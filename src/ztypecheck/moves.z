# moves -- ownership of values: moves, pins, receivers and locks. An
# implementation subunit of ztypecheck.

# isBorrowedVar -- true when the variable id is bound BORROWED (a borrowed
# parameter or a genuine borrowed local).
isBorrowedVar: function {st: zenv.ZSymbolTable.view vid: ztypes.vid} out bool is {
    if (st.reg.hasVariable id: vid).not then return false
    return (st.reg.variableOwnershipOf id: vid) == ztypes.zownership.borrowed
}

# methodReceiverIsView -- the method declares its receiver `.view`, so a call
# reads the receiver instead of writing it and the receiver lock is SHARED.
# DECLARED readonly-ness, and the only question the lock sites ask: it needs no
# name whitelist and works for user types. The whitelist that stood beside it
# existed for `.copy` alone, "the universal marker, which resolves to no method
# a declaration could mark" -- and now every `.copy` that is legal resolves to
# one that marks itself `.view`, while the rest are refused before a lock is
# ever in question.
methodReceiverIsView: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out bool is {
    rpn: st.reg.thisParamNameIdOf tid: mid
    if rpn.isZero then return false
    rpo: st.typing.declOwnershipOfId parentTypeId: mid nameId: rpn
    match (
        rpo
    ) case some then {
        return rpo == ztypes.zparamownership.viewMode
    } case none then {
        return false
    }
}

# callReadsReceiver -- the call at the dotted path `nid` only READS its receiver,
# so the receiver lock is shared: the method declares its receiver `.view`, or
# the path names a function STORED IN A FIELD, which is called by reading the
# slot and has no receiver to write through.
callReadsReceiver: function {
    st: zenv.ZSymbolTable.view mid: ztypes.tid nid: zast.nodeid
} out bool is {
    if (methodReceiverIsView :st :mid) then return true
    md: (st.typing.refDecl.get key: nid).or d: ztypes.declid
    if md.isZero then return false
    return (st.typing.decls.get i: md).fnptrField
}

# isMoveMarkerId -- a value-position ownership-transfer marker, by id. `.hold`
# moves its source exactly as `.take` does; the two differ only in whether the
# destination is frozen afterwards.
isMoveMarkerId: function {nameId: zast.nameid} out bool is {
    k: zast.markerKindOfName id: nameId
    return k.takeMarker or k.holdMarker
}

# isDropMarkerId -- the early-lifetime marker, by id. A statement-only sibling
# of the move markers: it ends a lifetime and hands back nothing, where `.take`
# moves the value on. One predicate so the spelling lives in one place -- four
# hardcoded compares is how member-guard came to be watching a spelling that
# had moved.
isDropMarkerId: function {nameId: zast.nameid} out bool is {
    return (zast.markerKindOfName id: nameId).dropMarker
}

# typeHasNonOwnedField -- the type declares at least one field the instance does
# NOT own: a `borrow`/`view` slot, i.e. a reference into something else. Such an
# instance is only sound while whatever it points at outlives it.
typeHasNonOwnedField: function {
    st: zenv.ZSymbolTable.view ast: Ast.view tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    # a generator's per-call slots are non-owned fields its generated `create`
    # never sets: the lowering declares that create honestly, so neither the
    # generator nor an instance of a generic one is asked
    gdef: st.reg.genericOriginOf :tid
    if gdef.isZero then gdef = tid
    if (definedAsGenerator :st :ast tid: gdef) then return false
    i: u64
    n: st.typing.declRowSlots ownerTid: tid
    found: false
    for i < n loop {
        frow: st.typing.declRowAt ownerTid: tid membersOnly: true slot: i
        if frow.keep when found.not then {
            nid: frow.name
            if (st.typing.declIsBorrowedFieldId parentTypeId: tid nameId: nid) then found = true
        }
        i = i + 1
    }
    return found
}

# listSlotTid -- the one type every list's `slot` has: it names its list's
# labels' positions and is read through a label, never as a value. Minted on
# first use.
listSlotTid: function {st: zenv.ZSymbolTable} out ztypes.tid is {
    if st.typing.listSlotTid.notZero then return st.typing.listSlotTid
    t: st.reg.newType name: "slot" typetype: ztypes.ztypetype.recordType
    st.reg.setValtype typeId: t value: true
    st.typing.listSlotTid = t
    return t
}

# definedAsGenerator -- the type is declared by a `generator` definition, whose
# class the lowering writes itself.
definedAsGenerator: function {
    st: zenv.ZSymbolTable.view ast: Ast.view tid: ztypes.tid
} out bool is {
    d: st.typing.declIdOfType typeId: tid
    if d.isZero then return false
    dn: (st.typing.decls.get i: d).node
    if dn.isZero then return false
    isGen: false
    nop: ast.nodes.get i: dn
    if nop.namedoperation then {
        def: ast.nodes.get i: nop.operation
        if def.objectdef when def.kind == zast.objectkind.generatorDef then isGen = true
    }
    return isGen
}

# stdTidPeek -- stdTidRo for a reader holding only a view of the table, the
# emitter: the memoised id, else the prelude's answer, never stored.
stdTidPeek: function {
    ast: Ast.view typing: ztyping.ZTyping.view wk: zast.nameid
} out ztypes.tid is {
    m: typing.stdTidMemo.get key: wk
    if m.some then {
        return m
    }
    return (
        (
            resolve.walkLookupTyperefByIdRo
            :ast
            :typing
            unitDecl: ztypes.declid
            scope: ztypes.declid
            baseId: wk
        ).or
        d: ztypes.tid.zero
    )
}

# checkInterpPart -- one interpolated sub-expression: walked and stamped, reported
# when it resolves to nothing, and refused when its type is not one the string
# machinery can splice.
checkInterpPart: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    partId: zast.nodeid
} is {
    en0: st.typing.errors.length
    if (refuseBlockPart :st :ast :partId) then return
    ptid: checkValueAt :st :unitDecl :ast nid: partId
    if st.typing.errors.length != en0 then return
    if ptid.isZero then {
        valuechecks.reportUnresolvedValue :st :unitDecl :ast nid: partId
        valuechecks.refuseUntypedValue :st :ast nid: partId
        return
    }
    # a FUNCTION value is not printable, but a LOCAL holding one after an earlier
    # error is most often that error's residue -- a refused `.take` still binds
    # its local -- so a bare name is reported only on a clean slate
    isFn: (st.reg.typetypeOf typeId: ptid) == ztypes.ztypetype.functionType
    isBare: false
    pn: ast.nodes.get i: partId
    isBare = pn.atomid
    if isFn when isBare when st.typing.errors.length > 0 then return
    # a bare name is spliced where it stands: a READ of its storage, which an
    # exclusive pin on it refuses as it refuses a field read
    if isBare when (st.reg.isReftypeOf tid: ptid) then {
        pn2: ast.nodes.get i: partId
        refuseReadUnderPin :st :ast nid: partId lineno: (nodeLine n: pn2) colno: (nodeCol n: pn2)
    }
    if (valuechecks.printableInterpTid :ast :st tid: ptid) then {
        # A PART IS A VALUE HELD WHILE IT IS SPLICED. A part no name binds -- a
        # call's result, a path that auto-calls one -- is built, appended to the
        # string being assembled and then released, and every value the
        # emitter releases is a variable of the checker's. A part a NAME binds
        # is appended where it stands and never held, which is why this asks
        # `receiverIsValue` rather than minting for every part.
        if (receiverIsValue :st :ast :unitDecl nid: partId) then (
            ownedReceiverTemp
            :st
            :ast
            recvT: ptid
            recvNid: partId
        )
        return
    }
    reportNotPrintable :st :ast :partId :ptid
}

# refuseBlockPart -- an interpolation part written as a block (`"\{ { n } }"`):
# a part is one expression, spliced where it stands, and a block's statements
# have nowhere to run there. True when it refused.
refuseBlockPart: function {st: zenv.ZSymbolTable ast: Ast.view partId: zast.nodeid} out bool is {
    part: ast.nodes.get i: partId
    if part.doexpr.not then return false
    (
        addErrorWithHint
        :st
        nodeid: partId
        lineno: part.lineno
        colno: part.colno
        e: zast.err.typeError
        msg: "a block cannot be an interpolation part".string
        note: String
        hint: "bind the block to a name first and interpolate the name".string
        width: 1
    )
    return true
}

# reportNotPrintable -- an interpolation part of type `ptid`, which has no
# printed form
reportNotPrintable: function {
    st: zenv.ZSymbolTable ast: Ast partId: zast.nodeid ptid: ztypes.tid
} is {
    part: ast.nodes.get i: partId
    ptn: specWrittenName :st :ast tid: ptid
    pm: "type '\{ptn}' is not printable in an interpolation"
    (
        addErrorWithHint
        :st
        nodeid: partId
        lineno: (nodeLine n: part)
        colno: (nodeCol n: part)
        e: zast.err.typeError
        msg: pm
        note: "an interpolated value must be numeric, bool, String or StringView".string
        hint: "unwrap or format the value first: match on it or use an accessor that yields a printable type".string
        width: 1
    )
}

# selfReturnOnInstance -- A MEMBER'S SELF-TYPE RETURN ON AN INSTANCE IS THE
# INSTANCE. A member declared `out type` names the type that DECLARES it, so one
# reached on a monomorphisation must answer that instance and never the template
# it was minted from: a template carries no layout, and a local given its id gets
# a C type nothing emits.
#
# Nearly every instance substitutes this where it is minted. One did not, and the
# discriminator was measured rather than reasoned: of the element types, ONLY
# `ListVal u8` answered the template -- it is the instance `collections.z` mints
# for `Bytes` while the standard library is still being read, and every later use
# reuses it. `b.copy` then emitted `z_t90_ListVal_t c = z_t121_ListVal_u8_copy(&b)`
# and the C compiler rejected the local. Asking here covers the mint whatever
# order it happened in.
selfReturnOnInstance: function {
    st: zenv.ZSymbolTable.view
    recvTid: ztypes.tid
    ret: ztypes.tid
} out ztypes.tid is {
    if recvTid.isZero then return ret
    if ret.isZero then return ret
    roSi: st.reg.genericOriginOf tid: recvTid
    if roSi.isZero then return ret
    if ret == roSi then return recvTid
    return ret
}

# createDottedBaseId -- the base atom's node id when a dotted path's child is
# `create` (explicit construction: `T.create` is bare-name construction).
createDottedBaseId: function {ast: Ast.view n: astnode.view} out optionval zast.nodeid is {
    if n.dottedpath then {
        ccn: atomNameId :ast n: (ast.nodes.get i: n.child)
        if ccn == zast.wellKnown.slot.wkCreate then return (optionval.some n.parent)
    }
    return (optionval.none zast.nodeid)
}

# unionCreateArmId -- the constructed arm's name id when a value is a tagged
# subtype construction (a UNION_CREATE-stamped call's dotted child), or "".
unionCreateArmId: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    n: astnode.view
} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        dgot: st.typing.dpTaggedParent.get key: n.nodeid
        match (
            dgot
        ) case some then {
            return (dottedMemberId :st :ast nid: n.nodeid child: n.child)
        } case none then {
            return zast.nameid
        }
    } case call then {
        kOpt: st.typing.callKind.get key: n.nodeid
        isUC: false
        if kOpt.some when kOpt == zast.callkind.unionCreate then isUC = true
        if isUC then return (dottedNodeMemberId :st :ast nid: n.callable)
        return zast.nameid
    } else {
        return zast.nameid
    }
}

# dottedNodeMemberId -- dottedMemberId of the node `nid`, 0 when it is no
# dotted path.
dottedNodeMemberId: function {
    st: zenv.ZSymbolTable.view ast: Ast.view nid: zast.nodeid
} out zast.nameid is {
    n: ast.nodes.get i: nid
    match (
        n
    ) case dottedpath then {
        return (dottedMemberId :st :ast nid: n.nodeid child: n.child)
    } else {
        return zast.nameid
    }
}

# consumeProjectionSource -- a `create` projection COPIES its source, so a
# trivial bare name is invalidated only where the projection consumes; a
# non-trivial argument is hoisted instead, having no name to invalidate.
consumeProjectionSource: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    argT: ztypes.tid
    consumes: bool
} is {
    if (argIsTrivial :ast op: (ast.nodes.get i: arg.operation)).not then {
        hp: List ztyping.PinPath
        appendRecordPins :st vp: (valuePinsOf :st nid: arg.operation) dst: hp
        # a consumed source moves into the instance, and its locks with it: the
        # temporary it leaves holds nothing
        kept: List ztyping.PinPath
        if consumes.not then appendRecordPins :st vp: (valuePinsOf :st nid: arg.operation) dst: kept
        (
            hoistArg
            :ast
            :st
            argId: arg.operation
            argType: argT
            paramType: ztypes.tid.zero
            :consumes
            viewParam: false
            argPins: kept
        )
        if consumes then carryPinsIntoDraft :st pins: hp
        return
    }
    if consumes.not then return
    pbn: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: arg.operation))
    if pbn.length == 0 then return
    pbv: st.lookupVarId nameId: (nameIdOf :ast name: pbn.stringView)
    if pbv.some then {
        takeHeldLocks :st from: pbv
        st.invalidate nameId: (nameIdOf :ast name: pbn.stringView) loc: takenHere
    }
}

# carryPinsIntoDraft -- the locks `pins` name join the pending value's, as
# carried.
carryPinsIntoDraft: function {st: zenv.ZSymbolTable pins: (List ztyping.PinPath).view} is {
    if pins.length == 0 then return
    for each cp: pins loop {
        st.walk.value.draft.pins.append (
            ztyping.PinPath
            path: cp.path.copy
            shared: cp.shared
            mutable: cp.mutable
            carried: true
        )
    }
    st.walk.value.draft.owned = true
}

# projectionSourceBorrows -- a projection (`Speaker d`, `Bytes.create from: d`)
# of the walked source `src`, of type `vt`, borrows it: the source is marked
# `.borrow`, or it is a reftype place written without a marker and the
# projection is not the value of a destination that owns what it holds
# (owningValueNid), which takes it.
projectionSourceBorrows: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    src: zast.nodeid
    vt: ztypes.tid
} out bool is {
    sn: ast.nodes.get i: src
    mk: zast.markerKindOf :ast n: sn
    if mk.borrowMarker then return true
    if mk.unmarked.not then return false
    if call.nid == st.walk.value.owningValueNid then return false
    if (st.reg.isReftypeOf tid: vt).not then return false
    bn: zast.atomNameIdOf n: sn
    if bn.notZero then return (st.lookupVarId nameId: bn).some
    return (localFieldPath :st :ast n: sn)
}

# valueCoreNid -- the node a value is, under the lines and one-statement
# blocks its parentheses wrap it in.
valueCoreNid: function {ast: Ast.view nid: zast.nodeid} out zast.nodeid is {
    cur: nid
    for cur.notZero loop {
        n: ast.nodes.get i: cur
        if n.statementline then {
            cur = n.statementline
        } else if n.statement when n.statements.count == 1 then {
            cur = zast.kidAt kids: ast.kids span: n.statements i: 0
        } else {
            return cur
        }
    }
    return cur
}

# consumeCastFromArg -- a typedef cast CONSUMES its from-argument. A trivial
# argument invalidates the source name; a non-trivial one hoists to the current
# scope. Only a REFTYPE source transfers -- a valtype owns no heap, so the cast
# takes a copy and the name stays live.
consumeCastFromArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    aOpId: zast.nodeid
    vt: ztypes.tid
} is {
    if (argIsTrivial :ast op: (ast.nodes.get i: aOpId)) then {
        bn: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: aOpId))
        if bn.length > 0 then {
            bvo: st.lookupVarId nameId: (nameIdOf :ast name: bn.stringView)
            # only a REFTYPE source transfers. A
            # valtype owns no heap, so the typedef
            # takes a copy and the name stays live --
            # the same guard a returned owned local
            # carries before it records a move.
            if bvo.some when (st.reg.isReftypeOf tid: vt) then {
                st.invalidate nameId: (nameIdOf :ast name: bn.stringView) loc: takenHere
            }
        }
    } else {
        hp: List ztyping.PinPath
        appendRecordPins :st vp: (valuePinsOf :st nid: aOpId) dst: hp
        (
            hoistArg
            :ast
            :st
            argId: aOpId
            argType: vt
            paramType: ztypes.tid.zero
            consumes: true
            viewParam: false
            argPins: hp
        )
    }
}

# pinTypedefBorrowSource -- a borrowed typedef locks its source EXCLUSIVELY: a
# `.borrow` source by the path under the marker; a source that is itself a
# borrowed view (a call's result) already pinned what it reads.
pinTypedefBorrowSource: function {st: zenv.ZSymbolTable ast: Ast src: zast.nodeid} is {
    srcN: src
    so: ast.nodes.get i: src
    if so.dottedpath when (
        (atomNameId :ast n: (ast.nodes.get i: so.child)) == zast.wellKnown.slot.wkBorrow
    ) then {
        srcN = so.parent
    }
    if srcN == src when (valuePinsOf :st nid: src).len > 0 then return
    tup: ListVal zast.nameid
    appendValueTuple :ast n: (ast.nodes.get i: srcN) dst: tup
    pinsPush :st path: tup shared: false mutable: true
}

# methodHasThisReceiver -- a FUNCTION child bound to a receiver: a declared
# `this` param (shorthand) or a recorded long-form receiver name. A this-less
# function member is a callable field, not a method.
methodHasThisReceiver: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out bool is {
    if (st.typing.declHasMemberId parentTypeId: mid nameId: zast.wellKnown.slot.wkThis
    ) then return true
    return (st.reg.hasThisParamName tid: mid)
}

# lockTransientReceiver -- a receiver that locks for ONE expression's duration:
# a zero-argument auto-call, or a binop's left operand, which is the receiver
# of the operator method (a binop is the call form of a one-argument method).
# Neither form opens a scope to pop, so a lock would be released as soon as it
# was taken: its only effect is the conflict check against locks outstanding
# elsewhere, and it is taken as a PROBE, which checks and lays no row. `shared`
# is what the METHOD's receiver marker decided. A binop is the hottest path
# there is.
lockTransientReceiver: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    # the receiver expression
    recv: astnode.view
    # the node holding the lock: the auto-call's dotted path, or the binop
    holderId: zast.nodeid
    shared: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    atup: ListVal zast.nameid
    appendValueTuple :ast n: recv dst: atup
    if atup.length == 0 then return
    arv: st.lookupVarId nameId: (atup.get i: 0)
    if arv.none then return
    if atup.length == 1 then {
        (
            lockCallArg
            :st
            pool: ast.names
            nameId: (atup.get i: 0)
            callId: holderId
            :shared
            mutable: shared.not
            :nodeid
            :lineno
            :colno
            probe: true
        )
    } else {
        (
            lockCallPath
            :st
            :ast
            pool: ast.names
            path: atup
            callId: holderId
            :shared
            mutable: shared.not
            :nodeid
            :lineno
            :colno
            probe: true
        )
    }
}

# lockAutoCallReceiver -- lockTransientReceiver for a zero-argument auto-call:
# the receiver is the dotted path's base, the holder the path itself.
lockAutoCallReceiver: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    dp: dpref
    shared: bool
} is {
    recvN: ast.nodes.get i: dp.parent
    (
        lockTransientReceiver
        :ast
        :st
        recv: recvN
        holderId: dp.nid
        :shared
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
    )
}

# readsMethodThroughInstance -- `dp` reads a method that takes a receiver
# through a value, not through its type: `e.key`, not `Entry.key`. A function
# FIELD is excluded: it is the instance's own reference, not a method.
readsMethodThroughInstance: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
    mo: ztypes.tid
} out bool is {
    cnId: dottedMemberId :st :ast nid: dp.nid child: dp.child
    if (st.typing.declIsFnptrFieldId parentTypeId: bt nameId: cnId) then return false
    if (memberDeclaresReceiver :st :bt :cnId :mo).not then return false
    return (instantiate.dottedBaseIsValue :st :ast :unitDecl n: (ast.nodes.get i: dp.nid))
}

# checkMemberAutoCall -- a FUNCTION member read in value position auto-calls: it
# takes the receiver lock a reader takes, answers the method's return type, and
# routes the pins its result keeps. Answers the path's type.
checkMemberAutoCall: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    # the RECEIVER's type: a member declared `out type` answers this instance
    bt: ztypes.tid
    mo: ztypes.tid
    coerce: bool
    memberResult: ztypes.tid
} out ztypes.tid is {
    result: memberResult
    # only a FUNCTION member auto-calls. fnAutoCallable counts the member's
    # parameters, and a field's type -- a generic parameter above all -- may
    # declare none, which read a field as a call that locked its receiver.
    moKind: st.reg.typetypeOf typeId: mo
    if moKind != ztypes.ztypetype.functionType then return result
    # a METHOD read through an INSTANCE has no reference form -- a reference has
    # nowhere to carry the receiver -- so a `.take` or `.copy` after it does not
    # stop the call: the marker applies to what the method returns
    suppressed: st.mode.suppressFnAutoCall
    if suppressed then suppressed = (readsMethodThroughInstance :st :ast :unitDecl :dp :bt :mo).not
    if coerce when suppressed.not when (valuechecks.fnAutoCallable :st mid: mo) then {
        # the read's value is the method's result, not the base's: what the
        # base's record gave the read goes, and the receiver's record is read
        # where the call needs it (valueReceiverPins)
        st.walk.value.draft.clear
        aShr: callReadsReceiver :st mid: mo nid: dp.nid
        # a receiver that is a `.view` result is read-only, written as a member
        # read (`(xs.get i: 0).pop`) exactly as written as a call
        bnid: dottedReceiverNodeId :ast n: (ast.nodes.get i: dp.nid)
        bro: (
            bnid.notZero and ((valuePinsOf :st nid: bnid).marker == ztypes.zparamownership.viewMode)
        )
        if aShr.not when bro when (
            instantiate.dottedBaseIsValue
            :st
            :ast
            :unitDecl
            n: (ast.nodes.get i: dp.nid)
        ) then {
            (
                addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.ownerError
                msg: "a method that writes its receiver cannot be called on a `.view` result: a view converts to no other ownership".string
            )
        }
        valuechecks.noteStatementAutoCall :st nid: dp.nid
        lockAutoCallReceiver :ast :st :dp shared: aShr
        landedA: (
            landLiteralReceiver
            :st
            :ast
            recv: dp.parent
            method: mo
            instance: ztypes.tid.zero
            call: zast.nodeid
        )
        ro: conform.methodReturnOf reg: st.reg typing: st.typing mid: mo
        match (
            ro
        ) case some then {
            result = (
                landedResult
                :st
                recv: dp.parent
                landed: landedA
                result: (selfReturnOnInstance :st recvTid: bt ret: ro)
                stampNid: zast.nodeid
            )
            # an auto-call's only input is its receiver: the pin its result
            # keeps, if any, is the receiver path at the strength the reader
            # took. Built locally, then pushed through the full field path (a
            # field list passed as an argument is a non-owning shallow copy).
            tup: ListVal zast.nameid
            if (receiverPinsNothing :ast :st recvT: bt).not then {
                appendValueTuple :ast n: (ast.nodes.get i: dp.parent) dst: tup
                cutAtViewingMethod :st :ast recv: dp.parent dst: tup
            }
            recvPins: List ztyping.PinPath
            if (receiverPinsNothing :ast :st recvT: bt).not then (
                valueReceiverPins
                :st
                :ast
                :unitDecl
                funcId: mo
                recvNid: dp.parent
                recvT: bt
                path: tup
                pins: recvPins
            )
            (
                pinCallResult
                :st
                pool: ast.names
                funcId: mo
                pins: recvPins
                recvPath: tup
                recvShared: aShr
            )
        } case none then {
            # A no-`out` METHOD auto-call resolves to null (the
            # reference's auto-call rule for out-less methods).
            result = st.typing.nullTypeId
        }
    }
    return result
}

# listValueMember -- a member of the list `row` that is no element, label or
# count: one its value's type declares (`get`, `iterate`). A name it does not
# declare is reported, in the words every position uses, and answers false.
listValueMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    row: u32
    cnId: zast.nameid
} out bool is {
    gt: (st.typing.constAggs.get i: row.u64).tid
    forceMemberOf :st :ast parentTypeId: gt nameId: cnId
    if (st.typing.declChildOfId parentTypeId: gt nameId: cnId).some then return true
    pp: ListVal zast.nameid
    appendValueTuple :ast n: (ast.nodes.get i: dp.parent) dst: pp
    bn: zenv.formatPath pool: ast.names path: pp.listView
    mn: zast.nameTextAt :ast ref: cnId
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        msg: "list '\{bn}' has no element or member '\{mn}'"
        note: String
        hint: String
        width: mn.length
    )
    return false
}

# checkStaticListMember -- a member read off a list reached by a compile-time
# path (`codes`, `zast.wellKnown`): an element by its label or ordinal, typed as
# the list's element; the count, `length`, untyped; `slot`, whose labels read
# positions (checkListSlotRead); `.array`, the elements copied into the sized
# array instance (array_{elem}_{count}), minted on first access; and `tag`,
# which only a sum's `as` block reads. Any other member is the list value's
# (`get`, `iterate`). Through a run-time VALUE, `.array`, `.tag` and `.slot`
# are refused: the path carries what they need.
checkStaticListMember: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    if bt.notZero when bt == st.typing.listSlotTid then return (
        checkListSlotRead
        :st
        :ast
        :dp
        :cnId
    )
    isArray: cnId == zast.wellKnown.slot.tyArray
    row: listRowOfNode :st nid: dp.parent
    if row == 0 then {
        if (stdtypes.refuseStaticListValueMember :st :ast :dp :bt :cnId :isArray) then return (
            callleg
            handled: true
            tid: ztypes.tid.zero
        )
        return (callleg handled: false tid: ztypes.tid.zero)
    }
    g: st.typing.constAggs.get i: row.u64
    if isArray then return (stdtypes.checkListArray :st :ast :unitDecl :dp :row)
    if cnId == zast.wellKnown.slot.wkSlot then {
        if g.slot.isZero then {
            pp: ListVal zast.nameid
            appendValueTuple :ast n: (ast.nodes.get i: dp.parent) dst: pp
            bn: zenv.formatPath pool: ast.names path: pp.listView
            (
                addErrorWithHint
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.typeError
                msg: "'\{bn}' has no labelled element, so no `slot`"
                note: String
                hint: "label the elements whose positions you read: `list { first: 2 second: 3 }`".string
                width: 4
            )
            return (callleg handled: true tid: ztypes.tid.zero)
        }
        # a position needs no array
        takeListBase :st :dp
        sl: listSlotTid :st
        stampGate :st nid: dp.nid tid: sl
        return (callleg handled: true tid: sl)
    }
    if cnId == zast.wellKnown.slot.wkTag then {
        msg: "a list's `tag` is the discriminator source of a variant or union, and only a list of integers is one".string
        hint: "write the arms' values as integers: `codes: list { a: 1 b: 2 } out staticlist u8`".string
        if (statics.typeIsNumberOf :st tid: g.elem float: false) then {
            msg = "a list's `tag` is read in a variant's or union's `as` block: `tag: codes.tag`".string
            hint = String
        }
        (
            addErrorWithHint
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            e: zast.err.typeError
            :msg
            note: String
            :hint
            width: 3
        )
        return (callleg handled: true tid: ztypes.tid.zero)
    }
    et: statics.listMemberType :st :ast :row nameId: cnId
    if et.isZero then {
        # a generic unit's list over its parameter is a value of a partial,
        # whose members its template answers
        if (st.reg.isPartialOf tid: g.tid) then return (callleg handled: false tid: ztypes.tid.zero)
        return (callleg handled: (listValueMember :st :ast :dp :row :cnId).not tid: ztypes.tid.zero)
    }
    # an element or the count is a constant: the list's array is not read
    takeListBase :st :dp
    stampGate :st nid: dp.nid tid: et
    return (callleg handled: true tid: et)
}

# listRowOfNode -- the list row the node at `nid` folded to in the walk in
# progress: a list reached by a compile-time path. 0 for any other node.
listRowOfNode: function {st: zenv.ZSymbolTable.view nid: zast.nodeid} out u32 is {
    v: st.typing.nodeConstAt :nid
    if v.kind.aggKind.not then return 0
    if (st.typing.constAggs.get i: v.aggId.u64).kind.staticList.not then return 0
    return v.aggId
}

# takeListBase -- the list at the base of dotted path `dp` is read for a
# constant the path names, not for its array: the base reaches nothing.
takeListBase: function {st: zenv.ZSymbolTable dp: dpref} is {
    (
        st.walk.consts.wideConstTaken.set
        key: (ztyping.monostamp mono: st.typing.curMonoStamp node: dp.parent)
        value: 1
    )
}

# checkListSlotRead -- `P.slot.label`: the position of the list's element so
# labelled, typed as its `slot` (the list's index, or untyped). A name that is
# no label of the list is refused: `slot` holds the labels' positions and
# nothing else.
checkListSlotRead: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    cnId: zast.nameid
} out callleg is {
    pn: ast.nodes.get i: dp.parent
    row: zast.nodeid
    if pn.dottedpath then row = pn.parent
    lr: listRowOfNode :st nid: row
    if lr == 0 then return (callleg handled: true tid: ztypes.tid.zero)
    if (st.typing.aggLabelPos id: lr label: cnId).some then {
        sl: (st.typing.constAggs.get i: lr.u64).slot
        stampGate :st nid: dp.nid tid: sl
        return (callleg handled: true tid: sl)
    }
    mn: zast.nameTextAt :ast ref: cnId
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        msg: "'\{mn}' is no label of this block: its `slot` holds its labels' positions and nothing else"
        note: String
        hint: "read a label's position, `blk.slot.label`".string
        width: mn.length
    )
    return (callleg handled: true tid: ztypes.tid.zero)
}

# checkDropMarkerVar -- `.drop` on a name in scope. Answers true when the drop
# is blocked (and the error is already reported), so the caller leaves the
# ownership transfer unrecorded.
checkDropMarkerVar: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    cnId: zast.nameid
    mkRoot: StringView
    blocked: bool
} out bool is {
    relBlocked: blocked
    if (isDropMarkerId nameId: cnId) then {
        # the name's own locks -- the readonly lock a `.view` result, a `view`
        # parameter or a `hold` binding keeps on itself -- end with it; only a
        # lock something else holds on it stops the drop
        selfH: ztypes.zlockholder.var (
            (st.lookupVarId nameId: (nameIdOf :ast name: mkRoot)).or
            d: ztypes.vid
        )
        rlk: st.findLockHeldByOther nameId: (nameIdOf :ast name: mkRoot) self: selfH
        heldByOther: false
        if rlk.some then {
            relBlocked = true
            heldByOther = true
            rhn: st.holderPhrase pool: ast.names holder: rlk.holder
            lsn: zenv.zlockstateNameLower t: rlk.state
            mrel: "Cannot drop '\{mkRoot}': \{lsn} lock held by \{rhn}"
            (
                addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.ownerError
                msg: mrel
            )
        }
        # a lock another holder has is what stops the drop, said once; failing
        # that, an exclusive lock the name itself holds stops any access
        if heldByOther.not then {
            rpath: ListVal zast.nameid
            rpath.append (nameIdOf :ast name: mkRoot)
            elh: st.findExclusiveLock path: rpath
            if elh.some then {
                relBlocked = true
                ahp: st.holderPhrase pool: ast.names holder: elh
                macc: "Cannot access: '\{mkRoot}' has exclusive lock held by \{ahp}"
                ahint: String
                if elh.var then {
                    ahint = throughHint :st pool: ast.names vid: elh verb: "read"
                }
                aen: String
                aid: nodeId n: (ast.nodes.get i: dp.parent)
                aln: nodeLine n: (ast.nodes.get i: dp.parent)
                acl: nodeCol n: (ast.nodes.get i: dp.parent)
                (
                    addErrorWithHint
                    :st
                    nodeid: aid
                    lineno: aln
                    colno: acl
                    e: zast.err.ownerError
                    msg: macc
                    note: aen
                    hint: ahint
                    width: mkRoot.length
                )
            }
        }
    }
    return relBlocked
}

# checkMoveMarkerVar -- `.take` on a name in scope: readonly first (a `view`
# parameter is both readonly and pinned), then pinned, then borrowed. Answers true
# when the move is blocked, so the caller leaves the transfer unrecorded.
checkMoveMarkerVar: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    cnId: zast.nameid
    mkRoot: StringView
    mvo: ztypes.vid
} out bool is {
    relBlocked: false
    if (isMoveMarkerId nameId: cnId) then {
        # Readonly first: a `view` parameter is both readonly and
        # non-owned, and readonly is the rule the author has to
        # satisfy. A `hold` binding IS owned, so only this leg
        # catches it -- moving it out would thaw a frozen cell.
        if (nameIsReadonly :st :ast name: mkRoot) then {
            cn: zast.nameTextAt :ast ref: cnId
            relBlocked = true
            tvb: "with '.\{cn}'"
            (
                readonlyMoveError
                :st
                :ast
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                name: mkRoot
                verb: tvb.stringView
            )
        }
        if relBlocked.not then {
            cn: zast.nameTextAt :ast ref: cnId
            tpv: "with '.\{cn}'"
            if (
                pinnedMoveError
                :st
                :ast
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                name: mkRoot
                verb: tpv.stringView
            ) then relBlocked = true
        }
        if relBlocked.not when (isBorrowedVar :st vid: mvo) then {
            relBlocked = true
            mtbKeep: keepSourceHint :st :ast name: mkRoot
            mtb: "Cannot move borrowed variable '\{mkRoot}' with '.take' — borrowed names stay bound to their source for the full scope\{mtbKeep}"
            (
                addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.ownerError
                msg: mtb
            )
        }
    }
    return relBlocked
}

# memberIsTypeOnly -- the function member `cnId` of `bt` (of type `mo`) belongs
# to the TYPE, so no instance reaches it: it declares no receiver -- `create`, a
# shared function of the `as` section. A member the compiler synthesises other
# than `create` takes its receiver implicitly. The checker refuses `t.create`
# by it, and an editor offers on a value only what it does not mark.
memberIsTypeOnly: function {
    st: zenv.ZSymbolTable.view
    bt: ztypes.tid
    cnId: zast.nameid
    mo: ztypes.tid
} out bool is {
    if (memberDeclaresReceiver :st :bt :cnId :mo) then return false
    if cnId == zast.wellKnown.slot.wkCreate then return true
    return (st.typing.declMemberIsSynth parentTypeId: bt nameId: cnId).not
}

# memberDeclaresReceiver -- the function member `cnId` of `bt` takes a receiver. A
# member a mono MINTS for itself carries no parameter rows, so the question goes
# to the template's declaration of it.
memberDeclaresReceiver: function {
    st: zenv.ZSymbolTable.view
    bt: ztypes.tid
    cnId: zast.nameid
    mo: ztypes.tid
} out bool is {
    if (methodHasThisReceiver :st mid: mo) then return true
    gorig: st.reg.genericOriginOf tid: bt
    if gorig.isZero then return false
    tmo: st.typing.declChildOfId parentTypeId: gorig nameId: cnId
    match (
        tmo
    ) case some then {
        return (methodHasThisReceiver :st mid: tmo)
    } case none then {
        return false
    }
}

# reportBareMemberRef -- The THIRD value position for a bare function reference.
# checkUnitMemberValue owns `unit.member` and typeOfBareName the bare atom; the
# instance-method path declined to auto-call and reported nothing, so `y: r.add`
# kept a FUNCTION stamp and the emitter called it with the receiver alone -- one
# argument into a two-parameter C function, at exit 0.
#
# Two legitimate FUNCTION stamps have to survive: a marker's base, which sets
# suppressFnAutoCall, and a for-header, which sets allowBareFnRef. A fn-pointer
# FIELD is excluded because checkMemberProjections already reports it in its
# own words. The hint offers `.copy` only when the read is not through an
# instance, where a method has no reference form.
reportBareMemberRef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    mo: ztypes.tid
    # the member read's type: still the FUNCTION when it was not called
    result: ztypes.tid
    # the hint to give instead of bareFnRefErrorFor's own; "" for that one
    hint: ""
} out bool is {
    if st.mode.suppressFnAutoCall or st.mode.allowBareFnRef then return false
    if (st.reg.typetypeOf typeId: result) != ztypes.ztypetype.functionType then return false
    if (st.typing.declIsFnptrFieldId parentTypeId: bt nameId: cnId) then return false
    cn: zast.nameTextCopy :ast ref: cnId
    bfl: nodeLine n: (ast.nodes.get i: dp.child)
    bfc: nodeCol n: (ast.nodes.get i: dp.child)
    # the read is named as written: the whole path, which is also how its
    # reference is spelled (`Gauge.tenfold.copy`)
    wtp: ListVal zast.nameid
    appendValueTuple :ast n: (ast.nodes.get i: dp.nid) dst: wtp
    wpath: zenv.formatPath pool: ast.names path: wtp.listView
    (
        valuechecks.bareFnRefErrorFor
        :ast
        :st
        nodeid: dp.nid
        lineno: bfl
        colno: bfc
        width: cn.length
        fid: result
        written: wpath.stringView
        refHint: (readsMethodThroughInstance :st :ast :unitDecl :dp :bt :mo).not
        :hint
    )
    return true
}

# refuseMarkerWithoutStorage -- an ownership marker (`.take`, `.borrow`, `.hold`)
# on a value that names no storage: a literal, a unit constant, a list or
# one of its elements, an arm, a call's result, and a function's NAME -- a unit
# function, or a method read through its type. A marker moves, lends or freezes
# a variable or a field; such a value is read where it is written, so the marker
# would do nothing while saying it does something. A function's reference is
# `.copy`; a variable or a field holding one is storage, and `.take` moves it.
# A native and a bound method have no reference form, and are refused in those
# words (refuseNativeReference, refuseBoundMethodReference). A TYPE names no
# storage either: a projection is written with the marker on its source
# (`Speaker d.borrow`).
# The addressability question is the one a write target answers. True when it
# reported; the marked value then has no type, so a binding of it is not refused
# a second time for what it would have held.
refuseMarkerWithoutStorage: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    isMarker: (isMoveMarkerId nameId: cnId) or (cnId == zast.wellKnown.slot.wkBorrow)
    if isMarker.not then return false
    btt: st.reg.typetypeOf typeId: bt
    isFn: btt == ztypes.ztypetype.functionType
    # a spec's name was refused as a value by the base walk (refuseSpecValue)
    if isFn when (
        typeargs.namesSpec
        :st
        :ast
        :unitDecl
        scope: st.curScope
        baseId: (zast.atomNameIdOf n: (ast.nodes.get i: dp.parent))
    ) then return true
    # a function with no reference form at all is refused in those words
    if isFn when (refuseNativeReference :st :ast :dp :bt) then return true
    if isFn when (refuseBoundMethodReference :st :ast :dp :bt :cnId) then return true
    if (valuechecks.isAddressableTarget :ast :st nid: dp.parent) then return false
    tp: ListVal zast.nameid
    appendValueTuple :ast n: (ast.nodes.get i: dp.parent) dst: tp
    what: "this value".string
    hint: "write the value without a marker".string
    if (ast.nodes.get i: dp.parent).atomstring then {
        what = "a string literal".string
        hint = "write the literal without a marker".string
    }
    if tp.length > 0 then {
        pp: zenv.formatPath pool: ast.names path: tp.listView
        what = "'\{pp}'"
        hint = "write the value without a marker: '\{pp}'"
        if (listRowOfNode :st nid: dp.parent) != 0 then hint = "copy a list with '\{pp}.array'"
        if isFn then hint = "a function's reference is '\{pp}.copy'"
    }
    cn: zast.nameTextAt :ast ref: cnId
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        msg: "\{what} names no storage: '.\{cn}' applies to a variable or a field"
        note: "a literal, a constant, a list, a function and a call's result are values, not places".string
        :hint
        width: 1
    )
    return true
}

# refuseNativeReference -- a native function has no reference form, under
# `.take` or `.copy`: the compiler supplies its body, and an inlined one has no
# C function whose address there is to take. false when `bt` is not a native.
refuseNativeReference: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
} out bool is {
    if (valuechecks.isNativeFnTid :st tid: bt).not then return false
    ntp: ListVal zast.nameid
    appendValueTuple :ast n: (ast.nodes.get i: dp.parent) dst: ntp
    pth: zenv.formatPath pool: ast.names path: ntp.listView
    mnr: "'\{pth}' is native and has no reference form"
    addError :st nodeid: dp.nid lineno: dp.lineno colno: dp.colno e: zast.err.callError msg: mnr
    stampGate :st nid: dp.nid tid: bt
    return true
}

# refuseBoundMethodReference -- A BOUND METHOD HAS NO REFERENCE FORM. A method
# reference is a plain C function pointer, and a pointer has nowhere to carry
# the receiver -- `r.add.take` emitted the identical C to the bare `r.add`,
# which called the method with the receiver and none of its arguments. Copy it
# off the TYPE instead and pass the receiver explicitly.
#
# Scoped by methodHasThisReceiver, which is what separates a method from a
# callable FIELD: a function-pointer field read (`p.op.take`) declares no
# receiver and stays legal, as fnptr_field_bare_read instructs. The base must
# also be a VALUE -- `point.add.copy` names the type, and that is the unbound
# form this error points at. A method that needs no argument never reaches
# here: read through an instance it is called (readsMethodThroughInstance).
# false when nothing was refused.
refuseBoundMethodReference: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if (methodHasThisReceiver :st mid: bt).not then return false
    rootNm: typeargs.dottedRootName :ast n: (ast.nodes.get i: dp.parent)
    baseIsValue: false
    if rootNm.length > 0 then {
        rvo: st.lookupVarId nameId: (nameIdOf :ast name: rootNm.stringView)
        match (
            rvo
        ) case some then baseIsValue = true case none then null
    }
    if baseIsValue.not then return false
    cn: zast.nameTextAt :ast ref: cnId
    mNm: callchecks.dottedChildName :ast n: (ast.nodes.get i: dp.parent)
    # composed with append, not interpolation: a dotted path built inline reads
    # to A002 as a composed table key
    bound: rootNm.copy
    bound.append "."
    bound.append mNm
    unb: st.reg.nameOf tid: (st.reg.ownerTidOf tid: bt)
    unb.append "."
    unb.append mNm
    unb.append ".copy"
    bmm: "'\{bound.stringView}' is a bound method: a reference has nowhere to carry the receiver"
    bmn: "a method reference is a plain function pointer".string
    bmh: "copy it off the type -- '\{unb.stringView}' -- and pass the receiver explicitly"
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.callError
        msg: bmm
        note: bmn
        hint: bmh
        width: cn.length
    )
    stampGate :st nid: dp.nid tid: bt
    return true
}

# checkFunctionCopy -- `.copy` of a FUNCTION is another reference to it: a unit
# function, a static method or an unbound method read through its type, a
# function-reference variable, parameter or field. dottedBaseTid read the base
# as a reference, so a function type here is the function itself, not a call
# the base walk declined. A native and a bound method have no reference form.
checkFunctionCopy: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    if (cnId == zast.wellKnown.slot.wkCopy).not then return (
        callleg
        handled: false
        tid: ztypes.tid.zero
    )
    if (st.reg.typetypeOf typeId: bt) != ztypes.ztypetype.functionType then return (
        callleg
        handled: false
        tid: ztypes.tid.zero
    )
    refused: refuseNativeReference :st :ast :dp :bt
    if refused.not then refused = refuseBoundMethodReference :st :ast :dp :bt :cnId
    if refused.not then stampGate :st nid: dp.nid tid: bt
    return (callleg handled: true tid: bt)
}

# checkTransferMarker -- `.take` / `.drop` are ownership transfer markers, not
# members. The path carries the base's type; a bare-name source releases its held
# locks and invalidates (the taken overlay propagates out of popped scopes).
checkTransferMarker: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    # `.take` / `.drop`: ownership transfer markers, not members. The path
    # carries the base's type; a bare-name source releases its held locks and
    # invalidates (the taken overlay propagates out of popped scopes).
    isXferMarker: (isMoveMarkerId nameId: cnId) or (isDropMarkerId nameId: cnId)
    # nothing below is about anything else, so leave rather than nest it all
    if isXferMarker.not then return (callleg handled: false tid: ztypes.tid.zero)
    # a native has no reference form. The compiler supplies the body, and an
    # inlined one -- a binop, a conversion -- has no C function whose address
    # there is to take; even a fragment-backed one was not referenced but
    # CALLED, and typed by a function typedef that was never written. That
    # left the C compiler reporting a mangled name for a mistake in the path.
    if (isMoveMarkerId nameId: cnId) when (refuseNativeReference :st :ast :dp :bt) then {
        return (callleg handled: true tid: bt)
    }
    if (isMoveMarkerId nameId: cnId) when (refuseBoundMethodReference :st :ast :dp :bt :cnId) then {
        return (callleg handled: true tid: bt)
    }
    # `.drop` is a statement, not a value: it ends a lifetime and hands
    # back nothing, so a binding, an argument or an operand has nothing to
    # take from it. Legal only on the node that IS the statement.
    # a line whose value is used -- a block's value line, a function's implied
    # return -- is no statement for this purpose: `x.drop` there yields nothing
    dropIsValue: (dp.nid != st.walk.value.stmtExprNid) or st.mode.stmtDiscarded.not
    if (isDropMarkerId nameId: cnId) when dropIsValue then {
        mvs: "'.drop' is a statement, not a value -- it ends a lifetime and produces nothing; use '.take' to move the value into a new name".string
        (
            addError
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            e: zast.err.ownerError
            msg: mvs
        )
    }
    # A VALUE IS TAKEN BY COPYING ITS BYTES: a valtype -- a number, a
    # record, a variant, a function reference -- has no owner, so `.take` or
    # `.hold` of one moves nothing and leaves its source as it is: no
    # invalidation, no field emptied, no readonly or borrow to refuse. A `.hold`
    # binding is still frozen; that is the binding's, not the source's. Only a
    # reftype is moved.
    if (isMoveMarkerId nameId: cnId) when (st.reg.isReftypeOf tid: bt).not then {
        stampGate :st nid: dp.nid tid: bt
        return (callleg handled: true tid: bt)
    }
    if (isMoveMarkerId nameId: cnId) then takeMarkerOnField :st :ast :dp
    mkRootId: zast.atomNameIdOf n: (ast.nodes.get i: dp.parent)
    # a numeric literal is an atom too, and names no variable
    notVariable: mkRootId.isZero or (isNumericLiteralNameAt :ast ref: mkRootId)
    if (isDropMarkerId nameId: cnId) when notVariable then {
        mrv: "'.drop' can only be applied to a variable name".string
        (
            addError
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            e: zast.err.ownerError
            msg: mrv
        )
    }
    if mkRootId.notZero then {
        mvo: st.lookupVarId nameId: mkRootId
        match (
            mvo
        ) case some then {
            mkRoot: zast.nameTextAt :ast ref: mkRootId
            relBlocked: checkMoveMarkerVar :st :ast :dp :cnId mkRoot: mkRoot.stringView :mvo
            relBlocked = (
                checkDropMarkerVar
                :st
                :ast
                :dp
                :cnId
                mkRoot: mkRoot.stringView
                blocked: relBlocked
            )
            if relBlocked.not then {
                # a `.take` hands the locks to the value it makes
                # (takeHeldLocks), whose record the place it moves into
                # installs; a `.drop` releases them
                if (isMoveMarkerId nameId: cnId) then {
                    takeHeldLocks :st from: mvo
                } else {
                    mh: ztypes.zlockholder.var mvo
                    valuechecks.releaseCascade :st holder: mh
                    if (isDropMarkerId nameId: cnId) then noteDropReleasedTemps :st dropNid: dp.nid
                }
                if (isDropMarkerId nameId: cnId) then (
                    st.recordNamedDestroy
                    nid: dp.nid
                    nameId: mkRootId
                )
                st.invalidate nameId: mkRootId loc: takenHere
            }
        } case none then {
            if (isDropMarkerId nameId: cnId) then {
                dfo: walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: mkRootId
                if dfo.some then {
                    mkRoot: zast.nameTextAt :ast ref: mkRootId
                    mtl: "Cannot drop top-level definition '\{mkRoot}'"
                    (
                        addError
                        :st
                        nodeid: dp.nid
                        lineno: dp.lineno
                        colno: dp.colno
                        e: zast.err.ownerError
                        msg: mtl
                    )
                }
            }
        }
    }
    setmk: bt
    stampGate :st nid: dp.nid tid: setmk
    return (callleg handled: true tid: bt)
}

# boxMemberDelegates -- a member read off a Box that is its element's: anything
# but the ownership and access markers and `.copy`, which act on the box.
boxMemberDelegates: function {nameId: zast.nameid} out bool is {
    if nameId.isZero then return false
    if (isStripMarkerId :nameId) then return false
    if (isDropMarkerId :nameId) then return false
    return (nameId == zast.wellKnown.slot.wkCopy).not
}

# dottedBaseTid -- type the base a dotted path hangs off. The base is a REFERENCE,
# so a name-shaped one must not construct and a marker child must not auto-call
# it; an unresolved bare name may still be a unit, and a literal materialises to
# its concrete default before member lookup. 0 when the base types to nothing.
dottedBaseTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
} out ztypes.tid is {
    # the base of a dotted path is a reference, not a bare value: a type
    # name there must not construct (Counter.create, unit.Type.arm). Only
    # name-shaped bases suppress -- an expression base walks normally so
    # atoms inside its args still stamp. A marker child (`.copy`, `.take`,
    # `.borrow`, `.view`, `.hold`, `.drop`) applies to the base itself, so a
    # function base is a REFERENCE the base walk must not auto-call -- unless
    # the base was written in parentheses of its own, which force the call
    # (`(mk).copy` copies the result). A member that is no marker reads its
    # base as a value even inside a marker's base -- `(mk).shown.copy` calls
    # `(mk)` -- so each base walk sets the mode from its own child. Both shapes
    # are read through views scoped to this block: the base walk lends ast.
    baseIsName: false
    childIsRef: false
    {
        dpkN: ast.nodes.get i: dp.parent
        if dpkN.atomid then baseIsName = true
        if dpkN.dottedpath then baseIsName = true
        # a type application there names its type, as a name does
        if dpkN.call then st.walk.typeAppsNamed.add item: dp.parent
        if (zast.isValueMarkerLeaf :ast leaf: dp.child) then childIsRef = true
        if (zast.markerKindOfLeaf :ast leaf: dp.child).dropMarker then childIsRef = true
        if (zast.callsBeforeMarker :ast parent: dp.parent child: dp.child) then childIsRef = false
    }
    savedMode: st.mode
    if baseIsName then st.mode.suppressBareCtor = true
    st.mode.suppressFnAutoCall = childIsRef
    errsBase: st.typing.errors.length
    bt: checkValueAt :st :unitDecl :ast nid: dp.parent
    # a member read off a value keeps what the value keeps; a method a call
    # calls makes a value of its own, and reads its receiver's record itself
    if st.walk.value.calleeDottedNid != dp.nid then callchecks.composeChildRecord :st nid: dp.parent
    st.mode = savedMode
    if baseIsName then valuechecks.readSingletonBase :st :ast :unitDecl base: dp.parent :bt
    # a base refused as a call missing its arguments has no value to read a
    # member of: that refusal is the one error
    if st.typing.errors.length > errsBase when (
        (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.functionType
    ) then {
        return ztypes.tid.zero
    }
    if bt.isZero then {
        # an unresolved bare-name base may be a unit-qualified member
        # path (io.stdout): the side map types the base as the UNIT type.
        ubn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: dp.parent))
        if ubn.length > 0 then {
            ubo: (
                st.typing.declTypeOf
                declId: (
                    st.typing.declFindChild
                    parentDeclId: st.typing.programRoot
                    nameId: (nameIdOf :ast name: ubn.stringView)
                )
            )
            if ubo.notZero then {
                bt = ubo
                ubp: dp.parent
                if ubp.notZero then {
                    setub: ubo
                    stampGate :st nid: ubp tid: setub
                }
            }
        }
        if bt.isZero then return ztypes.tid.zero
    }
    # A literal's members are its own type's, looked up there; a member that
    # runs reads the literal where it lands (landLiteralReceiver).
    # A BOX IS A HEAP POINTER AROUND ONE VALTYPE and declares no members of
    # its own, so its operators, fields and methods are the boxed element's --
    # always, not only when the Box resolves nothing: under --eager every member
    # is minted and the Box would answer with an edge of its own, attributing
    # the member to a type that declares none. The ownership and access markers
    # stay the Box's (`b.take` moves the box, `b.drop` ends it), and `.copy` is
    # asked of the box, which has none.
    # what the BASE itself is, before any delegation rewrites `bt` to the type
    # the member is looked up on: a temporary holds the value the path hangs
    # off, which is the box and not the element inside it -- and a string
    # literal as the StringView it is at run time
    holdT: bt
    if (numerics.isTextLiteralTid :st tid: bt) then holdT = (
        valuechecks.materialiseLiteral
        :ast
        :st
        t: bt
    )
    isOpB: boxMemberDelegates nameId: (atomNameId :ast n: (ast.nodes.get i: dp.child))
    if isOpB when (st.reg.isBoxOf tid: bt) when (st.reg.genericArgCount specId: bt) == 1 then {
        bxE: st.reg.genericTypeArgAt specId: bt ordinal: 0
        if bxE.notZero then bt = bxE
    }
    # A VALUE READ THROUGH IS HELD WHILE IT IS READ. `(mkBox).label` reads a
    # field out of a value no name binds; the emitter hoists it so the read can
    # happen and then destroys it, and every value the emitter destroys is a
    # variable of the checker's. Every dotted path passes here -- a field, a marker, a method's
    # receiver -- so the rule is stated once for all of them, and the call legs
    # that ask it too find the temporary already made.
    if (receiverIsValue :st :ast :unitDecl nid: dp.parent) then (
        ownedReceiverTemp
        :st
        :ast
        recvT: holdT
        recvNid: dp.parent
    )
    return bt
}

# refuseReadUnderPin -- the path at `nid` (a dotted path, or a bare name read as
# a value) is READ while another variable holds an EXCLUSIVE pin over it: the
# pin says that holder may be writing through its reference, so the source is
# read through the holder or not at all until the holder dies.
refuseReadUnderPin: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    # the root alone answers the common case: no variable holds an EXCLUSIVE
    # lock on it, so there is nothing to overlap and no path to build
    rid: rootNameIdOf :ast n: (ast.nodes.get i: nid)
    if rid.isZero then return
    rd: st.findLocal nameId: rid
    if rd.isZero then return
    if (st.hasExclusiveVarLock declId: rd).not then return
    rp: ListVal zast.nameid
    appendValueTuple :ast n: (ast.nodes.get i: nid) dst: rp
    if rp.length == 0 then return
    rvo: st.lookupVarId nameId: (rp.get i: 0)
    if rvo.none then return
    xh: st.findExclusiveVarLock path: rp
    if xh.some when (xh == (ztypes.zlockholder.var rvo)).not then {
        hn: st.formatLockHolder pool: ast.names holder: xh
        hph: st.holderPhrase pool: ast.names holder: xh
        pp: zenv.formatPath pool: ast.names path: rp.listView
        mr: "Cannot read '\{pp}': exclusive lock held by \{hph}"
        hr: "read through '\{hn}' instead, or end '\{hn}'s scope first to release the lock"
        if (st.lockHolderIsTemporary holder: xh) then hr = temporaryHint
        nr: String
        (
            addErrorWithHint
            :st
            nodeid: nid
            :lineno
            :colno
            e: zast.err.ownerError
            msg: mr
            note: nr
            hint: hr
            width: pp.length
        )
    }
}

# exprRootNameId -- the root name of an expression: a `:name` label-value
# shorthand names its local directly, any other shape its path's root.
exprRootNameId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case labelvalue then {
        return n.name
    } else {
        return (rootNameIdOf :ast :n)
    }
}

# rootIsBorrowedParam -- the expression is rooted at a `.borrow`/`.view`
# parameter or the receiver: a name bound as a parameter that is BORROWED, or
# a path through one -- or a BORROWED local reading through one, as a bare
# binding (`x: t.child`, `y: x.grandchild`) or a pinning call's reference
# result (`x: inner t`) does: such a local is the expression it was bound from.
# Such a root outlives the call; an owned local, or one whose pins reach
# storage that dies with the call (pinRootDiesWithCall), does not.
rootIsBorrowedParam: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    n: astnode.view
} out bool is {
    rn: exprRootNameId :ast :n
    if rn.isZero then return false
    vo: st.lookupVarId nameId: rn
    match (
        vo
    ) case some then {
        if (st.reg.variableOwnershipOf id: vo) != ztypes.zownership.borrowed then return false
        if (st.reg.variableOriginOf id: vo) == ztypes.zvarorigin.param then return true
        if (localHasBorrowSource :st vid: vo).not then return false
        return (pinRootDiesWithCall :st nameId: rn depth: 0).not
    } case none then {
        return false
    }
}

# localHasBorrowSource -- a borrowed local names what it reads: a lock row it
# holds, or the variable it was bound to borrow.
localHasBorrowSource: function {st: zenv.ZSymbolTable.view vid: ztypes.vid} out bool is {
    held: List ztyping.PinPath
    st.heldLockPaths holder: ztypes.zlockholder.var vid dst: held
    if held.length > 0 then return true
    return (st.reg.variableBorrowOriginOf id: vid).notZero
}

# pinsAllParamRooted -- every pin of a returned value (a just-typed call's) is
# rooted at a `.borrow`/`.view` parameter or the receiver; false when it has
# none.
pinsAllParamRooted: function {
    st: zenv.ZSymbolTable.view pins: (List ztyping.PinPath).view
} out bool is {
    if pins.length == 0 then return false
    for each p: pins loop {
        vo: st.lookupVarId nameId: (p.path.get i: 0)
        match (
            vo
        ) case some then {
            if (st.reg.variableOriginOf id: vo) != ztypes.zvarorigin.param then return false
            if (st.reg.variableOwnershipOf id: vo) != ztypes.zownership.borrowed then return false
        } case none then {
            return false
        }
    }
    return true
}

# callNodeIdOf -- the id of a call; zero for any other shape.
callNodeIdOf: function {n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case call then {
        return n.nodeid
    } else {
        return zast.nodeid
    }
}

# rootNameTextOf -- the root name of an expression as text; empty when it has
# none (a literal, a construction, a call), so the report can say so instead
# of naming a variable that does not exist.
rootNameTextOf: function {ast: Ast.view n: astnode.view} out String is {
    rn: exprRootNameId :ast :n
    if rn.isZero then return String
    return (zast.nameTextCopy :ast ref: rn)
}

# checkReturnRooting -- what a returned value may point at. A reference return
# (`outx T.borrow` / `outx T.view`) must be rooted at a `.borrow`/`.view`
# parameter or the receiver -- a local dies with this call. A construction
# returned from an `outx` function may fill a non-owned field only from such
# a root: the result's pins are on the caller's inputs, and only what the
# caller still owns can be referenced. Answers whether it reported.
checkReturnRooting: function {
    # the symbol table the reports go to
    st: zenv.ZSymbolTable
    # the tree the returned expression is read from
    ast: Ast
    # the returned argument
    arg: argref
    # its type
    argT: ztypes.tid
    # what it keeps locked (returnedPins), and its marker
    rpins: (List ztyping.PinPath).view
    marker: ztypes.zparamownership
} out bool is {
    if argT.isZero then return false
    cid: callNodeIdOf n: (ast.nodes.get i: arg.operation)
    if st.walk.fn.currentReturnMarker.isReference then {
        okRef: false
        # a call, and a control value (what its arms keep, pendReturnedPins), is
        # rooted where its pins are
        if cid.notZero or (isControlValue :ast nid: arg.operation) then {
            okRef = pinsAllParamRooted :st pins: rpins
        } else {
            okRef = rootIsBorrowedParam :st :ast n: (ast.nodes.get i: arg.operation)
        }
        if okRef.not then {
            rnm: rootNameTextOf :ast n: (ast.nodes.get i: arg.operation)
            m1: "a reference return must point into a `.borrow`/`.view` parameter; '\{rnm}' is a local and dies with this call"
            if rnm.length == 0 then {
                m1 = "a reference return must point into a `.borrow`/`.view` parameter; this expression is not rooted at one and dies with this call".string
            }
            (
                addError
                :st
                nodeid: arg.nid
                lineno: arg.lineno
                colno: arg.colno
                e: zast.err.ownerError
                msg: m1
            )
        }
        if okRef when (st.walk.fn.currentReturnMarker == ztypes.zparamownership.viewMode).not then {
            checkBorrowResultSource :st :ast :arg :cid :marker
        }
        return okRef.not
    }
    if st.walk.fn.currentFnPins.not then return false
    if cid.isZero then return false
    cr: statics.callRefAt :ast nid: cid
    isCtor: false
    cko: st.typing.callKind.get key: cid
    if cko.some then {
        if cko.classCreate then isCtor = true
        if cko.unionCreate then isCtor = true
        if cko.recordCreate then isCtor = true
    }
    mcb: callchecks.metaCreateBaseId :ast n: (ast.nodes.get i: cr.callable)
    if mcb.some then {
        isCtor = true
    }
    if isCtor.not then return false
    reported: false
    kA: u64
    for kA < cr.nargs loop {
        aid: zast.callArgAt :ast nid: cr.nid i: kA
        kA = kA + 1
        fa: argRefAt :ast nid: aid
        if fa.nid.notZero when fa.name.notZero when (
            st.typing.declIsBorrowedFieldId
            parentTypeId: argT
            nameId: fa.name
        ) then {
            srcOk: false
            fcid: callNodeIdOf n: (ast.nodes.get i: fa.operation)
            if fcid.notZero then {
                # a call's result references what its own rules allow
                srcOk = true
            } else {
                srcOk = rootIsBorrowedParam :st :ast n: (ast.nodes.get i: fa.operation)
            }
            if srcOk.not then {
                tn2: specWrittenName :st :ast tid: argT
                fld: zast.nameTextAt :ast ref: fa.name
                src: rootNameTextOf :ast n: (ast.nodes.get i: fa.operation)
                m2: "the returned `\{tn2}` stores '\{src}' in its non-owned field '\{fld}', but '\{src}' is not a `.borrow`/`.view` parameter -- an `outx` result may only reference what its caller still owns"
                if src.length == 0 then {
                    m2 = "the returned `\{tn2}` fills its non-owned field '\{fld}' from an expression that is not rooted at a `.borrow`/`.view` parameter -- an `outx` result may only reference what its caller still owns"
                }
                (
                    addError
                    :st
                    nodeid: fa.nid
                    lineno: fa.lineno
                    colno: fa.colno
                    e: zast.err.ownerError
                    msg: m2
                )
                reported = true
            }
        }
    }
    return reported
}

# checkBorrowResultSource -- a `.borrow` result lends mutability, so it may
# not be read out of a readonly source: a `.view` parameter or receiver, a
# `.view`/`.hold` field on the way, or a call whose result is a `.view`. A
# view is the most restricted ownership and converts to no other; the
# function declares `outx T.view` instead, or takes its source as `.borrow`.
# Runs after the rooting check passed, so the root is a parameter.
checkBorrowResultSource: function {
    # where the refusal lands
    st: zenv.ZSymbolTable
    # the tree the return's path is read out of
    ast: Ast
    # the return's argument, whose source is judged
    arg: argref
    # the returned call's node, zero when the return is a path
    cid: zast.nodeid
    # the returned value's marker (returnedPins)
    marker: ztypes.zparamownership
} is {
    if (isControlValue :ast nid: arg.operation) then {
        checkArmBorrowSources :st :ast :arg :marker
        return
    }
    if cid.notZero then {
        if marker == ztypes.zparamownership.viewMode then {
            (
                addError
                :st
                nodeid: arg.nid
                lineno: arg.lineno
                colno: arg.colno
                e: zast.err.ownerError
                msg: "a `.borrow` result cannot be lent from a `.view` result: a view converts to no other ownership -- declare `outx T.view`".string
            )
        }
        return
    }
    path: ListVal zast.nameid
    appendValueTuple :ast n: (ast.nodes.get i: arg.operation) dst: path
    if path.length == 0 then return
    # a no-paren auto-call is a path whose leaf is a method: what it lends is
    # the method's result, judged by the method's own flag
    lm: pathLeafMethodId :st :path
    if lm.notZero then {
        if (st.typing.returnMarkerOf tid: lm) == ztypes.zparamownership.viewMode then {
            (
                addError
                :st
                nodeid: arg.nid
                lineno: arg.lineno
                colno: arg.colno
                e: zast.err.ownerError
                msg: "a `.borrow` result cannot be lent from a `.view` result: a view converts to no other ownership -- declare `outx T.view`".string
            )
        }
        return
    }
    if (pathIsReadonly :st :path).not then return
    ff: frozenFieldInPath :st :path upTo: path.length
    m: String
    if ff.isZero then {
        rnm: rootNameTextOf :ast n: (ast.nodes.get i: arg.operation)
        m = "a `.borrow` result cannot be lent through '\{rnm}', a `.view`: a view converts to no other ownership -- declare `outx T.view`, or take '\{rnm}' as `.borrow`"
    } else {
        fnm: zast.nameTextAt :ast ref: ff
        m = "a `.borrow` result cannot be lent through the readonly field '\{fnm}': a view converts to no other ownership -- declare `outx T.view`"
    }
    addError :st nodeid: arg.nid lineno: arg.lineno colno: arg.colno e: zast.err.ownerError msg: m
}

# checkArmBorrowSources -- checkBorrowResultSource for a control value: it
# lends what each arm lends, so one arm read out of a readonly source refuses
# the value, once.
checkArmBorrowSources: function {
    st: zenv.ZSymbolTable ast: Ast arg: argref marker: ztypes.zparamownership
} is {
    leaves: ListVal zast.nodeid
    armValueLeaves :st :ast nid: arg.operation into: leaves
    errs: st.typing.errors.length
    for each lf: leaves loop {
        if st.typing.errors.length == errs then (
            checkBorrowResultSource
            :st
            :ast
            arg: (
                argref
                nid: arg.nid
                name: arg.name
                operation: lf
                lineno: arg.lineno
                colno: arg.colno
            )
            cid: (callNodeIdOf n: (ast.nodes.get i: lf))
            :marker
        )
    }
}

# reportReturnKeepsDyingStorage -- a returned value keeps its pending pins
# locked for the caller, so a pin rooted at a local or a temporary points at a
# value that dies with this call, `out` or `outx` alike, and a construction's
# fields with them. Answers whether it reported.
reportReturnKeepsDyingStorage: function {
    # where the refusal is reported
    st: zenv.ZSymbolTable
    # the tree that names the storage a pin is rooted at
    ast: Ast.view
    # the returned argument
    arg: argref
    # what it keeps locked (returnedPins)
    rpins: (List ztyping.PinPath).view
} out bool is {
    roots: ListVal zast.nameid
    for each p: rpins loop roots.append (p.path.get i: 0)
    deadNm: zast.nameid
    for each rn: roots loop {
        if deadNm.isZero when (pinRootDiesWithCall :st nameId: rn depth: 0) then deadNm = rn
    }
    if deadNm.isZero then return false
    dn: lockRootPhrase :st :ast nameId: deadNm
    m4: "Cannot return this value: it keeps \{dn} locked, which dies with this call"
    (
        addError
        :st
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
        e: zast.err.ownerError
        msg: m4
    )
    return true
}

# checkReturnCarries -- what a returned value keeps locked. A local that
# holds locks may be returned only through an `outx` function, and only when
# every lock is on a parameter or the receiver -- what the caller still owns
# and its binding will keep locked; a lock on another local would point at a
# value that dies with this call, and a plain `out` would hand the caller a
# value whose locks it cannot see. A returned CALL whose result pins a
# parameter is judged the same way.
checkReturnCarries: function {
    # where a refused return is reported
    st: zenv.ZSymbolTable
    # the tree the returned expression is read from
    ast: Ast
    # the returned argument
    arg: argref
    # its type
    argT: ztypes.tid
    # what it keeps locked (returnedPins)
    rpins: (List ztyping.PinPath).view
} is {
    if argT.isZero then return
    if (st.reg.isReftypeOf tid: argT).not then return
    an: ast.nodes.get i: arg.operation
    rbn: zast.atomNameIdOf n: an
    rvo: ztypes.vid
    if rbn.notZero then rvo = (st.lookupVarId nameId: rbn).or d: ztypes.vid
    # `return w.take`: the take moved w's locks into its value's record, which
    # the return reads (rpins)
    taken: false
    if rbn.isZero then {
        rbn = takenBareName :ast nid: (valueCoreNid :ast nid: arg.operation)
        if rbn.notZero then {
            rvo = takenLocalVar :st :ast nid: arg.operation
            taken = true
        }
    }
    if rbn.notZero then {
        if rvo.notZero then {
            # a view PARAMETER holds no locks of its own: what it views is the
            # caller's, which a plain `out` result would leave unlocked
            if (st.reg.variableOriginOf id: rvo) == ztypes.zvarorigin.param when (
                valuechecks.isViewFamilyTid
                :ast
                :st
                tid: argT
            ) when st.walk.fn.currentFnPins.not when st.walk.fn.currentReturnMarker.isReference.not then {
                pwn: zast.nameTextAt :ast ref: rbn
                pfn: declWrittenName :st :ast tid: st.walk.fn.currentFnTid
                pm: "Cannot return '\{pwn}': it views what the caller passed, which the caller cannot see because '\{pfn}' is `out`, not `outx`"
                (
                    addError
                    :st
                    nodeid: arg.nid
                    lineno: arg.lineno
                    colno: arg.colno
                    e: zast.err.ownerError
                    msg: pm
                )
                return
            }
            held: List ztyping.PinPath
            if taken then {
                for each rp: rpins loop (
                    pinsAppend
                    pins: held
                    path: rp.path
                    shared: rp.shared
                    mutable: rp.mutable
                    carried: rp.carried
                )
            } else st.heldLockPaths holder: ztypes.zlockholder.var rvo dst: held
            if held.length > 0 then {
                wn: zast.nameTextAt :ast ref: rbn
                rootPhrase: lockRootPhrase :st :ast nameId: (valuechecks.pinRootAt pins: held i: 0)
                if st.walk.fn.currentFnPins.not then {
                    fnNm: declWrittenName :st :ast tid: st.walk.fn.currentFnTid
                    m1: "Cannot return '\{wn}': it holds locks on \{rootPhrase}, which the caller cannot see because '\{fnNm}' is `out`, not `outx`"
                    (
                        addError
                        :st
                        nodeid: arg.nid
                        lineno: arg.lineno
                        colno: arg.colno
                        e: zast.err.ownerError
                        msg: m1
                    )
                    return
                }
                for each hp: held loop {
                    srcNm: hp.path.get i: 0
                    svo: st.lookupVarId nameId: srcNm
                    if svo.some when (pinRootDiesWithCall :st nameId: srcNm depth: 0) then {
                        sn: lockRootPhrase :st :ast nameId: srcNm
                        m2: "Cannot return '\{wn}': it holds locks on \{sn}, which dies with this call"
                        (
                            addError
                            :st
                            nodeid: arg.nid
                            lineno: arg.lineno
                            colno: arg.colno
                            e: zast.err.ownerError
                            msg: m2
                        )
                        return
                    }
                }
                # the locks travel with the value: the caller's binding installs
                # the callee's pins, which name these very parameters
                valuechecks.releaseCascade :st holder: ztypes.zlockholder.var rvo
            }
        }
        return
    }
    # a returned `if`, `match` or block keeps what its arms hand back
    ctlRet: isControlValue :ast nid: arg.operation
    if (reportReturnKeepsDyingStorage :st :ast :arg :rpins) then return
    # a returned call: its pending pins are what the result keeps locked
    if (callNodeIdOf n: an).isZero when ctlRet.not then return
    if st.walk.fn.currentFnPins then return
    if st.walk.fn.currentReturnMarker.isReference then return
    if rpins.length == 0 then return
    # found first, reported after: the report takes `st` while the pins are
    # being read through it
    badPn: zast.nameid
    roots: ListVal zast.nameid
    for each p: rpins loop roots.append (p.path.get i: 0)
    for each rt: roots loop {
        if badPn.isZero then badPn = paramReachedFrom :st nameId: rt depth: 0
    }
    if badPn.notZero then {
        pn: zast.nameTextAt :ast ref: badPn
        fnNm: declWrittenName :st :ast tid: st.walk.fn.currentFnTid
        what: "this call's result"
        if ctlRet then what = "this value"
        m3: "Cannot return \{what}: it keeps '\{pn}' locked, which the caller cannot see because '\{fnNm}' is `out`, not `outx`"
        (
            addError
            :st
            nodeid: arg.nid
            lineno: arg.lineno
            colno: arg.colno
            e: zast.err.ownerError
            msg: m3
        )
    }
}

# armValueLeaves -- the values the arms of the `if` or `match` at `nid` yield,
# through nested ones: what a destination sees, arm by arm.
armValueLeaves: function {
    st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid into: ListVal zast.nodeid
} is {
    if (isControlValue :ast :nid).not then return
    blocks: ListVal zast.nodeid
    valuechecks.controlArmBlocks :ast :nid into: blocks
    for each blk: blocks loop {
        av: armValueOf :st :ast blockId: blk
        if av.nid.notZero then {
            if (isControlValue :ast nid: av.nid) then {
                armValueLeaves :st :ast nid: av.nid :into
            } else {
                into.append from: av.nid
            }
        }
    }
}

# armsYieldAPlace -- a control value one of whose arms yields a PLACE: storage
# something else owns -- a local the arm does not move, a field, an element a
# call hands back. What such a value hands back is a REFERENCE on that arm's
# path, so it owns nothing, while an arm yielding a value of its own holds that
# in a temporary of its own. `armLeafPlaces` and `armLeafMoves` are where the
# arm walk recorded which is which, and the emitter's `armLeafIsPlace` reads the
# same two -- one fact, asked from both sides.
armsYieldAPlace: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} out bool is {
    if (isControlValue :ast :nid).not then return false
    leaves: ListVal zast.nodeid
    armValueLeaves :st :ast :nid into: leaves
    for each lf: leaves loop {
        if (armLeafStaysPlace :st :lf) then return true
    }
    return false
}

# armLeafStaysPlace -- the arm value `lf` reads storage something else owns and
# nothing moves it out: what it yields is a reference to that storage.
armLeafStaysPlace: function {st: zenv.ZSymbolTable.view lf: zast.nodeid} out bool is {
    if (st.typing.armLeafMoves.has item: lf) then return false
    return (st.typing.armLeafPlaces.has item: lf)
}

# armBorrowedLeaves -- the arm values read out of storage something else owns: a
# field read through names rooted in a local, or a value a call hands back pinned
# to its source. A destination that owns what it holds refuses them, one by one.
armBorrowedLeaves: function {
    st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid into: ListVal zast.nodeid
} is {
    all: ListVal zast.nodeid
    armValueLeaves :st :ast :nid into: all
    for each lf: all loop {
        n: ast.nodes.get i: lf
        if (zast.atomNameIdOf :n).isZero then into.append from: lf
    }
}

# refuseBorrowedArms -- every arm of the control value at `nid` that reads storage
# something else owns is refused `verb`, as the same value written alone is.
refuseBorrowedArms: function {
    st: zenv.ZSymbolTable
    ast: Ast
    nid: zast.nodeid
    verb: StringView
} is {
    if (isControlValue :ast :nid).not then return
    leaves: ListVal zast.nodeid
    armBorrowedLeaves :st :ast :nid into: leaves
    for each lf: leaves loop {
        ln: ast.nodes.get i: lf
        refuseBorrowedMove :st :ast n: ln vt: (walkTypeOf :st nid: lf) :verb
    }
}

# armLeafLocal -- the variable an arm's bare-name value reads, when its name still
# resolves to that variable where the value lands; zero for a local the arm
# declared itself, which has left scope and which the arm's own end moves.
armLeafLocal: function {st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid} out ztypes.vid is {
    none: ztypes.vid.zero
    av: st.typing.atomVariableId.get key: nid
    if av.none then return none
    cur: st.lookupVarId nameId: (zast.atomNameIdOf n: (ast.nodes.get i: nid))
    if cur.none then return none
    if (cur == av).not then return none
    return cur
}

# armLeafReadsRef -- an arm's bare-name value reads a reference: the type it
# reads, which inside a match arm is the narrowed payload and not the
# variable's declared sum -- a number read out of a union is a copy, and hands
# the union on no more than a number read out of a record does
armLeafReadsRef: function {st: zenv.ZSymbolTable.view nid: zast.nodeid} out bool is {
    return (st.reg.isReftypeOf tid: (walkTypeOf :st :nid))
}

# armLeafBorrowed -- an arm's bare-name value reads a borrowed variable: the
# name is a reference, whichever scope declared it
armLeafBorrowed: function {st: zenv.ZSymbolTable.view nid: zast.nodeid} out bool is {
    av: st.typing.atomVariableId.get key: nid
    if av.none then return false
    return (st.reg.variableOwnershipOf id: av) == ztypes.zownership.borrowed
}

# armLeafIsPartial -- whether a control value one of whose arm values
# (`leaves`) yields the local `from` has another that yields something else: a
# path reaches past the `if` or `match` still holding the local, so moving it
# there is a maybe -- zeroed where it happens, destroyed at the scope's
# end all the same.
armLeafIsPartial: function {
    st: zenv.ZSymbolTable ast: Ast.view leaves: (ListVal zast.nodeid).view from: ztypes.vid
} out bool is {
    for each lf: leaves loop {
        if ((armLeafLocal :st :ast nid: lf) == from).not then return true
    }
    return false
}

# markLeafTakeMaybe -- the move the arm leaf `leaf` just recorded is a maybe.
markLeafTakeMaybe: function {st: zenv.ZSymbolTable ast: Ast.view leaf: zast.nodeid} is {
    st.markTakeMaybe declId: (st.findLocal nameId: (zast.atomNameIdOf n: (ast.nodes.get i: leaf)))
}

# pinread -- a value's pins as the destination that receives it reads them
# (pinsOfValue): whether what binds it owns it -- an `outx` result, a holder
# moved out with its locks -- and the marker that makes the binding readonly
# (`.view`) or frozen (`.hold`).
pinread: record {
    # owned by what binds it, yet pinned
    owned: bool
    # the marker on the return the value came from
    marker: ztypes.zparamownership
}

# pinsOfValue -- what the value at `nid`, of type `vt`, keeps locked, appended to
# `dst` for the destination that receives it: what its walk recorded
# (recordDraft), or, when it made no pins and the destination `borrowing`
# it is a second name for it, the place it is read from -- a bare name or a
# field (placePins). A control value keeps what every arm hands back
# (pinsOfArms). `verb` says what the destination does with the value, for the
# refusal of a pin on storage that dies with an arm.
pinsOfValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    vt: ztypes.tid
    nid: zast.nodeid
    borrowing: bool
    verb: StringView
    dst: List ztyping.PinPath
} out pinread is {
    if (isControlValue :ast :nid) then return (
        pinsOfArms
        :st
        :ast
        :vt
        :nid
        borrowing: true
        writes: true
        :verb
        :dst
    )
    vp: valuePinsOf :st :nid
    if vp.len > 0 then {
        appendRecordPins :st :vp :dst
    } else if borrowing then {
        placePins :st :ast :vt :nid :dst
    }
    return (pinread owned: vp.owned marker: vp.marker)
}

# returnedPins -- what a returned value keeps locked, onto `dst` for the return
# checks: an `if`, `match` or block's arms (pinsOfArms; an arm's place is handed
# back only by a reference or a view), any other value's record.
returnedPins: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    argT: ztypes.tid
    dst: List ztyping.PinPath
} out pinread is {
    nid: arg.operation
    if (isControlValue :ast :nid) then {
        retBorrows: (
            (valuechecks.isViewFamilyTid :ast :st tid: argT) or
            st.walk.fn.currentReturnMarker.isReference
        )
        return (
            readValuePins
            :st
            :ast
            vt: argT
            :nid
            borrowing: retBorrows
            writes: true
            verb: "return"
            :dst
        )
    }
    vp: valuePinsOf :st :nid
    appendRecordPins :st :vp :dst
    return (pinread owned: vp.owned marker: vp.marker)
}

# appendRecordPins -- a copy of each pin of the record `vp` onto `dst`.
appendRecordPins: function {
    st: zenv.ZSymbolTable.view vp: ztyping.valuepins dst: List ztyping.PinPath
} is {
    k: u64
    for k < vp.len loop {
        p: st.walk.value.pins.get i: vp.start.u64 + k
        k = k + 1
        dst.append (
            ztyping.PinPath
            path: p.path.copy
            shared: p.shared
            mutable: p.mutable
            carried: p.carried
        )
    }
}

# readValuePins -- what the value at `nid`, of type `vt`, keeps locked, for a
# destination that reads it whole, appended to `dst`: an `if`, `match` or
# block's arms hand over theirs (pinsOfArms, which reports a pin on storage that
# dies with an arm), any other value its record. `borrowing` and `writes` are
# pinsOfArms'.
readValuePins: function {
    st: zenv.ZSymbolTable
    ast: Ast
    vt: ztypes.tid
    nid: zast.nodeid
    borrowing: bool
    writes: bool
    verb: StringView
    dst: List ztyping.PinPath
} out pinread is {
    if (isControlValue :ast :nid).not then {
        vp: valuePinsOf :st :nid
        appendRecordPins :st :vp :dst
        return (pinread owned: vp.owned marker: vp.marker)
    }
    return (pinsOfArms :st :ast :vt :nid :borrowing :writes :verb :dst)
}

# placePins -- `b: h.p` or `b: a`, a reftype read whole from a field or a name:
# the binding is a SECOND NAME for that place, not a transfer of it, so it pins
# the path exactly as `b: h.p.borrow` does -- a write to it, a move out of it or
# a mutating method on it is refused while `b` lives, and `b` cannot escape as
# owned. `.take` is the one spelling that moves. Through a readonly root the
# second name is readonly too, which is what keeps a rename from laundering a
# borrow into an owned value.
placePins: function {
    st: zenv.ZSymbolTable ast: Ast.view vt: ztypes.tid nid: zast.nodeid dst: List ztyping.PinPath
} is {
    n0: dst.length
    fieldReadPin :st :ast :vt :nid writes: true :dst
    if dst.length > n0 then return
    if (st.reg.isReftypeOf tid: vt).not then return
    # a TYPE name or a zero-arg function resolves to no variable: those
    # construct or call rather than naming storage, and the binding owns what
    # they hand back
    bn: zast.atomNameIdOf n: (ast.nodes.get i: nid)
    if bn.isZero then return
    if (st.lookupVarId nameId: bn).none then return
    np: ListVal zast.nameid
    np.append bn
    mw: (pathIsReadonly :st path: np).not
    pinsAppend pins: dst path: np shared: true mutable: mw carried: false
}

# fieldReadPin -- the pin a reftype field read at `nid` places: a field is always
# borrowed, whatever owns its parent.
fieldReadPin: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    vt: ztypes.tid
    nid: zast.nodeid
    # the destination may write through the field
    writes: bool
    dst: List ztyping.PinPath
} is {
    if (st.reg.isReftypeOf tid: vt).not then return
    fp: ListVal zast.nameid
    vn: ast.nodes.get i: nid
    if (isMarkedMove :ast n: vn) then return
    # a field read off a value no name holds is part of that value: the pin is
    # rooted at the temporary its read holds the value in, which then lives as
    # long as the pin
    fields: ListVal zast.nameid
    base: fieldChainBase :st :ast :nid :fields
    if base != nid then {
        btn: st.walk.value.tempNameOf.get key: base
        if btn.some then {
            holdUnnamedLocal :st recvNid: base tnId: btn dst: fp
            for each f: fields loop fp.append f
            pinsAppend pins: dst path: fp shared: true mutable: writes carried: false
            return
        }
    }
    if (movedFieldPath :st :ast n: vn).not then return
    appendValueTuple :ast n: vn dst: fp
    if fp.length < 2 then return
    if (st.lookupVarId nameId: (fp.get i: 0)).none then return
    # through a readonly root the second name is readonly too
    mw: (pathIsReadonly :st path: fp).not and writes
    pinsAppend pins: dst path: fp shared: true mutable: mw carried: false
}

# pinsOfArms -- `b: if c then w else h.p`: each arm hands back what that value
# bound alone would pin -- a local of an enclosing scope, a field, what a call
# hands back (its record) -- so the binding is a second name for whichever the
# arm that ran yields. The arms' pins are one set: a path two arms pin is locked
# once, at the stronger strength. The value is readonly when any arm's is
# (armLeafMarker), and then the destination writes through none of its arms. It
# is owned only when an arm hands back an `outx` result and none hands back a
# place.
pinsOfArms: function {
    st: zenv.ZSymbolTable
    ast: Ast
    vt: ztypes.tid
    nid: zast.nodeid
    # the destination is a second name for a place an arm yields
    borrowing: bool
    # ... and may write through it
    writes: bool
    verb: StringView
    dst: List ztyping.PinPath
} out pinread is {
    leaves: ListVal zast.nodeid
    armValueLeaves :st :ast :nid into: leaves
    marker: ztypes.zparamownership.noneMode
    for each mf: leaves loop {
        marker = readonlyMarker a: marker b: (armLeafMarker :st :ast :vt leaf: mf :borrowing)
    }
    aw: writes and (marker == ztypes.zparamownership.noneMode)
    owned: false
    place: false
    arms: List ztyping.PinPath
    for each lf: leaves loop {
        if (armLeafPins :st :ast :vt leaf: lf :borrowing writes: aw :verb dst: arms
        ) then owned = true
        if (
            (armLeafLocal :st :ast nid: lf).notZero or (st.typing.armLeafPlaces.has item: lf)
        ) then place = true
    }
    mergePins pins: arms :dst
    return (pinread owned: owned and place.not :marker)
}

# armLeafMarker -- the marker the arm value `leaf` gives the destination:
# readonly (`.view`) when a destination `borrowing` it is a second name for a
# place read out of a readonly path, as `b: h.p` is (valueReadsReadonlyPlace);
# else what the value's walk recorded, when armLeafPins counts that record.
armLeafMarker: function {
    st: zenv.ZSymbolTable
    ast: Ast
    vt: ztypes.tid
    leaf: zast.nodeid
    borrowing: bool
} out ztypes.zparamownership is {
    rom: ztypes.zparamownership.noneMode
    if borrowing when (valueReadsReadonlyPlace :st :ast nid: leaf :vt) then {
        rom = ztypes.zparamownership.viewMode
    }
    if (armLeafLocal :st :ast nid: leaf).notZero then return rom
    vp: valuePinsOf :st nid: leaf
    if borrowing.not when vp.owned.not when (valuechecks.isViewFamilyTid :ast :st tid: vt
    ).not then return rom
    return (readonlyMarker a: vp.marker b: rom)
}

# armLeafPins -- what the arm value `leaf` hands the destination, onto `dst`: a
# place (a local of an enclosing scope, a field) when the destination is a second
# name for it, and what the value's walk recorded. A destination that takes
# ownership counts only a value of the arm's own -- a lent one is refused arm by
# arm (refuseBorrowedArms). Answers whether the arm's value is owned by what
# binds it.
armLeafPins: function {
    st: zenv.ZSymbolTable
    ast: Ast
    vt: ztypes.tid
    leaf: zast.nodeid
    borrowing: bool
    writes: bool
    verb: StringView
    dst: List ztyping.PinPath
} out bool is {
    from: armLeafLocal :st :ast nid: leaf
    if from.notZero then {
        if borrowing then armLocalPin :st :ast :leaf :writes :dst
        return false
    }
    if borrowing then fieldReadPin :st :ast :vt nid: leaf :writes :dst
    vp: valuePinsOf :st nid: leaf
    # a lent view's copy views what it viewed: it hands its pins on as an
    # owned value does
    if borrowing.not when vp.owned.not when (valuechecks.isViewFamilyTid :ast :st tid: vt
    ).not then return false
    pinned: armRecordPins :st :ast :leaf :vp :verb :dst
    return pinned and vp.owned
}

# armLocalPin -- an arm `leaf` that yields a bare reference local of an
# enclosing scope: the binding is a second name for it on that arm's path, so
# it pins it as `b: w` does, readonly through a readonly local.
armLocalPin: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    leaf: zast.nodeid
    # the destination may write through the local
    writes: bool
    dst: List ztyping.PinPath
} is {
    if (armLeafReadsRef :st nid: leaf).not then return
    np: ListVal zast.nameid
    np.append (zast.atomNameIdOf n: (ast.nodes.get i: leaf))
    mw: (pathIsReadonly :st path: np).not and writes
    pinsAppend pins: dst path: np shared: true mutable: mw carried: false
}

# armRecordPins -- the record `vp` of the arm value `leaf`, onto `dst`: an
# element a call hands back, and an `outx` result, pin their source as they do
# bound alone. A pin rooted at storage the arm declared is refused: it dies
# with the arm. True when the arm hands back pins.
armRecordPins: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    leaf: zast.nodeid
    vp: ztyping.valuepins
    verb: StringView
    dst: List ztyping.PinPath
} out bool is {
    if vp.len == 0 then return false
    k: u64
    for k < vp.len loop {
        i: vp.start.u64 + k
        k = k + 1
        root: valuePinRoot :st :i
        was: st.walk.value.pinRoots.get :i
        now: (st.lookupVarId nameId: root).or d: ztypes.vid
        if was.notZero when now != was then {
            reportArmKeepsDyingStorage :st :ast :leaf :root rootVid: was :verb
            return false
        }
    }
    appendRecordPins :st :vp :dst
    return true
}

# mergePins -- `pins` onto `dst` as one set: a path pinned twice is locked once,
# exclusive when either pin is, writable when either may write, carried when
# either came with a moved value; a path under one the set locks exclusive is
# covered by that lock (pinPathCovered).
mergePins: function {pins: (List ztyping.PinPath).view dst: List ztyping.PinPath} is {
    i: u64
    for i < pins.length loop {
        if (pinPathSeenBefore :pins :i).not when (pinPathCovered :pins :i).not then {
            dst.append (mergedPin :pins :i)
        }
        i = i + 1
    }
}

# pinPathCovered -- pin `i`'s path lies under a shorter path another pin of the
# set locks exclusive (`d: if c then o.first else o.b`, `first` lending `o`):
# that lock already keeps every other holder off the longer path, so locking
# it as well adds nothing, and would set the one holder against itself. A pin
# carried with a moved value is kept.
pinPathCovered: function {pins: (List ztyping.PinPath).view i: u64} out bool is {
    p: pins.get :i
    if p.carried then return false
    j: u64
    for j < pins.length loop {
        q: pins.get i: j
        qx: q.shared.not or q.mutable
        if qx when q.path.length < p.path.length when (
            zenv.isPrefix
            p: q.path.listView
            whole: p.path.listView
        ) then return true
        j = j + 1
    }
    return false
}

# pinPathSeenBefore -- whether pin `i` locks a path an earlier pin locks.
pinPathSeenBefore: function {pins: (List ztyping.PinPath).view i: u64} out bool is {
    p: pins.get :i
    j: u64
    for j < i loop {
        q: pins.get i: j
        if (zenv.pathsEqual a: q.path.listView b: p.path.listView) then return true
        j = j + 1
    }
    return false
}

# mergedPin -- pin `i` joined with every later pin on its path.
mergedPin: function {pins: (List ztyping.PinPath).view i: u64} out ztyping.PinPath is {
    p: pins.get :i
    sh: p.shared
    mu: p.mutable
    ca: p.carried
    k: i + 1
    for k < pins.length loop {
        r: pins.get i: k
        if (zenv.pathsEqual a: r.path.listView b: p.path.listView) then {
            sh = sh and r.shared
            mu = mu or r.mutable
            ca = ca or r.carried
        }
        k = k + 1
    }
    return (ztyping.PinPath path: p.path.copy shared: sh and mu.not mutable: mu carried: ca)
}

# readonlyMarker -- the marker of a value whose arms are marked `a` and `b`:
# readonly (`.view`) when either is, else frozen (`.hold`) when either is.
readonlyMarker: function {
    a: ztypes.zparamownership b: ztypes.zparamownership
} out ztypes.zparamownership is {
    if (a == ztypes.zparamownership.viewMode) or (b == ztypes.zparamownership.viewMode) then {
        return ztypes.zparamownership.viewMode
    }
    if (a == ztypes.zparamownership.holdMode) or (b == ztypes.zparamownership.holdMode) then {
        return ztypes.zparamownership.holdMode
    }
    return ztypes.zparamownership.noneMode
}

# valuePinRoot -- the name recorded pin `i` is rooted at.
valuePinRoot: function {st: zenv.ZSymbolTable.view i: u64} out zast.nameid is {
    p: st.walk.value.pins.get :i
    return (p.path.get i: 0)
}

# reportArmKeepsDyingStorage -- the arm value `leaf` keeps `root` locked, and
# `root` is storage the arm, block or `with` declared, which dies as it ends.
reportArmKeepsDyingStorage: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    leaf: zast.nodeid
    root: zast.nameid
    # the variable `root` named where the value was made, which died with the
    # arm and resolves no more
    rootVid: ztypes.vid
    verb: StringView
} is {
    dn: lockRootPhrase :st :ast nameId: root :rootVid
    m: "Cannot \{verb} this value: it keeps \{dn} locked, which dies with the scope that declares it"
    ln: ast.nodes.get i: leaf
    (
        addError
        :st
        nodeid: leaf
        lineno: (nodeLine n: ln)
        colno: (nodeCol n: ln)
        e: zast.err.ownerError
        msg: m
    )
}

# recordArmValueLocks -- the last line of a block yields its value: when that
# is a local the block declared, the value hands over the locks the local holds
# (recordHandedBackLocks), which a binding of the `if` or `match` the block is
# an arm of pins as what the arm that ran hands back (pinArmValue).
recordArmValueLocks: function {st: zenv.ZSymbolTable ast: Ast.view lineId: zast.nodeid} is {
    (
        recordHandedBackLocks
        :st
        :ast
        valNid: (
            implicitReturnValue
            reg: st.reg
            typing: st.typing
            :ast
            :lineId
            lineType: (walkTypeOf :st nid: lineId)
        )
    )
}

# recordHandedBackLocks -- a value that is a local this scope declared hands
# over the locks it holds: they end with the scope, and what binds the value
# keeps them instead, after what its own walk keeps (the record). An OWNED local
# moves out with its locks: what binds it owns it, as it owns an `outx` result.
recordHandedBackLocks: function {st: zenv.ZSymbolTable ast: Ast.view valNid: zast.nodeid} is {
    if valNid.isZero then return
    handBackLocalLocks :st :ast :valNid
    followDyingReferences :st nid: valNid
}

# handBackLocalLocks -- recordHandedBackLocks for a value that is a local this
# scope declared: its held locks join the value's record.
handBackLocalLocks: function {st: zenv.ZSymbolTable ast: Ast.view valNid: zast.nodeid} is {
    bn: zast.atomNameIdOf n: (ast.nodes.get i: valNid)
    if bn.isZero then return
    if (st.scopeBindsHere nameId: bn).not then return
    hv: st.lookupVarId nameId: bn
    if hv.some then {
        held: List ztyping.PinPath
        st.heldLockPaths holder: ztypes.zlockholder.var hv dst: held
        movedOut: (st.reg.variableOwnershipOf id: hv) == ztypes.zownership.owned
        recordWithLocks :st :valNid :held :movedOut
    }
}

# followDyingReferences -- a value a block hands back that keeps a REFERENCE the
# block declared locked -- a borrowed local, a hoisted temporary -- keeps what
# that reference borrows instead: the reference dies with the block, and what
# it borrows does not, as a return follows a borrowed local (pinRootDiesWithCall).
# Storage the block declared stays, and the destination refuses it.
followDyingReferences: function {st: zenv.ZSymbolTable nid: zast.nodeid} is {
    vp: valuePinsOf :st :nid
    if vp.len == 0 then return
    own: List ztyping.PinPath
    appendRecordPins :st :vp dst: own
    followed: List ztyping.PinPath
    changed: false
    for each p: own loop {
        if (appendFollowedPin :st :p dst: followed depth: 0) then changed = true
    }
    if changed.not then return
    start: st.walk.value.pins.length
    for each fp: followed loop appendValuePin :st p: fp
    (
        st.setValuePins
        :nid
        vp: (
            ztyping.valuepins
            start: start.u32.orPanic
            len: followed.length.u32.orPanic
            owned: vp.owned
            marker: vp.marker
        )
    )
}

# appendFollowedPin -- `p` onto `dst`, or, when it is rooted at a reference this
# scope declares, what that reference holds (followed in turn). True when it
# followed one.
appendFollowedPin: function {
    st: zenv.ZSymbolTable.view
    p: ztyping.PinPath.view
    dst: List ztyping.PinPath
    depth: u64
    # the variable that will hold the pins, when the reference is followed for
    # outliving IT rather than for dying with this scope (dyingReference)
    holder: ztypes.vid.zero
} out bool is {
    rn: p.path.get i: 0
    rv: dyingReference :st nameId: rn :depth :holder
    if rv.isZero then {
        dst.append (
            ztyping.PinPath
            path: p.path.copy
            shared: p.shared
            mutable: p.mutable
            carried: p.carried
        )
        return false
    }
    held: List ztyping.PinPath
    st.heldLockPaths holder: ztypes.zlockholder.var rv dst: held
    # a readonly self-lock marks the reference itself; it borrows nothing
    for each hp: held loop {
        if (hp.path.get i: 0) != rn then {
            appendFollowedPin :st p: hp :dst depth: depth + 1 :holder
        }
    }
    return true
}

# dyingReference -- the variable `nameId` names when it is a reference -- a
# borrowed local, a hoisted temporary -- that dies while what it borrows does
# not: one this scope declares, or, given a `holder`, one whose scope does not
# enclose the holder's (a re-point in an arm at the arm's reference); zero for
# anything else.
dyingReference: function {
    st: zenv.ZSymbolTable.view
    nameId: zast.nameid
    depth: u64
    # when set, the reference dies before THIS variable: its scope does not
    # enclose the holder's, wherever it is declared
    holder: ztypes.vid.zero
} out ztypes.vid is {
    if depth >= 8 then return ztypes.vid
    if holder.isZero when (st.scopeBindsHere :nameId).not then return ztypes.vid
    rv: (st.lookupVarId :nameId).or d: ztypes.vid
    if rv.isZero then return rv
    # a parameter is the caller's storage: no scope of the body's ends it
    if (st.reg.variableOriginOf id: rv) == ztypes.zvarorigin.param then return ztypes.vid
    if holder.notZero when (
        st.scopeEncloses
        outer: (st.scopeOfVar vid: rv)
        inner: (st.scopeOfVar vid: holder)
    ) then return ztypes.vid
    if (st.reg.variableOwnershipOf id: rv) != ztypes.zownership.borrowed then return ztypes.vid
    return rv
}

# recordWithLocks -- the value at `valNid` keeps `held` as well as what its
# record holds, and is owned by what binds it when it moved out.
recordWithLocks: function {
    st: zenv.ZSymbolTable
    valNid: zast.nodeid
    held: (List ztyping.PinPath).view
    movedOut: bool
} is {
    own: valuePinsOf :st nid: valNid
    if held.length == 0 when own.len == 0 then return
    cps: List ztyping.PinPath
    roots: ListVal ztypes.vid
    k: u64
    for k < own.len loop {
        i: own.start.u64 + k
        k = k + 1
        roots.append (st.walk.value.pinRoots.get :i)
        p: st.walk.value.pins.get :i
        cps.append (
            ztyping.PinPath
            path: p.path.copy
            shared: p.shared
            mutable: p.mutable
            carried: p.carried
        )
    }
    start: st.walk.value.pins.length
    rev: List ztyping.PinPath
    for cps.length > 0 loop rev.append cps.pop
    for rev.length > 0 loop st.walk.value.pins.append rev.pop
    for each r: roots loop st.walk.value.pinRoots.append r
    for each hp: held loop appendValuePin :st p: hp
    (
        st.setValuePins
        nid: valNid
        vp: (
            ztyping.valuepins
            start: start.u32.orPanic
            len: (st.walk.value.pins.length - start).u32.orPanic
            owned: own.owned or movedOut
            marker: own.marker
        )
    )
}

# takenNameText -- the name `w` of a value written `w.take`, as a report spells
# it
takenNameText: function {ast: Ast.view nid: zast.nodeid} out String is {
    return (zast.nameTextCopy :ast ref: (takenBareName :ast nid: (valueCoreNid :ast :nid)))
}

# takenLocalVar -- the local a value written `w.take` moves out of, zero when
# the value is not one.
takenLocalVar: function {
    st: zenv.ZSymbolTable.view ast: Ast.view nid: zast.nodeid
} out ztypes.vid is {
    tn: takenBareName :ast nid: (valueCoreNid :ast :nid)
    if tn.isZero then return ztypes.vid
    td: st.findLocal nameId: tn
    if td.isZero then return ztypes.vid
    return (st.typing.declLocalVarOf declId: td)
}

# refuseStaticListStatement -- a list's name written alone as a statement.
# Its value is a view of constants, so evaluating it does nothing. True when
# `vt`, the statement's type, is a block and was refused.
refuseStaticListStatement: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    vt: ztypes.tid
    nid: zast.nodeid
} out bool is {
    if vt.isZero or ((listRowOfNode :st :nid) == 0) then return false
    tp: ListVal zast.nameid
    appendValueTuple :ast n: (ast.nodes.get i: nid) dst: tp
    pp: zenv.formatPath pool: ast.names path: tp.listView
    ln: u32
    co: u32
    vn: ast.nodes.get i: nid
    ln = nodeLine n: vn
    co = nodeCol n: vn
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: ln
        colno: co
        e: zast.err.typeError
        msg: "'\{pp}' alone does nothing: a list's value is a view of constants"
        note: String
        hint: "bind it, pass it, or read an element".string
        width: pp.length
    )
    return true
}

# refuseArmLeavesIntoOwned -- `r = if c then w else ..` into an owned target: an
# arm that yields a bare reftype local yields a borrow, which the target's mode
# refuses as `r = w` alone is refused (reportModeChange); `w.take` moves.
refuseArmLeavesIntoOwned: function {st: zenv.ZSymbolTable ast: Ast rasgn: reasgref} is {
    if (isControlValue :ast nid: rasgn.value).not then return
    leaves: ListVal zast.nodeid
    armValueLeaves :st :ast nid: rasgn.value into: leaves
    for each lf: leaves loop {
        from: armLeafLocal :st :ast nid: lf
        if from.notZero when (armLeafReadsRef :st nid: lf) then {
            (
                reportModeChange
                :st
                :ast
                :rasgn
                targetHeld: false
                vmode: "borrowed"
                value: lf
            )
        }
    }
}

# exprTextOf -- the spelling of a value built from names, member reads and calls
# with their arguments (`l.get i: 0`), appended to `dst` for a report; any other
# part reads `(...)`.
exprTextOf: function {ast: Ast.view n: astnode.view dst: String} is {
    match (
        n
    ) case atomid then {
        dst.append (zast.nameTextAt :ast ref: n.name)
    } case dottedpath then {
        exprTextOf :ast n: (ast.nodes.get i: n.parent) :dst
        dst.append "."
        exprTextOf :ast n: (ast.nodes.get i: n.child) :dst
    } case call then {
        exprTextOf :ast n: (ast.nodes.get i: n.callable) :dst
        for each argId: (zast.kidsOf :ast span: n.arguments) loop {
            argTextOf :ast arg: (argRefAt :ast nid: argId) :dst
        }
    } else {
        dst.append "(...)"
    }
}

# argTextOf -- one argument of a call as exprTextOf spells it: ` label: value`,
# a nested call in parentheses.
argTextOf: function {ast: Ast.view arg: argref dst: String} is {
    dst.append " "
    if arg.name.notZero then {
        dst.append (zast.nameTextAt :ast ref: arg.name)
        dst.append ": "
    }
    nested: (ast.nodes.get i: arg.operation).call
    if nested then dst.append "("
    exprTextOf :ast n: (ast.nodes.get i: arg.operation) :dst
    if nested then dst.append ")"
}

# borrowedValueText -- the spelling of `n` when it is read out of storage
# something else owns -- a field read through names (`h.p`), or a value a call
# hands back pinned to its source (`l.get i: 0`) -- and its type has something to
# destroy; "" otherwise. Moving such a value gives its storage a second owner.
borrowedValueText: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    n: astnode.view
    vt: ztypes.tid
    # a value whose walk left pins and owns nothing is borrowed (its record);
    # false where the caller judges those pins itself
    byPins: true
} out String is {
    none: String
    if vt.isZero then return none
    if (st.reg.isReftypeOf tid: vt).not then return none
    if (st.reg.needsDestructor typeId: vt).not then return none
    if (isMarkedMove :ast :n) then return none
    txt: String
    if (localFieldPath :st :ast :n) then {
        exprTextOf :ast :n dst: txt
        return txt
    }
    if (callHandsBackBorrow :st :ast :n) then {
        exprTextOf :ast :n dst: txt
        return txt
    }
    if byPins.not then return none
    vp: valuePinsOf :st nid: (zast.nodeIdOf :n)
    if vp.len == 0 then return none
    if vp.owned then return none
    exprTextOf :ast :n dst: txt
    return txt
}

# dottedLendsResult -- the method a dotted path auto-calls declares a borrow
# return, so reading the path hands back a view INTO its base. This is the path
# form of what `callHandsBackBorrow` answers for a call that is written as one:
# `c.label` and `(c.label)` lend the same thing, and only the second is a `call`
# node.
dottedLendsResult: function {st: zenv.ZSymbolTable nid: zast.nodeid} out bool is {
    rdo: st.typing.refDecl.get key: nid
    if rdo.none then return false
    rd: st.typing.decls.get i: rdo
    if (rd.kind.methodDecl or rd.kind.funcDecl).not then return false
    return (st.typing.returnsReference tid: rd.typeId)
}

# valueIsLent -- the value at `nid` is one whose storage belongs to something
# else, so a temporary holding it owns nothing: a call, or a path that
# auto-calls one, whose callee declares a borrow return; a field read off such a
# value; or a control value one
# of whose arms yields a place, which makes the whole value a reference on that
# arm's path. Both sides of a lifetime ask this -- the mint below and the
# argument hoist -- so the two cannot drift apart.
valueIsLent: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} out bool is {
    if (callHandsBackBorrow :st :ast n: (ast.nodes.get i: nid)) then return true
    # a FIELD read off a lent value is lent too: `(hs.get i: 0).parts` is
    # storage the list's element owns. A valtype field is read by copy, and the
    # copy is the temporary's own
    fbase: zast.nodeid
    fReft: st.reg.isReftypeOf tid: (walkTypeOf :st :nid)
    {
        n: ast.nodes.get i: nid
        if fReft when n.dottedpath when (
            memberReadIsField
            :st
            parentNid: n.parent
            nameId: (dottedMemberId :st :ast :nid child: n.child)
        ) then fbase = n.parent
    }
    if fbase.notZero when (valueIsLent :st :ast nid: fbase) then return true
    return (armsYieldAPlace :st :ast :nid)
}

# callHandsBackBorrow -- the call `n` hands back a value pinned to its source,
# because its callee's return carries `.borrow` (an element read off a
# container). Asked of a value whose pins are no longer pending: an arm of an
# `if` or a `match` is walked long before the destination sees it.
callHandsBackBorrow: function {st: zenv.ZSymbolTable ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case call then {
        cal: ast.nodes.get i: n.callable
        ft: walkTypeOf :st nid: (nodeId n: cal)
        if ft.notZero when (st.typing.returnsReference tid: ft) then return true
        ch: memberaccess.dottedChildNameId :ast n: cal
        if ch.isZero then return false
        rt: walkTypeOf :st nid: (dottedReceiverNodeId :ast n: cal)
        if rt.isZero then return false
        mo: st.typing.declChildOfId parentTypeId: rt nameId: ch
        match (
            mo
        ) case some then {
            return (st.typing.returnsReference tid: mo)
        } case none then {
            return false
        }
    } case dottedpath then {
        return (dottedLendsResult :st nid: n.nodeid)
    } else {
        return false
    }
}

# localFieldPath -- `n` is a field read through names rooted in a local
# (movedFieldPath): not an arm or a constant reached through a type.
localFieldPath: function {st: zenv.ZSymbolTable ast: Ast.view n: astnode.view} out bool is {
    if (movedFieldPath :st :ast :n).not then return false
    root: rootNameIdOf :ast :n
    if root.isZero then return false
    return (st.lookupVarId nameId: root).some
}

# reassignValueMode -- the mode a reassignment's value `n` is written in when
# it is not owned: "held" for `.hold`, "borrowed" for `.borrow` or for an
# unmarked reftype place -- a variable, or a field read through one -- which is
# a borrow. "" for an owned value (`.take`, a call's result, a construction)
# and, while its type `vt` is not known yet, for an unmarked one.
reassignValueMode: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    n: astnode.view
    vt: ztypes.tid
} out StringView is {
    mk: zast.markerKindOf :ast :n
    if mk.holdMarker then return "held"
    if mk.borrowMarker then return "borrowed"
    if mk.unmarked.not then return ""
    if vt.isZero or (st.reg.isReftypeOf tid: vt).not then return ""
    bn: zast.atomNameIdOf :n
    if bn.notZero then {
        if (st.lookupVarId nameId: bn).none then return ""
        return "borrowed"
    }
    if (localFieldPath :st :ast :n) then return "borrowed"
    return ""
}

# reportModeChange -- the refusal of storing a `vmode` value, at `value`, in
# the reassignment's owned or held target.
reportModeChange: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
    targetHeld: bool
    vmode: StringView
    value: zast.nodeid
} is {
    tmode: "owned"
    if targetHeld then tmode = "held"
    tt: String
    exprTextOf :ast n: (ast.nodes.get i: rasgn.topath) dst: tt
    mm: "Cannot reassign \{tmode} '\{tt}' with a \{vmode} value: a reassignment keeps the ownership its target was bound with"
    vn: ast.nodes.get i: value
    (
        addError
        :st
        nodeid: value
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
        e: zast.err.ownerError
        msg: mm
    )
}

# refuseBorrowedReassign -- `r = v` into a target that owns what it holds -- an
# owned local, a field -- refuses a borrowed `v` (refuseBorrowedMove). A borrowed
# local target rebinds its reference instead.
refuseBorrowedReassign: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
    # the target's bare name, zero when the target is a path
    targetNameId: zast.nameid
    # the assigned value's type
    rvt: ztypes.tid
} is {
    if targetNameId.notZero then {
        tvo: st.lookupVarId nameId: targetNameId
        if tvo.some when (isBorrowedVar :st vid: tvo) then return
    }
    (
        refuseBorrowedMove
        :st
        :ast
        n: (ast.nodes.get i: rasgn.value)
        vt: rvt
        verb: "by reassignment"
    )
}

# refuseBorrowedTake -- a value pinned to storage something else owns -- a field,
# an element a call hands back -- cannot be taken by a parameter
# (refuseBorrowedMove).
refuseBorrowedTake: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    n: astnode.view
    vt: ztypes.tid
    # borrowedValueText's
    byPins: true
} is {
    refuseBorrowedMove :st :ast :n :vt verb: "into a `.take` parameter" :byPins
}

# refuseBorrowedMove -- a borrowed value (borrowedValueText) moved `verb` into
# storage that owns what it holds is refused, as moving a borrowed name is.
refuseBorrowedMove: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    n: astnode.view
    vt: ztypes.tid
    verb: StringView
    # borrowedValueText's
    byPins: true
} out bool is {
    bt: borrowedValueText :st :ast :n :vt :byPins
    if bt.length == 0 then return false
    borrowedMoveError :st :ast :n text: bt.stringView :verb
    return true
}

# borrowedMoveError -- the refusal of moving the borrowed value `n`, spelt `text`,
# `verb` into storage that owns what it holds. A field and a value a call lends
# are not borrowed names, so each is refused for its own reason.
borrowedMoveError: function {
    st: zenv.ZSymbolTable ast: Ast.view n: astnode.view text: StringView verb: StringView
} is {
    mbvKeep: keepSourceHint :st :ast name: text
    mbv: "Cannot move borrowed variable '\{text}' \{verb} — borrowed names stay bound to their source for the full scope\{mbvKeep}"
    if (localFieldPath :st :ast :n) then {
        mbv = "Cannot move field '\{text}' \{verb}: a field stays in its owner for as long as the owner lives; copy it (`.copy`), or exchange it for another value with `swap`"
    } else if (callHandsBackBorrow :st :ast :n) then {
        mbv = "Cannot move '\{text}' \{verb}: the call lends a value that its source still owns; copy it (`.copy`)"
    }
    # a borrowed BOX is a call, not a name: what makes one that owns is the
    # source's marker
    bck: st.typing.callKind.get key: (nodeId :n)
    if bck.some when (
        (bck == zast.callkind.protocolBorrow) or (bck == zast.callkind.facetBorrow)
    ) then {
        mbv = "Cannot move '\{text}' \{verb}: it is a borrowed box, bound to its source for the full scope -- take the source (`.take`, or no marker) for a box that owns it"
    }
    (
        addError
        :st
        nodeid: (nodeId :n)
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.ownerError
        msg: mbv
    )
}

# withValueOwnership -- the with-binding's ownership from the bound value's
# syntactic shape, the same rules as a function argument: a bare
# name bound to a runtime variable or a field read through names borrows;
# `.take` transfers; a value whose storage belongs to something else
# (valueIsLent: a control value an arm of which yields a place, a call that
# lends) borrows; other calls -- an auto-called member among them -- literals
# and constructions are fresh owned values.
withValueOwnership: function {
    ast: Ast
    st: zenv.ZSymbolTable
    nid: zast.nodeid
} out ztypes.zownership is {
    lent: (isControlValue :ast :nid) and (valueIsLent :st :ast :nid)
    if lent then return ztypes.zownership.borrowed
    v: ast.nodes.get i: nid
    match (
        v
    ) case atomid then {
        vNm: ast.names.texts.get i: v.name
        vo: st.lookupVarId nameId: (nameIdOf :ast name: vNm.stringView)
        match (
            vo
        ) case some then {
            return ztypes.zownership.borrowed
        } case none then {
            return ztypes.zownership.owned
        }
    } case dottedpath then {
        if (zast.markerKindOfLeaf :ast leaf: v.child).takeMarker then return ztypes.zownership.owned
        if (movedFieldPath :st :ast n: (ast.nodes.get i: v.nodeid)
        ) then return ztypes.zownership.borrowed
        return ztypes.zownership.owned
    } else {
        return ztypes.zownership.owned
    }
}

# withValueIsMemberCall -- the with-bound value is an auto-called member of a
# path (`TEXT.lines`): a value of its own, which may still look into the path
# it was called on without its signature saying so.
withValueIsMemberCall: function {
    st: zenv.ZSymbolTable.view ast: Ast.view v: astnode.view
} out bool is {
    match (
        v
    ) case dottedpath then {
        if (isMoveMarkerId nameId: (atomNameId :ast n: (ast.nodes.get i: v.child))
        ) then return false
        return (movedFieldPath :st :ast n: (ast.nodes.get i: v.nodeid)).not
    } else {
        return false
    }
}

# forValueNode -- the node a `for` body yields as its value: the last line's
# value, or 0 when it yields none. It is the node lastStmtType reads the type
# of, so the two always speak about the same expression.
forValueNode: function {
    st: zenv.ZSymbolTable.view ast: Ast.view block: astnode.view
} out zast.nodeid is {
    match (
        block
    ) case statement then {
        ne9: block.statements.count.u64
        if ne9 == 0 then return zast.nodeid
        lastId: zast.kidAt kids: ast.kids span: block.statements i: ne9 - 1
        last: ast.nodes.get i: lastId
        if last.statementline.not then return zast.nodeid
        return (
            implicitReturnValue
            reg: st.reg
            typing: st.typing
            :ast
            lineId: last.nodeid
            lineType: (walkTypeOf :st nid: last.nodeid)
        )
    } else {
        # an expression-shaped body (`loop x * x`) carries its value on its
        # own node, exactly as lastStmtType reads it
        return (nodeId n: block)
    }
}

# checkComprehensionValue -- A FOR-EXPRESSION APPENDS ITS BODY'S VALUE, so that
# value answers to `.append`'s own contract: a reftype element is TAKEN
# (`ListRef.append from: T.take`) and a valtype is COPIED (`ListVal.append
# from: t`), which is why only the reftype half is asked here.
#
# Nothing modelled the append before, so a borrowed element was written into an
# owning list with no diagnostic -- `ys: for each e: xs loop e` over a
# `List String` minted an owning `ListRef String` from a view of the
# container's storage. It read as a wrong length only because the emitter never
# emitted the loop; with the loop emitted it is a use-after-free.
#
# The refusals are the argument site's, not a second derivation of them: a bare
# name goes to consumeBareArgOwnership (readonly, pinned, borrowed, and the
# take it records is what reportLoopMoves reads to refuse moving an outer local
# once per iteration), anything else to refuseBorrowedTake.
checkComprehensionValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    fornode: forref
    elemT: ztypes.tid
} is {
    if (st.reg.isReftypeOf tid: elemT).not then return
    if fornode.body.isZero then return
    valueNid: forValueNode :st :ast block: (ast.nodes.get i: fornode.body)
    if valueNid.isZero then return
    vn9: ast.nodes.get i: valueNid
    bn9: zast.atomNameIdOf n: vn9
    if bn9.notZero then {
        bindingVid: st.lookupVarId nameId: bn9
        if bindingVid.some then {
            bindingName: zast.nameTextAt :ast ref: bn9
            # the value moves into the list the loop builds, which could hand
            # it out again without its locks: one that holds any is refused
            noPins: List ztyping.PinPath
            (
                consumeBareArgOwnership
                :st
                :ast
                name: bindingName.stringView
                vid: bindingVid
                keeper: fornode.nid
                calleePins: false
                pins: noPins
                nodeid: valueNid
                lineno: (nodeLine n: vn9)
                colno: (nodeCol n: vn9)
            )
            return
        }
    }
    errsBefore: st.typing.errors.length
    # the element's own pins are judged below, as a lock the list cannot keep
    refuseBorrowedTake :st :ast n: vn9 vt: elemT byPins: false
    if st.typing.errors.length == errsBefore when (isMarkedMove :ast n: vn9).not then {
        checkFieldMove :st :ast n: vn9
    }
    # an element that keeps locks of its own -- a view a call hands back, an
    # `outx` result -- is stored in the list, which cannot keep them
    if st.typing.errors.length != errsBefore then return
    held: List ztyping.PinPath
    pinsOfValue :st :ast vt: elemT nid: valueNid borrowing: false verb: "store" dst: held
    if held.length == 0 then return
    heldNm: takenNameText :ast nid: valueNid
    (
        reportHeldIntoSlot
        :st
        :ast
        name: heldNm.stringView
        :held
        movedT: elemT
        keeper: fornode.nid
        calleePins: false
        nodeid: valueNid
        lineno: (nodeLine n: vn9)
        colno: (nodeCol n: vn9)
    )
}

# isControlValue -- the node is an `if` or a `match`, whose value is its arms',
# or a block or a `with`, whose value is its body's: a body is a one-arm value.
isControlValue: function {ast: Ast.view nid: zast.nodeid} out bool is {
    n: ast.nodes.get i: nid
    return n.ifexpr or n.caseexpr or n.doexpr or n.withexpr
}

# armValueOf -- the value an arm's body yields: its last line's, or the body
# itself when it is a bare expression. A nested `if` or `match` yields the type
# its own arms agree on.
armValueOf: function {st: zenv.ZSymbolTable ast: Ast blockId: zast.nodeid} out armvalue is {
    none: armvalue nid: zast.nodeid tid: ztypes.tid untyped: false
    if blockId.isZero then return none
    valId: blockId
    lineId: blockId
    isBlock: false
    bn: ast.nodes.get i: blockId
    isBlock = bn.statement
    if isBlock then {
        lineId = lastStmtLineIdAt :ast oId: blockId
        if lineId.isZero then return none
        valId = (
            implicitReturnValue
            reg: st.reg
            typing: st.typing
            :ast
            :lineId
            lineType: (walkTypeOf :st nid: lineId)
        )
        if valId.isZero then return none
    }
    vt: walkTypeOf :st nid: lineId
    if (isControlValue :ast nid: valId) then vt = valueArmsTid :st :ast nid: valId first: vt
    if vt.isZero or ((st.reg.typetypeOf typeId: vt) == ztypes.ztypetype.neverType) then return none
    # a nested `if` or `match` one of whose arms yields nothing yields nothing
    if vt == st.typing.nullTypeId then return none
    cf: st.typing.nodeConstAt nid: valId
    num: cf.kind.ivalKind or cf.kind.fvalKind
    # a nested `if` or `match` of literal arms yields the literal type itself
    untypedConst: num and cf.numTid.isZero
    untyped: untypedConst or (isLiteralTypeId reg: st.reg tid: vt)
    return (armvalue nid: valId tid: vt :untyped)
}

# valueArmsTid -- the one type a value-producing `if` or `match` yields, which
# every arm yielding a value must agree on: the spec gives an `if` or a `match`
# used as an expression one result type. A typed arm governs an untyped literal
# one, whose value must then fit it (checkNumericCoercion); untyped arms alone
# yield what the first of them does, or the float one's type when one is a
# float; two arms of different types are refused. An arm that diverges yields
# no value and is skipped; one that finishes without a value (a `null` body, a
# binding last, a nested value with such an arm) makes the whole yield `null`,
# which a value position refuses. The node is restamped with the answer;
# `first` -- the first arm's type -- when no arm yields a value.
valueArmsTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    nid: zast.nodeid
    first: ztypes.tid
} out ztypes.tid is {
    blocks: ListVal zast.nodeid
    valuechecks.controlArmBlocks :ast :nid into: blocks
    arms: ListVal armvalue
    valueless: false
    for each blk: blocks loop {
        av: armValueOf :st :ast blockId: blk
        if av.nid.notZero then {
            arms.append from: av
        } else if (
            (flow.lastStmtType :st :ast block: (ast.nodes.get i: blk)) == st.typing.nullTypeId
        ) then {
            valueless = true
        }
    }
    if valueless then {
        nt: st.typing.nullTypeId
        stampGate :st :nid tid: nt
        return nt
    }
    governing: numerics.typedArmsAgree :st :ast :nid :arms
    if governing.untyped then return governing.tid
    if governing.nid.isZero then {
        loose: looseArm :st :arms
        if loose.nid.isZero then return first
        # literal arms alone: an integer one beside a float one must be exactly
        # a float
        if (numerics.isFloatLiteralTid :st tid: loose.tid) then (
            numerics.checkArmsFitFloat
            :st
            :ast
            :arms
            float: loose
        )
        stampGate :st :nid tid: loose.tid
        return loose.tid
    }
    numerics.coerceLiteralArms :st :ast :nid :arms :governing
    stampGate :st :nid tid: governing.tid
    recordControlPlaceLeaves :st :ast :nid
    return governing.tid
}

# recordControlPlaceLeaves -- the arms of a control value (an `if`, a `match`, a
# block, a `with`) that read storage something else owns -- a local of an
# enclosing scope, a borrowed local the arm declared (a reference into storage
# outside it), a field, an element a call hands back -- by the node id of the
# arm's value. The emitter reads them: such a value is a reference to that
# storage on that arm's path, not a value of its own. An owned local the arm
# itself declared is the arm's own value and is not one of these; nor is a leaf
# a destination moves (armLeafMoves).
recordControlPlaceLeaves: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} is {
    leaves: ListVal zast.nodeid
    armValueLeaves :st :ast :nid into: leaves
    for each lf: leaves loop {
        ln: ast.nodes.get i: lf
        place: false
        if (zast.atomNameIdOf n: ln).notZero then {
            place = (armLeafLocal :st :ast nid: lf).notZero or (armLeafBorrowed :st nid: lf)
        } else if (localFieldPath :st :ast n: ln) then {
            place = true
        } else if (zast.markerKindOf :ast n: ln).borrowMarker then {
            place = true
        } else if (callHandsBackBorrow :st :ast n: ln) then {
            place = true
        }
        if place then st.typing.armLeafPlaces.add item: lf
    }
    parkOwnedArmLeaves :st :ast :leaves
}

# parkOwnedArmLeaves -- when ANY arm of a value `if` or `match` yields a place,
# the whole value is a reference to that arm's storage, and an arm that yields a
# value of its own has no storage to point at: it is parked in a temporary the
# statement releases, and its address is what that arm answers. That
# temporary, like every value the emitter releases, is a variable of the
# checker's, so it is minted here -- beside the
# fact that made the value a reference, which is the only place both are known.
parkOwnedArmLeaves: function {
    st: zenv.ZSymbolTable ast: Ast leaves: (ListVal zast.nodeid).view
} is {
    place: false
    for each lf: leaves loop {
        if (armLeafStaysPlace :st :lf) then place = true
    }
    if place.not then return
    for each lf: leaves loop {
        if (armLeafStaysPlace :st :lf).not then parkedArmTemp :st :ast :lf
    }
}

# parkedArmTemp -- the temporary one such arm is parked in. It is the same rule
# a value receiver's temporary follows -- a reftype value no name binds, held
# while it is used -- so it is the same mint, idempotent per node and declining
# a value its callee only lends.
parkedArmTemp: function {st: zenv.ZSymbolTable ast: Ast lf: zast.nodeid} is {
    lt: walkTypeOf :st nid: lf
    if lt.isZero then return
    ownedReceiverTemp :st :ast recvT: lt recvNid: lf
}

# looseArm -- among untyped literal arms, the one whose type they take: a float
# one when there is one, else the first.
looseArm: function {st: zenv.ZSymbolTable.view arms: (ListVal armvalue).view} out armvalue is {
    loose: armvalue nid: zast.nodeid tid: ztypes.tid untyped: false
    for each av: arms loop {
        if av.untyped then {
            if loose.nid.isZero then loose = av
            if (numerics.isFloatLiteralTid :st tid: av.tid) then loose = av
        }
    }
    return loose
}

# argIsTrivial -- true when a call argument's operation is a hoisting no-op: a
# bare atom, a labelvalue, a string literal without interpolation, or an
# expression wrapping a bare atom / labelvalue. Anything else (binop, call,
# dotted path, interpolated string) hoists into a synth temp.
argIsTrivial: function {ast: Ast.view op: astnode.view} out bool is {
    match (
        op
    ) case atomid then {
        return true
    } case labelvalue then {
        return true
    } case atomstring then {
        for each spId: (zast.kidsOf :ast span: op.stringparts) loop {
            sp: ast.nodes.get i: spId
            match (
                sp
            ) case stringchunk then null else {
                return false
            }
        }
        return true
    } else {
        return false
    }
}

# methodReceiverRootId -- methodReceiverRoot as the receiver atom's name id
# (zero when the callable is not a dotted path on a bare atom).
methodReceiverRootId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (zast.atomNameIdOf n: (ast.nodes.get i: n.parent))
    } else {
        return zast.nameid
    }
}

# methodReceiverTuple -- the full dotted path of a method call's receiver
# (everything before the method name): `st.typing.decls.get` -> [st, typing,
# decls]. Empty when the callable is not a dotted path or the receiver
# is not a plain path. Path-scoped locks need the full tuple so sibling
# fields stay independent.
methodReceiverTuple: function {ast: Ast.view n: astnode.view dst: ListVal zast.nameid} is {
    if n.dottedpath then {
        appendValueTuple :ast n: (ast.nodes.get i: n.parent) :dst
    }
}

# dottedReceiverNodeId -- the nodeid of a dotted callable's receiver expression
# (its stamped type is the immediate receiver type); 0 otherwise.
dottedReceiverNodeId: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        return (nodeId n: (ast.nodes.get i: n.parent))
    } else {
        return zast.nodeid
    }
}

# markVarMutated -- record that `nameId`'s variable is written somewhere, which
# is what the unmutated-parameter and viewable-local rules read. A name with no
# variable behind it is silently ignored: not every name in a body is a binding.
markVarMutated: function {st: zenv.ZSymbolTable nameId: zast.nameid} is {
    if nameId.isZero then return
    vo: st.lookupVarId :nameId
    if vo.some then {
        mk: vo
        st.typing.variableMutated.add item: mk
    }
}

# lockCallArg -- the call-scoped lock a parameter or receiver takes on its
# argument's root for the call's duration (the symtab appends the lock overlay
# entry in the open call scope; it vanishes when the scope pops): SHARED when
# `shared` asks it and the callee only reads, EXCLUSIVE when it may write
# through the reference (`mutable`). An argument's lock is `queued`: it starts
# with the call, once every argument is walked (layArgLocks).
lockCallArg: function {
    st: zenv.ZSymbolTable
    pool: zast.StringPool.view
    nameId: zast.nameid
    callId: zast.nodeid
    shared: bool
    mutable: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    # check the lock without laying it (zenv tryLock's `probe`)
    probe: false
    queued: false
} is {
    if mutable then markVarMutated :st :nameId
    if queued then {
        segFrom: st.argLockSegs.length
        st.argLockSegs.append nameId
        st.queueArgLock :callId :segFrom isPath: false :shared :mutable :nodeid :lineno :colno
        return
    }
    pth: ListVal zast.nameid
    pth.append nameId
    h: ztypes.zlockholder.call callId
    clk: ztypes.zlockstate.exclusive
    if shared when mutable.not then clk = ztypes.zlockstate.shared
    r: (
        st.tryLock
        :pool
        path: pth.listView
        lockType: clk
        lockScope: ztypes.zlockscope.target
        holder: h
        :mutable
        :probe
    )
    if r.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: r
}

# layArgLocks -- the call starts: lay the locks its arguments queued from
# `mark` up, in argument order, each checked against what is live now -- the
# pins of the values the arguments evaluated to, and the call's earlier
# arguments.
layArgLocks: function {st: zenv.ZSymbolTable pool: zast.StringPool.view mark: u64} is {
    n: st.argLocks.length
    if n <= mark then return
    p: ListVal zast.nameid
    k: mark
    for k < n loop {
        q: st.argLocks.get i: k
        k = k + 1
        if q.isPath then {
            p.resize to: 0
            p.extendView from: (st.argLockSegs.slice from: q.segFrom to: q.segTo)
            (
                lockCallArgPath
                :st
                :pool
                path: p
                callId: q.callId
                mutable: q.mutable
                nodeid: q.nodeid
                lineno: q.lineno
                colno: q.colno
            )
        } else {
            (
                lockCallArg
                :st
                :pool
                nameId: (st.argLockSegs.get i: q.segFrom)
                callId: q.callId
                shared: q.shared
                mutable: q.mutable
                nodeid: q.nodeid
                lineno: q.lineno
                colno: q.colno
            )
        }
    }
    st.dropArgLocks :mark
}

# lockCallPath -- call-scoped path lock over a full receiver tuple: SHARED
# on the strict prefixes, reader/writer kind on the leaf. The prefixes are
# intent locks, so they never block the leaf they were taken for.
lockCallPath: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    pool: zast.StringPool.view
    path: (ListVal zast.nameid).view
    callId: zast.nodeid
    shared: bool
    # the callee may write through the reference
    mutable: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    # check the locks without laying them (zenv tryLock's `probe`)
    probe: false
} is {
    n: path.length
    if n == 0 then return
    if mutable then {
        # a NESTED receiver (`st.reg.foo`) may write through its path, which
        # is a mutable use of the ROOT. The third and last lock-taking entry
        # point, beside lockCallArg (bare names) and installBorrowLocks (path
        # args).
        markVarMutated :st nameId: (path.get i: 0)
        (
            checkFrozenWrite
            :st
            :ast
            :path
            verb: "mutate through"
            upTo: path.length
            :nodeid
            :lineno
            :colno
        )
    }
    he: ztypes.zlockholder.call callId
    clk: ztypes.zlockstate.exclusive
    if shared when mutable.not then clk = ztypes.zlockstate.shared
    end: 1.u64
    for end < n loop {
        rs: (
            st.tryLock
            :pool
            path: (path.slice from: 0 to: end)
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.intent
            holder: he
            mutable: false
            :probe
        )
        if rs.length > 0 then {
            (
                reportPathConflict
                :st
                :pool
                :path
                holder: he
                lockType: clk
                :mutable
                :rs
                :nodeid
                :lineno
                :colno
            )
            return
        }
        end = end + 1
    }
    re: (
        st.tryLock
        :pool
        path: path.listView
        lockType: clk
        lockScope: ztypes.zlockscope.target
        holder: he
        :mutable
        :probe
    )
    if re.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: re
}

# reportPathConflict -- a call's lock on `path` met a conflict at one of its
# prefixes: report it once, as the conflict of the whole path when the leaf's
# own lock meets one (it names both paths), else as the prefix's message `rs`.
reportPathConflict: function {
    st: zenv.ZSymbolTable
    pool: zast.StringPool.view
    path: (ListVal zast.nameid).view
    holder: ztypes.zlockholder
    lockType: ztypes.zlockstate
    mutable: bool
    rs: String
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    rw: (
        st.tryLock
        :pool
        path: path.listView
        :lockType
        lockScope: ztypes.zlockscope.target
        :holder
        :mutable
        probe: true
    )
    if rw.length > 0 then {
        addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: rw
    } else {
        addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: rs
    }
}

# lockCallArgPath -- the call-scoped lock an argument that is a field path
# (`o.s`) takes for the call's duration: SHARED intent on each strict prefix,
# and on the leaf EXCLUSIVE, or SHARED when the callee only reads, held by the
# CALL, so a later argument that moves or passes the same value meets it. Unlike a nested receiver's lockCallPath it stops at
# the first conflict, which names both arguments once.
lockCallArgPath: function {
    st: zenv.ZSymbolTable
    pool: zast.StringPool.view
    path: (ListVal zast.nameid).view
    callId: zast.nodeid
    # the callee may write through the reference
    mutable: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    # an argument's lock, laid when the call starts (lockCallArg)
    queued: false
} is {
    n: path.length
    if n == 0 then return
    if mutable then markVarMutated :st nameId: (path.get i: 0)
    if queued then {
        segFrom: st.argLockSegs.length
        st.argLockSegs.extendView from: path.listView
        st.queueArgLock :callId :segFrom isPath: true shared: true :mutable :nodeid :lineno :colno
        return
    }
    he: ztypes.zlockholder.call callId
    lk: ztypes.zlockstate.exclusive
    if mutable.not then lk = ztypes.zlockstate.shared
    end: 1.u64
    for end < n loop {
        rs: (
            st.tryLock
            :pool
            path: (path.slice from: 0 to: end)
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.intent
            holder: he
            mutable: false
        )
        if rs.length > 0 then {
            (
                reportPathConflict
                :st
                :pool
                :path
                holder: he
                lockType: lk
                :mutable
                :rs
                :nodeid
                :lineno
                :colno
            )
            return
        }
        end = end + 1
    }
    re: (
        st.tryLock
        :pool
        path: path.listView
        lockType: lk
        lockScope: ztypes.zlockscope.target
        holder: he
        :mutable
    )
    if re.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: re
}

# takenHere -- the location stamp an ownership-transfer overlay carries (pop
# propagates only located takes into the enclosing scope).
takenHere: function {} out optionval ztypes.zsrcpos is {
    return (optionval.some (ztypes.zsrcpos fsno: zvfs.fsno lineno: 0 colno: 0))
}

# keeperText -- how a report names what could keep a taken value: the list a
# comprehension builds, a function a call runs, or a method call's receiver
# path.
keeperText: function {ast: Ast.view keeper: zast.nodeid} out String is {
    kn: ast.nodes.get i: keeper
    if kn.forexpr then return "the list this loop builds".string
    if kn.call then {
        fnText: String
        exprTextOf :ast n: (ast.nodes.get i: kn.callable) dst: fnText
        return "a `.take` parameter of '\{fnText}'"
    }
    tup: ListVal zast.nameid
    methodReceiverTuple :ast n: kn dst: tup
    if tup.length == 0 then return "the receiver".string
    path: String
    for each id: tup loop {
        if path.length > 0 then path.append "."
        path.append (zast.nameTextAt :ast ref: id)
    }
    return "'\{path}'"
}

# consumeBareArgOwnership -- a bare-name reftype value at an OWNING slot (a
# take parameter, a constructor field, a tagged-arm payload): refuse a
# readonly / pinned / borrowed source, else transfer ownership out of it.
consumeBareArgOwnership: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    name: StringView
    vid: ztypes.vid
    # what could keep the value past the call (methodKeeperOf); it refuses the value's locks
    keeper: zast.nodeid
    # the callee's result will hold the value (an `outx` callee, a construction)
    calleePins: bool
    # the call's pins, which locks the value carries join
    pins: List ztyping.PinPath
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    # Readonly first, then ownership: ANY borrowed binding refuses the move
    # (the view-family test predates element borrows).
    if (nameIsReadonly :st :ast :name) then {
        (
            readonlyMoveError
            :st
            :ast
            :nodeid
            :lineno
            :colno
            :name
            verb: "into a `.take` parameter"
        )
    } else {
        argPins: (
            pinnedMoveError
            :st
            :ast
            :nodeid
            :lineno
            :colno
            :name
            verb: "into a `.take` parameter"
        )
        if argPins then null else if (isBorrowedVar :st :vid) then {
            mb7Keep: keepSourceHint :st :ast :name
            mb7: "Cannot move borrowed variable '\{name}' into a `.take` parameter — borrowed names stay bound to their source for the full scope\{mb7Keep}"
            addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: mb7
        } else {
            (
                moveHeldLocksIntoSlot
                :st
                :ast
                :name
                :vid
                :keeper
                :calleePins
                :pins
                :nodeid
                :lineno
                :colno
            )
            st.invalidate nameId: (nameIdOf :ast :name) loc: takenHere
        }
    }
}

# moveHeldLocksIntoSlot -- a value moving into an owning place takes the locks
# it holds along: into the call's result when the callee's result holds the
# value (an `outx` callee, a construction), and refused otherwise. A method's
# receiver never takes them: it could store the value and later hand it out
# without them, so a lock-holding value cannot be moved into one. A bare `w` and
# the hoisted temporary of an unnamed value -- a `w.take`'s among them, its
# locks carried in its record -- come here.
moveHeldLocksIntoSlot: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    # the moved value's name, as the report spells it
    name: StringView
    vid: ztypes.vid
    # what could keep the value past the call: a method call's callable or a
    # comprehension's for node, zero when nothing could
    keeper: zast.nodeid
    # the callee's result will hold the value (an `outx` callee, a construction)
    calleePins: bool
    # the call's pins, which locks the value carries join
    pins: List ztyping.PinPath
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    if calleePins when keeper.isZero then {
        carryHeldLocks :st from: vid :pins
        return
    }
    held: List ztyping.PinPath
    st.heldLockPaths holder: ztypes.zlockholder.var vid dst: held
    if held.length == 0 then return
    (
        reportHeldIntoSlot
        :st
        :ast
        :name
        :held
        movedT: (st.reg.variableTypeOf id: vid)
        :keeper
        :calleePins
        :nodeid
        :lineno
        :colno
    )
}

# reportHeldIntoSlot -- a value moved into a slot holds the locks `held`, which
# the slot cannot keep: a `.take` parameter of a call that is not `outx`, a
# function body that could store it anywhere, a list a comprehension builds.
reportHeldIntoSlot: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    # the moved value's name, as the report spells it (empty: "the value")
    name: StringView
    held: (List ztyping.PinPath).view
    # the moved value's type, for the remedy
    movedT: ztypes.tid
    keeper: zast.nodeid
    calleePins: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    root: lockRootPhrase :st :ast nameId: (valuechecks.pinRootAt pins: held i: 0)
    what: "the value".string
    if name.length > 0 then what = "'\{name}'"
    rem: lockFreeRemedy :st :ast tid: movedT
    msg: "Cannot move \{what} into a `.take` parameter: it holds a lock on \{root}, and the callee is not `outx`, so nothing keeps \{root} locked once the call returns\{rem}"
    # a function call keeps the value through its body; one that is not `outx`
    # fails for the plainer reason above
    keptByCall: keeper.notZero and (ast.nodes.get i: keeper).call
    if keptByCall when calleePins then {
        into: keeperText :ast :keeper
        msg = "Cannot move \{what} into \{into}: it holds a lock on \{root}, and the function's body could store it where that lock does not follow -- only a construction or a native `outx` call keeps a moved value's locks\{rem}"
    } else if keeper.notZero when keptByCall.not then {
        into: keeperText :ast :keeper
        msg = "Cannot move \{what} into \{into}: it holds a lock on \{root}, and a value stored there could later be taken out without that lock\{rem}"
    }
    # a value handed to another thread by a call that keeps nothing: nothing
    # waits for that thread, so nothing keeps the lock while it runs
    xc: (st.walk.value.crossingArgCallee.get key: nodeid).or d: ztypes.tid.zero
    if xc.notZero when calleePins.not then {
        xn: conform.crossingCallName :st funcId: xc
        msg = "Cannot hand \{what} to another thread with `\{xn}`: it holds a lock on \{root}, and the call keeps no handle that would hold that lock while the thread runs\{rem}"
    }
    addError :st :nodeid :lineno :colno e: zast.err.ownerError :msg
}

# appendValueTuple -- the source path of a value node (root first), appended onto
# dst. Ownership and access markers are not addressable segments, so
# `rec.field.borrow` contributes (rec, field). A path is rooted at a name: one
# that hangs off a value no name holds (`(mk k: 3).s`) contributes nothing,
# as non-path shapes do -- its first member is no root to look up.
appendValueTuple: function {ast: Ast.view n: astnode.view dst: ListVal zast.nameid} is {
    if (valueTupleRoot :ast :n).isZero then return
    appendNamedTuple :ast :n :dst
}

# appendNamedTuple -- appendValueTuple's walk, for a path rooted at a name
appendNamedTuple: function {ast: Ast.view n: astnode.view dst: ListVal zast.nameid} is {
    match (
        n
    ) case atomid then {
        dst.append n.name
    } case dottedpath then {
        appendNamedTuple :ast n: (ast.nodes.get i: n.parent) :dst
        cid: atomNameId :ast n: (ast.nodes.get i: n.child)
        if cid.notZero when (isStripMarkerId nameId: cid).not then dst.append cid
    } else null
}

# valueTupleRoot -- the name a path is rooted at, zero when `n` is no path or
# hangs off a value no name holds
valueTupleRoot: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case atomid then {
        return n.name
    } case dottedpath then {
        return (valueTupleRoot :ast n: (ast.nodes.get i: n.parent))
    } else {
        return zast.nameid
    }
}

# fieldChainBase -- the node a chain of FIELD reads at `nid` hangs off --
# `(mk k: 3)` in `(mk k: 3).inner.s` -- with the fields past it, root first,
# appended onto `fields`; `nid` itself when it reads no field. Markers are no
# segments, and a member that is no field (a method, a constant) ends the chain.
fieldChainBase: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    nid: zast.nodeid
    fields: ListVal zast.nameid
} out zast.nodeid is {
    rev: ListVal zast.nameid
    cur: nid
    for cur.notZero loop {
        n: ast.nodes.get i: cur
        if n.dottedpath.not then break
        mem: dottedMemberId :st :ast nid: cur child: n.child
        if (isStripMarkerId nameId: mem).not when (
            memberReadIsField
            :st
            parentNid: n.parent
            nameId: mem
        ).not then break
        if (isStripMarkerId nameId: mem).not then rev.append mem
        cur = n.parent
    }
    k: rev.length
    for k > 0 loop {
        k = k - 1
        fields.append (rev.get i: k)
    }
    return cur
}

# receiverHoldsValue -- the receiver at `nid` is storage a value no name holds
# owns: that value itself (receiverIsValue), or a field read off it, which is
# part of it
receiverHoldsValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    fields: ListVal zast.nameid
    return (receiverIsValue :st :ast :unitDecl nid: (fieldChainBase :st :ast :nid :fields))
}

# valueReceiverPath -- the path a pinning result keeps on a receiver that holds
# a value (receiverHoldsValue): the unnamed local holding it, or -- a field
# read off such a value -- that value's unnamed local and the fields down to
# the receiver: a view of a field is a view of what holds it, and keeps it
# alive.
valueReceiverPath: function {
    st: zenv.ZSymbolTable
    ast: Ast
    recvT: ztypes.tid
    recvNid: zast.nodeid
    dst: ListVal zast.nameid
} is {
    fields: ListVal zast.nameid
    base: fieldChainBase :st :ast nid: recvNid :fields
    if base == recvNid then {
        unnamedReceiverLocal :st :ast :recvT :recvNid :dst
        return
    }
    n0: dst.length
    unnamedReceiverLocal :st :ast recvT: (walkTypeOf :st nid: base) recvNid: base :dst
    if dst.length == n0 then return
    for each f: fields loop dst.append f
}

# argPinTuple -- what a value node passed to a locking parameter reads
# through, root first, appended onto dst: its names up to the last field, as
# appendValueTuple spells them, while each member past the root is a field. A
# member that is a call returning a view of its base (`b.sv`) reads that base,
# so the path stops there; one that hands back a value of its own (`b.mk`,
# `k.string`, `k.copy`) reads nothing a name holds, and answers true with dst
# left empty: the argument is a fresh value, the hoisted temporary its storage.
argPinTuple: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    n: astnode.view
    dst: ListVal zast.nameid
} out bool is {
    match (
        n
    ) case atomid then {
        dst.append n.name
        return false
    } case dottedpath then {
        cid: dottedMemberId :st :ast nid: n.nodeid child: n.child
        if cid.isZero or (isStripMarkerId nameId: cid) then {
            return (argPinTuple :st :ast n: (ast.nodes.get i: n.parent) :dst)
        }
        if (argPinTuple :st :ast n: (ast.nodes.get i: n.parent) :dst) then return true
        if (memberReadIsField :st parentNid: n.parent nameId: cid) then {
            dst.append cid
            return false
        }
        if (readReturnsBorrow :st nid: n.nodeid) then return false
        for dst.length > 0 loop dst.pop
        return true
    } else {
        return false
    }
}

# argIsFresh -- argument `nid` is a fresh value at the end of a path
# (argPinTuple): a value of its own, which nothing names
argIsFresh: function {st: zenv.ZSymbolTable.view ast: Ast.view nid: zast.nodeid} out bool is {
    tup: ListVal zast.nameid
    return (argPinTuple :st :ast n: (ast.nodes.get i: nid) dst: tup)
}

# readReturnsBorrow -- the dotted read `nid` calls a function whose result
# keeps what it was handed locked: a view of its base, not a value of its own
readReturnsBorrow: function {st: zenv.ZSymbolTable.view nid: zast.nodeid} out bool is {
    rdo: st.typing.refDecl.get key: nid
    if rdo.none then return false
    fid: st.typing.declTypeOf declId: rdo
    if (st.reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return false
    return (resultPins :st funcId: fid)
}

# movePins -- every pin of `from` onto the end of `dst`, in order; `from` is
# left empty.
movePins: function {from: List ztyping.PinPath dst: List ztyping.PinPath} is {
    rev: List ztyping.PinPath
    for from.length > 0 loop rev.append from.pop
    for rev.length > 0 loop dst.append rev.pop
}

# pinsAppend -- record one pin in `pins`: a copy of `path` at `shared`
# strength, `mutable` when the reference may write through itself, `carried`
# when a moved-in value brought it: the call's result keeps such a lock
# whatever the callee declares.
pinsAppend: function {
    pins: List ztyping.PinPath
    path: (ListVal zast.nameid).view
    shared: bool
    mutable: bool
    carried: bool
} is {
    if path.length == 0 then return
    p: ListVal zast.nameid
    for each seg: path loop p.append seg
    pins.append (ztyping.PinPath path: p shared: shared and mutable.not :mutable :carried)
}

# pinsAppendOne -- pinsAppend for a one-segment path: a bare root name.
pinsAppendOne: function {
    pins: List ztyping.PinPath
    nameId: zast.nameid
    shared: bool
    mutable: bool
} is {
    p: ListVal zast.nameid
    p.append nameId
    pins.append (ztyping.PinPath path: p shared: shared and mutable.not :mutable carried: false)
}

# carryHeldLocks -- a lock-holding value moves into a call whose result will
# hold it (an `outx` callee, a construction): its locks join the call's pins
# as CARRIED, and leave the value. Answers whether the value held any.
carryHeldLocks: function {
    # the symbol table the value's rows leave
    st: zenv.ZSymbolTable
    # the variable moving into the call
    from: ztypes.vid
    # the call's pending pins the carried locks join
    pins: List ztyping.PinPath
} out bool is {
    held: List ztyping.PinPath
    holder: ztypes.zlockholder.var from
    st.heldLockPaths :holder dst: held
    if held.length == 0 then return false
    for each hp: held loop (
        pinsAppend
        :pins
        path: hp.path
        shared: hp.shared
        mutable: hp.mutable
        carried: true
    )
    st.releaseHeldLocks :holder
    return true
}

# takeHeldLocks -- `w.take` moves w's value out, and the locks w holds go with
# it (Q2, user 2026-11-09): they leave w and are pending as the taken value's,
# carried, for whatever receives it -- a with name, an argument's temporary, a
# for header -- to keep. A take nothing receives drops them with the value at
# its line's end.
takeHeldLocks: function {st: zenv.ZSymbolTable from: ztypes.vid} is {
    carried: List ztyping.PinPath
    if (carryHeldLocks :st :from pins: carried).not then return
    for each cp: carried loop {
        st.walk.value.draft.pins.append (
            ztyping.PinPath
            path: cp.path.copy
            shared: cp.shared
            mutable: cp.mutable
            carried: true
        )
    }
    st.walk.value.draft.owned = true
}

# pinsPush / pinsPushOne -- record a pin the pending result keeps. Appended
# through the full field path: a field list passed as an argument is a
# non-owning shallow copy whose appends would be lost.
pinsPush: function {
    st: zenv.ZSymbolTable
    path: (ListVal zast.nameid).view
    shared: bool
    mutable: bool
} is {
    if path.length == 0 then return
    p: ListVal zast.nameid
    for each seg: path loop p.append seg
    st.walk.value.draft.pins.append (
        ztyping.PinPath
        path: p
        shared: shared and mutable.not
        :mutable
        carried: false
    )
}

# pinRootDiesWithCall -- whether a returned value's pin rooted at `nameId` points
# at storage that dies with this call. An owned local, temporary or `.take`
# parameter does and a borrowed parameter does not; a borrowed local does only
# when what it borrows does --
# the locks it holds, else the source it was borrowed from.
pinRootDiesWithCall: function {
    st: zenv.ZSymbolTable.view
    # the pin's root name
    nameId: zast.nameid
    # how many borrowed locals the walk has gone through
    depth: u64
} out bool is {
    if depth > 16 then return false
    vo: st.lookupVarId :nameId
    if vo.none then return false
    vid: vo
    # an owned value dies with the call: a local, or a `.take` parameter
    if (st.reg.variableOwnershipOf id: vid) != ztypes.zownership.borrowed then return true
    if (st.reg.variableOriginOf id: vid) == ztypes.zvarorigin.param then return false
    held: List ztyping.PinPath
    st.heldLockPaths holder: ztypes.zlockholder.var vid dst: held
    if held.length > 0 then return (heldRootsDieWithCall :st :held :depth)
    bo: st.reg.variableBorrowOriginOf id: vid
    if bo.isZero or (bo == nameId) then return false
    return (pinRootDiesWithCall :st nameId: bo depth: depth + 1)
}

# heldRootsDieWithCall -- whether any lock a borrowed local holds is rooted at
# paramReachedFrom -- the parameter a pin rooted at `nameId` keeps locked: the
# root itself, or through a borrowed local or a hoisted temporary, a parameter
# what it holds is rooted at (as pinRootDiesWithCall follows them); zero when
# none.
paramReachedFrom: function {
    st: zenv.ZSymbolTable.view nameId: zast.nameid depth: u64
} out zast.nameid is {
    if depth > 16 then return zast.nameid
    vid: (st.lookupVarId :nameId).or d: ztypes.vid
    if vid.isZero then return zast.nameid
    if (st.reg.variableOriginOf id: vid) == ztypes.zvarorigin.param then return nameId
    if (st.reg.variableOwnershipOf id: vid) != ztypes.zownership.borrowed then return zast.nameid
    held: List ztyping.PinPath
    st.heldLockPaths holder: ztypes.zlockholder.var vid dst: held
    roots: ListVal zast.nameid
    for each hp: held loop roots.append (hp.path.get i: 0)
    for each r: roots loop {
        if r != nameId then {
            pr: paramReachedFrom :st nameId: r depth: depth + 1
            if pr.notZero then return pr
        }
    }
    return zast.nameid
}

# storage that dies with this call.
heldRootsDieWithCall: function {
    st: zenv.ZSymbolTable.view
    held: (List ztyping.PinPath).view
    depth: u64
} out bool is {
    roots: ListVal zast.nameid
    for each hp: held loop roots.append (hp.path.get i: 0)
    for each r: roots loop {
        if (pinRootDiesWithCall :st nameId: r depth: depth + 1) then return true
    }
    return false
}

# nameIsSynthVariable -- the name is a variable the checker made (an unnamed
# local), which a diagnostic calls "a temporary" rather than by name.
nameIsSynthVariable: function {st: zenv.ZSymbolTable.view nameId: zast.nameid} out bool is {
    vo: st.lookupVarId :nameId
    if vo.none then return false
    return (st.holderIsTemporary vid: vo)
}

# temporaryHint -- what releases a lock a compiler temporary holds: whatever
# holds the temporary (the release cascade frees it with that holder).
temporaryHint: function out String is {
    return "end what holds the temporary first to release it".string
}

# throughHint -- the remedy for a lock the variable `vid` holds: `verb` through
# it, or end its scope; for a temporary, end what holds it.
throughHint: function {
    st: zenv.ZSymbolTable.view pool: zast.StringPool.view vid: ztypes.vid verb: StringView
} out String is {
    if (st.holderIsTemporary :vid) then return temporaryHint
    hn: st.formatVarHolder :pool :vid
    return "\{verb} through '\{hn}' instead, or end '\{hn}'s scope first to release the lock"
}

# pathReaderHint -- why a write under the reader `rn`'s shared lock is refused,
# and its remedy; a temporary is named as one.
pathReaderHint: function {rn: StringView temporary: bool} out String is {
    if temporary then {
        return "a temporary reads this path -- writing it would invalidate what it points at; \{temporaryHint}"
    }
    return "'\{rn}' reads this path -- writing it would invalidate what '\{rn}' points at; end its scope first"
}

# movedReaderHint -- why moving `name` out from under the reader `phn` is
# refused, and its remedy; a temporary is named as one.
movedReaderHint: function {phn: StringView name: StringView temporary: bool} out String is {
    if temporary then {
        return "a temporary reads '\{name}' -- moving it would leave the temporary pointing at freed memory; \{temporaryHint}, or copy with '.copy'"
    }
    return "'\{phn}' reads '\{name}' -- moving it would leave '\{phn}' pointing at freed memory; end its scope first, or copy with '.copy'"
}

# lockRootPhrase -- how a diagnostic names the root of a lock: the variable
# quoted, or "a temporary" for an unnamed local no source line declares.
lockRootPhrase: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    nameId: zast.nameid
    # the variable the root named where the lock was laid, when the caller has
    # it: a scope that has closed since no longer resolves the name
    rootVid: ztypes.vid.zero
} out String is {
    if rootVid.notZero then {
        if (st.holderIsTemporary vid: rootVid) then return "a temporary".string
    } else if (nameIsSynthVariable :st :nameId) then return "a temporary".string
    return "'\{zast.nameTextAt :ast ref: nameId}'"
}

# pinsWithoutMethodLeaves -- move `src` into `dst` dropping the pins whose path
# LEAF is a method whose result is FRESH: such a path describes a CALL, and a
# call's result ownership is its signature's business, so `.copy` hands back a
# value the temporary owns and locking its source would freeze it for nothing.
# The other half of that rule is why the leaf's id is asked for rather than a
# bare "is it a method": a method that LENDS what it answers -- an element get,
# an `outx` or a declared borrow return -- hands back a view INTO the source,
# and the pin it left is the whole record of that. Dropping those made a
# borrowed element's temporary claim it owned the element.
pinsWithoutMethodLeaves: function {
    st: zenv.ZSymbolTable.view
    src: List ztyping.PinPath
    dst: List ztyping.PinPath
} is {
    rev: List ztyping.PinPath
    for src.length > 0 loop rev.append src.pop
    for rev.length > 0 loop {
        p: rev.pop
        mid: pathLeafMethodId :st path: p.path
        if mid.isZero or (resultPins :st funcId: mid) then dst.append p
    }
}

# pinConstructionResult -- a bare-name construction of a type with a non-owned
# field, which has no `create` to say `outx this`: the result is OWNED and
# keeps every borrowed-field argument (and anything a moved-in argument
# carried) locked, exactly as the `outx this` a written create would declare.
pinConstructionResult: function {
    st: zenv.ZSymbolTable
    # the names the adopted temporaries' locks are spelt in
    pool: zast.StringPool.view
    pins: (List ztyping.PinPath).view
} is {
    adoptKeptTemps :st :pool :pins
    for each p: pins loop {
        pinsPush :st path: p.path shared: p.shared mutable: p.mutable
    }
    if pins.length > 0 then st.walk.value.draft.owned = true
}

# resultPins -- whether a call's result keeps its inputs locked: an `outx`
# result or a reference return.
resultPins: function {st: zenv.ZSymbolTable.view funcId: ztypes.tid} out bool is {
    if (st.typing.funcPins.has item: funcId) then return true
    return (st.typing.returnsReference tid: funcId)
}

# ownedValueReceiver -- a receiver that owns what it holds and that no name
# binds is a temporary of the checker's EVEN WHEN the call's result keeps
# nothing: the emitter hoists it so the call runs once, and frees it, and
# every value the emitter frees is a variable of the checker's. A receiver rooted in
# a variable names its storage already, unless the path ends in a fresh value
# (`grid.pop.length`), which nothing names either.
ownedValueReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    call: callref
} is {
    rpn: dottedReceiverNodeId :ast n: (ast.nodes.get i: call.callable)
    if rpn.isZero then return
    if (receiverIsValue :st :ast :unitDecl nid: rpn).not then return
    if (receiverRootIsVar :st :ast :call) when (
        receiverIsFreshValue
        :st
        :ast
        nid: rpn
    ).not then return
    ownedReceiverTemp :st :ast recvT: (walkTypeOf :st nid: rpn) recvNid: rpn
}

# takeValueReceiver -- a method call's receiver, before its arguments are
# walked: one that is not a variable is evaluated first, so what its value keeps
# locked is taken now, before the argument walk drains it, and held locked
# across the arguments. The receiver's type when the result will keep an
# unnamed local of it (captureValueReceiver); zero otherwise. A concrete and a
# generic method take their receiver the same way.
takeValueReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    call: callref
    funcId: ztypes.tid
    # false when the dotted base names a type and hands the receiver to the
    # arguments
    recvVal: bool
    pins: List ztyping.PinPath
} out ztypes.tid is {
    if recvVal.not then return ztypes.tid
    # a receiver that is a `.view` result is read-only: a method that writes its
    # receiver cannot take one, as no `.borrow` can be lent from it
    rvNid: dottedReceiverNodeId :ast n: (ast.nodes.get i: call.callable)
    rvRo: (
        rvNid.notZero and ((valuePinsOf :st nid: rvNid).marker == ztypes.zparamownership.viewMode)
    )
    rvT: captureValueReceiver :st :ast :unitDecl :call :funcId :pins
    if rvRo when (callReadsReceiver :st mid: funcId nid: call.nid).not then {
        (
            addError
            :st
            nodeid: call.nid
            lineno: call.lineno
            colno: call.colno
            e: zast.err.ownerError
            msg: "a method that writes its receiver cannot be called on a `.view` result: a view converts to no other ownership".string
        )
    }
    # a receiver rooted in a variable is locked through that root after the
    # arguments; any other holds its pins locked across them
    if pins.length > 0 when (receiverRootIsVar :st :ast :call).not then {
        lockReceiverPins :st :ast :call :pins
    }
    return rvT
}

# receiverPinsNothing -- a receiver whose storage no result can point into: a
# text's bytes are the program's, so what a call hands back over them (its
# view among them) keeps the text's binding unlocked.
receiverPinsNothing: function {ast: Ast st: zenv.ZSymbolTable recvT: ztypes.tid} out bool is {
    if recvT.isZero then return false
    return recvT == (stdTid :ast :st wk: zast.wellKnown.slot.tyText)
}

# calleeIsFieldFunction -- the callable at `nid` is a function stored in a field
# (`hk.f v: x`): a call through it reads the field and passes no receiver.
calleeIsFieldFunction: function {st: zenv.ZSymbolTable.view nid: zast.nodeid} out bool is {
    md: (st.typing.refDecl.get key: nid).or d: ztypes.declid
    if md.isZero then return false
    return (st.typing.decls.get i: md).fnptrField
}

# receiverResultPath -- the receiver path a method call's result pins: the
# receiver's variable tuple when its root is a variable (a unit-qualified free
# function reached through this path has none, and pins its arguments alone);
# otherwise the unnamed local takeValueReceiver's `rvT` asks for, whose pins
# join the arguments'. Empty when the result keeps nothing.
receiverResultPath: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    funcId: ztypes.tid
    rvT: ztypes.tid
    rvPins: (List ztyping.PinPath).view
    pins: List ztyping.PinPath
    # receives the receiver's path
    dst: ListVal zast.nameid
} is {
    if (resultPins :st :funcId).not then return
    # a function stored in a field takes no receiver: what it hands back is
    # its own, not a view of the object that holds it
    if (calleeIsFieldFunction :st nid: call.callable) then return
    rcvT: walkTypeOf :st nid: (dottedReceiverNodeId :ast n: (ast.nodes.get i: call.callable))
    if (receiverPinsNothing :ast :st recvT: rcvT) then return
    methodReceiverTuple :ast n: (ast.nodes.get i: call.callable) :dst
    (
        cutAtViewingMethod
        :st
        :ast
        recv: (dottedReceiverNodeId :ast n: (ast.nodes.get i: call.callable))
        :dst
    )
    if dst.length > 0 then {
        rvb: st.lookupVarId nameId: (dst.get i: 0)
        if rvb.none then for dst.length > 0 loop dst.pop
    }
    # a fresh value at the end of a variable's path is the unnamed local, not
    # the path
    if rvT.notZero then for dst.length > 0 loop dst.pop
    if dst.length == 0 then (
        joinValueReceiver
        :st
        :ast
        :rvT
        recvNid: (dottedReceiverNodeId :ast n: (ast.nodes.get i: call.callable))
        :rvPins
        path: dst
        :pins
    )
}

# cutAtViewingMethod -- `dst`, the path a result pins on its receiver `recv`, cut
# where it passes through a method that hands back a view of its base -- `first`
# in `s.first.trim`: what the result keeps is that base, not a path through the
# method, which no write to the base would meet (argPinTuple, which cuts an
# argument's path the same way). A path ending in a fresh value is left whole.
cutAtViewingMethod: function {
    st: zenv.ZSymbolTable.view ast: Ast.view recv: zast.nodeid dst: ListVal zast.nameid
} is {
    if dst.length <= 1 then return
    k: viewingMethodPrefix :st :ast nid: recv
    if (k == 0) or (k >= dst.length) then return
    for dst.length > k loop dst.pop
}

# viewingMethodPrefix -- how many names of the dotted read `nid` come before the
# first member that is a method (`s` before `first` in `s.first.trim`), when that
# method hands back a view of its base (readReturnsBorrow); zero when the read
# passes through no method, or the first one makes a value of its own. Walks the
# tree, building nothing.
viewingMethodPrefix: function {
    st: zenv.ZSymbolTable.view ast: Ast.view nid: zast.nodeid
} out u64 is {
    # the root counts one name, each member one more, from the leaf down
    depth: u64
    cur: nid
    for cur.notZero loop {
        n: ast.nodes.get i: cur
        par: zast.nodeid
        match (
            n
        ) case dottedpath then {
            par = n.parent
        } else null
        depth = depth + 1
        cur = par
    }
    first: u64
    borrows: false
    idx: depth
    cur = nid
    for cur.notZero loop {
        n: ast.nodes.get i: cur
        par: zast.nodeid
        mem: zast.nameid
        match (
            n
        ) case dottedpath then {
            par = n.parent
            mem = dottedMemberId :st :ast nid: n.nodeid child: n.child
        } else null
        if par.notZero when mem.notZero when (isStripMarkerId nameId: mem).not when (
            memberReadIsField
            :st
            parentNid: par
            nameId: mem
        ).not then {
            first = idx
            borrows = readReturnsBorrow :st nid: cur
        }
        idx = idx - 1
        cur = par
    }
    if (first == 0) or borrows.not then return 0
    return first - 1
}

# captureValueReceiver -- a call on a receiver that is a value rather than a
# variable: the receiver is evaluated before the arguments, so the pins its own
# borrowed result left are taken now, before the argument walk. They are the
# receiver's, never an argument's, and the caller holds them locked while the
# arguments are walked. When the call's result pins too, the answer is the
# receiver's type when it left none, for the unnamed local the result will
# keep; zero otherwise.
captureValueReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    call: callref
    funcId: ztypes.tid
    # receives the pins a borrowed receiver left
    pins: List ztyping.PinPath
} out ztypes.tid is {
    rcv: dottedReceiverNodeId :ast n: (ast.nodes.get i: call.callable)
    if rcv.isZero then return ztypes.tid
    rpins: List ztyping.PinPath
    (
        readValuePins
        :st
        :ast
        vt: (walkTypeOf :st nid: rcv)
        nid: rcv
        borrowing: true
        writes: (methodReceiverIsView :st mid: funcId).not
        verb: "pass"
        dst: rpins
    )
    if (resultPins :st :funcId).not then {
        if rpins.length == 0 then {
            ownedValueReceiver :st :ast :unitDecl :call
            return ztypes.tid
        }
        if (receiverHoldsValue :st :ast :unitDecl nid: rcv).not then return ztypes.tid
        movePins from: rpins dst: pins
        return ztypes.tid
    }
    if (receiverRootIsVar :st :ast :call) when (receiverIsFreshValue :st :ast nid: rcv
    ).not then return ztypes.tid
    if (receiverHoldsValue :st :ast :unitDecl nid: rcv).not then return ztypes.tid
    movePins from: rpins dst: pins
    if pins.length > 0 then return ztypes.tid
    return (walkTypeOf :st nid: rcv)
}

# receiverIsFreshValue -- a receiver path rooted in a variable that still ends
# in a fresh value: an auto-call returning what it owns, not a view into its
# base (`grid.pop`, not `b.rowsMut`). What its result borrows is that value,
# which nothing names, so it is an unnamed local as a call's result is.
receiverIsFreshValue: function {st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid} out bool is {
    if nid.isZero then return false
    isPath: false
    bn: ast.nodes.get i: nid
    isPath = bn.dottedpath
    if isPath.not then return false
    rdo: st.typing.refDecl.get key: nid
    if rdo.none then return false
    fid: st.typing.declTypeOf declId: rdo
    if (st.reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return false
    return (resultPins :st funcId: fid).not
}

# receiverRootIsVar -- the method call's receiver path is rooted in a variable.
receiverRootIsVar: function {st: zenv.ZSymbolTable ast: Ast.view call: callref} out bool is {
    rvTup: ListVal zast.nameid
    methodReceiverTuple :ast n: (ast.nodes.get i: call.callable) dst: rvTup
    if rvTup.length == 0 then return false
    return (st.lookupVarId nameId: (rvTup.get i: 0)).some
}

# lockReceiverPins -- what a value receiver's borrowed result keeps locked
# stays locked while the call's arguments are walked, in the call's scope: an
# argument that writes the same storage (`(grid.getMut i: 0).append from:
# (grid.pop).pop`) is refused as it is when the receiver is bound to a name
# first.
lockReceiverPins: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    pins: (List ztyping.PinPath).view
} is {
    for each p: pins loop {
        (
            lockCallPath
            :st
            :ast
            pool: ast.names
            path: p.path
            callId: call.nid
            shared: p.shared
            mutable: p.mutable
            nodeid: call.nid
            lineno: call.lineno
            colno: call.colno
        )
    }
}

# receiverIsValue -- whether a dotted base is a value no variable holds: a call,
# a function a bare name or a path auto-calls, a numeric generic parameter's
# value, or any other expression (a literal, an interpolation, a value if). A
# name for a variable, a unit or a type is not one.
receiverIsValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    isName: false
    isPath: false
    bn: ast.nodes.get i: nid
    isName = bn.atomid
    isPath = bn.dottedpath
    if isName then return (
        (memberaccess.baseRunsCall :st :ast :nid) or (st.typing.numericParamRead.get key: nid).some
    )
    if (valuechecks.namesTypeApplication :st :ast :unitDecl :nid) then return false
    if isPath.not then return true
    rdo: st.typing.refDecl.get key: nid
    if rdo.none then return false
    return (
        (st.reg.typetypeOf typeId: (st.typing.declTypeOf declId: rdo)) ==
        ztypes.ztypetype.functionType
    )
}

# joinValueReceiver -- after a call's scope pops, what captureValueReceiver
# found becomes the result's receiver input: the unnamed local, or the pins the
# receiver's borrowed result left, joined to the argument pins.
joinValueReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast
    # the receiver's type, zero when no unnamed local is made
    rvT: ztypes.tid
    # the receiver node, whose value the unnamed local is
    recvNid: zast.nodeid
    # the pins a borrowed receiver left
    rvPins: (List ztyping.PinPath).view
    # receives the unnamed local's path
    path: ListVal zast.nameid
    # the call's argument pins
    pins: List ztyping.PinPath
} is {
    if rvT.notZero then valueReceiverPath :st :ast recvT: rvT :recvNid dst: path
    for each rp: rvPins loop (
        pinsAppend
        :pins
        path: rp.path
        shared: rp.shared
        mutable: rp.mutable
        carried: rp.carried
    )
}

# valueReceiverPins -- an auto-call whose result pins, read on a receiver that
# is a value rather than a variable: the path becomes the unnamed local, or the
# pins the receiver's own borrowed result left are taken in its place.
valueReceiverPins: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    funcId: ztypes.tid
    # the receiver node
    recvNid: zast.nodeid
    recvT: ztypes.tid
    # the receiver tuple, replaced when its root is not a variable
    path: ListVal zast.nameid
    # receives the pins a borrowed receiver left
    pins: List ztyping.PinPath
} is {
    if path.length > 0 when (st.lookupVarId nameId: (path.get i: 0)).some then return
    if (receiverHoldsValue :st :ast :unitDecl nid: recvNid).not then return
    rpins: List ztyping.PinPath
    (
        readValuePins
        :st
        :ast
        vt: recvT
        nid: recvNid
        borrowing: true
        writes: (methodReceiverIsView :st mid: funcId).not
        verb: "pass"
        dst: rpins
    )
    if (resultPins :st :funcId).not then {
        # nothing keeps the receiver locked, but it is still a value that owns
        # its storage; a receiver whose own walk left pins owns nothing and
        # hands those on instead. A field read off a value is part of the
        # value, which its own read already holds.
        if rpins.length == 0 when (receiverIsValue :st :ast :unitDecl nid: recvNid) then (
            ownedReceiverTemp
            :st
            :ast
            :recvT
            :recvNid
        )
        return
    }
    for path.length > 0 loop path.pop
    if rpins.length > 0 then {
        movePins from: rpins dst: pins
        return
    }
    valueReceiverPath :st :ast :recvT :recvNid dst: path
}

# unnamedReceiverLocal -- a pinning call's receiver that is a value rather than
# a variable and owns its storage is an unnamed local of the enclosing scope,
# and the result keeps that local locked. A view value (a StringView, a
# ListView) points at storage it does not own, and a receiver whose own result
# was borrowed hands on the pins it left instead, so neither makes one.
unnamedReceiverLocal: function {
    # the symbol table the local is defined in
    st: zenv.ZSymbolTable
    # the tree whose name pool names it
    ast: Ast
    # the receiver's type
    recvT: ztypes.tid
    # the receiver node whose value the local is
    recvNid: zast.nodeid
    # receives the local's path
    dst: ListVal zast.nameid
} is {
    if recvT.isZero then return
    if (valuechecks.isViewFamilyTid :ast :st tid: recvT) then return
    tnId: mintReceiverTemp :st :ast :recvT :recvNid
    if tnId.isZero then return
    holdUnnamedLocal :st :recvNid :tnId :dst
}

# holdUnnamedLocal -- the temporary `tnId` holding the value at `recvNid` is
# kept by the line being walked: an unnamed local of its scope, and the root of
# the path `dst` receives
holdUnnamedLocal: function {
    st: zenv.ZSymbolTable
    recvNid: zast.nodeid
    tnId: zast.nameid
    dst: ListVal zast.nameid
} is {
    st.walk.value.lineUnnamedLocals.append tnId
    st.typing.unnamedLocalOfNode.set key: recvNid value: tnId
    dst.append tnId
}

# mintReceiverTemp -- the temporary a receiver that is a VALUE is held in: its
# own variable, owned, defined in the enclosing scope. A view value (a
# StringView, a ListView) points at storage it does not own and gets none, and
# answers a zero name. `tempOf` records the VARIABLE, which is what the emitter
# spells: a name resolves only while its scope is open, and emission runs after
# every scope has popped.
mintReceiverTemp: function {
    st: zenv.ZSymbolTable
    ast: Ast
    recvT: ztypes.tid
    recvNid: zast.nodeid
} out zast.nameid is {
    if recvT.isZero then return zast.nameid
    if (valuechecks.isViewFamilyTid :ast :st tid: recvT) then return zast.nameid
    # ONE VALUE, ONE TEMPORARY. A receiver is reached twice -- as the base of
    # its dotted path, and by the call leg that pins its result -- and a second
    # mint would leave two variables claiming one value, which a destroy list
    # would then free twice.
    exN: st.walk.value.tempNameOf.get key: recvNid
    if exN.some then return exN
    # WHAT A VALUE IS HELD IN DOES NOT ALWAYS OWN IT (valueIsLent): a temporary
    # over storage something else owns would free that storage.
    rown: ztypes.zownership.owned
    if (valueIsLent :st :ast nid: recvNid) then rown = ztypes.zownership.borrowed
    vid: st.reg.newVariable ztypeId: recvT ownership: rown
    tnId: st.newTempName pool: ast.names
    st.defineTemp nameId: tnId :vid
    # a view of it may leave the scope it is bound in -- an argument carrying
    # it out of a call -- and the result that keeps it adopts it there
    st.walk.value.adoptableTemps.set key: tnId value: vid
    st.walk.value.tempNameOf.set key: recvNid value: tnId
    if st.recording then st.typing.tempOf.set key: recvNid value: vid
    return tnId
}

# ownedReceiverTemp -- a receiver that is a value and owns its storage is held
# by a temporary of the checker's WHETHER OR NOT the call's result keeps it
# locked. The emitter hoists and frees it either way, and every value it
# frees is a variable of the checker's. It joins no pin list: nothing holds it
# past the call, and no name binds it.
ownedReceiverTemp: function {
    st: zenv.ZSymbolTable
    ast: Ast
    recvT: ztypes.tid
    recvNid: zast.nodeid
} is {
    # only a REFTYPE receiver holds storage a temporary has to own: a valtype
    # is self-contained (it may hold no reftype, spec.pdoc), so the emitter
    # never hoists one to free it, and a temporary for it would name nothing.
    if (st.reg.isReftypeOf tid: recvT).not then return
    mintReceiverTemp :st :ast :recvT :recvNid
}

# adoptKeptTemps -- the temporaries a call's result keeps locked -- an argument
# temp a pinning callee's result pins, a receiver's temp whose view an argument
# carried out -- left the scope with the call: each is defined again -- the same
# variable, so it is one temporary however far it is promoted -- as an unnamed
# local of the scope the call is in, so the pin names a live variable.
adoptKeptTemps: function {
    st: zenv.ZSymbolTable
    pool: zast.StringPool.view
    pins: (List ztyping.PinPath).view
    # only the pins a moved-in argument carried: what a result that pins
    # nothing of its own still keeps
    carriedOnly: false
} is {
    roots: ListVal zast.nameid
    for each p: pins loop {
        if carriedOnly.not or p.carried then roots.append (p.path.get i: 0)
    }
    for each r: roots loop {
        # a temp's name is unique to the run, so an entry is never asked twice
        ato: st.walk.value.adoptableTemps.get key: r
        if ato.some then {
            if (st.lookupVarId nameId: r).none then {
                # a temporary the popped scope listed (a receiver's) moves out of
                # that list: it dies once, here
                if ((st.walk.value.pinnedTempPending.get key: ato).or d: false).not then (
                    st.retireTempListing
                    vid: ato
                )
                # defineTemp, not defineVar: the temporary is now THIS scope's,
                # and `tempScopeOf` is the key its destroy list is under -- left
                # pointing at the popped call scope, scopeOwnsTemp looks it up
                # in a list that no longer names it and answers "owns nothing",
                # which drops the free
                st.defineTemp nameId: r vid: ato
                st.walk.value.lineUnnamedLocals.append r
                # the temporary is the user's named hoist made explicit: it
                # keeps its own locks where it now lives
                relayTempPins :st :pool vid: ato
            }
            # settled either way -- adopted here, or still bound by a scope that
            # has yet to pop -- so the scope that holds it now may list it
            st.walk.value.pinnedTempPending.set key: ato value: false
        }
    }
}

# recordTempPins -- the locks the hoisted temporary `vid` laid (installPins of
# `pins`), kept for the result that may adopt it (relayTempPins).
recordTempPins: function {
    st: zenv.ZSymbolTable
    vid: ztypes.vid
    pins: (List ztyping.PinPath).view
    onlyRoot: zast.nameid
    forceShared: bool
} is {
    start: st.walk.value.pins.length
    for each p: pins loop {
        if onlyRoot.isZero or ((p.path.get i: 0) == onlyRoot) then {
            sh: p.shared or forceShared
            mu: p.mutable and forceShared.not
            st.walk.value.pinRoots.append ztypes.vid
            st.walk.value.pins.append (
                ztyping.PinPath
                path: p.path.copy
                shared: sh
                mutable: mu
                carried: p.carried
            )
        }
    }
    n: st.walk.value.pins.length - start
    if n == 0 then return
    (
        st.walk.value.tempPins.set
        key: vid
        value: (
            ztyping.valuepins
            start: start.u32.orPanic
            len: n.u32.orPanic
            owned: false
            marker: ztypes.zparamownership.noneMode
        )
    )
}

# relayTempPins -- an adopted temporary lays again, where it now lives, the
# locks it laid in the call's scope (recordTempPins), which closed with the
# call: the result keeps the temporary, and the temporary keeps what it views.
relayTempPins: function {st: zenv.ZSymbolTable pool: zast.StringPool.view vid: ztypes.vid} is {
    tp: st.walk.value.tempPins.get key: vid
    if tp.none then return
    run: List ztyping.PinPath
    appendRecordPins :st vp: tp dst: run
    # a temporary it views lives on with it: the chain of hoists is adopted
    # whole, innermost first
    adoptKeptTemps :st :pool pins: run
    (
        valuechecks.installPins
        :st
        :pool
        pins: run
        :vid
        onlyRoot: zast.nameid
        forceShared: false
        nodeid: zast.nodeid
        lineno: 0
        colno: 0
    )
}

# pinCallResult -- what a call's result keeps locked. An `outx` result and a
# reference return
# (`.borrow`/`.view`) pin the receiver and every borrow/view argument, each
# at the strength the call took on it: SHARED for a `.view` input or a
# whitelisted reader, EXCLUSIVE for a `.borrow` one. A reference result makes
# its binding borrowed; `.view` makes it readonly; `.hold` freezes it.
pinCallResult: function {
    # the symbol table whose pin side channel receives the pins
    st: zenv.ZSymbolTable
    # the names the adopted temporaries' locks are spelt in
    pool: zast.StringPool.view
    # the callee, whose return flags say whether the result pins at all
    funcId: ztypes.tid
    # the argument pins the call walk collected
    pins: (List ztyping.PinPath).view
    # the receiver path, empty when the receiver is not a variable
    recvPath: (ListVal zast.nameid).view
    # the strength the call took on the receiver
    recvShared: bool
} is {
    doPins: st.typing.funcPins.has item: funcId
    marker: st.typing.returnMarkerOf tid: funcId
    isRef: marker.isReference
    if isRef then doPins = true
    if doPins then {
        adoptKeptTemps :st :pool :pins
        pinsPush :st path: recvPath shared: recvShared mutable: recvShared.not
        for each p: pins loop {
            pinsPush :st path: p.path shared: p.shared mutable: p.mutable
        }
        if isRef.not then st.walk.value.draft.owned = true
        if marker == ztypes.zparamownership.viewMode then st.walk.value.draft.marker = marker
    } else {
        # the locks a moved-in argument carried travel to the result whatever
        # the callee declares, and the temporaries they are on with them
        adoptKeptTemps :st :pool :pins carriedOnly: true
        pushCarriedPins :st :pins
    }
    # `hold`: owned and READONLY with no pin, whichever leg ran
    if marker == ztypes.zparamownership.holdMode then st.walk.value.draft.marker = marker
}

# pushCarriedPins -- the locks moved-in values carried travel to the result
# being built: the value that held them lives in it now.
pushCarriedPins: function {st: zenv.ZSymbolTable pins: (List ztyping.PinPath).view} is {
    anyC: false
    for each p2: pins loop {
        if p2.carried then {
            pinsPush :st path: p2.path shared: p2.shared mutable: p2.mutable
            anyC = true
        }
    }
    if anyC then st.walk.value.draft.owned = true
}

# frozenFieldInPath -- the first segment of a path, up to `upTo`, declared
# `view` or `hold`, or "". The contents of such a field are readonly for the
# instance's whole life; the slot rule (static or not) is the other axis and is
# decided at the declaration. Walks segment by segment, since the frozen field
# may be nested (`b.inner.name`).
#
# `upTo` is what separates writing THROUGH a frozen field from writing the
# field itself: an assignment passes the strict prefix, because assigning the
# slot is the slot rule's business, while a mutating call passes the whole path
# -- there the leaf IS the receiver being mutated.
frozenFieldInPath: function {
    st: zenv.ZSymbolTable.view
    path: (ListVal zast.nameid).view
    upTo: u64
} out zast.nameid is {
    n: upTo
    if n > path.length then n = path.length
    if n < 2 then return zast.nameid.zero
    cur: ztypes.tid
    {
        ro: st.lookup nameId: (path.get i: 0)
        match (
            ro
        ) case some then {
            cur = ro
        } case none then {
            return zast.nameid.zero
        }
    }
    i: 1.u64
    for i < n loop {
        seg: path.get :i
        oo: st.typing.declOwnershipOfId parentTypeId: cur nameId: seg
        if oo.some then {
            if oo == ztypes.zparamownership.viewMode then return seg
            if oo == ztypes.zparamownership.holdMode then return seg
        }
        co: st.typing.declChildOfId parentTypeId: cur nameId: seg
        match (
            co
        ) case some then {
            cur = co
        } case none then {
            return zast.nameid.zero
        }
        i = i + 1
    }
    return zast.nameid.zero
}

# pathLeafIsMethod -- the last segment of a path names a METHOD rather than a
# field. A call's result ownership is its signature's business -- `.copy` and
# every owned return are fresh values -- so the deep-readonly rule, which is
# about reading a reftype field out of a readonly path, must not claim them.
pathLeafIsMethod: function {
    st: zenv.ZSymbolTable.view
    path: (ListVal zast.nameid).view
} out bool is {
    return (pathLeafMethodId :st :path).notZero
}

# pathLeafMethodId -- the function id of the METHOD a path's last segment
# names, zero when the leaf is a field or the path does not resolve. The walk
# pathLeafIsMethod asks; a caller that needs the method's own flags (what its
# result lends) asks this.
pathLeafMethodId: function {
    st: zenv.ZSymbolTable.view
    path: (ListVal zast.nameid).view
} out ztypes.tid is {
    n: path.length
    if n < 2 then return ztypes.tid
    cur: ztypes.tid
    {
        ro: st.lookup nameId: (path.get i: 0)
        match (
            ro
        ) case some then {
            cur = ro
        } case none then {
            return ztypes.tid
        }
    }
    last: n - 1
    i: 1.u64
    for i < n loop {
        co: st.typing.declChildOfId parentTypeId: cur nameId: (path.get :i)
        match (
            co
        ) case some then {
            if i == last then {
                tt: st.reg.typetypeOf typeId: co
                if tt == ztypes.ztypetype.functionType then return co
                return ztypes.tid
            }
            # An INTERMEDIATE method continues from what it RETURNS, not from
            # the function type: `e.value.copy` walks entry -> value's return
            # (String) -> copy. Reading the segment's own type here dead-ends
            # on the first method in the path, and the walk then reports that
            # the leaf is not a method when it is.
            cur = co
            mtt: st.reg.typetypeOf typeId: co
            if mtt == ztypes.ztypetype.functionType then {
                cur = st.reg.returnTypeOf tid: co
            }
        } case none then {
            return ztypes.tid
        }
        i = i + 1
    }
    return ztypes.tid
}

# pathIsReadonly -- true when a value path may only be read: it passes through
# a `view`/`hold` field, or its root binding holds a readonly lock on itself (a
# `view` parameter, a `hold` binding). Readonly is deep, so a binding taken
# from such a path is readonly in turn -- otherwise the intermediate name
# launders the restriction away.
pathIsReadonly: function {
    st: zenv.ZSymbolTable.view
    path: (ListVal zast.nameid).view
} out bool is {
    if path.length == 0 then return false
    ff: frozenFieldInPath :st :path upTo: path.length
    if ff.notZero then return true
    r: path.get i: 0
    rv: st.lookupVarId nameId: r
    if rv.none then return false
    lk: st.findLock nameId: r
    if lk.none then return false
    if lk != ztypes.zlockstate.shared then return false
    lh: st.findLockHolder nameId: r
    if lh.none then return false
    return lh == (ztypes.zlockholder.var rv)
}

# valueReadsReadonlyPlace -- the reftype value at `nid`, of type `vt`, is a
# name or a field read out of a readonly path (pathIsReadonly). Readonly is
# deep, so whatever becomes a second name for it -- a binding, or an arm a
# binding takes -- is readonly in turn. A path whose leaf is a method is a
# call, and its result is its signature's business.
valueReadsReadonlyPlace: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    nid: zast.nodeid
    vt: ztypes.tid
} out bool is {
    if (st.reg.isReftypeOf tid: vt).not then return false
    path: ListVal zast.nameid
    appendValueTuple :ast n: (ast.nodes.get i: nid) dst: path
    if path.length == 0 then return false
    if (pathLeafIsMethod :st :path) then return false
    return (pathIsReadonly :st :path)
}

# nameIsReadonly -- the one-segment form of pathIsReadonly. A `view` parameter,
# a `hold` binding and a payload narrowed from either each hold a readonly lock
# on their own name, so this answers "may this binding only be read?".
nameIsReadonly: function {st: zenv.ZSymbolTable.view ast: Ast.view name: StringView} out bool is {
    if name.length == 0 then return false
    rop: ListVal zast.nameid
    rop.append (nameIdOf :ast :name)
    return (pathIsReadonly :st path: rop)
}

# pinnedMoveError -- a move out of a binding ANOTHER holder has locked is
# refused: the holder reads or writes through that value, and a move frees it
# out from under them (a StringView over a moved String reads freed memory).
# A CALL is a holder too: `f a: src b: src.take` hands the callee a reference
# to `src` beside the value moved out of it. `.drop` has refused this for a
# while; the move sites never asked. Reports and returns true when it fires,
# so the caller skips its remaining legs.
pinnedMoveError: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    name: StringView
    verb: StringView
} out bool is {
    if name.length == 0 then return false
    pnid: nameIdOf :ast :name
    pvo: st.lookupVarId nameId: pnid
    if pvo.none then return false
    byCall: st.argLockQueued nameId: pnid
    phn: String
    php: String
    phTemp: false
    plsn: String
    if byCall.not then {
        plk: st.findLock nameId: pnid
        if plk.none then return false
        plh: st.findLockHolder nameId: pnid
        if plh.none then return false
        # A holder that is the binding itself is the readonly case, which
        # readonlyMoveError words better.
        if plh == (ztypes.zlockholder.var pvo) then return false
        if plh.call then {
            byCall = true
        } else {
            phn = st.formatVarHolder pool: ast.names vid: plh
            php = st.varHolderPhrase pool: ast.names vid: plh
            phTemp = st.holderIsTemporary vid: plh
            plsn = zenv.zlockstateNameLower t: plk
        }
    }
    pm: String
    pht: String
    if byCall then {
        # the enclosing call already holds a reference to the value: the
        # callee would read it beside the moved-out copy
        pm = "Cannot move '\{name}' \{verb}: this call already passes '\{name}'"
        pht = "the callee would hold '\{name}' beside the value moved out of it; bind or copy the value first"
    } else {
        pm = "Cannot move '\{name}' \{verb}: \{plsn} lock held by \{php}"
        pht = movedReaderHint phn: phn.stringView :name temporary: phTemp
    }
    pen: String
    (
        addErrorWithHint
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: pm
        note: pen
        hint: pht
        width: name.length
    )
    return true
}

# keepSourceHint -- the tail a refused move offers to keep the value instead:
# `.copy` where the type has one (a valtype, or a type declaring `copy`; a
# container of references declares none), an owned String for a StringView,
# and nothing for a type with no duplicate, which `.copy` refuses
# (checkCopyMember). The name's type is read as it stands here, so a narrowed
# payload answers for its arm.
keepSourceHint: function {st: zenv.ZSymbolTable.view ast: Ast.view name: StringView} out String is {
    to: st.lookup nameId: (nameIdOf :ast :name)
    if to.some then {
        vt: conform.typedefChaseTid typing: st.typing tid: to
        if vt == (stdTidPeek :ast typing: st.typing wk: zast.wellKnown.slot.tyStringView) then {
            return "; a StringView has no owned copy: '.string' makes an owned String (allocates)".string
        }
        ct: vt
        og: st.reg.genericOriginOf tid: vt
        if og.notZero then ct = og
        cm: st.typing.declMemberIdOf parentTypeId: ct nameId: zast.wellKnown.slot.wkCopy
        if cm.notZero or (st.reg.typetypeOf typeId: vt).isValueFamily then {
            return "; copy with '.copy' to keep the source".string
        }
    }
    return "".string
}

# lockFreeRemedy -- the tail a refused move of a lock-holding value offers. A
# StringView has an owned String, which holds no lock. Any other holder keeps
# its references in a copy, and so its locks, so it is offered nothing.
lockFreeRemedy: function {st: zenv.ZSymbolTable.view ast: Ast.view tid: ztypes.tid} out String is {
    if (
        (conform.typedefChaseTid typing: st.typing :tid) ==
        (stdTidPeek :ast typing: st.typing wk: zast.wellKnown.slot.tyStringView)
    ) then {
        return "; '.string' makes an owned String (allocates), which holds no lock".string
    }
    return "".string
}

# readonlyMoveError -- a move whose SOURCE may only be read is refused:
# capability may only be given up, so `hold`/`view` never become an owned
# mutable value. `verb` names the move form ("with '.take'", "by
# reassignment", ...).
readonlyMoveError: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    name: StringView
    verb: StringView
} is {
    rmmKeep: keepSourceHint :st :ast :name
    rmm: "Cannot move readonly variable '\{name}' \{verb} — a readonly binding may only be read\{rmmKeep}"
    addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: rmm
}

# takeMarkerOnField -- `h.p.take`. A field is borrowed from its owner whatever
# owns the owner, and changes only by `swap`, so a take of one that owns what it
# holds moves a borrowed value and is refused in the words a borrowed name's
# `.take` gets. A field that owns nothing -- a number, a record, a view -- hands
# on its value, and answers to checkFieldMove.
takeMarkerOnField: function {st: zenv.ZSymbolTable ast: Ast.view dp: dpref} is {
    fieldN: ast.nodes.get i: dp.parent
    if (movedFieldPath :st :ast n: fieldN) then {
        ft: walkTypeOf :st nid: dp.parent
        if (refuseBorrowedMove :st :ast n: fieldN vt: ft verb: "with '.take'") then return
    }
    checkFieldMove :st :ast n: (ast.nodes.get i: dp.nid)
}

# checkFieldMove -- a move out of a field leaves the field empty, which is a write
# to it: refused, as any write is, through a readonly root or a locked path. A
# name moved whole is not a field and answers to the move rules for names. Only a
# field that owns nothing gets here: every other field in a moving position is
# refused as a borrowed value.
checkFieldMove: function {st: zenv.ZSymbolTable ast: Ast.view n: astnode.view} is {
    if (movedFieldPath :st :ast :n).not then return
    checkWriteLock :st :ast :n verb: "move" moving: true
}

# movedFieldPath -- `n`, less a move marker, is a field read through names:
# `h.p`, `h.p.take`, `this.a.b` -- and not a method or a constant reached the
# same way, such as `name.copy`.
movedFieldPath: function {st: zenv.ZSymbolTable.view ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case dottedpath then {
        p: ast.nodes.get i: n.parent
        cid: dottedMemberId :st :ast nid: n.nodeid child: n.child
        if (isMoveMarkerId nameId: cid) then return (movedFieldPath :st :ast n: p)
        if (memberReadIsField :st parentNid: n.parent nameId: cid).not then return false
        if p.atomid then return true
        return (movedFieldPath :st :ast n: p)
    } else {
        return false
    }
}

# dottedMemberId -- the member the dotted path `nid` reads: the internal member
# a public alias resolved to (stamped where the alias resolved), else the
# written child. A pass that asks WHICH member a resolved path reads asks here,
# so a renamed member is the member it renames everywhere.
dottedMemberId: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    nid: zast.nodeid
    child: zast.nodeid
} out zast.nameid is {
    ai: st.typing.aliasInternalIdOf nodeid: nid
    if ai.notZero then return ai
    return (atomNameId :ast n: (ast.nodes.get i: child))
}

# memberReadIsField -- the member `nameId` read off the node `parentNid` is a
# field its owner stores, by its declaration: not a function, which a read
# calls, nor a unit's constant or list, which no instance stores, nor an
# `as` constant, nor an implementation label (`fr.closer` converts the owner to the
# protocol; it reads no field).
memberReadIsField: function {
    st: zenv.ZSymbolTable.view
    parentNid: zast.nodeid
    nameId: zast.nameid
} out bool is {
    if nameId.isZero then return false
    pt: walkTypeOf :st nid: parentNid
    if pt.isZero then return false
    if (zenv.isImplementationLabelOf ty: st.typing reg: st.reg tid: pt :nameId) then {
        return false
    }
    md: st.typing.declMemberIdOf parentTypeId: pt :nameId
    if md.isZero then return false
    if (st.typing.decls.get i: md).kind.fieldDecl.not then return false
    return (st.typing.isAsConstDecl declId: md).not
}

# isMarkedMove -- `n` ends in a move marker.
isMarkedMove: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case dottedpath then {
        return (isMoveMarkerId nameId: (atomNameId :ast n: (ast.nodes.get i: n.child)))
    } else {
        return false
    }
}

# checkFrozenWrite -- reject a mutation reaching through a readonly field.
checkFrozenWrite: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    path: (ListVal zast.nameid).view
    verb: StringView
    upTo: u64
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    ff: frozenFieldInPath :st :path :upTo
    if ff.isZero then return
    pp: zenv.formatPath pool: ast.names path: path.listView
    ffn: zast.poolTextAt pool: ast.names ref: ff
    mf: "Cannot \{verb} '\{pp}': field '\{ffn}' is readonly"
    addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: mf
}

# reportCallPassesRoot -- a write to `path` while a call still open passes its
# root: the callee would hold the root beside what the write took from it. The
# words are those a move of a name the call passes gets (pinnedMoveError).
reportCallPassesRoot: function {
    st: zenv.ZSymbolTable
    n: astnode.view
    verb: StringView
    # the write moves the value out
    moving: bool
    path: StringView
    root: StringView
} is {
    cm: "Cannot \{verb} '\{path}': this call already passes '\{root}'"
    ch: String
    if moving then {
        ch = "the callee would hold '\{root}' beside the value moved out of it; bind or copy the value first"
    }
    cn: String
    (
        addErrorWithHint
        :st
        nodeid: (nodeId :n)
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.ownerError
        msg: cm
        note: cn
        hint: ch
        width: root.length
    )
}

# checkWriteLock -- a write is rejected while an EXCLUSIVE lock overlapping its
# target path is outstanding: the holder reaches through that path, so the write
# would invalidate what it points at. Sibling paths do not overlap, so a lock on
# one field leaves the others writable.
checkWriteLock: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    n: astnode.view
    verb: StringView
    # the write moves the value out, which the call-holder refusal's hint names
    moving: bool
} is {
    wp: ListVal zast.nameid
    appendValueTuple :ast :n dst: wp
    if wp.length == 0 then return
    markVarMutated :st nameId: (wp.get i: 0)
    # hoisted: the length read locks wp for its duration, and wp is already
    # an argument to the same call -- one appearance per call.
    wpn: wp.length
    (
        checkFrozenWrite
        :st
        :ast
        path: wp
        :verb
        upTo: wpn - 1
        nodeid: (nodeId :n)
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
    )
    wrn: wp.get i: 0
    wv: st.lookupVarId nameId: wrn
    if wv.none then return
    wr: zast.poolTextAt pool: ast.names ref: wrn
    pp: zenv.formatPath pool: ast.names path: wp.listView
    wh: st.findExclusiveLock path: wp
    if wh.some then {
        if wh.call then {
            reportCallPassesRoot :st :n :verb :moving path: pp.stringView root: wr.stringView
            return
        }
        hph: st.varHolderPhrase pool: ast.names vid: wh
        mw: "Cannot \{verb} '\{pp}': exclusive lock held by \{hph}"
        wht: throughHint :st pool: ast.names vid: wh verb: "write"
        wen: String
        (
            addErrorWithHint
            :st
            nodeid: (nodeId :n)
            lineno: (nodeLine :n)
            colno: (nodeCol :n)
            e: zast.err.ownerError
            msg: mw
            note: wen
            hint: wht
            width: wr.length
        )
        return
    }
    rh: st.findReadBlocker path: wp
    if rh.none then return
    if rh.call then {
        reportCallPassesRoot :st :n :verb :moving path: pp.stringView root: wr.stringView
        return
    }
    rn: st.formatVarHolder pool: ast.names vid: rh
    selfRo: rn.stringView == wr
    rph: st.varHolderPhrase pool: ast.names vid: rh
    mr: "Cannot \{verb} '\{pp}': shared lock held by \{rph}"
    if selfRo then mr = "Cannot \{verb} '\{pp}': '\{wr}' is readonly here"
    rht: String
    if selfRo.not then {
        rht = pathReaderHint rn: rn.stringView temporary: (st.holderIsTemporary vid: rh)
    }
    if selfRo then {
        # `view` is not owned, `hold` is -- the self-lock is the same, so the
        # binding's ownership is what tells them apart for the hint.
        rmk: "hold".string
        if (isBorrowedVar :st vid: wv) then rmk = "view".string
        rht = "a `\{rmk}` binding is readonly for its whole scope; take a `.copy` to get a mutable value"
    }

    ren: String
    (
        addErrorWithHint
        :st
        nodeid: (nodeId :n)
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.ownerError
        msg: mr
        note: ren
        hint: rht
        width: wr.length
    )
}

# hoistArg -- hoist a non-trivial call argument into a fresh synth temp:
# define the temp (OWNED, synth origin anf) in the open CALL scope, record it as
# the argument's temporary (tempOf), and, for the dump only, the synth
# Assignment / AtomId rows + their type stamps (hoistRows). The parsed argument
# keeps its own stamps.
hoistArg: function {
    ast: Ast
    st: zenv.ZSymbolTable
    argId: zast.nodeid
    argType: ztypes.tid
    paramType: ztypes.tid
    consumes: bool
    viewParam: bool
    # what the argument keeps locked: its record, and the path it is read from
    argPins: List ztyping.PinPath
    # the call holds the argument's path itself (lockFieldArgForCall)
    callHolds: false
} out zast.nameid is {
    # the argument's position
    ln: u32
    co: u32
    argNode: ast.nodes.get i: argId
    ln = nodeLine n: argNode
    co = nodeCol n: argNode
    # a temporary is a run-time variable, so a number literal it holds takes
    # its default, as a binding's does: a numeric literal type has no run-time
    # variable
    tempType: argType
    if (isLiteralTypeId reg: st.reg tid: argType) then tempType = (
        valuechecks.materialiseLiteral
        :ast
        :st
        t: argType
    )
    assignId: hoistRows :ast :st argType: tempType :paramType :ln :co
    st.walk.value.draft.dropPins
    # A borrow path whose LEAF is a method describes a CALL, and a call's
    # result ownership is its signature's business: `.copy` hands back a fresh
    # value, so the temp OWNS it and locking `x.copy` as though it were a field
    # read freezes the source for nothing -- which is what made `.copy`, the
    # escape hatch every readonly diagnostic recommends, fail as an argument.
    # c0b482b applied this rule to bindings; the argument path had its own copy.
    hpins: List ztyping.PinPath
    pinsWithoutMethodLeaves :st src: argPins dst: hpins
    hown: ztypes.zownership.owned
    if hpins.length > 0 when (
        st.reg.isReftypeOf
        tid: tempType
    ) then hown = ztypes.zownership.borrowed
    # A VALUE WHOSE STORAGE SOMETHING ELSE OWNS is held by a temp that owns
    # nothing (valueIsLent): a borrow-returning call, a field read off one, or a
    # control value one of whose arms yields a place -- the arms need not agree.
    if hown == ztypes.zownership.owned when (
        valueIsLent
        :st
        :ast
        nid: argId
    ) then hown = ztypes.zownership.borrowed
    vid: st.reg.newVariable ztypeId: tempType ownership: hown
    st.reg.setVariableSynthOrigin id: vid origin: ztypes.zsynthorigin.anf
    if hown == ztypes.zownership.borrowed then (
        st.reg.setVariableBorrowOrigin
        id: vid
        origin: (valuechecks.pinRootAt pins: hpins i: 0)
    )
    tnId: st.newTempName pool: ast.names
    st.defineTemp nameId: tnId :vid
    # the hoisted temp is the user-written hoist made explicit: it borrows
    # its source path for the call scope (SHARED prefixes, leaf kind from
    # the side channel), so aliasing between arguments -- or with a live
    # view of the source -- conflicts exactly as the call-scoped locking
    # algorithm in ownership.pdoc requires. A path the call holds itself
    # (`callHolds`) is the argument's one lock, and the temp lays none
    # install only when the consumed side-channel path belongs to THIS
    # argument (its root atom): a stale residue from receiver evaluation
    # must stay drained-without-locks, or it would double the call's own
    # receiver locks under a temp holder
    if hown == ztypes.zownership.borrowed then {
        hrt: rootNameIdOf :ast n: (ast.nodes.get i: argId)
        # a CALL's result pins exactly what that call left: every call drains
        # the side channel before it pushes its own (pinCallResult), so no
        # residue can stand in for this argument's -- `(s.substring from: 0
        # to: 4)` and `(pick :l i: 0)` hold their sources as `s.stringView`
        # does, and a later argument moving or writing them meets the temp
        isCallArg: (ast.nodes.get i: argId).call
        # and so does a control value: what its arms hand back, whatever each
        # is rooted at
        isCtl: isControlValue :ast nid: argId
        # and so does a value no variable roots -- a method or field read off a
        # call's result (`(xs.get i: 0).stringView`), off a literal, off an
        # auto-called function: what it keeps is what its own walk left
        rootless: hrt.isZero or (st.lookupVarId nameId: hrt).none
        # and every one of them is this argument's: a construction's root is
        # its type, which names none of what it locks
        if isCallArg or isCtl or rootless then hrt = zast.nameid
        if callHolds.not then {
            # A `.view` parameter only reads its argument, so the hoisted temp
            # locks the source SHARED -- exactly as the bare-name leg already
            # did via `isViewArg`. Without this a PATH-shaped argument
            # (`f xs: h.items`) took an exclusive lock and was refused off any
            # readonly holder, while the identical value hoisted to a local by
            # hand was accepted.
            (
                valuechecks.installPins
                :st
                pool: ast.names
                pins: hpins
                :vid
                onlyRoot: hrt
                forceShared: viewParam
                nodeid: argId
                lineno: ln
                colno: co
            )
            recordTempPins :st :vid pins: hpins onlyRoot: hrt forceShared: viewParam
        }
    }
    if assignId.notZero then st.typing.setDefVariable nid: assignId :vid
    if st.recording then st.typing.tempOf.set key: argId value: vid
    if consumes then st.invalidate nameId: tnId loc: takenHere
    return tnId
}

# hoistRows -- the synth Assignment / AtomId rows a hoisted argument shows as
# in the dump, stamped with the argument's and the parameter's types; the
# Assignment's id, 0 for a compile, which reserves no rows.
hoistRows: function {
    ast: Ast
    st: zenv.ZSymbolTable
    argType: ztypes.tid
    paramType: ztypes.tid
    ln: u32
    co: u32
} out zast.nodeid is {
    if st.typing.dumpRows.not then return zast.nodeid
    # the rows stand for no source text, so they report from no file
    assignId: zast.tableReserve :ast from: zast.nodeid.zero
    atomId: zast.tableReserve :ast from: zast.nodeid.zero
    st.typing.synthNodes.append (
        ztyping.SynthNode
        nodeid: assignId
        kind: "Assignment"
        ownerUnit: st.walk.fn.synthOwnerUnit
        ownerName: st.walk.fn.synthOwnerName
        lineno: ln
        colno: co
    )
    st.typing.synthNodes.append (
        ztyping.SynthNode
        nodeid: atomId
        kind: "AtomId"
        ownerUnit: st.walk.fn.synthOwnerUnit
        ownerName: st.walk.fn.synthOwnerName
        lineno: ln
        colno: co
    )
    stampGate :st nid: assignId tid: argType
    atomT: argType
    if paramType.notZero then atomT = paramType
    stampGate :st nid: atomId tid: atomT
    return assignId
}

# lockBorrowedArgPath -- a reftype argument passed to a locking parameter has
# its whole value path locked for the call, not just its root: a write through
# any prefix would move the storage the callee is reading.
lockBorrowedArgPath: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    arg: argref
    isViewArg: bool
    pins: List ztyping.PinPath
    # the call's result keeps the lock (an `outx` callee, a construction):
    # only then is the path recorded as a pin
    calleePins: bool
    # what the argument keeps locked (readValuePins), and its flags; the path
    # it is read from joins them when it keeps nothing else
    av: List ztyping.PinPath
    ar: pinread
} out pinread is {
    an: ast.nodes.get i: arg.operation
    seen: valueTupleRoot :ast n: an
    if seen.isZero then return ar
    # residue left by an EARLIER argument of this call must not stand in for
    # THIS argument's source: keep a pending path only when it is rooted at
    # this argument's own base. A base that names no variable -- a method read
    # off a call's result, `(xs.get i: 0).stringView` -- is a value whose
    # pins are what its own walk left, as hoistArg keeps them
    seenVar: (st.lookupVarId nameId: seen).some
    got: ar
    if seenVar when av.length > 0 when (valuechecks.pinRootAt pins: av i: 0) != seen then got = (
        dropArgPins
        :av
    )
    src: ListVal zast.nameid
    fresh: argPinTuple :st :ast n: an dst: src
    if fresh.not when src.length > 0 then {
        rt: src.get i: 0
        if av.length == 0 then {
            rvo: st.lookupVarId nameId: rt
            if rvo.some then {
                got = dropArgPins :av
                pinsPush :st path: src shared: true mutable: isViewArg.not
                pinsAppend pins: av path: src shared: true mutable: isViewArg.not carried: false
                # the call's result keeps this pin: a path-shaped argument
                # pins exactly as a bare one does
                if calleePins then {
                    pinsAppend :pins path: src shared: true mutable: isViewArg.not carried: false
                }
            }
        } else if calleePins then pinsFromArg :av :pins :isViewArg
    }
    return got
}

# dropArgPins -- an argument's pins go, and with them what describes their
# value: the argument is its path alone.
dropArgPins: function {av: List ztyping.PinPath} out pinread is {
    for av.length > 0 loop av.pop
    return (pinread owned: false marker: ztypes.zparamownership.noneMode)
}

# pinsFromArg -- the pins an argument's own read left (a call returning a view
# of its base, `b.sv`), onto `pins`: the call's result keeps them as it would
# the argument's path
pinsFromArg: function {
    av: (List ztyping.PinPath).view
    pins: List ztyping.PinPath
    isViewArg: bool
} is {
    for each pp: av loop {
        pinsAppend :pins path: pp.path shared: true mutable: isViewArg.not carried: false
    }
}

# lockFieldArgForCall -- a field read through names (`o.it`) handed to a
# locking parameter is held by the CALL for its duration, so the
# one-appearance rule sees it: the field's owner or the same field passed
# again in this call is the same value twice. Answers whether the call holds
# it: the argument's hoisted temp then lays no lock of its own on the path, so
# the argument is one lock, the call's.
lockFieldArgForCall: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    arg: argref
    isViewArg: bool
} out bool is {
    opN: ast.nodes.get i: arg.operation
    if (movedFieldPath :st :ast n: opN).not then return false
    src: ListVal zast.nameid
    appendValueTuple :ast n: opN dst: src
    if (st.lookupVarId nameId: (src.get i: 0)).none then return false
    (
        lockCallArgPath
        :st
        pool: ast.names
        path: src
        callId: call.nid
        mutable: isViewArg.not
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
        queued: true
    )
    return true
}

# moveTakenTempLocks -- a taken value no name holds (a construction over a
# lock-holder, an `outx` result) carries its locks into the slot as a moved
# name's go. Its hoisted temporary `tnm` is already taken, so it is found by
# its declaration.
moveTakenTempLocks: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tnm: zast.nameid
    # the argument is an owned value with locks, at a taking parameter
    taken: bool
    # the callable whose receiver could keep the temporary, zero when none
    keeper: zast.nodeid
    # the call's result holds the value
    calleePins: bool
    # the call's pins, which the value's locks join
    pins: List ztyping.PinPath
    arg: argref
} is {
    if taken.not then return
    tkd: st.findLocal nameId: tnm
    tkv: st.typing.declLocalVarOf declId: tkd
    if tkv.isZero then return
    # a `w.take` argument is reported as w
    movedNm: takenNameText :ast nid: arg.operation
    (
        moveHeldLocksIntoSlot
        :st
        :ast
        name: movedNm.stringView
        vid: tkv
        :keeper
        :calleePins
        :pins
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
    )
}

# refuseViewToWriter -- a `.view` result (`xs.get i: 0`) lent to a parameter
# that may write it is refused, as the same result is as a receiver
# (`(xs.get i: 0).pop`) and as a name bound to it: a view converts to no other
# ownership. The marker is the argument's own: its value was just walked. A
# value-type field read off the result (`(xs.get i: 0).node`) is a copy of its
# own, as it is bound by a let, and lends nothing.
refuseViewToWriter: function {
    st: zenv.ZSymbolTable
    ast: Ast
    vt: ztypes.tid
    isLockish: bool
    isViewArg: bool
    isTake: bool
    arg: argref
    # the argument's marker (readValuePins)
    marker: ztypes.zparamownership
} is {
    if isLockish.not or isViewArg or isTake then return
    if marker != ztypes.zparamownership.viewMode then return
    if (st.reg.isReftypeOf tid: vt).not then return
    target: "this parameter".string
    if arg.name.notZero then target = "'\{zast.nameTextAt :ast ref: arg.name}'"
    (
        addError
        :st
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
        e: zast.err.ownerError
        msg: "a `.view` result cannot be lent to \{target}, which may write it: a view converts to no other ownership"
    )
}

# lockNonTrivialArg -- an argument the call cannot hoist to a temp keeps its
# source: take it, or lock the path it reads through for the call's duration.
# A locked path joins `pins`, the locks the call's result may keep.
lockNonTrivialArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    vt: ztypes.tid
    pt: ztypes.tid
    isTake: bool
    isLockish: bool
    isViewArg: bool
    # the parameter is the callee's receiver: a valtype locks like a class
    isRecvArg: bool
    # a valtype bound to `.borrow` or `.view`: its field path and its hoisted
    # temp take the call lock, and for a pinning (`outx`) callee the pins a
    # reftype's take
    valByPointer: bool
    pins: List ztyping.PinPath
    # what could keep a taken argument past the call, zero when none
    keeper: zast.nodeid
    # the call's result keeps the locks its arguments place
    calleePins: bool
    arg: argref
} is {
    # what the argument keeps locked: an if/match/block's arms' pins, any other
    # value's record; the place it is read from joins them (lockBorrowedArgPath)
    av: List ztyping.PinPath
    ar: (
        readValuePins
        :st
        :ast
        :vt
        nid: arg.operation
        borrowing: true
        writes: true
        verb: "pass"
        dst: av
    )
    refuseViewToWriter :st :ast :vt :isLockish :isViewArg :isTake :arg marker: ar.marker
    # A construction or take parameter consumes the hoisted
    # temp inside the call scope; a lock/borrow parameter
    # locks it there.
    consumes: false
    if isTake then consumes = true
    # a plain field-path argument behaves as its user-
    # written hoist would: seed the borrow side channel with
    # the real source tuple, which the call's own lock on the
    # path (lockFieldArgForCall) or the hoisted temp holds
    byRef: isRecvArg or (st.reg.isReftypeOf tid: vt)
    # what the result of an `outx` callee keeps locked is every borrow and view
    # argument, whatever its family
    pinsLike: byRef or (valByPointer and calleePins)
    callHolds: false
    if isLockish when pinsLike then {
        ar = lockBorrowedArgPath :st :ast :arg :isViewArg :pins :calleePins :av :ar
        callHolds = lockFieldArgForCall :st :ast :call :arg :isViewArg
    } else if isLockish when valByPointer then {
        callHolds = lockFieldArgForCall :st :ast :call :arg :isViewArg
    }
    hadPending: av.length > 0
    # an OWNED value holding locks (a construction, an `outx` result); a
    # borrowed one is refused at a taking slot on its own account -- but a view
    # is moved as a copy that views what it viewed, lent or owned
    ownsPins: hadPending and (ar.owned or (valuechecks.isViewFamilyTid :ast :st tid: vt))
    tnm: (
        hoistArg
        :ast
        :st
        argId: arg.operation
        argType: vt
        paramType: pt
        :consumes
        viewParam: isViewArg
        argPins: av
        :callHolds
    )
    moveTakenTempLocks :st :ast :tnm taken: isTake and ownsPins :keeper :calleePins :pins :arg
    # an owned value no name holds, lent to a call whose result keeps it locked:
    # the result pins the temp, which outlives the call as an unnamed local. A
    # root that names no variable (`mkList`, auto-called) holds nothing either.
    argRoot: rootNameIdOf :ast n: (ast.nodes.get i: arg.operation)
    rootIsVar: argRoot.notZero and (st.lookupVarId nameId: argRoot).some
    pinTemp: false
    if calleePins when isLockish when pinsLike then {
        # a fresh value at the end of a variable's path is the unnamed local,
        # not the path
        pinTemp = rootIsVar.not
        if rootIsVar then pinTemp = argIsFresh :st :ast nid: arg.operation
    }
    if pinTemp then {
        tnId: tnm
        pinsAppendOne :pins nameId: tnId shared: isViewArg mutable: isViewArg.not
        tvo: st.lookupVarId nameId: tnId
        if tvo.some then {
            st.walk.value.adoptableTemps.set key: tnId value: tvo
            # the call's own scope pops before the result is judged, and it must
            # not list a temporary that result keeps locked
            st.walk.value.pinnedTempPending.set key: tvo value: true
        }
    }
    if hadPending.not when isLockish when byRef or valByPointer then {
        (
            lockCallArg
            :st
            pool: ast.names
            nameId: tnm
            callId: call.nid
            shared: true
            mutable: isViewArg.not
            nodeid: (zast.nodeIdOf n: (ast.nodes.get i: arg.operation))
            lineno: (nodeLine n: (ast.nodes.get i: arg.operation))
            colno: (nodeCol n: (ast.nodes.get i: arg.operation))
            queued: true
        )
    }
}

# hoistTrivialArg -- an argument the call CAN hoist to a temp still locks its
# source when the parameter borrows it: the temp aliases the same storage. A
# locked source joins `pins`, the locks the call's result may keep.
hoistTrivialArg: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    vt: ztypes.tid
    pt: ztypes.tid
    isTake: bool
    isLockish: bool
    isViewArg: bool
    # the parameter is the callee's receiver: a valtype locks like a class
    isRecvArg: bool
    # a valtype bound to `.borrow` or `.view`: a bare name takes the call lock,
    # and the pin a pinning (`outx`) callee's result keeps, as a reftype's does
    valByPointer: bool
    pins: List ztyping.PinPath
    # what could keep a taken bare name past the call, zero when none
    keeper: zast.nodeid
    # the call's result will hold a taken value (an `outx` callee, a construction)
    calleePins: bool
    arg: argref
} is {
    # A trivial literal argument coerces in place at the
    # parameter boundary (no hoist: restamp its bare node).
    if pt.notZero then {
        argNid: nodeId n: (ast.nodes.get i: arg.operation)
        if argNid.notZero then {
            stamped: pt
            stampGate :st nid: argNid tid: stamped
        }
    }
    # A bare-name reftype argument: a take parameter consumes
    # it (the overlay propagates out on pop); a lock/borrow
    # parameter locks it for the call. A `:name` shorthand
    # argument is the same bare local read and resolves
    # identically: a take parameter consumes it, a lock/borrow
    # parameter locks it (see docs/typechecker.pdoc, `:name` at
    # the argument site).
    bnId: zast.atomNameIdOf n: (ast.nodes.get i: arg.operation)
    if bnId.isZero then {
        bnId = atomNameId :ast n: (ast.nodes.get i: arg.operation)
    }
    byRef: isRecvArg or (st.reg.isReftypeOf tid: vt)
    if bnId.notZero when byRef or valByPointer then {
        bvo: st.lookupVarId nameId: bnId
        if bvo.some then {
            if isTake then {
                # the only leg that spells the name: the diagnostics it may
                # raise are written from the text
                bnT: zast.nameTextAt :ast ref: bnId
                (
                    consumeBareArgOwnership
                    :st
                    :ast
                    name: bnT.stringView
                    vid: bvo
                    :keeper
                    :calleePins
                    :pins
                    nodeid: (zast.nodeIdOf n: (ast.nodes.get i: arg.operation))
                    lineno: (nodeLine n: (ast.nodes.get i: arg.operation))
                    colno: (nodeCol n: (ast.nodes.get i: arg.operation))
                )
            } else {
                if isLockish then {
                    (
                        lockCallArg
                        :st
                        pool: ast.names
                        nameId: bnId
                        callId: call.nid
                        shared: true
                        mutable: isViewArg.not
                        nodeid: (zast.nodeIdOf n: (ast.nodes.get i: arg.operation))
                        lineno: (nodeLine n: (ast.nodes.get i: arg.operation))
                        colno: (nodeCol n: (ast.nodes.get i: arg.operation))
                        queued: true
                    )
                    # the call's result keeps this pin
                    if calleePins when byRef or valByPointer then {
                        pinsAppendOne :pins nameId: bnId shared: true mutable: isViewArg.not
                    }
                }
            }
        }
    }
}

# moveArmLeavesIntoArgument -- `f s: (if c then w else ..)` with a taking `s`:
# an arm that yields a bare local moves it into the argument on that arm's
# path, as `f s: w` does, its locks following it where that move sends them.
moveArmLeavesIntoArgument: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    # what could keep an arm's moved local past the call, zero when none
    keeper: zast.nodeid
    # the call's result holds the value
    calleePins: bool
    # the call's pins, which the moved value's locks join
    pins: List ztyping.PinPath
} is {
    if (isControlValue :ast nid: arg.operation).not then return
    moveArmFieldLeaves :st :ast nid: arg.operation
    leaves: ListVal zast.nodeid
    armValueLeaves :st :ast nid: arg.operation into: leaves
    for each lf: leaves loop {
        from: armLeafLocal :st :ast nid: lf
        if from.notZero when (armLeafReadsRef :st nid: lf) then {
            partial: armLeafIsPartial :st :ast :leaves :from
            nm: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: lf))
            (
                consumeBareArgOwnership
                :st
                :ast
                name: nm.stringView
                vid: from
                :keeper
                :calleePins
                :pins
                nodeid: lf
                lineno: (nodeLine n: (ast.nodes.get i: lf))
                colno: (nodeCol n: (ast.nodes.get i: lf))
            )
            if partial then markLeafTakeMaybe :st :ast leaf: lf
            st.typing.armLeafMoves.add item: lf
        }
    }
}

# moveArmFieldLeaves -- an arm of a taken value that reads storage something else
# owns -- a field, an element a call hands back -- is refused, as the same value
# written alone is.
moveArmFieldLeaves: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} is {
    leaves: ListVal zast.nodeid
    armBorrowedLeaves :st :ast :nid into: leaves
    for each lf: leaves loop {
        ln: ast.nodes.get i: lf
        lt: walkTypeOf :st nid: lf
        refuseBorrowedMove :st :ast n: ln vt: lt verb: "into a `.take` parameter"
    }
}

# atomReadsNoVariable -- the argument `op` is a bare name that reads no
# variable, yet yields a reftype value: a function it auto-calls or a type it
# constructs. Such a value is owned by nothing that is named.
atomReadsNoVariable: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    op: zast.nodeid
    vt: ztypes.tid
} out bool is {
    if (st.reg.isReftypeOf tid: vt).not then return false
    nm: zast.atomNameIdOf n: (ast.nodes.get i: op)
    if nm.isZero then return false
    return (st.lookupVarId nameId: nm).none
}

# hoistAndLockArg -- what the CALL does to the argument's source: hoist a
# non-trivial value to a temp, take ownership of it, or place the lock a
# borrowed parameter holds for the call's duration. A locked source joins
# `pins`, the locks the call's result may keep.
hoistAndLockArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    vt: ztypes.tid
    pt: ztypes.tid
    isTake: bool
    isLockish: bool
    isViewArg: bool
    # the parameter is the callee's receiver, so a valtype argument is passed
    # by reference and locks like a dotted receiver
    isRecvArg: bool
    # a valtype bound to an explicit `.borrow` or `.view`: it takes the call
    # lock a reftype argument takes, and pins no result
    valByPointer: bool
    pins: List ztyping.PinPath
    # handed on to the hoist: what could keep a taken argument (methodKeeperOf)
    keeper: zast.nodeid
    # the call's result will hold a taken value (an `outx` callee, a construction)
    calleePins: bool
    arg: argref
} is {
    trivial: argIsTrivial :ast op: (ast.nodes.get i: arg.operation)
    # a bare name that is no variable -- a function it auto-calls, a type it
    # constructs -- hands over a value no name holds: a temporary like a call's
    if trivial when (atomReadsNoVariable :st :ast op: arg.operation :vt) then trivial = false
    if trivial then {
        (
            hoistTrivialArg
            :st
            :ast
            :call
            :vt
            :pt
            :isTake
            :isLockish
            :isViewArg
            :isRecvArg
            :valByPointer
            :pins
            :keeper
            :calleePins
            :arg
        )
    } else {
        (
            lockNonTrivialArg
            :st
            :ast
            :call
            :vt
            :pt
            :isTake
            :isLockish
            :isViewArg
            :isRecvArg
            :valByPointer
            :pins
            :keeper
            :calleePins
            :arg
        )
    }
}

# signatureText -- a function type spelled as its signature is written,
# `function {x: i64 v: String.view} outx StringView`: each parameter's marker,
# and `out` or `outx` with the return's marker, are part of what a slot of the
# type accepts (functionSignaturesMatch). A function type is named after what
# declares it -- the function, or a function field's signature -- and that name
# says nothing about what it takes.
signatureText: function {st: zenv.ZSymbolTable.view ast: Ast.view tid: ztypes.tid} out String is {
    seen: ListVal ztypes.tid
    return (signatureTextWithin :st :ast :tid :seen)
}

# signatureTextWithin -- signatureText inside the signatures `seen` lists. A
# function type one of its own members names again -- `f: function {s: f}` --
# is spelled by its name there, as its signature has no end.
signatureTextWithin: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tid: ztypes.tid
    seen: ListVal ztypes.tid
} out String is {
    seen.append tid
    r: "function".string
    ps: signatureParamsText :st :ast :tid :seen
    if ps.length > 0 then r.append " {\{ps}}"
    r.append (conform.signatureReturnText :st :ast :tid :seen)
    seen.pop
    return r
}

# signatureMemberName -- the type of a signature's parameter or return as the
# signature spells it: specWrittenName, but a function type already being
# spelled (`seen`) by its name.
signatureMemberName: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tid: ztypes.tid
    seen: ListVal ztypes.tid
} out String is {
    if (spelledAsSignature :st :tid).not then return (declWrittenName :st :ast :tid)
    if (seen.contains item: tid) then return (declWrittenName :st :ast :tid)
    return (signatureTextWithin :st :ast :tid :seen)
}

# signatureParamsText -- a function type's parameters as its signature writes
# them, each with its marker: `x: i64 v: String.view`
signatureParamsText: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tid: ztypes.tid
    # the signatures being spelled, this one last
    seen: ListVal ztypes.tid
} out String is {
    ps: String
    ns: st.typing.declRowSlots ownerTid: tid
    k: u64
    for k < ns loop {
        row: st.typing.declRowAt ownerTid: tid membersOnly: true slot: k
        k = k + 1
        if row.keep then {
            if ps.length > 0 then ps.append " "
            if row.name == zast.wellKnown.slot.wkThis then {
                ps.append ":this"
            } else {
                ptn: signatureMemberName :st :ast tid: row.tid :seen
                ps.append "\{zast.nameTextAt :ast ref: row.name}: \{ptn}"
                pm: st.typing.declOwnershipOfId parentTypeId: tid nameId: row.name
                if pm.some then {
                    ps.append "."
                    ps.append (conform.markerText o: pm)
                }
            }
        }
    }
    return ps
}

# spelledAsSignature -- `tid` is a function type no program writes by a name of
# its own: a function field's signature, named after the field, or the type of
# a function with a body, named after the function. A spec -- a function type
# declared without a body -- is a type a program names, and so is a generic
# template, which only an application of it spells.
spelledAsSignature: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if (st.reg.genericOriginOf :tid).notZero then return false
    if (st.reg.isGenericOf :tid) then return false
    fd: st.typing.declIdOfType typeId: tid
    if fd.notZero when (st.typing.decls.get i: fd).fnptrField then return true
    if (st.reg.typetypeOf typeId: tid) != ztypes.ztypetype.functionType then return false
    return ((st.walk.fn.hasBody.get key: tid).or d: false)
}

# typeArgWrittenName -- a type argument as an application spells it. A function
# type is named, not spelled out: its signature can name this very application
# (`held: function {xs: (List held)}`), and would be spelled without end.
typeArgWrittenName: function {
    st: zenv.ZSymbolTable.view ast: Ast.view tid: ztypes.tid
} out String is {
    if (spelledAsSignature :st :tid) then return (st.reg.nameOf :tid)
    return (specWrittenName :st :ast :tid)
}

# declWrittenName -- a declaration as a program names it: its name, or for an
# instance of a generic one the application that names it, `(Getter i64)`.
# The first argument is written without its label, as the style guide writes
# it (lint L003); every later one carries its label: `(MapRR String V: i64)`.
# A message naming a function itself says this; the function's TYPE, as a
# value has it, is spelled by specWrittenName.
# Trailing arguments that are their parameter's default are left out, as the
# instance's label leaves them (defaultsTailLength): `(ListVal u8)`. An
# instance's numeric parameter as a type is named through the instance,
# `(Box 5).cap`, except where the walk reads the parameter's bare name as
# that very type -- the instance's own code -- which names it `cap`, as the
# template's walk does.
declWrittenName: function {st: zenv.ZSymbolTable.view ast: Ast.view tid: ztypes.tid} out String is {
    sg: st.typing.singletons.get key: tid
    # a template's own parameter is named as the template's body names it
    if sg.some when sg.instance.notZero when (
        (statics.monoSingletonOf :st nameId: sg.param) != tid
    ) then {
        sw: declWrittenName :st :ast tid: sg.instance
        sw.append "."
        sw.append (zast.nameTextAt :ast ref: sg.param)
        return sw
    }
    org: st.reg.genericOriginOf :tid
    if org.isZero then return (st.reg.nameOf :tid)
    otid: org
    r: "(\{declWrittenName :st :ast tid: otid}"
    tdecl: st.typing.declIdOfType typeId: otid
    pns: st.reg.genericParamNamesOf :tdecl
    n: st.reg.genericArgCount specId: tid
    for n > 1 loop {
        if (argIsItsDefault :st :tdecl spec: tid ordinal: n - 1).not then break
        n = n - 1
    }
    i: u64
    for i < n loop {
        a: st.reg.genericArgAt specId: tid ordinal: i
        at: String
        match (
            a
        ) case valueArg then {
            at = st.reg.valueArgText :tdecl paramName: (st.reg.genericParamNameAt :tdecl :i) bits: a
        } case typeArg then {
            at = typeArgWrittenName :st :ast tid: a
        }
        if i > 0 when i < pns.length then {
            pt: zast.nameTextAt :ast ref: (pns.get :i)
            r.append " \{pt}: \{at}"
        } else {
            r.append " \{at}"
        }
        i = i + 1
    }
    r.append ")"
    return r
}

# argIsItsDefault -- whether the spec's `ordinal`th argument is a type its
# parameter's default named (one recorded by defaultTypeTid).
argIsItsDefault: function {
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    spec: ztypes.tid
    ordinal: u64
} out bool is {
    d: st.reg.genericParamDefaultTidAt :tdecl i: ordinal
    if d.isZero then return false
    return (st.reg.genericTypeArgAt specId: spec :ordinal) == d
}

# takenBareName -- the name `x` of a value written `x.take`, or 0.
takenBareName: function {ast: Ast.view nid: zast.nodeid} out zast.nameid is {
    vn: ast.nodes.get i: nid
    if vn.dottedpath.not then return zast.nameid
    cid: atomNameId :ast n: (ast.nodes.get i: vn.child)
    if cid != zast.wellKnown.slot.wkTake then return zast.nameid
    return (zast.atomNameIdOf n: (ast.nodes.get i: vn.parent))
}

# callReceiverId -- the receiver node of the dotted call `call` (`4` in
# `4 + w`, `"ab"` in `"ab".substring ...`), 0 when the callee is not dotted.
callReceiverId: function {ast: Ast.view call: callref} out zast.nodeid is {
    cb: ast.nodes.get i: call.callable
    if cb.dottedpath then return cb.parent
    return zast.nodeid
}

# callArgsFold -- every argument of the call `call` has a compile-time value; true
# for no call.
callArgsFold: function {st: zenv.ZSymbolTable.view ast: Ast.view call: zast.nodeid} out bool is {
    if call.isZero then return true
    cn: ast.nodes.get i: call
    match (
        cn
    ) case call then {
        for each aId: (zast.kidsOf :ast span: cn.arguments) loop {
            op: aId
            an: ast.nodes.get i: aId
            match an case namedoperation then op = an.operation else null
            if (st.typing.nodeConstAt nid: op).isConst.not then return false
        }
    } else null
    return true
}

# landLiteralReceiver -- a literal that is the receiver of a native `method`
# LANDS where the method reads it, as a literal argument lands in its
# parameter: a number's operator in the type its one generic parameter is bound
# to (`4 + w` with `w: u64` reads 4 as a u64), `times`, `upto` and `downto` in
# the number's default, i64, and every member of a string literal in its
# StringView. It must fit there, and its node is stamped with that type, which
# is the type the operation is emitted in, as that type's member of the same
# name. A conversion settles its literal itself, and a method bound to or
# returning a literal type is computed by the compiler: neither lands -- while
# the operation has a compile-time value. One with none, a value only run time
# knows (`(if c then 1 else 2).u8`, `1 + (if c then 4 else 5)`), is no literal
# the compiler can compute with: what nothing else gives a type lands in its
# default, as it does when it is bound, and the operation is that type's. The
# answer is then the member it runs as, whose result is the operation's (a
# conversion of an i64 answers a Result); 0 where something else gave the type
# (an operand's, whose instance has the result already), for an operation that
# folds, and for one that lands nowhere. `recv` is the receiver's node, a
# call's or an auto-called path's; `instance` is the generic call's instance, 0
# for a method that is not generic; `call` is the call, 0 for an auto-called
# path, which takes no arguments.
landLiteralReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast
    recv: zast.nodeid
    method: ztypes.tid
    instance: ztypes.tid
    call: zast.nodeid
} out ztypes.tid is {
    if method.isZero or (st.reg.isNativeOf tid: method).not then return ztypes.tid.zero
    if recv.isZero then return ztypes.tid.zero
    rt: walkTypeOf :st nid: recv
    target: valuechecks.literalLandingTid :st :ast :rt :method :instance
    folds: (st.typing.nodeConstAt nid: recv).isConst
    if folds then folds = callArgsFold :st :ast :call
    defaulted: (
        folds.not and
        (target.isZero or (valuechecks.isAnyLiteralTid :st tid: target)) and
        (
            isLiteralTypeId
            reg: st.reg
            tid: rt
        )
    )
    if defaulted then target = valuechecks.materialiseLiteral :ast :st t: rt
    if target.isZero or (valuechecks.isAnyLiteralTid :st tid: target) then return ztypes.tid.zero
    if (
        (st.reg.typetypeOf typeId: target) == ztypes.ztypetype.genericParam
    ) then return ztypes.tid.zero
    rn: ast.nodes.get i: recv
    (
        numerics.checkNumericCoercion
        :st
        :ast
        dstTid: target
        srcTid: rt
        valueNid: recv
        nodeid: recv
        lineno: (nodeLine n: rn)
        colno: (nodeCol n: rn)
    )
    stampGate :st nid: recv tid: target
    # the member the operation runs as is the target's, demanded here where
    # that is decided: the emitter reads it and resolves nothing itself
    nm: (st.typing.decls.get i: (st.typing.declIdOfType typeId: method)).name
    owner: memberaccess.typedefMemberOwner :st :ast bt: target cnId: nm
    forceMemberOf :st :ast parentTypeId: owner nameId: nm
    stdtypes.markMemberUsed :st ownerTid: owner nameId: nm
    if defaulted.not then return ztypes.tid.zero
    return (st.typing.declTypeOf declId: (st.typing.declMemberIdOf parentTypeId: owner nameId: nm))
}

# landedResult -- the result of an operation on a literal receiver once
# landLiteralReceiver has landed it: what the member it runs as returns, on the
# type it landed in, stamped on `stampNid` (the call) when there is one;
# `result` itself when it did not land.
landedResult: function {
    st: zenv.ZSymbolTable
    recv: zast.nodeid
    landed: ztypes.tid
    result: ztypes.tid
    stampNid: zast.nodeid
} out ztypes.tid is {
    if landed.isZero then return result
    lro: conform.methodReturnOf reg: st.reg typing: st.typing mid: landed
    if lro.none then return result
    r: selfReturnOnInstance :st recvTid: (walkTypeOf :st nid: recv) ret: lro
    if stampNid.notZero then stampGate :st nid: stampNid tid: r
    return r
}

# stampArgDisposition -- record what the call does with the argument `op`:
# the emitter zeroes the source of a taken one after the call, and the LSP
# words it. Keyed by the value node.
stampArgDisposition: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    op: zast.nodeid
    own: ztypes.zparamownership
} is {
    dispNid: nodeId n: (ast.nodes.get i: op)
    if dispNid.isZero then return
    dispVal: own
    st.typing.argDisposition.set key: dispNid value: dispVal
}

# bindBoxedArgument -- the box's value argument once its type is known. A
# TRIVIAL argument (a bare name or a literal) is stamped with the boxed type at
# its innermost node; anything else is hoisted. A box holds a value type (its
# `anyval` bound), so no argument is a reftype name to move into it.
bindBoxedArgument: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    argT: ztypes.tid
} is {
    if (argIsTrivial :ast op: (ast.nodes.get i: arg.operation)).not then {
        hp: List ztyping.PinPath
        appendRecordPins :st vp: (valuePinsOf :st nid: arg.operation) dst: hp
        (
            hoistArg
            :ast
            :st
            argId: arg.operation
            argType: argT
            paramType: ztypes.tid.zero
            consumes: true
            viewParam: false
            argPins: hp
        )
        return
    }
    iid: nodeId n: (ast.nodes.get i: arg.operation)
    if iid.notZero then stampGate :st nid: iid tid: argT
}

# returnedBareFieldName -- `return <base>.<field>` where the member is a field
# (memberReadIsField) whose type is a reftype, or generic and may instantiate to
# one: the bare read escapes a shallow copy of storage the owner still frees.
# Returns the field name for the diagnostic; "" when the return shape is fine.
returnedBareFieldName: function {
    ast: Ast
    st: zenv.ZSymbolTable
    nid: zast.nodeid
} out String is {
    arm: declare.rowArmAt :ast :nid
    match (
        arm
    ) case dottedpath then {
        dr: statics.dpRefAt :ast :nid
        bfcId: dottedMemberId :st :ast :nid child: dr.child
        if bfcId.isZero then return "".string
        if (isStripMarkerId nameId: bfcId) then return "".string
        bft: walkTypeOf :st nid: dr.parent
        if bft.isZero then return "".string
        forceMemberOf :st :ast parentTypeId: bft nameId: bfcId
        if (memberReadIsField :st parentNid: dr.parent nameId: bfcId).not then return "".string
        bfo: st.typing.declChildOfId parentTypeId: bft nameId: bfcId
        match (
            bfo
        ) case some then {
            if (st.reg.typetypeOf typeId: bfo) == ztypes.ztypetype.genericParam then {
                if (
                    flow.genericFieldMayBeReftype
                    :ast
                    :st
                    ownerTid: bft
                    fieldTid: bfo
                ) then return (zast.nameTextCopy :ast ref: bfcId)
                return "".string
            }
            if (st.reg.isReftypeOf tid: bfo) then return (zast.nameTextCopy :ast ref: bfcId)
            return "".string
        } case none then {
            return "".string
        }
    } else {
        return "".string
    }
}

# refuseYieldedBorrow -- a yield moves its value out to the caller, as a
# `return` through `out` does. A value that keeps something locked is refused
# (refuseYieldedLocks). So is one read out of storage something else owns -- a
# field, a borrowed name, a value a call lends -- whether it is the value
# itself or an arm of an `if` or a `match`.
refuseYieldedBorrow: function {st: zenv.ZSymbolTable ast: Ast arg: argref argT: ztypes.tid} is {
    if argT.isZero then return
    errs: st.typing.errors.length
    valuechecks.refuseYieldedLocks :st :ast :arg :argT
    if st.typing.errors.length != errs then return
    verb: "as a yielded value"
    refuseBorrowedMove :st :ast n: (ast.nodes.get i: arg.operation) vt: argT :verb
    refuseBorrowedArms :st :ast nid: arg.operation :verb
}

# reportReturnedBareField -- a bare field read returned as an owned result: the
# owner still frees it, so returning it hands the caller a second owner of the
# same storage.
reportReturnedBareField: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
} is {
    if st.walk.fn.currentReturnMarker.isReference then return
    bfn: returnedBareFieldName :ast :st nid: arg.operation
    if bfn.length == 0 then return
    fieldN: ast.nodes.get i: arg.operation
    txt: String
    exprTextOf :ast n: fieldN dst: txt
    borrowedMoveError :st :ast n: fieldN text: txt.stringView verb: "as an owned result"
}

# recordReturnedOwnedLocal -- a returned owned local is CONSUMED: record the
# transfer so L022 does not offer a view for it. A BORROWED source returned as
# an owned result is refused on the way: it aliases storage the caller still
# frees, and both bindings destroy it. Parameters borrow by default and a
# receiver is always borrowed, so the bare name is the whole tell. A DESTRUCTOR
# is what makes it a double free -- a StringView is a reftype too, but it is a
# fat pointer with no owned interior, and copying one frees nothing.
recordReturnedOwnedLocal: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    argT: ztypes.tid
} is {
    if argT.isZero then return
    if (st.reg.isReftypeOf tid: argT).not then return
    if (isControlValue :ast nid: arg.operation) then {
        refuseReturnedArms :st :ast nid: arg.operation
        # an arm that yields a bare local returns it on that arm's path
        leaves: ListVal zast.nodeid
        armValueLeaves :st :ast nid: arg.operation into: leaves
        for each lf: leaves loop {
            from: armLeafLocal :st :ast nid: lf
            if from.notZero then {
                lt: st.reg.variableTypeOf id: from
                if (armLeafReadsRef :st nid: lf) then {
                    partial: armLeafIsPartial :st :ast :leaves :from
                    returnOwnedLocal :st :ast nid: lf vid: from tid: lt
                    # the arm hands the local out on its path, as a binding of
                    # the value takes it
                    lfn: ast.nodes.get i: lf
                    (
                        st.invalidateDeclAs
                        declId: (st.findLocal nameId: (zast.atomNameIdOf n: lfn))
                        loc: optionval.some (
                            ztypes.zsrcpos
                            fsno: zvfs.fsno
                            lineno: (nodeLine n: lfn)
                            colno: (nodeCol n: lfn)
                        )
                        maybe: partial
                    )
                    st.typing.armLeafMoves.add item: lf
                }
            }
        }
        return
    }
    rbnId: zast.atomNameIdOf n: (ast.nodes.get i: arg.operation)
    if rbnId.isZero then return
    rvv: st.lookupVarId nameId: rbnId
    rvid: ztypes.vid
    if rvv.some then {
        rvid = rvv
    }
    if rvid.isZero then return
    returnOwnedLocal :st :ast nid: arg.operation vid: rvid tid: argT
}

# refuseReturnedArms -- an arm that yields a field read is refused as a returned
# bare field read is, and one that yields storage a call pinned to its source as a
# returned borrowed name is: the owner still frees what the return hands back.
refuseReturnedArms: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} is {
    if st.walk.fn.currentReturnMarker.isReference then return
    refuseReturnedArmReferences :st :ast :nid
    leaves: ListVal zast.nodeid
    armBorrowedLeaves :st :ast :nid into: leaves
    for each lf: leaves loop {
        ln: ast.nodes.get i: lf
        lt: walkTypeOf :st nid: lf
        if (st.reg.needsDestructor typeId: lt) then {
            la: (
                argref
                nid: lf
                name: zast.nameid
                operation: lf
                lineno: (nodeLine n: ln)
                colno: (nodeCol n: ln)
            )
            errR: st.typing.errors.length
            reportReturnedBareField :st :ast arg: la
            if st.typing.errors.length == errR then {
                refuseBorrowedMove :st :ast n: ln vt: lt verb: "as an owned result"
            }
        }
    }
}

# refuseReturnedArmReferences -- an arm or `with` that ends on a name IT
# declared which borrows -- `with w: s do w` -- returns that reference as an
# owned result, as `w: s; return w` would: the storage stays its source's, which
# the return would hand the caller a second owner of. Refused alike.
refuseReturnedArmReferences: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} is {
    leaves: ListVal zast.nodeid
    armValueLeaves :st :ast :nid into: leaves
    for each lf: leaves loop {
        ln: ast.nodes.get i: lf
        if (zast.atomNameIdOf n: ln).notZero when (armLeafLocal :st :ast nid: lf).isZero when (
            armLeafBorrowed
            :st
            nid: lf
        ) when (returnHandsOnStorage :st tid: (walkTypeOf :st nid: lf)) then (
            reportReturnedBorrowedName
            :st
            :ast
            nid: lf
        )
    }
}

# returnOwnedLocal -- the local `vid` of type `tid`, read by the atom `nid`,
# returned as an owned result.
returnOwnedLocal: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    vid: ztypes.vid
    tid: ztypes.tid
} is {
    # a borrowed name returned bare hands the caller storage its source still
    # owns (returnHandsOnStorage)
    lends: st.walk.fn.currentReturnMarker.isReference
    if (returnHandsOnStorage :st :tid) when lends.not when (isBorrowedVar :st :vid) then (
        reportReturnedBorrowedName
        :st
        :ast
        :nid
    )
    st.typing.variableMoved.add item: vid
}

# returnHandsOnStorage -- a value of `tid` returned bare hands the caller storage:
# a user class is passed by reference, and returning it bare takes it, as
# `return p.take` would (a destructor-less one reached the C as a pointer
# returned for a struct); anything else when it has something to destroy. A view,
# or a by-value sum with nothing to destroy, owns nothing, and handing it on
# copies nothing that matters.
returnHandsOnStorage: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    isClass: (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.classType
    # a native class that owns storage has a destructor; one without is a view
    if isClass then isClass = (st.reg.isNativeOf :tid).not
    return isClass or (st.reg.needsDestructor typeId: tid)
}

# reportReturnedBorrowedName -- the borrowed name read by the atom `nid`,
# returned as an owned result: the caller still owns what it names.
reportReturnedBorrowedName: function {st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid} is {
    rbNm: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: nid))
    mbr: "Cannot return borrowed variable '\{rbNm}' as an owned result — the caller still owns it; return '\{rbNm}.copy' (duplicate), declare the source '.take' (transfer ownership in), or declare the return '.borrow'"
    (
        addError
        :st
        nodeid: (zast.nodeIdOf n: (ast.nodes.get i: nid))
        lineno: (nodeLine n: (ast.nodes.get i: nid))
        colno: (nodeCol n: (ast.nodes.get i: nid))
        e: zast.err.ownerError
        msg: mbr
    )
}

# checkReturnedValue -- one value handed to `return`: its own type, then every
# question the enclosing function's declaration asks of it.
checkReturnedValue: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    arg: argref
} is {
    # a function answering nothing may hand on what a call answering nothing
    # gives (`return j.call` where `call` is `out null`), as `null` itself
    if st.walk.fn.currentReturnsNothing when (resolve.returnsNullValue :st :unitDecl :ast :arg
    ) then return
    # an instance whose type argument makes the declared `out` null returns
    # nothing: what its body hands to `return` is that null
    if st.walk.fn.currentOutIsNullArg then {
        checkValueAt :st :unitDecl :ast nid: arg.operation
        stampGate :st nid: arg.operation tid: st.typing.nullTypeId
        return
    }
    if st.walk.fn.currentReturnsNothing then {
        opn: ast.nodes.get i: arg.operation
        (
            addErrorWithHint
            :st
            nodeid: (zast.nodeIdOf n: opn)
            lineno: (nodeLine n: opn)
            colno: (nodeCol n: opn)
            e: zast.err.typeError
            msg: "a function with no `out` type returns no value".string
            note: "the declaration names no `out`, so its callers receive nothing".string
            hint: "declare the `out` type, or use a bare `return`".string
            width: 1
        )
        return
    }
    errR: st.typing.errors.length
    argT: ztypes.tid
    if st.walk.fn.currentReturnMarker.isReference then {
        argT = checkValueAt :st :unitDecl :ast nid: arg.operation
    } else {
        argT = valuechecks.checkMovedValueAt :st :unitDecl :ast nid: arg.operation owning: true
    }
    # A returned value that typed to nothing and raised nothing is an
    # unresolvable name -- but ONLY where this walk knows the enclosing
    # function's return type. Some bodies reach here degenerate (zlexer's
    # create/acceptAny: return type unknown, the local's own binding never
    # registered a scope entry), and there the scope cannot answer whether a
    # name is in scope. currentReturnTypeId is exactly the condition under
    # which the return-type check below already runs.
    if argT.u64 == 0 when (
        st.typing.errors.length == errR
    ) when st.walk.fn.currentReturnTypeId.notZero then {
        valuechecks.reportUnresolvedValue :st :unitDecl :ast nid: arg.operation
    }
    reportReturnedBareField :st :ast :arg
    recordReturnedOwnedLocal :st :ast :arg :argT
    rpins: List ztyping.PinPath
    rr: returnedPins :st :ast :arg :argT dst: rpins
    if (checkReturnRooting :st :ast :arg :argT :rpins marker: rr.marker).not then (
        checkReturnCarries
        :st
        :ast
        :arg
        :argT
        :rpins
    )
    numerics.checkReturnTypeMatch :st :ast :arg :argT
}

# lockMethodReceiver -- the lock a method call places on its RECEIVER: a mutating
# method takes it exclusively, a `view` receiver shares it, and a receiver that
# is not a bare name locks the path it was reached through. Both families lock:
# a valtype receiver is passed by reference exactly as a class is, so a
# `{:this}` method on a `.view` record parameter conflicts with the parameter's
# readonly self-lock the same way a class method does. Answers whether that
# lock was SHARED -- the strength the result's pin keeps on the receiver.
lockMethodReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    dro: ztypes.tid
    # the receiver atom's name id, zero when the receiver is not a bare atom
    rroId: zast.nameid
} out bool is {
    recvShared: true
    if rroId.notZero then {
        recvVid: st.lookupVarId nameId: rroId
        if recvVid.some then {
            recvTid: st.lookup nameId: rroId
            if recvTid.some then {
                recvShared = callReadsReceiver :st mid: dro nid: call.callable
                (
                    lockCallArg
                    :st
                    pool: ast.names
                    nameId: rroId
                    callId: call.nid
                    shared: recvShared
                    mutable: recvShared.not
                    nodeid: call.nid
                    lineno: call.lineno
                    colno: call.colno
                )
            }
        }
    }
    if rroId.isZero then recvShared = lockNestedMethodReceiver :st :ast :call :dro
    return recvShared
}

# lockNestedMethodReceiver -- the receiver is not a bare name (st.reg.map.get
# ...), so the root-name lock cannot see it: lock the full receiver tuple for
# the call; the immediate receiver type (the stamped parent) drives the
# reader/writer kind. Answers whether the lock was SHARED (true when nothing
# was locked).
lockNestedMethodReceiver: function {
    # the symbol table the lock row is laid in
    st: zenv.ZSymbolTable
    # the tree the receiver path is read from
    ast: Ast.view
    # the call whose receiver is locked
    call: callref
    # the method called, whose receiver marker sets the strength
    dro: ztypes.tid
} out bool is {
    recvShared: true
    # Nested receiver (st.reg.map.get ...): the root-name
    # block above cannot see it. Lock the full receiver
    # tuple; the immediate receiver type (the stamped
    # parent) drives the reader/writer kind.
    rtupC: ListVal zast.nameid
    callableNode: ast.nodes.get i: call.callable
    methodReceiverTuple :ast n: callableNode dst: rtupC
    if rtupC.length > 1 then {
        rvoN: st.lookupVarId nameId: (rtupC.get i: 0)
        if rvoN.some then {
            callableNode: ast.nodes.get i: call.callable
            rpidN: dottedReceiverNodeId :ast n: callableNode
            rvtN: walkTypeOf :st nid: rpidN
            if rvtN.notZero then {
                recvShared = callReadsReceiver :st mid: dro nid: call.callable
                (
                    lockCallPath
                    :st
                    :ast
                    pool: ast.names
                    path: rtupC
                    callId: call.nid
                    shared: recvShared
                    mutable: recvShared.not
                    nodeid: call.nid
                    lineno: call.lineno
                    colno: call.colno
                )
            }
        }
    }
    return recvShared
}

# checkResolvedMethodCall -- the callable resolved through the dotted walk to a
# METHOD: check its arguments against that method's parameters, and answer what
# the call yields. The typedef and projection constructor forms answer here
# too, since they reach the walk the same way.
# a leg's answer: whether it fully handled the call, and the type it yields.
checkResolvedMethodCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dro: ztypes.tid
} out ztypes.tid is {
    tdcb: createDottedBaseId :ast n: (ast.nodes.get i: call.callable)
    tdcid: zast.nodeid
    if tdcb.some then {
        tdcid = tdcb
    }
    # `T.create ...` from inside T's own create -- the explicit spelling
    # of the same recursion the bare-name leg refuses. The dotted base's
    # stamped type is the type being constructed, the same move the
    # synthesized-create leg below makes.
    if tdcid.notZero then {
        sctid: walkTypeOf :st nid: tdcid
        if sctid.notZero then {
            (
                callchecks.ctorSelfRecursionAt
                :st
                nodeid: call.nid
                lineno: call.lineno
                colno: call.colno
                width: 1
                ctorTid: sctid
            )
        }
    }
    if tdcid.notZero then {
        dleg: callchecks.checkTypedefOrProjectionCall :st :unitDecl :ast :call :tdcid
        if dleg.handled then return dleg.tid
    }
    mcm: st.pushCall node: call.nid
    # A DOTTED BASE THAT NAMES A TYPE leaves the receiver to the
    # arguments (`Counter.increment c`); every other base passes it
    # through the dot.
    # AN INFIX LEFT OPERAND IS A VALUE EXPRESSION. `a op b` evaluates `a` the
    # way any value position does -- a function auto-calls, a bare type name
    # constructs -- so the receiver always arrives through the dot. Only the
    # DOTTED spelling reads its left as a path, where a bare type name is
    # type-qualified dispatch and hands the receiver to the arguments.
    # checkDottedCallableCall answered whether the base names a type, once, for
    # every dotted call (callBaseNamesType); an infix call is never in it
    recvVal: (st.typing.callBaseNamesType.has item: call.nid).not
    rvPins: List ztyping.PinPath
    rvT: takeValueReceiver :st :ast :unitDecl :call funcId: dro :recvVal pins: rvPins
    pins: (
        callchecks.walkCallArgsHoist
        :st
        :unitDecl
        :ast
        :call
        funcId: dro
        isCtor: false
        reportUnknown: false
        recvImplicit: recvVal
    )
    callchecks.checkMissingCallArgs :ast :st :call funcId: dro isCtor: false recvImplicit: recvVal
    callchecks.reportDottedNoParameters :st :ast :call funcId: dro
    callchecks.checkNativeTemplateArgs :st :ast :call funcId: dro recvImplicit: recvVal
    # The receiver locks for the call's duration too, after
    # the args; the strength it took is the strength the result's pin
    # keeps on it.
    rro: methodReceiverRootId :ast n: (ast.nodes.get i: call.callable)
    recvShr: lockMethodReceiver :st :ast :call :dro rroId: rro
    st.popTo marker: mcm
    mres: ztypes.tid
    mro: conform.methodReturnOf reg: st.reg typing: st.typing mid: dro
    if mro.some then {
        # a self-type return reached on an instance is the instance, as the
        # dotted auto-call answers it
        recvTid: walkTypeOf :st nid: (dottedReceiverNodeId :ast n: (ast.nodes.get i: call.callable))
        mres = selfReturnOnInstance :st :recvTid ret: mro
        setmr: mres
        stampGate :st nid: call.nid tid: setmr
    }
    landedC: (
        landLiteralReceiver
        :st
        :ast
        recv: (callReceiverId :ast :call)
        method: dro
        instance: ztypes.tid.zero
        call: call.nid
    )
    mres = (
        landedResult
        :st
        recv: (callReceiverId :ast :call)
        landed: landedC
        result: mres
        stampNid: call.nid
    )
    # A synthesized `create` has no recorded return: explicit
    # `.create` constructs, so the result is the base type.
    if mres.isZero then {
        cdb: createDottedBaseId :ast n: (ast.nodes.get i: call.callable)
        cdbid: zast.nodeid
        if cdb.some then {
            cdbid = cdb
        }
        if cdbid.notZero then {
            btid: walkTypeOf :st nid: cdbid
            if btid.notZero then {
                mres = btid
                stampResult: mres
                stampGate :st nid: call.nid tid: stampResult
            }
        }
    }
    # the receiver's pin: its tuple when its root is a variable (a
    # unit-qualified free function reached through this path has none,
    # and pins its arguments alone), at the strength the call took
    rtupP: ListVal zast.nameid
    receiverResultPath :st :ast :call funcId: dro :rvT :rvPins :pins dst: rtupP
    pinCallResult :st pool: ast.names funcId: dro :pins recvPath: rtupP recvShared: recvShr
    st.typing.callKind.set key: call.nid value: zast.callkind.regular
    return mres
}

# movePayloadIntoArm -- an owned arm stores its payload OWNED: a bare-name
# reftype payload moves in, its locks with it, which the value being built
# keeps as a construction keeps a moved-in field's (pushCarriedPins); any other
# payload's locks come in its record (composeChildRecord). A non-owned arm pins
# its payload instead (pinPayloadOfArm), whatever its family: it holds a
# pointer to a valtype as to a reftype, as a `.view` parameter does.
movePayloadIntoArm: function {
    st: zenv.ZSymbolTable
    ast: Ast
    # the payload's value node
    op: zast.nodeid
    # the payload's type
    vt: ztypes.tid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    # the type built and the arm it selects
    dtp: ztypes.tid
    armId: zast.nameid
} is {
    if vt.isZero then return
    if (st.typing.declIsBorrowedFieldId parentTypeId: dtp nameId: armId) then {
        amd: st.typing.declMemberIdOf parentTypeId: dtp nameId: armId
        armView: (st.typing.decls.get i: amd).ownership == ztypes.zparamownership.viewMode
        pinPayloadOfArm :st :ast :op :armView :nodeid :lineno :colno
        return
    }
    if (st.reg.isReftypeOf tid: vt).not then return
    carry: List ztyping.PinPath
    bn: zast.atomNameIdOf n: (ast.nodes.get i: op)
    if bn.notZero then {
        bvo: st.lookupVarId nameId: bn
        if bvo.some then {
            bnT: zast.nameTextAt :ast ref: bn
            (
                consumeBareArgOwnership
                :st
                :ast
                name: bnT.stringView
                vid: bvo
                keeper: zast.nodeid
                calleePins: true
                pins: carry
                :nodeid
                :lineno
                :colno
            )
            stampArgDisposition :st :ast :op own: ztypes.zparamownership.takeMode
        }
    }
    pushCarriedPins :st pins: carry
}

# pinPayloadOfArm -- a non-owned arm (`some: T.borrow`, `some: t.view`) holds a
# reference into its payload's source, as a non-owned field does: a payload
# that names a variable or a field of one is pinned for the life of the value
# built at the arm's strength -- EXCLUSIVE for `.borrow`, SHARED for `.view` --
# its owner keeps it, and nothing is moved. A value that names no storage -- a
# call's result, a literal, a constant, a function's name -- has nothing for
# the arm to point at, and is refused, as a marker on it is.
pinPayloadOfArm: function {
    st: zenv.ZSymbolTable
    ast: Ast
    # the payload's value node
    op: zast.nodeid
    # the arm is `.view`: it only reads what it points at
    armView: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    pth: ListVal zast.nameid
    {
        pn: ast.nodes.get i: op
        if pn.atomid or pn.dottedpath then appendValueTuple :ast n: pn dst: pth
    }
    if pth.length == 0 then {
        (
            addError
            :st
            :nodeid
            :lineno
            :colno
            e: zast.err.ownerError
            msg: "a non-owned arm points into its payload's source, and a temporary has none that outlives the statement: bind the value to a name first".string
        )
        return
    }
    if (st.lookupVarId nameId: (pth.get i: 0)).none then {
        rnm: zast.nameTextAt :ast ref: (pth.get i: 0)
        (
            addError
            :st
            :nodeid
            :lineno
            :colno
            e: zast.err.ownerError
            msg: "a non-owned arm points into its payload's source, and '\{rnm}' names no storage: bind the value to a name first"
        )
        return
    }
    own: ztypes.zparamownership.borrowMode
    if armView then own = ztypes.zparamownership.viewMode
    stampArgDisposition :st :ast :op :own
    pinsPush :st path: pth shared: true mutable: armView.not
    st.walk.value.draft.owned = true
}

# checkGenericFnCall -- a GENERIC FUNCTION member reached through the dotted
# walk dispatches through the same machinery its bare-name form does: infer the
# type arguments from the call, mint the instance, and answer its return.
checkGenericFnCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dro: ztypes.tid
} out ztypes.tid is {
    # the arguments' locks and the receiver's live in one call scope, laid in
    # that order exactly as the concrete-method path lays them, so a receiver
    # that is also an argument meets the argument's row. A generic method's
    # writer receiver conflicts with live views the same way (the conflict
    # check happens at take; the pop releases it before the next statement).
    # A unit-member callee (io.eprintln) has no value root and skips.
    mcmG: st.pushCall node: call.nid
    # a dotted base that names a type leaves the receiver to the arguments
    # (`Acc.put a text: s`), as on the concrete leg (checkResolvedMethodCall)
    recvVal: true
    if (methodHasThisReceiver :st mid: dro) then recvVal = (
        st.typing.callBaseNamesType.has
        item: call.nid
    ).not
    # the locks the call's result may keep: a hoisted argument's temporary
    # joins them AS IT IS MINTED, in argument order, so the walk and the
    # instance's own pass write to one list
    rvPinsG: List ztyping.PinPath
    rvTG: takeValueReceiver :st :ast :unitDecl :call funcId: dro :recvVal pins: rvPinsG
    pinsG: List ztyping.PinPath
    errG: st.typing.errors.length
    gfr: conform.checkGenericCall :st :unitDecl :ast :call funcId: dro pins: pinsG
    if gfr.notZero then {
        setgf: gfr
        stampGate :st nid: call.nid tid: setgf
    }
    st.typing.callKind.set key: call.nid value: zast.callkind.regular
    callableNode: ast.nodes.get i: call.callable
    midG: genericCallInstance :st :ast :call
    # a refused binding says all there is to say: the receiver lands nowhere
    landedG: ztypes.tid
    if st.typing.errors.length == errG then landedG = (
        landLiteralReceiver
        :st
        :ast
        recv: (callReceiverId :ast :call)
        method: dro
        instance: midG
        call: call.nid
    )
    gfr = (
        landedResult
        :st
        recv: (callReceiverId :ast :call)
        landed: landedG
        result: gfr
        stampNid: call.nid
    )
    callchecks.checkGenericCallMissingArgs :ast :st :call mid: midG recvImplicit: recvVal
    rroG: methodReceiverRootId :ast n: callableNode
    recvShrG: lockMethodReceiver :st :ast :call :dro rroId: rroG
    st.popTo marker: mcmG
    # the result pins the receiver as a concrete method's does
    rtupG: ListVal zast.nameid
    if recvVal then (
        receiverResultPath
        :st
        :ast
        :call
        funcId: midG
        rvT: rvTG
        rvPins: rvPinsG
        pins: pinsG
        dst: rtupG
    )
    if midG.notZero then (
        pinCallResult
        :st
        pool: ast.names
        funcId: midG
        pins: pinsG
        recvPath: rtupG
        recvShared: recvShrG
    )
    return gfr
}

# genericCallInstance -- the function instance a generic call minted, read
# back off the callable's stamp; zero when inference failed.
genericCallInstance: function {
    st: zenv.ZSymbolTable.view ast: Ast.view call: callref
} out ztypes.tid is {
    cnid: nodeId n: (ast.nodes.get i: call.callable)
    return (walkTypeOf :st nid: cnid)
}

# pinGenericCallResult -- what a generic call's result keeps locked: the pins
# its arguments collected, answered by the instance's return markers.
pinGenericCallResult: function {
    st: zenv.ZSymbolTable
    pool: zast.StringPool.view
    mid: ztypes.tid
    pins: (List ztyping.PinPath).view
} is {
    if mid.isZero then return
    noRecv: ListVal zast.nameid
    pinCallResult :st :pool funcId: mid :pins recvPath: noRecv recvShared: true
}

# pinConstructionSources -- a construction of `tid` pins its sources exactly as
# a direct call of the same `create` does. `outx this` is a statement about what
# the RESULT holds -- a reference into an argument -- so which spelling reached
# the create, the bare type name, `T.create`, or a generic type's applied or
# inferred instance, cannot change it. The binding stays owned; only the sources
# are pinned.
pinConstructionSources: function {
    st: zenv.ZSymbolTable ast: Ast.view tid: ztypes.tid pins: (List ztyping.PinPath).view
} is {
    cxO: st.typing.declChildOfId parentTypeId: tid nameId: zast.wellKnown.slot.wkCreate
    match (
        cxO
    ) case some then {
        noRecvC: ListVal zast.nameid
        cxPins: st.typing.funcPins.has item: cxO
        if cxPins.not when (typeHasNonOwnedField :st :ast :tid) then {
            # a create that does not say `outx this` on a type declaring a
            # non-owned field is the SYNTHESISED one (a written one is
            # refused): the construction pins as `outx this` would
            pinConstructionResult :st pool: ast.names :pins
        } else {
            pinCallResult :st pool: ast.names funcId: cxO :pins recvPath: noRecvC recvShared: true
        }
    } case none then {
        # no `create` written: the construction IS the constructor, and a
        # type declaring a non-owned field is built `outx this` -- every
        # borrowed-field argument stays pinned under the result
        if (typeHasNonOwnedField :st :ast :tid) then (
            pinConstructionResult
            :st
            pool: ast.names
            :pins
        )
    }
}

# genericArgPreHoist -- what a generic call decides about one argument BEFORE
# it hoists it, the same three things `checkTypedCallArg` decides: the
# argument's disposition (which the emitter reads to zero a taken source and
# the LSP to word it), the refusal a field handed to a taking parameter earns,
# and what could keep a taken argument past the call (methodKeeperOf), which
# it answers: zero when nothing could.
genericArgPreHoist: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    funcId: ztypes.tid
    aow: argownership
    bnId: zast.nameid
    opN: astnode.view
    vt: ztypes.tid
    pins: List ztyping.PinPath
    calleePins: bool
    arg: argref
} out zast.nodeid is {
    if aow.isTake or aow.isLockish or aow.isHold then {
        dispVal: ztypes.zparamownership.borrowMode
        if aow.isViewArg then dispVal = ztypes.zparamownership.viewMode
        if aow.isHold then dispVal = ztypes.zparamownership.holdMode
        if aow.isTake then dispVal = ztypes.zparamownership.takeMode
        stampArgDisposition :st :ast op: arg.operation own: dispVal
    }
    keeper: zast.nodeid
    if aow.isTake.not then return keeper
    if bnId.isZero then moveGenericFieldArg :st :ast :arg :opN :vt
    keeper = callchecks.methodKeeperOf :st :call :funcId
    moveArmLeavesIntoArgument :st :ast :arg :keeper :calleePins :pins
    return keeper
}

# moveGenericFieldArg -- a path handed to a generic call's taking parameter: a
# field is refused as a borrowed value, and one that owns nothing moves through
# checkFieldMove.
moveGenericFieldArg: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    arg: argref
    opN: astnode.view
    vt: ztypes.tid
} is {
    stampArgDisposition :st :ast op: arg.operation own: ztypes.zparamownership.takeMode
    errM: st.typing.errors.length
    refuseBorrowedTake :st :ast n: opN :vt
    if st.typing.errors.length == errM when (isMarkedMove :ast n: opN).not then {
        checkFieldMove :st :ast n: opN
    }
}

# appendValuePin -- a copy of pin `p` onto the value-pin arena, with the variable
# its root names here (none when it names none).
appendValuePin: function {st: zenv.ZSymbolTable p: ztyping.PinPath.view} is {
    rv: (st.lookupVarId nameId: (p.path.get i: 0)).or d: ztypes.vid
    st.walk.value.pinRoots.append rv
    st.walk.value.pins.append (
        ztyping.PinPath
        path: p.path.copy
        shared: p.shared
        mutable: p.mutable
        carried: p.carried
    )
}

# valuePinsOf -- the record of the value at `nid`: an empty run when its walk
# made no pins.
valuePinsOf: function {st: zenv.ZSymbolTable.view nid: zast.nodeid} out ztyping.valuepins is {
    none: ztyping.valuepins start: 0 len: 0 owned: false marker: ztypes.zparamownership.noneMode
    vp: (st.walk.value.pinsAt.get key: nid).or d: none
    return vp
}

# moveYieldedLocals -- a block's value that is a local of the block's own is
# moved out of it where the block ends: the local leaves scope there, and the
# value goes on to whatever receives the block's. `lineId` is the block's last
# line, walked, its scope still open.
moveYieldedLocals: function {st: zenv.ZSymbolTable ast: Ast lineId: zast.nodeid} is {
    valueNid: (
        implicitReturnValue
        reg: st.reg
        typing: st.typing
        :ast
        :lineId
        lineType: (walkTypeOf :st nid: lineId)
    )
    if valueNid.notZero then moveYieldedValue :st :ast :valueNid
}

# moveYieldedValue -- the value `valueNid` leaves the innermost open scope as
# that scope's value: each owned local of the scope it yields is moved out.
# Each value it yields is asked, an `if`'s or a `match`'s arm by arm and a
# block's through its last line: the local is moved on every path when every
# one of them is that local, and on some otherwise. A local of an enclosing
# scope outlives this one, and what receives the value decides whether it
# moves.
moveYieldedValue: function {st: zenv.ZSymbolTable ast: Ast valueNid: zast.nodeid} is {
    leaves: ListVal zast.nodeid
    if (isControlValue :ast nid: valueNid) then {
        armValueLeaves :st :ast nid: valueNid into: leaves
    } else {
        leaves.append from: valueNid
    }
    for each lf: leaves loop {
        from: armLeafLocal :st :ast nid: lf
        if from.isZero then continue
        d: st.findLocal nameId: (zast.atomNameIdOf n: (ast.nodes.get i: lf))
        if d.isZero then continue
        if (st.innermostOpenIs scope: (st.typing.declParentOf declId: d)).not then continue
        if (st.ownsDestroy vid: from).not then continue
        partial: armLeafIsPartial :st :ast :leaves :from
        st.invalidateDeclAs declId: d loc: takenHere maybe: partial
        st.typing.armLeafMoves.add item: lf
    }
}

# noteDropReleasedTemps -- a `.drop` released its binding's holds: an unnamed
# local a binding held that nothing holds now dies at the drop, for a
# temporary belongs to the borrows of it and lives no longer than they do. A
# drop in an arm or a loop body frees it on that path only: it stays held for
# the other paths, where a later release frees it in turn.
noteDropReleasedTemps: function {st: zenv.ZSymbolTable dropNid: zast.nodeid} is {
    onPath: st.inPath
    kept: ListVal zast.nameid
    for st.walk.value.heldTemps.length > 0 loop {
        nm: st.walk.value.heldTemps.pop
        p: ListVal zast.nameid
        p.append nm
        if (st.isPathLocked path: p) then {
            kept.append nm
        } else {
            st.typing.dropTemps.append (ztyping.droptemp :dropNid temp: nm)
            if onPath then kept.append nm
        }
    }
    for kept.length > 0 loop st.walk.value.heldTemps.append kept.pop
}

# lastStmtLineId / lastStmtLineIdAt -- the node id of a function body's last
# statement line (the implicit-return position), or 0 when absent.
lastStmtLineId: function {ast: Ast.view block: astnode.view} out zast.nodeid is {
    if block.statement then {
        ne: block.statements.count.u64
        if ne > 0 then {
            lastId: zast.kidAt kids: ast.kids span: block.statements i: ne - 1
            last: ast.nodes.get i: lastId
            if last.statementline then return last.nodeid
        }
    }
    return zast.nodeid
}

# the node id of the last statement line in operation `oId`.
lastStmtLineIdAt: function {ast: Ast.view oId: zast.nodeid} out zast.nodeid is {
    if oId.isZero then return zast.nodeid
    return (lastStmtLineId :ast block: (ast.nodes.get i: oId))
}

# checkImplicitReturn -- the value an `out`-typed function body ends on IS its
# return, as the value handed to `return` is: it is asked every question a
# returned value is, and a literal takes the declared type on the line. A body
# that ends on a binding, a write, or an expression with no value returns
# nothing it declared. A control construct with no value of its own returns on
# each of its paths or it is refused: the walk marks the end unreachable when
# none of them gets there.
checkImplicitReturn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    defn: fnref
    # the error count before the body walk: a tail that already failed has no
    # value because of that failure, which is not a second one to report
    bodyErrs: u64
} is {
    expR: st.walk.fn.currentReturnTypeId
    if expR.isZero or defn.body.isZero or st.walk.fn.currentReturnsNothing then return
    # a generator's body yields its values; its synthesised `.call` returns none
    if (bodies.generatorCallOf typing: st.typing nid: defn.nid).notZero then return
    lsid: lastStmtLineIdAt :ast oId: defn.body
    valId: zast.nodeid
    if lsid.notZero then valId = (
        implicitReturnValue
        reg: st.reg
        typing: st.typing
        :ast
        lineId: lsid
        lineType: (walkTypeOf :st nid: lsid)
    )
    if valId.isZero then {
        if st.typing.errors.length == bodyErrs then reportValuelessTail :st :ast :defn :lsid :expR
        return
    }
    argT: walkTypeOf :st nid: valId
    if (isControlValue :ast nid: valId) then argT = valueArmsTid :st :ast nid: valId first: argT
    vn: ast.nodes.get i: valId
    arg: (
        argref
        nid: valId
        name: zast.nameid
        operation: valId
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
    )
    reportReturnedBareField :st :ast :arg
    recordReturnedOwnedLocal :st :ast :arg :argT
    rpins: List ztyping.PinPath
    rr: returnedPins :st :ast :arg :argT dst: rpins
    if (checkReturnRooting :st :ast :arg :argT :rpins marker: rr.marker).not then (
        checkReturnCarries
        :st
        :ast
        :arg
        :argT
        :rpins
    )
    numerics.checkReturnTypeMatch :st :ast :arg :argT
    if (valuechecks.isAnyLiteralTid :st tid: argT) then stampGate :st nid: lsid tid: expR
    recordTailExit :st :ast lineId: lsid :valId
}

# recordTailExit -- what the tail line `lineId` of a value-returning body
# destroys as it returns its value `valId` (exitDestroy, as a `return` of it
# records): every scope of the function, but the local it hands back when the
# value is a bare name. A `with` or `do` line hands return position to its own
# last line, which records instead.
recordTailExit: function {
    st: zenv.ZSymbolTable ast: Ast.view lineId: zast.nodeid valId: zast.nodeid
} is {
    if valId.isZero then return
    vn: ast.nodes.get i: valId
    # a `do` line, and a `with` that hands return position to its own body,
    # record at that body's last line instead
    if vn.doexpr then return
    if (flow.withForwardsTail :ast n: vn) then return
    ret: ztypes.vid
    rn: zast.atomNameIdOf n: vn
    if rn.notZero then ret = (st.lookupVarId nameId: rn).or d: ztypes.vid
    st.recordReturnDestroy nid: lineId except: ret
    if st.recording then st.typing.tailExits.add item: lineId
}

# implicitReturnValue -- the expression an `out`-typed function body's last line
# hands back: the line's own expression when it yields a value. 0 for a line
# that yields none -- a binding, a write, an exchange, an expression with no
# type or typed `null` -- and for one that diverges, which leaves on every path
# itself. The caller reads the line's type: the walk its own stamp, the emitter
# the one it emits by. Both ask here, so what is checked as a return is what is
# emitted as one.
implicitReturnValue: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ast: Ast.view
    lineId: zast.nodeid
    # the type stamped on the line
    lineType: ztypes.tid
} out zast.nodeid is {
    innerId: zast.nodeid
    ln: ast.nodes.get i: lineId
    if ln.statementline then innerId = ln.statementline
    if innerId.isZero then return innerId
    if (lineIsStatementOnly :ast :lineId) then return zast.nodeid
    # a bare `return`, `break` or `continue` leaves rather than yields
    ctl: flow.ctlDivKind bn: (zast.atomNameIdOf n: (ast.nodes.get i: innerId))
    if ctl > 0 then return zast.nodeid
    if lineType.isZero then return zast.nodeid
    if (reg.typetypeOf typeId: lineType) == ztypes.ztypetype.neverType then return zast.nodeid
    # `null`, or a call answering nothing, is no value to hand back
    if lineType == typing.nullTypeId then return zast.nodeid
    return innerId
}

# lineIsStatementOnly -- the statement line `lineId` is a binding, a write or an
# exchange: it does its work and yields no value, whatever type its line is
# stamped with (a binding's line carries the bound type).
lineIsStatementOnly: function {ast: Ast.view lineId: zast.nodeid} out bool is {
    ln: ast.nodes.get i: lineId
    if ln.statementline.not then return false
    arm: declare.rowArmAt :ast nid: ln.statementline
    return arm.assignment or arm.reassignment or arm.swapstmt
}

# reportValuelessTail -- an `out`-typed function body whose last line has no
# value: a control construct is refused only when some path falls out of it,
# anything else always is.
reportValuelessTail: function {
    st: zenv.ZSymbolTable ast: Ast defn: fnref lsid: zast.nodeid expR: ztypes.tid
} is {
    if lsid.notZero when (flow.tailIsControl :st :ast lineId: lsid) then {
        # a template's walk has not read what each instance folds: they answer
        if st.isUnreachable.not when st.recording then reportTailFallsOut :st :ast :lsid :expR
        return
    }
    reportNoTailValue :st :ast :defn :lsid :expR
}

# reportTailFallsOut -- an `out`-typed function body ending on a control construct
# that some path falls out of, with no value to return. Reported at the construct.
reportTailFallsOut: function {
    st: zenv.ZSymbolTable ast: Ast.view lsid: zast.nodeid expR: ztypes.tid
} is {
    en: specWrittenName :st :ast tid: expR
    lnode: ast.nodes.get i: lsid
    (
        addErrorWithHint
        :st
        nodeid: lsid
        lineno: (nodeLine n: lnode)
        colno: (nodeCol n: lnode)
        e: zast.err.typeError
        msg: "missing return value: function expects '\{en}', and a path through its body reaches the end without one"
        note: "".string
        hint: "return a value on every path: add the missing `else`, or end the body on a `return`".string
        width: 1
    )
}

# reportNoTailValue -- an `out`-typed function body that ends on no value.
reportNoTailValue: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    defn: fnref
    lsid: zast.nodeid
    expR: ztypes.tid
} is {
    en: specWrittenName :st :ast tid: expR
    ln: defn.lineno
    co: defn.colno
    if lsid.notZero then {
        lnode: ast.nodes.get i: lsid
        ln = nodeLine n: lnode
        co = nodeCol n: lnode
    }
    (
        addErrorWithHint
        :st
        nodeid: defn.nid
        lineno: ln
        colno: co
        e: zast.err.typeError
        msg: "missing return value: function expects '\{en}', and its body ends on no value"
        note: "".string
        hint: "end the body on the value it returns, or `return` it".string
        width: 1
    )
}
