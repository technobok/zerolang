    declMemberTypeOf: function {:this parentTypeId: u64 nameId: u64} out optionval u64 is {
        # a pool id out of u32 range never labels a member; 0 is the absent id
        n32: nameId.u32.or d: 0
        if n32 == 0 then return (optionval.none u64)
        md9: this.declMemberIdOf :parentTypeId nameId: n32
        if md9 == 0 then return (optionval.none u64)
        t9: u64
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                t9 = mo9.typeId
            } case none then null
        }
        return (optionval.some t9)
    }

    declChildOfId: function {:this parentTypeId: u64 nameId: u64} out optionval u64 is {
        md9: this.declMemberIdOf :parentTypeId nameId: nameId.u32.orPanic
        if md9 == 0 then return (optionval.none u64)
        t9: u64
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                t9 = mo9.typeId
            } case none then null
        }
        if t9 == 0 then return (optionval.none u64)
        return (optionval.some t9)
    }

    # declIsLockField / declIsLockFieldId -- is `name` the lock field of the
    # type that minted parentTypeId? The owning declaration names one member as
    # its lock, so this is a round trip through that pointer.
    declIsLockField: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} out bool is {
        nid9: pool.find s: name
        if nid9 == 0 then return false
        return (this.declIsLockFieldId :parentTypeId nameId: nid9)
    }

    declIsLockFieldId: function {:this parentTypeId: u64 nameId: u32} out bool is {
        od9: this.declIdOfType typeId: parentTypeId
        if od9 == 0 then return false
        lf9: u64
