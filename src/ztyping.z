        ki9: u64
        kn9: kids9.length
        for ki9 < kn9 loop {
            kd9: kids9.get i: ki9
            ki9 = ki9 + 1
            cn9: u32
            cnode9: u32
            ck9: declkind.fieldDecl
            isM9: false
            {
                ko9: this.decls.get key: kd9
                match (
                    ko9
                ) case some then {
                    cn9 = ko9.name
                    cnode9 = ko9.node
                    ck9 = ko9.kind
                    if ko9.kind.fieldDecl then isM9 = true
                    if ko9.kind.methodDecl then isM9 = true
                    if ko9.kind.armDecl then isM9 = true
                } case none then null
            }
            if isM9 then {
                cid9: this.declNew name: cn9 parent: id9 kind: ck9 node: cnode9
