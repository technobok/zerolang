# ZTyping -- the typecheck-output container.
#
# The parser produces a frozen zast.Program; the type checker consumes it
# and produces a ZTyping: every typecheck-derived datum the downstream
# consumers (emitter, SQL dumper) read. It is the data module, kept apart
# from the producer the way zast is kept apart from zparser, and it
# references ztypes.z for ZType and the shared enums.
#
# Representation is id-first and relational: cross-type references are
# stored as u64 type ids (resolved through the registry by the producer),
# and the per-node stamps live in id-keyed Maps. A type's members live on
# its declaration -- the Decl tree is the single member index -- and their
# names are shared Ast.names pool ids. Every mutator runs on :this -- a
# container that owns all of its state -- so mutations persist.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :SynthNode
    :Decl
    :defaultval
    :foldedbranch
    :callslot
    :constslot
    :monostamp
    :nsbody
    :declkind
    :declkindName
    :declrow
    :ZTyping
    :newTyping
    :armside
    :armSideOfName
    :isSumPair
    :sumPairFalsyArmOf
    :sumPairTruthyArmOf
    :armSuffixSideOf
    :nodeTypeAt
    :nodeTypeSet
}

ZType: ztypes.ZType
Node: zast.Node

# --- relational row carriers ---

# The clause a constant fold selected for an `if`. `known` false means the
# conditions did not all fold, so a runtime `if` must be emitted; `known` true
# with `stmt` 0 means every condition was false and there was no else clause,
# so nothing is emitted at all.
foldedbranch: record {
    known: bool
    stmt: zast.nodeid
}

# One typecheck-synthesised AST row for the dump: a node minted during the
# body walk (call-arg hoist temps) that the parsed-program walk cannot reach.
# One member-type write held while its owner had no declaration to land on.
pendwrite: record {
    parent: ztypes.tid
    name: zast.nameid
    type: ztypes.tid
}

# One row of a declChildWalk, read by slot instead of accumulated into a
# list. `keep` IS the walk filter -- the kind narrowing and the `typeId > 0`
# rule -- so a caller that loops slots and skips the rows it says no to is
# running the same walk the list form runs, not a restatement of it.
declrow: record {
    name: u64
    tid: u64
    keep: bool
}

SynthNode: class {
    nodeid: u32
    # the row's shape name, always a literal the emitter of the row spells --
    # a view over program memory, which outlives every row
    kind: StringView
    # the (unit, definition) pair the dump LABEL spells, as the ids ZTyping
    # already carries: three rows are synthesised per hoist and each used to
    # own a copy of the same composed text
    ownerUnit: ztypes.declid
    ownerName: zast.nameid
    lineno: u32
    colno: u32
}

# --- declaration tree ---

# The kind of declaration a Decl records: which definition shape the
# indexer saw. Resolution semantics stay with the readers (a reexport
# shares its target's type id; a publicNs holds the unit's exported
# name -> declaration edges).
declkind: variant {
    # the sentinel row 0 of ZTyping.decls: no declaration
    noneDecl: null
    unitDecl: null
    funcDecl: null
    typeDecl: null
    constDecl: null
    dataDecl: null
    paramDecl: null
    fieldDecl: null
    methodDecl: null
    armDecl: null
    reexportDecl: null
    publicNs: null
    # a body frame: a function's body, or a block, arm, loop or call bracket
    # inside one -- the environment frame the locals written there hang under
    blockDecl: null
    # a local variable or body-level binding (a parameter's body binding, a
    # loop variable, a generic parameter bound for a walk)
    localDecl: null
    # the program root: the one declaration every file unit hangs under, so a
    # file unit is a declaration with a parent like any other
    programDecl: null
} as { tag: u8.tag }

# declkindName -- a declaration kind's dump/debug text.
declkindName: function {k: declkind} out String is {
    match (
        k
    ) case noneDecl then {
        return "none".string
    } case unitDecl then {
        return "unit".string
    } case funcDecl then {
        return "function".string
    } case typeDecl then {
        return "type".string
    } case constDecl then {
        return "const".string
    } case dataDecl then {
        return "data".string
    } case paramDecl then {
        return "param".string
    } case fieldDecl then {
        return "field".string
    } case methodDecl then {
        return "method".string
    } case armDecl then {
        return "arm".string
    } case reexportDecl then {
        return "reexport".string
    } case publicNs then {
        return "publicns".string
    } case blockDecl then {
        return "block".string
    } case localDecl then {
        return "local".string
    } case programDecl then {
        return "program".string
    }
}

# callslot -- which generic parameter of which call site. Two id spaces stay
# two fields; both are widened to u64 so the key has no padding for the
# container's byte hash to read.
callslot: record {
    call: u64
    param: u64
}

# constslot -- which member of which type, for the compile-time value channel.
constslot: record {
    owner: u64
    name: u64
}

# monostamp -- which node of which monomorphisation. One template node carries
# a different answer per instance, so the instance id is part of the key.
monostamp: record {
    mono: u64
    node: u64
}

# nsbody -- a namespace or hidden subunit whose member BODIES are owed a walk.
# The demand path resolves its signatures where it finds it; the bodies are
# walked at the top-level drain, because a body walk inside a resolver runs in
# a grey window.
nsbody: record {
    unitName: zast.nameid
    unitOp: zast.nodeid
}

# defaultval -- a member's default value. `literal` carries the default-expression
# nodeid (re-emitted verbatim); `function`/`arm` carry the target DeclId; `none`
# means no default.
defaultval: variant {
    none: null
    literal: u32
    func: ztypes.declid
    arm: ztypes.declid
} as { tag: u8.tag }

# One declaration: a named definition site in the program. `name` is the
# shared Ast.names pool id; `parent` the enclosing Decl (0 = a tree
# root); `node` the declaring namedoperation's AST nodeid (location via
# fsnoForNode); `typeId` the type this declaration minted (0 until one
# is); `children` the ordered namespace the declaration owns. Body-local
# variables are not Decls -- they keep the lexical variable-id system. On a
# MEMBER declaration `typeId` is the member's own type (what the tid-keyed
# child index records), not one it minted.
Decl: class {
    name: u32
    parent: ztypes.declid
    kind: declkind
    node: u32
    typeId: ztypes.tid
    # ownership -- a param member's binding mode (noneMode when unset); where a
    # param's lock status lives.
    ownership: ztypes.zparamownership
    # defaultVal -- a member's default value (none when unset). (Named
    # defaultVal, not default, which is a C keyword the emitter would not mangle.)
    defaultVal: defaultval
    # demand-resolution state for a unit-level definition: `resolving` is the
    # DFS grey mark (a reference that walks back into it is a cycle back-edge,
    # and uses the forward-decl id instead of re-descending), `defined` the
    # done mark. On the declaration itself, so the walk that finds the
    # definition also finds its state.
    resolving: bool
    defined: bool
    # pending -- a reference found this definition and queued it for
    # resolution (the demand mark); cleared when its turn comes.
    pending: bool
    # walked -- the definition's bodies have been (or are being) type-checked:
    # a type's methods, or a free function's body. The walk is what stamps a
    # body, so this is what the emitter asks before emitting one.
    walked: bool
    # grantsPrivate -- the field's declared type was a `.private` friend handle
    # (syntactic; not derivable from typeId).
    grantsPrivate: bool
    # a unit-kind row that is a lookup FRAME (a file unit, a namespace, a
    # subunit, a template, and their clones -- not a `require:` block): the
    # frame walks ask this bit, never the node
    unitFrame: bool
    # fnptrField -- the member occupies a struct function-pointer slot: an
    # is-block function member of a record or class, or an as-block member of a
    # generic class. Where it was declared, not its kind, decides this.
    fnptrField: bool
    # lockFieldDecl -- on a TYPE decl, which member is the type's lock (0 = none).
    lockFieldDecl: u64
    # conformerName -- on a protocol / facet decl, the name id of the first
    # type in this unit whose as-block named it (0 = none). A spec's `this`
    # binds to that type. On the DECLARATION, so the marker name is scoped by
    # what declared it rather than by the unit it was written in.
    conformerName: u32
    # varId -- on a local declaration bound to a runtime variable, that
    # variable's id (0 for a type-only binding and for every other kind)
    varId: ztypes.vid
    # rows -- on a local, how many overlay rows the body walk currently has
    # laid over it (a take, a narrowing, a lock); the walk's row scan is
    # skipped when there are none
    rows: u64
    # the namespace this declaration owns: name id -> child declaration, in
    # declaration order. One representation answers both questions a namespace
    # is asked -- `children.get` is the lookup and the dense entries are the
    # order -- because an IdMap indexes itself once it outgrows a scan and
    # costs no allocation at all below that.
    children: (IdMapV zast.nameid v: ztypes.declid)
}

# the typing side-tables: every typecheck stamp keyed by AST node id
# (types, monomorphisations, lock overlays) plus the declaration tree, kept
# separate from the frozen AST so the tree is never mutated.
ZTyping: class {
    # typecheck-synthesised AST rows, the per-run `_t` temp-name counter,
    # and the current `unit.def` dump label the body walk maintains.
    synthNodes: (List SynthNode)
    nextTempId: u64
    synthLabel: String
    # the same (unit, definition) pair synthLabel SPELLS, carried as ids. The
    # label is a dump row; the pair is what checkCase resolves a bare
    # `match t` subject against, and a spelled pair had to be split back apart
    # and re-resolved by name to get here.
    synthOwnerUnit: ztypes.declid
    synthOwnerName: zast.nameid
    currentThisTid: ztypes.tid
    # the tid of the FUNCTION whose body is being walked, beside the receiver
    # type above. Together they answer "which member of which type am I in",
    # which `currentThisTid` alone cannot: every method of a type shares it.
    # Zero for a generic mono instance walk, which has no declaration of its
    # own to name.
    currentFnTid: ztypes.tid
    lastLockParamRoot: zast.nameid

    # a generic template's syntactic body divergence (its last statement is a
    # return), recorded at resolution for the clone-scope synthesis.
    fnBodyDiverges: (IdMapV u64 v: bool)
    # function types whose return carries the `.borrow` marker, recorded at
    # resolution; the body walk's auto-call coercion reads it to report the
    # receiver source path.
    funcReturnsBorrow: (IdMapV u64 v: bool)
    # of those, the ones whose reference is READONLY (`out T.view`): the pin
    # they leave on the receiver is shared, so several may be live at once.
    funcReturnsView: (IdMapV u64 v: bool)
    # function types whose return carries `.takex`: an OWNED result that pins
    # its non-owned sources for the binding's life. Not a borrow -- the binding
    # keeps its destructor -- so it is tracked apart from funcReturnsBorrow.
    funcReturnsTakex: (IdMapV u64 v: bool)
    # the fn whose body is being walked declares a `.borrow` return: bare
    # field returns are its contract (the lock/borrow source outlives).
    currentReturnsBorrow: bool
    # the borrow source path a just-coerced BORROW-returning auto-call reported;
    # consumed by the binding sites, drained at statement and call boundaries.
    pendingBorrowPath: (ListVal zast.nameid)
    # the pending borrow is a RETURNED borrow (a `.borrow`-marked return): a
    # read-view of the source, so the binding's leaf lock is SHARED (the
    # container-view model) rather than the exclusive alias default.
    pendingBorrowShared: bool
    # the pending borrow came from an `out T.view` return, so the binding it
    # lands on is READONLY as well as pinned.
    pendingBorrowReadonly: bool
    # the pending pin came from an `out T.takex` return: the SOURCES are pinned
    # for the binding's life, but the binding itself stays OWNED -- it carries a
    # destructor and may be moved. Without this the pin would demote it to a
    # borrow, which is what `borrow`/`view` mean and `takex` does not.
    pendingBorrowOwned: bool
    # per-mono template stamps, written by the post-sweep instance walk when
    # curMonoStamp is set; the emitter's mono re-walks read these where the
    # global table is param-suppressed.
    # monoParamSubst maps the CURRENT mono's generic-param tids to its args
    # (flat substitution at stamp time); live only during the instance walk.
    monoNodeType: (MapVV monostamp v: ztypes.tid)
    # namespace / subunit bodies the demand path owes a walk, and the unit
    # ops already walked -- a subunit of the MAIN unit is walked by the main
    # tree walk and must not be walked twice.
    nsBodiesOwed: (ListVal nsbody)
    nsBodiesWalked: (IdSet u64)
    # the unit ops whose constant definitions have been materialised, so a
    # namespace reached twice -- once as a demanded definition, once as an
    # alias target -- evaluates and reports them once
    nsConstsWalked: (IdSet u64)
    # the generic template ops whose method bodies have been scanned for
    # demands from the template's own frame (once per template)
    templateBodiesScanned: (IdSet u64)
    monoParamSubst: (IdMapV ztypes.tid v: ztypes.tid)
    curMonoStamp: u64
    curMonoFnTid: ztypes.tid

    # child-name id minting (ztyping-local id space)
    # base type name id (pool id) -> resolved builtin tid (currentUnit "");
    # an unresolved 0 is never stored so later resolution can still fill it
    builtinTidMemo: (IdMapV u64 v: ztypes.tid)

    # true once any public-interface rename exists (skips alias lookups otherwise)
    renameSeen: bool
    # true once any member has been marked private (gates cross-unit checks)
    privacySeen: bool
    asConstClone: (IdMapV u64 v: bool)
    generatorWrapper: (IdMapV u64 v: bool)
    typeofShell: (IdMapV u64 v: u32)
    noStampNode: (IdMapV u64 v: bool)
    # FUNCTION tid -> the definition carries a body (a bodyless spec is false)
    fnHasBody: (IdMapV u64 v: bool)
    # a reassignment TARGET path is being checked (a write, not a read)
    inAssignTarget: bool
    # the generic template (its DeclId) whose signature is being
    # registered: its param names are not unit typerefs
    sigGenericDecl: ztypes.declid
    inContainmentEdge: bool
    suppressParamStamps: bool
    suppressBareCtor: bool
    suppressFnAutoCall: bool
    # a FUNCTION stamp that survives here is legitimate, so a bare method
    # reference must not be reported. Distinct from suppressFnAutoCall,
    # which also stops the coercion: a for-header still NEEDS the 0-arg
    # auto-call (`for x: counter loop`) and only wants the error silenced.
    allowBareFnRef: bool
    typedefBaseName: (IdMapV u64 v: zast.nameid)
    # a typedef wrapper's base type id, resolved structurally at declaration
    # (a parameterized base rides the spec trie, a bare atom the unit ladder)
    typedefBaseTid: (IdMapV ztypes.tid v: ztypes.tid)
    mainDefIsReftype: (IdMapV u64 v: bool)
    dpTaggedParent: (IdMapV u64 v: ztypes.tid)
    dpArmPredicate: (IdMapV u64 v: ztypes.tid)
    dpTagRead: (IdMapV u64 v: ztypes.tid)
    tagAccessorName: (IdMapV u64 v: zast.nameid)
    tagAccessorTid: (IdMapV ztypes.tid v: ztypes.tid)
    postGuardName: (IdMapV u64 v: zast.nameid)
    # the subject's variable, beside its name: the emitter asks whether the
    # subject is a pointer receiver, and a name cannot answer that once locals
    # are named by id
    postGuardVarId: (IdMapV u64 v: ztypes.vid)
    postGuardTid: (IdMapV u64 v: ztypes.tid)
    postGuardArm: (IdMapV u64 v: zast.nameid)
    pendingCustomTag: (IdMapV u64 v: zast.nameid)
    pendingCustomTagNode: (IdMapV u64 v: u64)
    pendingDefaultOwner: (IdMapV u64 v: u64)
    pendingDefaultId: (IdMapV u64 v: u64)
    pendingDefaultName: (IdMapV u64 v: zast.nameid)
    constructedTypes: (IdMapV u64 v: bool)
    collectionChildrenBuilt: (IdSet u64)
    # per-call-argument disposition (take/lock/borrow); absent = valtype/none.
    # tooling-only; the emitter never reads it.
    argDisposition: (IdMapV u64 v: ztypes.zparamownership)
    # inferred concrete tid per call, keyed by call node and parameter name
    callGenericBinding: (MapVV callslot v: u64)

    # per-binop operator resolution: the type that DECLARES the operator, after
    # the typedef chase and the Box unwrap, and the method it resolved to.
    # binopMethod is 0 where no declaration was found and the comparison fell
    # back to structural equality; binopOwner is the presence test, and it is
    # never 0. Keyed by nodeid.
    binopOwner: (IdMapV u64 v: ztypes.tid)
    binopMethod: (IdMapV u64 v: ztypes.tid)
    # the same two facts from the per-instance walk, in their own tables
    # because their key is a different thing -- a monostamp, as monoNodeType
    # keys a type stamp, not a nodeid. One template node resolves to a
    # different operator per instantiation, so the answers cannot share a
    # slot -- and they cannot share a TABLE with the nodeid-keyed pair either,
    # or the key would mean one thing or the other depending on who wrote it.
    monoBinopOwner: (MapVV monostamp v: ztypes.tid)
    monoBinopMethod: (MapVV monostamp v: ztypes.tid)

    # per-node single-valued stamps, indexed by nodeid - 1 (node ids are
    # minted dense 1..N, so the stamp IS the slot); 0 means unstamped
    nodeType: (ListVal ztypes.tid)
    callKind: (IdMapV u64 v: zast.callkind)
    atomVariableId: (IdMapV u64 v: ztypes.vid)
    # variable ids the body MUTATES. Recorded at the two ENFORCEMENT points --
    # `lockCallArg` whenever it takes a non-shared lock, and `checkWriteLock` --
    # so it answers the same question the lock rules do rather than guessing at
    # it a second time. `atomVariableId` cannot serve: it stamps an assignment
    # TARGET like any other use, so a read and a write look identical there.
    variableMutated: (IdSet ztypes.vid)
    # vid -> the binding's value was MOVED out (ownership transfer recorded at
    # the symtab's invalidate choke point); a moved local is not viewable
    variableMoved: (IdSet ztypes.vid)
    # dotted-path nodeid -> the internal member name a public alias resolved to
    aliasInternalName: (IdMapR u64 V: String)
    implicitCreate: (IdMapV u64 v: u64)
    funcReturnNode: (IdMapV u64 v: u64)
    defVariableId: (IdMapV u64 v: ztypes.vid)

    # --- compile-time constant values ---
    # The value domain, keyed two ways. nodeConst answers "what does this
    # node evaluate to" for a use site; memberConst answers it for a named
    # definition, keyed exactly as setMemberType keys the TYPE channel so the
    # two cannot disagree about what a constant is. Both are sparse -- a few
    # dozen nodes out of a couple hundred thousand -- so a map, not the dense
    # ListVal nodeType uses.
    nodeConst: (IdMapV u64 v: ztypes.cval)
    memberConst: (MapVV constslot v: ztypes.cval)
    # evaluation state per memberConst key: 0 unvisited, 1 evaluating, 2 done.
    # Constants are not written in dependency order, so the evaluator pulls
    # rather than pushes and this is its cycle guard.
    constEvalState: (MapVV constslot v: u8)
    # the svalKind payload pool; cval.strId indexes it 1-based (0 = none)
    constStrings: (List String)
    # ifexpr nodeid -> the clause the fold selected
    foldedBranch: (IdMapV u64 v: foldedbranch)
    # the pending evaluation failure, recorded by the evaluator and rendered by
    # whichever caller REQUIRED a value. One slot, not a table: evaluation is a
    # synchronous recursive pull, so at most one is live, and the caller either
    # drains it or clears it before the next pull.
    constFail: ztypes.constfail

    # aggregate typecheck state
    conformance: (List ztypes.ZConformance)
    # resolve every top-level definition of every unit, not only the ones a
    # use site demands: the tooling mode, so an error inside a definition
    # nothing references is still reported.
    eagerAll: bool
    # keep the per-frame dump rows (locals and overlay rows in the order they
    # were laid) as each frame closes: the model dump reads them; nothing
    # else does, so a plain build or check does not build them
    dumpRows: bool

    # the target unit must declare a `main` (E0039). A BUILD needs an entry
    # point; `zc dump` INTROSPECTS a unit and does not, for the same reason
    # `--eager` does not -- neither is asking what a root reaches.
    requireMain: bool

    # what the build is FOR, threaded in from the driver so the `platform`
    # unit's constants describe this invocation rather than the file on disk.
    # ccPath is the RESOLVED compiler path (--cc > <target>-gcc > $CC > cc),
    # targetTriple the --target as given ("" for a native build).
    ccPath: String
    ccMode: String
    targetTriple: String
    # the qualified paths natives.tbl marks `fold` -- the compile-time values
    # this compiler answers itself. Read by the driver and handed in for the
    # same reason ccPath is: the checker resolves nothing on its own, and a
    # front end that answered a different set than the build would decide a
    # `require:` guard differently in the editor than on the command line.
    foldPaths: (List String)
    # a generic parameter's BOUND, as (atom node -> the name it spells) and the
    # frame to resolve it in. Recorded where the parameter is registered -- the
    # bound is read as TEXT there and mapped to a constraint kind, never as a
    # type-ref -- and resolved once at the end, for TOOLING only: an unresolved
    # one is silent, and nothing here reaches the emitter.
    genericBoundName: (IdMapV u64 v: zast.nameid)
    genericBoundFrame: (IdMapV u64 v: ztypes.declid)
    # what a reference resolved to, recorded for TOOLING and read by nothing
    # else. refDecl is the emitter's -- it reads it in five places and adding an
    # entry there for an editor's benefit moved the emitted C -- so a stamp that
    # exists to answer go-to-definition goes here instead.
    toolRefDecl: (IdMapV u64 v: ztypes.declid)
    # a generic parameter, as (node -> the name it spells) and the frame to
    # resolve it in. Recorded at the parameter's declaration and at every type
    # position that resolves to one: a generic parameter lives outside the
    # name-resolution table, so nothing else records what its atom means, and
    # `newType ... genericParam` leaves ZType.def zero -- the tid cannot answer
    # for its declaration either. Resolved once at the end, for TOOLING only.
    genericParamName: (IdMapV u64 v: zast.nameid)
    genericParamFrame: (IdMapV u64 v: ztypes.declid)
    # what the end pass made of those: the parameter's own Decl, and the node of
    # the bound it was declared with. The Decl entry is also the MARKER -- a
    # generic parameter and an ordinary field are both fieldDecl, so a Decl
    # alone cannot say which of the two a node is.
    genericParamDecl: (IdMapV u64 v: ztypes.declid)
    genericParamBound: (IdMapV u64 v: u64)
    # the node id of the expression that IS the statement being checked, or 0.
    # `.drop` ends a lifetime and produces nothing, so it is legal only there --
    # this is what tells `y: x.drop` from `x.drop`. Node ids are unique, so a
    # stale value can never wrongly permit one.
    stmtExprNid: u64
    # true once indexUnitDefs has populated the node finder; descent is gated
    # off before then (generator lowering runs pre-index).
    defNodeIndexBuilt: bool
    # Type ids whose `as {}` block strikes the compiler-provided `.copy` off
    # with `copy: null`. A valtype's default copy is its byte copy, so the
    # opt-out has no member to suppress -- it is a fact about the type.
    copyOptOut: (IdSet u64)
    # ordinalVariant -- a variant whose arms ALL carry no payload, mapped to its
    # arm count. Such a variant is an ORDINAL: nothing distinguishes one value
    # from another except which arm it is, so there is nothing for a tagged
    # struct to carry. The front end records the SHAPE, from the arms the author
    # wrote; what a backend does with it -- an integer, a C `bool` -- is the
    # backend's call.
    #
    # The tag STORAGE a variant declares (`tag: u8.tag`) is deliberately not
    # recorded here: no backend honours it for any variant today, so a rule that
    # consulted it would be the only one, and would read as settled policy when
    # it is not. It belongs here once the declared width decides the emitted one.
    ordinalVariant: (IdMapV u64 v: u64)
    # sumPairFirstArm / sumPairSecondArm -- the two arm names of a 2-arm sum
    # type, as pool ids, in the order the author wrote them. Every 2-arm
    # `variant` and `union` is recorded, generic templates included, whatever
    # the arms carry -- so presence IS the question "is this tid a 2-arm sum".
    # The record states the ORDER; the falsy-first convention is what gives
    # arm 0 its meaning, and that meaning belongs to the reader.
    #
    # Recorded here rather than walked at use: the arm list is a member walk,
    # and forcing one at emission time demands members the program never asked
    # for -- which segfaults a demand-driven compile.
    sumPairFirstArm: (IdMapV u64 v: u64)
    sumPairSecondArm: (IdMapV u64 v: u64)
    # truthyCondArm -- for a condition node whose type is a 2-arm sum rather
    # than a bool, the name id of the arm the condition HOLDS: the second one,
    # since the first is falsy by the convention. `if x` is `if x.<that arm>`
    # with the arm left implicit, and every reader treats it as exactly that --
    # the lowering, the narrowing fact, and the branch aliases alike.
    #
    # Stamped by the checker rather than derived, because finding the arm
    # follows a generic MONO back to the template it was minted from, and that
    # needs the registry the emitter only ever holds read-only.
    truthyCondArm: (IdMapV u64 v: u64)
    # variantTagBase -- the NUMERIC type a tagged type's discriminator is stored
    # in, from its declaration (`tag: u8.tag`) or the spec's u8 default. Absent
    # for a data-sourced tag, whose constants set their own width.
    variantTagBase: (IdMapV u64 v: u64)
    # the system unit's root DeclId, resolved once: the member probe below it
    # runs per reference, so it must not re-resolve the unit name each time
    systemUnitRoot: ztypes.declid
    # mainUnitRoot / collectionsUnitRoot -- the same id-valued anchors for the
    # two other units the checker names outright. An identity gate compares
    # these, never a spelling: two units may share a name.
    mainUnitRoot: ztypes.declid
    collectionsUnitRoot: ztypes.declid
    # the prelude's root DeclId (`core`), the outermost frame of every bare
    # definition lookup, resolved once the def index exists
    coreUnitRoot: ztypes.declid
    # the program root DeclId, minted beside the sentinel: every file unit
    # carries it as its parent, so the declaration tree has one top
    programRoot: ztypes.declid
    # the canonical `null` tid, seeded with the other system types: an
    # out-less method's auto-call resolves to null, and every reader of
    # that stamp already treats it as the no-value type
    nullTypeId: u64
    # one-shot guard: the native link-target descend runs once per program
    # type-ref node id -> base type name; resolved to its real type post-demand
    pendingTyperef: (IdMapV u64 v: zast.nameid)
    # the environment frame the type-ref was written in (curFrame at record
    # time), so the post-demand stamp resolves it where it was written
    pendingTyperefFrame: (IdMapV u64 v: ztypes.declid)
    unitTypesById: (IdMapV u64 v: ztypes.tid)
    # --- declaration tree ---
    # every Decl row, indexed by its DeclId: row 0 is the sentinel and ids are
    # minted dense in mint order and never removed, so the id IS the index
    decls: (List Decl)
    # type id -> the declaration that minted it (first mint wins), so a member
    # setter reaches the owner's declaration without the type registry. A
    # monomorphisation is absent: it links to its template through the
    # registry, never through declSetType.
    declByTypeId: (IdMapV u64 v: ztypes.declid)
    # the `public:` block Decl of each unit or type Decl that has one, by
    # the owner's declid: a unit's surface is asked for per qualified lookup
    publicNsByOwner: (IdMapV u64 v: ztypes.declid)
    # reference nodeid -> resolved DeclId (stamped by resolution)
    refDecl: (IdMapV u64 v: ztypes.declid)
    # declarations a reference found and demanded, in discovery order,
    # awaiting resolution (resolveDemandedDefs drains it)
    pendingDefs: (ListVal ztypes.declid)
    # dependency units in which a demanded definition has resolved (by unit
    # name id): each runs its conformance pass once, on first entry
    enteredUnits: (IdSet u64)
    # units whose `require:` block has been demanded (by unit-root declid), and
    # the blocks themselves in demand order. A unit's toolchain requirement is
    # a precondition on using it, so the first declaration demanded from a unit
    # resolves its `require:` first; membership here is therefore also the
    # answer to "did the program reach this unit".
    requireSeen: (IdSet u64)
    requireDemanded: (ListVal ztypes.declid)
    # the platform facts a `require:` block guards on are seeded before the
    # first block folds, which is earlier than the main pass would
    platformSeeded: bool
    # a drain of pendingDefs is running (a nested request returns to it)
    drainingDefs: bool
    # how many pendingTyperef entries stampPendingTyperefs has processed (its
    # cursor), and whether the post-demand pass has run at all
    typerefsStamped: u64
    typerefPassRan: bool
    # type-ref nodes a stamp pass could not stamp because their declaration
    # had not resolved yet; the next pass takes them first
    typerefRetry: (ListVal u64)
    # Member-type writes that found no declaration to land on. Generator
    # lowering pre-resolves system.optionval and system.Iterator, and the
    # never/null canonical pair is minted, before indexUnitDefs builds the
    # unit-root Decls, so those types' members are typed before anything
    # declares them. The write is held here and answers member-type reads for
    # the rest of the run. Keyed by (parent, name), last write wins, a handful
    # of entries.
    pendWrites: (ListVal pendwrite)
    isError: bool
    errors: (List zast.ErrorData)
    currentReturnTypeId: ztypes.tid
} as {
    # --- declaration tree ---

    # declNew -- append one declaration row (its DeclId is the index it lands
    # at) and link it into the parent's namespace; parent 0 adds no edge --
    # the program root, and any row that takes its parent from declSetParent.
    declNew: function {:this name: u32 parent: ztypes.declid kind: declkind node: u32} out ztypes.declid is {
        id: ztypes.declid.create from: this.decls.length
        this.decls.append (Decl
            :name
            :parent
            :kind
            :node
            typeId: ztypes.tid
            ownership: ztypes.zparamownership.noneMode
            defaultVal: defaultval.none
            resolving: false
            defined: false
            pending: false
            walked: false
            grantsPrivate: false
            unitFrame: false
            fnptrField: false
            lockFieldDecl: 0
            conformerName: 0
            varId: ztypes.vid
            rows: 0
            children: (IdMapV zast.nameid v: ztypes.declid)
        )
        if (parent.isZero) == false then (this.declAddChildEdge
            parentDeclId: parent
            nameId: (zast.nameid.create from: name.u32)
            childDeclId: id
        )
        if kind.publicNs then this.publicNsByOwner.set key: parent.u64 value: id
        return id
    }

    # declPublicNsOf -- the `public:` block Decl under `owner`, or 0.
    declPublicNsOf: function {t: this.view owner: ztypes.declid} out ztypes.declid is {
        po: t.publicNsByOwner.get key: owner.u64
        match (
            po
        ) case some then {
            return po
        } case none then null
        return (ztypes.declid.create from: 0)
    }

    # declSetUnitFrame -- mark a unit-kind row as a lookup frame.
    declSetUnitFrame: function {:this declId: ztypes.declid} is {
        fo: this.decls.getMut i: declId.u64
        fo.unitFrame = true
    }

    # declSetParent -- link a declaration to its enclosing one after the mint.
    # declNew edges a child into its parent's namespace, so a declaration that
    # is parented but NOT looked up by name there takes the link directly
    # (declNewFrame and declCloneType do the same).
    declSetParent: function {:this declId: ztypes.declid parent: ztypes.declid} is {
        po: this.decls.getMut i: declId.u64
        po.parent = parent
    }

    # declIsUnitFrame -- the frame bit (a `public:` block is one too).
    declIsUnitFrame: function {t: this.view declId: ztypes.declid} out bool is {
        decl: t.decls.get i: declId.u64
        if decl.kind.publicNs then return true
        return decl.unitFrame
    }

    # declNewFrame -- a body frame under `parent` (a function declaration, or
    # the enclosing frame). Unnamed: a frame is entered, never referred to.
    declNewFrame: function {:this parent: ztypes.declid node: u32} out ztypes.declid is {
        # parent-linked, but not edged into the parent's namespace: a frame is
        # climbed out of, never looked up, and a function's children stay its
        # parameters
        id: this.declNew name: 0 parent: ztypes.declid kind: declkind.blockDecl :node
        fo: this.decls.getMut i: id.u64
        fo.parent = parent
        return id
    }

    # declNewLocal -- a local written in frame `parent`: its name, type and
    # (for a runtime binding) variable id. A frame binds each name once, so
    # rebinding it in the same frame is a duplicate definition; a NESTED frame
    # is what shadows an outer local.
    declNewLocal: function {:this name: u32 parent: ztypes.declid node: u32 typeId: ztypes.tid varId: ztypes.vid} out ztypes.declid is {
        id: this.declNew :name :parent kind: declkind.localDecl :node
        lo: this.decls.getMut i: id.u64
        lo.typeId = typeId
        lo.varId = varId
        return id
    }

    # declParentOf -- the enclosing declaration, 0 for the program root or an
    # invalid id.
    declParentOf: function {t: this.view declId: ztypes.declid} out ztypes.declid is {
        r: ztypes.declid
        decl: t.decls.get i: declId.u64
        r = decl.parent
        return r
    }

    # declIsFrame -- is `declId` a body frame?
    declIsFrame: function {t: this.view declId: ztypes.declid} out bool is {
        r: false
        decl: t.decls.get i: declId.u64
        if decl.kind.blockDecl then r = true
        return r
    }

    # declLocalTypeOf / declLocalVarOf -- a local's type and variable id.
    declLocalTypeOf: function {t: this.view declId: ztypes.declid} out ztypes.tid is {
        r: ztypes.tid
        decl: t.decls.get i: declId.u64
        r = decl.typeId
        return r
    }

    # declRowsOf / declRowsAdd -- the live overlay-row count of a local.
    declRowsOf: function {t: this.view declId: ztypes.declid} out u64 is {
        r: u64
        decl: t.decls.get i: declId.u64
        r = decl.rows
        return r
    }

    declRowsAdd: function {:this declId: ztypes.declid delta: i64} is {
        decl: this.decls.getMut i: declId.u64
        if delta > 0 then {
            decl.rows = decl.rows + 1
        } else {
            if decl.rows > 0 then decl.rows = decl.rows - 1
        }
    }

    declLocalVarOf: function {t: this.view declId: ztypes.declid} out ztypes.vid is {
        r: ztypes.vid
        decl: t.decls.get i: declId.u64
        r = decl.varId
        return r
    }

    # declFindLocal -- the local `nameId` resolves to from frame `frame`
    # outward: each frame's own locals (a frame binds each name at most once),
    # then the frame enclosing it, until the chain leaves the frames -- a
    # frame's parent that is not a frame is the declaration whose body it is,
    # and ends the walk. One row read and one probe per frame; a nested frame
    # is what shadows an outer local.
    declFindLocal: function {
        t: this.view
        frame: ztypes.declid
        nameId: zast.nameid
    } out ztypes.declid is {
        if nameId.isZero then return (ztypes.declid.create from: 0)
        cur: frame
        for cur > 0 loop {
            found: ztypes.declid
            next: ztypes.declid
            {
                fo: t.decls.get i: cur.u64
                if (fo.kind.blockDecl) == false then return (ztypes.declid.create from: 0)
                lo: fo.children.get key: nameId
                match (
                    lo
                ) case some then {
                    found = lo
                } case none then null
                next = fo.parent
            }
            if (found.isZero) == false then return found
            cur = next
        }
        return (ztypes.declid.create from: 0)
    }

    # declChildAt -- the child declaration in slot `index` of `declId`'s
    # namespace (0 past the end); declNameOf -- a declaration's name id.
    declChildAt: function {t: this.view declId: ztypes.declid index: u64} out ztypes.declid is {
        r: ztypes.declid
        decl: t.decls.get i: declId.u64
        co: decl.children.valueAt i: index
        match (
            co
        ) case some then {
            r = co
        } case none then null
        return r
    }

    declNameOf: function {t: this.view declId: ztypes.declid} out u32 is {
        r: u32
        decl: t.decls.get i: declId.u64
        r = decl.name
        return r
    }

    # declAddChildEdge -- add a name -> declaration edge to a parent's
    # namespace (also used for public-interface entries, whose targets are
    # sibling declarations rather than fresh rows). A namespace binds each
    # name once, so the edge is a keyed write and the order it lands in is
    # the declaration order every walk reads back.
    declAddChildEdge: function {:this parentDeclId: ztypes.declid nameId: zast.nameid childDeclId: ztypes.declid} is {
        po: this.decls.getMut i: parentDeclId.u64
        po.children.set key: nameId value: childDeclId
    }

    # declSetPending / declIsPending -- the demand mark: a reference found
    # the definition and queued it (ZTyping.pendingDefs) for resolution.
    declSetPending: function {:this declId: ztypes.declid mark: bool} is {
        decl: this.decls.getMut i: declId.u64
        decl.pending = mark
    }

    declIsPending: function {this: this.view declId: ztypes.declid} out bool is {
        decl: this.decls.get i: declId.u64
        return decl.pending
    }

    # declSetWalked / declIsWalked -- the body-walk mark.
    declSetWalked: function {:this declId: ztypes.declid} is {
        decl: this.decls.getMut i: declId.u64
        decl.walked = true
    }

    declIsWalked: function {t: this.view declId: ztypes.declid} out bool is {
        decl: t.decls.get i: declId.u64
        return decl.walked
    }

    # declSetType -- record the canonical type a declaration minted, and the
    # reverse edge. The first mint wins, so a later alias declaration sharing
    # the type does not displace the defining one.
    # declSetResolving / declIsResolving -- the DFS grey mark.
    declSetResolving: function {:this declId: ztypes.declid mark: bool} is {
        decl: this.decls.getMut i: declId.u64
        decl.resolving = mark
    }

    declIsResolving: function {this: this.view declId: ztypes.declid} out bool is {
        decl: this.decls.get i: declId.u64
        return decl.resolving
    }

    # declSetDefined / declIsDefined -- the demand "done" mark.
    declSetDefined: function {:this declId: ztypes.declid} is {
        decl: this.decls.getMut i: declId.u64
        decl.defined = true
    }

    declIsDefined: function {this: this.view declId: ztypes.declid} out bool is {
        decl: this.decls.get i: declId.u64
        return decl.defined
    }

    # First conformer wins, in body order: a later as-block naming the same
    # marker does not displace the spec receiver already bound.
    declSetConformer: function {:this declId: ztypes.declid nameId: u32} is {
        decl: this.decls.getMut i: declId.u64
        if decl.conformerName == 0 then decl.conformerName = nameId
    }

    declConformerOf: function {this: this.view declId: ztypes.declid} out u32 is {
        decl: this.decls.get i: declId.u64
        return decl.conformerName
    }

    declSetType: function {:this declId: ztypes.declid typeId: ztypes.tid} is {
        {
            decl: this.decls.getMut i: declId.u64
            decl.typeId = typeId
        }
        if typeId > 0 then {
            seen: false
            {
                ex: this.declByTypeId.get key: typeId
                match (
                    ex
                ) case some then {
                    seen = true
                } case none then null
            }
            if seen == false then this.declByTypeId.set key: typeId value: declId
        }
    }

    # declPendWrite -- hold a member-type write whose owner has no declaration
    # yet. In place on a repeat, so the buffer carries one entry per
    # (parent, name).
    declPendWrite: function {:this parentTypeId: ztypes.tid nameId: zast.nameid typeId: ztypes.tid} is {
        i: u64
        n: this.pendWrites.length
        for i < n loop {
            w: this.pendWrites.get :i
            if w.parent == parentTypeId when w.name == nameId then {
                nw: pendwrite parent: parentTypeId name: nameId type: typeId
                this.pendWrites.set :i val: nw
                return
            }
            i = i + 1
        }
        pw: pendwrite parent: parentTypeId name: nameId type: typeId
        this.pendWrites.append pw
    }

    # declPendMemberType -- the type a pended write recorded for
    # (parent, name); 0 when there is none.
    declPendMemberType: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out u64 is {
        i: u64
        n: t.pendWrites.length
        for i < n loop {
            w: t.pendWrites.get :i
            # declPendWrite keeps one entry per (parent, name), so the first
            # match is the only one
            if w.parent == parentTypeId when w.name == nameId then return w.type.u64
            i = i + 1
        }
        return 0
    }

    # declPendCount -- how many pended pre-index writes `parentTypeId` holds.
    declPendCount: function {this: this.view parentTypeId: ztypes.tid} out u64 is {
        c: u64
        i: u64
        n: this.pendWrites.length
        for i < n loop {
            w: this.pendWrites.get :i
            if w.parent == parentTypeId then c = c + 1
            i = i + 1
        }
        return c
    }

    # declFindChild -- the child declaration named nameId under parentDeclId
    # (0 when absent). A namespace binds each name once -- the parser rejects
    # a repeated definition in any one body, registerUnitRoots a repeated unit
    # name, and the binding site a rebound local -- which is what lets the
    # namespace be keyed by the name at all.
    declFindChild: function {
        t: this.view
        parentDeclId: ztypes.declid
        nameId: zast.nameid
    } out ztypes.declid is {
        found: ztypes.declid
        po: t.decls.get i: parentDeclId.u64
        co: po.children.get key: nameId
        match (
            co
        ) case some then {
            found = co
        } case none then null
        return found
    }

    # declIdOfType -- the declaration that minted `typeId`; 0 for a type with
    # none of its own. A monomorphisation HAS one -- declMonoType clones the
    # template's -- so this returns the mono's own declaration, whose members
    # carry instantiated types. (declOfTypeId, in ztypecheck, hops
    # genericOrigin to the TEMPLATE's instead; the two differ on monos.)
    declIdOfType: function {t: this.view typeId: ztypes.tid} out ztypes.declid is {
        od: ztypes.declid
        {
            go: t.declByTypeId.get key: typeId
            match (
                go
            ) case some then {
                od = go
            } case none then null
        }
        return od
    }

    # declSetMemberType -- record a member declaration's type. Deliberately
    # not declSetType: the member did not mint the type, so it must not claim
    # the reverse declByTypeId edge.
    declSetMemberType: function {:this parentTypeId: ztypes.tid nameId: zast.nameid typeId: ztypes.tid} is {
        md8: this.declMemberIdOf :parentTypeId :nameId
        if md8.isZero then {
            # a function type's members are its parameters, and a synthesized
            # constructor gains them after its own declaration exists
            od8: this.declIdOfType typeId: parentTypeId
            if od8.isZero then {
                this.declPendWrite :parentTypeId :nameId :typeId
                return
            }
            isFn8: false
            node8: u32
            {
                oo8: this.decls.get i: od8.u64
                if oo8.kind.methodDecl then isFn8 = true
                if oo8.kind.funcDecl then isFn8 = true
                node8 = oo8.node
            }
            if isFn8 == false then {
                this.declPendWrite :parentTypeId :nameId :typeId
                return
            }
            md8 = (this.declNew
                name: nameId
                parent: od8
                kind: declkind.paramDecl
                node: node8
            )
        }
        {
            do8: this.decls.getMut i: md8.u64
            do8.typeId = typeId
        }
        # every member type names the declaration that minted it, whatever the
        # member's kind: a method's type IS the function it declares (its
        # parameters attach to that namespace), and a synthesized field's type
        # still has exactly one declaration behind it.
        if typeId > 0 then {
            exd8: this.declIdOfType :typeId
            if exd8.isZero then this.declByTypeId.set key: typeId value: md8
        }
    }

    # declChildOf / declChildOfId -- the type of member `name` on parentTypeId.
    # The member's DECLARATION is the source of truth: undeclared, or declared
    # carrying no type, both read as absent. A member with no declaration at
    # all falls back to the pended pre-index writes, which is the only record
    # of a type whose owner never acquires a declaration.
    declChildOf: function {
        this: this.view
        pool: zast.StringPool.view
        parentTypeId: ztypes.tid
        name: StringView
    } out optionval u64 is {
        nid: pool.find s: name
        if nid.isZero then return (optionval.none u64)
        return (this.declChildOfId :parentTypeId nameId: nid)
    }

    declChildOfId: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out optionval u64 is {
        if nameId.isZero then return (optionval.none u64)
        md: t.declMemberIdOf :parentTypeId :nameId
        if (md.isZero) == false then {
            childTid: u64
            {
                mo: t.decls.get i: md.u64
                childTid = mo.typeId
            }
            if childTid == 0 then return (optionval.none u64)
            return (optionval.some childTid)
        }
        pv: t.declPendMemberType :parentTypeId :nameId
        if pv == 0 then return (optionval.none u64)
        return (optionval.some pv)
    }

    # declIsLockField / declIsLockFieldId -- is `name` the lock field of the
    # type that minted parentTypeId? The owning declaration names one member as
    # its lock, so this is a round trip through that pointer.
    declIsLockField: function {
        this: this.view
        pool: zast.StringPool.view
        parentTypeId: ztypes.tid
        name: StringView
    } out bool is {
        nid: pool.find s: name
        if nid.isZero then return false
        return (this.declIsLockFieldId :parentTypeId nameId: nid)
    }

    declIsLockFieldId: function {
        this: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out bool is {
        od: this.declIdOfType typeId: parentTypeId
        if od.isZero then return false
        lf: u64
        {
            oo: this.decls.get i: od.u64
            lf = oo.lockFieldDecl
        }
        if lf == 0 then return false
        return lf == (this.declFindChild parentDeclId: od :nameId)
    }

    # declDefaultOfId -- member `nameId`'s recorded default value; none when
    # the member is undeclared or carries none.
    declDefaultOfId: function {
        this: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out defaultval is {
        md: this.declMemberIdOf :parentTypeId :nameId
        if md.isZero then return defaultval.none
        r: defaultval.none
        {
            mo: this.decls.get i: md.u64
            dv: mo.defaultVal
            r = dv
        }
        return r
    }

    # declHasDefaultId -- does member `nameId` of parentTypeId carry a default?
    declHasDefaultId: function {
        this: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out bool is {
        md: this.declMemberIdOf :parentTypeId :nameId
        if md.isZero then return false
        r: false
        {
            mo: this.decls.get i: md.u64
            if mo.defaultVal.none then r = false else r = true
        }
        return r
    }

    # declOwnershipIs -- the parameter binding mode recorded on member `name`
    # of parentTypeId equals `own`; false when the member is undeclared or
    # carries no mode. A zero-inited declaration reads noneMode, so an unset
    # mode never matches take, borrow or lock.
    # declOwnershipOfId -- a member's recorded parameter ownership, or none
    # when it has none: an unset declaration reads noneMode.
    declOwnershipOfId: function {
        this: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out optionval ztypes.zparamownership is {
        md: this.declMemberIdOf :parentTypeId :nameId
        if md.isZero then return (optionval.none ztypes.zparamownership)
        r: ztypes.zparamownership.noneMode
        {
            mo: this.decls.get i: md.u64
            r = mo.ownership
        }
        if r.noneMode then return (optionval.none ztypes.zparamownership)
        return (optionval.some r)
    }

    # declGrantsPrivate -- was member `name` declared with a `.private` handle
    # type, so reads through it stay private-capable?
    declGrantsPrivate: function {
        this: this.view
        pool: zast.StringPool.view
        parentTypeId: ztypes.tid
        name: StringView
    } out bool is {
        nid: pool.find s: name
        if nid.isZero then return false
        md: this.declMemberIdOf :parentTypeId nameId: nid
        if md.isZero then return false
        r: false
        {
            mo: this.decls.get i: md.u64
            r = mo.grantsPrivate
        }
        return r
    }

    declOwnershipIs: function {
        this: this.view
        pool: zast.StringPool.view
        parentTypeId: ztypes.tid
        name: StringView
        own: ztypes.zparamownership
    } out bool is {
        nid: pool.find s: name
        if nid.isZero then return false
        md: this.declMemberIdOf :parentTypeId nameId: nid
        if md.isZero then return false
        r: false
        {
            mo: this.decls.get i: md.u64
            oc: own
            r = (ztypes.zparamownershipInt mo.ownership) == (ztypes.zparamownershipInt oc)
        }
        return r
    }

    # declIsFnptrField / declIsFnptrFieldId -- does member `name` occupy a
    # struct function-pointer slot? Where it was declared decides this, so the
    # member declaration carries it as a bit.
    declIsFnptrField: function {
        this: this.view
        pool: zast.StringPool.view
        parentTypeId: ztypes.tid
        name: StringView
    } out bool is {
        nid: pool.find s: name
        if nid.isZero then return false
        return (this.declIsFnptrFieldId :parentTypeId nameId: nid)
    }

    declIsFnptrFieldId: function {
        this: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out bool is {
        md: this.declMemberIdOf :parentTypeId :nameId
        if md.isZero then return false
        r: false
        {
            mo: this.decls.get i: md.u64
            r = mo.fnptrField
        }
        return r
    }

    # declIsMethodId -- was member `name` DECLARED as a function? The type a
    # member resolves to cannot answer this: a collection materialises
    # `length`/`capacity` as plain scalars, because they emit as a struct field
    # read rather than a call, so the member's type is its RETURN type and it is
    # indistinguishable from a field by type alone. The declaration still knows.
    # declMemberIsSynth -- the member was SYNTHESISED by the checker (create,
    # borrow, ==, !=, tag) rather than written by the author. `declSynthMember`
    # gives a synthesised member the OWNER's node, having none of its own; a
    # declared member carries its own namedoperation. That difference is the
    # only record of which is which, and the emitter needs it: its byte-compare
    # and byte-copy defaults must yield to a method the author wrote.
    declMemberIsSynth: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out bool is {
        md: t.declMemberIdOf :parentTypeId :nameId
        if md.isZero then return false
        od: t.declIdOfType typeId: parentTypeId
        if od.isZero then return false
        r: false
        {
            mo: t.decls.get i: md.u64
            oo: t.decls.get i: od.u64
            if mo.node == oo.node then r = true
        }
        return r
    }

    declIsMethodId: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out bool is {
        md: t.declMemberIdOf :parentTypeId :nameId
        if md.isZero then return false
        r: false
        {
            mo: t.decls.get i: md.u64
            k: mo.kind
            if k.methodDecl then r = true
            if k.funcDecl then r = true
        }
        return r
    }

    # declCloneType -- a monomorphisation's own type declaration: the
    # template's name and node, with the template's members cloned in order.
    # It hangs UNDER the template -- the specialisation edge of the tree is
    # this parent link -- but is edged into no namespace: a specialisation is
    # reached through the trie under its template, never by name, so
    # resolving the template's name still finds the template, and a walk from
    # a specialisation's member climbs into the template's frame first.
    declCloneType: function {:this templateDeclId: ztypes.declid} out ztypes.declid is {
        tname: u32
        tnode: u32
        tkind: declkind.typeDecl
        tframe: false
        kids: (ListVal ztypes.declid)
        {
            to: this.decls.get i: templateDeclId.u64
            tname = to.name
            tnode = to.node
            tkind = to.kind
            tframe = to.unitFrame
            with cit: to.children.iterateItems do for c: cit loop kids.append c.value
        }
        if tname == 0 then return (ztypes.declid.create from: 0)
        # the clone keeps the template's kind: a monomorphisation of a generic
        # FUNCTION is a function, and only a function declaration may own its
        # parameter declarations.
        id: this.declNew name: tname parent: ztypes.declid kind: tkind node: tnode
        if tframe then this.declSetUnitFrame declId: id
        {
            no: this.decls.getMut i: id.u64
            no.parent = templateDeclId
        }
        ki: u64
        kn: kids.length
        for ki < kn loop {
            kd: kids.get i: ki
            ki = ki + 1
            cn: u32
            cnode: u32
            ck: declkind.fieldDecl
            isM: false
            {
                ko: this.decls.get i: kd.u64
                cn = ko.name
                cnode = ko.node
                ck = ko.kind
                if ko.kind.fieldDecl then isM = true
                if ko.kind.methodDecl then isM = true
                if ko.kind.armDecl then isM = true
            }
            if isM then this.declNew name: cn parent: id kind: ck node: cnode
        }
        return id
    }

    # declSynthMember -- mint the declaration of a member the checker
    # synthesises (create, borrow, ==, !=, tag) under the type that minted
    # `parentTypeId`, appended in member order. A no-op
    # when that type has no declaration of its own, or when the member is
    # already declared (a type writing its own `create` in an is-block).
    declSynthMember: function {:this parentTypeId: ztypes.tid nameId: zast.nameid kind: declkind} is {
        od: this.declIdOfType typeId: parentTypeId
        if od.isZero then return
        if (this.declFindChild parentDeclId: od :nameId) > 0 then return
        node: u32
        {
            oo: this.decls.get i: od.u64
            node = oo.node
        }
        kk: kind
        this.declNew name: nameId parent: od kind: kk :node
    }

    # declChildSlots -- how many children a declaration's namespace holds.
    declChildSlots: function {t: this.view declId: ztypes.declid} out u64 is {
        po: t.decls.get i: declId.u64
        return po.children.length
    }

    # declPendRowAt -- the slot-th pended pre-index write for this parent. A
    # pended row carries no kind and no type filter: the window it covers is
    # before anything declared the owner, so there is no kind to filter on and
    # the write IS the type. Every such row therefore answers `keep`.
    declPendRowAt: function {this: this.view parentTypeId: ztypes.tid slot: u64} out declrow is {
        c: u64
        i: u64
        n: this.pendWrites.length
        for i < n loop {
            w: this.pendWrites.get :i
            if w.parent == parentTypeId then {
                if c == slot then return (declrow name: w.name.u64 tid: w.type.u64 keep: true)
                c = c + 1
            }
            i = i + 1
        }
        return (declrow name: 0 tid: 0 keep: false)
    }

    # declRowSlots -- how many slots a declChildWalk over `ownerTid` reads.
    # NOT how many rows it yields: a slot whose row answers `keep` false is
    # still a slot. When the type has no declaration of its own the pended
    # pre-index writes answer, exactly as the walk does.
    declRowSlots: function {this: this.view ownerTid: ztypes.tid} out u64 is {
        od: this.declIdOfType typeId: ownerTid
        if od.isZero then return (this.declPendCount parentTypeId: ownerTid)
        return (this.declChildSlots declId: od)
    }

    # declRowAt -- the slot-th row of a declChildWalk over `ownerTid`.
    # `membersOnly` narrows `keep` to the field / method / arm / param
    # children. The owner is re-read per slot rather than staged into a row
    # list: the per-child probe is a `:this` call, which cannot run under a
    # live children borrow, and a map probe is cheaper than a staged list.
    declRowAt: function {
        this: this.view
        ownerTid: ztypes.tid
        membersOnly: bool
        slot: u64
    } out declrow is {
        od: this.declIdOfType typeId: ownerTid
        if od.isZero then return (this.declPendRowAt parentTypeId: ownerTid :slot)
        nid: u64
        did: ztypes.declid
        {
            oo: this.decls.get i: od.u64
            nid = (oo.children.keyAt i: slot).u64
            vo: oo.children.valueAt i: slot
            match (
                vo
            ) case some then {
                did = vo
            } case none then null
        }
        keep: (membersOnly) == false
        mt: u64
        {
            ko: this.decls.get i: did.u64
            if membersOnly then {
                if ko.kind.fieldDecl then keep = true
                if ko.kind.methodDecl then keep = true
                if ko.kind.paramDecl then keep = true
                if ko.kind.armDecl then keep = true
            }
            mt = ko.typeId
        }
        if mt == 0 then keep = false
        return (declrow name: nid tid: mt :keep)
    }

    # declChildWalk -- the shared walk behind declMemberList and declChildRows:
    # every child of the type's own declaration that carries a type, in
    # declaration order, as (name pool id, type id). It is the row accessors
    # collected, so a caller that loops the slots instead of taking the list
    # cannot disagree with it about what a child is.
    declChildWalk: function {
        this: this.view
        ownerTid: ztypes.tid
        membersOnly: bool
        names: ListVal u64
        tids: ListVal u64
    } is {
        n: this.declRowSlots :ownerTid
        i: u64
        for i < n loop {
            r: this.declRowAt :ownerTid :membersOnly slot: i
            i = i + 1
            if r.keep then {
                names.append r.name
                tids.append r.tid
            }
        }
    }

    # declMemberList -- a type's members, in declaration order: the member
    # names (pool ids) and their types. Members are the field / method / arm /
    # param children carrying a type; a unit's definitions and a type's
    # `public:` block are not members and are skipped. Declaration order IS
    # member order because the index builds the member Decls in that order and
    # nothing reorders them -- member order does not depend on the order the
    # members are typed in.
    declMemberList: function {
        this: this.view
        ownerTid: ztypes.tid
        names: (ListVal u64)
        tids: (ListVal u64)
    } is {
        this.declChildWalk :ownerTid membersOnly: true :names :tids
    }

    # declChildRows -- as declMemberList but with no kind filter, so a unit's
    # definitions come out alongside a type's members: the SQL dumps want the
    # whole namespace a declaration describes. `typeId > 0` is the only filter
    # needed -- an untyped child (a re-exported generic param, a `public:`
    # block) is not a member of anything.
    declChildRows: function {
        this: this.view
        ownerTid: ztypes.tid
        names: (ListVal u64)
        tids: (ListVal u64)
    } is {
        this.declChildWalk :ownerTid membersOnly: false :names :tids
    }

    # declAllMemberRows -- every (owner type, child name, child type) triple the
    # declaration tree describes, owners in ascending tid order. The
    # whole-program form of declChildRows, for the callers that visit every
    # member in the program rather than one owner's. A tid with no declaration
    # of its own contributes nothing and is skipped without asking
    # declChildRows, so its edge fallback stays a signal about the pre-index
    # window rather than noise from this walk. lastTid is the registry's
    # nextTypeId, which ZTyping cannot reach on its own.
    declAllMemberRows: function {
        :this
        lastTid: u64
        owners: ListVal u64
        names: ListVal u64
        tids: ListVal u64
    } is {
        childTid: u64
        for childTid < lastTid loop {
            if (this.declIdOfType typeId: (ztypes.tid.create from: childTid.u64)) > 0 then {
                nms: (ListVal u64)
                tds: (ListVal u64)
                (this.declChildRows
                    ownerTid: (ztypes.tid.create from: childTid.u64)
                    names: nms
                    tids: tds
                )
                i: u64
                n: nms.length
                for i < n loop {
                    ov: childTid
                    owners.append ov
                    names.append (nms.get :i)
                    tids.append (tds.get :i)
                    i = i + 1
                }
            }
            childTid = childTid + 1
        }
    }

    # declMemberCount -- how many members the type's declaration carries: the
    # declaration-side form of childCount. Routed through declMemberList so the
    # two can never disagree about what counts as a member.
    declMemberCount: function {this: this.view ownerTid: ztypes.tid} out u64 is {
        od: this.declIdOfType typeId: ownerTid
        if od.isZero then return (this.declPendCount parentTypeId: ownerTid)
        c: u64
        n: this.declChildSlots declId: od
        i: u64
        for i < n loop {
            did: ztypes.declid
            {
                oo: this.decls.get i: od.u64
                vo: oo.children.valueAt :i
                match (
                    vo
                ) case some then {
                    did = vo
                } case none then null
            }
            i = i + 1
            {
                ko: this.decls.get i: did.u64
                isMem: false
                if ko.kind.fieldDecl then isMem = true
                if ko.kind.methodDecl then isMem = true
                if ko.kind.paramDecl then isMem = true
                if ko.kind.armDecl then isMem = true
                if isMem when ko.typeId > 0 then c = c + 1
            }
        }
        return c
    }

    # declLastChildNameId -- the name pool id of the LAST typed child of the
    # type's declaration, 0 when it has none. Last, because that is the row a
    # declChildRows walk leaves behind; paired with declMemberCount == 1 by the
    # single-parameter probes, which want the name without a row list.
    declLastChildNameId: function {this: this.view ownerTid: ztypes.tid} out u64 is {
        od: this.declIdOfType typeId: ownerTid
        if od.isZero then return 0
        r: u64
        n: this.declChildSlots declId: od
        i: u64
        for i < n loop {
            nid: u64
            did: ztypes.declid
            {
                oo: this.decls.get i: od.u64
                nid = (oo.children.keyAt :i).u64
                vo: oo.children.valueAt :i
                match (
                    vo
                ) case some then {
                    did = vo
                } case none then null
            }
            i = i + 1
            {
                ko: this.decls.get i: did.u64
                if ko.typeId > 0 then r = nid
            }
        }
        return r
    }

    # declHasMemberId -- does the type that minted `parentTypeId` declare a
    # typed member `nameId`? The declaration-side form of hasChildId.
    declHasMemberId: function {
        this: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out bool is {
        if nameId.isZero then return false
        return (this.declTypedMemberIdOf :parentTypeId :nameId) > 0
    }

    # declMemberIdOf -- the declaration of member `nameId` under the type
    # `parentTypeId` minted; 0 when that type has no declaration of its own or
    # the member is not declared.
    declMemberIdOf: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out ztypes.declid is {
        od: t.declIdOfType typeId: parentTypeId
        if od.u64 == 0 then return od
        return (t.declFindChild parentDeclId: od :nameId)
    }

    # declTypedMemberIdOf -- the declaration of member `nameId` under the type
    # `parentTypeId` minted, but only when that declaration carries a type; 0
    # otherwise. The narrowing is what lets a member DeclId serve as the
    # identity of a (parent, name) pair: a declaration carrying no type was
    # never a member anything could name.
    declTypedMemberIdOf: function {
        this: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out ztypes.declid is {
        md: this.declMemberIdOf :parentTypeId :nameId
        if md.u64 == 0 then return md
        childTid: u64
        {
            mo: this.decls.get i: md.u64
            childTid = mo.typeId
        }
        if childTid == 0 then return (ztypes.declid.create from: 0)
        return md
    }

    # --- member types ---

    # setMemberType -- record the type of member `nameId` on `parentTypeId`:
    # ensure the member's declaration, stamp the type onto it, and on first
    # sight position it in the owner's last member slot, so declaration order
    # is built as member order rather than corrected afterwards.
    setMemberType: function {:this parentTypeId: ztypes.tid nameId: zast.nameid childTypeId: u64} is {
        (this.declSetMemberType
            :parentTypeId
            :nameId
            typeId: (ztypes.tid.create from: childTypeId.u64)
        )
    }

    # --- member constant values ---

    # memberConstKey -- the (parent type, member name) pair memberConst and
    # constEvalState share, so the two tables cannot drift apart on what a key
    # means.
    memberConstKey: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out constslot is {
        return (constslot owner: parentTypeId.u64 name: nameId.u64)
    }

    # setMemberConst -- record the compile-time VALUE of member `nameId` on
    # `parentTypeId`, the channel parallel to setMemberType's type.
    setMemberConst: function {:this parentTypeId: ztypes.tid nameId: zast.nameid value: ztypes.cval} is {
        k: this.memberConstKey :parentTypeId :nameId
        this.memberConst.set key: k :value
    }

    # setNodeConst -- record the compile-time VALUE of a USE SITE, the other
    # half of the value domain. memberConst answers for a named definition;
    # this answers for the node that reads or computes one, which is what the
    # emitter asks before it emits an expression at all.
    setNodeConst: function {:this nid: zast.nodeid value: ztypes.cval} is {
        this.nodeConst.set key: nid.u64 :value
    }

    # memberConstOf -- that value, or `none` when the member has none.
    memberConstOf: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out ztypes.cval is {
        k: t.memberConstKey :parentTypeId :nameId
        g: t.memberConst.get key: k
        match (
            g
        ) case some then {
            return g
        } case none then {
            return ztypes.noConst
        }
    }

    # --- per-member flags ---

    # setAliasInternalName / aliasInternalNameOf -- per dotted-path-node record
    # of the internal member an external access resolved to through a public
    # alias; the emitter reads it to emit the internal C name.
    setAliasInternalName: function {:this nodeid: zast.nodeid internalName: StringView} is {
        v: internalName.string
        this.aliasInternalName.set key: nodeid.u64 value: v
    }

    aliasInternalNameOf: function {this: this.view nodeid: zast.nodeid} out String is {
        r: this.aliasInternalName.get key: nodeid.u64
        match (
            r
        ) case some then {
            return r.copy
        } case none then {
            return "".string
        }
    }

    # setChildGrantsPrivateId -- mark a field edge as one whose declared type
    # was a `.private` handle, so reads through it are private-capable.
    setChildGrantsPrivateId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid} is {
        md8: this.declMemberIdOf :parentTypeId :nameId
        if (md8.isZero) == false then {
            do8: this.decls.getMut i: md8.u64
            do8.grantsPrivate = true
        }
    }

    markAsConstClone: function {:this typeId: ztypes.tid} is {
        tk: typeId
        mv2: true
        this.asConstClone.set key: tk value: mv2
    }

    isAsConstClone: function {this: this.view typeId: ztypes.tid} out bool is {
        tk2: typeId
        r: this.asConstClone.get key: tk2
        match (
            r
        ) case some then {
            return r
        } case none then {
            return false
        }
    }

    setChildLockField: function {:this pool: zast.StringPool.view parentTypeId: ztypes.tid name: StringView} is {
        nid8: pool.find s: name
        if nid8 > 0 then {
            od8: this.declIdOfType typeId: parentTypeId
            if (od8.isZero) == false then {
                md8: this.declFindChild parentDeclId: od8 nameId: nid8
                if (md8.isZero) == false then {
                    do8: this.decls.getMut i: od8.u64
                    do8.lockFieldDecl = md8
                }
            }
        }
    }

    setChildFnptrField: function {:this pool: zast.StringPool.view parentTypeId: ztypes.tid name: StringView} is {
        nid8: pool.find s: name
        if nid8 > 0 then {
            md8: this.declMemberIdOf :parentTypeId nameId: nid8
            if (md8.isZero) == false then {
                do8: this.decls.getMut i: md8.u64
                do8.fnptrField = true
            }
        }
    }

    # --- member defaults ---

    # setDefaultLiteral -- a literal default. `node` is the default
    # expression's AST node, which the declaration carries the way a unit
    # constant does (its value is re-rendered from the node, never stored).
    setDefaultLiteral: function {:this pool: zast.StringPool.view parentTypeId: ztypes.tid name: StringView node: u32} is {
        this.declSetDefault :parentTypeId :pool :name value: (defaultval.literal node)
    }

    # declSetDefault -- record a member declaration's default value; a no-op
    # when the owner type has no declaration (a monomorphisation) or the
    # member is not a declared one.
    declSetDefault: function {:this parentTypeId: ztypes.tid pool: zast.StringPool.view name: StringView value: defaultval} is {
        nid8: pool.find s: name
        if nid8.isZero then return
        md8: this.declMemberIdOf :parentTypeId nameId: nid8
        if md8.isZero then return
        do8: this.decls.getMut i: md8.u64
        dv8: value
        do8.defaultVal = dv8
    }

    # setDefaultFunction -- a default naming a function; `targetDecl` is that
    # function's declaration (0 when it resolved to no declaration).
    setDefaultFunction: function {:this pool: zast.StringPool.view parentTypeId: ztypes.tid name: StringView targetDecl: ztypes.declid} is {
        this.declSetDefault :parentTypeId :pool :name value: (defaultval.func targetDecl)
    }

    # setDefaultVariantArm -- a default naming an arm of the member's own
    # type; `targetDecl` is that arm's declaration (0 when it resolved to no
    # declaration).
    setDefaultVariantArm: function {:this pool: zast.StringPool.view parentTypeId: ztypes.tid name: StringView targetDecl: ztypes.declid} is {
        this.declSetDefault :parentTypeId :pool :name value: (defaultval.arm targetDecl)
    }

    # declDefaultText -- a member's default as display text, "" when it has
    # none. A literal renders as its expression nodeid (the caller needs an Ast
    # to re-render it); a function or arm renders as its target's declared name.
    declDefaultText: function {
        this: this.view
        pool: zast.StringPool.view
        parentTypeId: ztypes.tid
        name: StringView
    } out String is {
        nid: pool.find s: name
        if nid.isZero then return "".string
        dv: this.declDefaultOfId :parentTypeId nameId: nid
        {
            dl: dv
            if dl.literal then return "literal node \{dl}"
        }
        tgt: ztypes.declid
        {
            df: dv
            if df.func then tgt = df
        }
        isArm: false
        {
            da: dv
            if da.arm then {
                tgt = da
                isArm = true
            }
        }
        if tgt.isZero then return "".string
        nm: u32
        {
            to: this.decls.get i: tgt.u64
            nm = to.name
        }
        tx: zast.poolTextAt :pool ref: (zast.nameid.create from: nm.u32)
        if isArm then return "arm \{tx}"
        return "func \{tx}"
    }

    # --- member ownership ---

    setChildOwnership: function {:this pool: zast.StringPool.view parentTypeId: ztypes.tid name: StringView ownership: ztypes.zparamownership} is {
        nid8: pool.find s: name
        if nid8 > 0 then {
            md8: this.declMemberIdOf :parentTypeId nameId: nid8
            if (md8.isZero) == false then {
                do8: this.decls.getMut i: md8.u64
                oc8: ownership
                do8.ownership = oc8
            }
        }
    }

    # setChildOwnershipId -- the id-keyed form of setChildOwnership.
    setChildOwnershipId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid ownership: ztypes.zparamownership} is {
        md8: this.declMemberIdOf :parentTypeId :nameId
        if (md8.isZero) == false then {
            do8: this.decls.getMut i: md8.u64
            oc8: ownership
            do8.ownership = oc8
        }
    }

    # declOwnershipText -- a member's ownership as display text, "none" when
    # it has none.
    declOwnershipText: function {
        this: this.view
        pool: zast.StringPool.view
        parentTypeId: ztypes.tid
        name: StringView
    } out String is {
        nid: pool.find s: name
        if nid.isZero then return "none".string
        r: this.declOwnershipOfId :parentTypeId nameId: nid
        match (
            r
        ) case some then {
            return (ztypes.zparamownershipName r)
        } case none then {
            return "none".string
        }
    }

}

# armside -- which side of a 2-arm sum a trailing predicate segment names.
# `x.a.false` negates the predicate `x.a`, `x.a.true` passes it through, and
# anything else is not that shape at all. Falsy arm first, as the convention
# the record states the order for asks.
armside: variant {
    none: null
    falsy: null
    truthy: null
}

# armSuffixSideOf -- which side of a 2-arm sum the trailing segment of a dotted
# ARM PREDICATE names, asked by arm IDENTITY rather than by spelling. `nid` is
# the outer dotted node: the dpArmPredicate stamp on it names the type the
# segment is an arm of, and that type's arm ORDER decides the side -- the arm
# written first negates the predicate, the one written second passes it
# through. `bool` is that type everywhere this shape occurs, and it writes
# `false` before `true`.
# sumPairKeyOf -- the tid whose 2-arm record answers for `tid`: itself when it
# has one, else the template it was monomorphized from. A generic MONO carries
# no record of its own -- resolveVariant and resolveUnion write one per
# DECLARATION -- and a mono's arms are the template's, so the template's record
# is the mono's answer. 0 when neither is a 2-arm sum.
sumPairKeyOf: function {
    ty: ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
} out u64 is {
    {
        o: ty.sumPairFirstArm.get key: tid.u64
        match (
            o
        ) case some then {
            return tid.u64
        } case none then null
    }
    go: reg.genericOriginOf :tid
    if go.isZero then return 0
    {
        p: ty.sumPairFirstArm.get key: go.u64
        match (
            p
        ) case some then {
            return go.u64
        } case none then null
    }
    return 0
}

# sumPairZeroArm -- the arm of the 2-arm sum `tid` whose DISCRIMINATOR is 0.
#
# Falsy is a property of the discriminator's VALUE, not of where the arm was
# written. The two coincide under the default tag -- u8, sequential from 0, so
# the arm written first takes 0 -- which is exactly why writing the falsy arm
# first is the least syntax that says this, and why every stdlib pair does.
#
# A `data`-sourced tag names its own values, and there the position says
# nothing: the zero-valued arm may be written second, or no arm may carry 0 at
# all. Such a pair is NOT treated as having a falsy arm -- the same stance
# variantTagIsOrdinalPlain takes for the C-bool lowering, and for the same
# reason: `data { LOW: 0  HIGH: 10 }` has two arms and is not two ordinals.
# Reading those values here would claim more than the backend honours, since
# the tag enum is emitted without them.
#
# 0 when `tid` is not a 2-arm sum, or when an author-declared `data` tag gives
# its arms values other than 0 and 1.
sumPairArmValueIs: function {
    ty: ZTyping.view
    dataTid: u64
    armName: u64
    want: i64
} out bool is {
    if armName == 0 then return false
    c: (ty.memberConstOf
        parentTypeId: (ztypes.tid.create from: dataTid.u64)
        nameId: (zast.nameid.create from: armName.u32.orPanic)
    )
    if c.kind.ivalKind then return c.ival == want
    return false
}

sumPairZeroArm: function {
    ty: ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
} out u64 is {
    k: sumPairKeyOf :ty :reg :tid
    if k == 0 then return 0
    f: u64
    s: u64
    {
        o: ty.sumPairFirstArm.get key: k
        match (
            o
        ) case some then {
            f = o
        } case none then null
    }
    {
        o8: ty.sumPairSecondArm.get key: k
        match (
            o8
        ) case some then {
            s = o8
        } case none then null
    }
    if f == 0 then return 0
    if s == 0 then return 0
    # variantTagBase records 0 for a DATA-sourced tag, a numeric base for a
    # declared one, and nothing when none was declared. Only the data case
    # detaches the value from the position: a declared numeric is still
    # sequential from 0, so the arm written first carries 0.
    isData: false
    {
        tb: ty.variantTagBase.get key: k
        match (
            tb
        ) case some then {
            if tb == 0 then isData = true
        } case none then null
    }
    if (isData) == false then return f
    # A data block names its own values, so the pair is boolean-like only when
    # those values ARE a discriminator pair -- 0 and 1, in either written
    # order. The arm carrying 0 is the falsy one wherever it stands. Any other
    # set (`{ ON: 1  OFF: 2 }`, `{ HI: 5  LO: 0 }`) is an enumeration that
    # happens to have two elements, not a truth value.
    dt: u64
    {
        d0: ty.declChildOfId parentTypeId: (ztypes.tid.create from: k.u64) nameId: zast.names.wkTag
        match (
            d0
        ) case some then {
            dt = d0
        } case none then null
    }
    if dt == 0 then return 0
    if (sumPairArmValueIs :ty dataTid: dt armName: f want: 0) then {
        if (sumPairArmValueIs :ty dataTid: dt armName: s want: 1) then return f
        return 0
    }
    if (sumPairArmValueIs :ty dataTid: dt armName: s want: 0) then {
        if (sumPairArmValueIs :ty dataTid: dt armName: f want: 1) then return s
    }
    return 0
}

# isSumPair -- is `tid` a 2-arm sum type with a falsy arm? The question
# truthiness asks: such a type has a zero-discriminator arm and another one, so
# it answers as a condition. A 2-arm type whose data tag gives neither arm 0 is
# NOT one of these.
isSumPair: function {
    ty: ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
} out bool is {
    return (sumPairZeroArm :ty :reg :tid) > 0
}

# sumPairFalsyArmOf -- the name id of `tid`'s falsy arm: the one whose
# discriminator is 0. 0 when `tid` has no such arm.
sumPairFalsyArmOf: function {
    ty: ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
} out u64 is {
    return (sumPairZeroArm :ty :reg :tid)
}

# sumPairTruthyArmOf -- the name id of `tid`'s truthy arm: the one that is NOT
# the zero-discriminator arm. 0 when `tid` has no falsy arm to be the other of.
sumPairTruthyArmOf: function {
    ty: ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
} out u64 is {
    z: sumPairZeroArm :ty :reg :tid
    if z == 0 then return 0
    k: sumPairKeyOf :ty :reg :tid
    f: u64
    {
        o: ty.sumPairFirstArm.get key: k
        match (
            o
        ) case some then {
            f = o
        } case none then null
    }
    if f != z then return f
    o8: ty.sumPairSecondArm.get key: k
    match (
        o8
    ) case some then {
        return o8
    } case none then {
        return 0
    }
}

# armSideOfName -- which side of the 2-arm sum `typeId` the name `nameId` is BY
# POSITION: the arm written second is the truthy one, the arm written first the
# falsy one. `none` when the name is neither, or when `typeId` is not a 2-arm
# sum -- so an absent tid answers `none` rather than needing a guard at every
# caller.
#
# Positional on purpose: its callers ask about `bool`'s own arms, and bool
# declares a plain numeric tag whose values ARE the positions. A type whose
# `data` tag names its own values needs sumPairZeroArm, which reads them.
armSideOfName: function {ty: ZTyping.view typeId: u64 nameId: u64} out armside is {
    if nameId == 0 then return armside.none
    {
        childTid: ty.sumPairSecondArm.get key: typeId
        match (
            childTid
        ) case some then {
            if childTid == nameId then return armside.truthy
        } case none then null
    }
    {
        f: ty.sumPairFirstArm.get key: typeId
        match (
            f
        ) case some then {
            if f == nameId then return armside.falsy
        } case none then null
    }
    return armside.none
}

armSuffixSideOf: function {
    ty: ZTyping.view
    nid: u64
    parentNid: u64
    childNameId: u64
} out armside is {
    if childNameId == 0 then return armside.none
    # The suffix reads a predicate's bool RESULT, so the receiver must itself
    # be an arm predicate. `o.some` is a predicate in its own right -- its
    # receiver is an ordinary value -- and falls through to the general path,
    # even though its own stamped type is a 2-arm sum too and its child names
    # that type's second arm.
    parentIsPred: false
    {
        pp: ty.dpArmPredicate.get key: parentNid
        match (
            pp
        ) case some then {
            parentIsPred = true
        } case none then null
    }
    if (parentIsPred) == false then return armside.none
    dps: ty.dpArmPredicate.get key: nid
    match (
        dps
    ) case some then {
        return (armSideOfName :ty typeId: dps nameId: childNameId)
    } case none then {
        return armside.none
    }
}

# nodeTypeAt -- the type id stamped on node `nid`; 0 when nothing is stamped
# there (nodeTypeSet records neither a 0 node id nor a 0 type id). A node id
# indexes the table directly; the length test is not an index adjustment but
# the sparse tail -- the table grows only as far as the highest stamped id.
nodeTypeAt: function {tbl: (ListVal ztypes.tid).view nid: u64} out ztypes.tid is {
    if nid >= tbl.length then return (ztypes.tid.create from: 0)
    return (tbl.get i: nid)
}

# nodeTypeSet -- stamp node `nid` with type id `tid`. Node id 0 means "no node"
# and type id 0 is the unresolved sentinel, so neither is recorded: an absent
# stamp and a 0 stamp are the same answer to every reader.
nodeTypeSet: function {tbl: (ListVal ztypes.tid) nid: u64 tid: ztypes.tid} is {
    if nid == 0 then return
    if tid.isZero then return
    for tbl.length <= nid loop tbl.append ztypes.tid
    v: tid
    tbl.set i: nid val: v
}

# construct an empty ZTyping, pre-sizing its tables for roughly
# `nodeEst` nodes.
newTyping: function {nodeEst: 0.u64} out ZTyping is {
    childTid: (ZTyping
        synthNodes: (List SynthNode)
        nextTempId: 0
        synthLabel: "".string
        synthOwnerUnit: ztypes.declid
        synthOwnerName: zast.nameid
        currentThisTid: ztypes.tid
        currentFnTid: ztypes.tid
        lastLockParamRoot: zast.nameid
        fnBodyDiverges: (IdMapV u64 v: bool)
        funcReturnsBorrow: (IdMapV u64 v: bool)
        funcReturnsView: (IdMapV u64 v: bool)
        funcReturnsTakex: (IdMapV u64 v: bool)
        currentReturnsBorrow: false
        pendingBorrowPath: (ListVal zast.nameid)
        pendingBorrowShared: false
        pendingBorrowReadonly: false
        pendingBorrowOwned: false
            monoNodeType: (MapVV monostamp v: ztypes.tid)
            nsBodiesOwed: (ListVal nsbody)
            nsBodiesWalked: (IdSet u64)
            nsConstsWalked: (IdSet u64)
            templateBodiesScanned: (IdSet u64)
        monoParamSubst: (IdMapV ztypes.tid v: ztypes.tid)
        curMonoStamp: 0
        curMonoFnTid: ztypes.tid
        builtinTidMemo: (IdMapV u64 v: ztypes.tid)
        renameSeen: false
        privacySeen: false
        asConstClone: (IdMapV u64 v: bool)
        generatorWrapper: (IdMapV u64 v: bool)
        typeofShell: (IdMapV u64 v: u32)
        noStampNode: (IdMapV u64 v: bool)
        fnHasBody: (IdMapV u64 v: bool)
        inAssignTarget: false
        sigGenericDecl: ztypes.declid
        inContainmentEdge: false
        suppressParamStamps: false
        suppressBareCtor: false
        suppressFnAutoCall: false
        allowBareFnRef: false
        typedefBaseName: (IdMapV u64 v: zast.nameid)
        typedefBaseTid: (IdMapV ztypes.tid v: ztypes.tid)
        mainDefIsReftype: (IdMapV u64 v: bool)
        dpTaggedParent: (IdMapV u64 v: ztypes.tid)
        dpArmPredicate: (IdMapV u64 v: ztypes.tid)
        dpTagRead: (IdMapV u64 v: ztypes.tid)
        tagAccessorName: (IdMapV u64 v: zast.nameid)
        tagAccessorTid: (IdMapV ztypes.tid v: ztypes.tid)
        postGuardName: (IdMapV u64 v: zast.nameid)
        postGuardVarId: (IdMapV u64 v: ztypes.vid)
        postGuardTid: (IdMapV u64 v: ztypes.tid)
        postGuardArm: (IdMapV u64 v: zast.nameid)
        pendingCustomTag: (IdMapV u64 v: zast.nameid)
        pendingCustomTagNode: (IdMapV u64 v: u64)
        pendingDefaultOwner: (IdMapV u64 v: u64)
        pendingDefaultId: (IdMapV u64 v: u64)
        pendingDefaultName: (IdMapV u64 v: zast.nameid)
        constructedTypes: (IdMapV u64 v: bool)
        collectionChildrenBuilt: (IdSet u64)
        argDisposition: (IdMapV u64 v: ztypes.zparamownership)
        callGenericBinding: (MapVV callslot v: u64)
        binopOwner: (IdMapV u64 v: ztypes.tid)
        binopMethod: (IdMapV u64 v: ztypes.tid)
        monoBinopOwner: (MapVV monostamp v: ztypes.tid)
        monoBinopMethod: (MapVV monostamp v: ztypes.tid)
        # measured self-compile: ~0.6 stamps/node -- capacity nodeEst
        # holds 2/3*nodeEst entries before the first grow
        nodeType: (ListVal ztypes.tid capacity: nodeEst + (nodeEst / 4) + 1)
        callKind: (IdMapV u64 v: zast.callkind)
        atomVariableId: (IdMapV u64 v: ztypes.vid capacity: nodeEst / 4)
        variableMutated: (IdSet ztypes.vid)
        variableMoved: (IdSet ztypes.vid)
        aliasInternalName: (IdMapR u64 V: String)
        implicitCreate: (IdMapV u64 v: u64)
        funcReturnNode: (IdMapV u64 v: u64)
        defVariableId: (IdMapV u64 v: ztypes.vid)
        nodeConst: (IdMapV u64 v: ztypes.cval)
        memberConst: (MapVV constslot v: ztypes.cval)
        constEvalState: (MapVV constslot v: u8)
        constStrings: (List String)
        foldedBranch: (IdMapV u64 v: foldedbranch)
        constFail: ztypes.noConstFail
        conformance: (List ztypes.ZConformance)
        eagerAll: false
        dumpRows: false
        requireMain: true
        ccPath: "".string
        ccMode: "".string
        targetTriple: "".string
        foldPaths: (List String)
        genericBoundName: (IdMapV u64 v: zast.nameid)
        genericBoundFrame: (IdMapV u64 v: ztypes.declid)
        toolRefDecl: (IdMapV u64 v: ztypes.declid)
        genericParamName: (IdMapV u64 v: zast.nameid)
        genericParamFrame: (IdMapV u64 v: ztypes.declid)
        genericParamDecl: (IdMapV u64 v: ztypes.declid)
        genericParamBound: (IdMapV u64 v: u64)
        stmtExprNid: 0
        defNodeIndexBuilt: false
        copyOptOut: (IdSet u64)
        ordinalVariant: (IdMapV u64 v: u64)
        sumPairFirstArm: (IdMapV u64 v: u64)
        sumPairSecondArm: (IdMapV u64 v: u64)
        truthyCondArm: (IdMapV u64 v: u64)
        variantTagBase: (IdMapV u64 v: u64)
        systemUnitRoot: ztypes.declid
        mainUnitRoot: ztypes.declid
        collectionsUnitRoot: ztypes.declid
        coreUnitRoot: ztypes.declid
        programRoot: ztypes.declid
        nullTypeId: 0
        pendingTyperef: (IdMapV u64 v: zast.nameid)
        pendingTyperefFrame: (IdMapV u64 v: ztypes.declid)
        unitTypesById: (IdMapV u64 v: ztypes.tid)
        decls: (List Decl)
        declByTypeId: (IdMapV u64 v: ztypes.declid)
        publicNsByOwner: (IdMapV u64 v: ztypes.declid)
        refDecl: (IdMapV u64 v: ztypes.declid)
        pendingDefs: (ListVal ztypes.declid)
        enteredUnits: (IdSet u64)
        requireSeen: (IdSet u64)
        requireDemanded: (ListVal ztypes.declid)
        platformSeeded: false
        drainingDefs: false
        typerefsStamped: 0
        typerefPassRan: false
        typerefRetry: (ListVal u64)
        pendWrites: (ListVal pendwrite)
        errors: (List zast.ErrorData)
        currentReturnTypeId: ztypes.tid
        isError: false)
    # Row 0 of each table this object owns is a sentinel, so an id indexes its
    # row with no arithmetic. The declaration sentinel answers "nothing" to
    # every reader: no name, no parent, no type, no children, kind none.
    childTid.decls.append (Decl
        name: 0
        parent: ztypes.declid
        kind: declkind.noneDecl
        node: 0
        typeId: ztypes.tid
        ownership: ztypes.zparamownership.noneMode
        defaultVal: defaultval.none
        resolving: false
        defined: false
        pending: false
        walked: false
        grantsPrivate: false
        unitFrame: false
        fnptrField: false
        lockFieldDecl: 0
        conformerName: 0
        varId: ztypes.vid
        rows: 0
        children: (IdMapV zast.nameid v: ztypes.declid)
    )
    childTid.constStrings.append "".string
    # the program root, DeclId 1: the file units are parented to it, so every
    # declaration but this one has a parent. Minted with parent 0, so it takes
    # no name edge and lands in no namespace; it carries no unit-frame bit and
    # no type id, which is what keeps it out of the bare-name walks --
    # unitFrameOf climbs through it and probeFrameTyperef finds no member
    # index on it.
    childTid.programRoot = (childTid.declNew
        name: 0
        parent: ztypes.declid
        kind: declkind.programDecl
        node: 0
    )
    return childTid
}
