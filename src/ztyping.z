# ZTyping -- the typecheck-output container.
#
# The parser produces a frozen zast.Program; the type checker consumes it
# and produces a ZTyping: every typecheck-derived datum the downstream
# consumers (emitter, SQL dumper) read. This is the data module, separate
# from the producer, mirroring the zast / zparser split. References ztypes.z
# for ZType + the shared enums (a multi-unit reference, like zparser -> zast).
#
# Representation is id-first and relational: cross-type references are
# stored as u64 type ids (resolved through the registry by the producer),
# and the per-node stamps live in id-keyed Maps. A type's members live on
# its declaration -- the Decl tree is the single member index -- and their
# names are shared Ast.names pool ids. Every mutator runs on :this -- a
# container that owns all of its state -- so mutations persist.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :PendingUnitWalk
    :SynthNode
    :Decl
    :DefaultVal
    :declchild
    :declkind
    :declkindName
    :ZTyping
    :newTyping
    :main
}

ZType: ztypes.ZType
Node: zast.Node

# --- relational row carriers ---

# A declaration's name index switches from a linear child scan to the byName
# map past this many children (no owned key, no hash below it).
bucketScanMax: 16.u64

# One edge of the generic-args table: a (parent, param-name) link. The
# mutable arg-type id lives in genericArgTypeBy, keyed by a
# (parentTypeId, paramNameId) composite.
ZTypeGenericArg: class {
    parentTypeId: u64
    paramName: String
    position: u64
}

# Per-node compile-time constant value, carried via the shared ZConst
# (kind/ival/fval/sval). bool consts fold onto IVAL until the producer
# slice needs a distinct encoding.
NodeConstRow: class {
    nodeid: u64
    value: ztypes.ZConst
}

# One (node -> (name, optional type)) row: the relational form of the
# if/case post-block ownership-cleanup lists. Order-significant (append).
TakenVarRow: class {
    nodeid: u64
    name: String
    typeId: (optionval u64)
}

# One (node -> name) row: the relational form of the set-valued node
# stamps (generic-param names, taken-arm names, for-iterator bindings).
NodeNameRow: class {
    nodeid: u64
    name: String
}

# One monomorphized (mono-type, originating-AST-node) pair.
MonoRow: class {
    monoTypeId: u64
    astNodeId: u64
}


# One typecheck-synthesised AST row for the dump: a node minted during the
# body walk (call-arg hoist temps) that the parsed-program walk cannot reach.
SynthNode: class {
    nodeid: u32
    kind: String
    label: String
    lineno: u32
    colno: u32
}

# PendingUnitWalk -- a generic-unit mono's cloned method awaiting its lazy
# first-use walk (the reference clones and checks bodies at the use site,
# so the clone scopes parent under the using function).
PendingUnitWalk: class {
    monoId: u64
    monoName: String
    qualified: String
    gpName: String
    argId: u64
    fn: Node
}

# --- declaration tree ---

# The kind of declaration a Decl records: which definition shape the
# indexer saw. Resolution semantics stay with the readers (a reexport
# shares its target's type id; a publicNs holds the unit's exported
# name -> declaration edges).
declkind: variant {
    unitDecl: null
    funcDecl: null
    typeDecl: null
    constDecl: null
    dataDecl: null
    paramDecl: null
    fieldDecl: null
    methodDecl: null
    armDecl: null
    reexportDecl: null
    publicNs: null
} as { tag: u8.tag }

# declkindName -- a declaration kind's dump/debug text.
declkindName: function {k: declkind} out String is {
    match (
        k
    ) case unitDecl then {
        return "unit".string
    } case funcDecl then {
        return "function".string
    } case typeDecl then {
        return "type".string
    } case constDecl then {
        return "const".string
    } case dataDecl then {
        return "data".string
    } case paramDecl then {
        return "param".string
    } case fieldDecl then {
        return "field".string
    } case methodDecl then {
        return "method".string
    } case armDecl then {
        return "arm".string
    } case reexportDecl then {
        return "reexport".string
    } case publicNs then {
        return "publicns".string
    }
}

# one name -> child-declaration edge of a Decl's namespace.
declchild: record {
    nameId: u32
    declId: u64
}

# DefaultVal -- a member's default value, de-hacking the childDefault string
# sentinels (`#function:`/`#variant:`). `literal` carries the default-expression
# nodeid (re-emitted verbatim); `function`/`arm` carry the target DeclId; `none`
# means no default.
DefaultVal: variant {
    none: null
    literal: u32
    func: u64
    arm: u64
} as { tag: u8.tag }

# One declaration: a named definition site in the program. `name` is the
# shared Ast.names pool id; `parent` the enclosing Decl (0 = a tree
# root); `node` the declaring namedoperation's AST nodeid (location via
# fsnoForNode); `typeId` the type this declaration minted (0 until one
# is); `children` the ordered namespace the declaration owns. Body-local
# variables are not Decls -- they keep the lexical variable-id system. On a
# MEMBER declaration `typeId` is the member's own type (what the tid-keyed
# child index records), not one it minted.
Decl: class {
    name: u32
    parent: u64
    kind: declkind
    node: u32
    typeId: u64
    # originDecl -- a mono member decl's template member decl (Phase 4
    # navigation); 0 for template/source members.
    originDecl: u64
    # ownership -- a param member's binding mode (noneMode when unset); where a
    # param's lock status lives.
    ownership: ztypes.zparamownership
    # defaultVal -- a member's default value (none when unset). (Named
    # defaultVal, not default, which is a C keyword the emitter would not mangle.)
    defaultVal: DefaultVal
    # grantsPrivate -- the field's declared type was a `.private` friend handle
    # (syntactic; not derivable from typeId).
    grantsPrivate: bool
    # lockArm -- a variant arm marked as the lock arm.
    lockArm: bool
    # fnptrField -- the member occupies a struct function-pointer slot: an
    # is-block function member of a record or class, or an as-block member of a
    # generic class. Where it was declared, not its kind, decides this.
    fnptrField: bool
    # lockFieldDecl -- on a TYPE decl, which member is the type's lock (0 = none).
    lockFieldDecl: u64
    children: (List declchild)
    # derived nameId -> declId accelerator over `children`, backfilled when
    # the namespace outgrows a linear scan (bucketScanMax); not dumped
    byName: (Map u64 value: u64)
}

# the typing side-tables: every typecheck stamp keyed by AST node id
# (types, child edges, monomorphisations, lock overlays), kept separate
# from the frozen AST so the tree is never mutated.
ZTyping: class {
    # typecheck-synthesised AST rows, the per-run `_t` temp-name counter, the
    # synth node-id mint (starts above any parsed id), and the current
    # `unit.def` dump label the body walk maintains.
    synthNodes: (List SynthNode)
    nextSynthNodeId: u32
    nextTempId: u64
    synthLabel: String
    currentThisName: String
    lastLockParamRoot: String

    # generic instantiations: refs recorded for the mono pass and
    # the minted instances, deduped by mono name (template_arg1[_arg2...]).
    # a generic template's syntactic body divergence (its last statement is a
    # return), recorded at resolution for the clone-scope synthesis.
    fnBodyDiverges: (Map u64 value: bool)
    # function types whose return carries the `.borrow` marker, recorded at
    # resolution; the body walk's auto-call coercion reads it to report the
    # receiver source path.
    funcReturnsBorrow: (Map u64 value: bool)
    # the fn whose body is being walked declares a `.borrow` return: bare
    # field returns are its contract (the lock/borrow source outlives).
    currentReturnsBorrow: bool
    # the borrow source path a just-coerced BORROW-returning auto-call reported
    # (the reference's _pending_borrow_lock); consumed by the binding sites,
    # drained at statement and call boundaries.
    pendingBorrowPath: (List String)
    # the pending borrow is a RETURNED borrow (a `.borrow`-marked return): a
    # read-view of the source, so the binding's leaf lock is SHARED (the
    # container-view model) rather than the exclusive alias default.
    pendingBorrowShared: bool
    # type names whose method bodies the walk has already visited (methods
    # body-check once, at the type's first body-walk reference).
    walkedMethodOwners: (Map String value: bool)
    # per-mono template stamps: (monoId << 32 | nodeid) -> tid, written by
    # the post-sweep instance walk when curMonoStamp is set; the emitter's
    # mono re-walks read these where the global table is param-suppressed.
    # monoParamSubst maps the CURRENT mono's generic-param tids to its args
    # (flat substitution at stamp time); live only during the instance walk.
    monoNodeType: (Map u64 value: u64)
    monoParamSubst: (Map u64 value: u64)
    curMonoStamp: u64
    curMonoFnTid: u64
    # the unit whose members mainMemberIndex indexes (set once, when that
    # unit's body walk starts); demand walks in any other unit must not
    # consult the index -- its values index this unit's body list only
    mainMemberIndex: (Map String value: u64)
    mainMemberUnit: String

    # child-name id minting (ztyping-local id space)
    # base type name id (pool id) -> resolved builtin tid (currentUnit "");
    # an unresolved 0 is never stored so later resolution can still fill it
    builtinTidMemo: (Map u64 value: u64)

    # flat edge tables
    typeGenericArg: (List ZTypeGenericArg)

    # true once any public-interface rename exists (skips alias lookups otherwise)
    renameSeen: bool
    # true once any member has been marked private (gates cross-unit checks)
    privacySeen: bool
    asConstClone: (Map u64 value: bool)
    generatorWrapper: (Map u64 value: bool)
    typeofShell: (Map u64 value: u32)
    noStampNode: (Map u64 value: bool)
    # FUNCTION tid -> the definition carries a body (a bodyless spec is false)
    fnHasBody: (Map u64 value: bool)
    # a reassignment TARGET path is being checked (a write, not a read)
    inAssignTarget: bool
    # the generic template (its DeclId) whose signature is being
    # registered: its param names are not unit typerefs
    sigGenericDecl: u64
    inContainmentEdge: bool
    suppressParamStamps: bool
    suppressBareCtor: bool
    suppressFnAutoCall: bool
    typedefBaseName: (Map u64 value: String)
    # a typedef wrapper's base type id, resolved structurally at declaration
    # (a parameterized base rides the spec trie, a bare atom the unit ladder)
    typedefBaseTid: (Map u64 value: u64)
    protocolThisContext: (Map String value: String)
    mainDefIsReftype: (Map String value: bool)
    dpTaggedParent: (Map u64 value: u64)
    dpArmPredicate: (Map u64 value: u64)
    dpTagRead: (Map u64 value: u64)
    tagAccessorName: (Map u64 value: String)
    tagAccessorTid: (Map u64 value: u64)
    postGuardName: (Map u64 value: String)
    postGuardRecv: (Map u64 value: String)
    postGuardTid: (Map u64 value: u64)
    postGuardArm: (Map u64 value: String)
    fullMainUnit: String
    pendingCustomTag: (Map u64 value: String)
    pendingCustomTagNode: (Map u64 value: u64)
    pendingDefaultOwner: (Map u64 value: u64)
    pendingDefaultId: (Map u64 value: u64)
    pendingDefaultName: (Map u64 value: String)
    constructedTypes: (Map u64 value: bool)
    collectionChildrenBuilt: (Map u64 value: bool)
    pendingUnitWalk: (List PendingUnitWalk)
    unitMonoWalksPending: (Map u64 value: bool)
    # per-call-argument disposition (take/lock/borrow); absent = valtype/none.
    # tooling-only; the emitter never reads it.
    argDisposition: (Map u64 value: ztypes.zparamownership)
    # generic arg-type id, keyed by (parentTypeId << 32 | paramNameId)
    genericArgTypeBy: (Map u64 value: u64)
    # inferred concrete tid per call, keyed by (callNodeid << 32 | paramNameId)
    callGenericBinding: (Map u64 value: u64)

    # per-node single-valued stamps, keyed by parsed-AST nodeid
    nodeType: (Map u64 value: u64)
    nodeLiteralBase: (Map u64 value: ztypes.numbase)
    callKind: (Map u64 value: zast.callkind)
    atomVariableId: (Map u64 value: u64)
    # dotted-path nodeid -> the internal member name a public alias resolved to
    aliasInternalName: (Map u64 value: String)
    implicitCreate: (Map u64 value: u64)
    variableZtype: (Map u64 value: u64)
    variableOwnership: (Map u64 value: ztypes.zownership)
    # variable origin kind: true = parameter, false = local (unit-level unstamped)
    variableOrigin: (Map u64 value: bool)
    variableIsPrivate: (Map u64 value: bool)
    variableBorrowOrigin: (Map u64 value: String)
    variableSynthOrigin: (Map u64 value: String)
    funcReturnNode: (Map u64 value: u64)
    defVariableId: (Map u64 value: u64)
    withOwnership: (Map u64 value: ztypes.zownership)
    # member access: dotted-path nodeid -> the receiver's canonical type id
    # (the member's owner). Tooling (zls go-to-definition) resolves the
    # member by name inside the owner's definition body.

    # per-node collection-valued stamps, flattened to append-only rows
    nodeConst: (List NodeConstRow)
    ifTakenVars: (List TakenVarRow)
    caseSubjectTakenArms: (List NodeNameRow)

    # aggregate typecheck state
    conformance: (List ztypes.ZConformance)
    monoTypes: (List MonoRow)
    preludeUnit: (Map String value: String)
    # names whose definition BODY has been resolved (the demand "done" marker);
    # distinct from `resolved` now that references pre-populate it.
    definedKeys: (Set String)
    # names whose definition body is currently being resolved -- the DFS grey
    # set. A reference that walks back into a grey name is a cycle back-edge:
    # it uses the forward-decl id instead of re-descending.
    resolving: (Set String)
    # true once indexUnitDefs has populated the node finder; descent is gated
    # off before then (generator lowering runs pre-index).
    defNodeIndexBuilt: bool
    # memoized pseudo-shell ids for literal do-block break values: the optionval
    # instance over a literal payload keys off ONE shell per literal kind, not a
    # fresh mint per occurrence.
    systemUnitTid: u64
    literalIntShellId: u64
    literalFloatShellId: u64
    # one-shot guard: the native link-target descend runs once per program
    nativeLinkTargetsDone: bool
    # type-ref node id -> base type name; resolved to its real type post-demand
    pendingTyperef: (Map u64 value: String)
    pendingTyperefUnit: (Map u64 value: String)
    unitTypesById: (Map u64 value: u64)
    # --- declaration tree (parallel to the string-keyed def tables
    # above; readers migrate to Decls stage by stage) ---
    # every Decl row, keyed by DeclId (dense 1..N mint order)
    decls: (Map u64 value: Decl)
    # type id -> the declaration that minted it (first mint wins), so a member
    # setter reaches the owner's declaration without the type registry. A
    # monomorphisation is absent: it links to its template through the
    # registry, never through declSetType.
    declByTypeId: (Map u64 value: u64)
    # bare unit name -> the unit's root DeclId (the root index)
    unitRootByName: (Map String value: u64)
    # reference nodeid -> resolved DeclId (stamped by resolution)
    refDecl: (Map u64 value: u64)
    # canonical mints that predate the def index (their unit root Decl
    # does not exist yet); drained into root-proxy links by indexUnitDefs
    declProxyTids: (List u64)
    declProxyUnits: (List String)
    # Member-type writes that found no declaration to land on. Generator
    # lowering pre-resolves system.optionval and system.Iterator, and the
    # never/null canonical pair is minted, before indexUnitDefs builds the
    # unit-root Decls, so those types' members are typed before anything
    # declares them. The write is held here until the index exists and
    # declStampPreIndexMembers can land it, and answers reads during the
    # window. Keyed by (parent, name), last write wins, a handful of entries.
    pendParent: (List u64)
    pendName: (List u64)
    pendType: (List u64)
    isError: bool
    errors: (List zast.ErrorData)
    currentReturnTypeId: u64
} as {
    # --- declaration tree ---

    # declNew -- append one declaration row (DeclId = new row count) and
    # link it into the parent's namespace; parent 0 = a tree root.
    declNew: function {:this name: u32 parent: u64 kind: declkind node: u32} out u64 is {
        id: this.decls.length + 1
        this.decls.set key: id value: (Decl
            :name
            :parent
            :kind
            :node
            typeId: 0
            originDecl: 0
            ownership: ztypes.zparamownership.noneMode
            defaultVal: DefaultVal.none
            grantsPrivate: false
            lockArm: false
            fnptrField: false
            lockFieldDecl: 0
            children: (List declchild)
            byName: (Map u64 value: u64)
        )
        if parent > 0 then this.declAddChildEdge parentDeclId: parent nameId: name childDeclId: id
        return id
    }

    # declAddChildEdge -- append a name -> declaration edge to a parent's
    # namespace (also used for public-interface entries, whose targets are
    # sibling declarations rather than fresh rows).
    # declMoveChildToEnd -- move a member's entry to the LAST MEMBER SLOT of its
    # parent's namespace. Called when the member is first edged, so declaration
    # order BECOMES child-edge order as it is built, instead of being permuted
    # to match it afterwards. Non-member children (a type's `public:` block)
    # keep their positions; only the member slots rotate.
    declMoveChildToEnd: function {:this parentDeclId: u64 nameId: u32} is {
        cn9: (List u32)
        cd9: (List u64)
        {
            po9: this.decls.get key: parentDeclId
            match (
                po9
            ) case some then {
                with cit9: po9.children.iterate do for c9: cit9 loop {
                    cn9.append c9.nameId
                    cd9.append c9.declId
                }
            } case none then null
        }
        n9: cn9.length
        if n9 < 2 then return
        # the member slots, probed once the children borrow is released
        slots9: (List u64)
        si9: u64
        for si9 < n9 loop {
            isMem9: false
            {
                ko9: this.decls.get key: (cd9.get i: si9)
                match (
                    ko9
                ) case some then {
                    if ko9.kind.fieldDecl then isMem9 = true
                    if ko9.kind.methodDecl then isMem9 = true
                    if ko9.kind.paramDecl then isMem9 = true
                    if ko9.kind.armDecl then isMem9 = true
                } case none then null
            }
            if isMem9 then slots9.append si9
            si9 = si9 + 1
        }
        m9: slots9.length
        if m9 < 2 then return
        # the LAST match, not the first: declFindChild is last-wins, so a
        # variant arm and an as-block method sharing a name must keep their
        # relative order or the name resolves to the other one
        at9: u64
        found9: false
        ki9: u64
        for ki9 < m9 loop {
            sp9: slots9.get i: ki9
            if (cn9.get i: sp9) == nameId then {
                at9 = ki9
                found9 = true
            }
            ki9 = ki9 + 1
        }
        if (found9) == false then return
        if at9 == (m9 - 1) then return
        movS9: slots9.get i: at9
        movN9: cn9.get i: movS9
        movD9: cd9.get i: movS9
        ri9: at9
        for ri9 < (m9 - 1) loop {
            dst9: slots9.get i: ri9
            src9: slots9.get i: (ri9 + 1)
            cn9.set i: dst9 val: (cn9.get i: src9)
            cd9.set i: dst9 val: (cd9.get i: src9)
            ri9 = ri9 + 1
        }
        lst9: slots9.get i: (m9 - 1)
        cn9.set i: lst9 val: movN9
        cd9.set i: lst9 val: movD9
        wo9: this.decls.get key: parentDeclId
        match (
            wo9
        ) case some then {
            wi9: u64
            for wi9 < n9 loop {
                (wo9.children.set
                    i: wi9
                    val: (declchild nameId: (cn9.get i: wi9) declId: (cd9.get i: wi9))
                )
                wi9 = wi9 + 1
            }
        } case none then null
    }

    declAddChildEdge: function {:this parentDeclId: u64 nameId: u32 childDeclId: u64} is {
        po9: this.decls.get key: parentDeclId
        match (
            po9
        ) case some then {
            po9.children.append (declchild :nameId declId: childDeclId)
            # keep the name index in the WRITER, the way pushChildIndex keeps
            # the edge bucket's: the first append past the scan threshold
            # backfills it and later appends keep it filled. Backfilling in the
            # reader instead would make every lookup a mutation, and a mutating
            # lookup cannot run under a live children borrow.
            if po9.children.length > bucketScanMax then {
                if po9.byName.length == 0 then {
                    with cit7: po9.children.iterate do for c7: cit7 loop {
                        po9.byName.set key: c7.nameId.u64 value: c7.declId
                    }
                } else {
                    po9.byName.set key: nameId.u64 value: childDeclId
                }
            }
        } case none then null
    }

    # declSetType -- record the canonical type a declaration minted, and the
    # reverse edge. The first mint wins, so a later alias declaration sharing
    # the type does not displace the defining one.
    declSetType: function {:this declId: u64 typeId: u64} is {
        {
            do9: this.decls.get key: declId
            match (
                do9
            ) case some then {
                do9.typeId = typeId
            } case none then null
        }
        if typeId > 0 then {
            seen9: false
            {
                ex9: this.declByTypeId.get key: typeId
                match (
                    ex9
                ) case some then {
                    seen9 = true
                } case none then null
            }
            if seen9 == false then this.declByTypeId.set key: typeId value: declId
        }
    }

    # declPendWrite -- hold a member-type write whose owner has no declaration
    # yet. In place on a repeat, so the buffer carries one entry per
    # (parent, name) exactly as a child edge did.
    declPendWrite: function {:this parentTypeId: u64 nameId: u64 typeId: u64} is {
        i9: u64
        n9: this.pendParent.length
        for i9 < n9 loop {
            hit9: (this.pendParent.get i: i9) == parentTypeId
            if hit9 then hit9 = (this.pendName.get i: i9) == nameId
            if hit9 then {
                this.pendType.set i: i9 val: typeId
                return
            }
            i9 = i9 + 1
        }
        pp9: parentTypeId
        this.pendParent.append pp9
        pn9: nameId
        this.pendName.append pn9
        pt9: typeId
        this.pendType.append pt9
    }

    # declPendMemberType -- the type a pended write recorded for
    # (parent, name); 0 when there is none.
    declPendMemberType: function {:this parentTypeId: u64 nameId: u64} out u64 is {
        r9: u64
        i9: u64
        n9: this.pendParent.length
        for i9 < n9 loop {
            hit9: (this.pendParent.get i: i9) == parentTypeId
            if hit9 then hit9 = (this.pendName.get i: i9) == nameId
            if hit9 then r9 = this.pendType.get i: i9
            i9 = i9 + 1
        }
        return r9
    }

    # declPendRows -- one parent's pended writes, in write order.
    declPendRows: function {:this parentTypeId: u64 names: List u64 tids: List u64} is {
        i9: u64
        n9: this.pendParent.length
        for i9 < n9 loop {
            if (this.pendParent.get i: i9) == parentTypeId then {
                names.append (this.pendName.get i: i9)
                tids.append (this.pendType.get i: i9)
            }
            i9 = i9 + 1
        }
    }

    # declStampPreIndexMembers -- land the member-type writes a type held while
    # it had no declaration. indexUnitDefs calls this once on each pre-index
    # mint it drains; no other path needs it, because every other member is
    # declared before its type is written.
    declStampPreIndexMembers: function {:this parentTypeId: u64 declId: u64} is {
        nids9: (List u64)
        tids9: (List u64)
        this.declPendRows :parentTypeId names: nids9 tids: tids9
        i9: u64
        n9: nids9.length
        for i9 < n9 loop {
            nid9: nids9.get i: i9
            mtid9: tids9.get i: i9
            i9 = i9 + 1
            if mtid9 > 0 then {
                md9: this.declFindChild parentDeclId: declId nameId: nid9.u32.orPanic
                if md9 > 0 then {
                    do9: this.decls.get key: md9
                    match (
                        do9
                    ) case some then {
                        do9.typeId = mtid9
                    } case none then null
                }
            }
        }
    }

    # declFindChild -- the last child declaration named nameId under
    # parentDeclId (0 when absent); last wins, matching the overwrite
    # semantics of the string-keyed def tables.
    declFindChild: function {:this parentDeclId: u64 nameId: u32} out u64 is {
        po9: this.decls.get key: parentDeclId
        found9: u64
        match (
            po9
        ) case some then {
            if po9.byName.length > 0 then {
                bo9: po9.byName.get key: nameId.u64
                match (
                    bo9
                ) case some then {
                    found9 = bo9
                } case none then null
            } else {
                with cit9: po9.children.iterate do for c9: cit9 loop {
                    if c9.nameId == nameId then found9 = c9.declId
                }
            }
        } case none then null
        return found9
    }

    # declIdOfType -- the declaration that minted `typeId`; 0 for a type with
    # none of its own. A monomorphisation HAS one -- declMonoType clones the
    # template's -- so this returns the mono's own declaration, whose members
    # carry instantiated types. (declOfTypeId, in ztypecheck, hops
    # genericOrigin to the TEMPLATE's instead; the two differ on monos.)
    declIdOfType: function {:this typeId: u64} out u64 is {
        od9: u64
        {
            go9: this.declByTypeId.get key: typeId
            match (
                go9
            ) case some then {
                od9 = go9
            } case none then null
        }
        return od9
    }

    # declSetMemberType -- record a member declaration's type. Deliberately
    # not declSetType: the member did not mint the type, so it must not claim
    # the reverse declByTypeId edge.
    declSetMemberType: function {:this parentTypeId: u64 nameId: u64 typeId: u64} is {
        nid8: nameId.u32.orPanic
        md8: this.declMemberIdOf :parentTypeId nameId: nid8
        if md8 == 0 then {
            # a function type's members are its parameters, and a synthesized
            # constructor gains them after its own declaration exists
            od8: this.declIdOfType typeId: parentTypeId
            if od8 == 0 then {
                this.declPendWrite :parentTypeId :nameId :typeId
                return
            }
            isFn8: false
            node8: u32
            {
                oo8: this.decls.get key: od8
                match (
                    oo8
                ) case some then {
                    if oo8.kind.methodDecl then isFn8 = true
                    if oo8.kind.funcDecl then isFn8 = true
                    node8 = oo8.node
                } case none then null
            }
            if isFn8 == false then {
                this.declPendWrite :parentTypeId :nameId :typeId
                return
            }
            md8 = (this.declNew
                name: nid8
                parent: od8
                kind: declkind.paramDecl
                node: node8
            )
        }
        isMethod8: false
        {
            do8: this.decls.get key: md8
            match (
                do8
            ) case some then {
                do8.typeId = typeId
                if do8.kind.methodDecl then isMethod8 = true
            } case none then null
        }
        # a method's type IS the function it declares, so it owns that type's
        # namespace -- its parameters attach here. A field's type belongs to
        # whatever declared it, so a field never claims one.
        if isMethod8 when typeId > 0 then {
            if (this.declIdOfType :typeId) == 0 then this.declByTypeId.set key: typeId value: md8
        }
    }

    # declChildOf / declChildOfId -- the type of member `name` on parentTypeId,
    # read from the member's declaration. none when the member is undeclared or
    # carries no type, matching an absent child edge.
    declChildOf: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} out optionval u64 is {
        nid9: pool.find s: name
        if nid9 == 0 then return (optionval.none u64)
        return (this.declChildOfId :parentTypeId nameId: nid9.u64)
    }

    declChildOfId: function {:this parentTypeId: u64 nameId: u64} out optionval u64 is {
        md9: this.declMemberIdOf :parentTypeId nameId: nameId.u32.orPanic
        if md9 == 0 then return (optionval.none u64)
        t9: u64
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                t9 = mo9.typeId
            } case none then null
        }
        if t9 == 0 then return (optionval.none u64)
        return (optionval.some t9)
    }

    # declIsLockField / declIsLockFieldId -- is `name` the lock field of the
    # type that minted parentTypeId? The owning declaration names one member as
    # its lock, so this is a round trip through that pointer.
    declIsLockField: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} out bool is {
        nid9: pool.find s: name
        if nid9 == 0 then return false
        return (this.declIsLockFieldId :parentTypeId nameId: nid9)
    }

    declIsLockFieldId: function {:this parentTypeId: u64 nameId: u32} out bool is {
        od9: this.declIdOfType typeId: parentTypeId
        if od9 == 0 then return false
        lf9: u64
        {
            oo9: this.decls.get key: od9
            match (
                oo9
            ) case some then {
                lf9 = oo9.lockFieldDecl
            } case none then null
        }
        if lf9 == 0 then return false
        return lf9 == (this.declFindChild parentDeclId: od9 :nameId)
    }

    # declDefaultOfId -- member `nameId`'s recorded default value; none when
    # the member is undeclared or carries none.
    declDefaultOfId: function {:this parentTypeId: u64 nameId: u32} out DefaultVal is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9 == 0 then return DefaultVal.none
        r9: DefaultVal.none
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                dv9: mo9.defaultVal
                r9 = dv9
            } case none then null
        }
        return r9
    }

    # declHasDefaultId -- does member `nameId` of parentTypeId carry a default?
    declHasDefaultId: function {:this parentTypeId: u64 nameId: u32} out bool is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9 == 0 then return false
        r9: false
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                if mo9.defaultVal.none then r9 = false else r9 = true
            } case none then null
        }
        return r9
    }

    # declOwnershipIs -- the parameter binding mode recorded on member `name`
    # of parentTypeId equals `own`; false when the member is undeclared or
    # carries no mode. A zero-inited declaration reads noneMode, so an unset
    # mode never matches take, borrow or lock.
    # declOwnershipOfId -- a member's recorded parameter ownership, or none
    # when it has none. An unset declaration reads noneMode, which is exactly
    # the sidecar's absent entry, so both report none.
    declOwnershipOfId: function {:this parentTypeId: u64 nameId: u32} out optionval ztypes.zparamownership is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9 == 0 then return (optionval.none ztypes.zparamownership)
        r9: ztypes.zparamownership.noneMode
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                r9 = mo9.ownership
            } case none then null
        }
        if r9.noneMode then return (optionval.none ztypes.zparamownership)
        return (optionval.some r9)
    }

    # declGrantsPrivate -- was member `name` declared with a `.private` handle
    # type, so reads through it stay private-capable?
    declGrantsPrivate: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} out bool is {
        nid9: pool.find s: name
        if nid9 == 0 then return false
        md9: this.declMemberIdOf :parentTypeId nameId: nid9
        if md9 == 0 then return false
        r9: false
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                r9 = mo9.grantsPrivate
            } case none then null
        }
        return r9
    }

    declOwnershipIs: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView own: ztypes.zparamownership} out bool is {
        nid9: pool.find s: name
        if nid9 == 0 then return false
        md9: this.declMemberIdOf :parentTypeId nameId: nid9
        if md9 == 0 then return false
        r9: false
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                oc9: own
                r9 = (ztypes.zparamownershipInt mo9.ownership) == (ztypes.zparamownershipInt oc9)
            } case none then null
        }
        return r9
    }

    # declIsFnptrField / declIsFnptrFieldId -- does member `name` occupy a
    # struct function-pointer slot? Where it was declared decides this, so the
    # member declaration carries it as a bit.
    declIsFnptrField: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} out bool is {
        nid9: pool.find s: name
        if nid9 == 0 then return false
        return (this.declIsFnptrFieldId :parentTypeId nameId: nid9)
    }

    declIsFnptrFieldId: function {:this parentTypeId: u64 nameId: u32} out bool is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9 == 0 then return false
        r9: false
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                r9 = mo9.fnptrField
            } case none then null
        }
        return r9
    }

    # declIsLockArm -- is arm `name` of parentTypeId marked as the lock arm?
    declIsLockArm: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} out bool is {
        nid9: pool.find s: name
        if nid9 == 0 then return false
        md9: this.declMemberIdOf :parentTypeId nameId: nid9
        if md9 == 0 then return false
        r9: false
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                r9 = mo9.lockArm
            } case none then null
        }
        return r9
    }


    # declCloneType -- a monomorphisation's own type declaration: the
    # template's name, node and home unit, with the template's members cloned
    # in order and originDecl pointing back at each. The clone is reachable by
    # no name -- it is linked into no parent namespace, so resolving the
    # template's name still finds the template.
    declCloneType: function {:this templateDeclId: u64} out u64 is {
        tname9: u32
        tnode9: u32
        tparent9: u64
        tkind9: declkind.typeDecl
        kids9: (List u64)
        {
            to9: this.decls.get key: templateDeclId
            match (
                to9
            ) case some then {
                tname9 = to9.name
                tnode9 = to9.node
                tparent9 = to9.parent
                tkind9 = to9.kind
                with cit9: to9.children.iterate do for c9: cit9 loop kids9.append c9.declId
            } case none then null
        }
        if tname9 == 0 then return 0
        # the clone keeps the template's kind: a monomorphisation of a generic
        # FUNCTION is a function, and only a function declaration may own its
        # parameter declarations.
        id9: this.declNew name: tname9 parent: 0 kind: tkind9 node: tnode9
        {
            no9: this.decls.get key: id9
            match (
                no9
            ) case some then {
                no9.parent = tparent9
                no9.originDecl = templateDeclId
            } case none then null
        }
        ki9: u64
        kn9: kids9.length
        for ki9 < kn9 loop {
            kd9: kids9.get i: ki9
            ki9 = ki9 + 1
            cn9: u32
            cnode9: u32
            ck9: declkind.fieldDecl
            isM9: false
            {
                ko9: this.decls.get key: kd9
                match (
                    ko9
                ) case some then {
                    cn9 = ko9.name
                    cnode9 = ko9.node
                    ck9 = ko9.kind
                    if ko9.kind.fieldDecl then isM9 = true
                    if ko9.kind.methodDecl then isM9 = true
                    if ko9.kind.armDecl then isM9 = true
                } case none then null
            }
            if isM9 then {
                cid9: this.declNew name: cn9 parent: id9 kind: ck9 node: cnode9
                {
                    co9: this.decls.get key: cid9
                    match (
                        co9
                    ) case some then {
                        co9.originDecl = kd9
                    } case none then null
                }
            }
        }
        return id9
    }

    # declSynthMember -- mint the declaration of a member the checker
    # synthesises (create, borrow, ==, !=, tag) under the type that minted
    # `parentTypeId`, appended in the position its child edge took. A no-op
    # when that type has no declaration of its own, or when the member is
    # already declared (a type writing its own `create` in an is-block).
    declSynthMember: function {:this parentTypeId: u64 nameId: u64 kind: declkind} is {
        od9: this.declIdOfType typeId: parentTypeId
        if od9 == 0 then return
        nid8: nameId.u32.orPanic
        if (this.declFindChild parentDeclId: od9 nameId: nid8) > 0 then return
        node9: u32
        {
            oo9: this.decls.get key: od9
            match (
                oo9
            ) case some then {
                node9 = oo9.node
            } case none then null
        }
        kk9: kind
        this.declNew name: nid8 parent: od9 kind: kk9 node: node9
    }

    # declMemberList -- a type's members, in declaration order, from the
    # declaration tree rather than the child-edge tables: the member names
    # (pool ids) and their types. Members are the field / method / arm / param
    # children carrying a type; a unit's definitions and a type's `public:`
    # block are not members and are skipped. When the type has no declaration
    # of its own the pended pre-index writes answer instead. Declaration order
    # IS member order: declMoveChildToEnd places
    # each member in the last member slot as it is first edged.
    declMemberList: function {:this ownerTid: u64 names: List u64 tids: List u64} is {
        od9: this.declIdOfType typeId: ownerTid
        if od9 == 0 then {
            this.declPendRows parentTypeId: ownerTid :names :tids
            return
        }
        kids9: (List u64)
        raw9: (List u64)
        {
            oo9: this.decls.get key: od9
            match (
                oo9
            ) case some then {
                with cit9: oo9.children.iterate do for c9: cit9 loop {
                    kids9.append c9.declId
                    raw9.append c9.nameId.u64
                }
            } case none then null
        }
        i9: u64
        n9: kids9.length
        for i9 < n9 loop {
            isMem9: false
            mt9: u64
            {
                ko9: this.decls.get key: (kids9.get i: i9)
                match (
                    ko9
                ) case some then {
                    if ko9.kind.fieldDecl then isMem9 = true
                    if ko9.kind.methodDecl then isMem9 = true
                    if ko9.kind.paramDecl then isMem9 = true
                    if ko9.kind.armDecl then isMem9 = true
                    mt9 = ko9.typeId
                } case none then null
            }
            if isMem9 when mt9 > 0 then {
                names.append (raw9.get i: i9)
                tids.append mt9
            }
            i9 = i9 + 1
        }
    }

    # declChildRows -- every child of the type's own declaration that carries a
    # type, in declaration order: the child names (pool ids) and their types.
    # Unlike declMemberList this applies no kind filter, so a unit's definitions
    # come out alongside a type's members -- the SQL dumps want the whole
    # namespace a declaration describes. `typeId > 0` is the only filter it
    # needs: an untyped child (a re-exported generic param, a `public:` block)
    # never had a child edge either. As in declMemberList, a type with no
    # declaration of its own answers from the pended pre-index writes.
    declChildRows: function {:this ownerTid: u64 names: List u64 tids: List u64} is {
        od9: this.declIdOfType typeId: ownerTid
        if od9 == 0 then {
            this.declPendRows parentTypeId: ownerTid :names :tids
            return
        }
        kids9: (List u64)
        raw9: (List u64)
        {
            oo9: this.decls.get key: od9
            match (
                oo9
            ) case some then {
                with cit9: oo9.children.iterate do for c9: cit9 loop {
                    kids9.append c9.declId
                    raw9.append c9.nameId.u64
                }
            } case none then null
        }
        i9: u64
        n9: kids9.length
        for i9 < n9 loop {
            mt9: u64
            {
                ko9: this.decls.get key: (kids9.get i: i9)
                match (
                    ko9
                ) case some then {
                    mt9 = ko9.typeId
                } case none then null
            }
            if mt9 > 0 then {
                names.append (raw9.get i: i9)
                tids.append mt9
            }
            i9 = i9 + 1
        }
    }

    # declAllMemberRows -- every (owner type, child name, child type) triple the
    # declaration tree describes, owners in ascending tid order. The
    # whole-program form of declChildRows, for the callers that visit every
    # member in the program rather than one owner's. A tid with no declaration
    # of its own contributes nothing and is skipped without asking
    # declChildRows, so its edge fallback stays a signal about the pre-index
    # window rather than noise from this walk. lastTid is the registry's
    # nextTypeId, which ZTyping cannot reach on its own.
    declAllMemberRows: function {
        :this
        lastTid: u64
        owners: List u64
        names: List u64
        tids: List u64
    } is {
        t9: u64
        for t9 < lastTid loop {
            if (this.declIdOfType typeId: t9) > 0 then {
                nms9: (List u64)
                tds9: (List u64)
                this.declChildRows ownerTid: t9 names: nms9 tids: tds9
                i9: u64
                n9: nms9.length
                for i9 < n9 loop {
                    ov9: t9
                    owners.append ov9
                    names.append (nms9.get i: i9)
                    tids.append (tds9.get i: i9)
                    i9 = i9 + 1
                }
            }
            t9 = t9 + 1
        }
    }

    # declMemberCount -- how many members the type's declaration carries: the
    # declaration-side form of childCount. Routed through declMemberList so the
    # two can never disagree about what counts as a member.
    declMemberCount: function {:this ownerTid: u64} out u64 is {
        nms9: (List u64)
        tds9: (List u64)
        this.declMemberList :ownerTid names: nms9 tids: tds9
        return nms9.length
    }

    # declHasMemberId -- does the type that minted `parentTypeId` declare a
    # typed member `nameId`? The declaration-side form of hasChildId.
    declHasMemberId: function {:this parentTypeId: u64 nameId: u64} out bool is {
        n329: nameId.u32.or d: 0
        if n329 == 0 then return false
        return (this.declTypedMemberIdOf :parentTypeId nameId: n329) > 0
    }

    # declMemberIdOf -- the declaration of member `nameId` under the type
    # `parentTypeId` minted; 0 when that type has no declaration of its own or
    # the member is not declared.
    declMemberIdOf: function {:this parentTypeId: u64 nameId: u32} out u64 is {
        od9: this.declIdOfType typeId: parentTypeId
        if od9 == 0 then return 0
        return (this.declFindChild parentDeclId: od9 :nameId)
    }

    # declTypedMemberIdOf -- the declaration of member `nameId` under the type
    # `parentTypeId` minted, but only when that declaration carries a type; 0
    # otherwise. The narrowing is what lets a member DeclId serve as the
    # identity of a (parent, name) pair: a declaration carrying no type was
    # never a member anything could name.
    declTypedMemberIdOf: function {:this parentTypeId: u64 nameId: u32} out u64 is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9 == 0 then return 0
        t9: u64
        {
            mo9: this.decls.get key: md9
            match (
                mo9
            ) case some then {
                t9 = mo9.typeId
            } case none then null
        }
        if t9 == 0 then return 0
        return md9
    }

    # --- children table ---

    # setMemberType -- record the type of member `nameId` on `parentTypeId`:
    # ensure the member's declaration, stamp the type onto it, and on first
    # sight position it in the owner's last member slot, so declaration order
    # is built as member order rather than corrected afterwards.
    setMemberType: function {:this parentTypeId: u64 nameId: u64 childTypeId: u64} is {
        n329: nameId.u32.or d: 0
        # first sight is "the declaration does not carry a type yet". It also
        # reads true for a unit's `public:` pseudo-member, which already has
        # one; that costs nothing, because declMoveChildToEnd rotates member
        # slots only and a publicNs child is not among them.
        first9: false
        if n329 > 0 then first9 = (this.declTypedMemberIdOf :parentTypeId nameId: n329) == 0
        # declSetMemberType can be what CREATES the member declaration, so the
        # position is fixed after it, not before
        this.declSetMemberType :parentTypeId :nameId typeId: childTypeId
        if first9 then {
            od9: this.declIdOfType typeId: parentTypeId
            if od9 > 0 then this.declMoveChildToEnd parentDeclId: od9 nameId: n329
        }
    }

    # childOf -- the type of member `name` on `parentTypeId`, by text.
    childOf: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} out optionval u64 is {
        nid9: (pool.find s: name).u64
        if nid9 == 0 then return (optionval.none u64)
        return (this.childOfId :parentTypeId nameId: nid9)
    }

    # childOfId -- the type of member `nameId` on `parentTypeId`. The member's
    # DECLARATION is the source of truth: a declared member with no type reads
    # as absent. A member with no declaration at all falls back to the pended
    # pre-index writes.
    childOfId: function {:this parentTypeId: u64 nameId: u64} out optionval u64 is {
        n32: nameId.u32.or d: 0
        if n32 == 0 then return (optionval.none u64)
        od9: this.declIdOfType typeId: parentTypeId
        md9: u64
        if od9 > 0 then md9 = this.declFindChild parentDeclId: od9 nameId: n32
        if md9 > 0 then {
            t9: u64
            {
                mo9: this.decls.get key: md9
                match (
                    mo9
                ) case some then {
                    t9 = mo9.typeId
                } case none then null
            }
            if t9 == 0 then return (optionval.none u64)
            return (optionval.some t9)
        }
        # the member is not declared, so a write held for the pre-index window
        # is the only source.
        pv9: this.declPendMemberType :parentTypeId :nameId
        if pv9 == 0 then return (optionval.none u64)
        return (optionval.some pv9)
    }

    # --- bool sidecars (private / lock-field / lock-arm) ---

    # setAliasInternalName / aliasInternalNameOf -- per dotted-path-node record
    # of the internal member an external access resolved to through a public
    # alias; the emitter reads it to emit the internal C name.
    setAliasInternalName: function {:this nodeid: u64 internalName: StringView} is {
        v9: internalName.string
        this.aliasInternalName.set key: nodeid value: v9
    }

    aliasInternalNameOf: function {:this nodeid: u64} out String is {
        r9: this.aliasInternalName.get key: nodeid
        match (
            r9
        ) case some then {
            return r9.copy
        } case none then {
            return "".string
        }
    }

    # setChildGrantsPrivateId -- mark a field edge as one whose declared type
    # was a `.private` handle, so reads through it are private-capable.
    setChildGrantsPrivateId: function {:this parentTypeId: u64 nameId: u64} is {
        md8: this.declMemberIdOf :parentTypeId nameId: nameId.u32.orPanic
        if md8 > 0 then {
            do8: this.decls.get key: md8
            match (
                do8
            ) case some then {
                do8.grantsPrivate = true
            } case none then null
        }
    }

    markAsConstClone: function {:this typeId: u64} is {
        tk: typeId
        mv2: true
        this.asConstClone.set key: tk value: mv2
    }

    isAsConstClone: function {:this typeId: u64} out bool is {
        tk2: typeId
        r: this.asConstClone.get key: tk2
        match (
            r
        ) case some then {
            return r
        } case none then {
            return false
        }
    }

    setChildLockField: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} is {
        nid8: pool.find s: name
        if nid8 > 0 then {
            od8: this.declIdOfType typeId: parentTypeId
            if od8 > 0 then {
                md8: this.declFindChild parentDeclId: od8 nameId: nid8
                if md8 > 0 then {
                    do8: this.decls.get key: od8
                    match (
                        do8
                    ) case some then {
                        do8.lockFieldDecl = md8
                    } case none then null
                }
            }
        }
    }

    setChildFnptrField: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} is {
        nid8: pool.find s: name
        if nid8 > 0 then {
            md8: this.declMemberIdOf :parentTypeId nameId: nid8
            if md8 > 0 then {
                do8: this.decls.get key: md8
                match (
                    do8
                ) case some then {
                    do8.fnptrField = true
                } case none then null
            }
        }
    }

    # --- default sidecar ---

    # setDefaultLiteral -- a literal default. `node` is the default
    # expression's AST node, which the declaration carries the way a unit
    # constant does (its value is re-rendered from the node, never stored).
    setDefaultLiteral: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView node: u32} is {
        this.declSetDefault :parentTypeId :pool :name value: (DefaultVal.literal node)
    }

    # declSetDefault -- record a member declaration's default value; a no-op
    # when the owner type has no declaration (a monomorphisation) or the
    # member is not a declared one.
    declSetDefault: function {:this parentTypeId: u64 pool: zast.StringPool name: StringView value: DefaultVal} is {
        nid8: pool.find s: name
        if nid8 == 0 then return
        md8: this.declMemberIdOf :parentTypeId nameId: nid8
        if md8 == 0 then return
        do8: this.decls.get key: md8
        match (
            do8
        ) case some then {
            dv8: value
            do8.defaultVal = dv8
        } case none then null
    }

    # setDefaultFunction -- a default naming a function; `targetDecl` is that
    # function's declaration (0 when it resolved to no declaration).
    setDefaultFunction: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView targetDecl: u64} is {
        this.declSetDefault :parentTypeId :pool :name value: (DefaultVal.func targetDecl)
    }

    # setDefaultVariantArm -- a default naming an arm of the member's own
    # type; `targetDecl` is that arm's declaration (0 when it resolved to no
    # declaration).
    setDefaultVariantArm: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView targetDecl: u64} is {
        this.declSetDefault :parentTypeId :pool :name value: (DefaultVal.arm targetDecl)
    }

    # declDefaultText -- a member's default as display text, "" when it has
    # none. A literal renders as its expression nodeid (the caller needs an Ast
    # to re-render it); a function or arm renders as its target's declared name.
    declDefaultText: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} out String is {
        nid9: pool.find s: name
        if nid9 == 0 then return "".string
        dv9: this.declDefaultOfId :parentTypeId nameId: nid9
        {
            dl9: dv9
            if dl9.literal then return "literal node \{dl9}"
        }
        tgt9: u64
        {
            df9: dv9
            if df9.func then tgt9 = df9
        }
        isArm9: false
        {
            da9: dv9
            if da9.arm then {
                tgt9 = da9
                isArm9 = true
            }
        }
        if tgt9 == 0 then return "".string
        nm9: u32
        {
            to9: this.decls.get key: tgt9
            match (
                to9
            ) case some then {
                nm9 = to9.name
            } case none then null
        }
        tx9: zast.poolTextCopy :pool ref: nm9
        if isArm9 then return "arm \{tx9}"
        return "func \{tx9}"
    }

    # --- ownership sidecar ---

    setChildOwnership: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView ownership: ztypes.zparamownership} is {
        nid8: pool.find s: name
        if nid8 > 0 then {
            md8: this.declMemberIdOf :parentTypeId nameId: nid8
            if md8 > 0 then {
                do8: this.decls.get key: md8
                match (
                    do8
                ) case some then {
                    oc8: ownership
                    do8.ownership = oc8
                } case none then null
            }
        }
    }

    # setChildOwnershipId -- the id-keyed form of setChildOwnership.
    setChildOwnershipId: function {:this parentTypeId: u64 nameId: u64 ownership: ztypes.zparamownership} is {
        md8: this.declMemberIdOf :parentTypeId nameId: nameId.u32.orPanic
        if md8 > 0 then {
            do8: this.decls.get key: md8
            match (
                do8
            ) case some then {
                oc8: ownership
                do8.ownership = oc8
            } case none then null
        }
    }

    # declOwnershipText -- a member's ownership as display text, "none" when
    # it has none.
    declOwnershipText: function {:this pool: zast.StringPool parentTypeId: u64 name: StringView} out String is {
        nid9: pool.find s: name
        if nid9 == 0 then return "none".string
        r9: this.declOwnershipOfId :parentTypeId nameId: nid9
        match (
            r9
        ) case some then {
            return (ztypes.zparamownershipName r9)
        } case none then {
            return "none".string
        }
    }

    # --- generic args ---

    hasGenericArgNamed: function {:this parentTypeId: u64 paramName: StringView} out bool is {
        iter: this.typeGenericArg.iterate
        for row: iter loop {
            if row.parentTypeId == parentTypeId then {
                if row.paramName.stringview == paramName then return true
            }
        }
        return false
    }

    setGenericArg: function {:this pool: zast.StringPool parentTypeId: u64 paramName: StringView argTypeId: u64} is {
        present: this.hasGenericArgNamed :parentTypeId :paramName
        if present == false then {
            pos: this.typeGenericArg.length
            this.typeGenericArg.append (ZTypeGenericArg
                :parentTypeId
                paramName: paramName.string
                position: pos
            )
        }
        key9: (parentTypeId * 4294967296) + (pool.find s: paramName).u64
        this.genericArgTypeBy.set key: key9 value: argTypeId
    }

    genericArgOf: function {:this pool: zast.StringPool parentTypeId: u64 paramName: StringView} out optionval u64 is {
        key9: (parentTypeId * 4294967296) + (pool.find s: paramName).u64
        r: this.genericArgTypeBy.get key: key9
        match (
            r
        ) case some then {
            return (optionval.some r)
        } case none then {
            return (optionval.none u64)
        }
    }

    hasGenericArgs: function {:this parentTypeId: u64} out bool is {
        iter: this.typeGenericArg.iterate
        for row: iter loop {
            if row.parentTypeId == parentTypeId then return true
        }
        return false
    }
}

# construct an empty ZTyping, pre-sizing its tables for roughly
# `nodeEst` nodes.
newTyping: function {nodeEst: 0.u64} out ZTyping is {
    return (ZTyping
        synthNodes: (List SynthNode)
        nextSynthNodeId: 0x40000000
        nextTempId: 0
        synthLabel: "".string
        currentThisName: "".string
        lastLockParamRoot: "".string
        fnBodyDiverges: (Map u64 value: bool)
        funcReturnsBorrow: (Map u64 value: bool)
        currentReturnsBorrow: false
        pendingBorrowPath: (List String)
        pendingBorrowShared: false
        walkedMethodOwners: (Map String value: bool)
        monoNodeType: (Map u64 value: u64)
        monoParamSubst: (Map u64 value: u64)
        curMonoStamp: 0
        curMonoFnTid: 0
        mainMemberIndex: (Map String value: u64)
        mainMemberUnit: "".string
        builtinTidMemo: (Map u64 value: u64)
        typeGenericArg: (List ZTypeGenericArg)
        renameSeen: false
        privacySeen: false
        asConstClone: (Map u64 value: bool)
        generatorWrapper: (Map u64 value: bool)
        typeofShell: (Map u64 value: u32)
        noStampNode: (Map u64 value: bool)
        fnHasBody: (Map u64 value: bool)
        inAssignTarget: false
        sigGenericDecl: 0
        inContainmentEdge: false
        suppressParamStamps: false
        suppressBareCtor: false
        suppressFnAutoCall: false
        typedefBaseName: (Map u64 value: String)
        typedefBaseTid: (Map u64 value: u64)
        protocolThisContext: (Map String value: String)
        mainDefIsReftype: (Map String value: bool)
        dpTaggedParent: (Map u64 value: u64)
        dpArmPredicate: (Map u64 value: u64)
        dpTagRead: (Map u64 value: u64)
        tagAccessorName: (Map u64 value: String)
        tagAccessorTid: (Map u64 value: u64)
        postGuardName: (Map u64 value: String)
        postGuardRecv: (Map u64 value: String)
        postGuardTid: (Map u64 value: u64)
        postGuardArm: (Map u64 value: String)
        fullMainUnit: "".string
        pendingCustomTag: (Map u64 value: String)
        pendingCustomTagNode: (Map u64 value: u64)
        pendingDefaultOwner: (Map u64 value: u64)
        pendingDefaultId: (Map u64 value: u64)
        pendingDefaultName: (Map u64 value: String)
        constructedTypes: (Map u64 value: bool)
        collectionChildrenBuilt: (Map u64 value: bool)
        pendingUnitWalk: (List PendingUnitWalk)
        unitMonoWalksPending: (Map u64 value: bool)
        argDisposition: (Map u64 value: ztypes.zparamownership)
        genericArgTypeBy: (Map u64 value: u64)
        callGenericBinding: (Map u64 value: u64)
        # measured self-compile: ~0.6 stamps/node -- capacity nodeEst
        # holds 2/3*nodeEst entries before the first grow
        nodeType: (Map u64 value: u64 capacity: nodeEst)
        nodeLiteralBase: (Map u64 value: ztypes.numbase)
        callKind: (Map u64 value: zast.callkind)
        atomVariableId: (Map u64 value: u64 capacity: nodeEst / 4)
        aliasInternalName: (Map u64 value: String)
        implicitCreate: (Map u64 value: u64)
        variableZtype: (Map u64 value: u64)
        variableOwnership: (Map u64 value: ztypes.zownership)
        variableOrigin: (Map u64 value: bool)
        variableIsPrivate: (Map u64 value: bool)
        variableBorrowOrigin: (Map u64 value: String)
        variableSynthOrigin: (Map u64 value: String)
        funcReturnNode: (Map u64 value: u64)
        defVariableId: (Map u64 value: u64)
        withOwnership: (Map u64 value: ztypes.zownership)
        nodeConst: (List NodeConstRow)
        ifTakenVars: (List TakenVarRow)
        caseSubjectTakenArms: (List NodeNameRow)
        conformance: (List ztypes.ZConformance)
        monoTypes: (List MonoRow)
        preludeUnit: (Map String value: String)
        definedKeys: (Set String)
        resolving: (Set String)
        defNodeIndexBuilt: false
        systemUnitTid: 0
        literalIntShellId: 0
        literalFloatShellId: 0
        nativeLinkTargetsDone: false
        pendingTyperef: (Map u64 value: String)
        pendingTyperefUnit: (Map u64 value: String)
        unitTypesById: (Map u64 value: u64)
        decls: (Map u64 value: Decl)
        declByTypeId: (Map u64 value: u64)
        unitRootByName: (Map String value: u64)
        refDecl: (Map u64 value: u64)
        declProxyTids: (List u64)
        declProxyUnits: (List String)
        pendParent: (List u64)
        pendName: (List u64)
        pendType: (List u64)
        errors: (List zast.ErrorData)
        currentReturnTypeId: 0
        isError: false)
}

# a bool rendered as "true" or "false".
boolText: function {b: bool} out String is {
    match (
        b
    ) case true then {
        return "true".string
    } case false then {
        return "false".string
    }
}

# Render an (optionval u64) as its value text or "none".
optU64Text: function {o: optionval u64} out String is {
    match (
        o
    ) case some then {
        return "\{o}"
    } case none then {
        return "none".string
    }
}

# --- smoke harness ---
# Every name-bearing query goes through a helper that takes the name as a
# param (a string literal cannot be nested inside an interpolation), and the
# raw Map.get stamp reads are matched inline (the get result type is the
# native Map option, distinct from the methods' (optionval t: u64)).

# standalone entry point for the ztyping smoke tests.
main: function is {
    reg: ztypes.newRegistry
    # id 0 is the no-type sentinel, exactly as typecheck seeds it: a member's
    # metadata reaches its declaration through the owner's type id, and 0
    # never links to one.
    reg.newType name: "notype" typetype: ztypes.ztypetype.nullType
    tPoint: reg.newType name: "point" typetype: ztypes.ztypetype.recordType
    tInt: reg.newType name: "i64" typetype: ztypes.ztypetype.recordType
    tStr: reg.newType name: "String" typetype: ztypes.ztypetype.classType
    tList: reg.newType name: "List" typetype: ztypes.ztypetype.classType
    pid: tPoint
    lid: tList

    ty: newTyping
    pool9: zast.StringPool.create

    # the per-member metadata setters record onto member DECLARATIONS, so the
    # smoke declares the type and its fields the way the def indexer would.
    # Without this the sidecar section reads back empty.
    pDecl9: ty.declNew name: (pool9.set s: "point") parent: 0 kind: declkind.typeDecl node: 0
    ty.declSetType declId: pDecl9 typeId: pid
    ty.declNew name: (pool9.set s: "x") parent: pDecl9 kind: declkind.fieldDecl node: 0
    ty.declNew name: (pool9.set s: "y") parent: pDecl9 kind: declkind.fieldDecl node: 0
    ty.declNew name: (pool9.set s: "label") parent: pDecl9 kind: declkind.fieldDecl node: 0
    # a function / arm default names its target by DeclId, so the targets have
    # to be declared for the defaults below to resolve to anything
    mkDecl9: ty.declNew name: (pool9.set s: "makeY") parent: 0 kind: declkind.funcDecl node: 0
    armDecl9: ty.declNew name: (pool9.set s: "none") parent: 0 kind: declkind.armDecl node: 0

    print "=== children ==="
    ty.setMemberType parentTypeId: pid nameId: (pool9.set s: "x").u64 childTypeId: tInt
    ty.setMemberType parentTypeId: pid nameId: (pool9.set s: "y").u64 childTypeId: tInt
    ty.setMemberType parentTypeId: pid nameId: (pool9.set s: "label").u64 childTypeId: tStr
    ty.setMemberType parentTypeId: pid nameId: (pool9.set s: "x").u64 childTypeId: tInt

    print "memberCount point -> \{ty.declMemberCount ownerTid: pid}"
    smokeHasChild pool: pool9 :ty :pid name: "x"
    smokeHasChild pool: pool9 :ty :pid name: "z"
    smokeChildOf pool: pool9 :ty :pid name: "x"
    smokeChildOf pool: pool9 :ty :pid name: "label"
    smokeChildOf pool: pool9 :ty :pid name: "z"
    dumpChildren :ty pool: pool9 parentTypeId: pid

    print "=== sidecars ==="
    ty.setChildLockField pool: pool9 parentTypeId: pid name: "y"
    ty.setDefaultFunction pool: pool9 parentTypeId: pid name: "y" targetDecl: mkDecl9
    (ty.setDefaultVariantArm
        pool: pool9
        parentTypeId: pid
        name: "label"
        targetDecl: armDecl9
    )
    (ty.setChildOwnership
        pool: pool9
        parentTypeId: pid
        name: "x"
        ownership: ztypes.zparamownership.takeMode
    )
    (ty.setChildOwnership
        pool: pool9
        parentTypeId: pid
        name: "y"
        ownership: ztypes.zparamownership.borrowMode
    )

    smokeIsLockField pool: pool9 :ty :pid name: "y"
    smokeDefault pool: pool9 :ty :pid name: "x"
    smokeDefault pool: pool9 :ty :pid name: "y"
    smokeDefault pool: pool9 :ty :pid name: "label"
    smokeOwn pool: pool9 :ty :pid name: "x"
    smokeOwn pool: pool9 :ty :pid name: "y"
    smokeOwn pool: pool9 :ty :pid name: "label"

    print "=== generic args ==="
    ty.setGenericArg pool: pool9 parentTypeId: lid paramName: "of" argTypeId: tInt
    ty.setGenericArg pool: pool9 parentTypeId: lid paramName: "of" argTypeId: tStr
    smokeGenericArg pool: pool9 :ty pid: lid name: "of"
    print "hasGenericArgs List -> \{boolText (ty.hasGenericArgs parentTypeId: lid)}"
    print "hasGenericArgs point -> \{boolText (ty.hasGenericArgs parentTypeId: pid)}"

    print "=== node stamps ==="
    stagedStr: tStr
    ty.nodeType.set key: 100 value: stagedStr
    nt: ty.nodeType.get key: 100
    match (
        nt
    ) case some then {
        print "nodeType[100] -> \{nt}"
    } case none then {
        print "nodeType[100] -> none"
    }
    ty.callKind.set key: 101 value: zast.callkind.recordCreate
    ck: ty.callKind.get key: 101
    match (
        ck
    ) case some then {
        print "callKind[101] -> \{zast.callkindname ck}"
    } case none then {
        print "callKind[101] -> none"
    }
    ty.withOwnership.set key: 102 value: ztypes.zownership.borrowed
    wo: ty.withOwnership.get key: 102
    match (
        wo
    ) case some then {
        print "withOwnership[102] -> \{ztypes.zownershipName wo}"
    } case none then {
        print "withOwnership[102] -> none"
    }
    ty.atomVariableId.set key: 103 value: 42
    av: ty.atomVariableId.get key: 103
    match (
        av
    ) case some then {
        print "atomVariableId[103] -> \{av}"
    } case none then {
        print "atomVariableId[103] -> none"
    }
    ty.nodeLiteralBase.set key: 104 value: ztypes.numbase.nonDec
    nb: ty.nodeLiteralBase.get key: 104
    match (
        nb
    ) case some then {
        print "nodeLiteralBase[104] -> \{ztypes.numbaseName nb}"
    } case none then {
        print "nodeLiteralBase[104] -> none"
    }

    print "=== node tables ==="
    k0: ztypes.makeIntConst 1024.i64
    ty.nodeConst.append (NodeConstRow nodeid: 200 value: k0)
    dumpNodeConst :ty
    ty.ifTakenVars.append (TakenVarRow nodeid: 300 name: "tmp".string typeId: (optionval.some tStr))
    ty.ifTakenVars.append (TakenVarRow
        nodeid: 300
        name: "scratch".string
        typeId: (optionval.none u64)
    )
    dumpTakenVars :ty
    ty.caseSubjectTakenArms.append (NodeNameRow nodeid: 400 name: "ok".string)
    ty.caseSubjectTakenArms.append (NodeNameRow nodeid: 400 name: "err".string)
    print "  takenArms count=\{ty.caseSubjectTakenArms.length}"

    print "=== aggregates ==="
    cf: reg.newConformance implTypeId: pid specTypeId: lid label: "drawable" isFacet: false
    ty.conformance.append cf
    dumpConformance :ty
    ty.monoTypes.append (MonoRow monoTypeId: tList astNodeId: 600)
    print "monoTypes count -> \{ty.monoTypes.length}"
    print "isError -> \{boolText ty.isError}"
}

# smoke-test: print whether type `pid` has a child named `name`.
smokeHasChild: function {pool: zast.StringPool ty: ZTyping pid: u64 name: StringView} is {
    nid9: pool.find s: name
    b: false
    if nid9 > 0 then b = ty.declHasMemberId parentTypeId: pid nameId: nid9.u64
    print "hasMember point.\{name} -> \{boolText b}"
}

# smoke-test: print the child type id of `pid`'s member `name`.
smokeChildOf: function {pool: zast.StringPool ty: ZTyping pid: u64 name: StringView} is {
    r: ty.childOf :pool parentTypeId: pid :name
    print "childOf point.\{name} -> \{optU64Text r}"
}

# smoke-test: print whether member `name` of `pid` is a lock field.
smokeIsLockField: function {pool: zast.StringPool ty: ZTyping pid: u64 name: StringView} is {
    b: ty.declIsLockField :pool parentTypeId: pid :name
    print "isLockField point.\{name} -> \{boolText b}"
}

# smoke-test: print the default value of member `name` of `pid`.
smokeDefault: function {pool: zast.StringPool ty: ZTyping pid: u64 name: StringView} is {
    d: ty.declDefaultText :pool parentTypeId: pid :name
    print "default point.\{name} -> \{d}"
}

# smoke-test: print the ownership of member `name` of `pid`.
smokeOwn: function {pool: zast.StringPool ty: ZTyping pid: u64 name: StringView} is {
    o: ty.declOwnershipText :pool parentTypeId: pid :name
    print "ownership point.\{name} -> \{o}"
}

# smoke-test: print the generic-argument bound for `name` on `pid`.
smokeGenericArg: function {pool: zast.StringPool ty: ZTyping pid: u64 name: StringView} is {
    r: ty.genericArgOf :pool parentTypeId: pid paramName: name
    print "genericArg List.\{name} -> \{optU64Text r}"
}

# smoke-test: print every declared member of parent type `parentTypeId`.
dumpChildren: function {ty: ZTyping pool: zast.StringPool parentTypeId: u64} is {
    nms9: (List u64)
    tds9: (List u64)
    ty.declMemberList ownerTid: parentTypeId names: nms9 tids: tds9
    i9: u64
    n9: nms9.length
    for i9 < n9 loop {
        rnB9: pool.texts.get i: ((nms9.get i: i9) - 1)
        print "  child \{i9} \{rnB9} -> \{tds9.get i: i9}"
        i9 = i9 + 1
    }
}

# smoke-test: print the node-constant table.
dumpNodeConst: function {ty: ZTyping} is {
    iter: ty.nodeConst.iterate
    for row: iter loop {
        print "  const node=\{row.nodeid} kind=\{ztypes.zconstkindName row.value.kind} ival=\{row.value.ival}"
    }
}

# smoke-test: print the taken-variable overlay.
dumpTakenVars: function {ty: ZTyping} is {
    iter: ty.ifTakenVars.iterate
    for row: iter loop {
        print "  ifTaken node=\{row.nodeid} name=\{row.name} type=\{optU64Text row.typeId}"
    }
}

# smoke-test: print the recorded protocol conformances.
dumpConformance: function {ty: ZTyping} is {
    iter: ty.conformance.iterate
    for row: iter loop {
        print "  conf id=\{row.conformanceId} impl=\{row.implTypeId} spec=\{row.specTypeId} label=\{row.label}"
    }
}
