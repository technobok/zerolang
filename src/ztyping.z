# ZTyping -- the typecheck-output container.
#
# The parser produces a frozen zast.Program; the type checker consumes it
# and produces a ZTyping: every typecheck-derived datum the downstream
# consumers (emitter, SQL dumper) read. This is the data module, separate
# from the producer, mirroring the zast / zparser split. References ztypes.z
# for ZType + the shared enums (a multi-unit reference, like zparser -> zast).
#
# Representation is id-first and relational: cross-type references are
# stored as u64 type ids (resolved through the registry by the producer),
# and the per-node stamps live in id-keyed Maps. A type's members live on
# its declaration -- the Decl tree is the single member index -- and their
# names are shared Ast.names pool ids. Every mutator runs on :this -- a
# container that owns all of its state -- so mutations persist.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :PendingUnitWalk
    :SynthNode
    :Decl
    :defaultval
    :foldedbranch
    :declchild
    :declkind
    :declkindName
    :ZTyping
    :newTyping
    :armside
    :armSideOfName
    :armSuffixSideOf
    :nodeTypeAt
    :nodeTypeSet
    :main
}

ZType: ztypes.ZType
Node: zast.Node

# --- relational row carriers ---

# A declaration's name index switches from a linear child scan to the byName
# map past this many children (no owned key, no hash below it).
bucketScanMax: 16.u64

# One edge of the generic-args table: a (parent, param-name) link. The
# mutable arg-type id lives in genericArgTypeBy, keyed by a
# (parentTypeId, paramNameId) composite.
ZTypeGenericArg: class {
    parentTypeId: ztypes.tid
    paramName: String
    position: u64
}

# The clause a constant fold selected for an `if`. `known` false means the
# conditions did not all fold, so a runtime `if` must be emitted; `known` true
# with `stmt` 0 means every condition was false and there was no else clause,
# so nothing is emitted at all.
foldedbranch: record {
    known: bool
    stmt: zast.nodeid
}

# One typecheck-synthesised AST row for the dump: a node minted during the
# body walk (call-arg hoist temps) that the parsed-program walk cannot reach.
SynthNode: class {
    nodeid: u32
    kind: String
    label: String
    lineno: u32
    colno: u32
}

# PendingUnitWalk -- a generic-unit mono's cloned method awaiting its lazy
# first-use walk (the reference clones and checks bodies at the use site,
# so the clone scopes parent under the using function).
PendingUnitWalk: class {
    monoId: ztypes.tid
    monoName: String
    qualified: String
    gpName: String
    argId: u64
    fn: Node
}

# --- declaration tree ---

# The kind of declaration a Decl records: which definition shape the
# indexer saw. Resolution semantics stay with the readers (a reexport
# shares its target's type id; a publicNs holds the unit's exported
# name -> declaration edges).
declkind: variant {
    unitDecl: null
    funcDecl: null
    typeDecl: null
    constDecl: null
    dataDecl: null
    paramDecl: null
    fieldDecl: null
    methodDecl: null
    armDecl: null
    reexportDecl: null
    publicNs: null
} as { tag: u8.tag }

# declkindName -- a declaration kind's dump/debug text.
declkindName: function {k: declkind} out String is {
    match (
        k
    ) case unitDecl then {
        return "unit".string
    } case funcDecl then {
        return "function".string
    } case typeDecl then {
        return "type".string
    } case constDecl then {
        return "const".string
    } case dataDecl then {
        return "data".string
    } case paramDecl then {
        return "param".string
    } case fieldDecl then {
        return "field".string
    } case methodDecl then {
        return "method".string
    } case armDecl then {
        return "arm".string
    } case reexportDecl then {
        return "reexport".string
    } case publicNs then {
        return "publicns".string
    }
}

# one name -> child-declaration edge of a Decl's namespace.
declchild: record {
    nameId: zast.nameid
    declId: ztypes.declid
}

# defaultval -- a member's default value, de-hacking the childDefault string
# sentinels (`#function:`/`#variant:`). `literal` carries the default-expression
# nodeid (re-emitted verbatim); `function`/`arm` carry the target DeclId; `none`
# means no default.
defaultval: variant {
    none: null
    literal: u32
    func: ztypes.declid
    arm: ztypes.declid
} as { tag: u8.tag }

# One declaration: a named definition site in the program. `name` is the
# shared Ast.names pool id; `parent` the enclosing Decl (0 = a tree
# root); `node` the declaring namedoperation's AST nodeid (location via
# fsnoForNode); `typeId` the type this declaration minted (0 until one
# is); `children` the ordered namespace the declaration owns. Body-local
# variables are not Decls -- they keep the lexical variable-id system. On a
# MEMBER declaration `typeId` is the member's own type (what the tid-keyed
# child index records), not one it minted.
Decl: class {
    name: u32
    parent: ztypes.declid
    kind: declkind
    node: u32
    typeId: ztypes.tid
    # ownership -- a param member's binding mode (noneMode when unset); where a
    # param's lock status lives.
    ownership: ztypes.zparamownership
    # defaultVal -- a member's default value (none when unset). (Named
    # defaultVal, not default, which is a C keyword the emitter would not mangle.)
    defaultVal: defaultval
    # demand-resolution state for a unit-level definition: `resolving` is the
    # DFS grey mark (a reference that walks back into it is a cycle back-edge,
    # and uses the forward-decl id instead of re-descending), `defined` the
    # done mark. On the declaration itself, so the walk that finds the
    # definition also finds its state.
    resolving: bool
    defined: bool
    # grantsPrivate -- the field's declared type was a `.private` friend handle
    # (syntactic; not derivable from typeId).
    grantsPrivate: bool
    # fnptrField -- the member occupies a struct function-pointer slot: an
    # is-block function member of a record or class, or an as-block member of a
    # generic class. Where it was declared, not its kind, decides this.
    fnptrField: bool
    # lockFieldDecl -- on a TYPE decl, which member is the type's lock (0 = none).
    lockFieldDecl: u64
    children: (ListVal declchild)
    # derived nameId -> declId accelerator over `children`, backfilled when
    # the namespace outgrows a linear scan (bucketScanMax); not dumped
    byName: (MapVV u64 value: ztypes.declid)
}

# the typing side-tables: every typecheck stamp keyed by AST node id
# (types, monomorphisations, lock overlays) plus the declaration tree, kept
# separate from the frozen AST so the tree is never mutated.
ZTyping: class {
    # typecheck-synthesised AST rows, the per-run `_t` temp-name counter,
    # and the current `unit.def` dump label the body walk maintains.
    synthNodes: (List SynthNode)
    nextTempId: u64
    synthLabel: String
    currentThisName: String
    lastLockParamRoot: String

    # generic instantiations: refs recorded for the mono pass and
    # the minted instances, deduped by mono name (template_arg1[_arg2...]).
    # a generic template's syntactic body divergence (its last statement is a
    # return), recorded at resolution for the clone-scope synthesis.
    fnBodyDiverges: (MapVV u64 value: bool)
    # function types whose return carries the `.borrow` marker, recorded at
    # resolution; the body walk's auto-call coercion reads it to report the
    # receiver source path.
    funcReturnsBorrow: (MapVV u64 value: bool)
    # of those, the ones whose reference is READONLY (`out T.view`): the pin
    # they leave on the receiver is shared, so several may be live at once.
    funcReturnsView: (MapVV u64 value: bool)
    # function types whose return carries `.takex`: an OWNED result that pins
    # its non-owned sources for the binding's life. Not a borrow -- the binding
    # keeps its destructor -- so it is tracked apart from funcReturnsBorrow.
    funcReturnsTakex: (MapVV u64 value: bool)
    # the fn whose body is being walked declares a `.borrow` return: bare
    # field returns are its contract (the lock/borrow source outlives).
    currentReturnsBorrow: bool
    # the borrow source path a just-coerced BORROW-returning auto-call reported
    # (the reference's _pending_borrow_lock); consumed by the binding sites,
    # drained at statement and call boundaries.
    pendingBorrowPath: (List String)
    # the pending borrow is a RETURNED borrow (a `.borrow`-marked return): a
    # read-view of the source, so the binding's leaf lock is SHARED (the
    # container-view model) rather than the exclusive alias default.
    pendingBorrowShared: bool
    # the pending borrow came from an `out T.view` return, so the binding it
    # lands on is READONLY as well as pinned.
    pendingBorrowReadonly: bool
    # the pending pin came from an `out T.takex` return: the SOURCES are pinned
    # for the binding's life, but the binding itself stays OWNED -- it carries a
    # destructor and may be moved. Without this the pin would demote it to a
    # borrow, which is what `borrow`/`view` mean and `takex` does not.
    pendingBorrowOwned: bool
    # type names whose method bodies the walk has already visited (methods
    # body-check once, at the type's first body-walk reference).
    walkedMethodOwners: (MapVV u64 value: bool)
    # per-mono template stamps: (monoId << 32 | nodeid) -> tid, written by
    # the post-sweep instance walk when curMonoStamp is set; the emitter's
    # mono re-walks read these where the global table is param-suppressed.
    # monoParamSubst maps the CURRENT mono's generic-param tids to its args
    # (flat substitution at stamp time); live only during the instance walk.
    monoNodeType: (MapVV u64 value: ztypes.tid)
    monoParamSubst: (MapVV ztypes.tid value: ztypes.tid)
    curMonoStamp: u64
    curMonoFnTid: ztypes.tid
    # the unit whose members mainMemberIndex indexes (set once, when that
    # unit's body walk starts); demand walks in any other unit must not
    # consult the index -- its values index this unit's body list only
    mainMemberIndex: (MapVV u64 value: u64)
    mainMemberUnit: String

    # child-name id minting (ztyping-local id space)
    # base type name id (pool id) -> resolved builtin tid (currentUnit "");
    # an unresolved 0 is never stored so later resolution can still fill it
    builtinTidMemo: (MapVV u64 value: ztypes.tid)

    # one row per (generic parent, param name) link
    typeGenericArg: (List ZTypeGenericArg)

    # true once any public-interface rename exists (skips alias lookups otherwise)
    renameSeen: bool
    # true once any member has been marked private (gates cross-unit checks)
    privacySeen: bool
    asConstClone: (MapVV u64 value: bool)
    generatorWrapper: (MapVV u64 value: bool)
    typeofShell: (MapVV u64 value: u32)
    noStampNode: (MapVV u64 value: bool)
    # FUNCTION tid -> the definition carries a body (a bodyless spec is false)
    fnHasBody: (MapVV u64 value: bool)
    # a reassignment TARGET path is being checked (a write, not a read)
    inAssignTarget: bool
    # the generic template (its DeclId) whose signature is being
    # registered: its param names are not unit typerefs
    sigGenericDecl: ztypes.declid
    inContainmentEdge: bool
    suppressParamStamps: bool
    suppressBareCtor: bool
    suppressFnAutoCall: bool
    typedefBaseName: (MapVR u64 value: String)
    # a typedef wrapper's base type id, resolved structurally at declaration
    # (a parameterized base rides the spec trie, a bare atom the unit ladder)
    typedefBaseTid: (MapVV ztypes.tid value: ztypes.tid)
    # the conformer a protocol / facet's spec `this` binds to, keyed by
    # ztypes.memberKey (declaring unit id high, marker name id low) and valued
    # by the conformer's own name id. Keyed by the UNIT because a marker name
    # is only unique within one: a facet in a dependency must not inherit
    # another unit's conformer just because the names agree.
    protocolThisContext: (MapVV u64 value: u64)
    mainDefIsReftype: (MapVV u64 value: bool)
    dpTaggedParent: (MapVV u64 value: ztypes.tid)
    dpArmPredicate: (MapVV u64 value: ztypes.tid)
    dpTagRead: (MapVV u64 value: ztypes.tid)
    tagAccessorName: (MapVR u64 value: String)
    tagAccessorTid: (MapVV ztypes.tid value: ztypes.tid)
    postGuardName: (MapVR u64 value: String)
    # the subject's variable, beside its name: the emitter asks whether the
    # subject is a pointer receiver, and a name cannot answer that once locals
    # are named by id
    postGuardVarId: (MapVV u64 value: ztypes.vid)
    postGuardRecv: (MapVR u64 value: String)
    postGuardTid: (MapVV u64 value: ztypes.tid)
    postGuardArm: (MapVR u64 value: String)
    # the namespace unit a definition is being resolved INSIDE, and that
    # definition's own name. A namespace's members are children of its type id
    # rather than of the file unit's, and declareCanonicalType has no other way
    # to know: `defUnit` names the file. Set only while resolveNamespaceUnit
    # walks a member, and read only for that member's own name, so a demand
    # that fires mid-walk for some other definition is not captured.
    nsOwnerTid: ztypes.tid
    nsOwnerName: String
    nsOwnerDeclId: ztypes.declid
    nsOwnerUnit: String
    # whether that namespace is a hidden subunit. A subunit is read only
    # because its parent named it, so it is never declared surface and its
    # scope stops at itself: it may name its own definitions, its own
    # subunits, top-level units and core, but not its parent's.
    nsOwnerIsSubunit: bool
    pendingCustomTag: (MapVR u64 value: String)
    pendingCustomTagNode: (MapVV u64 value: u64)
    pendingDefaultOwner: (MapVV u64 value: u64)
    pendingDefaultId: (MapVV u64 value: u64)
    pendingDefaultName: (MapVR u64 value: String)
    constructedTypes: (MapVV u64 value: bool)
    collectionChildrenBuilt: (MapVV u64 value: bool)
    pendingUnitWalk: (List PendingUnitWalk)
    unitMonoWalksPending: (MapVV u64 value: bool)
    # per-call-argument disposition (take/lock/borrow); absent = valtype/none.
    # tooling-only; the emitter never reads it.
    argDisposition: (MapVV u64 value: ztypes.zparamownership)
    # generic arg-type id, keyed by (parentTypeId << 32 | paramNameId)
    genericArgTypeBy: (MapVV u64 value: u64)
    # inferred concrete tid per call, keyed by (callNodeid << 32 | paramNameId)
    callGenericBinding: (MapVV u64 value: u64)

    # per-binop operator resolution: the type that DECLARES the operator, after
    # the typedef chase and the Box unwrap, and the method it resolved to.
    # binopMethod is 0 where no declaration was found and the comparison fell
    # back to structural equality; binopOwner is the presence test, and it is
    # never 0. Keyed by nodeid.
    binopOwner: (MapVV u64 value: ztypes.tid)
    binopMethod: (MapVV u64 value: ztypes.tid)
    # the same two facts from the per-instance walk, in their own tables
    # because their key is a different thing: (monoId << 32 | nodeid), as
    # monoNodeType keys a type stamp. One template node resolves to a
    # different operator per instantiation, so the answers cannot share a
    # slot -- and they cannot share a TABLE with the nodeid-keyed pair either,
    # or the key would mean one thing or the other depending on who wrote it.
    monoBinopOwner: (MapVV u64 value: ztypes.tid)
    monoBinopMethod: (MapVV u64 value: ztypes.tid)

    # per-node single-valued stamps, indexed by nodeid - 1 (node ids are
    # minted dense 1..N, so the stamp IS the slot); 0 means unstamped
    nodeType: (ListVal ztypes.tid)
    callKind: (MapVV u64 value: zast.callkind)
    atomVariableId: (MapVV u64 value: ztypes.vid)
    # variable ids the body MUTATES. Recorded at the two ENFORCEMENT points --
    # `lockCallArg` whenever it takes a non-shared lock, and `checkWriteLock` --
    # so it answers the same question the lock rules do rather than guessing at
    # it a second time. `atomVariableId` cannot serve: it stamps an assignment
    # TARGET like any other use, so a read and a write look identical there.
    variableMutated: (MapVV ztypes.vid value: bool)
    # vid -> the binding's value was MOVED out (ownership transfer recorded at
    # the symtab's invalidate choke point); a moved local is not viewable
    variableMoved: (MapVV ztypes.vid value: bool)
    # dotted-path nodeid -> the internal member name a public alias resolved to
    aliasInternalName: (MapVR u64 value: String)
    implicitCreate: (MapVV u64 value: u64)
    variableZtype: (MapVV u64 value: u64)
    variableOwnership: (MapVV u64 value: ztypes.zownership)
    # variable origin kind: true = parameter, false = local (unit-level unstamped)
    variableOrigin: (MapVV u64 value: bool)
    variableIsPrivate: (MapVV u64 value: bool)
    variableBorrowOrigin: (MapVR u64 value: String)
    variableSynthOrigin: (MapVR u64 value: String)
    funcReturnNode: (MapVV u64 value: u64)
    defVariableId: (MapVV u64 value: ztypes.vid)

    # --- compile-time constant values ---
    # The value domain, keyed two ways. nodeConst answers "what does this
    # node evaluate to" for a use site; memberConst answers it for a named
    # definition, keyed exactly as setMemberType keys the TYPE channel so the
    # two cannot disagree about what a constant is. Both are sparse -- a few
    # dozen nodes out of a couple hundred thousand -- so a map, not the dense
    # ListVal nodeType uses.
    nodeConst: (MapVV u64 value: ztypes.cval)
    memberConst: (MapVV u64 value: ztypes.cval)
    # evaluation state per memberConst key: 0 unvisited, 1 evaluating, 2 done.
    # Constants are not written in dependency order, so the evaluator pulls
    # rather than pushes and this is its cycle guard.
    constEvalState: (MapVV u64 value: u8)
    # the svalKind payload pool; cval.strId indexes it 1-based (0 = none)
    constStrings: (List String)
    # ifexpr nodeid -> the clause the fold selected
    foldedBranch: (MapVV u64 value: foldedbranch)
    # the pending evaluation failure, recorded by the evaluator and rendered by
    # whichever caller REQUIRED a value. One slot, not a table: evaluation is a
    # synchronous recursive pull, so at most one is live, and the caller either
    # drains it or clears it before the next pull.
    constFail: ztypes.constfail

    # aggregate typecheck state
    conformance: (List ztypes.ZConformance)
    preludeUnit: (Map String value: String)
    # resolve every top-level definition of every unit, not only the ones a
    # use site demands: the tooling mode, so an error inside a definition
    # nothing references is still reported.
    eagerAll: bool

    # the target unit must declare a `main` (E0039). A BUILD needs an entry
    # point; `zc dump` INTROSPECTS a unit and does not, for the same reason
    # `--eager` does not -- neither is asking what a root reaches.
    requireMain: bool

    # what the build is FOR, threaded in from the driver so the `platform`
    # unit's constants describe this invocation rather than the file on disk.
    # ccPath is the RESOLVED compiler path (--cc > <target>-gcc > $CC > cc),
    # targetTriple the --target as given ("" for a native build).
    ccPath: String
    ccMode: String
    targetTriple: String
    # true once indexUnitDefs has populated the node finder; descent is gated
    # off before then (generator lowering runs pre-index).
    defNodeIndexBuilt: bool
    # Demand marks for the PRE-INDEX window only. Generator lowering resolves
    # system.Iterator / system.optionval before indexUnitDefs builds the unit
    # roots' children, so those definitions have no Decl to carry the mark yet.
    # Keyed by (unitNameId << 32) | defNameId -- an id pair, never a synthesized
    # name. Every post-index mark lives on the Decl itself.
    preIndexDefined: (SetVal u64)
    # Type ids whose `as {}` block strikes the compiler-provided `.copy` off
    # with `copy: null`. A valtype's default copy is its byte copy, so the
    # opt-out has no member to suppress -- it is a fact about the type.
    copyOptOut: (SetVal u64)
    # ordinalVariant -- a variant whose arms ALL carry no payload, mapped to its
    # arm count. Such a variant is an ORDINAL: nothing distinguishes one value
    # from another except which arm it is, so there is nothing for a tagged
    # struct to carry. The front end records the SHAPE, from the arms the author
    # wrote; what a backend does with it -- an integer, a C `bool` -- is the
    # backend's call.
    #
    # The tag STORAGE a variant declares (`tag: u8.tag`) is deliberately not
    # recorded here: no backend honours it for any variant today, so a rule that
    # consulted it would be the only one, and would read as settled policy when
    # it is not. It belongs here once the declared width decides the emitted one.
    ordinalVariant: (MapVV u64 value: u64)
    # sumPairFirstArm / sumPairSecondArm -- the two arm names of a 2-arm sum
    # type, as pool ids, in the order the author wrote them. Every 2-arm
    # `variant` and `union` is recorded, generic templates included, whatever
    # the arms carry -- so presence IS the question "is this tid a 2-arm sum".
    # The record states the ORDER; the falsy-first convention is what gives
    # arm 0 its meaning, and that meaning belongs to the reader.
    #
    # Recorded here rather than walked at use: the arm list is a member walk,
    # and forcing one at emission time demands members the program never asked
    # for -- which segfaults a demand-driven compile.
    sumPairFirstArm: (MapVV u64 value: u64)
    sumPairSecondArm: (MapVV u64 value: u64)
    # variantTagBase -- the NUMERIC type a tagged type's discriminator is stored
    # in, from its declaration (`tag: u8.tag`) or the spec's u8 default. Absent
    # for a data-sourced tag, whose constants set their own width.
    variantTagBase: (MapVV u64 value: u64)
    # memoized pseudo-shell ids for literal do-block break values: the optionval
    # instance over a literal payload keys off ONE shell per literal kind, not a
    # fresh mint per occurrence.
    systemUnitTid: ztypes.tid
    # the system unit's root DeclId, resolved once: the member probe below it
    # runs per reference, so it must not re-resolve the unit name each time
    systemUnitRoot: ztypes.declid
    # the canonical `null` tid, seeded with the other system types: an
    # out-less method's auto-call resolves to null, and every reader of
    # that stamp already treats it as the no-value type
    nullTypeId: u64
    # one-shot guard: the native link-target descend runs once per program
    nativeLinkTargetsDone: bool
    # type-ref node id -> base type name; resolved to its real type post-demand
    pendingTyperef: (MapVR u64 value: String)
    pendingTyperefUnit: (MapVR u64 value: String)
    unitTypesById: (MapVV u64 value: ztypes.tid)
    # --- declaration tree (parallel to the string-keyed def tables
    # above; readers migrate to Decls stage by stage) ---
    # every Decl row, indexed by DeclId - 1 (DeclIds are minted dense 1..N in
    # mint order and never removed, so the row IS the index)
    decls: (List Decl)
    # type id -> the declaration that minted it (first mint wins), so a member
    # setter reaches the owner's declaration without the type registry. A
    # monomorphisation is absent: it links to its template through the
    # registry, never through declSetType.
    declByTypeId: (MapVV u64 value: ztypes.declid)
    # bare unit name -> the unit's root DeclId (the root index)
    unitRootByName: (MapVV u64 value: ztypes.declid)
    # reference nodeid -> resolved DeclId (stamped by resolution)
    refDecl: (MapVV u64 value: ztypes.declid)
    # canonical mints that predate the def index (their unit root Decl
    # does not exist yet); drained into root-proxy links by indexUnitDefs
    declProxyTids: (ListVal ztypes.tid)
    declProxyUnits: (List String)
    # Member-type writes that found no declaration to land on. Generator
    # lowering pre-resolves system.optionval and system.Iterator, and the
    # never/null canonical pair is minted, before indexUnitDefs builds the
    # unit-root Decls, so those types' members are typed before anything
    # declares them. The write is held here until the index exists and
    # declStampPreIndexMembers can land it, and answers reads during the
    # window. Keyed by (parent, name), last write wins, a handful of entries.
    pendParent: (ListVal u64)
    pendName: (ListVal u64)
    pendType: (ListVal u64)
    isError: bool
    errors: (List zast.ErrorData)
    currentReturnTypeId: ztypes.tid
} as {
    # --- declaration tree ---

    # declValid -- `id` addresses a real row. DeclIds are minted dense 1..N by
    # declNew and never removed, so 0 (the "no declaration" sentinel) and any id
    # past the end are the only misses.
    declValid: function {t: this.view id: ztypes.declid} out bool is {
        if id.isZero then return false
        return id <= t.decls.length
    }

    # declNew -- append one declaration row (DeclId = new row count) and
    # link it into the parent's namespace; parent 0 = a tree root.
    declNew: function {:this name: u32 parent: ztypes.declid kind: declkind node: u32} out ztypes.declid is {
        this.decls.append (Decl
            :name
            :parent
            :kind
            :node
            typeId: ztypes.tid
            ownership: ztypes.zparamownership.noneMode
            defaultVal: defaultval.none
            resolving: false
            defined: false
            grantsPrivate: false
            fnptrField: false
            lockFieldDecl: 0
            children: (ListVal declchild)
            byName: (MapVV u64 value: ztypes.declid)
        )
        id: ztypes.declid.create from: this.decls.length
        if (parent.isZero) == false then (this.declAddChildEdge
            parentDeclId: parent
            nameId: (zast.nameid.create from: name.u32)
            childDeclId: id
        )
        return id
    }

    # declAddChildEdge -- append a name -> declaration edge to a parent's
    # namespace (also used for public-interface entries, whose targets are
    # sibling declarations rather than fresh rows).
    declAddChildEdge: function {:this parentDeclId: ztypes.declid nameId: zast.nameid childDeclId: ztypes.declid} is {
        if (this.declValid id: parentDeclId) then {
            po9: this.decls.getMut i: (parentDeclId - 1)
            po9.children.append (declchild :nameId declId: childDeclId)
            # keep the name index in the WRITER: the first append past the
            # scan threshold backfills it and later appends keep it filled.
            # Backfilling in the reader instead would make every lookup a
            # mutation, and a mutating
            # lookup cannot run under a live children borrow.
            if po9.children.length > bucketScanMax then {
                if po9.byName.length == 0 then {
                    with cit7: po9.children.iterate do for c7: cit7 loop {
                        po9.byName.set key: c7.nameId.u64 value: c7.declId
                    }
                } else {
                    po9.byName.set key: nameId.u64 value: childDeclId
                }
            }
        }
    }

    # declSetType -- record the canonical type a declaration minted, and the
    # reverse edge. The first mint wins, so a later alias declaration sharing
    # the type does not displace the defining one.
    # declSetResolving / declIsResolving -- the DFS grey mark.
    declSetResolving: function {:this declId: ztypes.declid mark: bool} is {
        if (this.declValid id: declId) == false then return
        do9: this.decls.getMut i: (declId - 1)
        do9.resolving = mark
    }

    declIsResolving: function {:this declId: ztypes.declid} out bool is {
        if (this.declValid id: declId) == false then return false
        do9: this.decls.get i: (declId - 1)
        return do9.resolving
    }

    # declSetDefined / declIsDefined -- the demand "done" mark.
    declSetDefined: function {:this declId: ztypes.declid} is {
        if (this.declValid id: declId) == false then return
        do9: this.decls.getMut i: (declId - 1)
        do9.defined = true
    }

    declIsDefined: function {:this declId: ztypes.declid} out bool is {
        if (this.declValid id: declId) == false then return false
        do9: this.decls.get i: (declId - 1)
        return do9.defined
    }

    declSetType: function {:this declId: ztypes.declid typeId: ztypes.tid} is {
        {
            if (this.declValid id: declId) then {
                do9: this.decls.getMut i: (declId - 1)
                do9.typeId = typeId
            }
        }
        if typeId > 0 then {
            seen9: false
            {
                ex9: this.declByTypeId.get key: typeId
                match (
                    ex9
                ) case some then {
                    seen9 = true
                } case none then null
            }
            if seen9 == false then this.declByTypeId.set key: typeId value: declId
        }
    }

    # declPendWrite -- hold a member-type write whose owner has no declaration
    # yet. In place on a repeat, so the buffer carries one entry per
    # (parent, name).
    declPendWrite: function {:this parentTypeId: ztypes.tid nameId: zast.nameid typeId: ztypes.tid} is {
        i9: u64
        n9: this.pendParent.length
        for i9 < n9 loop {
            hit9: (this.pendParent.get i: i9) == parentTypeId
            if hit9 then hit9 = (this.pendName.get i: i9) == nameId.u64
            if hit9 then {
                this.pendType.set i: i9 val: typeId
                return
            }
            i9 = i9 + 1
        }
        pp9: parentTypeId
        this.pendParent.append pp9
        pn9: nameId.u64
        this.pendName.append pn9
        pt9: typeId
        this.pendType.append pt9
    }

    # declPendMemberType -- the type a pended write recorded for
    # (parent, name); 0 when there is none.
    declPendMemberType: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out u64 is {
        r9: u64
        i9: u64
        n9: t.pendParent.length
        for i9 < n9 loop {
            hit9: (t.pendParent.get i: i9) == parentTypeId
            if hit9 then hit9 = (t.pendName.get i: i9) == nameId.u64
            if hit9 then r9 = t.pendType.get i: i9
            i9 = i9 + 1
        }
        return r9
    }

    # declPendCount -- how many pended pre-index writes `parentTypeId` holds.
    declPendCount: function {:this parentTypeId: ztypes.tid} out u64 is {
        c9: u64
        i9: u64
        n9: this.pendParent.length
        for i9 < n9 loop {
            if (this.pendParent.get i: i9) == parentTypeId then c9 = c9 + 1
            i9 = i9 + 1
        }
        return c9
    }

    # declPendRows -- one parent's pended writes, in write order.
    declPendRows: function {:this parentTypeId: ztypes.tid names: ListVal u64 tids: ListVal u64} is {
        i9: u64
        n9: this.pendParent.length
        for i9 < n9 loop {
            if (this.pendParent.get i: i9) == parentTypeId then {
                names.append (this.pendName.get i: i9)
                tids.append (this.pendType.get i: i9)
            }
            i9 = i9 + 1
        }
    }

    # declStampPreIndexMembers -- land the member-type writes a type held while
    # it had no declaration. indexUnitDefs calls this once on each pre-index
    # mint it drains; no other path needs it, because every other member is
    # declared before its type is written.
    declStampPreIndexMembers: function {:this parentTypeId: ztypes.tid declId: ztypes.declid} is {
        nids9: (ListVal u64)
        tids9: (ListVal u64)
        this.declPendRows :parentTypeId names: nids9 tids: tids9
        i9: u64
        n9: nids9.length
        for i9 < n9 loop {
            nid9: nids9.get i: i9
            mtid9: tids9.get i: i9
            i9 = i9 + 1
            if mtid9 > 0 then {
                md9: (this.declFindChild
                    parentDeclId: declId
                    nameId: (zast.nameid.create from: nid9.u32.orPanic)
                )
                if (md9.isZero) == false then {
                    if (this.declValid id: md9) then {
                        do9: this.decls.getMut i: (md9 - 1)
                        do9.typeId = ztypes.tid.create from: mtid9.u64
                    }
                }
            }
        }
    }

    # declFindChild -- the last child declaration named nameId under
    # parentDeclId (0 when absent); last wins, matching the overwrite
    # semantics of the string-keyed def tables.
    declFindChild: function {
        t: this.view
        parentDeclId: ztypes.declid
        nameId: zast.nameid
    } out ztypes.declid is {
        found9: ztypes.declid
        if (t.declValid id: parentDeclId) then {
            po9: t.decls.get i: (parentDeclId - 1)
            if po9.byName.length > 0 then {
                bo9: po9.byName.get key: nameId.u64
                match (
                    bo9
                ) case some then {
                    found9 = bo9
                } case none then null
            } else {
                with cit9: po9.children.iterate do for c9: cit9 loop {
                    if c9.nameId == nameId then found9 = c9.declId
                }
            }
        }
        return found9
    }

    # declIdOfType -- the declaration that minted `typeId`; 0 for a type with
    # none of its own. A monomorphisation HAS one -- declMonoType clones the
    # template's -- so this returns the mono's own declaration, whose members
    # carry instantiated types. (declOfTypeId, in ztypecheck, hops
    # genericOrigin to the TEMPLATE's instead; the two differ on monos.)
    declIdOfType: function {t: this.view typeId: ztypes.tid} out ztypes.declid is {
        od9: ztypes.declid
        {
            go9: t.declByTypeId.get key: typeId
            match (
                go9
            ) case some then {
                od9 = go9
            } case none then null
        }
        return od9
    }

    # declSetMemberType -- record a member declaration's type. Deliberately
    # not declSetType: the member did not mint the type, so it must not claim
    # the reverse declByTypeId edge.
    declSetMemberType: function {:this parentTypeId: ztypes.tid nameId: zast.nameid typeId: ztypes.tid} is {
        md8: this.declMemberIdOf :parentTypeId :nameId
        if md8.isZero then {
            # a function type's members are its parameters, and a synthesized
            # constructor gains them after its own declaration exists
            od8: this.declIdOfType typeId: parentTypeId
            if od8.isZero then {
                this.declPendWrite :parentTypeId :nameId :typeId
                return
            }
            isFn8: false
            node8: u32
            {
                if (this.declValid id: od8) then {
                    oo8: this.decls.get i: (od8 - 1)
                    if oo8.kind.methodDecl then isFn8 = true
                    if oo8.kind.funcDecl then isFn8 = true
                    node8 = oo8.node
                }
            }
            if isFn8 == false then {
                this.declPendWrite :parentTypeId :nameId :typeId
                return
            }
            md8 = (this.declNew
                name: nameId
                parent: od8
                kind: declkind.paramDecl
                node: node8
            )
        }
        {
            if (this.declValid id: md8) then {
                do8: this.decls.getMut i: (md8 - 1)
                do8.typeId = typeId
            }
        }
        # every member type names the declaration that minted it, whatever the
        # member's kind: a method's type IS the function it declares (its
        # parameters attach to that namespace), and a synthesized field's type
        # still has exactly one declaration behind it.
        if typeId > 0 then {
            exd8: this.declIdOfType :typeId
            if exd8.isZero then this.declByTypeId.set key: typeId value: md8
        }
    }

    # declChildOf / declChildOfId -- the type of member `name` on parentTypeId.
    # The member's DECLARATION is the source of truth: undeclared, or declared
    # carrying no type, both read as absent. A member with no declaration at
    # all falls back to the pended pre-index writes, which is the only record
    # of a type whose owner never acquires a declaration.
    declChildOf: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView} out optionval u64 is {
        nid9: pool.find s: name
        if nid9.isZero then return (optionval.none u64)
        return (this.declChildOfId :parentTypeId nameId: nid9)
    }

    declChildOfId: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out optionval u64 is {
        if nameId.isZero then return (optionval.none u64)
        md9: t.declMemberIdOf :parentTypeId :nameId
        if (md9.isZero) == false then {
            t9: u64
            {
                if (t.declValid id: md9) then {
                    mo9: t.decls.get i: (md9 - 1)
                    t9 = mo9.typeId
                }
            }
            if t9 == 0 then return (optionval.none u64)
            return (optionval.some t9)
        }
        pv9: t.declPendMemberType :parentTypeId :nameId
        if pv9 == 0 then return (optionval.none u64)
        return (optionval.some pv9)
    }

    # declIsLockField / declIsLockFieldId -- is `name` the lock field of the
    # type that minted parentTypeId? The owning declaration names one member as
    # its lock, so this is a round trip through that pointer.
    declIsLockField: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView} out bool is {
        nid9: pool.find s: name
        if nid9.isZero then return false
        return (this.declIsLockFieldId :parentTypeId nameId: nid9)
    }

    declIsLockFieldId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid} out bool is {
        od9: this.declIdOfType typeId: parentTypeId
        if od9.isZero then return false
        lf9: u64
        {
            if (this.declValid id: od9) then {
                oo9: this.decls.get i: (od9 - 1)
                lf9 = oo9.lockFieldDecl
            }
        }
        if lf9 == 0 then return false
        return lf9 == (this.declFindChild parentDeclId: od9 :nameId)
    }

    # declDefaultOfId -- member `nameId`'s recorded default value; none when
    # the member is undeclared or carries none.
    declDefaultOfId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid} out defaultval is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9.isZero then return defaultval.none
        r9: defaultval.none
        {
            if (this.declValid id: md9) then {
                mo9: this.decls.get i: (md9 - 1)
                dv9: mo9.defaultVal
                r9 = dv9
            }
        }
        return r9
    }

    # declHasDefaultId -- does member `nameId` of parentTypeId carry a default?
    declHasDefaultId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid} out bool is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9.isZero then return false
        r9: false
        {
            if (this.declValid id: md9) then {
                mo9: this.decls.get i: (md9 - 1)
                if mo9.defaultVal.none then r9 = false else r9 = true
            }
        }
        return r9
    }

    # declOwnershipIs -- the parameter binding mode recorded on member `name`
    # of parentTypeId equals `own`; false when the member is undeclared or
    # carries no mode. A zero-inited declaration reads noneMode, so an unset
    # mode never matches take, borrow or lock.
    # declOwnershipOfId -- a member's recorded parameter ownership, or none
    # when it has none: an unset declaration reads noneMode.
    declOwnershipOfId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid} out optionval ztypes.zparamownership is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9.isZero then return (optionval.none ztypes.zparamownership)
        r9: ztypes.zparamownership.noneMode
        {
            if (this.declValid id: md9) then {
                mo9: this.decls.get i: (md9 - 1)
                r9 = mo9.ownership
            }
        }
        if r9.noneMode then return (optionval.none ztypes.zparamownership)
        return (optionval.some r9)
    }

    # declGrantsPrivate -- was member `name` declared with a `.private` handle
    # type, so reads through it stay private-capable?
    declGrantsPrivate: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView} out bool is {
        nid9: pool.find s: name
        if nid9.isZero then return false
        md9: this.declMemberIdOf :parentTypeId nameId: nid9
        if md9.isZero then return false
        r9: false
        {
            if (this.declValid id: md9) then {
                mo9: this.decls.get i: (md9 - 1)
                r9 = mo9.grantsPrivate
            }
        }
        return r9
    }

    declOwnershipIs: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView own: ztypes.zparamownership} out bool is {
        nid9: pool.find s: name
        if nid9.isZero then return false
        md9: this.declMemberIdOf :parentTypeId nameId: nid9
        if md9.isZero then return false
        r9: false
        {
            if (this.declValid id: md9) then {
                mo9: this.decls.get i: (md9 - 1)
                oc9: own
                r9 = (ztypes.zparamownershipInt mo9.ownership) == (ztypes.zparamownershipInt oc9)
            }
        }
        return r9
    }

    # declIsFnptrField / declIsFnptrFieldId -- does member `name` occupy a
    # struct function-pointer slot? Where it was declared decides this, so the
    # member declaration carries it as a bit.
    declIsFnptrField: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView} out bool is {
        nid9: pool.find s: name
        if nid9.isZero then return false
        return (this.declIsFnptrFieldId :parentTypeId nameId: nid9)
    }

    declIsFnptrFieldId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid} out bool is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9.isZero then return false
        r9: false
        {
            if (this.declValid id: md9) then {
                mo9: this.decls.get i: (md9 - 1)
                r9 = mo9.fnptrField
            }
        }
        return r9
    }

    # declIsMethodId -- was member `name` DECLARED as a function? The type a
    # member resolves to cannot answer this: a collection materialises
    # `length`/`capacity` as plain scalars, because they emit as a struct field
    # read rather than a call, so the member's type is its RETURN type and it is
    # indistinguishable from a field by type alone. The declaration still knows.
    # declMemberIsSynth -- the member was SYNTHESISED by the checker (create,
    # borrow, ==, !=, tag) rather than written by the author. `declSynthMember`
    # gives a synthesised member the OWNER's node, having none of its own; a
    # declared member carries its own namedoperation. That difference is the
    # only record of which is which, and the emitter needs it: its byte-compare
    # and byte-copy defaults must yield to a method the author wrote.
    declMemberIsSynth: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out bool is {
        md9: t.declMemberIdOf :parentTypeId :nameId
        if md9.isZero then return false
        od9: t.declIdOfType typeId: parentTypeId
        if od9.isZero then return false
        r9: false
        {
            if (t.declValid id: md9) when (t.declValid id: od9) then {
                mo9: t.decls.get i: (md9 - 1)
                oo9: t.decls.get i: (od9 - 1)
                if mo9.node == oo9.node then r9 = true
            }
        }
        return r9
    }

    declIsMethodId: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out bool is {
        md9: t.declMemberIdOf :parentTypeId :nameId
        if md9.isZero then return false
        r9: false
        {
            if (t.declValid id: md9) then {
                mo9: t.decls.get i: (md9 - 1)
                k9: mo9.kind
                if k9.methodDecl then r9 = true
                if k9.funcDecl then r9 = true
            }
        }
        return r9
    }

    # declCloneType -- a monomorphisation's own type declaration: the
    # template's name, node and home unit, with the template's members cloned
    # in order. The clone is reachable by
    # no name -- it is linked into no parent namespace, so resolving the
    # template's name still finds the template.
    declCloneType: function {:this templateDeclId: ztypes.declid} out ztypes.declid is {
        tname9: u32
        tnode9: u32
        tparent9: ztypes.declid
        tkind9: declkind.typeDecl
        kids9: (ListVal ztypes.declid)
        {
            if (this.declValid id: templateDeclId) then {
                to9: this.decls.get i: (templateDeclId - 1)
                tname9 = to9.name
                tnode9 = to9.node
                tparent9 = to9.parent
                tkind9 = to9.kind
                with cit9: to9.children.iterate do for c9: cit9 loop kids9.append c9.declId
            }
        }
        if tname9 == 0 then return (ztypes.declid.create from: 0)
        # the clone keeps the template's kind: a monomorphisation of a generic
        # FUNCTION is a function, and only a function declaration may own its
        # parameter declarations.
        id9: this.declNew name: tname9 parent: ztypes.declid kind: tkind9 node: tnode9
        {
            if (this.declValid id: id9) then {
                no9: this.decls.getMut i: (id9 - 1)
                no9.parent = tparent9
            }
        }
        ki9: u64
        kn9: kids9.length
        for ki9 < kn9 loop {
            kd9: kids9.get i: ki9
            ki9 = ki9 + 1
            cn9: u32
            cnode9: u32
            ck9: declkind.fieldDecl
            isM9: false
            {
                if (this.declValid id: kd9) then {
                    ko9: this.decls.get i: (kd9 - 1)
                    cn9 = ko9.name
                    cnode9 = ko9.node
                    ck9 = ko9.kind
                    if ko9.kind.fieldDecl then isM9 = true
                    if ko9.kind.methodDecl then isM9 = true
                    if ko9.kind.armDecl then isM9 = true
                }
            }
            if isM9 then this.declNew name: cn9 parent: id9 kind: ck9 node: cnode9
        }
        return id9
    }

    # declSynthMember -- mint the declaration of a member the checker
    # synthesises (create, borrow, ==, !=, tag) under the type that minted
    # `parentTypeId`, appended in member order. A no-op
    # when that type has no declaration of its own, or when the member is
    # already declared (a type writing its own `create` in an is-block).
    declSynthMember: function {:this parentTypeId: ztypes.tid nameId: zast.nameid kind: declkind} is {
        od9: this.declIdOfType typeId: parentTypeId
        if od9.isZero then return
        if (this.declFindChild parentDeclId: od9 :nameId) > 0 then return
        node9: u32
        {
            if (this.declValid id: od9) then {
                oo9: this.decls.get i: (od9 - 1)
                node9 = oo9.node
            }
        }
        kk9: kind
        this.declNew name: nameId parent: od9 kind: kk9 node: node9
    }

    # declChildSlots -- how many children a declaration's namespace holds.
    declChildSlots: function {:this declId: ztypes.declid} out u64 is {
        if (this.declValid id: declId) then {
            po9: this.decls.get i: (declId - 1)
            return po9.children.length
        }
        return 0
    }

    # declChildWalk -- the shared walk behind declMemberList and declChildRows:
    # every child of the type's own declaration that carries a type, in
    # declaration order, as (name pool id, type id). `membersOnly` narrows to
    # the field / method / arm / param children. When the type has no
    # declaration of its own the pended pre-index writes answer instead.
    # The owner is re-read per index rather than staged into a row list: the
    # per-child probe is a `:this` call, which cannot run under a live children
    # borrow, and a map probe is cheaper than the staging lists it replaces.
    declChildWalk: function {
        :this
        ownerTid: ztypes.tid
        membersOnly: bool
        names: ListVal u64
        tids: ListVal u64
    } is {
        od9: this.declIdOfType typeId: ownerTid
        if od9.isZero then {
            this.declPendRows parentTypeId: ownerTid :names :tids
            return
        }
        n9: this.declChildSlots declId: od9
        i9: u64
        for i9 < n9 loop {
            nid9: u64
            did9: ztypes.declid
            {
                if (this.declValid id: od9) then {
                    oo9: this.decls.get i: (od9 - 1)
                    ce9: oo9.children.get i: i9
                    nid9 = ce9.nameId.u64
                    did9 = ce9.declId
                }
            }
            i9 = i9 + 1
            keep9: (membersOnly) == false
            mt9: u64
            {
                if (this.declValid id: did9) then {
                    ko9: this.decls.get i: (did9 - 1)
                    if membersOnly then {
                        if ko9.kind.fieldDecl then keep9 = true
                        if ko9.kind.methodDecl then keep9 = true
                        if ko9.kind.paramDecl then keep9 = true
                        if ko9.kind.armDecl then keep9 = true
                    }
                    mt9 = ko9.typeId
                }
            }
            if keep9 when mt9 > 0 then {
                names.append nid9
                tids.append mt9
            }
        }
    }

    # declMemberList -- a type's members, in declaration order: the member
    # names (pool ids) and their types. Members are the field / method / arm /
    # param children carrying a type; a unit's definitions and a type's
    # `public:` block are not members and are skipped. Declaration order IS
    # member order because the index builds the member Decls in that order and
    # nothing reorders them -- member order does not depend on the order the
    # members are typed in.
    declMemberList: function {:this ownerTid: ztypes.tid names: (ListVal u64).view tids: (ListVal u64).view} is {
        this.declChildWalk :ownerTid membersOnly: true :names :tids
    }

    # declChildRows -- as declMemberList but with no kind filter, so a unit's
    # definitions come out alongside a type's members: the SQL dumps want the
    # whole namespace a declaration describes. `typeId > 0` is the only filter
    # needed -- an untyped child (a re-exported generic param, a `public:`
    # block) is not a member of anything.
    declChildRows: function {:this ownerTid: ztypes.tid names: (ListVal u64).view tids: (ListVal u64).view} is {
        this.declChildWalk :ownerTid membersOnly: false :names :tids
    }

    # declAllMemberRows -- every (owner type, child name, child type) triple the
    # declaration tree describes, owners in ascending tid order. The
    # whole-program form of declChildRows, for the callers that visit every
    # member in the program rather than one owner's. A tid with no declaration
    # of its own contributes nothing and is skipped without asking
    # declChildRows, so its edge fallback stays a signal about the pre-index
    # window rather than noise from this walk. lastTid is the registry's
    # nextTypeId, which ZTyping cannot reach on its own.
    declAllMemberRows: function {
        :this
        lastTid: u64
        owners: ListVal u64
        names: ListVal u64
        tids: ListVal u64
    } is {
        t9: u64
        for t9 < lastTid loop {
            if (this.declIdOfType typeId: (ztypes.tid.create from: t9.u64)) > 0 then {
                nms9: (ListVal u64)
                tds9: (ListVal u64)
                this.declChildRows ownerTid: (ztypes.tid.create from: t9.u64) names: nms9 tids: tds9
                i9: u64
                n9: nms9.length
                for i9 < n9 loop {
                    ov9: t9
                    owners.append ov9
                    names.append (nms9.get i: i9)
                    tids.append (tds9.get i: i9)
                    i9 = i9 + 1
                }
            }
            t9 = t9 + 1
        }
    }

    # declMemberCount -- how many members the type's declaration carries: the
    # declaration-side form of childCount. Routed through declMemberList so the
    # two can never disagree about what counts as a member.
    declMemberCount: function {:this ownerTid: ztypes.tid} out u64 is {
        od9: this.declIdOfType typeId: ownerTid
        if od9.isZero then return (this.declPendCount parentTypeId: ownerTid)
        c9: u64
        n9: this.declChildSlots declId: od9
        i9: u64
        for i9 < n9 loop {
            did9: ztypes.declid
            {
                if (this.declValid id: od9) then {
                    oo9: this.decls.get i: (od9 - 1)
                    did9 = (oo9.children.get i: i9).declId
                }
            }
            i9 = i9 + 1
            {
                if (this.declValid id: did9) then {
                    ko9: this.decls.get i: (did9 - 1)
                    isMem9: false
                    if ko9.kind.fieldDecl then isMem9 = true
                    if ko9.kind.methodDecl then isMem9 = true
                    if ko9.kind.paramDecl then isMem9 = true
                    if ko9.kind.armDecl then isMem9 = true
                    if isMem9 when ko9.typeId > 0 then c9 = c9 + 1
                }
            }
        }
        return c9
    }

    # declLastChildNameId -- the name pool id of the LAST typed child of the
    # type's declaration, 0 when it has none. Last, because that is the row a
    # declChildRows walk leaves behind; paired with declMemberCount == 1 by the
    # single-parameter probes, which want the name without a row list.
    declLastChildNameId: function {:this ownerTid: ztypes.tid} out u64 is {
        od9: this.declIdOfType typeId: ownerTid
        if od9.isZero then return 0
        r9: u64
        n9: this.declChildSlots declId: od9
        i9: u64
        for i9 < n9 loop {
            nid9: u64
            did9: ztypes.declid
            {
                if (this.declValid id: od9) then {
                    oo9: this.decls.get i: (od9 - 1)
                    ce9: oo9.children.get i: i9
                    nid9 = ce9.nameId.u64
                    did9 = ce9.declId
                }
            }
            i9 = i9 + 1
            {
                if (this.declValid id: did9) then {
                    ko9: this.decls.get i: (did9 - 1)
                    if ko9.typeId > 0 then r9 = nid9
                }
            }
        }
        return r9
    }

    # declHasMemberId -- does the type that minted `parentTypeId` declare a
    # typed member `nameId`? The declaration-side form of hasChildId.
    declHasMemberId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid} out bool is {
        if nameId.isZero then return false
        return (this.declTypedMemberIdOf :parentTypeId :nameId) > 0
    }

    # declMemberIdOf -- the declaration of member `nameId` under the type
    # `parentTypeId` minted; 0 when that type has no declaration of its own or
    # the member is not declared.
    declMemberIdOf: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out ztypes.declid is {
        od9: t.declIdOfType typeId: parentTypeId
        if od9.u64 == 0 then return od9
        return (t.declFindChild parentDeclId: od9 :nameId)
    }

    # declTypedMemberIdOf -- the declaration of member `nameId` under the type
    # `parentTypeId` minted, but only when that declaration carries a type; 0
    # otherwise. The narrowing is what lets a member DeclId serve as the
    # identity of a (parent, name) pair: a declaration carrying no type was
    # never a member anything could name.
    declTypedMemberIdOf: function {:this parentTypeId: ztypes.tid nameId: zast.nameid} out ztypes.declid is {
        md9: this.declMemberIdOf :parentTypeId :nameId
        if md9.u64 == 0 then return md9
        t9: u64
        {
            if (this.declValid id: md9) then {
                mo9: this.decls.get i: (md9 - 1)
                t9 = mo9.typeId
            }
        }
        if t9 == 0 then return (ztypes.declid.create from: 0)
        return md9
    }

    # --- member types ---

    # setMemberType -- record the type of member `nameId` on `parentTypeId`:
    # ensure the member's declaration, stamp the type onto it, and on first
    # sight position it in the owner's last member slot, so declaration order
    # is built as member order rather than corrected afterwards.
    setMemberType: function {:this parentTypeId: ztypes.tid nameId: zast.nameid childTypeId: u64} is {
        (this.declSetMemberType
            :parentTypeId
            :nameId
            typeId: (ztypes.tid.create from: childTypeId.u64)
        )
    }

    # --- member constant values ---

    # memberConstKey -- the (parent type, member name) packing memberConst and
    # constEvalState share. One helper, so the remap in
    # canonicalizeShellNodeStamps and every read site cannot drift apart.
    memberConstKey: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out u64 is {
        return (parentTypeId * 4294967296) + nameId.u64
    }

    # setMemberConst -- record the compile-time VALUE of member `nameId` on
    # `parentTypeId`, the channel parallel to setMemberType's type.
    setMemberConst: function {:this parentTypeId: ztypes.tid nameId: zast.nameid value: ztypes.cval} is {
        k9: this.memberConstKey :parentTypeId :nameId
        this.memberConst.set key: k9 :value
    }

    # memberConstOf -- that value, or `none` when the member has none.
    memberConstOf: function {
        t: this.view
        parentTypeId: ztypes.tid
        nameId: zast.nameid
    } out ztypes.cval is {
        k9: t.memberConstKey :parentTypeId :nameId
        g9: t.memberConst.get key: k9
        match (
            g9
        ) case some then {
            return g9
        } case none then {
            return ztypes.noConst
        }
    }

    # --- per-member flags ---

    # setAliasInternalName / aliasInternalNameOf -- per dotted-path-node record
    # of the internal member an external access resolved to through a public
    # alias; the emitter reads it to emit the internal C name.
    setAliasInternalName: function {:this nodeid: zast.nodeid internalName: StringView} is {
        v9: internalName.string
        this.aliasInternalName.set key: nodeid.u64 value: v9
    }

    aliasInternalNameOf: function {:this nodeid: zast.nodeid} out String is {
        r9: this.aliasInternalName.get key: nodeid.u64
        match (
            r9
        ) case some then {
            return r9.copy
        } case none then {
            return "".string
        }
    }

    # setChildGrantsPrivateId -- mark a field edge as one whose declared type
    # was a `.private` handle, so reads through it are private-capable.
    setChildGrantsPrivateId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid} is {
        md8: this.declMemberIdOf :parentTypeId :nameId
        if (md8.isZero) == false then {
            if (this.declValid id: md8) then {
                do8: this.decls.getMut i: (md8 - 1)
                do8.grantsPrivate = true
            }
        }
    }

    markAsConstClone: function {:this typeId: ztypes.tid} is {
        tk: typeId
        mv2: true
        this.asConstClone.set key: tk value: mv2
    }

    isAsConstClone: function {:this typeId: ztypes.tid} out bool is {
        tk2: typeId
        r: this.asConstClone.get key: tk2
        match (
            r
        ) case some then {
            return r
        } case none then {
            return false
        }
    }

    setChildLockField: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView} is {
        nid8: pool.find s: name
        if nid8 > 0 then {
            od8: this.declIdOfType typeId: parentTypeId
            if (od8.isZero) == false then {
                md8: this.declFindChild parentDeclId: od8 nameId: nid8
                if (md8.isZero) == false then {
                    if (this.declValid id: od8) then {
                        do8: this.decls.getMut i: (od8 - 1)
                        do8.lockFieldDecl = md8
                    }
                }
            }
        }
    }

    setChildFnptrField: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView} is {
        nid8: pool.find s: name
        if nid8 > 0 then {
            md8: this.declMemberIdOf :parentTypeId nameId: nid8
            if (md8.isZero) == false then {
                if (this.declValid id: md8) then {
                    do8: this.decls.getMut i: (md8 - 1)
                    do8.fnptrField = true
                }
            }
        }
    }

    # --- member defaults ---

    # setDefaultLiteral -- a literal default. `node` is the default
    # expression's AST node, which the declaration carries the way a unit
    # constant does (its value is re-rendered from the node, never stored).
    setDefaultLiteral: function {:this pool: zast.StringPool.view parentTypeId: ztypes.tid name: StringView node: u32} is {
        this.declSetDefault :parentTypeId :pool :name value: (defaultval.literal node)
    }

    # declSetDefault -- record a member declaration's default value; a no-op
    # when the owner type has no declaration (a monomorphisation) or the
    # member is not a declared one.
    declSetDefault: function {:this parentTypeId: ztypes.tid pool: zast.StringPool name: StringView value: defaultval} is {
        nid8: pool.find s: name
        if nid8.isZero then return
        md8: this.declMemberIdOf :parentTypeId nameId: nid8
        if md8.isZero then return
        if (this.declValid id: md8) then {
            do8: this.decls.getMut i: (md8 - 1)
            dv8: value
            do8.defaultVal = dv8
        }
    }

    # setDefaultFunction -- a default naming a function; `targetDecl` is that
    # function's declaration (0 when it resolved to no declaration).
    setDefaultFunction: function {:this pool: zast.StringPool.view parentTypeId: ztypes.tid name: StringView targetDecl: ztypes.declid} is {
        this.declSetDefault :parentTypeId :pool :name value: (defaultval.func targetDecl)
    }

    # setDefaultVariantArm -- a default naming an arm of the member's own
    # type; `targetDecl` is that arm's declaration (0 when it resolved to no
    # declaration).
    setDefaultVariantArm: function {:this pool: zast.StringPool.view parentTypeId: ztypes.tid name: StringView targetDecl: ztypes.declid} is {
        this.declSetDefault :parentTypeId :pool :name value: (defaultval.arm targetDecl)
    }

    # declDefaultText -- a member's default as display text, "" when it has
    # none. A literal renders as its expression nodeid (the caller needs an Ast
    # to re-render it); a function or arm renders as its target's declared name.
    declDefaultText: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView} out String is {
        nid9: pool.find s: name
        if nid9.isZero then return "".string
        dv9: this.declDefaultOfId :parentTypeId nameId: nid9
        {
            dl9: dv9
            if dl9.literal then return "literal node \{dl9}"
        }
        tgt9: ztypes.declid
        {
            df9: dv9
            if df9.func then tgt9 = df9
        }
        isArm9: false
        {
            da9: dv9
            if da9.arm then {
                tgt9 = da9
                isArm9 = true
            }
        }
        if tgt9.isZero then return "".string
        nm9: u32
        {
            if (this.declValid id: tgt9) then {
                to9: this.decls.get i: (tgt9 - 1)
                nm9 = to9.name
            }
        }
        tx9: zast.poolTextAt :pool ref: (zast.nameid.create from: nm9.u32)
        if isArm9 then return "arm \{tx9}"
        return "func \{tx9}"
    }

    # --- member ownership ---

    setChildOwnership: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView ownership: ztypes.zparamownership} is {
        nid8: pool.find s: name
        if nid8 > 0 then {
            md8: this.declMemberIdOf :parentTypeId nameId: nid8
            if (md8.isZero) == false then {
                if (this.declValid id: md8) then {
                    do8: this.decls.getMut i: (md8 - 1)
                    oc8: ownership
                    do8.ownership = oc8
                }
            }
        }
    }

    # setChildOwnershipId -- the id-keyed form of setChildOwnership.
    setChildOwnershipId: function {:this parentTypeId: ztypes.tid nameId: zast.nameid ownership: ztypes.zparamownership} is {
        md8: this.declMemberIdOf :parentTypeId :nameId
        if (md8.isZero) == false then {
            if (this.declValid id: md8) then {
                do8: this.decls.getMut i: (md8 - 1)
                oc8: ownership
                do8.ownership = oc8
            }
        }
    }

    # declOwnershipText -- a member's ownership as display text, "none" when
    # it has none.
    declOwnershipText: function {:this pool: zast.StringPool parentTypeId: ztypes.tid name: StringView} out String is {
        nid9: pool.find s: name
        if nid9.isZero then return "none".string
        r9: this.declOwnershipOfId :parentTypeId nameId: nid9
        match (
            r9
        ) case some then {
            return (ztypes.zparamownershipName r9)
        } case none then {
            return "none".string
        }
    }

    # --- generic args ---

    hasGenericArgNamed: function {:this parentTypeId: ztypes.tid paramName: StringView} out bool is {
        iter: this.typeGenericArg.iterate
        for row: iter loop {
            if row.parentTypeId == parentTypeId then {
                if row.paramName.stringview == paramName then return true
            }
        }
        return false
    }

    setGenericArg: function {:this pool: zast.StringPool parentTypeId: ztypes.tid paramName: StringView argTypeId: u64} is {
        present: this.hasGenericArgNamed :parentTypeId :paramName
        if present == false then {
            pos: this.typeGenericArg.length
            this.typeGenericArg.append (ZTypeGenericArg
                :parentTypeId
                paramName: paramName.string
                position: pos
            )
        }
        key9: (parentTypeId * 4294967296) + (pool.find s: paramName).u64
        this.genericArgTypeBy.set key: key9 value: argTypeId
    }

    genericArgOf: function {:this pool: zast.StringPool parentTypeId: ztypes.tid paramName: StringView} out optionval u64 is {
        key9: (parentTypeId * 4294967296) + (pool.find s: paramName).u64
        r: this.genericArgTypeBy.get key: key9
        match (
            r
        ) case some then {
            return (optionval.some r)
        } case none then {
            return (optionval.none u64)
        }
    }

    hasGenericArgs: function {:this parentTypeId: ztypes.tid} out bool is {
        iter: this.typeGenericArg.iterate
        for row: iter loop {
            if row.parentTypeId == parentTypeId then return true
        }
        return false
    }
}

# armside -- which side of a 2-arm sum a trailing predicate segment names.
# `x.a.false` negates the predicate `x.a`, `x.a.true` passes it through, and
# anything else is not that shape at all. Falsy arm first, as the convention
# the record states the order for asks.
armside: variant {
    none: null
    falsy: null
    truthy: null
}

# armSuffixSideOf -- which side of a 2-arm sum the trailing segment of a dotted
# ARM PREDICATE names, asked by arm IDENTITY rather than by spelling. `nid` is
# the outer dotted node: the dpArmPredicate stamp on it names the type the
# segment is an arm of, and that type's arm ORDER decides the side -- the arm
# written first negates the predicate, the one written second passes it
# through. `bool` is that type everywhere this shape occurs, and it writes
# `false` before `true`, which is what a `== "true"` test used to encode.
# armSideOfName -- which side of the 2-arm sum `tid` the name `nameId` is: the
# arm written second is the truthy one, the arm written first the falsy one.
# `none` when the name is neither, or when `tid` is not a 2-arm sum at all --
# so an absent tid answers `none` rather than needing a guard at every caller.
armSideOfName: function {ty: ZTyping.view typeId: u64 nameId: u64} out armside is {
    if nameId == 0 then return armside.none
    {
        t9: ty.sumPairSecondArm.get key: typeId
        match (
            t9
        ) case some then {
            if t9 == nameId then return armside.truthy
        } case none then null
    }
    {
        f9: ty.sumPairFirstArm.get key: typeId
        match (
            f9
        ) case some then {
            if f9 == nameId then return armside.falsy
        } case none then null
    }
    return armside.none
}

armSuffixSideOf: function {
    ty: ZTyping.view
    nid: u64
    parentNid: u64
    childNameId: u64
} out armside is {
    if childNameId == 0 then return armside.none
    # The suffix reads a predicate's bool RESULT, so the receiver must itself
    # be an arm predicate. `o.some` is a predicate in its own right -- its
    # receiver is an ordinary value -- and falls through to the general path,
    # even though its own stamped type is a 2-arm sum too and its child names
    # that type's second arm.
    parentIsPred9: false
    {
        pp9: ty.dpArmPredicate.get key: parentNid
        match (
            pp9
        ) case some then {
            parentIsPred9 = true
        } case none then null
    }
    if (parentIsPred9) == false then return armside.none
    dps9: ty.dpArmPredicate.get key: nid
    match (
        dps9
    ) case some then {
        return (armSideOfName :ty typeId: dps9 nameId: childNameId)
    } case none then {
        return armside.none
    }
}

# nodeTypeAt -- the type id stamped on node `nid`; 0 when nothing is stamped
# there (nodeTypeSet records neither a 0 node id nor a 0 type id).
nodeTypeAt: function {tbl: (ListVal ztypes.tid).view nid: u64} out ztypes.tid is {
    if nid == 0 then return (ztypes.tid.create from: 0)
    i9: nid - 1
    if i9 >= tbl.length then return (ztypes.tid.create from: 0)
    return (tbl.get i: i9)
}

# nodeTypeSet -- stamp node `nid` with type id `tid`. Node id 0 means "no node"
# and type id 0 is the unresolved sentinel, so neither is recorded: an absent
# stamp and a 0 stamp are the same answer to every reader.
nodeTypeSet: function {tbl: (ListVal ztypes.tid) nid: u64 tid: ztypes.tid} is {
    if nid == 0 then return
    if tid.isZero then return
    i9: nid - 1
    for tbl.length <= i9 loop tbl.append ztypes.tid
    v9: tid
    tbl.set i: i9 val: v9
}

# construct an empty ZTyping, pre-sizing its tables for roughly
# `nodeEst` nodes.
newTyping: function {nodeEst: 0.u64} out ZTyping is {
    return (ZTyping
        synthNodes: (List SynthNode)
        nextTempId: 0
        synthLabel: "".string
        currentThisName: "".string
        lastLockParamRoot: "".string
        fnBodyDiverges: (MapVV u64 value: bool)
        funcReturnsBorrow: (MapVV u64 value: bool)
        funcReturnsView: (MapVV u64 value: bool)
        funcReturnsTakex: (MapVV u64 value: bool)
        currentReturnsBorrow: false
        pendingBorrowPath: (List String)
        pendingBorrowShared: false
        pendingBorrowReadonly: false
        pendingBorrowOwned: false
        walkedMethodOwners: (MapVV u64 value: bool)
        monoNodeType: (MapVV u64 value: ztypes.tid)
        monoParamSubst: (MapVV ztypes.tid value: ztypes.tid)
        curMonoStamp: 0
        curMonoFnTid: ztypes.tid
        mainMemberIndex: (MapVV u64 value: u64)
        mainMemberUnit: "".string
        builtinTidMemo: (MapVV u64 value: ztypes.tid)
        typeGenericArg: (List ZTypeGenericArg)
        renameSeen: false
        privacySeen: false
        asConstClone: (MapVV u64 value: bool)
        generatorWrapper: (MapVV u64 value: bool)
        typeofShell: (MapVV u64 value: u32)
        noStampNode: (MapVV u64 value: bool)
        fnHasBody: (MapVV u64 value: bool)
        inAssignTarget: false
        sigGenericDecl: ztypes.declid
        inContainmentEdge: false
        suppressParamStamps: false
        suppressBareCtor: false
        suppressFnAutoCall: false
        typedefBaseName: (MapVR u64 value: String)
        typedefBaseTid: (MapVV ztypes.tid value: ztypes.tid)
        protocolThisContext: (MapVV u64 value: u64)
        mainDefIsReftype: (MapVV u64 value: bool)
        dpTaggedParent: (MapVV u64 value: ztypes.tid)
        dpArmPredicate: (MapVV u64 value: ztypes.tid)
        dpTagRead: (MapVV u64 value: ztypes.tid)
        tagAccessorName: (MapVR u64 value: String)
        tagAccessorTid: (MapVV ztypes.tid value: ztypes.tid)
        postGuardName: (MapVR u64 value: String)
        postGuardVarId: (MapVV u64 value: ztypes.vid)
        postGuardRecv: (MapVR u64 value: String)
        postGuardTid: (MapVV u64 value: ztypes.tid)
        postGuardArm: (MapVR u64 value: String)
        nsOwnerTid: ztypes.tid
        nsOwnerName: "".string
        nsOwnerDeclId: ztypes.declid
        nsOwnerUnit: "".string
        nsOwnerIsSubunit: false
        pendingCustomTag: (MapVR u64 value: String)
        pendingCustomTagNode: (MapVV u64 value: u64)
        pendingDefaultOwner: (MapVV u64 value: u64)
        pendingDefaultId: (MapVV u64 value: u64)
        pendingDefaultName: (MapVR u64 value: String)
        constructedTypes: (MapVV u64 value: bool)
        collectionChildrenBuilt: (MapVV u64 value: bool)
        pendingUnitWalk: (List PendingUnitWalk)
        unitMonoWalksPending: (MapVV u64 value: bool)
        argDisposition: (MapVV u64 value: ztypes.zparamownership)
        genericArgTypeBy: (MapVV u64 value: u64)
        callGenericBinding: (MapVV u64 value: u64)
        binopOwner: (MapVV u64 value: ztypes.tid)
        binopMethod: (MapVV u64 value: ztypes.tid)
        monoBinopOwner: (MapVV u64 value: ztypes.tid)
        monoBinopMethod: (MapVV u64 value: ztypes.tid)
        # measured self-compile: ~0.6 stamps/node -- capacity nodeEst
        # holds 2/3*nodeEst entries before the first grow
        nodeType: (ListVal ztypes.tid capacity: nodeEst + (nodeEst / 4))
        callKind: (MapVV u64 value: zast.callkind)
        atomVariableId: (MapVV u64 value: ztypes.vid capacity: nodeEst / 4)
        variableMutated: (MapVV ztypes.vid value: bool)
        variableMoved: (MapVV ztypes.vid value: bool)
        aliasInternalName: (MapVR u64 value: String)
        implicitCreate: (MapVV u64 value: u64)
        variableZtype: (MapVV u64 value: u64)
        variableOwnership: (MapVV u64 value: ztypes.zownership)
        variableOrigin: (MapVV u64 value: bool)
        variableIsPrivate: (MapVV u64 value: bool)
        variableBorrowOrigin: (MapVR u64 value: String)
        variableSynthOrigin: (MapVR u64 value: String)
        funcReturnNode: (MapVV u64 value: u64)
        defVariableId: (MapVV u64 value: ztypes.vid)
        nodeConst: (MapVV u64 value: ztypes.cval)
        memberConst: (MapVV u64 value: ztypes.cval)
        constEvalState: (MapVV u64 value: u8)
        constStrings: (List String)
        foldedBranch: (MapVV u64 value: foldedbranch)
        constFail: ztypes.noConstFail
        conformance: (List ztypes.ZConformance)
        preludeUnit: (Map String value: String)
        eagerAll: false
        requireMain: true
        ccPath: "".string
        ccMode: "".string
        targetTriple: "".string
        defNodeIndexBuilt: false
        preIndexDefined: (SetVal u64)
        copyOptOut: (SetVal u64)
        ordinalVariant: (MapVV u64 value: u64)
        sumPairFirstArm: (MapVV u64 value: u64)
        sumPairSecondArm: (MapVV u64 value: u64)
        variantTagBase: (MapVV u64 value: u64)
        systemUnitTid: ztypes.tid
        systemUnitRoot: ztypes.declid
        nullTypeId: 0
        nativeLinkTargetsDone: false
        pendingTyperef: (MapVR u64 value: String)
        pendingTyperefUnit: (MapVR u64 value: String)
        unitTypesById: (MapVV u64 value: ztypes.tid)
        decls: (List Decl)
        declByTypeId: (MapVV u64 value: ztypes.declid)
        unitRootByName: (MapVV u64 value: ztypes.declid)
        refDecl: (MapVV u64 value: ztypes.declid)
        declProxyTids: (ListVal ztypes.tid)
        declProxyUnits: (List String)
        pendParent: (ListVal u64)
        pendName: (ListVal u64)
        pendType: (ListVal u64)
        errors: (List zast.ErrorData)
        currentReturnTypeId: ztypes.tid
        isError: false)
}

# a bool rendered as "true" or "false".
boolText: function {b: bool} out String is {
    match (
        b
    ) case true then {
        return "true".string
    } case false then {
        return "false".string
    }
}

# Render an (optionval u64) as its value text or "none".
optU64Text: function {o: optionval u64} out String is {
    match (
        o
    ) case some then {
        return "\{o}"
    } case none then {
        return "none".string
    }
}

# --- smoke harness ---
# Every name-bearing query goes through a helper that takes the name as a
# param (a string literal cannot be nested inside an interpolation), and the
# raw Map.get stamp reads are matched inline (the get result type is the
# native Map option, distinct from the methods' (optionval t: u64)).

# standalone entry point for the ztyping smoke tests.
main: function is {
    reg: ztypes.newRegistry
    tPoint: reg.newType name: "point" typetype: ztypes.ztypetype.recordType
    tInt: reg.newType name: "i64" typetype: ztypes.ztypetype.recordType
    tStr: reg.newType name: "String" typetype: ztypes.ztypetype.classType
    tList: reg.newType name: "List" typetype: ztypes.ztypetype.classType
    pid: tPoint
    lid: tList

    ty: newTyping
    pool9: zast.StringPool.create

    # the per-member metadata setters record onto member DECLARATIONS, so the
    # smoke declares the type and its fields the way the def indexer would.
    pDecl9: (ty.declNew
        name: (pool9.set s: "point")
        parent: ztypes.declid
        kind: declkind.typeDecl
        node: 0
    )
    ty.declSetType declId: pDecl9 typeId: pid
    ty.declNew name: (pool9.set s: "x") parent: pDecl9 kind: declkind.fieldDecl node: 0
    ty.declNew name: (pool9.set s: "y") parent: pDecl9 kind: declkind.fieldDecl node: 0
    ty.declNew name: (pool9.set s: "label") parent: pDecl9 kind: declkind.fieldDecl node: 0
    # a function / arm default names its target by DeclId, so the targets have
    # to be declared for the defaults below to resolve to anything
    mkDecl9: (ty.declNew
        name: (pool9.set s: "makeY")
        parent: ztypes.declid
        kind: declkind.funcDecl
        node: 0
    )
    armDecl9: (ty.declNew
        name: (pool9.set s: "none")
        parent: ztypes.declid
        kind: declkind.armDecl
        node: 0
    )

    print "=== children ==="
    ty.setMemberType parentTypeId: pid nameId: (pool9.set s: "x") childTypeId: tInt
    ty.setMemberType parentTypeId: pid nameId: (pool9.set s: "y") childTypeId: tInt
    ty.setMemberType parentTypeId: pid nameId: (pool9.set s: "label") childTypeId: tStr
    ty.setMemberType parentTypeId: pid nameId: (pool9.set s: "x") childTypeId: tInt

    print "memberCount point -> \{ty.declMemberCount ownerTid: pid}"
    smokeHasChild pool: pool9 :ty :pid name: "x"
    smokeHasChild pool: pool9 :ty :pid name: "z"
    smokeChildOf pool: pool9 :ty :pid name: "x"
    smokeChildOf pool: pool9 :ty :pid name: "label"
    smokeChildOf pool: pool9 :ty :pid name: "z"
    dumpChildren :ty pool: pool9 parentTypeId: pid

    print "=== member metadata ==="
    ty.setChildLockField pool: pool9 parentTypeId: pid name: "y"
    ty.setDefaultFunction pool: pool9 parentTypeId: pid name: "y" targetDecl: mkDecl9
    (ty.setDefaultVariantArm
        pool: pool9
        parentTypeId: pid
        name: "label"
        targetDecl: armDecl9
    )
    (ty.setChildOwnership
        pool: pool9
        parentTypeId: pid
        name: "x"
        ownership: ztypes.zparamownership.takeMode
    )
    (ty.setChildOwnership
        pool: pool9
        parentTypeId: pid
        name: "y"
        ownership: ztypes.zparamownership.borrowMode
    )

    smokeIsLockField pool: pool9 :ty :pid name: "y"
    smokeDefault pool: pool9 :ty :pid name: "x"
    smokeDefault pool: pool9 :ty :pid name: "y"
    smokeDefault pool: pool9 :ty :pid name: "label"
    smokeOwn pool: pool9 :ty :pid name: "x"
    smokeOwn pool: pool9 :ty :pid name: "y"
    smokeOwn pool: pool9 :ty :pid name: "label"

    print "=== generic args ==="
    ty.setGenericArg pool: pool9 parentTypeId: lid paramName: "of" argTypeId: tInt
    ty.setGenericArg pool: pool9 parentTypeId: lid paramName: "of" argTypeId: tStr
    smokeGenericArg pool: pool9 :ty pid: lid name: "of"
    print "hasGenericArgs List -> \{boolText (ty.hasGenericArgs parentTypeId: lid)}"
    print "hasGenericArgs point -> \{boolText (ty.hasGenericArgs parentTypeId: pid)}"

    print "=== node stamps ==="
    stagedStr: tStr
    nodeTypeSet tbl: ty.nodeType nid: 100 tid: stagedStr
    nt: nodeTypeAt tbl: ty.nodeType nid: 100
    if nt > 0 then {
        print "nodeType[100] -> \{nt}"
    } else {
        print "nodeType[100] -> none"
    }
    ty.callKind.set key: 101 value: zast.callkind.recordCreate
    ck: ty.callKind.get key: 101
    match (
        ck
    ) case some then {
        print "callKind[101] -> \{zast.callkindname ck}"
    } case none then {
        print "callKind[101] -> none"
    }
    ty.atomVariableId.set key: 103 value: (ztypes.vid.create from: 42)
    av: ty.atomVariableId.get key: 103
    match (
        av
    ) case some then {
        print "atomVariableId[103] -> \{av}"
    } case none then {
        print "atomVariableId[103] -> none"
    }

    print "=== node tables ==="
    k0: ztypes.makeIntConst 1024.i64
    ty.nodeConst.set key: 200 value: k0
    ty.nodeConst.set key: 201 value: (ztypes.makeArmConst
        armTid: (ztypes.tid.create from: 30)
        armName: (zast.nameid.create from: 70)
    )
    (ty.setMemberConst
        parentTypeId: pid
        nameId: (zast.nameid.create from: 9)
        value: (ztypes.makeStrConst 4.u32)
    )
    dumpNodeConst :ty
    mc: ty.memberConstOf parentTypeId: pid nameId: (zast.nameid.create from: 9)
    print "  memberConst[point.#9] kind=\{ztypes.zconstkindName mc.kind} strId=\{mc.strId}"
    mx: ty.memberConstOf parentTypeId: pid nameId: (zast.nameid.create from: 10)
    print "  memberConst[point.#10] kind=\{ztypes.zconstkindName mx.kind}"

    print "=== aggregates ==="
    cf: reg.newConformance implTypeId: pid specTypeId: lid label: "drawable" isFacet: false
    ty.conformance.append cf
    dumpConformance :ty
    print "isError -> \{boolText ty.isError}"
}

# smoke-test: print whether type `pid` has a child named `name`.
smokeHasChild: function {pool: zast.StringPool ty: ZTyping pid: u64 name: StringView} is {
    nid9: pool.find s: name
    b: false
    if nid9 > 0 then b = (ty.declHasMemberId
        parentTypeId: (ztypes.tid.create from: pid.u64)
        nameId: nid9
    )
    print "hasMember point.\{name} -> \{boolText b}"
}

# smoke-test: print the child type id of `pid`'s member `name`.
smokeChildOf: function {pool: zast.StringPool.view ty: ZTyping pid: u64 name: StringView} is {
    r: ty.declChildOf :pool parentTypeId: (ztypes.tid.create from: pid.u64) :name
    print "childOf point.\{name} -> \{optU64Text r}"
}

# smoke-test: print whether member `name` of `pid` is a lock field.
smokeIsLockField: function {pool: zast.StringPool.view ty: ZTyping pid: u64 name: StringView} is {
    b: ty.declIsLockField :pool parentTypeId: (ztypes.tid.create from: pid.u64) :name
    print "isLockField point.\{name} -> \{boolText b}"
}

# smoke-test: print the default value of member `name` of `pid`.
smokeDefault: function {pool: zast.StringPool.view ty: ZTyping pid: u64 name: StringView} is {
    d: ty.declDefaultText :pool parentTypeId: (ztypes.tid.create from: pid.u64) :name
    print "default point.\{name} -> \{d}"
}

# smoke-test: print the ownership of member `name` of `pid`.
smokeOwn: function {pool: zast.StringPool.view ty: ZTyping pid: u64 name: StringView} is {
    o: ty.declOwnershipText :pool parentTypeId: (ztypes.tid.create from: pid.u64) :name
    print "ownership point.\{name} -> \{o}"
}

# smoke-test: print the generic-argument bound for `name` on `pid`.
smokeGenericArg: function {pool: zast.StringPool.view ty: ZTyping pid: u64 name: StringView} is {
    r: ty.genericArgOf :pool parentTypeId: (ztypes.tid.create from: pid.u64) paramName: name
    print "genericArg List.\{name} -> \{optU64Text r}"
}

# smoke-test: print every declared member of parent type `parentTypeId`.
dumpChildren: function {ty: ZTyping pool: zast.StringPool.view parentTypeId: ztypes.tid} is {
    nms9: (ListVal u64)
    tds9: (ListVal u64)
    ty.declMemberList ownerTid: parentTypeId names: nms9 tids: tds9
    i9: u64
    n9: nms9.length
    for i9 < n9 loop {
        rnB9: pool.texts.get i: ((nms9.get i: i9) - 1)
        print "  child \{i9} \{rnB9} -> \{tds9.get i: i9}"
        i9 = i9 + 1
    }
}

# smoke-test: print the node-constant table. Takes the mutable typing because
# a map's item iterator borrows its receiver, as appendAtomStamps does.
dumpNodeConst: function {ty: ZTyping} is {
    with iter: ty.nodeConst.iterateItems do for row: iter loop {
        print "  const node=\{row.key} kind=\{ztypes.zconstkindName row.value.kind} ival=\{row.value.ival} armName=\{row.value.armName}"
    }
}

# smoke-test: print the recorded protocol conformances.
dumpConformance: function {ty: ZTyping.view} is {
    iter: ty.conformance.iterate
    for row: iter loop {
        print "  conf id=\{row.conformanceId} impl=\{row.implTypeId} spec=\{row.specTypeId} label=\{row.label}"
    }
}
