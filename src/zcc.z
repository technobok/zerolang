# zcc -- the C compiler a build hands its C to: which family it is, and how that
# family spells the parts of a command line that differ between families. A
# DRIVER's fact, read by zc, the C backend and the test runner alike, so it is
# a leaf: it opens nothing of the compiler, and the runner builds without the
# type checker.

# Public interface -- the definitions other units may reference; all other
# top-level definitions are private to this unit.
public: unit {
    :ccfamily
    :ccFamilyOf
    :ccFamilyName
    :msvcFlags
    :msvcPath
    :outputArgs
    :objectArgs
    :libraryArg
    :objectExt
    :spawnCompiler
}

# ccfamily -- the C compiler a build hands its C to, by family: what the C
# backend asks when a unit needs something only some compilers have, and what
# a driver asks for the flags it passes.
ccfamily: variant {
    # GCC, reached by spawning it
    gcc: null
    # Clang, spawned like GCC
    clang: null
    # the vendored tcc, which compiles in-process as well as by spawn
    tcc: null
    # Microsoft's cl, which spells its options `-name:value` and links
    # libraries named `<name>.lib`
    msvc: null
    # a C compiler the build does not name
    other: null
}

# ccFamilyOf -- the family a resolved compiler PATH names, by basename. By name
# alone: probing --version would put a subprocess in every compile, so a --cc
# pointing at a wrapper script reads as `other`. `tcc` is tested before `cc`
# and `clang` before `gcc`, since the shorter spelling is a substring of paths
# naming the longer; cl is matched whole, since `cl` is part of `clang`.
ccFamilyOf: function {ccPath: StringView} out ccfamily is {
    b: path.baseName p: ccPath
    if (b.contains needle: "tcc") then return ccfamily.tcc
    if (b.contains needle: "clang") then return ccfamily.clang
    if (b.contains needle: "gcc") then return ccfamily.gcc
    for each s9c: msvcNames loop {
        if s9c == b then return ccfamily.msvc
    }
    return ccfamily.other
}

# msvcNames -- the basenames cl answers to, matched whole
msvcNames: list { "cl" "cl.exe" } out staticlist StringView

# ccFamilyName -- a family as the word natives.tbl spells it in `nocc=`.
ccFamilyName: function {f: ccfamily} out StringView is {
    if f.tcc then return "tcc"
    if f.clang then return "clang"
    if f.gcc then return "gcc"
    if f.msvc then return "msvc"
    return "other"
}

# msvcFlags -- what every cl command line carries: no banner, ISO C17, the C11
# atomics the thread shim uses (an experimental switch in cl 19.51), and source
# and execution text in UTF-8, as the emitted C is.
msvcFlags: function {} out List String is {
    a: List String
    a.append from: "-nologo".string
    a.append from: "-std:c17".string
    a.append from: "-experimental:c11atomics".string
    a.append from: "-utf-8".string
    return a
}

# msvcPath -- a path as cl is handed it. cl, and the link.exe it runs, read an
# argument starting with `/` as an option, and a POSIX absolute path starts so;
# cl runs on a POSIX host only under wine, whose drive Z: is the root, so such a
# path is spelled `Z:/...`. Any other path is cl's to read as it is.
msvcPath: function {p: StringView} out String is {
    if (p.startsWith prefix: "/") then return "Z:\{p}"
    return p.string
}

# outputArgs -- the arguments naming the executable a compile writes.
outputArgs: function {f: ccfamily exe: StringView} out List String is {
    a: List String
    if f.msvc then {
        a.append from: "-Fe:\{msvcPath p: exe}"
        return a
    }
    a.append from: "-o".string
    a.append from: exe.string
    return a
}

# objectArgs -- the arguments compiling the C file `src` to the object `obj`
# without linking: `-c src -o obj`, or cl's `-c src -Fo:obj`.
objectArgs: function {f: ccfamily src: StringView obj: StringView} out List String is {
    a: List String
    a.append from: "-c".string
    if f.msvc then {
        a.append from: (msvcPath p: src)
        a.append from: "-Fo:\{msvcPath p: obj}"
        return a
    }
    a.append from: src.string
    a.append from: "-o".string
    a.append from: obj.string
    return a
}

# libraryArg -- the argument linking the library `name`: `-l<name>`, or
# `<name>.lib` for cl.
libraryArg: function {f: ccfamily name: StringView} out String is {
    if f.msvc then return "\{name}.lib"
    return "-l\{name}"
}

# objectExt -- the extension of an object file the family writes: `.obj` for
# cl, which reads any other as a source it does not know (D9024), `.o` else.
objectExt: function {f: ccfamily} out StringView is {
    if f.msvc then return ".obj"
    return ".o"
}

# spawnCompiler -- run the compile `argv` of family `f` on the C file `src`,
# its diagnostics on stderr, and answer its exit status. cl names each C file
# it compiles on its standard output, and writes its warnings and errors there
# too: that output is read back from the file `scratch`, the name dropped and
# the rest written to stderr. Every other family writes to the terminal's own
# streams.
spawnCompiler: function {
    argv: List String f: ccfamily src: StringView scratch: StringView
} out i32 is {
    if f.msvc.not then return (os.spawn :argv cwd: "" outPath: "" errPath: "" timeoutSecs: 0)
    rc: os.spawn :argv cwd: "" outPath: scratch errPath: "" timeoutSecs: 0
    said: io.readText path: scratch
    if said.ok then {
        cn: path.baseName p: src
        for each ln: said.stringView.lines loop {
            if ln != cn then io.eprintln ln
        }
    }
    rm: io.remove path: scratch
    rm.drop
    return rc
}
