# zls -- the zerolang language server (LSP 3.17 subset). Speaks
# JSON-RPC 2.0 with Content-Length framing over stdio (`--stdio`, the
# default) or a framed input file (`--replay`, the test harness's
# transport; os.spawn cannot pipe a child's stdin while capturing its
# output). Documents sync with full text; every didOpen/didChange runs
# zcheck.check with the open buffers overlaid on disk and publishes
# diagnostics. Positions negotiate utf-32 (matching the compiler's
# codepoint columns) and fall back to utf-16 conversion.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

Value: json.Value
Obj: json.Obj
Arr: json.Arr
Ast: zast.Ast

# Transport -- the byte source/sink the server is framed over. stdio reads
# fd 0 and writes fd 1; replay reads a file and writes fd 1 (the harness
# captures stdout); tcp reads and writes one accepted connection. The Server
# owns this union, so the accepted Conn / open File has exactly one owner and
# both the reader and writer reach it through short-lived borrows.
Transport: union {
    # the ordinary editor connection: framed messages over stdin and stdout
    stdio: null
    # a recorded session read from a file, which is what the LSP goldens drive
    replay: io.File
    # a socket connection, for an editor that attaches over one
    tcp: net.Conn
}

# ---- small builders -------------------------------------------------

# a fresh empty JSON object.
newObj: function out Obj is {
    return (Obj entries: (Map String V: Value) keys: List String)
}

# a fresh empty JSON array.
newArr: function out Arr is {
    return (Arr items: List Value)
}

# ---- uri <-> path ---------------------------------------------------

# the value of hex-digit byte `b`, or -1 when not a hex digit.
hexNibble: function {b: u8} out i64 is {
    if b >= 48 when b <= 57 then return b - 48
    if b >= 97 when b <= 102 then return b - 87
    if b >= 65 when b <= 70 then return b - 55
    return -1
}

# uriToPath -- "file:///a/b%20c.z" -> "/a/b c.z". Non-file URIs return "".
# The host "localhost" is this machine: "file://localhost/a" -> "/a". On
# Windows a drive path is native: "file:///C:/a/b.z" (or "file:///c%3A/...")
# -> "C:\a\b.z", and any other host is a share: "file://srv/share/x" ->
# "\\srv\share\x", as VS Code and Rust's url crate read it. Elsewhere such
# a host keeps its text, read from the working directory.
uriToPath: function {uri: StringView} out String is {
    if (uri.startsWith "file://").not then return "".string
    r: String
    i: 7.u64
    if uri.startsWith "file://localhost/" then i = 16
    n: uri.length
    for i < n loop {
        bo: uri.byteAt :i
        match (
            bo
        ) case some then {
            if bo == 37 when (i + 2) < n then {
                h1: i64
                h2: i64
                b1: uri.byteAt i: i + 1
                match (
                    b1
                ) case some then {
                    h1 = hexNibble b: b1
                } case none then null
                b2: uri.byteAt i: i + 2
                match (
                    b2
                ) case some then {
                    h2 = hexNibble b: b2
                } case none then null
                if h1 >= 0 when h2 >= 0 then {
                    r.appendByte b: ((h1 << 4) | h2).u8.orPanic
                    i = i + 2
                } else {
                    r.appendByte b: bo
                }
            } else {
                r.appendByte b: bo
            }
        } case none then null
        i = i + 1
    }
    if z.build.os == z.build.oskind.windows then return (windowsPathOfUri p: r.stringView)
    return r
}

# windowsPathOfUri -- a file URI's decoded path (what follows "file://") as
# Windows spells it: a drive path "/C:/x" drops its leading "/", a host
# "srv/share/x" is the share "\\srv\share\x", and path.clean writes the
# native separators; any other is as written
windowsPathOfUri: function {p: StringView} out String is {
    if (p.startsWith "/").not then {
        share: "//\{p}"
        return (path.clean p: share.stringView)
    }
    if ((p.byteAt i: 2).or d: 0) != 58 then return p.string
    drive: p.substring from: 1 to: p.length
    return (path.clean p: drive)
}

# pathToUri -- absolute path -> file:// URI (no percent-encoding; the
# workspace paths this serves are plain). On Windows the separators become "/",
# a drive path gains the leading "/" (file:///C:/x), a share names its server
# as the host (\\srv\share\x -> file://srv/share/x), and the verbatim prefix
# is dropped (\\?\C:\x -> file:///C:/x, \\?\UNC\srv\share -> file://srv/share).
pathToUri: function {file: StringView} out String is {
    r: "file://".string
    if z.build.os == z.build.oskind.windows then {
        fwd: path.toSlash p: file
        v: fwd.stringView
        if (v.startsWith prefix: "//?/") then {
            v = v.substring from: 4 to: v.length
            un: v.stripPrefix p: "UNC/"
            match (
                un
            ) case some then {
                r.append un
                return r
            } case none then null
        }
        share: v.stripPrefix p: "//"
        match (
            share
        ) case some then {
            r.append share
            return r
        } case none then null
        if ((v.byteAt i: 1).or d: 0) == 58 then r.append "/"
        r.append v
        return r
    }
    r.append file
    return r
}

# relPathOf -- path relative to a provider root ("" when outside it), in
# "/"-separated form, the provider's own
relPathOf: function {file: StringView srcDir: StringView} out String is {
    if srcDir.length == 0 then return "".string
    pn: path.toSlash p: file
    pre: path.toSlash p: srcDir
    pre.append "/"
    pv: pre.stringView
    if pn.stringView.startsWith pv then return (pn.stringView.substring
        from: pre.length
        to: pn.length
    ).string
    return "".string
}

# relPathBest -- the document's path relative to the provider root that OWNS
# it: the most specific of the two, not the first that matches. srcDir and
# systemDir need not be disjoint -- a srcDir of the repo root has lib/system
# nested inside it -- and there srcDir matches a system file first and yields
# `lib/system/io.z`, while the system provider names that same file `io.z`.
# Nothing matches it after that, so every span row for the file is filtered
# out and hover, definition, references and completion all answer null on
# every position, including declarations in the file being edited.
relPathBest: function {
    path: StringView
    srcDir: StringView
    systemDir: StringView
} out String is {
    a: relPathOf file: path :srcDir
    b: relPathOf file: path srcDir: systemDir
    if a.length == 0 then return b
    if b.length == 0 then return a
    # both roots contain the file, so the deeper one owns it -- and the deeper
    # root is the one that leaves the shorter path behind.
    if b.length < a.length then return b
    return a
}

# ResolvedRoots -- the two directories zls checks against, each with the
# channel that decided it. The path alone cannot say WHY it was chosen, and a
# misconfigured session looks identical to a correct one from the outside: the
# only way to tell a `$ZEROLANG_SYSTEM` pointing at another checkout from the
# auto-detected one is to ask the server which channel it used.
ResolvedRoots: class {
    # the project's src directory as resolved
    srcDir: String
    # the stdlib directory as resolved
    systemDir: String
    # HOW srcDir was chosen -- a flag, an environment variable, a guess from the
    # workspace. A wrong root is the most common reason an editor sees errors a
    # build does not, so the answer has to be reportable
    srcWhy: String
    # how systemDir was chosen, for the same reason
    systemWhy: String
    # whether a flag or initializationOptions named srcDir, which a document's
    # project then does not override
    srcExplicit: bool
    # whether a flag or initializationOptions named systemDir
    systemExplicit: bool
}

# resolveRoots -- the session's roots, resolved once at `initialize`.
# Precedence: CLI flags > initializationOptions > rootUri itself > cwd. A
# document inside a project (a project.z at or above its directory) is checked
# against that project's roots instead, wherever no flag or option named them
# (Server.enterProjectOf).
resolveRoots: function {
    srcFlag: StringView
    sysFlag: StringView
    optSrc: StringView
    optSys: StringView
    rootPath: StringView
} out ResolvedRoots is {
    sd: String
    syd: String
    sw: String
    yw: String
    if srcFlag.length > 0 then {
        sd = srcFlag.string
        sw = "--src flag".string
    }
    if sysFlag.length > 0 then {
        syd = sysFlag.string
        yw = "--system flag".string
    }
    if sd.length == 0 when optSrc.length > 0 then {
        sd = optSrc.string
        sw = "initializationOptions.srcDir".string
    }
    if syd.length == 0 when optSys.length > 0 then {
        syd = optSys.string
        yw = "initializationOptions.systemDir".string
    }
    srcExplicit: sd.length > 0
    systemExplicit: syd.length > 0
    if sd.length == 0 then {
        if rootPath.length > 0 then {
            sd = rootPath.string
            sw = "rootUri itself, for a document in no project".string
        } else {
            # the literal "." cannot work: relPathOf tests a "./" prefix
            # against the document's absolute path and never matches, so every
            # document would fall outside every root.
            cw: os.cwd
            match (
                cw
            ) case ok then {
                sd = cw.copy
                sw = "cwd (the client sent no rootUri)".string
            } case err then {
                sd = ".".string
                sw = "cwd unreadable (the client sent no rootUri)".string
            }
        }
    }
    if syd.length == 0 then {
        # resolveSystemDir stays the one resolver; the label below only mirrors
        # the order it already applies, so the report names the channel without
        # a second copy of the path-building.
        syd = zcheck.resolveSystemDir flagVal: ""
        yw = "the lib/system beside the zls executable".string
        rv: os.env key: "ZEROLANG_ROOT"
        match (
            rv
        ) case some then {
            yw = "$ZEROLANG_ROOT/lib/system".string
        } case none then null
        ev: os.env key: "ZEROLANG_SYSTEM"
        match (
            ev
        ) case some then {
            yw = "$ZEROLANG_SYSTEM".string
        } case none then null
    }
    return (ResolvedRoots
        srcDir: sd.take
        systemDir: syd.take
        srcWhy: sw.take
        systemWhy: yw.take
        :srcExplicit
        :systemExplicit
    )
}

# absRelPath -- absolute path for a provider-relative file: the srcDir
# join when it exists on disk, else the systemDir join when that does,
# else the srcDir join (unsaved new files).
absRelPath: function {rel0: StringView srcDir: StringView systemDir: StringView} out String is {
    sj: path.join a: srcDir b: rel0
    if (io.exists path: sj) then return sj
    yj: path.join a: systemDir b: rel0
    if (io.exists path: yj) then return yj
    return sj
}

# ---- position encoding ----------------------------------------------

# encodedCol -- 1-based codepoint column -> 0-based column in the
# negotiated encoding, measured over `lineText`. utf-32 columns equal
# codepoint counts; utf-16 pays one extra unit per astral codepoint.
encodedCol: function {lineText: StringView cpCol1: u32 utf32: bool} out u32 is {
    if cpCol1 == 0 then return 0
    target: (cpCol1 - 1).u64
    if utf32 then return (cpCol1 - 1).u32
    units: u32
    idx: u64
    for each cp: lineText.codepoints loop {
        if idx >= target then break
        if cp >= 65536 then {
            units = units + 2
        } else {
            units = units + 1
        }
        idx = idx + 1
    }
    # columns past the end of the line degrade to the line's width in
    # units plus the shortfall (whitespace-only overhang)
    if idx < target then units = units + (target - idx).u32.orPanic
    return units
}

# ---- transport i/o -------------------------------------------------

# transportRead -- fill `into` with up to 64 KiB from the active transport;
# each arm dispatches the concrete Reader (stdio's fd 0, the replay File, or
# the tcp Conn). Matching the bare `tp` param narrows the arm.
transportRead: function {tp: Transport into: Bytes} out (ResultVR u64 E: IoError) is {
    match (
        tp
    ) case tcp then {
        return (tp.read :into max: 65536)
    } case replay then {
        return (tp.read :into max: 65536)
    } case stdio then {
        r: io.stdin
        return (r.read :into max: 65536)
    }
}

# transportWrite -- write `bv` to the active transport: the tcp Conn, else
# fd 1 (stdio and replay both answer on stdout).
transportWrite: function {tp: Transport bv: ByteView} out (ResultVR u64 E: IoError) is {
    match (
        tp
    ) case tcp then {
        return (tp.write from: bv)
    } else {
        w: io.stdout
        return (w.write from: bv)
    }
}

# transportReadable -- whether the transport's input has a message (or its
# end) within `millis`: the socket's own poll, else standard input's, read
# through a File over fd 0 that does not own it. Replay never asks (a file is
# always readable).
transportReadable: function {tp: Transport.view millis: i32} out (ResultVR bool E: IoError) is {
    match (
        tp
    ) case tcp then {
        return (tp.pollReadable timeoutMillis: millis)
    } else {
        stdinFile: io.File fd: 0 open: false
        return (stdinFile.pollReadable timeoutMillis: millis)
    }
}

# ---- json-rpc send -------------------------------------------------
# The send helpers take the transport by argument (not off `this`): a
# caller passes `tp: this.transport`, a leaf disjoint from `this.docs` /
# `this.snapshots`, so sending stays legal while those fields are locked
# (e.g. publishAll sends inside a docs iteration).

# write every byte of `s`, looping until the transport has taken them all: a
# single write may take fewer than it was offered, and a partial LSP frame is
# a protocol error rather than a short message.
writeAll: function {s: StringView tp: Transport} is {
    b: Bytes
    i: u64
    n: s.length
    for i < n loop {
        bo: s.byteAt :i
        match (
            bo
        ) case some then {
            b.append from: bo
        } case none then null
        i = i + 1
    }
    bv: b.byteView
    wr: transportWrite :tp :bv
    match (
        wr
    ) case ok then null case err then {
        io.eprintln "zls: transport write failed"
    }
}

# frame `body` with a Content-Length header and send it.
frameAndSend: function {body: String tp: Transport} is {
    blen: body.length
    m: "Content-Length: \{blen}"
    m.appendByte b: 13
    m.appendByte b: 10
    m.appendByte b: 13
    m.appendByte b: 10
    m.append body
    writeAll s: m.stringView :tp
}

# send a JSON-RPC success response for request `id`.
sendResult: function {id: Value.take result: Value.take tp: Transport} is {
    o: newObj
    o.set key: "jsonrpc".string value: Value.text "2.0".string
    o.set key: "id".string value: id
    o.set key: "result".string value: result
    root: Value.object o
    body: json.serialize v: root
    frameAndSend :body :tp
}

# send a JSON-RPC error response for request `id`.
sendError: function {id: Value.take code: i64 message: StringView tp: Transport} is {
    e: newObj
    e.set key: "code".string value: Value.intval code
    e.set key: "message".string value: Value.text message.string
    o: newObj
    o.set key: "jsonrpc".string value: Value.text "2.0".string
    o.set key: "id".string value: id
    o.set key: "error".string value: Value.object e
    root: Value.object o
    body: json.serialize v: root
    frameAndSend :body :tp
}

# send a JSON-RPC notification.
sendNotification: function {method: StringView params: Value.take tp: Transport} is {
    o: newObj
    o.set key: "jsonrpc".string value: Value.text "2.0".string
    o.set key: "method".string value: Value.text method.string
    o.set key: "params".string value: params
    root: Value.object o
    body: json.serialize v: root
    frameAndSend :body :tp
}

# idValueOf -- the request id as a fresh Value (int, string, or null).
idValueOf: function {msg: Value.view} out Value is {
    f: json.at v: msg path: "id"
    k: f.kind
    match (
        k
    ) case intval then {
        return (Value.intval f.i)
    } case text then {
        return (Value.text f.s.copy)
    } else {
        return Value.nul
    }
}

# ---- header parsing -------------------------------------------------

# the byte count parsed from a `Content-Length:` header line.
parseContentLength: function {line: StringView} out u64 is {
    lower: line.toLowerAscii
    lv: lower.stringView
    if lv.startsWith "content-length:" then {
        rest: lv.substring from: 15 to: lv.length
        t: rest.trim
        pr: t.parseU64
        match (
            pr
        ) case ok then {
            return pr
        } case err then {
            return 0
        }
    }
    return 0
}

# ---- document + server ----------------------------------------------

# one open text document: its uri, version, and current text.
Document: class {
    # the editor's identifier for the file, which is what every request names it
    # by
    uri: String
    # the same file as a filesystem path
    path: String
    # its path relative to the project root, which is what diagnostics report
    relpath: String
    # the src root of the project it belongs to, which its relpath is relative
    # to; documents of one project are checked together
    srcDir: String
    # that project's stdlib directory
    systemDir: String
    # the buffer's CURRENT contents, which may differ from what is on disk --
    # that difference is the whole reason the server keeps documents
    text: String
    # the editor's version counter, so a stale response can be recognised as
    # stale
    version: i64
}

# zlsWord -- every word zls reads off outside text: its command-line flags, the
# JSON-RPC methods it answers, the position encoding it negotiates and the
# completion trigger it reads. A word is classified by its slot here
# (zast.Vocab), never by comparing its text.
zlsWord: list {
    mInitialize: "initialize"
    mInitialized: "initialized"
    mShutdown: "shutdown"
    mExit: "exit"
    mDidOpen: "textDocument/didOpen"
    mDidChange: "textDocument/didChange"
    mDidClose: "textDocument/didClose"
    mDefinition: "textDocument/definition"
    mHover: "textDocument/hover"
    mReferences: "textDocument/references"
    mCompletion: "textDocument/completion"
    mResolve: "completionItem/resolve"
    mSignatureHelp: "textDocument/signatureHelp"
    mFormatting: "textDocument/formatting"
    mDocumentSymbol: "textDocument/documentSymbol"
    encUtf32: "utf-32"
    fV: "-V"
    fVersion: "--version"
    fStdio: "--stdio"
    fReplay: "--replay"
    fSrc: "--src"
    fSystem: "--system"
    fListen: "--listen"
    fHelp: "--help"
    trigSpace: " "
} out staticlist StringView

# the language-server state: open documents, the project dirs, and the check cache.
Server: class {
    # the words zls classifies outside text by (zlsWord)
    words: zast.Vocab
    # the open buffers by uri
    docs: (Map String V: Document)
    # the src root of the project in hand that holds the document being checked
    # or answered for (enterProjectOf)
    srcDir: String
    # every src root of the project in hand, `srcDir` first
    srcDirs: List String
    # the stdlib root of the project in hand
    systemDir: String
    # the session's src root (resolveRoots), for a document in no project
    baseSrcDir: String
    # the session's stdlib root
    baseSystemDir: String
    # whether a flag or initializationOptions named srcDir, which no project
    # overrides
    srcExplicit: bool
    # whether a flag or initializationOptions named systemDir
    systemExplicit: bool
    # the generated `z` unit of the project in hand
    layer: zcheck.GenLayer
    # the src root as given on the command line, kept apart from the resolved
    # one so the resolution can be explained
    srcFlag: String
    # the stdlib root as given on the command line
    sysFlag: String
    # whether the client negotiated UTF-32 positions. LSP counts in UTF-16 by
    # default and the compiler counts bytes, so this decides which conversion
    # every position goes through
    encUtf32: bool
    # whether `initialize` has completed; a request before it is a protocol
    # error
    initialized: bool
    # whether `shutdown` has been received, after which only `exit` is legal
    shutdownReq: bool
    # whether the message loop should continue
    running: bool
    # what to exit with, which the protocol makes depend on whether shutdown
    # came first
    exitCode: i32
    # bytes read but not yet consumed; a frame rarely arrives in one read
    inbuf: Bytes
    # how far into inbuf the parse has reached
    inpos: u64
    # where messages come from and go to
    transport: Transport
    # true for stdio/tcp (coalesce an edit burst before rechecking); false
    # for replay so every sync message publishes inline (goldens stay stable)
    debounce: bool
    # open-doc uris awaiting a coalesced recheck (interactive mode only)
    dirty: (MapRV String v: bool)
    # last-good check per GROUP -- the relpath of the topmost unit a set of
    # open documents belongs to: a unit and its subunits share one check.
    # Navigation answers from these even while the live buffer is broken
    snapshots: (Map String V: zcheck.CheckResult)
    # each open document's group: the key of the check that answers for it
    docCheck: (Map String V: String)
    # each group's check by the unit it is rooted at
    snapMain: (Map String V: String)
    # the programs project.z lists, when the project in hand holds the
    # document being checked or answered for; none otherwise
    projPrograms: List String
    # each open document's project programs, as projPrograms read when it was
    # checked
    docPrograms: (Map String V: List String)
    # the generated `z` unit as each of projPrograms reads it, by program
    entryLayers: (Map String V: zcheck.GenLayer)
    # each program, checked when a reference search needs it and no open
    # document's check is rooted there; dropped by the next recheck or close,
    # as any edit may change it. Keyed by the program's unit.
    entrySnap: (Map String V: zcheck.CheckResult)
} as {
    # ---- framed reader over the BufReader ----

    # one byte from the transport, refilling the buffer when it runs dry. none
    # means the connection ended
    needByte: function {:this} out optionval u8 is {
        for this.inpos >= this.inbuf.length loop {
            fresh: Bytes
            this.inbuf = fresh.take
            this.inpos = 0
            rr: transportRead tp: this.transport into: this.inbuf
            match (
                rr
            ) case ok then {
                if rr == 0 then return (optionval.none u8)
            } case err then {
                return (optionval.none u8)
            }
        }
        b: this.inbuf.get i: this.inpos
        this.inpos = this.inpos + 1
        return (optionval.some b)
    }

    # one LSP header line, up to its CRLF. none when the connection ended mid-
    # header
    readHeaderLine: function {:this} out Option String is {
        line: String
        for true loop {
            bo: this.needByte
            match (
                bo
            ) case some then {
                if bo == 10 then {
                    n: line.length
                    if n > 0 then {
                        lv: line.stringView
                        lb: lv.byteAt i: n - 1
                        match (
                            lb
                        ) case some then {
                            if lb == 13 then {
                                s2: (lv.substring from: 0 to: n - 1).string
                                return (Option.some s2)
                            }
                        } case none then null
                    }
                    return (Option.some line)
                }
                line.appendByte b: bo
            } case none then {
                return (Option.none String)
            }
        }
    }

    # exactly `n` bytes of message body, which Content-Length has already told
    # us to expect
    readBody: function {:this n: u64} out Option String is {
        body: String
        body.reserve :n
        i: u64
        for i < n loop {
            bo: this.needByte
            match (
                bo
            ) case some then {
                body.appendByte b: bo
            } case none then {
                return (Option.none String)
            }
            i = i + 1
        }
        return (Option.some body)
    }

    # readMessage -- one framed JSON-RPC payload; none at end of input.
    readMessage: function {:this} out Option String is {
        clen: u64
        for true loop {
            lo: this.readHeaderLine
            match (
                lo
            ) case some then {
                if lo.length == 0 then break
                lv: lo.stringView
                c: parseContentLength line: lv
                if c > 0 then clen = c
            } case none then {
                return (Option.none String)
            }
        }
        if clen == 0 then {
            io.eprintln "zls: message without Content-Length"
            return (Option.none String)
        }
        return (this.readBody n: clen)
    }

    # ---- dispatch ----

    # dispatch one decoded message to its handler, and answer it where the
    # protocol requires an answer
    handleMessage: function {:this msg: Value.view} is {
        mo: json.textAt v: msg path: "method"
        hasId: json.hasAt v: msg path: "id"
        match (
            mo
        ) case some then {
            mv: this.words.slotOf text: mo.stringView
            # the handshake's acknowledgement: a notification, with nothing to answer
            if mv == zlsWord.slot.mInitialized then return
            if mv == zlsWord.slot.mInitialize then {
                this.handleInitialize :msg
            } else if mv == zlsWord.slot.mShutdown then {
                this.shutdownReq = true
                idv: idValueOf :msg
                sendResult id: idv result: Value.nul tp: this.transport
            } else if mv == zlsWord.slot.mExit then {
                this.running = false
                if this.shutdownReq.not then this.exitCode = 1
            } else if mv == zlsWord.slot.mDidOpen then {
                this.handleDidOpen :msg
            } else if mv == zlsWord.slot.mDidChange then {
                this.handleDidChange :msg
            } else if mv == zlsWord.slot.mDidClose then {
                this.handleDidClose :msg
            } else if mv == zlsWord.slot.mDefinition then {
                this.handleNav :msg mode: 1
            } else if mv == zlsWord.slot.mHover then {
                this.handleNav :msg mode: 2
            } else if mv == zlsWord.slot.mReferences then {
                this.handleNav :msg mode: 3
            } else if mv == zlsWord.slot.mCompletion then {
                this.handleNav :msg mode: 4
            } else if mv == zlsWord.slot.mResolve then {
                this.handleResolve :msg
            } else if mv == zlsWord.slot.mSignatureHelp then {
                this.handleNav :msg mode: 5
            } else if mv == zlsWord.slot.mFormatting then {
                this.handleFormatting :msg
            } else if mv == zlsWord.slot.mDocumentSymbol then {
                this.handleDocSymbol :msg
            } else {
                if hasId then {
                    idv2: idValueOf :msg
                    sendError id: idv2 code: -32601 message: "method not found" tp: this.transport
                }
            }
        } case none then {
            io.eprintln "zls: message without method"
        }
    }

    # the handshake: resolve the project roots, negotiate position encoding, and
    # report what this server can do
    handleInitialize: function {:this msg: Value.view} is {
        # position encoding: utf-32 when the client offers it
        i: u64
        for true loop {
            pth: "params/capabilities/general/positionEncodings/\{i}"
            f: json.at v: msg path: pth.stringView
            k: f.kind
            done: false
            match (
                k
            ) case text then {
                if (this.words.slotOf text: f.s.stringView) == zlsWord.slot.encUtf32 then {
                    this.encUtf32 = true
                }
            } else {
                done = true
            }
            if done then break
            i = i + 1
        }
        # workspace discovery: CLI flags > initializationOptions > rootUri
        # auto-detect (zerolang repo layout) > cwd
        rootPath: String
        ro: json.textAt v: msg path: "params/rootUri"
        match (
            ro
        ) case some then {
            rootPath = uriToPath uri: ro.stringView
        } case none then null
        optSrc: String
        io1: json.textAt v: msg path: "params/initializationOptions/srcDir"
        match (
            io1
        ) case some then {
            optSrc = io1.copy
        } case none then null
        optSys: String
        io2: json.textAt v: msg path: "params/initializationOptions/systemDir"
        match (
            io2
        ) case some then {
            optSys = io2.copy
        } case none then null
        rr: (resolveRoots
            srcFlag: this.srcFlag.stringView
            sysFlag: this.sysFlag.stringView
            optSrc: optSrc.stringView
            optSys: optSys.stringView
            rootPath: rootPath.stringView
        )
        # The roots decide whether this server can answer anything at all, and
        # a wrong one looks exactly like a right one from the editor. Say what
        # was resolved and which channel decided it, every session, on STDERR:
        # stdout is the protocol channel, and an editor keeps server stderr in
        # its LSP log (`:LspLog` in nvim).
        io.eprintln "zls: srcDir=\{rr.srcDir} [\{rr.srcWhy}]"
        io.eprintln "zls: systemDir=\{rr.systemDir} [\{rr.systemWhy}]"
        this.srcDir = rr.srcDir.copy
        this.systemDir = rr.systemDir.copy
        this.baseSrcDir = rr.srcDir.copy
        this.baseSystemDir = rr.systemDir.copy
        this.srcExplicit = rr.srcExplicit
        this.systemExplicit = rr.systemExplicit
        # response
        caps: newObj
        caps.set key: "textDocumentSync".string value: Value.intval 1
        caps.set key: "definitionProvider".string value: Value.boolean true
        caps.set key: "hoverProvider".string value: Value.boolean true
        comp: newObj
        ctc: newArr
        ctc.items.append (Value.text ".".string)
        ctc.items.append (Value.text " ".string)
        comp.set key: "triggerCharacters".string value: Value.array ctc
        # an item's signature and doc come on request, for the one highlighted
        comp.set key: "resolveProvider".string value: Value.boolean true
        caps.set key: "completionProvider".string value: Value.object comp
        sig: newObj
        stc: newArr
        stc.items.append (Value.text ":".string)
        stc.items.append (Value.text " ".string)
        sig.set key: "triggerCharacters".string value: Value.array stc
        rtc: newArr
        rtc.items.append (Value.text ":".string)
        rtc.items.append (Value.text " ".string)
        sig.set key: "retriggerCharacters".string value: Value.array rtc
        caps.set key: "signatureHelpProvider".string value: Value.object sig
        caps.set key: "documentFormattingProvider".string value: Value.boolean true
        caps.set key: "referencesProvider".string value: Value.boolean true
        caps.set key: "documentSymbolProvider".string value: Value.boolean true
        encName: "utf-16"
        if this.encUtf32 then encName = "utf-32"
        caps.set key: "positionEncoding".string value: Value.text encName.string
        info: newObj
        info.set key: "name".string value: Value.text "zls".string
        info.set key: "version".string value: Value.text zversion.semver
        res: newObj
        res.set key: "capabilities".string value: Value.object caps
        res.set key: "serverInfo".string value: Value.object info
        idv: idValueOf :msg
        resv: Value.object res
        sendResult id: idv result: resv tp: this.transport
        this.initialized = true
    }

    # enterProjectOf -- make the project `file` belongs to the one
    # in hand: the nearest project.z at or above its directory gives the src
    # and stdlib roots no flag or initializationOptions named, and its `z`
    # unit is generated -- the same writer zc uses, so the editor has the
    # unit, on disk, before any build. A file in no project takes the
    # session's roots and a cache-directory `z`.
    enterProjectOf: function {:this file: StringView} is {
        this.srcDir = this.baseSrcDir.copy
        this.srcDirs = List String
        this.systemDir = this.baseSystemDir.copy
        start: path.dirname p: file
        pf: zproject.discoverProject start: start.stringView
        if pf.found when pf.error.length > 0 then {
            io.eprintln "zls: \{pf.error}"
            pf = zproject.ProjectFile.create
        }
        if pf.found then {
            if this.srcExplicit.not then {
                # the document's own root first: its relpath, and the open
                # buffers, are relative to it
                this.srcDirs = pf.sourceRootsFor path: file
                if this.srcDirs.length > 0 then this.srcDir = (this.srcDirs.get i: 0).copy
            }
            sysp: zproject.inProject dir: pf.dir.stringView rel: pf.systemDir.stringView
            if this.systemExplicit.not when sysp.length > 0 then {
                this.systemDir = zcheck.resolveSystemDir flagVal: sysp.stringView
            }
        }
        if this.srcDirs.length == 0 then this.srcDirs.append from: this.srcDir.copy
        un: zsource.unitNameOf :file
        facts: (zproject.BuildFacts.create
            srcdirs: this.srcDirs
            systemdir: this.systemDir.stringView
            main: un.stringView
        )
        facts.triple = pf.target.copy
        this.layer = zproject.zLayer :pf :facts
        zproject.writeLayer layer: this.layer
        this.enterPrograms :pf path: file
    }

    # enterPrograms -- the programs project `pf` lists, and the `z` layer each
    # reads, when the project holds the file at `path`; none otherwise
    enterPrograms: function {:this pf: zproject.ProjectFile.view path: StringView} is {
        this.projPrograms = List String
        this.entryLayers = Map String V: zcheck.GenLayer
        if pf.found.not or (pf.holdsSource :path).not then return
        for each pg: pf.programs loop {
            this.projPrograms.append from: pg.copy
            ef: (zproject.BuildFacts.create
                srcdirs: this.srcDirs
                systemdir: this.systemDir.stringView
                main: pg.stringView
            )
            ef.triple = pf.target.copy
            this.entryLayers.set key: pg.copy value: (zproject.zLayer :pf facts: ef)
        }
    }

    # ---- document sync (full text) ----

    # the editor opened a buffer; record its text and check it
    handleDidOpen: function {:this msg: Value.view} is {
        uo: json.textAt v: msg path: "params/textDocument/uri"
        to: json.textAt v: msg path: "params/textDocument/text"
        vo: json.intAt v: msg path: "params/textDocument/version"
        ver: i64
        match (
            vo
        ) case some then {
            ver = vo
        } case none then null
        match (
            uo
        ) case some then {
            match (
                to
            ) case some then {
                pth: uriToPath uri: uo.stringView
                this.enterProjectOf file: pth.stringView
                rel: (relPathBest
                    path: pth.stringView
                    srcDir: this.srcDir.stringView
                    systemDir: this.systemDir.stringView
                )
                if rel.length == 0 then {
                    # Outside both roots -- every .z file in examples/ or a
                    # scratch directory, whenever srcDir is a project's src/.
                    # An empty relpath kept the buffer out of the overlay AND
                    # made pathMatches reject every row, so the file got lint
                    # squiggles and no compiler diagnostics at all: a clean
                    # compile it never had. Serve it from its own buffer
                    # instead, under the name the parser will look the unit up
                    # by, so the overlay that shadows disk is the one the main
                    # unit resolves to.
                    un9: zsource.unitNameOf file: pth.stringView
                    rel = "\{un9}.z"
                    io.eprintln "zls: \{pth} is outside srcDir and systemDir; serving it from its open buffer"
                }
                d: (Document
                    uri: uo.copy
                    path: pth
                    relpath: rel
                    srcDir: this.srcDir.copy
                    systemDir: this.systemDir.copy
                    text: to.copy
                    version: ver
                )
                key: uo.copy
                this.docs.set :key value: d
                this.syncDoc uri: uo.stringView
            } case none then null
        } case none then null
    }

    # the editor edited a buffer; replace the text and mark it dirty rather than
    # re-checking immediately
    handleDidChange: function {:this msg: Value.view} is {
        uo: json.textAt v: msg path: "params/textDocument/uri"
        to: json.textAt v: msg path: "params/contentChanges/0/text"
        vo: json.intAt v: msg path: "params/textDocument/version"
        match (
            uo
        ) case some then {
            match (
                to
            ) case some then {
                rem: this.docs.remove key: uo
                changed: false
                match (
                    rem
                ) case some then {
                    d: rem.take
                    d.text = to.copy
                    match (
                        vo
                    ) case some then {
                        d.version = vo
                    } case none then null
                    key: uo.copy
                    this.docs.set :key value: d
                    changed = true
                } case none then null
                if changed then this.syncDoc uri: uo.stringView
            } case none then null
        } case none then null
    }

    # the editor closed a buffer; drop it, since the file on disk is
    # authoritative again
    handleDidClose: function {:this msg: Value.view} is {
        uo: json.textAt v: msg path: "params/textDocument/uri"
        match (
            uo
        ) case some then {
            rem: this.docs.remove key: uo
            match (
                rem
            ) case some then null case none then null
            this.forgetChecks uri: uo.stringView
            # clear this uri's diagnostics
            empty: newArr
            p: newObj
            p.set key: "uri".string value: Value.text uo.copy
            p.set key: "diagnostics".string value: Value.array empty
            pv: Value.object p
            (sendNotification
                method: "textDocument/publishDiagnostics"
                params: pv
                tp: this.transport
            )
        } case none then null
    }

    # forgetChecks -- closing document `uri`: its group's check goes with the
    # group's last open document, and the entry's program, which read its
    # buffer, goes too
    forgetChecks: function {:this uri: StringView} is {
        gone: this.docCheck.remove key: uri.string
        match (
            gone
        ) case some then {
            gk: gone.take
            if (this.groupInUse key: gk.stringView).not then {
                dropped: this.snapshots.remove key: gk.copy
                match (
                    dropped
                ) case some then null case none then null
                dm: this.snapMain.remove key: gk
                match (
                    dm
                ) case some then null case none then null
            }
        } case none then null
        this.entrySnap = Map String V: zcheck.CheckResult
        de: this.docPrograms.remove key: uri.string
        match (
            de
        ) case some then null case none then null
    }

    # ---- diagnostics ----

    # recomputeFor -- run a full check with all open buffers overlaid,
    # rooted at `uri`'s unit, and publish per-file diagnostics.
    # ---- debounce ----

    # bring one document's analysis up to date with its current text
    syncDoc: function {:this uri: StringView} is {
        if this.debounce then this.markDirty :uri else this.recomputeFor :uri
    }

    # note that a document changed. Checking is deferred so a burst of
    # keystrokes costs one analysis rather than one each
    markDirty: function {:this uri: StringView} is {
        this.dirty.set key: uri.string value: true
    }

    # whether any document is waiting to be re-checked
    hasDirty: function {this: this.view} out bool is {
        return this.dirty.length > 0
    }

    # flushDirty -- recheck every dirty document, then clear: one check per
    # GROUP, since a unit and its subunits share it. The dirty uris are copied
    # out first: recomputeFor locks `this`, which would conflict with a live
    # iterator over this.dirty.
    flushDirty: function {:this} is {
        uris: List String
        for each e: this.dirty.iterateItems loop uris.append e.key.copy
        fresh: MapRV String v: bool
        this.dirty = fresh.take
        checked: Set String
        ui: u64
        for ui < uris.length loop {
            u: uris.get i: ui
            g: this.groupOf uri: u.stringView
            if (checked.has item: g).not then {
                this.recomputeFor uri: u.stringView
                checked.add item: g.take
            }
            ui = ui + 1
        }
    }

    # inputQuiet -- true when no message is buffered and the input fd stays
    # unreadable for `millis`. A buffered burst reports not-quiet at once.
    inputQuiet: function {this: this.view millis: i32} out bool is {
        if this.inpos < this.inbuf.length then return false
        pr: transportReadable tp: this.transport :millis
        match (
            pr
        ) case ok then {
            if pr then return false
            return true
        } case err then {
            return true
        }
    }

    # re-analyse one document and publish its diagnostics
    recomputeFor: function {:this uri: StringView} is {
        if this.initialized.not then return
        mp: String
        drel: String
        found: false
        {
            dgo: this.docs.get key: uri.asString
            match (
                dgo
            ) case some then {
                mp = dgo.path.copy
                drel = dgo.relpath.copy
                found = true
            } case none then null
        }
        if found.not then return
        this.enterProjectOf file: mp.stringView
        this.entrySnap = Map String V: zcheck.CheckResult
        pgs: List String
        for each pg: this.projPrograms loop pgs.append from: pg.copy
        this.docPrograms.set key: uri.string value: pgs.take
        ovs: this.overlaysOf
        # a subunit's document is checked inside its topmost unit, which the
        # parse starts from; that unit's relpath keys the group's shared check
        topRel: (this.topRelOf
            rel: drel.stringView
            srcDir: this.srcDir.stringView
            systemDir: this.systemDir.stringView
        )
        mu: zsource.unitNameOf file: topRel.stringView
        gk: path.join a: this.srcDir.stringView b: topRel.stringView
        r: (zcheck.check
            srcdirs: this.srcDirs
            systemdir: this.systemDir.stringView
            mainUnit: mu.stringView
            overlays: ovs
            layer: this.layer
        )
        rows: ListVal zcheck.diagrow
        msgs: List String
        zcheck.diagsOf :r :rows :msgs
        this.publishAll :r :rows :msgs mainUnit: mu.stringView mainPath: mp.stringView
        if r.parseOk then {
            # the check answers for every open document of the group, so an
            # edit to any of them refreshes navigation for all
            this.bindGroup :uri topRel: topRel.stringView key: gk.stringView
            this.snapshots.set key: gk.copy value: r
            this.snapMain.set key: gk.copy value: mu.copy
        }
    }

    # overlaysOf -- the open buffers of the project in hand -- in any of its
    # source roots -- which shadow its files on disk, each under its own root
    overlaysOf: function {:this} out List (Map String V: String) is {
        ovs: List (Map String V: String)
        for each r: this.srcDirs loop {
            ov: Map String V: String
            for each e: this.docs.iterateItems loop {
                if e.value.relpath.length > 0 when e.value.srcDir.stringView == r then {
                    k: e.value.relpath.copy
                    v: e.value.text.copy
                    ov.set key: k value: v
                }
            }
            ovs.append from: ov.take
        }
        return ovs
    }

    # topRelOf -- the relpath of the topmost unit the file at `rel` belongs to.
    # While its folder `<d>/<u>/` sits beside a unit file `<d>/<u>.z`, it is a
    # subunit and the walk steps up; the parent counts when it is an open
    # buffer, saved or not, or a file under either root. A relpath with no
    # folder is its own top, so the climb never leaves the roots.
    topRelOf: function {
        this: this.view
        rel: StringView
        srcDir: StringView
        systemDir: StringView
    } out String is {
        cur: rel.string
        stepping: true
        for stepping loop {
            stepping = false
            slashOpt: cur.stringView.lastIndexOf needle: "/"
            match (
                slashOpt
            ) case some then {
                if slashOpt > 0 then {
                    parentRel: "\{cur.stringView.substring from: 0 to: slashOpt}.z"
                    if (this.unitFileExists rel: parentRel.stringView :srcDir :systemDir) then {
                        cur = parentRel.take
                        stepping = true
                    }
                }
            } case none then null
        }
        return cur
    }

    # unitFileExists -- whether a unit file is at `rel`: an open document's
    # buffer of the project rooted at `srcDir`, saved or not, or a file under
    # the src or system root.
    unitFileExists: function {
        this: this.view
        rel: StringView
        srcDir: StringView
        systemDir: StringView
    } out bool is {
        open: false
        for each k: this.docs loop {
            dgo: this.docs.get key: k
            match (
                dgo
            ) case some then {
                if dgo.relpath.stringView == rel when (
                    dgo.srcDir.stringView == srcDir
                ) then open = true
            } case none then null
        }
        if open then return true
        if (io.exists path: (path.join a: srcDir b: rel)) then return true
        return (io.exists path: (path.join a: systemDir b: rel))
    }

    # groupOf -- the group key of the open document `uri`: its topmost unit's
    # file, under its project's src root. "" when the document is not open.
    groupOf: function {this: this.view uri: StringView} out String is {
        rel: String
        sd: String
        syd: String
        {
            dgo: this.docs.get key: uri.asString
            match (
                dgo
            ) case some then {
                rel = dgo.relpath.copy
                sd = dgo.srcDir.copy
                syd = dgo.systemDir.copy
            } case none then {
                return rel
            }
        }
        top: this.topRelOf rel: rel.stringView srcDir: sd.stringView systemDir: syd.stringView
        return (path.join a: sd.stringView b: top.stringView)
    }

    # bindGroup -- point every open document of the group `topRel` of the
    # project in hand at its check, `key`, the one just run for `uri` included.
    bindGroup: function {:this uri: StringView topRel: StringView key: StringView} is {
        # the documents are copied out first: the climb reads `this.docs` too
        uris: List String
        rels: List String
        for each k: this.docs loop {
            dgo: this.docs.get key: k
            match (
                dgo
            ) case some then {
                if dgo.srcDir.stringView == this.srcDir then {
                    uris.append k.copy
                    rels.append dgo.relpath.copy
                }
            } case none then null
        }
        members: List String
        members.append uri.string
        i: u64
        for i < uris.length loop {
            top: (this.topRelOf
                rel: (rels.get :i).stringView
                srcDir: this.srcDir.stringView
                systemDir: this.systemDir.stringView
            )
            if top.stringView == topRel then members.append (uris.get :i).copy
            i = i + 1
        }
        for each m: members loop {
            this.docCheck.set key: m.copy value: key.string
        }
    }

    # checkKeyOf -- the key of the check that answers for `uri`, "" when none
    # has run for it.
    checkKeyOf: function {this: this.view uri: StringView} out String is {
        return (textAtKey m: this.docCheck key: uri)
    }

    # groupInUse -- whether any open document is still answered by the check
    # `key`.
    groupInUse: function {this: this.view key: StringView} out bool is {
        used: false
        for each k: this.docCheck loop {
            g: this.docCheck.get key: k
            match (
                g
            ) case some then {
                if g.stringView == key then used = true
            } case none then null
        }
        return used
    }

    # publishAll -- one publishDiagnostics per open document: its
    # matching rows (by provider path), or an empty list to clear.
    publishAll: function {
        :this
        r: zcheck.CheckResult
        rows: (ListVal zcheck.diagrow).view
        msgs: List String
        mainUnit: StringView
        mainPath: StringView
    } is {
        # resolve each row's provider path once (parallel to rows)
        paths: List String
        for each row: rows loop {
            pp: String
            if row.fsno.isZero.not then pp = r.vfs.pathfromprovider dentryid: row.fsno
            paths.append pp
        }
        for each e: this.docs.iterateItems loop {
            # a document of another project is not this check's to clear
            if e.value.srcDir.stringView != this.srcDir then continue
            drel: e.value.relpath
            dov: "/".string
            dov.append drel
            durl: e.value.uri.copy
            arr: newArr
            nrows: rows.length
            ri: u64
            for ri < nrows loop {
                pv: paths.get i: ri
                hit: false
                if drel.length > 0 then {
                    if pv.stringView == drel then hit = true
                    if pv.stringView == dov then hit = true
                }
                if hit then {
                    row: rows.get i: ri
                    m: msgs.get i: ri
                    lineText: String
                    lt: r.vfs.getline dentryid: row.fsno lineno: row.lineno - 1
                    match (
                        lt
                    ) case some then {
                        lineText = lt.copy
                    } case none then null
                    dv: (diagValue
                        :row
                        msg: m.stringView
                        lineText: lineText.stringView
                        utf32: this.encUtf32
                    )
                    arr.items.append dv
                }
                ri = ri + 1
            }
            self: docFsnoOf :r rel: drel.stringView
            # a check that loaded no unit from the document it was run for did
            # not check it: say so rather than publish a clean file
            isMain: e.value.path.stringView == mainPath
            if isMain when self.isZero when arr.items.length == 0 then {
                nc: notCheckedDiag :r :mainUnit :msgs
                arr.items.append nc
            }
            # every document the check loaded takes its typecheck-tier lints
            # from it: the check is eager, so each loaded body was walked
            if self.isZero.not then {
                (tcLintInto
                    :arr
                    text: e.value.text.copy
                    relpath: drel.stringView
                    utf32: this.encUtf32
                    prog: r.prog
                    :self
                    sto: r.st
                )
            } else {
                lintInto :arr text: e.value.text.copy relpath: drel.stringView utf32: this.encUtf32
            }
            p: newObj
            p.set key: "uri".string value: Value.text durl
            p.set key: "diagnostics".string value: Value.array arr
            pv: Value.object p
            (sendNotification
                method: "textDocument/publishDiagnostics"
                params: pv
                tp: this.transport
            )
        }
    }

    # ---- formatting ----

    # answer a format request with the edits `zl fmt` would make, as byte ranges
    # the editor can apply
    handleFormatting: function {:this msg: Value.view} is {
        idv: idValueOf :msg
        uo: json.textAt v: msg path: "params/textDocument/uri"
        answer: Value.nul
        match (
            uo
        ) case some then {
            dtext: String
            drel: String
            found: false
            {
                dgo: this.docs.get key: uo
                match (
                    dgo
                ) case some then {
                    dtext = dgo.text.copy
                    drel = dgo.relpath.copy
                    found = true
                } case none then null
            }
            if found then {
                res: formatAnswer text: dtext.stringView relpath: drel.stringView
                answer = res.take
            }
        } case none then null
        sendResult id: idv result: answer tp: this.transport
    }

    # ---- navigation requests ----

    # handleNav -- definition (mode 1), hover (mode 2), references
    # (mode 3): shared request decode + snapshot lookup.
    handleNav: function {:this msg: Value.view mode: u8} is {
        if this.debounce when this.hasDirty then this.flushDirty
        idv: idValueOf :msg
        uo: json.textAt v: msg path: "params/textDocument/uri"
        lo: json.intAt v: msg path: "params/position/line"
        co: json.intAt v: msg path: "params/position/character"
        line0: -1
        match (
            lo
        ) case some then {
            line0 = lo
        } case none then null
        ch0: -1
        match (
            co
        ) case some then {
            ch0 = co
        } case none then null
        answer: Value.nul
        match (
            uo
        ) case some then {
            if line0 >= 0 when ch0 >= 0 then {
                dtext: String
                drel: String
                dsrc: String
                dsys: String
                dpath: String
                found: false
                {
                    dgo: this.docs.get key: uo
                    match (
                        dgo
                    ) case some then {
                        dtext = dgo.text.copy
                        drel = dgo.relpath.copy
                        dsrc = dgo.srcDir.copy
                        dsys = dgo.systemDir.copy
                        dpath = dgo.path.copy
                        found = true
                    } case none then null
                }
                if found then {
                    # the document's own project answers for it
                    this.srcDir = dsrc.take
                    this.systemDir = dsys.take
                    ck: this.checkKeyOf uri: uo.stringView
                    {
                        sno: this.snapshots.getMut key: ck
                        match (
                            sno
                        ) case some then {
                            res: Value.nul
                            trigCh: String
                            # a client that sends no context asks for every
                            # reference, as Find References does
                            inclDecl: true
                            ido: json.boolAt v: msg path: "params/context/includeDeclaration"
                            match (
                                ido
                            ) case some then {
                                inclDecl = ido
                            } case none then null
                            tco: json.textAt v: msg path: "params/context/triggerCharacter"
                            match (
                                tco
                            ) case some then {
                                trigCh = tco.copy
                            } case none then null
                            if mode == 4 then {
                                res = (completionAnswer
                                    snap: sno
                                    docUri: uo.stringView
                                    docRel: drel.stringView
                                    docText: dtext.stringView
                                    :line0
                                    ch: ch0
                                    utf32: this.encUtf32
                                    trig: trigCh.stringView
                                    words: this.words
                                )
                            } else if mode == 5 then {
                                res = (signatureHelpAnswer
                                    snap: sno
                                    docRel: drel.stringView
                                    docText: dtext.stringView
                                    :line0
                                    ch: ch0
                                    utf32: this.encUtf32
                                )
                            } else {
                                res = (navAnswer
                                    snap: sno
                                    docRel: drel.stringView
                                    docUri: uo.stringView
                                    srcDir: this.srcDir.stringView
                                    systemDir: this.systemDir.stringView
                                    docText: dtext.stringView
                                    :line0
                                    ch: ch0
                                    utf32: this.encUtf32
                                    :mode
                                    :inclDecl
                                )
                            }
                            answer = res.take
                        } case none then null
                    }
                    if mode == 3 when (this.searchesElsewhere uri: uo.stringView ck: ck.stringView
                    ) then {
                        m3: (this.referencesElsewhere
                            :msg
                            own: answer
                            ck: ck.stringView
                            uri: uo.stringView
                            docPath: dpath.stringView
                            docRel: drel.stringView
                            docUri: uo.stringView
                            docText: dtext.stringView
                            :line0
                            ch: ch0
                        )
                        answer = m3.take
                    }
                }
            }
        } case none then null
        sendResult id: idv result: answer tp: this.transport
    }

    # referencesElsewhere -- the references `own` answered from the document's
    # check, with those every other program that loads its file answers: each
    # other open document's check, and each program project.z lists, checked
    # when no open check is rooted there. A library unit is checked from itself, so its
    # own program holds none of the units that use it. A program without the
    # file answers nothing; a location already listed is listed once.
    referencesElsewhere: function {
        :this
        msg: Value.view
        own: Value.view
        # the document's own check
        ck: StringView
        uri: StringView
        docPath: StringView
        docRel: StringView
        docUri: StringView
        docText: StringView
        line0: i64
        ch: i64
    } out Value is {
        acc: mergeLocations a: own b: Value.nul
        inclDecl: true
        ido: json.boolAt v: msg path: "params/context/includeDeclaration"
        match (
            ido
        ) case some then {
            inclDecl = ido
        } case none then null
        keys: List String
        for each k: this.snapshots loop {
            if k.stringView != ck then keys.append from: k.copy
        }
        for each k: keys loop {
            so: this.snapshots.getMut key: k
            match (
                so
            ) case some then {
                r: (navAnswer
                    snap: so
                    :docRel
                    :docUri
                    srcDir: this.srcDir.stringView
                    systemDir: this.systemDir.stringView
                    :docText
                    :line0
                    :ch
                    utf32: this.encUtf32
                    mode: 3
                    :inclDecl
                )
                acc = mergeLocations a: acc b: r
            } case none then null
        }
        for each ent: (this.programsOf :uri) loop {
            if (this.entryOpen entry: ent.stringView).not then {
                this.checkEntry entry: ent.stringView :docPath
                eo: this.entrySnap.getMut key: ent.copy
                match (
                    eo
                ) case some then {
                    r: (navAnswer
                        snap: eo
                        :docRel
                        :docUri
                        srcDir: this.srcDir.stringView
                        systemDir: this.systemDir.stringView
                        :docText
                        :line0
                        :ch
                        utf32: this.encUtf32
                        mode: 3
                        :inclDecl
                    )
                    acc = mergeLocations a: acc b: r
                } case none then null
            }
        }
        return acc
    }

    # snapMainIs -- the group check `key` is rooted at unit `unitName`
    snapMainIs: function {this: this.view key: StringView unitName: StringView} out bool is {
        if unitName.length == 0 then return false
        g: this.snapMain.get key: key.string
        match (
            g
        ) case some then {
            return g.stringView == unitName
        } case none then {
            return false
        }
    }

    # searchesElsewhere -- a references request on `uri`, answered from check
    # `ck`, has another program to search: another open document's check, or
    # a program project.z lists that no open check is rooted at
    searchesElsewhere: function {this: this.view uri: StringView ck: StringView} out bool is {
        for each k: this.snapshots loop {
            if k.stringView != ck then return true
        }
        for each ent: (this.programsOf :uri) loop {
            if (this.entryOpen entry: ent.stringView).not then return true
        }
        return false
    }

    # programsOf -- the project programs of open document `uri`, none for none
    programsOf: function {this: this.view uri: StringView} out List String is {
        r: List String
        g: this.docPrograms.get key: uri.string
        match (
            g
        ) case some then {
            for each pg: g loop r.append from: pg.copy
        } case none then null
        return r
    }

    # entryOpen -- an open document's check is rooted at unit `entry`
    entryOpen: function {this: this.view entry: StringView} out bool is {
        for each k: this.snapshots loop {
            if (this.snapMainIs key: k.stringView unitName: entry) then return true
        }
        return false
    }

    # checkEntry -- check program `entry`, the open buffers shadowing the
    # disk, unless it is checked already. The project is entered from the
    # document asking, which the program's layer is read for.
    checkEntry: function {:this entry: StringView docPath: StringView} is {
        if (this.entrySnap.has key: entry.string) then return
        this.enterProjectOf file: docPath
        ovs: this.overlaysOf
        lo: this.entryLayers.get key: entry.string
        match (
            lo
        ) case some then {
            r: (zcheck.check
                srcdirs: this.srcDirs
                systemdir: this.systemDir.stringView
                mainUnit: entry
                overlays: ovs
                layer: lo
            )
            if r.parseOk then this.entrySnap.set key: entry.string value: r
        } case none then null
    }

    # handleResolve -- completionItem/resolve: the item back exactly as the
    # client sent it, with the hover card of what it names as `documentation`,
    # found again by name from where the completion was asked (the item's
    # `data`). Nothing the menu already shows changes -- a field that did would
    # redraw the highlighted row, and could re-sort the list under the cursor.
    # An item with no data, or one that no longer names anything, comes back
    # as it was.
    handleResolve: function {:this msg: Value.view} is {
        if this.debounce when this.hasDirty then this.flushDirty
        idv: idValueOf :msg
        item: paramsCopy :msg
        lbl: String
        base: String
        {
            lbo: json.textAt v: msg path: "params/label"
            match (
                lbo
            ) case some then {
                lbl = lbo.copy
            } case none then null
            bo: json.textAt v: msg path: "params/data/base"
            match (
                bo
            ) case some then {
                base = bo.copy
            } case none then null
        }
        uo: json.textAt v: msg path: "params/data/uri"
        lo: json.intAt v: msg path: "params/data/line"
        match (
            item
        ) case object then {
            match (
                uo
            ) case some then {
                match (
                    lo
                ) case some then {
                    (this.resolveInto
                        it: item
                        uri: uo.stringView
                        line0: lo
                        base: base.stringView
                        label: lbl.stringView
                    )
                } case none then null
            } case none then null
        } else null
        sendResult id: idv result: item tp: this.transport
    }

    # resolveInto -- fill `it` with the card of `label` as completed at `line0`
    # of the document `uri`, after the member base `base` ("" for a bare name)
    resolveInto: function {
        :this
        it: Obj
        uri: StringView
        line0: i64
        base: StringView
        label: StringView
    } is {
        drel: String
        dsrc: String
        found: false
        {
            dgo: this.docs.get key: uri.string
            match (
                dgo
            ) case some then {
                drel = dgo.relpath.copy
                dsrc = dgo.srcDir.copy
                found = true
            } case none then null
        }
        if found.not then return
        this.srcDir = dsrc.take
        ck: this.checkKeyOf :uri
        sno: this.snapshots.getMut key: ck
        match (
            sno
        ) case some then {
            card: (completionCard
                snap: sno
                docRel: drel.stringView
                :line0
                :base
                :label
            )
            md: String
            mo: json.textAt v: card path: "contents/value"
            match (
                mo
            ) case some then {
                md = mo.copy
            } case none then null
            if md.length > 0 then {
                doc: newObj
                doc.set key: "kind".string value: Value.text "markdown".string
                doc.set key: "value".string value: Value.text md.copy
                it.set key: "documentation".string value: Value.object doc
            }
        } case none then null
    }

    # answer a document-symbol request with the file's definitions, which is
    # what an outline view shows
    handleDocSymbol: function {:this msg: Value.view} is {
        if this.debounce when this.hasDirty then this.flushDirty
        idv: idValueOf :msg
        uo: json.textAt v: msg path: "params/textDocument/uri"
        answer: Value.nul
        match (
            uo
        ) case some then {
            drel: String
            dtext: String
            dsrc: String
            dsys: String
            found: false
            {
                dgo: this.docs.get key: uo
                match (
                    dgo
                ) case some then {
                    drel = dgo.relpath.copy
                    dtext = dgo.text.copy
                    dsrc = dgo.srcDir.copy
                    dsys = dgo.systemDir.copy
                    found = true
                } case none then null
            }
            if found then {
                this.srcDir = dsrc.take
                this.systemDir = dsys.take
                ck: this.checkKeyOf uri: uo.stringView
                sno: this.snapshots.get key: ck
                match (
                    sno
                ) case some then {
                    res: (symbolsAnswer
                        snap: sno
                        unitOp: (docUnitOp r: sno rel: drel.stringView)
                        docText: dtext.stringView
                        utf32: this.encUtf32
                    )
                    answer = res.take
                } case none then null
            }
        } case none then null
        sendResult id: idv result: answer tp: this.transport
    }
}

# diagValue -- one LSP Diagnostic object from a flattened row.
diagValue: function {
    row: zcheck.diagrow
    msg: StringView
    lineText: StringView
    utf32: bool
} out Value is {
    line0: u32
    if row.lineno > 0 then line0 = row.lineno - 1
    c0: encodedCol :lineText cpCol1: row.colno :utf32
    w: row.width
    if w == 0 then w = 1
    c1: encodedCol :lineText cpCol1: row.colno + w :utf32
    if c1 <= c0 then c1 = c0 + 1
    st: newObj
    st.set key: "line".string value: Value.intval line0.i64
    st.set key: "character".string value: Value.intval c0.i64
    en: newObj
    en.set key: "line".string value: Value.intval line0.i64
    en.set key: "character".string value: Value.intval c1.i64
    rg: newObj
    rg.set key: "start".string value: Value.object st
    rg.set key: "end".string value: Value.object en
    code: codeOf n: row.code
    d: newObj
    d.set key: "range".string value: Value.object rg
    d.set key: "severity".string value: Value.intval 1
    d.set key: "code".string value: Value.text code
    d.set key: "source".string value: Value.text "zc".string
    d.set key: "message".string value: Value.text msg.string
    return (Value.object d)
}

# notCheckedDiag -- a warning on line 1 that the check loaded no unit from the
# document: a subunit its parent never names, or a project that did not parse
# (then naming the first error, which sits in another file).
notCheckedDiag: function {
    r: zcheck.CheckResult.view
    mainUnit: StringView
    msgs: (List String).view
} out Value is {
    why: "no unit the project loads from '\{mainUnit}' comes from this file (a subunit loads only when its parent names it)"
    if r.parseOk.not then {
        why = "the project does not parse from unit '\{mainUnit}'"
        if msgs.length > 0 then why.append ": \{msgs.get i: 0}"
    }
    pos: newObj
    pos.set key: "line".string value: Value.intval 0
    pos.set key: "character".string value: Value.intval 0
    pos2: newObj
    pos2.set key: "line".string value: Value.intval 0
    pos2.set key: "character".string value: Value.intval 1
    rg: newObj
    rg.set key: "start".string value: Value.object pos
    rg.set key: "end".string value: Value.object pos2
    d: newObj
    d.set key: "range".string value: Value.object rg
    d.set key: "severity".string value: Value.intval 2
    d.set key: "source".string value: Value.text "zls".string
    d.set key: "message".string value: Value.text "not checked: \{why}"
    return (Value.object d)
}

# codeOf -- "E" + zero-padded-4 error code.
codeOf: function {n: u32} out String is {
    r: "E".string
    if n < 1000 then r.append "0"
    if n < 100 then r.append "0"
    if n < 10 then r.append "0"
    cs: "\{n}"
    r.append cs
    return r
}

# ---- span collection (per-request AST index) ------------------------
# Positions are start-only in the AST; name-bearing leaves get a span
# [colLo, colHi) in 1-based codepoint columns. Row kinds: 1 = bare atom
# use, 2 = member access (nodeid is the DOTTED PATH's id, the
# refDecl member declaration; the name is the child atom's), 3 = binding name.
# A table covers one unit's file, or every file for references. A node's own
# position is read off the node (nodePosOf), never from the table.

# one hit-testable span: a source range mapped to a resolvable reference.
spanrow: record {
    # the node this span belongs to
    nodeid: zast.nodeid
    # the source line the span sits on, in the compiler's own numbering. The
    # conversion to what LSP wants happens at the protocol boundary, not here
    line: u32
    # the name written there, by its interned id
    name: zast.nameid
    # the first column it covers
    colLo: u32
    # one past the last, so the pair is a half-open range
    colHi: u32
    # what sort of thing it is, which decides whether a hover or a goto answers
    # from it
    kind: u8
}

# spanKindRank -- how strongly a row's kind claims a hit, so the three hit
# tests share one preference rule instead of three sequences of ifs. A member
# row outranks a plain use because the dotted path is what the cursor is on; a
# DECLARATION row is the last resort -- it fills an answer nothing else claimed
# and never displaces a reference row; everything else sits between. A row is
# taken only when it outranks the best so far, so the first row wins a tie and
# walk order decides.
spanKindRank: function {kind: u8} out u8 is {
    if kind == 2 then return 2
    if kind == 6 then return 0
    return 1
}

# rangerow -- an enclosing-node span, start..end as source positions; kind
# 4 = call, 5 = caseexpr. endPos is the latest start in the node's subtree (an
# extent good enough to find the node enclosing a cursor).
rangerow: record {
    # the node this range belongs to
    nodeid: zast.nodeid
    # where the node starts
    startPos: zast.nodepos
    # where its last descendant starts
    endPos: zast.nodepos
    # what sort of thing it is
    kind: u8
}

# namesGenericBound -- `op` declares a generic parameter: `X.generic`, or the
# call `(X.generic default: ...)`.
namesGenericBound: function {ast: Ast.view op: zast.nodeid} out bool is {
    o: ast.nodes.get i: op
    dp: op
    if o.call then dp = o.callable
    d: ast.nodes.get i: dp
    if d.dottedpath.not then return false
    c: ast.nodes.get i: d.child
    if c.atomid.not then return false
    return c.name == zast.wellKnown.slot.wkGeneric
}

# casearm -- where the arm a `case` clause writes is matched: its match's
# subject, and the function the match is written in (0 outside one)
casearm: record {
    subject: zast.nodeid
    fn: zast.nodeid
}

# the table of hit-testable spans a request builds: fileSpans for one unit's
# file, programSpans for every file.
Spans: class {
    # the line/column spans, which is what a position lookup searches
    rows: ListVal spanrow
    # the names those rows refer to, kept beside them so a row stays a fixed-
    # size value
    names: List String
    # the enclosing calls and matches, which a cursor lookup searches
    ranges: ListVal rangerow
    # the latest position seen inside the call or match being walked: its
    # range's end
    lastPos: zast.nodepos
    # the walk descends into subunits, whose bodies are other files
    wholeProgram: bool
    # the call each labelled argument is written in, keyed by the argument's
    # value node, which its rows are keyed on. A call and its labels sit in one
    # file, so a file's walk has them all.
    argCall: (IdMapV zast.nodeid v: zast.nodeid)
    # each `for` binding's arm, keyed by its value node, which its row is keyed
    # on: the checker binds the loop variable on that node, or on the
    # `E.iterate` node it mints for the arm
    forArm: (IdMapV zast.nodeid v: zast.nodeid)
    # each `case` clause's arm, its written name, keyed to where it is
    # matched: the checker resolves the arm by name through the subject's type
    # and records nothing on it
    caseArm: (IdMapV zast.nodeid v: casearm)
    # the function the walk is in, 0 outside one
    curFn: zast.nodeid
    # the generic parameters the walk is inside the template of, innermost
    # last: each one's name, and its declaring arm's operation
    genNames: ListVal zast.nameid
    genOps: ListVal zast.nodeid
    # each atom spelled as a generic parameter in scope, keyed to that
    # parameter's declaring operation, which genericParamDecl keys. The checker
    # notes only the spellings the paths that read them stop for.
    genUse: (IdMapV zast.nodeid v: zast.nodeid)
} as {
    # an empty table
    create: function {} out this is {
        return (meta.create
            rows: ListVal spanrow
            names: List String
            ranges: ListVal rangerow
            lastPos: (zast.nodepos line: 0 col: 0)
            wholeProgram: false
            argCall: (IdMapV zast.nodeid v: zast.nodeid)
            forArm: (IdMapV zast.nodeid v: zast.nodeid)
            caseArm: (IdMapV zast.nodeid v: casearm)
            curFn: zast.nodeid
            genNames: ListVal zast.nameid
            genOps: ListVal zast.nodeid
            genUse: (IdMapV zast.nodeid v: zast.nodeid)
        )
    }

    # a node's position was seen, so the enclosing range reaches at least that far
    note: function {:this line: u32 col: u32} is {
        v: zast.nodepos :line :col
        if v > this.lastPos then this.lastPos = v
    }

    # record a node's span and the name written there
    addRow: function {
        :this
        ast: Ast.view
        id: zast.nodeid
        line: u32
        col: u32
        name: zast.nameid
        kind: u8
    } is {
        txt: zast.nameTextAt :ast ref: name
        hi: col + txt.count.u32.orPanic
        this.rows.append (spanrow nodeid: id :line :name colLo: col colHi: hi :kind)
        this.names.append txt.copy
    }

    # record the span of a dotted path's MEMBER half, so hovering `a.b` answers
    # about `b` and not about `a`
    memberRow: function {:this ast: Ast.view dpid: zast.nodeid c: zast.astnode.view} is {
        if c.atomid then this.addRow :ast id: dpid line: c.lineno col: c.colno name: c.name kind: 2
    }

    # innerRangeOfKind -- the innermost recorded range of `kind` in the file
    # `wantFsno` whose [startPos, endPos + slack lines] contains `curPos`, or 0
    # (always 0 for no file).
    innerRangeOfKind: function {
        t: this.view
        curPos: zast.nodepos
        kind: u8
        slack: u32
        prog: Ast.view
        wantFsno: zvfs.fsno
    } out zast.nodeid is {
        best: zast.nodeid
        if wantFsno.isZero then return best
        bestStart: zast.nodepos line: 0 col: 0
        ri: u64
        for ri < t.ranges.length loop {
            rr: t.ranges.get i: ri
            hit: rr.kind == kind
            if rr.startPos > curPos then hit = false
            if (
                curPos > (zast.nodepos line: rr.endPos.line + slack col: rr.endPos.col)
            ) then hit = false
            # THE WALK SPANS EVERY UNIT and a position is a line and a column, so a
            # range in ANOTHER file at the same line and a later column reads
            # as the innermost one. Every operator is a call now, so those
            # ranges are everywhere and the collision stopped being rare.
            if hit when (prog.fsnoForNode nodeid: rr.nodeid) != wantFsno then hit = false
            if hit then {
                shouldTake: best.isZero or (rr.startPos > bestStart)
                if shouldTake then {
                    best = rr.nodeid
                    bestStart = rr.startPos
                }
            }
            ri = ri + 1
        }
        return best
    }

    # walkProgram -- every file: each top-level unit, and the subunits inside
    # them. A loaded unit's wrapper (here, or a subunit's in its parent's body)
    # holds the FILE's name at the file's first token, where no such text is
    # written, so it adds no row: the first definition's own name sits there.
    walkProgram: function {:this prog: Ast.view} is {
        this.wholeProgram = true
        for each wpid: prog.units loop {
            wp: prog.nodes.get i: wpid
            if wp.namedoperation then {
                this.walkAt ast: prog nId: wp.operation
            } else this.walk ast: prog n: wp
        }
    }

    # walkAt -- the id-taking entry: the row view is this frame's, so a
    # caller can lend the table in the same call.
    walkAt: function {:this ast: Ast.view nId: zast.nodeid} is {
        n: ast.nodes.get i: nId
        this.walk :ast :n
    }

    # walk -- note every node's position in pre-order (the navigation index),
    # add the rows names and members contribute, and bracket calls and matches
    # as ranges; children come from zast.childIds.
    walk: function {:this ast: Ast.view n: zast.astnode.view} is {
        if n.placeholder then return
        pos: zast.posOf :n
        this.note line: pos.line col: pos.col
        kids: zast.childIds :ast :n
        match (
            n
        ) case atomid then {
            this.addRow :ast id: n.nodeid line: n.lineno col: n.colno name: n.name kind: 1
            this.noteGenericUse id: n.nodeid name: n.name
        } case labelvalue then {
            this.addRow :ast id: n.nodeid line: n.lineno col: n.colno name: n.name kind: 1
        } case dottedpath then {
            # the member selector is a row of its own, not a node walk
            this.walk :ast n: (ast.nodes.get i: n.parent)
            this.memberRow :ast dpid: n.nodeid c: (ast.nodes.get i: n.child)
            return
        } case call then {
            this.noteArguments :ast callId: n.nodeid args: n.arguments
            this.walkRange :ast nodeid: n.nodeid startPos: pos :kids kind: 4
            return
        } case functiondef then {
            outerFn: this.curFn
            mark: this.genNames.length
            this.pushGenerics :ast items: n.asItems
            this.curFn = n.nodeid
            this.walkIds :ast ids: kids
            this.curFn = outerFn
            this.popGenerics to: mark
            return
        } case objectdef then {
            mark: this.genNames.length
            this.pushGenerics :ast items: n.asItems
            this.walkIds :ast ids: kids
            this.popGenerics to: mark
            return
        } case unitdef then {
            mark: this.genNames.length
            if n.isGeneric then this.pushGenerics :ast items: n.body
            this.walkIds :ast ids: kids
            this.popGenerics to: mark
            return
        } case caseexpr then {
            this.noteCaseArms :ast subject: n.subject clauses: n.clauses
            this.walkRange :ast nodeid: n.nodeid startPos: pos :kids kind: 5
            return
        } case forexpr then {
            this.noteBindings :ast conds: n.conditions
        } case assignment then {
            this.addRow :ast id: n.nodeid line: n.lineno col: n.colno name: n.name kind: 3
        } case namedoperation then {
            # the DECLARATION's own name. A definition's name lives on the
            # namedoperation arm that holds it -- functionrow and
            # objectdefrow carry none -- and nothing rowed it, so every
            # top-level def, field, method, arm name and parameter answered
            # null while references to them answered fine. A file that is
            # mostly declarations, which every lib/system unit is, therefore
            # read as though navigation were dead. Kind 6 is ranked last in
            # navAnswer so it can only fill an answer, never displace one.
            isSub: (zast.unitOpKindIs
                :ast
                opId: n.operation
                k: zast.unitkind.subunit
            )
            if isSub when this.wholeProgram.not then return
            if n.name.isZero.not when isSub.not then {
                # keyed by the OPERATION node, not the arm: the arm carries
                # the name and the position, the operation carries the
                # definition's stamps. Same split memberRow makes.
                this.addRow :ast id: n.operation line: n.lineno col: n.colno name: n.name kind: 6
            }
        } else null
        this.walkIds :ast ids: kids
    }

    # noteArguments -- record call `callId` against each of its labelled
    # arguments
    noteArguments: function {:this ast: Ast.view callId: zast.nodeid args: zast.kidspan} is {
        ai: u64
        for ai < args.count loop {
            arm: ast.nodes.get i: (zast.kidAt kids: ast.kids span: args i: ai)
            ai = ai + 1
            if arm.namedoperation when arm.name.isZero.not then (this.argCall.set
                key: arm.operation
                value: callId
            )
        }
    }

    # noteBindings -- record the arm of each of a `for`'s named conditions
    noteBindings: function {:this ast: Ast.view conds: zast.kidspan} is {
        ci: u64
        for ci < conds.count loop {
            arm: ast.nodes.get i: (zast.kidAt kids: ast.kids span: conds i: ci)
            ci = ci + 1
            if arm.namedoperation when arm.name.isZero.not then (this.forArm.set
                key: arm.operation
                value: arm.nodeid
            )
        }
    }

    # pushGenerics -- bring into scope the generic parameters a template's
    # `as` block declares: each arm whose operation is `X.generic`, or the call
    # `(X.generic default: ...)`
    pushGenerics: function {:this ast: Ast.view items: zast.kidspan} is {
        ii: u64
        for ii < items.count loop {
            arm: ast.nodes.get i: (zast.kidAt kids: ast.kids span: items i: ii)
            ii = ii + 1
            if arm.namedoperation when arm.name.isZero.not when (namesGenericBound
                :ast
                op: arm.operation
            ) then {
                this.genNames.append arm.name
                this.genOps.append arm.operation
            }
        }
    }

    # popGenerics -- leave the template whose parameters were pushed after
    # `to` were in scope
    popGenerics: function {:this to: u64} is {
        for this.genNames.length > to loop {
            this.genNames.pop
            this.genOps.pop
        }
    }

    # noteGenericUse -- an atom spelled as a generic parameter in scope, the
    # innermost first, names it
    noteGenericUse: function {:this id: zast.nodeid name: zast.nameid} is {
        gi: this.genNames.length
        for gi > 0 loop {
            gi = gi - 1
            if (this.genNames.get i: gi) == name then {
                op: this.genOps.get i: gi
                if op != id then this.genUse.set key: id value: op
                return
            }
        }
    }

    # noteCaseArms -- record each clause's arm against its match's subject
    noteCaseArms: function {:this ast: Ast.view subject: zast.nodeid clauses: zast.kidspan} is {
        ci: u64
        for ci < clauses.count loop {
            cl: ast.nodes.get i: (zast.kidAt kids: ast.kids span: clauses i: ci)
            ci = ci + 1
            if cl.caseclause when cl.matcharm.isZero.not then (this.caseArm.set
                key: cl.matcharm
                value: (casearm :subject fn: this.curFn)
            )
        }
    }

    # bindingArmOf -- the arm of the `for` binding whose value node is `nid`, which
    # sits at the loop variable's name; `nid` itself for any other node
    bindingArmOf: function {t: this.view nid: zast.nodeid} out zast.nodeid is {
        a: t.forArm.get key: nid
        match (
            a
        ) case some then {
            return a
        } case none then {
            return nid
        }
    }

    # walkRange -- walk a call's or a match's children and record its range,
    # which ends at the latest position inside it
    walkRange: function {
        :this
        ast: Ast.view
        nodeid: zast.nodeid
        startPos: zast.nodepos
        kids: (ListVal zast.nodeid).view
        kind: u8
    } is {
        outer: this.lastPos
        this.lastPos = startPos
        this.walkIds :ast ids: kids
        this.ranges.append (rangerow :nodeid :startPos endPos: this.lastPos :kind)
        if outer > this.lastPos then this.lastPos = outer
    }

    # record spans for a list of child nodes in order
    walkIds: function {:this ast: Ast.view ids: (ListVal zast.nodeid).view} is {
        for each c: ids loop this.walk :ast n: (ast.nodes.get i: c)
    }
}

# fileSpans -- the spans of the unit whose body is the file `fsno`, without its
# subunits (other files); empty when no unit's body is that file.
fileSpans: function {prog: Ast.view fsno: zvfs.fsno} out Spans is {
    sp: Spans.create
    op: (zsource.lintedUnitOf :prog self: fsno).op
    if op.isZero.not then sp.walkAt ast: prog nId: op
    return sp
}

# programSpans -- the spans of every file the program loaded, for a lookup that
# searches them all.
programSpans: function {prog: Ast.view} out Spans is {
    sp: Spans.create
    sp.walkProgram :prog
    return sp
}

# nodePosOf -- where the node `nid` starts; line 0 for no node.
nodePosOf: function {prog: Ast.view nid: zast.nodeid} out zast.nodepos is {
    return (zast.posOf n: (prog.nodes.get i: nid))
}

# docLine -- 1-based line `lineno` of `text` (without the newline).
docLine: function {text: StringView lineno: u32} out String is {
    if lineno == 0 then return "".string
    cur: 1.u32
    start: u64
    i: u64
    n: text.length
    for i < n loop {
        b: text.byteAt :i
        match (
            b
        ) case some then {
            if b == 10 then {
                if cur == lineno then return (text.substring from: start to: i).string
                cur = cur + 1
                start = i + 1
            }
        } case none then null
        i = i + 1
    }
    if cur == lineno then return (text.substring from: start to: n).string
    return "".string
}

# ---- navigation resolution ------------------------------------------

# cpColOf -- LSP character (0-based, negotiated encoding) -> 1-based
# codepoint column, measured over the line's text.
cpColOf: function {lineText: StringView ch: i64 utf32: bool} out u32 is {
    if ch < 0 then return 1
    if utf32 then return ch.u32.orPanic + 1
    units: i64
    idx: u32
    for each cp: lineText.codepoints loop {
        if units >= ch then break
        if cp >= 65536 then {
            units = units + 2
        } else {
            units = units + 1
        }
        idx = idx + 1
    }
    return idx + 1
}

# pathMatches -- whether a provider path names the request's document: a file
# provider's path is relative to its root ("rel"), an overlay's is "/rel"
pathMatches: function {pv: StringView rel: StringView} out bool is {
    if rel.length == 0 then return false
    if pv == rel then return true
    ov: "/".string
    ov.append rel
    if pv == ov then return true
    return false
}

# docFsnoOf -- the file number the check gave the document at `rel`: the
# parsed file whose provider path is the document's. 0 when the check parsed
# no such file.
docFsnoOf: function {r: zcheck.CheckResult.view rel: StringView} out zvfs.fsno is {
    found: zvfs.fsno
    if r.parseOk.not then return found
    for each f: r.prog.files loop {
        if found.isZero then {
            pv: r.vfs.pathfromprovider dentryid: f
            if (pathMatches pv: pv.stringView :rel) then found = f
        }
    }
    return found
}

# docUnitDecl -- the declaration of the document's unit, where a card shown for
# it reads a bare type name; 0 when no loaded unit comes from the document.
docUnitDecl: function {
    # the snapshot whose units are searched
    r: zcheck.CheckResult.view
    # the document, relative to the workspace
    rel: StringView
} out ztypes.declid is {
    op: docUnitOp :r :rel
    if op.isZero then return ztypes.declid
    o: r.st
    match (
        o
    ) case some then {
        uk: ztypecheck.unitdefNodeId ast: r.prog nId: op
        ut: (o.typing.unitTypesById.get key: uk).or d: ztypes.tid.zero
        if ut.isZero then return ztypes.declid
        return (o.reg.defOf tid: ut)
    } case none then {
        return ztypes.declid
    }
}

# docUnitOp -- the unitdef node of the document's unit, found by its FILE: a
# subunit's document is that subunit, never a top-level unit of the same name.
# 0 when no loaded unit comes from the document.
docUnitOp: function {r: zcheck.CheckResult.view rel: StringView} out zast.nodeid is {
    lu: zsource.lintedUnitOf prog: r.prog self: (docFsnoOf :r :rel)
    return lu.op
}

# ---- stamp lookups through the snapshot's Option symtab ----

# the variable id referenced at use-site node `nid`, or 0.
useVarId: function {o: (Option zenv.ZSymbolTable).view nid: zast.nodeid} out ztypes.vid is {
    match (
        o
    ) case some then {
        g: o.typing.atomVariableId.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            return ztypes.vid.zero
        }
    } case none then {
        return ztypes.vid.zero
    }
}

# the unit-definition type id referenced at node `nid` (the referenced
# declaration's minted tid via refDecl), or 0.
useUnitDef: function {o: (Option zenv.ZSymbolTable).view nid: zast.nodeid} out ztypes.tid is {
    rd: refDeclOf :o :nid
    return (declTypeIdOf :o declId: rd)
}

# the declaration id referenced at node `nid` (typing.refDecl), or 0.
refDeclOf: function {o: (Option zenv.ZSymbolTable).view nid: zast.nodeid} out ztypes.declid is {
    match (
        o
    ) case some then {
        g: o.typing.refDecl.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            # a reference the compiler resolved for TOOLING only -- a generic
            # parameter's bound, which is a constraint to the compiler and a
            # type name to a reader
            t9: o.typing.toolRefDecl.get key: nid
            match (
                t9
            ) case some then {
                return t9
            } case none then {
                return ztypes.declid.zero
            }
        }
    } case none then {
        return ztypes.declid.zero
    }
}

# the generic parameter declared or referenced at node `nid`, or 0.
#
# Deliberately NOT reached through refDeclOf. A parameter's declaration shares
# its node id with the `.generic` member row beside it -- Spans keys a
# declaration's row to the node of the thing declared, and for
# `t: anyval.generic` that is the dotted path the member row is keyed to as
# well -- so an answer refDeclOf could see would answer on the word `generic`
# too. navAnswer consults this only when the hit IS a declaration row.
genericParamDeclOf: function {
    o: (Option zenv.ZSymbolTable).view nid: zast.nodeid
} out ztypes.declid is {
    match (
        o
    ) case some then {
        g: o.typing.genericParamDecl.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            return ztypes.declid.zero
        }
    } case none then {
        return ztypes.declid.zero
    }
}

# the node that spells a generic parameter's BOUND at node `nid`, or 0. Its own
# declaration is already in toolRefDecl, so the bound's name and doc come from
# the machinery that answers for the bound itself.
genericParamBoundOf: function {
    o: (Option zenv.ZSymbolTable).view nid: zast.nodeid
} out zast.nodeid is {
    match (
        o
    ) case some then {
        g: o.typing.genericParamBound.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            return zast.nodeid
        }
    } case none then {
        return zast.nodeid
    }
}

# genericParamCard -- generic parameter `gpd` rendered as it was declared,
# `t: anyval.generic`. "" when it has no name.
#
# A parameter's Decl carries no type id -- nothing links one -- and its node no
# stamp, so every signature and type-kind fallback hover has answers nothing for
# it. The name it was declared under and the bound beside it are what there is;
# the bound is read from the declaration's own node.
genericParamCard: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    gpd: ztypes.declid
    # the unit the generic parameter's card is shown in
    site: ztypes.declid
} out String is {
    if gpd.isZero then return "".string
    bnm: String
    btid: useUnitDef :o nid: (genericParamBoundOf :o nid: (declOperationOf :o :prog declId: gpd))
    if btid.isZero.not then bnm = displayTypeNameOfOpt :o tid: btid :site
    card: String
    {
        pnm: String
        match (
            o
        ) case some then {
            pnm = declNameText ast: prog st: o declId: gpd
        } case none then null
        if pnm.length == 0 then return "".string
        card.append pnm
        if bnm.length > 0 then {
            card.append ": "
            card.append bnm
            card.append ".generic"
        }
    }
    return card
}

# genericParamOwner -- the name of the head that declares generic parameter
# `gpd`, or "". The parameter's Decl is a child of the template's.
genericParamOwner: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    gpd: ztypes.declid
} out String is {
    if gpd.isZero then return "".string
    own: String
    {
        match (
            o
        ) case some then {
            par: ztypes.declid
            d: o.typing.decls.get i: gpd
            par = d.parent
            if par.isZero.not then {
                own = declNameText ast: prog st: o declId: par
            }
        } case none then null
    }
    return own
}

# declOperationOf -- the operation of the arm declaration `declId` is written
# as, 0 when it is written as none.
declOperationOf: function {
    o: (Option zenv.ZSymbolTable).view prog: Ast.view declId: ztypes.declid
} out zast.nodeid is {
    dn: declNodeOf :o :declId
    if dn.isZero then return dn
    arm: prog.nodes.get i: dn
    if arm.namedoperation then return arm.operation
    return zast.nodeid.zero
}

# genericUseDecl -- the generic parameter use row node `nid`, spelled `name`,
# names: one the checker noted, else one in scope where it is written
# (Spans.genUse). 0 when it names none, or when the declaration spelled
# otherwise shares the node -- a parameter typed by one, `v: t`.
genericUseDecl: function {
    snap: zcheck.CheckResult sp: Spans.view nid: zast.nodeid name: zast.nameid
} out ztypes.declid is {
    d: genericParamDeclOf o: snap.st :nid
    if d.isZero then {
        op: sp.genUse.get key: nid
        match (
            op
        ) case some then {
            d = genericParamDeclOf o: snap.st nid: op
        } case none then null
    }
    if d.isZero then return d
    o: snap.st
    match (
        o
    ) case some then {
        if (o.typing.decls.get i: d).name == name then return d
    } case none then null
    return ztypes.declid.zero
}

# a declaration's defining AST node id, or 0.
declNodeOf: function {o: (Option zenv.ZSymbolTable).view declId: ztypes.declid} out zast.nodeid is {
    if declId.isZero then return zast.nodeid.zero
    match (
        o
    ) case some then {
        return (o.typing.decls.get i: declId).node
    } case none then {
        return zast.nodeid.zero
    }
}

# a declaration's minted type id, or 0.
declTypeIdOf: function {
    o: (Option zenv.ZSymbolTable).view declId: ztypes.declid
} out ztypes.tid is {
    if declId.isZero then return ztypes.tid.zero
    match (
        o
    ) case some then {
        return (ztypecheck.declTypeIdOf st: o :declId)
    } case none then {
        return ztypes.tid.zero
    }
}

# the owner type id of the member referenced at node `nid` (the member
# declaration's parent type, via refDecl), or 0.
memberOwnerOf: function {o: (Option zenv.ZSymbolTable).view nid: zast.nodeid} out ztypes.tid is {
    return (declOwnerOf :o declId: (refDeclOf :o :nid))
}

# declOwnerOf -- the type declaration `declId` is a member of, or 0 when it is
# no member (a list's element is the list's, which is no type: listMemberDecl).
declOwnerOf: function {o: (Option zenv.ZSymbolTable).view declId: ztypes.declid} out ztypes.tid is {
    if declId.isZero then return ztypes.tid.zero
    par: ztypes.declid
    match (
        o
    ) case some then {
        d: o.typing.decls.get i: declId
        par = d.parent
    } case none then null
    if par.isZero then return ztypes.tid.zero
    match (
        o
    ) case some then {
        p: o.typing.decls.get i: par
        if p.kind.typeDecl then return p.typeId
        return ztypes.tid.zero
    } case none then {
        return ztypes.tid.zero
    }
}

# the variable id defined at node `nid`, or 0.
defVarIdOf: function {o: (Option zenv.ZSymbolTable).view nid: zast.nodeid} out ztypes.vid is {
    match (
        o
    ) case some then {
        g: o.typing.defVariableId.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            return ztypes.vid.zero
        }
    } case none then {
        return ztypes.vid.zero
    }
}

# the type id stamped on node `nid`, or 0.
nodeTypeAt: function {o: (Option zenv.ZSymbolTable).view nid: zast.nodeid} out ztypes.tid is {
    match (
        o
    ) case some then {
        return (ztyping.nodeTypeAt tbl: o.typing.nodeType :nid)
    } case none then {
        return ztypes.tid.zero
    }
}

# surfaceDeclOfType -- the Decl a reader means by type `tid`, over the LSP's
# optional snapshot. Writing a type's name navigates to core's re-export line,
# so a hit resolved through a TYPE ID has to land in the same place.
surfaceDeclOfType: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    tid: ztypes.tid
} out ztypes.declid is {
    if tid.isZero then return ztypes.declid.zero
    match (
        o
    ) case some then {
        {
            return (ztypecheck.surfaceDeclOfTypeId
                st: o
                ast: prog
                :tid
            )
        }
    } case none then null
    return ztypes.declid.zero
}

# isLiteralTid -- one of the registry's reserved literal rows.
isLiteralTid: function {o: (Option zenv.ZSymbolTable).view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    match (
        o
    ) case some then {
        if tid == o.reg.literalIntTid then return true
        if tid == o.reg.literalBitsTid then return true
        return tid == o.reg.literalFloatTid
    } case none then null
    return false
}

# literalNote -- what a numeric literal BECOMES, which is the one thing about it
# a reader cannot get from the source. Unpinned it falls to the default type;
# pinned, it already wears the type that pinned it. "" for anything else.
literalNote: function {
    o: (Option zenv.ZSymbolTable).view
    name: StringView
    refTid: ztypes.tid
    nodeTid: ztypes.tid
    # the unit the literal's note is shown in
    site: ztypes.declid
} out String is {
    if (ztypecheck.isNumericLiteralName :name).not then return "".string
    match (
        o
    ) case some then {
        falls: literalFallNote st: o :name :refTid
        if falls.length > 0 then return falls
        if nodeTid.isZero.not then {
            tn: displayTypeNameSt st: o tid: nodeTid :site
            if tn.length > 0 then {
                kind: "an integer literal"
                if (ztypecheck.isFloatLiteralName :name) then kind = "a float literal"
                note: "\{kind} pinned to `\{tn}` here"
                return note
            }
        }
    } case none then null
    return "".string
}

# literalFallNote -- the default an unpinned literal falls to, by the literal
# type it wears: i64, u64 for a hex, octal or binary integer, which spells
# bits, or f64. "" when the literal is pinned.
literalFallNote: function {
    st: zenv.ZSymbolTable.view
    name: StringView
    refTid: ztypes.tid
} out String is {
    if refTid == st.reg.literalFloatTid then return "falls to `f64` here".string
    if refTid != st.reg.literalIntTid then return "".string
    if (ztypecheck.isBitsLexeme lex: name) then return "falls to `u64` here".string
    return "falls to `i64` here".string
}

# varDefNode -- the binding node that declared variable `vid`.
varDefNode: function {o: (Option zenv.ZSymbolTable).view vid: ztypes.vid} out zast.nodeid is {
    match (
        o
    ) case some then {
        for each e: o.typing.defVariableId.iterateItems loop {
            if e.value == vid then return e.key
        }
        return zast.nodeid
    } case none then {
        return zast.nodeid
    }
}

# displayTypeNameSt -- reg.nameOf, but a source type renders "<units>.<name>",
# the path of units a program spells it through (`io.File`, `z.build.oskind`),
# UNLESS its file unit is a core-language one (system/core/collections) or it has
# no source unit -- those stay bare. So String/List/Map stay bare while io/os/cli/
# net and other stdlib units render dotted (io.File, cli.OptionDef). A generic mono
# keys the unit test on its ORIGIN's declaring unit while displaying the full
# instance name (e.g. "List u64" stays bare -- List is declared in collections).
# A core-language type stays bare only where its bare name reaches it: under a
# unit's own `u8` the system's prints as a program there would write it,
# `core.u8` (or its own unit's path when core does not re-export it).
displayTypeNameSt: function {
    # the checked program the type is named from
    st: zenv.ZSymbolTable.view
    # the type to name
    tid: ztypes.tid
    # the unit the name is shown in (docUnitDecl): a core-language type prints
    # bare only when its bare name, looked up there, reaches it. 0 for no site.
    site: ztypes.declid
} out String is {
    disp: st.reg.nameOf :tid
    if disp.length == 0 then return disp
    inst: instanceSpelling :st :tid :site
    if inst.length > 0 then return inst
    base: tid
    go: st.reg.genericOriginOf :tid
    if go.isZero.not then base = go
    bname: String
    name9v: st.reg.nameOf tid: base
    bname = name9v.take
    if bname.length == 0 then return disp
    path: ztypecheck.unitPathOfTid :st tid: base
    if path.length == 0 then return disp
    if (isCoreLanguageUnit :st unitDecl: (ztypecheck.unitDeclOfTid :st tid: base)) then {
        if (ztypecheck.bareNameReaches :st :site :base) then return disp
        if (coreReexports :st :base) then path = "core".string
    }
    return "\{path}.\{disp.stringView}"
}

# instanceSpelling -- an instance of a generic type as a program writes it: the
# template's name, its first argument, then each further one labelled with its
# parameter's name, an argument its parameter's default supplies left out --
# `optionval i64`, `(MapRR String V: json.Value)`, `ListRef String`. More than
# one argument is parenthesised, as a program must write it, and so is an
# argument that is itself an instance. "" when `tid` is no instance, or a
# parameter's name is not known yet, which leaves the registry's name.
instanceSpelling: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    site: ztypes.declid
} out String is {
    go: st.reg.genericOriginOf :tid
    n: st.reg.genericArgCount specId: tid
    if go.isZero or (n == 0) then return "".string
    tdecl: st.reg.defOf tid: go
    # the trailing arguments their defaults supply are not written
    shown: n
    for shown > 1 loop {
        last: st.reg.genericTypeArgAt specId: tid ordinal: shown - 1
        dflt: st.reg.genericParamDefaultTidAt :tdecl i: shown - 1
        if last.isZero or dflt.isZero or (last == dflt).not then break
        shown = shown - 1
    }
    s: displayTypeNameSt :st tid: go :site
    i: u64
    for i < shown loop {
        s.append " "
        if i > 0 then {
            ptid: ((st.reg.genericParamTidOf
                :tdecl
                paramName: (st.reg.genericParamNameAt :tdecl :i)
            ).or
                d: ztypes.tid.zero
            )
            pn: st.reg.nameOf tid: ptid
            if pn.length == 0 then return "".string
            s.append pn
            s.append ": "
        }
        s.append (instanceArgSpelling :st arg: (st.reg.genericArgAt specId: tid ordinal: i) :site)
        i = i + 1
    }
    if shown > 1 then return "(\{s})"
    return s
}

# instanceArgSpelling -- one argument of an instance as a program writes it.
# An instance that prints with one argument prints bare, so as an argument it
# takes the parentheses a longer one already carries.
instanceArgSpelling: function {
    st: zenv.ZSymbolTable.view
    arg: ztypes.genericarg
    site: ztypes.declid
} out String is {
    match (
        arg
    ) case typeArg then {
        at: displayTypeNameSt :st tid: arg :site
        if at.stringView.contains " " when (at.stringView.startsWith "(").not then return "(\{at})"
        return at
    } case valueArg then {
        return "\{arg}"
    }
}

# coreReexports -- core names the type under its own name, so `core.<name>`
# reaches it from any unit
coreReexports: function {st: zenv.ZSymbolTable.view base: ztypes.tid} out bool is {
    bd: ztypecheck.declOfTypeId :st tid: base
    if bd.isZero or st.typing.coreUnitRoot.isZero then return false
    nameId: (st.typing.decls.get i: bd).name
    return (st.typing.declFindChild parentDeclId: st.typing.coreUnitRoot :nameId).isZero.not
}

# isCoreLanguageUnit -- the unit is one whose types a program spells bare: the
# system, core and collections units, by their declarations
isCoreLanguageUnit: function {st: zenv.ZSymbolTable.view unitDecl: ztypes.declid} out bool is {
    if unitDecl.isZero then return false
    if unitDecl == st.typing.systemUnitRoot then return true
    if unitDecl == st.typing.coreUnitRoot then return true
    return unitDecl == st.typing.collectionsUnitRoot
}

# the hover display name of type `tid` (unit-qualified outside core/system).
displayTypeNameOfOpt: function {
    # the snapshot's checked program, none when the check did not run
    o: (Option zenv.ZSymbolTable).view
    # the type to name
    tid: ztypes.tid
    # the name's unit
    site: ztypes.declid
} out String is {
    match (
        o
    ) case some then {
        return (displayTypeNameSt st: o :tid :site)
    } case none then {
        return "".string
    }
}

# typeKindTextOpt -- a type definition's kind word ("class", "variant", ...)
# for hover, or "" when tid is 0 or names something other than a type def. A
# typedef says so and names its base: "typedef u64".
typeKindTextOpt: function {
    # the snapshot's checked program, if any
    o: (Option zenv.ZSymbolTable).view
    # the type whose kind is named
    tid: ztypes.tid
    # the card's unit
    site: ztypes.declid
} out String is {
    result: String
    if tid.isZero then return result
    match (
        o
    ) case some then {
        tdb: o.typing.typedefBaseTid.get key: tid
        match (
            tdb
        ) case some then {
            result = "typedef ".string
            result.append (displayTypeNameSt st: o tid: tdb :site)
            return result
        } case none then null
        tt: o.reg.typetypeOf typeId: tid
        match (
            tt
        ) case classType then {
            result = "class".string
        } case recordType then {
            result = "record".string
            # a static record is declared `data`, a static variant `choice`
            if (o.reg.isStaticOf :tid) then result = "data".string
        } case variantType then {
            result = "variant".string
            if (o.reg.isStaticOf :tid) then result = "choice".string
        } case unionType then {
            result = "union".string
        } case facetType then {
            result = "facet".string
        } case protocolType then {
            result = "protocol".string
        } else null
    } case none then null
    return result
}

# declNameText -- the name a declaration was declared under, or "".
declNameText: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    declId: ztypes.declid
} out String is {
    if declId.isZero then return "".string
    nm: zast.nameid
    decl: st.typing.decls.get i: declId
    nm = decl.name
    if nm.isZero then return "".string
    return (zast.poolTextCopy pool: ast.names ref: nm)
}

# defaultDisplay -- a defaulted param's recorded default rendered with its
# resolved type: a literal re-renders from its expression node as `v.<type>`
# (int) or `(v).<type>` (float); a function default is the target's bare name;
# an arm default is `<type>.<arm>`. "" when the param has no default.
defaultDisplay: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    dv: ztyping.defaultval
    typeName: StringView
} out String is {
    df: dv
    if df.func then return (declNameText :ast :st declId: df)
    {
        da: dv
        if da.arm then {
            arm: declNameText :ast :st declId: da
            if arm.length == 0 then return "".string
            r: typeName.string
            r.appendByte b: 46
            r.append arm
            return r
        }
    }
    dtextOwn: String
    dl: dv
    if dl.literal then {
        if dl.isZero then return "".string
        dtextOwn = ztypecheck.rootNameOf :ast n: (ast.nodes.get i: dl)
    }
    dk: dv
    if dk.constant then {
        # a named or computed scalar: the member's own name
        dtextOwn = declNameText :ast :st declId: dk
    }
    dtext: dtextOwn.stringView
    if dtext.length == 0 then return "".string
    # the type's spelling, read as the lexer reads a literal's suffix
    fk: ztypes.numkindByName name: typeName
    isFloat: fk.has and (ztypes.isFloatKind k: fk.kind)
    rr: String
    if isFloat then {
        rr.appendByte b: 40
        rr.append dtext
        rr.appendByte b: 41
        rr.appendByte b: 46
        rr.append typeName
    } else {
        rr.append dtext
        rr.appendByte b: 46
        rr.append typeName
    }
    return rr
}

# paramDocs -- map of parameter name -> its trailing `#` doc comment, read from
# the function's declaration source. Resolves the function tid to its
# functiondef node (via the namedoperation wrapper), then reads each parameter
# node's line; only a parameter that is the last on its source line takes that
# line's trailing comment. Empty when the function has no documented parameters.
paramDocs: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    vfs: zvfs.ZVfs
    tid: ztypes.tid
} out (Map String V: String) is {
    result: Map String V: String
    defNid: defNodeInfo :o :prog :tid member: ""
    if defNid.isZero then return result
    fnNid: zast.nodeid
    {
        wn: prog.nodes.get i: defNid
        if wn.namedoperation then fnNid = wn.operation
    }
    if fnNid.isZero then return result
    fsno: zvfs.fsno
    {
        {
            fsno = prog.fsnoForNode nodeid: fnNid
        }
    }
    if fsno.isZero then return result
    paramIds: ListVal zast.nodeid
    {
        {
            fd: prog.nodes.get i: fnNid
            if fd.functiondef then {
                pax1509: u64
                for pax1509 < fd.parameters.count loop {
                    pid: zast.kidAt kids: prog.kids span: fd.parameters i: pax1509
                    pax1509 = pax1509 + 1
                    paramIds.append pid
                }
            }
        }
    }
    pnms: List String
    plns: ListVal u32
    pk: u64
    for pk < paramIds.length loop {
        pid: paramIds.get i: pk
        nameRef: zast.nameid
        ln: u32
        {
            pnode: prog.nodes.get i: pid
            if pnode.namedoperation then {
                nameRef = pnode.name
                ln = pnode.lineno
            }
        }
        if nameRef.isZero.not then {
            nm: zast.nameTextCopy ast: prog ref: nameRef
            pnms.append nm
            plns.append ln
        }
        pk = pk + 1
    }
    ci: u64
    cn: pnms.length
    for ci < cn loop {
        lastOnLine: true
        nxt: ci + 1
        if nxt < cn then {
            thisLn: plns.get i: ci
            nextLn: plns.get i: nxt
            if nextLn == thisLn then lastOnLine = false
        }
        if lastOnLine then {
            curLn: plns.get i: ci
            tcm: trailingDocOf :vfs :fsno line1: curLn
            if tcm.length > 0 then {
                kk: (pnms.get i: ci).copy
                result.set key: kk value: tcm
            }
        }
        ci = ci + 1
    }
    return result
}

# paramStartsLine -- true when the source line `line1` (1-based) of file `fsno`,
# leading whitespace removed, begins with `name` -- the parameter starts its own
# line rather than sharing the function-head line with the name.
paramStartsLine: function {vfs: zvfs.ZVfs fsno: zvfs.fsno line1: u32 name: StringView} out bool is {
    result: false
    if line1 == 0 then return result
    lg: vfs.getline dentryid: fsno lineno: line1 - 1
    match (
        lg
    ) case some then {
        lv: lg.stringView
        tl: lv.trimStart
        if tl.startsWith name then result = true
    } case none then null
    return result
}

# paramLeadDocs -- map of parameter name -> the contiguous `#` doc block on the
# lines directly above the parameter's declaration, read from source. A block is
# taken only for a parameter that starts its own source line; a parameter sharing
# the function-head line or a preceding parameter's line has no line of its own
# above it. Empty when no parameter carries a leading block.
paramLeadDocs: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    vfs: zvfs.ZVfs
    tid: ztypes.tid
} out (Map String V: String) is {
    result: Map String V: String
    defNid: defNodeInfo :o :prog :tid member: ""
    if defNid.isZero then return result
    fnNid: zast.nodeid
    {
        wn: prog.nodes.get i: defNid
        if wn.namedoperation then fnNid = wn.operation
    }
    if fnNid.isZero then return result
    fsno: zvfs.fsno
    {
        {
            fsno = prog.fsnoForNode nodeid: fnNid
        }
    }
    if fsno.isZero then return result
    paramIds: ListVal zast.nodeid
    {
        {
            fd: prog.nodes.get i: fnNid
            if fd.functiondef then {
                pax1519: u64
                for pax1519 < fd.parameters.count loop {
                    pid: zast.kidAt kids: prog.kids span: fd.parameters i: pax1519
                    pax1519 = pax1519 + 1
                    paramIds.append pid
                }
            }
        }
    }
    pnms: List String
    plns: ListVal u32
    pk: u64
    for pk < paramIds.length loop {
        pid: paramIds.get i: pk
        nameRef: zast.nameid
        ln: u32
        {
            pnode: prog.nodes.get i: pid
            if pnode.namedoperation then {
                nameRef = pnode.name
                ln = pnode.lineno
            }
        }
        if nameRef.isZero.not then {
            nm: zast.nameTextCopy ast: prog ref: nameRef
            pnms.append nm
            plns.append ln
        }
        pk = pk + 1
    }
    ci: u64
    cn: pnms.length
    for ci < cn loop {
        firstOnLine: true
        if ci > 0 then {
            thisLn: plns.get i: ci
            prevLn: plns.get i: ci - 1
            if prevLn == thisLn then firstOnLine = false
        }
        if firstOnLine then {
            curLn: plns.get i: ci
            startsOwn: (paramStartsLine
                :vfs
                :fsno
                line1: curLn
                name: (pnms.get i: ci).stringView
            )
            if startsOwn then {
                blk: docBlockAboveOf :vfs :fsno line1: curLn
                if blk.length > 0 then {
                    kk: (pnms.get i: ci).copy
                    result.set key: kk value: blk
                }
            }
        }
        ci = ci + 1
    }
    return result
}

# ownershipSuffix -- a parameter's declared ownership as the text a signature
# spells after its type: ".take", ".borrow", ".view" or ".hold", and "" when
# the declaration records no ownership, which is the common case.
ownershipSuffix: function {
    st: zenv.ZSymbolTable.view
    parentTypeId: ztypes.tid
    nameId: zast.nameid
} out StringView is {
    oo: st.typing.declOwnershipOfId :parentTypeId :nameId
    match (
        oo
    ) case some then {
        if oo == ztypes.zparamownership.takeMode then return ".take"
        if oo == ztypes.zparamownership.borrowMode then return ".borrow"
        if oo == ztypes.zparamownership.viewMode then return ".view"
        if oo == ztypes.zparamownership.holdMode then return ".hold"
    } case none then null
    return ""
}

# paramDisplayOf -- one parameter as a signature spells it: "name: <default>"
# when the declaration carries a default value, "name: <type><ownership>"
# otherwise. The single renderer behind the hover signature, the signatureHelp
# parameter list and the argument-label completions.
paramDisplayOf: function {
    prog: Ast.view
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    pname: StringView
    ptid: ztypes.tid
    pnid: zast.nameid
    # the unit the parameter is shown in
    site: ztypes.declid
} out String is {
    owner: tid
    pid: pnid
    dv: st.typing.declDefaultOfId parentTypeId: owner nameId: pid
    ptn: displayTypeNameSt :st tid: ptid :site
    ps: pname.string
    ps.append ": "
    if dv.none then {
        ps.append ptn
        ps.append (ownershipSuffix :st parentTypeId: owner nameId: pid)
        return ps
    }
    dd: defaultDisplay ast: prog :st :dv typeName: ptn.stringView
    if dd.length > 0 then {
        ps.append dd
        return ps
    }
    ps.append ptn
    return ps
}

# returnSuffix -- the ownership a function's RESULT carries, as the text a
# signature spells after the return type: ".view", ".borrow", or "" when the
# result is owned.
returnSuffix: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out StringView is {
    rb: st.typing.funcReturnsBorrow.get key: tid
    match (
        rb
    ) case some then {
        if rb then {
            if ((st.typing.funcReturnsView.get key: tid).or d: false) then return ".view"
            return ".borrow"
        }
    } case none then null
    return ""
}

# fnReturnClause -- a function type's return clause as a signature spells it,
# " out T" or " outx T" with the result's own ownership suffixes after the
# type. "" when the function returns nothing.
fnReturnClause: function {
    # the checked program holding the function
    st: zenv.ZSymbolTable.view
    # the function type
    tid: ztypes.tid
    # the signature's unit
    site: ztypes.declid
} out String is {
    rets: String
    rr: ztypecheck.methodReturnOf :st mid: tid
    rtid: rr.or d: ztypes.tid
    if rtid.isZero then return rets
    if ((st.typing.funcPins.get key: tid).or d: false) then {
        rets.append " outx "
    } else {
        rets.append " out "
    }
    rets.append (displayTypeNameSt :st tid: rtid :site)
    rets.append (returnSuffix :st :tid)
    if ((st.typing.funcReturnsFrozen.get key: tid).or d: false) then rets.append ".hold"
    return rets
}

# paramDocLines -- each parameter's trailing doc and its leading doc block,
# index for index with `pnames`. Returns true when any parameter carries
# either, which is what forces the wrapped render however short the line is.
paramDocLines: function {
    pnames: (List String).view
    docs: (Map String V: String).view
    leads: (Map String V: String).view
    pdocs: List String
    pleads: List String
} out bool is {
    hasDocs: false
    pdi: u64
    for pdi < pnames.length loop {
        pdc: String
        plc: String
        {
            pn0: pnames.get i: pdi
            dgot: docs.get key: pn0
            match (
                dgot
            ) case some then {
                pdc = dgot.copy
            } case none then null
            lgot: leads.get key: pn0
            match (
                lgot
            ) case some then {
                plc = lgot.copy
            } case none then null
        }
        if pdc.length > 0 then hasDocs = true
        if plc.length > 0 then hasDocs = true
        pdocs.append pdc
        pleads.append plc
        pdi = pdi + 1
    }
    return hasDocs
}

# sigOneLine -- the whole signature on one line, "name: function {p: T q: U}"
# followed by the return clause; the parameter block is dropped when there are
# no parameters.
sigOneLine: function {name: StringView pdisp: (List String).view rets: StringView} out String is {
    one: name.string
    one.append ": function"
    if pdisp.length > 0 then {
        one.append " {"
        oi: u64
        for oi < pdisp.length loop {
            if oi > 0 then one.append " "
            one.append (pdisp.get i: oi)
            oi = oi + 1
        }
        one.append "}"
    }
    one.append rets
    return one
}

# docPrefixed -- a parameter's leading doc block as the comment lines a wrapped
# signature spells above it: a newline and "    # " before the block, and again
# in place of every newline inside it.
docPrefixed: function {block: StringView} out String is {
    r: String
    r.appendByte b: 10
    r.append "    # "
    wbj: u64
    for wbj < block.length loop {
        wcb: block.byteAt i: wbj
        match (
            wcb
        ) case some then {
            if wcb == 10 then {
                r.appendByte b: 10
                r.append "    # "
            } else {
                r.appendByte b: wcb
            }
        } case none then null
        wbj = wbj + 1
    }
    return r
}

# sigWrapped -- the signature laid out one parameter per line, the form `zl
# fmt` uses past 100 columns: each parameter's leading doc block above it and
# its trailing doc beside it.
sigWrapped: function {
    name: StringView
    pdisp: (List String).view
    pdocs: (List String).view
    pleads: (List String).view
    rets: StringView
} out String is {
    wrap: name.string
    wrap.append ": function {"
    wi: u64
    for wi < pdisp.length loop {
        wlb: pleads.get i: wi
        if wlb.length > 0 then wrap.append (docPrefixed block: wlb.stringView)
        wrap.appendByte b: 10
        wrap.append "    "
        wrap.append (pdisp.get i: wi)
        wpdc: pdocs.get i: wi
        if wpdc.length > 0 then {
            wrap.append "  # "
            wrap.append wpdc
        }
        wi = wi + 1
    }
    wrap.appendByte b: 10
    wrap.append "}"
    wrap.append rets
    return wrap
}

# fnSigTextOpt -- a function type's readable signature "name: function {p:
# T ...} out Ret", the receiver skipped; "" when the type is not a function.
fnSigTextOpt: function {
    vfs: zvfs.ZVfs
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    tid: ztypes.tid
    name: StringView
    # the unit the signature is shown in
    site: ztypes.declid
} out String is {
    docs: paramDocs :o :prog :vfs :tid
    leads: paramLeadDocs :o :prog :vfs :tid
    match (
        o
    ) case some then {
        isFn: false
        if (o.reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType then isFn = true
        if isFn.not then return "".string
        # the declared parameters, skipping the receiver; type names resolve
        # afterwards (the name read takes a lock on `o`)
        pnames: List String
        ptids: ListVal ztypes.tid
        pnids: ListVal zast.nameid
        {
            userParams :prog :o :tid names: pnames tids: ptids nameIds: pnids
        }
        # render each param display string once the member list is collected:
        # resolving a member declaration locks `o` exclusively. A defaulted
        # param shows its value; else its type + ownership.
        pdisp: List String
        pi: u64
        for pi < pnames.length loop {
            pn: pnames.get i: pi
            pdisp.append (paramDisplayOf
                :prog
                st: o
                :tid
                pname: pn.stringView
                ptid: (ptids.get i: pi)
                pnid: (pnids.get i: pi)
                :site
            )
            pi = pi + 1
        }
        rets: fnReturnClause st: o :tid :site
        # one line, or param-per-line (zl fmt >100-col style) when too long.
        pdocs: List String
        pleads: List String
        hasDocs: paramDocLines :pnames :docs :leads :pdocs :pleads
        one: sigOneLine :name :pdisp rets: rets.stringView
        if one.length <= 100 when hasDocs.not then return one
        if pdisp.length == 0 then return one
        return (sigWrapped :name :pdisp :pdocs :pleads rets: rets.stringView)
    } case none then {
        return "".string
    }
}

# fnParamDisplays -- the per-parameter display strings for a function tid
# (receiver skipped): each "name: <type>[.take/.borrow]" or "name: <default>",
# mirroring fnSigTextOpt's param rendering. Raw material for signatureHelp
# parameters.
fnParamDisplays: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    tid: ztypes.tid
    # the unit the parameters are shown in
    site: ztypes.declid
} out List String is {
    result: List String
    match (
        o
    ) case some then {
        pnames: List String
        ptids: ListVal ztypes.tid
        pnids: ListVal zast.nameid
        {
            userParams :prog :o :tid names: pnames tids: ptids nameIds: pnids
        }
        pi: u64
        for pi < pnames.length loop {
            pn: pnames.get i: pi
            result.append (paramDisplayOf
                :prog
                st: o
                :tid
                pname: pn.stringView
                ptid: (ptids.get i: pi)
                pnid: (pnids.get i: pi)
                :site
            )
            pi = pi + 1
        }
    } case none then null
    return result
}

# hoverMarkdown -- a hover result: `code` rendered as a fenced ```zerolang
# block (highlighted like source), then an optional doc block as markdown
# prose. `code` may be multi-line (a hand-wrapped signature).
hoverMarkdown: function {code: StringView doc: StringView} out Value is {
    v: String
    v.appendByte b: 96
    v.appendByte b: 96
    v.appendByte b: 96
    v.append "zerolang"
    v.appendByte b: 10
    v.append code
    v.appendByte b: 10
    v.appendByte b: 96
    v.appendByte b: 96
    v.appendByte b: 96
    if doc.length > 0 then {
        v.appendByte b: 10
        v.appendByte b: 10
        v.append doc
    }
    mk: newObj
    mk.set key: "kind".string value: Value.text "markdown".string
    mk.set key: "value".string value: Value.text v
    ho: newObj
    ho.set key: "contents".string value: Value.object mk
    return (Value.object ho)
}

# ---- def-node navigation (unit/body indexes into the program AST) ----

# defNodeInfo -- the target nodeid for a top-level def (member == "")
# or a named member inside it. Mono tids chase their generic origin.
defNodeInfo: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    tid: ztypes.tid
    member: StringView
} out zast.nodeid is {
    did: ztypes.declid
    match (
        o
    ) case some then {
        did = ztypecheck.declOfTypeId st: o :tid
    } case none then null
    if did.isZero then return zast.nodeid
    if member.length == 0 then return (declNodeOf :o declId: did)
    {
        mnid: zast.poolFind pool: prog.names text: member
        if mnid.isZero then return zast.nodeid
        mdid: ztypes.declid
        match (
            o
        ) case some then {
            mdid = o.typing.declFindChild parentDeclId: did nameId: mnid
        } case none then null
        return (declNodeOf :o declId: mdid)
    }
    return zast.nodeid
}

# locationValue -- an LSP Location for a target node ({} miss -> nul).
locationValue: function {
    snap: zcheck.CheckResult
    nid: zast.nodeid
    width: u32
    docRel: StringView
    docUri: StringView
    srcDir: StringView
    systemDir: StringView
    docText: StringView
    utf32: bool
} out Value is {
    pg: nodePosOf prog: snap.prog :nid
    line: pg.line
    col: pg.col
    if line == 0 then return Value.nul
    fs: zcheck.fsnoFor r: snap nodeid: nid
    if fs.isZero then return Value.nul
    own: fileIsDoc :snap :fs :docRel
    lineText: String
    # a utf-32 column is the codepoint column, which needs no line
    if utf32.not then {
        if own then {
            lineText = docLine text: docText lineno: line
        } else {
            lg: snap.vfs.getline dentryid: fs lineno: line - 1
            match (
                lg
            ) case some then {
                lineText = lg.copy
            } case none then null
        }
    }
    w: width
    if w == 0 then w = 1
    c0: encodedCol lineText: lineText.stringView cpCol1: col :utf32
    c1: encodedCol lineText: lineText.stringView cpCol1: col + w :utf32
    if c1 <= c0 then c1 = c0 + 1
    uri: fileUri :snap :fs :own :docUri :srcDir :systemDir
    return (locationObj uri: uri.stringView line0: line - 1 :c0 :c1)
}

# fileIsDoc -- file `fs` is the open document's, whose text is the buffer the
# editor holds rather than what is on disk.
fileIsDoc: function {
    snap: zcheck.CheckResult
    fs: zvfs.fsno
    docRel: StringView
} out bool is {
    pp: snap.vfs.pathfromprovider dentryid: fs
    return (pathMatches pv: pp.stringView rel: docRel)
}

# fileUri -- the uri a Location in file `fs` carries: the document's own, or the
# file's path on disk.
fileUri: function {
    snap: zcheck.CheckResult
    fs: zvfs.fsno
    # the file is the document's
    own: bool
    docUri: StringView
    srcDir: StringView
    systemDir: StringView
} out String is {
    if own then return docUri.string
    absp: snap.vfs.pathfromproviderNative dentryid: fs
    if absp.length == 0 then {
        pp: snap.vfs.pathfromprovider dentryid: fs
        st0: u64
        if pp.startsWith "/" then st0 = 1
        rel0: pp.substring from: st0 to: pp.length
        absp = absRelPath :rel0 :srcDir :systemDir
    }
    return (pathToUri file: absp.stringView)
}

# locationObj -- an LSP Location: `uri`, on 0-based line `line0`, from column
# `c0` up to `c1`.
locationObj: function {uri: StringView line0: u32 c0: u32 c1: u32} out Value is {
    st: newObj
    st.set key: "line".string value: Value.intval line0.i64
    st.set key: "character".string value: Value.intval c0.i64
    en: newObj
    en.set key: "line".string value: Value.intval line0.i64
    en.set key: "character".string value: Value.intval c1.i64
    rg: newObj
    rg.set key: "start".string value: Value.object st
    rg.set key: "end".string value: Value.object en
    lo: newObj
    lo.set key: "uri".string value: Value.text uri.string
    lo.set key: "range".string value: Value.object rg
    return (Value.object lo)
}

# defNodeOf -- the def-node id a resolved hit points at: a variable binding
# (refVid), a type/function def (refTid), or an owner's member (refOwner +
# member name); 0 when unresolved.
defNodeOf: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    refVid: ztypes.vid
    refTid: ztypes.tid
    refOwner: ztypes.tid
    member: StringView
} out zast.nodeid is {
    if refVid.isZero.not then return (varDefNode :o vid: refVid)
    if refTid.isZero.not then return (defNodeInfo
        :o
        :prog
        tid: refTid
        member: ""
    )
    if refOwner.isZero.not then return (defNodeInfo
        :o
        :prog
        tid: refOwner
        :member
    )
    return zast.nodeid
}

# trailingDocOf -- the text of a trailing `#` comment on `line1` (1-based) of
# file `fsno`, the `#` and surrounding space stripped; "" when there is none.
# Surfaces a field's or parameter's inline doc in hover.
trailingDocOf: function {vfs: zvfs.ZVfs fsno: zvfs.fsno line1: u32} out String is {
    result: String
    if line1 == 0 then return result
    lg: vfs.getline dentryid: fsno lineno: line1 - 1
    match (
        lg
    ) case some then {
        lv: lg.stringView
        n: lv.length
        inStr: false
        hashAt: u64
        found: false
        i: u64
        for i < n loop {
            b: lv.byteAt :i
            match (
                b
            ) case some then {
                if b == 34 then inStr = inStr.not
                if b == 35 when inStr.not when found.not then {
                    hashAt = i
                    found = true
                }
            } case none then null
            if found then break
            i = i + 1
        }
        if found then {
            after: lv.substring from: hashAt + 1 to: n
            trimmed: after.trim
            result = trimmed.string
        }
    } case none then null
    return result
}

# docBlockAboveOf -- the contiguous `#` comment block immediately above `line1`
# (1-based) in file `fsno`, each line stripped of its leading "# " and joined
# top-to-bottom by newlines; "" when there is none. Reads through the vfs.
docBlockAboveOf: function {vfs: zvfs.ZVfs fsno: zvfs.fsno line1: u32} out String is {
    if line1 <= 1 then return "".string
    acc: List String
    k: line1
    for k > 1 loop {
        k = k - 1
        lg: vfs.getline dentryid: fsno lineno: k - 1
        stop: false
        match (
            lg
        ) case some then {
            lv: lg.stringView
            tl: lv.trimStart
            if tl.startsWith "#" then {
                st: 1.u64
                sb: tl.byteAt i: 1
                match (
                    sb
                ) case some then {
                    if sb == 32 then st = 2
                } case none then null
                ds: tl.substring from: st to: tl.length
                acc.append ds.string
            } else {
                stop = true
            }
        } case none then {
            stop = true
        }
        if stop then break
    }
    result: String
    ai: acc.length
    for ai > 0 loop {
        ai = ai - 1
        if result.length > 0 then result.appendByte b: 10
        dl: acc.get i: ai
        result.append dl
    }
    return result
}

# docCommentForNode -- the contiguous `#` comment block immediately above the
# definition at `defLine` (1-based) in file `fsno`; "" when there is none.
# Reads through the vfs, so a definition in another unit works too.
docCommentForNode: function {snap: zcheck.CheckResult fsno: zvfs.fsno defLine: u32} out String is {
    r: docBlockAboveOf vfs: snap.vfs :fsno line1: defLine
    return r
}

# unitFsnoByName -- the file of the TOP-LEVEL unit named `name`: the file its
# body was parsed from, never a file that merely shares the name (a subunit
# `holder/util.z` is not the unit `util`). 0 when the program has no such unit,
# or the unit has no member to place it.
unitFsnoByName: function {snap: zcheck.CheckResult.view name: StringView} out zvfs.fsno is {
    lu: zsource.lintedUnitNamed prog: snap.prog uname: name
    if lu.op.isZero then return zvfs.fsno
    return (zsource.unitAnchorFsno prog: snap.prog mainOp: lu.op)
}

# unitFsnoOfDecl -- the file of the unit declared by `declId` (a subunit
# reference resolves to its declaration): the file its body was parsed from.
# The declaration's own node is minted after that file closes and lies in
# none, so the body answers. 0 when it has no member to place it.
unitFsnoOfDecl: function {snap: zcheck.CheckResult.view declId: ztypes.declid} out zvfs.fsno is {
    dn: declNodeOf o: snap.st :declId
    if dn.isZero then return zvfs.fsno
    op: dn
    n: snap.prog.nodes.get i: dn
    if n.namedoperation then op = n.operation
    if (snap.prog.nodes.get i: op).unitdef.not then return zvfs.fsno
    return (zsource.unitAnchorFsno prog: snap.prog mainOp: op)
}

# unitGenericParamsOf -- a unitdef's generic parameters rendered " {T U}"
# (its `T: base.generic` body declarations); "" when it has none.
unitGenericParamsOf: function {ast: Ast.view udId: zast.nodeid} out String is {
    ud: ast.nodes.get i: udId
    result: String
    if ud.unitdef then {
        box2039: u64
        for box2039 < ud.body.count loop {
            gm9Id: zast.kidAt kids: ast.kids span: ud.body i: box2039
            box2039 = box2039 + 1
            gm: ast.nodes.get i: gm9Id
            if gm.namedoperation when (ztypecheck.isBareGenericParam
                :ast
                op: (ast.nodes.get i: gm.operation)
            ) then {
                gpn: zast.nameTextAt :ast ref: gm.name
                if result.length == 0 then result.append " {"
                if result.length > 2 then result.append " "
                result.append gpn
            }
        }
    }
    if result.length > 0 then result.append "}"
    return result
}

# unitGenericSuffix -- the " {T U}" suffix for a generic unit named `name`.
unitGenericSuffix: function {prog: Ast.view name: StringView} out String is {
    result: String
    {
        uCnt9a: prog.units.length
        uIdx9a: u64
        for uIdx9a < uCnt9a loop {
            u9Id: prog.units.get i: uIdx9a
            uIdx9a = uIdx9a + 1
            opId: zast.nodeid
            u: prog.nodes.get i: u9Id
            if u.namedoperation then {
                lb: zast.poolTextAt pool: prog.names ref: u.name
                if lb.stringView == name then opId = u.operation
            }
            if opId.isZero.not then {
                gs: (unitGenericParamsOf
                    ast: prog
                    udId: opId
                )
                if gs.length > 0 then result = gs.take
            }
        }
    }
    return result
}

# unitDocComment -- a unit file's godoc-style header: the contiguous `#`
# comment lines from the top of the file, up to the first blank line or
# first definition. "" when the file has no header comment.
unitDocComment: function {snap: zcheck.CheckResult fsno: zvfs.fsno} out String is {
    result: String
    k: u64
    for true loop {
        lg: snap.vfs.getline dentryid: fsno lineno: k
        stop: false
        match (
            lg
        ) case some then {
            lv: lg.stringView
            tl: lv.trimStart
            if tl.startsWith "#" then {
                st: 1.u64
                sb: tl.byteAt i: 1
                match (
                    sb
                ) case some then {
                    if sb == 32 then st = 2
                } case none then null
                ds: tl.substring from: st to: tl.length
                if result.length > 0 then result.appendByte b: 10
                result.append ds
            } else {
                stop = true
            }
        } case none then {
            stop = true
        }
        if stop then break
        k = k + 1
    }
    return result
}

# locationAtFileTop -- an LSP Location at line 0 of file `fsno` (a unit
# reference has no member node to point at).
locationAtFileTop: function {
    snap: zcheck.CheckResult
    fsno: zvfs.fsno
    docRel: StringView
    docUri: StringView
    srcDir: StringView
    systemDir: StringView
} out Value is {
    if fsno.isZero then return Value.nul
    own: fileIsDoc :snap fs: fsno :docRel
    uri: fileUri :snap fs: fsno :own :docUri :srcDir :systemDir
    return (locationObj uri: uri.stringView line0: 0 c0: 0 c1: 0)
}

# dispositionNote -- a call argument's disposition (from the argDisposition
# stamp) as a one-line prose note, or "".
dispositionNote: function {o: (Option zenv.ZSymbolTable).view nid: zast.nodeid} out String is {
    match (
        o
    ) case some then {
        d: o.typing.argDisposition.get key: nid
        match (
            d
        ) case some then {
            if d == ztypes.zparamownership.takeMode then {
                return "Moved into the call (a taking parameter).".string
            }
            if d == ztypes.zparamownership.borrowMode then {
                return "Borrowed for the duration of the call.".string
            }
            if d == ztypes.zparamownership.viewMode then {
                return "Read through a view for the duration of the call.".string
            }
            if d == ztypes.zparamownership.holdMode then {
                return "Held: moved in and frozen, the caller keeps the storage.".string
            }
        } case none then null
    } case none then null
    return "".string
}

# inferredGenericLines -- concrete generic bindings inferred for the call
# `callId` whose callee is `calleeNid`, one "# T = Type" comment per bound
# generic param (from the callGenericBinding stamp), or "".
inferredGenericLines: function {
    o: Option zenv.ZSymbolTable
    prog: Ast.view
    callId: zast.nodeid
    # the unit the inferred arguments are shown in
    site: ztypes.declid
} out String is {
    match (
        o
    ) case some then {
        holders: List String
        tids: ListVal ztypes.tid
        {
            for each e: o.typing.callGenericBinding.iterateItems loop {
                if e.key.call == callId then {
                    hv: (zast.poolTextCopy
                        pool: prog.names
                        ref: e.key.param
                    )
                    holders.append hv
                    tids.append e.value
                }
            }
        }
        r: String
        hi: u64
        for hi < holders.length loop {
            tn: displayTypeNameSt st: o tid: (tids.get i: hi) :site
            if r.length > 0 then r.appendByte b: 10
            r.append "# "
            r.append (holders.get i: hi)
            r.append " = "
            r.append tn
            hi = hi + 1
        }
        return r
    } case none then {
        return "".string
    }
}

# isInstanceOfOpt -- `tid` is a monomorphised instance of the template `tpl`.
isInstanceOfOpt: function {
    o: (Option zenv.ZSymbolTable).view tid: ztypes.tid tpl: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if tid == tpl then return false
    match (
        o
    ) case some then {
        return (o.reg.genericOriginOf :tid) == tpl
    } case none then {
        return false
    }
}

# declAnnotation -- what a reference with no variable names, as a hover's `#`
# note: a type's `as` constant is "constant"; a unit's own definition takes none
# (its card names it by its full path), nor does a type's field or conformance
# read off a value. "" when the reference resolved to no declaration.
declAnnotation: function {o: (Option zenv.ZSymbolTable).view nid: zast.nodeid} out String is {
    rd: refDeclOf :o :nid
    if rd.isZero then return "".string
    match (
        o
    ) case some then {
        if (o.typing.isAsConstDecl declId: rd) then return "constant".string
        return "".string
    } case none then {
        return "".string
    }
}

# refAnnotation -- a value reference's ownership + scope origin (+ borrow
# source) as an in-fence `#` comment body: "owned local" / "borrowed
# parameter" / "borrowed local, from s" / "constant"; "" when the reference
# carries no stamped ownership/origin.
refAnnotation: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    vid: ztypes.vid
    nid: zast.nodeid
} out String is {
    if vid.isZero then return (declAnnotation :o :nid)
    match (
        o
    ) case some then {
        if (o.reg.hasVariable id: vid).not then return "".string
        own: String
        vo: o.reg.variableOwnershipOf id: vid
        if vo == ztypes.zownership.owned then own = "owned".string
        if vo == ztypes.zownership.borrowed then own = "borrowed".string
        orig: String
        ro: o.reg.variableOriginOf id: vid
        if ro == ztypes.zvarorigin.param then orig = "parameter".string
        if ro == ztypes.zvarorigin.local then orig = "local".string
        if own.length == 0 when orig.length == 0 then return "".string
        r: String
        if own.length > 0 then r.append own
        if orig.length > 0 then {
            if r.length > 0 then r.append " "
            r.append orig
        }
        bo: o.reg.variableBorrowOriginOf id: vid
        if bo.isZero.not then {
            {
                r.append ", from "
                r.append (zast.poolTextAt pool: prog.names ref: bo)
            }
        }
        return r
    } case none then {
        return "".string
    }
}

# navhit -- what navResolve found under the cursor: the span row it landed on,
# and the target that row resolves to. An absent option means the cursor sat on
# nothing and every mode answers null. The row's NAME is not a field because a
# record holds no reftype; the caller reads it from the Spans by `idx`.
navhit: record {
    # the span row's index, which is also its index in the Spans' name list
    idx: u64
    # the row kind that won the hit test (1 use, 2 member, 3 binding, 6
    # declaration, 7 operator)
    kind: u8
    # the hit span's width in columns, which a Location needs
    width: u32
    # the node the hit resolves through: the row's own, or, for a call label,
    # the operation of the parameter or field it names
    nodeid: zast.nodeid
    # the node whose passing a hover notes: the row's own, which for a call
    # label is the argument's value; a `for` binding's arm, which is passed
    # nowhere
    argNode: zast.nodeid
    # the variable the reference resolved to, zero when it is not one
    vid: ztypes.vid
    # the type the reference resolved to, zero when it is not one
    tid: ztypes.tid
    # the owner type of a member hit, zero when it is not one
    owner: ztypes.tid
    # the Decl the reference resolved to; a re-export keeps its own
    declId: ztypes.declid
    # set when the name denotes a UNIT rather than anything inside one
    unitFsno: zvfs.fsno
}

# bestSpanRow -- the span row under the cursor in this document; where rows
# overlap, the highest-ranked kind wins. -1 when no row covers the cursor.
bestSpanRow: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    docRel: StringView
    l1u: u32
    cp1: u32
} out i64 is {
    bestIdx: -1
    bestKind: u8
    nr: sp.rows.length
    ri: u64
    for ri < nr loop {
        row: sp.rows.get i: ri
        if row.line == l1u when row.colLo <= cp1 when cp1 < row.colHi then {
            fs: zcheck.fsnoFor r: snap nodeid: row.nodeid
            pp: snap.vfs.pathfromprovider dentryid: fs
            outranks: (spanKindRank kind: row.kind) > (spanKindRank kind: bestKind)
            if (pathMatches pv: pp.stringView rel: docRel) when (bestIdx < 0) or outranks then {
                bestIdx = ri.i64.orPanic
                bestKind = row.kind
            }
        }
        ri = ri + 1
    }
    return bestIdx
}

# navtarget -- what a hit resolved to; each zero when the reference is not one.
navtarget: record {
    # the variable
    vid: ztypes.vid
    # the type
    tid: ztypes.tid
    # the owner type of a member hit
    owner: ztypes.tid
    # the Decl (surface: a re-export keeps its own Decl); it fills the type id
    # for hits only the Decl layer knows (public-interface entries)
    declId: ztypes.declid
}

# navTargetByKind -- what a hit's kind says it names: a use is a variable or a
# unit; a member has an owner (a unit-qualified member has no owner stamp and
# falls back to its def tid); a binding is its variable; a declaration is its
# type, then a unit, then its own variable, until defOwnTarget makes a
# parameter, a field or an arm its own. The Decl comes from refDecl.
navTargetByKind: function {snap: zcheck.CheckResult hnid: zast.nodeid kind: u8} out navtarget is {
    if kind == 2 then return (memberNavTarget :snap :hnid)
    if kind == 1 then return (useNavTarget :snap :hnid)
    refVid: ztypes.vid
    refTid: ztypes.tid
    if kind == 3 then refVid = defVarIdOf o: snap.st nid: hnid
    if kind == 6 then {
        refTid = nodeTypeAt o: snap.st nid: hnid
        if refTid.isZero then refTid = useUnitDef o: snap.st nid: hnid
        if refTid.isZero then refVid = defVarIdOf o: snap.st nid: hnid
    }
    return (navtarget
        vid: refVid
        tid: refTid
        owner: ztypes.tid
        declId: (refDeclOf o: snap.st nid: hnid)
    )
}

# useNavTarget -- what a use row names: a variable, or a unit's definition. A
# label that binds (the `:this` of a signature) is its variable, not the type
# its refDecl names.
useNavTarget: function {snap: zcheck.CheckResult hnid: zast.nodeid} out navtarget is {
    rd: refDeclOf o: snap.st nid: hnid
    rv: useVarId o: snap.st nid: hnid
    if rv.isZero.not then return (navtarget vid: rv tid: ztypes.tid owner: ztypes.tid declId: rd)
    if (snap.prog.nodes.get i: hnid).labelvalue then {
        bv: defVarIdOf o: snap.st nid: hnid
        if bv.isZero.not then return (navtarget
            vid: bv
            tid: ztypes.tid
            owner: ztypes.tid
            declId: ztypes.declid
        )
    }
    return (navtarget
        vid: rv
        tid: (useUnitDef o: snap.st nid: hnid)
        owner: ztypes.tid
        declId: rd
    )
}

# defOwnTarget -- a definition's hit as its own Decl: one whose value carries no
# stamp (`S: "top"`, which a fold reads without walking), or one whose value
# names another declaration (`START: mode.slow`, an arm) when it holds a value.
# A parameter, a field or an arm is its own declaration too, never the type it
# is declared with, which its row's node carries. `t` as it is otherwise, and
# for any hit but a definition's.
defOwnTarget: function {
    snap: zcheck.CheckResult
    # the definition's value node, which its row is keyed on
    hnid: zast.nodeid
    # the definition's name
    hnm: StringView
    # the hit's row kind; 6 is a definition's
    kind: u8
    t: navtarget
} out navtarget is {
    if kind != 6 then return t
    dd: declOfDefOp o: snap.st prog: snap.prog opId: hnid name: hnm
    # a parameter's own declaration, never the Decl its type's node resolves
    # to -- a generic parameter's, at `v: t`
    if (declKindIsParam :snap declId: dd) then return (navtarget
        vid: (defVarIdOf o: snap.st nid: hnid)
        tid: ztypes.tid
        owner: ztypes.tid
        declId: dd
    )
    if t.vid.isZero.not or dd.isZero then return t
    if (declIsMember :snap declId: dd) then return (navtarget
        vid: ztypes.vid
        tid: ztypes.tid
        owner: (declOwnerOf o: snap.st declId: dd)
        declId: dd
    )
    if dd == t.declId then return t
    if t.declId.isZero when t.tid.isZero then {
        return (navtarget vid: t.vid tid: t.tid owner: t.owner declId: dd)
    }
    if (declHoldsValue :snap declId: dd).not then return t
    return (navtarget
        vid: t.vid
        tid: (declTypeIdOf o: snap.st declId: dd)
        owner: t.owner
        declId: dd
    )
}

# declIsMember -- declaration `declId` is a field or an arm of its type.
declIsMember: function {snap: zcheck.CheckResult.view declId: ztypes.declid} out bool is {
    if declId.isZero then return false
    o: snap.st
    match (
        o
    ) case some then {
        k: (o.typing.decls.get i: declId).kind
        return k.fieldDecl or k.armDecl
    } case none then {
        return false
    }
}

# declHoldsValue -- the declaration holds a compile-time value.
declHoldsValue: function {snap: zcheck.CheckResult declId: ztypes.declid} out bool is {
    o: snap.st
    match (
        o
    ) case some then {
        return (ztypecheck.constValueOfDeclLate st: o ast: snap.prog :declId).kind.none.not
    } case none then {
        return false
    }
}

# declOfDefOp -- the Decl a definition declares, by its name and the value node
# its declaration row is keyed on; 0 when none does. A scan, names compared
# first: no table maps a definition back to its Decl, and only a definition
# whose value carries no stamp asks -- a unit constant (`S: "top"`), which a
# fold reads without walking.
declOfDefOp: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    opId: zast.nodeid
    name: StringView
} out ztypes.declid is {
    nm: zast.poolFind pool: prog.names text: name
    if nm.isZero then return ztypes.declid.zero
    match (
        o
    ) case some then {
        k: u64
        for each d: o.typing.decls loop {
            if d.name == nm when d.node.isZero.not then {
                arm: prog.nodes.get i: d.node
                if arm.namedoperation when arm.operation == opId then return (ztypes.declid k)
            }
            k = k + 1
        }
    } case none then null
    return ztypes.declid.zero
}

# memberNavTarget -- what a member hit names: its owner, a list's member
# (listMemberDecl), or, for a unit-qualified member with no owner stamp, its
# def tid.
memberNavTarget: function {snap: zcheck.CheckResult hnid: zast.nodeid} out navtarget is {
    refTid: ztypes.tid
    refDecl: refDeclOf o: snap.st nid: hnid
    refOwner: memberOwnerOf o: snap.st nid: hnid
    lm: ztypes.declid
    if refOwner.isZero then lm = listMemberDecl :snap dpid: hnid
    if lm.isZero.not then refDecl = lm
    if refOwner.isZero when lm.isZero then refTid = useUnitDef o: snap.st nid: hnid
    return (navtarget vid: ztypes.vid tid: refTid owner: refOwner declId: refDecl)
}

# listDeclOfNodeOpt -- the list declaration node `nid` names (`codes`,
# `zast.wellKnown`), the declaration the checker resolved it to; 0 for any
# other node.
listDeclOfNodeOpt: function {
    o: (Option zenv.ZSymbolTable).view nid: zast.nodeid
} out ztypes.declid is {
    d: refDeclOf :o :nid
    if d.isZero then return d
    match (
        o
    ) case some then {
        if (o.typing.decls.get i: d).kind.staticListDecl then return d
    } case none then null
    return ztypes.declid.zero
}

# listMemberDecl -- the declaration a member read `dpid` of a list names: its
# element, by label or ordinal -- a label's position, `blk.slot.label`, is its
# element's too -- and the list itself for its count, which has no
# declaration of its own. 0 when the path reads no list.
listMemberDecl: function {snap: zcheck.CheckResult dpid: zast.nodeid} out ztypes.declid is {
    baseId: zast.nodeid
    nm: zast.nameid
    {
        n: snap.prog.nodes.get i: dpid
        if n.dottedpath then {
            c: snap.prog.nodes.get i: n.child
            if c.atomid then {
                baseId = n.parent
                nm = c.name
            }
        }
    }
    if baseId.isZero then return ztypes.declid.zero
    ld: listDeclOfNodeOpt o: snap.st nid: baseId
    if ld.isZero then {
        b: snap.prog.nodes.get i: baseId
        if b.dottedpath when (
            (atomNameOfNode prog: snap.prog nid: b.child) == zast.wellKnown.slot.wkSlot
        ) then {
            ld = listDeclOfNodeOpt o: snap.st nid: b.parent
        }
    }
    if ld.isZero then return ld
    o: snap.st
    match (
        o
    ) case some then {
        e: o.typing.declFindChild parentDeclId: ld nameId: nm
        if e.isZero.not then return e
    } case none then null
    return ld
}

# atomNameOfNode -- the name an atom node spells, 0 for any other node
atomNameOfNode: function {prog: Ast.view nid: zast.nodeid} out zast.nameid is {
    n: prog.nodes.get i: nid
    if n.atomid then return n.name
    return zast.nameid.zero
}

# listOfDeclOpt -- the list declaration `declId` is or belongs to: a list's own,
# or its element's list. 0 for any other declaration.
listOfDeclOpt: function {
    o: (Option zenv.ZSymbolTable).view declId: ztypes.declid
} out ztypes.declid is {
    if declId.isZero then return declId
    match (
        o
    ) case some then {
        d: o.typing.decls.get i: declId
        if d.kind.staticListDecl then return declId
        if d.parent.isZero.not when (o.typing.decls.get i: d.parent).kind.staticListDecl then {
            return d.parent
        }
    } case none then null
    return ztypes.declid.zero
}

# listMemberHit -- the hit is a list's member: an element, named where the list
# declares it or read through it, or the list's count read through it.
listMemberHit: function {snap: zcheck.CheckResult hit: navhit} out bool is {
    ld: listOfDeclOpt o: snap.st declId: hit.declId
    if ld.isZero then return false
    return (ld != hit.declId) or (hit.kind == 2)
}

# listMemberPrefix -- the path a list member's hit is spelled through: its
# list's, `nav.primes`; "" when the hit is no list's member.
listMemberPrefix: function {snap: zcheck.CheckResult hit: navhit} out String is {
    if (listMemberHit :snap :hit).not then return "".string
    lp: listPathOpt :snap declId: (listOfDeclOpt o: snap.st declId: hit.declId)
    # a label's position is read through the list's `slot`
    if (readsListSlotOpt :snap nid: hit.nodeid) then lp.append ".slot"
    return lp
}

# nodeConstOpt -- the value the check folded node `nid` to, over the LSP's
# optional snapshot; none when it folded to none.
nodeConstOpt: function {o: (Option zenv.ZSymbolTable).view nid: zast.nodeid} out ztypes.cval is {
    match (
        o
    ) case some then {
        return ((o.typing.nodeConst.get key: nid).or d: ztypes.noConst)
    } case none then null
    return ztypes.noConst
}

# listPathOpt -- the path a list is spelled through, `nav.primes`.
listPathOpt: function {snap: zcheck.CheckResult declId: ztypes.declid} out String is {
    ld: declId
    o: snap.st
    match (
        o
    ) case some then {
        up: ztypecheck.unitPathOfDecl st: o declId: ld
        nm: zast.nameTextAt ast: snap.prog ref: (o.typing.decls.get i: ld).name
        if up.length > 0 then up.appendByte b: 46
        up.append nm
        return up
    } case none then null
    return "".string
}

# listRowTidOpt -- when `declId` is a list's element, the type its list row
# gives a read of it (`elem`) or of its label's position (`slot`). 0 otherwise.
listRowTidOpt: function {
    snap: zcheck.CheckResult declId: ztypes.declid slot: bool
} out ztypes.tid is {
    ld: listOfDeclOpt o: snap.st :declId
    if ld.isZero or (ld == declId) then return ztypes.tid.zero
    o: snap.st
    match (
        o
    ) case some then {
        lv: ztypecheck.constValueOfDeclLate st: o ast: snap.prog declId: ld
        if lv.kind.aggKind.not then return ztypes.tid.zero
        g: o.typing.constAggs.get i: lv.aggId.u64
        if slot then return g.slot
        return g.elem
    } case none then null
    return ztypes.tid.zero
}

# listSlotValueOpt -- the position a label's position read `hit` names: its
# element's place in its list, typed as the list's `slot`.
listSlotValueOpt: function {snap: zcheck.CheckResult hit: navhit} out ztypes.cval is {
    ld: listOfDeclOpt o: snap.st declId: hit.declId
    if ld.isZero or (ld == hit.declId) then return ztypes.noConst
    o: snap.st
    match (
        o
    ) case some then {
        lv: ztypecheck.constValueOfDeclLate st: o ast: snap.prog declId: ld
        if lv.kind.aggKind.not then return ztypes.noConst
        g: o.typing.constAggs.get i: lv.aggId.u64
        po: o.typing.aggLabelPos id: lv.aggId label: (o.typing.decls.get i: hit.declId).name
        match (
            po
        ) case some then {
            cv: ztypes.makeIntConst po.i64.orPanic
            if g.slot != o.reg.literalIntTid when (ztypecheck.numKindOfTid
                st: o
                tid: g.slot
            ).has then cv = ztypes.typedConst c: cv numTid: g.slot
            return cv
        } case none then null
    } case none then null
    return ztypes.noConst
}

# readsListSlotOpt -- node `nid` reads a label's position, `blk.slot.label`.
readsListSlotOpt: function {snap: zcheck.CheckResult nid: zast.nodeid} out bool is {
    n: snap.prog.nodes.get i: nid
    if n.dottedpath.not then return false
    st0: ztypes.tid
    {
        o: snap.st
        match (
            o
        ) case some then {
            st0 = o.typing.listSlotTid
        } case none then null
    }
    return st0.isZero.not and ((nodeTypeAt o: snap.st nid: n.parent) == st0)
}

# isUnitTidOpt -- `tid` is a unit's type, over the LSP's optional snapshot.
isUnitTidOpt: function {o: (Option zenv.ZSymbolTable).view tid: ztypes.tid} out bool is {
    match (
        o
    ) case some then {
        return (o.reg.typetypeOf typeId: tid) == ztypes.ztypetype.unitType
    } case none then {
        return false
    }
}

# typeNamedAs -- type `tid`'s own name is `name`, its unit qualifier aside: the
# name in a construction names the type, where a value of the type would not.
# A unit is not asked.
typeNamedAs: function {
    o: (Option zenv.ZSymbolTable).view tid: ztypes.tid name: StringView
} out bool is {
    # a unit's name resolves through the unit lookup, which knows its file
    if (isUnitTidOpt :o :tid) then return false
    full: displayTypeNameOfOpt :o :tid site: ztypes.declid
    if full.stringView == name then return true
    dotted: ".\{name}"
    return (full.stringView.endsWith suffix: dotted)
}

# navTargetRefine -- the legs that need the Decl. An OPERATOR: the method the
# checker bound carries the doc, and surfaceDeclOfType finds the declaration
# that declares it. A generic parameter's own declaration: its table, not
# toolRefDecl, so the `.generic` member row sharing this node id keeps
# answering nothing. A DECLARATION whose written type is a literal type: the
# fold rewrote the node's stamp to i64/f64, so the card named the default
# while the doc beneath it described the literal type; the Decl is the honest
# answer. A PINNED literal -- `65` at a u8 parameter, or the base of `65.u8`
# -- was stamped with the type that pinned it and never wore a literal one,
# so the fold pass had nothing to record; its lexeme is the only tell left.
# Last, a hit only the Decl knows takes the Decl's type.
navTargetRefine: function {
    snap: zcheck.CheckResult
    hnid: zast.nodeid
    # the hit's name text
    hnm: StringView
    kind: u8
    base: navtarget
} out navtarget is {
    refTid: base.tid
    refDeclId: base.declId
    if kind == 6 when refDeclId.isZero then refDeclId = genericParamDeclOf o: snap.st nid: hnid
    own: (defOwnTarget
        :snap
        :hnid
        :hnm
        :kind
        t: (navtarget vid: base.vid tid: refTid owner: base.owner declId: refDeclId)
    )
    refDeclId = own.declId
    refTid = own.tid
    if kind == 6 when own.vid.isZero when own.owner.isZero when refDeclId.isZero.not then {
        dt9: declTypeIdOf o: snap.st declId: refDeclId
        if (isLiteralTid o: snap.st tid: dt9) then refTid = dt9
    }
    if kind == 1 when refDeclId.isZero when (ztypecheck.isNumericLiteralName name: hnm) then {
        refDeclId = (surfaceDeclOfType
            o: snap.st
            prog: snap.prog
            tid: (nodeTypeAt o: snap.st nid: hnid)
        )
    }
    if own.vid.isZero when refTid.isZero when own.owner.isZero when refDeclId.isZero.not then {
        refTid = declOnlyTid :snap declId: refDeclId
    }
    if kind == 1 when own.vid.isZero when refDeclId.isZero then {
        ct9: calleeTypeOf o: snap.st nid: hnid name: hnm
        if ct9.isZero.not then {
            refTid = ct9
            refDeclId = surfaceDeclOfType o: snap.st prog: snap.prog tid: ct9
        }
    }
    return (navtarget vid: own.vid tid: refTid owner: own.owner declId: refDeclId)
}

# declOnlyTid -- the type a hit that only its Decl resolves takes: the Decl's.
# A parameter is a value of its type, though a native's binds no variable.
declOnlyTid: function {snap: zcheck.CheckResult declId: ztypes.declid} out ztypes.tid is {
    if (declKindIsParam :snap :declId) then return ztypes.tid.zero
    return (declTypeIdOf o: snap.st :declId)
}

# calleeTypeOf -- the TYPE a name in callable position names (`Dog n: 7`, `Path
# s`), or 0 when the name at `nid` is not one. The checker stamps the name with
# the type it builds and keeps its refDecl free for the emitter, so the stamp is
# what says which type it is.
calleeTypeOf: function {
    o: (Option zenv.ZSymbolTable).view nid: zast.nodeid name: StringView
} out ztypes.tid is {
    ct: nodeTypeAt :o :nid
    if ct.isZero.not when (typeNamedAs :o tid: ct :name) then return ct
    return ztypes.tid.zero
}

# navResolve -- hit-test a cursor against the span index and resolve what it
# landed on. The three per-mode answers below all start here, so the resolution
# rules live in one place and cannot drift between definition, hover and
# references.
navResolve: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    docRel: StringView
    l1u: u32
    cp1: u32
} out optionval navhit is {
    bestIdx: bestSpanRow :snap :sp :docRel :l1u :cp1
    if bestIdx < 0 then return (optionval.none navhit)
    bi: bestIdx.u64.orPanic
    hit: sp.rows.get i: bi
    hnm: sp.names.get i: bi
    w: hit.colHi - hit.colLo
    hnid: labelSubject :snap :sp row: hit
    base: navTargetByKind :snap :hnid kind: hit.kind
    # a `for` binding is its variable, as its uses are
    lv: loopVarOf :snap :sp row: hit
    argNode: hit.nodeid
    if lv.isZero.not then {
        base = navtarget vid: lv tid: ztypes.tid owner: ztypes.tid declId: ztypes.declid
        argNode = sp.bindingArmOf nid: hit.nodeid
    }
    # a generic parameter's use is the parameter
    if hit.kind == 1 when base.vid.isZero then {
        gp: genericUseDecl :snap :sp nid: hit.nodeid name: hit.name
        if gp.isZero.not then base = (navtarget
            vid: ztypes.vid
            tid: ztypes.tid
            owner: ztypes.tid
            declId: gp
        )
    }
    # the arm a `case` names answers as its declaration does
    ca: caseArmDecl :snap :sp nid: hit.nodeid
    if ca.isZero.not then base = (navtarget
        vid: ztypes.vid
        tid: ztypes.tid
        owner: (declOwnerOf o: snap.st declId: ca)
        declId: ca
    )
    t: navTargetRefine :snap :hnid hnm: hnm.stringView kind: hit.kind :base
    # a unit's name answers with its FILE: a top-level unit's by name, a
    # subunit's through the declaration the checker resolved it to
    unitFsno: zvfs.fsno
    if t.vid.isZero when t.tid.isZero then {
        unitFsno = unitFsnoByName :snap name: hnm.stringView
    } else if t.vid.isZero when (isUnitTidOpt o: snap.st tid: t.tid) then {
        unitFsno = unitFsnoOfDecl :snap declId: t.declId
    }
    found: (navhit
        idx: bi
        kind: hit.kind
        width: w
        nodeid: hnid
        :argNode
        vid: t.vid
        tid: t.tid
        owner: t.owner
        declId: t.declId
        :unitFsno
    )
    return (optionval.some found)
}

# caseArmDecl -- the declaration the arm a `case` clause writes (`nid`) names:
# the subject's arm, for a union or a variant -- a typedef's base's, an
# instance's generic's -- or, for a match over a generic parameter, the type
# the name resolves to where the template writes it. 0 for a value match and
# any node that is no clause's arm. The checker resolves it by name too
# (checkCaseClause, dissectArmByType) and records nothing.
caseArmDecl: function {
    snap: zcheck.CheckResult sp: Spans.view nid: zast.nodeid
} out ztypes.declid is {
    subj: zast.nodeid
    fn: zast.nodeid
    sj: sp.caseArm.get key: nid
    match (
        sj
    ) case some then {
        subj = sj.subject
        fn = sj.fn
    } case none then {
        return ztypes.declid.zero
    }
    nm: zast.nameid
    {
        an: snap.prog.nodes.get i: nid
        if an.atomid then nm = an.name
    }
    t: nodeTypeAt o: snap.st nid: subj
    o: snap.st
    match (
        o
    ) case some then {
        if t.isZero or nm.isZero then return ztypes.declid.zero
        if (o.reg.isTypeParamOf tid: t) then return (dissectArmDecl prog: snap.prog :o :fn name: nm)
        sum: caseSumOf :o :t
        tt: o.reg.typetypeOf typeId: sum
        isSum: (tt == ztypes.ztypetype.unionType) or (tt == ztypes.ztypetype.variantType)
        td: ztypecheck.declOfTypeId st: o tid: sum
        if isSum.not or td.isZero then return ztypes.declid.zero
        return (o.typing.declFindChild parentDeclId: td nameId: nm)
    } case none then null
    return ztypes.declid.zero
}

# caseSumOf -- the sum a match on a `t` value dissects: a typedef's base, and a
# partial's generic, whose declaration holds the arms.
caseSumOf: function {o: zenv.ZSymbolTable.view t: ztypes.tid} out ztypes.tid is {
    cur: t
    hops: u32
    for hops < 64 loop {
        nx: (o.typing.typedefBaseTid.get key: cur).or d: ztypes.tid
        if nx.isZero then break
        cur = nx
        hops = hops + 1
    }
    if (o.reg.isPartialOf tid: cur) then {
        og: o.reg.genericOriginOf tid: cur
        if og.isZero.not then return og
    }
    return cur
}

# dissectArmDecl -- the type a clause of a match over a generic parameter
# names, looked up as dissection looks it up: from the template the match is
# written in, function `fn`, in its unit.
dissectArmDecl: function {
    prog: Ast.view o: zenv.ZSymbolTable.view fn: zast.nodeid name: zast.nameid
} out ztypes.declid is {
    if fn.isZero then return ztypes.declid.zero
    scope: ztypecheck.declOfTypeId st: o tid: (ztyping.nodeTypeAt tbl: o.typing.nodeType nid: fn)
    ud: scope
    hops: u32
    for ud.isZero.not and (hops < 64) loop {
        if (o.typing.decls.get i: ud).kind.unitDecl then break
        ud = o.typing.declParentOf declId: ud
        hops = hops + 1
    }
    if ud.isZero then return ud
    nm: zast.nameTextAt ast: prog ref: name
    at: (ztypecheck.walkLookupTyperefRo
        ast: prog
        st: o
        unitDecl: ud
        :scope
        base: nm.stringView
    )
    match (
        at
    ) case some then {
        return (ztypecheck.declOfTypeId st: o tid: at)
    } case none then null
    return ztypes.declid.zero
}

# loopVarOf -- the variable the `for` binding row `row` binds, or 0 when the row
# binds none. The checker binds it on the binding's value node, or, for a value
# walked through its type's `iterate`, on the `E.iterate` node it mints for the
# binding's arm; the value node's own stamps are the collection's.
loopVarOf: function {snap: zcheck.CheckResult sp: Spans.view row: spanrow} out ztypes.vid is {
    if row.kind != 6 then return ztypes.vid.zero
    arm: sp.bindingArmOf nid: row.nodeid
    if arm == row.nodeid then return ztypes.vid.zero
    v: defVarIdOf o: snap.st nid: row.nodeid
    if v.isZero.not then return v
    o: snap.st
    match (
        o
    ) case some then {
        mi: o.typing.forImplicitIterate.get key: arm
        match (
            mi
        ) case some then {
            return ((o.typing.defVariableId.get key: mi).or d: ztypes.vid.zero)
        } case none then null
    } case none then null
    return v
}

# labelSubject -- the node a hit on span row `row` resolves through: a call
# label's is the operation of the parameter or field it names, so the label
# answers as that declaration's own row does; any other row's is its own.
labelSubject: function {snap: zcheck.CheckResult sp: Spans.view row: spanrow} out zast.nodeid is {
    if row.kind != 6 then return row.nodeid
    lab: labelDeclOf :snap :sp :row
    if lab.isZero then return row.nodeid
    o: snap.st
    match (
        o
    ) case some then {
        arm: snap.prog.nodes.get i: (o.typing.decls.get i: lab).node
        if arm.namedoperation then return arm.operation
    } case none then null
    return row.nodeid
}

# genericParamHoverCard -- the card for a hit on a generic PARAMETER, or nul
# when the hit is not one. A generic parameter answers nothing through the type
# fallbacks -- its Decl has no type id and its node no stamp -- so it gets its
# own card. Never for a member row: the `.generic` selector shares the
# declaration's node id, and a card there would sit on a word that is not the
# parameter.
genericParamHoverCard: function {
    # the snapshot the card is built from
    snap: zcheck.CheckResult
    # the generic parameter under the cursor
    hit: navhit
    # the name under the cursor
    hname: StringView
    # the card's site
    site: ztypes.declid
} out Value is {
    if (hit.kind == 2) or hit.vid.isZero.not then return Value.nul
    gpd: hit.declId
    if gpd.isZero then return Value.nul
    gop: declOperationOf o: snap.st prog: snap.prog declId: gpd
    if (genericParamDeclOf o: snap.st nid: gop) != gpd then return Value.nul
    if (declNamed o: snap.st prog: snap.prog declId: gpd name: hname).not then return Value.nul
    gcard: genericParamCard o: snap.st prog: snap.prog :gpd :site
    if gcard.length == 0 then return Value.nul
    gdoc: String
    gown: genericParamOwner o: snap.st prog: snap.prog :gpd
    if gown.length > 0 then {
        gdoc.append "generic parameter of `"
        gdoc.append gown
        gdoc.appendByte b: 96
    }
    return (hoverMarkdown code: gcard.stringView doc: gdoc.stringView)
}

# hitReadsConstOpt -- the hit reads a constant: a bare name (`LIMIT`, `ON:
# true`, `M: mode.slow`) -- a use with no variable, resolved to a declaration,
# whose node carries the value the checker folded -- or a list's element
# or length read through the block. A numeric literal folds too and is not
# asked.
hitReadsConstOpt: function {
    o: (Option zenv.ZSymbolTable).view
    hit: navhit
    # the hit's written text
    name: StringView
} out bool is {
    # a list's element or length, read through the list
    if hit.kind == 2 when (listOfDeclOpt :o declId: hit.declId).isZero.not then {
        match (
            o
        ) case some then {
            return (o.typing.nodeConst.has key: hit.nodeid)
        } case none then {
            return false
        }
    }
    if hit.kind != 1 then return false
    if hit.vid.isZero.not then return false
    # a literal folds too, and is no constant's name
    if (ztypecheck.isNumericLiteralName :name) then return false
    if hit.declId.isZero then return false
    match (
        o
    ) case some then {
        return (o.typing.nodeConst.has key: hit.nodeid)
    } case none then {
        return false
    }
}

# hitIsConst -- the hit names a constant: one a use read (hitReadsConstOpt), or
# a declaration that holds a value -- a member read through a unit path
# (`z.build.os`), a declaration's own name, a list's element, a
# completion item. A label (`on: true`) carries its VALUE's Decl, under a name
# that is not the Decl's own.
hitIsConst: function {snap: zcheck.CheckResult hit: navhit name: StringView} out bool is {
    if (hitReadsConstOpt o: snap.st :hit :name) then return true
    if hit.vid.isZero.not then return false
    # a literal is no constant's name, whatever Decl its spelling reaches
    if (ztypecheck.isNumericLiteralName :name) then return false
    if (declNamed o: snap.st prog: snap.prog declId: hit.declId :name).not then return false
    return (constValueOfHit :snap :hit).kind.none.not
}

# declNamed -- the declaration's own name is `name`.
declNamed: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    declId: ztypes.declid
    name: StringView
} out bool is {
    if declId.isZero then return false
    match (
        o
    ) case some then {
        nm: (o.typing.decls.get i: declId).name
        if nm.isZero then return false
        return nm == (zast.poolFind pool: prog.names text: name)
    } case none then null
    return false
}

# constValueOfHit -- the value a constant's card shows: what the use site read,
# when the check folded it there, else what its declaration folds to.
constValueOfHit: function {snap: zcheck.CheckResult hit: navhit} out ztypes.cval is {
    # a label's position the check did not fold (an id-typed index)
    if hit.nodeid.isZero.not when (readsListSlotOpt :snap nid: hit.nodeid) when (nodeConstOpt
        o: snap.st
        nid: hit.nodeid
    ).kind.none then return (listSlotValueOpt :snap :hit)
    o: snap.st
    match (
        o
    ) case some then {
        if hit.nodeid.isZero.not then {
            g: o.typing.nodeConst.get key: hit.nodeid
            if g.some then return g
        }
        return (ztypecheck.constValueOfDeclLate st: o ast: snap.prog declId: hit.declId)
    } case none then {
        return ztypes.noConst
    }
}

# untypedConstTypeName -- `intliteral` or `floatliteral` when a constant's value
# is an untyped number (a unit constant `K: 10`, an element of a list that
# names no type), "" for anything else.
untypedConstTypeName: function {v: ztypes.cval} out String is {
    if v.numTid.isZero.not then return "".string
    if v.kind.ivalKind then return "intliteral".string
    if v.kind.fvalKind then return "floatliteral".string
    return "".string
}

# constHoverText -- a compile-time value as source spells it: an untyped number
# bare (`10`), a typed one with its type (`5.u8`), a typedef's as its
# construction (`rid 0`), a quoted string, an arm by its type's full path
# (`nav.mode.slow`). "" for no value.
constHoverText: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    v: ztypes.cval
    # the unit the constant's value is shown in
    site: ztypes.declid
} out String is {
    match (
        o
    ) case some then {
        if v.kind.ivalKind then return (typedNumberText
            st: o
            :v
            num: (ztypecheck.constIntText st: o :v)
            :site
        )
        if v.kind.fvalKind then return (typedNumberText
            st: o
            :v
            num: (ztypecheck.constFloatText st: o :v)
            :site
        )
        if v.kind.svalKind then {
            sv: o.typing.constStrings.get i: v.strId
            return "\"\{sv}\""
        }
        if v.kind.armKind then {
            arm: displayTypeNameSt st: o tid: v.armTid :site
            arm.appendByte b: 46
            arm.append (zast.poolTextAt pool: prog.names ref: v.armName)
            return arm
        }
        return "".string
    } case none then {
        return "".string
    }
}

# typedNumberText -- a number as source spells its type: bare when it has none,
# `5.u8` for a scalar, `rid 0` for a typedef, which constructs from its base
typedNumberText: function {
    st: zenv.ZSymbolTable.view
    v: ztypes.cval
    num: String.take
    # the unit the number's type is named in
    site: ztypes.declid
} out String is {
    if v.numTid.isZero then return num
    tn: displayTypeNameSt :st tid: v.numTid :site
    if (st.typing.typedefBaseName.has key: v.numTid) then return "\{tn} \{num}"
    # display text, not a key: the literal, its dot and its type
    r: num.take
    r.appendByte b: 46
    r.append tn
    return r
}

# constCard -- a constant's card in source syntax, by its full path: `nav.K: 10
# # intliteral`, `nav.LIMIT: 5.u8`, `nav.M: nav.mode.slow`, `nav.primes.0: 2
# # intliteral`, `nav.NAME: "zed"  # StringView` -- the binding a program could
# write, with its type as the comment where the value's spelling names none. ""
# when the value cannot be spelled.
constCard: function {
    # the snapshot a constant's card reads
    snap: zcheck.CheckResult
    # the constant's hit
    hit: navhit
    # the name under the cursor
    hname: String.view
    # the constant card's unit
    site: ztypes.declid
} out String is {
    v: constValueOfHit :snap :hit
    cv: constHoverText o: snap.st prog: snap.prog :v :site
    if cv.length == 0 then return "".string
    card: String
    pre: constPathPrefix :snap :hit :site
    if pre.length > 0 then {
        card.append pre
        card.appendByte b: 46
    }
    card.append hname
    card.append ": "
    card.append cv
    ut: untypedConstTypeName :v
    if v.kind.svalKind then {
        st9: hit.tid
        if st9.isZero then st9 = declTypeIdOf o: snap.st declId: hit.declId
        if st9.isZero then st9 = listRowTidOpt :snap declId: hit.declId slot: false
        if st9.isZero.not then ut = displayTypeNameOfOpt o: snap.st tid: st9 :site
    }
    # a label's position in a list indexed by an id type is a value of that
    # type, which the number the checker folded does not carry
    if ut.length > 0 when (readsListSlotOpt :snap nid: hit.nodeid) then {
        dt: listRowTidOpt :snap declId: hit.declId slot: true
        if dt.isZero.not when (isLiteralTid o: snap.st tid: dt).not then {
            ut = displayTypeNameOfOpt o: snap.st tid: dt :site
        }
    }
    if ut.length > 0 then {
        card.append "  # "
        card.append ut
    }
    return card
}

# constPathPrefix -- what a constant's name is spelled through: its owner (a
# list, `nav.primes`) when it has one, else the units its declaration sits in
constPathPrefix: function {
    # the snapshot the hover reads
    snap: zcheck.CheckResult
    # the constant under the cursor
    hit: navhit
    # the hover's unit
    site: ztypes.declid
} out String is {
    if hit.owner.isZero.not then return (displayTypeNameOfOpt o: snap.st tid: hit.owner :site)
    # an element, named where its list declares it or read through it, or a
    # list's count
    lp: listMemberPrefix :snap :hit
    if lp.length > 0 then return lp
    o: snap.st
    match (
        o
    ) case some then {
        return (ztypecheck.unitPathOfDecl st: o declId: hit.declId)
    } case none then {
        return "".string
    }
}

# hoverTypeFence -- the code-fence text for a hit that has no signature: the
# type's kind when the registry knows one, otherwise `owner.name: type` with the
# reference's ownership annotation. "" when nothing can be said, which is the
# caller's signal to answer null.
hoverTypeFence: function {
    snap: zcheck.CheckResult
    hit: navhit
    hname: String
    # the node's own stamped type, which the kind fallback does not use
    t: ztypes.tid
    # the unit the hover is shown in
    site: ztypes.declid
} out String is {
    # a CONSTANT's hit carries its value's type: the card names the constant,
    # its type and its value, not the type
    isConst: hitIsConst :snap :hit name: hname.stringView
    tk: String
    if isConst.not when (listMemberHit :snap :hit).not then tk = (typeKindTextOpt
        o: snap.st
        tid: hit.tid
        :site
    )
    if tk.length > 0 then {
        kindFence: displayTypeNameOfOpt o: snap.st tid: hit.tid :site
        kindFence.append ": "
        kindFence.append tk
        return kindFence
    }
    if isConst then {
        cc: constCard :snap :hit :hname :site
        if cc.length > 0 then return cc
    }
    if t.isZero then return "".string
    tn: displayTypeNameOfOpt o: snap.st tid: t :site
    if tn.length == 0 then return "".string
    fence: String
    own: String
    if hit.owner.isZero.not then own = displayTypeNameOfOpt o: snap.st tid: hit.owner :site
    lp: listMemberPrefix :snap :hit
    if lp.length > 0 then own = lp.take
    if own.length > 0 then {
        fence.append own
        fence.appendByte b: 46
    }
    fence.append hname
    fence.append ": "
    fence.append tn
    # a list's element or length is a constant, which nothing owns
    if (listMemberHit :snap :hit) then return fence
    # a native's parameter binds no variable, and the Decl its node resolves
    # to is its type's -- `:i`, of the generic `i`, read as that constant
    if hit.vid.isZero when (declKindIsParam :snap declId: hit.declId) then return fence
    annot: refAnnotation prog: snap.prog o: snap.st vid: hit.vid nid: hit.nodeid
    if annot.length > 0 then {
        fence.append "  # "
        fence.append annot
    }
    return fence
}


# hoverDoc -- the `#` doc block above a definition node, "" when the node has
# no position, sits on the first line, or carries none.
hoverDoc: function {snap: zcheck.CheckResult nid: zast.nodeid} out String is {
    fs: zcheck.fsnoFor r: snap nodeid: nid
    ln: (nodePosOf prog: snap.prog :nid).line
    none: String
    if fs.isZero then return none
    if ln < 2 then return none
    return (docCommentForNode :snap fsno: fs defLine: ln)
}

# hoverSigTid -- the type whose signature a hover shows: the stamped def
# tid when the hit is a callable or unit member (a function hovers as its
# signature, not its return value), the instance when a generic call
# resolved to one, and the Decl's type when only the Decl layer resolved the hit.
# A declaration that binds a variable shows the variable's: a `for` binding's
# node is the collection.
hoverSigTid: function {snap: zcheck.CheckResult hit: navhit} out ztypes.tid is {
    if hit.kind == 6 when hit.vid.isZero.not then return (variableTypeOpt o: snap.st vid: hit.vid)
    t: nodeTypeAt o: snap.st nid: hit.nodeid
    ud: useUnitDef o: snap.st nid: hit.nodeid
    sigTid: t
    if ud.isZero.not then sigTid = ud
    if (isInstanceOfOpt o: snap.st tid: t tpl: ud) then sigTid = t
    if sigTid.isZero then sigTid = hit.tid
    return sigTid
}

# navHoverAnswer -- the hover card for a resolved hit: a code fence holding the
# signature or the type, and the doc block above the definition it names.
navHoverAnswer: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    hit: navhit
    hname: String
    # the hovered document's unit (docUnitDecl)
    site: ztypes.declid
} out Value is {
    if hit.unitFsno.isZero.not then {
        ub: hname.copy
        ub.append ": unit"
        ugs: unitGenericSuffix prog: snap.prog name: hname.stringView
        ub.append ugs
        udoc: unitDocComment :snap fsno: hit.unitFsno
        return (hoverMarkdown code: ub.stringView doc: udoc.stringView)
    }
    t: hoverValueTid :snap :hit
    sigTid: hoverSigTid :snap :hit
    body: (fnSigTextOpt
        vfs: snap.vfs
        prog: snap.prog
        o: snap.st
        tid: sigTid
        name: hname.stringView
        :site
    )
    if body.length == 0 then {
        gc: genericParamHoverCard :snap :hit hname: hname.stringView :site
        if gc.nul.not then return gc
        tf: hoverTypeFence :snap :hit :hname :t :site
        if tf.length == 0 then return Value.nul
        body.append tf
    }
    docBody: String
    # append the `#` doc block above the definition, if any (cross-file
    # ok). The referenced surface Decl wins (a bare `i64` reads core's
    # re-export line); the canonical def node is the doc fallback.
    legacyDnd: (defNodeOf
        o: snap.st
        prog: snap.prog
        refVid: hit.vid
        refTid: hit.tid
        refOwner: hit.owner
        member: hname.stringView
    )
    dnd: declNodeOf o: snap.st declId: hit.declId
    if dnd.isZero then dnd = legacyDnd
    if dnd.isZero.not then {
        docBody = hoverDoc :snap nid: dnd
        if hit.owner.isZero.not then appendTrailingDoc :snap nid: dnd :body
    }
    # a constant with no doc of its own takes none: the fallback is its
    # value's TYPE, whose doc describes something else
    if docBody.length == 0 when legacyDnd.isZero.not when (legacyDnd == dnd).not when (hitIsConst
        :snap
        :hit
        name: hname.stringView
    ).not then {
        docBody = hoverDoc :snap nid: legacyDnd
    }
    hoverCallNotes :snap :sp :hit :body :docBody :site
    # a list's ordinal (`primes.0`) is spelled like a literal, and is none
    if (listMemberHit :snap :hit) then return (hoverMarkdown
        code: body.stringView
        doc: docBody.stringView
    )
    ln9: (literalNote
        o: snap.st
        name: hname.stringView
        refTid: hit.tid
        nodeTid: (nodeTypeAt o: snap.st nid: hit.nodeid)
        :site
    )
    appendNote :docBody note: ln9.stringView
    return (hoverMarkdown code: body.stringView doc: docBody.stringView)
}

# hoverValueTid -- the type a hover card gives its hit's name: its node's stamp.
# A completion item has no node, so its type is its declaration's. A
# declaration that binds a variable is of the variable's type: a `for`
# binding's node is the collection. A parameter
# or a member is of its declared type where its node has no stamp, and where it
# is declared with a literal type, which the fold rewrote the stamp from.
hoverValueTid: function {snap: zcheck.CheckResult hit: navhit} out ztypes.tid is {
    if hit.nodeid.isZero then return hit.tid
    if hit.kind == 6 when hit.vid.isZero.not then return (variableTypeOpt o: snap.st vid: hit.vid)
    nt: nodeTypeAt o: snap.st nid: hit.nodeid
    # a declaration, and a name with no stamp of its own -- a `case`'s arm --
    # are what is declared
    if (hit.kind == 6) or nt.isZero when hit.tid.isZero then {
        dt: declTypeIdOf o: snap.st declId: hit.declId
        if nt.isZero or (isLiteralTid o: snap.st tid: dt) then return dt
    }
    return nt
}

# variableTypeOpt -- variable `vid`'s type, over the LSP's optional snapshot.
variableTypeOpt: function {o: (Option zenv.ZSymbolTable).view vid: ztypes.vid} out ztypes.tid is {
    match (
        o
    ) case some then {
        return (o.reg.variableTypeOf id: vid)
    } case none then {
        return ztypes.tid.zero
    }
}

# appendNote -- add a paragraph to a hover's doc text: a blank line between
# it and what is there, nothing at all when the note is empty.
appendNote: function {docBody: String.borrow note: StringView} is {
    if note.length == 0 then return
    if docBody.length > 0 then {
        docBody.appendByte b: 10
        docBody.appendByte b: 10
    }
    docBody.append note
}

# appendTrailingDoc -- a member's trailing `#` comment on its definition line
# joins the signature fence, when the definition has a line and a comment.
appendTrailingDoc: function {
    snap: zcheck.CheckResult
    nid: zast.nodeid
    body: String.borrow
} is {
    dfs: zcheck.fsnoFor r: snap nodeid: nid
    dln: (nodePosOf prog: snap.prog :nid).line
    if dfs.isZero then return
    if dln < 2 then return
    tc: trailingDocOf vfs: snap.vfs fsno: dfs line1: dln
    if tc.length == 0 then return
    body.append "  # "
    body.append tc
}

# hoverCallNotes -- the call-site enrichment: hovering a callee appends the
# inferred generic bindings to the fence; hovering an argument appends its
# disposition to the doc text. Nothing when the hover is not inside a call.
hoverCallNotes: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    hit: navhit
    body: String.borrow
    docBody: String.borrow
    # the unit the call's notes are shown in
    site: ztypes.declid
} is {
    hpos: nodePosOf prog: snap.prog nid: hit.argNode
    # the call around a node is in the node's own file
    callId: (sp.innerRangeOfKind
        curPos: hpos
        kind: 4
        slack: 0
        prog: snap.prog
        wantFsno: (snap.prog.fsnoForNode nodeid: hit.argNode)
    )
    if callId.isZero then return
    callPos: nodePosOf prog: snap.prog nid: callId
    if callPos == hpos then {
        gl: inferredGenericLines o: snap.st prog: snap.prog :callId :site
        if gl.length > 0 then {
            body.appendByte b: 10
            body.append gl
        }
        return
    }
    dn9x: dispositionNote o: snap.st nid: hit.argNode
    appendNote :docBody note: dn9x.stringView
}

# navDefinitionAnswer -- the Location a resolved hit points at: the file top for
# a unit, otherwise the node that declares it. A parameter is declared at its
# name; its variable's node is the type it is declared with. A `for` binding's
# variable is at its arm; its node is the collection.
navDefinitionAnswer: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    hit: navhit
    hname: String
    # the hit row's name
    name: zast.nameid
    docRel: StringView
    docUri: StringView
    srcDir: StringView
    systemDir: StringView
    docText: StringView
    utf32: bool
} out Value is {
    if hit.unitFsno.isZero.not then {
        return (locationAtFileTop :snap fsno: hit.unitFsno :docRel :docUri :srcDir :systemDir)
    }
    dd: hit.declId
    if dd.isZero when hit.vid.isZero.not then dd = paramDeclOfVar :snap vid: hit.vid :name
    dn: declNodeOf o: snap.st declId: dd
    if dn.isZero then {
        dn = (defNodeOf
            o: snap.st
            prog: snap.prog
            refVid: hit.vid
            refTid: hit.tid
            refOwner: hit.owner
            member: hname.stringView
        )
    }
    if dn.isZero then return Value.nul
    return (locationValue
        :snap
        nid: (sp.bindingArmOf nid: dn)
        width: hit.width
        :docRel
        :docUri
        :srcDir
        :systemDir
        :docText
        :utf32
    )
}

# reftarget -- what the references to a hit are, each zero when the hit is not
# one: the variable, the declaration, and the owner whose members are matched by
# name
reftarget: record {
    vid: ztypes.vid
    # at the origin of its same-name re-exports
    declId: ztypes.declid
    owner: ztypes.tid
    # the hit's name. A row spelled otherwise names none of the hit's
    # declarations: `this` and the `view` of `Box.view` resolve to Box as well
    name: zast.nameid
}

# referencesTargetOf -- what the references to a hit are. A declaration row
# answers what it declares -- a parameter's variable, a field's owner, a
# definition's Decl -- and never the type it is declared with, which is what
# the row's node carries. A label that binds (the `:this` of a signature) is its
# variable; a parameter's TYPE shares the parameter's node and binds nothing.
referencesTargetOf: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    hit: navhit
    name: zast.nameid
} out reftarget is {
    vid: hit.vid
    owner: hit.owner
    dd: hit.declId
    if hit.kind == 1 when vid.isZero when (snap.prog.nodes.get i: hit.nodeid).labelvalue then {
        vid = defVarIdOf o: snap.st nid: hit.nodeid
    }
    if hit.kind == 6 then {
        dr: declRowTarget :snap :sp :hit :name
        vid = dr.vid
        dd = dr.declId
        owner = ztypes.tid.zero
    }
    # a `:x` that reads no variable labels its callee's parameter, or the field
    # it builds; a written label resolved through what it names already
    if vid.isZero when hit.kind == 1 then {
        lab: labelDeclOf :snap :sp row: (sp.rows.get i: hit.idx)
        if lab.isZero.not then {
            dd = lab
            vid = paramVarOf :snap declId: lab
        }
    }
    if vid.isZero.not then {
        # a parameter is labelled at its call sites too
        if (declKindIsParam :snap declId: dd).not then dd = paramDeclOfVar :snap :vid :name
        return (reftarget :vid declId: dd owner: ztypes.tid :name)
    }
    od: spelledOrigin :snap declId: dd :name
    # a list's count or `slot`, spelled by its own name, is the list's
    if od.isZero when dd.isZero.not when (listOfDeclOpt o: snap.st declId: dd) == dd then od = dd
    if owner.isZero then owner = declOwnerOf o: snap.st declId: od
    return (reftarget :vid declId: od :owner :name)
}

# declRowTarget -- what declaration row `hit` declares: the variable it binds
# (a parameter, a local, a `for` binding), else its Decl.
declRowTarget: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    hit: navhit
    name: zast.nameid
} out reftarget is {
    vid: defVarIdOf o: snap.st nid: hit.nodeid
    if vid.isZero then vid = loopVarOf :snap :sp row: (sp.rows.get i: hit.idx)
    hnm: zast.nameTextAt ast: snap.prog ref: name
    dd: declOfDefOp o: snap.st prog: snap.prog opId: hit.nodeid name: hnm.stringView
    if dd.isZero then dd = genericParamDeclOf o: snap.st nid: hit.nodeid
    return (reftarget :vid declId: dd owner: ztypes.tid :name)
}

# spelledOrigin -- declaration `declId` at the origin of its same-name
# re-exports, or 0 when it is not spelled `name`.
spelledOrigin: function {
    snap: zcheck.CheckResult declId: ztypes.declid name: zast.nameid
} out ztypes.declid is {
    if declId.isZero then return declId
    o: snap.st
    match (
        o
    ) case some then {
        if (o.typing.decls.get i: declId).name != name then return ztypes.declid.zero
        return (sameNameOrigin prog: snap.prog :o :declId)
    } case none then null
    return ztypes.declid.zero
}

# sameNameOrigin -- the declaration a chain of same-name re-exports starts from:
# core's `File: io.File` is io's File. A re-export under another name (`os:
# oskind.linux`) is a declaration of its own, as go-to-definition has it.
sameNameOrigin: function {
    prog: Ast.view o: zenv.ZSymbolTable.view declId: ztypes.declid
} out ztypes.declid is {
    cur: declId
    hops: u32
    for hops < 8 loop {
        d: o.typing.decls.get i: cur
        if d.kind.reexportDecl.not then return cur
        nx: reexportOriginStep :prog :o declId: cur
        if nx.isZero then return cur
        if (o.typing.decls.get i: nx).name != d.name then return cur
        cur = nx
        hops = hops + 1
    }
    return cur
}

# reexportOriginStep -- the declaration re-export `declId` names: a unit's
# definition, or a type's member (`true: bool.true`), the type read as the
# re-export's own unit reads it; 0 when it names neither.
reexportOriginStep: function {
    prog: Ast.view o: zenv.ZSymbolTable.view declId: ztypes.declid
} out ztypes.declid is {
    ud: reexportTargetDecl :prog :o :declId
    if ud.isZero.not then return ud
    tg: ztypecheck.reexportTargetIdsOf st: o ast: prog :declId
    if tg.unitName.isZero then return ud
    site: o.typing.declParentOf :declId
    ty: ztypecheck.declOfUnitDefIds st: o unitDecl: site nameId: tg.unitName
    if ty.isZero then ty = (ztypecheck.declOfUnitDefIds
        st: o
        unitDecl: o.typing.coreUnitRoot
        nameId: tg.unitName
    )
    if ty.isZero then return ty
    ty = sameNameOrigin :prog :o declId: ty
    if (o.typing.decls.get i: ty).kind.typeDecl.not then return ztypes.declid.zero
    return (o.typing.declFindChild parentDeclId: ty nameId: tg.defName)
}

# labelDeclOf -- the declaration label row `row` names: a parameter of the callee
# it is an argument of, or a field of the type it builds; 0 when the row labels
# no argument, or the callee declares nothing of its name. The label is the
# argument's declaration row, or a `:x`, whose value is its label; the value's
# own rows share the argument's node and are no label. An operator's operand is
# labelled by no written name.
labelDeclOf: function {snap: zcheck.CheckResult sp: Spans.view row: spanrow} out ztypes.declid is {
    if row.kind == 1 then {
        if (snap.prog.nodes.get i: row.nodeid).labelvalue.not then return ztypes.declid.zero
    } else if row.kind != 6 then return ztypes.declid.zero
    callId: zast.nodeid
    cg: sp.argCall.get key: row.nodeid
    match (
        cg
    ) case some then {
        callId = cg
    } case none then {
        return ztypes.declid.zero
    }
    calNid: zast.nodeid
    {
        cn: snap.prog.nodes.get i: callId
        if cn.call when cn.infix.not then calNid = cn.callable
    }
    if calNid.isZero then return ztypes.declid.zero
    cd: calleeDeclOf :snap :calNid
    if cd.isZero then return ztypes.declid.zero
    o: snap.st
    match (
        o
    ) case some then {
        org: sameNameOrigin prog: snap.prog :o declId: cd
        ch: o.typing.declFindChild parentDeclId: org nameId: row.name
        if ch.isZero then return ch
        k: (o.typing.decls.get i: ch).kind
        if k.paramDecl or k.fieldDecl then return ch
    } case none then null
    return ztypes.declid.zero
}

# calleeDeclOf -- the declaration callable node `calNid` names: a function's, a
# method's, or a type's when the name in callable position builds one.
calleeDeclOf: function {snap: zcheck.CheckResult calNid: zast.nodeid} out ztypes.declid is {
    cd: refDeclOf o: snap.st nid: calNid
    if cd.isZero.not then return cd
    caln: snap.prog.nodes.get i: calNid
    if caln.atomid.not then return cd
    cnm: zast.nameTextAt ast: snap.prog ref: caln.name
    ct: calleeTypeOf o: snap.st nid: calNid name: cnm.stringView
    if ct.isZero then return cd
    return (surfaceDeclOfType o: snap.st prog: snap.prog tid: ct)
}

# paramVarOf -- the variable parameter declaration `declId` binds in its
# function's body; 0 for any other declaration.
paramVarOf: function {snap: zcheck.CheckResult declId: ztypes.declid} out ztypes.vid is {
    if (declKindIsParam :snap :declId).not then return ztypes.vid.zero
    opNid: zast.nodeid
    o: snap.st
    match (
        o
    ) case some then {
        arm: snap.prog.nodes.get i: (o.typing.decls.get i: declId).node
        if arm.namedoperation then opNid = arm.operation
    } case none then null
    if opNid.isZero then return ztypes.vid.zero
    return (defVarIdOf :o nid: opNid)
}

# paramDeclOfVar -- the parameter declaration that binds variable `vid`, named
# `name`; 0 when the variable is no parameter's. Two scans, once per request.
paramDeclOfVar: function {
    snap: zcheck.CheckResult vid: ztypes.vid name: zast.nameid
} out ztypes.declid is {
    op: varDefNode o: snap.st :vid
    if op.isZero then return ztypes.declid.zero
    nm: zast.nameTextAt ast: snap.prog ref: name
    dd: declOfDefOp o: snap.st prog: snap.prog opId: op name: nm.stringView
    if (declKindIsParam :snap declId: dd) then return dd
    return ztypes.declid.zero
}

# declKindIsParam -- declaration `declId` is a function's parameter.
declKindIsParam: function {snap: zcheck.CheckResult.view declId: ztypes.declid} out bool is {
    if declId.isZero then return false
    o: snap.st
    match (
        o
    ) case some then {
        return (o.typing.decls.get i: declId).kind.paramDecl
    } case none then {
        return false
    }
}

# rowNamesDecl -- span row `row`, spelled as declaration `declId` is, names it:
# through its refDecl, at the origin of the same-name re-exports that goes
# through, or as a type in callable position.
rowNamesDecl: function {snap: zcheck.CheckResult row: spanrow declId: ztypes.declid} out bool is {
    o: snap.st
    rd: refDeclOf :o nid: row.nodeid
    if rd.isZero when row.kind == 1 when (useVarId :o nid: row.nodeid).isZero then {
        nm: zast.nameTextAt ast: snap.prog ref: row.name
        ct: calleeTypeOf :o nid: row.nodeid name: nm.stringView
        if ct.isZero.not then rd = surfaceDeclOfType :o prog: snap.prog tid: ct
    }
    if rd.isZero then return false
    if rd == declId then return true
    match (
        o
    ) case some then {
        return (sameNameOrigin prog: snap.prog :o declId: rd) == declId
    } case none then {
        return false
    }
}

# RefFile -- a file a references answer lands in: its uri, and, when columns
# are counted in utf-16, its text and where each of its lines starts.
RefFile: class {
    fsno: zvfs.fsno
    uri: String
    # the document's buffer for the document, the loaded file otherwise; empty
    # under utf-32
    text: String
    # the byte offset each line starts at, line 1 first
    starts: ListVal u64
} as {
    # the file `fs` as references read it: its text and line starts only when
    # utf-16 columns need them
    create: function {
        snap: zcheck.CheckResult
        fs: zvfs.fsno
        docRel: StringView
        docUri: StringView
        srcDir: StringView
        systemDir: StringView
        docText: StringView
        utf32: bool
    } out this is {
        own: fileIsDoc :snap :fs :docRel
        f: (meta.create
            fsno: fs
            uri: (fileUri :snap :fs :own :docUri :srcDir :systemDir)
            text: String
            starts: ListVal u64
        )
        if utf32 then return f
        if own then {
            f.text = docText.string
        } else {
            r: snap.vfs.open dentryid: fs
            match (
                r
            ) case file then {
                f.text = r.stringView.string
            } case dir then null case err then null
        }
        f.starts.append 0
        tv: f.text.stringView
        n: tv.length
        i: u64
        for i < n loop {
            b: tv.byteAt :i
            match (
                b
            ) case some then {
                if b == 10 then f.starts.append i + 1
            } case none then null
            i = i + 1
        }
        return f
    }

    # a Location over span row `row`, which sits in this file
    locationOf: function {t: this.view row: spanrow utf32: bool} out Value is {
        if utf32 then return (locationObj
            uri: t.uri.stringView
            line0: row.line - 1
            c0: row.colLo - 1
            c1: row.colHi - 1
        )
        ln: (row.line - 1).u64
        lo: t.text.length
        hi: t.text.length
        if ln < t.starts.length then lo = t.starts.get i: ln
        if (ln + 1) < t.starts.length then hi = (t.starts.get i: ln + 1) - 1
        lt: t.text.substring from: lo to: hi
        return (locationObj
            uri: t.uri.stringView
            line0: row.line - 1
            c0: (encodedCol lineText: lt cpCol1: row.colLo :utf32)
            c1: (encodedCol lineText: lt cpCol1: row.colHi :utf32)
        )
    }
}

# rowRefersTo -- what span row `row` is to `tg`: 0 nothing, 1 a reference, 2 a
# declaration. A variable's uses and bindings by its id; otherwise a row spelled
# as the target is -- a declaration by the node it is rowed on (`ops`), a member
# by its owner when the target has one, a use by the declaration it resolves
# to, a labelled argument by the parameter or field it names.
rowRefersTo: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    tg: reftarget
    row: spanrow
    # declOpsOf the target
    ops: (ListVal zast.nodeid).view
} out u8 is {
    if tg.vid.isZero.not then {
        rv: rowReadsVar :snap :sp :row vid: tg.vid name: tg.name
        if rv > 0 then return rv
    }
    if row.name != tg.name then return 0
    if row.kind == 6 when (ops.contains item: row.nodeid) then return 2
    if tg.vid.isZero when (rowUsesDecl :snap :sp :tg :row) then return 1
    if tg.declId.isZero or (sp.argCall.has key: row.nodeid).not then return 0
    if (labelDeclOf :snap :sp :row) == tg.declId then return 1
    return 0
}

# rowUsesDecl -- use or member row `row`, spelled as `tg`, names its
# declaration: a member by its owner when the target has one, the arm a `case`
# writes by the declaration it names, any other by the declaration it resolves
# to.
rowUsesDecl: function {
    snap: zcheck.CheckResult sp: Spans.view tg: reftarget row: spanrow
} out bool is {
    if row.kind == 2 when tg.owner.isZero.not then {
        return (memberOwnerOf o: snap.st nid: row.nodeid) == tg.owner
    }
    use: (row.kind == 1) or (row.kind == 2)
    if use.not or tg.declId.isZero then return false
    # a list's element is named as its list declares it
    if row.kind == 2 when (memberOwnerOf o: snap.st nid: row.nodeid).isZero then {
        lm: listMemberDecl :snap dpid: row.nodeid
        if lm.isZero.not then return lm == tg.declId
    }
    ca: caseArmDecl :snap :sp nid: row.nodeid
    if ca.isZero when row.kind == 1 then ca = (genericUseDecl
        :snap
        :sp
        nid: row.nodeid
        name: row.name
    )
    if ca.isZero then return (rowNamesDecl :snap :row declId: tg.declId)
    o: snap.st
    match (
        o
    ) case some then {
        return (sameNameOrigin prog: snap.prog :o declId: ca) == tg.declId
    } case none then {
        return false
    }
}

# declOpsOf -- the nodes `tg`'s declarations are rowed on: the operation of its
# Decl's arm, and of each same-name re-export of it (core's `true: bool.true`).
# One scan of the Decls, names compared first. None for a variable, whose
# bindings rowReadsVar finds.
declOpsOf: function {snap: zcheck.CheckResult tg: reftarget} out ListVal zast.nodeid is {
    ops: ListVal zast.nodeid
    if tg.declId.isZero or tg.vid.isZero.not then return ops
    o: snap.st
    match (
        o
    ) case some then {
        k: u64
        for each d: o.typing.decls loop {
            if d.name == tg.name when d.node.isZero.not when (declIsOrReexports
                prog: snap.prog
                :o
                declId: ztypes.declid k
                target: tg.declId
            ) then {
                arm: snap.prog.nodes.get i: d.node
                if arm.namedoperation then ops.append arm.operation
            }
            k = k + 1
        }
    } case none then null
    return ops
}

# declIsOrReexports -- declaration `declId` is `target`, or a same-name
# re-export of it.
declIsOrReexports: function {
    prog: Ast.view o: zenv.ZSymbolTable.view declId: ztypes.declid target: ztypes.declid
} out bool is {
    if declId == target then return true
    if (o.typing.decls.get i: declId).kind.reexportDecl.not then return false
    return (sameNameOrigin :prog :o :declId) == target
}

# rowReadsVar -- what span row `row` is to variable `vid`, named `name`: 0
# nothing, 1 a use, 2 a binding -- a local's, a parameter's declaration, a `for`
# binding, a `:this`, whichever kind of row it is. A parameter's type shares its
# declaration's node and is spelled otherwise.
rowReadsVar: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    row: spanrow
    vid: ztypes.vid
    name: zast.nameid
} out u8 is {
    if row.kind != 2 when row.name == name then {
        if (defVarIdOf o: snap.st nid: row.nodeid) == vid then return 2
        if (loopVarOf :snap :sp :row) == vid then return 2
    }
    if row.kind == 1 when (useVarId o: snap.st nid: row.nodeid) == vid then return 1
    return 0
}

# navReferencesAnswer -- every span row that names the hit's target, as an
# array of Locations. One pass over the rows: a variable's uses and bindings by
# its id, a member row by its owner when the target has one, and any other row
# spelled as the target is by the declaration it resolves to. A Location is the
# row's own span: a member row's node is the dotted path, which starts at the
# receiver.
navReferencesAnswer: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    hit: navhit
    docRel: StringView
    docUri: StringView
    srcDir: StringView
    systemDir: StringView
    docText: StringView
    utf32: bool
    # the target's declarations are listed too
    inclDecl: bool
} out Value is {
    tg: referencesTargetOf :snap :sp :hit name: (sp.rows.get i: hit.idx).name
    ops: declOpsOf :snap :tg
    arr: newArr
    # the last row taken: a `:this` parameter's declaration row and its use row
    # are one node and one span, which is one reference
    lastNid: zast.nodeid
    lastCol: u32
    # the files the answer has landed in, and which one the last row was in
    files: List RefFile
    fi: u64
    rj: u64
    for rj < sp.rows.length loop {
        row2: sp.rows.get i: rj
        n2: row2.nodeid
        rk: rowRefersTo :snap :sp :tg row: row2 :ops
        add: (rk == 1) or ((rk == 2) and inclDecl)
        if add when n2 == lastNid when row2.colLo == lastCol then add = false
        fs: zvfs.fsno
        if add then fs = zcheck.fsnoFor r: snap nodeid: n2
        if fs.isZero.not then {
            lastNid = n2
            lastCol = row2.colLo
            stale: fi >= files.length
            if stale.not then stale = (files.get i: fi).fsno != fs
            if stale then {
                fi = 0
                for fi < files.length loop {
                    if (files.get i: fi).fsno == fs then break
                    fi = fi + 1
                }
                if fi == files.length then files.append (RefFile.create
                    :snap
                    :fs
                    :docRel
                    :docUri
                    :srcDir
                    :systemDir
                    :docText
                    :utf32
                )
            }
            arr.items.append ((files.get i: fi).locationOf row: row2 :utf32)
        }
        rj = rj + 1
    }
    return (Value.array arr)
}

# textAtKey -- the text map `m` holds at `key`, "" when it holds none
textAtKey: function {m: (Map String V: String).view key: StringView} out String is {
    g: m.get key: key.string
    match (
        g
    ) case some then {
        return g.copy
    } case none then {
        return String
    }
}

# mergeLocations -- the references answers `a` and `b` as one: `a`'s, then
# `b`'s in the files `a` lists none in. Two programs that load a file read the
# same source and find the same rows in it, so a file is answered once; null
# when neither is an array.
mergeLocations: function {a: Value.view b: Value.view} out Value is {
    if a.array.not when b.array.not then return Value.nul
    arr: newArr
    had: Set String
    appendLocations :arr :had from: a skipHad: false
    appendLocations :arr :had from: b skipHad: true
    return (Value.array arr)
}

# appendLocations -- append to `arr` each Location of answer `from`, rebuilt
# from its uri and range, and note its uri in `had`; with `skipHad`, only those
# in a file `had` held before
appendLocations: function {arr: Arr had: Set String from: Value.view skipHad: bool} is {
    match (
        from
    ) case array then {
        before: Set String
        if skipHad then for each h: had loop before.add item: h.copy
        for each l: from.items loop {
            us: String
            u: json.textAt v: l path: "uri"
            match (
                u
            ) case some then {
                us = u.copy
            } case none then null
            if (before.has item: us).not then {
                had.add item: us.copy
                arr.items.append (locationObj
                    uri: us.stringView
                    line0: ((json.intAt v: l path: "range/start/line").or d: 0).u32.orPanic
                    c0: ((json.intAt v: l path: "range/start/character").or d: 0).u32.orPanic
                    c1: ((json.intAt v: l path: "range/end/character").or d: 0).u32.orPanic
                )
            }
        }
    } else null
}

# navAnswer -- definition (1), hover (2), references (3) from the
# last-good snapshot.
navAnswer: function {
    snap: zcheck.CheckResult
    docRel: StringView
    docUri: StringView
    srcDir: StringView
    systemDir: StringView
    docText: StringView
    line0: i64
    ch: i64
    utf32: bool
    mode: u8
    # references: list the target's declarations too
    inclDecl: bool
} out Value is {
    l1: line0 + 1
    l1u: l1.u32.orPanic
    lt: docLine text: docText lineno: l1u
    cp1: cpColOf lineText: lt.stringView :ch :utf32
    # references search every file; the rest read the document's own
    sp: Spans.create
    if mode == 3 then {
        sp = programSpans prog: snap.prog
    } else {
        sp = fileSpans prog: snap.prog fsno: (docFsnoOf r: snap rel: docRel)
    }
    hitOpt: navResolve :snap :sp :docRel :l1u :cp1
    if hitOpt.none then return Value.nul
    hit: hitOpt
    hname: (sp.names.get i: hit.idx).copy
    if mode == 2 then return (navHoverAnswer
        :snap
        :sp
        :hit
        :hname
        site: (docUnitDecl r: snap rel: docRel)
    )
    if mode == 1 then {
        return (navDefinitionAnswer
            :snap
            :sp
            :hit
            :hname
            name: (sp.rows.get i: hit.idx).name
            :docRel
            :docUri
            :srcDir
            :systemDir
            :docText
            :utf32
        )
    }
    return (navReferencesAnswer
        :snap
        :sp
        :hit
        :docRel
        :docUri
        :srcDir
        :systemDir
        :docText
        :utf32
        :inclDecl
    )
}

# symbolsAnswer -- flat DocumentSymbol list for the document's unit, the unitdef
# node `unitOp` (0: none, an empty list).
symbolsAnswer: function {
    snap: zcheck.CheckResult.view
    unitOp: zast.nodeid
    docText: StringView
    utf32: bool
} out Value is {
    arr: newArr
    if unitOp.isZero.not then (collectBodySymbols
        ast: snap.prog
        ud: (snap.prog.nodes.get i: unitOp)
        :docText
        :utf32
        :arr
    )
    return (Value.array arr)
}

# collect document-symbol entries from a unit body.
collectBodySymbols: function {
    ast: Ast.view
    ud: zast.astnode.view
    docText: StringView
    utf32: bool
    arr: Arr
} is {
    if ud.unitdef then {
        box2049: u64
        for box2049 < ud.body.count loop {
            b9Id: zast.kidAt kids: ast.kids span: ud.body i: box2049
            box2049 = box2049 + 1
            symbolOf :ast m: (ast.nodes.get i: b9Id) :docText :utf32 :arr
        }
    }
}

# the document-symbol entry for one definition.
symbolOf: function {
    ast: Ast.view
    m: zast.astnode.view
    docText: StringView
    utf32: bool
    arr: Arr
} is {
    if m.namedoperation then {
        lb: zast.nameTextAt :ast ref: m.name
        if lb.length == 0 then return
        k: symbolKindOf op: (ast.nodes.get i: m.operation)
        lt: docLine text: docText lineno: m.lineno
        c0: encodedCol lineText: lt.stringView cpCol1: m.colno :utf32
        wname: lb.stringView.count
        c1: encodedCol lineText: lt.stringView cpCol1: m.colno + wname.u32.orPanic :utf32
        if c1 <= c0 then c1 = c0 + 1
        line0: i64
        if m.lineno > 0 then line0 = m.lineno - 1
        st: newObj
        st.set key: "line".string value: Value.intval line0
        st.set key: "character".string value: Value.intval c0.i64
        en: newObj
        en.set key: "line".string value: Value.intval line0
        en.set key: "character".string value: Value.intval c1.i64
        rg: newObj
        rg.set key: "start".string value: Value.object st
        rg.set key: "end".string value: Value.object en
        rv: Value.object rg
        sy: newObj
        sy.set key: "name".string value: Value.text lb.copy
        sy.set key: "kind".string value: Value.intval k
        sy.set key: "range".string value: rv
        rgv2: rangeCopy :docText :utf32 :line0 :c0 :c1
        sy.set key: "selectionRange".string value: rgv2
        arr.items.append (Value.object sy)
    }
}

# rangeCopy -- a fresh range object (ranges cannot be shared: Values
# move into their parent on set).
rangeCopy: function {docText: StringView utf32: bool line0: i64 c0: i64 c1: i64} out Value is {
    docText.drop
    utf32.drop
    st: newObj
    st.set key: "line".string value: Value.intval line0
    st.set key: "character".string value: Value.intval c0
    en: newObj
    en.set key: "line".string value: Value.intval line0
    en.set key: "character".string value: Value.intval c1
    rg: newObj
    rg.set key: "start".string value: Value.object st
    rg.set key: "end".string value: Value.object en
    return (Value.object rg)
}

# the LSP SymbolKind code for definition `op`.
symbolKindOf: function {op: zast.astnode.view} out i64 is {
    match (
        op
    ) case functiondef then {
        return 12
    } case objectdef then {
        return 5
    } else {
        return 13
    }
}

# ---- lint + formatting ------------------------------------------------

# lintInto -- fast-tier zl findings for one live buffer as Warning /
# Information diagnostics (hard errors stay with the compile pass,
# which owns them).
lintInto: function {arr: Arr text: String.take relpath: StringView utf32: bool} is {
    lo: zsource.defaultOpts
    lo.lineLength = 100
    lo.complexity = zsource.complexityThreshold
    la: zsource.analyzeSource source: text path: relpath.string opts: lo
    appendLintDiags :arr :la :utf32
}

# tcLintInto -- lintInto plus the typecheck-tier rules (L005 suffix, L012
# unused private def / member, L013 / L014 unused local / param) for the
# document the check was run for: its unit, a subunit included, found by
# its file. Reuses the compile pass's
# program and symbol table -- no second typecheck.
tcLintInto: function {
    arr: Arr
    text: String.take
    relpath: StringView
    utf32: bool
    prog: Ast.view
    # the file the check parsed the document from; its unit is linted
    self: zvfs.fsno
    sto: Option zenv.ZSymbolTable
} is {
    lo: zsource.defaultOpts
    lo.lineLength = 100
    lo.complexity = zsource.complexityThreshold
    la: zsource.analyzeSource source: text path: relpath.string opts: lo
    match (
        sto
    ) case some then {
        lu: zsource.lintedUnitOf :prog :self
        if lu.op.isZero.not then {
            la.lintSuffixUnit :prog :lu st: sto
            la.reportUnusedDefs :prog :lu st: sto
            la.reportUnusedVars :prog :lu st: sto
            la.reportViewableLocals :prog :lu st: sto
        }
    } case none then null
    appendLintDiags :arr :la :utf32
}

# appendLintDiags -- an Analysis's collected warnings / infos as LSP
# diagnostic rows (hard errors stay with the compile pass, which owns them).
appendLintDiags: function {arr: Arr la: zsource.Analysis.view utf32: bool} is {
    for each d: la.diags loop {
        sevN: i64
        k: d.sev
        match (
            k
        ) case warning then {
            sevN = 2
        } case info then {
            sevN = 3
        } else null
        if sevN > 0 then {
            lt: docLine text: la.source.stringView lineno: d.lineno
            line0: i64
            if d.lineno > 0 then line0 = d.lineno - 1
            c0: encodedCol lineText: lt.stringView cpCol1: d.colno :utf32
            w: d.width
            if w == 0 then w = 1
            c1: encodedCol lineText: lt.stringView cpCol1: d.colno + w :utf32
            if c1 <= c0 then c1 = c0 + 1
            m: d.msg.copy
            if d.hint.length > 0 then {
                m.appendByte b: 10
                m.append "hint: "
                m.append d.hint
            }
            st: newObj
            st.set key: "line".string value: Value.intval line0
            st.set key: "character".string value: Value.intval c0.i64
            en: newObj
            en.set key: "line".string value: Value.intval line0
            en.set key: "character".string value: Value.intval c1.i64
            rg: newObj
            rg.set key: "start".string value: Value.object st
            rg.set key: "end".string value: Value.object en
            dg: newObj
            dg.set key: "range".string value: Value.object rg
            dg.set key: "severity".string value: Value.intval sevN
            dg.set key: "code".string value: Value.text d.code.copy
            dg.set key: "source".string value: Value.text "zl".string
            dg.set key: "message".string value: Value.text m
            arr.items.append (Value.object dg)
        }
    }
}

# formatAnswer -- the zl format pipeline over a live buffer: the safe
# non-layout fixes, re-parse validation, then the document printer at
# 100 columns. One whole-document TextEdit when anything changed; null
# when the buffer has parse errors, a fix would break it or the printer
# refuses it (the editor keeps the buffer untouched).
formatAnswer: function {text: StringView relpath: StringView} out Value is {
    fo: zsource.defaultOpts
    fo.lineLength = 100
    a: zsource.analyzeSource source: text.string path: relpath.string opts: fo
    if a.parseErrorCount > 0 then return Value.nul
    newsrc: a.source.copy
    valid: true
    if a.edits.length > 0 then {
        newsrc = zfix.applyEdits source: a.source.stringView edits: a.edits
        valid = zsource.sourceParses source: newsrc.copy
    }
    if valid.not then return Value.nul
    res: (zfmt.formatSource
        source: newsrc.stringView
        width: 100
        collapse: false
        raw: false
        gate: true
    )
    if res.ok.not then return Value.nul
    laid: String
    laid swap res.text
    newsrc = laid.take
    arr: newArr
    changed: false
    cv: newsrc.stringView
    if (cv == text).not then changed = true
    cv.drop
    if changed then {
        nl: i64
        i: u64
        n: text.length
        for i < n loop {
            b: text.byteAt :i
            match (
                b
            ) case some then {
                if b == 10 then nl = nl + 1
            } case none then null
            i = i + 1
        }
        st: newObj
        st.set key: "line".string value: Value.intval 0
        st.set key: "character".string value: Value.intval 0
        en: newObj
        en.set key: "line".string value: Value.intval nl + 1
        en.set key: "character".string value: Value.intval 0
        rg: newObj
        rg.set key: "start".string value: Value.object st
        rg.set key: "end".string value: Value.object en
        te: newObj
        te.set key: "range".string value: Value.object rg
        te.set key: "newText".string value: Value.text newsrc
        arr.items.append (Value.object te)
    }
    return (Value.array arr)
}

# ---- completion -------------------------------------------------------

# byteIdxOfCp -- byte offset where the 1-based codepoint column starts;
# s.length when the column is past the end of the line.
byteIdxOfCp: function {s: StringView cp1: u32} out u64 is {
    if cp1 <= 1 then return 0
    cnt: u32
    i: u64
    n: s.length
    for i < n loop {
        b: s.byteAt :i
        match (
            b
        ) case some then {
            isStart: b < 128
            if b >= 192 then isStart = true
            if isStart then {
                cnt = cnt + 1
                if cnt == cp1 then return i
            }
        } case none then null
        i = i + 1
    }
    return n
}

# byteOr -- the byte at `i`, and `d` when `i` is past the end. The scans below
# read a line right to left and treat "off the end" as "not the byte I want",
# which is what `d` spells without a `match` around every read.
byteOr: function {s: StringView.view i: u64 d: u8} out u8 is {
    got: s.byteAt :i
    match (
        got
    ) case some then {
        return got
    } case none then null
    return d
}

# byteIs -- is the byte at `i` exactly `b`? False past the end.
byteIs: function {s: StringView.view i: u64 b: u8} out bool is {
    return (byteOr :s :i d: 0) == b
}

# skipSpacesFrom -- the first index at or after `from` holding neither a space
# nor a tab; the length when the rest of the line is blank.
skipSpacesFrom: function {s: StringView from: u64} out u64 is {
    j: from
    n: s.length
    for j < n loop {
        b: byteOr :s i: j d: 0
        if b != 32 when b != 9 then return j
        j = j + 1
    }
    return j
}

# identEndFrom -- the first index at or after `from` whose byte cannot continue
# an identifier; `from` itself when the byte there already cannot.
identEndFrom: function {s: StringView from: u64} out u64 is {
    j: from
    n: s.length
    for j < n loop {
        if (isIdentByte b: (byteOr :s i: j d: 0)).not then return j
        j = j + 1
    }
    return j
}

# identStartBack -- the first index of the identifier run ending at `from`,
# read backwards and never past `floor`.
identStartBack: function {s: StringView from: u64 floor: u64} out u64 is {
    ls: from
    for ls > floor loop {
        if (isIdentByte b: (byteOr :s i: ls - 1 d: 0)).not then return ls
        ls = ls - 1
    }
    return ls
}

# true when byte `b` may appear in an identifier.
isIdentByte: function {b: u8} out bool is {
    return (
        (b >= 97) and
        (b <= 122) or
        ((b >= 65) and (b <= 90)) or
        ((b >= 48) and (b <= 57)) or
        (
            b == 95
        )
    )
}

# addCand -- record a completion candidate (first kind wins on dups).
addCand: function {sink: (MapRV String v: u8) name: StringView kind: u8} is {
    if name.length == 0 then return
    if (sink.has key: name.asString) then return
    k2: name.string
    sink.set key: k2 value: kind
}

# add the language keywords to a completion sink: exactly the words the lexer
# reads as keywords (zlexer `kwlookup`). A builtin such as `return` or `true`
# is a definition, and reaches the sink with the other definitions.
addKeywords: function {sink: (MapRV String v: u8)} is {
    addCand :sink name: "function" kind: 14
    addCand :sink name: "class" kind: 14
    addCand :sink name: "record" kind: 14
    addCand :sink name: "union" kind: 14
    addCand :sink name: "variant" kind: 14
    addCand :sink name: "protocol" kind: 14
    addCand :sink name: "facet" kind: 14
    addCand :sink name: "data" kind: 14
    addCand :sink name: "choice" kind: 14
    addCand :sink name: "list" kind: 14
    addCand :sink name: "if" kind: 14
    addCand :sink name: "then" kind: 14
    addCand :sink name: "else" kind: 14
    addCand :sink name: "when" kind: 14
    addCand :sink name: "match" kind: 14
    addCand :sink name: "case" kind: 14
    addCand :sink name: "for" kind: 14
    addCand :sink name: "each" kind: 14
    addCand :sink name: "while" kind: 14
    addCand :sink name: "loop" kind: 14
    addCand :sink name: "with" kind: 14
    addCand :sink name: "do" kind: 14
    addCand :sink name: "is" kind: 14
    addCand :sink name: "as" kind: 14
    addCand :sink name: "in" kind: 14
    addCand :sink name: "out" kind: 14
    addCand :sink name: "native" kind: 14
    addCand :sink name: "on" kind: 14
    addCand :sink name: "unit" kind: 14
    addCand :sink name: "generator" kind: 14
    addCand :sink name: "typedef" kind: 14
    addCand :sink name: "outx" kind: 14
    addCand :sink name: "swap" kind: 14
}

# defKindOf -- the CompletionItemKind of a top-level definition.
defKindOf: function {op: zast.astnode.view} out u8 is {
    match (
        op
    ) case functiondef then {
        return 3
    } case objectdef then {
        return 7
    } case unitdef then {
        return 9
    } else {
        return 21
    }
}

# rankNew -- stamp `group` onto every candidate in the sink that no earlier
# group claimed, so a name keeps the nearest group it was found in.
rankNew: function {sink: (MapRV String v: u8) rank: (MapRV String v: u8) group: u8} is {
    for each ce: sink.iterateItems loop {
        if (rank.has key: ce.key).not then rank.set key: ce.key.copy value: group
    }
}

# addUnitChainDefs -- the unit-level definitions a bare name written in unit
# `site` reaches: the unit's own, then each unit enclosing it, nearest first.
addUnitChainDefs: function {
    snap: zcheck.CheckResult.view
    site: ztypes.declid
    sink: (MapRV String v: u8)
} is {
    o: snap.st
    match (
        o
    ) case some then {
        cur: site
        for cur.isZero.not loop {
            if (o.typing.declIsUnitScope declId: cur) then {
                addDeclUnitDefs prog: snap.prog st: o declId: cur :sink
            }
            cur = o.typing.declParentOf declId: cur
        }
    } case none then null
}

# addCoreDefs -- the prelude's definitions, which a bare name reaches from
# every unit.
addCoreDefs: function {snap: zcheck.CheckResult.view sink: (MapRV String v: u8)} is {
    o: snap.st
    match (
        o
    ) case some then {
        cr: o.typing.coreUnitRoot
        if cr.isZero.not then addDeclUnitDefs prog: snap.prog st: o declId: cr :sink
    } case none then null
}

# addDeclUnitDefs -- the definitions of the unit declaration `declId`.
addDeclUnitDefs: function {
    prog: Ast.view
    st: zenv.ZSymbolTable.view
    declId: ztypes.declid
    sink: (MapRV String v: u8)
} is {
    dn: (st.typing.decls.get i: declId).node
    if dn.isZero then return
    np: prog.nodes.get i: dn
    if np.namedoperation then collectUnitDefsIn ast: prog ud: (prog.nodes.get i: np.operation) :sink
}

# addUnitFiles -- the units the folder `dirid` holds, as Module candidates:
# each `<name>.z` entry whose name is a unit name. Nothing is parsed, so a unit
# the program has not loaded is offered too.
addUnitFiles: function {vfs: zvfs.ZVfs.view dirid: zvfs.fsno sink: (MapRV String v: u8)} is {
    r: vfs.open dentryid: dirid
    match (
        r
    ) case dir then {
        for each nm: r loop {
            stem: nm.stringView.stripSuffix s: ".z"
            match (
                stem
            ) case some then {
                if (zparser.isValidUnitName name: stem) then addCand :sink name: stem kind: 9
            } case none then null
        }
    } case file then null case err then null
}

# add a unit node's definition names to a completion sink.
collectUnitDefsIn: function {ast: Ast.view ud: zast.astnode.view sink: (MapRV String v: u8)} is {
    if ud.unitdef then {
        box2059: u64
        for box2059 < ud.body.count loop {
            b9Id: zast.kidAt kids: ast.kids span: ud.body i: box2059
            box2059 = box2059 + 1
            collectMemberDef :ast m: (ast.nodes.get i: b9Id) :sink
        }
    }
}

# add member `m`'s name to a completion sink.
collectMemberDef: function {ast: Ast.view m: zast.astnode.view sink: (MapRV String v: u8)} is {
    if m.namedoperation then {
        lb: zast.nameTextAt :ast ref: m.name
        if lb.length > 0 then {
            k: defKindOf op: (ast.nodes.get i: m.operation)
            addCand :sink name: lb.stringView kind: k
        }
    }
}

# enclosingDefStart -- the start line of the unit-body definition the
# cursor sits in (the last def at or before the cursor line), also
# adding that definition's parameter names when it is a function.
# 0 when the cursor precedes every definition, or there is no unit.
enclosingDefStart: function {
    prog: Ast.view
    # the document's unitdef node
    unitOp: zast.nodeid
    l1u: u32
    sink: (MapRV String v: u8)
} out u32 is {
    if unitOp.isZero then return 0
    return (enclosingInBody ast: prog ud: (prog.nodes.get i: unitOp) :l1u :sink)
}

# the definition enclosing a position within a body.
enclosingInBody: function {
    ast: Ast.view
    ud: zast.astnode.view
    l1u: u32
    sink: (MapRV String v: u8)
} out u32 is {
    match (
        ud
    ) case unitdef then {
        best: u32
        {
            box2069: u64
            for box2069 < ud.body.count loop {
                b9Id: zast.kidAt kids: ast.kids span: ud.body i: box2069
                box2069 = box2069 + 1
                b9IdNode: ast.nodes.get i: b9Id
                ln: memberStartLine m: b9IdNode
                if ln > 0 when ln <= l1u when ln > best then best = ln
            }
        }
        if best > 0 then {
            box2079: u64
            for box2079 < ud.body.count loop {
                b2Id: zast.kidAt kids: ast.kids span: ud.body i: box2079
                box2079 = box2079 + 1
                b2: ast.nodes.get i: b2Id
                ln2: memberStartLine m: b2
                if ln2 == best then addMemberParams :ast m: b2 :sink
            }
        }
        return best
    } else {
        return 0
    }
}

# the source line where member `m` begins.
memberStartLine: function {m: zast.astnode.view} out u32 is {
    match (
        m
    ) case namedoperation then {
        return m.lineno
    } else {
        return 0
    }
}

# add member `m`'s parameter names to a completion sink.
addMemberParams: function {ast: Ast.view m: zast.astnode.view sink: (MapRV String v: u8)} is {
    if m.namedoperation then {
        addFnParams :ast op: (ast.nodes.get i: m.operation) :sink
    }
}

# add function `op`'s parameter names to a completion sink.
addFnParams: function {ast: Ast.view op: zast.astnode.view sink: (MapRV String v: u8)} is {
    if op.functiondef then {
        pax1529: u64
        for pax1529 < op.parameters.count loop {
            pm9Id: zast.kidAt kids: ast.kids span: op.parameters i: pax1529
            pax1529 = pax1529 + 1
            pm: ast.nodes.get i: pm9Id
            addParamLabel :ast :pm :sink
        }
    }
}

# add parameter `pm`'s label to a completion sink.
addParamLabel: function {ast: Ast.view pm: zast.astnode.view sink: (MapRV String v: u8)} is {
    if pm.namedoperation then {
        pl: zast.nameTextAt :ast ref: pm.name
        addCand :sink name: pl.stringView kind: 6
    }
}

# addScopeCompletions -- the bare-name candidates, each stamped in `rank` with
# its group, which orders them: 0 the enclosing def's params and locals, 1 the
# document's unit and the units enclosing it, 2 core, 3 the subunits in the
# document unit's own folder, 4 the top-level units on the roots, 5 keywords.
# Groups 3 and 4 are read from the folders, so a unit the program does not use
# is offered too; a subunit of any other unit is not, being out of reach.
addScopeCompletions: function {
    snap: zcheck.CheckResult
    docRel: StringView
    l1u: u32
    sink: (MapRV String v: u8)
    rank: (MapRV String v: u8)
} is {
    defStart: (enclosingDefStart
        prog: snap.prog
        unitOp: (docUnitOp r: snap rel: docRel)
        :l1u
        :sink
    )
    if defStart > 0 then {
        sp: fileSpans prog: snap.prog fsno: (docFsnoOf r: snap rel: docRel)
        nr: sp.rows.length
        ri: u64
        for ri < nr loop {
            row: sp.rows.get i: ri
            if row.kind == 3 when row.line >= defStart when row.line <= l1u then {
                fs: zcheck.fsnoFor r: snap nodeid: row.nodeid
                pp: snap.vfs.pathfromprovider dentryid: fs
                if (pathMatches pv: pp.stringView rel: docRel) then {
                    nm: sp.names.get i: ri
                    addCand :sink name: nm.stringView kind: 6
                }
            }
            ri = ri + 1
        }
    }
    rankNew :sink :rank group: 0
    addUnitChainDefs :snap site: (docUnitDecl r: snap rel: docRel) :sink
    rankNew :sink :rank group: 1
    addCoreDefs :snap :sink
    rankNew :sink :rank group: 2
    docFs: docFsnoOf r: snap rel: docRel
    if docFs.isZero.not then {
        un: zsource.unitNameOf file: docRel
        own: snap.vfs.siblingDir fileid: docFs name: un.stringView
        addUnitFiles vfs: snap.vfs dirid: own :sink
    }
    rankNew :sink :rank group: 3
    addUnitFiles vfs: snap.vfs dirid: snap.vfs.rootid :sink
    rankNew :sink :rank group: 4
    addKeywords :sink
    rankNew :sink :rank group: 5
}

# addTypeMembers -- a type's fields (kind 5) and methods (kind 2), the
# receiver excluded.
addTypeMembers: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    tid: ztypes.tid
    sink: (MapRV String v: u8)
    # drop members named for a numeric type: after a literal, the ones its
    # literal type does not declare are compile errors, not completions
    skipNumeric: bool
} is {
    match (
        o
    ) case some then {
        {
            addTypeMembersIn :prog :o :tid :sink :skipNumeric
        }
    } case none then null
}

# userParams -- a function type's user parameters, in declaration order:
# names, type ids and name pool ids, with the receiver skipped. The receiver
# is either the shorthand `this` or the type's recorded long-form receiver
# name. Collected in one pass because resolving a member declaration takes an
# exclusive lock on `o`, so no caller may probe while enumerating.
userParams: function {
    prog: Ast.view
    o: zenv.ZSymbolTable.view
    tid: ztypes.tid
    names: List String
    tids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
} is {
    otmk: tid
    mk: u64
    mn: o.typing.declRowSlots ownerTid: otmk
    for mk < mn loop {
        rwmk: o.typing.declRowAt ownerTid: otmk membersOnly: true slot: mk
        mk = mk + 1
        if rwmk.keep then {
            mnid: rwmk.name
            mtid: rwmk.tid
            cnB: prog.names.texts.get i: mnid
            cn: cnB.stringView
            isRecv: (
                (mnid == zast.wellKnown.slot.wkThis) or
                (o.reg.thisParamNameIs
                    :tid
                    nameId: mnid
                )
            )
            if isRecv.not then {
                names.append cn.string
                tids.append mtid
                nameIds.append mnid
            }
        }
    }
}

# addTypeMembersIn -- addTypeMembers with the program narrowed (prog is
# the programrow payload).
addTypeMembersIn: function {
    prog: Ast.view
    o: zenv.ZSymbolTable.view
    tid: ztypes.tid
    sink: (MapRV String v: u8)
    skipNumeric: bool
} is {
    # a unit's children are its definitions, not members: addUnitMembers
    # handles those, and declMemberList excludes them by design
    if (o.reg.typetypeOf typeId: tid) == ztypes.ztypetype.unitType then return
    pn8: List String
    pt8: ListVal ztypes.tid
    pi8: ListVal zast.nameid
    userParams :prog :o :tid names: pn8 tids: pt8 nameIds: pi8
    mk8: u64
    mn8: pn8.length
    for mk8 < mn8 loop {
        cn: pn8.get i: mk8
        skip8: false
        if skipNumeric when (ztypecheck.isNumericTypeName name: cn.stringView) then skip8 = true
        if skip8.not then {
            k: 5.u8
            if (
                (o.reg.typetypeOf typeId: (pt8.get i: mk8)) == ztypes.ztypetype.functionType
            ) then k = 2
            md: o.typing.declMemberIdOf parentTypeId: tid nameId: (pi8.get i: mk8)
            if md.isZero.not when (o.typing.decls.get i: md).kind.armDecl then k = 20
            addCand :sink name: cn.stringView kind: k
        }
        mk8 = mk8 + 1
    }
}

# addHeadUnitMembers -- the definitions of the unit a single head names: the
# top-level unit by its file, else the unit a bare name reaches from the
# document's unit -- its own subunit, which no top-level file of the name holds.
addHeadUnitMembers: function {
    snap: zcheck.CheckResult.view
    docRel: StringView
    name: StringView
    sink: (MapRV String v: u8)
} is {
    if (unitFsnoByName :snap :name).isZero.not then {
        addUnitMembers prog: snap.prog :name :sink
        return
    }
    d: (bareDeclOf
        o: snap.st
        site: (docUnitDecl r: snap rel: docRel)
        nameId: (zast.poolFind pool: snap.prog.names text: name)
    )
    if d.isZero then return
    o: snap.st
    match (
        o
    ) case some then {
        addDeclUnitDefs prog: snap.prog st: o declId: d :sink
    } case none then null
}

# addUnitMembers -- the top-level symbols of the file-unit named `name`.
addUnitMembers: function {prog: Ast.view name: StringView sink: (MapRV String v: u8)} is {
    {
        uCnt9d: prog.units.length
        uIdx9d: u64
        for uIdx9d < uCnt9d loop {
            u9Id: prog.units.get i: uIdx9d
            uIdx9d = uIdx9d + 1
            u: prog.nodes.get i: u9Id
            if u.namedoperation then {
                lb: zast.poolTextAt pool: prog.names ref: u.name
                if lb.stringView == name then (collectUnitDefsIn
                    ast: prog
                    ud: (prog.nodes.get i: u.operation)
                    :sink
                )
            }
        }
    }
}

# baseTypeInScope -- the type id of the local `base` visible in the enclosing
# def: a kind-3 binding row, or a kind-1 use row that reads a variable (a
# parameter's uses are its only rows there). A use of a unit-level name -- a
# function, a type -- is no local; 0 when none is found.
baseTypeInScope: function {
    snap: zcheck.CheckResult
    docRel: StringView
    defStart: u32
    l1u: u32
    base: StringView
} out ztypes.tid is {
    result: ztypes.tid
    sp: fileSpans prog: snap.prog fsno: (docFsnoOf r: snap rel: docRel)
    nr: sp.rows.length
    ri: u64
    for ri < nr loop {
        row: sp.rows.get i: ri
        if row.line >= defStart when row.line <= l1u then {
            nm: sp.names.get i: ri
            if nm.stringView == base then {
                tt: localRowType :snap :row :docRel
                if tt.isZero.not then result = tt
            }
        }
        ri = ri + 1
    }
    return result
}

# localRowType -- the type of the local a span row of the document names: a
# binding row, or a use row that reads a variable; 0 for any other row
localRowType: function {
    snap: zcheck.CheckResult
    row: spanrow
    docRel: StringView
} out ztypes.tid is {
    isLocal: row.kind == 3
    if row.kind == 1 then isLocal = (useVarId o: snap.st nid: row.nodeid).isZero.not
    if isLocal.not then return ztypes.tid.zero
    fs: zcheck.fsnoFor r: snap nodeid: row.nodeid
    pp: snap.vfs.pathfromprovider dentryid: fs
    if (pathMatches pv: pp.stringView rel: docRel).not then return ztypes.tid.zero
    return (nodeTypeAt o: snap.st nid: row.nodeid)
}

# parenOpenOf -- index of the `(` matching the `)` at `close`, by a backward
# paren-depth scan of one line; `close` itself when nothing matches.
parenOpenOf: function {ltv: StringView close: u64} out u64 is {
    depth: u64
    i: close + 1
    for i > 0 loop {
        i = i - 1
        b: ltv.byteAt :i
        match (
            b
        ) case some then {
            if b == 41 then depth = depth + 1
            if b == 40 then {
                if depth == 0 then return close
                depth = depth - 1
                if depth == 0 then return i
            }
        } case none then null
    }
    return close
}

# baserange -- a member base's [lo, hi) byte range on the completion line.
baserange: record {
    # the first byte of the base expression
    lo: u64
    # one past its last byte
    hi: u64
}

# memberBaseOf -- the base expression before the `.` at `dot`. Identifier bytes
# and dots walk back as one run; when a `)` sits there instead the base is
# parenthesised (`(2.5).`) and the run is its interior, which the plain scan
# reads as empty.
memberBaseOf: function {ltv: StringView dot: u64} out baserange is {
    bs: dot
    for bs > 0 loop {
        bb: ltv.byteAt i: bs - 1
        match (
            bb
        ) case some then {
            if (isIdentByte b: bb).not when bb != 46 then break
        } case none then {
            break
        }
        bs = bs - 1
    }
    if bs < dot then return (baserange lo: bs hi: dot)
    if dot == 0 then return (baserange lo: dot hi: dot)
    cb: ltv.byteAt i: dot - 1
    match (
        cb
    ) case some then {
        if cb == 41 then {
            close: dot - 1
            op: parenOpenOf :ltv :close
            if (op + 1) < close then return (baserange lo: op + 1 hi: close)
        }
    } case none then null
    return (baserange lo: dot hi: dot)
}

# numberEnd -- the length of the numeric literal `base` opens with, or 0 when it
# does not open with one. The parser's rule decides where it ends: a dot
# CONTINUES the number only when a digit follows, so `2.5` is one lexeme while
# the second dot in `2.5.f32` is a member selector.
numberEnd: function {base: StringView} out u64 is {
    if (ztypecheck.isNumericLiteralName name: base).not then return 0
    n: base.length
    i: u64
    for i < n loop {
        b: base.byteAt :i
        stop: false
        match (
            b
        ) case some then {
            if b == 46 then {
                nb: base.byteAt i: i + 1
                match (
                    nb
                ) case some then {
                    isD: false
                    if nb >= 48 when nb <= 57 then isD = true
                    if isD.not then stop = true
                } case none then {
                    stop = true
                }
            }
        } case none then {
            stop = true
        }
        if stop then return i
        i = i + 1
    }
    return n
}

# literalTidOf -- the literal type a numeric lexeme wears: floatliteral when it
# carries a decimal point, intliteral otherwise.
literalTidOf: function {o: (Option zenv.ZSymbolTable).view name: StringView} out ztypes.tid is {
    match (
        o
    ) case some then {
        if (ztypecheck.isFloatLiteralName :name) then return o.reg.literalFloatTid
        return o.reg.literalIntTid
    } case none then null
    return ztypes.tid.zero
}

# literalConvTid -- the type a literal's declared conversion `name` produces.
# Every member of a literal type is a conversion, and `65.u8` IS a u8 -- a pin,
# not a call -- so the segment after a literal head resolves to the RETURN type
# where an ordinary member access would stop at the method.
literalConvTid: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    litTid: ztypes.tid
    name: StringView
} out ztypes.tid is {
    m: childOfIn :prog :o parent: litTid :name
    if m.isZero then return ztypes.tid.zero
    match (
        o
    ) case some then {
        r: ztypecheck.methodReturnOf st: o mid: m
        match (
            r
        ) case some then {
            return r
        } case none then null
    } case none then null
    return ztypes.tid.zero
}

# literalDefaultTid -- the concrete type an unpinned literal falls to, asked of
# the literal type's own declaration rather than spelled here twice.
literalDefaultTid: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    litTid: ztypes.tid
    # the literal is written in hex, octal or binary, which falls to u64
    bits: bool
} out ztypes.tid is {
    isF: false
    match (
        o
    ) case some then {
        if litTid == o.reg.literalFloatTid then isF = true
    } case none then null
    if isF then return (literalConvTid :prog :o :litTid name: "f64")
    if bits then return (literalConvTid :prog :o :litTid name: "u64")
    return (literalConvTid :prog :o :litTid name: "i64")
}

# addLiteralMembers -- a numeric literal's completion surface: the conversions
# its literal type declares, plus the default type's OTHER members. The filter
# is the checker's own rule -- a numeric target the literal type does not
# declare is an error (`2.5.u8`), while a non-numeric child falls through to the
# materialised receiver (`5.times`, `1.0.scaleB`). Unfiltered, a float literal
# would be offered twelve conversions that do not compile.
addLiteralMembers: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    litTid: ztypes.tid
    # the literal is written in hex, octal or binary
    bits: bool
    sink: (MapRV String v: u8)
} is {
    addTypeMembers :prog :o tid: litTid :sink skipNumeric: false
    dflt: literalDefaultTid :prog :o :litTid :bits
    if dflt.isZero then return
    addTypeMembers :prog :o tid: dflt :sink skipNumeric: true
}

# dotFrom -- index of the first `.` at or after `start` in base, or
# base.length when there is none.
dotFrom: function {base: StringView start: u64} out u64 is {
    n: base.length
    i: start
    for i < n loop {
        b: base.byteAt :i
        match (
            b
        ) case some then {
            if b == 46 then return i
        } case none then null
        i = i + 1
    }
    return n
}

# descendUnitType -- the type id of `unit.name`, resolved (and declared on
# demand) by the compiler's own reference-level resolver, so it works even
# for a type not yet referenced elsewhere in the loaded program.
descendUnitType: function {
    prog: Ast
    unitName: StringView
    name: StringView
    o: Option zenv.ZSymbolTable
} out ztypes.tid is {
    result: ztypes.tid
    match (
        o
    ) case some then {
        {
            ud: (ztypecheck.unitDeclOfName
                st: o
                nameId: (zast.poolFind pool: prog.names text: unitName)
            )
            result = (ztypecheck.resolveUnitMemberLate
                st: o
                ast: prog
                unitDecl: ud
                :name
            )
        }
    } case none then null
    return result
}

# childOfIn -- the type id of `parent`'s child named `name` (a field, method,
# or a unit's member type), or 0. The compiler's own per-level resolver.
childOfIn: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    parent: ztypes.tid
    name: StringView
} out ztypes.tid is {
    result: ztypes.tid
    match (
        o
    ) case some then {
        {
            # the name is the editor's text: interned here, at the tool's edge
            co: (o.typing.declChildOfId
                parentTypeId: parent
                nameId: (zast.poolFind pool: prog.names text: name)
            )
            match (
                co
            ) case some then {
                result = co
            } case none then null
        }
    } case none then null
    return result
}

# descendSegments -- resolve the dot-separated segments of `base` from byte
# `start`, each a member of the running type; 0 when one does not resolve.
descendSegments: function {
    snap: zcheck.CheckResult
    base: StringView
    start: u64
    tid0: ztypes.tid
} out ztypes.tid is {
    n: base.length
    cur: tid0
    pos: start
    for pos <= n loop {
        de: dotFrom :base start: pos
        seg: base.substring from: pos to: de
        if seg.length > 0 then {
            cur = childOfIn prog: snap.prog o: snap.st parent: cur name: seg
            if cur.isZero then return ztypes.tid.zero
        }
        pos = de + 1
    }
    return cur
}

# addLiteralHead -- completions for a base opening with a numeric literal. The
# whole base is the number (`65.`, `2.5.`) -> the literal's own surface; a
# suffix follows (`65.u8.`) -> that conversion's type, then the ordinary member
# descent from there.
addLiteralHead: function {
    snap: zcheck.CheckResult
    base: StringView
    numEnd: u64
    sink: (MapRV String v: u8)
} is {
    # an owned copy: `base` is lent again below, and two live views of one
    # source conflict
    lit: (base.substring from: 0 to: numEnd).string
    ltid: literalTidOf o: snap.st name: lit.stringView
    if ltid.isZero then return
    bits: ztypecheck.isBitsLexeme lex: lit.stringView
    n: base.length
    if numEnd >= n then {
        addLiteralMembers prog: snap.prog o: snap.st litTid: ltid :bits :sink
        return
    }
    s0: numEnd + 1
    de: dotFrom :base start: s0
    seg: (base.substring from: s0 to: de).string
    cur: (literalConvTid
        prog: snap.prog
        o: snap.st
        litTid: ltid
        name: seg.stringView
    )
    if cur.isZero then {
        # a NON-numeric child falls through to the materialised receiver, the
        # rule that keeps `5.times` and `1.0.scaleB` working
        dflt: literalDefaultTid prog: snap.prog o: snap.st litTid: ltid :bits
        if dflt.isZero then return
        cur = (childOfIn
            prog: snap.prog
            o: snap.st
            parent: dflt
            name: seg.stringView
        )
    }
    if cur.isZero then return
    s1: de + 1
    cur = descendSegments :snap :base start: s1 tid0: cur
    if cur.isZero then return
    (addTypeMembers
        prog: snap.prog
        o: snap.st
        tid: cur
        :sink
        skipNumeric: false
    )
}

# dotplace -- the block a `.` being completed is written in. It decides which
# markers may follow a TYPE there; in a body the `.` follows a value instead.
dotplace: variant {
    # a function body or a unit's definitions, where a value is read
    body: null
    # a parameter list: `function {`, `in {` or `generator {`
    params: null
    # an `as { }` block, where a generic parameter names its bound
    asItems: null
    # a class's fields
    classFields: null
    # a union's arms
    unionArms: null
    # an `outx` return, which keeps the inputs it is built from locked
    outxReturn: null
    # a record, variant, facet, protocol or data body, or an `out` return: no
    # marker follows a type there
    unmarked: null
} as { tag: u8.tag }

# dotsite -- where a `.` being completed sits, read off the live text
dotsite: record {
    # the innermost block around it
    place: dotplace
    # the path before the `.` opens a statement, so `.drop` may end it
    stmtStart: bool
    # the path is the value of a statement-level binding, `b: p.`
    binding: bool
}

# placeOpenedBy -- the block a `{` opens, named by the token before it
placeOpenedBy: function {prev: zlexer.toktype} out dotplace is {
    match (
        prev
    ) case functionTok then {
        return dotplace.params
    } case inTok then {
        return dotplace.params
    } case generatorTok then {
        return dotplace.params
    } case asTok then {
        return dotplace.asItems
    } case classTok then {
        return dotplace.classFields
    } case unionTok then {
        return dotplace.unionArms
    } case recordTok then {
        return dotplace.unmarked
    } case variantTok then {
        return dotplace.unmarked
    } case facetTok then {
        return dotplace.unmarked
    } case protocolTok then {
        return dotplace.unmarked
    } case dataTok then {
        return dotplace.unmarked
    } case choiceTok then {
        return dotplace.unmarked
    } case listTok then {
        return dotplace.unmarked
    } else {
        return dotplace.body
    }
}

# opensStatement -- a statement may begin right after token `tt`
opensStatement: function {tt: zlexer.toktype} out bool is {
    match (
        tt
    ) case bofTok then {
        return true
    } case eolTok then {
        return true
    } case semicolonTok then {
        return true
    } case braceOpenTok then {
        return true
    } case thenTok then {
        return true
    } case elseTok then {
        return true
    } case doTok then {
        return true
    } case loopTok then {
        return true
    } else {
        return false
    }
}

# DotScan -- the blocks open at each point of a token walk, and the tokens just
# behind it: what dotSiteOf reads a `.`'s site from
DotScan: class {
    # the open blocks, innermost last
    places: ListVal dotplace
    # beside each place: it was opened by a `(`, where a line end is no
    # statement boundary
    parens: ListVal bool
    # the last token taken
    prev: zlexer.toktype
    # the one before it
    prev2: zlexer.toktype
    # the last token that is not a line end, which is what names a block
    prevCode: zlexer.toktype
} as {
    # take one token that is not whitespace, a comment or a label's colon. A
    # `{` opens the place its keyword names -- an interpolation's `\{` lexes as
    # one too, opening a body -- and a `(` keeps the place around it
    step: function {:this tt: zlexer.toktype} is {
        match (
            tt
        ) case braceOpenTok then {
            this.places.append (placeOpenedBy prev: this.prevCode)
            this.parens.append false
        } case parenOpenTok then {
            this.places.append this.innermost
            this.parens.append true
        } case braceCloseTok then {
            this.close
        } case parenCloseTok then {
            this.close
        } else null
        this.prev2 = this.prev
        this.prev = tt
        if tt.eolTok.not then this.prevCode = tt
    }

    # end the innermost block, ignoring a stray closer
    close: function {:this} is {
        if this.places.length == 0 then return
        this.places.pop
        this.parens.pop
    }

    # the innermost open place; a body when none is open
    innermost: function {t: this.view} out dotplace is {
        if t.places.length == 0 then return dotplace.body
        return (t.places.get i: t.places.length - 1)
    }

    # the innermost block was opened by a `(`
    inParen: function {t: this.view} out bool is {
        if t.parens.length == 0 then return false
        return (t.parens.get i: t.parens.length - 1)
    }
}

# dotSiteOf -- the site of a `.` whose base starts at (line, col), found by
# lexing the live text up to it. The block being written has usually not parsed
# since its `{` was typed, so the last-good snapshot cannot place it; the lexer
# already tells a string or a comment from code.
dotSiteOf: function {docText: StringView line: u32 col: u32} out dotsite is {
    pool: zast.StringPool.create
    tk: zlexer.Tokenizer.create source: docText.string fsno: zvfs.fsno
    tk.keepTrivia = false
    sc: (DotScan
        places: ListVal dotplace
        parens: ListVal bool
        prev: zlexer.toktype.bofTok
        prev2: zlexer.toktype.bofTok
        prevCode: zlexer.toktype.bofTok
    )
    for true loop {
        t: tk.nextToken :pool
        if t.toktype.eofTok or (t.lineno > line) then break
        if t.lineno == line when t.colno >= col then break
        if (t.toktype.wsTok or t.toktype.commentTok or t.toktype.colonTok).not then (sc.step
            tt: t.toktype
        )
    }
    place: sc.innermost
    if sc.prevCode.outxTok then place = dotplace.outxReturn
    if sc.prevCode.outTok then place = dotplace.unmarked
    inParen: sc.inParen
    return (dotsite
        :place
        stmtStart: inParen.not and (opensStatement tt: sc.prev)
        binding: inParen.not and sc.prev.labelTok and (opensStatement tt: sc.prev2)
    )
}

# basekind -- what the text before a `.` names, which decides what may follow it
basekind: variant {
    # nothing the snapshot resolves
    unknown: null
    # a unit, whose definitions follow
    unitBase: null
    # a type spelled by its name
    typeBase: null
    # a variable or parameter, or a field reached through one: storage a marker
    # may move or lend
    storage: null
    # any other value -- a constant, an arm, a call's result -- which no marker
    # applies to
    value: null
    # a function's name, which only `.copy` turns into a reference
    fnName: null
} as { tag: u8.tag }

# dotbase -- the resolved base of a `.`
dotbase: record {
    # its type; 0 when the snapshot knows none (a unit named by its file)
    tid: ztypes.tid
    # what the base names
    kind: basekind
    # the base is one name rather than a path
    single: bool
}

# declBaseKind -- what declaration `d` makes of a base that names it, following
# a re-export to what it names
declBaseKind: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    d: ztypes.declid
    throughStorage: bool
} out basekind is {
    match (
        o
    ) case some then {
        cur: d
        hops: u32
        for hops < 8 loop {
            if cur.isZero then return basekind.unknown
            k: (o.typing.decls.get i: cur).kind
            if k.reexportDecl.not then return (baseKindOfDecl :k :throughStorage)
            cur = reexportTargetDecl :prog :o declId: cur
            if cur.isZero then return basekind.value
            hops = hops + 1
        }
    } case none then null
    return basekind.unknown
}

# baseKindOfDecl -- what a declaration of kind `k` names. A field is storage
# only when it is reached through storage.
baseKindOfDecl: function {k: ztyping.declkind throughStorage: bool} out basekind is {
    match (
        k
    ) case unitDecl then {
        return basekind.unitBase
    } case publicNs then {
        return basekind.unitBase
    } case typeDecl then {
        return basekind.typeBase
    } case funcDecl then {
        return basekind.fnName
    } case fieldDecl then {
        if throughStorage then return basekind.storage
        return basekind.value
    } case paramDecl then {
        return basekind.storage
    } case localDecl then {
        return basekind.storage
    } else {
        return basekind.value
    }
}

# reexportTargetDecl -- the declaration a re-export names, through the unit it
# names it in; 0 when that is no unit -- `true: bool.true` names a member of a
# TYPE, which is a value
reexportTargetDecl: function {
    prog: Ast.view
    o: zenv.ZSymbolTable.view
    declId: ztypes.declid
} out ztypes.declid is {
    tg: ztypecheck.reexportTargetIdsOf st: o ast: prog :declId
    ud: ztypecheck.unitDeclOfName st: o nameId: tg.unitName
    if ud.isZero then return ud
    return (ztypecheck.declOfUnitDefIds st: o unitDecl: ud nameId: tg.defName)
}

# bareDeclOf -- the declaration a bare name written in unit `site` reaches at
# unit level: the unit's own, else the prelude's. Locals are baseTypeInScope's.
bareDeclOf: function {
    o: (Option zenv.ZSymbolTable).view
    site: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    match (
        o
    ) case some then {
        return (bareDeclIn st: o :site :nameId)
    } case none then null
    return ztypes.declid.zero
}

# bareDeclIn -- bareDeclOf over a symbol table that is there.
bareDeclIn: function {
    st: zenv.ZSymbolTable.view
    site: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    d: ztypecheck.declOfUnitDefIds :st unitDecl: site :nameId
    if d.isZero then d = (ztypecheck.declOfUnitDefIds
        :st
        unitDecl: st.typing.coreUnitRoot
        :nameId
    )
    return d
}

# unitChildDecl -- the declaration of the file unit `unitId`'s definition
# `nameId`
unitChildDecl: function {
    o: (Option zenv.ZSymbolTable).view
    unitId: zast.nameid
    nameId: zast.nameid
} out ztypes.declid is {
    match (
        o
    ) case some then {
        ud: ztypecheck.unitDeclOfName st: o nameId: unitId
        return (ztypecheck.declOfUnitDefIds st: o unitDecl: ud :nameId)
    } case none then null
    return ztypes.declid.zero
}

# memberDeclOf -- the declaration of `parent`'s member named `nameId`: a unit's
# definition, or a type's field, method or arm
memberDeclOf: function {
    o: (Option zenv.ZSymbolTable).view
    parent: ztypes.tid
    nameId: zast.nameid
} out ztypes.declid is {
    match (
        o
    ) case some then {
        if (o.reg.typetypeOf typeId: parent) == ztypes.ztypetype.unitType then {
            return (ztypecheck.declOfUnitDefIds st: o unitDecl: (o.reg.defOf tid: parent) :nameId)
        }
        return (o.typing.declMemberIdOf parentTypeId: parent :nameId)
    } case none then null
    return ztypes.declid.zero
}

# bareTypeOf -- the type a bare name written in unit `site` names, from what the
# check already minted
bareTypeOf: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    site: ztypes.declid
    name: StringView
} out ztypes.tid is {
    match (
        o
    ) case some then {
        r: (ztypecheck.walkLookupTyperefRo
            ast: prog
            st: o
            unitDecl: site
            scope: site
            base: name
        )
        return (r.or d: ztypes.tid.zero)
    } case none then null
    return ztypes.tid.zero
}

# dothead -- what a base's head resolves to, and where the segments after it
# begin
dothead: record {
    # the head's type; 0 when the snapshot knows none
    tid: ztypes.tid
    # what the head names
    kind: basekind
    # the byte offset of the first segment after the head
    next: u64
}

# resolveDotBase -- what the base before a `.` names and its type: the head,
# then each later segment as a member of the type so far
resolveDotBase: function {
    snap: zcheck.CheckResult
    docRel: StringView
    l1u: u32
    base: StringView
} out dotbase is {
    n: base.length
    dotPos: dotFrom :base start: 0
    single: dotPos >= n
    h: dotHeadOf :snap :docRel :l1u :base :dotPos
    cur: h.tid
    kind: h.kind
    next: h.next
    for next <= n loop {
        de: dotFrom :base start: next
        # an owned copy: the descent lends the base
        seg: (base.substring from: next to: de).string
        if seg.length > 0 then {
            if cur.isZero then return (dotbase tid: cur kind: basekind.unknown :single)
            md: (memberDeclOf
                o: snap.st
                parent: cur
                nameId: (zast.poolFind pool: snap.prog.names text: seg.stringView)
            )
            kind = declBaseKind prog: snap.prog o: snap.st d: md throughStorage: kind.storage
            cur = childOfIn prog: snap.prog o: snap.st parent: cur name: seg.stringView
        }
        next = de + 1
    }
    return (dotbase tid: cur :kind :single)
}

# dotHeadOf -- the head of a base whose first segment ends at `dotPos`: a unit
# by its file (with the definition after it), else one bare name
dotHeadOf: function {
    snap: zcheck.CheckResult
    docRel: StringView
    l1u: u32
    base: StringView
    dotPos: u64
} out dothead is {
    # an owned copy: the lookups below lend the base
    firstSeg: (base.substring from: 0 to: dotPos).string
    if (unitFsnoByName :snap name: firstSeg.stringView).isZero.not then {
        return (unitHeadOf :snap :base unitName: firstSeg.stringView :dotPos)
    }
    h: bareHeadOf :snap :docRel :l1u name: firstSeg.stringView next: dotPos + 1
    # a name nothing reaches may be a unit the program does not use: load it
    # into the snapshot, and the head resolves as it would for a loaded one
    if h.kind.unknown when (loadUnitNamed :snap :docRel name: firstSeg.stringView) then {
        if (unitFsnoByName :snap name: firstSeg.stringView).isZero.not then {
            return (unitHeadOf :snap :base unitName: firstSeg.stringView :dotPos)
        }
        return (bareHeadOf :snap :docRel :l1u name: firstSeg.stringView next: dotPos + 1)
    }
    return h
}

# loadUnitNamed -- load the unit `name` into the snapshot when a reference
# written in the document's unit would find a file of that name the program
# has not loaded: a subunit in the unit's own folder first, then a top-level
# unit on the roots, the order resolution searches them in. The unit and the
# units it names that are not loaded yet are parsed and indexed; nothing is
# re-checked. They live in the snapshot until the next good check replaces
# it. True when a unit was added.
loadUnitNamed: function {
    snap: zcheck.CheckResult
    docRel: StringView
    name: StringView
} out bool is {
    if (zparser.isValidUnitName :name).not then return false
    file: "\{name}.z"
    docFs: docFsnoOf r: snap rel: docRel
    ownerOp: docUnitOp r: snap rel: docRel
    if docFs.isZero.not when ownerOp.isZero.not then {
        un: zsource.unitNameOf file: docRel
        own: snap.vfs.siblingDir fileid: docFs name: un.stringView
        hit: snap.vfs.walk parent: own name: file.stringView
        if (snap.vfs.arm dentryid: hit) == zvfs.nodekind.file then {
            return (zcheck.addSubunit
                r: snap
                dirid: own
                :ownerOp
                ownerDecl: (docUnitDecl r: snap rel: docRel)
                :name
            )
        }
    }
    top: snap.vfs.walk parent: snap.vfs.rootid name: file.stringView
    if (snap.vfs.arm dentryid: top) == zvfs.nodekind.file then return (zcheck.addUnit r: snap :name)
    return false
}

# unitHeadOf -- a head that opens with a file unit: the unit alone, or the unit
# and the definition named after it
unitHeadOf: function {
    snap: zcheck.CheckResult
    base: StringView
    unitName: StringView
    dotPos: u64
} out dothead is {
    n: base.length
    if dotPos >= n then return (dothead tid: ztypes.tid.zero kind: basekind.unitBase next: n + 1)
    next: dotPos + 1
    nextDot: dotFrom :base start: next
    # an owned copy: the descent lends the base
    secondSeg: (base.substring from: next to: nextDot).string
    tid: (descendUnitType
        prog: snap.prog
        :unitName
        name: secondSeg.stringView
        o: snap.st
    )
    memberD: (unitChildDecl
        o: snap.st
        unitId: (zast.poolFind pool: snap.prog.names text: unitName)
        nameId: (zast.poolFind pool: snap.prog.names text: secondSeg.stringView)
    )
    return (dothead
        :tid
        kind: (declBaseKind prog: snap.prog o: snap.st d: memberD throughStorage: false)
        next: nextDot + 1
    )
}

# bareHeadOf -- a head that is one bare name: a local of the enclosing
# definition, else a unit-level name of the document's unit or the prelude
bareHeadOf: function {
    snap: zcheck.CheckResult
    docRel: StringView
    l1u: u32
    name: StringView
    # where the segments after the head begin
    next: u64
} out dothead is {
    throwaway: MapRV String v: u8
    ds: (enclosingDefStart
        prog: snap.prog
        unitOp: (docUnitOp r: snap rel: docRel)
        :l1u
        sink: throwaway
    )
    lt: baseTypeInScope :snap :docRel defStart: ds :l1u base: name
    if lt.isZero.not then return (dothead tid: lt kind: basekind.storage :next)
    site: docUnitDecl r: snap rel: docRel
    d: bareDeclOf o: snap.st :site nameId: (zast.poolFind pool: snap.prog.names text: name)
    kind: declBaseKind prog: snap.prog o: snap.st :d throughStorage: false
    if kind.typeBase then return (dothead
        tid: (bareTypeOf prog: snap.prog o: snap.st :site :name)
        :kind
        :next
    )
    return (dothead tid: (declTypeIdOf o: snap.st declId: d) :kind :next)
}

# addUnitDeclMembers -- the definitions of the unit whose type is `unitTid`,
# and of its `public:` block: a subunit reached through a path, which has no
# file of the name to list.
addUnitDeclMembers: function {
    prog: Ast.view
    o: (Option zenv.ZSymbolTable).view
    unitTid: ztypes.tid
    sink: (MapRV String v: u8)
} is {
    match (
        o
    ) case some then {
        ud: o.reg.defOf tid: unitTid
        if ud.isZero then return
        addDeclChildren :prog :o declId: ud :sink
        pb: ztypecheck.publicNsOf st: o tid: unitTid
        if pb.isZero.not then addDeclChildren :prog :o declId: pb :sink
    } case none then null
}

# addDeclChildren -- each child of declaration `declId` as a completion, its
# kind by what it declares
addDeclChildren: function {
    prog: Ast.view
    o: zenv.ZSymbolTable.view
    declId: ztypes.declid
    sink: (MapRV String v: u8)
} is {
    n: o.typing.declChildSlots :declId
    i: u64
    for i < n loop {
        nid: zast.nameid
        cd: ztypes.declid
        {
            dd: o.typing.decls.get i: declId
            nid = dd.children.keyAt :i
            cv: dd.children.valueAt :i
            match (
                cv
            ) case some then {
                cd = cv
            } case none then null
        }
        i = i + 1
        k: 21.u8
        ck: (o.typing.decls.get i: cd).kind
        if ck.funcDecl then k = 3
        if ck.typeDecl then k = 7
        if ck.unitDecl then k = 9
        if ck.publicNs.not then {
            nm: zast.nameTextAt ast: prog ref: nid
            addCand :sink name: nm.stringView kind: k
        }
    }
}

# markerLabel -- the keyword a marker is written as
markerLabel: function {k: zast.markerkind} out StringView is {
    match (
        k
    ) case takeMarker then {
        return "take"
    } case borrowMarker then {
        return "borrow"
    } case viewMarker then {
        return "view"
    } case holdMarker then {
        return "hold"
    } case dropMarker then {
        return "drop"
    } case privateMarker then {
        return "private"
    } case genericBound then {
        return "generic"
    } else {
        return ""
    }
}

# markerDetail -- the one line a completion shows beside a marker
markerDetail: function {k: zast.markerkind} out StringView is {
    match (
        k
    ) case takeMarker then {
        return "owned and mutable: the value moves out of its path"
    } case borrowMarker then {
        return "not owned, mutable: a reference that may write through"
    } case viewMarker then {
        return "not owned, readonly: a reference that may only read"
    } case holdMarker then {
        return "owned and readonly: moved in, then frozen"
    } case dropMarker then {
        return "ends the name now: destroys what it owns, releases what it borrows"
    } case privateMarker then {
        return "the friend handle: reaches the type's non-public members"
    } case genericBound then {
        return "the bound of a generic parameter"
    } else {
        return ""
    }
}

# addTypeMarkers -- the markers a TYPE may carry in `place`
addTypeMarkers: function {place: dotplace marks: ListVal zast.markerkind} is {
    match (
        place
    ) case params then {
        marks.append zast.markerkind.takeMarker
        marks.append zast.markerkind.borrowMarker
        marks.append zast.markerkind.viewMarker
        marks.append zast.markerkind.holdMarker
        marks.append zast.markerkind.privateMarker
    } case classFields then {
        marks.append zast.markerkind.borrowMarker
        marks.append zast.markerkind.viewMarker
        marks.append zast.markerkind.privateMarker
    } case unionArms then {
        marks.append zast.markerkind.borrowMarker
        marks.append zast.markerkind.viewMarker
        marks.append zast.markerkind.holdMarker
    } case outxReturn then {
        marks.append zast.markerkind.borrowMarker
        marks.append zast.markerkind.viewMarker
    } case asItems then {
        marks.append zast.markerkind.genericBound
    } else null
}

# addMemberCompletions -- what may follow the `.` after `base`: members, and
# the markers the place allows. A path that ends in a marker ends there, but
# for `private.`, which a `borrow` or `view` narrows. A unit lists its
# definitions anywhere; outside a body the base is otherwise a TYPE, and the
# block decides its markers.
addMemberCompletions: function {
    snap: zcheck.CheckResult
    docRel: StringView
    l1u: u32
    base: StringView
    site: dotsite
    sink: (MapRV String v: u8)
    marks: ListVal zast.markerkind
} is {
    leaf: leafMarkerOf prog: snap.prog :base
    if leaf.privateMarker then {
        marks.append zast.markerkind.borrowMarker
        marks.append zast.markerkind.viewMarker
        return
    }
    if leaf.unmarked.not then return
    # a numeric head resolves by its TYPE, never by name: baseTypeInScope matches
    # a span row by SPELLING, so `65.` would otherwise complete off whatever a
    # same-spelled literal elsewhere in the enclosing def happens to be.
    numEnd: numberEnd :base
    if numEnd > 0 then {
        addLiteralHead :snap :base :numEnd :sink
        return
    }
    db: resolveDotBase :snap :docRel :l1u :base
    if db.kind.unitBase then {
        if db.single then {
            addHeadUnitMembers :snap :docRel name: base :sink
        } else addUnitDeclMembers prog: snap.prog o: snap.st unitTid: db.tid :sink
        return
    }
    if site.place.body then {
        addValueCompletions :snap :db :site :sink :marks
        return
    }
    addTypeMarkers place: site.place :marks
    if site.place.asItems when (tagCarrier :snap tid: db.tid) then (addCand
        :sink
        name: "tag"
        kind: 7
    )
}

# leafMarkerOf -- the marker the last segment of `base` spells
leafMarkerOf: function {prog: Ast.view base: StringView} out zast.markerkind is {
    lastDot: base.length
    for lastDot > 0 loop {
        if (byteIs s: base i: lastDot - 1 b: 46) then break
        lastDot = lastDot - 1
    }
    leaf: base.substring from: lastDot to: base.length
    return (zast.markerKindOfName id: (zast.poolFind pool: prog.names text: leaf))
}

# addValueCompletions -- what may follow a `.` in a body, by what the base
# names: a type's members; a value's members, and `copy` on a valtype; storage
# may also be moved, lent, held or -- opening a statement -- dropped, but a
# valtype is never borrowed into a binding; a function's name only copies.
addValueCompletions: function {
    snap: zcheck.CheckResult
    db: dotbase
    site: dotsite
    sink: (MapRV String v: u8)
    marks: ListVal zast.markerkind
} is {
    if db.kind.fnName then {
        addCand :sink name: "copy" kind: 2
        return
    }
    if db.tid.isZero then return
    (addTypeMembers
        prog: snap.prog
        o: snap.st
        tid: db.tid
        :sink
        skipNumeric: false
    )
    if db.kind.typeBase then return
    valtype: isValtypeOpt o: snap.st tid: db.tid
    if valtype then addCand :sink name: "copy" kind: 2
    if db.kind.storage.not then return
    marks.append zast.markerkind.takeMarker
    if (valtype and site.binding).not then marks.append zast.markerkind.borrowMarker
    marks.append zast.markerkind.viewMarker
    marks.append zast.markerkind.holdMarker
    if db.single when site.stmtStart then marks.append zast.markerkind.dropMarker
}

# tagCarrier -- a type whose `.tag` names a discriminator type: a list's
# value (`staticlist u8`) or a numeric type
tagCarrier: function {snap: zcheck.CheckResult tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    o: snap.st
    match (
        o
    ) case some then {
        sl: ztypecheck.stdTidRo ast: snap.prog st: o wk: zast.wellKnown.slot.tyStaticlist
        if sl.isZero.not when (o.reg.genericOriginOf :tid) == sl then return true
        return (ztypecheck.numKindOfTid st: o :tid).has
    } case none then null
    return false
}

# isValtypeOpt -- the type is known to be a valtype
isValtypeOpt: function {o: (Option zenv.ZSymbolTable).view tid: ztypes.tid} out bool is {
    match (
        o
    ) case some then {
        return (o.reg.isValtypeOf :tid)
    } case none then null
    return false
}

# completionItem -- a completion item object (label + kind, optional detail).
completionItem: function {label: StringView kind: u8 detail: StringView} out Value is {
    it: newObj
    it.set key: "label".string value: Value.text label.string
    it.set key: "kind".string value: Value.intval kind.i64
    if detail.length > 0 then {
        it.set key: "detail".string value: Value.text detail.string
    }
    return (Value.object it)
}

# backOverBlanks -- the position of the first byte of the run of spaces and
# tabs that ends at `pos`; `pos` itself when there is none.
backOverBlanks: function {ltv: StringView pos: u64} out u64 is {
    p: pos
    for p > 0 loop {
        b: (ltv.byteAt i: p - 1).or d: 0
        if b != 32 when b != 9 then break
        p = p - 1
    }
    return p
}

# backOverIdent -- the position of the first byte of the identifier that ends
# at `pos`; `pos` itself when no identifier byte precedes it.
backOverIdent: function {ltv: StringView pos: u64} out u64 is {
    p: pos
    for p > 0 loop {
        b: (ltv.byteAt i: p - 1).or d: 0
        if (isIdentByte :b).not then break
        p = p - 1
    }
    return p
}

# caseWordBefore -- whether the word before the blank run ending at `ps` is
# `case`: the cursor sits where an arm name goes.
caseWordBefore: function {prog: Ast.view ltv: StringView ps: u64} out bool is {
    ws: backOverBlanks :ltv pos: ps
    if ws == ps then return false
    wb: backOverIdent :ltv pos: ws
    wid: zast.poolFind pool: prog.names text: (ltv.substring from: wb to: ws)
    return wid == zast.wellKnown.slot.kwCase
}

# caseClauseIds -- a match's subject node index, with its clause ids appended
# to `dst`; 0 when the node is not a caseexpr.
caseClauseIds: function {
    prog: Ast.view caseId: zast.nodeid dst: ListVal zast.nodeid
} out zast.nodeid is {
    cnode: prog.nodes.get i: caseId
    if cnode.caseexpr.not then return zast.nodeid
    clx: u64
    for clx < cnode.clauses.count loop {
        cl: zast.kidAt kids: prog.kids span: cnode.clauses i: clx
        clx = clx + 1
        dst.append cl
    }
    return cnode.subject
}

# usedArmNames -- the arm names the clauses already cover, by the arm each
# clause matches: a bare name or a label.
usedArmNames: function {prog: Ast.view clauseIds: (ListVal zast.nodeid).view dst: List String} is {
    for each clId: clauseIds loop {
        maIdx: zast.nodeid
        clNode: prog.nodes.get i: clId
        if clNode.caseclause then maIdx = clNode.matcharm
        if maIdx.isZero then continue
        maRef: zast.nameid
        {
            maNode: prog.nodes.get i: maIdx
            match (
                maNode
            ) case atomid then {
                maRef = maNode.name
            } case labelvalue then {
                maRef = maNode.name
            } else null
        }
        if maRef.isZero then continue
        an: zast.nameTextCopy ast: prog ref: maRef
        if an.length > 0 then dst.append an
    }
}

# namesHave -- whether `names` holds `n`.
namesHave: function {names: (List String).view n: StringView} out bool is {
    for each e: names loop {
        if e.stringView == n then return true
    }
    return false
}

# caseArmComplete -- when the cursor sits after `case ` inside a match, append
# the subject variant's remaining arms (sumSubtypeNames minus arms already
# covered by other clauses) to `arr` as EnumMember items. Returns true when it
# handled the completion (a case-arm context), false otherwise.
caseArmComplete: function {
    arr: Arr
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    ltv: StringView
    ps: u64
    prefix: StringView
    cursorPos: zast.nodepos
    # the document's own file, where the enclosing match is looked up
    docFs: zvfs.fsno
} out bool is {
    if (caseWordBefore :prog :ltv :ps).not then return false
    sp: fileSpans :prog fsno: docFs
    caseId: (sp.innerRangeOfKind
        curPos: cursorPos
        kind: 5
        slack: 1
        :prog
        wantFsno: docFs
    )
    if caseId.isZero then return false
    clauseIds: ListVal zast.nodeid
    subjIdx: caseClauseIds :prog :caseId dst: clauseIds
    if subjIdx.isZero then return false
    subjNid: zast.nodeid
    subjNode: prog.nodes.get i: subjIdx
    subjNid = ztypecheck.nodeId n: subjNode
    subjTid: nodeTypeAt :o nid: subjNid
    if subjTid.isZero then return false
    if o.none then return false
    arms: ztypecheck.sumSubtypeNames ast: prog st: o sid: subjTid
    used: List String
    usedArmNames :prog :clauseIds dst: used
    for each arm: arms loop {
        if (namesHave names: used n: arm.stringView) then continue
        if prefix.length > 0 when (arm.startsWith prefix).not then continue
        arr.items.append (completionItem label: arm.stringView kind: 20 detail: "")
    }
    return true
}

# resolveCalleeFuncId -- a callable/leaf node id -> its function tid: nodeType
# carries a method callable's fn tid, useUnitDef a free function's; anything that
# does not name a function type yields 0.
resolveCalleeFuncId: function {
    o: (Option zenv.ZSymbolTable).view nid: zast.nodeid
} out ztypes.tid is {
    ftid: nodeTypeAt :o :nid
    udx: useUnitDef :o :nid
    if udx.isZero.not then ftid = udx
    if ftid.isZero then return ztypes.tid.zero
    result: ztypes.tid
    match (
        o
    ) case some then {
        tt: o.reg.typetypeOf typeId: ftid
        if tt.functionType then result = ftid
    } case none then null
    return result
}

# bareCalleeFuncId -- a lone function/method name with no label yet parses as
# an atom/dotted-path, not a call node, so the arg-label path has nothing to sit
# inside. Resolve the identifier just before the trailing whitespace via the
# same leaf-span + def recipe navAnswer uses; a function/method type yields its
# function id, anything else (a value arg, a keyword, an unresolved leaf) 0.
bareCalleeFuncId: function {
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    ltv: StringView
    ws: u64
    cursorPos: zast.nodepos
    sp: Spans.view
    docFs: zvfs.fsno
} out ztypes.tid is {
    leaf9: cursorLeafNid :prog :ltv :ws :cursorPos :sp :docFs
    if leaf9.isZero then return ztypes.tid.zero
    return (resolveCalleeFuncId :o nid: leaf9)
}

# cursorLeafNid -- the node id of the identifier immediately before the
# trailing whitespace at the cursor, or 0.
cursorLeafNid: function {
    prog: Ast.view
    ltv: StringView
    ws: u64
    cursorPos: zast.nodepos
    sp: Spans.view
    docFs: zvfs.fsno
} out zast.nodeid is {
    scan: ws
    for scan > 0 loop {
        ib: ltv.byteAt i: scan - 1
        stopid: false
        match (
            ib
        ) case some then {
            if (isIdentByte b: ib).not then stopid = true
        } case none then {
            stopid = true
        }
        if stopid then break
        scan = scan - 1
    }
    if scan == ws then return zast.nodeid
    idTxt: ltv.substring from: scan to: ws
    sub: ltv.substring from: 0 to: scan
    cc: sub.count
    idCol: cc.u32.orPanic + 1
    return (leafNidAt
        :sp
        :prog
        :docFs
        line1u: cursorPos.line
        :idCol
        name: idTxt
    )
}

# leafNidAt -- the node of the span row in the document's file `docFs` that
# covers (line1u, idCol) and names `name`, the highest-ranked kind when several
# do, or 0. The walk spans every unit, so a row of another file at the same line
# and column must not answer; the name refuses a row of a snapshot older than
# the text being read.
leafNidAt: function {
    sp: Spans.view
    prog: Ast.view
    docFs: zvfs.fsno
    line1u: u32
    idCol: u32
    name: StringView
} out zast.nodeid is {
    leafNid: zast.nodeid
    bk: u8
    found: false
    rix: u64
    for rix < sp.rows.length loop {
        row: sp.rows.get i: rix
        if row.line == line1u when row.colLo <= idCol when idCol < row.colHi when (
            (prog.fsnoForNode nodeid: row.nodeid) == docFs
        ) when (sp.names.get i: rix).stringView == name then {
            shouldTake: found.not
            if (spanKindRank kind: row.kind) > (spanKindRank kind: bk) then shouldTake = true
            if shouldTake then {
                leafNid = row.nodeid
                bk = row.kind
                found = true
            }
        }
        rix = rix + 1
    }
    return leafNid
}

# emitLabels -- append `funcId`'s parameter labels (minus the receiver and any
# already-supplied labels) to `arr` as kind-5 items with a type[+ownership]
# detail. Shared by the bare-name and call-node arg-label paths. Returns true
# when it emitted a label context (the callee has non-receiver params).
emitLabels: function {
    arr: Arr
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    funcId: ztypes.tid
    supplied: List String
    prefix: StringView
    # the unit the completion labels are shown in
    site: ztypes.declid
} out bool is {
    # callee params (skip receiver), collected before any declaration read
    pnames: List String
    pnids: ListVal zast.nameid
    pptids: ListVal ztypes.tid
    {
        match (
            o
        ) case some then {
            (userParams
                :prog
                :o
                tid: funcId
                names: pnames
                tids: pptids
                nameIds: pnids
            )
        } case none then null
    }
    if pnames.length == 0 then return false
    ri: u64
    for ri < pnames.length loop {
        pn: pnames.get i: ri
        isSupp: false
        for each su: supplied loop {
            if su.stringView == pn then isSupp = true
        }
        matchp: true
        if prefix.length > 0 when (pn.startsWith prefix).not then matchp = false
        if isSupp.not when matchp then {
            det: String
            match (
                o
            ) case some then {
                tn: displayTypeNameSt st: o tid: (pptids.get i: ri) :site
                det.append tn
                det.append (ownershipSuffix
                    st: o
                    parentTypeId: funcId
                    nameId: (pnids.get i: ri)
                )
            } case none then null
            arr.items.append (completionItem label: pn.stringView kind: 5 detail: det.stringView)
        }
        ri = ri + 1
    }
    return true
}

# argLabelComplete -- when the cursor sits at a fresh argument position inside a
# call (not after `:` or `.`), append the callee's remaining parameter labels
# (minus the receiver and the labels already supplied) to `arr`, with a
# type[+ownership] detail. Returns true when it handled a call-arg-label context.
argLabelComplete: function {
    arr: Arr
    o: (Option zenv.ZSymbolTable).view
    prog: Ast.view
    ltv: StringView
    ps: u64
    prefix: StringView
    cursorPos: zast.nodepos
    # the unit the completion is asked in
    site: ztypes.declid
    # the document's own file, where the enclosing call is looked up
    docFs: zvfs.fsno
} out bool is {
    ws: ps
    for ws > 0 loop {
        wb: ltv.byteAt i: ws - 1
        stopw: false
        match (
            wb
        ) case some then {
            if wb != 32 when wb != 9 then stopw = true
        } case none then {
            stopw = true
        }
        if stopw then break
        ws = ws - 1
    }
    if ws == 0 then return false
    pvb: ltv.byteAt i: ws - 1
    badPos: false
    match (
        pvb
    ) case some then {
        if pvb == 58 then badPos = true
        if pvb == 46 then badPos = true
    } case none then null
    if badPos then return false
    sp: fileSpans :prog fsno: docFs
    callId: (sp.innerRangeOfKind
        curPos: cursorPos
        kind: 4
        slack: 1
        :prog
        wantFsno: docFs
    )
    supplied: List String
    # a bare function/method name (no label yet) has no call node; on a fresh
    # arg position (empty prefix) resolve the identifier just before the cursor
    # and, when it names a function/method, offer its labels. Gated to the
    # empty-prefix case so typing a value still falls through to scope
    # completion; given priority since a slack-matched call node may be nearby.
    if prefix.length == 0 then {
        bfid: bareCalleeFuncId :o :prog :ltv :ws :cursorPos :sp :docFs
        if bfid.isZero.not then {
            empty: List String
            return (emitLabels
                :arr
                :o
                :prog
                funcId: bfid
                supplied: empty
                :prefix
                :site
            )
        }
    }
    if callId.isZero then return false
    # callable index + supplied argument node ids (scoped: one node view)
    callableIdx: zast.nodeid
    argIds: ListVal zast.nodeid
    okCall: false
    {
        cnode: prog.nodes.get i: callId
        if cnode.call then {
            callableIdx = cnode.callable
            arx639: u64
            for arx639 < cnode.arguments.count loop {
                aid: zast.kidAt kids: prog.kids span: cnode.arguments i: arx639
                arx639 = arx639 + 1
                argIds.append aid
            }
            okCall = true
        }
    }
    if okCall.not then return false
    if callableIdx.isZero then return false
    # callee function id (callable node -> nodeId -> useUnitDef)
    calNid: zast.nodeid
    caln: prog.nodes.get i: callableIdx
    calNid = ztypecheck.nodeId n: caln
    funcId: resolveCalleeFuncId :o nid: calNid
    if funcId.isZero then return false
    # supplied labels (each arg -> namedoperation.name ref -> text)
    si: u64
    for si < argIds.length loop {
        aid: argIds.get i: si
        nameRef: zast.nameid
        anode: prog.nodes.get i: aid
        if anode.namedoperation then nameRef = anode.name
        if nameRef.isZero.not then {
            lbl: zast.nameTextCopy ast: prog ref: nameRef
            if lbl.length > 0 then supplied.append lbl
        }
        si = si + 1
    }
    return (emitLabels :arr :o :prog :funcId :supplied :prefix :site)
}

# HeadScan -- the running state of the backward scan for the head of the call
# being typed: the paren depth carried from line to line, the head once a line
# has decided it, and the fallback statement start (the first line begun
# outside parens).
HeadScan: class {
    # paren depth: each ")" met scanning back opens one that an "(" must close
    pd: i64
    # the line the head sits on, once decided
    headLine: u32
    # the head's byte offset on that line
    headByte: u64
    # the nearest statement start, taken when a block boundary is met first
    stmtLine: u32
    # that statement's byte offset, always the start of its line
    stmtByte: u64
    # whether a statement start has been seen at all
    haveStmt: bool
    # set when the head is decided and the walk must end
    stop: bool
} as {
    # takeHead -- record `line` and `byte` as the head and end the walk.
    takeHead: function {:this line: u32 byte: u64} is {
        this.headLine = line
        this.headByte = byte
        this.stop = true
    }

    # takeBoundary -- a block brace at depth zero, or the top of the buffer: the
    # statement start wins when one has been seen, else the boundary's own
    # position.
    takeBoundary: function {:this line: u32 byte: u64} is {
        if this.haveStmt then {
            this.takeHead line: this.stmtLine byte: this.stmtByte
            return
        }
        this.takeHead :line :byte
    }
}

# headpos -- where a call's head sits in the buffer.
headpos: record {
    # the head's line, 1-based
    line: u32
    # the head's byte offset on that line
    byte: u64
}

# scanLineForHead -- one line of the backward head scan, read right to left
# from `end`. It records the head and stops at the innermost unmatched "(" or
# at a block brace outside parens; anything else only moves the depth.
scanLineForHead: function {hs: HeadScan s: StringView line: u32 end: u64} is {
    i: end
    for i > 0 loop {
        bb: byteOr :s i: i - 1 d: 0
        if bb == 41 then hs.pd = hs.pd + 1
        if bb == 40 then {
            if hs.pd > 0 then {
                hs.pd = hs.pd - 1
            } else {
                hs.takeHead :line byte: i
            }
        }
        isBrace: (bb == 123) or (bb == 125)
        if isBrace when hs.pd == 0 then hs.takeBoundary :line byte: i
        if hs.stop then return
        i = i - 1
    }
}

# callHeadAt -- the head of the call being typed at (`line`, `byte`). Scanning
# back through the buffer, the innermost unmatched "(" wins -- an enclosing,
# possibly multi-line, call -- and otherwise the nearest statement start, once a
# block boundary or the top of the buffer is reached. A newline is NOT a hard
# stop: a call spans lines inside parens.
callHeadAt: function {
    docText: StringView
    line: u32
    byte: u64
    lineText: StringView
} out headpos is {
    hs: (HeadScan
        pd: 0
        headLine: line
        headByte: 0
        stmtLine: line
        stmtByte: 0
        haveStmt: false
        stop: false
    )
    scanLine: line
    scanText: lineText.string
    scanEnd: byte
    for hs.stop.not loop {
        scanLineForHead :hs s: scanText.stringView line: scanLine end: scanEnd
        if hs.stop then break
        if hs.pd == 0 when hs.haveStmt.not then {
            hs.stmtLine = scanLine
            hs.stmtByte = 0
            hs.haveStmt = true
        }
        if scanLine <= 1 then {
            hs.takeBoundary line: 1 byte: 0
        } else {
            scanLine = scanLine - 1
            scanText = docLine text: docText lineno: scanLine
            scanEnd = scanText.length
        }
    }
    return (headpos line: hs.headLine byte: hs.headByte)
}

# namespan -- the callee path written at a call's head: the byte range of its
# LAST dotted segment, which is the name to resolve, and the end of the whole
# path.
namespan: record {
    # the first byte of the last dotted segment
    segStart: u64
    # one past the last byte of the whole path
    calleeEnd: u64
    # false when the head holds no identifier at all
    found: bool
}

# calleeNameOn -- the callee path written at `from`: leading blanks skipped, an
# identifier taken, a `name:` binder stepped over to the name it binds, then
# every `.segment` after it followed.
calleeNameOn: function {s: StringView from: u64} out namespan is {
    j: skipSpacesFrom :s :from
    ids: j
    j = identEndFrom :s from: j
    # `x: f a: 1` heads a BINDING, so the callee is what follows the colon
    if (byteIs :s i: j b: 58) then {
        j = skipSpacesFrom :s from: j + 1
        ids = j
        j = identEndFrom :s from: j
    }
    if j == ids then return (namespan segStart: 0 calleeEnd: 0 found: false)
    segStart: ids
    for (byteIs :s i: j b: 46) loop {
        j = j + 1
        segStart = j
        j = identEndFrom :s from: j
    }
    return (namespan :segStart calleeEnd: j found: true)
}

# labelBefore -- the identifier immediately before the ":" at `colon`, and ""
# when there is none before `floor`.
labelBefore: function {s: StringView colon: u64 floor: u64} out String is {
    ls: identStartBack :s from: colon :floor
    if ls < colon then return (s.substring from: ls to: colon).string
    return "".string
}

# activeLabelAt -- the argument label the cursor sits inside: read back from
# `cursor`, the identifier before the nearest ":" at paren depth zero. "" when
# there is none before `floor`.
activeLabelAt: function {s: StringView cursor: u64 floor: u64} out String is {
    k: cursor
    apd: i64
    for k > floor loop {
        ab: byteOr :s i: k - 1 d: 0
        if ab == 41 then apd = apd + 1
        if ab == 40 when apd > 0 then apd = apd - 1
        if ab == 58 when apd == 0 then {
            lab: labelBefore :s colon: k - 1 :floor
            if lab.length > 0 then return lab
        }
        k = k - 1
    }
    return "".string
}

# paramLabelOf -- a parameter display's label: everything before its first ":",
# and the whole display when it holds none.
paramLabelOf: function {disp: StringView.view} outx StringView is {
    ci: u64
    for ci < disp.length loop {
        if (byteIs s: disp i: ci b: 58) then return (disp.substring from: 0 to: ci)
        ci = ci + 1
    }
    return disp
}

# activeParamIndex -- which parameter `label` names, and 0 when none does,
# which is also what an absent label answers.
activeParamIndex: function {pdisps: (List String).view label: StringView} out i64 is {
    if label.length == 0 then return 0
    pi: u64
    for pi < pdisps.length loop {
        pds: pdisps.get i: pi
        if (paramLabelOf disp: pds.stringView) == label then return pi.i64.orPanic
        pi = pi + 1
    }
    return 0
}

# signatureParams -- the SignatureHelp `parameters` array: one object per
# parameter display, labelled with the display itself.
signatureParams: function {pdisps: (List String).view} out Arr is {
    params: newArr
    pi: u64
    for pi < pdisps.length loop {
        pds: pdisps.get i: pi
        pobj: newObj
        pobj.set key: "label".string value: Value.text pds.copy
        params.items.append (Value.object pobj)
        pi = pi + 1
    }
    return params
}

# signatureHelpAnswer -- a mid-typing signature popup. A call being typed often
# fails to parse (a trailing label -> "Expected an Operation after label") and is
# absent from the last-good snapshot tree, so locate the enclosing call by a
# paren-depth-aware backward scan of the live buffer (a call spans lines only
# inside parens; a nested call argument is always parenthesised, so the innermost
# unmatched "(" bounds it), resolve the callee against the snapshot, and render
# its signature with the active parameter (the label nearest the cursor). Returns
# a SignatureHelp object, or null when the cursor is not inside a resolvable call.
signatureHelpAnswer: function {
    snap: zcheck.CheckResult
    docRel: StringView
    docText: StringView
    line0: i64
    ch: i64
    utf32: bool
} out Value is {
    # the unit the signature is shown in, where a core type's bare name is read
    site: docUnitDecl r: snap rel: docRel
    l1: line0 + 1
    l1u: l1.u32.orPanic
    curLt: docLine text: docText lineno: l1u
    cp1: cpColOf lineText: curLt.stringView :ch :utf32
    curByte: byteIdxOfCp s: curLt.stringView :cp1
    head: callHeadAt :docText line: l1u byte: curByte lineText: curLt.stringView
    headLt: docLine text: docText lineno: head.line
    hstv: headLt.stringView
    nm: calleeNameOn s: hstv from: head.byte
    if nm.found.not then return Value.nul
    # the label scan must not reach back into the callee's own name when the
    # head shares the cursor's line
    lowb: u64
    if head.line == l1u then lowb = nm.calleeEnd
    activeLabel: activeLabelAt s: curLt.stringView cursor: curByte floor: lowb
    nmS: hstv.substring from: nm.segStart to: nm.calleeEnd
    segCp: u64
    hsub: hstv.substring from: 0 to: nm.segStart
    segCp = hsub.count
    idCol: segCp.u32.orPanic + 1
    sp: fileSpans prog: snap.prog fsno: (docFsnoOf r: snap rel: docRel)
    leafNid: (leafNidAt
        :sp
        prog: snap.prog
        docFs: (docFsnoOf r: snap rel: docRel)
        line1u: head.line
        :idCol
        name: nmS
    )
    funcId: resolveCalleeFuncId o: snap.st nid: leafNid
    if funcId.isZero then return Value.nul
    label: (fnSigTextOpt
        vfs: snap.vfs
        prog: snap.prog
        o: snap.st
        tid: funcId
        name: nmS
        :site
    )
    if label.length == 0 then return Value.nul
    pdisps: fnParamDisplays prog: snap.prog o: snap.st tid: funcId :site
    activeIdx: activeParamIndex :pdisps label: activeLabel.stringView
    params: signatureParams :pdisps
    siginfo: newObj
    siginfo.set key: "label".string value: Value.text label
    siginfo.set key: "parameters".string value: Value.array params
    siginfo.set key: "activeParameter".string value: Value.intval activeIdx
    sigs: newArr
    sigs.items.append (Value.object siginfo)
    root: newObj
    root.set key: "signatures".string value: Value.array sigs
    root.set key: "activeSignature".string value: Value.intval 0
    root.set key: "activeParameter".string value: Value.intval activeIdx
    return (Value.object root)
}

# completionAnswer -- scope-based completion from the last-good
# snapshot (addScopeCompletions: locals, the unit chain, core, the units that
# could be named, keywords, in that order by `sortText`), filtered by the
# identifier prefix on the LIVE line. A '.' before the prefix is member
# position -> the base's members.
completionAnswer: function {
    snap: zcheck.CheckResult
    # the document's uri, which each item's `data` carries for its resolve
    docUri: StringView
    docRel: StringView
    docText: StringView
    line0: i64
    ch: i64
    utf32: bool
    trig: StringView
    # zls's words, which the trigger character is classified by
    words: zast.Vocab.view
} out Value is {
    arr: newArr
    l1: line0 + 1
    l1u: l1.u32.orPanic
    lt: docLine text: docText lineno: l1u
    ltv: lt.stringView
    cp1: cpColOf lineText: ltv :ch :utf32
    cur: byteIdxOfCp s: ltv :cp1
    # identifier prefix ending at the cursor
    ps: cur
    for ps > 0 loop {
        b: ltv.byteAt i: ps - 1
        match (
            b
        ) case some then {
            if (isIdentByte :b).not then break
        } case none then {
            break
        }
        ps = ps - 1
    }
    cands: MapRV String v: u8
    # each bare-name candidate's group, which its sortText leads with
    rank: MapRV String v: u8
    # the markers a member position allows, offered after the members
    marks: ListVal zast.markerkind
    memberMode: false
    # the base before the `.` in member position, which a resolve re-reads
    memberBase: String
    # member position: a '.' before the prefix -> complete the base's members
    if ps > 0 then {
        pb: ltv.byteAt i: ps - 1
        match (
            pb
        ) case some then {
            if pb == 46 then {
                memberMode = true
                be: ps - 1
                br: memberBaseOf :ltv dot: be
                base: ltv.substring from: br.lo to: br.hi
                memberBase = base.string
                (addMemberCompletions
                    :snap
                    :docRel
                    :l1u
                    :base
                    site: (dotSiteOf :docText line: l1u col: (cpColOfByte s: ltv i: br.lo))
                    sink: cands
                    :marks
                )
            }
        } case none then null
    }
    # an owned copy: the completers below lend the line
    prefix: (ltv.substring from: ps to: cur).string
    if memberMode.not then {
        curPos: zast.nodepos line: l1u col: cp1
        docFs: docFsnoOf r: snap rel: docRel
        handledCA: (caseArmComplete
            :arr
            o: snap.st
            prog: snap.prog
            :ltv
            :ps
            prefix: prefix.stringView
            cursorPos: curPos
            :docFs
        )
        if handledCA then return (Value.array arr)
        handledAL: (argLabelComplete
            :arr
            o: snap.st
            prog: snap.prog
            :ltv
            :ps
            prefix: prefix.stringView
            cursorPos: curPos
            site: (docUnitDecl r: snap rel: docRel)
            :docFs
        )
        if handledAL then return (Value.array arr)
        if (words.slotOf text: trig) == zlsWord.slot.trigSpace then return (Value.array arr)
        addScopeCompletions :snap :docRel :l1u sink: cands :rank
    }

    # each label kept, behind its sortText's group digit when it has one, so
    # the array is in the order sortText gives and a client sorting by either
    # keeps it
    labels: List String
    for each ce: cands.iterateItems loop {
        if ce.key.stringView.startsWith prefix then {
            lk: String
            ro0: rank.get key: ce.key
            match (
                ro0
            ) case some then {
                lk = "\{ro0.u64}"
            } case none then null
            lk.append ce.key
            labels.append lk
        }
    }
    labels.sort
    li: u64
    ln: labels.length
    for li < ln loop {
        lk: labels.get i: li
        # every candidate is ranked or none is; a ranked key leads with a digit
        skip: u64
        if rank.length > 0 then skip = 1
        lb: (lk.stringView.substring from: skip to: lk.length).string
        ko: cands.get key: lb
        kind: 6.u8
        match (
            ko
        ) case some then {
            kind = ko
        } case none then null
        it: newObj
        it.set key: "label".string value: Value.text lb.copy
        it.set key: "kind".string value: Value.intval kind.i64
        # the item's place in the array, zero-padded: a client comparing
        # sortText bytewise or case-blind keeps the array's order either way
        it.set key: "sortText".string value: Value.text (sortKeyAt i: li)
        (it.set
            key: "data".string
            value: (completionData uri: docUri :line0 base: memberBase.stringView)
        )
        arr.items.append (Value.object it)
        li = li + 1
    }
    appendMarkers :arr :marks prefix: prefix.stringView
    return (Value.array arr)
}

# sortKeyAt -- an item's sortText: its index, zero-padded to five digits, so
# the keys order as the numbers do. A marker's `~` key sorts after every one.
sortKeyAt: function {i: u64} out String is {
    digits: "\{i}"
    k: String
    pad: digits.length
    for pad < 5 loop {
        k.append "0"
        pad = pad + 1
    }
    k.append digits
    return k
}

# completionData -- an item's `data`: where its completion was asked, and the
# member base before the `.` ("" for a bare name), which is all a resolve
# needs to find the item again by name in the snapshot it then holds.
completionData: function {uri: StringView line0: i64 base: StringView} out Value is {
    d: newObj
    d.set key: "uri".string value: Value.text uri.string
    d.set key: "line".string value: Value.intval line0
    d.set key: "base".string value: Value.text base.string
    return (Value.object d)
}

# paramsCopy -- a deep copy of a request's `params`: a resolve answers the
# item it was sent
paramsCopy: function {msg: Value.view} out Value is {
    match (
        msg
    ) case object then {
        po: msg.entries.get key: "params".string
        match (
            po
        ) case some then {
            return (valueCopy v: po)
        } case none then null
    } else null
    return Value.nul
}

# valueCopy -- a deep copy of a JSON value
valueCopy: function {v: Value.view} out Value is {
    match (
        v
    ) case nul then {
        return Value.nul
    } case boolean then {
        return (Value.boolean v)
    } case intval then {
        return (Value.intval v)
    } case floatval then {
        return (Value.floatval v)
    } case text then {
        return (Value.text v.copy)
    } case array then {
        a: newArr
        for each x: v.items loop a.items.append (valueCopy v: x)
        return (Value.array a)
    } case object then {
        o: newObj
        for each k: v.keys loop {
            e: v.entries.get key: k
            match (
                e
            ) case some then {
                o.set key: k.copy value: (valueCopy v: e)
            } case none then null
        }
        return (Value.object o)
    }
}

# completionCard -- the hover card of the completion item `label`, completed
# at `line0` after the member base `base` ("" for a bare name): found again by
# name the way the completion found it -- a local, a member of the base, a
# unit-level name the document's unit chain or the prelude reaches, or a unit
# by its file, read without parsing it. Nul when it names nothing now.
completionCard: function {
    snap: zcheck.CheckResult
    docRel: StringView
    line0: i64
    base: StringView
    label: StringView
} out Value is {
    l1u: (line0 + 1).u32.orPanic
    site: docUnitDecl r: snap rel: docRel
    if base.length == 0 then {
        throwaway: MapRV String v: u8
        ds: (enclosingDefStart
            prog: snap.prog
            unitOp: (docUnitOp r: snap rel: docRel)
            :l1u
            sink: throwaway
        )
        lt: baseTypeInScope :snap :docRel defStart: ds :l1u base: label
        # a local reads as hover reads its binding: the name and its type
        if lt.isZero.not then {
            lc: label.string
            lc.append ": "
            lc.append (displayTypeNameOfOpt o: snap.st tid: lt :site)
            return (hoverMarkdown code: lc.stringView doc: "")
        }
    }
    hit: itemHit :snap :docRel :l1u :site :base :label
    if hit.declId.isZero when hit.tid.isZero when hit.unitFsno.isZero then return Value.nul
    sp: Spans.create
    if (declKindIs o: snap.st declId: hit.declId k: ztyping.declkind.fieldDecl) then {
        return (fieldCard :snap :hit :label :site)
    }
    return (navHoverAnswer :snap :sp :hit hname: label.string :site)
}

# fieldCard -- a field as hover reads a use of it: `Owner.name: Type`, its
# trailing comment, and the doc block above it -- never the card of its type
fieldCard: function {
    snap: zcheck.CheckResult
    hit: navhit
    label: StringView
    site: ztypes.declid
} out Value is {
    code: displayTypeNameOfOpt o: snap.st tid: hit.owner :site
    code.append "."
    code.append label
    code.append ": "
    code.append (displayTypeNameOfOpt o: snap.st tid: hit.tid :site)
    doc: String
    dn: declNodeOf o: snap.st declId: hit.declId
    if dn.isZero.not then {
        doc = hoverDoc :snap nid: dn
        appendTrailingDoc :snap nid: dn body: code
    }
    return (hoverMarkdown code: code.stringView doc: doc.stringView)
}

# declKindIs -- whether the declaration `declId` is of kind `k`
declKindIs: function {
    o: (Option zenv.ZSymbolTable).view
    declId: ztypes.declid
    k: ztyping.declkind
} out bool is {
    if declId.isZero then return false
    match (
        o
    ) case some then {
        return (o.typing.decls.get i: declId).kind == k
    } case none then null
    return false
}

# itemHit -- what the completion item `label` names, as a hover hit: a member
# of the base's type, a definition of the unit the base or the unit chain
# reaches, or a unit by its file. Every id zero when it names nothing.
itemHit: function {
    snap: zcheck.CheckResult
    docRel: StringView
    l1u: u32
    site: ztypes.declid
    base: StringView
    label: StringView
} out navhit is {
    hit: (navhit
        idx: 0
        kind: 6
        width: 0
        nodeid: zast.nodeid
        argNode: zast.nodeid
        vid: ztypes.vid
        tid: ztypes.tid
        owner: ztypes.tid
        declId: ztypes.declid
        unitFsno: zvfs.fsno
    )
    nameId: zast.poolFind pool: snap.prog.names text: label
    holder: ztypes.declid
    {
        o: snap.st
        match (
            o
        ) case some then {
            if base.length == 0 then holder = chainUnitHolding st: o :site :nameId
        } case none then {
            return hit
        }
    }
    if base.length == 0 then {
        if holder.isZero then hit.unitFsno = unitFileFsno :snap :docRel name: label
    } else {
        db: resolveDotBase :snap :docRel :l1u :base
        if db.kind.unitBase then {
            holder = unitBaseHolder :snap :site :base :db
        } else if db.tid.isZero.not then {
            hit.owner = db.tid
            o: snap.st
            match (
                o
            ) case some then {
                hit.declId = o.typing.declMemberIdOf parentTypeId: db.tid :nameId
            } case none then null
            hit.tid = childOfIn prog: snap.prog :o parent: db.tid name: label
        }
    }
    if holder.isZero.not then hit = unitDefHit :snap :hit :holder :nameId :label
    return hit
}

# unitDefHit -- `hit` naming the definition `label` of the unit `holder`: a
# subunit by its file, anything else by its declaration and type
unitDefHit: function {
    snap: zcheck.CheckResult
    hit: navhit
    holder: ztypes.declid
    nameId: zast.nameid
    label: StringView
} out navhit is {
    h: hit
    isUnit: false
    {
        o: snap.st
        match (
            o
        ) case some then {
            h.declId = ztypecheck.declOfUnitDefIds st: o unitDecl: holder :nameId
            isUnit = (o.typing.decls.get i: h.declId).kind.unitDecl
        } case none then {
            return h
        }
    }
    if isUnit then {
        h.unitFsno = unitFsnoOfDecl :snap declId: h.declId
    } else {
        h.tid = unitMemberTid :snap :holder declId: h.declId :label
    }
    return h
}

# unitBaseHolder -- the unit a member base names: a path's unit by its type, a
# single head by its file, else the subunit the document's unit reaches
unitBaseHolder: function {
    snap: zcheck.CheckResult
    site: ztypes.declid
    base: StringView
    db: dotbase
} out ztypes.declid is {
    bn: zast.poolFind pool: snap.prog.names text: base
    named: false
    if db.single then named = (unitFsnoByName :snap name: base).isZero.not
    o: snap.st
    match (
        o
    ) case some then {
        if db.single.not then return (o.reg.defOf tid: db.tid)
        if named then return (ztypecheck.unitDeclOfName st: o nameId: bn)
        return (bareDeclIn st: o :site nameId: bn)
    } case none then null
    return ztypes.declid.zero
}

# unitMemberTid -- the type of the unit definition `declId` (named `label` in
# the unit `holder`), resolved now if the check has not. A re-export (core's
# `print: io.print`) keeps its own Decl, whose doc line the card reads, and
# types as its target.
unitMemberTid: function {
    snap: zcheck.CheckResult
    holder: ztypes.declid
    declId: ztypes.declid
    label: StringView
} out ztypes.tid is {
    o: snap.st
    match (
        o
    ) case some then {
        tHolder: holder
        tName: label.string
        if (o.typing.decls.get i: declId).kind.reexportDecl then {
            tgt: reexportTargetDecl prog: snap.prog :o :declId
            if tgt.isZero.not then {
                tHolder = o.typing.declParentOf declId: tgt
                tName = (zast.nameTextAt
                    ast: snap.prog
                    ref: (o.typing.decls.get i: tgt).name
                ).copy
            }
        }
        return (ztypecheck.resolveUnitMemberLate
            st: o
            ast: snap.prog
            unitDecl: tHolder
            name: tName.stringView
        )
    } case none then null
    return ztypes.tid.zero
}

# chainUnitHolding -- the unit declaration that holds the unit-level name
# `nameId` as written in unit `site`: the unit itself or the nearest unit
# enclosing it, else the prelude. 0 when none does.
chainUnitHolding: function {
    st: zenv.ZSymbolTable.view
    site: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return ztypes.declid.zero
    cur: site
    for cur.isZero.not loop {
        if (st.typing.declIsUnitScope declId: cur) when (ztypecheck.declOfUnitDefIds
            :st
            unitDecl: cur
            :nameId
        ).isZero.not then return cur
        cur = st.typing.declParentOf declId: cur
    }
    cr: st.typing.coreUnitRoot
    if cr.isZero.not when (ztypecheck.declOfUnitDefIds :st unitDecl: cr :nameId).isZero.not then {
        return cr
    }
    return ztypes.declid.zero
}

# unitFileFsno -- the file of the unit `name` as completion lists it -- in the
# document unit's own folder, else on the roots -- loaded or not, so its
# header comment can be read without parsing it. 0 when there is none.
unitFileFsno: function {
    snap: zcheck.CheckResult
    docRel: StringView
    name: StringView
} out zvfs.fsno is {
    if (zparser.isValidUnitName :name).not then return zvfs.fsno
    file: "\{name}.z"
    docFs: docFsnoOf r: snap rel: docRel
    if docFs.isZero.not then {
        un: zsource.unitNameOf file: docRel
        own: snap.vfs.siblingDir fileid: docFs name: un.stringView
        hit: snap.vfs.walk parent: own name: file.stringView
        if (snap.vfs.arm dentryid: hit) == zvfs.nodekind.file then return hit
    }
    top: snap.vfs.walk parent: snap.vfs.rootid name: file.stringView
    if (snap.vfs.arm dentryid: top) == zvfs.nodekind.file then return top
    return zvfs.fsno
}

# appendMarkers -- the markers `prefix` opens, as keyword items that sort after
# every member: `~` follows each identifier byte
appendMarkers: function {arr: Arr marks: (ListVal zast.markerkind).view prefix: StringView} is {
    for each mk: marks loop {
        ml: markerLabel k: mk
        if ml.startsWith prefix then {
            mi: newObj
            mi.set key: "label".string value: Value.text ml.string
            mi.set key: "kind".string value: Value.intval 14
            mi.set key: "detail".string value: Value.text (markerDetail k: mk).string
            mi.set key: "sortText".string value: Value.text "~\{ml}"
            arr.items.append (Value.object mi)
        }
    }
}

# cpColOfByte -- the 1-based codepoint column of byte `i` of a line, the
# lexer's column numbering
cpColOfByte: function {s: StringView.view i: u64} out u32 is {
    col: u32
    j: u64
    for j < i loop {
        b: byteOr :s i: j d: 0
        if (b < 128) or (b >= 192) then col = col + 1
        j = j + 1
    }
    return col + 1
}

# ---- main ------------------------------------------------------------

# DEBOUNCE_MS -- interactive recheck coalescing window. A burst of edits
# within this window collapses to one recheck; ~100 ms clears typical
# inter-keystroke gaps while staying under the perception threshold.
DEBOUNCE_MS: 100.i32

# the server loop: read framed requests and dispatch each until shutdown.
serve: function {srv: Server} is {
    for srv.running loop {
        mo: srv.readMessage
        match (
            mo
        ) case some then {
            pr: json.parse source: mo.stringView
            match (
                pr
            ) case ok then {
                srv.handleMessage msg: pr
            } case err then {
                io.eprintln "zls: bad JSON payload"
            }
            if srv.debounce when srv.hasDirty when (srv.inputQuiet millis: DEBOUNCE_MS
            ) then srv.flushDirty
        } case none then {
            if srv.debounce when srv.hasDirty then srv.flushDirty
            srv.running = false
        }
    }
}

# print the zls usage to stderr.
printUsage: function is {
    io.eprintln "usage: zls [--stdio] [--replay <file>] [--listen <port>]"
    io.eprintln "           [--src <dir>] [--system <dir>]"
}


# language-server entry point: dispatch on the transport flag
# (--stdio / --replay / --listen) and serve LSP requests.
main: function is {
    argv: os.args
    n: argv.length
    replay: String
    listenArg: String
    srcFlag: String
    sysFlag: String
    words: zast.Vocab.create block: zlsWord
    i: 1.u64
    for i < n loop {
        arg: argv.get :i
        av: words.slotOf text: arg.stringView
        if (av == zlsWord.slot.fV) or (av == zlsWord.slot.fVersion) then {
            v: zversion.versionLine tool: "zls"
            print "\{v}\n"
            os.exit code: 0
        } else if av == zlsWord.slot.fStdio then null else if av == zlsWord.slot.fReplay then {
            if (i + 1) < n then {
                i = i + 1
                replay = (argv.get :i).copy
            }
        } else if av == zlsWord.slot.fSrc then {
            if (i + 1) < n then {
                i = i + 1
                srcFlag = (argv.get :i).copy
            }
        } else if av == zlsWord.slot.fSystem then {
            if (i + 1) < n then {
                i = i + 1
                sysFlag = (argv.get :i).copy
            }
        } else if av == zlsWord.slot.fListen then {
            if (i + 1) < n then {
                i = i + 1
                listenArg = (argv.get :i).copy
            }
        } else if av == zlsWord.slot.fHelp then {
            printUsage
            os.exit code: 0
        } else {
            io.eprintln "zls: unknown argument"
            printUsage
            os.exit code: 2
        }
        i = i + 1
    }
    ib: Bytes
    srv: (Server
        :words
        docs: (Map String V: Document)
        srcDir: "".string
        srcDirs: List String
        systemDir: "".string
        baseSrcDir: "".string
        baseSystemDir: "".string
        srcExplicit: false
        systemExplicit: false
        layer: zcheck.noLayer
        :srcFlag
        :sysFlag
        encUtf32: false
        initialized: false
        shutdownReq: false
        running: true
        exitCode: 0
        inbuf: ib
        inpos: 0
        transport: Transport.stdio
        debounce: true
        dirty: (MapRV String v: bool)
        snapshots: (Map String V: zcheck.CheckResult)
        docCheck: (Map String V: String)
        snapMain: (Map String V: String)
        projPrograms: List String
        docPrograms: (Map String V: List String)
        entryLayers: (Map String V: zcheck.GenLayer)
        entrySnap: (Map String V: zcheck.CheckResult)
    )
    if listenArg.length > 0 then {
        pr: listenArg.stringView.parseU64
        match (
            pr
        ) case ok then {
            if pr > 65535 then {
                io.eprintln "zls: --listen port out of range (0-65535)"
                os.exit code: 2
            }
            port: pr.u16.orPanic
            lo: net.listen :port
            match (
                lo
            ) case ok then {
                ao: lo.accept
                match (
                    ao
                ) case ok then {
                    srv.transport = Transport.tcp ao
                    serve :srv
                } case err then {
                    io.eprintln "zls: accept failed"
                    os.exit code: 3
                }
            } case err then {
                io.eprintln "zls: listen failed"
                os.exit code: 3
            }
        } case err then {
            io.eprintln "zls: --listen expects a port number"
            os.exit code: 2
        }
    } else if replay.length > 0 then {
        fo: io.open path: replay mode: io.openmode.read
        match (
            fo
        ) case ok then {
            srv.transport = Transport.replay fo
            srv.debounce = false
            serve :srv
        } case err then {
            io.eprintln "zls: cannot open replay file"
            os.exit code: 2
        }
    } else {
        serve :srv
    }
    os.exit code: srv.exitCode
}
