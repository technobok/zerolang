# zls -- the zerolang language server (LSP 3.17 subset). Speaks
# JSON-RPC 2.0 with Content-Length framing over stdio (`--stdio`, the
# default) or a framed input file (`--replay`, the test harness's
# transport; os.spawn cannot pipe a child's stdin while capturing its
# output). Documents sync with full text; every didOpen/didChange runs
# zcheck.check with the open buffers overlaid on disk and publishes
# diagnostics. Positions negotiate utf-32 (matching the compiler's
# codepoint columns) and fall back to utf-16 conversion.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

Value: json.Value
Obj: json.Obj
Arr: json.Arr
Ast: zast.Ast

# Transport -- the byte source/sink the server is framed over. stdio reads
# fd 0 and writes fd 1; replay reads a file and writes fd 1 (the harness
# captures stdout); tcp reads and writes one accepted connection. The Server
# owns this union, so the accepted Conn / open File has exactly one owner and
# both the reader and writer reach it through short-lived borrows.
Transport: union {
    stdio: null
    replay: io.File
    tcp: net.Conn
}

# ---- small builders -------------------------------------------------

# a fresh empty JSON object.
newObj: function out Obj is {
    return (Obj entries: (Map String V: Value) keys: (List String))
}

# a fresh empty JSON array.
newArr: function out Arr is {
    return (Arr items: (List Value))
}

# ---- uri <-> path ---------------------------------------------------

# the value of hex-digit byte `b`, or -1 when not a hex digit.
hexNibble: function {b: u8} out i64 is {
    if b >= 48 when b <= 57 then return (b - 48).i64
    if b >= 97 when b <= 102 then return (b - 87).i64
    if b >= 65 when b <= 70 then return (b - 55).i64
    return -1
}

# uriToPath -- "file:///a/b%20c.z" -> "/a/b c.z". Non-file URIs return "".
uriToPath: function {uri: StringView} out String is {
    if (uri.startsWith "file://") == false then return "".string
    r: String
    i: 7.u64
    n: uri.length
    for i < n loop {
        bo: uri.byteAt :i
        match (
            bo
        ) case some then {
            if bo == 37 when (i + 2) < n then {
                h1: i64
                h2: i64
                b1: uri.byteAt i: i + 1
                match (
                    b1
                ) case some then {
                    h1 = hexNibble b: b1
                } case none then null
                b2: uri.byteAt i: i + 2
                match (
                    b2
                ) case some then {
                    h2 = hexNibble b: b2
                } case none then null
                if h1 >= 0 when h2 >= 0 then {
                    r.appendByte b: ((h1 << 4) | h2).u8.orPanic
                    i = i + 2
                } else {
                    r.appendByte b: bo
                }
            } else {
                r.appendByte b: bo
            }
        } case none then null
        i = i + 1
    }
    return r
}

# pathToUri -- absolute path -> file:// URI (no percent-encoding; the
# workspace paths this serves are plain).
pathToUri: function {path: StringView} out String is {
    r: "file://".string
    r.append path
    return r
}

# relPathOf -- path relative to a provider root ("" when outside it).
relPathOf: function {path: StringView srcDir: StringView} out String is {
    if srcDir.length == 0 then return "".string
    pre: srcDir.string
    pre.append "/"
    pv: pre.stringView
    if path.startsWith pv then return (path.substring from: pre.length to: path.length).string
    return "".string
}

# relPathBest -- the document's path relative to the provider root that OWNS
# it: the most specific of the two, not the first that matches. srcDir and
# systemDir need not be disjoint -- a srcDir of the repo root has lib/system
# nested inside it -- and there srcDir matches a system file first and yields
# `lib/system/io.z`, while the system provider names that same file `io.z`.
# Nothing matches it after that, so every span row for the file is filtered
# out and hover, definition, references and completion all answer null on
# every position, including declarations in the file being edited.
relPathBest: function {
    path: StringView
    srcDir: StringView
    systemDir: StringView
} out String is {
    a: relPathOf :path :srcDir
    b: relPathOf :path srcDir: systemDir
    if a.length == 0 then return b
    if b.length == 0 then return a
    # both roots contain the file, so the deeper one owns it -- and the deeper
    # root is the one that leaves the shorter path behind.
    if b.length < a.length then return b
    return a
}

# ResolvedRoots -- the two directories zls checks against, each with the
# channel that decided it. The path alone cannot say WHY it was chosen, and a
# misconfigured session looks identical to a correct one from the outside: the
# only way to tell a `$ZEROLANG_SYSTEM` pointing at another checkout from the
# auto-detected one is to ask the server which channel it used.
ResolvedRoots: class {
    srcDir: String
    systemDir: String
    srcWhy: String
    systemWhy: String
}

# resolveRoots -- the one workspace-discovery resolution, shared by
# `initialize` and `--print-roots` so the report cannot drift from what the
# server actually checks against. Precedence: CLI flags > initializationOptions
# > rootUri auto-detect (the zerolang repo layout) > cwd.
resolveRoots: function {
    srcFlag: StringView
    sysFlag: StringView
    optSrc: StringView
    optSys: StringView
    rootPath: StringView
} out ResolvedRoots is {
    sd: String
    syd: String
    sw: String
    yw: String
    if srcFlag.length > 0 then {
        sd = srcFlag.string
        sw = "--src flag".string
    }
    if sysFlag.length > 0 then {
        syd = sysFlag.string
        yw = "--system flag".string
    }
    if sd.length == 0 when optSrc.length > 0 then {
        sd = optSrc.string
        sw = "initializationOptions.srcDir".string
    }
    if syd.length == 0 when optSys.length > 0 then {
        syd = optSys.string
        yw = "initializationOptions.systemDir".string
    }
    if sd.length == 0 then {
        if rootPath.length > 0 then {
            candSys: zcheck.joinPath a: rootPath b: "lib/system"
            candSrc: zcheck.joinPath a: rootPath b: "src"
            hasSys: io.exists path: candSys
            hasSrc: io.exists path: candSrc
            if hasSys when hasSrc then {
                sd = candSrc.copy
                sw = "rootUri auto-detect (root holds src/ and lib/system/)".string
                if syd.length == 0 then {
                    syd = candSys.copy
                    yw = "rootUri auto-detect (root holds src/ and lib/system/)".string
                }
            } else {
                sd = rootPath.string
                sw = "rootUri itself (no src/ + lib/system/ pair under it)".string
            }
        } else {
            # the literal "." cannot work: relPathOf tests a "./" prefix
            # against the document's absolute path and never matches, so every
            # document would fall outside every root.
            cw: os.cwd
            match (
                cw
            ) case ok then {
                sd = cw.copy
                sw = "cwd (the client sent no rootUri)".string
            } case err then {
                sd = ".".string
                sw = "cwd unreadable (the client sent no rootUri)".string
            }
        }
    }
    if syd.length == 0 then {
        # resolveSystemDir stays the one resolver; the label below only mirrors
        # the order it already applies, so the report names the channel without
        # a second copy of the path-building.
        syd = zcheck.resolveSystemDir flagVal: ""
        yw = "the lib/system beside the zls executable".string
        rv: os.env key: "ZEROLANG_ROOT"
        match (
            rv
        ) case some then {
            yw = "$ZEROLANG_ROOT/lib/system".string
        } case none then null
        ev: os.env key: "ZEROLANG_SYSTEM"
        match (
            ev
        ) case some then {
            yw = "$ZEROLANG_SYSTEM".string
        } case none then null
    }
    return (ResolvedRoots
        srcDir: sd.take
        systemDir: syd.take
        srcWhy: sw.take
        systemWhy: yw.take
    )
}

# absRelPath -- absolute path for a provider-relative file: the srcDir
# join when it exists on disk, else the systemDir join when that does,
# else the srcDir join (unsaved new files).
absRelPath: function {rel0: StringView srcDir: StringView systemDir: StringView} out String is {
    sj: zcheck.joinPath a: srcDir b: rel0
    if (io.exists path: sj) then return sj
    yj: zcheck.joinPath a: systemDir b: rel0
    if (io.exists path: yj) then return yj
    return sj
}

# ---- position encoding ----------------------------------------------

# encodedCol -- 1-based codepoint column -> 0-based column in the
# negotiated encoding, measured over `lineText`. utf-32 columns equal
# codepoint counts; utf-16 pays one extra unit per astral codepoint.
encodedCol: function {lineText: StringView cpCol1: u32 utf32: bool} out u32 is {
    if cpCol1 == 0 then return 0
    target: (cpCol1 - 1).u64
    if utf32 then return (cpCol1 - 1).u32
    units: u32
    idx: u64
    with cit: lineText.codepoints do for cp: cit loop {
        if idx >= target then break
        if cp >= 65536 then {
            units = units + 2
        } else {
            units = units + 1
        }
        idx = idx + 1
    }
    # columns past the end of the line degrade to the line's width in
    # units plus the shortfall (whitespace-only overhang)
    if idx < target then units = units + (target - idx).u32.orPanic
    return units
}

# ---- transport i/o -------------------------------------------------

# transportRead -- fill `into` with up to 64 KiB from the active transport;
# each arm dispatches the concrete Reader (stdio's fd 0, the replay File, or
# the tcp Conn). Matching the bare `tp` param narrows the arm.
transportRead: function {tp: Transport into: Bytes} out (Result (Box u64) E: IoError) is {
    match (
        tp
    ) case tcp then {
        return (tp.read :into max: 65536)
    } case replay then {
        return (tp.read :into max: 65536)
    } case stdio then {
        r: io.stdin
        return (r.read :into max: 65536)
    }
}

# transportWrite -- write `bv` to the active transport: the tcp Conn, else
# fd 1 (stdio and replay both answer on stdout).
transportWrite: function {tp: Transport bv: ByteView} out (Result (Box u64) E: IoError) is {
    match (
        tp
    ) case tcp then {
        return (tp.write from: bv)
    } else {
        w: io.stdout
        return (w.write from: bv)
    }
}

# transportFd -- the pollable input fd: the tcp socket, else stdin (fd 0).
# replay never polls (a file is always readable), so its fd is unused.
transportFd: function {tp: Transport.view} out i32 is {
    match (
        tp
    ) case tcp then {
        return tp.fd
    } else {
        return 0
    }
}

# ---- json-rpc send -------------------------------------------------
# The send helpers take the transport by argument (not off `this`): a
# caller passes `tp: this.transport`, a leaf disjoint from `this.docs` /
# `this.snapshots`, so sending stays legal while those fields are locked
# (e.g. publishAll sends inside a docs iteration).

# write all of `s` to transport `tp`.
writeAll: function {s: StringView tp: Transport} is {
    b: Bytes
    i: u64
    n: s.length
    for i < n loop {
        bo: s.byteAt :i
        match (
            bo
        ) case some then {
            b.append from: bo
        } case none then null
        i = i + 1
    }
    bv: ByteView.borrow from: b.listView
    wr: transportWrite :tp :bv
    match (
        wr
    ) case ok then null case err then {
        io.eprintln "zls: transport write failed"
    }
}

# frame `body` with a Content-Length header and send it.
frameAndSend: function {body: String tp: Transport} is {
    blen: body.length
    m: "Content-Length: \{blen}"
    m.appendByte b: 13
    m.appendByte b: 10
    m.appendByte b: 13
    m.appendByte b: 10
    m.append body
    writeAll s: m.stringView :tp
}

# send a JSON-RPC success response for request `id`.
sendResult: function {id: Value.take result: Value.take tp: Transport} is {
    o: newObj
    o.set key: "jsonrpc".string value: (Value.text "2.0".string)
    o.set key: "id".string value: id
    o.set key: "result".string value: result
    root: (Value.object o)
    body: json.serialize v: root
    frameAndSend :body :tp
}

# send a JSON-RPC error response for request `id`.
sendError: function {id: Value.take code: i64 message: StringView tp: Transport} is {
    e: newObj
    e.set key: "code".string value: (Value.intval code)
    e.set key: "message".string value: (Value.text message.string)
    o: newObj
    o.set key: "jsonrpc".string value: (Value.text "2.0".string)
    o.set key: "id".string value: id
    o.set key: "error".string value: (Value.object e)
    root: (Value.object o)
    body: json.serialize v: root
    frameAndSend :body :tp
}

# send a JSON-RPC notification.
sendNotification: function {method: StringView params: Value.take tp: Transport} is {
    o: newObj
    o.set key: "jsonrpc".string value: (Value.text "2.0".string)
    o.set key: "method".string value: (Value.text method.string)
    o.set key: "params".string value: params
    root: (Value.object o)
    body: json.serialize v: root
    frameAndSend :body :tp
}

# idValueOf -- the request id as a fresh Value (int, string, or null).
idValueOf: function {msg: Value.view} out Value is {
    f: json.at v: msg path: "id"
    k: f.kind
    match (
        k
    ) case intval then {
        return (Value.intval f.i)
    } case text then {
        return (Value.text f.s.copy)
    } else {
        return Value.nul
    }
}

# ---- header parsing -------------------------------------------------

# the byte count parsed from a `Content-Length:` header line.
parseContentLength: function {line: StringView} out u64 is {
    lower: line.toLowerAscii
    lv: lower.stringView
    if lv.startsWith "content-length:" then {
        rest: lv.substring from: 15 to: lv.length
        t: rest.trim
        pr: t.parseU64
        match (
            pr
        ) case ok then {
            return pr
        } case err then {
            return 0
        }
    }
    return 0
}

# ---- document + server ----------------------------------------------

# one open text document: its uri, version, and current text.
Document: class {
    uri: String
    path: String
    relpath: String
    text: String
    version: i64
}

# the language-server state: open documents, the project dirs, and the check cache.
Server: class {
    docs: (Map String V: Document)
    srcDir: String
    systemDir: String
    srcFlag: String
    sysFlag: String
    encUtf32: bool
    initialized: bool
    shutdownReq: bool
    running: bool
    exitCode: i32
    inbuf: Bytes
    inpos: u64
    transport: Transport
    # true for stdio/tcp (coalesce an edit burst before rechecking); false
    # for replay so every sync message publishes inline (goldens stay stable)
    debounce: bool
    # open-doc uris awaiting a coalesced recheck (interactive mode only)
    dirty: (MapRV String v: bool)
    # last-good check per document uri: navigation answers from these
    # even while the live buffer is broken
    snapshots: (Map String V: zcheck.CheckResult)
} as {
    # ---- framed reader over the BufReader ----

    needByte: function {:this} out (optionval u8) is {
        for this.inpos >= this.inbuf.length loop {
            fresh: Bytes
            this.inbuf = fresh
            this.inpos = 0
            rr: transportRead tp: this.transport into: this.inbuf
            match (
                rr
            ) case ok then {
                if rr == 0 then return (optionval.none u8)
            } case err then {
                return (optionval.none u8)
            }
        }
        b: this.inbuf.get i: this.inpos
        this.inpos = this.inpos + 1
        return (optionval.some b)
    }

    readHeaderLine: function {:this} out (Option String) is {
        line: String
        for true loop {
            bo: this.needByte
            match (
                bo
            ) case some then {
                if bo == 10 then {
                    n: line.length
                    if n > 0 then {
                        lv: line.stringView
                        lb: lv.byteAt i: n - 1
                        match (
                            lb
                        ) case some then {
                            if lb == 13 then {
                                s2: (lv.substring from: 0 to: n - 1).string
                                return (Option.some s2)
                            }
                        } case none then null
                    }
                    return (Option.some line)
                }
                line.appendByte b: bo
            } case none then {
                return (Option.none String)
            }
        }
    }

    readBody: function {:this n: u64} out (Option String) is {
        body: String
        body.reserve :n
        i: u64
        for i < n loop {
            bo: this.needByte
            match (
                bo
            ) case some then {
                body.appendByte b: bo
            } case none then {
                return (Option.none String)
            }
            i = i + 1
        }
        return (Option.some body)
    }

    # readMessage -- one framed JSON-RPC payload; none at end of input.
    readMessage: function {:this} out (Option String) is {
        clen: u64
        for true loop {
            lo: this.readHeaderLine
            match (
                lo
            ) case some then {
                if lo.length == 0 then break
                lv: lo.stringView
                c: parseContentLength line: lv
                if c > 0 then clen = c
            } case none then {
                return (Option.none String)
            }
        }
        if clen == 0 then {
            io.eprintln "zls: message without Content-Length"
            return (Option.none String)
        }
        return (this.readBody n: clen)
    }

    # ---- dispatch ----

    handleMessage: function {:this msg: Value.view} is {
        mo: json.textAt v: msg path: "method"
        hasId: json.hasAt v: msg path: "id"
        match (
            mo
        ) case some then {
            mv: mo.stringView
            if mv == "initialize" then {
                this.handleInitialize :msg
            } else if mv == "initialized" then {
            } else if mv == "shutdown" then {
                this.shutdownReq = true
                idv: idValueOf :msg
                sendResult id: idv result: Value.nul tp: this.transport
            } else if mv == "exit" then {
                this.running = false
                if this.shutdownReq == false then this.exitCode = 1
            } else if mv == "textDocument/didOpen" then {
                this.handleDidOpen :msg
            } else if mv == "textDocument/didChange" then {
                this.handleDidChange :msg
            } else if mv == "textDocument/didClose" then {
                this.handleDidClose :msg
            } else if mv == "textDocument/definition" then {
                this.handleNav :msg mode: 1
            } else if mv == "textDocument/hover" then {
                this.handleNav :msg mode: 2
            } else if mv == "textDocument/references" then {
                this.handleNav :msg mode: 3
            } else if mv == "textDocument/completion" then {
                this.handleNav :msg mode: 4
            } else if mv == "textDocument/signatureHelp" then {
                this.handleNav :msg mode: 5
            } else if mv == "textDocument/formatting" then {
                this.handleFormatting :msg
            } else if mv == "textDocument/documentSymbol" then {
                this.handleDocSymbol :msg
            } else {
                if hasId then {
                    idv2: idValueOf :msg
                    sendError id: idv2 code: -32601 message: "method not found" tp: this.transport
                }
            }
        } case none then {
            io.eprintln "zls: message without method"
        }
    }

    handleInitialize: function {:this msg: Value.view} is {
        # position encoding: utf-32 when the client offers it
        i: u64
        for true loop {
            pth: "params/capabilities/general/positionEncodings/\{i}"
            f: json.at v: msg path: pth.stringView
            k: f.kind
            done: false
            match (
                k
            ) case text then {
                if f.s.stringView == "utf-32" then this.encUtf32 = true
            } else {
                done = true
            }
            if done then break
            i = i + 1
        }
        # workspace discovery: CLI flags > initializationOptions > rootUri
        # auto-detect (zerolang repo layout) > cwd
        rootPath: String
        ro: json.textAt v: msg path: "params/rootUri"
        match (
            ro
        ) case some then {
            rootPath = uriToPath uri: ro.stringView
        } case none then null
        optSrc: String
        io1: json.textAt v: msg path: "params/initializationOptions/srcDir"
        match (
            io1
        ) case some then {
            optSrc = io1.copy
        } case none then null
        optSys: String
        io2: json.textAt v: msg path: "params/initializationOptions/systemDir"
        match (
            io2
        ) case some then {
            optSys = io2.copy
        } case none then null
        rr: (resolveRoots
            srcFlag: this.srcFlag.stringView
            sysFlag: this.sysFlag.stringView
            optSrc: optSrc.stringView
            optSys: optSys.stringView
            rootPath: rootPath.stringView
        )
        # The roots decide whether this server can answer anything at all, and
        # a wrong one looks exactly like a right one from the editor. Say what
        # was resolved and which channel decided it, every session, on STDERR:
        # stdout is the protocol channel, and an editor keeps server stderr in
        # its LSP log (`:LspLog` in nvim).
        io.eprintln "zls: srcDir=\{rr.srcDir} [\{rr.srcWhy}]"
        io.eprintln "zls: systemDir=\{rr.systemDir} [\{rr.systemWhy}]"
        this.srcDir = rr.srcDir.copy
        this.systemDir = rr.systemDir.copy
        # response
        caps: newObj
        caps.set key: "textDocumentSync".string value: (Value.intval 1)
        caps.set key: "definitionProvider".string value: (Value.boolean true)
        caps.set key: "hoverProvider".string value: (Value.boolean true)
        comp: newObj
        ctc: newArr
        ctc.items.append (Value.text ".".string)
        ctc.items.append (Value.text " ".string)
        comp.set key: "triggerCharacters".string value: (Value.array ctc)
        caps.set key: "completionProvider".string value: (Value.object comp)
        sig: newObj
        stc: newArr
        stc.items.append (Value.text ":".string)
        stc.items.append (Value.text " ".string)
        sig.set key: "triggerCharacters".string value: (Value.array stc)
        rtc: newArr
        rtc.items.append (Value.text ":".string)
        rtc.items.append (Value.text " ".string)
        sig.set key: "retriggerCharacters".string value: (Value.array rtc)
        caps.set key: "signatureHelpProvider".string value: (Value.object sig)
        caps.set key: "documentFormattingProvider".string value: (Value.boolean true)
        caps.set key: "referencesProvider".string value: (Value.boolean true)
        caps.set key: "documentSymbolProvider".string value: (Value.boolean true)
        encName: "utf-16"
        if this.encUtf32 then encName = "utf-32"
        caps.set key: "positionEncoding".string value: (Value.text encName.string)
        info: newObj
        info.set key: "name".string value: (Value.text "zls".string)
        info.set key: "version".string value: (Value.text zversion.semver)
        res: newObj
        res.set key: "capabilities".string value: (Value.object caps)
        res.set key: "serverInfo".string value: (Value.object info)
        idv: idValueOf :msg
        resv: (Value.object res)
        sendResult id: idv result: resv tp: this.transport
        this.initialized = true
    }

    # ---- document sync (full text) ----

    handleDidOpen: function {:this msg: Value.view} is {
        uo: json.textAt v: msg path: "params/textDocument/uri"
        to: json.textAt v: msg path: "params/textDocument/text"
        vo: json.intAt v: msg path: "params/textDocument/version"
        ver: i64
        match (
            vo
        ) case some then {
            ver = vo
        } case none then null
        match (
            uo
        ) case some then {
            match (
                to
            ) case some then {
                pth: uriToPath uri: uo.stringView
                rel: (relPathBest
                    path: pth.stringView
                    srcDir: this.srcDir.stringView
                    systemDir: this.systemDir.stringView
                )
                if rel.length == 0 then {
                    # Outside both roots -- every .z file in examples/ or a
                    # scratch directory, whenever srcDir is a project's src/.
                    # An empty relpath kept the buffer out of the overlay AND
                    # made pathMatches reject every row, so the file got lint
                    # squiggles and no compiler diagnostics at all: a clean
                    # compile it never had. Serve it from its own buffer
                    # instead, under the name the parser will look the unit up
                    # by, so the overlay that shadows disk is the one the main
                    # unit resolves to.
                    un9: zsource.unitNameOf path: pth.stringView
                    rel = "\{un9}.z"
                    io.eprintln "zls: \{pth} is outside srcDir and systemDir; serving it from its open buffer"
                }
                d: (Document uri: uo.copy path: pth relpath: rel text: to.copy version: ver)
                key: uo.copy
                this.docs.set :key value: d
                this.syncDoc uri: uo.stringView
            } case none then null
        } case none then null
    }

    handleDidChange: function {:this msg: Value.view} is {
        uo: json.textAt v: msg path: "params/textDocument/uri"
        to: json.textAt v: msg path: "params/contentChanges/0/text"
        vo: json.intAt v: msg path: "params/textDocument/version"
        match (
            uo
        ) case some then {
            match (
                to
            ) case some then {
                rem: this.docs.remove key: uo
                changed: false
                match (
                    rem
                ) case some then {
                    d: rem.take
                    d.text = to.copy
                    match (
                        vo
                    ) case some then {
                        d.version = vo
                    } case none then null
                    key: uo.copy
                    this.docs.set :key value: d
                    changed = true
                } case none then null
                if changed then this.syncDoc uri: uo.stringView
            } case none then null
        } case none then null
    }

    handleDidClose: function {:this msg: Value.view} is {
        uo: json.textAt v: msg path: "params/textDocument/uri"
        match (
            uo
        ) case some then {
            rem: this.docs.remove key: uo
            match (
                rem
            ) case some then null case none then null
            # clear this uri's diagnostics
            empty: newArr
            p: newObj
            p.set key: "uri".string value: (Value.text uo.copy)
            p.set key: "diagnostics".string value: (Value.array empty)
            pv: (Value.object p)
            (sendNotification
                method: "textDocument/publishDiagnostics"
                params: pv
                tp: this.transport
            )
        } case none then null
    }

    # ---- diagnostics ----

    # recomputeFor -- run a full check with all open buffers overlaid,
    # rooted at `uri`'s unit, and publish per-file diagnostics.
    # ---- debounce ----

    syncDoc: function {:this uri: StringView} is {
        if this.debounce then this.markDirty :uri else this.recomputeFor :uri
    }

    markDirty: function {:this uri: StringView} is {
        this.dirty.set key: uri.string value: true
    }

    hasDirty: function {:this} out bool is {
        return (this.dirty.length > 0)
    }

    # flushDirty -- recheck every dirty document, then clear. The dirty uris
    # are copied out first: recomputeFor locks `this`, which would conflict
    # with a live iterator over this.dirty.
    flushDirty: function {:this} is {
        uris: (List String)
        with it: this.dirty.iterateItems do for e: it loop uris.append e.key.copy
        fresh: (MapRV String v: bool)
        this.dirty = fresh
        ui: u64
        for ui < uris.length loop {
            u: uris.get i: ui
            this.recomputeFor uri: u.stringView
            ui = ui + 1
        }
    }

    # inputQuiet -- true when no message is buffered and the input fd stays
    # unreadable for `millis`. A buffered burst reports not-quiet at once.
    inputQuiet: function {:this millis: i32} out bool is {
        if this.inpos < this.inbuf.length then return false
        pr: net.pollReadable fd: (transportFd tp: this.transport) timeoutMillis: millis
        match (
            pr
        ) case ok then {
            if pr then return false
            return true
        } case err then {
            return true
        }
    }

    recomputeFor: function {:this uri: StringView} is {
        if this.initialized == false then return
        ov: (Map String V: String)
        with dit: this.docs.iterateItems do for e: dit loop {
            if e.value.relpath.length > 0 then {
                k: e.value.relpath.copy
                v: e.value.text.copy
                ov.set key: k value: v
            }
        }
        mu: String
        mp: String
        found: false
        {
            dgo: this.docs.get key: uri.asString
            match (
                dgo
            ) case some then {
                mu = zsource.unitNameOf path: dgo.path.stringView
                mp = dgo.path.copy
                found = true
            } case none then null
        }
        if found == false then return
        r: (zcheck.check
            srcdir: this.srcDir.stringView
            systemdir: this.systemDir.stringView
            mainUnit: mu.stringView
            overlays: ov
        )
        rows: (ListVal zcheck.diagrow)
        msgs: (List String)
        zcheck.diagsOf :r :rows :msgs
        this.publishAll :r :rows :msgs mainUnit: mu.stringView mainPath: mp.stringView
        if r.parseOk then {
            ku: uri.string
            this.snapshots.set key: ku value: r
        }
    }

    # publishAll -- one publishDiagnostics per open document: its
    # matching rows (by provider path), or an empty list to clear.
    publishAll: function {
        :this
        r: zcheck.CheckResult
        rows: (ListVal zcheck.diagrow).view
        msgs: (List String)
        mainUnit: StringView
        mainPath: StringView
    } is {
        # resolve each row's provider path once (parallel to rows)
        paths: (List String)
        with rit: rows.iterate do for row: rit loop {
            pp: String
            if row.fsno > 0 then pp = r.vfs.pathfromprovider dentryid: row.fsno
            paths.append pp
        }
        with dit: this.docs.iterateItems do for e: dit loop {
            drel: e.value.relpath
            dfs: zcheck.joinPath a: this.srcDir.stringView b: drel.stringView
            dov: "/".string
            dov.append drel
            durl: e.value.uri.copy
            arr: newArr
            nrows: rows.length
            ri: u64
            for ri < nrows loop {
                pv: paths.get i: ri
                hit: false
                if drel.length > 0 then {
                    if pv.stringView == drel.stringView then hit = true
                    if pv.stringView == dfs.stringView then hit = true
                    if pv.stringView == dov.stringView then hit = true
                }
                if hit then {
                    row: rows.get i: ri
                    m: msgs.get i: ri
                    lineText: String
                    lt: r.vfs.getline dentryid: row.fsno lineno: (row.lineno - 1).u64
                    match (
                        lt
                    ) case some then {
                        lineText = lt.copy
                    } case none then null
                    dv: (diagValue
                        :row
                        msg: m.stringView
                        lineText: lineText.stringView
                        utf32: this.encUtf32
                    )
                    arr.items.append dv
                }
                ri = ri + 1
            }
            if e.value.path.stringView == mainPath then {
                (tcLintInto
                    :arr
                    text: e.value.text.copy
                    relpath: drel.stringView
                    utf32: this.encUtf32
                    prog: r.prog
                    uname: mainUnit
                    sto: r.st
                )
            } else {
                lintInto :arr text: e.value.text.copy relpath: drel.stringView utf32: this.encUtf32
            }
            p: newObj
            p.set key: "uri".string value: (Value.text durl)
            p.set key: "diagnostics".string value: (Value.array arr)
            pv: (Value.object p)
            (sendNotification
                method: "textDocument/publishDiagnostics"
                params: pv
                tp: this.transport
            )
        }
    }

    # ---- formatting ----

    handleFormatting: function {:this msg: Value.view} is {
        idv: idValueOf :msg
        uo: json.textAt v: msg path: "params/textDocument/uri"
        answered: false
        match (
            uo
        ) case some then {
            dtext: String
            drel: String
            found: false
            {
                dgo: this.docs.get key: uo
                match (
                    dgo
                ) case some then {
                    dtext = dgo.text.copy
                    drel = dgo.relpath.copy
                    found = true
                } case none then null
            }
            if found then {
                res: formatAnswer text: dtext.stringView relpath: drel.stringView
                sendResult id: idv result: res tp: this.transport
                answered = true
            }
        } case none then null
        if answered == false then sendResult id: idv result: Value.nul tp: this.transport
    }

    # ---- navigation requests ----

    # handleNav -- definition (mode 1), hover (mode 2), references
    # (mode 3): shared request decode + snapshot lookup.
    handleNav: function {:this msg: Value.view mode: u8} is {
        if this.debounce when this.hasDirty then this.flushDirty
        idv: idValueOf :msg
        uo: json.textAt v: msg path: "params/textDocument/uri"
        lo: json.intAt v: msg path: "params/position/line"
        co: json.intAt v: msg path: "params/position/character"
        line0: -1
        match (
            lo
        ) case some then {
            line0 = lo
        } case none then null
        ch0: -1
        match (
            co
        ) case some then {
            ch0 = co
        } case none then null
        answered: false
        match (
            uo
        ) case some then {
            if line0 >= 0 when ch0 >= 0 then {
                dtext: String
                drel: String
                found: false
                {
                    dgo: this.docs.get key: uo
                    match (
                        dgo
                    ) case some then {
                        dtext = dgo.text.copy
                        drel = dgo.relpath.copy
                        found = true
                    } case none then null
                }
                if found then {
                    sno: this.snapshots.get key: uo
                    match (
                        sno
                    ) case some then {
                        res: Value.nul
                        trigCh: String
                        {
                            tco: json.textAt v: msg path: "params/context/triggerCharacter"
                            match (
                                tco
                            ) case some then {
                                trigCh = tco.copy
                            } case none then null
                        }
                        if mode == 4 then {
                            res = (completionAnswer
                                snap: sno
                                docRel: drel.stringView
                                srcDir: this.srcDir.stringView
                                docText: dtext.stringView
                                :line0
                                ch: ch0
                                utf32: this.encUtf32
                                trig: trigCh.stringView
                            )
                        } else if mode == 5 then {
                            res = (signatureHelpAnswer
                                snap: sno
                                docRel: drel.stringView
                                srcDir: this.srcDir.stringView
                                docText: dtext.stringView
                                :line0
                                ch: ch0
                                utf32: this.encUtf32
                            )
                        } else {
                            res = (navAnswer
                                snap: sno
                                docRel: drel.stringView
                                docUri: uo.stringView
                                srcDir: this.srcDir.stringView
                                systemDir: this.systemDir.stringView
                                docText: dtext.stringView
                                :line0
                                ch: ch0
                                utf32: this.encUtf32
                                :mode
                            )
                        }
                        sendResult id: idv result: res tp: this.transport
                        answered = true
                    } case none then null
                }
            }
        } case none then null
        if answered == false then sendResult id: idv result: Value.nul tp: this.transport
    }

    handleDocSymbol: function {:this msg: Value.view} is {
        if this.debounce when this.hasDirty then this.flushDirty
        idv: idValueOf :msg
        uo: json.textAt v: msg path: "params/textDocument/uri"
        answered: false
        match (
            uo
        ) case some then {
            mu: String
            dtext: String
            found: false
            {
                dgo: this.docs.get key: uo
                match (
                    dgo
                ) case some then {
                    mu = zsource.unitNameOf path: dgo.path.stringView
                    dtext = dgo.text.copy
                    found = true
                } case none then null
            }
            if found then {
                sno: this.snapshots.get key: uo
                match (
                    sno
                ) case some then {
                    res: (symbolsAnswer
                        snap: sno
                        unitName: mu.stringView
                        docText: dtext.stringView
                        utf32: this.encUtf32
                    )
                    sendResult id: idv result: res tp: this.transport
                    answered = true
                } case none then null
            }
        } case none then null
        if answered == false then sendResult id: idv result: Value.nul tp: this.transport
    }
}

# diagValue -- one LSP Diagnostic object from a flattened row.
diagValue: function {
    row: zcheck.diagrow
    msg: StringView
    lineText: StringView
    utf32: bool
} out Value is {
    line0: u32
    if row.lineno > 0 then line0 = row.lineno - 1
    c0: encodedCol :lineText cpCol1: row.colno :utf32
    w: row.width
    if w == 0 then w = 1
    c1: encodedCol :lineText cpCol1: row.colno + w :utf32
    if c1 <= c0 then c1 = c0 + 1
    st: newObj
    st.set key: "line".string value: (Value.intval line0.i64)
    st.set key: "character".string value: (Value.intval c0.i64)
    en: newObj
    en.set key: "line".string value: (Value.intval line0.i64)
    en.set key: "character".string value: (Value.intval c1.i64)
    rg: newObj
    rg.set key: "start".string value: (Value.object st)
    rg.set key: "end".string value: (Value.object en)
    code: codeOf n: row.code
    d: newObj
    d.set key: "range".string value: (Value.object rg)
    d.set key: "severity".string value: (Value.intval 1)
    d.set key: "code".string value: (Value.text code)
    d.set key: "source".string value: (Value.text "zc".string)
    d.set key: "message".string value: (Value.text msg.string)
    return (Value.object d)
}

# codeOf -- "E" + zero-padded-4 error code.
codeOf: function {n: u32} out String is {
    r: "E".string
    if n < 1000 then r.append "0"
    if n < 100 then r.append "0"
    if n < 10 then r.append "0"
    cs: "\{n}"
    r.append cs
    return r
}

# ---- span collection (per-request AST index) ------------------------
# Positions are start-only in the AST; name-bearing leaves get a span
# [colLo, colHi) in 1-based codepoint columns. Row kinds: 1 = bare atom
# use, 2 = member access (nodeid is the DOTTED PATH's id, the
# refDecl member declaration; the name is the child atom's), 3 = binding name.
# `pos` records every node's start for def-target positioning.

# one hit-testable span: a source range mapped to a resolvable reference.
spanrow: record {
    nodeid: u32
    line: u32
    colLo: u32
    colHi: u32
    kind: u8
}

# rangerow -- an enclosing-node span, start..end as line*1048576+col; kind
# 4 = call, 5 = caseexpr. endPos is the last descendant's start (a subtree
# extent good enough to find the node enclosing a cursor).
rangerow: record {
    nodeid: u32
    startPos: u64
    endPos: u64
    kind: u8
}

# the per-file table of hit-testable spans built for goto-def / hover / references.
Spans: class {
    rows: (ListVal spanrow)
    names: (List String)
    pos: (IdMapV u64 v: u64)
    ranges: (ListVal rangerow)
    lastPos: u64
} as {
    note: function {:this id: u32 line: u32 col: u32} is {
        if id > 0 then {
            v: (line.u64 * 1048576) + col.u64
            this.pos.set key: id.u64 value: v
            if v > this.lastPos then this.lastPos = v
        }
    }

    addRow: function {:this id: u32 line: u32 col: u32 name: StringView kind: u8} is {
        w: name.count
        this.rows.append (spanrow nodeid: id :line colLo: col colHi: col + w.u32.orPanic :kind)
        this.names.append name.string
    }

    memberRow: function {:this ast: Ast.view dpid: u32 c: zast.Node.view} is {
        match (
            c
        ) case atomid then {
            cAr: zast.nameTextAt :ast ref: c.name
            this.addRow id: dpid line: c.lineno col: c.colno name: cAr.stringView kind: 2
        } else null
    }

    # innerRangeOfKind -- the innermost recorded range of `kind` whose
    # [startPos, endPos + slack] contains `curPos` (line*1048576+col), or 0.
    innerRangeOfKind: function {t: this.view curPos: u64 kind: u8 slack: u64} out u32 is {
        best: u32
        bestStart: u64
        ri: u64
        for ri < t.ranges.length loop {
            rr: t.ranges.get i: ri
            hit: rr.kind == kind
            if rr.startPos > curPos then hit = false
            if curPos > (rr.endPos + slack) then hit = false
            if hit then {
                shouldTake: false
                if best == 0 then shouldTake = true
                if rr.startPos > bestStart then shouldTake = true
                if shouldTake then {
                    best = rr.nodeid
                    bestStart = rr.startPos
                }
            }
            ri = ri + 1
        }
        return best
    }

    # walkProgram -- root entry: notes the program node, then walks each
    # unit wrapper (the table rides inside the program node).
    walkProgram: function {:this prog: zast.Node.view} is {
        match (
            prog
        ) case program then {
            this.note id: prog.nodeid line: prog.lineno col: prog.colno
            wpi: u64
            wpn: prog.ast.units.length
            for wpi < wpn loop {
                wpid: (zast.nodeid.create from: (prog.ast.units.get i: wpi))
                this.walkAt ast: prog.ast nId: wpid
                wpi = wpi + 1
            }
        } else null
    }

    # walkAt -- the id-taking entry: the row view is this frame's, so a
    # caller can lend the table in the same call.
    walkAt: function {:this ast: Ast.view nId: zast.nodeid} is {
        n: ast.nodes.get i: nId.u64
        this.walk :ast :n
    }

    # walk -- note every node's position in pre-order (the navigation index),
    # add the rows names and members contribute, and bracket calls and matches
    # as ranges; children come from zast.childIds.
    walk: function {:this ast: Ast.view n: zast.Node.view} is {
        if n.placeholder then return
        pos: zast.posOf :n
        nid: zast.nodeIdOf :n
        this.note id: nid line: pos.line col: pos.col
        kids: zast.childIds :ast :n
        match (
            n
        ) case atomid then {
            nAr: zast.nameTextAt :ast ref: n.name
            this.addRow id: n.nodeid line: n.lineno col: n.colno name: nAr.stringView kind: 1
        } case labelvalue then {
            nLb: zast.nameTextAt :ast ref: n.name
            this.addRow id: n.nodeid line: n.lineno col: n.colno name: nLb.stringView kind: 1
        } case dottedpath then {
            # the member selector is a row of its own, not a node walk
            this.walk :ast n: (ast.nodes.get i: n.parent.u64)
            this.memberRow :ast dpid: n.nodeid c: (ast.nodes.get i: n.child.u64)
            return
        } case call then {
            csp: (n.lineno.u64 * 1048576) + n.colno.u64
            this.walkIds :ast ids: kids
            this.ranges.append (rangerow
                nodeid: n.nodeid
                startPos: csp
                endPos: this.lastPos
                kind: 4
            )
            return
        } case caseexpr then {
            xsp: (n.lineno.u64 * 1048576) + n.colno.u64
            this.walkIds :ast ids: kids
            this.ranges.append (rangerow
                nodeid: n.nodeid
                startPos: xsp
                endPos: this.lastPos
                kind: 5
            )
            return
        } case assignment then {
            anmL: zast.poolTextAt pool: ast.names ref: n.name
            this.addRow id: n.nodeid line: n.lineno col: n.colno name: anmL.stringView kind: 3
        } case namedoperation then {
            # the DECLARATION's own name. A definition's name lives on the
            # namedoperation arm that holds it -- FunctionData and
            # ObjectDefData carry none -- and nothing rowed it, so every
            # top-level def, field, method, arm name and parameter answered
            # null while references to them answered fine. A file that is
            # mostly declarations, which every lib/system unit is, therefore
            # read as though navigation were dead. Kind 6 is ranked last in
            # navAnswer so it can only fill an answer, never displace one.
            if (n.name.isZero) == false then {
                nmD: zast.nameTextAt :ast ref: n.name
                # keyed by the OPERATION node, not the arm: the arm carries
                # the name and the position, the operation carries the
                # definition's stamps. Same split memberRow makes.
                this.addRow id: n.operation line: n.lineno col: n.colno name: nmD.stringView kind: 6
            }
        } else null
        this.walkIds :ast ids: kids
    }

    walkIds: function {:this ast: Ast.view ids: (ListVal u32).view} is {
        with it: ids.iterate do for c: it loop this.walk :ast n: (ast.nodes.get i: c.u64)
    }
}


# docLine -- 1-based line `lineno` of `text` (without the newline).
docLine: function {text: StringView lineno: u32} out String is {
    if lineno == 0 then return "".string
    cur: 1.u32
    start: u64
    i: u64
    n: text.length
    for i < n loop {
        b: text.byteAt :i
        match (
            b
        ) case some then {
            if b == 10 then {
                if cur == lineno then return (text.substring from: start to: i).string
                cur = cur + 1
                start = i + 1
            }
        } case none then null
        i = i + 1
    }
    if cur == lineno then return (text.substring from: start to: n).string
    return "".string
}

# ---- navigation resolution ------------------------------------------

# cpColOf -- LSP character (0-based, negotiated encoding) -> 1-based
# codepoint column, measured over the line's text.
cpColOf: function {lineText: StringView ch: i64 utf32: bool} out u32 is {
    if ch < 0 then return 1
    if utf32 then return ch.u32.orPanic + 1
    units: i64
    idx: u32
    with cit: lineText.codepoints do for cp: cit loop {
        if units >= ch then break
        if cp >= 65536 then {
            units = units + 2
        } else {
            units = units + 1
        }
        idx = idx + 1
    }
    return idx + 1
}

# pathMatches -- whether a provider path names the request's document
# (overlay "/rel", plain "rel", or "<srcDir>/rel" forms).
pathMatches: function {pv: StringView rel: StringView srcDir: StringView} out bool is {
    if rel.length == 0 then return false
    if pv == rel then return true
    fs: zcheck.joinPath a: srcDir b: rel
    if pv == fs.stringView then return true
    ov: "/".string
    ov.append rel
    if pv == ov.stringView then return true
    return false
}

# ---- stamp lookups through the snapshot's Option symtab ----

# the variable id referenced at use-site node `nid`, or 0.
useVarId: function {o: (Option zenv.ZSymbolTable).view nid: u64} out ztypes.vid is {
    match (
        o
    ) case some then {
        g: o.typing.atomVariableId.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            return (ztypes.vid.create from: 0)
        }
    } case none then {
        return (ztypes.vid.create from: 0)
    }
}

# the unit-definition type id referenced at node `nid` (the referenced
# declaration's minted tid via refDecl), or 0.
useUnitDef: function {o: (Option zenv.ZSymbolTable).view nid: u64} out u64 is {
    rd: refDeclOf :o :nid
    return (declTypeIdOf :o declId: rd)
}

# the declaration id referenced at node `nid` (typing.refDecl), or 0.
refDeclOf: function {o: (Option zenv.ZSymbolTable).view nid: u64} out ztypes.declid is {
    match (
        o
    ) case some then {
        g: o.typing.refDecl.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            # a reference the compiler resolved for TOOLING only -- a generic
            # parameter's bound, which is a constraint to the compiler and a
            # type name to a reader
            t9: o.typing.toolRefDecl.get key: nid
            match (
                t9
            ) case some then {
                return t9
            } case none then {
                return (ztypes.declid.create from: 0)
            }
        }
    } case none then {
        return (ztypes.declid.create from: 0)
    }
}

# the generic parameter declared or referenced at node `nid`, or 0.
#
# Deliberately NOT reached through refDeclOf. A parameter's declaration shares
# its node id with the `.generic` member row beside it -- Spans keys a
# declaration's row to the node of the thing declared, and for
# `t: anyval.generic` that is the dotted path the member row is keyed to as
# well -- so an answer refDeclOf could see would answer on the word `generic`
# too. navAnswer consults this only when the hit IS a declaration row.
genericParamDeclOf: function {o: (Option zenv.ZSymbolTable).view nid: u64} out ztypes.declid is {
    match (
        o
    ) case some then {
        g: o.typing.genericParamDecl.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            return (ztypes.declid.create from: 0)
        }
    } case none then {
        return (ztypes.declid.create from: 0)
    }
}

# the node that spells a generic parameter's BOUND at node `nid`, or 0. Its own
# declaration is already in toolRefDecl, so the bound's name and doc come from
# the machinery that answers for the bound itself.
genericParamBoundOf: function {o: (Option zenv.ZSymbolTable).view nid: u64} out u64 is {
    match (
        o
    ) case some then {
        g: o.typing.genericParamBound.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            return 0
        }
    } case none then {
        return 0
    }
}

# genericParamCard -- a generic parameter rendered as it was declared,
# `t: anyval.generic`. "" when `nid` does not spell one.
#
# A parameter's Decl carries no type id -- nothing links one -- and its node no
# stamp, so every signature and type-kind fallback hover has answers nothing for
# it. The name it was declared under and the bound beside it are what there is.
genericParamCard: function {
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    nid: u64
} out String is {
    gpd: genericParamDeclOf :o :nid
    if gpd.isZero then return "".string
    # the bound answers through the channel that already resolves it
    bnm: String
    {
        btid: useUnitDef :o nid: (genericParamBoundOf :o :nid)
        if btid > 0 then bnm = displayTypeNameOfOpt :o tid: (ztypes.tid.create from: btid.u64)
    }
    card: String
    match (
        prog
    ) case program then {
        pnm: String
        match (
            o
        ) case some then {
            pnm = declNameText ast: prog.ast st: o declId: gpd
        } case none then null
        if pnm.length == 0 then return "".string
        card.append pnm
        if bnm.length > 0 then {
            card.append ": "
            card.append bnm
            card.append ".generic"
        }
    } else null
    return card
}

# genericParamOwner -- the name of the head that declares the generic parameter
# at `nid`, or "". The parameter's Decl is a child of the template's.
genericParamOwner: function {
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    nid: u64
} out String is {
    gpd: genericParamDeclOf :o :nid
    if gpd.isZero then return "".string
    own: String
    match (
        prog
    ) case program then {
        match (
            o
        ) case some then {
            par: ztypes.declid
            {
                d: o.typing.decls.get i: gpd.u64
                par = d.parent
            }
            if (par.isZero) == false then {
                own = declNameText ast: prog.ast st: o declId: par
            }
        } case none then null
    } else null
    return own
}

# a declaration's defining AST node id, or 0.
declNodeOf: function {o: (Option zenv.ZSymbolTable).view declId: ztypes.declid} out u64 is {
    if declId.isZero then return 0
    match (
        o
    ) case some then {
        g: o.typing.decls.get i: declId.u64
        return g.node.u64
        return 0
    } case none then {
        return 0
    }
}

# a declaration's minted type id, or 0.
declTypeIdOf: function {o: (Option zenv.ZSymbolTable).view declId: ztypes.declid} out u64 is {
    if declId.isZero then return 0
    match (
        o
    ) case some then {
        g: o.typing.decls.get i: declId.u64
        return g.typeId
        return 0
    } case none then {
        return 0
    }
}

# the owner type id of the member referenced at node `nid` (the member
# declaration's parent type via refDecl), or 0.
memberOwnerOf: function {o: (Option zenv.ZSymbolTable).view nid: u64} out u64 is {
    rd: refDeclOf :o :nid
    if rd.isZero then return 0
    par: ztypes.declid
    match (
        o
    ) case some then {
        d: o.typing.decls.get i: rd.u64
        par = d.parent
    } case none then null
    if par.isZero then return (ztypes.declid.create from: 0)
    match (
        o
    ) case some then {
        p: o.typing.decls.get i: par.u64
        if p.kind.typeDecl then return p.typeId
        return 0
        return 0
    } case none then {
        return 0
    }
}

# the variable id defined at node `nid`, or 0.
defVarIdOf: function {o: (Option zenv.ZSymbolTable).view nid: u64} out ztypes.vid is {
    match (
        o
    ) case some then {
        g: o.typing.defVariableId.get key: nid
        match (
            g
        ) case some then {
            return g
        } case none then {
            return (ztypes.vid.create from: 0)
        }
    } case none then {
        return (ztypes.vid.create from: 0)
    }
}

# the type id stamped on node `nid`, or 0.
nodeTypeAt: function {o: (Option zenv.ZSymbolTable).view nid: u64} out u64 is {
    match (
        o
    ) case some then {
        return (ztyping.nodeTypeAt tbl: o.typing.nodeType :nid)
    } case none then {
        return 0
    }
}

# surfaceDeclOfType -- the Decl a reader means by type `tid`, over the LSP's
# optional snapshot. Writing a type's name navigates to core's re-export line,
# so a hit resolved through a TYPE ID has to land in the same place.
surfaceDeclOfType: function {
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    tid: u64
} out ztypes.declid is {
    if tid == 0 then return (ztypes.declid.create from: 0)
    match (
        o
    ) case some then {
        match (
            prog
        ) case program then {
            return (ztypecheck.surfaceDeclOfTypeId
                st: o
                ast: prog.ast
                tid: (ztypes.tid.create from: tid)
            )
        } else null
    } case none then null
    return (ztypes.declid.create from: 0)
}

# literalNote -- what a numeric literal BECOMES, which is the one thing about it
# a reader cannot get from the source. Unpinned it falls to the default type;
# pinned, it already wears the type that pinned it. "" for anything else.
literalNote: function {
    o: (Option zenv.ZSymbolTable).view
    name: StringView
    refTid: u64
    nodeTid: u64
} out String is {
    if (ztypecheck.isNumericLiteralName :name) == false then return "".string
    match (
        o
    ) case some then {
        if refTid == o.reg.literalIntTid then return "falls to `i64` here".string
        if refTid == o.reg.literalFloatTid then return "falls to `f64` here".string
        if nodeTid > 0 then {
            tn: displayTypeNameSt st: o tid: (ztypes.tid.create from: nodeTid.u64)
            if tn.length > 0 then {
                kind: "an integer literal"
                if (ztypecheck.isFloatLiteralName :name) then kind = "a float literal"
                note: "\{kind} pinned to `\{tn}` here"
                return note
            }
        }
    } case none then null
    return "".string
}

# varDefNode -- the binding node that declared variable `vid`.
varDefNode: function {o: (Option zenv.ZSymbolTable).view vid: ztypes.vid} out u64 is {
    match (
        o
    ) case some then {
        with it: o.typing.defVariableId.iterateItems do for e: it loop {
            if e.value == vid then return e.key
        }
        return 0
    } case none then {
        return 0
    }
}

# displayTypeNameSt -- reg.nameOf, but a source type renders "<unit>.<name>"
# UNLESS it is declared in a core-language unit (system/core/collections) or has
# no source unit -- those stay bare. So String/List/Map stay bare while io/os/cli/
# net and other stdlib units render dotted (io.File, cli.OptionDef). A generic mono
# keys the unit test on its ORIGIN's declaring unit while displaying the full
# instance name (e.g. "List u64" stays bare -- List is declared in collections).
displayTypeNameSt: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out String is {
    disp: st.reg.nameOf tid: (ztypes.tid.create from: tid.u64)
    if disp.length == 0 then return disp
    base: tid
    {
        go: st.reg.genericOriginOf tid: (ztypes.tid.create from: tid.u64)
        if go > 0 then base = go
    }
    bname: String
    {
        name9v: st.reg.nameOf tid: (ztypes.tid.create from: base.u64)
            bname = name9v
    }
    if bname.length == 0 then return disp
    unitName: (ztypecheck.unitNameOfTid
        :st
        tid: (ztypes.tid.create from: base.u64)
)
    if unitName.length == 0 then return disp
    uv: unitName.stringView
    if uv == "system" then return disp
    if uv == "core" then return disp
    if uv == "collections" then return disp
    return "\{uv}.\{disp.stringView}"
}

# the hover display name of type `tid` (unit-qualified outside core/system).
displayTypeNameOfOpt: function {o: (Option zenv.ZSymbolTable).view tid: ztypes.tid} out String is {
    match (
        o
    ) case some then {
        return (displayTypeNameSt st: o :tid)
    } case none then {
        return "".string
    }
}

# typeKindTextOpt -- a type definition's kind word ("class", "variant", ...)
# for hover, or "" when tid is 0 or names something other than a type def.
typeKindTextOpt: function {o: (Option zenv.ZSymbolTable).view tid: ztypes.tid} out String is {
    result: String
    if tid.isZero then return result
    match (
        o
    ) case some then {
        tt: o.reg.typetypeOf typeId: (ztypes.tid.create from: tid.u64)
        match (
            tt
        ) case classType then {
            result = "class".string
        } case recordType then {
            result = "record".string
        } case variantType then {
            result = "variant".string
        } case unionType then {
            result = "union".string
        } case facetType then {
            result = "facet".string
        } case protocolType then {
            result = "protocol".string
        } else null
    } case none then null
    return result
}

# declNameText -- the name a declaration was declared under, or "".
declNameText: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    declId: ztypes.declid
} out String is {
    if declId.isZero then return "".string
    nm: u32
    {
        decl: st.typing.decls.get i: declId.u64
        nm = decl.name
    }
    if nm == 0 then return "".string
    return (zast.poolTextCopy pool: ast.names ref: (zast.nameid.create from: nm.u32))
}

# defaultDisplay -- a defaulted param's recorded default rendered with its
# resolved type: a literal re-renders from its expression node as `v.<type>`
# (int) or `(v).<type>` (float); a function default is the target's bare name;
# an arm default is `<type>.<arm>`. "" when the param has no default.
defaultDisplay: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    dv: ztyping.defaultval
    typeName: StringView
} out String is {
    {
        df: dv
        if df.func then return (declNameText :ast :st declId: df)
    }
    {
        da: dv
        if da.arm then {
            arm: declNameText :ast :st declId: da
            if arm.length == 0 then return "".string
            r: typeName.string
            r.appendByte b: 46
            r.append arm
            return r
        }
    }
    dtextOwn: String
    {
        dl: dv
        if dl.literal then {
            if dl == 0 then return "".string
            dtextOwn = ztypecheck.rootNameOf :ast n: (ast.nodes.get i: dl.u64)
        }
    }
    dtext: dtextOwn.stringView
    if dtext.length == 0 then return "".string
    isFloat: false
    if typeName == "f64" then isFloat = true
    if typeName == "f32" then isFloat = true
    if typeName == "f16" then isFloat = true
    if typeName == "f128" then isFloat = true
    rr: String
    if isFloat then {
        rr.appendByte b: 40
        rr.append dtext
        rr.appendByte b: 41
        rr.appendByte b: 46
        rr.append typeName
    } else {
        rr.append dtext
        rr.appendByte b: 46
        rr.append typeName
    }
    return rr
}

# paramDocs -- map of parameter name -> its trailing `#` doc comment, read from
# the function's declaration source. Resolves the function tid to its
# functiondef node (via the namedoperation wrapper), then reads each parameter
# node's line; only a parameter that is the last on its source line takes that
# line's trailing comment. Empty when the function has no documented parameters.
paramDocs: function {
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    vfs: zvfs.ZVfs
    tid: ztypes.tid
} out (Map String V: String) is {
    result: (Map String V: String)
    defNid: defNodeInfo :o :prog :tid member: ""
    if defNid == 0 then return result
    fnNid: u32
    {
        match (
            prog
        ) case program then {
            wn: prog.ast.nodes.get i: defNid.u64
            match (
                wn
            ) case namedoperation then {
                fnNid = wn.operation
            } else null
        } else null
    }
    if fnNid == 0 then return result
    fsno: zvfs.fsno
    {
        match (
            prog
        ) case program then {
            fsno = prog.ast.fsnoForNode nodeid: fnNid
        } else null
    }
    if fsno.u64 == 0 then return result
    paramIds: (ListVal u32)
    {
        match (
            prog
        ) case program then {
            fd: prog.ast.nodes.get i: fnNid.u64
            match (
                fd
            ) case functiondef then {
                with pit: fd.parameters.iterate do for pid: pit loop paramIds.append pid
            } else null
        } else null
    }
    pnms: (List String)
    plns: (ListVal u32)
    pk: u64
    for pk < paramIds.length loop {
        pid: paramIds.get i: pk
        nameRef: u32
        ln: u32
        {
            match (
                prog
            ) case program then {
                pnode: prog.ast.nodes.get i: pid.u64
                match (
                    pnode
                ) case namedoperation then {
                    nameRef = pnode.name
                    ln = pnode.lineno
                } else null
            } else null
        }
        if nameRef > 0 then {
            match (
                prog
            ) case program then {
                nm: zast.nameTextCopy ast: prog.ast ref: (zast.nameid.create from: nameRef.u32)
                pnms.append nm
                plns.append ln
            } else null
        }
        pk = pk + 1
    }
    ci: u64
    cn: pnms.length
    for ci < cn loop {
        lastOnLine: true
        nxt: ci + 1
        if nxt < cn then {
            thisLn: plns.get i: ci
            nextLn: plns.get i: nxt
            if nextLn == thisLn then lastOnLine = false
        }
        if lastOnLine then {
            curLn: plns.get i: ci
            tcm: trailingDocOf :vfs :fsno line1: curLn
            if tcm.length > 0 then {
                kk: (pnms.get i: ci).copy
                result.set key: kk value: tcm
            }
        }
        ci = ci + 1
    }
    return result
}

# paramStartsLine -- true when the source line `line1` (1-based) of file `fsno`,
# leading whitespace removed, begins with `name` -- the parameter starts its own
# line rather than sharing the function-head line with the name.
paramStartsLine: function {vfs: zvfs.ZVfs fsno: zvfs.fsno line1: u32 name: StringView} out bool is {
    result: false
    if line1 == 0 then return result
    lg: vfs.getline dentryid: fsno lineno: (line1 - 1).u64
    match (
        lg
    ) case some then {
        lv: lg.stringView
        tl: lv.trimStart
        if tl.startsWith name then result = true
    } case none then null
    return result
}

# paramLeadDocs -- map of parameter name -> the contiguous `#` doc block on the
# lines directly above the parameter's declaration, read from source. A block is
# taken only for a parameter that starts its own source line; a parameter sharing
# the function-head line or a preceding parameter's line has no line of its own
# above it. Empty when no parameter carries a leading block.
paramLeadDocs: function {
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    vfs: zvfs.ZVfs
    tid: ztypes.tid
} out (Map String V: String) is {
    result: (Map String V: String)
    defNid: defNodeInfo :o :prog :tid member: ""
    if defNid == 0 then return result
    fnNid: u32
    {
        match (
            prog
        ) case program then {
            wn: prog.ast.nodes.get i: defNid.u64
            match (
                wn
            ) case namedoperation then {
                fnNid = wn.operation
            } else null
        } else null
    }
    if fnNid == 0 then return result
    fsno: zvfs.fsno
    {
        match (
            prog
        ) case program then {
            fsno = prog.ast.fsnoForNode nodeid: fnNid
        } else null
    }
    if fsno.u64 == 0 then return result
    paramIds: (ListVal u32)
    {
        match (
            prog
        ) case program then {
            fd: prog.ast.nodes.get i: fnNid.u64
            match (
                fd
            ) case functiondef then {
                with pit: fd.parameters.iterate do for pid: pit loop paramIds.append pid
            } else null
        } else null
    }
    pnms: (List String)
    plns: (ListVal u32)
    pk: u64
    for pk < paramIds.length loop {
        pid: paramIds.get i: pk
        nameRef: u32
        ln: u32
        {
            match (
                prog
            ) case program then {
                pnode: prog.ast.nodes.get i: pid.u64
                match (
                    pnode
                ) case namedoperation then {
                    nameRef = pnode.name
                    ln = pnode.lineno
                } else null
            } else null
        }
        if nameRef > 0 then {
            match (
                prog
            ) case program then {
                nm: zast.nameTextCopy ast: prog.ast ref: (zast.nameid.create from: nameRef.u32)
                pnms.append nm
                plns.append ln
            } else null
        }
        pk = pk + 1
    }
    ci: u64
    cn: pnms.length
    for ci < cn loop {
        firstOnLine: true
        if ci > 0 then {
            thisLn: plns.get i: ci
            prevLn: plns.get i: (ci - 1)
            if prevLn == thisLn then firstOnLine = false
        }
        if firstOnLine then {
            curLn: plns.get i: ci
            startsOwn: (paramStartsLine
                :vfs
                :fsno
                line1: curLn
                name: (pnms.get i: ci).stringView
            )
            if startsOwn then {
                blk: docBlockAboveOf :vfs :fsno line1: curLn
                if blk.length > 0 then {
                    kk: (pnms.get i: ci).copy
                    result.set key: kk value: blk
                }
            }
        }
        ci = ci + 1
    }
    return result
}

# fnSigTextOpt -- a function type's readable signature "name: function {p:
# T ...} out Ret", the receiver skipped; "" when the type is not a function.
fnSigTextOpt: function {
    vfs: zvfs.ZVfs
    prog: zast.Node.view
    o: (Option zenv.ZSymbolTable).view
    tid: ztypes.tid
    name: StringView
} out String is {
    docs: paramDocs :o :prog :vfs :tid
    leads: paramLeadDocs :o :prog :vfs :tid
    match (
        o
    ) case some then {
        isFn: false
        if (o.reg.typetypeOf typeId: (ztypes.tid.create from: tid.u64)) == ztypes.ztypetype.functionType then isFn = true
        if (isFn) == false then return "".string
        # the declared parameters, skipping the receiver; type names resolve
        # afterwards (the name read takes a lock on `o`)
        pnames: (List String)
        ptids: (ListVal u64)
        pnids: (ListVal u64)
        match (
            prog
        ) case program then {
            userParams :prog :o :tid names: pnames tids: ptids nameIds: pnids
        } else null
        # render each param display string once the member list is collected:
        # resolving a member declaration locks `o` exclusively. A defaulted
        # param shows its value; else its type + ownership.
        pdisp: (List String)
        pi: u64
        for pi < pnames.length loop {
            pt: ptids.get i: pi
            dv: (o.typing.declDefaultOfId
                parentTypeId: (ztypes.tid.create from: tid.u64)
                nameId: (zast.nameid.create from: (pnids.get i: pi).u32.orPanic)
            )
            hasDef: (dv.none) == false
            ptn: displayTypeNameSt st: o tid: (ztypes.tid.create from: pt.u64)
            ps: (pnames.get i: pi).copy
            ps.append ": "
            if hasDef then {
                dd: String
                match (
                    prog
                ) case program then {
                    dd = (defaultDisplay
                        ast: prog.ast
                        st: o
                        :dv
                        typeName: ptn.stringView
                    )
                } else null
                if dd.length > 0 then {
                    ps.append dd
                } else {
                    ps.append ptn
                }
            } else {
                ps.append ptn
                oo: (o.typing.declOwnershipOfId
                    parentTypeId: (ztypes.tid.create from: tid.u64)
                    nameId: (zast.nameid.create from: (pnids.get i: pi).u32.orPanic)
                )
                match (
                    oo
                ) case some then {
                    if oo == ztypes.zparamownership.takeMode then ps.append ".take"
                    if oo == ztypes.zparamownership.borrowMode then ps.append ".borrow"
                    if oo == ztypes.zparamownership.viewMode then ps.append ".view"
                    if oo == ztypes.zparamownership.holdMode then ps.append ".hold"
                    if oo == ztypes.zparamownership.takexMode then ps.append ".takex"
                } case none then null
            }
            pdisp.append ps
            pi = pi + 1
        }
        rets: String
        rr: ztypecheck.methodReturnOf st: o mid: (ztypes.tid.create from: tid.u64)
        rtid: ztypecheck.optTidOr o: rr d: ztypes.tid
        if rtid > 0 then {
            rtn: displayTypeNameSt st: o tid: rtid
            rets.append " out "
            rets.append rtn
            rb: o.typing.funcReturnsBorrow.get key: tid
            match (
                rb
            ) case some then {
                if rb then rets.append ".borrow"
            } case none then null
        }
        # one line, or param-per-line (zl fmt >100-col style) when too long.
        pdocs: (List String)
        pleads: (List String)
        hasDocs: false
        pdi: u64
        for pdi < pnames.length loop {
            pdc: String
            plc: String
            {
                pn0: pnames.get i: pdi
                dgot: docs.get key: pn0
                match (
                    dgot
                ) case some then {
                    pdc = dgot.copy
                } case none then null
                lgot: leads.get key: pn0
                match (
                    lgot
                ) case some then {
                    plc = lgot.copy
                } case none then null
            }
            if pdc.length > 0 then hasDocs = true
            if plc.length > 0 then hasDocs = true
            pdocs.append pdc
            pleads.append plc
            pdi = pdi + 1
        }
        one: name.string
        one.append ": function"
        if pdisp.length > 0 then {
            one.append " {"
            oi: u64
            for oi < pdisp.length loop {
                if oi > 0 then one.append " "
                one.append (pdisp.get i: oi)
                oi = oi + 1
            }
            one.append "}"
        }
        one.append rets
        if one.length <= 100 when hasDocs == false then return one
        if pdisp.length == 0 then return one
        wrap: name.string
        wrap.append ": function {"
        wi: u64
        for wi < pdisp.length loop {
            wlb: pleads.get i: wi
            if wlb.length > 0 then {
                wlv: wlb.stringView
                wrap.appendByte b: 10
                wrap.append "    # "
                wbj: u64
                for wbj < wlv.length loop {
                    wcb: wlv.byteAt i: wbj
                    match (
                        wcb
                    ) case some then {
                        if wcb == 10 then {
                            wrap.appendByte b: 10
                            wrap.append "    # "
                        } else {
                            wrap.appendByte b: wcb
                        }
                    } case none then null
                    wbj = wbj + 1
                }
            }
            wrap.appendByte b: 10
            wrap.append "    "
            wrap.append (pdisp.get i: wi)
            wpdc: pdocs.get i: wi
            if wpdc.length > 0 then {
                wrap.append "  # "
                wrap.append wpdc
            }
            wi = wi + 1
        }
        wrap.appendByte b: 10
        wrap.append "}"
        wrap.append rets
        return wrap
    } case none then {
        return "".string
    }
}

# fnParamDisplays -- the per-parameter display strings for a function tid
# (receiver skipped): each "name: <type>[.take/.lock]" or "name: <default>",
# mirroring fnSigTextOpt's param rendering. Raw material for signatureHelp
# parameters.
fnParamDisplays: function {
    prog: zast.Node.view
    o: (Option zenv.ZSymbolTable).view
    tid: ztypes.tid
} out (List String) is {
    result: (List String)
    match (
        o
    ) case some then {
        pnames: (List String)
        ptids: (ListVal u64)
        pnids: (ListVal u64)
        match (
            prog
        ) case program then {
            userParams :prog :o :tid names: pnames tids: ptids nameIds: pnids
        } else null
        pi: u64
        for pi < pnames.length loop {
            pt: ptids.get i: pi
            dv: (o.typing.declDefaultOfId
                parentTypeId: (ztypes.tid.create from: tid.u64)
                nameId: (zast.nameid.create from: (pnids.get i: pi).u32.orPanic)
            )
            hasDef: (dv.none) == false
            ptn: displayTypeNameSt st: o tid: (ztypes.tid.create from: pt.u64)
            ps: (pnames.get i: pi).copy
            ps.append ": "
            if hasDef then {
                dd: String
                match (
                    prog
                ) case program then {
                    dd = (defaultDisplay
                        ast: prog.ast
                        st: o
                        :dv
                        typeName: ptn.stringView
                    )
                } else null
                if dd.length > 0 then {
                    ps.append dd
                } else {
                    ps.append ptn
                }
            } else {
                ps.append ptn
                oo: (o.typing.declOwnershipOfId
                    parentTypeId: (ztypes.tid.create from: tid.u64)
                    nameId: (zast.nameid.create from: (pnids.get i: pi).u32.orPanic)
                )
                match (
                    oo
                ) case some then {
                    if oo == ztypes.zparamownership.takeMode then ps.append ".take"
                    if oo == ztypes.zparamownership.borrowMode then ps.append ".borrow"
                    if oo == ztypes.zparamownership.viewMode then ps.append ".view"
                    if oo == ztypes.zparamownership.holdMode then ps.append ".hold"
                    if oo == ztypes.zparamownership.takexMode then ps.append ".takex"
                } case none then null
            }
            result.append ps
            pi = pi + 1
        }
    } case none then null
    return result
}

# hoverMarkdown -- a hover result: `code` rendered as a fenced ```zerolang
# block (highlighted like source), then an optional doc block as markdown
# prose. `code` may be multi-line (a hand-wrapped signature).
hoverMarkdown: function {code: StringView doc: StringView} out Value is {
    v: String
    v.appendByte b: 96
    v.appendByte b: 96
    v.appendByte b: 96
    v.append "zerolang"
    v.appendByte b: 10
    v.append code
    v.appendByte b: 10
    v.appendByte b: 96
    v.appendByte b: 96
    v.appendByte b: 96
    if doc.length > 0 then {
        v.appendByte b: 10
        v.appendByte b: 10
        v.append doc
    }
    mk: newObj
    mk.set key: "kind".string value: (Value.text "markdown".string)
    mk.set key: "value".string value: (Value.text v)
    ho: newObj
    ho.set key: "contents".string value: (Value.object mk)
    return (Value.object ho)
}

# ---- def-node navigation (unit/body indexes into the program AST) ----

# defNodeInfo -- the target nodeid for a top-level def (member == "")
# or a named member inside it. Mono tids chase their generic origin.
defNodeInfo: function {
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    tid: ztypes.tid
    member: StringView
} out u64 is {
    did: ztypes.declid
    match (
        o
    ) case some then {
        did = ztypecheck.declOfTypeId st: o tid: (ztypes.tid.create from: tid.u64)
    } case none then null
    if did.isZero then return 0
    if member.length == 0 then return (declNodeOf :o declId: did)
    match (
        prog
    ) case program then {
        mnid: zast.poolFind pool: prog.ast.names text: member
        if mnid.isZero then return 0
        mdid: ztypes.declid
        match (
            o
        ) case some then {
            mdid = o.typing.declFindChild parentDeclId: did nameId: mnid
        } case none then null
        return (declNodeOf :o declId: mdid)
    } else null
    return 0
}

# locationValue -- an LSP Location for a target node ({} miss -> nul).
locationValue: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    nid: u64
    width: u32
    docRel: StringView
    docUri: StringView
    srcDir: StringView
    systemDir: StringView
    docText: StringView
    utf32: bool
} out Value is {
    pg: sp.pos.get key: nid
    match (
        pg
    ) case some then {
        line: (pg / 1048576).u32.orPanic
        col: (pg % 1048576).u32.orPanic
        if line == 0 then return Value.nul
        fs: zcheck.fsnoFor r: snap nodeid: nid.u32.orPanic
        if fs.u64 == 0 then return Value.nul
        pp: snap.vfs.pathfromprovider dentryid: fs
        own: pathMatches pv: pp.stringView rel: docRel :srcDir
        uri: String
        lineText: String
        if own then {
            uri = docUri.string
            lineText = docLine text: docText lineno: line
        } else {
            absp: snap.vfs.pathfromproviderNative dentryid: fs
            if absp.length == 0 then {
                st0: u64
                if pp.startsWith "/" then st0 = 1
                rel0: pp.substring from: st0 to: pp.length
                absp = absRelPath :rel0 :srcDir :systemDir
            }
            uri = pathToUri path: absp.stringView
            lg: snap.vfs.getline dentryid: fs lineno: (line - 1).u64
            match (
                lg
            ) case some then {
                lineText = lg.copy
            } case none then null
        }
        w: width
        if w == 0 then w = 1
        c0: encodedCol lineText: lineText.stringView cpCol1: col :utf32
        c1: encodedCol lineText: lineText.stringView cpCol1: col + w :utf32
        if c1 <= c0 then c1 = c0 + 1
        st: newObj
        st.set key: "line".string value: (Value.intval (line - 1).i64)
        st.set key: "character".string value: (Value.intval c0.i64)
        en: newObj
        en.set key: "line".string value: (Value.intval (line - 1).i64)
        en.set key: "character".string value: (Value.intval c1.i64)
        rg: newObj
        rg.set key: "start".string value: (Value.object st)
        rg.set key: "end".string value: (Value.object en)
        lo: newObj
        lo.set key: "uri".string value: (Value.text uri)
        lo.set key: "range".string value: (Value.object rg)
        return (Value.object lo)
    } case none then {
        return Value.nul
    }
}

# defNodeOf -- the def-node id a resolved hit points at: a variable binding
# (refVid), a type/function def (refTid), or an owner's member (refOwner +
# member name); 0 when unresolved.
defNodeOf: function {
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    refVid: ztypes.vid
    refTid: u64
    refOwner: u64
    member: StringView
} out u64 is {
    if (refVid.isZero) == false then return (varDefNode :o vid: refVid)
    if refTid > 0 then return (defNodeInfo
        :o
        :prog
        tid: (ztypes.tid.create from: refTid.u64)
        member: ""
    )
    if refOwner > 0 then return (defNodeInfo
        :o
        :prog
        tid: (ztypes.tid.create from: refOwner.u64)
        :member
    )
    return 0
}

# trailingDocOf -- the text of a trailing `#` comment on `line1` (1-based) of
# file `fsno`, the `#` and surrounding space stripped; "" when there is none.
# Surfaces a field's or parameter's inline doc in hover.
trailingDocOf: function {vfs: zvfs.ZVfs fsno: zvfs.fsno line1: u32} out String is {
    result: String
    if line1 == 0 then return result
    lg: vfs.getline dentryid: fsno lineno: (line1 - 1).u64
    match (
        lg
    ) case some then {
        lv: lg.stringView
        n: lv.length
        inStr: false
        hashAt: u64
        found: false
        i: u64
        for i < n loop {
            b: lv.byteAt :i
            match (
                b
            ) case some then {
                if b == 34 then inStr = (inStr == false)
                if b == 35 when inStr == false when found == false then {
                    hashAt = i
                    found = true
                }
            } case none then null
            if found then break
            i = i + 1
        }
        if found then {
            after: lv.substring from: (hashAt + 1) to: n
            trimmed: after.trim
            result = trimmed.string
        }
    } case none then null
    return result
}

# docBlockAboveOf -- the contiguous `#` comment block immediately above `line1`
# (1-based) in file `fsno`, each line stripped of its leading "# " and joined
# top-to-bottom by newlines; "" when there is none. Reads through the vfs.
docBlockAboveOf: function {vfs: zvfs.ZVfs fsno: zvfs.fsno line1: u32} out String is {
    if line1 <= 1 then return "".string
    acc: (List String)
    k: line1
    for k > 1 loop {
        k = k - 1
        lg: vfs.getline dentryid: fsno lineno: (k - 1).u64
        stop: false
        match (
            lg
        ) case some then {
            lv: lg.stringView
            tl: lv.trimStart
            if tl.startsWith "#" then {
                st: 1.u64
                sb: tl.byteAt i: 1
                match (
                    sb
                ) case some then {
                    if sb == 32 then st = 2
                } case none then null
                ds: tl.substring from: st to: tl.length
                acc.append ds.string
            } else {
                stop = true
            }
        } case none then {
            stop = true
        }
        if stop then break
    }
    result: String
    ai: acc.length
    for ai > 0 loop {
        ai = ai - 1
        if result.length > 0 then result.appendByte b: 10
        dl: acc.get i: ai
        result.append dl
    }
    return result
}

# docCommentForNode -- the contiguous `#` comment block immediately above the
# definition at `defLine` (1-based) in file `fsno`; "" when there is none.
# Reads through the vfs, so a definition in another unit works too.
docCommentForNode: function {snap: zcheck.CheckResult fsno: zvfs.fsno defLine: u32} out String is {
    r: docBlockAboveOf vfs: snap.vfs :fsno line1: defLine
    return r
}

# unitFsnoByName -- the vfs dentry id of the file for the unit named
# `name`, or 0 when no such unit file exists.
unitFsnoByName: function {snap: zcheck.CheckResult name: StringView} out zvfs.fsno is {
    ids: (ListVal zvfs.fsno)
    paths: (List String)
    snap.vfs.fileTable outIds: ids outPaths: paths
    result: zvfs.fsno
    i: u64
    n: ids.length
    for i < n loop {
        pth: paths.get :i
        un: zsource.unitNameOf path: pth.stringView
        if un.stringView == name then result = ids.get :i
        i = i + 1
    }
    return result
}

# unitGenericParamsOf -- a unitdef's generic parameters rendered " {T U}"
# (its `T: base.generic` body declarations); "" when it has none.
unitGenericParamsOf: function {ast: Ast.view udId: u32} out String is {
    ud: ast.nodes.get i: udId.u64
    result: String
    match (
        ud
    ) case unitdef then {
        bit: ud.body.iterate
        for gm9Id: bit loop {
            gm: ast.nodes.get i: gm9Id.u64
            match (
                gm
            ) case namedoperation then {
                if (ztypecheck.isBareGenericParam
                    :ast
                    op: (ast.nodes.get i: gm.operation.u64)
                ) then {
                    gpn: zast.nameTextAt :ast ref: gm.name
                    if result.length == 0 then result.append " {"
                    if result.length > 2 then result.append " "
                    result.append gpn
                }
            } else null
        }
    } else null
    if result.length > 0 then result.append "}"
    return result
}

# unitGenericSuffix -- the " {T U}" suffix for a generic unit named `name`.
unitGenericSuffix: function {prog: zast.Node.view name: StringView} out String is {
    result: String
    match (
        prog
    ) case program then {
        uCnt9a: prog.ast.units.length
        uIdx9a: u64
        for uIdx9a < uCnt9a loop {
            u9Id: (zast.nodeid.create from: (prog.ast.units.get i: uIdx9a))
            uIdx9a = uIdx9a + 1
            opId: zast.nodeid
            {
                u: prog.ast.nodes.get i: u9Id.u64
                if u.namedoperation then {
                    lb: zast.poolTextAt pool: prog.ast.names ref: u.name
                    if lb.stringView == name then opId = u.operation
                }
            }
            if opId > 0 then {
                gs: (unitGenericParamsOf
                    ast: prog.ast
                    udId: opId
                )
                if gs.length > 0 then result = gs
            }
        }
    } else null
    return result
}

# unitDocComment -- a unit file's godoc-style header: the contiguous `#`
# comment lines from the top of the file, up to the first blank line or
# first definition. "" when the file has no header comment.
unitDocComment: function {snap: zcheck.CheckResult fsno: zvfs.fsno} out String is {
    result: String
    k: u64
    for true loop {
        lg: snap.vfs.getline dentryid: fsno lineno: k
        stop: false
        match (
            lg
        ) case some then {
            lv: lg.stringView
            tl: lv.trimStart
            if tl.startsWith "#" then {
                st: 1.u64
                sb: tl.byteAt i: 1
                match (
                    sb
                ) case some then {
                    if sb == 32 then st = 2
                } case none then null
                ds: tl.substring from: st to: tl.length
                if result.length > 0 then result.appendByte b: 10
                result.append ds
            } else {
                stop = true
            }
        } case none then {
            stop = true
        }
        if stop then break
        k = k + 1
    }
    return result
}

# locationAtFileTop -- an LSP Location at line 0 of file `fsno` (a unit
# reference has no member node to point at).
locationAtFileTop: function {
    snap: zcheck.CheckResult
    fsno: zvfs.fsno
    docRel: StringView
    docUri: StringView
    srcDir: StringView
    systemDir: StringView
} out Value is {
    if fsno.u64 == 0 then return Value.nul
    pp: snap.vfs.pathfromprovider dentryid: fsno
    own: pathMatches pv: pp.stringView rel: docRel :srcDir
    uri: String
    if own then {
        uri = docUri.string
    } else {
        absp: snap.vfs.pathfromproviderNative dentryid: fsno
        if absp.length == 0 then {
            st0: u64
            if pp.startsWith "/" then st0 = 1
            rel0: pp.substring from: st0 to: pp.length
            absp = absRelPath :rel0 :srcDir :systemDir
        }
        uri = pathToUri path: absp.stringView
    }
    st: newObj
    st.set key: "line".string value: (Value.intval 0.i64)
    st.set key: "character".string value: (Value.intval 0.i64)
    en: newObj
    en.set key: "line".string value: (Value.intval 0.i64)
    en.set key: "character".string value: (Value.intval 0.i64)
    rg: newObj
    rg.set key: "start".string value: (Value.object st)
    rg.set key: "end".string value: (Value.object en)
    lo: newObj
    lo.set key: "uri".string value: (Value.text uri)
    lo.set key: "range".string value: (Value.object rg)
    return (Value.object lo)
}

# dispositionNote -- a call argument's disposition (from the argDisposition
# stamp) as a one-line prose note, or "".
dispositionNote: function {o: (Option zenv.ZSymbolTable).view nid: u64} out String is {
    match (
        o
    ) case some then {
        d: o.typing.argDisposition.get key: nid
        match (
            d
        ) case some then {
            if d == ztypes.zparamownership.takeMode then {
                return "Moved into the call (a taking parameter).".string
            }
            if d == ztypes.zparamownership.borrowMode then {
                return "Borrowed for the duration of the call.".string
            }
        } case none then null
    } case none then null
    return "".string
}

# inferredGenericLines -- concrete generic bindings inferred for the call
# `callId` whose callee is `calleeNid`, one "# T = Type" comment per bound
# generic param (from the callGenericBinding stamp), or "".
inferredGenericLines: function {
    o: (Option zenv.ZSymbolTable)
    prog: zast.Node.view
    callId: u64
} out String is {
    match (
        o
    ) case some then {
        holders: (List String)
        tids: (ListVal u64)
        match (
            prog
        ) case program then {
            with git: o.typing.callGenericBinding.iterateItems do for e: git loop {
                if e.key.call == callId then {
                    hv: (zast.poolTextCopy
                        pool: prog.ast.names
                        ref: (zast.nameid.create from: e.key.param.u32.orPanic)
                    )
                    holders.append hv
                    tids.append e.value
                }
            }
        } else null
        r: String
        hi: u64
        for hi < holders.length loop {
            tn: displayTypeNameSt st: o tid: (ztypes.tid.create from: (tids.get i: hi))
            if r.length > 0 then r.appendByte b: 10
            r.append "# "
            r.append (holders.get i: hi)
            r.append " = "
            r.append tn
            hi = hi + 1
        }
        return r
    } case none then {
        return "".string
    }
}

# isInstanceOfOpt -- `tid` is a monomorphised instance of the template `tpl`.
isInstanceOfOpt: function {o: (Option zenv.ZSymbolTable).view tid: u64 tpl: u64} out bool is {
    if tid == 0 then return false
    if tid == tpl then return false
    match (
        o
    ) case some then {
        return (o.reg.genericOriginOf tid: (ztypes.tid.create from: tid.u64)).u64 == tpl
    } case none then {
        return false
    }
}

# refAnnotation -- a value reference's ownership + scope origin (+ borrow
# source) as an in-fence `#` comment body: "owned local" / "borrowed
# parameter" / "borrowed local, from s" / "static unit-level"; "" when the
# reference carries no stamped ownership/origin.
refAnnotation: function {
    prog: zast.Node.view
    o: (Option zenv.ZSymbolTable).view
    vid: ztypes.vid
    nid: u64
} out String is {
    if vid.isZero then {
        udo: useUnitDef :o :nid
        if udo > 0 then return "static unit-level".string
        return "".string
    }
    match (
        o
    ) case some then {
        if (o.reg.hasVariable id: vid) == false then return "".string
        own: String
        vo: o.reg.variableOwnershipOf id: vid
        if vo == ztypes.zownership.owned then own = "owned".string
        if vo == ztypes.zownership.borrowed then own = "borrowed".string
        orig: String
        ro: o.reg.variableOriginOf id: vid
        if ro == ztypes.zvarorigin.param then orig = "parameter".string
        if ro == ztypes.zvarorigin.local then orig = "local".string
        if own.length == 0 when orig.length == 0 then return "".string
        r: String
        if own.length > 0 then r.append own
        if orig.length > 0 then {
            if r.length > 0 then r.append " "
            r.append orig
        }
        bo: o.reg.variableBorrowOriginOf id: vid
        if (bo.isZero) == false then {
            match (
                prog
            ) case program then {
                r.append ", from "
                r.append (zast.poolTextAt pool: prog.ast.names ref: bo)
            } else null
        }
        return r
    } case none then {
        return "".string
    }
}

# navAnswer -- definition (1), hover (2), references (3) from the
# last-good snapshot.
navAnswer: function {
    snap: zcheck.CheckResult
    docRel: StringView
    docUri: StringView
    srcDir: StringView
    systemDir: StringView
    docText: StringView
    line0: i64
    ch: i64
    utf32: bool
    mode: u8
} out Value is {
    l1: line0 + 1
    l1u: l1.u32.orPanic
    lt: docLine text: docText lineno: l1u
    cp1: cpColOf lineText: lt.stringView :ch :utf32
    sp: (Spans
        rows: (ListVal spanrow)
        names: (List String)
        pos: (IdMapV u64 v: u64)
        ranges: (ListVal rangerow)
        lastPos: 0
    )
    sp.walkProgram prog: snap.prog
    bestIdx: -1
    bestKind: u8
    nr: sp.rows.length
    ri: u64
    for ri < nr loop {
        row: sp.rows.get i: ri
        if row.line == l1u when row.colLo <= cp1 then {
            if cp1 < row.colHi then {
                fs: zcheck.fsnoFor r: snap nodeid: row.nodeid
                pp: snap.vfs.pathfromprovider dentryid: fs
                if (pathMatches pv: pp.stringView rel: docRel :srcDir) then {
                    shouldTake: false
                    if bestIdx < 0 then shouldTake = true
                    if row.kind == 2 when bestKind != 2 then shouldTake = true
                    # a declaration row is the last resort: it fills an answer
                    # nothing else claimed, and never displaces a reference row
                    if bestIdx >= 0 when row.kind == 6 then shouldTake = false
                    if bestKind == 6 when row.kind != 6 then shouldTake = true
                    if shouldTake then {
                        bestIdx = ri.i64.orPanic
                        bestKind = row.kind
                    }
                }
            }
        }
        ri = ri + 1
    }
    if bestIdx < 0 then return Value.nul
    bi: bestIdx.u64.orPanic
    hit: sp.rows.get i: bi
    hname: (sp.names.get i: bi).copy
    w: hit.colHi - hit.colLo
    hnid: hit.nodeid.u64

    # resolve the hit to a target
    refVid: ztypes.vid
    refTid: u64
    refOwner: u64
    if bestKind == 1 then {
        refVid = useVarId o: snap.st nid: hnid
        if refVid.isZero then refTid = useUnitDef o: snap.st nid: hnid
    }
    if bestKind == 2 then {
        refOwner = memberOwnerOf o: snap.st nid: hnid
        # a unit-qualified member has no owner stamp; fall back to its def tid
        if refOwner == 0 then refTid = useUnitDef o: snap.st nid: hnid
    }
    if bestKind == 3 then refVid = defVarIdOf o: snap.st nid: hnid
    if bestKind == 6 then {
        refTid = nodeTypeAt o: snap.st nid: hnid
        if refTid == 0 then refTid = useUnitDef o: snap.st nid: hnid
        if refTid == 0 then refVid = defVarIdOf o: snap.st nid: hnid
    }
    # the Decl the reference resolved to (surface: a re-export keeps its
    # own Decl); fills the type id for hits only the Decl layer knows
    # (public-interface entries)
    refDeclId: refDeclOf o: snap.st nid: hnid
    # a generic parameter's own declaration: its table, not toolRefDecl, so the
    # `.generic` member row sharing this node id keeps answering nothing
    if bestKind == 6 when refDeclId.isZero then {
        refDeclId = genericParamDeclOf o: snap.st nid: hnid
    }
    # a PINNED literal -- `65` at a u8 parameter, or the base of `65.u8` -- was
    # stamped with the type that pinned it and never wore a literal one, so the
    # fold pass had nothing to record. Its lexeme is the only tell left.
    if bestKind == 1 when refDeclId.isZero then {
        if (ztypecheck.isNumericLiteralName name: hname.stringView) then {
            refDeclId = (surfaceDeclOfType
                o: snap.st
                prog: snap.prog
                tid: (nodeTypeAt o: snap.st nid: hnid)
            )
        }
    }
    if refVid.isZero when refTid == 0 when refOwner == 0 then {
        if refDeclId > 0 then refTid = declTypeIdOf o: snap.st declId: refDeclId
    }

    unitFsno: zvfs.fsno
    if refVid.isZero when refTid == 0 then unitFsno = unitFsnoByName :snap name: hname.stringView

    if mode == 2 then {
        if unitFsno.u64 > 0 then {
            ub: hname.copy
            ub.append ": unit"
            ugs: unitGenericSuffix prog: snap.prog name: hname.stringView
            ub.append ugs
            udoc: unitDocComment :snap fsno: unitFsno
            return (hoverMarkdown code: ub.stringView doc: udoc.stringView)
        }
        tnid: hnid
        t: nodeTypeAt o: snap.st nid: tnid
        # a callable / unit-member auto-calls to its return type in value
        # position; prefer its stamped def tid so a function hovers as its
        # signature rather than the return value's type.
        ud: useUnitDef o: snap.st nid: tnid
        sigTid: t
        if ud > 0 then sigTid = ud
        # a generic call's callable carries the TEMPLATE's declaration; the
        # instance the call resolved to is the stamp, and that is the
        # signature worth showing
        if (isInstanceOfOpt o: snap.st tid: t tpl: ud) then sigTid = t
        # a hit only the Decl layer resolves (a public-interface entry)
        # carries no node stamps; its Decl's type is the signature
        if sigTid == 0 then sigTid = refTid
        body: (fnSigTextOpt
            vfs: snap.vfs
            prog: snap.prog
            o: snap.st
            tid: (ztypes.tid.create from: sigTid.u64)
            name: hname.stringView
        )
        if body.length == 0 then {
            # a generic parameter answers nothing through any fallback below --
            # its Decl has no type id and its node no stamp -- so it gets its
            # own card. Never for a member row: the `.generic` selector shares
            # the declaration's node id, and a card there would sit on a word
            # that is not the parameter.
            if bestKind != 2 then {
                gcard: genericParamCard o: snap.st prog: snap.prog nid: hnid
                if gcard.length > 0 then {
                    gdoc: String
                    gown: genericParamOwner o: snap.st prog: snap.prog nid: hnid
                    if gown.length > 0 then {
                        gdoc.append "generic parameter of `"
                        gdoc.append gown
                        gdoc.appendByte b: 96
                    }
                    return (hoverMarkdown code: gcard.stringView doc: gdoc.stringView)
                }
            }
            tk: typeKindTextOpt o: snap.st tid: (ztypes.tid.create from: refTid.u64)
            if tk.length > 0 then {
                body = displayTypeNameOfOpt o: snap.st tid: (ztypes.tid.create from: refTid.u64)
                body.append ": "
                body.append tk
            } else {
                if t == 0 then return Value.nul
                tn: displayTypeNameOfOpt o: snap.st tid: (ztypes.tid.create from: t.u64)
                if tn.length == 0 then return Value.nul
                if refOwner > 0 then {
                    own: (displayTypeNameOfOpt
                        o: snap.st
                        tid: (ztypes.tid.create from: refOwner.u64)
                    )
                    if own.length > 0 then {
                        body.append own
                        body.appendByte b: 46
                    }
                }
                body.append hname
                body.append ": "
                body.append tn
                annot: refAnnotation prog: snap.prog o: snap.st vid: refVid nid: tnid
                if annot.length > 0 then {
                    body.append "  # "
                    body.append annot
                }
            }
        }
        docBody: String
        # append the `#` doc block above the definition, if any (cross-file
        # ok). The referenced surface Decl wins (a bare `i64` reads core's
        # re-export line); the canonical def node is the doc fallback.
        legacyDnd: (defNodeOf
            o: snap.st
            prog: snap.prog
            :refVid
            :refTid
            :refOwner
            member: hname.stringView
        )
        dnd: declNodeOf o: snap.st declId: refDeclId
        if dnd == 0 then dnd = legacyDnd
        if dnd > 0 then {
            dfs: zcheck.fsnoFor r: snap nodeid: dnd.u32.orPanic
            dpg: sp.pos.get key: dnd
            match (
                dpg
            ) case some then {
                dln: (dpg / 1048576).u32.orPanic
                if dfs > 0 when dln > 1 then {
                    doc: docCommentForNode :snap fsno: dfs defLine: dln
                    if doc.length > 0 then docBody = doc
                    if refOwner > 0 then {
                        tc: trailingDocOf vfs: snap.vfs fsno: dfs line1: dln
                        if tc.length > 0 then {
                            body.append "  # "
                            body.append tc
                        }
                    }
                }
            } case none then null
        }
        if docBody.length == 0 when legacyDnd > 0 when legacyDnd != dnd then {
            lfs: zcheck.fsnoFor r: snap nodeid: legacyDnd.u32.orPanic
            lpg: sp.pos.get key: legacyDnd
            match (
                lpg
            ) case some then {
                lln: (lpg / 1048576).u32.orPanic
                if lfs > 0 when lln > 1 then {
                    ldoc: docCommentForNode :snap fsno: lfs defLine: lln
                    if ldoc.length > 0 then docBody = ldoc
                }
            } case none then null
        }
        # call-site enrichment: hovering a callee appends inferred generic
        # bindings (in-fence); hovering an argument appends its disposition.
        hpos: u64
        {
            hp: sp.pos.get key: hnid
            match (
                hp
            ) case some then {
                hpos = hp
            } case none then null
        }
        callId: sp.innerRangeOfKind curPos: hpos kind: 4 slack: 0
        if callId > 0 then {
            callPos: u64
            {
                cp9x: sp.pos.get key: callId.u64
                match (
                    cp9x
                ) case some then {
                    callPos = cp9x
                } case none then null
            }
            if callPos == hpos then {
                gl: inferredGenericLines o: snap.st prog: snap.prog callId: callId.u64
                if gl.length > 0 then {
                    body.appendByte b: 10
                    body.append gl
                }
            } else {
                dn9x: dispositionNote o: snap.st nid: hnid
                if dn9x.length > 0 then {
                    if docBody.length > 0 then {
                        docBody.appendByte b: 10
                        docBody.appendByte b: 10
                    }
                    docBody.append dn9x
                }
            }
        }
        ln9: (literalNote
            o: snap.st
            name: hname.stringView
            :refTid
            nodeTid: (nodeTypeAt o: snap.st nid: hnid)
        )
        if ln9.length > 0 then {
            if docBody.length > 0 then {
                docBody.appendByte b: 10
                docBody.appendByte b: 10
            }
            docBody.append ln9
        }
        return (hoverMarkdown code: body.stringView doc: docBody.stringView)
    }

    if mode == 1 then {
        if unitFsno.u64 > 0 then {
            return (locationAtFileTop :snap fsno: unitFsno :docRel :docUri :srcDir :systemDir)
        }
        dn: declNodeOf o: snap.st declId: refDeclId
        if dn == 0 then {
            dn = (defNodeOf
                o: snap.st
                prog: snap.prog
                :refVid
                :refTid
                :refOwner
                member: hname.stringView
            )
        }
        if dn == 0 then return Value.nul
        return (locationValue
            :snap
            :sp
            nid: dn
            width: w
            :docRel
            :docUri
            :srcDir
            :systemDir
            :docText
            :utf32
        )
    }

    # references: one pass over the span rows
    arr: newArr
    rj: u64
    for rj < nr loop {
        row2: sp.rows.get i: rj
        n2: row2.nodeid.u64
        add: false
        if (refVid.isZero) == false then {
            if row2.kind == 1 then {
                uvN: useVarId o: snap.st nid: n2
                if uvN == refVid then add = true
            }
            if row2.kind == 3 then {
                dvN: defVarIdOf o: snap.st nid: n2
                if dvN == refVid then add = true
            }
        }
        if refTid > 0 when row2.kind == 1 then {
            if (useUnitDef o: snap.st nid: n2) == refTid then add = true
        }
        if refOwner > 0 when row2.kind == 2 then {
            if (memberOwnerOf o: snap.st nid: n2) == refOwner then {
                nm2: sp.names.get i: rj
                if nm2.stringView == hname.stringView then add = true
            }
        }
        if add then {
            lv2: (locationValue
                :snap
                :sp
                nid: n2
                width: row2.colHi - row2.colLo
                :docRel
                :docUri
                :srcDir
                :systemDir
                :docText
                :utf32
            )
            appendIfObject :arr v: lv2
        }
        rj = rj + 1
    }
    return (Value.array arr)
}

# appendIfObject -- append `v` when it is a real Location (drop nul).
appendIfObject: function {arr: Arr v: Value.take} is {
    keep: false
    match (
        v
    ) case object then {
        keep = true
    } else null
    if keep then arr.items.append v
}

# symbolsAnswer -- flat DocumentSymbol list for the document's unit.
symbolsAnswer: function {
    snap: zcheck.CheckResult.view
    unitName: StringView
    docText: StringView
    utf32: bool
} out Value is {
    arr: newArr
    collectUnitSymbols prog: snap.prog :unitName :docText :utf32 :arr
    return (Value.array arr)
}

# collect document-symbol entries for a whole unit.
collectUnitSymbols: function {
    prog: zast.Node.view
    unitName: StringView
    docText: StringView
    utf32: bool
    arr: Arr
} is {
    match (
        prog
    ) case program then {
        uCnt9b: prog.ast.units.length
        uIdx9b: u64
        for uIdx9b < uCnt9b loop {
            u9Id: (zast.nodeid.create from: (prog.ast.units.get i: uIdx9b))
            uIdx9b = uIdx9b + 1
            (collectUnitSymbolsIn
                ast: prog.ast
                wId: u9Id
                :unitName
                :docText
                :utf32
                :arr
            )
        }
    } else null
}

# collect document-symbol entries within a unit node.
collectUnitSymbolsIn: function {
    ast: Ast.view
    wId: zast.nodeid
    unitName: StringView
    docText: StringView
    utf32: bool
    arr: Arr
} is {
    w: ast.nodes.get i: wId.u64
    match (
        w
    ) case namedoperation then {
        lb: zast.nameTextAt :ast ref: w.name
        if lb.stringView == unitName then (collectBodySymbols
            :ast
            ud: (ast.nodes.get i: w.operation.u64)
            :docText
            :utf32
            :arr
        )
    } else null
}

# collect document-symbol entries from a unit body.
collectBodySymbols: function {
    ast: Ast.view
    ud: zast.Node.view
    docText: StringView
    utf32: bool
    arr: Arr
} is {
    match (
        ud
    ) case unitdef then {
        bit: ud.body.iterate
        for b9Id: bit loop symbolOf :ast m: (ast.nodes.get i: b9Id.u64) :docText :utf32 :arr
    } else null
}

# the document-symbol entry for one definition.
symbolOf: function {
    ast: Ast.view
    m: zast.Node.view
    docText: StringView
    utf32: bool
    arr: Arr
} is {
    match (
        m
    ) case namedoperation then {
        lb: zast.nameTextAt :ast ref: m.name
        if lb.length == 0 then return
        k: symbolKindOf op: (ast.nodes.get i: m.operation.u64)
        lt: docLine text: docText lineno: m.lineno
        c0: encodedCol lineText: lt.stringView cpCol1: m.colno :utf32
        wname: lb.stringView.count
        c1: encodedCol lineText: lt.stringView cpCol1: m.colno + wname.u32.orPanic :utf32
        if c1 <= c0 then c1 = c0 + 1
        line0: i64
        if m.lineno > 0 then line0 = (m.lineno - 1).i64
        st: newObj
        st.set key: "line".string value: (Value.intval line0)
        st.set key: "character".string value: (Value.intval c0.i64)
        en: newObj
        en.set key: "line".string value: (Value.intval line0)
        en.set key: "character".string value: (Value.intval c1.i64)
        rg: newObj
        rg.set key: "start".string value: (Value.object st)
        rg.set key: "end".string value: (Value.object en)
        rv: (Value.object rg)
        sy: newObj
        sy.set key: "name".string value: (Value.text lb.copy)
        sy.set key: "kind".string value: (Value.intval k)
        sy.set key: "range".string value: rv
        rgv2: (rangeCopy :docText :utf32 :line0 c0: c0.i64 c1: c1.i64)
        sy.set key: "selectionRange".string value: rgv2
        arr.items.append (Value.object sy)
    } else null
}

# rangeCopy -- a fresh range object (ranges cannot be shared: Values
# move into their parent on set).
rangeCopy: function {docText: StringView utf32: bool line0: i64 c0: i64 c1: i64} out Value is {
    docText
    utf32
    st: newObj
    st.set key: "line".string value: (Value.intval line0)
    st.set key: "character".string value: (Value.intval c0)
    en: newObj
    en.set key: "line".string value: (Value.intval line0)
    en.set key: "character".string value: (Value.intval c1)
    rg: newObj
    rg.set key: "start".string value: (Value.object st)
    rg.set key: "end".string value: (Value.object en)
    return (Value.object rg)
}

# the LSP SymbolKind code for definition `op`.
symbolKindOf: function {op: zast.Node.view} out i64 is {
    match (
        op
    ) case functiondef then {
        return 12
    } case objectdef then {
        return 5
    } else {
        return 13
    }
}

# ---- lint + formatting ------------------------------------------------

# lintInto -- fast-tier zl findings for one live buffer as Warning /
# Information diagnostics (hard errors stay with the compile pass,
# which owns them).
lintInto: function {arr: Arr text: String.take relpath: StringView utf32: bool} is {
    lo: zsource.defaultOpts
    lo.lineLength = 100
    la: zsource.analyzeSource source: text path: relpath.string opts: lo
    appendLintDiags :arr :la :utf32
}

# tcLintInto -- lintInto plus the typecheck-tier rules (L005 suffix, L012
# unused private def / member, L013 / L014 unused local / param) for the
# document that owns the check's main unit. Reuses the compile pass's
# program and symbol table -- no second typecheck.
tcLintInto: function {
    arr: Arr
    text: String.take
    relpath: StringView
    utf32: bool
    prog: zast.Node.view
    uname: StringView
    sto: (Option zenv.ZSymbolTable)
} is {
    lo: zsource.defaultOpts
    lo.lineLength = 100
    la: zsource.analyzeSource source: text path: relpath.string opts: lo
    match (
        sto
    ) case some then {
        la.lintSuffixUnit :prog :uname st: sto
        la.reportUnusedDefs :prog :uname st: sto
        la.reportUnusedVars :prog :uname st: sto
        la.reportViewableLocals :prog :uname st: sto
    } case none then null
    appendLintDiags :arr :la :utf32
}

# appendLintDiags -- an Analysis's collected warnings / infos as LSP
# diagnostic rows (hard errors stay with the compile pass, which owns them).
appendLintDiags: function {arr: Arr la: zsource.Analysis.view utf32: bool} is {
    with dit: la.diags.iterate do for d: dit loop {
        sevN: i64
        k: d.sev
        match (
            k
        ) case warning then {
            sevN = 2
        } case info then {
            sevN = 3
        } else null
        if sevN > 0 then {
            lt: docLine text: la.source.stringView lineno: d.lineno
            line0: i64
            if d.lineno > 0 then line0 = (d.lineno - 1).i64
            c0: encodedCol lineText: lt.stringView cpCol1: d.colno :utf32
            w: d.width
            if w == 0 then w = 1
            c1: encodedCol lineText: lt.stringView cpCol1: d.colno + w :utf32
            if c1 <= c0 then c1 = c0 + 1
            m: d.msg.copy
            if d.hint.length > 0 then {
                m.appendByte b: 10
                m.append "hint: "
                m.append d.hint
            }
            st: newObj
            st.set key: "line".string value: (Value.intval line0)
            st.set key: "character".string value: (Value.intval c0.i64)
            en: newObj
            en.set key: "line".string value: (Value.intval line0)
            en.set key: "character".string value: (Value.intval c1.i64)
            rg: newObj
            rg.set key: "start".string value: (Value.object st)
            rg.set key: "end".string value: (Value.object en)
            dg: newObj
            dg.set key: "range".string value: (Value.object rg)
            dg.set key: "severity".string value: (Value.intval sevN)
            dg.set key: "code".string value: (Value.text d.code.copy)
            dg.set key: "source".string value: (Value.text "zl".string)
            dg.set key: "message".string value: (Value.text m)
            arr.items.append (Value.object dg)
        }
    }
}

# formatAnswer -- the zl fmt pipeline over a live buffer: fast-tier
# edits, re-parse validation, wrap at 100. One whole-document TextEdit
# when anything changed; null when the buffer has parse errors or a
# fix would break it (the editor keeps the buffer untouched).
formatAnswer: function {text: StringView relpath: StringView} out Value is {
    fo: zsource.defaultOpts
    fo.lineLength = 100
    a: zsource.analyzeSource source: text.string path: relpath.string opts: fo
    if a.parseErrorCount > 0 then return Value.nul
    newsrc: a.source.copy
    valid: true
    if a.edits.length > 0 then {
        newsrc = zfix.applyEdits source: a.source.stringView edits: a.edits
        valid = zsource.sourceParses source: newsrc.copy
    }
    if valid == false then return Value.nul
    wrapped: zsource.wrapSource source: newsrc.stringView lineLength: 100
    newsrc = wrapped
    arr: newArr
    changed: false
    {
        cv: newsrc.stringView
        if (cv == text) == false then changed = true
    }
    if changed then {
        nl: i64
        i: u64
        n: text.length
        for i < n loop {
            b: text.byteAt :i
            match (
                b
            ) case some then {
                if b == 10 then nl = nl + 1
            } case none then null
            i = i + 1
        }
        st: newObj
        st.set key: "line".string value: (Value.intval 0)
        st.set key: "character".string value: (Value.intval 0)
        en: newObj
        en.set key: "line".string value: (Value.intval nl + 1)
        en.set key: "character".string value: (Value.intval 0)
        rg: newObj
        rg.set key: "start".string value: (Value.object st)
        rg.set key: "end".string value: (Value.object en)
        te: newObj
        te.set key: "range".string value: (Value.object rg)
        te.set key: "newText".string value: (Value.text newsrc)
        arr.items.append (Value.object te)
    }
    return (Value.array arr)
}

# ---- completion -------------------------------------------------------

# byteIdxOfCp -- byte offset where the 1-based codepoint column starts;
# s.length when the column is past the end of the line.
byteIdxOfCp: function {s: StringView cp1: u32} out u64 is {
    if cp1 <= 1 then return 0
    cnt: u32
    i: u64
    n: s.length
    for i < n loop {
        b: s.byteAt :i
        match (
            b
        ) case some then {
            isStart: b < 128
            if b >= 192 then isStart = true
            if isStart then {
                cnt = cnt + 1
                if cnt == cp1 then return i
            }
        } case none then null
        i = i + 1
    }
    return n
}

# true when byte `b` may appear in an identifier.
isIdentByte: function {b: u8} out bool is {
    if b >= 97 when b <= 122 then return true
    if b >= 65 when b <= 90 then return true
    if b >= 48 when b <= 57 then return true
    if b == 95 then return true
    return false
}

# addCand -- record a completion candidate (first kind wins on dups).
addCand: function {sink: (MapRV String v: u8) name: StringView kind: u8} is {
    if name.length == 0 then return
    if (sink.has key: name.asString) then return
    k2: name.string
    sink.set key: k2 value: kind
}

# add the language keywords to a completion sink.
addKeywords: function {sink: (MapRV String v: u8)} is {
    addCand :sink name: "function" kind: 14
    addCand :sink name: "class" kind: 14
    addCand :sink name: "record" kind: 14
    addCand :sink name: "union" kind: 14
    addCand :sink name: "variant" kind: 14
    addCand :sink name: "protocol" kind: 14
    addCand :sink name: "facet" kind: 14
    addCand :sink name: "data" kind: 14
    addCand :sink name: "if" kind: 14
    addCand :sink name: "then" kind: 14
    addCand :sink name: "else" kind: 14
    addCand :sink name: "when" kind: 14
    addCand :sink name: "match" kind: 14
    addCand :sink name: "case" kind: 14
    addCand :sink name: "for" kind: 14
    addCand :sink name: "while" kind: 14
    addCand :sink name: "loop" kind: 14
    addCand :sink name: "with" kind: 14
    addCand :sink name: "do" kind: 14
    addCand :sink name: "return" kind: 14
    addCand :sink name: "break" kind: 14
    addCand :sink name: "continue" kind: 14
    addCand :sink name: "is" kind: 14
    addCand :sink name: "as" kind: 14
    addCand :sink name: "in" kind: 14
    addCand :sink name: "out" kind: 14
    addCand :sink name: "native" kind: 14
    addCand :sink name: "true" kind: 14
    addCand :sink name: "false" kind: 14
    addCand :sink name: "null" kind: 14
}

# defKindOf -- the CompletionItemKind of a top-level definition.
defKindOf: function {op: zast.Node.view} out u8 is {
    match (
        op
    ) case functiondef then {
        return 3
    } case objectdef then {
        return 7
    } else {
        return 21
    }
}

# collectTopDefs -- every loaded unit's name (Module) and top-level
# definition labels (Function / Class / Constant).
collectTopDefs: function {prog: zast.Node.view sink: (MapRV String v: u8)} is {
    match (
        prog
    ) case program then {
        uCnt9z: prog.ast.units.length
        uIdx9z: u64
        for uIdx9z < uCnt9z loop {
            u9Id: (zast.nodeid.create from: (prog.ast.units.get i: uIdx9z))
            uIdx9z = uIdx9z + 1
            (collectUnitDefs
            ast: prog.ast
            wId: u9Id
            :sink
        )
        }
    } else null
}

# add a unit's top-level definition names to a completion sink.
collectUnitDefs: function {ast: Ast.view wId: zast.nodeid sink: (MapRV String v: u8)} is {
    w: ast.nodes.get i: wId.u64
    match (
        w
    ) case namedoperation then {
        ul: zast.nameTextAt :ast ref: w.name
        addCand :sink name: ul.stringView kind: 9
        collectUnitDefsIn :ast ud: (ast.nodes.get i: w.operation.u64) :sink
    } else null
}

# add a unit node's definition names to a completion sink.
collectUnitDefsIn: function {ast: Ast.view ud: zast.Node.view sink: (MapRV String v: u8)} is {
    match (
        ud
    ) case unitdef then {
        bit: ud.body.iterate
        for b9Id: bit loop collectMemberDef :ast m: (ast.nodes.get i: b9Id.u64) :sink
    } else null
}

# add member `m`'s name to a completion sink.
collectMemberDef: function {ast: Ast.view m: zast.Node.view sink: (MapRV String v: u8)} is {
    match (
        m
    ) case namedoperation then {
        lb: zast.nameTextAt :ast ref: m.name
        if lb.length > 0 then {
            k: defKindOf op: (ast.nodes.get i: m.operation.u64)
            addCand :sink name: lb.stringView kind: k
        }
    } else null
}

# enclosingDefStart -- the start line of the unit-body definition the
# cursor sits in (the last def at or before the cursor line), also
# adding that definition's parameter names when it is a function.
# 0 when the cursor precedes every definition.
enclosingDefStart: function {
    prog: zast.Node.view
    unitName: StringView
    l1u: u32
    sink: (MapRV String v: u8)
} out u32 is {
    match (
        prog
    ) case program then {
        uCnt9c: prog.ast.units.length
        uIdx9c: u64
        for uIdx9c < uCnt9c loop {
            u9Id: (zast.nodeid.create from: (prog.ast.units.get i: uIdx9c))
            uIdx9c = uIdx9c + 1
            r: enclosingInUnit ast: prog.ast wId: u9Id :unitName :l1u :sink
            if r > 0 then return r
        }
        return 0
    } else {
        return 0
    }
}

# the definition enclosing a position within a unit.
enclosingInUnit: function {
    ast: Ast.view
    wId: zast.nodeid
    unitName: StringView
    l1u: u32
    sink: (MapRV String v: u8)
} out u32 is {
    w: ast.nodes.get i: wId.u64
    match (
        w
    ) case namedoperation then {
        ul: zast.nameTextAt :ast ref: w.name
        if ul.stringView == unitName then return (enclosingInBody
            :ast
            ud: (ast.nodes.get i: w.operation.u64)
            :l1u
            :sink
        )
        return 0
    } else {
        return 0
    }
}

# the definition enclosing a position within a body.
enclosingInBody: function {
    ast: Ast.view
    ud: zast.Node.view
    l1u: u32
    sink: (MapRV String v: u8)
} out u32 is {
    match (
        ud
    ) case unitdef then {
        best: u32
        {
            bit: ud.body.iterate
            for b9Id: bit loop {
                b9IdNode: ast.nodes.get i: b9Id.u64
                ln: memberStartLine m: b9IdNode
                if ln > 0 when ln <= l1u then {
                    if ln > best then best = ln
                }
            }
        }
        if best > 0 then {
            bit2: ud.body.iterate
            for b2Id: bit2 loop {
                b2: ast.nodes.get i: b2Id.u64
                ln2: memberStartLine m: b2
                if ln2 == best then addMemberParams :ast m: b2 :sink
            }
        }
        return best
    } else {
        return 0
    }
}

# the source line where member `m` begins.
memberStartLine: function {m: zast.Node.view} out u32 is {
    match (
        m
    ) case namedoperation then {
        return m.lineno
    } else {
        return 0
    }
}

# add member `m`'s parameter names to a completion sink.
addMemberParams: function {ast: Ast.view m: zast.Node.view sink: (MapRV String v: u8)} is {
    match (
        m
    ) case namedoperation then {
        addFnParams :ast op: (ast.nodes.get i: m.operation.u64) :sink
    } else null
}

# add function `op`'s parameter names to a completion sink.
addFnParams: function {ast: Ast.view op: zast.Node.view sink: (MapRV String v: u8)} is {
    match (
        op
    ) case functiondef then {
        pit: op.parameters.iterate
        for pm9Id: pit loop {
            pm: ast.nodes.get i: pm9Id.u64
            addParamLabel :ast :pm :sink
        }
    } else null
}

# add parameter `pm`'s label to a completion sink.
addParamLabel: function {ast: Ast.view pm: zast.Node.view sink: (MapRV String v: u8)} is {
    match (
        pm
    ) case namedoperation then {
        pl: zast.nameTextAt :ast ref: pm.name
        addCand :sink name: pl.stringView kind: 6
    } else null
}

# addScopeCompletions -- the enclosing def's params/locals, every loaded
# unit's top-level defs and unit names, and keywords.
addScopeCompletions: function {
    snap: zcheck.CheckResult
    docRel: StringView
    srcDir: StringView
    l1u: u32
    sink: (MapRV String v: u8)
} is {
    docUnit: zsource.unitNameOf path: docRel
    defStart: enclosingDefStart prog: snap.prog unitName: docUnit.stringView :l1u :sink
    if defStart > 0 then {
        sp: (Spans
            rows: (ListVal spanrow)
            names: (List String)
            pos: (IdMapV u64 v: u64)
            ranges: (ListVal rangerow)
            lastPos: 0
        )
        sp.walkProgram prog: snap.prog
        nr: sp.rows.length
        ri: u64
        for ri < nr loop {
            row: sp.rows.get i: ri
            if row.kind == 3 when row.line >= defStart then {
                if row.line <= l1u then {
                    fs: zcheck.fsnoFor r: snap nodeid: row.nodeid
                    pp: snap.vfs.pathfromprovider dentryid: fs
                    if (pathMatches pv: pp.stringView rel: docRel :srcDir) then {
                        nm: sp.names.get i: ri
                        addCand :sink name: nm.stringView kind: 6
                    }
                }
            }
            ri = ri + 1
        }
    }
    collectTopDefs prog: snap.prog :sink
    addKeywords :sink
}

# addTypeMembers -- a type's fields (kind 5) and methods (kind 2), the
# receiver excluded.
addTypeMembers: function {
    prog: zast.Node.view
    o: (Option zenv.ZSymbolTable).view
    tid: ztypes.tid
    sink: (MapRV String v: u8)
} is {
    match (
        o
    ) case some then {
        match (
            prog
        ) case program then {
            addTypeMembersIn :prog :o :tid :sink
        } else null
    } case none then null
}

# userParams -- a function type's user parameters, in declaration order:
# names, type ids and name pool ids, with the receiver skipped. The receiver
# is either the shorthand `this` or the type's recorded long-form receiver
# name. Collected in one pass because resolving a member declaration takes an
# exclusive lock on `o`, so no caller may probe while enumerating.
userParams: function {
    prog: zast.ProgramData.view
    o: zenv.ZSymbolTable.view
    tid: ztypes.tid
    names: List String
    tids: ListVal u64
    nameIds: ListVal u64
} is {
    mNms: (ListVal u64)
    mTds: (ListVal u64)
    o.typing.declMemberList ownerTid: (ztypes.tid.create from: tid.u64) names: mNms tids: mTds
    mk: u64
    mn: mNms.length
    for mk < mn loop {
        mnid: mNms.get i: mk
        mtid: mTds.get i: mk
        mk = mk + 1
        cnB: prog.ast.names.texts.get i: mnid.u64
        cn: cnB.stringView
        isRecv: false
        if mnid == zast.names.wkThis.u64 then isRecv = true
        if (o.reg.thisParamNameIs
            tid: (ztypes.tid.create from: tid.u64)
            nameId: (zast.nameid.create from: mnid.u32.orPanic)
        ) then isRecv = true
        if (isRecv) == false then {
            names.append cn.string
            tids.append mtid
            nameIds.append mnid
        }
    }
}

# addTypeMembersIn -- addTypeMembers with the program narrowed (prog is
# the ProgramData payload).
addTypeMembersIn: function {
    prog: zast.ProgramData.view
    o: zenv.ZSymbolTable.view
    tid: ztypes.tid
    sink: (MapRV String v: u8)
} is {
    # a unit's children are its definitions, not members: addUnitMembers
    # handles those, and declMemberList excludes them by design
    if (o.reg.typetypeOf typeId: (ztypes.tid.create from: tid.u64)) == ztypes.ztypetype.unitType then return
    pn8: (List String)
    pt8: (ListVal u64)
    pi8: (ListVal u64)
    userParams :prog :o :tid names: pn8 tids: pt8 nameIds: pi8
    mk8: u64
    mn8: pn8.length
    for mk8 < mn8 loop {
        cn: pn8.get i: mk8
        k: 5.u8
        if (o.reg.typetypeOf typeId: (ztypes.tid.create from: (pt8.get i: mk8))) == ztypes.ztypetype.functionType then k = 2
        addCand :sink name: cn.stringView kind: k
        mk8 = mk8 + 1
    }
}

# addUnitMembers -- the top-level symbols of the file-unit named `name`.
addUnitMembers: function {prog: zast.Node.view name: StringView sink: (MapRV String v: u8)} is {
    match (
        prog
    ) case program then {
        uCnt9d: prog.ast.units.length
        uIdx9d: u64
        for uIdx9d < uCnt9d loop {
            u9Id: (zast.nodeid.create from: (prog.ast.units.get i: uIdx9d))
            uIdx9d = uIdx9d + 1
            u: prog.ast.nodes.get i: u9Id.u64
            match (
                u
            ) case namedoperation then {
                lb: zast.poolTextAt pool: prog.ast.names ref: u.name
                if lb.stringView == name then (collectUnitDefsIn
                    ast: prog.ast
                    ud: (prog.ast.nodes.get i: u.operation.u64)
                    :sink
                )
            } else null
        }
    } else null
}

# baseTypeInScope -- the type id of the local/binding `base` visible in the
# enclosing def (kind-1 use or kind-3 binding rows in scope); 0
# when not found.
baseTypeInScope: function {
    snap: zcheck.CheckResult
    docRel: StringView
    srcDir: StringView
    defStart: u32
    l1u: u32
    base: StringView
} out u64 is {
    result: u64
    sp: (Spans
        rows: (ListVal spanrow)
        names: (List String)
        pos: (IdMapV u64 v: u64)
        ranges: (ListVal rangerow)
        lastPos: 0
    )
    sp.walkProgram prog: snap.prog
    nr: sp.rows.length
    ri: u64
    for ri < nr loop {
        row: sp.rows.get i: ri
        kindok: false
        if row.kind == 3 then kindok = true
        if row.kind == 1 then kindok = true
        if kindok when row.line >= defStart then {
            if row.line <= l1u then {
                nm: sp.names.get i: ri
                if nm.stringView == base then {
                    fs: zcheck.fsnoFor r: snap nodeid: row.nodeid
                    pp: snap.vfs.pathfromprovider dentryid: fs
                    if (pathMatches pv: pp.stringView rel: docRel :srcDir) then {
                        tt: nodeTypeAt o: snap.st nid: row.nodeid.u64
                        if tt > 0 then result = tt
                    }
                }
            }
        }
        ri = ri + 1
    }
    return result
}

# dotFrom -- index of the first `.` at or after `start` in base, or
# base.length when there is none.
dotFrom: function {base: StringView start: u64} out u64 is {
    n: base.length
    i: start
    for i < n loop {
        b: base.byteAt :i
        match (
            b
        ) case some then {
            if b == 46 then return i
        } case none then null
        i = i + 1
    }
    return n
}

# descendUnitType -- the type id of `unit.name`, resolved (and declared on
# demand) by the compiler's own reference-level resolver, so it works even
# for a type not yet referenced elsewhere in the loaded program.
descendUnitType: function {
    prog: zast.Node
    unitName: StringView
    name: StringView
    o: (Option zenv.ZSymbolTable)
} out u64 is {
    result: u64
    match (
        o
    ) case some then {
        match (
            prog
        ) case program then {
            ud: (ztypecheck.unitDeclOfName
                st: o
                nameId: (zast.poolFind pool: prog.ast.names text: unitName)
            )
            result = (ztypecheck.descendNamed
        frame: ztypes.declid
                st: o
                ast: prog.ast
                unitDecl: ud
                :name
)
        } else null
    } case none then null
    return result
}

# childOfIn -- the type id of `parent`'s child named `name` (a field, method,
# or a unit's member type), or 0. The compiler's own per-level resolver.
childOfIn: function {
    prog: zast.Node.view
    o: (Option zenv.ZSymbolTable).view
    parent: u64
    name: StringView
} out u64 is {
    result: u64
    match (
        o
    ) case some then {
        match (
            prog
        ) case program then {
            co: (o.typing.declChildOf
                pool: prog.ast.names
                parentTypeId: (ztypes.tid.create from: parent.u64)
                :name
            )
            match (
                co
            ) case some then {
                result = co
            } case none then null
        } else null
    } case none then null
    return result
}

# addMemberCompletions -- members of the base expression before a `.`. A bare
# unit lists its top-level symbols; otherwise the base is resolved one segment
# at a time -- a `unit.Type` head via the compiler's descendNamed (declaring on
# demand), a scope value via baseTypeInScope, each further segment via `childOf`
# -- and the final type's fields/methods are listed.
addMemberCompletions: function {
    snap: zcheck.CheckResult
    docRel: StringView
    srcDir: StringView
    l1u: u32
    base: StringView
    sink: (MapRV String v: u8)
} is {
    n: base.length
    dotPos: dotFrom :base start: 0
    if dotPos >= n then {
        if (unitFsnoByName :snap name: base) > 0 then {
            addUnitMembers prog: snap.prog name: base :sink
        } else {
            docUnit: zsource.unitNameOf path: docRel
            throwaway: (MapRV String v: u8)
            ds: (enclosingDefStart
                prog: snap.prog
                unitName: docUnit.stringView
                :l1u
                sink: throwaway
            )
            bt: baseTypeInScope :snap :docRel :srcDir defStart: ds :l1u :base
            if bt > 0 then (addTypeMembers
                prog: snap.prog
                o: snap.st
                tid: (ztypes.tid.create from: bt.u64)
                :sink
            )
        }
        return
    }
    # an owned copy: the scans below lend the base
    firstSeg: (base.substring from: 0 to: dotPos).string
    cur: u64
    startSeg: dotPos + 1
    if (unitFsnoByName :snap name: firstSeg.stringView) > 0 then {
        nextDot: dotFrom :base start: dotPos + 1
        secondSeg: base.substring from: dotPos + 1 to: nextDot
        cur = (descendUnitType
            prog: snap.prog
            unitName: firstSeg.stringView
            name: secondSeg
            o: snap.st
        )
        startSeg = nextDot + 1
    } else {
        docUnit: zsource.unitNameOf path: docRel
        throwaway: (MapRV String v: u8)
        ds: enclosingDefStart prog: snap.prog unitName: docUnit.stringView :l1u sink: throwaway
        cur = baseTypeInScope :snap :docRel :srcDir defStart: ds :l1u base: firstSeg.stringView
    }
    if cur == 0 then return
    pos: startSeg
    for pos <= n loop {
        de: dotFrom :base start: pos
        seg: (base.substring from: pos to: de)
        if seg.length > 0 then {
            cur = childOfIn prog: snap.prog o: snap.st parent: cur name: seg
            if cur == 0 then return
        }
        pos = de + 1
    }
    addTypeMembers prog: snap.prog o: snap.st tid: (ztypes.tid.create from: cur.u64) :sink
}

# completionItem -- a completion item object (label + kind, optional detail).
completionItem: function {label: StringView kind: u8 detail: StringView} out Value is {
    it: newObj
    it.set key: "label".string value: (Value.text label.string)
    it.set key: "kind".string value: (Value.intval kind.i64)
    if detail.length > 0 then {
        it.set key: "detail".string value: (Value.text detail.string)
    }
    return (Value.object it)
}

# caseArmComplete -- when the cursor sits after `case ` inside a match, append
# the subject variant's remaining arms (sumSubtypeNames minus arms already
# covered by other clauses) to `arr` as EnumMember items. Returns true when it
# handled the completion (a case-arm context), false otherwise.
caseArmComplete: function {
    arr: Arr
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    ltv: StringView
    ps: u64
    prefix: StringView
    cursorPos: u64
} out bool is {
    ws: ps
    for ws > 0 loop {
        wb: ltv.byteAt i: ws - 1
        stopw: false
        match (
            wb
        ) case some then {
            if wb != 32 when wb != 9 then stopw = true
        } case none then {
            stopw = true
        }
        if stopw then break
        ws = ws - 1
    }
    if ws == ps then return false
    wb2: ws
    for wb2 > 0 loop {
        cb: ltv.byteAt i: wb2 - 1
        stopc: false
        match (
            cb
        ) case some then {
            if (isIdentByte b: cb) == false then stopc = true
        } case none then {
            stopc = true
        }
        if stopc then break
        wb2 = wb2 - 1
    }
    isCaseKw: false
    {
        word: ltv.substring from: wb2 to: ws
        if word == "case" then isCaseKw = true
    }
    if (isCaseKw) == false then return false
    sp: (Spans
        rows: (ListVal spanrow)
        names: (List String)
        pos: (IdMapV u64 v: u64)
        ranges: (ListVal rangerow)
        lastPos: 0
    )
    sp.walkProgram :prog
    caseId: sp.innerRangeOfKind curPos: cursorPos kind: 5 slack: 1048576
    if caseId == 0 then return false
    # caseexpr subject index + clause ids (scoped: one node view at a time)
    subjIdx: u32
    clauseIds: (ListVal u64)
    okCase: false
    match (
        prog
    ) case program then {
        cnode: prog.ast.nodes.get i: caseId.u64
        match (
            cnode
        ) case caseexpr then {
            subjIdx = cnode.subject
            with clit: cnode.clauses.iterate do for cl: clit loop clauseIds.append cl.u64
            okCase = true
        } else null
    } else null
    if (okCase) == false then return false
    if subjIdx == 0 then return false
    subjNid: u32
    match (
        prog
    ) case program then {
        subjNode: prog.ast.nodes.get i: subjIdx.u64
        subjNid = ztypecheck.nodeId n: subjNode
    } else null
    subjTid: nodeTypeAt :o nid: subjNid.u64
    if subjTid == 0 then return false
    arms: (List String)
    gotArms: false
    match (
        o
    ) case some then {
        match (
            prog
        ) case program then {
            arms = ztypecheck.sumSubtypeNames ast: prog.ast st: o sid: subjTid
            gotArms = true
        } else null
    } case none then null
    if (gotArms) == false then return false
    used: (List String)
    ui: u64
    for ui < clauseIds.length loop {
        clId: clauseIds.get i: ui
        maIdx: u32
        match (
            prog
        ) case program then {
            clNode: prog.ast.nodes.get i: clId.u64
            match (
                clNode
            ) case caseclause then {
                maIdx = clNode.matcharm
            } else null
        } else null
        if maIdx > 0 then {
            maRef: u32
            match (
                prog
            ) case program then {
                maNode: prog.ast.nodes.get i: maIdx.u64
                match (
                    maNode
                ) case atomid then {
                    maRef = maNode.name
                } case labelvalue then {
                    maRef = maNode.name
                } else null
            } else null
            if maRef > 0 then {
                match (
                    prog
                ) case program then {
                    an: zast.nameTextCopy ast: prog.ast ref: (zast.nameid.create from: maRef.u32)
                    if an.length > 0 then used.append an
                } else null
            }
        }
        ui = ui + 1
    }
    with ait: arms.iterate do for arm: ait loop {
        skip: false
        with uit: used.iterate do for u: uit loop {
            if u.stringView == arm.stringView then skip = true
        }
        matchp: true
        if prefix.length > 0 then {
            if (arm.startsWith prefix) == false then matchp = false
        }
        if skip == false when matchp then {
            arr.items.append (completionItem label: arm.stringView kind: 20 detail: "")
        }
    }
    return true
}

# resolveCalleeFuncId -- a callable/leaf node id -> its function tid: nodeType
# carries a method callable's fn tid, useUnitDef a free function's; anything that
# does not name a function type yields 0.
resolveCalleeFuncId: function {o: (Option zenv.ZSymbolTable).view nid: u64} out u64 is {
    ftid: nodeTypeAt :o :nid
    udx: useUnitDef :o :nid
    if udx > 0 then ftid = udx
    if ftid == 0 then return 0
    result: u64
    match (
        o
    ) case some then {
        tt: o.reg.typetypeOf typeId: (ztypes.tid.create from: ftid.u64)
        match (
            tt
        ) case functionType then {
            result = ftid
        } else null
    } case none then null
    return result
}

# leafFuncIdAt -- the innermost leaf span at (line1u, idCol) resolved to a
# function tid, preferring a kind-2 member row so a dotted method's callable
# resolves; 0 when nothing there names a function. Shared by the bare-name
# arg-label lookup and signature help.
leafFuncIdAt: function {
    snap: zcheck.CheckResult
    sp: Spans.view
    docRel: StringView
    srcDir: StringView
    line1u: u32
    idCol: u32
} out u64 is {
    o: snap.st
    leafNid: u32
    bk: u8
    found: false
    rix: u64
    for rix < sp.rows.length loop {
        row: sp.rows.get i: rix
        if row.line == line1u when row.colLo <= idCol then {
            if idCol < row.colHi then {
                fs: zcheck.fsnoFor r: snap nodeid: row.nodeid
                pp: snap.vfs.pathfromprovider dentryid: fs
                if (pathMatches pv: pp.stringView rel: docRel :srcDir) then {
                    shouldTake: false
                    if (found) == false then shouldTake = true
                    if row.kind == 2 when bk != 2 then shouldTake = true
                    if shouldTake then {
                        leafNid = row.nodeid
                        bk = row.kind
                        found = true
                    }
                }
            }
        }
        rix = rix + 1
    }
    if (found) == false then return 0
    return (resolveCalleeFuncId :o nid: leafNid.u64)
}

# bareCalleeFuncId -- a lone function/method name with no label yet parses as
# an atom/dotted-path, not a call node, so the arg-label path has nothing to sit
# inside. Resolve the identifier just before the trailing whitespace via the
# same leaf-span + def recipe navAnswer uses; a function/method type yields its
# function id, anything else (a value arg, a keyword, an unresolved leaf) 0.
bareCalleeFuncId: function {
    o: (Option zenv.ZSymbolTable).view
    ltv: StringView
    ws: u64
    cursorPos: u64
    sp: Spans.view
} out u64 is {
    scan: ws
    for scan > 0 loop {
        ib: ltv.byteAt i: scan - 1
        stopid: false
        match (
            ib
        ) case some then {
            if (isIdentByte b: ib) == false then stopid = true
        } case none then {
            stopid = true
        }
        if stopid then break
        scan = scan - 1
    }
    if scan == ws then return 0
    idTxt: (ltv.substring from: scan to: ws)
    sub: ltv.substring from: 0 to: scan
    cc: sub.count
    idCol: cc.u32.orPanic + 1
    l1u: (cursorPos / 1048576).u32.orPanic
    leafNid: u32
    bk: u8
    found: false
    rix: u64
    for rix < sp.rows.length loop {
        row: sp.rows.get i: rix
        if row.line == l1u when row.colLo <= idCol then {
            if idCol < row.colHi then {
                # the walk spans every unit and rows carry no file id, so a
                # same-line/column row from another file can collide; the
                # identifier text disambiguates
                nmR: sp.names.get i: rix
                if nmR.stringView == idTxt then {
                    shouldTake: false
                    if (found) == false then shouldTake = true
                    if row.kind == 2 when bk != 2 then shouldTake = true
                    if shouldTake then {
                        leafNid = row.nodeid
                        bk = row.kind
                        found = true
                    }
                }
            }
        }
        rix = rix + 1
    }
    if (found) == false then return 0
    return (resolveCalleeFuncId :o nid: leafNid.u64)
}

# emitLabels -- append `funcId`'s parameter labels (minus the receiver and any
# already-supplied labels) to `arr` as kind-5 items with a type[+ownership]
# detail. Shared by the bare-name and call-node arg-label paths. Returns true
# when it emitted a label context (the callee has non-receiver params).
emitLabels: function {
    arr: Arr
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    funcId: u64
    supplied: (List String)
    prefix: StringView
} out bool is {
    # callee params (skip receiver), collected before any declaration read
    pnames: (List String)
    pnids: (ListVal u64)
    pptids: (ListVal u64)
    match (
        prog
    ) case program then {
        match (
            o
        ) case some then {
            (userParams
                :prog
                :o
                tid: (ztypes.tid.create from: funcId.u64)
                names: pnames
                tids: pptids
                nameIds: pnids
            )
        } case none then null
    } else null
    if pnames.length == 0 then return false
    ri: u64
    for ri < pnames.length loop {
        pn: pnames.get i: ri
        isSupp: false
        with sit: supplied.iterate do for su: sit loop {
            if su.stringView == pn.stringView then isSupp = true
        }
        matchp: true
        if prefix.length > 0 then {
            if (pn.startsWith prefix) == false then matchp = false
        }
        if isSupp == false when matchp then {
            det: String
            match (
                o
            ) case some then {
                tn: displayTypeNameSt st: o tid: (ztypes.tid.create from: (pptids.get i: ri))
                det.append tn
                oo: (o.typing.declOwnershipOfId
                    parentTypeId: (ztypes.tid.create from: funcId.u64)
                    nameId: (zast.nameid.create from: (pnids.get i: ri).u32.orPanic)
                )
                match (
                    oo
                ) case some then {
                    if oo == ztypes.zparamownership.takeMode then det.append ".take"
                    if oo == ztypes.zparamownership.borrowMode then det.append ".borrow"
                    if oo == ztypes.zparamownership.viewMode then det.append ".view"
                    if oo == ztypes.zparamownership.holdMode then det.append ".hold"
                    if oo == ztypes.zparamownership.takexMode then det.append ".takex"
                } case none then null
            } case none then null
            arr.items.append (completionItem label: pn.stringView kind: 5 detail: det.stringView)
        }
        ri = ri + 1
    }
    return true
}

# argLabelComplete -- when the cursor sits at a fresh argument position inside a
# call (not after `:` or `.`), append the callee's remaining parameter labels
# (minus the receiver and the labels already supplied) to `arr`, with a
# type[+ownership] detail. Returns true when it handled a call-arg-label context.
argLabelComplete: function {
    arr: Arr
    o: (Option zenv.ZSymbolTable).view
    prog: zast.Node.view
    ltv: StringView
    ps: u64
    prefix: StringView
    cursorPos: u64
} out bool is {
    ws: ps
    for ws > 0 loop {
        wb: ltv.byteAt i: ws - 1
        stopw: false
        match (
            wb
        ) case some then {
            if wb != 32 when wb != 9 then stopw = true
        } case none then {
            stopw = true
        }
        if stopw then break
        ws = ws - 1
    }
    if ws == 0 then return false
    pvb: ltv.byteAt i: ws - 1
    badPos: false
    match (
        pvb
    ) case some then {
        if pvb == 58 then badPos = true
        if pvb == 46 then badPos = true
    } case none then null
    if badPos then return false
    sp: (Spans
        rows: (ListVal spanrow)
        names: (List String)
        pos: (IdMapV u64 v: u64)
        ranges: (ListVal rangerow)
        lastPos: 0
    )
    sp.walkProgram :prog
    callId: sp.innerRangeOfKind curPos: cursorPos kind: 4 slack: 1048576
    supplied: (List String)
    # a bare function/method name (no label yet) has no call node; on a fresh
    # arg position (empty prefix) resolve the identifier just before the cursor
    # and, when it names a function/method, offer its labels. Gated to the
    # empty-prefix case so typing a value still falls through to scope
    # completion; given priority since a slack-matched call node may be nearby.
    if prefix.length == 0 then {
        bfid: bareCalleeFuncId :o :ltv :ws :cursorPos :sp
        if bfid > 0 then {
            empty: (List String)
            return (emitLabels :arr :o :prog funcId: bfid supplied: empty :prefix)
        }
    }
    if callId == 0 then return false
    # callable index + supplied argument node ids (scoped: one node view)
    callableIdx: u32
    argIds: (ListVal u64)
    okCall: false
    match (
        prog
    ) case program then {
        cnode: prog.ast.nodes.get i: callId.u64
        match (
            cnode
        ) case call then {
            callableIdx = cnode.callable
            with aiter: cnode.arguments.iterate do for aid: aiter loop argIds.append aid.u64
            okCall = true
        } else null
    } else null
    if (okCall) == false then return false
    if callableIdx == 0 then return false
    # callee function id (callable node -> nodeId -> useUnitDef)
    calNid: u32
    match (
        prog
    ) case program then {
        caln: prog.ast.nodes.get i: callableIdx.u64
        calNid = ztypecheck.nodeId n: caln
    } else null
    funcId: resolveCalleeFuncId :o nid: calNid.u64
    if funcId == 0 then return false
    # supplied labels (each arg -> namedoperation.name ref -> text)
    si: u64
    for si < argIds.length loop {
        aid: argIds.get i: si
        nameRef: u32
        match (
            prog
        ) case program then {
            anode: prog.ast.nodes.get i: aid.u64
            match (
                anode
            ) case namedoperation then {
                nameRef = anode.name
            } else null
        } else null
        if nameRef > 0 then {
            match (
                prog
            ) case program then {
                lbl: zast.nameTextCopy ast: prog.ast ref: (zast.nameid.create from: nameRef.u32)
                if lbl.length > 0 then supplied.append lbl
            } else null
        }
        si = si + 1
    }
    return (emitLabels :arr :o :prog :funcId :supplied :prefix)
}

# signatureHelpAnswer -- a mid-typing signature popup. A call being typed often
# fails to parse (a trailing label -> "Expected an Operation after label") and is
# absent from the last-good snapshot tree, so locate the enclosing call by a
# paren-depth-aware backward scan of the live buffer (a call spans lines only
# inside parens; a nested call argument is always parenthesised, so the innermost
# unmatched "(" bounds it), resolve the callee against the snapshot, and render
# its signature with the active parameter (the label nearest the cursor). Returns
# a SignatureHelp object, or null when the cursor is not inside a resolvable call.
signatureHelpAnswer: function {
    snap: zcheck.CheckResult
    docRel: StringView
    srcDir: StringView
    docText: StringView
    line0: i64
    ch: i64
    utf32: bool
} out Value is {
    l1: line0 + 1
    l1u: l1.u32.orPanic
    curLt: docLine text: docText lineno: l1u
    cp1: cpColOf lineText: curLt.stringView :ch :utf32
    curByte: byteIdxOfCp s: curLt.stringView :cp1
    # scan backward for the operation head: the innermost unmatched "(" (an
    # enclosing, possibly multi-line, call) wins; otherwise the nearest statement
    # start (a line begun outside parens) once a block boundary or the buffer top
    # is reached. Newlines are NOT hard stops -- a call spans lines inside parens.
    pd: i64
    headLine: l1u
    headByte: u64
    stmtLine: l1u
    stmtByte: u64
    haveStmt: false
    stop: false
    scanLine: l1u
    scanText: curLt.copy
    scanEnd: curByte
    for stop == false loop {
        {
            stv: scanText.stringView
            i: scanEnd
            for i > 0 loop {
                bb: stv.byteAt i: i - 1
                match (
                    bb
                ) case some then {
                    if bb == 41 then pd = pd + 1
                    if bb == 40 then {
                        if pd > 0 then {
                            pd = pd - 1
                        } else {
                            headLine = scanLine
                            headByte = i
                            stop = true
                        }
                    }
                    if bb == 123 when pd == 0 then {
                        if haveStmt then {
                            headLine = stmtLine
                            headByte = stmtByte
                        } else {
                            headLine = scanLine
                            headByte = i
                        }
                        stop = true
                    }
                    if bb == 125 when pd == 0 then {
                        if haveStmt then {
                            headLine = stmtLine
                            headByte = stmtByte
                        } else {
                            headLine = scanLine
                            headByte = i
                        }
                        stop = true
                    }
                } case none then null
                if stop then break
                i = i - 1
            }
        }
        if stop then break
        if pd == 0 when haveStmt == false then {
            stmtLine = scanLine
            stmtByte = 0
            haveStmt = true
        }
        if scanLine <= 1 then {
            if haveStmt then {
                headLine = stmtLine
                headByte = stmtByte
            } else {
                headLine = 1
                headByte = 0
            }
            stop = true
        } else {
            scanLine = scanLine - 1
            scanText = docLine text: docText lineno: scanLine
            scanEnd = scanText.length
        }
    }
    headLt: docLine text: docText lineno: headLine
    hstv: headLt.stringView
    hlen: hstv.length
    j: headByte
    for j < hlen loop {
        wb: hstv.byteAt i: j
        stopw: false
        match (
            wb
        ) case some then {
            if wb != 32 when wb != 9 then stopw = true
        } case none then {
            stopw = true
        }
        if stopw then break
        j = j + 1
    }
    ids: j
    for j < hlen loop {
        ib: hstv.byteAt i: j
        stopi: false
        match (
            ib
        ) case some then {
            if (isIdentByte b: ib) == false then stopi = true
        } case none then {
            stopi = true
        }
        if stopi then break
        j = j + 1
    }
    isBind: false
    {
        cb: hstv.byteAt i: j
        match (
            cb
        ) case some then {
            if cb == 58 then isBind = true
        } case none then null
    }
    if isBind then {
        j = j + 1
        for j < hlen loop {
            wb2: hstv.byteAt i: j
            stopw2: false
            match (
                wb2
            ) case some then {
                if wb2 != 32 when wb2 != 9 then stopw2 = true
            } case none then {
                stopw2 = true
            }
            if stopw2 then break
            j = j + 1
        }
        ids = j
        for j < hlen loop {
            ib2: hstv.byteAt i: j
            stopi2: false
            match (
                ib2
            ) case some then {
                if (isIdentByte b: ib2) == false then stopi2 = true
            } case none then {
                stopi2 = true
            }
            if stopi2 then break
            j = j + 1
        }
    }
    if j == ids then return Value.nul
    segStart: ids
    for true loop {
        db: hstv.byteAt i: j
        isDot: false
        match (
            db
        ) case some then {
            if db == 46 then isDot = true
        } case none then null
        if (isDot) == false then break
        j = j + 1
        segStart = j
        for j < hlen loop {
            ib3: hstv.byteAt i: j
            stopi3: false
            match (
                ib3
            ) case some then {
                if (isIdentByte b: ib3) == false then stopi3 = true
            } case none then {
                stopi3 = true
            }
            if stopi3 then break
            j = j + 1
        }
    }
    calleeEnd: j
    activeLabel: String
    {
        lowb: u64
        if headLine == l1u then lowb = calleeEnd
        alstv: curLt.stringView
        k: curByte
        apd: i64
        albreak: false
        for k > lowb loop {
            ab: alstv.byteAt i: k - 1
            match (
                ab
            ) case some then {
                if ab == 41 then apd = apd + 1
                if ab == 40 when apd > 0 then apd = apd - 1
                if ab == 58 when apd == 0 then {
                    le: k - 1
                    ls: le
                    for ls > lowb loop {
                        lb: alstv.byteAt i: ls - 1
                        stopl: false
                        match (
                            lb
                        ) case some then {
                            if (isIdentByte b: lb) == false then stopl = true
                        } case none then {
                            stopl = true
                        }
                        if stopl then break
                        ls = ls - 1
                    }
                    if ls < le then {
                        activeLabel = (alstv.substring from: ls to: le).string
                        albreak = true
                    }
                }
            } case none then null
            if albreak then break
            k = k - 1
        }
    }
    nmS: (hstv.substring from: segStart to: calleeEnd)
    segCp: u64
    {
        hsub: hstv.substring from: 0 to: segStart
        segCp = hsub.count
    }
    idCol: segCp.u32.orPanic + 1
    sp: (Spans
        rows: (ListVal spanrow)
        names: (List String)
        pos: (IdMapV u64 v: u64)
        ranges: (ListVal rangerow)
        lastPos: 0
    )
    sp.walkProgram prog: snap.prog
    funcId: leafFuncIdAt :snap :sp :docRel :srcDir line1u: headLine :idCol
    if funcId == 0 then return Value.nul
    label: (fnSigTextOpt
        vfs: snap.vfs
        prog: snap.prog
        o: snap.st
        tid: (ztypes.tid.create from: funcId.u64)
        name: nmS
    )
    if label.length == 0 then return Value.nul
    pdisps: fnParamDisplays prog: snap.prog o: snap.st tid: (ztypes.tid.create from: funcId.u64)
    params: newArr
    activeIdx: i64
    foundActive: false
    pi: u64
    for pi < pdisps.length loop {
        pds: pdisps.get i: pi
        pdv: pds.stringView
        colon: u64
        hasColon: false
        ci: u64
        for ci < pdv.length loop {
            cbb: pdv.byteAt i: ci
            match (
                cbb
            ) case some then {
                if cbb == 58 when hasColon == false then {
                    colon = ci
                    hasColon = true
                }
            } case none then null
            ci = ci + 1
        }
        pnm: pdv
        if hasColon then pnm = pdv.substring from: 0 to: colon
        if foundActive == false when activeLabel.length > 0 then {
            if pnm == activeLabel.stringView then {
                activeIdx = pi.i64.orPanic
                foundActive = true
            }
        }
        pobj: newObj
        pobj.set key: "label".string value: (Value.text pdv.string)
        params.items.append (Value.object pobj)
        pi = pi + 1
    }
    siginfo: newObj
    siginfo.set key: "label".string value: (Value.text label)
    siginfo.set key: "parameters".string value: (Value.array params)
    siginfo.set key: "activeParameter".string value: (Value.intval activeIdx)
    sigs: newArr
    sigs.items.append (Value.object siginfo)
    root: newObj
    root.set key: "signatures".string value: (Value.array sigs)
    root.set key: "activeSignature".string value: (Value.intval 0)
    root.set key: "activeParameter".string value: (Value.intval activeIdx)
    return (Value.object root)
}

# completionAnswer -- scope-based completion from the last-good
# snapshot: the enclosing definition's params and preceding bindings,
# every loaded unit's top-level defs and unit names, and keywords --
# filtered by the identifier prefix on the LIVE line. A '.' before the
# prefix is member position -> the base's members.
completionAnswer: function {
    snap: zcheck.CheckResult
    docRel: StringView
    srcDir: StringView
    docText: StringView
    line0: i64
    ch: i64
    utf32: bool
    trig: StringView
} out Value is {
    arr: newArr
    l1: line0 + 1
    l1u: l1.u32.orPanic
    lt: docLine text: docText lineno: l1u
    ltv: lt.stringView
    cp1: cpColOf lineText: ltv :ch :utf32
    cur: byteIdxOfCp s: ltv :cp1
    # identifier prefix ending at the cursor
    ps: cur
    for ps > 0 loop {
        b: ltv.byteAt i: ps - 1
        match (
            b
        ) case some then {
            if (isIdentByte :b) == false then break
        } case none then {
            break
        }
        ps = ps - 1
    }
    cands: (MapRV String v: u8)
    memberMode: false
    # member position: a '.' before the prefix -> complete the base's members
    if ps > 0 then {
        pb: ltv.byteAt i: ps - 1
        match (
            pb
        ) case some then {
            if pb == 46 then {
                memberMode = true
                be: ps - 1
                bs: be
                for bs > 0 loop {
                    bb: ltv.byteAt i: bs - 1
                    match (
                        bb
                    ) case some then {
                        if (isIdentByte b: bb) == false when bb != 46 then break
                    } case none then {
                        break
                    }
                    bs = bs - 1
                }
                base: (ltv.substring from: bs to: be)
                (addMemberCompletions
                    :snap
                    :docRel
                    :srcDir
                    :l1u
                    :base
                    sink: cands
                )
            }
        } case none then null
    }
    # an owned copy: the completers below lend the line
    prefix: (ltv.substring from: ps to: cur).string

    if (memberMode) == false then {
        curPos: (l1u.u64 * 1048576) + cp1.u64
        handledCA: (caseArmComplete
            :arr
            o: snap.st
            prog: snap.prog
            :ltv
            :ps
            prefix: prefix.stringView
            cursorPos: curPos
        )
        if handledCA then return (Value.array arr)
        handledAL: (argLabelComplete
            :arr
            o: snap.st
            prog: snap.prog
            :ltv
            :ps
            prefix: prefix.stringView
            cursorPos: curPos
        )
        if handledAL then return (Value.array arr)
        if trig == " " then return (Value.array arr)
        addScopeCompletions :snap :docRel :srcDir :l1u sink: cands
    }

    labels: (List String)
    with cit: cands.iterateItems do for ce: cit loop {
        pv: prefix.stringView
        if pv.length == 0 then {
            lc: ce.key.copy
            labels.append lc
        } else {
            kv: ce.key.stringView
            if kv.startsWith pv then {
                lc2: ce.key.copy
                labels.append lc2
            }
        }
    }
    labels.sort
    li: u64
    ln: labels.length
    for li < ln loop {
        lb: labels.get i: li
        ko: cands.get key: lb
        kind: 6.u8
        match (
            ko
        ) case some then {
            kind = ko
        } case none then null
        it: newObj
        it.set key: "label".string value: (Value.text lb.copy)
        it.set key: "kind".string value: (Value.intval kind.i64)
        arr.items.append (Value.object it)
        li = li + 1
    }
    return (Value.array arr)
}

# ---- main ------------------------------------------------------------

# DEBOUNCE_MS -- interactive recheck coalescing window. A burst of edits
# within this window collapses to one recheck; ~100 ms clears typical
# inter-keystroke gaps while staying under the perception threshold.
DEBOUNCE_MS: 100.i32

# the server loop: read framed requests and dispatch each until shutdown.
serve: function {srv: Server} is {
    for srv.running loop {
        mo: srv.readMessage
        match (
            mo
        ) case some then {
            pr: json.parse source: mo.stringView
            match (
                pr
            ) case ok then {
                srv.handleMessage msg: pr
            } case err then {
                io.eprintln "zls: bad JSON payload"
            }
            if srv.debounce when srv.hasDirty then {
                if (srv.inputQuiet millis: DEBOUNCE_MS) then srv.flushDirty
            }
        } case none then {
            if srv.debounce when srv.hasDirty then srv.flushDirty
            srv.running = false
        }
    }
}

# print the zls usage to stderr.
printUsage: function is {
    io.eprintln "usage: zls [--stdio] [--replay <file>] [--listen <port>]"
    io.eprintln "           [--src <dir>] [--system <dir>]"
}


# language-server entry point: dispatch on the transport flag
# (--stdio / --replay / --listen) and serve LSP requests.
main: function is {
    argv: os.args
    n: argv.length
    replay: String
    listenArg: String
    srcFlag: String
    sysFlag: String
    i: 1.u64
    for i < n loop {
        arg: (argv.get :i)
        av: arg.stringView
        if av == "-V" then {
            v: zversion.versionLine tool: "zls"
            print "\{v}\n"
            os.exit code: 0
        } else if av == "--version" then {
            v: zversion.versionLine tool: "zls"
            print "\{v}\n"
            os.exit code: 0
        } else if av == "--stdio" then {
        } else if av == "--replay" then {
            if (i + 1) < n then {
                i = i + 1
                replay = (argv.get :i).copy
            }
        } else if av == "--src" then {
            if (i + 1) < n then {
                i = i + 1
                srcFlag = (argv.get :i).copy
            }
        } else if av == "--system" then {
            if (i + 1) < n then {
                i = i + 1
                sysFlag = (argv.get :i).copy
            }
        } else if av == "--listen" then {
            if (i + 1) < n then {
                i = i + 1
                listenArg = (argv.get :i).copy
            }
        } else if av == "--help" then {
            printUsage
            os.exit code: 0
        } else {
            io.eprintln "zls: unknown argument"
            printUsage
            os.exit code: 2
        }
        i = i + 1
    }
    ib: Bytes
    srv: (Server
        docs: (Map String V: Document)
        srcDir: "".string
        systemDir: "".string
        :srcFlag
        :sysFlag
        encUtf32: false
        initialized: false
        shutdownReq: false
        running: true
        exitCode: 0
        inbuf: ib
        inpos: 0
        transport: (Transport.stdio)
        debounce: true
        dirty: (MapRV String v: bool)
        snapshots: (Map String V: zcheck.CheckResult)
    )
    if listenArg.length > 0 then {
        pr: listenArg.stringView.parseU64
        match (
            pr
        ) case ok then {
            if pr > 65535 then {
                io.eprintln "zls: --listen port out of range (0-65535)"
                os.exit code: 2
            }
            port: pr.u16.orPanic
            lo: net.listen :port
            match (
                lo
            ) case ok then {
                ao: lo.accept
                match (
                    ao
                ) case ok then {
                    srv.transport = (Transport.tcp ao)
                    serve :srv
                } case err then {
                    io.eprintln "zls: accept failed"
                    os.exit code: 3
                }
            } case err then {
                io.eprintln "zls: listen failed"
                os.exit code: 3
            }
        } case err then {
            io.eprintln "zls: --listen expects a port number"
            os.exit code: 2
        }
    } else if replay.length > 0 then {
        fo: io.open path: replay mode: io.openmode.read
        match (
            fo
        ) case ok then {
            srv.transport = (Transport.replay fo)
            srv.debounce = false
            serve :srv
        } case err then {
            io.eprintln "zls: cannot open replay file"
            os.exit code: 2
        }
    } else {
        serve :srv
    }
    os.exit code: srv.exitCode
}
