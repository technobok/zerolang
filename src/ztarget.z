# ztarget -- the --target triple: its vocabulary, its parse, and what a build
# for it needs to ask of it. A DRIVER's fact: zc validates the flag and names
# the executable from it, and every front end resolves it once, here, into the
# operating system and architecture the build is for -- the host's where no
# triple names one -- and hands those names on: zc writes them into the
# generated `z` unit (z.build.os / z.build.arch), and the C backend asks the
# architecture of it. The type checker parses nothing and knows no target.

# Public interface -- the definitions other units may reference; all other
# top-level definitions are private to this unit.
public: unit {
    :targetTripleError
    :targetOrHostOs
    :targetOrHostArch
    :targetExeSuffix
    :targetIsHost
}

# The vocabulary: each `<arm>Spellings` block lists the spellings of a --target
# triple that name one oskind or archkind arm, the arm's own name first. It is
# DATA rather than a chain of comparisons: the spelling is the datum for
# external text -- there is no name id for "mingw32" -- so the whole parser gets
# by on the one compare namesArm makes, and the refusal lists the vocabulary
# from the same blocks.

linuxSpellings: data { "linux" } out StringView

darwinSpellings: data { "darwin" "apple" "macos" } out StringView

windowsSpellings: data { "windows" "mingw32" "mingw" "msvc" } out StringView

x86Spellings: data { "x86_64" "amd64" } out StringView

armSpellings: data { "aarch64" "arm64" } out StringView

# namesArm -- whether `comp`, one `-` separated component of a --target
# triple, is one of the `spellings` of an arm
namesArm: function {spellings: stringdata comp: StringView} out bool is {
    for each s9n: spellings loop {
        if s9n == comp then return true
    }
    return false
}

# armVocabulary -- an arm's spellings as the refusal lists them: its name, then
# the others in parentheses (`darwin (also apple, macos)`)
armVocabulary: function {spellings: stringdata} out String is {
    r: String
    k: u64
    for each s9v: spellings loop {
        if k == 1 then r.append " (also "
        if k > 1 then r.append ", "
        r.append s9v
        k = k + 1
    }
    if k > 1 then r.append ")"
    return r
}

# tripleOsNames -- the DISTINCT `oskind` arm names a --target triple asks for,
# space-separated. Empty when it names none, two words when it names two --
# both of which are errors, not a fall back to the host and not last-write-wins.
#
# Components are matched WHOLE, split on `-`, never as substrings. A
# `contains needle: "linux"` test cannot fail, so it cannot report failure: it
# read the host into every unknown triple, and `x86_64-linux-windows` resolved
# to whichever test happened to run last. Several spellings name one arm
# (`apple` and `darwin`; `mingw32` and `windows`), so what is counted here is
# the resolved VALUES and not the hits -- `x86_64-apple-darwin` names one.
tripleOsNames: function {triple: StringView} out String is {
    hasLinux: false
    hasDarwin: false
    hasWindows: false
    for each c9t: (triple.split sep: "-") loop {
        if (namesArm spellings: linuxSpellings comp: c9t) then hasLinux = true
        if (namesArm spellings: darwinSpellings comp: c9t) then hasDarwin = true
        if (namesArm spellings: windowsSpellings comp: c9t) then hasWindows = true
    }
    r: String
    if hasLinux then r.append linuxSpellings.0
    if hasDarwin then {
        if r.length > 0 then r.append " "
        r.append darwinSpellings.0
    }
    if hasWindows then {
        if r.length > 0 then r.append " "
        r.append windowsSpellings.0
    }
    return r
}

# tripleArchNames -- the DISTINCT `archkind` arm names a --target triple asks
# for, on the same contract as tripleOsNames.
tripleArchNames: function {triple: StringView} out String is {
    hasX86: false
    hasArm: false
    for each c9a: (triple.split sep: "-") loop {
        if (namesArm spellings: x86Spellings comp: c9a) then hasX86 = true
        if (namesArm spellings: armSpellings comp: c9a) then hasArm = true
    }
    r: String
    if hasX86 then r.append x86Spellings.0
    if hasArm then {
        if r.length > 0 then r.append " "
        r.append armSpellings.0
    }
    return r
}

# oneNameOf -- the single name in a tripleOsNames/tripleArchNames answer, or ""
# when it named none or several. The two failures read the same here because
# both mean "no arm to seed"; targetTripleError tells them apart for the user.
oneNameOf: function {names: StringView} out String is {
    if names.length == 0 then return ""
    if (names.contains needle: " ") then return ""
    return names.string
}

# targetTripleError -- "" when `--target <triple>` names exactly one operating
# system and exactly one architecture zc models, else the message to print.
# Multi-line: the first line says what is wrong with the triple given, the rest
# list the vocabulary, which lives here beside the tables rather than at the
# flag so the two cannot drift.
#
# An empty triple is not an error -- it means a native build.
targetTripleError: function {triple: StringView} out String is {
    if triple.length == 0 then return ""
    osn: tripleOsNames :triple
    arn: tripleArchNames :triple
    osv: osn.stringView
    arv: arn.stringView
    bad: String
    if osn.length == 0 then {
        bad.append "--target '\{triple}' names no operating system zc can build for"
    } else if (osv.contains needle: " ") then {
        bad.append "--target '\{triple}' names more than one operating system (\{osv})"
    } else if arn.length == 0 then {
        bad.append "--target '\{triple}' names no architecture zc can build for"
    } else if (arv.contains needle: " ") then {
        bad.append "--target '\{triple}' names more than one architecture (\{arv})"
    } else {
        return ""
    }
    bad.append "\n  operating systems: "
    bad.append (armVocabulary spellings: linuxSpellings)
    bad.append ", "
    bad.append (armVocabulary spellings: windowsSpellings)
    bad.append ", "
    bad.append (armVocabulary spellings: darwinSpellings)
    bad.append "\n  architectures: "
    bad.append (armVocabulary spellings: x86Spellings)
    bad.append ", "
    bad.append (armVocabulary spellings: armSpellings)
    return bad
}

# targetOsName / targetArchName -- the single arm name a --target triple asks
# for, or "" when it names none or several (both of which zc refuses at the
# flag) and for an empty triple. Everything that needs to ASK about the target
# comes through these rather than through a substring of the triple.
targetOsName: function {triple: StringView} out String is {
    if triple.length == 0 then return ""
    osn: tripleOsNames :triple
    return (oneNameOf names: osn.stringView)
}

# the architecture half of a target triple, as written text
targetArchName: function {triple: StringView} out String is {
    if triple.length == 0 then return ""
    arn: tripleArchNames :triple
    return (oneNameOf names: arn.stringView)
}

# targetOrHostOs / targetOrHostArch -- what the build is FOR: the --target
# triple decides when one is given, and the host the compiler runs on
# otherwise. A cross --cc used WITHOUT --target therefore leaves these
# describing the host, which the docs say plainly. An unresolved half also
# keeps the host value: zc refuses such a triple at the flag, and a front end
# that never validated one is better served by the host than by a guess.
targetOrHostOs: function {triple: StringView} out String is {
    o9r: targetOsName :triple
    if o9r.length > 0 then return o9r
    return os.hostOsName
}

# the target's architecture, falling back to the host's when no triple was
# given
targetOrHostArch: function {triple: StringView} out String is {
    a9r: targetArchName :triple
    if a9r.length > 0 then return a9r
    return os.hostArchName
}

# targetExeSuffix -- the extension an executable built for this target carries.
# It lives beside the vocabulary because it IS a question about the vocabulary:
# no real mingw triple spells "windows", so asking the triple for the substring
# left `x86_64-w64-mingw32` -- the example the docs give -- without a suffix.
targetExeSuffix: function {triple: StringView} out String is {
    osn: targetOsName :triple
    if osn.stringView == windowsSpellings.0 then return ".exe"
    return ""
}

# targetIsHost -- true when `--target <triple>` names the machine zc is running
# on, and for an empty triple. The build path refuses a CROSS target its
# resolved compiler cannot evidently reach; a host target needs no such check.
# An unresolvable triple answers true, because targetTripleError has already
# refused it and a second complaint about the same string helps nobody.
targetIsHost: function {triple: StringView} out bool is {
    if triple.length == 0 then return true
    osn: tripleOsNames :triple
    arn: tripleArchNames :triple
    o9h: oneNameOf names: osn.stringView
    a9h: oneNameOf names: arn.stringView
    if o9h.length == 0 then return true
    if a9h.length == 0 then return true
    ho: os.hostOsName
    ha: os.hostArchName
    return (o9h.stringView == ho) and (a9h.stringView == ha)
}
