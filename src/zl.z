# zl -- the zerolang linter + formatter. A separate binary from the compiler:
# `zl lint <files>` reports diagnostics, `zl fmt <files>` applies the safe fixes
# and lays each file out.
# Both default to the fast tier (lex + parse, no typecheck) for run-on-save
# speed; `--full` adds the typecheck-tier rules; the parse gate refuses to edit
# a file that does not parse. See docs/zl.pdoc.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

# printVersion -- a version line (stdout).
printVersion: function is {
    v: zversion.versionLine tool: "zl"
    print "\{v}\n"
}

# printUsage -- the command and flag usage, to STDERR: it is printed when the
# invocation was wrong, so it must not land in a pipeline's output.
printUsage: function is {
    io.eprintln "usage: zl <command> [flags] [files...]"
    io.eprintln "commands:"
    io.eprintln "  lint <files>   report diagnostics"
    io.eprintln "  fmt <files>    apply safe fixes, then lay the file out with the printer"
    io.eprintln "  format <files> the same as fmt"
    io.eprintln "  explain <code> describe a lint code"
    io.eprintln "fmt flags:"
    io.eprintln "  --check   exit non-zero if any file needs formatting; write nothing"
    io.eprintln "  --stdout  print the formatted result instead of writing in place"
    io.eprintln "  --diff    print a unified diff of the changes; write nothing"
    io.eprintln "  --full    also apply the typecheck-tier fixes (--src DIR --system DIR set the project)"
    io.eprintln "  --line-length N  the width the printer lays out at (default 100)"
    io.eprintln "  --collapse  ignore the author's keep-open newline markers"
    io.eprintln "lint flags:"
    io.eprintln "  --full    also run typecheck-tier rules (--src DIR --system DIR set the project)"
    io.eprintln "  --casing  report variant/union members that are not lowerCamelCase (advisory)"
    io.eprintln "  --docs    report definitions/functions/methods lacking a leading `#` doc (advisory)"
    io.eprintln "  --docs-params  report undocumented function parameters (advisory)"
    io.eprintln "  --docs-fields  report undocumented members: fields, variant/union arms, generic parameters (advisory)"
    io.eprintln "  --docs-private  measure a unit's whole surface, not only its `public:` block (advisory)"
    io.eprintln "  --docs-quality  report docs that only re-say the declaration, and bodies repeated in a file (advisory)"
    io.eprintln "  --docs-all      every doc flag at once"
    io.eprintln "  --arch    report architecture findings: string-literal compares, composed keys, long functions, and under --full unit/type-name compares and write-only fields (advisory)"
    io.eprintln "  --line-length N  report lines over N columns (advisory; default off)"
    io.eprintln "  --complexity N  report functions whose cognitive complexity exceeds N (advisory; --arch implies 15)"
    io.eprintln "  --counts  print one `<code> <file> <count>` row per code to stdout, the findings' weights added up, in place of the diagnostics"
    io.eprintln "  --complexity-table FILE  write every A008 function to FILE as `score<TAB>file:line<TAB>function` rows, highest first, and print one summary line in place of the diagnostics"
}

# reportAnalysis -- render every collected diagnostic for one file to stderr,
# rustc-style, reusing the file's line table for the source snippet. A
# diagnostic the full tier placed in another file names that file and its line.
reportAnalysis: function {a: zsource.Analysis.view} is {
    di: u32
    for each d: a.diags loop {
        placed: a.elsewhere.get key: di
        match (
            placed
        ) case some then {
            # found in another file: that file's path and line
            there: (
                zdiag.render
                :d
                path: placed.path.stringView
                srcLine: placed.line.stringView
                hasLine: placed.hasLine
            )
            io.eprintln there
        } case none then {
            srcLine: String
            hasLine: false
            if d.lineno > 0 then {
                idx: d.lineno - 1
                if idx.u64 < a.lines.length then {
                    srcLine = (a.lines.get i: idx).copy
                    hasLine = true
                }
            }
            block: zdiag.render :d path: a.path.stringView srcLine: srcLine.stringView :hasLine
            io.eprintln block
        }
        di = di + 1
    }
}

# FileRoots -- the roots one file is checked against.
FileRoots: class {
    # the src roots, the first that answers a unit name winning
    srcdirs: List String
    # the stdlib directory
    systemdir: String
    # what is wrong with the project.zd the file belongs to, "" when nothing is
    error: String
    # the generated `z` unit the typecheck tier mounts
    layer: zcheck.GenLayer
} as {
    # fromProject -- what project `pf` gives the file at `path`, where no flag
    # gave it: its systemDir, and its source roots when the file lies under one.
    # A file of the project's tree outside its sources (a test fixture, a
    # script) is checked from its own directory, as zc checks a unit named by
    # its file.
    fromProject: function {:this pf: zproject.ProjectFile.view path: StringView} is {
        if pf.found.not then return
        this.error = pf.error.copy
        sys: zproject.inProject dir: pf.dir.stringView rel: pf.systemDir.stringView
        if this.systemdir.length == 0 then this.systemdir = sys.take
        if this.srcdirs.length == 0 when (pf.holdsSource :path) then {
            for each sr: pf.sourceRoots loop this.srcdirs.append from: sr.copy
        }
    }
}

# rootsFor -- the roots `file` is checked against. The src roots are every
# --src as given; when none was, the source root of the project the file sits
# in, when the file lies under it; otherwise the file's own directory and then
# the working directory. The stdlib is --system, else the project's systemDir, else zc's
# resolution. For a subunit, `file` is its topmost unit's file. The file's own
# directory comes first, so the unit checked is the file named and not a
# same-named unit where zl happens to run. Only a `discover` run looks for the
# project: the fast tier reads no root.
rootsFor: function {
    srcdirs: (List String).view
    systemFlag: StringView
    file: StringView
    discover: bool
    # the prelude the project check's parse shares (zparser.PreludeStore)
    prelude: zparser.PreludeStore
} out FileRoots is {
    r: (
        FileRoots
        srcdirs: List String
        systemdir: systemFlag.string
        error: String
        layer: zcheck.noLayer
    )
    for each d: srcdirs loop r.srcdirs.append from: d.copy
    pf: zproject.ProjectFile.create
    if discover then {
        start: path.dirname p: file
        pf = (
            zproject.discoverProject
            start: start.stringView
            systemdir: (zcheck.resolveSystemDir flagVal: systemFlag).stringView
            :prelude
        )
        r.fromProject :pf path: file
    }
    r.systemdir = zcheck.resolveSystemDir flagVal: r.systemdir.stringView
    if r.srcdirs.length == 0 then fileOwnRoots :file into: r.srcdirs
    if discover then {
        un: zsource.unitNameOf :file
        facts: (
            zproject.BuildFacts.create
            srcdirs: r.srcdirs
            systemdir: r.systemdir.stringView
            main: un.stringView
        )
        facts.triple = pf.target.copy
        r.layer = zproject.zLayer :pf :facts
        zproject.writeLayer layer: r.layer
    }
    return r
}

# fileOwnRoots -- the roots of `file` outside any project and with no --src:
# its own directory when it names one (either separator on Windows), then the
# working directory
fileOwnRoots: function {file: StringView into: List String} is {
    if (path.baseName p: file).length < file.length then into.append (path.dirname p: file)
    into.append from: ".".string
}

# CodeTotal -- one code's findings in one file, as --counts prints them
CodeTotal: class {
    # the rule or error code
    code: String
    # the findings' weights added up
    total: u64
}

# reportCounts -- the file's findings as rows to stdout, the form of a row in a
# ratchet baseline: `<code> <file> <count>`, one per code in the order the code
# first appears. The count adds the findings' weights, which is their number
# except where a rule measures how far over a limit a finding is (A008).
reportCounts: function {a: zsource.Analysis.view} is {
    rows: List CodeTotal
    for each d: a.diags loop {
        at: rows.length
        j: u64
        for j < rows.length loop {
            if (rows.get i: j).code.stringView == d.code then {
                at = j
                break
            }
            j = j + 1
        }
        if at == rows.length then rows.append (CodeTotal code: d.code.copy total: 0)
        row: rows.getMut i: at
        row.total = row.total + d.weight
    }
    for each r: rows loop {
        print "\{r.code} \{a.path} \{r.total}"
    }
}

# runLint -- lint each target file at the tier `opts` asks for, and report its
# diagnostics, or its count rows when `counts` is set, or with a `table` path
# its A008 functions there (writeComplexityTable). Exit 1 if any diagnostics
# fail the gate; a table run answers 0 once the table is written.
runLint: function {
    paths: (List String).borrow
    srcdirs: (List String).view
    systemdir: StringView
    opts: zsource.lintopts
    counts: bool
    table: StringView
} out i32 is {
    rows: List ComplexityRow
    if paths.length == 0 then {
        io.eprintln "zl lint: no input files"
        return 2
    }
    total: u64
    # every file's project check and its own check read the prelude once, where
    # they find the same files (zparser.Parser.parseShared). Lint writes no
    # file, so the prelude read first is the one on disk throughout.
    prelude: zparser.PreludeStore.create share: true
    for each p: paths loop {
        top: zsource.topUnitPathOf file: p.stringView
        roots: (
            rootsFor
            :srcdirs
            systemFlag: systemdir
            file: top.stringView
            discover: opts.full
            :prelude
        )
        if roots.error.length > 0 then {
            io.eprintln roots.error
            return 2
        }
        a: (
            zsource.analyzeFileTiered
            path: p.copy
            srcdirs: roots.srcdirs
            systemdir: roots.systemdir.stringView
            layer: roots.layer
            :opts
            :prelude
        )
        if table.length > 0 then {
            addComplexityRows :rows :a
        } else if counts then {
            reportCounts :a
        } else {
            reportAnalysis :a
        }
        total = total + a.failCount
    }
    if table.length > 0 then return (
        writeComplexityTable
        :rows
        path: table
        threshold: opts.complexity
    )
    if total > 0 then return 1
    return 0
}

# ComplexityRow -- one A008 function: its cognitive complexity, the file and
# line it is at, and its name
ComplexityRow: class {
    score: u64
    path: String
    line: u32
    fn: String
}

# addComplexityRows -- each function A008 found in `a` as a row of `rows`
addComplexityRows: function {rows: List ComplexityRow a: zsource.Analysis.view} is {
    for each f: a.complexities loop {
        rows.append (ComplexityRow score: f.score path: a.path.copy line: f.line fn: f.fn.copy)
    }
}

# writeComplexityTable -- `rows`, highest score first, to the file at `path`
# under a header row, and one line naming the count and the highest; answers 0,
# or 2 when the file cannot be written
writeComplexityTable: function {
    rows: List ComplexityRow path: StringView threshold: u32
} out i32 is {
    order: ListVal u64
    for order.length < rows.length loop order.append order.length
    i: 1.u64
    for i < order.length loop {
        k: i
        for k > 0 while (
            (rows.get i: (order.get i: k - 1)).score < (rows.get i: (order.get i: k)).score
        ) loop {
            t: order.get i: k - 1
            order.set i: k - 1 val: (order.get i: k)
            order.set i: k val: t
            k = k - 1
        }
        i = i + 1
    }
    text: "score\tfile:line\tfunction\n".string
    for each j: order loop {
        row: rows.get i: j
        text.append "\{row.score}"
        text.appendByte b: ascii.ht
        text.append row.path
        text.appendByte b: ascii.colon
        text.append "\{row.line}"
        text.appendByte b: ascii.ht
        text.append row.fn
        text.appendByte b: ascii.lf
    }
    w: io.writeText :path content: text
    if w.err then {
        io.eprintln "zl lint: cannot write \{path}"
        return 2
    }
    if rows.length == 0 then {
        print "complexity: no function over \{threshold} -- \{path}"
        return 0
    }
    top: rows.get i: (order.get i: 0)
    print "complexity: \{rows.length} functions over \{threshold}, highest \{top.score} \{top.fn} -- \{path}"
    return 0
}

# writeStdout -- emit `s` to stdout as exact bytes. Unlike `print` (which appends a
# newline) this is a lossless filter: the output matches the in-place write byte for
# byte, so `--stdout` and the default writer never diverge.
writeStdout: function {s: StringView} is {
    b: Bytes
    for each bo: s.byteView loop b.append from: bo
    bv: b.byteView
    w: io.stdout
    wr: w.write from: bv
    match (
        wr
    ) case ok then null case err then null
}

# refuseFormat -- report a file the formatter will not rewrite. Under --stdout
# the source is echoed unchanged, so a pipeline still gets its input back.
refuseFormat: function {msg: StringView source: StringView stdout: bool} out i32 is {
    io.eprintln msg
    if stdout then writeStdout s: source
    return 1
}

# reportFmtDiff -- `--diff`: a unified diff of what would change, and 1 when
# anything would.
reportFmtDiff: function {a: zsource.Analysis.view text: StringView changed: bool} out i32 is {
    if changed.not then return 0
    de: zsource.lineDiffEdits old: a.source.stringView new: text
    dtext: zsource.renderDiff path: a.path.stringView source: a.source.stringView edits: de
    writeStdout s: dtext.stringView
    return 1
}

# reportFmtCheck -- `--check`: name a file that would change, and 1 when one
# would.
reportFmtCheck: function {p: StringView changed: bool} out i32 is {
    if changed.not then return 0
    wf: "would reformat \{p}"
    print wf
    return 1
}

# writeFormatted -- the default: write the laid-out text back over the file.
writeFormatted: function {
    a: zsource.Analysis.view
    p: StringView
    text: String
    changed: bool
} out i32 is {
    if changed.not then return 0
    wr: io.writeText path: a.path content: text
    match (
        wr
    ) case ok then {
        fm: "formatted \{p}"
        print fm
        return 0
    } case err then null
    ew: "zl fmt: could not write \{p}"
    io.eprintln ew
    return 1
}

# formatOnePath -- lay one file out: the safe fixes first (elision, label
# collapse, zero-init, string-like), then the document printer at `lineLength`
# columns. Returns 1 when the file is refused, or when --check or --diff finds
# it would change, and 0 when there is nothing to report.
formatOnePath: function {
    p: StringView
    check: bool
    stdout: bool
    diff: bool
    full: bool
    srcdirs: (List String).view
    systemdir: StringView
    lineLength: u32
    collapse: bool
} out i32 is {
    fmtOpts: zsource.defaultOpts
    fmtOpts.full = full
    top: zsource.topUnitPathOf file: p
    # fmt rewrites files as it goes, so no prelude read before a write is kept
    # for a later file
    noShare: zparser.PreludeStore.create
    roots: (
        rootsFor
        :srcdirs
        systemFlag: systemdir
        file: top.stringView
        discover: full
        prelude: noShare
    )
    if roots.error.length > 0 then {
        io.eprintln roots.error
        return 2
    }
    a: (
        zsource.analyzeFileTiered
        path: p.string
        srcdirs: roots.srcdirs
        systemdir: roots.systemdir.stringView
        layer: roots.layer
        opts: fmtOpts
        prelude: noShare
    )
    if a.parseErrorCount > 0 then {
        reportAnalysis :a
        mp: "zl fmt: \{p} has parse errors; not formatting"
        return (refuseFormat msg: mp.stringView source: a.source.stringView :stdout)
    }
    newsrc: a.source.copy
    if a.edits.length > 0 then {
        newsrc = zfix.applyEdits source: a.source.stringView edits: a.edits
        if (zsource.sourceParses source: newsrc.copy).not then {
            eb: "zl fmt: a fix would break \{p}; skipped"
            return (refuseFormat msg: eb.stringView source: a.source.stringView :stdout)
        }
        if full.not then newsrc = zsource.settleFixes source: newsrc.copy path: p opts: fmtOpts
    }
    res: (
        zfmt.formatSource
        source: newsrc.stringView
        width: lineLength
        :collapse
        raw: false
        gate: true
    )
    if res.ok.not then {
        er: "zl fmt: \{p} refused at line \{res.line}, column \{res.col}: \{res.msg}"
        return (refuseFormat msg: er.stringView source: a.source.stringView :stdout)
    }
    text: String
    text swap res.text
    if full.not then text = (
        zsource.relayFixes
        text: text.copy
        path: p
        opts: fmtOpts
        width: lineLength
        :collapse
    )
    changed: (text.stringView == a.source).not
    if stdout then {
        writeStdout s: text.stringView
        return 0
    }
    if diff then return (reportFmtDiff :a text: text.stringView :changed)
    if check then return (reportFmtCheck :p :changed)
    return (writeFormatted :a :p :text :changed)
}

# runFormat -- `zl fmt`: lay each target file out. The three reporting modes are
# mutually exclusive, and the exit status is 1 when any file was refused or,
# under --check or --diff, would change.
runFormat: function {
    paths: (List String).borrow
    check: bool
    stdout: bool
    diff: bool
    full: bool
    srcdirs: (List String).view
    systemdir: StringView
    lineLength: u32
    collapse: bool
} out i32 is {
    if paths.length == 0 then {
        io.eprintln "zl fmt: no input files"
        return 2
    }
    modes: u32
    if check then modes = modes + 1
    if stdout then modes = modes + 1
    if diff then modes = modes + 1
    if modes > 1 then {
        io.eprintln "zl fmt: --check, --stdout and --diff are mutually exclusive"
        return 2
    }
    rc: i32
    for each p: paths loop {
        one: (
            formatOnePath
            p: p.stringView
            :check
            :stdout
            :diff
            :full
            :srcdirs
            :systemdir
            :lineLength
            :collapse
        )
        if one != 0 then rc = one
    }
    return rc
}

# zlWord -- the words zl reads at position 1 of its command line: the commands,
# and the flags that only print and stop. A word is classified by its slot here
# (zast.Vocab), never by comparing its text.
zlWord: list {
    vLint: "lint"
    vFmt: "fmt"
    vFormat: "format"
    vExplain: "explain"
    vHelp: "help"
    fH: "-h"
    fHelp: "--help"
    fV: "-V"
    fVersion: "--version"
} out staticlist StringView

# opt -- the name of each flag and option a command takes, as it is written on
# the command line. A command's spec declares its own, and CliFlags reads them
# back by the same names.
opt: list {
    full: "--full"
    casing: "--casing"
    docs: "--docs"
    docsParams: "--docs-params"
    docsFields: "--docs-fields"
    docsPrivate: "--docs-private"
    docsQuality: "--docs-quality"
    docsAll: "--docs-all"
    arch: "--arch"
    counts: "--counts"
    complexityTable: "--complexity-table"
    check: "--check"
    stdout: "--stdout"
    diff: "--diff"
    collapse: "--collapse"
    src: "--src"
    system: "--system"
    lineLength: "--line-length"
    complexity: "--complexity"
} out staticlist StringView

# addSwitch -- declares a flag on `sp`. It has no short alias and no help text:
# zl's usage is written by hand (printUsage).
addSwitch: function {sp: cli.Spec.borrow name: StringView} is {
    cli.addFlag spec: sp name: name.string shortName: "".string help: "".string
}

# addValue -- declares an option on `sp` that a command line may leave out
addValue: function {sp: cli.Spec.borrow name: StringView repeats: bool} is {
    (
        cli.addOption
        spec: sp
        name: name.string
        shortName: "".string
        help: "".string
        required: false
        :repeats
    )
}

# projectSpec -- a spec with what `lint` and `fmt` both take: the tier, the
# project's roots and the width. Their files are the extra arguments.
projectSpec: function out cli.Spec is {
    sp: cli.Spec.create programName: "zl".string summary: "".string
    addSwitch :sp name: opt.full
    addValue :sp name: opt.src repeats: true
    addValue :sp name: opt.system repeats: false
    addValue :sp name: opt.lineLength repeats: false
    return sp
}

# lintSpec -- the command line of `zl lint`
lintSpec: function out cli.Spec is {
    sp: projectSpec
    addSwitch :sp name: opt.casing
    addSwitch :sp name: opt.docs
    addSwitch :sp name: opt.docsParams
    addSwitch :sp name: opt.docsFields
    addSwitch :sp name: opt.docsPrivate
    addSwitch :sp name: opt.docsQuality
    addSwitch :sp name: opt.docsAll
    addSwitch :sp name: opt.arch
    addSwitch :sp name: opt.counts
    addValue :sp name: opt.complexityTable repeats: false
    addValue :sp name: opt.complexity repeats: false
    return sp
}

# formatSpec -- the command line of `zl fmt`
formatSpec: function out cli.Spec is {
    sp: projectSpec
    addSwitch :sp name: opt.check
    addSwitch :sp name: opt.stdout
    addSwitch :sp name: opt.diff
    addSwitch :sp name: opt.collapse
    return sp
}

# explainSpec -- the command line of `zl explain`: the one code to describe
explainSpec: function out cli.Spec is {
    sp: cli.Spec.create programName: "zl".string summary: "".string
    cli.addPositional spec: sp name: "code".string help: "".string required: true
    return sp
}

# wrongUsage -- the exit code of a command line zl does not accept
wrongUsage: 2

# refused -- says why `spec` refuses the command line, in cli's sentence for
# `e`; answers wrongUsage
refused: function {spec: cli.Spec.view e: cli.CliError.view} out i32 is {
    io.eprintln (cli.errorText :spec :e)
    return wrongUsage
}

# numberOf -- the option `name` read as a number, 0 when it was not written. A
# value that is no number, or one too large to be a width or a threshold, is a
# refusal.
numberOf: function {p: cli.Parsed.view name: StringView} out u32 is {
    v: p.option :name
    match (
        v
    ) case some then {
        pv: v.stringView.parseU64
        match (
            pv
        ) case ok then {
            n: pv.u32
            match (
                n
            ) case ok then {
                return n
            } case err then null
        } case err then null
        io.eprintln "zl: \{name} needs a number"
        os.exit code: wrongUsage
    } case none then null
    return 0
}

# textOf -- the value `v` holds, empty when it holds none: an option or a
# positional that was not written
textOf: function {v: (Option String).view} out String is {
    match (
        v
    ) case some then {
        return v.copy
    } case none then {
        return "".string
    }
}

# filesOf -- the files a command line names: its operands, in the order given
filesOf: function {p: cli.Parsed.view} out List String is {
    files: List String
    for each x: p.extraArgs loop files.append x.copy
    return files
}

# CliFlags -- what `zl`'s command line sets: the lint options a run threads
# through every rule, the formatter's own switches, and the roots a unit name
# resolves against. The two "was it given" bits are kept because --line-length
# and --complexity each have a default that applies only when the flag is
# absent.
CliFlags: class {
    # the files named on the command line, in the order given
    paths: List String
    # every --src, in the order given: all are roots and the first that answers
    # a unit name wins, as zc resolves them. Empty when none was given, and
    # each file is then checked from its own directory (rootsFor)
    srcdirs: List String
    # --system as given, empty when absent: each file's roots resolve it as zc
    # does, after its project's systemDir (rootsFor)
    systemdir: String
    # the lint options
    opts: zsource.lintopts
    # --check: report what would change and write nothing
    check: bool
    # --stdout: write the result to stdout rather than back to the file
    stdout: bool
    # --diff: report a unified diff of what would change
    diff: bool
    # --collapse: collapse an elidable label
    collapse: bool
    # whether --line-length was given, which is what suppresses fmt's default
    llSet: bool
    # whether --complexity was given, which is what suppresses --arch's default
    fcSet: bool
    # --counts: print each file's count rows in place of its diagnostics
    counts: bool
    # --complexity-table: the file the A008 table is written to, in place of
    # the diagnostics; empty when the flag is absent
    table: String
} as {
    # read -- what the command line `p` set. A name the command's spec does not
    # declare was not written, so one reading serves `lint` and `fmt`.
    read: function {p: cli.Parsed.view} out this is {
        o: zsource.defaultOpts
        docsAll: p.hasFlag name: opt.docsAll
        o.full = p.hasFlag name: opt.full
        o.lineLength = numberOf :p name: opt.lineLength
        o.casing = p.hasFlag name: opt.casing
        o.docs = docsAll or (p.hasFlag name: opt.docs)
        o.docParams = docsAll or (p.hasFlag name: opt.docsParams)
        o.docFields = docsAll or (p.hasFlag name: opt.docsFields)
        o.docsPrivate = docsAll or (p.hasFlag name: opt.docsPrivate)
        o.docsQuality = docsAll or (p.hasFlag name: opt.docsQuality)
        o.arch = p.hasFlag name: opt.arch
        o.complexity = numberOf :p name: opt.complexity
        return (
            meta.create
            paths: (filesOf :p)
            srcdirs: (p.optionAll name: opt.src)
            systemdir: (textOf v: (p.option name: opt.system))
            opts: o
            check: (p.hasFlag name: opt.check)
            stdout: (p.hasFlag name: opt.stdout)
            diff: (p.hasFlag name: opt.diff)
            collapse: (p.hasFlag name: opt.collapse)
            llSet: (p.given name: opt.lineLength)
            fcSet: (p.given name: opt.complexity)
            counts: (p.hasFlag name: opt.counts)
            table: (textOf v: (p.option name: opt.complexityTable))
        )
    }

    # lintOpts -- the options a lint run threads through every rule. --arch
    # implies the default complexity threshold, unless --complexity named one.
    lintOpts: function {t: this.view} out zsource.lintopts is {
        o: t.opts
        if t.fcSet.not when t.opts.arch then o.complexity = zsource.complexityThreshold
        return o
    }

    # formatWidth -- the column the printer wraps at: --line-length when it was
    # given, and fmt's own default otherwise. Lint leaves the option at 0, which
    # turns both wrapping and W005 off.
    formatWidth: function {t: this.view} out u32 is {
        if t.llSet then return t.opts.lineLength
        return 100
    }
}

# lintCommand -- `zl lint`; answers the exit code
lintCommand: function out i32 is {
    sp: lintSpec
    pr: cli.parse spec: sp args: os.args first: 2
    match (
        pr
    ) case ok then {
        cf: CliFlags.read p: pr
        lintOpts: cf.lintOpts
        return (
            runLint
            paths: cf.paths
            srcdirs: cf.srcdirs
            systemdir: cf.systemdir.stringView
            opts: lintOpts
            counts: cf.counts
            table: cf.table.stringView
        )
    } case err then {
        return (refused spec: sp e: pr)
    }
}

# formatCommand -- `zl fmt`; answers the exit code
formatCommand: function out i32 is {
    sp: formatSpec
    pr: cli.parse spec: sp args: os.args first: 2
    match (
        pr
    ) case ok then {
        cf: CliFlags.read p: pr
        lineLength: cf.formatWidth
        # --system stays as given: each file's roots resolve it, after its
        # project's systemDir, by zc's own precedence (rootsFor)
        return (
            runFormat
            paths: cf.paths
            check: cf.check
            stdout: cf.stdout
            diff: cf.diff
            full: cf.opts.full
            srcdirs: cf.srcdirs
            systemdir: cf.systemdir.stringView
            :lineLength
            collapse: cf.collapse
        )
    } case err then {
        return (refused spec: sp e: pr)
    }
}

# explainCommand -- `zl explain <code>`; answers the exit code
explainCommand: function out i32 is {
    sp: explainSpec
    pr: cli.parse spec: sp args: os.args first: 2
    match (
        pr
    ) case ok then {
        if pr.extraArgs.length > 0 then {
            io.eprintln "zl: unexpected argument '\{pr.extraArgs.get i: 0}'"
            return wrongUsage
        }
        code: textOf v: (pr.positional name: "code")
        return (zrule.explain code: code.stringView)
    } case err then {
        return (refused spec: sp e: pr)
    }
}

# CLI entry point for the zl linter/formatter: read the command at position 1
# (lint / fmt / explain), then run it on the arguments after it.
main: function is {
    argv: os.args
    if argv.length < 2 then {
        printUsage
        os.exit code: wrongUsage
    }
    zv: zast.Vocab.create block: zlWord
    sw: zv.slotOf text: (argv.get i: 1).stringView

    if sw == zlWord.slot.fH then {
        printUsage
        os.exit code: 0
    }
    if sw == zlWord.slot.fHelp then {
        printUsage
        os.exit code: 0
    }
    if sw == zlWord.slot.vHelp then {
        printUsage
        os.exit code: 0
    }

    if sw == zlWord.slot.fV then {
        printVersion
        os.exit code: 0
    }
    if sw == zlWord.slot.fVersion then {
        printVersion
        os.exit code: 0
    }

    if sw == zlWord.slot.vLint then os.exit code: lintCommand
    if sw == zlWord.slot.vFmt then os.exit code: formatCommand
    if sw == zlWord.slot.vFormat then os.exit code: formatCommand
    if sw == zlWord.slot.vExplain then os.exit code: explainCommand

    io.eprintln "zl: unknown command"
    printUsage
    os.exit code: wrongUsage
}
