# zl -- the zerolang linter + formatter. A separate binary from the compiler:
# `zl lint <files>` reports diagnostics, `zl fmt <files>` applies safe fixes.
# Both default to the fast tier (lex + parse, no typecheck) for run-on-save
# speed; `--full` adds the typecheck-tier rules; the parse gate refuses to edit
# a file that does not parse. See docs/zl.pdoc.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

# printVersion -- a version line (stdout).
printVersion: function is {
    v: zversion.versionLine tool: "zl"
    print "\{v}\n"
}

# printUsage -- the command and flag usage, to STDERR: it is printed when the
# invocation was wrong, so it must not land in a pipeline's output.
printUsage: function is {
    io.eprintln "usage: zl <command> [flags] [files...]"
    io.eprintln "commands:"
    io.eprintln "  lint <files>   report diagnostics"
    io.eprintln "  fmt  <files>   apply safe fixes (refuses files with parse errors)"
    io.eprintln "  format <files> apply safe fixes, then lay the file out with the printer"
    io.eprintln "  explain <code> describe a lint code"
    io.eprintln "fmt flags:"
    io.eprintln "  --check   exit non-zero if any file needs formatting; write nothing"
    io.eprintln "  --stdout  print the formatted result instead of writing in place"
    io.eprintln "  --diff    print a unified diff of the changes; write nothing"
    io.eprintln "  --line-length N  wrap over-long named-arg calls at N columns (default 100; 0 off)"
    io.eprintln "format flags: --check, --stdout, --diff and --full as fmt; --line-length N is the width"
    io.eprintln "  --collapse  ignore the author's keep-open newline markers"
    io.eprintln "lint flags:"
    io.eprintln "  --full    also run typecheck-tier rules (--src DIR --system DIR set the project)"
    io.eprintln "  --casing  report variant/union members that are not lowerCamelCase (advisory)"
    io.eprintln "  --docs    report definitions/functions/methods lacking a leading `#` doc (advisory)"
    io.eprintln "  --docs-params  report undocumented function parameters (advisory)"
    io.eprintln "  --docs-fields  report undocumented members: fields, variant/union arms, generic parameters (advisory)"
    io.eprintln "  --docs-private  measure a unit's whole surface, not only its `public:` block (advisory)"
    io.eprintln "  --docs-quality  report docs that only re-say the declaration, and bodies repeated in a file (advisory)"
    io.eprintln "  --docs-all      every doc flag at once"
    io.eprintln "  --arch    report architecture findings: string-literal compares, composed keys, long functions, and under --full unit/type-name compares and write-only fields (advisory)"
    io.eprintln "  --line-length N  report lines over N columns (advisory; default off)"
}

# reportAnalysis -- render every collected diagnostic for one file to stderr,
# rustc-style, reusing the file's line table for the source snippet.
reportAnalysis: function {a: zsource.Analysis.view} is {
    with dit: a.diags.iterate do for d: dit loop {
        srcLine: String
        hasLine: false
        if d.lineno > 0 then {
            idx: d.lineno - 1
            if idx.u64 < a.lines.length then {
                srcLine = (a.lines.get i: idx.u64).copy
                hasLine = true
            }
        }
        block: (zdiag.render :d path: a.path.stringView srcLine: srcLine.stringView :hasLine)
        io.eprintln block
    }
}

# runLint -- lint each target file at the tier `opts` asks for. Exit 1 if any
# diagnostics fail the gate.
runLint: function {
    paths: (List String).borrow
    srcdirs: (List String).view
    systemdir: StringView
    opts: zsource.lintopts
} out i32 is {
    if paths.length == 0 then {
        io.eprintln "zl lint: no input files"
        return 2
    }
    total: u64
    with pit: paths.iterate do for p: pit loop {
        a: zsource.analyzeFileTiered path: p.copy :srcdirs :systemdir :opts
        reportAnalysis :a
        total = total + a.failCount
    }
    if total > 0 then return 1
    return 0
}

# writeStdout -- emit `s` to stdout as exact bytes. Unlike `print` (which appends a
# newline) this is a lossless filter: the output matches the in-place write byte for
# byte, so `--stdout` and the default writer never diverge.
writeStdout: function {s: StringView} is {
    b: Bytes
    i: u64
    n: s.length
    for i < n loop {
        bo: s.byteAt :i
        match (
            bo
        ) case some then {
            b.append from: bo
        } case none then null
        i = i + 1
    }
    bv: ByteView.borrow from: b.listView
    w: io.stdout
    wr: w.write from: bv
    match (
        wr
    ) case ok then null case err then null
}

# runFmt -- fast-tier format over each target file. The parse gate refuses files with
# parse errors (reported, left untouched). Modes: default writes valid changes in place;
# `--check` reports files that would change and exits non-zero without writing; `--stdout`
# prints the formatted result (lossless, no in-place write).
runFmt: function {
    paths: (List String).borrow
    check: bool
    stdout: bool
    diff: bool
    full: bool
    srcdirs: (List String).view
    systemdir: StringView
    lineLength: u32
} out i32 is {
    if paths.length == 0 then {
        io.eprintln "zl fmt: no input files"
        return 2
    }
    modes: u32
    if check then modes = modes + 1
    if stdout then modes = modes + 1
    if diff then modes = modes + 1
    if modes > 1 then {
        io.eprintln "zl fmt: --check, --stdout and --diff are mutually exclusive"
        return 2
    }
    rc: i32
    with pit: paths.iterate do for p: pit loop {
        fmtOpts: zsource.defaultOpts
        fmtOpts.full = full
        fmtOpts.lineLength = lineLength
        a: zsource.analyzeFileTiered path: p.copy :srcdirs :systemdir opts: fmtOpts
        if a.parseErrorCount > 0 then {
            reportAnalysis :a
            msg: "zl fmt: \{p} has parse errors; not formatting"
            io.eprintln msg
            if stdout then {
                writeStdout s: a.source.stringView
            }
            rc = 1
        } else {
            hasEdits: a.edits.length > 0
            newsrc: a.source.copy
            valid: true
            if hasEdits then {
                newsrc = zfix.applyEdits source: a.source.stringView edits: a.edits
                valid = zsource.sourceParses source: newsrc.copy
            }
            if hasEdits when valid == false then {
                eb: "zl fmt: a fix would break \{p}; skipped"
                io.eprintln eb
                if stdout then {
                    writeStdout s: a.source.stringView
                }
                rc = 1
            } else {
                if lineLength > 0 then {
                    wrapped: zsource.wrapSource source: newsrc.stringView :lineLength
                    newsrc = wrapped
                }
                changed: (newsrc.stringView == a.source.stringView) == false
                if stdout then {
                    writeStdout s: newsrc.stringView
                } else if diff then {
                    if changed then {
                        de: zsource.lineDiffEdits old: a.source.stringView new: newsrc.stringView
                        dtext: (zsource.renderDiff
                            path: a.path.stringView
                            source: a.source.stringView
                            edits: de
                        )
                        writeStdout s: dtext.stringView
                        rc = 1
                    }
                } else if check then {
                    if changed then {
                        wf: "would reformat \{p}"
                        print wf
                        rc = 1
                    }
                } else {
                    if changed then {
                        wr: io.writeText path: a.path content: newsrc
                        match (
                            wr
                        ) case ok then {
                            fm: "formatted \{p}"
                            print fm
                        } case err then {
                            ew: "zl fmt: could not write \{p}"
                            io.eprintln ew
                            rc = 1
                        }
                    }
                }
            }
        }
    }
    return rc
}

# runFormat -- lay each target file out with the printer: the safe non-layout
# fixes first (elision, label collapse, zero-init, string-like), then the
# document printer at `lineLength` columns. `--check`, `--stdout` and `--diff`
# as `fmt` has them. A file the printer refuses (parse error, a walk out of
# step, a different tree) is reported and left untouched. Exit 1 if a file is
# refused or, under --check, would change.
runFormat: function {
    paths: (List String).borrow
    check: bool
    stdout: bool
    diff: bool
    full: bool
    srcdirs: (List String).view
    systemdir: StringView
    lineLength: u32
    collapse: bool
} out i32 is {
    if paths.length == 0 then {
        io.eprintln "zl format: no input files"
        return 2
    }
    modes: u32
    if check then modes = modes + 1
    if stdout then modes = modes + 1
    if diff then modes = modes + 1
    if modes > 1 then {
        io.eprintln "zl format: --check, --stdout and --diff are mutually exclusive"
        return 2
    }
    rc: i32
    with pit: paths.iterate do for p: pit loop {
        fmtOpts: zsource.defaultOpts
        fmtOpts.full = full
        fmtOpts.layout = false
        a: zsource.analyzeFileTiered path: p.copy :srcdirs :systemdir opts: fmtOpts
        if a.parseErrorCount > 0 then {
            reportAnalysis :a
            msg: "zl format: \{p} has parse errors; not formatting"
            io.eprintln msg
            if stdout then writeStdout s: a.source.stringView
            rc = 1
        } else {
            hasEdits: a.edits.length > 0
            newsrc: a.source.copy
            valid: true
            if hasEdits then {
                newsrc = zfix.applyEdits source: a.source.stringView edits: a.edits
                valid = zsource.sourceParses source: newsrc.copy
            }
            if hasEdits when valid == false then {
                eb: "zl format: a fix would break \{p}; skipped"
                io.eprintln eb
                if stdout then writeStdout s: a.source.stringView
                rc = 1
            } else {
                res: (zfmt.formatSource
                    source: newsrc.stringView
                    width: lineLength
                    :collapse
                    raw: false
                    gate: true
                )
                if res.ok == false then {
                    er: "zl format: \{p} refused at line \{res.line}, column \{res.col}: \{res.msg}"
                    io.eprintln er
                    if stdout then writeStdout s: a.source.stringView
                    rc = 1
                } else {
                    text: res.text.take
                    changed: (text.stringView == a.source.stringView) == false
                    if stdout then {
                        writeStdout s: text.stringView
                    } else if diff then {
                        if changed then {
                            de: zsource.lineDiffEdits old: a.source.stringView new: text.stringView
                            dtext: (zsource.renderDiff
                                path: a.path.stringView
                                source: a.source.stringView
                                edits: de
                            )
                            writeStdout s: dtext.stringView
                            rc = 1
                        }
                    } else if check then {
                        if changed then {
                            wf: "would reformat \{p}"
                            print wf
                            rc = 1
                        }
                    } else {
                        if changed then {
                            wr: io.writeText path: a.path content: text
                            match (
                                wr
                            ) case ok then {
                                fm: "formatted \{p}"
                                print fm
                            } case err then {
                                ew: "zl format: could not write \{p}"
                                io.eprintln ew
                                rc = 1
                            }
                        }
                    }
                }
            }
        }
    }
    return rc
}

# CLI entry point for the zl linter/formatter: parse the subcommand
# (lint / fmt / explain) and flags, then run it.
main: function is {
    argv: os.args
    n: argv.length
    if n < 2 then {
        printUsage
        os.exit code: 2
    }
    sub: (argv.get i: 1)
    sv: sub.stringView

    if sv == "-h" then {
        printUsage
        os.exit code: 0
    }
    if sv == "--help" then {
        printUsage
        os.exit code: 0
    }
    if sv == "help" then {
        printUsage
        os.exit code: 0
    }

    if sv == "-V" then {
        printVersion
        os.exit code: 0
    }
    if sv == "--version" then {
        printVersion
        os.exit code: 0
    }

    paths: List String
    fCheck: false
    fStdout: false
    fDiff: false
    fFull: false
    fCasing: false
    fDocs: false
    fDocParams: false
    fDocFields: false
    fDocsPrivate: false
    fDocsQuality: false
    fArch: false
    fCollapse: false
    # every --src, in the order given: all are roots and the first that answers
    # a unit name wins, as zc resolves them
    srcdirs: List String
    systemdir: "lib/system".string
    lineLength: u32
    llSet: false
    i: 2.u64
    for i < n loop {
        arg: (argv.get :i)
        av: arg.stringView
        if av == "--check" then {
            fCheck = true
        } else if av == "--stdout" then {
            fStdout = true
        } else if av == "--diff" then {
            fDiff = true
        } else if av == "--full" then {
            fFull = true
        } else if av == "--casing" then {
            fCasing = true
        } else if av == "--docs" then {
            fDocs = true
        } else if av == "--docs-params" then {
            fDocParams = true
        } else if av == "--docs-fields" then {
            fDocFields = true
        } else if av == "--docs-private" then {
            fDocsPrivate = true
        } else if av == "--docs-quality" then {
            fDocsQuality = true
        } else if av == "--docs-all" then {
            fDocs = true
            fDocParams = true
            fDocFields = true
            fDocsPrivate = true
            fDocsQuality = true
        } else if av == "--arch" then {
            fArch = true
        } else if av == "--collapse" then {
            fCollapse = true
        } else if av == "--src" then {
            if (i + 1) < n then {
                i = i + 1
                srcdirs.append from: (argv.get :i).copy
            } else {
                io.eprintln "zl: --src needs a directory"
                os.exit code: 2
            }
        } else if av == "--system" then {
            if (i + 1) < n then {
                i = i + 1
                systemdir = (argv.get :i).copy
            } else {
                io.eprintln "zl: --system needs a directory"
                os.exit code: 2
            }
        } else if av == "--line-length" then {
            if (i + 1) < n then {
                i = i + 1
                llStr: (argv.get :i)
                llSv: llStr.stringView
                llPv: llSv.parseU64
                match (
                    llPv
                ) case ok then {
                    lineLength = llPv.u32.orPanic
                    llSet = true
                } case err then {
                    io.eprintln "zl: --line-length needs a number"
                    os.exit code: 2
                }
            } else {
                io.eprintln "zl: --line-length needs a number"
                os.exit code: 2
            }
        } else if (av.startsWith prefix: "-") then {
            eu: "zl: unknown flag \{av}"
            io.eprintln eu
            os.exit code: 2
        } else {
            # `av` views `arg` for the whole branch chain, so the list takes
            # its own copy rather than moving the buffer out from under it.
            paths.append arg.copy
        }
        i = i + 1
    }

    if srcdirs.length == 0 then srcdirs.append from: ".".string
    if sv == "lint" then {
        lintOpts: (zsource.lintopts
            full: fFull
            :lineLength
            casing: fCasing
            docs: fDocs
            docParams: fDocParams
            docFields: fDocFields
            docsPrivate: fDocsPrivate
            docsQuality: fDocsQuality
            arch: fArch
            layout: false
        )
        rc: runLint :paths :srcdirs systemdir: systemdir.stringView opts: lintOpts
        os.exit code: rc
    }
    if sv == "fmt" then {
        if llSet == false then lineLength = 100
        rc: (runFmt
            :paths
            check: fCheck
            stdout: fStdout
            diff: fDiff
            full: fFull
            :srcdirs
            systemdir: systemdir.stringView
            :lineLength
        )
        os.exit code: rc
    }
    if sv == "format" then {
        if llSet == false then lineLength = 100
        rc: (runFormat
            :paths
            check: fCheck
            stdout: fStdout
            diff: fDiff
            full: fFull
            :srcdirs
            systemdir: systemdir.stringView
            :lineLength
            collapse: fCollapse
        )
        os.exit code: rc
    }
    if sv == "explain" then {
        if n < 3 then {
            io.eprintln "usage: zl explain <code>"
            os.exit code: 2
        }
        code: (argv.get i: 2)
        rc: zrule.explain code: code.stringView
        os.exit code: rc
    }

    io.eprintln "zl: unknown command"
    printUsage
    os.exit code: 2
}
