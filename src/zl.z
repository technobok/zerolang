# zl -- the zerolang linter + formatter. A separate binary from the compiler:
# `zl lint <files>` reports diagnostics, `zl fmt <files>` applies the safe fixes
# and lays each file out.
# Both default to the fast tier (lex + parse, no typecheck) for run-on-save
# speed; `--full` adds the typecheck-tier rules; the parse gate refuses to edit
# a file that does not parse. See docs/zl.pdoc.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

# printVersion -- a version line (stdout).
printVersion: function is {
    v: zversion.versionLine tool: "zl"
    print "\{v}\n"
}

# printUsage -- the command and flag usage, to STDERR: it is printed when the
# invocation was wrong, so it must not land in a pipeline's output.
printUsage: function is {
    io.eprintln "usage: zl <command> [flags] [files...]"
    io.eprintln "commands:"
    io.eprintln "  lint <files>   report diagnostics"
    io.eprintln "  fmt <files>    apply safe fixes, then lay the file out with the printer"
    io.eprintln "  format <files> the same as fmt"
    io.eprintln "  explain <code> describe a lint code"
    io.eprintln "fmt flags:"
    io.eprintln "  --check   exit non-zero if any file needs formatting; write nothing"
    io.eprintln "  --stdout  print the formatted result instead of writing in place"
    io.eprintln "  --diff    print a unified diff of the changes; write nothing"
    io.eprintln "  --full    also apply the typecheck-tier fixes (--src DIR --system DIR set the project)"
    io.eprintln "  --line-length N  the width the printer lays out at (default 100)"
    io.eprintln "  --collapse  ignore the author's keep-open newline markers"
    io.eprintln "lint flags:"
    io.eprintln "  --full    also run typecheck-tier rules (--src DIR --system DIR set the project)"
    io.eprintln "  --casing  report variant/union members that are not lowerCamelCase (advisory)"
    io.eprintln "  --docs    report definitions/functions/methods lacking a leading `#` doc (advisory)"
    io.eprintln "  --docs-params  report undocumented function parameters (advisory)"
    io.eprintln "  --docs-fields  report undocumented members: fields, variant/union arms, generic parameters (advisory)"
    io.eprintln "  --docs-private  measure a unit's whole surface, not only its `public:` block (advisory)"
    io.eprintln "  --docs-quality  report docs that only re-say the declaration, and bodies repeated in a file (advisory)"
    io.eprintln "  --docs-all      every doc flag at once"
    io.eprintln "  --arch    report architecture findings: string-literal compares, composed keys, long functions, and under --full unit/type-name compares and write-only fields (advisory)"
    io.eprintln "  --line-length N  report lines over N columns (advisory; default off)"
    io.eprintln "  --complexity N  report functions whose cognitive complexity exceeds N (advisory; --arch implies 15)"
}

# reportAnalysis -- render every collected diagnostic for one file to stderr,
# rustc-style, reusing the file's line table for the source snippet.
reportAnalysis: function {a: zsource.Analysis.view} is {
    with dit: a.diags.iterate do for d: dit loop {
        srcLine: String
        hasLine: false
        if d.lineno > 0 then {
            idx: d.lineno - 1
            if idx.u64 < a.lines.length then {
                srcLine = (a.lines.get i: idx.u64).copy
                hasLine = true
            }
        }
        block: (zdiag.render :d path: a.path.stringView srcLine: srcLine.stringView :hasLine)
        io.eprintln block
    }
}

# runLint -- lint each target file at the tier `opts` asks for. Exit 1 if any
# diagnostics fail the gate.
runLint: function {
    paths: (List String).borrow
    srcdirs: (List String).view
    systemdir: StringView
    opts: zsource.lintopts
} out i32 is {
    if paths.length == 0 then {
        io.eprintln "zl lint: no input files"
        return 2
    }
    total: u64
    with pit: paths.iterate do for p: pit loop {
        a: zsource.analyzeFileTiered path: p.copy :srcdirs :systemdir :opts
        reportAnalysis :a
        total = total + a.failCount
    }
    if total > 0 then return 1
    return 0
}

# writeStdout -- emit `s` to stdout as exact bytes. Unlike `print` (which appends a
# newline) this is a lossless filter: the output matches the in-place write byte for
# byte, so `--stdout` and the default writer never diverge.
writeStdout: function {s: StringView} is {
    b: Bytes
    i: u64
    n: s.length
    for i < n loop {
        bo: s.byteAt :i
        match (
            bo
        ) case some then {
            b.append from: bo
        } case none then null
        i = i + 1
    }
    bv: ByteView.borrow from: b.listView
    w: io.stdout
    wr: w.write from: bv
    match (
        wr
    ) case ok then null case err then null
}

# runFormat -- `zl fmt`: lay each target file out with the printer, the safe
# fixes first (elision, label collapse, zero-init, string-like), then the
# document printer at `lineLength` columns. A file the printer refuses (parse
# error, a walk out of step, a different tree) is reported and left untouched.
# Exit 1 if a file is refused or, under --check, would change.
runFormat: function {
    paths: (List String).borrow
    check: bool
    stdout: bool
    diff: bool
    full: bool
    srcdirs: (List String).view
    systemdir: StringView
    lineLength: u32
    collapse: bool
} out i32 is {
    if paths.length == 0 then {
        io.eprintln "zl fmt: no input files"
        return 2
    }
    modes: u32
    if check then modes = modes + 1
    if stdout then modes = modes + 1
    if diff then modes = modes + 1
    if modes > 1 then {
        io.eprintln "zl fmt: --check, --stdout and --diff are mutually exclusive"
        return 2
    }
    rc: i32
    with pit: paths.iterate do for p: pit loop {
        fmtOpts: zsource.defaultOpts
        fmtOpts.full = full
        a: zsource.analyzeFileTiered path: p.copy :srcdirs :systemdir opts: fmtOpts
        if a.parseErrorCount > 0 then {
            reportAnalysis :a
            msg: "zl fmt: \{p} has parse errors; not formatting"
            io.eprintln msg
            if stdout then writeStdout s: a.source.stringView
            rc = 1
        } else {
            hasEdits: a.edits.length > 0
            newsrc: a.source.copy
            valid: true
            if hasEdits then {
                newsrc = zfix.applyEdits source: a.source.stringView edits: a.edits
                valid = zsource.sourceParses source: newsrc.copy
            }
            if hasEdits when valid.not then {
                eb: "zl fmt: a fix would break \{p}; skipped"
                io.eprintln eb
                if stdout then writeStdout s: a.source.stringView
                rc = 1
            } else {
                res: (zfmt.formatSource
                    source: newsrc.stringView
                    width: lineLength
                    :collapse
                    raw: false
                    gate: true
                )
                if res.ok.not then {
                    er: "zl fmt: \{p} refused at line \{res.line}, column \{res.col}: \{res.msg}"
                    io.eprintln er
                    if stdout then writeStdout s: a.source.stringView
                    rc = 1
                } else {
                    text: res.text.take
                    changed: (text.stringView == a.source.stringView).not
                    if stdout then {
                        writeStdout s: text.stringView
                    } else if diff then {
                        if changed then {
                            de: zsource.lineDiffEdits old: a.source.stringView new: text.stringView
                            dtext: (zsource.renderDiff
                                path: a.path.stringView
                                source: a.source.stringView
                                edits: de
                            )
                            writeStdout s: dtext.stringView
                            rc = 1
                        }
                    } else if check then {
                        if changed then {
                            wf: "would reformat \{p}"
                            print wf
                            rc = 1
                        }
                    } else {
                        if changed then {
                            wr: io.writeText path: a.path content: text
                            match (
                                wr
                            ) case ok then {
                                fm: "formatted \{p}"
                                print fm
                            } case err then {
                                ew: "zl fmt: could not write \{p}"
                                io.eprintln ew
                                rc = 1
                            }
                        }
                    }
                }
            }
        }
    }
    return rc
}

# argstep -- what reading one command-line argument decided.
argstep: record {
    # false when the argument named no flag, so the caller must judge it itself
    taken: bool
    # the index of the last argument consumed, which is one past the flag when
    # the flag took a value
    at: u64
}

# flagValue -- the argument after `i`, which is `opt`'s value. An option with no
# argument left is a refusal, named by what it wanted: there is no default that
# would be right to guess.
flagValue: function {
    opt: StringView
    noun: StringView
    argv: (List String).view
    i: u64
    n: u64
} out String is {
    if (i + 1) < n then return (argv.get i: i + 1).copy
    ev: "zl: \{opt} needs a \{noun}"
    io.eprintln ev
    os.exit code: 2
    return "".string
}

# flagU32 -- `opt`'s value read as a number. A value that is not one is the
# same refusal as no value at all.
flagU32: function {opt: StringView argv: (List String).view i: u64 n: u64} out u32 is {
    v: flagValue :opt noun: "number" :argv :i :n
    pv: v.stringView.parseU64
    match (
        pv
    ) case ok then {
        return pv.u32.orPanic
    } case err then null
    ev: "zl: \{opt} needs a number"
    io.eprintln ev
    os.exit code: 2
    return 0
}

# CliFlags -- what `zl`'s command line sets: the lint options a run threads
# through every rule, the formatter's own switches, and the roots a unit name
# resolves against. The two "was it given" bits are kept because --line-length
# and --complexity each have a default that applies only when the flag is
# absent.
CliFlags: class {
    # the files named on the command line, in the order given
    paths: List String
    # every --src, in the order given: all are roots and the first that answers
    # a unit name wins, as zc resolves them
    srcdirs: List String
    # where the stdlib lives
    systemdir: String
    # the lint options, filled in place as the flags are read
    opts: zsource.lintopts
    # --check: report what would change and write nothing
    check: bool
    # --stdout: write the result to stdout rather than back to the file
    stdout: bool
    # --diff: report a unified diff of what would change
    diff: bool
    # --collapse: collapse an elidable label
    collapse: bool
    # whether --line-length was given, which is what suppresses fmt's default
    llSet: bool
    # whether --complexity was given, which is what suppresses --arch's default
    fcSet: bool
} as {
    # setLintSwitch -- the lint tier switches. True when `av` named one.
    setLintSwitch: function {:this av: StringView} out bool is {
        if av == "--full" then {
            this.opts.full = true
            return true
        }
        if av == "--casing" then {
            this.opts.casing = true
            return true
        }
        if av == "--docs" then {
            this.opts.docs = true
            return true
        }
        if av == "--docs-params" then {
            this.opts.docParams = true
            return true
        }
        if av == "--docs-fields" then {
            this.opts.docFields = true
            return true
        }
        if av == "--docs-private" then {
            this.opts.docsPrivate = true
            return true
        }
        if av == "--docs-quality" then {
            this.opts.docsQuality = true
            return true
        }
        if av == "--docs-all" then {
            this.opts.docs = true
            this.opts.docParams = true
            this.opts.docFields = true
            this.opts.docsPrivate = true
            this.opts.docsQuality = true
            return true
        }
        if av == "--arch" then {
            this.opts.arch = true
            return true
        }
        return false
    }

    # setFormatSwitch -- the formatter switches. True when `av` named one.
    setFormatSwitch: function {:this av: StringView} out bool is {
        if av == "--check" then {
            this.check = true
            return true
        }
        if av == "--stdout" then {
            this.stdout = true
            return true
        }
        if av == "--diff" then {
            this.diff = true
            return true
        }
        if av == "--collapse" then {
            this.collapse = true
            return true
        }
        return false
    }

    # takeValueFlag -- the flags whose value is the next argument. The step says
    # whether one matched and where to continue from.
    takeValueFlag: function {
        :this
        av: StringView
        argv: (List String).view
        i: u64
        n: u64
    } out argstep is {
        if av == "--src" then {
            this.srcdirs.append from: (flagValue opt: av noun: "directory" :argv :i :n)
            return (argstep taken: true at: i + 1)
        }
        if av == "--system" then {
            this.systemdir = flagValue opt: av noun: "directory" :argv :i :n
            return (argstep taken: true at: i + 1)
        }
        if av == "--line-length" then {
            this.opts.lineLength = flagU32 opt: av :argv :i :n
            this.llSet = true
            return (argstep taken: true at: i + 1)
        }
        if av == "--complexity" then {
            this.opts.complexity = flagU32 opt: av :argv :i :n
            this.fcSet = true
            return (argstep taken: true at: i + 1)
        }
        return (argstep taken: false at: i)
    }

    # takeOperand -- an argument that named no flag: a target file, unless it is
    # spelled like a flag, which is a refusal rather than a filename.
    takeOperand: function {:this av: StringView arg: String.view} is {
        if (av.startsWith prefix: "-") then {
            eu: "zl: unknown flag \{av}"
            io.eprintln eu
            os.exit code: 2
        }
        # `av` views `arg` for the whole branch chain, so the list takes its own
        # copy rather than moving the buffer out from under it
        this.paths.append arg.copy
    }

    # lintOpts -- the options a lint run threads through every rule. --arch
    # implies the default complexity threshold, unless --complexity named one.
    lintOpts: function {this: this.view} out zsource.lintopts is {
        o: this.opts
        if this.fcSet.not when this.opts.arch then o.complexity = zsource.complexityThreshold
        return o
    }

    # formatWidth -- the column the printer wraps at: --line-length when it was
    # given, and fmt's own default otherwise. Lint leaves the option at 0, which
    # turns both wrapping and W005 off.
    formatWidth: function {this: this.view} out u32 is {
        if this.llSet then return this.opts.lineLength
        return 100
    }
}

# parseArgs -- every argument from `from` on, read into a fresh CliFlags: the
# lint switches first, then the formatter's, then the value-taking flags, and
# anything left is a target file.
parseArgs: function {argv: (List String).view from: u64 n: u64} out CliFlags is {
    cf: (CliFlags
        paths: List String
        srcdirs: List String
        systemdir: "lib/system".string
        opts: zsource.defaultOpts
        check: false
        stdout: false
        diff: false
        collapse: false
        llSet: false
        fcSet: false
    )
    i: from
    for i < n loop {
        arg: (argv.get :i)
        av: arg.stringView
        known: cf.setLintSwitch :av
        if known.not then known = cf.setFormatSwitch :av
        if known.not then {
            step: cf.takeValueFlag :av :argv :i :n
            known = step.taken
            i = step.at
        }
        if known.not then cf.takeOperand :av :arg
        i = i + 1
    }
    if cf.srcdirs.length == 0 then cf.srcdirs.append from: ".".string
    return cf
}

# CLI entry point for the zl linter/formatter: parse the subcommand
# (lint / fmt / explain) and flags, then run it.
main: function is {
    argv: os.args
    n: argv.length
    if n < 2 then {
        printUsage
        os.exit code: 2
    }
    sub: (argv.get i: 1)
    sv: sub.stringView

    if sv == "-h" then {
        printUsage
        os.exit code: 0
    }
    if sv == "--help" then {
        printUsage
        os.exit code: 0
    }
    if sv == "help" then {
        printUsage
        os.exit code: 0
    }

    if sv == "-V" then {
        printVersion
        os.exit code: 0
    }
    if sv == "--version" then {
        printVersion
        os.exit code: 0
    }

    cf: parseArgs :argv from: 2 :n
    if sv == "lint" then {
        lintOpts: cf.lintOpts
        rc: (runLint
            paths: cf.paths
            srcdirs: cf.srcdirs
            systemdir: cf.systemdir.stringView
            opts: lintOpts
        )
        os.exit code: rc
    }
    isFmt: sv == "fmt"
    if sv == "format" then isFmt = true
    if isFmt then {
        lineLength: cf.formatWidth
        rc: (runFormat
            paths: cf.paths
            check: cf.check
            stdout: cf.stdout
            diff: cf.diff
            full: cf.opts.full
            srcdirs: cf.srcdirs
            systemdir: cf.systemdir.stringView
            :lineLength
            collapse: cf.collapse
        )
        os.exit code: rc
    }
    if sv == "explain" then {
        if n < 3 then {
            io.eprintln "usage: zl explain <code>"
            os.exit code: 2
        }
        code: (argv.get i: 2)
        rc: zrule.explain code: code.stringView
        os.exit code: rc
    }

    io.eprintln "zl: unknown command"
    printUsage
    os.exit code: 2
}
