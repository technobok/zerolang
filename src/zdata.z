# zdata -- a data file (`.zd`, docs/zdata.pdoc) as zc reads one. The file is a
# unit, checked as zerolang checks any unit (zcheck.check with the `.zd`
# extension, which also refuses what a data file may not hold); its values are
# read off the checked symbol table: the folded constants, a data value's
# fields with their defaults applied, a list's elements, a choice value's arm.
# The reader hands out the file's top-level unit, through which every
# definition is reached.

public: unit {
    :DataFile
    :open
    :dumpText
    :errorsText
    :errorCount
    :definition
    :fieldOf
    :textOf
    :boolOf
    :textsOf
    :isOfType
}

Ast: zast.Ast

# DataFile -- a checked data file: the check, and the file's own unit
DataFile: class {
    check: zcheck.CheckResult
    # the file's unit declaration, 0 when the check failed before it had one
    unitDecl: ztypes.declid
} as {
    # ok -- the file parsed and checked with no error
    ok: function {t: this.view} out bool is {
        return t.check.parseOk and (t.check.errorCount == 0)
    }
}

# open -- check the data file at `file` as a unit named by its stem. Its own
# directory is the first root, so the file's siblings and its hidden folder
# (`x/` beside `x.zd`) are reached first; then `srcdirs`, then `systemdir`,
# the roots zerolang's own units are found in.
open: function {
    file: StringView srcdirs: (List String).view systemdir: StringView
} out DataFile is {
    roots: List String
    roots.append (path.dirname p: file)
    for each sd: srcdirs loop roots.append from: sd.copy
    unitName: unitNameOf :file
    r: (
        zcheck.check
        srcdirs: roots
        :systemdir
        mainUnit: unitName.stringView
        overlays: List (Map String V: String)
        layer: zcheck.noLayer
        dataFile: true
    )
    ud: ztypes.declid
    {
        o: r.st
        match (
            o
        ) case some then {
            nid: zast.poolFind pool: r.prog.names text: unitName.stringView
            if nid.isZero.not then ud = (
                o.typing.declFindChild
                parentDeclId: o.typing.programRoot
                nameId: nid
            )
        } case none then null
    }
    return (DataFile check: r unitDecl: ud)
}

# errorCount -- how many errors the check found: its parse error, or every
# error of the checked file
errorCount: function {f: DataFile.view} out u64 is {
    if f.check.parseOk.not then return 1
    return f.check.errorCount
}

# errorsText -- every error, each its code and message, then where it is:
# `error[E0300]: ...` over ` --> settings.zd:2:5`
errorsText: function {f: DataFile.view} out String is {
    buf: String
    if f.check.parseOk.not then {
        root: f.check.prog.nodes.get i: f.check.prog.root
        match (
            root
        ) case error then {
            errorText e: (zast.errorDataOf ast: f.check.prog row: root) :f :buf
        } else null
        return buf
    }
    o: f.check.st
    match (
        o
    ) case some then {
        for each e: o.typing.errors loop errorText :e :f :buf
    } case none then null
    return buf
}

# errorText -- one error onto `buf`, as errorsText writes it
errorText: function {e: zast.ErrorData.view f: DataFile.view buf: String.borrow} is {
    if buf.length > 0 then buf.append "\n"
    buf.append (zast.errorLine :e)
    fno: e.fsno
    if fno.isZero when e.nodeid.isZero.not then fno = f.check.prog.fsnoForNode nodeid: e.nodeid
    if fno.isZero or (e.lineno == 0) then return
    buf.append "\n --> "
    buf.append (f.check.vfs.displayPath dentryid: fno)
    buf.append ":"
    buf.append "\{e.lineno}"
    buf.append ":"
    buf.append "\{e.colno}"
}

# definition -- the value the file's own unit defines as `name`; none when
# it defines no such value
definition: function {f: DataFile.view name: StringView} out ztypes.cval is {
    o: f.check.st
    match (
        o
    ) case some then {
        nid: zast.poolFind pool: f.check.prog.names text: name
        if nid.isZero then return ztypes.noConst
        ut: ztypecheck.declTypeIdOf st: o declId: f.unitDecl
        return (o.typing.memberConstOf parentTypeId: ut nameId: nid)
    } case none then null
    return ztypes.noConst
}

# fieldOf -- field `name` of data value `v`, its default where the
# construction left it out; none when `v` is no data value with that field
fieldOf: function {f: DataFile.view v: ztypes.cval name: StringView} out ztypes.cval is {
    if v.kind.aggKind.not then return ztypes.noConst
    o: f.check.st
    match (
        o
    ) case some then {
        nid: zast.poolFind pool: f.check.prog.names text: name
        g: o.typing.constAggs.get i: v.aggId.u64
        if g.kind.staticData.not then return ztypes.noConst
        ids: ListVal ztypes.tid
        nameIds: ListVal zast.nameid
        ztypecheck.dataFieldIds st: o tid: g.tid :ids :nameIds
        k: u32
        for k < g.itemCount while k.u64 < nameIds.length loop {
            if (nameIds.get i: k.u64) == nid then return (
                o.typing.constAggItems.get
                i: g.itemStart + k
            )
            k = k + 1
        }
    } case none then null
    return ztypes.noConst
}

# textOf -- a string value's text, "" for any other value
textOf: function {f: DataFile.view v: ztypes.cval} out String is {
    if v.kind.svalKind.not then return "".string
    o: f.check.st
    match (
        o
    ) case some then {
        return (o.typing.constStrings.get i: v.strId.u64).copy
    } case none then null
    return "".string
}

# boolOf -- whether `v` is `true`
boolOf: function {v: ztypes.cval} out bool is {
    return v.kind.armKind and (v.armName == zast.wellKnown.slot.wkTrue)
}

# textsOf -- a list's elements as text, each as textOf reads it; none for a
# value that is no list
textsOf: function {f: DataFile.view v: ztypes.cval} out List String is {
    r: List String
    if v.kind.aggKind.not then return r
    o: f.check.st
    match (
        o
    ) case some then {
        g: o.typing.constAggs.get i: v.aggId.u64
        if g.kind.staticList.not then return r
        k: u32
        for k < g.itemCount loop {
            r.append (textOf :f v: (o.typing.constAggItems.get i: g.itemStart + k))
            k = k + 1
        }
    } case none then null
    return r
}

# isOfType -- whether `v` is a data value of type `typeName` that unit
# `unitName` declares (a schema's type, `toolchain.project`)
isOfType: function {
    f: DataFile.view v: ztypes.cval unitName: StringView typeName: StringView
} out bool is {
    if v.kind.aggKind.not then return false
    o: f.check.st
    match (
        o
    ) case some then {
        un: zast.poolFind pool: f.check.prog.names text: unitName
        tn: zast.poolFind pool: f.check.prog.names text: typeName
        if un.isZero or tn.isZero then return false
        ud: o.typing.declFindChild parentDeclId: o.typing.programRoot nameId: un
        td: o.typing.declFindChild parentDeclId: ud nameId: tn
        if td.isZero then return false
        return (
            (o.typing.constAggs.get i: v.aggId.u64).tid ==
            (ztypecheck.declTypeIdOf st: o declId: td)
        )
    } case none then null
    return false
}

# dumpText -- every value the file defines, written back as zdata: one line per
# definition, a nested unit as a `unit { }` block, each data value with all its
# fields (defaults included). Types are the file's schema, not its values, and
# are left out.
dumpText: function {f: DataFile.view} out String is {
    buf: String
    o: f.check.st
    match (
        o
    ) case some then {
        dumpUnit st: o ast: f.check.prog unitDecl: f.unitDecl indent: 0 :buf
    } case none then null
    return buf
}

# dumpUnit -- the values unit `unitDecl` defines, in declaration order
dumpUnit: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    indent: u64
    buf: String.borrow
} is {
    ut: ztypecheck.declTypeIdOf :st declId: unitDecl
    pad: " ".repeated n: indent
    n: st.typing.declChildSlots declId: unitDecl
    i: u64
    for i < n loop {
        cd: st.typing.declChildAt declId: unitDecl index: i
        i = i + 1
        isUnit: false
        cname: zast.nameid
        {
            co: st.typing.decls.get i: cd
            isUnit = co.kind.unitDecl
            cname = co.name
        }
        nm: zast.nameTextAt :ast ref: cname
        if isUnit then {
            buf.append "\{pad}\{nm}: unit {\n"
            dumpUnit :st :ast unitDecl: cd indent: indent + 4 :buf
            buf.append "\{pad}}\n"
        } else {
            v: st.typing.memberConstOf parentTypeId: ut nameId: cname
            if v.kind.none.not then {
                buf.append "\{pad}\{nm}: "
                buf.append (valueText :st :ast :v)
                buf.append "\n"
            }
        }
    }
}

# valueText -- one folded value written as zdata
valueText: function {st: zenv.ZSymbolTable.view ast: Ast.view v: ztypes.cval} out String is {
    if v.kind.ivalKind then return (numberText :st :v text: (ztypecheck.constIntText :st :v))
    if v.kind.fvalKind then return (numberText :st :v text: (ztypecheck.constFloatText :st :v))
    if v.kind.svalKind then return (quoted s: (st.typing.constStrings.get i: v.strId.u64).stringView
    )
    if v.kind.armKind then return (armText :st :ast tid: v.armTid arm: v.armName)
    if v.kind.aggKind then return (aggText :st :ast row: v.aggId)
    return "?".string
}

# numberText -- a number, suffixed with its type when it has one (`5.u8`)
numberText: function {st: zenv.ZSymbolTable.view v: ztypes.cval text: String} out String is {
    t: text.copy
    if v.numTid.isZero then return t
    t.append "."
    t.append (st.reg.nameOf tid: v.numTid)
    return t
}

# armText -- an arm: `true` and `false` bare, any other through its type
armText: function {
    st: zenv.ZSymbolTable.view ast: Ast.view tid: ztypes.tid arm: zast.nameid
} out String is {
    an: zast.nameTextAt :ast ref: arm
    if tid == st.typing.boolTid then return an.copy
    return (pathText type: (st.reg.nameOf :tid) leaf: an.stringView)
}

# pathText -- `type.leaf`, a type's member as zdata writes it
pathText: function {type: String leaf: StringView} out String is {
    t: type.copy
    t.append "."
    t.append leaf
    return t
}

# aggText -- a list, a data value or a choice value, whole
aggText: function {st: zenv.ZSymbolTable.view ast: Ast.view row: u64} out String is {
    g: st.typing.constAggs.get i: row
    if g.kind.staticList then return (listText :st :ast :row)
    if g.kind.staticChoice then return (choiceText :st :ast :row)
    return (dataText :st :ast :row)
}

# listText -- a static list: `list { a b }`, each label written before its
# element
listText: function {st: zenv.ZSymbolTable.view ast: Ast.view row: u64} out String is {
    g: st.typing.constAggs.get i: row
    if g.itemCount == 0 then return "list {}".string
    t: "list {".string
    k: u64
    for k < g.itemCount loop {
        t.append " "
        if k < g.labelCount then {
            lb: st.typing.constAggLabels.get i: g.labelStart.u64 + k
            if lb.isZero.not then {
                t.append (zast.nameTextAt :ast ref: lb)
                t.append ": "
            }
        }
        t.append (valueText :st :ast v: (st.typing.constAggItems.get i: g.itemStart.u64 + k))
        k = k + 1
    }
    t.append " }"
    return t
}

# choiceText -- a choice value: its arm, and in parentheses with its value
# when the arm carries one
choiceText: function {st: zenv.ZSymbolTable.view ast: Ast.view row: u64} out String is {
    g: st.typing.constAggs.get i: row
    arm: (
        pathText
        type: (st.reg.nameOf tid: g.tid)
        leaf: (zast.nameTextAt :ast ref: g.arm).stringView
    )
    if g.itemCount == 0 then return arm
    t: "(".string
    t.append arm
    t.append " "
    t.append (valueText :st :ast v: (st.typing.constAggItems.get i: g.itemStart.u64))
    t.append ")"
    return t
}

# dataText -- a data value: `(type field: value ...)`, every field in declared
# order, its default where the construction left it out
dataText: function {st: zenv.ZSymbolTable.view ast: Ast.view row: u64} out String is {
    g: st.typing.constAggs.get i: row
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
    ztypecheck.dataFieldIds :st tid: g.tid :ids :nameIds
    t: "(".string
    t.append (st.reg.nameOf tid: g.tid)
    k: u64
    for k < g.itemCount while k < nameIds.length loop {
        t.append " "
        t.append (zast.nameTextAt :ast ref: (nameIds.get i: k))
        t.append ": "
        t.append (valueText :st :ast v: (st.typing.constAggItems.get i: g.itemStart.u64 + k))
        k = k + 1
    }
    t.append ")"
    return t
}

# unitNameOf -- a data file's unit name: its file name without `.zd`
unitNameOf: function {file: StringView} out String is {
    base: path.baseName p: file
    sfx: base.stringView.stripSuffix s: ".zd"
    match (
        sfx
    ) case some then {
        return sfx.string
    } case none then {
        return base.copy
    }
}

# quoted -- a string as a zdata literal: in double quotes, with `\` and `"`
# and the control characters escaped
quoted: function {s: StringView} out String is {
    t: "\"".string
    bv: s.byteView
    i: u64
    for i < bv.length loop {
        b: bv.get :i
        i = i + 1
        if b == 34 then {
            t.append "\\\""
        } else if b == 92 then {
            t.append "\\\\"
        } else if b == 10 then {
            t.append "\\n"
        } else if b == 9 then {
            t.append "\\t"
        } else {
            t.appendByte b
        }
    }
    t.append "\""
    return t
}
