# zversion -- the version the three tools report. The two halves are kept
# apart on purpose: `semver` is the release number alone, which is what a
# machine-readable field should carry (zls reports it over LSP, where a
# golden pins it), while `versionLine` adds the build stamp and so changes
# with every commit.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :semver
    :versionLine
}

# semver -- the release number. Bump it here and nowhere else.
semver: function out String is {
    return "0.1.0".string
}

# versionLine -- what `--version` prints for `tool`, with no trailing
# newline. The build stamp is SemVer build metadata and is present only
# when the build supplied one, so a tree built without git still reports a
# well-formed version; the compiler that built the binary always is.
#
#   zc (zerolang) 0.1.0+2ad0b065 (2026-08-07) [gcc 15.2.0]
#   zc (zerolang) 0.1.0 [gcc 15.2.0]
versionLine: function {tool: StringView} out String is {
    buf: String
    buf.append tool
    buf.append " (zerolang) "
    ver: semver
    buf.append ver
    commit: os.buildCommit
    if commit.length > 0 then {
        buf.append "+"
        buf.append commit
        date: os.buildDate
        if date.length > 0 then {
            buf.append " ("
            buf.append date
            buf.append ")"
        }
    }
    cc: os.buildCompiler
    if cc.length > 0 then {
        buf.append " ["
        buf.append cc
        buf.append "]"
    }
    return buf
}
