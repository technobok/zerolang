# SQL dump of compiler state, ported from src/zsqldump.py.
#
# Serialises the parsed program and the typecheck output as SQL (schema
# DDL, then INSERT rows) for the differential oracle. This slice emits the
# parse-derived tables a skeleton typecheck can populate -- files,
# ast_nodes and unit. The type / typed_node / symbol-table / conformance
# stages arrive as the typechecker port grows.
#
# The ported AST carries no token or fsno linkage, so the tokens table and
# the ast_nodes token_id / file_id columns are emitted empty / NULL (token
# and node identity are already covered by the lexer and parser
# differentials). There is no emitter dependency: the emitted_lines stage
# is omitted. Only the three populated tables are declared in the schema;
# the dump is compared by loading it into SQLite and projecting each table
# id-independently, so the declarations need only carry the queried
# columns.
#
# Output is accumulated on the ZDumper's `acc` field: every emitter is a
# method that appends to it and recurses through `this`, mirroring the
# parser's method-recursion style (an owned-String accumulator threaded by
# return value runs into self-reassignment ownership errors).

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :dumpCanon
    :dumpSql
}

Node: zast.Node
Ast: zast.Ast

# --- SQL value formatting (stateless) ---

# sqlStr -- `s` as a SQL single-quoted string literal, embedded quotes doubled.
sqlStr: function {s: StringView} out String is {
    inner: s.replace needle: "'" replacement: "''"
    acc: "'".string
    acc.append s: inner
    acc.append s: "'"
    return acc
}


# boolNum -- SQL integer boolean.
boolNum: function {b: bool} out String is {
    match (
        b
    ) case true then {
        return "1".string
    } case false then {
        return "0".string
    }
}

# optTidStr -- an optional TYPE id as decimal text, or "NULL". A sibling of
# optIdStr rather than a conversion at each call: the dump projects several
# optional tid columns and unwrapping at the boundary would lose the space.
# constValueText -- a compile-time value as the dump's const_value column:
# kind-tagged, payload by id rather than by text, so no user string ever
# reaches the SQL and nothing needs quoting.
constValueText: function {v: ztypes.cval} out String is {
    if v.kind.ivalKind then return "IVAL:\{v.ival}"
    if v.kind.fvalKind then return "FVAL:\{v.fval}"
    if v.kind.svalKind then return "SVAL:#\{v.strId}"
    if v.kind.armKind then return "ARM:\{v.armTid}#\{v.armName}"
    return "NONE".string
}

# constValueCanonText -- the same value for the CANONICAL dump, with every id
# resolved: an arm reads as `ARM:<type>.<arm>` and a string as its text. Raw
# ids would make the golden move whenever an unrelated type or pool entry was
# added ahead of it, which is the whole reason the canon form exists.
constValueCanonText: function {
    pool: zast.StringPool.view
    st: zenv.ZSymbolTable
    v: ztypes.cval
} out String is {
    if v.kind.armKind then {
        tn9: canonTypeName reg: st.reg tid: v.armTid
        # bind the pool text ONCE and never reassign into it: a `get` hands
        # back a non-owning shallow copy, so assigning one over an owned String
        # frees that String's buffer and leaves a pointer the pool still owns
        # to be freed again at scope exit
        if v.armName.isZero then return "ARM:\{tn9}.?"
        an9: pool.texts.get i: (v.armName.u32 - 1).u64
        return "ARM:\{tn9}.\{an9}"
    }
    if v.kind.svalKind then {
        if v.strId == 0 then return "SVAL:".string
        if v.strId.u64 > st.typing.constStrings.length then return "SVAL:?".string
        sv9: st.typing.constStrings.get i: (v.strId - 1).u64
        return "SVAL:\{sv9}"
    }
    return (constValueText :v)
}

optTidStr: function {o: optionval ztypes.tid} out String is {
    match (
        o
    ) case some then {
        return "\{o.u64}"
    } case none then {
        return "NULL".string
    }
}

# optIdStr -- an optional id as decimal text, or "NULL".
optVidStr9: function {o: optionval ztypes.vid} out String is {
    match (
        o
    ) case some then {
        ov9: o + 0
        return "\{ov9}"
    } case none then {
        return "NULL".string
    }
}

optIdStr: function {o: optionval u64} out String is {
    match (
        o
    ) case some then {
        return "\{o}"
    } case none then {
        return "NULL".string
    }
}

# definedUnitOf9 -- a type's defining unit as an Option, derived off the
# Decl parent chain.
definedUnitOf9: function {st: zenv.ZSymbolTable tid: ztypes.tid} out (Option of: String) is {
    nm9: ztypecheck.unitNameOfTid ty: st.typing reg: st.reg tid: (ztypes.tid.create from: tid.u64)
    if nm9.length == 0 then return (Option.none String)
    return (Option.some nm9)
}

# unitdefNodeId -- the nodeid of the unit row an id names (0 when the id does
# not name a unit). The row view is scoped to the fetch.
unitdefNodeId: function {ast: Ast.view nId: zast.nodeid} out u32 is {
    out9: zast.nodeid
    {
        n9: ast.nodes.get i: (nId - 1).u64
        if n9.unitdef then out9 = n9.nodeid
    }
    return out9
}

# schemaSql -- DDL for the populated tables. SQLite ignores the unused
# REFERENCES/DEFAULT decoration the reference carries, so only the columns
# the projections read are declared.
schemaSql: function {} out String is {
    acc: String
    acc.append s: "CREATE TABLE IF NOT EXISTS files (file_id INTEGER PRIMARY KEY, path TEXT NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS ast_nodes (node_id INTEGER PRIMARY KEY, kind TEXT NOT NULL, token_id INTEGER, name TEXT, file_id INTEGER, start_line INTEGER, start_col INTEGER, synth_origin TEXT);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS unit (unit_id INTEGER PRIMARY KEY, name TEXT NOT NULL, is_main INTEGER NOT NULL, unit_type_id INTEGER);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS types (type_id INTEGER PRIMARY KEY, name TEXT NOT NULL, typetype TEXT NOT NULL, is_valtype INTEGER, is_generic INTEGER, generic_origin_id INTEGER, needs_destructor INTEGER, destructor_name TEXT, is_heap_allocated INTEGER, defined_in_unit TEXT);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS decl (decl_id INTEGER PRIMARY KEY, name TEXT NOT NULL, parent_decl_id INTEGER NOT NULL, kind TEXT NOT NULL, node_id INTEGER NOT NULL, type_id INTEGER NOT NULL, ownership INTEGER NOT NULL, is_fnptr_field INTEGER NOT NULL, grants_private INTEGER NOT NULL, lock_field_decl_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS decl_child (parent_decl_id INTEGER NOT NULL, name TEXT NOT NULL, child_decl_id INTEGER NOT NULL, position INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS ref_decl (node_id INTEGER PRIMARY KEY, decl_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS typed_nodes (node_id INTEGER PRIMARY KEY, type_id INTEGER, is_const INTEGER, const_value TEXT);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS member_const (parent_type_id INTEGER NOT NULL, name_id INTEGER NOT NULL, value TEXT NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS conformance (conformance_id INTEGER PRIMARY KEY, impl_type_id INTEGER NOT NULL, spec_type_id INTEGER NOT NULL, label TEXT NOT NULL, is_facet INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS scope (scope_id INTEGER PRIMARY KEY, parent_id INTEGER, kind TEXT NOT NULL, name TEXT NOT NULL, depth INTEGER NOT NULL, opened_at_seq INTEGER NOT NULL, closed_at_seq INTEGER, unreachable INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS variable (variable_id INTEGER PRIMARY KEY, ztype_id INTEGER, ownership TEXT NOT NULL, is_private_access INTEGER NOT NULL, borrow_origin TEXT, synth_origin TEXT);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS entry (entry_id INTEGER PRIMARY KEY, scope_id INTEGER NOT NULL, position INTEGER NOT NULL, name TEXT NOT NULL, ztype_id INTEGER NOT NULL, is_definition INTEGER NOT NULL, variable_id INTEGER, original_ztype_id INTEGER, is_taken INTEGER NOT NULL, taken_at_line INTEGER, taken_at_col INTEGER, taken_at_file INTEGER);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS narrowed_subtype (entry_id INTEGER NOT NULL, name TEXT NOT NULL, type_id INTEGER, excluded INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS generic_child (parent_id INTEGER NOT NULL, arg_key INTEGER NOT NULL, child_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS generic_arg (spec_id INTEGER NOT NULL, ordinal INTEGER NOT NULL, arg_id INTEGER NOT NULL, arg_is_value INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS atom_variable (node_id INTEGER PRIMARY KEY, variable_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS implicit_create (node_id INTEGER PRIMARY KEY, type_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS arm_predicate (node_id INTEGER PRIMARY KEY, type_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS tag_read (node_id INTEGER PRIMARY KEY, type_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS tag_accessor (type_id INTEGER PRIMARY KEY, name TEXT NOT NULL, tag_type_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS post_guard (node_id INTEGER PRIMARY KEY, name TEXT NOT NULL, type_id INTEGER NOT NULL, arm TEXT NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS arg_disposition (node_id INTEGER PRIMARY KEY, disposition INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS variable_origin (variable_id INTEGER PRIMARY KEY, is_param INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS call_generic_binding (call_node INTEGER NOT NULL, param_name INTEGER NOT NULL, type_id INTEGER NOT NULL, PRIMARY KEY (call_node, param_name));\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS binop_operator (mono_id INTEGER NOT NULL, node_id INTEGER NOT NULL, owner_type_id INTEGER NOT NULL, method_id INTEGER NOT NULL, PRIMARY KEY (mono_id, node_id));\n"
    return acc
}

# optBoolSql -- an optional bool as SQL "1"/"0", or "NULL".
optBoolSql: function {o: optionval bool} out String is {
    match (
        o
    ) case some then {
        return (boolNum b: o)
    } case none then {
        return "NULL".string
    }
}

# optStrSql -- an optional String as a SQL string literal, or "NULL".
# ownOptStr -- copy a borrowed OptionView<String> (e.g. a String-value map's
# get, which now returns a locked view) into an owned Option<String> for the
# SQL formatters. The dump path is cold, so the copy is irrelevant.
ownOptStr: function {o: OptionView String} out Option String is {
    match (
        o
    ) case some then {
        return (Option.some o.copy)
    } case none then {
        return (Option.none String)
    }
}

# an optional string as a SQL literal (NULL when none).
# sqlStrOrNull -- a quoted SQL string, or NULL when the value is absent.
sqlStrOrNull: function {s: StringView present: bool} out String is {
    if (present) == false then return "NULL".string
    return (sqlStr :s)
}

optStrSql: function {o: Option String} out String is {
    match (
        o
    ) case some then {
        return (sqlStr s: o.stringview)
    } case none then {
        return "NULL".string
    }
}

# paramOwnSql -- a member's param-ownership as its integer code
# (TAKE=0, BORROW=1, LOCK=2), or "NULL" when it carries no ownership.
paramOwnSql: function {o: optionval ztypes.zparamownership} out String is {
    match (
        o
    ) case some then {
        return "\{ztypes.zparamownershipInt o}"
    } case none then {
        return "NULL".string
    }
}

# varOwnSql -- a variable's ownership enum as a SQL string literal.
varOwnSql: function {o: optionval ztypes.zownership} out String is {
    match (
        o
    ) case some then {
        ow: o
        ownStr: (ztypes.zownershipName ow)
        return (sqlStr s: ownStr.stringview)
    } case none then {
        return "'BORROWED'".string
    }
}

# optBoolNumOr0 -- an optional bool as SQL "1"/"0", defaulting to "0".
optBoolNumOr0: function {o: optionval bool} out String is {
    match (
        o
    ) case some then {
        return (boolNum b: o)
    } case none then {
        return "0".string
    }
}

# originSql -- a borrow/synth origin ("" or absent => NULL), else a SQL string.
originSql: function {o: Option String} out String is {
    match (
        o
    ) case some then {
        if o.length == 0 then {
            return "NULL".string
        } else {
            return (sqlStr s: o.stringview)
        }
    } case none then {
        return "NULL".string
    }
}

# originKindSql -- a variable's origin kind as canon text (param/local), or
# "NULL" when unstamped (unit-level variables carry no origin stamp).
originKindSql: function {o: optionval bool} out String is {
    match (
        o
    ) case some then {
        if o then return "param".string
        return "local".string
    } case none then {
        return "NULL".string
    }
}

# argAtomName -- the identifier name of the atom node at `id` (1-based), else
# "" (non-atom arguments carry no stable canon name).
argAtomName: function {ast: Ast.view id: u64} out String is {
    if id == 0 then return "".string
    n: ast.nodes.get i: (id - 1).u64
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# --- the dumper ---

# the SQL-dump builder: accumulates INSERT rows for every compiler table.
ZDumper: class {
    acc: String
} as {
    # emit -- one ast_nodes row. token_id and file_id are NULL (no token
    # linkage in the ported AST); synth_origin is NULL (the parser sets
    # none). nameSql is the pre-escaped context label.
    emit: function {:this id: u32 line: u32 col: u32 kind: StringView nameSql: StringView} is {
        row: "INSERT INTO ast_nodes VALUES (\{id}, '\{kind}', NULL, \{nameSql}, NULL, \{line}, \{col}, NULL);\n"
        this.acc.append s: row
    }

    # files stage.
    appendFiles: function {:this vfs: zvfs.ZVfs} is {
        ids: (ListVal zvfs.fsno)
        paths: (List String)
        vfs.fileTable outIds: ids outPaths: paths
        i: u64
        n: ids.length
        for i < n loop {
            fid: ids.get :i
            p: paths.get :i
            ps: sqlStr s: p.stringview
            row: "INSERT INTO files VALUES (\{fid.u64}, \{ps});\n"
            this.acc.append s: row
            i = i + 1
        }
    }

    # walkOpt -- walk an optional child when present.
    # walkOptAt -- the id-taking entry (0 = absent).
    walkOptAt: function {:this ast: Ast.view oId: zast.nodeid nameSql: StringView} is {
        if oId.isZero then return
        o9: ast.nodes.get i: (oId - 1).u64
        this.walkNode :ast node: o9 :nameSql
    }

    # walkUnwrapped -- walk a namedoperation child's wrapped operation, not
    # the wrapper. Used in the positions the reference stores as name->node
    # maps (unit body, function parameters / as-items, object members, if /
    # for conditions): node_children yields the values, so the wrapper
    # produces no ast_nodes row.
    walkUnwrapped: function {:this ast: Ast.view wrapper: Node.view nameSql: StringView} is {
        match (
            wrapper
        ) case namedoperation then {
            this.walkNode :ast node: (ast.nodes.get i: (wrapper.operation - 1).u64) :nameSql
        } else {
            this.walkNode :ast node: wrapper :nameSql
        }
    }

    # walkNode -- emit `node`'s row (labelled nameSql) and recurse. Mirrors
    # the reference node_children: wrapper positions unwrap (walkUnwrapped),
    # list positions (call arguments, data elements, for postconditions, if
    # / case clauses, statements, string parts) keep their child ast.nodes.
    walkNode: function {:this ast: Ast.view node: Node.view nameSql: StringView} is {
        match (
            node
        ) case error then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Error" :nameSql
        } case placeholder then null case atomid then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "AtomId" :nameSql
        } case labelvalue then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "LabelValue" :nameSql
        } case stringchunk then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "StringChunk" :nameSql
        } case binop then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "BinOp" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.lhs - 1).u64) :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.operator - 1).u64) :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.rhs - 1).u64) :nameSql
        } case atomstring then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "AtomString" :nameSql
            spiter: node.stringparts.iterate
            for sp: spiter loop {
                this.walkNode :ast node: (ast.nodes.get i: (sp - 1).u64) :nameSql
            }
        } case dottedpath then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "DottedPath" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.parent - 1).u64) :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.child - 1).u64) :nameSql
        } case call then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Call" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.callable - 1).u64) :nameSql
            aiter: node.arguments.iterate
            for arg: aiter loop {
                this.walkNode :ast node: (ast.nodes.get i: (arg - 1).u64) :nameSql
            }
        } case typeofexpr then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "TypeOfExpr" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.source - 1).u64) :nameSql
        } case namedoperation then {
            (this.emit
                id: node.nodeid
                line: node.lineno
                col: node.colno
                kind: "NamedOperation"
                :nameSql
            )
            this.walkNode :ast node: (ast.nodes.get i: (node.operation - 1).u64) :nameSql
        } case datablock then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Data" :nameSql
            eiter: node.elements.iterate
            for el: eiter loop {
                this.walkNode :ast node: (ast.nodes.get i: (el - 1).u64) :nameSql
            }
            this.walkOptAt :ast oId: node.outType :nameSql
        } case yieldexpr then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Yield" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.expr - 1).u64) :nameSql
        } case statement then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Statement" :nameSql
            sliter: node.statements.iterate
            for lnId9: sliter loop {
                this.walkNode :ast node: (ast.nodes.get i: (lnId9 - 1).u64) :nameSql
            }
        } case statementline then {
            (this.emit
                id: node.nodeid
                line: node.lineno
                col: node.colno
                kind: "StatementLine"
                :nameSql
            )
            this.walkNode :ast node: (ast.nodes.get i: (node.statementline - 1).u64) :nameSql
        } case assignment then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Assignment" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.value - 1).u64) :nameSql
        } case reassignment then {
            (this.emit
                id: node.nodeid
                line: node.lineno
                col: node.colno
                kind: "Reassignment"
                :nameSql
            )
            this.walkNode :ast node: (ast.nodes.get i: (node.topath - 1).u64) :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.value - 1).u64) :nameSql
        } case swapstmt then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Swap" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.lhs - 1).u64) :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.rhs - 1).u64) :nameSql
        } case expression then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Expression" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.expression - 1).u64) :nameSql
        } case ifexpr then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "If" :nameSql
            cliter: node.clauses.iterate
            for cl: cliter loop {
                this.walkNode :ast node: (ast.nodes.get i: (cl - 1).u64) :nameSql
            }
            this.walkOptAt :ast oId: node.elseclause :nameSql
        } case ifclause then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "IfClause" :nameSql
            coiter: node.conditions.iterate
            for coId9: coiter loop {
                this.walkUnwrapped :ast wrapper: (ast.nodes.get i: (coId9 - 1).u64) :nameSql
            }
            this.walkNode :ast node: (ast.nodes.get i: (node.statement - 1).u64) :nameSql
        } case forexpr then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "For" :nameSql
            fciter: node.conditions.iterate
            for fc: fciter loop {
                this.walkUnwrapped :ast wrapper: (ast.nodes.get i: (fc - 1).u64) :nameSql
            }
            this.walkOptAt :ast oId: node.body :nameSql
            fpiter: node.postconditions.iterate
            for fp: fpiter loop {
                this.walkNode :ast node: (ast.nodes.get i: (fp - 1).u64) :nameSql
            }
        } case doexpr then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Do" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.statement - 1).u64) :nameSql
        } case withexpr then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "With" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.value - 1).u64) :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.body - 1).u64) :nameSql
        } case caseexpr then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Case" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.subject - 1).u64) :nameSql
            cciter: node.clauses.iterate
            for cc: cciter loop {
                this.walkNode :ast node: (ast.nodes.get i: (cc - 1).u64) :nameSql
            }
            this.walkOptAt :ast oId: node.elseclause :nameSql
        } case caseclause then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "CaseClause" :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.matcharm - 1).u64) :nameSql
            this.walkNode :ast node: (ast.nodes.get i: (node.statement - 1).u64) :nameSql
        } case functiondef then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Function" :nameSql
            this.walkOptAt :ast oId: node.returntype :nameSql
            piter: node.parameters.iterate
            for pmId9: piter loop {
                pm: ast.nodes.get i: (pmId9 - 1).u64
                this.walkUnwrapped :ast wrapper: pm :nameSql
            }
            this.walkOptAt :ast oId: node.body :nameSql
            faiter: node.asItems.iterate
            for amId9: faiter loop {
                am: ast.nodes.get i: (amId9 - 1).u64
                this.walkUnwrapped :ast wrapper: am :nameSql
            }
        } case objectdef then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "ObjectDef" :nameSql
            oiiter: node.isItems.iterate
            for oiId9: oiiter loop {
                oi: ast.nodes.get i: (oiId9 - 1).u64
                this.walkUnwrapped :ast wrapper: oi :nameSql
            }
            oaiter: node.asItems.iterate
            for oaId9: oaiter loop {
                oa: ast.nodes.get i: (oaId9 - 1).u64
                this.walkUnwrapped :ast wrapper: oa :nameSql
            }
        } case unitdef then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Unit" :nameSql
            ubiter: node.body.iterate
            for ub: ubiter loop {
                ubNode9: ast.nodes.get i: (ub - 1).u64
                this.walkUnwrapped :ast wrapper: ubNode9 :nameSql
            }
        } case program then {
            this.emit id: node.nodeid line: node.lineno col: node.colno kind: "Program" :nameSql
        }
    }

    # appendUnitDefAndBody -- the unit's own ast_nodes row (labelled with
    # the unit name), then each body definition's subtree labelled
    # "<unit>.<def>". Mirrors the reference _collect_ast_nodes: the unit
    # node is emitted directly and each definition subtree is walked under
    # its own label.
    appendUnitDefAndBody: function {:this ast: Ast.view unitdef: Node.view uname: StringView} is {
        match (
            unitdef
        ) case unitdef then {
            unameSql: sqlStr s: uname
            (this.emit
                id: unitdef.nodeid
                line: unitdef.lineno
                col: unitdef.colno
                kind: "Unit"
                nameSql: unameSql.stringview
            )
            biter: unitdef.body.iterate
            for bm: biter loop {
                bmNode9: ast.nodes.get i: (bm - 1).u64
                this.appendBodyMember :ast member: bmNode9 :uname
            }
        } else null
    }

    appendBodyMember: function {:this ast: Ast.view member: Node.view uname: StringView} is {
        match (
            member
        ) case namedoperation then {
            dname: zast.nameTextAt :ast ref: member.name
            label: "\{uname}.\{dname}"
            labelSql: sqlStr s: label.stringview
            (this.walkNode
                :ast
                node: (ast.nodes.get i: (member.operation - 1).u64)
                nameSql: labelSql.stringview
            )
        } else null
    }

    appendNodes: function {:this program: Node.view} is {
        match (
            program
        ) case program then {
            uCnt9a: program.ast.units.length
            uIdx9a: u64
            for uIdx9a < uCnt9a loop {
                uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9a))
                uIdx9a = uIdx9a + 1
                this.appendUnitFromNamedOp ast: program.ast unitNamedOpId: uId9
            }
        } else null
    }

    appendUnitFromNamedOp: function {:this ast: Ast.view unitNamedOpId: u32} is {
        unitNamedOp: ast.nodes.get i: (unitNamedOpId - 1).u64
        if unitNamedOp.namedoperation then {
            uname: zast.nameTextAt :ast ref: unitNamedOp.name
            (this.appendUnitDefAndBody
                :ast
                unitdef: (ast.nodes.get i: (unitNamedOp.operation - 1).u64)
                uname: uname.stringview
            )
        }
    }

    # unit stage.
    appendUnits: function {:this program: Node.view typing: ztyping.ZTyping.view} is {
        match (
            program
        ) case program then {
            uCnt9b: program.ast.units.length
            uIdx9b: u64
            for uIdx9b < uCnt9b loop {
                uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9b))
                uIdx9b = uIdx9b + 1
                (this.appendUnitRow ast: program.ast
                    unitNamedOpId: uId9
                    mainName: program.mainUnitName.stringview
                    :typing
                )
            }
        } else null
    }

    appendUnitRow: function {
        :this
        ast: Ast.view
        unitNamedOpId: u32
        mainName: StringView
        typing: ztyping.ZTyping.view
    } is {
        unitNamedOp: ast.nodes.get i: (unitNamedOpId - 1).u64
        if unitNamedOp.namedoperation then {
            uname: zast.nameTextAt :ast ref: unitNamedOp.name
            uid: unitdefNodeId :ast nId: unitNamedOp.operation
            isMain: uname.stringview == mainName
            unameSql: sqlStr s: uname.stringview
            isMainStr: boolNum b: isMain
            utidStr: optTidStr o: (typing.unitTypesById.get key: uid.u64)
            row: "INSERT INTO unit VALUES (\{uid}, \{unameSql}, \{isMainStr}, \{utidStr});\n"
            this.acc.append s: row
        }
    }

    # appendTypes -- one row per registered type, read by sequential id from
    # the registry. The dumper emits the full (small) registry; the
    # differential filters to the example's own unit via defined_in_unit.
    appendTypes: function {:this st: zenv.ZSymbolTable pool: zast.StringPool.view} is {
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            if (st.reg.typeValid tid: (ztypes.tid.create from: tid.u64)) == false then {
                tid = tid.next
                continue
            }
            zt: st.reg.typeById.get i: tid
            nameSql: sqlStr s: zt.name.stringview
            ttName: ztypes.ztypetypeName t: zt.typetype
            ttSql: sqlStr s: ttName.stringview
            valSql: optBoolSql o: zt.isValtype
            genSql: boolNum b: zt.isgeneric
            goSql: optTidStr o: zt.genericOriginId
            dnid9: zt.destructorNameId
            ndSql: boolNum b: (dnid9) != 0
            dnTx9: zast.poolTextAt :pool ref: dnid9
            dnSql: sqlStrOrNull s: dnTx9.stringview present: (dnid9) != 0
            heapSql: boolNum b: zt.isHeapAllocated
            duSql: optStrSql o: (definedUnitOf9 :st :tid)
            row: "INSERT OR IGNORE INTO types VALUES (\{tid}, \{nameSql}, \{ttSql}, \{valSql}, \{genSql}, \{goSql}, \{ndSql}, \{dnSql}, \{heapSql}, \{duSql});\n"
            this.acc.append s: row
            tid = tid.next
        }
    }

    # appendDecls -- one decl row per declaration and one decl_child row
    # per namespace edge (the declaration tree the def indexer builds).
    appendDecls: function {:this ast: Ast.view typing: ztyping.ZTyping} is {
        n: typing.decls.length
        did: u64
        for did < n loop {
            did = did + 1
            if (typing.declValid id: (ztypes.declid.create from: did)) then {
                dOpt: typing.decls.get i: (did - 1)
                dnm: String
                if dOpt.name > 0 then {
                    dnB9: ast.names.texts.get i: (dOpt.name - 1).u64
                    dnm = dnB9.copy
                }
                nameSql: sqlStr s: dnm.stringview
                kn9: ztyping.declkindName k: dOpt.kind
                kindSql: sqlStr s: kn9.stringview
                ownSql: ztypes.zparamownershipInt dOpt.ownership
                fpSql: boolNum b: dOpt.fnptrField
                gpSql: boolNum b: dOpt.grantsPrivate
                row: "INSERT OR IGNORE INTO decl VALUES (\{did}, \{nameSql}, \{dOpt.parent + 0}, \{kindSql}, \{dOpt.node}, \{dOpt.typeId}, \{ownSql}, \{fpSql}, \{gpSql}, \{dOpt.lockFieldDecl});\n"
                this.acc.append s: row
                pos9: u64
                cnt9: dOpt.children.length
                for pos9 < cnt9 loop {
                    ce9: dOpt.children.get i: pos9
                    cnm: String
                    if ce9.nameId > 0 then {
                        cnB9: ast.names.texts.get i: (ce9.nameId - 1).u64
                        cnm = cnB9.copy
                    }
                    cnSql: sqlStr s: cnm.stringview
                    crow: "INSERT OR IGNORE INTO decl_child VALUES (\{did}, \{cnSql}, \{ce9.declId + 0}, \{pos9});\n"
                    this.acc.append s: crow
                    pos9 = pos9 + 1
                }
            }
        }
    }

    # appendSynthNodes -- ast_nodes rows for typecheck-synthesised nodes (the
    # call-arg hoist temps); the parsed-program walk cannot reach them. Empty
    # under signature-only runs.
    appendSynthNodes: function {:this typing: ztyping.ZTyping.view} is {
        siter: typing.synthNodes.iterate
        for sn: siter loop {
            ns: sqlStr s: sn.label.stringview
            (this.emit
                id: sn.nodeid
                line: sn.lineno
                col: sn.colno
                kind: sn.kind.stringview
                nameSql: ns.stringview
            )
        }
    }

    # appendTypedNodes -- one row per node->type stamp (typing.nodeType),
    # carrying the node's compile-time value when the typechecker folded one.
    # A const-only node with no type stamp emits no row: it would carry a NULL
    # type_id, which the node-type differential's JOIN drops anyway.
    appendTypedNodes: function {:this typing: ztyping.ZTyping.view} is {
        n9: typing.nodeType.length
        i9: u64
        for i9 < n9 loop {
            v9: typing.nodeType.get i: i9
            i9 = i9 + 1
            if v9 > 0 then {
                isc9: 0
                cvs9: "NULL".string
                cg9: typing.nodeConst.get key: i9
                match (
                    cg9
                ) case some then {
                    isc9 = 1
                    cvs9 = "'\{constValueText v: cg9}'"
                } case none then null
                row: "INSERT OR IGNORE INTO typed_nodes VALUES (\{i9}, \{v9}, \{isc9}, \{cvs9});\n"
                this.acc.append s: row
            }
        }
    }

    # appendAtomStamps -- one row per atom-use variable-id stamp and per
    appendAtomStamps: function {:this typing: ztyping.ZTyping} is {
        with avit: typing.atomVariableId.iterateItems do for av: avit loop {
            row: "INSERT OR IGNORE INTO atom_variable VALUES (\{av.key}, \{av.value});\n"
            this.acc.append s: row
        }
        with icit: typing.implicitCreate.iterateItems do for ic: icit loop {
            rowic: "INSERT OR IGNORE INTO implicit_create VALUES (\{ic.key}, \{ic.value});\n"
            this.acc.append s: rowic
        }
        with rdit: typing.refDecl.iterateItems do for rd: rdit loop {
            rowrd: "INSERT OR IGNORE INTO ref_decl VALUES (\{rd.key}, \{rd.value + 0});\n"
            this.acc.append s: rowrd
        }
        with apit: typing.dpArmPredicate.iterateItems do for ap: apit loop {
            row4: "INSERT OR IGNORE INTO arm_predicate VALUES (\{ap.key}, \{ap.value});\n"
            this.acc.append s: row4
        }
        with trit: typing.dpTagRead.iterateItems do for tr: trit loop {
            row5: "INSERT OR IGNORE INTO tag_read VALUES (\{tr.key}, \{tr.value});\n"
            this.acc.append s: row5
        }
        with pgit: typing.postGuardName.iterateItems do for pg: pgit loop {
            pgt9: u64
            pgo9: typing.postGuardTid.get key: pg.key
            match (
                pgo9
            ) case some then {
                pgt9 = pgo9
            } case none then null
            pga9: String
            pgao9: typing.postGuardArm.get key: pg.key
            match (
                pgao9
            ) case some then {
                pgv9: pgao9.copy
                pga9 = pgv9
            } case none then null
            row7: "INSERT OR IGNORE INTO post_guard VALUES (\{pg.key}, '\{pg.value}', \{pgt9}, '\{pga9}');\n"
            this.acc.append s: row7
        }
        with tait: typing.tagAccessorName.iterateItems do for ta: tait loop {
            tat9: u64
            tao9: typing.tagAccessorTid.get key: (ztypes.tid.create from: ta.key)
            match (
                tao9
            ) case some then {
                tat9 = tao9
            } case none then null
            row6: "INSERT OR IGNORE INTO tag_accessor VALUES (\{ta.key}, '\{ta.value}', \{tat9});\n"
            this.acc.append s: row6
        }
        with adit: typing.argDisposition.iterateItems do for ad: adit loop {
            adInt9: ztypes.zparamownershipInt ad.value
            rowAd9: "INSERT OR IGNORE INTO arg_disposition VALUES (\{ad.key}, \{adInt9});\n"
            this.acc.append s: rowAd9
        }
        with voit: typing.variableOrigin.iterateItems do for vo: voit loop {
            voNum9: boolNum b: vo.value
            rowVo9: "INSERT OR IGNORE INTO variable_origin VALUES (\{vo.key}, \{voNum9});\n"
            this.acc.append s: rowVo9
        }
        with cgit: typing.callGenericBinding.iterateItems do for cg: cgit loop {
            rowCg9: "INSERT OR IGNORE INTO call_generic_binding VALUES (\{cg.key.call}, \{cg.key.param}, \{cg.value});\n"
            this.acc.append s: rowCg9
        }
        with boit: typing.binopOwner.iterateItems do for bo: boit loop {
            bm9: u64
            bmo9: typing.binopMethod.get key: bo.key
            match (
                bmo9
            ) case some then {
                bm9 = bmo9
            } case none then null
            rowBo9: "INSERT OR IGNORE INTO binop_operator VALUES (0, \{bo.key}, \{bo.value}, \{bm9});\n"
            this.acc.append s: rowBo9
        }
        # the mono pair's two ids become the two columns that line up with the
        # nodeid-keyed rows above
        with mbit: typing.monoBinopOwner.iterateItems do for mb: mbit loop {
            mi9: mb.key.mono
            mn9: mb.key.node
            mm9: u64
            mmo9: typing.monoBinopMethod.get key: mb.key
            match (
                mmo9
            ) case some then {
                mm9 = mmo9
            } case none then null
            rowMb9: "INSERT OR IGNORE INTO binop_operator VALUES (\{mi9}, \{mn9}, \{mb.value}, \{mm9});\n"
            this.acc.append s: rowMb9
        }
    }

    # appendMemberConst -- one row per named constant the compile-time evaluator
    # produced a value for. The key is packed (parentTypeId << 32 | nameId), the
    # same packing setMemberConst uses, and it is unpacked here so the two
    # columns line up with the decl tables.
    appendMemberConst: function {:this typing: ztyping.ZTyping} is {
        with mcit: typing.memberConst.iterateItems do for mc: mcit loop {
            row: "INSERT OR IGNORE INTO member_const VALUES (\{mc.key.owner}, \{mc.key.name}, '\{constValueText v: mc.value}');\n"
            this.acc.append s: row
        }
    }

    # appendConformance -- one row per recorded conformance (impl satisfies spec
    # under a label).
    appendConformance: function {:this typing: ztyping.ZTyping.view} is {
        citer: typing.conformance.iterate
        for cf: citer loop {
            lblSql: sqlStr s: cf.label.stringview
            facetSql: boolNum b: cf.isFacet
            row: "INSERT OR IGNORE INTO conformance VALUES (\{cf.conformanceId}, \{cf.implTypeId}, \{cf.specTypeId}, \{lblSql}, \{facetSql});\n"
            this.acc.append s: row
        }
    }

    # appendSymbolTable -- scope / entry / variable rows from the body-walk
    # symbol table. scope rows from the append-only scope log (depth = log
    # index, mirroring the reference enumerate); entry rows from the pop-time
    # snapshots; variable rows from the per-id side tables, deduped. Sibling
    # fields are read directly (not via st methods) so the scope-log iterator's
    # lock does not reject a whole-value method call on st. narrowed_subtype is
    # emitted by a later slice (taken/narrowing entries).
    appendSymbolTable: function {:this pool: zast.StringPool.view st: zenv.ZSymbolTable.view} is {
        seen: (SetVal u64)
        depth: u64
        for row: st.scopeLog.iterate loop {
            sidv: row.scopeId
            parentSql: optIdStr o: row.parentId
            rk: (ztypes.zscopekindName row.kind)
            kindSql: sqlStr s: rk.stringview
            nameSql: sqlStr s: row.name.stringview
            closeSql: optIdStr o: (st.scopeClose.get key: sidv)
            unreachNum: boolNum b: (st.unreachableDump.has item: sidv)
            r: "INSERT OR IGNORE INTO scope VALUES (\{sidv}, \{parentSql}, \{kindSql}, \{nameSql}, \{depth}, \{row.openedAtSeq}, \{closeSql}, \{unreachNum});\n"
            this.acc.append s: r
            depth = depth + 1
        }
        for e: st.entryDump.iterate loop {
            varSql: optVidStr9 o: e.varId
            origSql: optTidStr o: e.originalZtypeId
            defNum: boolNum b: e.isDefinition
            takNum: boolNum b: e.isTaken
            enmT9: zast.poolTextAt :pool ref: (zast.nameid.create from: e.name)
            enmSql: sqlStr s: enmT9.stringview
            r: "INSERT OR IGNORE INTO entry VALUES (\{e.entryId}, \{e.scopeId}, \{e.position}, \{enmSql}, \{e.ztypeId}, \{defNum}, \{varSql}, \{origSql}, \{takNum}, NULL, NULL, NULL);\n"
            this.acc.append s: r
            if e.narrowedSubtype.length > 0 then {
                nnm: sqlStr s: e.narrowedSubtype.stringview
                nr: "INSERT INTO narrowed_subtype VALUES (\{e.entryId}, \{nnm}, NULL, 0);\n"
                this.acc.append s: nr
            }
            with xit2: e.excludedSubtypes.iterate do for xn2: xit2 loop {
                xnm: sqlStr s: xn2.stringview
                xr: "INSERT INTO narrowed_subtype VALUES (\{e.entryId}, \{xnm}, NULL, 1);\n"
                this.acc.append s: xr
            }
            vd: e.varId
            match (
                vd
            ) case some then {
                seen.add item: vd
            } case none then null
        }
        for vid: seen.iterate loop {
            ztSql: optIdStr o: (st.typing.variableZtype.get key: vid)
            ownSql: varOwnSql o: (st.typing.variableOwnership.get key: vid)
            privNum: optBoolNumOr0 o: (st.typing.variableIsPrivate.get key: vid)
            boSql: originSql o: (ownOptStr o: (st.typing.variableBorrowOrigin.get key: vid))
            soSql: originSql o: (ownOptStr o: (st.typing.variableSynthOrigin.get key: vid))
            r: "INSERT OR IGNORE INTO variable VALUES (\{vid}, \{ztSql}, \{ownSql}, \{privNum}, \{boSql}, \{soSql});\n"
            this.acc.append s: r
        }
    }

    # --- canonical (id-normalized) renderers for the dump-canon gate ---
    # Each emits a table's id-independent projection (PK ids omitted, FK ids
    # resolved to names, id-embedding cnames dropped), rows sorted, under a
    # "## <table>" header; mirrors the column choices in test_dumpsql_z.py.
    emitSection: function {:this title: StringView rows: List String} is {
        rows.sort
        this.acc.append s: "## "
        this.acc.append s: title
        this.acc.append s: "\n"
        ri: u64
        rn: rows.length
        for ri < rn loop {
            rc: (rows.get i: ri)
            this.acc.append s: rc
            this.acc.append s: "\n"
            ri = ri + 1
        }
    }

    appendUnitsCanon: function {:this program: Node} is {
        rows: (List String)
        match (
            program
        ) case program then {
            mn: program.mainUnitName.stringview
            uCnt9c: program.ast.units.length
            uIdx9c: u64
            for uIdx9c < uCnt9c loop {
                uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9c))
                uIdx9c = uIdx9c + 1
                u: program.ast.nodes.get i: (uId9 - 1).u64
                match (
                    u
                ) case namedoperation then {
                    uname: zast.poolTextAt pool: program.ast.names ref: u.name
                    isMain: uname.stringview == mn
                    unameSql: sqlStr s: uname.stringview
                    isMainStr: boolNum b: isMain
                    line: "\{unameSql} | \{isMainStr}"
                    rows.append line
                } else null
            }
        } else null
        this.emitSection title: "unit" :rows
    }


    # appendGenericChildren -- one row per specialization-tree edge:
    # parent type-id x argument key -> child spec type-id.
    appendGenericChildren: function {:this st: zenv.ZSymbolTable.view} is {
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            if tid >= st.reg.typeById.length then return
            zt: st.reg.typeById.get i: tid
            idx9: u64
            gn9: zt.genericChildKeys.length
            for idx9 < gn9 loop {
                gk9: zt.genericChildKeys.get i: idx9
                gv9: zt.genericChildTids.get i: idx9
                row: "INSERT OR IGNORE INTO generic_child VALUES (\{tid}, \{gk9}, \{gv9});\n"
                this.acc.append s: row
                idx9 = idx9 + 1
            }
            tid = tid.next
        }
    }

    # appendGenericArgs -- one row per specialization argument, in
    # definition-parameter order.
    appendGenericArgs: function {:this st: zenv.ZSymbolTable} is {
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            gargs9: (ListVal u64)
            if tid < st.reg.typeById.length then {
                zt: st.reg.typeById.get i: tid
                zn9: zt.genericArgs.length
                zi9: u64
                for zi9 < zn9 loop {
                    ze9: zt.genericArgs.get i: zi9
                    gargs9.append ze9
                    zi9 = zi9 + 1
                }
            }
            an9: gargs9.length
            ai9: u64
            for ai9 < an9 loop {
                av9: gargs9.get i: ai9
                iv9: u64
                if (st.reg.genericArgIsValueAt
                    specId: (ztypes.tid.create from: tid.u64)
                    ordinal: ai9
                ) then iv9 = 1
                row: "INSERT OR IGNORE INTO generic_arg VALUES (\{tid}, \{ai9}, \{av9}, \{iv9});\n"
                this.acc.append s: row
                ai9 = ai9 + 1
            }
            tid = tid.next
        }
    }

    appendGenericChildrenCanon: function {:this unm: StringView st: zenv.ZSymbolTable} is {
        rows: (List String)
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            gkeys9: (ListVal u64)
            gtids9: (ListVal u64)
            if tid < st.reg.typeById.length then {
                zt: st.reg.typeById.get i: tid
                du: definedUnitOf9 :st :tid
                inUnit: false
                match (
                    du
                ) case some then {
                    if du.stringview == unm then inUnit = true
                } case none then null
                if inUnit then {
                    zn8: zt.genericChildKeys.length
                    zi8: u64
                    for zi8 < zn8 loop {
                        zk8: zt.genericChildKeys.get i: zi8
                        gkeys9.append zk8
                        zt8: zt.genericChildTids.get i: zi8
                        gtids9.append zt8
                        zi8 = zi8 + 1
                    }
                }
            }
            {
                if gkeys9.length > 0 then {
                    idx9: u64
                    gn9: gkeys9.length
                    for idx9 < gn9 loop {
                        ekey9: gkeys9.get i: idx9
                        eval9: gtids9.get i: idx9
                        pn9: canonTypeName reg: st.reg :tid
                        # the edge key's kind comes from the child's last
                        # ordinal: a numeric VALUE key prints its literal
                        kc9: st.reg.genericArgCount specId: (ztypes.tid.create from: eval9.u64)
                        kIsVal9: false
                        if kc9 > 0 then {
                            kIsVal9 = (st.reg.genericArgIsValueAt
                                specId: (ztypes.tid.create from: eval9.u64)
                                ordinal: kc9 - 1
                            )
                        }
                        kn9: String
                        if kIsVal9 then {
                            kn9 = "\{ekey9}"
                        } else {
                            kn9 = canonTypeName reg: st.reg tid: (ztypes.tid.create from: ekey9.u64)
                        }
                        cn9: canonTypeName reg: st.reg tid: (ztypes.tid.create from: eval9.u64)
                        row: "generic_child \{pn9} \{kn9} \{cn9}"
                        rows.append row
                        idx9 = idx9 + 1
                    }
                }
            }
            tid = tid.next
        }
        this.emitSection title: "generic_child" :rows
    }

    appendGenericArgsCanon: function {:this unm: StringView st: zenv.ZSymbolTable} is {
        rows: (List String)
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            cargs9: (ListVal u64)
            if tid < st.reg.typeById.length then {
                zt: st.reg.typeById.get i: tid
                du: definedUnitOf9 :st :tid
                inUnit: false
                match (
                    du
                ) case some then {
                    if du.stringview == unm then inUnit = true
                } case none then null
                if inUnit then {
                    cz9: zt.genericArgs.length
                    ci9: u64
                    for ci9 < cz9 loop {
                        ce9: zt.genericArgs.get i: ci9
                        cargs9.append ce9
                        ci9 = ci9 + 1
                    }
                }
            }
            {
                if cargs9.length > 0 then {
                    an9: cargs9.length
                    ai9: u64
                    for ai9 < an9 loop {
                        av9: cargs9.get i: ai9
                        sn9: canonTypeName reg: st.reg :tid
                        iv9: u64
                        vn9: String
                        if (st.reg.genericArgIsValueAt
                            specId: (ztypes.tid.create from: tid.u64)
                            ordinal: ai9
                        ) then {
                            iv9 = 1
                            vn9 = "\{av9}"
                        } else {
                            vn9 = canonTypeName reg: st.reg tid: (ztypes.tid.create from: av9.u64)
                        }
                        row: "generic_arg \{sn9} \{ai9} \{vn9} \{iv9}"
                        rows.append row
                        ai9 = ai9 + 1
                    }
                }
            }
            tid = tid.next
        }
        this.emitSection title: "generic_arg" :rows
    }

    appendTypesCanon: function {:this unm: StringView st: zenv.ZSymbolTable.view} is {
        rows: (List String)
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            if tid >= st.reg.typeById.length then return
            zt: st.reg.typeById.get i: tid
            du: definedUnitOf9 :st :tid
            inUnit: false
            match (
                du
            ) case some then {
                if du.stringview == unm then inUnit = true
            } case none then null
            if inUnit then {
                nameSql: sqlStr s: zt.name.stringview
                ttName: ztypes.ztypetypeName t: zt.typetype
                ttSql: sqlStr s: ttName.stringview
                valSql: optBoolSql o: zt.isValtype
                genSql: boolNum b: zt.isgeneric
                ndSql: boolNum b: (zt.destructorNameId) != 0
                heapSql: boolNum b: zt.isHeapAllocated
                line: "\{nameSql} | \{ttSql} | \{valSql} | \{genSql} | \{ndSql} | \{heapSql}"
                rows.append line
            }
            tid = tid.next
        }
        this.emitSection title: "types" :rows
    }

    # appendDeclChildCanon -- the declaration namespace of every type defined in
    # this unit, one row per typed child: owner name, child name, child type
    # name, position, param ownership. The canon dump's only view of member
    # structure, so it resolves ids to names rather than dumping the decl tree.
    appendDeclChildCanon: function {:this ast: Ast.view unm: StringView st: zenv.ZSymbolTable} is {
        rows: (List String)
        tn9: st.reg.nextTypeId
        tid9: u64
        for tid9 < tn9 loop {
            pid9: tid9
            tid9 = tid9 + 1
            pdu: definedUnitOf9 :st tid: (ztypes.tid.create from: pid9.u64)
            inUnit: false
            match (
                pdu
            ) case some then {
                if pdu.stringview == unm then inUnit = true
            } case none then null
            if inUnit then {
                nms9: (ListVal u64)
                tds9: (ListVal u64)
                (st.typing.declChildRows
                    ownerTid: (ztypes.tid.create from: pid9.u64)
                    names: nms9
                    tids: tds9
                )
                pName: canonTypeName reg: st.reg tid: (ztypes.tid.create from: pid9.u64)
                pSql: sqlStr s: pName.stringview
                pos9: u64
                cn9: nms9.length
                for pos9 < cn9 loop {
                    nid9: nms9.get i: pos9
                    cName: (canonTypeName
                        reg: st.reg
                        tid: (ztypes.tid.create from: (tds9.get i: pos9))
                    )
                    cnB8: ast.names.texts.get i: (nid9 - 1).u64
                    cnSql: sqlStr s: cnB8.stringview
                    ctSql: sqlStr s: cName.stringview
                    own9: (st.typing.declOwnershipOfId
                        parentTypeId: (ztypes.tid.create from: pid9.u64)
                        nameId: (zast.nameid.create from: nid9.u32.orPanic)
                    )
                    poSql: paramOwnSql o: own9
                    line: "\{pSql} | \{cnSql} | \{ctSql} | \{pos9} | \{poSql}"
                    rows.append line
                    pos9 = pos9 + 1
                }
            }
        }
        this.emitSection title: "decl_child" :rows
    }

    appendConformanceCanon: function {:this unm: StringView st: zenv.ZSymbolTable} is {
        rows: (List String)
        citer: st.typing.conformance.iterate
        for cf: citer loop {
            idu: definedUnitOf9 :st tid: (ztypes.tid.create from: cf.implTypeId)
            inUnit: false
            match (
                idu
            ) case some then {
                if idu.stringview == unm then inUnit = true
            } case none then null
            if inUnit then {
                iName: canonTypeName reg: st.reg tid: (ztypes.tid.create from: cf.implTypeId)
                sName: canonTypeName reg: st.reg tid: (ztypes.tid.create from: cf.specTypeId)
                iSql: sqlStr s: iName.stringview
                sSql: sqlStr s: sName.stringview
                lblSql: sqlStr s: cf.label.stringview
                facetSql: boolNum b: cf.isFacet
                line: "\{iSql} | \{sSql} | \{lblSql} | \{facetSql}"
                rows.append line
            }
        }
        this.emitSection title: "conformance" :rows
    }

    # appendMemberConstCanon -- the compile-time VALUE of each named constant
    # this unit declares, keyed by name rather than by the packed
    # (parentTypeId, nameId) the table uses, and sorted like every canon
    # section so the golden does not depend on map order.
    appendMemberConstCanon: function {:this pool: zast.StringPool.view unm: StringView st: zenv.ZSymbolTable} is {
        rows: (List String)
        with mcit: st.typing.memberConst.iterateItems do for mc: mcit loop {
            pt9: mc.key.owner
            nm9: mc.key.name
            # the parent of a unit constant IS the unit type, whose name is the
            # unit name -- definedUnitOf9 answers for a type declared INSIDE a
            # unit and has nothing to say about the unit type itself.
            tn9: canonTypeName reg: st.reg tid: (ztypes.tid.create from: pt9.u64)
            if tn9.stringview == unm then {
                mn9: pool.texts.get i: (nm9 - 1)
                cvt9: constValueCanonText :pool :st v: mc.value
                line: "\{sqlStr s: mn9.stringview} | \{sqlStr s: cvt9.stringview}"
                rows.append line
            }
        }
        this.emitSection title: "member_const" :rows
    }

    # appendSymbolTableCanon -- the body-walk symbol table (scope / entry /
    # variable / narrowed_subtype), id-normalized: scope/entry/variable PK ids and
    # the scope open/close seqs are dropped, foreign keys resolved to names (scope
    # parent and entry owning-scope by scope name, entry/variable ztype via
    # canonTypeName). No unit filter -- the table holds only the main unit's bodies.
    appendSymbolTableCanon: function {:this pool: zast.StringPool.view st: zenv.ZSymbolTable} is {
        scopeName: (MapVR u64 value: String)
        scopeRows: (List String)
        depth: u64
        for row: st.scopeLog.iterate loop {
            scopeName.set key: row.scopeId value: row.name.copy
            parentNameSql: "NULL".string
            pidOpt: row.parentId
            match (
                pidOpt
            ) case some then {
                po: scopeName.get key: pidOpt
                match (
                    po
                ) case some then {
                    parentNameSql = sqlStr s: po.stringview
                } case none then null
            } case none then null
            rk: (ztypes.zscopekindName row.kind)
            kindSql: sqlStr s: rk.stringview
            nameSql: sqlStr s: row.name.stringview
            unreachNum: boolNum b: (st.unreachableDump.has item: row.scopeId)
            line: "\{parentNameSql} | \{kindSql} | \{nameSql} | \{depth} | \{unreachNum}"
            scopeRows.append line
            depth = depth + 1
        }
        this.emitSection title: "scope" rows: scopeRows

        entryRows: (List String)
        narrowedRows: (List String)
        seen: (SetVal u64)
        for e: st.entryDump.iterate loop {
            so: scopeName.get key: e.scopeId
            match (
                so
            ) case some then {
                scNameSql: sqlStr s: so.stringview
                enmT8: zast.poolTextAt :pool ref: (zast.nameid.create from: e.name)
                enmSql: sqlStr s: enmT8.stringview
                ztName: canonTypeName reg: st.reg tid: e.ztypeId
                ztSql: sqlStr s: ztName.stringview
                defNum: boolNum b: e.isDefinition
                hasVar: false
                vh: e.varId
                match (
                    vh
                ) case some then {
                    hasVar = true
                } case none then null
                hasVarNum: boolNum b: hasVar
                takNum: boolNum b: e.isTaken
                eline: "\{scNameSql} | \{e.position} | \{enmSql} | \{ztSql} | \{defNum} | \{hasVarNum} | \{takNum}"
                entryRows.append eline
            } case none then null
            if e.narrowedSubtype.length > 0 then {
                nnmSql: sqlStr s: e.narrowedSubtype.stringview
                narrowedRows.append "\{nnmSql} | 0"
            }
            with xit: e.excludedSubtypes.iterate do for xn: xit loop {
                xnmSql: sqlStr s: xn.stringview
                narrowedRows.append "\{xnmSql} | 1"
            }
            vd: e.varId
            match (
                vd
            ) case some then {
                seen.add item: vd
            } case none then null
        }
        this.emitSection title: "entry" rows: entryRows

        varRows: (List String)
        for vid: seen.iterate loop {
            ztId: optU64Or0 o: (st.typing.variableZtype.get key: vid)
            ztName: canonTypeName reg: st.reg tid: (ztypes.tid.create from: ztId.u64)
            ztSql: sqlStr s: ztName.stringview
            ownSql: varOwnSql o: (st.typing.variableOwnership.get key: vid)
            privNum: optBoolNumOr0 o: (st.typing.variableIsPrivate.get key: vid)
            boSql: originSql o: (ownOptStr o: (st.typing.variableBorrowOrigin.get key: vid))
            soSql: originSql o: (ownOptStr o: (st.typing.variableSynthOrigin.get key: vid))
            orSql9: originKindSql o: (st.typing.variableOrigin.get key: vid)
            vline: "\{ztSql} | \{ownSql} | \{privNum} | \{boSql} | \{soSql} | \{orSql9}"
            varRows.append vline
        }
        this.emitSection title: "variable" rows: varRows

        this.emitSection title: "narrowed_subtype" rows: narrowedRows
    }

    appendArgDispositionCanon: function {:this ast: Ast.view st: zenv.ZSymbolTable} is {
        rows: (List String)
        with adit: st.typing.argDisposition.iterateItems do for ad: adit loop {
            an9: argAtomName :ast id: ad.key
            if an9.length > 0 then {
                anSql9: sqlStr s: an9.stringview
                dnm9: ztypes.zparamownershipName ad.value
                rows.append "\{anSql9} | \{dnm9}"
            }
        }
        this.emitSection title: "arg_disposition" :rows
    }

    appendCallGenericBindingCanon: function {:this program: Node st: zenv.ZSymbolTable} is {
        rows: (List String)
        match (
            program
        ) case program then {
            with cgit: st.typing.callGenericBinding.iterateItems do for cg: cgit loop {
                hld9: (zast.poolTextAt
                    pool: program.ast.names
                    ref: (zast.nameid.create from: cg.key.param.u32.orPanic)
                )
                tn9: canonTypeName reg: st.reg tid: (ztypes.tid.create from: cg.value)
                hSql9: sqlStr s: hld9.stringview
                tSql9: sqlStr s: tn9.stringview
                rows.append "\{hSql9} | \{tSql9}"
            }
        } else null
        this.emitSection title: "call_generic_binding" :rows
    }

}

# walkExprStamps -- mirror the reference dump's node-type read (_node_ztype):
# an Expression wrapper's typed row shows the innermost non-expression node's
# stamp when one exists, falling back to the wrapper's own. The walk returns
# each node's effective stamp so nested wrappers see through inner wrappers;
# overrides are collected and applied to nodeType after the walk (check-time
# propagation has already read the original values).
# walkExprStampsAt -- the id-taking entry: the row view is this frame's, so a
# caller can lend the table exclusively.
walkExprStampsAt: function {
    typing: ztyping.ZTyping.view
    ast: Ast.view
    nId: zast.nodeid
    ids: (ListVal u64).view
    vals: (ListVal u64).view
} out u64 is {
    n9: ast.nodes.get i: (nId - 1).u64
    return (walkExprStamps :typing :ast n: n9 :ids :vals)
}

# recurse an expression, emitting a SQL row for each node's typecheck stamps.
walkExprStamps: function {
    typing: ztyping.ZTyping
    ast: Ast.view
    n: Node.view
    ids: ListVal u64
    vals: ListVal u64
} out u64 is {
    match (
        n
    ) case expression then {
        eff: walkExprStamps :typing :ast n: (ast.nodes.get i: (n.expression - 1).u64) :ids :vals
        if eff > 0 then {
            wid: n.nodeid.u64
            ids.append wid
            ev: eff
            vals.append ev
            return eff
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case binop then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.lhs - 1).u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.operator - 1).u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.rhs - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case atomstring then {
        spiter: n.stringparts.iterate
        for sp: spiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: (sp - 1).u64) :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case dottedpath then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.parent - 1).u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.child - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case call then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.callable - 1).u64) :ids :vals
        aiter: n.arguments.iterate
        for arg: aiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: (arg - 1).u64) :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case typeofexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.source - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case namedoperation then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.operation - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case datablock then {
        eiter: n.elements.iterate
        for el: eiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: (el - 1).u64) :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.outType :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case yieldexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.expr - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case statement then {
        sliter: n.statements.iterate
        for lnId9: sliter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: (lnId9 - 1).u64) :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case statementline then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.statementline - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case assignment then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.value - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case reassignment then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.topath - 1).u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.value - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case swapstmt then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.lhs - 1).u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.rhs - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case ifexpr then {
        cliter: n.clauses.iterate
        for cl: cliter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: (cl - 1).u64) :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.elseclause :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case ifclause then {
        coiter: n.conditions.iterate
        for coId9: coiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: (coId9 - 1).u64) :ids :vals
        }
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.statement - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case forexpr then {
        fciter: n.conditions.iterate
        for fc: fciter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: (fc - 1).u64) :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.body :ids :vals
        fpiter: n.postconditions.iterate
        for fp: fpiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: (fp - 1).u64) :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case doexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.statement - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case withexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.value - 1).u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.body - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case caseexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.subject - 1).u64) :ids :vals
        cciter: n.clauses.iterate
        for cc: cciter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: (cc - 1).u64) :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.elseclause :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case caseclause then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.matcharm - 1).u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: (n.statement - 1).u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case functiondef then {
        walkExprStampsOptAt :typing :ast oId: n.returntype :ids :vals
        piter: n.parameters.iterate
        for pmId9: piter loop {
            pm: ast.nodes.get i: (pmId9 - 1).u64
            walkExprStamps :typing :ast n: pm :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.body :ids :vals
        faiter: n.asItems.iterate
        for amId9: faiter loop {
            am: ast.nodes.get i: (amId9 - 1).u64
            walkExprStamps :typing :ast n: am :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case objectdef then {
        oiiter: n.isItems.iterate
        for oiId9: oiiter loop {
            oi: ast.nodes.get i: (oiId9 - 1).u64
            walkExprStamps :typing :ast n: oi :ids :vals
        }
        oaiter: n.asItems.iterate
        for oaId9: oaiter loop {
            oa: ast.nodes.get i: (oaId9 - 1).u64
            walkExprStamps :typing :ast n: oa :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case unitdef then {
        ubiter: n.body.iterate
        for ub: ubiter loop {
            ubNode9: ast.nodes.get i: (ub - 1).u64
            walkExprStamps :typing :ast n: ubNode9 :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case atomid then {
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case labelvalue then {
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case stringchunk then {
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } else {
        return 0
    }
}

# walkExprStampsOptAt -- the id-taking entry (0 = absent).
walkExprStampsOptAt: function {
    typing: ztyping.ZTyping.view
    ast: Ast.view
    oId: zast.nodeid
    ids: (ListVal u64).view
    vals: (ListVal u64).view
} is {
    if oId.isZero then return
    o9: ast.nodes.get i: (oId - 1).u64
    walkExprStamps :typing :ast n: o9 :ids :vals
}

# overrideExpressionStamps -- collect the wrapper overrides across every unit,
# then rewrite nodeType so appendTypedNodes emits the descended values.
overrideExpressionStamps: function {typing: ztyping.ZTyping program: Node.view} is {
    ids: (ListVal u64)
    vals: (ListVal u64)
    match (
        program
    ) case program then {
        uCnt9d: program.ast.units.length
        uIdx9d: u64
        for uIdx9d < uCnt9d loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9d))
            uIdx9d = uIdx9d + 1
            (walkExprStampsAt
                :typing
                ast: program.ast
                nId: (zast.nodeid.create from: uId9)
                :ids
                :vals
            )
        }
    } else null
    i: u64
    cnt: ids.length
    for i < cnt loop {
        k: ids.get :i
        v: vals.get :i
        setk: k
        setv: v
        ztyping.nodeTypeSet tbl: typing.nodeType nid: setk tid: (ztypes.tid.create from: setv.u64)
        i = i + 1
    }
}

# --- entry point ---

# dumpSql -- the full dump: schema, then files, ast_nodes and unit rows.
dumpSql: function {program: Node.view vfs: zvfs.ZVfs.view symtab: zenv.ZSymbolTable} out String is {
    d: ZDumper acc: schemaSql
    d.appendFiles :vfs
    d.appendNodes :program
    d.appendSynthNodes typing: symtab.typing
    d.appendUnits :program typing: symtab.typing
    match (
        program
    ) case program then {
        d.appendTypes st: symtab pool: program.ast.names
        d.appendDecls ast: program.ast typing: symtab.typing
    } else null
    d.appendGenericChildren st: symtab
    d.appendGenericArgs st: symtab
    overrideExpressionStamps typing: symtab.typing :program
    d.appendTypedNodes typing: symtab.typing
    d.appendAtomStamps typing: symtab.typing
    d.appendMemberConst typing: symtab.typing
    d.appendConformance typing: symtab.typing
    match (
        program
    ) case program then {
        d.appendSymbolTable pool: program.ast.names st: symtab
    } else null
    return d.acc.copy
}

# optU64Or0 -- an optionval u64's value, or 0 when absent.
optU64Or0: function {o: optionval u64} out u64 is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return 0
    }
}

# canonTypeName -- a type id's registered name, or "?" when unregistered.
# Renders foreign-key ids as stable names in the canonical dump.
canonTypeName: function {reg: ztypes.ZTypeRegistry tid: ztypes.tid} out String is {
    if (reg.typeValid tid: (ztypes.tid.create from: tid.u64)) == false then return "?".string
    zt: reg.typeById.get i: tid
    return zt.name.copy
}

# dumpCanon -- a canonical, id-normalized rendering of the typecheck state
# (unit, types, decl_child, conformance, and the body-walk symbol table:
# scope / entry / variable / narrowed_subtype) for the Python-free dump-canon
# regression gate. PK ids are omitted, FK ids resolved to names, id-embedding
# cnames dropped, rows sorted. Parse-level tables (files / ast_nodes) are
# covered by the lexer / parser goldens and omitted here.
# mainUnitNameOf -- the program's main unit name as an owned String.
mainUnitNameOf: function {program: Node.view} out String is {
    match (
        program
    ) case program then {
        return program.mainUnitName.copy
    } else {
        return "".string
    }
}

# render the whole program (AST plus symbol table) as canonical text
# for golden-diff comparison.
dumpCanon: function {program: Node.view symtab: zenv.ZSymbolTable} out String is {
    mu: mainUnitNameOf :program
    d: ZDumper acc: "".string
    d.appendUnitsCanon :program
    match (
        program
    ) case program then {
        d.appendTypesCanon unm: mu.stringview st: symtab
        d.appendDeclChildCanon ast: program.ast unm: mu.stringview st: symtab
        d.appendArgDispositionCanon ast: program.ast st: symtab
    } else null
    d.appendGenericChildrenCanon unm: mu.stringview st: symtab
    d.appendGenericArgsCanon unm: mu.stringview st: symtab
    d.appendConformanceCanon unm: mu.stringview st: symtab
    match (
        program
    ) case program then {
        d.appendMemberConstCanon pool: program.ast.names unm: mu.stringview st: symtab
        d.appendSymbolTableCanon pool: program.ast.names st: symtab
    } else null
    d.appendCallGenericBindingCanon :program st: symtab
    return d.acc.copy
}
