# SQL dump of compiler state: the parsed program and the typecheck output
# serialised as SQL (schema DDL, then INSERT rows) for `zc dump` and the dump
# goldens. The canonical form renders every id as the name it stands for, so
# two compiles of the same program compare equal whatever their id numbering.
#
# Output accumulates on the ZDumper's `acc` field: every emitter is a method
# that appends to it and recurses through `this`, because an owned-String
# accumulator threaded by return value runs into self-reassignment ownership
# errors.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :dumpCanon
    :dumpSql
}

Node: zast.Node
Ast: zast.Ast

# --- SQL value formatting (stateless) ---

# sqlStr -- `s` as a SQL single-quoted string literal, embedded quotes doubled.
sqlStr: function {s: StringView} out String is {
    inner: s.replace needle: "'" replacement: "''"
    acc: "'".string
    acc.append s: inner
    acc.append s: "'"
    return acc
}


# boolNum -- SQL integer boolean.
boolNum: function {b: bool} out String is {
    match (
        b
    ) case true then {
        return "1".string
    } case false then {
        return "0".string
    }
}

# optTidStr -- an optional TYPE id as decimal text, or "NULL". A sibling of
# optIdStr rather than a conversion at each call: the dump projects several
# optional tid columns and unwrapping at the boundary would lose the space.
# constValueText -- a compile-time value as the dump's const_value column:
# kind-tagged, payload by id rather than by text, so no user string ever
# reaches the SQL and nothing needs quoting.
constValueText: function {v: ztypes.cval} out String is {
    if v.kind.ivalKind then return "IVAL:\{v.ival}"
    if v.kind.fvalKind then return "FVAL:\{v.fval}"
    if v.kind.svalKind then return "SVAL:#\{v.strId}"
    if v.kind.armKind then return "ARM:\{v.armTid}#\{v.armName}"
    return "NONE".string
}

# constValueCanonText -- the same value for the CANONICAL dump, with every id
# resolved: an arm reads as `ARM:<type>.<arm>` and a string as its text. Raw
# ids would make the golden move whenever an unrelated type or pool entry was
# added ahead of it, which is the whole reason the canon form exists.
constValueCanonText: function {
    pool: zast.StringPool.view
    st: zenv.ZSymbolTable.view
    v: ztypes.cval
} out String is {
    if v.kind.armKind then {
        tn: canonTypeName reg: st.reg tid: v.armTid
        # bind the pool text ONCE and never reassign into it: a `get` hands
        # back a non-owning shallow copy, so assigning one over an owned String
        # frees that String's buffer and leaves a pointer the pool still owns
        # to be freed again at scope exit
        if v.armName.isZero then return "ARM:\{tn}.?"
        an: pool.texts.get i: v.armName.u32.u64
        return "ARM:\{tn}.\{an}"
    }
    if v.kind.svalKind then {
        sv: st.typing.constStrings.get i: v.strId.u64
        return "SVAL:\{sv}"
    }
    return (constValueText :v)
}

optTidStr: function {o: optionval ztypes.tid} out String is {
    match (
        o
    ) case some then {
        return "\{o.u64}"
    } case none then {
        return "NULL".string
    }
}

# optIdStr -- an optional id as decimal text, or "NULL".
vidOrNullText: function {o: optionval ztypes.vid} out String is {
    match (
        o
    ) case some then {
        ov: o + 0
        return "\{ov}"
    } case none then {
        return "NULL".string
    }
}

# frameLabelOf -- a frame's dump label ("" when unlabelled: a call bracket).
frameLabelOf: function {st: zenv.ZSymbolTable.view frame: ztypes.declid} out String is {
    o: st.frameLabel.get key: frame.u64
    match (
        o
    ) case some then {
        return o.copy
    } case none then {
        return "".string
    }
}

# definedUnitOf -- a type's defining unit as an Option, derived off the
# Decl parent chain.
definedUnitOf: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out (Option of: String) is {
    nm: ztypecheck.unitNameOfTid :st tid: (ztypes.tid.create from: tid.u64)
    if nm.length == 0 then return (Option.none String)
    return (Option.some nm)
}

# unitdefNodeId -- the nodeid of the unit row an id names (0 when the id does
# not name a unit). The row view is scoped to the fetch.
unitdefNodeId: function {ast: Ast.view nId: zast.nodeid} out u32 is {
    result: zast.nodeid
    {
        n: ast.nodes.get i: nId.u64
        if n.unitdef then result = n.nodeid
    }
    return result
}

# schemaSql -- DDL for the populated tables: only the columns the
# projections read are declared.
schemaSql: function {} out String is {
    acc: String
    acc.append s: "CREATE TABLE IF NOT EXISTS files (file_id INTEGER PRIMARY KEY, path TEXT NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS ast_nodes (node_id INTEGER PRIMARY KEY, kind TEXT NOT NULL, token_id INTEGER, name TEXT, file_id INTEGER, start_line INTEGER, start_col INTEGER, synth_origin TEXT);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS unit (unit_id INTEGER PRIMARY KEY, name TEXT NOT NULL, is_main INTEGER NOT NULL, unit_type_id INTEGER);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS types (type_id INTEGER PRIMARY KEY, name TEXT NOT NULL, typetype TEXT NOT NULL, is_valtype INTEGER, is_generic INTEGER, generic_origin_id INTEGER, needs_destructor INTEGER, is_heap_allocated INTEGER, defined_in_unit TEXT);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS decl (decl_id INTEGER PRIMARY KEY, name TEXT NOT NULL, parent_decl_id INTEGER NOT NULL, kind TEXT NOT NULL, node_id INTEGER NOT NULL, type_id INTEGER NOT NULL, ownership INTEGER NOT NULL, is_fnptr_field INTEGER NOT NULL, grants_private INTEGER NOT NULL, lock_field_decl_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS decl_child (parent_decl_id INTEGER NOT NULL, name TEXT NOT NULL, child_decl_id INTEGER NOT NULL, position INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS ref_decl (node_id INTEGER PRIMARY KEY, decl_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS typed_nodes (node_id INTEGER PRIMARY KEY, type_id INTEGER, is_const INTEGER, const_value TEXT);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS member_const (parent_type_id INTEGER NOT NULL, name_id INTEGER NOT NULL, value TEXT NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS conformance (conformance_id INTEGER PRIMARY KEY, impl_type_id INTEGER NOT NULL, spec_type_id INTEGER NOT NULL, label TEXT NOT NULL, is_facet INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS scope (scope_id INTEGER PRIMARY KEY, parent_id INTEGER, kind TEXT NOT NULL, name TEXT NOT NULL, depth INTEGER NOT NULL, unreachable INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS variable (variable_id INTEGER PRIMARY KEY, ztype_id INTEGER, ownership TEXT NOT NULL, is_private_access INTEGER NOT NULL, borrow_origin TEXT, synth_origin TEXT, origin TEXT);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS entry (entry_id INTEGER PRIMARY KEY, scope_id INTEGER NOT NULL, position INTEGER NOT NULL, name TEXT NOT NULL, ztype_id INTEGER NOT NULL, is_definition INTEGER NOT NULL, variable_id INTEGER, original_ztype_id INTEGER, is_taken INTEGER NOT NULL, taken_at_line INTEGER, taken_at_col INTEGER, taken_at_file INTEGER);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS narrowed_subtype (entry_id INTEGER NOT NULL, name TEXT NOT NULL, type_id INTEGER, excluded INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS generic_child (parent_id INTEGER NOT NULL, arg_key INTEGER NOT NULL, child_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS generic_arg (spec_id INTEGER NOT NULL, ordinal INTEGER NOT NULL, arg_id INTEGER NOT NULL, arg_is_value INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS atom_variable (node_id INTEGER PRIMARY KEY, variable_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS implicit_create (node_id INTEGER PRIMARY KEY, type_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS arm_predicate (node_id INTEGER PRIMARY KEY, type_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS tag_read (node_id INTEGER PRIMARY KEY, type_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS tag_accessor (type_id INTEGER PRIMARY KEY, name TEXT NOT NULL, tag_type_id INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS post_guard (node_id INTEGER PRIMARY KEY, name TEXT NOT NULL, type_id INTEGER NOT NULL, arm TEXT NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS arg_disposition (node_id INTEGER PRIMARY KEY, disposition INTEGER NOT NULL);\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS call_generic_binding (call_node INTEGER NOT NULL, param_name INTEGER NOT NULL, type_id INTEGER NOT NULL, PRIMARY KEY (call_node, param_name));\n"
    acc.append s: "CREATE TABLE IF NOT EXISTS binop_operator (mono_id INTEGER NOT NULL, node_id INTEGER NOT NULL, owner_type_id INTEGER NOT NULL, method_id INTEGER NOT NULL, PRIMARY KEY (mono_id, node_id));\n"
    return acc
}

# optBoolSql -- an optional bool as SQL "1"/"0", or "NULL".
optBoolSql: function {o: optionval bool} out String is {
    match (
        o
    ) case some then {
        return (boolNum b: o)
    } case none then {
        return "NULL".string
    }
}

optStrSql: function {o: (Option String).view} out String is {
    match (
        o
    ) case some then {
        return (sqlStr s: o.stringview)
    } case none then {
        return "NULL".string
    }
}

# paramOwnSql -- a member's param-ownership as its integer code
# (TAKE=0, BORROW=1, LOCK=2), or "NULL" when it carries no ownership.
paramOwnSql: function {o: optionval ztypes.zparamownership} out String is {
    match (
        o
    ) case some then {
        return "\{ztypes.zparamownershipInt o}"
    } case none then {
        return "NULL".string
    }
}

# varOwnSql -- a variable's ownership enum as a SQL string literal.
varOwnSql: function {o: ztypes.zownership} out String is {
    ownStr: (ztypes.zownershipName o)
    return (sqlStr s: ownStr.stringview)
}

# nameIdSql -- a name id as a SQL string literal, or NULL for the zero id.
nameIdSql: function {pool: zast.StringPool.view id: zast.nameid} out String is {
    if id.isZero then return "NULL".string
    t: zast.poolTextAt :pool ref: id
    return (sqlStr s: t.stringview)
}

# originSql -- a borrow/synth origin ("" or absent => NULL), else a SQL string.
originSql: function {o: (Option String).view} out String is {
    match (
        o
    ) case some then {
        if o.length == 0 then {
            return "NULL".string
        } else {
            return (sqlStr s: o.stringview)
        }
    } case none then {
        return "NULL".string
    }
}

# originKindSql -- a variable's origin kind as canon text (param/local), or
# "NULL" for a synthesised variable.
originKindSql: function {o: ztypes.zvarorigin} out String is {
    if o == ztypes.zvarorigin.param then return "param".string
    if o == ztypes.zvarorigin.local then return "local".string
    return "NULL".string
}

# argAtomName -- the identifier name of the atom node at `id` (1-based), else
# "" (non-atom arguments carry no stable canon name).
argAtomName: function {ast: Ast.view id: u64} out String is {
    if id == 0 then return "".string
    n: ast.nodes.get i: id.u64
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# --- the dumper ---

# the SQL-dump builder: accumulates INSERT rows for every compiler table.
ZDumper: class {
    acc: String
} as {
    # emit -- one ast_nodes row. token_id and file_id are NULL (the AST
    # carries no token linkage); synth_origin is NULL (the parser sets
    # none). nameSql is the pre-escaped context label.
    emit: function {:this id: u32 line: u32 col: u32 kind: StringView nameSql: StringView} is {
        row: "INSERT INTO ast_nodes VALUES (\{id}, '\{kind}', NULL, \{nameSql}, NULL, \{line}, \{col}, NULL);\n"
        this.acc.append s: row
    }

    # files stage.
    appendFiles: function {:this vfs: zvfs.ZVfs} is {
        ids: (ListVal zvfs.fsno)
        paths: (List String)
        vfs.fileTable outIds: ids outPaths: paths
        i: u64
        n: ids.length
        for i < n loop {
            fid: ids.get :i
            p: paths.get :i
            ps: sqlStr s: p.stringview
            row: "INSERT INTO files VALUES (\{fid.u64}, \{ps});\n"
            this.acc.append s: row
            i = i + 1
        }
    }

    # walkOpt -- walk an optional child when present.
    # walkOptAt -- the id-taking entry (0 = absent).
    walkOptAt: function {:this ast: Ast.view oId: zast.nodeid nameSql: StringView} is {
        if oId.isZero then return
        o: ast.nodes.get i: oId.u64
        this.walkNode :ast node: o :nameSql
    }

    # walkUnwrapped -- walk a namedoperation child's wrapped operation, not
    # the wrapper, in the name->node positions (unit body, function
    # parameters / as-items, object members, if / for conditions): the
    # wrapper produces no ast_nodes row.
    walkUnwrapped: function {:this ast: Ast.view wrapper: Node.view nameSql: StringView} is {
        match (
            wrapper
        ) case namedoperation then {
            this.walkNode :ast node: (ast.nodes.get i: wrapper.operation.u64) :nameSql
        } else {
            this.walkNode :ast node: wrapper :nameSql
        }
    }

    # walkNode -- emit `node`'s row (labelled nameSql) and recurse. The
    # name->node positions (if / for conditions, parameters, as-items, object
    # members, unit body) unwrap their namedoperation wrapper, which gets no
    # row; every other child is walked as it is. A program's units are walked
    # by appendUnitDefAndBody under their own labels, not from here.
    walkNode: function {:this ast: Ast.view node: Node.view nameSql: StringView} is {
        if node.placeholder then return
        pos: zast.posOf n: node
        nid: zast.nodeIdOf n: node
        this.emit id: nid.u32 line: pos.line col: pos.col kind: (zast.armName n: node) :nameSql
        match (
            node
        ) case ifclause then {
            this.walkUnwrappedIds :ast ids: node.conditions :nameSql
            this.walkNode :ast node: (ast.nodes.get i: node.statement.u64) :nameSql
        } case forexpr then {
            this.walkUnwrappedIds :ast ids: node.conditions :nameSql
            this.walkOptAt :ast oId: node.body :nameSql
            this.walkIds :ast ids: node.postconditions :nameSql
        } case functiondef then {
            this.walkOptAt :ast oId: node.returntype :nameSql
            this.walkUnwrappedIds :ast ids: node.parameters :nameSql
            this.walkOptAt :ast oId: node.body :nameSql
            this.walkUnwrappedIds :ast ids: node.asItems :nameSql
        } case objectdef then {
            this.walkUnwrappedIds :ast ids: node.isItems :nameSql
            this.walkUnwrappedIds :ast ids: node.asItems :nameSql
        } case unitdef then {
            this.walkUnwrappedIds :ast ids: node.body :nameSql
        } case program then null else {
            this.walkIds :ast ids: (zast.childIds :ast n: node) :nameSql
        }
    }

    walkIds: function {:this ast: Ast.view ids: (ListVal u32).view nameSql: StringView} is {
        with it: ids.iterate do for c: it loop {
            this.walkNode :ast node: (ast.nodes.get i: c.u64) :nameSql
        }
    }

    walkUnwrappedIds: function {:this ast: Ast.view ids: (ListVal u32).view nameSql: StringView} is {
        with it: ids.iterate do for c: it loop {
            this.walkUnwrapped :ast wrapper: (ast.nodes.get i: c.u64) :nameSql
        }
    }

    # appendUnitDefAndBody -- the unit's own ast_nodes row (labelled with
    # the unit name), then each body definition's subtree labelled
    # "<unit>.<def>": the unit node is emitted directly and each definition
    # subtree is walked under its own label.
    appendUnitDefAndBody: function {:this ast: Ast.view unitdef: Node.view uname: StringView} is {
        match (
            unitdef
        ) case unitdef then {
            unameSql: sqlStr s: uname
            (this.emit
                id: unitdef.nodeid
                line: unitdef.lineno
                col: unitdef.colno
                kind: "Unit"
                nameSql: unameSql.stringview
            )
            biter: unitdef.body.iterate
            for bm: biter loop {
                bmNode: ast.nodes.get i: bm.u64
                this.appendBodyMember :ast member: bmNode :uname
            }
        } else null
    }

    appendBodyMember: function {:this ast: Ast.view member: Node.view uname: StringView} is {
        match (
            member
        ) case namedoperation then {
            dname: zast.nameTextAt :ast ref: member.name
            label: "\{uname}.\{dname}"
            labelSql: sqlStr s: label.stringview
            (this.walkNode
                :ast
                node: (ast.nodes.get i: member.operation.u64)
                nameSql: labelSql.stringview
            )
        } else null
    }

    appendNodes: function {:this program: Node.view} is {
        match (
            program
        ) case program then {
            uCnt9a: program.ast.units.length
            uIdx9a: u64
            for uIdx9a < uCnt9a loop {
                uId: (zast.nodeid.create from: (program.ast.units.get i: uIdx9a))
                uIdx9a = uIdx9a + 1
                this.appendUnitFromNamedOp ast: program.ast unitNamedOpId: uId
            }
        } else null
    }

    appendUnitFromNamedOp: function {:this ast: Ast.view unitNamedOpId: u32} is {
        unitNamedOp: ast.nodes.get i: unitNamedOpId.u64
        if unitNamedOp.namedoperation then {
            uname: zast.nameTextAt :ast ref: unitNamedOp.name
            (this.appendUnitDefAndBody
                :ast
                unitdef: (ast.nodes.get i: unitNamedOp.operation.u64)
                uname: uname.stringview
            )
        }
    }

    # unit stage.
    appendUnits: function {:this program: Node.view typing: ztyping.ZTyping.view} is {
        match (
            program
        ) case program then {
            uCnt9b: program.ast.units.length
            uIdx9b: u64
            for uIdx9b < uCnt9b loop {
                uId: (zast.nodeid.create from: (program.ast.units.get i: uIdx9b))
                uIdx9b = uIdx9b + 1
                (this.appendUnitRow ast: program.ast
                    unitNamedOpId: uId
                    mainName: program.mainUnitName.stringview
                    :typing
                )
            }
        } else null
    }

    appendUnitRow: function {
        :this
        ast: Ast.view
        unitNamedOpId: u32
        mainName: StringView
        typing: ztyping.ZTyping.view
    } is {
        unitNamedOp: ast.nodes.get i: unitNamedOpId.u64
        if unitNamedOp.namedoperation then {
            uname: zast.nameTextAt :ast ref: unitNamedOp.name
            uid: unitdefNodeId :ast nId: unitNamedOp.operation
            isMain: uname.stringview == mainName
            unameSql: sqlStr s: uname.stringview
            isMainStr: boolNum b: isMain
            utidStr: optTidStr o: (typing.unitTypesById.get key: uid.u64)
            row: "INSERT INTO unit VALUES (\{uid}, \{unameSql}, \{isMainStr}, \{utidStr});\n"
            this.acc.append s: row
        }
    }

    # appendTypes -- one row per registered type, read by sequential id from
    # the registry. The dumper emits the full (small) registry; the
    # differential filters to the example's own unit via defined_in_unit.
    appendTypes: function {:this st: zenv.ZSymbolTable.view} is {
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            if (st.reg.typeValid tid: (ztypes.tid.create from: tid.u64)) == false then {
                tid = tid.next
                continue
            }
            zt: st.reg.typeById.get i: tid
            nameSql: sqlStr s: zt.name.stringview
            ttName: ztypes.ztypetypeName t: zt.typetype
            ttSql: sqlStr s: ttName.stringview
            valSql: optBoolSql o: zt.isValtype
            genSql: boolNum b: zt.isgeneric
            goSql: optTidStr o: zt.genericOriginId
            ndSql: boolNum b: zt.needsDestructor
            heapSql: boolNum b: zt.isHeapAllocated
            duSql: optStrSql o: (definedUnitOf :st :tid)
            row: "INSERT OR IGNORE INTO types VALUES (\{tid}, \{nameSql}, \{ttSql}, \{valSql}, \{genSql}, \{goSql}, \{ndSql}, \{heapSql}, \{duSql});\n"
            this.acc.append s: row
            tid = tid.next
        }
    }

    # appendDecls -- one decl row per declaration and one decl_child row
    # per namespace edge (the declaration tree the def indexer builds).
    appendDecls: function {:this ast: Ast.view typing: ztyping.ZTyping.view} is {
        n: typing.decls.length
        did: u64
        for did < n loop {
            dOpt: typing.decls.get i: did
            dnm: String
            if dOpt.name > 0 then {
                dnB: ast.names.texts.get i: dOpt.name.u64
                dnm = dnB.copy
            }
            nameSql: sqlStr s: dnm.stringview
            kn: ztyping.declkindName k: dOpt.kind
            kindSql: sqlStr s: kn.stringview
            ownSql: ztypes.zparamownershipInt dOpt.ownership
            fpSql: boolNum b: dOpt.fnptrField
            gpSql: boolNum b: dOpt.grantsPrivate
            row: "INSERT OR IGNORE INTO decl VALUES (\{did}, \{nameSql}, \{dOpt.parent + 0}, \{kindSql}, \{dOpt.node}, \{dOpt.typeId}, \{ownSql}, \{fpSql}, \{gpSql}, \{dOpt.lockFieldDecl});\n"
            this.acc.append s: row
            pos: u64
            cnt: dOpt.children.length
            for pos < cnt loop {
                cnid: dOpt.children.keyAt i: pos
                cdid: ztypes.declid
                cvo: dOpt.children.valueAt i: pos
                match (
                    cvo
                ) case some then {
                    cdid = cvo
                } case none then null
                cnm: String
                if cnid > 0 then {
                    cnB: ast.names.texts.get i: cnid.u64
                    cnm = cnB.copy
                }
                cnSql: sqlStr s: cnm.stringview
                crow: "INSERT OR IGNORE INTO decl_child VALUES (\{did}, \{cnSql}, \{cdid + 0}, \{pos});\n"
                this.acc.append s: crow
                pos = pos + 1
            }
            did = did + 1
        }
    }

    # appendSynthNodes -- ast_nodes rows for typecheck-synthesised nodes (the
    # call-arg hoist temps); the parsed-program walk cannot reach them. Empty
    # under signature-only runs.
    appendSynthNodes: function {:this ast: Ast.view typing: ztyping.ZTyping.view} is {
        siter: typing.synthNodes.iterate
        for sn: siter loop {
            # the label the checker used to carry as text: `<unit>.<definition>`
            lbl: String
            {
                un: (zast.poolTextAt
                    pool: ast.names
                    ref: (zast.nameid.create from: (typing.declNameOf declId: sn.ownerUnit))
                )
                dn: zast.poolTextAt pool: ast.names ref: sn.ownerName
                if un.length > 0 then {
                    lbl.append un
                    lbl.append "."
                    lbl.append dn
                }
            }
            ns: sqlStr s: lbl.stringview
            (this.emit
                id: sn.nodeid
                line: sn.lineno
                col: sn.colno
                kind: sn.kind
                nameSql: ns.stringview
            )
        }
    }

    # appendTypedNodes -- one row per node->type stamp (typing.nodeType),
    # carrying the node's compile-time value when the typechecker folded one.
    # A const-only node with no type stamp emits no row: it would carry a NULL
    # type_id, which the node-type differential's JOIN drops anyway.
    appendTypedNodes: function {:this typing: ztyping.ZTyping.view} is {
        n: typing.nodeType.length
        i: u64
        for i < n loop {
            v: typing.nodeType.get :i
            if v > 0 then {
                isc: 0
                cvs: "NULL".string
                cg: typing.nodeConst.get key: i
                match (
                    cg
                ) case some then {
                    isc = 1
                    cvs = "'\{constValueText v: cg}'"
                } case none then null
                row: "INSERT OR IGNORE INTO typed_nodes VALUES (\{i}, \{v}, \{isc}, \{cvs});\n"
                this.acc.append s: row
            }
            i = i + 1
        }
    }

    # appendAtomStamps -- one row per atom-use variable-id stamp and per
    appendAtomStamps: function {:this typing: ztyping.ZTyping pool: zast.StringPool.view} is {
        with avit: typing.atomVariableId.iterateItems do for av: avit loop {
            row: "INSERT OR IGNORE INTO atom_variable VALUES (\{av.key}, \{av.value});\n"
            this.acc.append s: row
        }
        with icit: typing.implicitCreate.iterateItems do for ic: icit loop {
            rowic: "INSERT OR IGNORE INTO implicit_create VALUES (\{ic.key}, \{ic.value});\n"
            this.acc.append s: rowic
        }
        with rdit: typing.refDecl.iterateItems do for rd: rdit loop {
            rowrd: "INSERT OR IGNORE INTO ref_decl VALUES (\{rd.key}, \{rd.value + 0});\n"
            this.acc.append s: rowrd
        }
        with apit: typing.dpArmPredicate.iterateItems do for ap: apit loop {
            row4: "INSERT OR IGNORE INTO arm_predicate VALUES (\{ap.key}, \{ap.value});\n"
            this.acc.append s: row4
        }
        with trit: typing.dpTagRead.iterateItems do for tr: trit loop {
            row5: "INSERT OR IGNORE INTO tag_read VALUES (\{tr.key}, \{tr.value});\n"
            this.acc.append s: row5
        }
        with pgit: typing.postGuardName.iterateItems do for pg: pgit loop {
            pgt: u64
            pgo: typing.postGuardTid.get key: pg.key
            match (
                pgo
            ) case some then {
                pgt = pgo
            } case none then null
            pgaId: zast.nameid
            pgao: typing.postGuardArm.get key: pg.key
            match (
                pgao
            ) case some then {
                pgaId = pgao
            } case none then null
            pga: zast.poolTextAt :pool ref: pgaId
            pgn: zast.poolTextAt :pool ref: pg.value
            row7: "INSERT OR IGNORE INTO post_guard VALUES (\{pg.key}, '\{pgn}', \{pgt}, '\{pga}');\n"
            this.acc.append s: row7
        }
        with tait: typing.tagAccessorName.iterateItems do for ta: tait loop {
            tat: u64
            tao: typing.tagAccessorTid.get key: (ztypes.tid.create from: ta.key)
            match (
                tao
            ) case some then {
                tat = tao
            } case none then null
            tan: zast.poolTextAt :pool ref: ta.value
            row6: "INSERT OR IGNORE INTO tag_accessor VALUES (\{ta.key}, '\{tan}', \{tat});\n"
            this.acc.append s: row6
        }
        with adit: typing.argDisposition.iterateItems do for ad: adit loop {
            adInt: ztypes.zparamownershipInt ad.value
            rowAd: "INSERT OR IGNORE INTO arg_disposition VALUES (\{ad.key}, \{adInt});\n"
            this.acc.append s: rowAd
        }
        with cgit: typing.callGenericBinding.iterateItems do for cg: cgit loop {
            rowCg: "INSERT OR IGNORE INTO call_generic_binding VALUES (\{cg.key.call}, \{cg.key.param}, \{cg.value});\n"
            this.acc.append s: rowCg
        }
        with boit: typing.binopOwner.iterateItems do for bo: boit loop {
            bm: u64
            bmo: typing.binopMethod.get key: bo.key
            match (
                bmo
            ) case some then {
                bm = bmo
            } case none then null
            rowBo: "INSERT OR IGNORE INTO binop_operator VALUES (0, \{bo.key}, \{bo.value}, \{bm});\n"
            this.acc.append s: rowBo
        }
        # the mono pair's two ids become the two columns that line up with the
        # nodeid-keyed rows above
        with mbit: typing.monoBinopOwner.iterateItems do for mb: mbit loop {
            mi: mb.key.mono
            mn: mb.key.node
            mm: u64
            mmo: typing.monoBinopMethod.get key: mb.key
            match (
                mmo
            ) case some then {
                mm = mmo
            } case none then null
            rowMb: "INSERT OR IGNORE INTO binop_operator VALUES (\{mi}, \{mn}, \{mb.value}, \{mm});\n"
            this.acc.append s: rowMb
        }
    }

    # appendMemberConst -- one row per named constant the compile-time evaluator
    # produced a value for. The key is packed (parentTypeId << 32 | nameId), the
    # same packing setMemberConst uses, and it is unpacked here so the two
    # columns line up with the decl tables.
    appendMemberConst: function {:this typing: ztyping.ZTyping} is {
        with mcit: typing.memberConst.iterateItems do for mc: mcit loop {
            row: "INSERT OR IGNORE INTO member_const VALUES (\{mc.key.owner}, \{mc.key.name}, '\{constValueText v: mc.value}');\n"
            this.acc.append s: row
        }
    }

    # appendConformance -- one row per recorded conformance (impl satisfies spec
    # under a label).
    appendConformance: function {:this typing: ztyping.ZTyping.view} is {
        citer: typing.conformance.iterate
        for cf: citer loop {
            lblSql: sqlStr s: cf.label.stringview
            facetSql: boolNum b: cf.isFacet
            row: "INSERT OR IGNORE INTO conformance VALUES (\{cf.conformanceId}, \{cf.implTypeId}, \{cf.specTypeId}, \{lblSql}, \{facetSql});\n"
            this.acc.append s: row
        }
    }

    # appendSymbolTable -- scope / entry / variable rows from the body-walk
    # environment. scope rows are the walk's frames in the order they were
    # opened (depth = that index); entry rows the locals and overlay rows
    # snapshotted when each frame closed; variable rows the per-id side
    # tables, deduped.
    appendSymbolTable: function {:this pool: zast.StringPool.view st: zenv.ZSymbolTable.view} is {
        seen: (IdSet u64)
        depth: u64
        nd: st.typing.decls.length
        di: u64
        for di < nd loop {
            d: ztypes.declid.create from: di
            di = di + 1
            if (st.typing.declIsFrame declId: d) when (st.frameHidden.has item: d.u64) == false then {
                lbl: frameLabelOf :st frame: d
                kind: "BLOCK"
                if lbl.length == 0 then kind = "CALL"
                kindSql: sqlStr s: kind
                nameSql: sqlStr s: lbl.stringview
                pd: st.typing.declParentOf declId: d
                parentSql: "NULL".string
                if (st.typing.declIsFrame declId: pd) then parentSql = "\{pd}"
                unreachNum: boolNum b: (st.unreachableFrames.has item: d.u64)
                r: "INSERT OR IGNORE INTO scope VALUES (\{d}, \{parentSql}, \{kindSql}, \{nameSql}, \{depth}, \{unreachNum});\n"
                this.acc.append s: r
                depth = depth + 1
            }
        }
        for e: st.entryDump.iterate loop {
            varSql: vidOrNullText o: e.varId
            origSql: optTidStr o: e.originalZtypeId
            defNum: boolNum b: e.isDefinition
            takNum: boolNum b: e.isTaken
            enmT: zast.poolTextAt :pool ref: (zast.nameid.create from: e.name)
            enmSql: sqlStr s: enmT.stringview
            r: "INSERT OR IGNORE INTO entry VALUES (\{e.entryId}, \{e.scopeId}, \{e.position}, \{enmSql}, \{e.ztypeId}, \{defNum}, \{varSql}, \{origSql}, \{takNum}, NULL, NULL, NULL);\n"
            this.acc.append s: r
            if (e.narrowedSubtype.isZero) == false then {
                nnb: zast.poolTextAt :pool ref: e.narrowedSubtype
                nnm: sqlStr s: nnb.stringview
                nr: "INSERT INTO narrowed_subtype VALUES (\{e.entryId}, \{nnm}, NULL, 0);\n"
                this.acc.append s: nr
            }
            with xit2: e.excludedSubtypes.iterate do for xn2i: xit2 loop {
                xn2: zast.poolTextAt :pool ref: (zast.nameid.create from: xn2i)
                xnm: sqlStr s: xn2.stringview
                xr: "INSERT INTO narrowed_subtype VALUES (\{e.entryId}, \{xnm}, NULL, 1);\n"
                this.acc.append s: xr
            }
            vd: e.varId
            match (
                vd
            ) case some then {
                seen.add item: vd
            } case none then null
        }
        for vid: seen.iterate loop {
            vidT: ztypes.vid.create from: vid
            if (st.reg.hasVariable id: vidT) == false then continue
            ztSql: "\{(st.reg.variableTypeOf id: vidT)}"
            ownSql: varOwnSql o: (st.reg.variableOwnershipOf id: vidT)
            privNum: boolNum b: (st.reg.variableIsPrivate id: vidT)
            boSql: nameIdSql :pool id: (st.reg.variableBorrowOriginOf id: vidT)
            soSql: originSql o: (st.reg.variableSynthOriginOf id: vidT)
            orSqlLit: "NULL".string
            vorigin: st.reg.variableOriginOf id: vidT
            if vorigin != ztypes.zvarorigin.synth then {
                orKind: originKindSql o: vorigin
                orSqlLit = sqlStr s: orKind.stringview
            }
            r: "INSERT OR IGNORE INTO variable VALUES (\{vid}, \{ztSql}, \{ownSql}, \{privNum}, \{boSql}, \{soSql}, \{orSqlLit});\n"
            this.acc.append s: r
        }
    }

    # --- canonical (id-normalized) renderers for the dump-canon gate ---
    # Each emits a table's id-independent projection (PK ids omitted, FK ids
    # resolved to names, id-embedding cnames dropped), rows sorted, under a
    # "## <table>" header.
    emitSection: function {:this title: StringView rows: List String} is {
        rows.sort
        this.acc.append s: "## "
        this.acc.append s: title
        this.acc.append s: "\n"
        ri: u64
        rn: rows.length
        for ri < rn loop {
            rc: (rows.get i: ri)
            this.acc.append s: rc
            this.acc.append s: "\n"
            ri = ri + 1
        }
    }

    appendUnitsCanon: function {:this program: Node.view} is {
        rows: (List String)
        match (
            program
        ) case program then {
            mn: program.mainUnitName.stringview
            uCnt9c: program.ast.units.length
            uIdx9c: u64
            for uIdx9c < uCnt9c loop {
                uId: (zast.nodeid.create from: (program.ast.units.get i: uIdx9c))
                uIdx9c = uIdx9c + 1
                u: program.ast.nodes.get i: uId.u64
                match (
                    u
                ) case namedoperation then {
                    uname: zast.poolTextAt pool: program.ast.names ref: u.name
                    isMain: uname.stringview == mn
                    unameSql: sqlStr s: uname.stringview
                    isMainStr: boolNum b: isMain
                    line: "\{unameSql} | \{isMainStr}"
                    rows.append line
                } else null
            }
        } else null
        this.emitSection title: "unit" :rows
    }


    # appendGenericChildren -- one row per specialization-tree edge:
    # parent type-id x argument key -> child spec type-id.
    appendGenericChildren: function {:this st: zenv.ZSymbolTable.view} is {
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            if tid >= st.reg.typeById.length then return
            zt: st.reg.typeById.get i: tid
            with git: zt.genericChildren.iterateItems do for ge: git loop {
                row: "INSERT OR IGNORE INTO generic_child VALUES (\{tid}, \{ge.key}, \{ge.value});\n"
                this.acc.append s: row
            }
            tid = tid.next
        }
    }

    # appendGenericArgs -- one row per specialization argument, in
    # definition-parameter order.
    appendGenericArgs: function {:this st: zenv.ZSymbolTable.view} is {
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            gargs: (ListVal u64)
            if tid < st.reg.typeById.length then {
                zt: st.reg.typeById.get i: tid
                zn: zt.genericArgs.length
                zi: u64
                for zi < zn loop {
                    ze: zt.genericArgs.get i: zi
                    gargs.append ze
                    zi = zi + 1
                }
            }
            an: gargs.length
            ai: u64
            for ai < an loop {
                av: gargs.get i: ai
                iv: u64
                if (st.reg.genericArgIsValueAt
                    specId: (ztypes.tid.create from: tid.u64)
                    ordinal: ai
                ) then iv = 1
                row: "INSERT OR IGNORE INTO generic_arg VALUES (\{tid}, \{ai}, \{av}, \{iv});\n"
                this.acc.append s: row
                ai = ai + 1
            }
            tid = tid.next
        }
    }

    appendGenericChildrenCanon: function {:this unm: StringView st: zenv.ZSymbolTable.view} is {
        rows: (List String)
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            gkeys: (ListVal u64)
            gtids: (ListVal u64)
            if tid < st.reg.typeById.length then {
                zt: st.reg.typeById.get i: tid
                du: definedUnitOf :st :tid
                inUnit: false
                match (
                    du
                ) case some then {
                    if du.stringview == unm then inUnit = true
                } case none then null
                if inUnit then {
                    with zit8: zt.genericChildren.iterateItems do for ze8: zit8 loop {
                        gkeys.append ze8.key
                        gtids.append ze8.value
                    }
                }
            }
            {
                if gkeys.length > 0 then {
                    idx: u64
                    gn: gkeys.length
                    for idx < gn loop {
                        ekey: gkeys.get i: idx
                        eval: gtids.get i: idx
                        pn: canonTypeName reg: st.reg :tid
                        # the edge key's kind comes from the child's last
                        # ordinal: a numeric VALUE key prints its literal
                        kc: st.reg.genericArgCount specId: (ztypes.tid.create from: eval.u64)
                        kIsVal: false
                        if kc > 0 then {
                            kIsVal = (st.reg.genericArgIsValueAt
                                specId: (ztypes.tid.create from: eval.u64)
                                ordinal: kc - 1
                            )
                        }
                        kn: String
                        if kIsVal then {
                            kn = "\{ekey}"
                        } else {
                            kn = canonTypeName reg: st.reg tid: (ztypes.tid.create from: ekey.u64)
                        }
                        cn: canonTypeName reg: st.reg tid: (ztypes.tid.create from: eval.u64)
                        row: "generic_child \{pn} \{kn} \{cn}"
                        rows.append row
                        idx = idx + 1
                    }
                }
            }
            tid = tid.next
        }
        this.emitSection title: "generic_child" :rows
    }

    appendGenericArgsCanon: function {:this unm: StringView st: zenv.ZSymbolTable.view} is {
        rows: (List String)
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            cargs: (ListVal u64)
            if tid < st.reg.typeById.length then {
                zt: st.reg.typeById.get i: tid
                du: definedUnitOf :st :tid
                inUnit: false
                match (
                    du
                ) case some then {
                    if du.stringview == unm then inUnit = true
                } case none then null
                if inUnit then {
                    cz: zt.genericArgs.length
                    ci: u64
                    for ci < cz loop {
                        ce: zt.genericArgs.get i: ci
                        cargs.append ce
                        ci = ci + 1
                    }
                }
            }
            {
                if cargs.length > 0 then {
                    an: cargs.length
                    ai: u64
                    for ai < an loop {
                        av: cargs.get i: ai
                        sn: canonTypeName reg: st.reg :tid
                        iv: u64
                        vn: String
                        if (st.reg.genericArgIsValueAt
                            specId: (ztypes.tid.create from: tid.u64)
                            ordinal: ai
                        ) then {
                            iv = 1
                            vn = "\{av}"
                        } else {
                            vn = canonTypeName reg: st.reg tid: (ztypes.tid.create from: av.u64)
                        }
                        row: "generic_arg \{sn} \{ai} \{vn} \{iv}"
                        rows.append row
                        ai = ai + 1
                    }
                }
            }
            tid = tid.next
        }
        this.emitSection title: "generic_arg" :rows
    }

    appendTypesCanon: function {:this unm: StringView st: zenv.ZSymbolTable.view} is {
        rows: (List String)
        n: st.reg.nextTypeId
        tid: ztypes.tid
        for tid < n loop {
            if tid >= st.reg.typeById.length then return
            zt: st.reg.typeById.get i: tid
            du: definedUnitOf :st :tid
            inUnit: false
            match (
                du
            ) case some then {
                if du.stringview == unm then inUnit = true
            } case none then null
            if inUnit then {
                nameSql: sqlStr s: zt.name.stringview
                ttName: ztypes.ztypetypeName t: zt.typetype
                ttSql: sqlStr s: ttName.stringview
                valSql: optBoolSql o: zt.isValtype
                genSql: boolNum b: zt.isgeneric
                ndSql: boolNum b: zt.needsDestructor
                heapSql: boolNum b: zt.isHeapAllocated
                line: "\{nameSql} | \{ttSql} | \{valSql} | \{genSql} | \{ndSql} | \{heapSql}"
                rows.append line
            }
            tid = tid.next
        }
        this.emitSection title: "types" :rows
    }

    # appendDeclChildCanon -- the declaration namespace of every type defined in
    # this unit, one row per typed child: owner name, child name, child type
    # name, position, param ownership. The canon dump's only view of member
    # structure, so it resolves ids to names rather than dumping the decl tree.
    appendDeclChildCanon: function {:this ast: Ast.view unm: StringView st: zenv.ZSymbolTable.view} is {
        rows: (List String)
        tn: st.reg.nextTypeId
        tid: u64
        for tid < tn loop {
            pid: tid
            tid = tid + 1
            pdu: definedUnitOf :st tid: (ztypes.tid.create from: pid.u64)
            inUnit: false
            match (
                pdu
            ) case some then {
                if pdu.stringview == unm then inUnit = true
            } case none then null
            if inUnit then {
                nms: (ListVal u64)
                tds: (ListVal u64)
                (st.typing.declChildRows
                    ownerTid: (ztypes.tid.create from: pid.u64)
                    names: nms
                    tids: tds
                )
                pName: canonTypeName reg: st.reg tid: (ztypes.tid.create from: pid.u64)
                pSql: sqlStr s: pName.stringview
                pos: u64
                cn: nms.length
                for pos < cn loop {
                    nid: nms.get i: pos
                    cName: (canonTypeName
                        reg: st.reg
                        tid: (ztypes.tid.create from: (tds.get i: pos))
                    )
                    cnB8: ast.names.texts.get i: nid.u64
                    cnSql: sqlStr s: cnB8.stringview
                    ctSql: sqlStr s: cName.stringview
                    own: (st.typing.declOwnershipOfId
                        parentTypeId: (ztypes.tid.create from: pid.u64)
                        nameId: (zast.nameid.create from: nid.u32.orPanic)
                    )
                    poSql: paramOwnSql o: own
                    line: "\{pSql} | \{cnSql} | \{ctSql} | \{pos} | \{poSql}"
                    rows.append line
                    pos = pos + 1
                }
            }
        }
        this.emitSection title: "decl_child" :rows
    }

    appendConformanceCanon: function {:this unm: StringView st: zenv.ZSymbolTable.view} is {
        rows: (List String)
        citer: st.typing.conformance.iterate
        for cf: citer loop {
            idu: definedUnitOf :st tid: (ztypes.tid.create from: cf.implTypeId)
            inUnit: false
            match (
                idu
            ) case some then {
                if idu.stringview == unm then inUnit = true
            } case none then null
            if inUnit then {
                iName: canonTypeName reg: st.reg tid: (ztypes.tid.create from: cf.implTypeId)
                sName: canonTypeName reg: st.reg tid: (ztypes.tid.create from: cf.specTypeId)
                iSql: sqlStr s: iName.stringview
                sSql: sqlStr s: sName.stringview
                lblSql: sqlStr s: cf.label.stringview
                facetSql: boolNum b: cf.isFacet
                line: "\{iSql} | \{sSql} | \{lblSql} | \{facetSql}"
                rows.append line
            }
        }
        this.emitSection title: "conformance" :rows
    }

    # appendMemberConstCanon -- the compile-time VALUE of each named constant
    # this unit declares, keyed by name rather than by the packed
    # (parentTypeId, nameId) the table uses, and sorted like every canon
    # section so the golden does not depend on map order.
    appendMemberConstCanon: function {:this pool: zast.StringPool.view unm: StringView st: zenv.ZSymbolTable} is {
        rows: (List String)
        with mcit: st.typing.memberConst.iterateItems do for mc: mcit loop {
            pt: mc.key.owner
            nm: mc.key.name
            # the parent of a unit constant IS the unit type, whose name is the
            # unit name -- definedUnitOf answers for a type declared INSIDE a
            # unit and has nothing to say about the unit type itself.
            tn: canonTypeName reg: st.reg tid: (ztypes.tid.create from: pt.u64)
            if tn.stringview == unm then {
                mn: pool.texts.get i: nm.u64
                cvt: constValueCanonText :pool :st v: mc.value
                line: "\{sqlStr s: mn.stringview} | \{sqlStr s: cvt.stringview}"
                rows.append line
            }
        }
        this.emitSection title: "member_const" :rows
    }

    # appendSymbolTableCanon -- the body-walk environment (scope / entry /
    # variable / narrowed_subtype), id-normalized: frame and entry ids are
    # dropped, a frame's parent named by its label, entry/variable ztype via
    # canonTypeName. No unit filter -- the table holds only the main unit's
    # bodies.
    appendSymbolTableCanon: function {:this pool: zast.StringPool.view st: zenv.ZSymbolTable.view} is {
        scopeName: (IdMapR u64 value: String)
        scopeRows: (List String)
        depth: u64
        nd: st.typing.decls.length
        di: u64
        for di < nd loop {
            d: ztypes.declid.create from: di
            di = di + 1
            if (st.typing.declIsFrame declId: d) when (st.frameHidden.has item: d.u64) == false then {
                lbl: frameLabelOf :st frame: d
                scopeName.set key: d.u64 value: lbl.copy
                parentNameSql: "NULL".string
                pd: st.typing.declParentOf declId: d
                po: scopeName.get key: pd.u64
                match (
                    po
                ) case some then {
                    parentNameSql = sqlStr s: po.stringview
                } case none then null
                kind: "BLOCK"
                if lbl.length == 0 then kind = "CALL"
                kindSql: sqlStr s: kind
                nameSql: sqlStr s: lbl.stringview
                unreachNum: boolNum b: (st.unreachableFrames.has item: d.u64)
                line: "\{parentNameSql} | \{kindSql} | \{nameSql} | \{depth} | \{unreachNum}"
                scopeRows.append line
                depth = depth + 1
            }
        }
        this.emitSection title: "scope" rows: scopeRows

        entryRows: (List String)
        narrowedRows: (List String)
        seen: (IdSet u64)
        for e: st.entryDump.iterate loop {
            so: scopeName.get key: e.scopeId
            match (
                so
            ) case some then {
                scNameSql: sqlStr s: so.stringview
                enmT8: zast.poolTextAt :pool ref: (zast.nameid.create from: e.name)
                enmSql: sqlStr s: enmT8.stringview
                ztName: canonTypeName reg: st.reg tid: e.ztypeId
                ztSql: sqlStr s: ztName.stringview
                defNum: boolNum b: e.isDefinition
                hasVar: false
                vh: e.varId
                match (
                    vh
                ) case some then {
                    hasVar = true
                } case none then null
                hasVarNum: boolNum b: hasVar
                takNum: boolNum b: e.isTaken
                eline: "\{scNameSql} | \{e.position} | \{enmSql} | \{ztSql} | \{defNum} | \{hasVarNum} | \{takNum}"
                entryRows.append eline
            } case none then null
            if (e.narrowedSubtype.isZero) == false then {
                nnb8: zast.poolTextAt :pool ref: e.narrowedSubtype
                nnmSql: sqlStr s: nnb8.stringview
                narrowedRows.append "\{nnmSql} | 0"
            }
            with xit: e.excludedSubtypes.iterate do for xni: xit loop {
                xn: zast.poolTextAt :pool ref: (zast.nameid.create from: xni)
                xnmSql: sqlStr s: xn.stringview
                narrowedRows.append "\{xnmSql} | 1"
            }
            vd: e.varId
            match (
                vd
            ) case some then {
                seen.add item: vd
            } case none then null
        }
        this.emitSection title: "entry" rows: entryRows

        varRows: (List String)
        for vid: seen.iterate loop {
            vidT: ztypes.vid.create from: vid
            if (st.reg.hasVariable id: vidT) == false then continue
            vtid: st.reg.variableTypeOf id: vidT
            ztName: canonTypeName reg: st.reg tid: vtid
            ztSql: sqlStr s: ztName.stringview
            ownSql: varOwnSql o: (st.reg.variableOwnershipOf id: vidT)
            privNum: boolNum b: (st.reg.variableIsPrivate id: vidT)
            boSql: nameIdSql :pool id: (st.reg.variableBorrowOriginOf id: vidT)
            soSql: originSql o: (st.reg.variableSynthOriginOf id: vidT)
            orSql: originKindSql o: (st.reg.variableOriginOf id: vidT)
            vline: "\{ztSql} | \{ownSql} | \{privNum} | \{boSql} | \{soSql} | \{orSql}"
            varRows.append vline
        }
        this.emitSection title: "variable" rows: varRows

        this.emitSection title: "narrowed_subtype" rows: narrowedRows
    }

    appendArgDispositionCanon: function {:this ast: Ast.view st: zenv.ZSymbolTable.view} is {
        rows: (List String)
        with adit: st.typing.argDisposition.iterateItems do for ad: adit loop {
            an: argAtomName :ast id: ad.key
            if an.length > 0 then {
                anSql: sqlStr s: an.stringview
                dnm: ztypes.zparamownershipName ad.value
                rows.append "\{anSql} | \{dnm}"
            }
        }
        this.emitSection title: "arg_disposition" :rows
    }

    appendCallGenericBindingCanon: function {:this program: Node.view st: zenv.ZSymbolTable} is {
        rows: (List String)
        match (
            program
        ) case program then {
            with cgit: st.typing.callGenericBinding.iterateItems do for cg: cgit loop {
                hld: (zast.poolTextAt
                    pool: program.ast.names
                    ref: (zast.nameid.create from: cg.key.param.u32.orPanic)
                )
                tn: canonTypeName reg: st.reg tid: (ztypes.tid.create from: cg.value)
                hSql: sqlStr s: hld.stringview
                tSql: sqlStr s: tn.stringview
                rows.append "\{hSql} | \{tSql}"
            }
        } else null
        this.emitSection title: "call_generic_binding" :rows
    }

}

# walkExprStamps -- an Expression wrapper's typed row shows the innermost
# non-expression node's
# stamp when one exists, falling back to the wrapper's own. The walk returns
# each node's effective stamp so nested wrappers see through inner wrappers;
# overrides are collected and applied to nodeType after the walk (check-time
# propagation has already read the original values).
# walkExprStampsAt -- the id-taking entry: the row view is this frame's, so a
# caller can lend the table exclusively.
walkExprStampsAt: function {
    typing: ztyping.ZTyping
    ast: Ast.view
    nId: zast.nodeid
    ids: ListVal u64
    vals: (ListVal u64)
} out u64 is {
    n: ast.nodes.get i: nId.u64
    return (walkExprStamps :typing :ast :n :ids :vals)
}

# recurse an expression, emitting a SQL row for each node's typecheck stamps.
walkExprStamps: function {
    typing: ztyping.ZTyping
    ast: Ast.view
    n: Node.view
    ids: ListVal u64
    vals: ListVal u64
} out u64 is {
    match (
        n
    ) case expression then {
        eff: walkExprStamps :typing :ast n: (ast.nodes.get i: n.expression.u64) :ids :vals
        if eff > 0 then {
            wid: n.nodeid.u64
            ids.append wid
            ev: eff
            vals.append ev
            return eff
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case binop then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.lhs.u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.operator.u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.rhs.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case atomstring then {
        spiter: n.stringparts.iterate
        for sp: spiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: sp.u64) :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case dottedpath then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.parent.u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.child.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case call then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.callable.u64) :ids :vals
        aiter: n.arguments.iterate
        for arg: aiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: arg.u64) :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case typeofexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.source.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case namedoperation then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.operation.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case datablock then {
        eiter: n.elements.iterate
        for el: eiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: el.u64) :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.outType :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case yieldexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.expr.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case statement then {
        sliter: n.statements.iterate
        for lnId: sliter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: lnId.u64) :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case statementline then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.statementline.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case assignment then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.value.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case reassignment then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.topath.u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.value.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case swapstmt then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.lhs.u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.rhs.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case ifexpr then {
        cliter: n.clauses.iterate
        for cl: cliter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: cl.u64) :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.elseclause :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case ifclause then {
        coiter: n.conditions.iterate
        for coId: coiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: coId.u64) :ids :vals
        }
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.statement.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case forexpr then {
        fciter: n.conditions.iterate
        for fc: fciter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: fc.u64) :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.body :ids :vals
        fpiter: n.postconditions.iterate
        for fp: fpiter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: fp.u64) :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case doexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.statement.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case withexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.value.u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.body.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case caseexpr then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.subject.u64) :ids :vals
        cciter: n.clauses.iterate
        for cc: cciter loop {
            walkExprStamps :typing :ast n: (ast.nodes.get i: cc.u64) :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.elseclause :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case caseclause then {
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.matcharm.u64) :ids :vals
        walkExprStamps :typing :ast n: (ast.nodes.get i: n.statement.u64) :ids :vals
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case functiondef then {
        walkExprStampsOptAt :typing :ast oId: n.returntype :ids :vals
        piter: n.parameters.iterate
        for pmId: piter loop {
            pm: ast.nodes.get i: pmId.u64
            walkExprStamps :typing :ast n: pm :ids :vals
        }
        walkExprStampsOptAt :typing :ast oId: n.body :ids :vals
        faiter: n.asItems.iterate
        for amId: faiter loop {
            am: ast.nodes.get i: amId.u64
            walkExprStamps :typing :ast n: am :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case objectdef then {
        oiiter: n.isItems.iterate
        for oiId: oiiter loop {
            oi: ast.nodes.get i: oiId.u64
            walkExprStamps :typing :ast n: oi :ids :vals
        }
        oaiter: n.asItems.iterate
        for oaId: oaiter loop {
            oa: ast.nodes.get i: oaId.u64
            walkExprStamps :typing :ast n: oa :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case unitdef then {
        ubiter: n.body.iterate
        for ub: ubiter loop {
            ubNode: ast.nodes.get i: ub.u64
            walkExprStamps :typing :ast n: ubNode :ids :vals
        }
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case atomid then {
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case labelvalue then {
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } case stringchunk then {
        return (ztyping.nodeTypeAt tbl: typing.nodeType nid: n.nodeid.u64)
    } else {
        return 0
    }
}

# walkExprStampsOptAt -- the id-taking entry (0 = absent).
walkExprStampsOptAt: function {
    typing: ztyping.ZTyping
    ast: Ast.view
    oId: zast.nodeid
    ids: ListVal u64
    vals: (ListVal u64)
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    walkExprStamps :typing :ast n: o :ids :vals
}

# overrideExpressionStamps -- collect the wrapper overrides across every unit,
# then rewrite nodeType so appendTypedNodes emits the descended values.
overrideExpressionStamps: function {typing: ztyping.ZTyping program: Node.view} is {
    ids: (ListVal u64)
    vals: (ListVal u64)
    match (
        program
    ) case program then {
        uCnt9d: program.ast.units.length
        uIdx9d: u64
        for uIdx9d < uCnt9d loop {
            uId: (zast.nodeid.create from: (program.ast.units.get i: uIdx9d))
            uIdx9d = uIdx9d + 1
            (walkExprStampsAt
                :typing
                ast: program.ast
                nId: (zast.nodeid.create from: uId)
                :ids
                :vals
            )
        }
    } else null
    i: u64
    cnt: ids.length
    for i < cnt loop {
        k: ids.get :i
        v: vals.get :i
        setk: k
        setv: v
        ztyping.nodeTypeSet tbl: typing.nodeType nid: setk tid: (ztypes.tid.create from: setv.u64)
        i = i + 1
    }
}

# --- entry point ---

# dumpSql -- the full dump: schema, then files, ast_nodes and unit rows.
dumpSql: function {program: Node.view vfs: zvfs.ZVfs symtab: zenv.ZSymbolTable} out String is {
    d: ZDumper acc: schemaSql
    d.appendFiles :vfs
    d.appendNodes :program
    match (
        program
    ) case program then {
        d.appendSynthNodes ast: program.ast typing: symtab.typing
    } else null
    d.appendUnits :program typing: symtab.typing
    match (
        program
    ) case program then {
        d.appendTypes st: symtab
        d.appendDecls ast: program.ast typing: symtab.typing
    } else null
    d.appendGenericChildren st: symtab
    d.appendGenericArgs st: symtab
    overrideExpressionStamps typing: symtab.typing :program
    d.appendTypedNodes typing: symtab.typing
    match (
        program
    ) case program then {
        d.appendAtomStamps typing: symtab.typing pool: program.ast.names
    } else null
    d.appendMemberConst typing: symtab.typing
    d.appendConformance typing: symtab.typing
    match (
        program
    ) case program then {
        d.appendSymbolTable pool: program.ast.names st: symtab
    } else null
    return d.acc.copy
}

# canonTypeName -- a type id's registered name, or "?" when unregistered.
# Renders foreign-key ids as stable names in the canonical dump.
canonTypeName: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out String is {
    if (reg.typeValid tid: (ztypes.tid.create from: tid.u64)) == false then return "?".string
    zt: reg.typeById.get i: tid
    return zt.name.copy
}

# dumpCanon -- a canonical, id-normalized rendering of the typecheck state
# (unit, types, decl_child, conformance, and the body-walk symbol table:
# scope / entry / variable / narrowed_subtype) for the dump-canon regression
# gate. PK ids are omitted, FK ids resolved to names, id-embedding
# cnames dropped, rows sorted. Parse-level tables (files / ast_nodes) are
# covered by the lexer / parser goldens and omitted here.
# mainUnitNameOf -- the program's main unit name as an owned String.
mainUnitNameOf: function {program: Node.view} out String is {
    match (
        program
    ) case program then {
        return program.mainUnitName.copy
    } else {
        return "".string
    }
}

# render the whole program (AST plus symbol table) as canonical text
# for golden-diff comparison.
dumpCanon: function {program: Node.view symtab: zenv.ZSymbolTable} out String is {
    mu: mainUnitNameOf :program
    d: ZDumper acc: "".string
    d.appendUnitsCanon :program
    match (
        program
    ) case program then {
        d.appendTypesCanon unm: mu.stringview st: symtab
        d.appendDeclChildCanon ast: program.ast unm: mu.stringview st: symtab
        d.appendArgDispositionCanon ast: program.ast st: symtab
    } else null
    d.appendGenericChildrenCanon unm: mu.stringview st: symtab
    d.appendGenericArgsCanon unm: mu.stringview st: symtab
    d.appendConformanceCanon unm: mu.stringview st: symtab
    match (
        program
    ) case program then {
        d.appendMemberConstCanon pool: program.ast.names unm: mu.stringview st: symtab
        d.appendSymbolTableCanon pool: program.ast.names st: symtab
    } else null
    d.appendCallGenericBindingCanon :program st: symtab
    return d.acc.copy
}
