# Type model for the zerolang type checker: the type descriptor (ZType), the
# variable / overlay-row / conformance carriers, the id registry, and the pure
# numeric-literal and name-mangling helpers.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :tid
    :declid
    :vid
    :constraintdesc
    :ZConformance
    :ZEntry
    :ZType
    :ZTypeRegistry
    :ZVariable
    :zvarorigin
    :constfail
    :constfailkind
    :noConstFail
    :constraintkind
    :cval
    :floatFitsFloat
    :intFitsFloat
    :isFloatKind
    :makeArmConst
    :makeFloatConst
    :makeIntConst
    :makeStrConst
    :mangleMemberPrefix
    :mangleVarName
    :newRegistry
    :noConst
    :numkindByName
    :parseLiteralValue
    :deftarget
    :noDefTarget
    :parseNumber
    :parseNumberAs
    :suffixInfoOf
    :zconstkind
    :zconstkindName
    :zcontrolkind
    :zcontrolkindName
    :zlockholderkindName
    :numkind
    :numkindName
    :zlockholder
    :zlockholderkind
    :zlockscope
    :zlockstate
    :zlockstateName
    :zownership
    :zownershipName
    :zparamownership
    :zparamownershipInt
    :zparamownershipName
    :zsrcpos
    :ztypetype
    :ztypetypeName
}

# the top-level classification a ZType carries: record / class / variant
# / union / protocol / facet, plus function, numeric, and generic-param.
ztypetype: variant {
    # the null type, which has one value and carries nothing
    nullType: null
    # a generic parameter's own type, minted per parameter during resolution
    genericParam: null
    # a unit. A unit IS a type here, which is what lets a subunit and a template
    # be ordinary members
    unitType: null
    # a function or method signature
    functionType: null
    # a record: a valtype with named fields
    recordType: null
    # a class: a reftype with named fields
    classType: null
    # a variant: a valtype tagged sum
    variantType: null
    # a union: a reftype tagged sum
    unionType: null
    # a protocol: a reftype interface with a vtable
    protocolType: null
    # a facet: a valtype interface carrying its vtable beside the value
    facetType: null
    # a data block's element type
    dataType: null
    # a tag: the discriminator type a sum is `as`-declared over
    tagType: null
    # the type of an expression that does not return, so nothing downstream of
    # it is reachable
    neverType: null
} as { tag: u8.tag }

# the kind of a built-in control primitive (if / for / match / with / do).
zcontrolkind: variant {
    # no control transfer: the statement falls through to the next
    none: null
    # a return, which leaves the function
    returnKind: null
    # a break, which leaves the innermost loop
    breakKind: null
    # a continue, which starts the innermost loop's next iteration
    continueKind: null
    # a raised error
    errorKind: null
    # a panic, which unwinds nothing and ends the process
    panicKind: null
} as { tag: u8.tag }

# a value's ownership mode at a binding (owned vs the borrowed forms).
zownership: variant {
    # the binding owns the value and is responsible for destroying it
    owned: null
    # the binding refers to a value something else owns, so it destroys nothing
    borrowed: null
} as { tag: u8.tag }

# the lock held on a path: none, shared, or exclusive.
zlockstate: variant {
    # nothing else may read OR write the locked path while this stands
    exclusive: null
    # other readers are admitted, writers are not. A borrow takes exclusive on
    # the leaf and shared on every prefix above it
    shared: null
} as { tag: u8.tag }

# whether a lock is on the value the operation actually reaches -- the leaf of
# its path -- or is bookkeeping on a prefix so that leaf can be taken. A SHARED
# target is a live read of its subtree; a SHARED intent is not.
zlockscope: variant {
    # the lock on the path actually named
    target: null
    # the lock on a prefix of it, which is what keeps a parent from being
    # replaced while a child is held
    intent: null
} as { tag: u8.tag }

# a parameter's ownership annotation. Ownership is two axes -- who owns the
# value, and what may be called on it -- so the grid is `.take` (owned and
# mutable), `.hold` (owned and readonly), `.borrow` (not owned but still
# mutable: mutating methods may be called through it) and `.view` (not owned
# and readonly, so the argument stays readable across the call). Whether a
# RESULT keeps its inputs locked is the declaration's business (`outx`), not
# a marker's. `lock` parses as a spelling of borrowMode; integer slot 2 is
# unassigned so dumps stay comparable, and 6 and 7 -- the retired `.takex` and
# `.holdx` -- likewise.
zparamownership: variant {
    # no annotation: the default, which borrows
    noneMode: null
    # `.take` -- ownership moves in, and the caller's binding is spent
    takeMode: null
    # `.borrow` -- not owned, and writable. `lock` parses as a spelling of this
    borrowMode: null
    # `.view` -- not owned and READONLY, so the argument stays readable across
    # the call
    viewMode: null
    # `.hold` -- owned and readonly: moved in, then frozen
    holdMode: null
} as { tag: u8.tag }

# what is holding a lock -- a binding, a view, or an iterator.
zlockholderkind: variant {
    # a binding holds it
    varKind: null
    # a call holds it, for the call's duration
    callKind: null
    # an iterator holds it, which is why it lasts to the end of the enclosing
    # scope
    forKind: null
} as { tag: u8.tag }

# the payload kind of a compile-time constant. A truth value is an `armKind`
# over bool's type like any other sum constant: bool IS a variant, and a
# constant that threw its arm identity away had to spell the arms back to
# answer `.true` / `.false`, which is the one thing a folded value should
# never need to do.
zconstkind: variant {
    # not a constant: the value is only known at runtime
    none: null
    # an integer, in `ival`
    ivalKind: null
    # a float, in `fval`
    fvalKind: null
    # a string, in `strId` -- an index into the constant pool, 1-based so 0 can
    # mean none
    svalKind: null
    # a sum arm, identified by `armTid` and `armName`. A truth value is one of
    # these over bool's type, bool being a variant like any other
    armKind: null
} as { tag: u8.tag }

# Why a compile-time evaluation could not produce a value. The evaluator
# RECORDS one of these and never reports; the caller that REQUIRED the value
# renders it. A body `if` fold requires nothing of its condition -- it takes a
# value when there is one and emits a runtime branch when there is not -- so it
# renders nothing, and an optimisation cannot turn a legal program into an
# error.
#
# The kind is an ARM, not rendered text: the renderer owns the wording, so the
# message can change without every recording site knowing it.
constfailkind: variant {
    # no failure; the evaluation produced a value
    none: null
    # an interpolation, which cannot be folded because it builds at runtime
    interp: null
    # the arithmetic left the range the evaluator works in
    overflow: null
    # a division by zero, caught HERE rather than trapping at runtime as the
    # emitted form would
    divZero: null
    # the constant depends on itself, directly or through others
    cycle: null
    # the fold reached a node that had already failed to parse or check
    reachedError: null
    # a method the evaluator does not implement, which is a gap rather than a
    # program error
    unsupportedMethod: null
    # a substring whose bounds fall outside the string
    substringRange: null
} as { tag: u8.tag }

# One recorded evaluation failure. A VALTYPE for the reason cval is: it copies
# out of the typing state rather than holding a lock on it. Text the message
# needs -- a constant's name, a user `error`'s own words -- is interned in
# ZTyping.constStrings and reached through strId, which indexes it; 0 reads
# the sentinel row and means "none".
constfail: record {
    # which failure it was
    kind: constfailkind
    # the node that failed, so the renderer can find it again
    nodeid: zast.nodeid
    # the line to report
    lineno: u32
    # the column to report
    colno: u32
    # how many columns to underline
    width: u32
    # the offending text when the failure carries one, as a constant-pool index
    strId: u32
}

# Concrete numeric type a literal resolves to. Parsing accumulates in
# u64; the 128-bit kinds carry the classification but a magnitude above
# u64 is out of range.
numkind: variant {
    # the i8 numeric type
    i8Type: null
    # the i16 numeric type
    i16Type: null
    # the i32 numeric type
    i32Type: null
    # the i64 numeric type
    i64Type: null
    # the i128 numeric type
    i128Type: null
    # the u8 numeric type
    u8Type: null
    # the u16 numeric type
    u16Type: null
    # the u32 numeric type
    u32Type: null
    # the u64 numeric type
    u64Type: null
    # the u128 numeric type
    u128Type: null
    # the c8 numeric type
    c8Type: null
    # the c32 numeric type
    c32Type: null
    # the f16 numeric type
    f16Type: null
    # the f32 numeric type
    f32Type: null
    # the f64 numeric type
    f64Type: null
    # the f128 numeric type
    f128Type: null
} as { tag: u8.tag }

# --- enum arm-name dumpers ---

# the printable name of a `ztypetype`.
# deftarget -- the (unit, definition) pair an alias or re-export names. Absent
# is a zero `unit`; the producers never fill one half alone.
deftarget: record {
    # the unit half of a definition's name, interned
    unitName: zast.nameid
    # the definition half, interned. The pair is what a cross-unit reference
    # resolves against
    defName: zast.nameid
}

# noDefTarget -- the absent pair.
noDefTarget: function {} out deftarget is {
    return (deftarget unitName: (zast.nameid.create from: 0) defName: (zast.nameid.create from: 0))
}

# the family's name as text, for diagnostics and dumps. The registry
# compares the ARM; this is only for rendering
ztypetypeName: function {t: ztypetype} out String is {
    match (
        t
    ) case nullType then {
        return "NULL".string
    } case genericParam then {
        return "GENERIC_PARAM".string
    } case unitType then {
        return "UNIT".string
    } case functionType then {
        return "FUNCTION".string
    } case recordType then {
        return "RECORD".string
    } case classType then {
        return "CLASS".string
    } case variantType then {
        return "VARIANT".string
    } case unionType then {
        return "UNION".string
    } case protocolType then {
        return "PROTOCOL".string
    } case facetType then {
        return "FACET".string
    } case dataType then {
        return "DATA".string
    } case tagType then {
        return "TAG".string
    } case neverType then {
        return "NEVER".string
    }
}

# the printable name of a `zcontrolkind`.
zcontrolkindName: function {t: zcontrolkind} out String is {
    match (
        t
    ) case none then {
        return "NONE".string
    } case returnKind then {
        return "RETURN".string
    } case breakKind then {
        return "BREAK".string
    } case continueKind then {
        return "CONTINUE".string
    } case errorKind then {
        return "ERROR".string
    } case panicKind then {
        return "PANIC".string
    }
}

# the printable name of a `zownership`.
zownershipName: function {t: zownership} out String is {
    match (
        t
    ) case owned then {
        return "OWNED".string
    } case borrowed then {
        return "BORROWED".string
    }
}

# the printable name of a `zlockstate`.
zlockstateName: function {t: zlockstate} out String is {
    match (
        t
    ) case exclusive then {
        return "EXCLUSIVE".string
    } case shared then {
        return "SHARED".string
    }
}

# the printable name of a `zparamownership`.
zparamownershipName: function {t: zparamownership} out String is {
    match (
        t
    ) case noneMode then {
        return "NONE".string
    } case takeMode then {
        return "TAKE".string
    } case borrowMode then {
        return "BORROW".string
    } case viewMode then {
        return "VIEW".string
    } case holdMode then {
        return "HOLD".string
    }
}

# the stable integer encoding of a `zparamownership` (for SQL dumps).
zparamownershipInt: function {t: zparamownership} out u64 is {
    match (
        t
    ) case noneMode then {
        return 3
    } case takeMode then {
        return 0
    } case borrowMode then {
        return 1
    } case viewMode then {
        return 4
    } case holdMode then {
        return 5
    }
}

# the printable name of a `zlockholderkind`.
zlockholderkindName: function {t: zlockholderkind} out String is {
    match (
        t
    ) case varKind then {
        return "VAR".string
    } case callKind then {
        return "CALL".string
    } case forKind then {
        return "FOR".string
    }
}

# the printable name of a `zconstkind`.
zconstkindName: function {t: zconstkind} out String is {
    match (
        t
    ) case none then {
        return "NONE".string
    } case ivalKind then {
        return "IVAL".string
    } case fvalKind then {
        return "FVAL".string
    } case svalKind then {
        return "SVAL".string
    } case armKind then {
        return "ARM".string
    }
}

# the printable name of a numeric kind (u8 / i64 / f64 / ...).
numkindName: function {k: numkind} out String is {
    match (
        k
    ) case i8Type then {
        return "i8".string
    } case i16Type then {
        return "i16".string
    } case i32Type then {
        return "i32".string
    } case i64Type then {
        return "i64".string
    } case i128Type then {
        return "i128".string
    } case u8Type then {
        return "u8".string
    } case u16Type then {
        return "u16".string
    } case u32Type then {
        return "u32".string
    } case u64Type then {
        return "u64".string
    } case u128Type then {
        return "u128".string
    } case c8Type then {
        return "c8".string
    } case c32Type then {
        return "c32".string
    } case f16Type then {
        return "f16".string
    } case f32Type then {
        return "f32".string
    } case f64Type then {
        return "f64".string
    } case f128Type then {
        return "f128".string
    }
}


# --- value-type carriers ---

# vid -- a symbol-table variable id (locals emit as z_v{vid}); 0 is "no
# variable". Same-space equality; sentinels read isZero.
vid: record { val: u64.typedef } as {
    # identity by id. Two vids name the same variable when their numbers match
    ==: function {this: this.view rhs: vid} out bool is {
        return this.u64 == rhs.u64
    }
    # the sentinel: 0 is no variable, never the first one
    isZero: function {this: this.view} out bool is {
        return this.u64 == 0
    }
}

# tid -- a type-registry id: an index into ZTypeRegistry.typeById. 0 is
# `notype`, the no-type / unresolved sentinel every consumer tests, so a
# zero tid never addresses a real type even though row 0 is registered.
# Same-space equality; sentinels read isZero. `next` exists because the
# INHERITED arithmetic on a typedef yields the base -- `t + 1` is a u64 --
# so walking the id space needs a method to stay in the space.
tid: record { val: u64.typedef } as {
    # identity by id, which IS type equality here -- two types are the same type
    # exactly when their tids match
    ==: function {this: this.view rhs: tid} out bool is {
        return this.u64 == rhs.u64
    }
    # the sentinel: 0 is no type, never the first one
    isZero: function {this: this.view} out bool is {
        return this.u64 == 0
    }
    # the next id in sequence, which is how a caller mints without keeping a
    # counter of its own
    next: function {this: this.view} out tid is {
        n: this.u64 + 1
        return (tid from: n)
    }
}

# declid -- a Decl-tree row id (minted dense 1..N by declNew); 0 is "no
# decl". A typedef so a decl id cannot cross with the other numeric id
# spaces; equality is same-space only, sentinels read .u64.
declid: record { val: u64.typedef } as {
    # identity by id. Two declids name the same declaration when their numbers
    # match
    ==: function {this: this.view rhs: declid} out bool is {
        return this.u64 == rhs.u64
    }
    # the sentinel: 0 is no declaration, never the first one
    isZero: function {this: this.view} out bool is {
        return this.u64 == 0
    }
}

# Source position triple (file, line, column) for take-location
# tracking on a scope entry.
zsrcpos: record {
    # the file
    fsno: zvfs.fsno
    # the line
    lineno: u32
    # the column. The triple is a position with no width, for the places that
    # record WHERE something happened rather than what to underline
    colno: u32
}

# Tagged identifier for a lock holder. `id` maps into a different
# id-space per `kind` (variable id or call nodeid; the forKind arm is
# declared for the loop-holder shape but nothing constructs one today).
zlockholder: record {
    # what is holding the lock
    kind: zlockholderkind
    # which one: a variable id, a call id or a loop id, read according to `kind`
    id: u64
}

# Suffix-detection result: the kind named by an inline suffix (if any)
# and the suffix's byte length.
suffixinfo: record {
    # whether a suffix was present at all
    has: bool
    # which numeric type it named
    kind: numkind
    # how many bytes it occupied, so the mantissa can be re-read without it
    len: u64
}

# Result of parse_literal_value: the unbounded value (range errors are
# the coercion boundary's concern, not this function's). `ok` is false
# only for an unparseable lexeme.
parsedval: record {
    # whether the text parsed at all
    ok: bool
    # which of the two value slots below is meaningful
    isFloat: bool
    # the integer magnitude, accumulated in u64 so the range check can be made
    # once at the end
    ival: u64
    # the float value
    fval: f64
}

# Integer/float lower bound for a numeric type. `has` is false for the
# kinds that are not range-checked (128-bit and float).
NumRange: class {
    # whether a range is known; a type with no bound leaves this false
    has: bool
    # the low bound as TEXT, because the most negative i64's magnitude is one
    # past what i64 can hold
    loText: String
    # the high bound, which fits u64 for every type that has one
    hi: u64
}

# --- reference-type carriers ---
# Cross-type references are stored as type ids, resolved through the
# registry.

# A compile-time constant value, as the evaluator passes it around.
#
# A VALTYPE, deliberately: it copies out of a stamp table instead of handing
# back a borrow, so a memoised evaluator can read one entry of a table it is
# about to write. A class here would make every read hold a lock on the map.
#
# The string payload is an index into ZTyping.constStrings (0 = none: the
# sentinel row holds the empty text)
# because a valtype owns no heap. An arm is identified by its OWNING type plus
# its name-pool id, not by an ordinal: the emitter's one arm-to-tag helper
# takes a name, and an ordinal would rot the first time an arm was inserted.
cval: record {
    # which of the payloads below is meaningful. Read it first; the rest are
    # zero unless it names them
    kind: zconstkind
    # the integer value
    ival: i64
    # the float value
    fval: f64
    # the string, as a 1-based index into the constant pool so 0 means none
    strId: u32
    # the arm's OWNING type, half of an arm's identity
    armTid: tid
    # the arm's name-pool id, the other half. Not an ordinal: an ordinal would
    # rot the first time an arm was inserted
    armName: zast.nameid
}

# how a runtime variable came to be: a parameter, a local binding, or one the
# checker synthesised -- a hoisted temp, an alias -- which is neither of those.
zvarorigin: variant {
    # the checker made it -- a hoisted temp, an alias -- and no source line
    # declares it
    synth: null
    # a binding written in a body
    local: null
    # a function parameter
    param: null
} as { tag: u8.tag }

# ZVariable -- one runtime variable: the row variableById holds for its vid.
# The C identifier is the emitter's business -- a variable is known here by
# its id alone.
ZVariable: class {
    # the variable's type
    ztypeId: tid
    # whether it owns its value or borrows one
    ownership: zownership
    # whether it may reach private members, which a `this` receiver may and an
    # outside binding may not
    isPrivateAccess: bool
    # the root of the path a borrowed variable borrows from (0 when none)
    borrowOrigin: zast.nameid
    # what the checker synthesised it FOR, when it synthesised it; none for a
    # written binding
    synthOrigin: (Option String)
    # how it came to be: a parameter, a local, or synthesised
    origin: zvarorigin
}

# Result of parseNumber: the resolved kind, the value (ival for
# integers, fval for floats), and an error message ("" when none).
# Integer magnitudes accumulate in u64; a literal above u64 is out of
# range.
ParsedNumber: class {
    # the numeric type resolved for the literal
    kind: numkind
    # which value slot below is meaningful
    isFloat: bool
    # the integer magnitude in u64; a literal above u64 is out of range and says
    # so in `err`
    ival: u64
    # the float value
    fval: f64
    # why the parse failed, empty when it did not
    err: String
}

# A protocol/facet conformance: an impl type satisfying a spec type
# under a label. Helper C names are pre-composed here.
ZConformance: class {
    # the type that conforms
    implTypeId: u64
    # the protocol or facet it conforms to
    specTypeId: u64
    # the conformance's written label
    label: String
    # the pool id of `label`, so a reader that only needs to know WHICH
    # member the marker names compares an id instead of the spelling. 0
    # when the row was built from a literal with no pool behind it.
    labelNameId: u64
    # whether the spec is a facet rather than a protocol, which decides how the
    # value carries its vtable
    isFacet: bool
    # this conformance's own id
    conformanceId: u64
}

# The type descriptor. A function's parameters, a record's or class's
# fields and methods, are the type's declaration children (the Decl tree);
# per-member metadata lives on the member's own Decl.
ZType: class {
    # the type's own id, which is its index in typeById
    typeId: tid
    # its written name, for diagnostics and for the emitted C
    name: String
    # which family it belongs to
    typetype: ztypetype
    # a function type's return; none for every other family
    returnTypeId: (optionval tid)
    # a method's receiver name, interned
    thisParamNameId: zast.nameid
    # whether this is a template rather than an instance
    isgeneric: bool
    # whether it passes by value. An optionval because it is not known until the
    # type resolves
    isValtype: (optionval bool)
    # the template this was instantiated from; none when it is not an instance
    genericOriginId: (optionval tid)
    # whether it is the origin of a tag generic, which the emitter treats apart
    isTagGenericOrigin: bool
    # id-keyed specialization tree: one level per generic parameter in
    # definition order -- argument type-id (or numeric value at a numeric
    # parameter level) -> the child specialization's type-id. Specs record
    # their ordered argument ids in genericArgs for backward substitution.
    # An IdMap rather than a pair of parallel lists: the key IS an id, an edge
    # is only ever added, and an empty one allocates nothing.
    genericChildren: (IdMapV u64 v: tid)
    # the type arguments this instance was minted with, in order
    genericArgs: (ListVal u64)
    # parallel to genericArgs: true when the ordinal is a numeric VALUE
    # (a sized record's `to:`), false when it is a type id
    genericArgIsValue: (ListVal bool)
    # whether a value of this type must be destroyed, which decides whether a
    # scope exit emits anything
    needsDestructor: bool
    # whether its storage is on the heap rather than in the binding
    isHeapAllocated: bool
    # whether it is a box: a valtype wrapped so a reftype slot can hold it
    isBox: bool
    # whether the runtime owns the layout, so no struct is emitted for it
    isNative: bool
    # whether the runtime addresses it by index rather than by name
    runtimeIndexed: bool
    # a data block's single element type. The checker settles it from `out T`
    # or the elements' own tags; the emitter reads it for the static array's C
    # element type rather than re-deriving one from a name. 0 for every other
    # kind of type.
    dataElemTypeId: (optionval tid)
    # the declaration (ztyping DeclId) that minted this type; 0 until the
    # declaration layer links it
    def: declid
    # the type that owns this one (a method's receiver); 0 when the type
    # stands free. The emitter composes C names from it.
    ownerTid: tid
}

# One overlay row of the body walk: a take, a narrowing, or a lock laid over
# a local (`declId`, its declaration in the environment) while `frame` is
# open; the row dies when the frame closes. Overlay state is held in flat,
# borrow-readable columns rather than nested reftype options: a walk reads a
# row through a borrowed list view, and a borrowed `(Option reftype)` field's
# payload cannot be reached without moving it out. The lock columns are live
# only when `hasLock`; `narrowedSubtype` is 0 when not narrowed. `defSeq` is
# how many locals the frame had defined when the row was laid, which is where
# the row sits among them in the dump.
# ZEntry -- one overlay row the body walk lays over a local (its declId): a
# take, a narrowing / exclusion, or a lock. ztypeId is the type the row
# presents (a narrowing changes it; originalZtypeId keeps the declared one);
# defSeq orders the row among the frame's locals for the dump.
ZEntry: class {
    # the entry's own id
    entryId: u64
    # the declaration this entry is for
    declId: declid
    # where it fell in declaration order, which shadowing resolves by
    defSeq: u64
    # the entry's current type, which narrowing may have changed
    ztypeId: tid
    # whether a lock is outstanding on it
    hasLock: bool
    # exclusive or shared
    lockType: zlockstate
    # whether the lock is on the path named or on a prefix of it
    lockScope: zlockscope
    # what took it, so the diagnostic can name the holder rather than just the
    # conflict
    lockHolder: zlockholder
    # the path locked, as interned segments
    lockPath: (ListVal zast.nameid)
    # the arm a match narrowed the entry to, 0 when it is not narrowed
    narrowedSubtype: zast.nameid
    # the arms ruled OUT by diverging guards, which is what lets a later match
    # need fewer arms
    excludedSubtypes: (IdSet zast.nameid)
    # the type before narrowing, so it can be restored when the narrowing ends
    originalZtypeId: (optionval tid)
    # whether ownership has moved out, which makes any later use an error
    isTaken: bool
    # where it was taken, so the error can point at the transfer and not just
    # the use
    takenAt: (optionval zsrcpos)
}

# --- registry: the home for the monotonic id counters shared across all
# type-model entities, plus the by-id type table (typeById): every type id
# resolves to its ZType here. newType files each type and returns its id;
# the type checker and the emitter read type metadata by id. ---

# A generic parameter's declared constraint, classified once at registration
# so the checks compare a tag rather than the text. numericMax carries the
# integer bound for NUMERIC; it is none for every other kind.
constraintkind: variant {
    # no bound at all
    none: null
    # any type, value or reference
    any: null
    # a valtype only: a record, a variant or a facet
    valType: null
    # a reftype only: a class, a union or a protocol
    refType: null
    # anything that presents bytes as a string
    stringLike: null
    # a numeric type, with numericMax bounding it
    numeric: null
    # a named bound the kinds above do not classify
    other: null
    # a valtype that can key a Map or Set, its hash synthesised from its bytes
    valHashable: null
    # a reftype that can key a Map or Set, which must define hash and == itself
    refHashable: null
    # an unsigned scalar usable as a dense index, which is what an IdMap key
    # must be
    idKey: null
} as { tag: u8.tag }

# a generic parameter's constraint: its kind plus, for a numeric-bound
# parameter, the maximum value it admits.
constraintdesc: record {
    # which family the bound admits
    kind: constraintkind
    # the integer bound for a NUMERIC constraint; none for every other kind
    numericMax: (optionval u64)
}

# ParamDesc / ParamList -- a template's generic parameters in declaration
# order, each with the constraint classified at registration and the canonical
# GENERIC_PARAM type id minted for it during resolution (0 until then).
# ParamDesc is a class because it holds a String.
ParamDesc: class {
    # the parameter's name, interned
    name: zast.nameid
    # the bound, classified once at registration
    constraint: constraintdesc
    # the canonical GENERIC_PARAM type minted for it during resolution; 0 until
    # then
    paramTid: tid
}

# a template's generic parameters in declaration order.
ParamList: class {
    # the parameters in DECLARATION order, which is the order type arguments
    # bind in
    params: (List ParamDesc)
}

# the registry of every type: each ZType keyed by id, plus the name and
# child indexes the resolver and emitter query.
# optStringCopy -- an owned copy of an optional string.
optStringCopy: function {o: (Option String).view} out Option String is {
    match (
        o
    ) case some then {
        return (Option.some o.copy)
    } case none then {
        return (Option.none String)
    }
}

# holeType -- the row standing in for an id minted by allocType, which names an
# expression with no type. typeId 0 marks it: a real row carries its own index,
# and index 0 is `notype`, which is always registered.
holeType: function {} out ZType is {
    return (ZType
    typeId: tid
    name: "".string
    typetype: ztypetype.nullType
    returnTypeId: (optionval.none tid)
    thisParamNameId: zast.nameid
    isgeneric: false
    isValtype: (optionval.none bool)
    genericOriginId: (optionval.none tid)
    isTagGenericOrigin: false
    genericChildren: (IdMapV u64 v: tid)
    genericArgs: (ListVal u64)
    genericArgIsValue: (ListVal bool)
    needsDestructor: false
    isHeapAllocated: false
    isBox: false
    isNative: false
    runtimeIndexed: false
    dataElemTypeId: (optionval.none tid)
    def: declid
    ownerTid: tid)
}

# the type model: every ZType by tid, every ZVariable by vid, and each
# template's generic parameters. Ids are dense and never reused, so an id IS
# an index and every lookup here is one
ZTypeRegistry: class {
    # the next type id to mint; ids are dense and never reused
    nextTypeId: u64
    # the next entry id to mint
    nextEntryId: u64
    # the next conformance id to mint
    nextConformanceId: u64
    # the shared unregistered id worn by every `break` / `continue` entry
    # (see ctlPlaceholder); 0 until first use
    ctlPlaceholderTid: u64
    # The two literal pseudo-types, reserved by newRegistry so a literal
    # stamp is an ordinary registered id rather than a magic constant.
    # A bare numeric literal wears one of these until a coercion boundary
    # pins a concrete type; foldLiteralStamps rewrites the survivors to
    # i64 / f64. Data-block elements wear literalIntTid too.
    literalIntTid: tid
    # the type an unsuffixed float literal starts as
    literalFloatTid: tid
    # every type, indexed by tid. A tid IS the index
    typeById: (List ZType)
    # every runtime variable, by vid (row 0 is the sentinel)
    variableById: (List ZVariable)
    # the main unit's name
    regMainUnit: String
    # its id, so the hot checks compare integers
    regMainUnitId: u64
    # generic-template metadata, keyed by the TEMPLATE's DeclId
    genericParams: (IdMapR declid V: ParamList)
    # true when the last getOrMintSpec minted a fresh instance (checkGenericCall's wasNew)
    specWasFresh: bool
} as {
    # allocType -- an id with no ZType behind it, for an expression that has
    # no type: the result of auto-calling a method declared without `out`.
    # Staying unregistered is what keeps the stamp out of the dump's type join.
    allocType: function {:this} out u64 is {
        r: this.nextTypeId
        this.nextTypeId = this.nextTypeId + 1
        this.typeById.append (holeType)
        return r
    }

    # ctlPlaceholder -- the one unregistered id every `break` / `continue`
    # entry wears. Those names carry no type; the id exists only so the entry
    # has a slot, and every reader dispatches on the name instead. One id
    # rather than one per loop keeps the id space dense. Minted on first use;
    # 0 is the notype sentinel, so it doubles as "not minted yet".
    ctlPlaceholder: function {:this} out u64 is {
        if this.ctlPlaceholderTid > 0 then return this.ctlPlaceholderTid
        t: this.allocType
        this.ctlPlaceholderTid = t
        return t
    }
    # --- carrier factories: the single construction site for each
    # carrier, filling sensible field defaults. Callers mutate specific
    # fields afterward. They are registry methods (not free functions)
    # so the id-counter bump persists through the `:this` receiver -- a
    # bump through a plain borrowed param does not propagate back.
    # ownerTid stays a bare u64 here: a parameter DEFAULT cannot be a typedef
    # value -- `(tid from: 0)` in that position reads as a generic instantiation
    # (tid_0), not a zero -- and 41 callers rely on the default. It converts on
    # the way into the field.
    newType: function {:this name: StringView typetype: ztypetype ownerTid: 0.u64} out tid is {
        id: (tid from: this.nextTypeId)
        this.nextTypeId = this.nextTypeId + 1
        ow: (tid from: ownerTid)
        t: (ZType
        typeId: id
        name: name.string
        :typetype
        returnTypeId: (optionval.none tid)
        thisParamNameId: zast.nameid
        isgeneric: false
        isValtype: (optionval.none bool)
        genericOriginId: (optionval.none tid)
        isTagGenericOrigin: false
        genericChildren: (IdMapV u64 v: tid)
        genericArgs: (ListVal u64)
        genericArgIsValue: (ListVal bool)
        needsDestructor: false
        isHeapAllocated: false
        isBox: false
        isNative: false
        runtimeIndexed: false
        dataElemTypeId: (optionval.none tid)
        def: declid
        ownerTid: ow)
        this.typeById.append t
        return id
    }

    # variableCount -- how many variables have been minted: the id the next
    # one will take, which a frame records at open so a variable's age tells
    # whether it was bound while the frame was open.
    variableCount: function {this: this.view} out u64 is {
        return this.variableById.length
    }

    # newVariable -- mint a runtime variable: its row is appended to
    # variableById and its id returned.
    newVariable: function {:this ztypeId: tid ownership: zownership} out vid is {
        id: vid.create from: this.variableById.length
        this.variableById.append (ZVariable
            :ztypeId
            :ownership
            isPrivateAccess: false
            borrowOrigin: zast.nameid
            synthOrigin: (Option.none String)
            origin: zvarorigin.synth)
        return id
    }

    # whether `id` names a variable at all, which the accessors below assume
    hasVariable: function {t: this.view id: vid} out bool is {
        if id.isZero then return false
        return id < t.variableById.length
    }

    # the variable's type
    variableTypeOf: function {t: this.view id: vid} out tid is {
        got: t.variableById.get i: id
        return got.ztypeId
    }

    # whether it owns its value or borrows one
    variableOwnershipOf: function {t: this.view id: vid} out zownership is {
        got: t.variableById.get i: id
        return got.ownership
    }

    # whether it may reach private members
    variableIsPrivate: function {t: this.view id: vid} out bool is {
        got: t.variableById.get i: id
        return got.isPrivateAccess
    }

    # the root of the path it borrows from, 0 when it borrows nothing
    variableBorrowOriginOf: function {t: this.view id: vid} out zast.nameid is {
        got: t.variableById.get i: id
        return got.borrowOrigin
    }

    # what the checker synthesised it for; none for a written binding
    variableSynthOriginOf: function {t: this.view id: vid} out Option String is {
        got: t.variableById.get i: id
        return (optStringCopy o: got.synthOrigin)
    }

    # how it came to be: a parameter, a local, or synthesised
    variableOriginOf: function {t: this.view id: vid} out zvarorigin is {
        got: t.variableById.get i: id
        return got.origin
    }

    # record the root a borrow came from, so a conflict can name the source and
    # not just the borrow
    setVariableBorrowOrigin: function {:this id: vid origin: zast.nameid} is {
        got: this.variableById.getMut i: id
        got.borrowOrigin = origin
    }

    # record what the variable was synthesised for, which is all a diagnostic
    # can say about a name no one wrote
    setVariableSynthOrigin: function {:this id: vid origin: String.take} is {
        got: this.variableById.getMut i: id
        got.synthOrigin = (Option.some origin)
    }

    # mark it able to reach private members, which a `this` receiver is and an
    # outside binding is not
    setVariablePrivate: function {:this id: vid} is {
        got: this.variableById.getMut i: id
        got.isPrivateAccess = true
    }

    # record how the variable came to be
    setVariableOrigin: function {:this id: vid origin: zvarorigin} is {
        got: this.variableById.getMut i: id
        got.origin = origin
    }

    # mint a scope entry for `ztypeId` and answer it. An entry is where
    # narrowing, locks and ownership are tracked -- the type alone is not enough
    newEntry: function {:this ztypeId: tid} out ZEntry is {
        id: this.nextEntryId
        this.nextEntryId = this.nextEntryId + 1
        return (ZEntry
            entryId: id
            declId: declid
            defSeq: 0
            :ztypeId
            hasLock: false
            lockType: zlockstate.shared
            lockScope: zlockscope.target
            lockHolder: (zlockholder kind: zlockholderkind.varKind id: 0)
            lockPath: (ListVal zast.nameid)
            narrowedSubtype: zast.nameid
            excludedSubtypes: (IdSet zast.nameid)
            originalZtypeId: (optionval.none tid)
            isTaken: false
            takenAt: (optionval.none zsrcpos))
    }

    # record that one type satisfies a protocol or facet, and answer the
    # conformance
    newConformance: function {
        this: this
        # the type that conforms
        implTypeId: u64
        # the protocol or facet it conforms to
        specTypeId: u64
        # the conformance's written label
        label: StringView
        # that label interned, which is what the comparisons use
        labelNameId: u64
        # whether the spec is a facet rather than a protocol, which decides how the
        # value carries its vtable
        isFacet: bool
    } out ZConformance is {
        id: this.nextConformanceId
        this.nextConformanceId = this.nextConformanceId + 1
        return (ZConformance
            :implTypeId
            :specTypeId
            label: label.string
            :labelNameId
            :isFacet
            conformanceId: id)
    }

    # --- by-id type metadata: resolve a type id to the stored ZType's
    # scalar facts. The symbol table reads these for narrowing,
    # exclusion, and live-owned-var detection. ---
    hasType: function {this: this.view typeId: tid} out bool is {
        return (this.typeValid tid: typeId)
    }

    # the family `typeId` belongs to
    typetypeOf: function {t: this.view typeId: tid} out ztypetype is {
        if typeId >= t.typeById.length then return ztypetype.nullType
        got: t.typeById.get i: typeId
        return got.typetype
    }

    # whether the type is the origin of a tag generic, which the emitter lays
    # out apart
    isTagGenericOriginOf: function {this: this.view typeId: tid} out bool is {
        if typeId >= this.typeById.length then return false
        got: this.typeById.get i: typeId
        return got.isTagGenericOrigin
    }

    # needsDestructor -- the type owns resources its destructor releases; the
    # emitter names and emits that destructor.
    needsDestructor: function {t: this.view typeId: tid} out bool is {
        if typeId >= t.typeById.length then return false
        got: t.typeById.get i: typeId
        return got.needsDestructor
    }

    # --- post-construction metadata stamps: mutate the stored ZType in
    # place through the by-id table. ---
    setNeedsDestructor: function {:this typeId: tid} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        got.needsDestructor = true
    }

    # mark it a box: a valtype wrapped so a reftype slot can hold it
    setIsBox: function {:this typeId: tid} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        got.isBox = true
    }

    # mark its storage as living on the heap rather than in the binding
    setIsHeapAllocated: function {:this typeId: tid} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        got.isHeapAllocated = true
    }

    # mark it the origin of a tag generic
    setTagGenericOrigin: function {:this typeId: tid} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        got.isTagGenericOrigin = true
    }

    # ownerTidOf -- the type owning `tid` as a member, or 0.
    ownerTidOf: function {this: this.view tid: tid} out tid is {
        if tid >= this.typeById.length then return (tid from: 0)
        got: this.typeById.get i: tid
        return got.ownerTid
    }

    # record whether it passes by value, which also decides whether it may hold
    # a reftype at all
    setValtype: function {:this typeId: tid value: bool} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        got.isValtype = (optionval.some value)
    }

    # record whether it is a template rather than an instance
    setGeneric: function {:this typeId: tid value: bool} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        got.isgeneric = value
    }

    # record that the runtime owns its layout, so no struct is emitted for it
    setNative: function {:this typeId: tid value: bool} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        got.isNative = value
    }


    # file an instantiation under its template, keyed by its argument trie --
    # which is what makes the same arguments find the same mono instead of
    # minting a twin
    setGenericChild: function {:this parentId: u64 key: u64 child: u64} is {
        if parentId >= this.typeById.length then return
        got: this.typeById.getMut i: parentId
        got.genericChildren.set :key value: (tid from: child)
    }

    # the instantiation already minted for these arguments, if there is one
    getGenericChild: function {this: this.view parentId: u64 key: u64} out optionval tid is {
        if parentId >= this.typeById.length then return (optionval.none tid)
        got: this.typeById.get i: parentId
        return (got.genericChildren.get :key)
    }

    # append one type argument to an instance, in declaration order
    appendGenericArg: function {:this specId: tid arg: u64} is {
        if specId >= this.typeById.length then return
        got: this.typeById.getMut i: specId
        got.genericArgs.append arg
        got.genericArgIsValue.append false
    }

    # appendGenericArgValue -- record a numeric VALUE ordinal (the literal,
    # not a type id) for a sized specialization.
    appendGenericArgValue: function {:this specId: tid value: u64} is {
        if specId >= this.typeById.length then return
        got: this.typeById.getMut i: specId
        got.genericArgs.append value
        got.genericArgIsValue.append true
    }

    # how many type arguments the instance was minted with
    genericArgCount: function {this: this.view specId: tid} out u64 is {
        if specId >= this.typeById.length then return 0
        got: this.typeById.get i: specId
        return got.genericArgs.length
    }

    # the argument at `ordinal`, counting from 0
    genericArgAt: function {this: this.view specId: tid ordinal: u64} out u64 is {
        if specId >= this.typeById.length then return 0
        got: this.typeById.get i: specId
        if ordinal < got.genericArgs.length then return (got.genericArgs.get i: ordinal)
        return 0
    }

    # whether that argument was a value type, which decides whether the instance
    # copies or moves it
    genericArgIsValueAt: function {this: this.view specId: tid ordinal: u64} out bool is {
        if specId >= this.typeById.length then return false
        got: this.typeById.get i: specId
        if ordinal < got.genericArgIsValue.length then return (got.genericArgIsValue.get i: ordinal)
        return false
    }

    # typeValid -- `tid` addresses a registered row rather than a hole. A hole
    # (an id minted by allocType) carries typeId 0; a real row carries its own
    # index, and index 0 is `notype`, which is always registered.
    typeValid: function {this: this.view tid: tid} out bool is {
        if tid >= this.typeById.length then return false
        if tid.isZero then return true
        got: this.typeById.get i: tid
        return (got.typeId.u64 == tid)
    }

    # nameOf -- a type's registered name, or "" when the id has none.
    nameOf: function {t: this.view tid: tid} out String is {
        if tid >= t.typeById.length then return "".string
        got: t.typeById.get i: tid
        return got.name.copy
    }

    # defOf -- the declaration that minted this type, or 0.
    defOf: function {this: this.view tid: tid} out declid is {
        if tid >= this.typeById.length then return (declid.create from: 0)
        got: this.typeById.get i: tid
        return got.def
    }

    # returnTypeOf -- a function type's return type id, or 0 when it has none.
    returnTypeOf: function {this: this.view tid: tid} out tid is {
        if tid >= this.typeById.length then return (tid from: 0)
        got: this.typeById.get i: tid
        r: got.returnTypeId
        match (
            r
        ) case some then {
            return r
        } case none then null
        return (tid from: 0)
    }

    # thisParamNameIdOf -- the pool id of a method's receiver-parameter name,
    # or 0 when it declares none.
    thisParamNameIdOf: function {this: this.view tid: tid} out zast.nameid is {
        if tid >= this.typeById.length then return (zast.nameid.create from: 0)
        got: this.typeById.get i: tid
        return got.thisParamNameId
    }

    # hasThisParamName -- the type declares a receiver parameter.
    hasThisParamName: function {this: this.view tid: tid} out bool is {
        tp: this.thisParamNameIdOf :tid
        return (tp.isZero) == false
    }

    # thisParamNameIs -- the receiver parameter is named `name`; false when the
    # type declares none, so an undeclared receiver never matches.
    thisParamNameIs: function {this: this.view tid: tid nameId: zast.nameid} out bool is {
        if nameId.isZero then return false
        tp8: this.thisParamNameIdOf :tid
        return tp8 == nameId
    }

    # isGenericOf -- the type is a generic template.
    isGenericOf: function {this: this.view tid: tid} out bool is {
        if tid >= this.typeById.length then return false
        got: this.typeById.get i: tid
        return got.isgeneric
    }

    # isNativeOf -- the type is compiler-provided. A pure read, so it takes the
    # receiver by view: a caller holding the registry readonly can still ask.
    isNativeOf: function {t: this.view tid: tid} out bool is {
        if tid >= t.typeById.length then return false
        got: t.typeById.get i: tid
        return got.isNative
    }

    # isValtypeOf -- the type is known to be a valtype. An unset or
    # unregistered id is neither a valtype nor a reftype.
    isValtypeOf: function {this: this.view tid: tid} out bool is {
        if tid >= this.typeById.length then return false
        got: this.typeById.get i: tid
        v: got.isValtype
        match (
            v
        ) case some then {
            return v
        } case none then null
        return false
    }

    # isReftypeOf -- the type is known to be a reftype.
    isReftypeOf: function {this: this.view tid: tid} out bool is {
        if tid >= this.typeById.length then return false
        got: this.typeById.get i: tid
        v: got.isValtype
        match (
            v
        ) case some then {
            return (v) == false
        } case none then null
        return false
    }

    # isBoxOf -- the type is the builtin Box (a heap pointer), not a user
    # class that happens to be named Box.
    isBoxOf: function {this: this.view tid: tid} out bool is {
        if tid >= this.typeById.length then return false
        got: this.typeById.get i: tid
        return got.isBox
    }

    # nameIs -- the registered name equals `name`, compared through a borrowed
    # view so no String is materialized. An unregistered id has no name, which
    # matches only the empty string.
    nameIs: function {this: this.view tid: tid name: StringView} out bool is {
        if tid >= this.typeById.length then return (name.length == 0)
        got: this.typeById.get i: tid
        return (got.name.stringView == name)
    }

    # isRuntimeIndexedOf -- a data block reached by `.index` / `.array`, so its
    # static array must be emitted.
    isRuntimeIndexedOf: function {this: this.view tid: tid} out bool is {
        if tid >= this.typeById.length then return false
        got: this.typeById.get i: tid
        return got.runtimeIndexed
    }

    # dataElemTypeOf -- the element type the checker settled on for a data
    # block, or 0 when the type is not a data block. The emitter asks this
    # rather than reading the `out T` name, so a block typed by its elements'
    # own tags emits the same C array as one typed by the clause.
    dataElemTypeOf: function {t: this.view tid: tid} out tid is {
        if tid >= t.typeById.length then return (tid from: 0)
        got: t.typeById.get i: tid
        de: got.dataElemTypeId
        match (
            de
        ) case some then {
            return de
        } case none then null
        return (tid from: 0)
    }

    # record a data block's element type
    setDataElemType: function {:this typeId: tid value: u64} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        vc: (tid from: value)
        got.dataElemTypeId = (optionval.some vc)
    }

    # genericOriginOf -- the template a mono was instantiated from, or 0 when
    # the type has no origin (0 is `notype`, never a real origin).
    genericOriginOf: function {t: this.view tid: tid} out tid is {
        if tid >= t.typeById.length then return (tid from: 0)
        got: t.typeById.get i: tid
        go: got.genericOriginId
        match (
            go
        ) case some then {
            return go
        } case none then null
        return (tid from: 0)
    }

    # record the template an instance came from
    setGenericOrigin: function {:this typeId: tid value: u64} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        vc: (tid from: value)
        got.genericOriginId = (optionval.some vc)
    }

    # record a function type's return
    setReturnType: function {:this typeId: tid value: u64} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        vc: (tid from: value)
        got.returnTypeId = (optionval.some vc)
    }

    # setDef -- link a minted type to the declaration that minted it.
    setDef: function {:this typeId: tid declId: declid} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        got.def = declId
    }

    # record a method's receiver name
    setThisParamName: function {:this typeId: tid nameId: zast.nameid} is {
        if typeId >= this.typeById.length then return
        got: this.typeById.getMut i: typeId
        got.thisParamNameId = nameId
    }

    # setMainUnit -- the program's main unit, by name and interned name id.
    setMainUnit: function {:this name: StringView nameId: zast.nameid} is {
        mn: name.string
        this.regMainUnit = mn
        this.regMainUnitId = nameId.u64
    }

    # addGenericParam / isGenericParamOf -- a template's generic-param
    # names and constraints, keyed by the template's DeclId (tdecl). A
    # method param typed by its enclosing type's generic param is NOT a
    # child (a generic type's methods resolve without the type's generic
    # context, so the param type is unresolvable there).
    # paramOrdinalOf -- a parameter's declaration ordinal, or none.
    paramOrdinalOf: function {
        this: this.view
        # the template the parameter belongs to
        tdecl: declid
        # the parameter's name, interned
        paramName: zast.nameid
    } out optionval u64 is {
        plo: this.genericParams.get key: tdecl
        match (
            plo
        ) case some then {
            i: u64
            n: plo.params.length
            for i < n loop {
                pdx: plo.params.get :i
                if pdx.name == paramName then return (optionval.some i)
                i = i + 1
            }
        } case none then null
        return (optionval.none u64)
    }

    # one canonical GENERIC_PARAM type per (template, parameter): references
    # inside the template's members resolve the parameter name to this id. It
    # lives on the parameter's own row; 0 means not yet minted.
    genericParamTidOf: function {
        this: this.view
        # the template asked about
        tdecl: declid
        # the parameter name asked about
        paramName: zast.nameid
    } out optionval u64 is {
        po: this.paramOrdinalOf :tdecl :paramName
        match (
            po
        ) case some then {
            plo: this.genericParams.get key: tdecl
            match (
                plo
            ) case some then {
                pt: (plo.params.get i: po).paramTid
                if pt > 0 then return (optionval.some pt.u64)
            } case none then null
        } case none then null
        return (optionval.none u64)
    }

    # record the canonical GENERIC_PARAM type minted for a parameter, which
    # stays 0 until resolution reaches it
    setGenericParamTid: function {
        this: this.view
        # the template the parameter belongs to
        tdecl: declid
        # the parameter whose type is being recorded
        paramName: zast.nameid
        # the canonical GENERIC_PARAM type minted for it
        tid: tid
    } is {
        po: this.paramOrdinalOf :tdecl :paramName
        match (
            po
        ) case some then {
            plo: this.genericParams.get key: tdecl
            match (
                plo
            ) case some then {
                v: tid
                pdx: plo.params.getMut i: po
                pdx.paramTid = v
            } case none then null
        } case none then null
    }

    # declare one generic parameter on a template, with its constraint
    # classified now so later checks compare an arm
    addGenericParam: function {:this tdecl: declid paramName: zast.nameid kind: constraintkind numericMax: (optionval u64)} is {
        found: false
        {
            plo: this.genericParams.get key: tdecl
            match (
                plo
            ) case some then {
                found = true
                has: false
                i: u64
                n: plo.params.length
                for i < n loop {
                    pdx: plo.params.get :i
                    if pdx.name == paramName then has = true
                    i = i + 1
                }
                if (has) == false then {
                    plo.params.append (ParamDesc
                        name: paramName
                        constraint: (constraintdesc :kind :numericMax)
                        paramTid: tid
                    )
                }
            } case none then null
        }
        if (found) == false then {
            np: (ParamList params: (List ParamDesc))
            np.params.append (ParamDesc
                name: paramName
                constraint: (constraintdesc :kind :numericMax)
                paramTid: tid
            )
            this.genericParams.set key: tdecl value: np
        }
    }

    # whether `name` is one of `tdecl`'s generic parameters
    isGenericParamOf: function {this: this.view tdecl: declid name: zast.nameid} out bool is {
        plo: this.genericParams.get key: tdecl
        match (
            plo
        ) case some then {
            i: u64
            n: plo.params.length
            for i < n loop {
                pdx: plo.params.get :i
                if pdx.name == name then return true
                i = i + 1
            }
        } case none then null
        return false
    }

    # genericParamConstraintOf -- the classified constraint for a template
    # parameter, or a NONE-kind descriptor when the parameter is unknown.
    genericParamConstraintOf: function {
        this: this.view
        # the template asked about
        tdecl: declid
        # the parameter name asked about
        paramName: zast.nameid
    } out constraintdesc is {
        plo: this.genericParams.get key: tdecl
        match (
            plo
        ) case some then {
            i: u64
            n: plo.params.length
            for i < n loop {
                pdx: plo.params.get :i
                if pdx.name == paramName then {
                    return (constraintdesc
                        kind: pdx.constraint.kind
                        numericMax: pdx.constraint.numericMax
                    )
                }
                i = i + 1
            }
        } case none then null
        return (constraintdesc kind: constraintkind.none numericMax: (optionval.none u64))
    }

    # genericParamNamesOf -- a template's parameter names, in declaration order.
    genericParamNamesOf: function {this: this.view tdecl: declid} out ListVal zast.nameid is {
        names: (ListVal zast.nameid)
        plo: this.genericParams.get key: tdecl
        match (
            plo
        ) case some then {
            i: u64
            n: plo.params.length
            for i < n loop {
                pdx: plo.params.get :i
                names.append pdx.name
                i = i + 1
            }
        } case none then null
        return names
    }

}

# construct an empty type registry seeded with the builtin/native types.
newRegistry: function {} out ZTypeRegistry is {
    r: (ZTypeRegistry
        nextTypeId: 0
        nextEntryId: 0
        nextConformanceId: 0
        ctlPlaceholderTid: 0
        literalIntTid: tid
        literalFloatTid: tid
        typeById: (List ZType capacity: 512)
        variableById: (List ZVariable)
        regMainUnit: "".string
        regMainUnitId: 0
        genericParams: (IdMapR declid V: ParamList)
        specWasFresh: false
    )
    # The reserved rows, minted here in a fixed order so every caller agrees
    # on their ids: 0 = notype (the no-type / unresolved sentinel every
    # `tid == 0` test reads), then the two literal types. Seeding them at
    # construction is what lets a literal stamp be compared by id instead of
    # against a magic constant or a type NAME. They are minted here and nowhere
    # else, so they are native in the plainest sense -- compiler-provided, with
    # no declaration a user program could collide with.
    r.newType name: "notype" typetype: ztypetype.nullType
    # variable row 0 is the sentinel: an atomVariableId stamp of 0 means "unset"
    r.newVariable ztypeId: tid ownership: zownership.owned
    r.literalIntTid = r.newType name: "intliteral" typetype: ztypetype.recordType
    r.setValtype typeId: r.literalIntTid value: true
    r.setNative typeId: r.literalIntTid value: true
    r.literalFloatTid = r.newType name: "floatliteral" typetype: ztypetype.recordType
    r.setValtype typeId: r.literalFloatTid value: true
    r.setNative typeId: r.literalFloatTid value: true
    return r
}

# noConstFail -- "nothing is pending". The cleared state of ZTyping.constFail;
# a record has no bare-name zero form, so the absent value is spelled once here
# the way noConst spells cval's.
noConstFail: function out constfail is {
    return (constfail
        kind: constfailkind.none
        nodeid: (zast.nodeid.create from: 0)
        lineno: 0
        colno: 0
        width: 0
        strId: 0
    )
}

# noConst -- "this node is not a compile-time constant". The absent value,
# so a caller can return one answer type rather than an Option of one.
noConst: function out cval is {
    return (cval
        kind: zconstkind.none
        ival: 0
        fval: 0.0
        strId: 0
        armTid: (tid.create from: 0)
        armName: (zast.nameid.create from: 0)
    )
}

# a cval holding the integer value `v`.
makeIntConst: function {v: i64} out cval is {
    c: noConst
    c.kind = zconstkind.ivalKind
    c.ival = v
    return c
}

# a cval holding the f64 value `v`.
makeFloatConst: function {v: f64} out cval is {
    c: noConst
    c.kind = zconstkind.fvalKind
    c.fval = v
    return c
}

# a cval naming the string interned at `id` in ZTyping.constStrings.
makeStrConst: function {id: u32} out cval is {
    c: noConst
    c.kind = zconstkind.svalKind
    c.strId = id
    return c
}

# a cval naming the arm `armName` of the variant or union type `armTid`.
makeArmConst: function {armTid: tid armName: zast.nameid} out cval is {
    c: noConst
    c.kind = zconstkind.armKind
    c.armTid = armTid
    c.armName = armName
    return c
}

# --- C name mangling ---

# C reserved words an emitted identifier must not collide with. A local
# variable or a struct member whose zerolang name is one of these is
# emitted as `v_<name>`.
isCReserved: function {name: StringView} out bool is {
    if name == "main" then return true
    if name == "break" then return true
    if name == "continue" then return true
    if name == "return" then return true
    if name == "switch" then return true
    if name == "case" then return true
    if name == "default" then return true
    if name == "if" then return true
    if name == "else" then return true
    if name == "for" then return true
    if name == "while" then return true
    if name == "do" then return true
    if name == "int" then return true
    if name == "float" then return true
    if name == "double" then return true
    if name == "char" then return true
    if name == "void" then return true
    if name == "bool" then return true
    if name == "struct" then return true
    if name == "union" then return true
    if name == "enum" then return true
    if name == "static" then return true
    if name == "const" then return true
    if name == "auto" then return true
    if name == "register" then return true
    if name == "extern" then return true
    if name == "volatile" then return true
    if name == "inline" then return true
    if name == "restrict" then return true
    if name == "signed" then return true
    if name == "unsigned" then return true
    if name == "long" then return true
    if name == "short" then return true
    if name == "sizeof" then return true
    if name == "typedef" then return true
    if name == "goto" then return true
    if name == "abs" then return true
    if name == "exit" then return true
    return false
}

# `name` mangled to a C-safe local identifier, dodging C reserved words.
mangleVarName: function {name: StringView} out String is {
    if isCReserved name then return ("v_".concat name)
    return name.string
}

# The prefix `name` needs to be a C-safe struct member identifier: `v_` for a
# C reserved word and empty for every other name, which is nearly all of them.
# A member shares the local scheme and its residual -- a member literally named
# `v_default` collides with a member named `default`. It is a prefix rather
# than a mangled copy because every caller is already building the C text
# around the name, so `\{prefix}\{name}` costs no allocation where handing back
# a mangled String would cost one per member spelling. It is separate from
# mangleVarName because the emitter-guard ratchet pins mangleVarName's call
# sites at the two inside varCName: locals are named in exactly one place, and
# so are members, in memberCPrefix.
mangleMemberPrefix: function {name: StringView} out StringView is {
    if isCReserved name then return "v_"
    return ""
}

# --- numeric classification and range ---

# true when numeric kind `k` is a floating-point kind (f16/f32/f64/f128).
isFloatKind: function {k: numkind} out bool is {
    match (
        k
    ) case f16Type then {
        return true
    } case f32Type then {
        return true
    } case f64Type then {
        return true
    } case f128Type then {
        return true
    } else {
        return false
    }
}

# the mantissa bit-width of floating-point kind `k`.
mantissaOf: function {k: numkind} out u64 is {
    match (
        k
    ) case f16Type then {
        return 11
    } case f32Type then {
        return 24
    } case f64Type then {
        return 53
    } case f128Type then {
        return 113
    } else {
        return 0
    }
}

# the representable value range of numeric kind `k`.
rangeOf: function {k: numkind} out NumRange is {
    match (
        k
    ) case i8Type then {
        return (NumRange has: true loText: "-128".string hi: 127)
    } case i16Type then {
        return (NumRange has: true loText: "-32768".string hi: 32767)
    } case i32Type then {
        return (NumRange has: true loText: "-2147483648".string hi: 2147483647)
    } case i64Type then {
        return (NumRange has: true loText: "-9223372036854775808".string hi: 9223372036854775807)
    } case u8Type then {
        return (NumRange has: true loText: "0".string hi: 255)
    } case u16Type then {
        return (NumRange has: true loText: "0".string hi: 65535)
    } case u32Type then {
        return (NumRange has: true loText: "0".string hi: 4294967295)
    } case u64Type then {
        return (NumRange has: true loText: "0".string hi: 18446744073709551615.u64)
    } case c8Type then {
        return (NumRange has: true loText: "0".string hi: 255)
    } case c32Type then {
        return (NumRange has: true loText: "0".string hi: 4294967295)
    } else {
        return (NumRange has: false loText: "0".string hi: 0)
    }
}

# the absolute value of `v` as a u64 (handles i64 min without overflow).
absI64: function {v: i64} out u64 is {
    if v < 0 then return (0 - v).u64.orPanic
    return v.u64.orPanic
}

# the number of significant bits in `v` (0 for 0).
bitLength: function {v: u64} out u64 is {
    count: u64
    tmp: v
    for tmp > 0 loop {
        tmp = tmp >> 1
        count = count + 1
    }
    return count
}

# True iff `value` is exactly representable as a float of kind `k`.
intFitsFloat: function {value: i64 k: numkind} out bool is {
    if (isFloatKind k) == false then return false
    m: mantissaOf k
    if value == 0 then return true
    av: absI64 value
    for (av & 1) == 0 loop av = av >> 1
    bl: bitLength av
    if bl <= m then return true
    return false
}

# True iff f64 `value` is exactly representable as a float of kind `k`.
# f64 always succeeds; f32 requires a bit-preserving round-trip; f128
# is not evaluated here (punt to an explicit suffix).
floatFitsFloat: function {value: f64 k: numkind} out bool is {
    match (
        k
    ) case f64Type then {
        return true
    } case f128Type then {
        return true
    } case f32Type then {
        r: value.f32
        match (
            r
        ) case ok then {
            return true
        } case err then {
            return false
        }
    } case f16Type then {
        # exact binary16 representability, computed in f64 ARITHMETIC ONLY.
        # Not because the seed cannot convert -- it can -- but because
        # halffloat's `require:` block refuses `_Float16` under tcc and
        # test-bootstrap builds the compiler WITH tcc, so a `.f16` in this file
        # would make the compiler unbuildable. The f64-only arithmetic is
        # load-bearing.
        #
        # Find the value's binade, derive the f16 ulp there, and require the
        # value to be an exact multiple of it within range.
        av: value
        if av < 0.0 then av = 0.0 - av
        if av == 0.0 then return true
        if av > 65504.0 then return false
        # f16 keeps ten stored mantissa bits, so the spacing in binade e is
        # 2^(e-10) -- the exponent from logB, the power of two from scaleB,
        # which is what those two exist for. Below the smallest normal the
        # spacing stops shrinking and stays at 2^-24: the subnormal floor.
        ulp: 1.0.scaleB n: (av.logB - 10)
        minUlp: 1.0.scaleB n: (0 - 24)
        if ulp < minUlp then ulp = minUlp
        q: av / ulp
        # q < 2048 by construction; the checked u64 conversion errs on a
        # fractional value, which is exactly the integerness test
        qo: q.u64
        match (
            qo
        ) case ok then {
            return true
        } case err then {
            return false
        }
    } else {
        return false
    }
}

# --- numeric-literal value parsing ---

# Digit value of an ASCII byte (0-9, a-f, A-F), or none.
digitVal: function {b: u8} out optionval u64 is {
    if b >= 48 then {
        if b <= 57 then return (optionval.some (b - 48).u64)
    }
    if b >= 97 then {
        if b <= 102 then return (optionval.some ((b - 97).u64 + 10))
    }
    if b >= 65 then {
        if b <= 70 then return (optionval.some ((b - 65).u64 + 10))
    }
    return (optionval.none u64)
}

# Detect an inline numeric type suffix shape (longest first) on a
# lexeme. Diagnostic + exact-name mapping only -- parseNumber never
# peels; inline suffixes are not part of the language.
# numkindByName -- the numkind for an exact numeric-type-name spelling
# ("u8", "f32", "c32"); has=false for any other text. The single source
# of suffix spellings -- suffixInfoOf derives from this table.
numkindByName: function {name: StringView} out suffixinfo is {
    if name == "i8" then return (suffixinfo has: true kind: numkind.i8Type len: 2)
    if name == "u8" then return (suffixinfo has: true kind: numkind.u8Type len: 2)
    if name == "c8" then return (suffixinfo has: true kind: numkind.c8Type len: 2)
    if name == "i16" then return (suffixinfo has: true kind: numkind.i16Type len: 3)
    if name == "i32" then return (suffixinfo has: true kind: numkind.i32Type len: 3)
    if name == "i64" then return (suffixinfo has: true kind: numkind.i64Type len: 3)
    if name == "u16" then return (suffixinfo has: true kind: numkind.u16Type len: 3)
    if name == "u32" then return (suffixinfo has: true kind: numkind.u32Type len: 3)
    if name == "u64" then return (suffixinfo has: true kind: numkind.u64Type len: 3)
    if name == "f16" then return (suffixinfo has: true kind: numkind.f16Type len: 3)
    if name == "f32" then return (suffixinfo has: true kind: numkind.f32Type len: 3)
    if name == "f64" then return (suffixinfo has: true kind: numkind.f64Type len: 3)
    if name == "c32" then return (suffixinfo has: true kind: numkind.c32Type len: 3)
    if name == "i128" then return (suffixinfo has: true kind: numkind.i128Type len: 4)
    if name == "u128" then return (suffixinfo has: true kind: numkind.u128Type len: 4)
    if name == "f128" then return (suffixinfo has: true kind: numkind.f128Type len: 4)
    return (suffixinfo has: false kind: numkind.i64Type len: 0)
}

# suffixInfoOf -- inline-suffix detection over a numeric lexeme: probe the
# lexeme's tail against the numkindByName table, longest spelling first.
# Only the inline-suffix rejection diagnostic consumes this -- the language
# itself has no inline suffixes.
suffixInfoOf: function {numstr: StringView} out suffixinfo is {
    n: numstr.length
    tl: 4.u64
    for tl >= 2 loop {
        if n >= tl then {
            si: numkindByName name: (numstr.substring from: (n - tl) to: n)
            if si.has then return si
        }
        tl = tl - 1
    }
    return (suffixinfo has: false kind: numkind.i64Type len: 0)
}

# the diagnostic message for a value outside kind `k`'s range `r`.
rangeErr: function {value: u64 k: numkind r: NumRange.view} out String is {
    msg: "Value \{value} out of range for \{numkindName k} (\{r.loText}..\{r.hi})"
    return msg
}

# Parse a numeric literal lexeme into (kind, value, error) against an
# optional required kind (the dot-form conversion target). The lexeme is
# consumed in its ENTIRETY -- the language has no inline type suffixes,
# so any non-literal tail is an invalid literal. 'e'-notation is NOT
# recognised here -- only a decimal point selects the float path, so a
# bare `1e3` is an invalid integer.
parseNumberWith: function {numstr: StringView hasK: bool k: numkind} out ParsedNumber is {
    n: numstr.length
    coreLen: n
    hasKind: hasK
    kind: k

    hasDot: false
    di: u64
    for di < coreLen loop {
        bo: numstr.byteAt di
        match bo case some then {
            if bo == 46 then hasDot = true
        } case none then null
        di = di + 1
    }

    if hasDot then {
        if hasKind then {
            if (isFloatKind kind) == false then {
                return (ParsedNumber
                    :kind
                    isFloat: false
                    ival: 0
                    fval: 0.0
                    err: "Numeric type specifier must be float for literals with decimal points".string
                )
            }
        } else {
            kind = numkind.f64Type
            hasKind = true
        }
    }

    base: 10.u64
    startIdx: u64
    isChar: false
    if numstr.startsWith "0b" then {
        base = 2
        startIdx = 2
    }
    if numstr.startsWith "0o" then {
        base = 8
        startIdx = 2
    }
    if numstr.startsWith "0x" then {
        base = 16
        startIdx = 2
    }
    if numstr.startsWith "0c" then {
        isChar = true
        startIdx = 2
    }

    if hasKind == false then {
        if isChar then {
            kind = numkind.c32Type
        } else {
            kind = numkind.i64Type
        }
        hasKind = true
    }

    if isChar then {
        bodyLen: coreLen - 2
        if bodyLen != 1 then {
            return (ParsedNumber
                :kind
                isFloat: false
                ival: 0
                fval: 0.0
                err: ("Character literal must be exactly one character: ".concat numstr)
            )
        }
        cbopt: numstr.byteAt 2.u64
        cval: u64
        match cbopt case some then {
            cval = cbopt.u64
        } case none then null
        rc: rangeOf kind
        if rc.has then {
            if cval > rc.hi then {
                em: rangeErr value: cval k: kind r: rc
                return (ParsedNumber :kind isFloat: false ival: cval fval: 0.0 err: em)
            }
        }
        return (ParsedNumber :kind isFloat: false ival: cval fval: 0.0 err: "".string)
    }

    if isFloatKind kind then {
        if base != 10 then {
            return (ParsedNumber
                :kind
                isFloat: true
                ival: 0
                fval: 0.0
                err: ("Base must be 10 for float: ".concat numstr)
            )
        }
        fbuf: String
        fi: u64
        for fi < coreLen loop {
            fbo: numstr.byteAt fi
            match fbo case some then {
                fbuf.appendByte fbo
            } case none then null
            fi = fi + 1
        }
        fres: fbuf.stringView.parseF64
        match fres case ok then {
            return (ParsedNumber :kind isFloat: true ival: 0 fval: fres err: "".string)
        } case err then {
            return (ParsedNumber
                :kind
                isFloat: true
                ival: 0
                fval: 0.0
                err: ("Invalid numeric literal: ".concat numstr)
            )
        }
    }

    acc: u64
    ok: true
    ii: startIdx
    for ii < coreLen loop {
        ibo: numstr.byteAt ii
        match ibo case some then {
            if ibo != 95 then {
                dvo: digitVal ibo
                match dvo case some then {
                    if dvo < base then {
                        acc = (acc * base) + dvo
                    } else {
                        ok = false
                    }
                } case none then {
                    ok = false
                }
            }
        } case none then null
        ii = ii + 1
    }

    if ok == false then {
        return (ParsedNumber
            :kind
            isFloat: false
            ival: 0
            fval: 0.0
            err: ("Invalid numeric literal: ".concat numstr)
        )
    }

    ri: rangeOf kind
    if ri.has then {
        if acc > ri.hi then {
            em2: rangeErr value: acc k: kind r: ri
            return (ParsedNumber :kind isFloat: false ival: acc fval: 0.0 err: em2)
        }
    }
    return (ParsedNumber :kind isFloat: false ival: acc fval: 0.0 err: "".string)
}

# Parse a numeric literal lexeme into (kind, value, error); the kind
# comes from the literal's own shape (dot -> f64, 0c -> c32, else i64).
parseNumber: function {numstr: StringView} out ParsedNumber is {
    return (parseNumberWith :numstr hasK: false k: numkind.i64Type)
}

# parseNumberAs -- parse a complete literal against a required kind (the
# dot-form conversion target): range-checks integers and chars, requires
# a float kind for dotted literals.
parseNumberAs: function {numstr: StringView k: numkind} out ParsedNumber is {
    return (parseNumberWith :numstr hasK: true :k)
}

# Parse a literal to its unbounded value, ignoring range errors so a
# u64::MAX literal can still flow into a u64-typed location. Returns
# ok=false only for an unparseable lexeme.
parseLiteralValue: function {numstr: StringView} out parsedval is {
    p: parseNumber numstr
    hasErr: (p.err.length > 0)
    if hasErr then {
        if p.ival == 0 then {
            if (p.err.stringView.contains "out of range") == false then {
                return (parsedval ok: false isFloat: false ival: 0 fval: 0.0)
            }
        }
    }
    return (parsedval ok: true isFloat: p.isFloat ival: p.ival fval: p.fval)
}
