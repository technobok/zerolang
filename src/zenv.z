# ZeroLang body-walk environment for the type checker.
#
# Frames and locals are declarations in the typing's Decl tree -- a frame is a
# blockDecl under the frame or declaration enclosing it, a local a localDecl
# under the frame it is written in -- so they persist and can be returned to.
# The table holds the walk's state over them: the open frames (a stack of ids,
# innermost last), the overlay rows the walk lays over locals (a take, a
# narrowing, a lock), which die with the frame that laid them, the frames whose
# remainder the walk found unreachable, and the rows snapshotted for the dump
# when a frame closes.
#
# `this.entries` -- the overlay rows -- is reached through a borrowed
# receiver, so `List.get` yields a COPY: fine to read, but a mutation written
# back with `List.set` frees heap fields the copy still aliases. Every mutation
# therefore goes through `append` / `pop` on the field list directly (which
# persist without copying).
#
# A row stores a u64 type id (never a live type); type metadata is read
# through the owned registry (`this.reg`) and declarations, member edges and
# locals through the typecheck-output container (`this.typing`).

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :ZSymbolTable
    :isExcludableKind
    :sumArmNames
    :newSymbolTable
    :formatPath
    :zlockstateNameLower
    :main
}

ZVariable: ztypes.ZVariable
ZEntry: ztypes.ZEntry
ZTyping: ztyping.ZTyping

# --- pure helpers ---

# a bool rendered as "true" or "false".
boolText: function {b: bool} out String is {
    match (
        b
    ) case true then {
        return "true".string
    } case false then {
        return "false".string
    }
}

# an optional u64 rendered as text ("none" when absent).
optVidText9: function {o: optionval ztypes.vid} out String is {
    match (
        o
    ) case some then {
        ov9: o + 0
        return "\{ov9}"
    } case none then {
        return "none".string
    }
}

# optTidText -- the same for an optional TYPE id; an `optionval tid` is not
# an `optionval u64`, so the smoke needs its own reader.
optTidText: function {o: optionval ztypes.tid} out String is {
    match (
        o
    ) case some then {
        return "\{o.u64}"
    } case none then {
        return "none".string
    }
}

# Two lock paths are equal iff same length and every segment matches.
pathsEqual: function {a: (List String).view b: (List String).view} out bool is {
    if a.length != b.length then return false
    n: a.length
    i: u64
    for i < n loop {
        av: a.get :i
        bv: b.get :i
        if av.stringview != bv.stringview then return false
        i = i + 1
    }
    return true
}

# True iff `p` is a (non-strict) prefix of `whole`.
isPrefix: function {p: (List String).view whole: (List String).view} out bool is {
    pn: p.length
    wn: whole.length
    if pn > wn then return false
    i: u64
    for i < pn loop {
        pv: p.get :i
        wv: whole.get :i
        if pv.stringview != wv.stringview then return false
        i = i + 1
    }
    return true
}

# Two paths overlap iff one is a (non-strict) prefix of the other:
# compare the shared leading run.
pathsOverlap: function {a: (List String).view b: (List String).view} out bool is {
    an: a.length
    bn: b.length
    n: an
    if bn < an then n = bn
    i: u64
    for i < n loop {
        av: a.get :i
        bv: b.get :i
        if av.stringview != bv.stringview then return false
        i = i + 1
    }
    return true
}

# true when two lock holders are the same.
holderEq: function {a: ztypes.zlockholder b: ztypes.zlockholder} out bool is {
    if a.kind == b.kind then {
        if a.id == b.id then return true
    }
    return false
}

# Multi-granularity conflict for a NEW lock acquisition. Both paths share
# the same root (caller filters by entry name). Same path: conflict iff
# either side is EXCLUSIVE. Strict-ancestor existing: conflict iff that
# ancestor is EXCLUSIVE, or is a SHARED TARGET and the request is EXCLUSIVE --
# a live read of a subtree excludes a writer below it, while a SHARED INTENT
# prefix permits the deeper lock it was taken for. Strict-ancestor requested:
# conflict iff the request is EXCLUSIVE. Siblings never conflict.
lockAcquireConflict: function {
    existingType: ztypes.zlockstate
    existingScope: ztypes.zlockscope
    existingPath: (List String).view
    reqType: ztypes.zlockstate
    reqPath: (List String).view
} out bool is {
    eq: pathsEqual a: existingPath b: reqPath
    if eq then {
        if existingType == ztypes.zlockstate.exclusive then return true
        if reqType == ztypes.zlockstate.exclusive then return true
        return false
    }
    eLen: existingPath.length
    rLen: reqPath.length
    if eLen < rLen then {
        anc: isPrefix p: existingPath whole: reqPath
        if anc then {
            if existingType == ztypes.zlockstate.exclusive then return true
            if existingScope == ztypes.zlockscope.target then {
                return (reqType == ztypes.zlockstate.exclusive)
            }
            return false
        }
    }
    if rLen < eLen then {
        anc2: isPrefix p: reqPath whole: existingPath
        if anc2 then return (reqType == ztypes.zlockstate.exclusive)
    }
    return false
}

# A subtype participates in exclusion narrowing only if it is a real
# data-bearing arm (not a function / data block / tag / enum member).
isExcludableKind: function {k: ztypes.ztypetype} out bool is {
    if k == ztypes.ztypetype.functionType then return false
    if k == ztypes.ztypetype.dataType then return false
    if k == ztypes.ztypetype.tagType then return false
    return true
}

# sumArmNames -- a sum type's arm names, in declaration order: the member
# children that are not a function, the tag data record or an enum, and are not
# a tag generic origin. The one definition of what a sum's arms are -- the
# checker (sumSubtypeNames), the emitter (sumArmNames9) and the exclusion
# narrowing below all route here, so they cannot disagree about the arm set.
sumArmNames: function {
    ty: ZTyping
    reg: ztypes.ZTypeRegistry
    pool: zast.StringPool.view
    tid: ztypes.tid
    names: List String
} is {
    nms9: (ListVal u64)
    tds9: (ListVal u64)
    ty.declMemberList ownerTid: (ztypes.tid.create from: tid.u64) names: nms9 tids: tds9
    i9: u64
    n9: nms9.length
    for i9 < n9 loop {
        nid9: nms9.get i: i9
        ctid9: tds9.get i: i9
        i9 = i9 + 1
        if (isExcludableKind k: (reg.typetypeOf typeId: (ztypes.tid.create from: ctid9.u64))) then {
            if (reg.isTagGenericOriginOf typeId: (ztypes.tid.create from: ctid9.u64)) == false then {
                nb9: pool.texts.get i: nid9.u64
                names.append nb9.copy
            }
        }
    }
}

# the lower-case display name of lock state `t` (for diagnostics).
zlockstateNameLower: function {t: ztypes.zlockstate} out String is {
    match (
        t
    ) case exclusive then {
        return "exclusive".string
    } case shared then {
        return "shared".string
    }
}

# a path list rendered as a dotted "a.b.c" string.
formatPath: function {path: (List String).view} out String is {
    if path.length == 0 then return "<unknown>".string
    return (stringJoin parts: path sep: ".")
}

# Two locks taken while processing calls conflict: one reftype reached twice as
# an argument or a receiver. A call identity is not user-visible, so the message
# names the paths instead of the holder.
formatAliasConflict: function {
    reqPath: (List String).view
    existingPath: (List String).view
    sameCall: bool
} out String is {
    rp: formatPath reqPath
    ep: formatPath existingPath
    if (pathsEqual a: reqPath b: existingPath) then {
        if sameCall then return "Cannot pass '\{rp}' twice in one call — a reftype may appear only once as an argument or as a receiver"
        return "Cannot pass '\{rp}': it is already passed to an enclosing call"
    }
    if reqPath.length < existingPath.length then {
        return "Cannot pass both '\{rp}' and '\{ep}' in one call — '\{ep}' is inside '\{rp}'; a reftype may appear only once as an argument or as a receiver"
    }
    return "Cannot pass both '\{ep}' and '\{rp}' in one call — '\{rp}' is inside '\{ep}'; a reftype may appear only once as an argument or as a receiver"
}

# --- carriers ---

# A row of the dump's `entry` table: a local of a frame, or an overlay row
# laid over one, snapshotted when the frame closed. `position` is the row's
# place among the frame's locals and overlays in the order they were laid.
ZEntryDumpRow: class {
    scopeId: u64
    position: u64
    entryId: u64
    name: u32
    ztypeId: ztypes.tid
    isDefinition: bool
    varId: (optionval ztypes.vid)
    originalZtypeId: (optionval ztypes.tid)
    isTaken: bool
    takenAt: (optionval ztypes.zsrcpos)
    narrowedSubtype: String
    excludedSubtypes: (List String)
}

# The body walk's environment. Frames and locals are declarations in the
# typing's Decl tree -- a frame is a blockDecl whose parent is the frame or
# declaration enclosing it, a local a localDecl under the frame it is written
# in -- so they persist, and a walk that returns to a frame later finds what
# was written there. What the table holds is the walk's STATE over them: the
# open frames, innermost last (a stack of frame ids -- discipline, not
# storage; the top is the typing's curFrame), the overlay rows the walk lays
# over locals -- a take, a narrowing, a lock -- which die with the frame that
# laid them, the frames whose walk found their remainder unreachable, and the
# rows snapshotted for the dump when a frame closes.
#
# A local resolves by climbing the open frame chain from the top through each
# enclosing frame; a frame's parent that is not a frame -- the function
# declaration -- ends the climb, so two functions never see each other's
# locals whatever order their bodies are walked in, and a body walked on
# demand from inside another leaves that one's locals invisible. The overlay
# rows are keyed by the local's declaration, so a row can only ever be read
# through the local it was laid over. Owns the type registry and the typing
# tables outright (moved in at construction), so every method reads metadata
# via `this.reg` / `this.typing`.
ZSymbolTable: class {
    frames: (ListVal ztypes.declid)
    # per open frame: the overlay index where its rows begin, and how many
    # locals it has defined so far (a row's defSeq)
    frameStarts: (ListVal u64)
    frameDefs: (ListVal u64)
    entries: (List ZEntry)
    unreachableFrames: (SetVal u64)
    # dump scaffolding: a frame's label ("function:x", "if_branch", ...), the
    # frames a diagnostics-only template walk opened (kept out of the dump),
    # and the rows snapshotted when a frame closed
    frameLabel: (MapVR u64 value: String)
    frameHidden: (SetVal u64)
    entryDump: (List ZEntryDumpRow)
    reg: ztypes.ZTypeRegistry
    typing: ZTyping
} as {
    # --- frames ---

    # The innermost open frame that exists as a declaration, or the zero id
    # when none is open. A block frame that has declared nothing yet has no
    # row (pushBlock, pushCall): it is transparent to every lookup, so the
    # nearest enclosing frame that does exist answers for it.
    curFrame: function {:this} out ztypes.declid is {
        n: this.frames.length
        for n > 0 loop {
            n = n - 1
            f: this.frames.get i: n
            if (f.isZero) == false then return f
        }
        return (ztypes.declid.create from: 0)
    }

    # Open a frame under the typing's current frame -- the enclosing frame,
    # or the declaration whose body this is -- and make it current.
    pushFrame: function {:this label: StringView} out ztypes.declid is {
        f: this.typing.declNewFrame parent: this.typing.curFrame node: 0
        this.frames.append f
        this.frameStarts.append this.entries.length
        this.frameDefs.append 0
        if label.length > 0 then this.frameLabel.set key: f.u64 value: label.string
        if this.typing.suppressParamStamps then this.frameHidden.add item: f.u64
        this.typing.curFrame = f
        return f
    }

    # pushLazyFrame -- open a block frame whose row is minted only when it
    # first declares something (materialiseTop): most blocks, arms, loops
    # and call brackets never do, and a frame that holds nothing is
    # invisible to every walk. The model dump wants every frame, so a dump
    # (and a template walk, whose frames are hidden by id) opens it now.
    pushLazyFrame: function {:this label: StringView} is {
        if this.typing.dumpRows then {
            this.pushFrame :label
            return
        }
        if this.typing.suppressParamStamps then {
            this.pushFrame :label
            return
        }
        this.frames.append (ztypes.declid.create from: 0)
        this.frameStarts.append this.entries.length
        this.frameDefs.append 0
    }

    # materialiseTop -- give the innermost open frame its row, under the
    # nearest enclosing frame that has one, and make it the typing's current
    # frame. A no-op for a frame that already has a row.
    materialiseTop: function {:this} is {
        n: this.frames.length
        if n == 0 then return
        top: this.frames.get i: (n - 1)
        if (top.isZero) == false then return
        f: this.typing.declNewFrame parent: this.typing.curFrame node: 0
        this.frames.set i: (n - 1) val: f
        this.typing.curFrame = f
    }

    # push -- open a body frame (a function's, or a mono walk's) named for
    # the dump.
    push: function {:this name: StringView} out u64 is {
        return (this.pushFrame label: name).u64
    }

    # pushBlock / pushCall -- open a nested frame; the marker returned is the
    # depth to pop back to.
    pushBlock: function {:this name: StringView} out u64 is {
        marker: this.frames.length
        this.pushLazyFrame label: name
        return marker
    }

    pushCall: function {:this} out u64 is {
        marker: this.frames.length
        this.pushLazyFrame label: ""
        return marker
    }

    # Close the innermost frame. Its overlay rows are dropped -- except a
    # take of a local defined in an ENCLOSING frame, which the enclosing
    # frame inherits so the error persists -- and the frame's locals and
    # rows are snapshotted for the dump first. The typing's current frame
    # returns to the frame's parent.
    pop: function {:this} out u64 is {
        n: this.frames.length
        if n == 0 then return 0
        topIdx: n - 1
        top: this.frames.get i: topIdx
        start: this.frameStarts.get i: topIdx
        if (top.isZero) == false then this.snapshotFrame frame: top :start
        endIdx: this.entries.length
        # takes of enclosing frames' locals survive the close
        mDecls: (ListVal ztypes.declid)
        mNames: (ListVal u32)
        mTypes: (ListVal u64)
        mLocs: (ListVal ztypes.zsrcpos)
        p2: start
        for p2 < endIdx loop {
            e: this.entries.get i: p2
            if e.isTaken then {
                taOpt: e.takenAt
                match (
                    taOpt
                ) case some then {
                    ef: this.typing.declParentOf declId: e.declId
                    if ef != top then {
                        zt: e.ztypeId
                        mDecls.append e.declId
                        mNames.append e.name
                        mTypes.append zt
                        mLocs.append taOpt
                    }
                } case none then null
            }
            p2 = p2 + 1
        }
        this.dropTail :start
        this.frames.pop
        this.frameStarts.pop
        this.frameDefs.pop
        # a frame that never got a row left the typing's current frame where
        # it was: at the nearest enclosing frame that has one
        if (top.isZero) == false then this.typing.curFrame = this.typing.declParentOf declId: top
        mc: mDecls.length
        mi: u64
        for mi < mc loop {
            d: mDecls.get i: mi
            already: this.isTakenDecl declId: d
            if already == false then {
                te: (this.reg.newEntry
                    nameId: (zast.nameid.create from: (mNames.get i: mi).u32)
                    ztypeId: (ztypes.tid.create from: (mTypes.get i: mi).u64)
                    isDefinition: false
                )
                te.isTaken = true
                te.takenAt = (optionval.some (mLocs.get i: mi))
                this.appendRow row: te declId: d
            }
            mi = mi + 1
        }
        return top.u64
    }

    # pushDryRun -- open a frame for a dry run: its rows are discarded whole
    # by popDiscard, and it stays out of the dump.
    pushDryRun: function {:this} is {
        f: this.pushFrame label: ""
        this.frameHidden.add item: f.u64
    }

    # popDiscard -- close the innermost frame and drop every row it laid,
    # takes included: the frame was a dry run.
    popDiscard: function {:this} is {
        n: this.frames.length
        if n == 0 then return
        topIdx: n - 1
        top: this.frames.get i: topIdx
        start: this.frameStarts.get i: topIdx
        this.dropTail :start
        this.frames.pop
        this.frameStarts.pop
        this.frameDefs.pop
        if (top.isZero) == false then this.typing.curFrame = this.typing.declParentOf declId: top
    }

    popTo: function {:this marker: u64} is {
        for this.frames.length > marker loop this.pop
    }

    # --- locals ---

    # Define a body-level binding without a runtime variable (a loop
    # variable's type binding, a generic parameter bound for a walk).
    define: function {:this nameId: zast.nameid ztypeId: ztypes.tid} is {
        this.defineLocal :nameId :ztypeId varId: ztypes.vid
    }

    # Define a runtime variable with ownership tracking. The C identifier is
    # the emitter's business -- a variable is known here by its id alone.
    defineVar: function {:this nameId: zast.nameid var: ZVariable} is {
        this.typing.variableZtype.set key: var.variableId value: var.ztypeId
        this.typing.variableOwnership.set key: var.variableId value: var.ownership
        this.typing.variableIsPrivate.set key: var.variableId value: var.isPrivateAccess
        bo: optStrOrEmpty o: var.borrowOrigin
        this.typing.variableBorrowOrigin.set key: var.variableId value: bo
        so: optStrOrEmpty o: var.synthOrigin
        this.typing.variableSynthOrigin.set key: var.variableId value: so
        this.defineLocal :nameId ztypeId: var.ztypeId varId: var.variableId
    }

    defineLocal: function {:this nameId: zast.nameid ztypeId: ztypes.tid varId: ztypes.vid} is {
        n: this.frames.length
        if n == 0 then return
        this.materialiseTop
        topIdx: n - 1
        (this.typing.declNewLocal
            name: nameId.u32
            parent: (this.frames.get i: topIdx)
            node: 0
            typeId: ztypeId
            :varId
        )
        this.frameDefs.set i: topIdx val: ((this.frameDefs.get i: topIdx) + 1)
    }

    # --- name resolution ---

    # findLocal -- the declaration `nameId` resolves to from the innermost
    # open frame outward: each frame's own locals (the last defined wins),
    # then the frame enclosing it, until the chain leaves the frames. Zero
    # when no frame defines it.
    findLocal: function {:this nameId: zast.nameid} out ztypes.declid is {
        return (this.typing.declFindLocal frame: this.curFrame :nameId)
    }

    # isLocalName -- does an open frame define `nameId`, taken or not?
    isLocalName: function {:this nameId: zast.nameid} out bool is {
        d: this.findLocal :nameId
        return d.isZero == false
    }

    # rowOf -- the newest overlay row laid over `declId`, or none.
    rowOf: function {:this declId: ztypes.declid} out optionval u64 is {
        if declId.isZero then return (optionval.none u64)
        if (this.typing.declRowsOf :declId) == 0 then return (optionval.none u64)
        ne: this.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == declId then return (optionval.some j2)
            j = j - 1
        }
        return (optionval.none u64)
    }

    # appendRow -- lay `row` over `declId` in the innermost frame.
    appendRow: function {:this row: ZEntry.take declId: ztypes.declid} is {
        r: row
        r.declId = declId
        n: this.frames.length
        if n > 0 then {
            r.frame = this.frames.get i: (n - 1)
            r.defSeq = this.frameDefs.get i: (n - 1)
        }
        this.typing.declRowsAdd :declId delta: 1
        this.entries.append r
    }

    # dropTail -- drop the rows from `start` up, keeping the locals' counts.
    dropTail: function {:this start: u64} is {
        for this.entries.length > start loop {
            e: this.entries.pop
            this.typing.declRowsAdd declId: e.declId delta: -1
        }
    }

    # Resolve a name to its type id, or none (also none when taken).
    lookup: function {:this nameId: zast.nameid} out optionval ztypes.tid is {
        d: this.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.tid)
        ro: this.rowOf declId: d
        match (
            ro
        ) case some then {
            e: this.entries.get i: ro
            if e.isTaken then return (optionval.none ztypes.tid)
            return (optionval.some e.ztypeId)
        } case none then null
        return (optionval.some (this.typing.declLocalTypeOf declId: d))
    }

    # Declared type of `name`, ignoring narrowing overlays: the row's
    # original (pre-narrowing) type when set, else its current type. A
    # narrowed sum-type target accepts a fresh value of its whole declared
    # type, so a reassignment validates its RHS against this, not the
    # narrowed view.
    declaredTypeOf: function {:this nameId: zast.nameid} out optionval ztypes.tid is {
        d: this.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.tid)
        ro: this.rowOf declId: d
        match (
            ro
        ) case some then {
            e: this.entries.get i: ro
            if e.isTaken then return (optionval.none ztypes.tid)
            oz9: e.originalZtypeId
            match (
                oz9
            ) case some then {
                return (optionval.some oz9)
            } case none then null
            return (optionval.some e.ztypeId)
        } case none then null
        return (optionval.some (this.typing.declLocalTypeOf declId: d))
    }

    # Variable id bound to `name`, skipping lock/narrow overlays; none if
    # taken or unbound.
    lookupVarId: function {:this nameId: zast.nameid} out optionval ztypes.vid is {
        d: this.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.vid)
        if (this.isTakenDecl declId: d) then return (optionval.none ztypes.vid)
        v: this.typing.declLocalVarOf declId: d
        if v.isZero then return (optionval.none ztypes.vid)
        return (optionval.some v)
    }

    # --- invalidation (take) ---

    invalidate: function {:this nameId: zast.nameid loc: optionval ztypes.zsrcpos} out bool is {
        d: this.findLocal :nameId
        if d.isZero then return false
        zt: this.currentTypeOf declId: d
        v: this.typing.declLocalVarOf declId: d
        if (v.isZero) == false then this.typing.variableMoved.set key: v value: true
        te: this.reg.newEntry :nameId ztypeId: zt isDefinition: false
        te.isTaken = true
        te.takenAt = loc
        this.appendRow row: te declId: d
        return true
    }

    # currentTypeOf -- the local's type as its newest row has it.
    currentTypeOf: function {:this declId: ztypes.declid} out ztypes.tid is {
        ro: this.rowOf :declId
        match (
            ro
        ) case some then {
            return (this.entries.get i: ro).ztypeId
        } case none then null
        return (this.typing.declLocalTypeOf :declId)
    }

    isTakenDecl: function {:this declId: ztypes.declid} out bool is {
        ro: this.rowOf :declId
        match (
            ro
        ) case some then {
            return (this.entries.get i: ro).isTaken
        } case none then null
        return false
    }

    getTakenLocation: function {:this nameId: zast.nameid} out optionval ztypes.zsrcpos is {
        d: this.findLocal :nameId
        ro: this.rowOf declId: d
        match (
            ro
        ) case some then {
            e: this.entries.get i: ro
            if e.isTaken then return e.takenAt
        } case none then null
        return (optionval.none ztypes.zsrcpos)
    }

    isTakenName: function {:this nameId: zast.nameid} out bool is {
        return (this.isTakenDecl declId: (this.findLocal :nameId))
    }

    # Index of the newest taken row for `name`, or none.
    takenIndex: function {:this nameId: zast.nameid} out optionval u64 is {
        d: this.findLocal :nameId
        if d.isZero then return (optionval.none u64)
        ne: this.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == d then {
                if e.isTaken then return (optionval.some j2)
            }
            j = j - 1
        }
        return (optionval.none u64)
    }

    # Rebuild the row list from `dropIdx` up, omitting that slot; the rows
    # below it keep their places.
    removeEntryAt: function {:this dropIdx: u64} is {
        if dropIdx >= this.entries.length then return
        rev: (List ZEntry)
        for this.entries.length > dropIdx loop rev.append this.entries.pop
        pos: dropIdx
        for rev.length > 0 loop {
            e: rev.pop
            if pos != dropIdx then {
                this.entries.append e
            } else {
                this.typing.declRowsAdd declId: e.declId delta: -1
            }
            pos = pos + 1
        }
    }

    # Remove the newest taken row for `name` (match/case restore).
    clearTaken: function {:this nameId: zast.nameid} is {
        kOpt: this.takenIndex :nameId
        match (
            kOpt
        ) case some then {
            this.removeEntryAt dropIdx: kOpt
        } case none then null
    }

    # Drop every taken row the innermost frame laid (diverging arm). Only
    # that frame's rows can be dropped, so only they are drained and
    # rebuilt -- the rows below its start are left where they are.
    discardTakenInCurrentScope: function {:this} is {
        n: this.frames.length
        if n == 0 then return
        start: this.frameStarts.get i: (n - 1)
        rev: (List ZEntry)
        for this.entries.length > start loop rev.append this.entries.pop
        for rev.length > 0 loop {
            e: rev.pop
            if e.isTaken == false then {
                this.entries.append e
            } else {
                this.typing.declRowsAdd declId: e.declId delta: -1
            }
        }
    }

    setTakenLocation: function {:this nameId: zast.nameid loc: ztypes.zsrcpos} is {
        kOpt: this.takenIndex :nameId
        match (
            kOpt
        ) case some then {
            rev: (List ZEntry)
            for this.entries.length > 0 loop rev.append this.entries.pop
            pos: u64
            for rev.length > 0 loop {
                e: rev.pop
                if pos == kOpt then {
                    lc: loc
                    e.takenAt = (optionval.some lc)
                }
                this.entries.append e
                pos = pos + 1
            }
        } case none then null
    }

    # --- lock holder formatting ---

    # localNameOfVar -- the name of the open local bound to `vid`, or 0.
    localNameOfVar: function {:this vid: ztypes.vid} out u32 is {
        cur: this.curFrame
        for cur > 0 loop {
            if (this.typing.declIsFrame declId: cur) == false then return 0
            kn: this.typing.declChildSlots declId: cur
            ki: kn
            for ki > 0 loop {
                ki = ki - 1
                kd: this.typing.declChildAt declId: cur index: ki
                kv: this.typing.declLocalVarOf declId: kd
                if kv == vid then return (this.typing.declNameOf declId: kd)
            }
            cur = this.typing.declParentOf declId: cur
        }
        return 0
    }

    formatLockHolder: function {:this pool: zast.StringPool.view holder: ztypes.zlockholder} out String is {
        k: holder.kind
        match (
            k
        ) case varKind then {
            nmId9: this.localNameOfVar vid: (ztypes.vid.create from: holder.id)
            if nmId9 == 0 then return "<var:\{holder.id}>"
            return (zast.poolTextCopy :pool ref: (zast.nameid.create from: nmId9.u32))
        } case callKind then {
            return "call:\{holder.id}"
        } case forKind then {
            return "__for".string
        }
        panic msg: "unreachable lock holder kind"
    }

    formatLockConflict: function {:this pool: zast.StringPool.view reqPath: (List String).view reqType: ztypes.zlockstate existingType: ztypes.zlockstate existingPath: (List String).view existingHolder: ztypes.zlockholder} out String is {
        rootStr: reqPath.get i: 0
        rootView: rootStr.stringview
        reqKind: zlockstateNameLower reqType
        heldKind: zlockstateNameLower existingType
        reqDetail: String
        if reqPath.length > 1 then {
            rp: formatPath reqPath
            reqDetail = " on '\{rp}'"
        }
        heldDetail: String
        same: pathsEqual a: existingPath b: reqPath
        if same == false then {
            hp: formatPath existingPath
            heldDetail = " on '\{hp}'"
        }
        holderName: this.formatLockHolder :pool holder: existingHolder
        # A binding holding a SHARED lock on ITSELF is a readonly parameter:
        # saying it "already has a lock held by" its own name explains nothing.
        # An exclusive self-lock is not that, and keeps the ordinary wording.
        if holderName.stringview == rootView when existingType == ztypes.zlockstate.shared then {
            return "Cannot take \{reqKind} lock on '\{rootView}'\{reqDetail}: '\{rootView}' is readonly here"
        }
        return "Cannot take \{reqKind} lock on '\{rootView}'\{reqDetail}: already has \{heldKind} lock\{heldDetail} held by '\{holderName}'"
    }

    # --- locks ---

    # Try to acquire a lock on `path` (segments; root is a variable name);
    # returns "" on success or an error message.
    tryLock: function {:this pool: zast.StringPool.view path: (List String).view lockType: ztypes.zlockstate lockScope: ztypes.zlockscope holder: ztypes.zlockholder} out String is {
        if path.length == 0 then return "".string
        rootId: zast.poolFind :pool text: (path.get i: 0).stringview
        d: this.findLocal nameId: rootId
        if d.isZero then return "".string
        if (this.isTakenDecl declId: d) then return "".string
        dv: this.typing.declLocalVarOf declId: d
        if dv.isZero then return "".string

        idempotent: false
        conflictAt: u64
        conflictFound: false
        conflictSelf: false
        ne: this.entries.length
        j: ne
        # An acquisition is checked against every outstanding lock on this
        # local. The scan never stops at the first row (an outstanding lock
        # anywhere in the body can conflict); rows over other locals -- a
        # shadowed same-named binding, another body's -- are another local's.
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == d then {
                if e.hasLock then {
                    conflict: (lockAcquireConflict
                        existingType: e.lockType
                        existingScope: e.lockScope
                        existingPath: e.lockPath
                        reqType: lockType
                        reqPath: path
                    )
                    if conflict then {
                        # the formatting method takes `this` exclusively:
                        # remember the index, format after the element
                        # view ends.
                        conflictAt = j2
                        conflictFound = true
                        conflictSelf = holderEq a: e.lockHolder b: holder
                        break
                    }
                    same: pathsEqual a: e.lockPath b: path
                    if same then {
                        eShared: e.lockType == ztypes.zlockstate.shared
                        rShared: lockType == ztypes.zlockstate.shared
                        if eShared then {
                            if rShared then idempotent = true
                        }
                    }
                }
            }
            j = j - 1
        }
        if conflictFound then {
            cType9: ztypes.zlockstate.exclusive
            cPath9: (List String)
            cHolder9: (ztypes.zlockholder kind: ztypes.zlockholderkind.varKind id: 0)
            {
                ce9: this.entries.get i: conflictAt
                cType9 = ce9.lockType
                cHolder9 = ce9.lockHolder
                with cpit9: ce9.lockPath.iterate do for cseg9: cpit9 loop {
                    csc9: cseg9.copy
                    cPath9.append csc9
                }
            }
            ck9: cHolder9.kind
            if ck9.callKind then {
                return (formatAliasConflict
                    reqPath: path
                    existingPath: cPath9
                    sameCall: conflictSelf
                )
            }
            return (this.formatLockConflict
                :pool
                reqPath: path
                reqType: lockType
                existingType: cType9
                existingPath: cPath9
                existingHolder: cHolder9
            )
        }
        if idempotent then return "".string

        le: this.reg.newEntry nameId: rootId ztypeId: ztypes.tid isDefinition: false
        le.ztypeId = this.typing.declLocalTypeOf declId: d
        ro: this.rowOf declId: d
        match (
            ro
        ) case some then {
            cur: this.entries.get i: ro
            le.ztypeId = cur.ztypeId
            le.narrowedSubtype = cur.narrowedSubtype.copy
            le.originalZtypeId = cur.originalZtypeId
            cit: cur.excludedSubtypes.iterate
            for s: cit loop {
                le.excludedSubtypes.add item: s.copy
            }
        } case none then null
        le.hasLock = true
        le.lockType = lockType
        le.lockScope = lockScope
        le.lockHolder = holder
        pli: u64
        for pli < path.length loop {
            seg: path.get i: pli
            le.lockPath.append seg.copy
            pli = pli + 1
        }
        this.appendRow row: le declId: d
        return "".string
    }

    findLock: function {:this nameId: zast.nameid} out optionval ztypes.zlockstate is {
        d: this.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.zlockstate)
        ne: this.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == d then {
                if e.hasLock then return (optionval.some e.lockType)
            }
            j = j - 1
        }
        return (optionval.none ztypes.zlockstate)
    }

    # Holder of the innermost lock on `name` (for the .release-of-locked check).
    findLockHolder: function {:this nameId: zast.nameid} out optionval ztypes.zlockholder is {
        d: this.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.zlockholder)
        ne: this.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == d then {
                if e.hasLock then return (optionval.some e.lockHolder)
            }
            j = j - 1
        }
        return (optionval.none ztypes.zlockholder)
    }

    # Holder of an EXCLUSIVE lock prefix-overlapping `path`, or none.
    findExclusiveLock: function {:this pool: zast.StringPool.view path: (List String).view} out optionval ztypes.zlockholder is {
        if path.length == 0 then return (optionval.none ztypes.zlockholder)
        rootId: zast.poolFind :pool text: (path.get i: 0).stringview
        d: this.findLocal nameId: rootId
        if d.isZero then return (optionval.none ztypes.zlockholder)
        ne: this.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == d then {
                if e.hasLock then {
                    if e.lockType == ztypes.zlockstate.exclusive then {
                        ov: pathsOverlap a: e.lockPath b: path
                        if ov then return (optionval.some e.lockHolder)
                    }
                }
            }
            j = j - 1
        }
        return (optionval.none ztypes.zlockholder)
    }

    # Holder of a SHARED lock that a write to `path` would invalidate, or none.
    # A write at or above any shared lock destroys what its holder reads. A
    # shared TARGET is a live read of its whole subtree, so a write below it is
    # blocked too; a shared INTENT is only bookkeeping toward a deeper lock,
    # which is checked on its own row.
    findReadBlocker: function {:this pool: zast.StringPool.view path: (List String).view} out optionval ztypes.zlockholder is {
        if path.length == 0 then return (optionval.none ztypes.zlockholder)
        rootId: zast.poolFind :pool text: (path.get i: 0).stringview
        d: this.findLocal nameId: rootId
        if d.isZero then return (optionval.none ztypes.zlockholder)
        ne: this.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == d then {
                if e.hasLock when e.lockType == ztypes.zlockstate.shared then {
                    blocks9: false
                    if (isPrefix p: path whole: e.lockPath) then blocks9 = true
                    if e.lockScope == ztypes.zlockscope.target then {
                        if (isPrefix p: e.lockPath whole: path) then blocks9 = true
                    }
                    if blocks9 then return (optionval.some e.lockHolder)
                }
            }
            j = j - 1
        }
        return (optionval.none ztypes.zlockholder)
    }

    # Any lock (SHARED or EXCLUSIVE) prefix-overlapping `path`?
    isPathLocked: function {:this pool: zast.StringPool.view path: (List String).view} out bool is {
        if path.length == 0 then return false
        rootId: zast.poolFind :pool text: (path.get i: 0).stringview
        d: this.findLocal nameId: rootId
        if d.isZero then return false
        ne: this.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == d then {
                if e.hasLock then {
                    ov: pathsOverlap a: e.lockPath b: path
                    if ov then return true
                }
            }
            j = j - 1
        }
        return false
    }

    # Release all locks held by `holder` (rebuild omitting them). Most
    # calls release nothing (their locks died with an inner frame), so scan
    # first and skip the rebuild when no row names the holder; when it does
    # run, the scratch list is sized once (a compile churns thousands of
    # these over row tables hundreds long -- the doubling chain was a top-5
    # allocation site).
    releaseHeldLocks: function {:this holder: ztypes.zlockholder} is {
        # Rows below the first one this holder locked keep their places;
        # the rebuild starts there.
        first9: this.entries.length
        idx9: u64
        with it9: this.entries.iterate do for e9: it9 loop {
            if e9.hasLock then {
                if (holderEq a: e9.lockHolder b: holder) then {
                    if idx9 < first9 then first9 = idx9
                }
            }
            idx9 = idx9 + 1
        }
        if first9 >= this.entries.length then return
        rev: (List ZEntry) capacity: (this.entries.length - first9)
        for this.entries.length > first9 loop rev.append this.entries.pop
        for rev.length > 0 loop {
            e: rev.pop
            drop: false
            if e.hasLock then {
                if (holderEq a: e.lockHolder b: holder) then drop = true
            }
            if (drop) == false then {
                this.entries.append e
            } else {
                this.typing.declRowsAdd declId: e.declId delta: -1
            }
        }
    }

    # --- narrowing ---

    # Narrow `name` to a subtype. shadow=true (match-arm): the row's type
    # id becomes the narrowed PAYLOAD type (null/missing payload keeps the
    # outer), and the outer is stashed in originalZtypeId for the emitter's
    # C-level unwrap. shadow=false (assignment): the type id stays the outer
    # union; only the subtype name is recorded.
    narrow: function {:this pool: zast.StringPool.view nameId: zast.nameid toTypeId: u64 subtypeName: StringView shadow: bool} is {
        d: this.findLocal :nameId
        if d.isZero then return
        curT: this.currentTypeOf declId: d
        originalTypeId: curT.u64
        entryZtype: originalTypeId
        hasSubtype: subtypeName.length > 0
        if shadow then {
            if hasSubtype then {
                if toTypeId == originalTypeId then {
                    payloadOpt: (this.typing.declChildOf
                        :pool
                        parentTypeId: (ztypes.tid.create from: originalTypeId.u64)
                        name: subtypeName
                    )
                    match (
                        payloadOpt
                    ) case some then {
                        pt: this.reg.typetypeOf typeId: (ztypes.tid.create from: payloadOpt.u64)
                        if pt != ztypes.ztypetype.nullType then entryZtype = payloadOpt
                    } case none then null
                } else {
                    # the caller passed a resolved payload (the typecheck
                    # re-resolves arm-child reference shells to real types);
                    # null payloads still keep the outer type.
                    pt2: this.reg.typetypeOf typeId: (ztypes.tid.create from: toTypeId.u64)
                    if pt2 != ztypes.ztypetype.nullType then entryZtype = toTypeId
                }
            }
        }

        nsName: String
        if hasSubtype then {
            sn: subtypeName.string
            nsName = sn
        }
        origOpt: (optionval.none ztypes.tid)
        if shadow then {
            oc: ztypes.tid.create from: originalTypeId.u64
            origOpt = (optionval.some oc)
        }

        e: (this.reg.newEntry
            :nameId
            ztypeId: (ztypes.tid.create from: entryZtype.u64)
            isDefinition: false
        )
        e.narrowedSubtype = nsName
        e.originalZtypeId = origOpt
        this.appendRow row: e declId: d
    }

    # Exclude `subtypeName` from `name`'s type. Collapses to a narrowing
    # when one excludable subtype remains; marks the frame unreachable when
    # none remain.
    exclude: function {:this pool: zast.StringPool.view nameId: zast.nameid subtypeName: StringView fullTypeId: u64} is {
        d: this.findLocal :nameId
        if d.isZero then return
        allSubs: (List String)
        (sumArmNames
            ty: this.typing
            reg: this.reg
            :pool
            tid: (ztypes.tid.create from: fullTypeId.u64)
            names: allSubs
        )

        newExcl: (Set String)
        this.collectExcluded :nameId into: newExcl
        newExcl.add item: subtypeName.string

        remainIdx: (ListVal u64)
        rn: allSubs.length
        ri: u64
        for ri < rn loop {
            nm: allSubs.get i: ri
            isExcl: newExcl.has item: nm
            if isExcl == false then {
                riv9: ri
                remainIdx.append riv9
            }
            ri = ri + 1
        }

        if remainIdx.length == 0 then {
            this.markUnreachable
        } else {
            narrowedSub: String
            if remainIdx.length == 1 then {
                soleIx9: remainIdx.get i: 0
                sole: allSubs.get i: soleIx9
                narrowedSub = sole.copy
            }
            e: (this.reg.newEntry
                :nameId
                ztypeId: (ztypes.tid.create from: fullTypeId.u64)
                isDefinition: false
            )
            e.narrowedSubtype = narrowedSub.copy
            eit: newExcl.iterate
            for s: eit loop {
                e.excludedSubtypes.add item: s.copy
            }
            this.appendRow row: e declId: d
        }
    }

    # Copy the current exclusion set for `name` into `into`.
    collectExcluded: function {:this nameId: zast.nameid into: Set String} is {
        ro: this.rowOf declId: (this.findLocal :nameId)
        match (
            ro
        ) case some then {
            e: this.entries.get i: ro
            it: e.excludedSubtypes.iterate
            for s: it loop {
                into.add item: s.copy
            }
        } case none then null
    }

    # resetNarrowing -- lay a row that restores the local's declared type.
    resetNarrowing: function {:this nameId: zast.nameid} is {
        d: this.findLocal :nameId
        if d.isZero then return
        re: (this.reg.newEntry
            :nameId
            ztypeId: (this.typing.declLocalTypeOf declId: d)
            isDefinition: false
        )
        this.appendRow row: re declId: d
    }

    isExcluded: function {:this nameId: zast.nameid subtypeName: StringView} out bool is {
        tmp: (Set String)
        this.collectExcluded :nameId into: tmp
        q: subtypeName
        return (tmp.has item: q.asString)
    }

    # narrowedArmOf -- the recorded single-arm narrowing for `name` when
    # its row still wears the OUTER type `fullTypeId` (assignment narrowing
    # or exclusion collapse). Shadow-narrowed rows (originalZtypeId set --
    # the name IS a payload) and un-narrowed locals yield "".
    narrowedArmOf: function {:this nameId: zast.nameid fullTypeId: u64} out String is {
        ro: this.rowOf declId: (this.findLocal :nameId)
        match (
            ro
        ) case some then {
            e: this.entries.get i: ro
            isShadow9: false
            oz9: e.originalZtypeId
            match (
                oz9
            ) case some then {
                isShadow9 = true
            } case none then null
            if isShadow9 then return "".string
            if e.ztypeId != fullTypeId then return "".string
            return e.narrowedSubtype.copy
        } case none then {
            return "".string
        }
    }

    # isShadowNarrowed -- the current row for `name` is a shadow narrowing
    # (the bare name IS a payload; originalZtypeId records the outer sum
    # type).
    isShadowNarrowed: function {:this nameId: zast.nameid} out bool is {
        ro: this.rowOf declId: (this.findLocal :nameId)
        match (
            ro
        ) case some then {
            e: this.entries.get i: ro
            oz9: e.originalZtypeId
            match (
                oz9
            ) case some then {
                return true
            } case none then {
                return false
            }
        } case none then {
            return false
        }
    }

    getSubtypeName: function {:this nameId: zast.nameid} out String is {
        ro: this.rowOf declId: (this.findLocal :nameId)
        match (
            ro
        ) case some then {
            e: this.entries.get i: ro
            return e.narrowedSubtype.copy
        } case none then {
            return "".string
        }
    }

    markUnreachable: function {:this} is {
        this.materialiseTop
        f: this.curFrame
        if (f.isZero) == false then this.unreachableFrames.add item: f.u64
    }

    isUnreachable: function {:this} out bool is {
        # the mark is the innermost open frame's own; one that has no row
        # yet cannot carry it
        n: this.frames.length
        if n == 0 then return false
        f: this.frames.get i: (n - 1)
        if f.isZero then return false
        return (this.unreachableFrames.has item: f.u64)
    }

    # --- utility ---

    # All defined, non-taken names inner->outer (dedup), for did-you-mean:
    # each open frame's locals in definition order, innermost frame first.
    allNames: function {:this} out ListVal u32 is {
        names: (ListVal u32)
        seen: (SetVal u32)
        cur: this.curFrame
        for cur > 0 loop {
            if (this.typing.declIsFrame declId: cur) == false then return names
            kn: this.typing.declChildSlots declId: cur
            ki: u64
            for ki < kn loop {
                kd: this.typing.declChildAt declId: cur index: ki
                nm: this.typing.declNameOf declId: kd
                ki = ki + 1
                if (seen.has item: nm) == false then {
                    if (this.isTakenDecl declId: kd) == false then {
                        names.append nm
                        seen.add item: nm
                    }
                }
            }
            cur = this.typing.declParentOf declId: cur
        }
        return names
    }

    # hasTakenRow -- has a take been laid over `declId` (whatever narrowing
    # or lock rows were laid after it)?
    hasTakenRow: function {:this declId: ztypes.declid} out bool is {
        if declId.isZero then return false
        if (this.typing.declRowsOf :declId) == 0 then return false
        ne: this.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == declId when e.isTaken then return true
            j = j - 1
        }
        return false
    }

    # Live (defined, not taken) variable names whose declared type needs a
    # destructor -- owned resources to snapshot before if/match arms. Each
    # name's liveness is decided by its innermost binding, so a take of the
    # binding in scope wins over an outer definition of the same name; a
    # narrowing laid over the binding does not hide a take under it.
    getLiveOwnedVars: function {:this} out SetVal u32 is {
        names: (SetVal u32)
        seen: (SetVal u32)
        cur: this.curFrame
        for cur > 0 loop {
            if (this.typing.declIsFrame declId: cur) == false then return names
            kn: this.typing.declChildSlots declId: cur
            ki: kn
            for ki > 0 loop {
                ki = ki - 1
                kd: this.typing.declChildAt declId: cur index: ki
                nm: this.typing.declNameOf declId: kd
                if (seen.has item: nm) == false then {
                    seen.add item: nm
                    # the take scan is the costly test: ask it last, of the
                    # few locals that are owned resources at all
                    v: this.typing.declLocalVarOf declId: kd
                    if (v.isZero) == false then {
                        dt: this.typing.declLocalTypeOf declId: kd
                        if (this.reg.hasDestructorName typeId: dt) then {
                            if (this.hasTakenRow declId: kd) == false then names.add item: nm
                        }
                    }
                }
            }
            cur = this.typing.declParentOf declId: cur
        }
        return names
    }

    # --- dump ---

    # snapshotFrame -- the frame's locals and overlay rows, in the order they
    # were laid, as dump rows. A generic template body walk is
    # diagnostics-only: its frames stay out of the dump (the emitter re-walks
    # per instance).
    snapshotFrame: function {:this frame: ztypes.declid start: u64} is {
        if (this.typing.dumpRows) == false then return
        if this.typing.suppressParamStamps then return
        kn: this.typing.declChildSlots declId: frame
        endIdx: this.entries.length
        pos: u64
        ki: u64
        ri: start
        # rows laid before the (ki+1)-th local sit before it
        for ki <= kn loop {
            for ri < endIdx loop {
                e: this.entries.get i: ri
                if e.defSeq > ki then break
                if e.frame == frame then {
                    exs: (List String)
                    with xit: e.excludedSubtypes.iterate do for xn: xit loop {
                        xnc: xn.copy
                        exs.append xnc
                    }
                    nsc: e.narrowedSubtype.copy
                    this.entryDump.append (ZEntryDumpRow
                        scopeId: frame.u64
                        position: pos
                        entryId: e.entryId
                        name: e.name
                        ztypeId: e.ztypeId
                        isDefinition: false
                        varId: (optionval.none ztypes.vid)
                        originalZtypeId: e.originalZtypeId
                        isTaken: e.isTaken
                        takenAt: e.takenAt
                        narrowedSubtype: nsc
                        excludedSubtypes: exs
                    )
                    pos = pos + 1
                }
                ri = ri + 1
            }
            if ki < kn then {
                kd: this.typing.declChildAt declId: frame index: ki
                vidOpt: (optionval.none ztypes.vid)
                v: this.typing.declLocalVarOf declId: kd
                if (v.isZero) == false then vidOpt = (optionval.some v)
                this.entryDump.append (ZEntryDumpRow
                    scopeId: frame.u64
                    position: pos
                    entryId: kd.u64
                    name: (this.typing.declNameOf declId: kd)
                    ztypeId: (this.typing.declLocalTypeOf declId: kd)
                    isDefinition: true
                    varId: vidOpt
                    originalZtypeId: (optionval.none ztypes.tid)
                    isTaken: false
                    takenAt: (optionval.none ztypes.zsrcpos)
                    narrowedSubtype: "".string
                    excludedSubtypes: (List String)
                )
                pos = pos + 1
            }
            ki = ki + 1
        }
    }
}

optStrOrEmpty: function {o: Option String} out String is {
    match (
        o
    ) case some then {
        return o.copy
    } case none then {
        return "".string
    }
}

# construct a symbol table taking ownership of the type registry and
# typing tables it will resolve against.
newSymbolTable: function {reg: ztypes.ZTypeRegistry.take typing: ZTyping.take} out ZSymbolTable is {
    return (ZSymbolTable
        frames: (ListVal ztypes.declid)
        frameStarts: (ListVal u64)
        frameDefs: (ListVal u64)
        entries: (List ZEntry)
        unreachableFrames: (SetVal u64)
        frameLabel: (MapVR u64 value: String)
        frameHidden: (SetVal u64)
        entryDump: (List ZEntryDumpRow)
        :reg
        :typing)
}

# --- smoke harness ---

# standalone entry point for the zenv smoke tests.
main: function is {
    reg: ztypes.newRegistry
    tResult: reg.newType name: "result" typetype: ztypes.ztypetype.unionType
    tOk: reg.newType name: "ok" typetype: ztypes.ztypetype.recordType
    tErr: reg.newType name: "err" typetype: ztypes.ztypetype.recordType
    tNone: reg.newType name: "none" typetype: ztypes.ztypetype.nullType
    tBuf: reg.newType name: "buf" typetype: ztypes.ztypetype.classType
    tI64: reg.newType name: "i64" typetype: ztypes.ztypetype.recordType
    pool9: zast.StringPool.create
    reg.setDestructorName typeId: tBuf nameId: (pool9.set s: "z_buf_destroy")

    ty: ztyping.newTyping
    ty.setMemberType parentTypeId: tResult nameId: (pool9.set s: "ok") childTypeId: tOk
    ty.setMemberType parentTypeId: tResult nameId: (pool9.set s: "err") childTypeId: tErr
    ty.setMemberType parentTypeId: tResult nameId: (pool9.set s: "none") childTypeId: tNone

    ty.dumpRows = true
    st: newSymbolTable :reg typing: ty

    print "=== scopes ==="
    s0: st.push name: "func"
    print "push func -> frame=\{s0} open=\{st.frames.length}"

    idX9: pool9.set s: "x"
    idY9: pool9.set s: "y"
    idMy9: pool9.set s: "MyType"
    idR9: pool9.set s: "r"

    vx: st.reg.newVariable ztypeId: tBuf ownership: ztypes.zownership.owned
    vidX: vx.variableId
    st.defineVar nameId: idX9 var: vx
    vy: st.reg.newVariable ztypeId: tI64 ownership: ztypes.zownership.owned
    st.defineVar nameId: idY9 var: vy
    st.define nameId: idMy9 ztypeId: tResult

    print "=== lookup ==="
    smokeLookup :st pool: pool9 name: "x"
    smokeLookup :st pool: pool9 name: "y"
    smokeLookup :st pool: pool9 name: "MyType"
    smokeLookup :st pool: pool9 name: "z"
    smokeVarId :st pool: pool9 name: "x"
    smokeVarId :st pool: pool9 name: "MyType"

    print "=== live owned vars ==="
    live: st.getLiveOwnedVars
    print "live has x -> \{boolText (live.has item: idX9)}"
    print "live has y -> \{boolText (live.has item: idY9)}"

    print "=== locks ==="
    px: (List String)
    px.append "x".string
    holderX: (ztypes.zlockholder kind: ztypes.zlockholderkind.varKind id: vidX)
    r1: (st.tryLock
        pool: pool9
        path: px
        lockType: ztypes.zlockstate.exclusive
        lockScope: ztypes.zlockscope.target
        holder: holderX
    )
    print "lock x EXCLUSIVE -> \{smokeErr r1.stringview}"

    px2: (List String)
    px2.append "x".string
    holderC: (ztypes.zlockholder kind: ztypes.zlockholderkind.callKind id: 99)
    r2: (st.tryLock
        pool: pool9
        path: px2
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: holderC
    )
    print "lock x SHARED -> \{smokeErr r2.stringview}"

    pxq: (List String)
    pxq.append "x".string
    print "isPathLocked x -> \{boolText (st.isPathLocked pool: pool9 path: pxq)}"
    pyq: (List String)
    pyq.append "y".string
    print "isPathLocked y -> \{boolText (st.isPathLocked pool: pool9 path: pyq)}"

    pxe: (List String)
    pxe.append "x".string
    exc: st.findExclusiveLock pool: pool9 path: pxe
    match (
        exc
    ) case some then {
        print "exclusive holder of x -> \{st.formatLockHolder pool: pool9 holder: exc}"
    } case none then {
        print "exclusive holder of x -> none"
    }
    st.releaseHeldLocks holder: holderX
    pxr: (List String)
    pxr.append "x".string
    print "isPathLocked x after release -> \{boolText (st.isPathLocked pool: pool9 path: pxr)}"
    print "findLock x after release -> \{smokeLockState (st.findLock nameId: idX9)}"

    print "=== invalidate ==="
    loc: (optionval.some (ztypes.zsrcpos fsno: zvfs.fsno lineno: 12 colno: 4))
    inv: st.invalidate nameId: idY9 :loc
    print "invalidate y -> \{boolText inv}"
    smokeLookup :st pool: pool9 name: "y"
    tl: st.getTakenLocation nameId: idY9
    match (
        tl
    ) case some then {
        print "taken y at line -> \{tl.lineno}"
    } case none then {
        print "taken y at line -> none"
    }
    st.setTakenLocation nameId: idY9 loc: (ztypes.zsrcpos fsno: zvfs.fsno lineno: 99 colno: 1)
    tl2: st.getTakenLocation nameId: idY9
    match (
        tl2
    ) case some then {
        print "taken y relocated -> \{tl2.lineno}"
    } case none then {
        print "taken y relocated -> none"
    }
    st.clearTaken nameId: idY9
    print "after clearTaken:"
    smokeLookup :st pool: pool9 name: "y"

    print "=== narrowing ==="
    vr: st.reg.newVariable ztypeId: tResult ownership: ztypes.zownership.owned
    st.defineVar nameId: idR9 var: vr
    st.narrow pool: pool9 nameId: idR9 toTypeId: tResult subtypeName: "ok" shadow: true
    smokeLookup :st pool: pool9 name: "r"
    print "subtype r -> \{st.getSubtypeName nameId: idR9}"
    st.resetNarrowing nameId: idR9
    print "after reset subtype r -> \{st.getSubtypeName nameId: idR9}"
    smokeLookup :st pool: pool9 name: "r"

    print "=== exclude ==="
    st.exclude pool: pool9 nameId: idR9 subtypeName: "ok" fullTypeId: tResult
    print "subtype r (excl ok) -> \{st.getSubtypeName nameId: idR9}"
    print "isExcluded r.ok -> \{boolText (st.isExcluded nameId: idR9 subtypeName: "ok")}"
    print "isExcluded r.err -> \{boolText (st.isExcluded nameId: idR9 subtypeName: "err")}"
    st.exclude pool: pool9 nameId: idR9 subtypeName: "none" fullTypeId: tResult
    print "subtype r (excl ok,none) -> \{st.getSubtypeName nameId: idR9}"
    print "unreachable -> \{boolText st.isUnreachable}"
    st.exclude pool: pool9 nameId: idR9 subtypeName: "err" fullTypeId: tResult
    print "unreachable after excl all -> \{boolText st.isUnreachable}"

    print "=== all names ==="
    names: st.allNames
    dumpNames pool: pool9 :names

    print "=== frames + pop ==="
    s1: st.push name: "inner"
    print "push inner -> frame=\{s1} open=\{st.frames.length}"
    st.pop
    print "after pop open=\{st.frames.length}"
    st.pop
    print "after pop open=\{st.frames.length}"
    dumpFrames :st
}

# smoke-test: an optional lock state rendered as text.
smokeLockState: function {o: optionval ztypes.zlockstate} out String is {
    match (
        o
    ) case some then {
        return (ztypes.zlockstateName o)
    } case none then {
        return "none".string
    }
}

# smoke-test: print the lookup result for `name`.
smokeLookup: function {st: ZSymbolTable pool: zast.StringPool.view name: StringView} is {
    r: st.lookup nameId: (zast.poolFind :pool text: name)
    print "lookup \{name} -> \{optTidText r}"
}

# smoke-test: print the variable id bound to `name`.
smokeVarId: function {st: ZSymbolTable pool: zast.StringPool.view name: StringView} is {
    r: st.lookupVarId nameId: (zast.poolFind :pool text: name)
    print "varId \{name} -> \{optVidText9 r}"
}

# smoke-test: format an error string.
smokeErr: function {s: StringView} out String is {
    if s.length == 0 then return "ok".string
    return s.string
}

# smoke-test: print a list of names.
dumpNames: function {pool: zast.StringPool.view names: (ListVal u32).view} is {
    iter: names.iterate
    for nm: iter loop {
        nt9: zast.poolTextAt :pool ref: (zast.nameid.create from: nm.u32)
        print "  name \{nt9}"
    }
}

# smoke-test: print the frames the walk left behind and the dump rows.
dumpFrames: function {st: ZSymbolTable} is {
    n: st.typing.decls.length
    k: u64
    for k < n loop {
        d: ztypes.declid.create from: k
        k = k + 1
        if (st.typing.declIsFrame declId: d) then {
            lbl: copiedLabel :st frame: d
            print "  frame=\{d} parent=\{st.typing.declParentOf declId: d} label=\{lbl} locals=\{st.typing.declChildSlots declId: d}"
        }
    }
    with dit: st.entryDump.iterate do for row: dit loop {
        print "  row scope=\{row.scopeId} pos=\{row.position} name=\{row.name} def=\{boolText row.isDefinition} taken=\{boolText row.isTaken}"
    }
}

# smoke-test: a frame's dump label, "" when unlabelled.
copiedLabel: function {st: ZSymbolTable frame: ztypes.declid} out String is {
    o: st.frameLabel.get key: frame.u64
    match (
        o
    ) case some then {
        return o.copy
    } case none then {
        return "".string
    }
}
