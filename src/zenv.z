# ZeroLang body-walk environment for the type checker.
#
# Scopes and locals are declarations in the typing's Decl tree -- a scope is a
# scopeDecl under the scope or declaration enclosing it, a local a localDecl
# under the scope it is written in -- so they persist and can be returned to.
# The table holds the walk's state over them: the open scopes (a stack of ids,
# innermost last), the overlay rows the walk lays over locals (a take, a
# narrowing, a lock), which die with the scope that laid them, the scopes whose
# remainder the walk found unreachable, and the rows snapshotted for the dump
# when a scope closes.
#
# `this.entries` -- the overlay rows -- is reached through a borrowed
# receiver, so `List.get` yields a COPY: fine to read, but a mutation written
# back with `List.set` frees heap fields the copy still aliases. Every mutation
# therefore goes through `append` / `pop` on the field list directly (which
# persist without copying).
#
# A row stores a u64 type id (never a live type); type metadata is read
# through the owned registry (`this.reg`) and declarations, member edges and
# locals through the typecheck-output container (`this.typing`).

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :ZSymbolTable
    :ValueDraft
    :openpos
    :divkind
    :sumArmNames
    :sumArmNameIds
    :isImplementationLabelOf
    :newSymbolTable
    :formatPath
    :pathsEqual
    :zlockstateNameLower
}

ZVariable: ztypes.ZVariable
ZEntry: ztypes.ZEntry
ZTyping: ztyping.ZTyping


# A lock path is the dotted path of a value as name ids: the root local's
# name, then each field read off it.

# Two lock paths are equal iff same length and every segment matches.
pathsEqual: function {a: ListViewVal zast.nameid b: ListViewVal zast.nameid} out bool is {
    if a.length != b.length then return false
    n: a.length
    i: u64
    for i < n loop {
        if (a.get :i) != (b.get :i) then return false
        i = i + 1
    }
    return true
}

# True iff `p` is a (non-strict) prefix of `whole`.
isPrefix: function {p: ListViewVal zast.nameid whole: ListViewVal zast.nameid} out bool is {
    pn: p.length
    if pn > whole.length then return false
    i: u64
    for i < pn loop {
        if (p.get :i) != (whole.get :i) then return false
        i = i + 1
    }
    return true
}

# Two paths overlap iff one is a (non-strict) prefix of the other:
# compare the shared leading run.
pathsOverlap: function {a: ListViewVal zast.nameid b: ListViewVal zast.nameid} out bool is {
    n: a.length
    if b.length < n then n = b.length
    i: u64
    for i < n loop {
        if (a.get :i) != (b.get :i) then return false
        i = i + 1
    }
    return true
}

# true when two lock holders are the same.
holderEq: function {a: ztypes.zlockholder b: ztypes.zlockholder} out bool is {
    return a == b
}

# Multi-granularity conflict for a NEW lock acquisition. Both paths share
# the same root (caller filters by entry name). Same path: conflict iff
# either side is EXCLUSIVE. Strict-ancestor existing: conflict iff that
# ancestor is EXCLUSIVE, or is a SHARED TARGET and the request is EXCLUSIVE --
# a live read of a subtree excludes a writer below it, while a SHARED INTENT
# prefix permits the deeper lock it was taken for. Strict-ancestor requested:
# conflict iff the request is EXCLUSIVE, or is a SHARED TARGET over a leaf a
# VARIABLE holds EXCLUSIVE -- reading the whole subtree reads what that
# holder may be writing through its pin, while an INTENT prefix is only the
# step toward a sibling. Siblings never conflict.
lockAcquireConflict: function {
    existingType: ztypes.zlockstate
    existingScope: ztypes.zlockscope
    existingPath: ListViewVal zast.nameid
    # the outstanding lock is a VARIABLE's pin rather than a call's
    existingVarHeld: bool
    reqType: ztypes.zlockstate
    # the requested lock is a TARGET (a live use) or an INTENT prefix
    reqScope: ztypes.zlockscope
    reqPath: ListViewVal zast.nameid
} out bool is {
    eq: pathsEqual a: existingPath b: reqPath
    if eq then {
        return (
            (existingType == ztypes.zlockstate.exclusive) or
            (
                reqType == ztypes.zlockstate.exclusive
            )
        )
    }
    eLen: existingPath.length
    rLen: reqPath.length
    if eLen < rLen then {
        anc: isPrefix p: existingPath whole: reqPath
        if anc then {
            if existingType == ztypes.zlockstate.exclusive then return true
            if existingScope == ztypes.zlockscope.target then {
                return reqType == ztypes.zlockstate.exclusive
            }
            return false
        }
    }
    if rLen < eLen then {
        isAncestor: isPrefix p: reqPath whole: existingPath
        if isAncestor then {
            if reqType == ztypes.zlockstate.exclusive then return true
            if reqScope == ztypes.zlockscope.target when existingVarHeld then {
                return existingType == ztypes.zlockstate.exclusive
            }
            return false
        }
    }
    return false
}

# A subtype participates in exclusion narrowing only if it is a real
# data-bearing arm (not a function / tag / enum member).
isExcludableKind: function {k: ztypes.ztypetype} out bool is {
    return ((k == ztypes.ztypetype.functionType) or (k == ztypes.ztypetype.tagType)).not
}

# isImplementationLabelOf -- member `nameId` of `tid` is an implementation marker's
# label: a row of the type's own, or of the generic template it is an instance
# of, whose marker holds for every instance.
isImplementationLabelOf: function {
    ty: ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
    nameId: zast.nameid
} out bool is {
    if (ty.isImplementationLabel implTid: tid :nameId) then return true
    og: reg.genericOriginOf :tid
    if og.isZero then return false
    return (ty.isImplementationLabel implTid: og :nameId)
}

# sumArmNameIds -- the same arms as sumArmNames, left as name-pool ids. The
# exclusion machinery compares arms, and an id compares without rendering the
# text or owning a copy of it.
sumArmNameIds: function {
    ty: ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
    ids: ListVal zast.nameid
} is {
    # a partial carries no rows of its own: its template's arms are its arms
    ot8: tid
    if (reg.isPartialOf :tid) then {
        po8: reg.genericOriginOf :tid
        if po8.isZero.not then ot8 = po8
    }
    i8: u64
    n8: ty.declRowSlots ownerTid: ot8
    for i8 < n8 loop {
        r8: ty.declRowAt ownerTid: ot8 membersOnly: true slot: i8
        i8 = i8 + 1
        if r8.keep then {
            armTid: r8.tid
            # an implementation marker is a member of its type but no arm of it
            if (isExcludableKind k: (reg.typetypeOf typeId: armTid)) when (
                reg.isTagGenericOriginOf
                typeId: armTid
            ).not when (isImplementationLabelOf :ty :reg tid: ot8 nameId: r8.name
            ).not then ids.append r8.name
        }
    }
}

# sumArmNames -- sumArmNameIds as texts, for the readers that spell an arm
# (the checker's sumSubtypeNames, the emitter's remainingArm). Routes through
# the id walk, so the two cannot disagree about the arm set.
sumArmNames: function {
    ty: ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    pool: zast.StringPool.view
    tid: ztypes.tid
    names: List String
} is {
    ids: ListVal zast.nameid
    sumArmNameIds :ty :reg :tid :ids
    i: u64
    n: ids.length
    for i < n loop {
        nb: pool.texts.get i: (ids.get :i)
        names.append nb.copy
        i = i + 1
    }
}

# the lower-case display name of lock state `t` (for diagnostics).
zlockstateNameLower: function {t: ztypes.zlockstate} out String is {
    match (
        t
    ) case exclusive then {
        return "exclusive".string
    } case shared then {
        return "shared".string
    }
}

# a path rendered as a dotted "a.b.c" string.
formatPath: function {pool: zast.StringPool.view path: ListViewVal zast.nameid} out String is {
    if path.length == 0 then return "<unknown>".string
    r: String
    i: u64
    for i < path.length loop {
        if i > 0 then r.append "."
        r.append (zast.poolTextAt :pool ref: (path.get :i))
        i = i + 1
    }
    return r
}

# Two locks taken while processing calls conflict: one value passed by
# reference -- a reftype, or a valtype by pointer -- reached twice as an argument
# or a receiver. A call identity is not user-visible, so the message
# names the paths instead of the holder.
formatAliasConflict: function {
    pool: zast.StringPool.view
    reqPath: ListViewVal zast.nameid
    existingPath: ListViewVal zast.nameid
    sameCall: bool
} out String is {
    rp: formatPath :pool path: reqPath
    ep: formatPath :pool path: existingPath
    if (pathsEqual a: reqPath b: existingPath) then {
        if sameCall then return "Cannot pass '\{rp}' twice in one call — a value passed by reference may appear only once as an argument or as a receiver"
        return "Cannot pass '\{rp}': it is already passed to an enclosing call"
    }
    if reqPath.length < existingPath.length then {
        return "Cannot pass both '\{rp}' and '\{ep}' in one call — '\{ep}' is inside '\{rp}'; a value passed by reference may appear only once as an argument or as a receiver"
    }
    return "Cannot pass both '\{ep}' and '\{rp}' in one call — '\{rp}' is inside '\{ep}'; a value passed by reference may appear only once as an argument or as a receiver"
}

# --- carriers ---

# openpos -- a scope's position in `open`, the stack of open scopes: 0 is the
# outermost. Every marker of the body walk is one -- what popTo closes back
# through, where an exit unwinds to, the scope a loop, `break` or function body
# owns. A typedef so a position cannot cross with a depth, a count or an id.
openpos: typedef u64

# A row of the dump's `entry` table: a local of a scope, or an overlay row
# laid over one, snapshotted when the scope closed. `position` is the row's
# place among the scope's locals and overlays in the order they were laid.
# exitrec -- an exit recordExitDestroy saw: a `return`, `break` or `continue`.
# A local bound after it into a scope it leaves must join it (addToExitsLeaving).
exitrec: record {
    exit: zast.nodeid
    # the position in `open` the exit unwinds to: it leaves every scope from
    # there up
    downTo: openpos
    # the id the next variable minted after the exit was recorded took
    vidMark: ztypes.vid
}

# openscope -- one open scope of the body walk: its Decl row (0 while a lazy
# scope has declared nothing), the scope it hangs under, the overlay index
# where its rows begin, and how many locals it has defined (a row's defSeq).
openscope: record {
    # the scope's own declaration
    id: ztypes.declid
    # the scope it was opened inside
    parent: ztypes.declid
    # the node whose evaluation the scope brackets -- a function body, a block,
    # an arm, a loop, a call -- or zero for a bracket the checker opens for
    # itself, which no C block closes
    node: zast.nodeid
    # the entry index the scope began at, which is what popping restores to
    start: u64
    # how many definitions it has taken so far
    defs: u64
    # the id the next variable minted after the scope opened took: a variable
    # with a smaller id was bound before it, in an enclosing scope
    firstVid: ztypes.vid
    # every path out of the scope that reaches the code after it ran all of it:
    # a `do` block no `break` left. A refill it made is then made on every path
    unconditional: bool
    # the scope runs on some paths only -- an arm, a loop's body, a `do` block
    # a `break` left: a lock it released from a scope outside it is released
    # on its path alone, and laid again when it closes (markPath)
    path: bool
    # where the releases it made begin in the table's releasedRows
    relMark: u64
}

# one scope entry, flattened for the SQL dump. It is a snapshot: entries are
# popped as scopes close, so the dump keeps its own copy rather than reading
# the live table
ZEntryDumpRow: class {
    # the scope the entry belonged to
    scopeId: ztypes.declid
    # where it sat in that scope, which shadowing resolves by
    position: u64
    # the local the row is about, on a definition row and an overlay row alike
    declId: ztypes.declid
    # an overlay row's own id (ZEntry.entryId), zero on a definition row: a
    # definition is the declaration itself, which has no overlay
    overlayId: ztypes.entryid
    # its name, as a pool id
    name: zast.nameid
    # its type at the moment of the snapshot, narrowing included
    ztypeId: ztypes.tid
    # whether it defines the name or merely refers to it
    isDefinition: bool
    # the runtime variable behind it, where there is one
    varId: optionval ztypes.vid
    # the type before narrowing, so the dump shows both
    originalZtypeId: optionval ztypes.tid
    # whether ownership had moved out by then
    isTaken: bool
    # where it was taken, so the dump can point at the transfer
    takenAt: optionval ztypes.zsrcpos
    # the arm it was narrowed to, 0 for none
    narrowedSubtype: zast.nameid
    # the arms ruled out by diverging guards
    excludedSubtypes: ListVal zast.nameid
}

# queuedarglock -- the lock one argument of a call holds for the call's
# duration, asked for while the call's arguments are walked. A call's pins start
# when the call starts, after every argument is evaluated: a call nested in a
# later argument has finished by then, so it never meets them. The checker lays
# the queue once the argument walk ends (layArgLocks).
queuedarglock: record {
    # the call that holds the lock
    callId: zast.nodeid
    # the local the path is rooted at, as the argument resolved it
    declId: ztypes.declid
    # the path, root first, as the range [segFrom, segTo) of the table's
    # argLockSegs: one segment for a bare name
    segFrom: u64
    segTo: u64
    # a field path (lockCallArgPath) rather than a bare name (lockCallArg)
    isPath: bool
    # the strength asked for
    shared: bool
    # the callee may write through the reference
    mutable: bool
    # where the argument is, for the report
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
}

# ValueDraft -- what the value whose walk is running keeps locked so far.
# checkValueAt gives each value node a draft of its own and records it
# (recordDraft); a value composed from a child reads the child's record.
ValueDraft: class {
    # the locks the value keeps on its inputs (an `outx` result, a reference
    # return, a moved-in value's carried ones), each at its own strength
    pins: List ztyping.PinPath
    # the marker on the return the value came from. `.view`: the binding it
    # lands on is READONLY as well as pinned. `.hold`: the binding is READONLY
    # while staying OWNED -- a property of the value, not of a reference
    marker: ztypes.zparamownership
    # the value is OWNED though it pins its sources (an owned `outx` result):
    # its binding carries a destructor and may be moved, where the pin alone
    # would make it a borrow
    owned: bool
} as {
    # holds -- the draft has a pin, or a flag about its value.
    holds: function {d: this.view} out bool is {
        if d.pins.length > 0 then return true
        if d.owned then return true
        return d.marker != ztypes.zparamownership.noneMode
    }

    # clear -- the draft holds nothing: no pin, no flag.
    clear: function {:this} is {
        for this.pins.length > 0 loop this.pins.pop
        this.marker = ztypes.zparamownership.noneMode
        this.owned = false
    }

    # dropPins -- the draft's pins go; what describes the value stays.
    dropPins: function {:this} is {
        for this.pins.length > 0 loop this.pins.pop
    }
}

# heldlock -- one lock row's strength and holder, read off the overlay.
heldlock: record {
    # the lock's strength
    state: ztypes.zlockstate
    # who holds it
    holder: ztypes.zlockholder
}

# pinjournal -- a value-pin record a dry run wrote over: its node and what the
# node held before (an empty run when it held nothing).
pinjournal: record {
    # the value's node
    nid: zast.nodeid
    # its record before the write
    was: ztyping.valuepins
}

# pinmark -- where a dry run began: the value-pin arena's length and the
# journal's.
pinmark: record {
    # the arena length
    arena: u64
    # the journal length
    journal: u64
}

# WalkState -- the body walk's working state: what the checker records while
# it walks and reads back itself. Nothing downstream reads it; the output is
# ZTyping's.
WalkState: class {
    # the next synthesised name's number, so two temps never collide
    nextTempId: u64
    # the temporaries a result may keep past the call scope they were bound in,
    # by name, with their variable: an owned argument temp a pinning call's
    # result keeps locked, and a receiver's temp (a value's own storage, whose
    # view the call's arguments may carry out). Once the call's own scope has
    # popped, one a result keeps is defined again -- the same variable -- as an
    # unnamed local of the enclosing scope, so the lock has something to name
    adoptableTemps: (IdMapV zast.nameid v: ztypes.vid)
    # the argument temps by VARIABLE, while they still await that second
    # definition. A TEMPORARY HAS ONE DEATH: the call's own scope must not list
    # one its result keeps locked, because the pin makes it outlive the call and
    # the adopting scope lists it instead. Cleared as each is adopted, so exactly
    # one scope ever names it. A receiver's temp is known to escape only once the
    # call has popped: the popped scope listed it, and adoption retires that
    # listing (retireTempListing).
    pinnedTempPending: (IdMapV ztypes.vid v: bool)
    # the unnamed locals the statement line being walked has made, by name:
    # read, and dropped, when the line ends
    lineUnnamedLocals: ListVal zast.nameid
    # the label the current synthesis is running under, for diagnostics about a
    # node no one wrote
    synthLabel: String
    # the same (unit, definition) pair synthLabel SPELLS, carried as ids. The
    # label is a dump row; the pair is what checkCase resolves a bare
    # `match t` subject against, and a spelled pair had to be split back apart
    # and re-resolved by name to get here.
    synthOwnerUnit: ztypes.declid
    # the definition the current synthesis belongs to
    synthOwnerName: zast.nameid
    # the receiver type in scope, which is what `this` and a bare member name
    # resolve against
    currentThisTid: ztypes.tid
    # the tid of the FUNCTION whose body is being walked, beside the receiver
    # type above. Together they answer "which member of which type am I in",
    # which `currentThisTid` alone cannot: every method of a type shares it.
    # Zero for a generic mono instance walk, which has no declaration of its
    # own to name.
    currentFnTid: ztypes.tid
    # the marker on the return of the fn whose body is being walked. A
    # reference return (`.borrow`, `.view`) makes bare field returns its
    # contract (the lock/borrow source outlives); what a `.view` lends is
    # readonly, so a readonly source is its contract, not a conversion
    currentReturnMarker: ztypes.zparamownership
    # the fn whose body is being walked is `outx`: a construction it returns
    # may fill a non-owned field only from a borrow/view parameter
    currentFnPins: bool
    # the fn whose body is being walked declares no `out` type, so a `return`
    # in it carries no value
    currentReturnsNothing: bool
    # what the value whose walk is running keeps locked so far (ValueDraft)
    draft: ValueDraft
    # the node of the call argument being typed (0 outside one): a reftype
    # argument is judged by the lock the call takes on it, not by the
    # field-read rule
    callArgNode: zast.nodeid
    # namespace / subunit bodies the demand path owes a walk, and the unit
    # ops already walked -- a subunit of the MAIN unit is walked by the main
    # tree walk and must not be walked twice.
    nsBodiesOwed: ListVal ztyping.nsbody
    # the unit bodies already walked, so a demand-driven walk does not repeat
    # one
    nsBodiesWalked: IdSet zast.nodeid
    # the unit ops whose constant definitions have been materialised, so a
    # namespace reached twice -- once as a demanded definition, once as an
    # alias target -- evaluates and reports them once
    nsConstsWalked: IdSet zast.nodeid
    # the computed constant definitions already asked why they have no value.
    # Both constant doors ask, and asking can demand another definition whose
    # own asking demands this one back, so each is asked once
    constsDiagnosed: IdSet zast.nodeid
    # the (instance, name) pairs of the template constants over a numeric
    # parameter that an instance has folded and asked why (foldInstanceConstant)
    instanceConstsChecked: SetVal ztyping.constslot
    # the unit-level nodes whose shape -- a member, a call's arguments, an
    # operator -- was reported as a body would report it: the evaluator's own
    # reason for the same node is not the one to show
    constShapesReported: IdSet zast.nodeid
    # the numeric generic arguments refused as no compile-time integer, by
    # argument node: the type-reference shell the refusal leaves behind is not a
    # second mistake to report
    numericArgsRefused: IdSet zast.nodeid
    # the unit a QUALIFIED generic bound names (`io` in `io.Reader.generic`),
    # by the bound atom's node: the bound resolves in that unit and nowhere else
    genericBoundQual: (IdMapV zast.nodeid v: zast.nameid)
    # the untyped integers outside i64, and the untyped floats past f64 --
    # a literal or a fold of them -- each by its node and the mono whose walk
    # evaluated it: one lands in its default unless an untyped fold consumes
    # it or a typed destination takes it, which wideConstTaken records and
    # checkWideConstants settles after the walk
    wideConsts: ListVal ztyping.monostamp
    # the wide untyped integers something took: 1 an untyped fold consumed it
    # as an operand, 2 a typed destination took it
    wideConstTaken: (MapVV ztyping.monostamp v: u8)
    # the nodes the walk folded to a data value, each with the mono whose walk
    # it was: one no fold consumed (wideConstTaken) is a run-time use, and
    # markAggsReached marks its value reached after the walk
    aggUses: ListVal ztyping.monostamp
    # the `upto` / `downto` calls, each by its node and the mono whose walk
    # checked it: a closed range whose two ends fold is refused after the walk
    # when it holds more values than its trip count can (checkClosedRangeSpans)
    closedRanges: ListVal ztyping.monostamp
    # the type applications, by node, that name their type rather than build a
    # value of it: the callable of a call supplying the fields (`(Box cap: 8)
    # used: "x"`) and the base of a member path (`(slot t: i64).empty`)
    typeAppsNamed: IdSet zast.nodeid
    # a parameter of a unit instance's copy of a function, by its declaration,
    # whose template's parameter was refused where it is written for naming a
    # numeric generic parameter: a call asks no argument for it, as for the
    # template's (memberRefusedForNumericParam)
    refusedParamCopies: IdSet ztypes.declid
    # a dotted type-ref that names a numeric generic parameter through what its
    # parent names, by its node: the type it was resolved to once
    # (numericParamTyperef)
    singletonPaths: (IdMapV zast.nodeid v: ztypes.tid)
    # a construction whose numeric generic argument reads a parameter of the
    # template the walk is in, walked without an instance: the partial type the
    # template walk gives it, by the construction's node. Each instance's walk
    # mints the concrete one
    valuePartialAt: (IdMapV zast.nodeid v: ztypes.tid)
    # set while a construction's arguments are read, when one depends on an
    # enclosing numeric generic parameter the walk has no value for
    numericArgDependent: bool
    # the generic template ops whose method bodies have been scanned for
    # demands from the template's own scope (once per template)
    templateBodiesScanned: IdSet zast.nodeid
    # the instances the post-sweep has visited: the sweep repeats while walks
    # mint new instances or owe an instance member, and an instance is asked
    # whether instantiating it ends on its first visit only
    monosWalked: IdSet ztypes.tid
    # a use reached an instance member of an author-declared generic type
    # that no instance walk has walked: the instance sweep owes another round
    instanceUseOwed: bool
    # the instance whose walk minted each type id (instances minted outside
    # the post-sweep have no entry)
    monoMintedBy: (IdMapV ztypes.tid v: ztypes.tid)
    # the templates reported as instantiating themselves without end
    monoRecursionReported: IdSet ztypes.tid
    # the function bodies whose own check, outside an instance walk, reported
    # an error: an instance walk of one would only report it again
    refusedBodies: IdSet zast.nodeid
    # the instances a generic call made from arguments it refused, true until
    # a call that refused none reaches one: a walk of one would only repeat
    # the refusal inside it
    refusedInstances: (IdMapV ztypes.tid v: bool)
    # the errors the function-body checks under way have charged so far: a
    # body is charged only the errors its own lines raised (checkFunctionBody)
    bodyErrorsCharged: u64
    # unnamed locals a binding held when their line ended, until a `.drop`
    # releases the last hold
    heldTemps: ListVal zast.nameid
    # the generic parameter to type-argument substitution in force for the
    # instantiation being walked
    monoParamSubst: (IdMapV ztypes.tid v: ztypes.tid)
    # the instantiation a constant is being evaluated for, when it is read
    # through one (`a.BIG` on a unit instance); 0 otherwise. A template's
    # constant over a numeric generic parameter has a value per instantiation
    constMono: ztypes.tid
    # the function type being walked inside that instantiation
    curMonoFnTid: ztypes.tid
    # true once any member has been marked private (gates cross-unit checks)
    privacySeen: bool
    # the names choices are declared under: a call builds a choice value only
    # when its head names one, so no other head's type is resolved to ask
    choiceNames: IdSet zast.nameid
    # a compile-time `match` arm's narrowing, innermost last: inside the arm a
    # choice value's subject name reads the value its arm carries
    constNarrows: ListVal ztyping.constnarrow
    # boxedArms -- the union arms written `(Box T)`, or whose instance's
    # argument is a Box, by armKey: a heap cell whatever the payload's size
    boxedArms: SetVal ztyping.armkey
    # types synthesised to carry a generator's state
    generatorWrapper: (IdMapV zast.nodeid v: bool)
    # nodes deliberately left unstamped, so a later pass does not read absence
    # as an error
    noStampNode: (IdMapV zast.nodeid v: bool)
    # FUNCTION tid -> the definition carries a body (a bodyless spec is false)
    fnHasBody: (IdMapV ztypes.tid v: bool)
    # the generic template (its DeclId) whose signature is being
    # registered: its param names are not unit typerefs
    sigGenericDecl: ztypes.declid
    # the function whose signature is being resolved: its parameters are in
    # scope there, so a type-ref in it naming one finds the parameter
    sigFnNode: zast.nodeid
    # that function's name, for the refusal
    sigFnName: zast.nameid
    # the dotted node currently being walked as a CALL'S CALLABLE, 0 outside
    # one. `Type.arm` is the same path whether an argument follows it or not,
    # so the arm read cannot tell a construction from a bare read on its own
    # -- this is what says an argument is coming.
    calleeDottedNid: zast.nodeid
    # the part that leaves a type with no generated `==`, or zero when it has
    # one: asked at every generated comparison, answered once per type
    valEqMissing: (IdMapV ztypes.tid v: ztypes.tid)
    # every type a hashable bound admitted as a key, of either family: its
    # `hash` and `==` are checked against the key spec once members resolve
    hashKeys: IdSet ztypes.tid
    # the value node of the `for each` header being walked: a callable object
    # there whose type declares `iterate` is walked through it, not called
    eachSubjectNid: zast.nodeid
    # the type owning a default not yet resolvable
    pendingDefaultOwner: (IdMapV zast.nodeid v: ztypes.tid)
    # the type of the member that default names, which the construction fill
    # stamps on the default's node
    pendingDefaultId: (IdMapV zast.nodeid v: ztypes.tid)
    # its name, interned
    pendingDefaultName: (IdMapV zast.nodeid v: zast.nameid)
    # types some site actually constructs, which is what makes construction a
    # DEMAND the emitter must satisfy
    constructedTypes: (IdMapV ztypes.tid v: bool)
    # collections whose child types have been minted, so minting runs once
    # the type-ref nodes written as a bare name in a type position -- not an
    # application's head -- which name a generic type's defaults' instance
    bareTyperefNodes: IdSet zast.nodeid
    collectionChildrenBuilt: IdSet ztypes.tid
    # what each checked value keeps locked, by the value's node: an
    # append-only arena of pins, the variable each pin's root named where the
    # value was made, and each node's run of the arena (pinsOfValue)
    valuePins: List ztyping.PinPath
    valuePinRoots: ListVal ztypes.vid
    pinsAt: (IdMapV zast.nodeid v: ztyping.valuepins)
    # the locks each hoisted argument temporary laid, a run of valuePins by its
    # variable: an `outx` result that keeps the temporary adopts it, and the
    # temporary lays them again where it now lives
    tempPins: (IdMapV ztypes.vid v: ztyping.valuepins)
    # a dry run's record writes, newest last, each with the record its node
    # held before, and per open dry run the arena and journal lengths at its
    # start: popDiscard puts every record back
    pinsJournal: ListVal pinjournal
    pinMarks: ListVal pinmark
    # the blocks whose last line's value nothing receives: a function body, and
    # the arms and bodies of an `if`, `match`, loop, `do` or `with` written as a
    # statement
    stmtBlocks: IdSet zast.nodeid
    # the declarations whose call-shaped value instantiatedAliasFold is resolving
    # right now, innermost last: a value that names its own definition (`foo:
    # bar foo`) re-enters it, and is answered as a constant instead, whose
    # channel reports the cycle
    aliasFoldsOpen: ListVal ztypes.declid
    # the declarations already reported as defined in terms of themselves
    aliasCyclesReported: IdSet ztypes.declid
    # the unit-level definitions whose value instantiates a generic template
    # (`Strs: (List String)`): each names that instance, a type. A call-shaped
    # constant (`AT: G.indexOf "#"`) is a value, whatever type it has
    instantiatedAliases: IdSet ztypes.declid
    # the checker's own temporaries: the emitter still decides WHEN each one
    # dies, so `scopeDestroy` does not list them (ownsDestroy). What a scope
    # would destroy if it did is recorded separately, below.
    tempVars: IdSet ztypes.vid
    # the NAME of the temporary a value node is held in, beside `tempOf`'s
    # variable: a second mint for the same node must reuse the first, and a
    # name is what its callers hand on
    tempNameOf: (IdMapV zast.nodeid v: zast.nameid)
    # the generator class whose `call` body is being walked, 0 outside one. A
    # suspending loop or `with` inside it saves what it holds in a C local to
    # a field of this class across each suspension, and the walk is what
    # knows the field's type
    currentGenTid: ztypes.tid
    # the next ordinal for a field minted on currentGenTid, so two loops in
    # one body never share a slot
    genSpillNext: u64
    # evaluation state per memberConst key: 0 unvisited, 1 evaluating, 2 done.
    # Constants are not written in dependency order, so the evaluator pulls
    # rather than pushes and this is its cycle guard.
    constEvalState: (MapVV ztyping.constslot v: u8)
    # each list-sourced tag's list, by its declaration, which a report names
    tagSourceDecls: (IdMapV ztypes.tid v: ztypes.declid)
    # the type-ref nodes in a static position, where a literal type may be
    # written: a list's `out` arguments (`out (staticlist intliteral)`) and a
    # data type's field types. A declared type may not name one anywhere else
    staticLiteralTyperefs: IdSet zast.nodeid
    # the pending evaluation failure, recorded by the evaluator and rendered by
    # whichever caller REQUIRED a value. One slot, not a table: evaluation is a
    # synchronous recursive pull, so at most one is live, and the caller either
    # drains it or clears it before the next pull.
    constFail: ztypes.constfail
    # every value placed where a spec value is expected, checked at the end
    specStandIns: ListVal ztyping.specstandin
    # each instance's first instantiating call, which its errors name
    monoSite: (IdMapV ztypes.tid v: ztyping.monosite)
    # each generic typedef instance whose base refuses its argument
    typedefClash: (IdMapV ztypes.tid v: ztyping.typedefclash)
    # a generic parameter's BOUND, as (atom node -> the name it spells) and the
    # scope to resolve it in. Recorded where the parameter is registered -- the
    # bound is read as TEXT there and mapped to a constraint kind, never as a
    # type-ref -- and resolved once at the end, for TOOLING only: an unresolved
    # one is silent, and nothing here reaches the emitter.
    genericBoundName: (IdMapV zast.nodeid v: zast.nameid)
    # the scope a generic bound resolves in, which is where it was WRITTEN and
    # not where it is used
    genericBoundScope: (IdMapV zast.nodeid v: ztypes.declid)
    # a generic parameter, as (node -> the name it spells) and the scope to
    # resolve it in. Recorded at the parameter's declaration and at every type
    # position that resolves to one: a generic parameter lives outside the
    # name-resolution table, so nothing else records what its atom means, and
    # `newType ... genericParam` mints the type with no declaration -- the tid
    # cannot answer for its declaration either. Resolved once at the end, for
    # TOOLING only.
    genericParamName: (IdMapV zast.nodeid v: zast.nameid)
    # the scope a generic parameter belongs to
    genericParamScope: (IdMapV zast.nodeid v: ztypes.declid)
    # the node id of the expression that IS the statement being checked, or 0.
    # `.drop` ends a lifetime and produces nothing, so it is legal only there --
    # this is what tells `y: x.drop` from `x.drop`. astnode ids are unique, so a
    # stale value can never wrongly permit one.
    stmtExprNid: zast.nodeid
    # the statement being walked -- its node, line and column -- or 0 outside a
    # body: where a bound an instance's argument does not meet is reported when
    # the instance is minted with no position of its own
    boundSiteNid: zast.nodeid
    boundSiteLine: u32
    boundSiteCol: u32
    # the argument type whose unmet bound was reported at that statement: the
    # instances minted as its members (a list's view and iterator) fail over
    # the same argument, and are not reported again
    boundSiteFailArg: ztypes.tid
    # every unmet bound reported so far: one error per refused instance
    unmetBounds: ListVal ztyping.unmetbound
    # the node id of the value a binding takes whole, or 0. An `if` or a
    # `match` there is emitted as statements assigning the local, so an arm of
    # it may leave; one anywhere else inside an expression may not.
    formValueNid: zast.nodeid
    # the node id of the value a destination that owns what it holds is walking
    # (a taking or held parameter, an owned field, a sum arm, a return, a
    # yield, a reassignment), or 0. An unmarked projection there takes its
    # source; anywhere else it borrows it.
    owningValueNid: zast.nodeid
    # true once indexUnitDefs has populated the node finder; descent is gated
    # off before then (generator lowering runs pre-index).
    defNodeIndexBuilt: bool
    # the types whose `as` block strikes `create` off with `null`: they construct in
    # no spelling
    createOptOut: IdSet ztypes.tid
    # a data type's fields as its constructions read them -- in dataFieldIds'
    # order, each with its static verdict and folded default -- computed on the
    # first construction of the type and kept: fieldSpans finds a type's run
    # of rows in fieldRows
    fieldSpans: (IdMapV ztypes.tid v: ztyping.fieldspan)
    # the thread unit's declaration: its markers say what may not cross to
    # another thread and which protocols' values a call hands across
    threadUnitRoot: ztypes.declid
    # each argument a call hands to another thread (a parameter typed or
    # bounded by a `thread.Crossing` protocol), to the callee: a lock the
    # argument carries is refused in a thread's words
    crossingArgCallee: (IdMapV zast.nodeid v: ztypes.tid)
    # one-shot guard: the native link-target descend runs once per program
    # type-ref node id -> base type name; resolved to its real type post-demand
    pendingTyperef: (IdMapV zast.nodeid v: zast.nameid)
    # the environment scope the type-ref was written in (curScope at record
    # time), so the post-demand stamp resolves it where it was written
    pendingTyperefScope: (IdMapV zast.nodeid v: ztypes.declid)
    # a field's type-ref that names a member of the field's own type, by the
    # ref's node, with that type's declaration: the ref waits in the scope the
    # type is written in, where the type's members are not seen, so the stamp
    # asks the type itself what the name is (stampOnePendingTyperef)
    fieldRefOwner: (IdMapV zast.nodeid v: ztypes.declid)
    # an alias's target, by the alias's member declaration, once resolved
    asAliasTarget: (IdMapV ztypes.declid v: ztypes.tid)
    # the names of the `as` items whose value is shaped as a type may be -- a
    # name, a path, an application -- laid at index time: every alias's name
    # is among them, so a name outside them asks no type for one
    asTypeShapedNames: IdSet zast.nameid
    # a type-ref written in a type's scope that names a member of that type,
    # by the ref's node, with the type's declaration: the ref waits in the
    # scope the type is written in, where the type's aliases are not seen, so
    # the stamp asks the type (stampOnePendingTyperef)
    aliasRefOwner: (IdMapV zast.nodeid v: ztypes.declid)
    # the member declarations a use site actually resolved, by the declaration's
    # own id. refDecl records the member of the DECLARING type, which for a
    # generic instance is the template's -- so it answers "some list calls
    # insert", never "THIS list does". This records the instance's own member,
    # which is the question the emitter asks before it writes a template method
    # out: a collection method nothing calls is 39 dead C functions per program.
    usedMemberDecl: IdSet ztypes.declid
    # the functions a static value refers to by name: each is used, and its
    # body is walked with the others once the body pass runs (a static value
    # is built while definitions resolve, before any body can be judged)
    staticFnRefs: ListVal ztypes.declid
    # the definitions a demanded body demanded in its turn, in the order met,
    # each with the scope and the unit it is walked in: the outermost demand
    # walks them one after another, so a chain of calls costs no stack
    demandDecls: ListVal ztypes.declid
    demandScopes: ListVal ztypes.declid
    demandUnits: ListVal ztypes.declid
    # a demanded body is being walked: a demand met now is queued
    demandDraining: bool
    # the bodied members their owner's walk deferred (bodiedMemberDeferred), in
    # the order deferred, and beside each the scope, unit and instance that
    # walk ran in: a use can reach one after its owner walked, and the member
    # is then walked on its own, unless another walk has walked it (Decl.walked)
    deferredDecls: ListVal ztypes.declid
    deferredScopes: ListVal ztypes.declid
    deferredUnits: ListVal ztypes.declid
    deferredMonos: ListVal ztypes.tid
    # the type ids below this one have had their generated `==` swept for the
    # written part comparisons it calls (markGeneratedEqParts)
    eqPartsSwept: ztypes.tid
    # every generic parameter's name, swept from the registry up to
    # gpNamesSwept: the names a pending type-ref reads as a parameter
    # (stampPendingTyperefs)
    gpNames: IdSet zast.nameid
    gpNamesSwept: ztypes.tid
    # declarations a reference found and demanded, in discovery order,
    # awaiting resolution (resolveDemandedDefs drains it)
    pendingDefs: ListVal ztypes.declid
    # dependency units in which a demanded definition has resolved (by unit
    # name id): each runs its implementation pass once, on first entry
    enteredUnits: IdSet ztypes.declid
    # a drain of pendingDefs is running (a nested request returns to it)
    drainingDefs: bool
    # how many pendingTyperef entries stampPendingTyperefs has processed (its
    # cursor), and whether the post-demand pass has run at all
    typerefsStamped: u64
    # whether the type-reference pass has run, since what is legal to ask
    # changes after it
    typerefPassRan: bool
    # type-ref nodes a stamp pass could not stamp because their declaration
    # had not resolved yet; the next pass takes them first
    typerefRetry: ListVal zast.nodeid
    # the return type in scope, which is what a bare `return` is checked against
    currentReturnTypeId: ztypes.tid
    # the per-call INPUT type in scope inside a generator's `call`, which is
    # what `yield` evaluates to. 0 outside one, and 0 for a generator that
    # declares no input -- reading `yield`'s value there is an error. It is
    # stashed rather than bound: the input is not a body binding, because a
    # generator yields before it can receive.
    currentYieldInputTid: ztypes.tid
}

# newWalkState -- a walk state with nothing recorded yet
newWalkState: function out WalkState is {
    return (
        WalkState
        nextTempId: 0
        adoptableTemps: (IdMapV zast.nameid v: ztypes.vid)
        pinnedTempPending: (IdMapV ztypes.vid v: bool)
        lineUnnamedLocals: ListVal zast.nameid
        synthLabel: "".string
        synthOwnerUnit: ztypes.declid
        synthOwnerName: zast.nameid
        currentThisTid: ztypes.tid
        currentFnTid: ztypes.tid
        currentReturnMarker: ztypes.zparamownership.noneMode
        currentFnPins: false
        currentReturnsNothing: false
        draft: (
            ValueDraft
            pins: List ztyping.PinPath
            marker: ztypes.zparamownership.noneMode
            owned: false
        )
        callArgNode: zast.nodeid
        nsBodiesOwed: ListVal ztyping.nsbody
        nsBodiesWalked: IdSet zast.nodeid
        nsConstsWalked: IdSet zast.nodeid
        constsDiagnosed: IdSet zast.nodeid
        instanceConstsChecked: SetVal ztyping.constslot
        constShapesReported: IdSet zast.nodeid
        numericArgsRefused: IdSet zast.nodeid
        genericBoundQual: (IdMapV zast.nodeid v: zast.nameid)
        wideConsts: ListVal ztyping.monostamp
        wideConstTaken: (MapVV ztyping.monostamp v: u8)
        aggUses: ListVal ztyping.monostamp
        closedRanges: ListVal ztyping.monostamp
        typeAppsNamed: IdSet zast.nodeid
        refusedParamCopies: IdSet ztypes.declid
        singletonPaths: (IdMapV zast.nodeid v: ztypes.tid)
        valuePartialAt: (IdMapV zast.nodeid v: ztypes.tid)
        numericArgDependent: false
        templateBodiesScanned: IdSet zast.nodeid
        monosWalked: IdSet ztypes.tid
        instanceUseOwed: false
        monoMintedBy: (IdMapV ztypes.tid v: ztypes.tid)
        monoRecursionReported: IdSet ztypes.tid
        refusedBodies: IdSet zast.nodeid
        refusedInstances: (IdMapV ztypes.tid v: bool)
        bodyErrorsCharged: 0
        heldTemps: ListVal zast.nameid
        monoParamSubst: (IdMapV ztypes.tid v: ztypes.tid)
        constMono: ztypes.tid.zero
        curMonoFnTid: ztypes.tid
        privacySeen: false
        choiceNames: IdSet zast.nameid
        constNarrows: ListVal ztyping.constnarrow
        boxedArms: SetVal ztyping.armkey
        generatorWrapper: (IdMapV zast.nodeid v: bool)
        noStampNode: (IdMapV zast.nodeid v: bool)
        fnHasBody: (IdMapV ztypes.tid v: bool)
        sigGenericDecl: ztypes.declid
        sigFnNode: zast.nodeid
        sigFnName: zast.nameid
        calleeDottedNid: zast.nodeid
        valEqMissing: (IdMapV ztypes.tid v: ztypes.tid)
        hashKeys: IdSet ztypes.tid
        eachSubjectNid: zast.nodeid
        pendingDefaultOwner: (IdMapV zast.nodeid v: ztypes.tid)
        pendingDefaultId: (IdMapV zast.nodeid v: ztypes.tid)
        pendingDefaultName: (IdMapV zast.nodeid v: zast.nameid)
        constructedTypes: (IdMapV ztypes.tid v: bool)
        bareTyperefNodes: IdSet zast.nodeid
        collectionChildrenBuilt: IdSet ztypes.tid
        valuePins: List ztyping.PinPath
        valuePinRoots: ListVal ztypes.vid
        pinsAt: (IdMapV zast.nodeid v: ztyping.valuepins)
        tempPins: (IdMapV ztypes.vid v: ztyping.valuepins)
        pinsJournal: ListVal pinjournal
        pinMarks: ListVal pinmark
        stmtBlocks: IdSet zast.nodeid
        aliasFoldsOpen: ListVal ztypes.declid
        aliasCyclesReported: IdSet ztypes.declid
        instantiatedAliases: IdSet ztypes.declid
        tempVars: IdSet ztypes.vid
        tempNameOf: (IdMapV zast.nodeid v: zast.nameid)
        currentGenTid: ztypes.tid
        genSpillNext: 0
        constEvalState: (MapVV ztyping.constslot v: u8)
        tagSourceDecls: (IdMapV ztypes.tid v: ztypes.declid)
        staticLiteralTyperefs: IdSet zast.nodeid
        constFail: ztypes.noConstFail
        specStandIns: ListVal ztyping.specstandin
        monoSite: (IdMapV ztypes.tid v: ztyping.monosite)
        typedefClash: (IdMapV ztypes.tid v: ztyping.typedefclash)
        genericBoundName: (IdMapV zast.nodeid v: zast.nameid)
        genericBoundScope: (IdMapV zast.nodeid v: ztypes.declid)
        genericParamName: (IdMapV zast.nodeid v: zast.nameid)
        genericParamScope: (IdMapV zast.nodeid v: ztypes.declid)
        stmtExprNid: zast.nodeid
        boundSiteNid: zast.nodeid
        boundSiteLine: 0
        boundSiteCol: 0
        boundSiteFailArg: ztypes.tid.zero
        unmetBounds: ListVal ztyping.unmetbound
        formValueNid: zast.nodeid
        owningValueNid: zast.nodeid
        defNodeIndexBuilt: false
        createOptOut: IdSet ztypes.tid
        fieldSpans: (IdMapV ztypes.tid v: ztyping.fieldspan)
        threadUnitRoot: ztypes.declid
        crossingArgCallee: (IdMapV zast.nodeid v: ztypes.tid)
        pendingTyperef: (IdMapV zast.nodeid v: zast.nameid)
        pendingTyperefScope: (IdMapV zast.nodeid v: ztypes.declid)
        fieldRefOwner: (IdMapV zast.nodeid v: ztypes.declid)
        asAliasTarget: (IdMapV ztypes.declid v: ztypes.tid)
        asTypeShapedNames: IdSet zast.nameid
        aliasRefOwner: (IdMapV zast.nodeid v: ztypes.declid)
        usedMemberDecl: IdSet ztypes.declid
        staticFnRefs: ListVal ztypes.declid
        demandDecls: ListVal ztypes.declid
        demandScopes: ListVal ztypes.declid
        demandUnits: ListVal ztypes.declid
        demandDraining: false
        deferredDecls: ListVal ztypes.declid
        deferredScopes: ListVal ztypes.declid
        deferredUnits: ListVal ztypes.declid
        deferredMonos: ListVal ztypes.tid
        eqPartsSwept: ztypes.tid
        gpNames: IdSet zast.nameid
        gpNamesSwept: ztypes.tid
        pendingDefs: ListVal ztypes.declid
        enteredUnits: IdSet ztypes.declid
        drainingDefs: false
        typerefsStamped: 0
        typerefPassRan: false
        typerefRetry: ListVal zast.nodeid
        currentReturnTypeId: ztypes.tid
        currentYieldInputTid: ztypes.tid
    )
}

# walkmode -- how the body walk reads what it meets: each a mode set around one
# part of a walk and restored after it. A walk that changes a mode saves the
# whole value first and puts it back (st.mode).
walkmode: record {
    # a reassignment TARGET path is being checked (a write, not a read)
    inAssignTarget: false
    # whether the walk is inside a containment check, which is what stops a
    # valtype cycle from recursing forever
    inContainmentEdge: false
    # stop stamping parameters, for the walks that re-visit a signature without
    # re-binding it
    suppressParamStamps: false
    # stop reading a bare type name as a construction
    suppressBareCtor: false
    # stop reading a bare function reference as a zero-argument call, which is
    # what `.take` needs
    suppressFnAutoCall: false
    # a FUNCTION stamp that survives here is legitimate, so a bare method
    # reference must not be reported. Distinct from suppressFnAutoCall,
    # which also stops the coercion: a for-header still NEEDS the 0-arg
    # auto-call (`for each x: counter loop`) and only wants the error silenced.
    allowBareFnRef: false
    # the statement being walked is one whose value nothing uses: not a block's
    # value line, not a function's implied return
    stmtDiscarded: false
    # recording an application's head: its name is the template, not a type
    typerefHead: false
    # bound refusals are not reported: a typedef instance's base is being
    # minted after its clash was recorded, and would only repeat it
    quietBounds: false
}

# The body walk's environment. Scopes and locals are declarations in the
# typing's Decl tree -- a scope is a scopeDecl whose parent is the scope or
# declaration enclosing it, a local a localDecl under the scope it is written
# in -- so they persist, and a walk that returns to a scope later finds what
# was written there. What the table holds is the walk's STATE over them: the
# open scopes, innermost last (a stack of scope ids -- discipline, not
# storage; the innermost with a row is curScope), the overlay rows the walk lays
# over locals -- a take, a narrowing, a lock -- which die with the scope that
# laid them, the scopes whose walk found their remainder unreachable, and the
# rows snapshotted for the dump when a scope closes.
#
# A local resolves by climbing the open scope chain from the top through each
# enclosing scope; a scope's parent that is not a scope -- the function
# declaration -- ends the climb, so two functions never see each other's
# locals whatever order their bodies are walked in, and a body walked on
# demand from inside another leaves that one's locals invisible. The overlay
# rows are keyed by the local's declaration, so a row can only ever be read
# through the local it was laid over. Owns the type registry and the typing
# tables outright (moved in at construction), so every method reads metadata
# via `this.reg` / `this.typing`.
ZSymbolTable: class {
    # the open scopes, innermost last
    open: ListVal openscope
    # the exits recorded (recordExitDestroy), in order. A function body keeps
    # its own.
    exitLog: ListVal exitrec
    # the innermost open scope that has a row -- the scope the walk resolves
    # from. A scope that has declared nothing yet has no row (pushBlock,
    # pushCall): it is transparent to every lookup, so the nearest enclosing
    # scope that does exist answers for it. 0 outside every walk.
    curScope: ztypes.declid
    # the scope stack as one flat list; a scope is a RANGE of it, which is why
    # popping is an index and not a structure
    entries: List ZEntry
    # the lock rows a release hid below the innermost scope, by index, oldest
    # first. Nothing below the innermost scope moves while it is open, so the
    # index holds until a scope's close settles the row (settleReleases)
    releasedRows: ListVal u64
    # the lock rows a path's close laid again (settleReleases), by id, in
    # order: the statement the path belongs to asks, once it is done, whether
    # their holders are spent (releaseIfSpent)
    restoredRows: ListVal ztypes.entryid
    # scopes the walk proved unreachable, so nothing inside one is reported
    # twice
    unreachableScopes: IdSet ztypes.declid
    # how each such scope became unreachable, a `divkind`: the first kind
    # recorded is the one control took
    unreachableKinds: (IdMapV ztypes.declid v: u8)
    # the open loops' bookkeeping, innermost last: each run marks its start
    # in the two lists below, which every open loop shares
    loopRuns: ListVal looprun
    # decl ids moved on a path that left its loop with `break`; the loop
    # re-lays them after itself
    loopBreakTakes: ListVal ztypes.declid
    # decl ids consumed at a `continue`, which the next iteration would find
    # consumed
    loopContinueTakes: ListVal ztypes.declid
    # decl ids moved by a loop's iterable binding, which runs once before the
    # loop and not per iteration
    loopOnceTakes: ListVal ztypes.declid
    # locals already reported as moved inside a loop, so an enclosing loop
    # does not report them again
    loopMoveReported: IdSet ztypes.declid
    # decl ids whose narrowing a NON-diverging arm's write ended, held until the
    # statement the arms belong to finishes: a sibling arm runs only when this
    # one did not, so it keeps the narrowing, while the code after the
    # statement runs after either
    armNarrowingEnds: ListVal ztypes.declid
    # the names a generator body bound to a borrow, in binding order, and the
    # position in `open` of the scope each was bound in: a yield refuses every
    # one still in scope, and each leaves with the scope that bound it
    genBorrowNames: ListVal zast.nameid
    genBorrowPositions: ListVal openpos
    # how many dry runs are open: nothing a dry run walks is recorded
    dryRunDepth: u64
    # the place in `open` of each function body open, innermost last: a
    # `return` leaves every scope from there up
    fnScopes: ListVal openpos
    # the place in `open` of each scope a `break` leaves, innermost last: a
    # loop's, or a `do` block's, which binds `break` to itself -- and whether
    # a `break` leaves it
    breakScopes: ListVal openpos
    breakSeen: ListVal bool
    # the function body a value-returning walk is in, and the block whose last
    # line is in return position: the body, or a `with` or `do` block that is
    # itself the last line of one; 0 when neither
    tailBody: zast.nodeid
    tailBlock: zast.nodeid
    # the generic-parameter answers a TEMPLATE walk keeps out of the shared stamp
    # table, by node, so that walk can still read what it just checked
    templateStamps: (IdMapV zast.nodeid v: ztypes.tid)
    # the arm predicates a TEMPLATE walk found on a partial (`o.some` on an
    # `optionval_t`), by node: the if-narrowing reads them there, and the shared
    # dpArmPredicate the emitter reads keeps each instance's own
    templateArmPreds: (IdMapV zast.nodeid v: ztypes.tid)
    # dump scaffolding: the root scopes of a walk the dump leaves out (a
    # diagnostics-only template walk, an instance walk, a dry run) -- every
    # scope under one is left out with it -- and the rows snapshotted when a
    # scope closed
    scopeHidden: IdSet ztypes.declid
    # the snapshot rows, appended as entries are popped rather than read live
    entryDump: List ZEntryDumpRow
    # the argument locks of the calls whose arguments are being walked, in
    # argument order: a call's run is from the length it found up. Their paths'
    # segments, back to back
    argLocks: ListVal queuedarglock
    argLockSegs: ListVal zast.nameid
    # the walk's modes, saved and restored as one value
    mode: walkmode
    # what the walk records and reads back itself
    walk: WalkState
    # the type registry this table resolves against
    reg: ztypes.ZTypeRegistry
    # the stamp container everything checked here is recorded into
    typing: ZTyping
} as {
    # --- scopes ---

    # innermostScope -- the innermost open scope that has a row, or the zero
    # id when none is open.
    innermostScope: function {t: this.view} out ztypes.declid is {
        n: t.open.length
        for n > 0 loop {
            n = n - 1
            f: (t.open.get i: n).id
            if f.isZero.not then return f
        }
        return ztypes.declid.zero
    }

    # Open a scope under `parent` -- the enclosing scope, or the declaration
    # whose body this is -- and make it current.
    pushScope: function {:this parent: ztypes.declid node: zast.nodeid} out ztypes.declid is {
        f: this.typing.declNewScope :parent :node
        this.open.append (
            openscope
            id: f
            :parent
            :node
            start: this.entries.length
            defs: 0
            firstVid: this.reg.nextVid
            unconditional: false
            path: false
            relMark: this.releasedRows.length
        )
        if this.mode.suppressParamStamps then this.scopeHidden.add item: f
        this.curScope = f
        return f
    }

    # pushLazyScope -- open a block scope whose row is minted only when it
    # first declares something (materialiseTop): most blocks, arms, loops
    # and call brackets never do, and a scope that holds nothing is
    # invisible to every walk. The dump shows the rows a compile makes, and
    # no others.
    pushLazyScope: function {:this node: zast.nodeid} is {
        parent: this.curScope
        this.open.append (
            openscope
            id: ztypes.declid
            :parent
            :node
            start: this.entries.length
            defs: 0
            firstVid: this.reg.nextVid
            unconditional: false
            path: false
            relMark: this.releasedRows.length
        )
    }

    # markUnconditional -- the open scope at `marker` (the index pushBlock
    # answered) is left, on every path that reaches the code after it, only
    # after all of it ran.
    markUnconditional: function {:this marker: openpos} is {
        if marker >= this.open.length then return
        fr: this.open.getMut i: marker
        fr.unconditional = true
    }

    # markPath -- the open scope at `marker` runs on some paths only: a lock
    # it releases from `since` on (a releaseMark) from a scope outside it is
    # released on its path alone, and its close lays it again
    markPath: function {:this marker: openpos since: u64} is {
        if marker >= this.open.length then return
        fr: this.open.getMut i: marker
        fr.path = true
        fr.relMark = since
    }

    # releaseMark -- where the next release of a lock row from a scope outside
    # the innermost one is noted, for markPath
    releaseMark: function {t: this.view} out u64 is {
        return t.releasedRows.length
    }

    # openIndexOf -- where the open scope `scope` sits in `open`, none when it is
    # not open.
    openIndexOf: function {t: this.view scope: ztypes.declid} out optionval openpos is {
        i: t.open.length
        for i > 0 loop {
            i = i - 1
            if (t.open.get :i).id == scope then return (optionval.some (openpos.create from: i))
        }
        return (optionval.none openpos)
    }

    # defineVarAt -- bind `nameId` to `vid` in the open scope at `index`, which
    # has its row, as defineLocal binds in the innermost.
    defineVarAt: function {:this index: openpos nameId: zast.nameid vid: ztypes.vid} is {
        fr: this.open.get i: index
        if fr.id.isZero then return
        (
            this.typing.declNewLocal
            name: nameId
            parent: fr.id
            node: zast.nodeid
            typeId: (this.reg.variableTypeOf id: vid)
            varId: vid
        )
        fr.defs = fr.defs + 1
        this.open.set i: index val: fr
    }

    # addToExitsLeaving -- the owned local `vid`, just bound in the open scope at
    # `index`, joins the destroys of every exit recorded since the variable
    # `since` was minted that leaves that scope: such an exit may run after the
    # local is filled -- on a loop's later iteration -- and an exit that runs
    # before finds it empty, which frees nothing.
    addToExitsLeaving: function {:this index: openpos since: ztypes.vid vid: ztypes.vid} is {
        if this.recording.not then return
        i: u64
        for i < this.exitLog.length loop {
            e: this.exitLog.get :i
            i = i + 1
            if e.vidMark > since when e.downTo <= index then this.addToExit nid: e.exit :vid
        }
    }

    # addToExit -- the exit at `nid` destroys `vid` too, after what it listed.
    addToExit: function {:this nid: zast.nodeid vid: ztypes.vid} is {
        start: this.typing.destroyItems.length
        rg: this.typing.exitDestroy.get key: nid
        if rg.some then {
            k: u64
            for k < rg.len loop {
                it: this.typing.destroyItems.get i: rg.start.u64 + k
                k = k + 1
                this.typing.destroyItems.append (ztyping.destroyitem vid: it.vid state: it.state)
            }
        }
        this.typing.destroyItems.append (ztyping.destroyitem :vid state: 0)
        this.closeExitRange :nid :start
    }

    # innermostOpenIs -- the innermost open scope is `scope` itself: no block,
    # arm, loop or call the walk entered since lies between, materialised or
    # not.
    innermostOpenIs: function {t: this.view scope: ztypes.declid} out bool is {
        n: t.open.length
        if n == 0 then return false
        return (t.open.get i: n - 1).id == scope
    }

    # materialiseTop -- give the innermost open scope its row, under the
    # scope it was opened in, and make it the typing's current scope. A
    # no-op for a scope that already has a row.
    materialiseTop: function {:this} is {
        n: this.open.length
        if n == 0 then return
        top: this.open.get i: n - 1
        if top.id.isZero.not then return
        top.id = this.typing.declNewScope parent: top.parent node: top.node
        this.open.set i: n - 1 val: top
        this.curScope = top.id
    }

    # pushBlock -- open a nested scope over `node`; the marker returned is its
    # position in `open`, which popTo closes back through.
    pushBlock: function {:this node: zast.nodeid} out openpos is {
        marker: openpos.create from: this.open.length
        this.pushLazyScope :node
        return marker
    }

    # pushCall -- open a call scope over the call `node` and answer the marker
    # that closes it. A call scope exists so a borrow taken for the call ends
    # with it.
    pushCall: function {:this node: zast.nodeid} out openpos is {
        return (this.pushBlock :node)
    }

    # Close the innermost scope. Its overlay rows are dropped -- except a
    # take of a local defined in an ENCLOSING scope, which the enclosing
    # scope inherits so the error persists -- and the scope's locals and
    # rows are snapshotted for the dump first. The typing's current scope
    # returns to the scope's parent.
    pop: function {:this} out ztypes.declid is {
        n: this.open.length
        if n == 0 then return ztypes.declid
        this.settleReleases
        fr: this.open.get i: n - 1
        top: fr.id
        start: fr.start
        if top.isZero.not then this.snapshotScope scope: top :start
        this.recordScopeDestroy :fr
        endIdx: this.entries.length
        # takes of enclosing scopes' locals survive the close, and so do the
        # narrowing ends a write laid over them and the refills (`refills`) a
        # write made. A refill replaces the local's takes before it here, and a
        # take replaces a refill before it; takes alone are laid in turn
        mDecls: ListVal ztypes.declid
        mTypes: ListVal ztypes.tid
        mLocs: ListVal (optionval ztypes.zsrcpos)
        # 0 a take, 1 a maybe take, 2 a refill, 4 replaced by a later row
        mFlags: ListVal u8
        mRefilled: false
        mEnds: ListVal ztypes.declid
        p2: start
        for p2 < endIdx loop {
            e: this.entries.get i: p2
            p2 = p2 + 1
            if e.isTaken.not when e.refills.not when e.endsNarrowing.not then continue
            if (this.typing.declParentOf declId: e.declId) == top then continue
            if e.endsNarrowing then mEnds.append e.declId
            if e.isTaken when e.takenAt.none then continue
            if e.isTaken.not when e.refills.not then continue
            if e.refills or mRefilled then {
                j: u64
                for j < mDecls.length loop {
                    if (mDecls.get i: j) == e.declId then {
                        jf: mFlags.get i: j
                        if e.refills or (jf == 2) then mFlags.set i: j val: 4
                    }
                    j = j + 1
                }
            }
            fl: u8
            if e.takenMaybe then fl = 1
            if e.refills then {
                fl = 2
                mRefilled = true
            }
            mDecls.append e.declId
            mTypes.append e.ztypeId
            mLocs.append e.takenAt
            mFlags.append fl
        }
        # a lock lives as long as its HOLDER: a row a variable of an ENCLOSING
        # scope holds -- a value that moved out of this scope with its locks --
        # survives the close, laid again over its root, which is still open
        mLocks: List ztypes.ZEntry
        # whether a lock on a temporary a line kept dies with the scope: only
        # then can one have lost the last hold on it (releaseUnheldTemps)
        droppedTempLock: false
        p3: start
        for p3 < endIdx loop {
            e: this.entries.get i: p3
            if e.hasLock when droppedTempLock.not when (
                this.heldTempNamed
                nameId: (this.typing.declNameOf declId: e.declId)
            ) then droppedTempLock = true
            # a holder minted while this scope was open dies with it -- the
            # common case, answered by its id; only an older holder is asked
            # which scope binds it
            h: e.lockHolder
            if e.hasLock when h.var when h < fr.firstVid then {
                hf: this.scopeOfVar vid: h
                rf: this.typing.declParentOf declId: e.declId
                if hf.isZero.not when hf != top when rf != top then {
                    le: this.reg.newEntry ztypeId: e.ztypeId
                    le.declId = e.declId
                    le.hasLock = true
                    le.lockType = e.lockType
                    le.lockScope = e.lockScope
                    le.lockHolder = e.lockHolder
                    le.lockMutable = e.lockMutable
                    for each seg: e.lockPath loop le.lockPath.append seg
                    mLocks.append le
                }
            }
            p3 = p3 + 1
        }
        this.dropTail :start
        this.open.pop
        if this.genBorrowPositions.length > 0 then this.dropGenBorrows
        this.curScope = this.innermostScope
        for mLocks.length > 0 loop {
            le2: mLocks.pop
            d2: le2.declId
            this.appendRow row: le2 declId: d2
        }
        mc: mDecls.length
        mi: u64
        for mi < mc loop {
            d: mDecls.get i: mi
            fl: mFlags.get i: mi
            mi = mi + 1
            if fl == 4 then continue
            already: this.isTakenDecl declId: d
            # a refill of a local that came in taken leaves it maybe taken; a
            # take of one that came in taken is laid again only to weaken a
            # certain take to a maybe, which a refill further in makes it
            if fl == 2 when already.not then continue
            if fl == 0 when already then continue
            if fl == 1 when already when (this.stateOfDecl declId: d) == 2 then continue
            # a refill every path through here made refills the local here too
            if fl == 2 when fr.unconditional then {
                re: this.reg.newEntry ztypeId: (mTypes.get i: mi - 1)
                re.refills = true
                this.appendRow row: re declId: d
                continue
            }
            te: this.reg.newEntry ztypeId: (mTypes.get i: mi - 1)
            te.isTaken = true
            te.takenMaybe = fl != 0
            te.takenAt = mLocs.get i: mi - 1
            if fl == 2 then te.takenAt = this.takenAtOfDecl declId: d
            this.appendRow row: te declId: d
        }
        # laid last, so no row re-laid above narrows the local again
        for each md: mEnds loop this.layNarrowingEnd declId: md
        # a holder that died here held its locks to here: a temporary only it
        # locked lets go of its own now
        if droppedTempLock then this.releaseUnheldTemps
        return top
    }

    # heldTempNamed -- `nameId` is a temporary a line kept to its block's end
    # (heldTemps).
    heldTempNamed: function {t: this.view nameId: zast.nameid} out bool is {
        k: u64
        for k < t.walk.heldTemps.length loop {
            if (t.walk.heldTemps.get i: k) == nameId then return true
            k = k + 1
        }
        return false
    }

    # releaseUnheldTemps -- every temporary a line kept (heldTemps) that nothing
    # locks any more releases its own locks, in turn freeing the temporaries only
    # it held: a temporary lives no longer than the holds on it (Q1). Asked after
    # a holder lets go -- a release (releaseCascade), the close of the scope it
    # was bound in.
    releaseUnheldTemps: function {:this} is {
        if this.walk.heldTemps.length == 0 then return
        # one path, re-aimed at each temporary in turn
        p: ListVal zast.nameid
        p.append zast.nameid
        released: true
        for released loop {
            released = false
            k: u64
            for k < this.walk.heldTemps.length loop {
                nm: this.walk.heldTemps.get i: k
                k = k + 1
                tv: this.lookupVarId nameId: nm
                if tv.some then {
                    p.set i: 0 val: nm
                    th: ztypes.zlockholder.var tv
                    if (this.isPathLocked path: p).not when (this.holdsAnyLock holder: th) then {
                        this.releaseHeldLocks holder: th
                        released = true
                    }
                }
            }
        }
    }

    # pushDryRun -- open a scope for a dry run: its rows are discarded whole
    # by popDiscard, and it stays out of the dump.
    pushDryRun: function {:this} is {
        f: this.pushScope parent: this.curScope node: zast.nodeid
        this.scopeHidden.add item: f
        this.dryRunDepth = this.dryRunDepth + 1
        mk: pinmark arena: this.walk.valuePins.length journal: this.walk.pinsJournal.length
        this.walk.pinMarks.append mk
    }

    # popDiscard -- close the innermost scope and drop every row it laid,
    # takes included: the scope was a dry run.
    popDiscard: function {:this} is {
        n: this.open.length
        if n == 0 then return
        # what a dry run released it gives back: it leaves no trace
        rm: (this.open.get i: n - 1).relMark
        for this.releasedRows.length > rm loop this.unhideLockRow i: this.releasedRows.pop
        this.dropTail start: (this.open.get i: n - 1).start
        this.open.pop
        if this.genBorrowPositions.length > 0 then this.dropGenBorrows
        this.curScope = this.innermostScope
        if this.dryRunDepth > 0 then this.dryRunDepth = this.dryRunDepth - 1
        this.discardDryRunPins
    }

    # discardDryRunPins -- the value-pin records the closing dry run wrote are
    # put back as they were, and its arena run is dropped.
    discardDryRunPins: function {:this} is {
        if this.walk.pinMarks.length == 0 then return
        mk: this.walk.pinMarks.pop
        for this.walk.pinsJournal.length > mk.journal loop {
            j: this.walk.pinsJournal.pop
            this.walk.pinsAt.set key: j.nid value: j.was
        }
        for this.walk.valuePins.length > mk.arena loop this.walk.valuePins.pop
        for this.walk.valuePinRoots.length > mk.arena loop this.walk.valuePinRoots.pop
    }

    # setValuePins -- record `vp` as what the value at `nid` keeps locked. In a
    # dry run the record it replaces is journalled, for popDiscard to restore.
    setValuePins: function {:this nid: zast.nodeid vp: ztyping.valuepins} is {
        if this.dryRunDepth > 0 then {
            was: (
                (
                    this.walk.pinsAt.get
                    key: nid
                ).or
                d: (
                    ztyping.valuepins
                    start: 0
                    len: 0
                    owned: false
                    marker: ztypes.zparamownership.noneMode
                )
            )
            this.walk.pinsJournal.append (pinjournal :nid :was)
        }
        this.walk.pinsAt.set key: nid value: vp
    }

    # close every scope back to `marker`, dumping the entries as they go
    popTo: function {:this marker: openpos} is {
        for this.open.length > marker loop this.pop
    }

    # --- locals ---

    # Define a body-level binding without a runtime variable (a loop
    # variable's type binding, a generic parameter bound for a walk).
    define: function {:this nameId: zast.nameid ztypeId: ztypes.tid} is {
        this.defineLocal :nameId :ztypeId varId: ztypes.vid
    }

    # Define a body-level binding bound to a runtime variable (a row of the
    # registry's variableById).
    defineVar: function {:this nameId: zast.nameid vid: ztypes.vid} is {
        this.defineLocal :nameId ztypeId: (this.reg.variableTypeOf id: vid) varId: vid
    }

    # defineTemp -- a binding for one of the checker's own temporaries, which no
    # destroy point lists (tempVars).
    defineTemp: function {:this nameId: zast.nameid vid: ztypes.vid} is {
        this.walk.tempVars.add item: vid
        n: this.open.length
        if this.recording when n > 0 then {
            nd: (this.open.get i: n - 1).node
            if nd.isZero.not then this.typing.tempScopeOf.set key: vid value: nd
        }
        this.defineVar :nameId :vid
    }

    # retireTempListing -- the temporary `vid` moves to the scope adopting it:
    # the popped scope that bound it listed it as owned at its end, and that
    # listing now reads moved, so exactly one scope's end owns it. Asked before
    # the temporary is defined again, while `tempScopeOf` still names the scope
    # it leaves.
    retireTempListing: function {:this vid: ztypes.vid} is {
        if this.recording.not then return
        so: this.typing.tempScopeOf.get key: vid
        if so.none then return
        rg: this.typing.scopeTempDestroy.get key: so
        if rg.none then return
        k: u64
        for k < rg.len loop {
            i: rg.start.u64 + k
            k = k + 1
            if (this.typing.destroyItems.get :i).vid == vid then {
                this.typing.destroyItems.set :i val: (ztyping.destroyitem :vid state: 1)
                return
            }
        }
    }

    # scopeBindsHere -- does the INNERMOST open scope already bind `nameId`?
    # Same-scope only: an OUTER scope binding the name is shadowing, which is
    # legal and resolved by declFindLocal's outward walk. An unmaterialised
    # scope has no locals yet, so it binds nothing.
    scopeBindsHere: function {t: this.view nameId: zast.nameid} out bool is {
        n: t.open.length
        if n == 0 then return false
        fr: (t.open.get i: n - 1).id
        if fr.isZero then return false
        d: t.typing.declFindChild parentDeclId: fr :nameId
        return d.isZero.not
    }

    # beginLocal -- a body's code runs top to bottom, so a local is in scope
    # from the statement that declares it on: bind `nameId` in the innermost
    # scope as that statement begins, GREY -- the DFS grey mark a declaration
    # wears while it resolves -- until defineLocal completes it with its value.
    # Its own value, or a binding's own expression, finds it before anything
    # outer, and a grey local is no value to read (isGreyName). 0 when the
    # scope already binds the name: the statement is a redefinition, which the
    # binding site reports, and the name stays the earlier binding.
    beginLocal: function {:this nameId: zast.nameid} out ztypes.declid is {
        n: this.open.length
        if (n == 0) or nameId.isZero then return ztypes.declid
        if (this.scopeBindsHere :nameId) then return ztypes.declid
        this.materialiseTop
        top: this.open.get i: n - 1
        d: (
            this.typing.declNewLocal
            name: nameId
            parent: top.id
            node: zast.nodeid
            typeId: ztypes.tid
            varId: ztypes.vid
        )
        this.typing.declSetResolving declId: d mark: true
        return d
    }

    # endLocal -- the statement that began the local `declId` is done. One
    # whose value failed was never completed: it binds its name all the same,
    # typeless, to a variable of its own, so the failure is reported once, at
    # the value, and a later read of the name is not a second error. Answers
    # that variable, 0 when the local was complete.
    endLocal: function {:this declId: ztypes.declid} out ztypes.vid is {
        if declId.isZero then return ztypes.vid
        if (this.typing.declIsResolving :declId).not then return ztypes.vid
        vh: this.reg.newVariable ztypeId: ztypes.tid ownership: ztypes.zownership.owned
        this.defineVar nameId: (this.typing.declNameOf :declId) vid: vh
        return vh
    }

    # isGreyName -- the nearest declaration of `nameId` is a local whose
    # statement is still being checked.
    isGreyName: function {t: this.view nameId: zast.nameid} out bool is {
        d: t.findLocal :nameId
        if d.isZero then return false
        return (t.typing.declIsResolving declId: d)
    }

    # bind a name in the innermost scope
    defineLocal: function {:this nameId: zast.nameid ztypeId: ztypes.tid varId: ztypes.vid} is {
        n: this.open.length
        if n == 0 then return
        this.materialiseTop
        top: this.open.get i: n - 1
        # one binding per name per scope: the namespace walks read a scope's
        # children by name and stop at the first hit, so a second edge under
        # the same name would be unreachable. The binding site reports the
        # duplicate; this keeps the tree honest if one ever reaches here. The
        # one binding there may be the grey one beginLocal made for this
        # statement, which this completes.
        ex: this.typing.declFindChild parentDeclId: top.id :nameId
        if ex.isZero.not then {
            if (this.typing.declIsResolving declId: ex) then {
                this.typing.declCompleteLocal declId: ex typeId: ztypeId :varId
                top.defs = top.defs + 1
                this.open.set i: n - 1 val: top
            }
            return
        }
        (
            this.typing.declNewLocal
            name: nameId
            parent: top.id
            node: zast.nodeid
            typeId: ztypeId
            :varId
        )
        top.defs = top.defs + 1
        this.open.set i: n - 1 val: top
    }

    # --- name resolution ---

    # findLocal -- the declaration `nameId` resolves to from the innermost
    # open scope outward: each scope's own locals (the last defined wins),
    # then the scope enclosing it, until the chain leaves the scopes. Zero
    # when no scope defines it.
    findLocal: function {t: this.view nameId: zast.nameid} out ztypes.declid is {
        return (t.typing.declFindLocal scope: t.curScope :nameId)
    }

    # bodyStart -- where the rows of the body being walked begin: the start of
    # the innermost open scope a body opened (push), whose parent is the
    # declaration the body belongs to rather than an enclosing scope
    bodyStart: function {t: this.view} out u64 is {
        n: t.open.length
        for n > 0 loop {
            n = n - 1
            sc: t.open.get i: n
            if sc.parent.isZero.not when (t.typing.decls.get i: sc.parent).kind.scopeDecl.not then {
                return sc.start
            }
        }
        return 0
    }

    # isLocalName -- does an open scope define `nameId`, taken or not?
    isLocalName: function {t: this.view nameId: zast.nameid} out bool is {
        d: t.findLocal :nameId
        return d.isZero.not
    }

    # rowOf -- the newest overlay row laid over `declId`, or none. A unit
    # constant is every body's to narrow, and a body another one demands is
    # walked while that one's rows are still open: a constant's rows count
    # only from the body being walked (bodyStart).
    rowOf: function {t: this.view declId: ztypes.declid} out optionval u64 is {
        if declId.isZero then return (optionval.none u64)
        if (t.typing.declRowsOf :declId) == 0 then return (optionval.none u64)
        lowest: u64
        if (t.typing.decls.get i: declId).kind.constDecl then lowest = t.bodyStart
        ne: t.entries.length
        j: ne
        for j > lowest loop {
            j2: j - 1
            e: t.entries.get i: j2
            # a released lock row is no row of the local's: it says nothing
            if e.declId == declId when e.lockReleased.not then return (optionval.some j2)
            j = j - 1
        }
        return (optionval.none u64)
    }

    # appendRow -- lay `row` over `declId` in the innermost scope.
    appendRow: function {:this row: ZEntry.take declId: ztypes.declid} is {
        r: row.take
        r.declId = declId
        n: this.open.length
        if n > 0 then r.defSeq = (this.open.get i: n - 1).defs
        this.typing.declRowsAdd :declId delta: 1
        this.entries.append r
    }

    # noteGenBorrow -- a generator body bound `nameId` to a borrow in the
    # innermost open scope: it may not be in scope at a yield.
    noteGenBorrow: function {:this nameId: zast.nameid} is {
        this.genBorrowNames.append nameId
        this.genBorrowPositions.append (openpos.create from: this.open.length - 1)
    }

    # dropGenBorrows -- forget the borrows whose scopes have closed.
    dropGenBorrows: function {:this} is {
        n: this.open.length
        for this.genBorrowPositions.length > 0 loop {
            if (this.genBorrowPositions.get i: this.genBorrowPositions.length - 1) < n then return
            this.genBorrowPositions.pop
            this.genBorrowNames.pop
        }
    }

    # dropTail -- drop the rows from `start` up, keeping the locals' counts.
    dropTail: function {:this start: u64} is {
        for this.entries.length > start loop {
            e: this.entries.pop
            this.typing.declRowsAdd declId: e.declId delta: -1
        }
    }

    # Resolve a name to its type id, or none (also none when taken, or grey).
    lookup: function {t: this.view nameId: zast.nameid} out optionval ztypes.tid is {
        d: t.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.tid)
        if (t.typing.declIsResolving declId: d) then return (optionval.none ztypes.tid)
        ro: t.rowOf declId: d
        if ro.some then {
            e: t.entries.get i: ro
            if e.isTaken then return (optionval.none ztypes.tid)
            return (optionval.some e.ztypeId)
        }
        return (optionval.some (t.typing.declTypeOf declId: d))
    }

    # Declared type of `name`, ignoring narrowing overlays: the row's
    # original (pre-narrowing) type when set, else its current type. A
    # narrowed sum-type target accepts a fresh value of its whole declared
    # type, so a reassignment validates its RHS against this, not the
    # narrowed view.
    declaredTypeOf: function {t: this.view nameId: zast.nameid} out optionval ztypes.tid is {
        d: t.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.tid)
        if (t.typing.declIsResolving declId: d) then return (optionval.none ztypes.tid)
        ro: t.rowOf declId: d
        if ro.some then {
            e: t.entries.get i: ro
            if e.isTaken then return (optionval.none ztypes.tid)
            oz: e.originalZtypeId
            if oz.some then {
                return (optionval.some oz)
            }
            return (optionval.some e.ztypeId)
        }
        return (optionval.some (t.typing.declTypeOf declId: d))
    }

    # Variable id bound to `name`, skipping lock/narrow overlays; none if
    # taken or unbound.
    lookupVarId: function {t: this.view nameId: zast.nameid} out optionval ztypes.vid is {
        d: t.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.vid)
        if (t.isTakenDecl declId: d) then return (optionval.none ztypes.vid)
        v: t.typing.declLocalVarOf declId: d
        if v.isZero then return (optionval.none ztypes.vid)
        return (optionval.some v)
    }

    # writeTargetVarId -- the variable a write to the bare name `nameId` fills:
    # lookupVarId's, and a local whose value moved out as well, which the
    # write refills
    writeTargetVarId: function {t: this.view nameId: zast.nameid} out optionval ztypes.vid is {
        d: t.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.vid)
        v: t.typing.declLocalVarOf declId: d
        if v.isZero then return (optionval.none ztypes.vid)
        return (optionval.some v)
    }

    # --- invalidation (take) ---

    # mark a name unusable after an ownership transfer, so a later use is an
    # error rather than a use-after-move
    invalidate: function {:this nameId: zast.nameid loc: optionval ztypes.zsrcpos} out bool is {
        return (this.invalidateDecl declId: (this.findLocal :nameId) :loc)
    }

    # invalidateDecl -- the same for a local named by its declaration, which a
    # shadow of its name cannot hide
    invalidateDecl: function {
        :this declId: ztypes.declid loc: optionval ztypes.zsrcpos
    } out bool is {
        return (this.invalidateDeclAs :declId :loc maybe: false)
    }

    # invalidateDeclAs -- invalidateDecl, saying whether the move happened on
    # every path to here or only on some (`maybe`).
    invalidateDeclAs: function {
        :this declId: ztypes.declid loc: optionval ztypes.zsrcpos maybe: bool
    } out bool is {
        d: declId
        if d.isZero then return false
        zt: this.currentTypeOf declId: d
        v: this.typing.declLocalVarOf declId: d
        if v.isZero.not then this.typing.variableMoved.add item: v
        te: this.reg.newEntry ztypeId: zt
        te.isTaken = true
        te.takenAt = loc
        # a local narrowed to an arm gives up only the arm's payload: it still
        # owns what holds it, so its end destroys it all the same
        te.takenMaybe = maybe or (this.narrowsToArm declId: d)
        this.appendRow row: te declId: d
        return true
    }

    # markTakeMaybe -- the move of the local `declId` just recorded happened on
    # only some of the paths that reach here: an arm of an `if` or a
    # `match` whose value moved it, where another arm yields something else.
    markTakeMaybe: function {:this declId: ztypes.declid} is {
        ro: this.rowOf :declId
        if ro.some then {
            e: this.entries.getMut i: ro
            if e.isTaken then e.takenMaybe = true
        }
    }

    # --- destruction ---

    # stateOfDecl -- the state a destroy point here records the local `declId`
    # in (destroyitem): 0 it holds its value, 1 it was moved on every path here,
    # 2 on some.
    stateOfDecl: function {t: this.view declId: ztypes.declid} out u8 is {
        ro: t.rowOf :declId
        if ro.some then {
            e: t.entries.get i: ro
            if e.isTaken when e.takenMaybe then return 2
            if e.isTaken then return 1
        }
        return 0
    }

    # ownsDestroy -- `vid` is a variable a destroy point lists: one that owns
    # what it holds and whose type can own something, and not one of the
    # checker's own temporaries.
    ownsDestroy: function {t: this.view vid: ztypes.vid} out bool is {
        if vid.isZero then return false
        if (t.walk.tempVars.has item: vid) then return false
        if (t.reg.variableOwnershipOf id: vid) != ztypes.zownership.owned then return false
        return (t.reg.isReftypeOf tid: (t.reg.variableTypeOf id: vid))
    }

    # recording -- whether what the walk passes is recorded for the emitter:
    # not in a dry run, and not in a generic template's walk, whose body only an
    # instance's copy of it is emitted from.
    recording: function {t: this.view} out bool is {
        if t.dryRunDepth > 0 then return false
        return (t.mode.suppressParamStamps and t.typing.curMonoStamp.isZero).not
    }

    # appendOwnedTempsOf -- the TEMPORARIES `scope` binds that own something at
    # its end, newest first, in the state they are in here. The other half of
    # `appendOwnedOf`'s walk: `ownsDestroy` excludes a temporary because the
    # emitter still decides when it dies, and this is what the checker would
    # say if it decided instead.
    appendOwnedTempsOf: function {:this scope: ztypes.declid} is {
        ki: this.typing.declChildSlots declId: scope
        for ki > 0 loop {
            ki = ki - 1
            kd: this.typing.declChildAt declId: scope index: ki
            v: this.typing.declLocalVarOf declId: kd
            if (this.walk.tempVars.has item: v).not then continue
            if v.isZero then continue
            # a temporary a pinning call's result keeps locked outlives the
            # call: the scope that adopts it lists it, and this one does not
            if ((this.walk.pinnedTempPending.get key: v).or d: false) then continue
            if (this.reg.variableOwnershipOf id: v) != ztypes.zownership.owned then continue
            if (this.reg.isReftypeOf tid: (this.reg.variableTypeOf id: v)).not then continue
            this.typing.destroyItems.append (
                ztyping.destroyitem
                vid: v
                state: (this.stateOfDecl declId: kd)
            )
        }
    }

    # appendOwnedOf -- the variables `scope` binds that a destroy point lists,
    # newest first, each in the state it is in here, but `except`.
    appendOwnedOf: function {:this scope: ztypes.declid except: ztypes.vid} is {
        ki: this.typing.declChildSlots declId: scope
        for ki > 0 loop {
            ki = ki - 1
            kd: this.typing.declChildAt declId: scope index: ki
            v: this.typing.declLocalVarOf declId: kd
            if v != except when (this.ownsDestroy vid: v) then {
                vs: this.stateOfDecl declId: kd
                this.typing.destroyItems.append (ztyping.destroyitem vid: v state: vs)
                if vs == 2 then this.typing.zeroOnMove.add item: v
            }
        }
    }

    # recordExitDestroy -- what the exit at `nid` destroys: the owned locals of
    # every open scope from the innermost down to the one at `downTo` in `open`,
    # innermost first, but `except` -- the local a `return` hands back.
    recordExitDestroy: function {:this nid: zast.nodeid downTo: openpos except: ztypes.vid} is {
        if this.recording.not then return
        this.exitLog.append (exitrec exit: nid :downTo vidMark: this.reg.nextVid)
        start: this.typing.destroyItems.length
        i: this.open.length
        for i > downTo loop {
            i = i - 1
            sid: (this.open.get :i).id
            if sid.isZero.not then this.appendOwnedOf scope: sid :except
        }
        this.closeExitRange :nid :start
    }

    # recordReturnDestroy -- what the `return` at `nid` destroys: every scope of
    # the function it leaves, but the local `except` it returns.
    recordReturnDestroy: function {:this nid: zast.nodeid except: ztypes.vid} is {
        n: this.fnScopes.length
        if n == 0 then return
        this.recordExitDestroy :nid downTo: (this.fnScopes.get i: n - 1) :except
    }

    # recordLoopExitDestroy -- what the `continue` at `nid` destroys: every scope
    # inside its loop, the loop's own among them.
    recordLoopExitDestroy: function {:this nid: zast.nodeid} is {
        n: this.loopRuns.length
        if n == 0 then return
        (
            this.recordExitDestroy
            :nid
            downTo: (this.loopRuns.get i: n - 1).scopeIndex
            except: ztypes.vid
        )
    }

    # recordBreakDestroy -- what the `break` at `nid` destroys: every scope inside
    # what it leaves -- its loop, or the `do` block that binds `break` -- that
    # scope's own among them.
    recordBreakDestroy: function {:this nid: zast.nodeid} is {
        n: this.breakScopes.length
        if n == 0 then return
        this.recordExitDestroy :nid downTo: (this.breakScopes.get i: n - 1) except: ztypes.vid
    }

    # openBreakScope -- the innermost open scope is one a `break` leaves.
    openBreakScope: function {:this} is {
        this.breakScopes.append (openpos.create from: this.open.length - 1)
        this.breakSeen.append false
    }

    # closeBreakScope -- that scope is closing.
    closeBreakScope: function {:this} is {
        if this.breakScopes.length > 0 then this.breakScopes.pop
        if this.breakSeen.length > 0 then this.breakSeen.pop
    }

    # noteBreak -- a `break` leaves the innermost break scope.
    noteBreak: function {:this} is {
        n: this.breakSeen.length
        if n > 0 then this.breakSeen.set i: n - 1 val: true
    }

    # restoreBreakSeen -- forget the `break`s since `breakLeavesInnermost` read
    # `seen`: a clause the fold proved dead, walked only for the editor, runs
    # none of them.
    restoreBreakSeen: function {:this seen: bool} is {
        n: this.breakSeen.length
        if n > 0 then this.breakSeen.set i: n - 1 val: seen
    }

    # breakLeavesInnermost -- whether a `break` left the innermost break scope.
    breakLeavesInnermost: function {t: this.view} out bool is {
        n: t.breakSeen.length
        if n == 0 then return false
        return (t.breakSeen.get i: n - 1)
    }

    # takenDeclsInScope -- the declarations the innermost scope's rows take,
    # in order.
    takenDeclsInScope: function {t: this.view into: ListVal ztypes.declid} is {
        n: t.open.length
        if n == 0 then return
        p: (t.open.get i: n - 1).start
        for p < t.entries.length loop {
            e: t.entries.get i: p
            if e.isTaken then into.append e.declId
            p = p + 1
        }
    }

    # recordNamedDestroy -- what the `.drop` or the reassignment at `nid`
    # destroys: the value the local `nameId` holds there.
    recordNamedDestroy: function {:this nid: zast.nodeid nameId: zast.nameid} is {
        if this.recording.not then return
        d: this.findLocal :nameId
        if d.isZero then return
        v: this.typing.declLocalVarOf declId: d
        if (this.ownsDestroy vid: v).not then return
        start: this.typing.destroyItems.length
        vs: this.stateOfDecl declId: d
        this.typing.destroyItems.append (ztyping.destroyitem vid: v state: vs)
        if vs == 2 then this.typing.zeroOnMove.add item: v
        this.closeExitRange :nid :start
    }

    # closeExitRange -- the items from `start` are what the exit at `nid`
    # destroys; nothing is recorded for an exit that destroys nothing.
    closeExitRange: function {:this nid: zast.nodeid start: u64} is {
        n: this.typing.destroyItems.length - start
        if n == 0 then return
        (
            this.typing.exitDestroy.set
            key: nid
            value: (ztyping.destroyrange start: start.u32.orPanic len: n.u32.orPanic)
        )
    }

    # recordScopeDestroy -- what the end of the closing scope `fr` destroys, when
    # the walk falls through to it (scopeDestroy), and what its TEMPORARIES own
    # (scopeTempDestroy), which is a different question and is asked of every
    # scope. A scope the walk cannot fall out of -- a loop body ending in
    # `break`, a branch that returns -- destroys none of its locals at its end,
    # because an exit destroyed them (exitDestroy). But a temporary bound there
    # still either owns what it holds or does not, and that is all a hoist asks
    # (scopeOwnsTemp): the emitter places the free at the statement, not at the
    # scope's end, so withholding the answer just left the hoist to guess again.
    recordScopeDestroy: function {:this fr: openscope} is {
        if fr.id.isZero or fr.node.isZero then return
        if this.recording.not then return
        if (this.unreachableScopes.has item: fr.id).not then {
            start: this.typing.destroyItems.length
            this.appendOwnedOf scope: fr.id except: ztypes.vid
            n: this.typing.destroyItems.length - start
            if n > 0 then (
                this.typing.scopeDestroy.set
                key: fr.node
                value: (ztyping.destroyrange start: start.u32.orPanic len: n.u32.orPanic)
            )
        }
        tstart: this.typing.destroyItems.length
        this.appendOwnedTempsOf scope: fr.id
        tn: this.typing.destroyItems.length - tstart
        if tn == 0 then return
        (
            this.typing.scopeTempDestroy.set
            key: fr.node
            value: (ztyping.destroyrange start: tstart.u32.orPanic len: tn.u32.orPanic)
        )
    }

    # currentTypeOf -- the local's type as its newest row has it.
    currentTypeOf: function {t: this.view declId: ztypes.declid} out ztypes.tid is {
        ro: t.rowOf :declId
        if ro.some then {
            return (t.entries.get i: ro).ztypeId
        }
        return (t.typing.declTypeOf :declId)
    }

    # whether a declaration's value has been moved out
    isTakenDecl: function {t: this.view declId: ztypes.declid} out bool is {
        ro: t.rowOf :declId
        if ro.some then {
            return (t.entries.get i: ro).isTaken
        }
        return false
    }

    # where it was taken, so the error points at the transfer and not only at
    # the use
    getTakenLocation: function {
        t: this.view
        nameId: zast.nameid
    } out optionval ztypes.zsrcpos is {
        d: t.findLocal :nameId
        ro: t.rowOf declId: d
        if ro.some then {
            e: t.entries.get i: ro
            if e.isTaken then return e.takenAt
        }
        return (optionval.none ztypes.zsrcpos)
    }

    # takenAtOfDecl -- where the local's newest row says its value was moved
    # out, none when it holds one.
    takenAtOfDecl: function {t: this.view declId: ztypes.declid} out optionval ztypes.zsrcpos is {
        ro: t.rowOf :declId
        if ro.some then {
            e: t.entries.get i: ro
            if e.isTaken then return e.takenAt
        }
        return (optionval.none ztypes.zsrcpos)
    }

    # whether a name's value has been moved out
    isTakenName: function {t: this.view nameId: zast.nameid} out bool is {
        return (t.isTakenDecl declId: (t.findLocal :nameId))
    }

    # Index of the newest taken row for `name`, or none.
    takenIndex: function {t: this.view nameId: zast.nameid} out optionval u64 is {
        return (t.takenIndexDecl declId: (t.findLocal :nameId))
    }

    # takenIndexDecl -- the same for a local named by its declaration.
    takenIndexDecl: function {t: this.view declId: ztypes.declid} out optionval u64 is {
        d: declId
        if d.isZero then return (optionval.none u64)
        ne: t.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: t.entries.get i: j2
            if e.declId == d when e.isTaken then return (optionval.some j2)
            j = j - 1
        }
        return (optionval.none u64)
    }

    # takenInInnermost -- whether a take was laid over `declId` in the
    # innermost scope, whatever rows were laid after it.
    takenInInnermost: function {t: this.view declId: ztypes.declid} out bool is {
        n: t.open.length
        if n == 0 then return false
        ko: t.takenIndexDecl :declId
        match (
            ko
        ) case some then {
            return ko >= (t.open.get i: n - 1).start
        } case none then {
            return false
        }
    }

    # refilledInInnermost -- the locals of enclosing scopes the innermost scope
    # refilled (a `refills` row) and that hold a value here, appended to `into`
    # once each.
    refilledInInnermost: function {t: this.view into: ListVal ztypes.declid} is {
        n: t.open.length
        if n == 0 then return
        p: (t.open.get i: n - 1).start
        for p < t.entries.length loop {
            e: t.entries.get i: p
            p = p + 1
            if e.refills.not then continue
            if (t.isTakenDecl declId: e.declId) then continue
            if (into.contains item: e.declId) then continue
            into.append e.declId
        }
    }

    # layRefill -- the local `declId` holds a value again: every path to here
    # refilled it.
    layRefill: function {:this declId: ztypes.declid} is {
        re: this.reg.newEntry ztypeId: (this.typing.declTypeOf :declId)
        re.refills = true
        this.appendRow row: re :declId
    }

    # takenBetween -- whether a take row lies in rows [from, to).
    takenBetween: function {t: this.view from: u64 to: u64} out bool is {
        i: from
        for i < to loop {
            if (t.entries.get :i).isTaken then return true
            i = i + 1
        }
        return false
    }

    # liftTakenBetween -- remove the take rows laid in rows [from, to), newest
    # first, keeping each one's declaration, whether it was a maybe, and where
    # it was taken. A row that records no place is left, as a scope's close
    # leaves it.
    liftTakenBetween: function {
        :this
        from: u64
        to: u64
        decls: ListVal ztypes.declid
        maybes: ListVal bool
        locs: ListVal ztypes.zsrcpos
    } is {
        i: to
        for i > from loop {
            i = i - 1
            tk: false
            {
                e: this.entries.get :i
                if e.isTaken then {
                    taOpt: e.takenAt
                    if taOpt.some then {
                        tk = true
                        decls.append e.declId
                        maybes.append e.takenMaybe
                        locs.append taOpt
                    }
                }
            }
            if tk then this.removeEntryAt dropIdx: i
        }
    }

    # shiftOpenStarts -- a row was removed at index `pos`, below the end: every
    # open scope that began above it begins one row lower now. A scope's rows
    # are the ones from its start up, and they go when it closes; left where it
    # was, the start would hand the first row the scope lays to the scope
    # outside it, which would keep it -- a lock its holder no longer outlived.
    shiftOpenStarts: function {:this pos: u64} is {
        k: u64
        for k < this.open.length loop {
            fr: this.open.get i: k
            if fr.start > pos then {
                fr.start = fr.start - 1
                this.open.set i: k val: fr
            }
            k = k + 1
        }
    }

    # Rebuild the row list from `dropIdx` up, omitting that slot; the rows
    # below it keep their places.
    removeEntryAt: function {:this dropIdx: u64} is {
        if dropIdx >= this.entries.length then return
        rev: List ZEntry
        for this.entries.length > dropIdx loop rev.append this.entries.pop
        pos: dropIdx
        for rev.length > 0 loop {
            e: rev.pop
            if pos != dropIdx then {
                this.entries.append e
            } else {
                this.typing.declRowsAdd declId: e.declId delta: -1
                this.shiftOpenStarts pos: dropIdx
            }
            pos = pos + 1
        }
    }

    # Remove the newest taken row for `name` (match/case restore).
    clearTaken: function {:this nameId: zast.nameid} is {
        this.clearTakenDecl declId: (this.findLocal :nameId)
    }

    # clearTakenDecl -- the same for a local named by its declaration.
    clearTakenDecl: function {:this declId: ztypes.declid} is {
        kOpt: this.takenIndexDecl :declId
        if kOpt.some then {
            this.removeEntryAt dropIdx: kOpt
        }
    }

    # Drop every taken row the innermost scope laid (diverging arm).
    discardTakenInCurrentScope: function {:this} is {
        n: this.open.length
        if n == 0 then return
        this.discardTakenFrom start: (this.open.get i: n - 1).start
    }

    # Drop every taken row laid at or above `start`, which is never below
    # the innermost scope's start: only that scope's rows can be dropped,
    # so only they are drained and rebuilt -- the rows below are left where
    # they are. A take of a temporary bound in one of those scopes stays: the
    # temporary dies with its scope, so no code after sees it, and the scope's
    # record of what its temporaries own (recordScopeDestroy) reads it -- a
    # value moved out on a path that returns is moved, not owned.
    discardTakenFrom: function {:this start: u64} is {
        rev: List ZEntry
        for this.entries.length > start loop rev.append this.entries.pop
        for rev.length > 0 loop {
            e: rev.pop
            if e.isTaken.not or (this.tempDiesAbove declId: e.declId :start) then {
                this.entries.append e
            } else {
                this.typing.declRowsAdd declId: e.declId delta: -1
                this.shiftOpenStarts pos: this.entries.length
            }
        }
    }

    # tempDiesAbove -- the local is one of the checker's temporaries, bound in
    # a scope opened at or above the entry index `start`: one dropped with it.
    tempDiesAbove: function {
        t: this.view
        # the local asked about
        declId: ztypes.declid
        # the entry index the dropped scopes begin at
        start: u64
    } out bool is {
        v: t.typing.declLocalVarOf :declId
        if (t.walk.tempVars.has item: v).not then return false
        p: t.typing.declParentOf :declId
        k: t.open.length
        for k > 0 loop {
            k = k - 1
            sc: t.open.get i: k
            if sc.start < start then return false
            if sc.id == p then return true
        }
        return false
    }

    # record where a take happened
    setTakenLocation: function {:this nameId: zast.nameid loc: ztypes.zsrcpos} is {
        kOpt: this.takenIndex :nameId
        if kOpt.some then {
            rev: List ZEntry
            for this.entries.length > 0 loop rev.append this.entries.pop
            pos: u64
            for rev.length > 0 loop {
                e: rev.pop
                if pos == kOpt then {
                    lc: loc
                    e.takenAt = optionval.some lc
                }
                this.entries.append e
                pos = pos + 1
            }
        }
    }

    # --- lock holder formatting ---

    # localNameOfVar -- the name of the open local bound to `vid`, or 0.
    localNameOfVar: function {t: this.view vid: ztypes.vid} out zast.nameid is {
        cur: t.curScope
        for cur.isZero.not loop {
            if (t.typing.declIsScope declId: cur).not then return zast.nameid.zero
            kn: t.typing.declChildSlots declId: cur
            ki: kn
            for ki > 0 loop {
                ki = ki - 1
                kd: t.typing.declChildAt declId: cur index: ki
                kv: t.typing.declLocalVarOf declId: kd
                if kv == vid then return (t.typing.declNameOf declId: kd)
            }
            cur = t.typing.declParentOf declId: cur
        }
        return zast.nameid.zero
    }

    # scopeOfVar -- the open scope that binds `vid`, climbing from the innermost;
    # zero when no open scope binds it.
    scopeOfVar: function {t: this.view vid: ztypes.vid} out ztypes.declid is {
        d: t.declOfVar :vid
        if d.isZero then return ztypes.declid
        return (t.typing.declParentOf declId: d)
    }

    # scopeEncloses -- `outer` is `inner` or one of the scopes enclosing it, so
    # a value bound in `outer` lives at least as long as one bound in `inner`.
    scopeEncloses: function {
        t: this.view
        # the scope expected to be the outer one
        outer: ztypes.declid
        # the scope whose ancestry is climbed
        inner: ztypes.declid
    } out bool is {
        cur: inner
        for cur.isZero.not loop {
            if cur == outer then return true
            if (t.typing.declIsScope declId: cur).not then return false
            cur = t.typing.declParentOf declId: cur
        }
        return false
    }

    # heldLockPaths -- the TARGET rows a variable holds, as pins: the path and
    # its strength. Intent prefixes are re-derived when the pins are installed
    # under another holder.
    heldLockPaths: function {
        t: this.view
        # the holder whose target rows are collected
        holder: ztypes.zlockholder
        # receives one pin per target row
        dst: List ztyping.PinPath
    } is {
        for each e: t.entries loop {
            if e.hasLock when e.lockScope == ztypes.zlockscope.target when (
                holderEq
                a: e.lockHolder
                b: holder
            ) then {
                p: ListVal zast.nameid
                for each seg: e.lockPath loop p.append seg
                dst.append (
                    ztyping.PinPath
                    path: p
                    shared: e.lockType == ztypes.zlockstate.shared
                    mutable: e.lockMutable
                    carried: false
                )
            }
        }
    }

    # holdsAnyLock -- whether `holder` holds a lock row.
    holdsAnyLock: function {t: this.view holder: ztypes.zlockholder} out bool is {
        for each e: t.entries loop {
            if e.hasLock when (holderEq a: e.lockHolder b: holder) then return true
        }
        return false
    }

    # render what holds a lock, so a conflict names the holder rather than only
    # the conflict
    formatLockHolder: function {
        t: this.view
        pool: zast.StringPool.view
        holder: ztypes.zlockholder
    } out String is {
        match (
            holder
        ) case var then {
            return (t.formatVarHolder :pool vid: holder)
        } case call then {
            return "call:\{holder}"
        }
    }

    # holderPhrase -- how a diagnostic names a lock's holder: the variable quoted,
    # or "a temporary" for one no source line declares, as lockRootPhrase names
    # a lock's root
    holderPhrase: function {
        t: this.view
        pool: zast.StringPool.view
        holder: ztypes.zlockholder
    } out String is {
        match (
            holder
        ) case var then {
            return (t.varHolderPhrase :pool vid: holder)
        } case call then {
            return "'call:\{holder}'"
        }
    }

    # varHolderPhrase -- holderPhrase for a variable holding the lock
    varHolderPhrase: function {
        t: this.view pool: zast.StringPool.view vid: ztypes.vid
    } out String is {
        if (t.holderIsTemporary :vid) then return "a temporary".string
        nm: t.formatVarHolder :pool :vid
        return "'\{nm}'"
    }

    # lockHolderIsTemporary -- the holder is a variable that is a compiler
    # temporary (holderIsTemporary); a call is not
    lockHolderIsTemporary: function {t: this.view holder: ztypes.zlockholder} out bool is {
        match (
            holder
        ) case var then {
            return (t.holderIsTemporary vid: holder)
        } case call then {
            return false
        }
    }

    # holderIsTemporary -- the variable holding a lock is a compiler temporary,
    # an unnamed local no source line declares (defineTemp lists it; its origin
    # alone does not say so: an origin never set reads as `synth`)
    holderIsTemporary: function {t: this.view vid: ztypes.vid} out bool is {
        return (t.walk.tempVars.has item: vid)
    }

    # the variable holding a lock, by its local's name
    formatVarHolder: function {
        t: this.view pool: zast.StringPool.view vid: ztypes.vid
    } out String is {
        nmId: t.localNameOfVar :vid
        if nmId.isZero then return "<var:\{vid}>"
        return (zast.poolTextCopy :pool ref: nmId)
    }

    # render the conflict itself: what was wanted, what stands in the way, and
    # where that came from
    formatLockConflict: function {
        t: this.view
        pool: zast.StringPool.view
        reqPath: ListViewVal zast.nameid
        reqType: ztypes.zlockstate
        existingType: ztypes.zlockstate
        existingPath: ListViewVal zast.nameid
        existingHolder: ztypes.vid
    } out String is {
        rootView: zast.poolTextAt :pool ref: (reqPath.get i: 0)
        reqKind: zlockstateNameLower reqType
        heldKind: zlockstateNameLower existingType
        # the path names its own root: `o.s`, not `o` on `o.s`
        rp: formatPath :pool path: reqPath
        heldDetail: String
        same: pathsEqual a: existingPath b: reqPath
        if same.not then {
            hp: formatPath :pool path: existingPath
            heldDetail = " on '\{hp}'"
        }
        holderName: t.formatVarHolder :pool vid: existingHolder
        # A binding holding a SHARED lock on ITSELF is a readonly parameter:
        # saying it "already has a lock held by" its own name explains nothing.
        # An exclusive self-lock is not that, and keeps the ordinary wording.
        if holderName.stringView == rootView when existingType == ztypes.zlockstate.shared then {
            return "Cannot take \{reqKind} lock on '\{rp}': '\{rootView}' is readonly here"
        }
        holderPh: t.varHolderPhrase :pool vid: existingHolder
        return "Cannot take \{reqKind} lock on '\{rp}': already has \{heldKind} lock\{heldDetail} held by \{holderPh}"
    }

    # --- locks ---

    # Try to acquire a lock on `path` (segments; root is a variable name);
    # returns "" on success or an error message.
    tryLock: function {
        :this
        pool: zast.StringPool.view
        # a WINDOW, so a prefix of a longer path is handed in without a copy
        path: ListViewVal zast.nameid
        lockType: ztypes.zlockstate
        lockScope: ztypes.zlockscope
        holder: ztypes.zlockholder
        # the holder may write through the reference it is taking
        mutable: bool
        # only ask: run the conflict check and lay no row. For a lock its
        # holder would release before anything else is checked -- the row
        # could only ever be removed again.
        probe: false
    } out String is {
        # every acquisition that CONFLICTS is spelled out; every other one
        # answers with this empty message, and an empty String constructed
        # bare owns no buffer, where `"".string` allocates one for each.
        ok: String
        if path.length == 0 then return ok
        d: this.findLocal nameId: (path.get i: 0)
        if d.isZero then return ok
        if (this.isTakenDecl declId: d) then return ok
        dv: this.typing.declLocalVarOf declId: d
        if dv.isZero then return ok

        idempotent: false
        conflictAt: u64
        conflictFound: false
        conflictSelf: false
        ne: this.entries.length
        j: ne
        # A local with no overlay row has no lock to conflict with: the scan
        # below starts past the end.
        if (this.typing.declRowsOf declId: d) == 0 then j = 0
        # An acquisition is checked against every outstanding lock on this
        # local. The scan never stops at the first row (an outstanding lock
        # anywhere in the body can conflict); rows over other locals -- a
        # shadowed same-named binding, another body's -- are another local's.
        for j > 0 loop {
            j2: j - 1
            e: this.entries.get i: j2
            if e.declId == d when e.hasLock then {
                conflict: (
                    lockAcquireConflict
                    existingType: e.lockType
                    existingScope: e.lockScope
                    existingPath: e.lockPath.listView
                    existingVarHeld: e.lockHolder.var
                    reqType: lockType
                    reqScope: lockScope
                    reqPath: path
                )
                if conflict then {
                    # the formatting method takes `this` exclusively:
                    # remember the index, format after the element
                    # view ends.
                    conflictAt = j2
                    conflictFound = true
                    conflictSelf = holderEq a: e.lockHolder b: holder
                    break
                }
                # a shared lock already on the same path covers this one while
                # it lasts at least as long. Another BINDING's may not: a
                # binding ends early when it is dropped or moved, and this
                # holder -- unless it is a call, over before any binding
                # could end -- would be left pointing at an unlocked path
                same: pathsEqual a: e.lockPath.listView b: path
                if same then {
                    eShared: e.lockType == ztypes.zlockstate.shared
                    rShared: lockType == ztypes.zlockstate.shared
                    endsFirst: (
                        e.lockHolder.var and (holderEq a: e.lockHolder b: holder).not
                    )
                    if endsFirst when holder.call then endsFirst = false
                    if eShared when rShared when endsFirst.not then idempotent = true
                }
            }
            j = j - 1
        }
        if conflictFound then {
            cType: ztypes.zlockstate.exclusive
            cPath: ListVal zast.nameid
            cHolder: ztypes.zlockholder.var ztypes.vid
            ce: this.entries.get i: conflictAt
            cType = ce.lockType
            cHolder = ce.lockHolder
            for each cseg: ce.lockPath loop cPath.append cseg
            if cHolder.call then {
                return (
                    formatAliasConflict
                    :pool
                    reqPath: path
                    existingPath: cPath.listView
                    sameCall: conflictSelf
                )
            }
            return (
                this.formatLockConflict
                :pool
                reqPath: path
                reqType: lockType
                existingType: cType
                existingPath: cPath.listView
                existingHolder: cHolder
            )
        }
        if idempotent or probe then return ok
        this.layLockRow :d :path :lockType :lockScope :holder :mutable
        return ok
    }

    # layLockRow -- lay the overlay row that records a lock just acquired on
    # local `d`, carrying the narrowing of its newest row forward.
    layLockRow: function {
        :this
        d: ztypes.declid
        path: ListViewVal zast.nameid
        lockType: ztypes.zlockstate
        lockScope: ztypes.zlockscope
        holder: ztypes.zlockholder
        mutable: bool
    } is {
        le: this.reg.newEntry ztypeId: (this.typing.declTypeOf declId: d)
        ro: this.rowOf declId: d
        if ro.some then {
            cur: this.entries.get i: ro
            le.ztypeId = cur.ztypeId
            le.narrowedSubtype = cur.narrowedSubtype
            le.originalZtypeId = cur.originalZtypeId
            cit: cur.excludedSubtypes.iterate
            for s: cit loop {
                le.excludedSubtypes.add item: s
            }
        }
        le.hasLock = true
        le.lockType = lockType
        le.lockScope = lockScope
        le.lockHolder = holder
        le.lockMutable = mutable
        # the entry OWNS its copy of the path: one sized grow from the window
        # rather than an append per segment
        le.lockPath.extendView from: path
        this.appendRow row: le declId: d
    }

    # the outstanding lock on a name, if any
    findLock: function {t: this.view nameId: zast.nameid} out optionval ztypes.zlockstate is {
        d: t.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.zlockstate)
        if (t.typing.declRowsOf declId: d) == 0 then return (optionval.none ztypes.zlockstate)
        ne: t.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: t.entries.get i: j2
            if e.declId == d when e.hasLock then return (optionval.some e.lockType)
            j = j - 1
        }
        return (optionval.none ztypes.zlockstate)
    }

    # The innermost lock on `name` that a holder other than `self` holds: what
    # stops `name.drop`. A binding's own locks -- the readonly lock it holds on
    # itself -- end with it, so they stop nothing.
    findLockHeldByOther: function {
        t: this.view
        nameId: zast.nameid
        self: ztypes.zlockholder
    } out optionval heldlock is {
        d: t.findLocal :nameId
        if d.isZero then return (optionval.none heldlock)
        if (t.typing.declRowsOf declId: d) == 0 then return (optionval.none heldlock)
        j: t.entries.length
        for j > 0 loop {
            j = j - 1
            e: t.entries.get i: j
            if e.declId == d when e.hasLock when (holderEq a: e.lockHolder b: self).not then {
                return (optionval.some (heldlock state: e.lockType holder: e.lockHolder))
            }
        }
        return (optionval.none heldlock)
    }

    # queueArgLock -- hold an argument's call lock until the call starts: the
    # arguments after it are evaluated first, and a call nested in one has
    # finished before this call begins. The caller has appended the path's
    # segments to argLockSegs from `segFrom` up.
    queueArgLock: function {
        :this
        callId: zast.nodeid
        segFrom: u64
        isPath: bool
        shared: bool
        mutable: bool
        nodeid: zast.nodeid
        lineno: u32
        colno: u32
    } is {
        (
            this.argLocks.append
            from: (
                queuedarglock
                :callId
                declId: (this.findLocal nameId: (this.argLockSegs.get i: segFrom))
                :segFrom
                segTo: this.argLockSegs.length
                :isPath
                :shared
                :mutable
                :nodeid
                :lineno
                :colno
            )
        )
    }

    # dropArgLocks -- forget the queued argument locks from `mark` up: their call
    # has laid them.
    dropArgLocks: function {:this mark: u64} is {
        if this.argLocks.length <= mark then return
        this.argLockSegs.resize to: (this.argLocks.get i: mark).segFrom
        this.argLocks.resize to: mark
    }

    # argLockQueued -- an argument of a call whose arguments are still being
    # walked passes the local `nameId`: the call starts after anything a later
    # argument does, so it would read the local after a move out of it.
    argLockQueued: function {t: this.view nameId: zast.nameid} out bool is {
        if t.argLocks.length == 0 then return false
        d: t.findLocal :nameId
        if d.isZero then return false
        for each q: t.argLocks loop {
            if q.declId == d then return true
        }
        return false
    }

    # Holder of the innermost lock on `name` (for the .drop-of-locked check).
    findLockHolder: function {
        t: this.view
        nameId: zast.nameid
    } out optionval ztypes.zlockholder is {
        d: t.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.zlockholder)
        if (t.typing.declRowsOf declId: d) == 0 then return (optionval.none ztypes.zlockholder)
        ne: t.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: t.entries.get i: j2
            if e.declId == d when e.hasLock then return (optionval.some e.lockHolder)
            j = j - 1
        }
        return (optionval.none ztypes.zlockholder)
    }

    # Holder of an EXCLUSIVE lock another VARIABLE holds on a path
    # prefix-overlapping `path`, or none: the pin an `outx` result keeps on
    # its `.borrow` input, which a read of that input must not cross.
    findExclusiveVarLock: function {
        # the symbol table whose lock rows are scanned
        t: this.view
        # the path read, root variable first
        path: (ListVal zast.nameid).view
    } out optionval ztypes.zlockholder is {
        if path.length == 0 then return (optionval.none ztypes.zlockholder)
        d: t.findLocal nameId: (path.get i: 0)
        if d.isZero then return (optionval.none ztypes.zlockholder)
        if (t.typing.declRowsOf declId: d) == 0 then return (optionval.none ztypes.zlockholder)
        ne: t.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: t.entries.get i: j2
            if e.declId == d when e.hasLock when (
                e.lockType == ztypes.zlockstate.exclusive
            ) when e.lockHolder.var then {
                ov: pathsOverlap a: e.lockPath.listView b: path.listView
                if ov then return (optionval.some e.lockHolder)
            }
            j = j - 1
        }
        return (optionval.none ztypes.zlockholder)
    }

    # Whether any VARIABLE holds an EXCLUSIVE lock on a local: the cheap
    # question a read asks before it builds the path findExclusiveVarLock
    # needs.
    hasExclusiveVarLock: function {
        # the symbol table whose lock rows are scanned
        t: this.view
        # the local read
        declId: ztypes.declid
    } out bool is {
        if (t.typing.declRowsOf :declId) == 0 then return false
        ne: t.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: t.entries.get i: j2
            if e.declId == declId when e.hasLock when (
                e.lockType == ztypes.zlockstate.exclusive
            ) when e.lockHolder.var then return true
            j = j - 1
        }
        return false
    }

    # Holder of an EXCLUSIVE lock prefix-overlapping `path`, or none.
    findExclusiveLock: function {
        t: this.view
        path: (ListVal zast.nameid).view
    } out optionval ztypes.zlockholder is {
        if path.length == 0 then return (optionval.none ztypes.zlockholder)
        d: t.findLocal nameId: (path.get i: 0)
        if d.isZero then return (optionval.none ztypes.zlockholder)
        if (t.typing.declRowsOf declId: d) == 0 then return (optionval.none ztypes.zlockholder)
        ne: t.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: t.entries.get i: j2
            if e.declId == d when e.hasLock when e.lockType == ztypes.zlockstate.exclusive then {
                ov: pathsOverlap a: e.lockPath.listView b: path.listView
                if ov then return (optionval.some e.lockHolder)
            }
            j = j - 1
        }
        return (optionval.none ztypes.zlockholder)
    }

    # Holder of a SHARED lock that a write to `path` would invalidate, or none.
    # lockHeldByOther -- a lock on the local `nameId`, or on a path through
    # it, held by any holder but `except`: something borrows it or through it.
    lockHeldByOther: function {
        t: this.view
        nameId: zast.nameid
        except: ztypes.zlockholder
    } out optionval ztypes.zlockholder is {
        d: t.findLocal :nameId
        if d.isZero then return (optionval.none ztypes.zlockholder)
        if (t.typing.declRowsOf declId: d) == 0 then return (optionval.none ztypes.zlockholder)
        j: t.entries.length
        for j > 0 loop {
            j = j - 1
            e: t.entries.get i: j
            if e.declId == d when e.hasLock when (holderEq a: e.lockHolder b: except).not then {
                return (optionval.some e.lockHolder)
            }
        }
        return (optionval.none ztypes.zlockholder)
    }

    # A write at or above any shared lock destroys what its holder reads. A
    # shared TARGET is a live read of its whole subtree, so a write below it is
    # blocked too; a shared INTENT is only bookkeeping toward a deeper lock,
    # which is checked on its own row.
    findReadBlocker: function {
        t: this.view
        path: (ListVal zast.nameid).view
    } out optionval ztypes.zlockholder is {
        if path.length == 0 then return (optionval.none ztypes.zlockholder)
        d: t.findLocal nameId: (path.get i: 0)
        if d.isZero then return (optionval.none ztypes.zlockholder)
        if (t.typing.declRowsOf declId: d) == 0 then return (optionval.none ztypes.zlockholder)
        ne: t.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: t.entries.get i: j2
            if e.declId == d when e.hasLock when e.lockType == ztypes.zlockstate.shared then {
                blocks: (
                    (isPrefix p: path.listView whole: e.lockPath.listView) or
                    (
                        (e.lockScope == ztypes.zlockscope.target) and
                        (isPrefix p: e.lockPath.listView whole: path.listView)
                    )
                )
                if blocks then return (optionval.some e.lockHolder)
            }
            j = j - 1
        }
        return (optionval.none ztypes.zlockholder)
    }

    # Any lock (SHARED or EXCLUSIVE) prefix-overlapping `path`?
    isPathLocked: function {t: this.view path: (ListVal zast.nameid).view} out bool is {
        if path.length == 0 then return false
        d: t.findLocal nameId: (path.get i: 0)
        if d.isZero then return false
        if (t.typing.declRowsOf declId: d) == 0 then return false
        ne: t.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: t.entries.get i: j2
            if e.declId == d when e.hasLock then {
                ov: pathsOverlap a: e.lockPath.listView b: path.listView
                if ov then return true
            }
            j = j - 1
        }
        return false
    }

    # Release all locks held by `holder`: each of its rows is hidden in place
    # (hideLockRow), so nothing in the table moves. Most calls release nothing
    # (their locks died with an inner scope), so a first scan finds where the
    # holder's rows begin, and none at all is the common answer.
    releaseHeldLocks: function {:this holder: ztypes.zlockholder} is {
        first: this.entries.length
        idx: u64
        for each e: this.entries loop {
            if e.hasLock when (holderEq a: e.lockHolder b: holder) when idx < first then first = idx
            idx = idx + 1
        }
        n: this.entries.length
        i: first
        for i < n loop {
            if (this.rowHeldBy :i :holder) then this.hideLockRow :i
            i = i + 1
        }
    }

    # rowHeldBy -- the row at `i` is a lock `holder` holds.
    rowHeldBy: function {t: this.view i: u64 holder: ztypes.zlockholder} out bool is {
        e: t.entries.get :i
        if e.hasLock.not then return false
        return (holderEq a: e.lockHolder b: holder)
    }

    # innermostStart -- where the innermost open scope's rows begin: a row
    # below it belongs to a scope outside, which may run on more paths.
    innermostStart: function {t: this.view} out u64 is {
        n: t.open.length
        if n == 0 then return 0
        return (t.open.get i: n - 1).start
    }

    # hideLockRow -- release the lock row at `i`. It stays where it is with its
    # lock off (`lockReleased`), so no index into the table moves. A row of a
    # scope outside the innermost one is noted (releasedRows): a scope between
    # that runs on some paths only lays it again at its close, since the paths
    # that did not run the release still hold it (settleReleases).
    hideLockRow: function {:this i: u64} is {
        floor: this.innermostStart
        e: this.entries.getMut :i
        e.hasLock = false
        e.lockReleased = true
        if i < floor then this.releasedRows.append i
    }

    # inPath -- an open scope runs on some paths only (markPath): what is
    # released now is released on those paths alone.
    inPath: function {t: this.view} out bool is {
        for each fr: t.open loop {
            if fr.path then return true
        }
        return false
    }

    # unhideLockRow -- the row at `i` holds its lock again.
    unhideLockRow: function {:this i: u64} is {
        e: this.entries.getMut :i
        e.hasLock = true
        e.lockReleased = false
    }

    # settleReleases -- the innermost scope is closing: the lock rows it
    # released from the scopes outside it (releasedRows from its relMark) are
    # settled. A scope that ran on some paths only (`path`) lays every one
    # again, for the paths that did not run it. Any other ran wherever the
    # scope around it ran: its release of that scope's own rows now stands,
    # and one of a scope further out stays noted for the scopes between.
    settleReleases: function {:this} is {
        n: this.open.length
        # the last scope closing takes every row the restored list names
        if n == 1 then {
            for this.restoredRows.length > 0 loop this.restoredRows.pop
        }
        fr: this.open.get i: n - 1
        if this.releasedRows.length <= fr.relMark then return
        if fr.path then {
            for this.releasedRows.length > fr.relMark loop {
                ri: this.releasedRows.pop
                this.unhideLockRow i: ri
                this.restoredRows.append (this.rowEntryId i: ri)
            }
            return
        }
        floor: u64
        if n >= 2 then floor = (this.open.get i: n - 2).start
        keep: ListVal u64
        k: fr.relMark
        for k < this.releasedRows.length loop {
            ri: this.releasedRows.get i: k
            if ri < floor then keep.append ri
            k = k + 1
        }
        for this.releasedRows.length > fr.relMark loop this.releasedRows.pop
        for each kr: keep loop this.releasedRows.append kr
    }

    # rowEntryId -- the id of the row at `i`, which no move of the table changes.
    rowEntryId: function {t: this.view i: u64} out ztypes.entryid is {
        return (t.entries.get :i).entryId
    }

    # rowHolder -- what holds, or held, the lock row at `i`.
    rowHolder: function {t: this.view i: u64} out ztypes.zlockholder is {
        return (t.entries.get :i).lockHolder
    }

    # hideLockRowById -- release the lock row `id`, when it still holds its lock.
    hideLockRowById: function {:this id: ztypes.entryid} is {
        j: this.entries.length
        for j > 0 loop {
            j = j - 1
            if (this.rowIsLiveLock i: j :id) then {
                this.hideLockRow i: j
                return
            }
        }
    }

    # restoreMark -- where the next row a path's close lays again is noted,
    # for the statement the path belongs to (releaseIfSpent)
    restoreMark: function {t: this.view} out u64 is {
        return t.restoredRows.length
    }

    # releaseIfSpent -- the lock row `id` that a path's close laid again goes
    # after all when its holder is spent here: moved out on some path, so
    # nothing reads it again (holderIsSpent). Answers whether it went.
    releaseIfSpent: function {:this id: ztypes.entryid} out bool is {
        j: this.entries.length
        for j > 0 loop {
            j = j - 1
            if (this.rowIsLiveLock i: j :id) then {
                if (this.holderIsSpent holder: (this.rowHolder i: j)).not then return false
                this.hideLockRow i: j
                return true
            }
        }
        return false
    }

    # innermostReleases -- the lock rows the innermost open scope released from
    # the scopes outside it, by index: the rows its close lays again when it is
    # a path
    innermostReleases: function {t: this.view into: ListVal u64} is {
        n: t.open.length
        if n == 0 then return
        k: (t.open.get i: n - 1).relMark
        for k < t.releasedRows.length loop {
            into.append (t.releasedRows.get i: k)
            k = k + 1
        }
    }

    # rowIsLiveLock -- the row at `i` is the lock row `id`, its lock held.
    rowIsLiveLock: function {t: this.view i: u64 id: ztypes.entryid} out bool is {
        e: t.entries.get :i
        if e.hasLock.not then return false
        return e.entryId == id
    }

    # holderIsSpent -- `holder` is a local whose value moved out on some path
    # to here: nothing reads it again, so nothing it locks needs to stay locked.
    holderIsSpent: function {t: this.view holder: ztypes.zlockholder} out bool is {
        match (
            holder
        ) case var then {
            d: t.declOfVar vid: holder
            if d.isZero then return false
            return (t.stateOfDecl declId: d) != 0
        } else {
            return false
        }
    }

    # declOfVar -- the local, in an open scope, that `vid` is the variable of.
    declOfVar: function {t: this.view vid: ztypes.vid} out ztypes.declid is {
        cur: t.curScope
        for cur.isZero.not loop {
            if (t.typing.declIsScope declId: cur).not then return ztypes.declid
            kn: t.typing.declChildSlots declId: cur
            ki: kn
            for ki > 0 loop {
                ki = ki - 1
                kd: t.typing.declChildAt declId: cur index: ki
                if (t.typing.declLocalVarOf declId: kd) == vid then return kd
            }
            cur = t.typing.declParentOf declId: cur
        }
        return ztypes.declid
    }

    # --- narrowing ---

    # subjectDecl -- the declaration a narrowing of `nameId` is laid over: the
    # local an open scope defines, else the unit-level constant the name reads.
    # A constant never changes, so it narrows as a local does; a nearer
    # definition of another kind shadows it, and narrows nothing.
    subjectDecl: function {t: this.view nameId: zast.nameid} out ztypes.declid is {
        d: t.findLocal :nameId
        if d.isZero.not then return d
        cur: t.curScope
        for cur.isZero.not loop {
            c: t.typing.declFindChild parentDeclId: cur :nameId
            if c.isZero.not then {
                if (t.typing.decls.get i: c).kind.constDecl then return c
                return ztypes.declid.zero
            }
            cur = t.typing.declParentOf declId: cur
        }
        return ztypes.declid.zero
    }

    # Narrow `name` to a subtype. shadow=true (match-arm): the row's type
    # id becomes the narrowed PAYLOAD type (null/missing payload keeps the
    # outer), and the outer is stashed in originalZtypeId for the emitter's
    # C-level unwrap. shadow=false (assignment): the type id stays the outer
    # union; only the subtype name is recorded.
    narrow: function {
        :this nameId: zast.nameid toTypeId: ztypes.tid subtypeName: zast.nameid shadow: bool
    } is {
        d: this.subjectDecl :nameId
        if d.isZero then return
        curT: this.currentTypeOf declId: d
        originalTypeId: curT
        entryZtype: originalTypeId
        hasSubtype: subtypeName.isZero.not
        if shadow when hasSubtype then {
            if toTypeId == originalTypeId then {
                payloadOpt: (
                    this.typing.declChildOfId
                    parentTypeId: originalTypeId
                    nameId: subtypeName
                )
                if payloadOpt.some then {
                    pt: this.reg.typetypeOf typeId: payloadOpt
                    if pt != ztypes.ztypetype.nullType then entryZtype = payloadOpt
                }
            } else {
                # the caller passed a resolved payload (the typecheck
                # re-resolves arm-child reference shells to real types);
                # null payloads still keep the outer type.
                pt2: this.reg.typetypeOf typeId: toTypeId
                if pt2 != ztypes.ztypetype.nullType then entryZtype = toTypeId
            }
        }

        nsName: zast.nameid
        if hasSubtype then nsName = subtypeName
        origOpt: optionval.none ztypes.tid
        if shadow then {
            oc: originalTypeId
            origOpt = optionval.some oc
        }

        e: this.reg.newEntry ztypeId: entryZtype
        e.narrowedSubtype = nsName
        e.originalZtypeId = origOpt
        this.appendRow row: e declId: d
    }

    # Exclude `subtypeName` from `name`'s type. Collapses to a narrowing
    # when one excludable subtype remains; marks the scope unreachable when
    # none remain.
    exclude: function {
        :this nameId: zast.nameid subtypeName: zast.nameid fullTypeId: ztypes.tid
    } is {
        d: this.subjectDecl :nameId
        if d.isZero then return
        allSubs: ListVal zast.nameid
        sumArmNameIds ty: this.typing reg: this.reg tid: fullTypeId ids: allSubs
        newExcl: IdSet zast.nameid
        this.collectExcluded :nameId into: newExcl
        newExcl.add item: subtypeName

        remainIdx: ListVal u64
        rn: allSubs.length
        ri: u64
        for ri < rn loop {
            nm: allSubs.get i: ri
            isExcl: newExcl.has item: nm
            if isExcl.not then {
                riv: ri
                remainIdx.append riv
            }
            ri = ri + 1
        }

        if remainIdx.length == 0 then {
            this.markUnreachable kind: divkind.exit
        } else {
            narrowedSub: zast.nameid
            if remainIdx.length == 1 then {
                soleIx: remainIdx.get i: 0
                sole: allSubs.get i: soleIx
                narrowedSub = sole
            }
            e: this.reg.newEntry ztypeId: fullTypeId
            e.narrowedSubtype = narrowedSub
            for each s: newExcl loop {
                e.excludedSubtypes.add item: s
            }
            this.appendRow row: e declId: d
        }
    }

    # Copy the current exclusion set for `name` into `into`.
    collectExcluded: function {t: this.view nameId: zast.nameid into: IdSet zast.nameid} is {
        ro: t.rowOf declId: (t.subjectDecl :nameId)
        if ro.some then {
            e: t.entries.get i: ro
            it: e.excludedSubtypes.iterate
            for s: it loop {
                into.add item: s
            }
        }
    }

    # resetNarrowing -- lay a row that restores the local's declared type.
    resetNarrowing: function {:this nameId: zast.nameid} is {
        d: this.findLocal :nameId
        if d.isZero then return
        re: this.reg.newEntry ztypeId: (this.typing.declTypeOf declId: d)
        this.appendRow row: re declId: d
    }

    # endNarrowingByWrite -- a write replaced the local's value, so no narrowing
    # of it stands: lay the row that restores its declared type. When the local
    # WAS narrowed the row is marked, and the scopes carry it outward -- a
    # narrowing an enclosing scope established described the value the write
    # replaced, in every scope the write can reach. When its value had moved
    # out the row is a refill (`refills`), which the scopes carry out too.
    endNarrowingByWrite: function {:this nameId: zast.nameid} is {
        d: this.findLocal :nameId
        if d.isZero then return
        re: this.reg.newEntry ztypeId: (this.typing.declTypeOf declId: d)
        re.endsNarrowing = this.isNarrowedDecl declId: d
        re.refills = this.isTakenDecl declId: d
        this.appendRow row: re declId: d
    }

    # endNarrowingIfNarrowed -- a marked end over `nameId` when, and only when,
    # the local is narrowed: a loop ends the narrowing of the names it writes
    # at its entry, and a name that is not narrowed needs no row.
    endNarrowingIfNarrowed: function {:this nameId: zast.nameid} is {
        d: this.findLocal :nameId
        if d.isZero then return
        if (this.isNarrowedDecl declId: d) then this.layNarrowingEnd declId: d
    }

    # layNarrowingEnd -- the marked row itself: the declared type, and no
    # narrowing.
    layNarrowingEnd: function {:this declId: ztypes.declid} is {
        re: this.reg.newEntry ztypeId: (this.typing.declTypeOf :declId)
        re.endsNarrowing = true
        this.appendRow row: re :declId
    }

    # isNarrowedDecl -- whether the local's newest row narrows it: to an arm, to
    # an arm's payload, or by ruling arms out.
    isNarrowedDecl: function {t: this.view declId: ztypes.declid} out bool is {
        ro: t.rowOf :declId
        if ro.none then return false
        e: t.entries.get i: ro
        if e.narrowedSubtype.isZero.not then return true
        if e.originalZtypeId.none.not then return true
        return e.excludedSubtypes.length > 0
    }

    # narrowsToArm -- whether the local's newest row narrows it to one arm or to
    # that arm's payload, so that the name reads the payload.
    narrowsToArm: function {t: this.view declId: ztypes.declid} out bool is {
        ro: t.rowOf :declId
        if ro.none then return false
        e: t.entries.get i: ro
        if e.narrowedSubtype.isZero.not then return true
        return e.originalZtypeId.none.not
    }

    # anyNarrowed -- whether any open scope narrows any local. Asked before a
    # walk that exists only to end narrowings, which has nothing to do when
    # nothing is narrowed -- the common case.
    anyNarrowed: function {t: this.view} out bool is {
        for each e: t.entries loop {
            if e.narrowedSubtype.isZero.not then return true
            if e.originalZtypeId.none.not then return true
            if e.excludedSubtypes.length > 0 then return true
        }
        return false
    }

    # discardNarrowingEndsInCurrentScope -- a scope whose walk left the
    # function drops the narrowing ends it holds: the code after never runs on
    # that path, so the narrowing still describes the value it reaches.
    discardNarrowingEndsInCurrentScope: function {:this} is {
        n: this.open.length
        if n == 0 then return
        if (this.holdsNarrowingEnd from: (this.open.get i: n - 1).start).not then return
        rev: List ZEntry
        for this.entries.length > (this.open.get i: n - 1).start loop rev.append this.entries.pop
        for rev.length > 0 loop {
            e: rev.pop
            if e.endsNarrowing then {
                this.typing.declRowsAdd declId: e.declId delta: -1
            } else {
                this.entries.append e
            }
        }
    }

    # holdsNarrowingEnd -- whether a row at or above `from` is a narrowing end.
    # Asked before a rebuild of the rows, which nearly every scope can skip.
    holdsNarrowingEnd: function {t: this.view from: u64} out bool is {
        i: from
        for i < t.entries.length loop {
            if (t.entries.get :i).endsNarrowing then return true
            i = i + 1
        }
        return false
    }

    # openArmNarrowingEnds -- a statement with arms begins: the mark its
    # collected narrowing ends are held above.
    openArmNarrowingEnds: function {t: this.view} out u64 is {
        return t.armNarrowingEnds.length
    }

    # collectArmNarrowingEnds -- a non-diverging arm finished: take the
    # narrowing ends its scope holds for locals of ENCLOSING scopes off the
    # stack, so its close does not carry them into the sibling arms, and hold
    # them for the statement's end.
    collectArmNarrowingEnds: function {:this} is {
        n: this.open.length
        if n == 0 then return
        if (this.holdsNarrowingEnd from: (this.open.get i: n - 1).start).not then return
        top: (this.open.get i: n - 1).id
        rev: List ZEntry
        for this.entries.length > (this.open.get i: n - 1).start loop rev.append this.entries.pop
        for rev.length > 0 loop {
            e: rev.pop
            if e.endsNarrowing when (this.typing.declParentOf declId: e.declId) != top then {
                this.armNarrowingEnds.append e.declId
                this.typing.declRowsAdd declId: e.declId delta: -1
            } else {
                this.entries.append e
            }
        }
    }

    # closeArmNarrowingEnds -- the statement the arms belong to finished: every
    # narrowing an arm's write ended is ended over what the statement left
    # behind. A local that died with the statement, or a name now resolving to
    # a different local, is not the one written, so only a decl its name still
    # resolves to is ended.
    closeArmNarrowingEnds: function {:this marker: u64} is {
        for this.armNarrowingEnds.length > marker loop {
            d: this.armNarrowingEnds.pop
            nid: this.typing.declNameOf declId: d
            if (this.findLocal nameId: nid) == d then this.layNarrowingEnd declId: d
        }
    }

    # whether an arm has been ruled out for a name, which is what lets a later
    # match need fewer arms
    isExcluded: function {
        t: this.view
        nameId: zast.nameid
        subtypeName: zast.nameid
    } out bool is {
        tmp: IdSet zast.nameid
        t.collectExcluded :nameId into: tmp
        return (tmp.has item: subtypeName)
    }

    # narrowedArmOf -- the recorded single-arm narrowing for `name` when
    # its row still wears the OUTER type `fullTypeId` (assignment narrowing
    # or exclusion collapse). Shadow-narrowed rows (originalZtypeId set --
    # the name IS a payload) and un-narrowed locals yield "".
    narrowedArmOf: function {
        t: this.view
        nameId: zast.nameid
        fullTypeId: ztypes.tid
    } out zast.nameid is {
        ro: t.rowOf declId: (t.subjectDecl :nameId)
        match (
            ro
        ) case some then {
            e: t.entries.get i: ro
            isShadow: false
            oz: e.originalZtypeId
            if oz.some then {
                isShadow = true
            }
            if isShadow then return zast.nameid
            if e.ztypeId != fullTypeId then return zast.nameid
            return e.narrowedSubtype
        } case none then {
            return zast.nameid
        }
    }

    # isShadowNarrowed -- the current row for `name` is a shadow narrowing
    # (the bare name IS a payload; originalZtypeId records the outer sum
    # type).
    isShadowNarrowed: function {t: this.view nameId: zast.nameid} out bool is {
        ro: t.rowOf declId: (t.subjectDecl :nameId)
        match (
            ro
        ) case some then {
            e: t.entries.get i: ro
            oz: e.originalZtypeId
            match (
                oz
            ) case some then {
                return true
            } case none then {
                return false
            }
        } case none then {
            return false
        }
    }

    # the arm a name is currently narrowed to
    getSubtypeName: function {t: this.view nameId: zast.nameid} out zast.nameid is {
        ro: t.rowOf declId: (t.subjectDecl :nameId)
        match (
            ro
        ) case some then {
            e: t.entries.get i: ro
            return e.narrowedSubtype
        } case none then {
            return zast.nameid
        }
    }

    # mark the current scope unreachable, after a statement that diverges;
    # the first kind recorded is the one control took
    markUnreachable: function {:this kind: u8} is {
        this.materialiseTop
        f: this.curScope
        if f.isZero then return
        this.unreachableScopes.add item: f
        known: this.unreachableKinds.get key: f
        if known.none then this.unreachableKinds.set key: f value: kind
    }

    # how the innermost open scope became unreachable; `divkind.none` while it
    # is reachable. The mark is the scope's own; one that has no row yet
    # cannot carry it.
    unreachableKind: function {t: this.view} out u8 is {
        n: t.open.length
        if n == 0 then return divkind.none
        f: (t.open.get i: n - 1).id
        if f.isZero then return divkind.none
        ko: t.unreachableKinds.get key: f
        match (
            ko
        ) case some then {
            return ko
        } case none then {
            return divkind.none
        }
    }

    # whether the walk is in unreachable code, where a diagnostic would be noise
    isUnreachable: function {t: this.view} out bool is {
        return (t.unreachableKind == divkind.none).not
    }

    # the height of the scope stack, for a later `discardTakenFrom`
    entryMark: function {t: this.view} out u64 is {
        return t.entries.length
    }

    # settleDivergingTakes -- what the innermost scope's takes owe once its
    # walk ends, by the kind that ended it. A path that leaves the FUNCTION
    # drops them: it never reaches the code after. One that leaves a LOOP or a
    # `do` block with `break` records them for it to lay again after itself --
    # the code after still sees them consumed -- and drops them here. A
    # `continue`, or a reachable end, keeps them: the next iteration, or the
    # code after, sees them. Answers the kind.
    settleDivergingTakes: function {:this} out u8 is {
        k: this.unreachableKind
        if k == divkind.brk when this.breakScopes.length > 0 then this.recordBreakTakes
        if k == divkind.exit then this.discardTakenInCurrentScope
        if k == divkind.exit then this.discardNarrowingEndsInCurrentScope
        if k == divkind.brk then this.discardTakenInCurrentScope
        return k
    }

    # openLoopRun -- a loop's walk begins: mark its runs, with the scope
    # stack's height at its entry
    openLoopRun: function {:this entryStart: u64} is {
        this.loopRuns.append (
            looprun
            :entryStart
            breakStart: this.loopBreakTakes.length
            contStart: this.loopContinueTakes.length
            onceStart: this.loopOnceTakes.length
            scopeIndex: (openpos.create from: this.open.length - 1)
        )
    }

    # markTakesMaybeFrom -- the takes laid from `from` on happened on only some
    # of the paths that reach here: a condition after the first, which
    # runs only when the ones before it hold.
    markTakesMaybeFrom: function {:this from: u64} is {
        i: from
        for i < this.entries.length loop {
            e: this.entries.getMut :i
            i = i + 1
            if e.isTaken then e.takenMaybe = true
        }
    }

    # recordOnceTakes -- the moves an iterable binding made (the rows laid
    # since `from`), which run once before the loop
    recordOnceTakes: function {:this from: u64} is {
        i: from
        for i < this.entries.length loop {
            d: this.takenDeclAt :i
            i = i + 1
            if d.isZero.not then this.loopOnceTakes.append d
        }
    }

    # isOnceTake -- the decl was moved by this loop's iterable binding
    isOnceTake: function {t: this.view run: looprun d: ztypes.declid} out bool is {
        i: run.onceStart
        for i < t.loopOnceTakes.length loop {
            if (t.loopOnceTakes.get :i) == d then return true
            i = i + 1
        }
        return false
    }

    # forgetOnceTakes -- the loop's walk ended: drop its binding's moves
    forgetOnceTakes: function {:this run: looprun} is {
        for this.loopOnceTakes.length > run.onceStart loop this.loopOnceTakes.pop
    }

    # closeLoopRun -- the loop's walk ended: answer its run, whose lists the
    # caller drains
    closeLoopRun: function {:this} out looprun is {
        return this.loopRuns.pop
    }

    # takenDeclAt -- the decl a scope-stack row marks as taken, 0 when the
    # row is not a take
    takenDeclAt: function {t: this.view i: u64} out ztypes.declid is {
        e: t.entries.get :i
        if e.isTaken.not then return ztypes.declid.zero
        return e.declId
    }

    # recordContinueTakes -- at a `continue`, every move made since the
    # innermost loop opened reaches its next iteration
    recordContinueTakes: function {:this} is {
        n: this.loopRuns.length
        if n == 0 then return
        run: this.loopRuns.get i: n - 1
        i: run.entryStart
        for i < this.entries.length loop {
            d: this.takenDeclAt :i
            i = i + 1
            if d.isZero.not then this.loopContinueTakes.append d
        }
    }

    # recordBreakTakes -- the innermost scope's taken rows, by decl id, for the
    # innermost loop or `do` block the `break` leaves
    recordBreakTakes: function {:this} is {
        n: this.open.length
        if n == 0 then return
        p: (this.open.get i: n - 1).start
        for p < this.entries.length loop {
            e: this.entries.get i: p
            if e.isTaken then this.loopBreakTakes.append e.declId
            p = p + 1
        }
    }

    # --- utility ---

    # All defined, non-taken names inner->outer (dedup), for did-you-mean:
    # each open scope's locals in definition order, innermost scope first.
    allNames: function {t: this.view} out ListVal zast.nameid is {
        names: ListVal zast.nameid
        seen: IdSet zast.nameid
        cur: t.curScope
        for cur.isZero.not loop {
            if (t.typing.declIsScope declId: cur).not then return names
            kn: t.typing.declChildSlots declId: cur
            ki: u64
            for ki < kn loop {
                kd: t.typing.declChildAt declId: cur index: ki
                nm: t.typing.declNameOf declId: kd
                ki = ki + 1
                if (seen.has item: nm).not when (t.isTakenDecl declId: kd).not then {
                    names.append nm
                    seen.add item: nm
                }
            }
            cur = t.typing.declParentOf declId: cur
        }
        return names
    }

    # hasTakenRow -- has a take been laid over `declId` (whatever narrowing
    # or lock rows were laid after it)?
    hasTakenRow: function {t: this.view declId: ztypes.declid} out bool is {
        if declId.isZero then return false
        if (t.typing.declRowsOf :declId) == 0 then return false
        ne: t.entries.length
        j: ne
        for j > 0 loop {
            j2: j - 1
            e: t.entries.get i: j2
            if e.declId == declId when e.isTaken then return true
            j = j - 1
        }
        return false
    }

    # Live (defined, not taken) owned locals, by DECLARATION -- owned resources
    # to snapshot before if/match arms. Each declaration's liveness is its own
    # taken row's, so a shadow of a name inside an arm neither hides the outer
    # local nor lends it the shadow's state; a narrowing laid over a binding is
    # a row of the same declaration and does not hide a take under it.
    getLiveOwnedVars: function {t: this.view} out IdSet ztypes.declid is {
        decls: IdSet ztypes.declid
        cur: t.curScope
        for cur.isZero.not loop {
            if (t.typing.declIsScope declId: cur).not then return decls
            kn: t.typing.declChildSlots declId: cur
            ki: kn
            for ki > 0 loop {
                ki = ki - 1
                kd: t.typing.declChildAt declId: cur index: ki
                # the take scan is the costly test: ask it last, of the few
                # locals that are owned resources at all
                v: t.typing.declLocalVarOf declId: kd
                if v.isZero.not then {
                    dt: t.typing.declTypeOf declId: kd
                    # a reftype moves on a take whether or not it has anything to
                    # destroy
                    owned: (t.reg.needsDestructor typeId: dt) or (t.reg.isReftypeOf tid: dt)
                    if owned when (t.hasTakenRow declId: kd).not then decls.add item: kd
                }
            }
            cur = t.typing.declParentOf declId: cur
        }
        return decls
    }

    # --- dump ---

    # snapshotScope -- the scope's locals and overlay rows, in the order they
    # were laid, as dump rows. A generic template body walk is
    # diagnostics-only: its scopes stay out of the dump (the emitter re-walks
    # per instance).
    snapshotScope: function {:this scope: ztypes.declid start: u64} is {
        if this.typing.dumpRows.not then return
        if this.mode.suppressParamStamps then return
        kn: this.typing.declChildSlots declId: scope
        endIdx: this.entries.length
        pos: u64
        ki: u64
        ri: start
        # rows laid before the (ki+1)-th local sit before it
        for ki <= kn loop {
            for ri < endIdx loop {
                e: this.entries.get i: ri
                if e.defSeq > ki then break
                # a released lock row is gone as far as the dump is concerned
                if e.lockReleased then {
                    ri = ri + 1
                    continue
                }
                exs: ListVal zast.nameid
                for each xn: e.excludedSubtypes loop exs.append xn
                nsc: e.narrowedSubtype
                this.entryDump.append (
                    ZEntryDumpRow
                    scopeId: scope
                    position: pos
                    declId: e.declId
                    overlayId: e.entryId
                    name: (this.typing.declNameOf declId: e.declId)
                    ztypeId: e.ztypeId
                    isDefinition: false
                    varId: optionval.none ztypes.vid
                    originalZtypeId: e.originalZtypeId
                    isTaken: e.isTaken
                    takenAt: e.takenAt
                    narrowedSubtype: nsc
                    excludedSubtypes: exs
                )
                pos = pos + 1
                ri = ri + 1
            }
            if ki < kn then {
                kd: this.typing.declChildAt declId: scope index: ki
                vidOpt: optionval.none ztypes.vid
                v: this.typing.declLocalVarOf declId: kd
                if v.isZero.not then vidOpt = optionval.some v
                this.entryDump.append (
                    ZEntryDumpRow
                    scopeId: scope
                    position: pos
                    declId: kd
                    overlayId: ztypes.entryid.zero
                    name: (this.typing.declNameOf declId: kd)
                    ztypeId: (this.typing.declTypeOf declId: kd)
                    isDefinition: true
                    varId: vidOpt
                    originalZtypeId: optionval.none ztypes.tid
                    isTaken: false
                    takenAt: optionval.none ztypes.zsrcpos
                    narrowedSubtype: zast.nameid
                    excludedSubtypes: ListVal zast.nameid
                )
                pos = pos + 1
            }
            ki = ki + 1
        }
    }
}

# looprun -- where one open loop's runs start in the symbol table's shared
# loop lists
looprun: record {
    # the scope stack's height when the loop opened: a taken row above it is
    # a move made inside the loop
    entryStart: u64
    # into loopBreakTakes
    breakStart: u64
    # into loopContinueTakes
    contStart: u64
    # into loopOnceTakes
    onceStart: u64
    # the place in `open` of the loop's own scope: a `break` or a `continue`
    # leaves every scope from there up
    scopeIndex: openpos
}

# divkind -- how a scope's walk ended, when it did not fall through: `exit`
# leaves the function (`return`, `panic`), `brk` leaves the loop, `cont` ends
# the iteration. Ordered so that the weakest for an enclosing loop -- the one
# that still reaches its next iteration -- is the largest.
divkind: list {
    none: 0
    exit: 1
    brk: 2
    cont: 3
} out staticlist u8

# construct a symbol table taking ownership of the type registry and
# typing tables it will resolve against.
newSymbolTable: function {reg: ztypes.ZTypeRegistry.take typing: ZTyping.take} out ZSymbolTable is {
    return (
        ZSymbolTable
        open: ListVal openscope
        exitLog: ListVal exitrec
        curScope: ztypes.declid
        entries: List ZEntry
        releasedRows: ListVal u64
        restoredRows: ListVal ztypes.entryid
        unreachableScopes: IdSet ztypes.declid
        unreachableKinds: (IdMapV ztypes.declid v: u8)
        loopRuns: ListVal looprun
        loopBreakTakes: ListVal ztypes.declid
        loopContinueTakes: ListVal ztypes.declid
        loopOnceTakes: ListVal ztypes.declid
        loopMoveReported: IdSet ztypes.declid
        armNarrowingEnds: ListVal ztypes.declid
        genBorrowNames: ListVal zast.nameid
        genBorrowPositions: ListVal openpos
        dryRunDepth: 0
        fnScopes: ListVal openpos
        breakScopes: ListVal openpos
        breakSeen: ListVal bool
        tailBody: zast.nodeid
        tailBlock: zast.nodeid
        templateStamps: (IdMapV zast.nodeid v: ztypes.tid)
        templateArmPreds: (IdMapV zast.nodeid v: ztypes.tid)
        scopeHidden: IdSet ztypes.declid
        entryDump: List ZEntryDumpRow
        argLocks: ListVal queuedarglock
        argLockSegs: ListVal zast.nameid
        mode: walkmode
        walk: newWalkState
        :reg
        :typing
    )
}
