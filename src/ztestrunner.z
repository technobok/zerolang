# ztestrunner.z -- self-hosted golden-corpus test gate, replacing the
# shell tests/run_corpus.sh. Three case kinds, each compared to a
# committed golden, driven entirely by os.spawn (no shell, no Python):
#   run    programs in run_cases.txt -> port emit -> gcc -> run; stdout
#          must match run_golden/<n>.out and exit match <n>.exit (0 default).
#   leak   every buildable example + emitc_corpus program -> ASan build,
#          run under detect_leaks=1; no use-after-free/double-free and 0
#          bytes leaked. KNOWN_LEAKY allowlists expected leakers (now empty).
#   error  tests/fixtures/errors/<n>.z -> the compiler must exit non-zero
#          and print error[Exxxx] lines matching errors/<n>.err (the
#          volatile location/snippet lines are normalized away).
#
# Usage: ztestrunner --zc <port-zc> --cc gcc --root <repo> [--report]

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

# slurp -- file content as an owned String, or "" when unreadable.
slurp: function {path: StringView} out String is {
    r: io.readText :path
    match (
        r
    ) case ok then {
        return r.copy
    } case err then {
        return "".string
    }
    return "".string
}

# declaresMain -- the file declares a top-level `main: function`. A unit with
# none is a LIBRARY: it exists to be opened by another program and is compiled
# through its dependant, so compiling it AS a program is E0039. The two sweeps
# below walk a whole directory rather than a case list, so they are the only
# places that would hand one to the compiler on its own. Mirrors the same
# `^main: *function` test the Makefile's case-guard uses on the other side.
declaresMain: function {path: StringView} out bool is {
    c: slurp :path
    with it: c.stringview.lines do for ln: it loop {
        if (ln.startsWith prefix: "main:") then {
            # bound, not chained: `(a.substring ...).trimStart` emits broken C
            # (the native is called undeclared, and the emitter takes & of the
            # call's result). Pre-existing; the seed compiler does it too.
            a: ln.substring from: 5 to: ln.length
            r: a.trimStart
            if (r.startsWith prefix: "function") then return true
        }
    }
    return false
}

# normErr -- keep only the stable error contract: the error code+message
# lines and the "N error(s) found" summary, each newline-terminated.
# Mirrors run_corpus.sh's grep -aE '^error\[E..\]:|[0-9]+ error(s)? found'.
normErr: function {content: StringView} out String is {
    buf: String
    with it: content.lines do for ln: it loop {
        keep: false
        if (ln.startsWith prefix: "error[E") then keep = true
        if (ln.endsWith suffix: "error found") then keep = true
        if (ln.endsWith suffix: "errors found") then keep = true
        if keep then {
            buf.append ln
            buf.append "\n"
        }
    }
    return buf
}

# isUnsafe -- ASan reported a memory-safety violation (not a mere leak).
isUnsafe: function {s: StringView} out bool is {
    if (s.contains needle: "ERROR: AddressSanitizer: heap-use-after-free") then return true
    if (s.contains needle: "ERROR: AddressSanitizer: attempting double-free") then return true
    if (s.contains needle: "ERROR: AddressSanitizer: heap-buffer-overflow") then return true
    if (s.contains needle: "ERROR: AddressSanitizer: stack-") then return true
    return false
}

# isLeak -- ASan reported leaked bytes.
isLeak: function {s: StringView} out bool is {
    if (s.contains needle: "SUMMARY: AddressSanitizer:") == false then return false
    return (s.contains needle: " byte")
}

# zcArgv -- the port-zc emit command argv. `ccFwd`, when non-empty, names the
# C compiler to zc ITSELF rather than only to the harness's compile step: the
# `platform` unit folds on it during type checking, so a `require:` guard
# decides differently with it than without. Empty by default, because passing
# it unconditionally would move platform.cc off `other` for every ordinary run.
zcArgv: function {
    zc: StringView
    ccFwd: StringView
    name: StringView
    srcdir: StringView
    sys: StringView
    outc: StringView
} out List String is {
    a: (List String)
    a.append from: zc.string
    a.append from: name.string
    if ccFwd.length > 0 then {
        a.append from: "--cc".string
        a.append from: ccFwd.string
    }
    a.append from: "--src".string
    a.append from: srcdir.string
    a.append from: "--system".string
    a.append from: sys.string
    a.append from: "--emit-c".string
    a.append from: outc.string
    return a
}

# dumpArgv -- the canonical-state dump command argv (dump --canon).
dumpArgv: function {
    zc: StringView
    name: StringView
    srcdir: StringView
    sys: StringView
} out List String is {
    a: (List String)
    a.append from: zc.string
    a.append from: "dump".string
    a.append from: name.string
    a.append from: "--src".string
    a.append from: srcdir.string
    a.append from: "--system".string
    a.append from: sys.string
    a.append from: "--canon".string
    return a
}

# zlinkArgs -- the `-l` flags the emitted C declares on its fixed second line,
# `/* zlink: name name */`. The generated file states its own link
# requirements, so the harness reads them off the artifact rather than being
# told separately. Only the header is parsed: these files reach 5.8 MB.
zlinkArgs: function {csrc: StringView} out List String is {
    flags9k: (List String)
    txt9k: slurp path: csrc
    if txt9k.length == 0 then return flags9k
    end9k: txt9k.length
    if end9k > 512 then end9k = 512
    head9k: txt9k.stringview.substring from: 0 to: end9k
    idx9k: u64
    with lit9k: (head9k.split sep: "\n") do for line9k: lit9k loop {
        if idx9k == 1 then {
            seen9k: false
            with tit9k: (line9k.split sep: " ") do for tok9k: tit9k loop {
                if tok9k == "*/" then seen9k = false
                if seen9k then {
                    la9k: "-l".string
                    la9k.append tok9k
                    flags9k.append from: la9k
                }
                if tok9k == "zlink:" then seen9k = true
            }
        }
        idx9k = idx9k + 1
    }
    return flags9k
}

# withZlink -- `argv` plus the `-l` flags `csrc` declares. The emitted C must
# already exist, so a pipeline step whose C is written by an earlier step
# resolves this at spawn time instead (PoolStep.zlinkFrom).
withZlink: function {argv: (List String).take csrc: StringView} out List String is {
    zl9m: zlinkArgs :csrc
    with zit9m: zl9m.iterate do for zf9m: zit9m loop {
        argv.append from: zf9m.copy
    }
    return argv
}

# withExtraArgs -- `argv` plus one element per non-empty line of `file`. An
# error fixture that needs a compiler flag -- `--cc tcc`, to prove a require:
# guard fires without tcc installed -- names it in <name>.zcargs beside its
# .err golden, the way a run case names its program's argv in <name>.args.
# An absent file reads as empty, since slurp returns "" for an unreadable path.
withExtraArgs: function {argv: (List String).take file: StringView} out List String is {
    ac9x: slurp path: file
    acv9x: ac9x.stringview
    with it9x: acv9x.lines do for ln9x: it9x loop {
        if ln9x.length > 0 then {
            argv.append from: ln9x.string
        }
    }
    return argv
}

# gccArgv -- the C build command argv; `asan` selects the ASan flags
# (-fsanitize=address -g -O0 -std=c17 -w) over the strict CF set. `ccflags`
# carries what the harness cannot infer about the compiler -- tcc needs
# `-B <payload>` or it cannot resolve its own stddef.h, since the directory it
# was configured with is not the one it is running from.
gccArgv: function {
    cc: StringView
    ccflags: StringView
    bin: StringView
    csrc: StringView
    asan: bool
} out List String is {
    a: (List String)
    a.append from: cc.string
    with cfit9g: (ccflags.split sep: " ") do for cf9g: cfit9g loop {
        if cf9g.length > 0 then a.append from: cf9g.string
    }
    if asan then {
        a.append from: "-fsanitize=address".string
        a.append from: "-g".string
        a.append from: "-O0".string
        a.append from: "-std=c17".string
        a.append from: "-w".string
    } else {
        a.append from: "-std=c17".string
        a.append from: "-Wall".string
        a.append from: "-Wextra".string
        a.append from: "-Wno-unused-function".string
        a.append from: "-Wno-unused-parameter".string
        a.append from: "-Werror=implicit-function-declaration".string
        a.append from: "-Werror=implicit-int".string
        a.append from: "-Werror=int-conversion".string
        a.append from: "-Werror=incompatible-pointer-types".string
    }
    a.append from: "-o".string
    a.append from: bin.string
    a.append from: csrc.string
    a.append from: "-lm".string
    return a
}

# binArgv -- the test-binary argv: the binary plus one element per
# non-empty line of run_golden/<name>.args (absent file -> just the bin).
binArgv: function {bin: StringView argsFile: StringView} out List String is {
    a: (List String)
    a.append from: bin.string
    ac: slurp path: argsFile
    acv: ac.stringview
    with it: acv.lines do for ln: it loop {
        if ln.length > 0 then {
            a.append from: ln.string
        }
    }
    return a
}

# PoolStep -- one spawn in a job's pipeline. allowFail steps record a
# nonzero exit without ending the job (a run step's exit code is data,
# compared against the golden -- only zc/cc steps are hard gates).
PoolStep: class {
    argv: (List String)
    cwd: String
    outPath: String
    errPath: String
    timeoutSecs: i32
    allowFail: bool
    # the emitted C whose declared link libraries this step must add, resolved
    # when the step runs because an earlier step in the pipeline writes it
    zlinkFrom: String
}

# build one pipeline step (a named command) for a test job.
mkStep: function {
    argv: (List String).take
    cwd: StringView
    outPath: StringView
    errPath: StringView
    timeoutSecs: i32
    allowFail: bool
    zlinkFrom: StringView
} out PoolStep is {
    return (PoolStep
        :argv
        cwd: cwd.string
        outPath: outPath.string
        errPath: errPath.string
        :timeoutSecs
        :allowFail
        zlinkFrom: zlinkFrom.string
    )
}

# stepArgv -- a step's argv as spawned: the link flags its C declares are
# resolved now, because the C is written by an earlier step of this pipeline.
stepArgv: function {step: PoolStep.view} out List String is {
    a9n: (List String)
    with ait9n: step.argv.iterate do for e9n: ait9n loop {
        a9n.append from: e9n.copy
    }
    if step.zlinkFrom.length == 0 then return a9n
    return (withZlink argv: a9n csrc: step.zlinkFrom.stringview)
}

# PoolJob -- a test case's sequential spawn pipeline (immutable; the
# pool's mutable per-job state lives in runJobs-local parallel arrays,
# since a list `get` hands back a non-owning shallow copy).
PoolJob: class {
    name: String
    steps: (List PoolStep)
}

# build a test job: a named sequence of steps run as a unit.
mkJob: function {name: StringView steps: (List PoolStep).take} out PoolJob is {
    return (PoolJob name: name.string :steps)
}

# runJobs -- drive every job through its steps with at most maxJobs
# children in flight. Steps within a job stay sequential; jobs overlap.
# A step past its deadline is SIGKILLed and recorded as 124 (spawn's
# timeout convention). Results land in the caller's statuses/failSteps,
# indexed by job: failStep -1 = every step ran (status = the LAST
# step's exit); otherwise the index of the hard-failing step.
runJobs: function {
    jobs: (List PoolJob).view
    maxJobs: u64
    statuses: ListVal i32
    failSteps: ListVal i64
} is {
    cap: maxJobs
    if cap == 0 then cap = 1
    total: jobs.length
    pids: (ListVal i32)
    stepIdxs: (ListVal u64)
    deadlines: (ListVal i64)
    killeds: (ListVal bool)
    pi: u64
    for pi < total loop {
        pids.append 0
        stepIdxs.append 0.u64
        deadlines.append 0.i64
        killeds.append false
        statuses.append 0
        failSteps.append -1
        pi = pi + 1
    }
    doneN: u64
    inflight: u64
    for doneN < total loop {
        ji: u64
        for ji < total while inflight < cap loop {
            jpid: pids.get i: ji
            jfail: failSteps.get i: ji
            jstep: stepIdxs.get i: ji
            j: jobs.get i: ji
            if jpid == 0 when jfail == -1 when jstep < j.steps.length then {
                st: j.steps.get i: jstep
                sargv: stepArgv step: st
                pid: (os.spawnAsync
                    argv: sargv
                    cwd: st.cwd.stringview
                    outPath: st.outPath.stringview
                    errPath: st.errPath.stringview
                )
                if pid <= 0 then {
                    statuses.set i: ji val: 127
                    failSteps.set i: ji val: jstep.i64.orPanic
                    doneN = doneN + 1
                } else {
                    pids.set i: ji val: pid
                    killeds.set i: ji val: false
                    if st.timeoutSecs > 0 then {
                        dl: os.monotonicMillis + (st.timeoutSecs.i64 * 1000)
                        deadlines.set i: ji val: dl
                    } else {
                        deadlines.set i: ji val: 0
                    }
                    inflight = inflight + 1
                }
            }
            ji = ji + 1
        }
        if inflight == 0 then return
        r: os.waitAny
        if r.pid > 0 then {
            jk: u64
            hit: false
            for jk < total while hit.false loop {
                if (pids.get i: jk) == r.pid then {
                    hit = true
                    pids.set i: jk val: 0
                    inflight = inflight - 1
                    kstep: stepIdxs.get i: jk
                    j2: jobs.get i: jk
                    stw: j2.steps.get i: kstep
                    stStatus: r.status
                    if (killeds.get i: jk) then stStatus = 124
                    statuses.set i: jk val: stStatus
                    ended: false
                    if stStatus != 0 when stw.allowFail.false then {
                        failSteps.set i: jk val: kstep.i64.orPanic
                        ended = true
                    } else {
                        kn: kstep + 1
                        stepIdxs.set i: jk val: kn
                        if kn >= j2.steps.length then ended = true
                    }
                    if ended then doneN = doneN + 1
                }
                jk = jk + 1
            }
        } else {
            now: os.monotonicMillis
            jm: u64
            for jm < total loop {
                mpid: pids.get i: jm
                mdl: deadlines.get i: jm
                if mpid > 0 when mdl > 0 when now > mdl when (killeds.get i: jm).false then {
                    os.kill pid: mpid
                    killeds.set i: jm val: true
                }
                jm = jm + 1
            }
            os.sleepMillis ms: 5
        }
    }
}

# frameLsp -- wrap each non-empty line of a .msgs transcript in LSP
# Content-Length framing (the bytes zls reads on its --replay input).
frameLsp: function {src: StringView} out String is {
    result: String
    with it: src.lines do for ln: it loop {
        if ln.length > 0 then {
            n: ln.length
            h: "Content-Length: \{n}"
            result.append h
            result.appendByte b: 13
            result.appendByte b: 10
            result.appendByte b: 13
            result.appendByte b: 10
            result.append ln
        }
    }
    return result
}

# deframeLsp -- zls output back to one JSON body per line. The server
# emits the exact form "Content-Length: N\r\n\r\n<body>"; anything
# else surfaces as a literal marker line so the diff fails loudly.
deframeLsp: function {raw: StringView} out String is {
    result: String
    pos: u64
    n: raw.length
    for pos < n loop {
        if pos + 16 > n then {
            result.append "<<deframe error: truncated header>>"
            result.appendByte b: 10
            return result
        }
        okHdr: false
        {
            hd: raw.substring from: pos to: pos + 16
            if hd == "Content-Length: " then okHdr = true
        }
        if okHdr == false then {
            result.append "<<deframe error: bad prefix>>"
            result.appendByte b: 10
            return result
        }
        clen: u64
        i: pos + 16
        for true loop {
            bo: raw.byteAt :i
            match (
                bo
            ) case some then {
                if bo >= 48 when bo <= 57 then {
                    clen = (clen * 10) + (bo.u64 - 48)
                    i = i + 1
                } else {
                    break
                }
            } case none then {
                break
            }
        }
        i = i + 4
        j: u64
        for j < clen loop {
            bo2: raw.byteAt :i
            match (
                bo2
            ) case some then {
                result.appendByte b: bo2
            } case none then null
            i = i + 1
            j = j + 1
        }
        result.appendByte b: 10
        pos = i
    }
    return result
}

# test-runner entry point: build the compiler, run the
# run/leak/error/dump/lsp suites, and report pass/fail counts.
main: function is {
    argv: os.args
    n: argv.length
    zc: "out/zc".string
    cc: "gcc".string
    ccflags: String
    ccFwdOn: false
    root: ".".string
    report: false
    heavy: false
    saveTemps: false
    timeoutSecs: 60.i32
    jobsMax: 1.u64
    i: 1.u64
    for i < n loop {
        a: argv.get :i
        av: a.stringview
        if av == "--zc" then {
            i = i + 1
            zc = (argv.get :i).copy
        } else if av == "--cc" then {
            i = i + 1
            cc = (argv.get :i).copy
        } else if av == "--ccflags" then {
            i = i + 1
            ccflags = (argv.get :i).copy
        } else if av == "--cc-forward" then {
            ccFwdOn = true
        } else if av == "--root" then {
            i = i + 1
            root = (argv.get :i).copy
        } else if av == "--report" then {
            report = true
        } else if av == "--heavy" then {
            heavy = true
        } else if av == "--save-temps" then {
            saveTemps = true
        } else if av == "--jobs" then {
            i = i + 1
            jval: (argv.get :i)
            jsv: jval.stringview
            jv: jsv.parseI64
            match (
                jv
            ) case ok then {
                if jv > 0 then jobsMax = jv.u64.orPanic
            } case err then null
        } else if av == "--timeout" then {
            i = i + 1
            tval: (argv.get :i)
            tsv: tval.stringview
            tv: tsv.parseI64
            match (
                tv
            ) case ok then {
                timeoutSecs = tv.i32.orPanic
            } case err then null
        }
        i = i + 1
    }

    # resolved after the loop, not inside the --cc-forward arm: the flags may
    # arrive in either order, and reading `cc` early would make `--cc-forward
    # --cc X` forward the default instead of X.
    ccFwd: String
    if ccFwdOn then ccFwd = cc.copy

    sys: "\{root.stringview}/lib/system"
    errors: "\{root.stringview}/tests/fixtures/errors"
    rungold: "\{root.stringview}/tests/fixtures/run_golden"
    runcases: "\{root.stringview}/tests/fixtures/run_cases.txt"
    examplesDir: "\{root.stringview}/examples"
    corpusDir: "\{root.stringview}/tests/fixtures/emitc_corpus"
    dumpcases: "\{root.stringview}/tests/fixtures/dump_cases.txt"
    dumpgold: "\{root.stringview}/tests/fixtures/dump_golden"
    mypid: os.pid
    d: "/tmp/ztr_\{mypid}"
    io.mkdirp path: d
    # sweep trees crashed prior runs left behind: the names are
    # pid-scoped, and a live owner still has /proc/<pid>
    myPidS: "\{mypid}"
    stale: io.listDir path: "/tmp"
    match (
        stale
    ) case ok then {
        with sit: stale.iterate do for se: sit loop {
            sv: se.stringview
            if sv.startsWith "ztr_" then {
                spid: sv.substring from: 4 to: sv.length
                if spid != myPidS.stringview then {
                    proc: "/proc/\{spid}"
                    if (io.exists path: proc) == false then {
                        dead: "/tmp/ztr_\{spid}"
                        io.removeTree path: dead.stringview
                    }
                }
            }
        }
    } case err then null

    passN: u64
    leakclean: u64
    xleak: u64
    xfail: u64
    skip: u64
    fails: u64

    # ---------------- RUN cases ----------------
    rcC: slurp path: runcases.stringview
    rcv: rcC.stringview
    runPool: (List PoolJob)
    with rit: rcv.lines do for ln: rit loop {
        if ln.length > 0 then {
            nameStr: String
            dirStr: String
            idx: u64
            with sit: (ln.split sep: " ") do for pc: sit loop {
                if pc.length > 0 then {
                    if idx == 0 then {
                        nameStr = pc.string
                    } else if idx == 1 then dirStr = pc.string
                    idx = idx + 1
                }
            }
            if idx >= 2 then {
                srcAbs: "\{root.stringview}/\{dirStr.stringview}"
                cpath: "\{d.stringview}/\{nameStr.stringview}.c"
                bpath: "\{d.stringview}/\{nameStr.stringview}.bin"
                opath: "\{d.stringview}/\{nameStr.stringview}.out"
                rdir: "\{d.stringview}/run_\{nameStr.stringview}"
                io.mkdirp path: rdir
                argsFile: "\{rungold.stringview}/\{nameStr.stringview}.args"
                steps: (List PoolStep)
                za: (zcArgv
                    zc: zc.stringview
                    ccFwd: ccFwd.stringview
                    name: nameStr.stringview
                    srcdir: srcAbs.stringview
                    sys: sys.stringview
                    outc: cpath.stringview
                )
                steps.append (mkStep
                    argv: za
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                    allowFail: false
                    zlinkFrom: ""
                )
                ga: (gccArgv
                    cc: cc.stringview
                    ccflags: ccflags.stringview
                    bin: bpath.stringview
                    csrc: cpath.stringview
                    asan: false
                )
                steps.append (mkStep
                    argv: ga
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                    allowFail: false
                    zlinkFrom: cpath.stringview
                )
                ba: binArgv bin: bpath.stringview argsFile: argsFile.stringview
                steps.append (mkStep
                    argv: ba
                    cwd: rdir.stringview
                    outPath: opath.stringview
                    errPath: "/dev/null"
                    :timeoutSecs
                    allowFail: true
                    zlinkFrom: ""
                )
                runPool.append (mkJob name: nameStr.stringview :steps)
            }
        }
    }
    runStatuses: (ListVal i32)
    runFailSteps: (ListVal i64)
    runJobs jobs: runPool maxJobs: jobsMax statuses: runStatuses failSteps: runFailSteps
    rji: u64
    for rji < runPool.length loop {
        rjob: runPool.get i: rji
        rnm: rjob.name.stringview
        rfail: runFailSteps.get i: rji
        if rfail == 0 then {
            print "FAIL(run) \{rnm} (zc)"
            fails = fails + 1
        } else if rfail == 1 then {
            print "FAIL(run) \{rnm} (cc)"
            fails = fails + 1
        } else {
            opath: "\{d.stringview}/\{rnm}.out"
            gold: "\{rungold.stringview}/\{rnm}.out"
            exitFile: "\{rungold.stringview}/\{rnm}.exit"
            if (io.exists path: gold) == false then {
                skip = skip + 1
            } else {
                goldC: slurp path: gold.stringview
                outC: slurp path: opath.stringview
                expStr: "0".string
                if (io.exists path: exitFile) then {
                    rawx: slurp path: exitFile.stringview
                    rxv: rawx.stringview
                    tvw: rxv.trim
                    expStr = tvw.string
                }
                codeStr: "\{runStatuses.get i: rji}"
                sameOut: outC.stringview == goldC.stringview
                sameExit: codeStr.stringview == expStr.stringview
                if sameOut when sameExit then {
                    passN = passN + 1
                } else {
                    print "FAIL(run) \{rnm}"
                    fails = fails + 1
                }
            }
        }
        rji = rji + 1
    }

    # ---------------- LSP (framed transcript) cases ----------------
    lspCases: "\{root.stringview}/tests/fixtures/lsp_cases"
    lspGold: "\{root.stringview}/tests/fixtures/lsp_golden"
    lspLs: io.listDir path: lspCases
    match (
        lspLs
    ) case ok then {
        zlsC: "\{d.stringview}/zls_bin.c"
        zlsB: "\{d.stringview}/zls_bin"
        srcD: "\{root.stringview}/src"
        za: (zcArgv
            zc: zc.stringview
            ccFwd: ccFwd.stringview
            name: "zls"
            srcdir: srcD.stringview
            sys: sys.stringview
            outc: zlsC.stringview
        )
        ec: (os.spawn
            argv: za
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        )
        built: false
        if ec != 0 then {
            print "FAIL(lsp) zls (zc)"
            fails = fails + 1
        } else {
            ga: (withZlink
                argv: (gccArgv
                    cc: cc.stringview
                    ccflags: ccflags.stringview
                    bin: zlsB.stringview
                    csrc: zlsC.stringview
                    asan: false
                )
                csrc: zlsC.stringview
            )
            bc: (os.spawn
                argv: ga
                cwd: ""
                outPath: "/dev/null"
                errPath: "/dev/null"
                timeoutSecs: 0
            )
            if bc != 0 then {
                print "FAIL(lsp) zls (cc)"
                fails = fails + 1
            } else {
                built = true
            }
        }
        if built then {
            names: (List String)
            with lit: lspLs.iterate do for fn: lit loop {
                keep: fn.endsWith ".msgs"
                if fn.endsWith ".raw" then keep = true
                if keep then names.append fn.copy
            }
            names.sort
            with nit: names.iterate do for cf: nit loop {
                cv: cf.stringview
                isRaw: cv.endsWith ".raw"
                ext: 5.u64
                if isRaw then ext = 4
                nm: cv.substring from: 0 to: cv.length - ext
                cp: "\{lspCases.stringview}/\{cv}"
                caseC: slurp path: cp.stringview
                input: String
                if isRaw then {
                    input = caseC.copy
                } else {
                    input = frameLsp src: caseC.stringview
                }
                inP: "\{d.stringview}/lsp_\{nm}.in"
                wri: io.writeText path: inP content: input
                match (
                    wri
                ) case ok then null case err then {
                    print "FAIL(lsp) \{nm} (write input)"
                    fails = fails + 1
                }
                outP: "\{d.stringview}/lsp_\{nm}.raw"
                ba: (List String)
                ba.append zlsB.copy
                ba.append "--replay".string
                ba.append inP.copy
                rc: (os.spawn
                    argv: ba
                    cwd: ""
                    outPath: outP.stringview
                    errPath: "/dev/null"
                    :timeoutSecs
                )
                goldP: "\{lspGold.stringview}/\{nm}.out"
                if (io.exists path: goldP) == false then {
                    skip = skip + 1
                } else {
                    rawOut: slurp path: outP.stringview
                    norm: deframeLsp raw: rawOut.stringview
                    goldC: slurp path: goldP.stringview
                    sameOut: norm.stringview == goldC.stringview
                    if sameOut when rc == 0 then {
                        passN = passN + 1
                    } else {
                        print "FAIL(lsp) \{nm}"
                        fails = fails + 1
                    }
                }
            }
        }
    } case err then null

    # ---------------- LEAK cases ----------------
    leakDirs: (List String)
    leakDirs.append from: examplesDir.copy
    leakDirs.append from: corpusDir.copy
    leakPool: (List PoolJob)
    di: u64
    for di < leakDirs.length loop {
        ld: (leakDirs.get i: di)
        lr: io.listDir path: ld
        match (
            lr
        ) case ok then {
            li: u64
            for li < lr.length loop {
                ent: (lr.get i: li)
                sfx: ent.stringview.stripSuffix s: ".z"
                match (
                    sfx
                ) case some then {
                    nm: sfx
                    lpath: "\{ld}/\{ent}"
                    if (declaresMain path: lpath.stringview) == false then {
                        li = li + 1
                        continue
                    }
                    lc: "\{d}/L_\{nm}.c"
                    lb: "\{d}/L_\{nm}.bin"
                    lerr: "\{d}/L_\{nm}.err"
                    rdir2: "\{d}/leak_\{nm}"
                    io.mkdirp path: rdir2
                    argsFile2: "\{rungold}/\{nm}.args"
                    steps: (List PoolStep)
                    za2: (zcArgv
                        zc: zc.stringview
                        ccFwd: ccFwd.stringview
                        name: nm
                        srcdir: ld.stringview
                        sys: sys.stringview
                        outc: lc.stringview
                    )
                    steps.append (mkStep
                        argv: za2
                        cwd: ""
                        outPath: "/dev/null"
                        errPath: "/dev/null"
                        timeoutSecs: 0
                        allowFail: false
                        zlinkFrom: ""
                    )
                    ga2: (gccArgv
                        cc: cc.stringview
                        ccflags: ccflags.stringview
                        bin: lb.stringview
                        csrc: lc.stringview
                        asan: true
                    )
                    steps.append (mkStep
                        argv: ga2
                        cwd: ""
                        outPath: "/dev/null"
                        errPath: "/dev/null"
                        timeoutSecs: 0
                        allowFail: false
                        zlinkFrom: lc.stringview
                    )
                    ba2: binArgv bin: lb.stringview argsFile: argsFile2.stringview
                    steps.append (mkStep
                        argv: ba2
                        cwd: rdir2.stringview
                        outPath: "/dev/null"
                        errPath: lerr.stringview
                        :timeoutSecs
                        allowFail: true
                        zlinkFrom: ""
                    )
                    leakPool.append (mkJob name: nm :steps)
                } case none then null
                li = li + 1
            }
        } case err then null
        di = di + 1
    }
    leakStatuses: (ListVal i32)
    leakFailSteps: (ListVal i64)
    os.setEnv key: "ASAN_OPTIONS" value: "detect_leaks=1"
    runJobs jobs: leakPool maxJobs: jobsMax statuses: leakStatuses failSteps: leakFailSteps
    os.unsetEnv key: "ASAN_OPTIONS"
    lji: u64
    for lji < leakPool.length loop {
        ljob: leakPool.get i: lji
        lnm: ljob.name.stringview
        lfail: leakFailSteps.get i: lji
        if lfail == -1 then {
            lerr: "\{d.stringview}/L_\{lnm}.err"
            errC: slurp path: lerr.stringview
            isKnown: false
            if (isUnsafe s: errC.stringview) then {
                print "FAIL(unsafe) \{lnm}"
                fails = fails + 1
            } else if (isLeak s: errC.stringview) then {
                if isKnown then {
                    xleak = xleak + 1
                } else {
                    print "FAIL(leak) \{lnm}"
                    fails = fails + 1
                }
            } else {
                if isKnown then {
                    print "FAIL(ratchet) \{lnm} now leak-CLEAN"
                    fails = fails + 1
                } else {
                    leakclean = leakclean + 1
                }
            }
        }
        lji = lji + 1
    }

    # ---------------- ERROR (negative) cases ----------------
    er: io.listDir path: errors
    errPool: (List PoolJob)
    match (
        er
    ) case ok then {
        ei: u64
        for ei < er.length loop {
            ent2: (er.get i: ei)
            esfx: ent2.stringview.stripSuffix s: ".z"
            match (
                esfx
            ) case some then {
                enm: esfx
                epe: "\{d}/\{enm}.pe"
                steps: (List PoolStep)
                eza: (zcArgv
                    zc: zc.stringview
                    ccFwd: ccFwd.stringview
                    name: enm
                    srcdir: errors.stringview
                    sys: sys.stringview
                    outc: "/dev/null"
                )
                exf: "\{errors.stringview}/\{enm}.zcargs"
                steps.append (mkStep
                    argv: (withExtraArgs argv: eza file: exf.stringview)
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: epe.stringview
                    timeoutSecs: 0
                    allowFail: true
                    zlinkFrom: ""
                )
                errPool.append (mkJob name: enm :steps)
            } case none then null
            ei = ei + 1
        }
    } case err then null
    errStatuses: (ListVal i32)
    errFailSteps: (ListVal i64)
    runJobs jobs: errPool maxJobs: jobsMax statuses: errStatuses failSteps: errFailSteps
    eji: u64
    for eji < errPool.length loop {
        ejob: errPool.get i: eji
        enmv: ejob.name.stringview
        epe: "\{d.stringview}/\{enmv}.pe"
        egold: "\{errors.stringview}/\{enmv}.err"
        ematch: false
        if (errStatuses.get i: eji) != 0 then {
            peC: slurp path: epe.stringview
            goldC2: slurp path: egold.stringview
            ne: normErr content: peC.stringview
            if ne.stringview == goldC2.stringview then ematch = true
        }
        if ematch then {
            passN = passN + 1
        } else {
            print "FAIL(error) \{enmv}"
            fails = fails + 1
        }
        efull: "\{errors.stringview}/\{enmv}.full"
        if (io.exists path: efull) then {
            fpeC: slurp path: epe.stringview
            fgoldC: slurp path: efull.stringview
            if fpeC.stringview == fgoldC.stringview then {
                passN = passN + 1
            } else {
                print "FAIL(error-full) \{enmv}"
                fails = fails + 1
            }
        }
        eji = eji + 1
    }

    # ---------------- DUMP (canonical state) cases ----------------
    ddC: slurp path: dumpcases.stringview
    ddv: ddC.stringview
    dumpPool: (List PoolJob)
    with ddit: ddv.lines do for ln: ddit loop {
        if ln.length > 0 then {
            nameStr: String
            dirStr: String
            idx: u64
            with sit: (ln.split sep: " ") do for pc: sit loop {
                if pc.length > 0 then {
                    if idx == 0 then {
                        nameStr = pc.string
                    } else if idx == 1 then dirStr = pc.string
                    idx = idx + 1
                }
            }
            if idx >= 2 then {
                srcAbs: "\{root.stringview}/\{dirStr.stringview}"
                dpath: "\{d.stringview}/\{nameStr.stringview}.canon"
                steps: (List PoolStep)
                da: (dumpArgv
                    zc: zc.stringview
                    name: nameStr.stringview
                    srcdir: srcAbs.stringview
                    sys: sys.stringview
                )
                # a dump case pins the whole-program model, which for a unit
                # with no `main` is the EAGER tier's -- the compiler resolves
                # what a program demands, and a program that demands nothing
                # is entitled to an empty model. `<name>.zcargs` beside the
                # source names the flag, the way an error fixture does.
                dxf: "\{srcAbs.stringview}/\{nameStr.stringview}.zcargs"
                steps.append (mkStep
                    argv: (withExtraArgs argv: da file: dxf.stringview)
                    cwd: ""
                    outPath: dpath.stringview
                    errPath: "/dev/null"
                    :timeoutSecs
                    allowFail: true
                    zlinkFrom: ""
                )
                dumpPool.append (mkJob name: nameStr.stringview :steps)
            }
        }
    }
    dumpStatuses: (ListVal i32)
    dumpFailSteps: (ListVal i64)
    runJobs jobs: dumpPool maxJobs: jobsMax statuses: dumpStatuses failSteps: dumpFailSteps
    dji: u64
    for dji < dumpPool.length loop {
        djob: dumpPool.get i: dji
        dnm: djob.name.stringview
        dpath: "\{d.stringview}/\{dnm}.canon"
        dgold: "\{dumpgold.stringview}/\{dnm}.canon"
        if (io.exists path: dgold) == false then {
            skip = skip + 1
        } else {
            gC: slurp path: dgold.stringview
            oC: slurp path: dpath.stringview
            okd: false
            if (dumpStatuses.get i: dji) == 0 then {
                if oC.stringview == gC.stringview then okd = true
            }
            if okd then {
                passN = passN + 1
            } else {
                print "FAIL(dump) \{dnm}"
                fails = fails + 1
            }
        }
        dji = dji + 1
    }

    # ---------------- DIFFERENTIAL (lexer / parser / program goldens) ----------------
    # Build the dump binaries once with the zc under test, then diff their
    # output over every example (and program fixture) against committed goldens.
    srcDir: "\{root.stringview}/src"
    lexgold: "\{root.stringview}/tests/fixtures/lexer_golden"
    parsegold: "\{root.stringview}/tests/fixtures/parser_golden"
    proggold: "\{root.stringview}/tests/fixtures/parser_program"
    zlxC: "\{d.stringview}/D_zlexer.c"
    zlxB: "\{d.stringview}/D_zlexer.bin"
    zpsC: "\{d.stringview}/D_zparser.c"
    zpsB: "\{d.stringview}/D_zparser.bin"
    lexOk: false
    parseOk: false
    zlxE: (zcArgv
        zc: zc.stringview
        ccFwd: ccFwd.stringview
        name: "zlexer"
        srcdir: srcDir.stringview
        sys: sys.stringview
        outc: zlxC.stringview
    )
    if (os.spawn
        argv: zlxE
        cwd: ""
        outPath: "/dev/null"
        errPath: "/dev/null"
        timeoutSecs: 0
    ) == 0 then {
        zlxG: (withZlink
            argv: (gccArgv
                cc: cc.stringview
                ccflags: ccflags.stringview
                bin: zlxB.stringview
                csrc: zlxC.stringview
                asan: false
            )
            csrc: zlxC.stringview
        )
        if (os.spawn
            argv: zlxG
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then lexOk = true
    }
    zpsE: (zcArgv
        zc: zc.stringview
        ccFwd: ccFwd.stringview
        name: "zparser"
        srcdir: srcDir.stringview
        sys: sys.stringview
        outc: zpsC.stringview
    )
    if (os.spawn
        argv: zpsE
        cwd: ""
        outPath: "/dev/null"
        errPath: "/dev/null"
        timeoutSecs: 0
    ) == 0 then {
        zpsG: (withZlink
            argv: (gccArgv
                cc: cc.stringview
                ccflags: ccflags.stringview
                bin: zpsB.stringview
                csrc: zpsC.stringview
                asan: false
            )
            csrc: zpsC.stringview
        )
        if (os.spawn
            argv: zpsG
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then parseOk = true
    }
    if lexOk == false then {
        print "FAIL(diff-build) zlexer"
        fails = fails + 1
    }
    if parseOk == false then {
        print "FAIL(diff-build) zparser"
        fails = fails + 1
    }
    dr: io.listDir path: examplesDir
    match (
        dr
    ) case ok then {
        ddi: u64
        for ddi < dr.length loop {
            dent: (dr.get i: ddi)
            dsfx: dent.stringview.stripSuffix s: ".z"
            match (
                dsfx
            ) case some then {
                dnm: dsfx
                exPath: "\{examplesDir}/\{dnm}.z"
                if lexOk then {
                    ltoks: "\{d}/D_\{dnm}.tokens"
                    la: (List String)
                    la.append from: zlxB.copy
                    la.append from: exPath.copy
                    (os.spawn
                        argv: la
                        cwd: ""
                        outPath: ltoks.stringview
                        errPath: "/dev/null"
                        :timeoutSecs
                    )
                    lgold: "\{lexgold}/\{dnm}.tokens"
                    if (io.exists path: lgold) then {
                        gL: slurp path: lgold.stringview
                        oL: slurp path: ltoks.stringview
                        if oL.stringview == gL.stringview then {
                            passN = passN + 1
                        } else {
                            print "FAIL(lexer) \{dnm}"
                            fails = fails + 1
                        }
                    }
                }
                if parseOk then {
                    past: "\{d}/D_\{dnm}.ast"
                    pa: (List String)
                    pa.append from: zpsB.copy
                    pa.append from: exPath.copy
                    (os.spawn
                        argv: pa
                        cwd: ""
                        outPath: past.stringview
                        errPath: "/dev/null"
                        :timeoutSecs
                    )
                    pgold: "\{parsegold}/\{dnm}.ast"
                    if (io.exists path: pgold) then {
                        gP: slurp path: pgold.stringview
                        oP: slurp path: past.stringview
                        if oP.stringview == gP.stringview then {
                            passN = passN + 1
                        } else {
                            print "FAIL(parser) \{dnm}"
                            fails = fails + 1
                        }
                    }
                }
            } case none then null
            ddi = ddi + 1
        }
    } case err then null
    if parseOk then {
        pr: io.listDir path: proggold
        match (
            pr
        ) case ok then {
            pri: u64
            for pri < pr.length loop {
                pent: (pr.get i: pri)
                ptsfx: pent.stringview.stripSuffix s: ".tree"
                match (
                    ptsfx
                ) case some then {
                    ptnm: ptsfx
                    treeDir: "\{proggold}/\{ptnm}.tree"
                    pout: "\{d}/P_\{ptnm}.out"
                    ppa: (List String)
                    ppa.append from: zpsB.copy
                    ppa.append from: "--program".string
                    ppa.append from: treeDir.copy
                    ppa.append from: "main".string
                    (os.spawn
                        argv: ppa
                        cwd: ""
                        outPath: pout.stringview
                        errPath: "/dev/null"
                        :timeoutSecs
                    )
                    pgold2: "\{proggold}/\{ptnm}.expected"
                    if (io.exists path: pgold2) then {
                        gPr: slurp path: pgold2.stringview
                        oPr: slurp path: pout.stringview
                        if oPr.stringview == gPr.stringview then {
                            passN = passN + 1
                        } else {
                            print "FAIL(program) \{ptnm}"
                            fails = fails + 1
                        }
                    }
                } case none then null
                pri = pri + 1
            }
        } case err then null
    }

    # ---------------- VFS (zvfs script dispatch) cases ----------------
    # Build zvfs once; run each zvfs_ops/*.script (substituting {ROOT} with the
    # sibling .tree fixture path, read-only) and diff stdout vs <name>.expected.
    vfsdir: "\{root.stringview}/tests/fixtures/zvfs_ops"
    zvfC: "\{d.stringview}/D_zvfs.c"
    zvfB: "\{d.stringview}/D_zvfs.bin"
    vfsOk: false
    zvfE: (zcArgv
        zc: zc.stringview
        ccFwd: ccFwd.stringview
        name: "zvfs"
        srcdir: srcDir.stringview
        sys: sys.stringview
        outc: zvfC.stringview
    )
    if (os.spawn
        argv: zvfE
        cwd: ""
        outPath: "/dev/null"
        errPath: "/dev/null"
        timeoutSecs: 0
    ) == 0 then {
        zvfG: (withZlink
            argv: (gccArgv
                cc: cc.stringview
                ccflags: ccflags.stringview
                bin: zvfB.stringview
                csrc: zvfC.stringview
                asan: false
            )
            csrc: zvfC.stringview
        )
        if (os.spawn
            argv: zvfG
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then vfsOk = true
    }
    if vfsOk == false then {
        print "FAIL(vfs-build) zvfs"
        fails = fails + 1
    }
    if vfsOk then {
        vr: io.listDir path: vfsdir
        match (
            vr
        ) case ok then {
            vi: u64
            for vi < vr.length loop {
                vent: (vr.get i: vi)
                vsfx: vent.stringview.stripSuffix s: ".script"
                match (
                    vsfx
                ) case some then {
                    vnm: vsfx
                    scriptPath: "\{vfsdir}/\{vnm}.script"
                    treePath: "\{vfsdir}/\{vnm}.tree"
                    rawScript: slurp path: scriptPath.stringview
                    subst: (rawScript.stringview.replace
                        needle: "{ROOT}"
                        replacement: treePath
                    )
                    tmpScript: "\{d}/V_\{vnm}.script"
                    io.writeText path: tmpScript content: subst
                    vout: "\{d}/V_\{vnm}.out"
                    va: (List String)
                    va.append from: zvfB.copy
                    va.append from: tmpScript.copy
                    (os.spawn
                        argv: va
                        cwd: ""
                        outPath: vout.stringview
                        errPath: "/dev/null"
                        :timeoutSecs
                    )
                    vgold: "\{vfsdir}/\{vnm}.expected"
                    if (io.exists path: vgold) then {
                        gV: slurp path: vgold.stringview
                        oV: slurp path: vout.stringview
                        if oV.stringview == gV.stringview then {
                            passN = passN + 1
                        } else {
                            print "FAIL(vfs) \{vnm}"
                            fails = fails + 1
                        }
                    }
                } case none then null
                vi = vi + 1
            }
        } case err then null
    }

    # ---------------- SMOKE (per-unit no-arg golden) cases ----------------
    smokecases: "\{root.stringview}/tests/fixtures/smoke_cases.txt"
    scC: slurp path: smokecases.stringview
    scv: scC.stringview
    smokePool: (List PoolJob)
    with scit: scv.lines do for sln: scit loop {
        if sln.length > 0 then {
            nameStr: String
            dirStr: String
            idx: u64
            with sit: (sln.split sep: " ") do for pc: sit loop {
                if pc.length > 0 then {
                    if idx == 0 then {
                        nameStr = pc.string
                    } else if idx == 1 then dirStr = pc.string
                    idx = idx + 1
                }
            }
            if idx >= 2 then {
                srcAbs: "\{root.stringview}/\{dirStr.stringview}"
                cpath: "\{d.stringview}/S_\{nameStr.stringview}.c"
                bpath: "\{d.stringview}/S_\{nameStr.stringview}.bin"
                opath: "\{d.stringview}/S_\{nameStr.stringview}.out"
                steps: (List PoolStep)
                za: (zcArgv
                    zc: zc.stringview
                    ccFwd: ccFwd.stringview
                    name: nameStr.stringview
                    srcdir: srcAbs.stringview
                    sys: sys.stringview
                    outc: cpath.stringview
                )
                steps.append (mkStep
                    argv: za
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                    allowFail: false
                    zlinkFrom: ""
                )
                ga: (gccArgv
                    cc: cc.stringview
                    ccflags: ccflags.stringview
                    bin: bpath.stringview
                    csrc: cpath.stringview
                    asan: false
                )
                steps.append (mkStep
                    argv: ga
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                    allowFail: false
                    zlinkFrom: cpath.stringview
                )
                ba: binArgv bin: bpath.stringview argsFile: ""
                steps.append (mkStep
                    argv: ba
                    cwd: ""
                    outPath: opath.stringview
                    errPath: "/dev/null"
                    :timeoutSecs
                    allowFail: true
                    zlinkFrom: ""
                )
                smokePool.append (mkJob name: nameStr.stringview :steps)
            }
        }
    }
    smokeStatuses: (ListVal i32)
    smokeFailSteps: (ListVal i64)
    runJobs jobs: smokePool maxJobs: jobsMax statuses: smokeStatuses failSteps: smokeFailSteps
    sji: u64
    for sji < smokePool.length loop {
        sjob: smokePool.get i: sji
        snm: sjob.name.stringview
        sfail: smokeFailSteps.get i: sji
        if sfail == 0 then {
            print "FAIL(smoke-emit) \{snm}"
            fails = fails + 1
        } else if sfail == 1 then {
            print "FAIL(smoke-build) \{snm}"
            fails = fails + 1
        } else {
            opath: "\{d.stringview}/S_\{snm}.out"
            gold: "\{root.stringview}/tests/fixtures/\{snm}_z/smoke.expected"
            if (io.exists path: gold) == false then {
                skip = skip + 1
            } else {
                goldC: slurp path: gold.stringview
                outC: slurp path: opath.stringview
                sameS: outC.stringview == goldC.stringview
                if sameS when (smokeStatuses.get i: sji) == 0 then {
                    passN = passN + 1
                } else {
                    print "FAIL(smoke) \{snm}"
                    fails = fails + 1
                }
            }
        }
        sji = sji + 1
    }

    # ---------------- SELFHOST-ASAN (heavy) ----------------
    # Build zc itself with ASan, then run it as the compiler over every example
    # and corpus unit in both --emit-c and --dump-sql modes; the COMPILER must
    # be UAF-/leak-free. Heavy (one ASan gcc of zc.c + two runs per unit).
    if heavy then {
        zcaC: "\{d.stringview}/zca.c"
        zcaB: "\{d.stringview}/zca.bin"
        zcaOk: false
        ea: (zcArgv
            zc: zc.stringview
            ccFwd: ccFwd.stringview
            name: "zc"
            srcdir: srcDir.stringview
            sys: sys.stringview
            outc: zcaC.stringview
        )
        if (os.spawn
            argv: ea
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then {
            gza: (withZlink
                argv: (gccArgv
                    cc: cc.stringview
                    ccflags: ccflags.stringview
                    bin: zcaB.stringview
                    csrc: zcaC.stringview
                    asan: true
                )
                csrc: zcaC.stringview
            )
            if (os.spawn
                argv: gza
                cwd: ""
                outPath: "/dev/null"
                errPath: "/dev/null"
                timeoutSecs: 0
            ) == 0 then zcaOk = true
        }
        if zcaOk == false then {
            print "FAIL(selfhost-asan-build) zc"
            fails = fails + 1
        }
        if zcaOk then {
            os.setEnv key: "ASAN_OPTIONS" value: "detect_leaks=1"
            saDirs: (List String)
            saDirs.append from: examplesDir.copy
            saDirs.append from: corpusDir.copy
            sdi: u64
            for sdi < saDirs.length loop {
                sad: (saDirs.get i: sdi)
                sar: io.listDir path: sad
                match (
                    sar
                ) case ok then {
                    sai: u64
                    for sai < sar.length loop {
                        sent: (sar.get i: sai)
                        ssfx: sent.stringview.stripSuffix s: ".z"
                        match (
                            ssfx
                        ) case some then {
                            snm: ssfx
                            saerr1: "\{d}/SA1_\{snm}.err"
                            m1: (List String)
                            m1.append from: zcaB.copy
                            m1.append from: snm.string
                            m1.append from: "--src".string
                            m1.append from: sad.copy
                            m1.append from: "--system".string
                            m1.append from: sys.copy
                            m1.append from: "--emit-c".string
                            m1.append from: "/dev/null".string
                            (os.spawn
                                argv: m1
                                cwd: ""
                                outPath: "/dev/null"
                                errPath: saerr1.stringview
                                :timeoutSecs
                            )
                            e1C: slurp path: saerr1.stringview
                            if (isUnsafe s: e1C.stringview) then {
                                print "FAIL(selfhost-asan) \{snm} emit-c unsafe"
                                fails = fails + 1
                            } else if (isLeak s: e1C.stringview) then {
                                print "FAIL(selfhost-asan) \{snm} emit-c leak"
                                fails = fails + 1
                            } else {
                                leakclean = leakclean + 1
                            }
                            saerr2: "\{d}/SA2_\{snm}.err"
                            m2: (List String)
                            m2.append from: zcaB.copy
                            m2.append from: snm.string
                            m2.append from: "--src".string
                            m2.append from: sad.copy
                            m2.append from: "--system".string
                            m2.append from: sys.copy
                            m2.append from: "--dump-sql".string
                            m2.append from: "-".string
                            (os.spawn
                                argv: m2
                                cwd: ""
                                outPath: "/dev/null"
                                errPath: saerr2.stringview
                                :timeoutSecs
                            )
                            e2C: slurp path: saerr2.stringview
                            if (isUnsafe s: e2C.stringview) then {
                                print "FAIL(selfhost-asan) \{snm} dump-sql unsafe"
                                fails = fails + 1
                            } else if (isLeak s: e2C.stringview) then {
                                print "FAIL(selfhost-asan) \{snm} dump-sql leak"
                                fails = fails + 1
                            } else {
                                leakclean = leakclean + 1
                            }
                        } case none then null
                        sai = sai + 1
                    }
                } case err then null
                sdi = sdi + 1
            }
            os.unsetEnv key: "ASAN_OPTIONS"
        }
    }

    # ---------------- FIXPOINT (heavy) ----------------
    # Self-host byte-identity: zc emitted by --zc, rebuilt, must re-emit itself
    # identically. Heavy (two zc self-emits + one gcc of zc.c) -- opt-in.
    if heavy then {
        fp1: "\{d.stringview}/fp1.c"
        fp1bin: "\{d.stringview}/fp1.bin"
        fp2: "\{d.stringview}/fp2.c"
        fpOk: false
        e1: (zcArgv
            zc: zc.stringview
            ccFwd: ccFwd.stringview
            name: "zc"
            srcdir: srcDir.stringview
            sys: sys.stringview
            outc: fp1.stringview
        )
        if (os.spawn
            argv: e1
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then {
            g1: (withZlink
                argv: (gccArgv
                    cc: cc.stringview
                    ccflags: ccflags.stringview
                    bin: fp1bin.stringview
                    csrc: fp1.stringview
                    asan: false
                )
                csrc: fp1.stringview
            )
            if (os.spawn
                argv: g1
                cwd: ""
                outPath: "/dev/null"
                errPath: "/dev/null"
                timeoutSecs: 0
            ) == 0 then {
                e2: (zcArgv
                    zc: fp1bin.stringview
                    ccFwd: ccFwd.stringview
                    name: "zc"
                    srcdir: srcDir.stringview
                    sys: sys.stringview
                    outc: fp2.stringview
                )
                if (os.spawn
                    argv: e2
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                ) == 0 then {
                    c1: slurp path: fp1.stringview
                    c2: slurp path: fp2.stringview
                    if c1.stringview == c2.stringview then fpOk = true
                }
            }
        }
        if fpOk then {
            passN = passN + 1
        } else {
            print "FAIL(fixpoint) zc stage1 != stage2"
            fails = fails + 1
        }
    }

    # ---------------- summary ----------------
    if saveTemps then {
        print "kept test artifacts at \{d.stringview}"
    } else {
        io.removeTree path: d.stringview
    }
    print "----"
    print "pass=\{passN} leak-clean=\{leakclean} xfail=\{xfail} xleak=\{xleak} skip=\{skip} fails=\{fails}"
    if report then {
        os.exit code: 0
    }
    if fails == 0 then {
        print "CORPUS GATE GREEN"
        os.exit code: 0
    } else {
        print "CORPUS GATE FAILED (\{fails})"
        os.exit code: 1
    }
}
