# ztestrunner.z -- the self-hosted corpus test gate, driven entirely by
# os.spawn. Case kinds, each compared to a committed golden under
# tests/fixtures:
#   run      run_cases.zd (+ matrix_cases.zd, cpar_cases.zd) -> emit -> cc
#            -> run; stdout matches run_golden/<n>.out, exit code matches
#            <n>.exit (0 default) -- <n>.<os>.out / .exit where the system the
#            case is built for has its own. A case marked `posix` checks
#            something only POSIX has, and a build for Windows skips it
#            (listed as such)
#   lsp      framed JSON-RPC transcripts replayed through zls
#   leak     every buildable example + emitc_corpus program under the
#            SANITIZER ITS COMPILER HAS -- ASan with detect_leaks=1 for gcc and
#            clang, `-b` with TCC_BOUNDS_PRINT_HEAP for tcc, which has no ASan
#            at all. No use-after-free, no double free, nothing held at exit
#            outside tests/known/leaks.zd. The spelling is proved to work on a
#            deliberate leak before any verdict is trusted (proveSanitizer).
#   error    errors/<n>.z must fail with the error[Exxxx] lines of <n>.err
#   errcode  every error zast.errFacts lists is reported by some golden
#   lone     every run case, with one unrelated error written at the top of
#            `main`, reports that error and no other
#   dump     dump_cases.zd -> `zc dump --canon` matches dump_golden/<n>.canon
#   docpage  docs/*.html is what the renderer writes from its .pdoc, a link
#            between pages names a page and an anchor that exist, and the
#            code table of docs/errors.pdoc is zast.errFacts' (docErrorTable)
#   lexer / parser / program goldens for every example
#   vfs      zvfs script dispatch
#   smoke    per-unit no-arg binaries against <unit>_z/smoke.expected
#   usage    a driver (zc, zl, zgate, the runner itself) given a command line:
#            what it says and its exit code match the case's expected files
#   vocab    the spec and the three highlighters carry the lexer's keywords
#            and reserved words, and core.z's names (src/ztestrunner/vocab.z)
#   pins     counts the compiler's own source is held at, each a text in the
#            code of a set of files (src/ztestrunner/pins.z)
#   fixtures every program declaring `main` is in a case list, no list names
#            a case twice, and no fixture breaks L023 (src/ztestrunner/fixtures.z)
#   natives  zc natives show places what zc emit --mark-natives marks
#   usernative  a unit outside the standard library builds and runs its own
#            natives; check rows refuses a mistyped key
#   piece    zc natives check needs reports a record taken out of the emitter
#   statictcc  no libtcc symbol is linked into the drivers beside --zc
#   cobj     a unit's C source builds once through the object cache
#   linemarks  zc --line-marks adds directives only, the run cases build and
#            run with them, and gcov reads the fixture's lines from them
#            (src/ztestrunner/linemarks.z)
#   --heavy adds the self-host ASan run and the byte-identity fixpoint.
# These kinds run only by `--only KIND` (each a Makefile leg):
#   emitted  what the emitted C of every program holds, read from one shared
#            emit (src/ztestrunner/emitted.z; baselines in expected.z)
#   probes   ThreadSanitizer, with --cc, reports a race made on purpose
#   pedantic the C of the drivers and the run cases, for --target, has no
#            -Wpedantic diagnostic under --cc
#   ctest    the C test programs, tests/c/*_test.c, built by --cc and run
#            under --exec, against tests/c/<name>_test.out
# The run kind also takes --zc-flag (each run case's zc gets the flag),
# --zc-build (zc builds each case itself, with --cc's compiler), --repeat N
# (a case that passed runs N more times), --cases / --cases-naming (a
# subset) and --known (the expected failures).
#
# Usage: ztestrunner --zc <zc> --cc gcc --root <repo> [--jobs N] [--heavy] [--report]
#   `ztestrunner --help` lists every flag. The command line is read by `cli`:
#   an option the runner does not declare, an option with no value, a number
#   that is none and an operand are each refused on stderr with exit 2.
#   --jobs defaults to os.cpuCount, so it follows the machine it runs on.
#   --regen-lsp rewrites every tests/fixtures/lsp_golden/*.out from this run's
#   answers instead of comparing against them.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

# slurp -- file content as an owned String, or "" when unreadable (zjobs.slurp)
slurp: zjobs.slurp

# PoolStep, PoolJob -- a spawn of a job and a job, of the job pool (zjobs)
PoolStep: zjobs.PoolStep
PoolJob: zjobs.PoolJob

# declaresMain -- the file declares a top-level `main: function`. A unit with
# none is a LIBRARY: it exists to be opened by another program and is compiled
# through its dependant, so compiling it AS a program is E0039. The two sweeps
# below walk a whole directory rather than a case list, so they are the only
# places that would hand one to the compiler on its own. The fixtures kind
# reads a program's `main` the same way.
declaresMain: function {path: StringView} out bool is {
    c: slurp :path
    for each ln: c.stringView.lines loop {
        if (ln.startsWith prefix: "main:") then {
            # bound, not chained: `(a.substring ...).trimStart` emits broken C
            # (the native is called undeclared, and the emitter takes & of the
            # call's result). Pre-existing; the seed compiler does it too.
            a: ln.substring from: 5 to: ln.length
            r: a.trimStart
            if (r.startsWith prefix: "function") then return true
        }
    }
    return false
}

# normErr -- keep only the stable error contract: the error code+message
# lines and the "N error(s) found" summary, each newline-terminated.
# Mirrors run_corpus.sh's grep -aE '^error\[E..\]:|[0-9]+ error(s)? found'.
normErr: function {content: StringView} out String is {
    buf: String
    for each ln: content.lines loop {
        keep: (
            (ln.startsWith prefix: "error[E") or
            (ln.endsWith suffix: "error found") or
            (ln.endsWith suffix: "errors found")
        )
        if keep then {
            buf.append ln
            buf.append "\n"
        }
    }
    return buf
}

# usesBoundsChecker -- whether this compiler's sanitizer is tcc's `-b` bounds
# checker rather than ASan. Everything that has to BRANCH asks this rather than
# comparing a family name, so the question is asked once and in one spelling.
usesBoundsChecker: function {ccPath: StringView} out bool is {
    return (zcc.ccFamilyOf :ccPath).tcc
}

# sanEnvKey / sanEnvValue -- the environment a sanitized run needs. ASan wants
# leak detection turned on; tcc's bounds checker wants its heap report turned
# on (bcheck.c reads the name's PRESENCE, so any value will do).
sanEnvKey: function {bounds: bool} out String is {
    if bounds then return "TCC_BOUNDS_PRINT_HEAP".string
    return "ASAN_OPTIONS".string
}

# the sanitizer options string for a run: the two families do not measure
# the same thing, so the value travels with the verdict
sanEnvValue: function {bounds: bool} out String is {
    if bounds then return "1".string
    return "detect_leaks=1".string
}

# isUnsafe -- the sanitizer reported a memory-safety violation, not a leak.
# Two spellings because they are two different tools: gcc and clang have ASan,
# tcc has its own bounds checker (`-b`) and no ASan at all -- it ACCEPTS
# -fsanitize=address and ignores it, which is how 453 cases were once reported
# leak-clean by a check that never ran. Under ASan EVERY AddressSanitizer
# report is a violation -- a read past a global array is a
# global-buffer-overflow, which a list of the heap and stack kinds missed -- and
# a leak is LeakSanitizer's, a different prefix; UBSan's bounds check reports a
# `runtime error`.
isUnsafe: function {bounds: bool s: StringView} out bool is {
    if bounds then {
        return (
            (s.contains needle: "BCHECK: ") or
            (
                s.contains
                needle: "RUNTIME ERROR: invalid memory access"
            )
        )
    }
    return (
        (s.contains needle: "ERROR: AddressSanitizer: ") or (s.contains needle: ": runtime error: ")
    )
}

# isLeak -- the sanitizer reported memory still held at exit.
#
# The two tools do NOT measure the same thing, and the difference is visible in
# the corpus. ASan reports what is definitely LOST; tcc's bounds checker prints
# every block still live at exit, reachable or not. So a program that ends in
# `os.exit` -- which skips zerolang's destructors by design -- is clean under
# ASan and reports blocks under tcc. That is why the known-leak set is keyed by
# family and not by name alone.
isLeak: function {bounds: bool s: StringView} out bool is {
    if bounds then return (s.contains needle: "__bound_exit(): malloc found size")
    if (s.contains needle: "SUMMARY: AddressSanitizer:").not then return false
    return (s.contains needle: " byte")
}

# zcArgv -- the zc emit command argv, one `--src` per entry of `srcdirs`, in
# order. `ccFwd`, when non-empty, names the C compiler to zc ITSELF rather than
# only to the harness's compile step: the C backend refuses a unit the
# compiler cannot build (f128 under tcc), so the emit decides differently with
# it than without. Empty by default, which leaves zc on its own resolution of
# the compiler.
zcArgv: function {
    zc: StringView
    ccFwd: StringView
    name: StringView
    srcdirs: (List String).view
    sys: StringView
    outc: StringView
} out List String is {
    a: List String
    a.append from: zc.string
    a.append from: name.string
    if ccFwd.length > 0 then {
        a.append from: "--cc".string
        a.append from: ccFwd.string
    }
    for each d: srcdirs loop {
        a.append from: "--src".string
        a.append from: d.copy
    }
    a.append from: "--system".string
    a.append from: sys.string
    a.append from: "--emit-c".string
    a.append from: outc.string
    return a
}

# oneDir -- a single source root, as zcArgv takes its roots
oneDir: function {d: StringView} out List String is {
    l: List String
    l.append from: d.string
    return l
}

# caseDirs -- the source roots of case program `c` under the repository
# `root`: its own directory first, then its `roots`
caseDirs: function {root: StringView c: CaseProgram.view} out List String is {
    l: List String
    l.append (path.join a: root b: c.dir.stringView)
    for each d: c.roots loop l.append (path.join a: root b: d.stringView)
    return l
}

# dumpArgv -- the canonical-state dump command argv (dump --canon).
dumpArgv: function {
    zc: StringView
    name: StringView
    srcdir: StringView
    sys: StringView
} out List String is {
    a: List String
    a.append from: zc.string
    a.append from: "dump".string
    a.append from: name.string
    a.append from: "--src".string
    a.append from: srcdir.string
    a.append from: "--system".string
    a.append from: sys.string
    a.append from: "--canon".string
    return a
}

# withExtraArgs -- `argv` plus one element per non-empty line of `file`. An
# error fixture that needs a compiler flag -- `--cc tcc`, to prove a refusal
# fires without tcc installed -- names it in <name>.zcargs beside its
# .err golden, the way a run case names its program's argv in <name>.args.
# An absent file reads as empty, since slurp returns "" for an unreadable path.
withExtraArgs: function {argv: (List String).take file: StringView} out List String is {
    argsText: slurp path: file
    argsView: argsText.stringView
    for each line: argsView.lines loop {
        if line.length > 0 then {
            argv.append from: line.string
        }
    }
    return argv
}

# fixtureNames -- the entries of `dir` that end in `suffix`, without it, in the
# order the directory lists them. A directory that cannot be listed is an
# empty list: the kinds that walk one had nothing to say about that either.
fixtureNames: function {dir: StringView suffix: StringView} out List String is {
    names: List String
    ls: io.listDir path: dir
    if ls.err then return names
    for each ent: ls loop {
        sfx: ent.stringView.stripSuffix s: suffix
        if sfx.some then names.append from: sfx.string
    }
    return names
}

# buildstep -- how far buildTool got: the tool is built, or the step that
# failed.
buildstep: variant {
    built: null
    emit: null
    compile: null
} as { tag: u8.tag }

# buildTool -- the two-step ladder every driver-building kind climbs: emit
# `name` with the zc at `zc` into `csrc`, then compile that C to `bin` with
# the runner's C compiler. Answers how far it got, so a kind names the failed
# step in its own FAIL line. `srcdirs` are the source roots, in
# order.
buildTool: function {
    r: Runner.view
    zc: StringView
    name: StringView
    srcdirs: (List String).view
    csrc: StringView
    bin: StringView
    asan: bool
} out buildstep is {
    ea: zcArgv :zc ccFwd: r.ccFwd.stringView :name :srcdirs sys: r.sys.stringView outc: csrc
    if (
        (
            os.spawn
            argv: ea
            cwd: ""
            outPath: os.nullDevice.stringView
            errPath: os.nullDevice.stringView
            timeoutSecs: 0
        ) !=
        0
    ) then return buildstep.emit
    ga: (
        zjobs.withZlink
        argv: (
            ccArgv
            cc: r.cc.stringView
            ccflags: r.ccflags.stringView
            target: r.target.stringView
            :bin
            :csrc
            :asan
        )
        :csrc
        zc: r.zc.stringView
    )
    if (
        (
            os.spawn
            argv: ga
            cwd: ""
            outPath: os.nullDevice.stringView
            errPath: os.nullDevice.stringView
            timeoutSecs: 0
        ) !=
        0
    ) then return buildstep.compile
    return buildstep.built
}

# ccArgv -- the C build command argv; `asan` selects the SANITIZED build over
# the strict CF set. `ccflags` carries what the harness cannot infer about the
# compiler -- tcc needs `-B <payload>` or it cannot resolve its own stddef.h,
# since the directory it was configured with is not the one it is running from.
#
# The sanitizer flags are chosen by compiler family, because there is no one
# spelling: gcc and clang have ASan, tcc has `-b` and no ASan. Appending
# -fsanitize=address to tcc is worse than useless -- tcc accepts it, warns
# nothing, and produces a binary with no instrumentation, so the harness went
# on reporting a leak verdict it had not measured. Nothing is appended here
# whose effect the runner has not established; runLeakCases proves the chosen
# spelling really reports a leak before it trusts a single verdict.
#
# cl takes its own spellings (zcc.msvcFlags) and builds the unsanitized program
# only, its paths spelled through zcc.msvcPath.
ccArgv: function {
    cc: StringView
    ccflags: StringView
    # the --target triple, empty for the host: a build for Windows links the
    # compiler's runtime libraries statically, as `zc build` does, and names no
    # libm -- its math is the C runtime's
    target: StringView
    bin: StringView
    csrc: StringView
    asan: bool
} out List String is {
    fam: zcc.ccFamilyOf ccPath: cc
    if fam.msvc then return (msvcArgv :cc :ccflags :bin :csrc)
    a: List String
    a.append from: cc.string
    for each ccFlag: (ccflags.split sep: " ") loop {
        if ccFlag.length > 0 then a.append from: ccFlag.string
    }
    if asan then {
        if (usesBoundsChecker ccPath: cc) then {
            a.append from: "-b".string
            a.append from: "-g".string
            a.append from: "-w".string
        } else {
            a.append from: "-fsanitize=address".string
            # an index past the end of a C array (a list's static one,
            # an array's inline storage) aborts rather than reads on
            a.append from: "-fsanitize=bounds".string
            a.append from: "-fno-sanitize-recover=bounds".string
            a.append from: "-g".string
            a.append from: "-O0".string
            a.append from: "-std=c17".string
            a.append from: "-w".string
        }
    } else {
        a.append from: "-std=c17".string
        a.append from: "-Wall".string
        a.append from: "-Wextra".string
        a.append from: "-Werror=unused-function".string
        a.append from: "-Wno-unused-parameter".string
        a.append from: "-Werror=implicit-function-declaration".string
        a.append from: "-Werror=implicit-int".string
        a.append from: "-Werror=int-conversion".string
        a.append from: "-Werror=incompatible-pointer-types".string
        # a view is `const` in the C: a discarded qualifier is the emitter
        # writing through, or a reader that did not take const
        a.append from: "-Werror=discarded-qualifiers".string
        # a function with a result whose end the C can reach: the emitter
        # writes `z_unreachable()` after every path that leaves, and a missing
        # one would fall off the end of the function
        a.append from: "-Werror=return-type".string
    }
    windows: ztarget.targetIsWindows triple: target
    # not tcc's: its runtime is always linked in, and under -static it would
    # take libraries only as archives, never through its .def import lists
    if windows when fam.tcc.not then a.append from: "-static".string
    for each outArg: (zcc.outputArgs f: fam exe: bin) loop a.append from: outArg.copy
    a.append from: csrc.string
    if windows.not then a.append from: "-lm".string
    for each sa: (zcc.mainStackArgs f: fam :windows) loop a.append from: sa.copy
    return a
}

# msvcArgv -- ccArgv for cl: its own spellings, then the C file, its object
# beside it rather than in the directory the runner runs in, the executable,
# and the main stack the linker reserves (zcc.mainStackArgs).
msvcArgv: function {
    cc: StringView
    ccflags: StringView
    bin: StringView
    csrc: StringView
} out List String is {
    a: List String
    a.append from: cc.string
    for each mf: zcc.msvcFlags loop a.append from: mf.copy
    for each cf: (ccflags.split sep: " ") loop {
        if cf.length > 0 then a.append from: cf.string
    }
    a.append from: (zcc.msvcPath p: csrc)
    od: path.dirname p: csrc
    a.append from: "-Fo:\{zcc.msvcPath p: od.stringView}/"
    outs: zcc.outputArgs f: zcc.ccfamily.msvc exe: bin
    for each of: outs loop a.append from: of.copy
    a.append from: "-link".string
    for each sa: (zcc.mainStackArgs f: zcc.ccfamily.msvc windows: true) loop a.append from: sa.copy
    return a
}

# binArgv -- the test-binary argv: the binary plus one element per
# non-empty line of run_golden/<name>.args (absent file -> just the bin).
binArgv: function {bin: StringView argsFile: StringView} out List String is {
    a: List String
    a.append from: bin.string
    ac: slurp path: argsFile
    acv: ac.stringView
    for each ln: acv.lines loop {
        if ln.length > 0 then {
            a.append from: ln.string
        }
    }
    return a
}

# frameLsp -- wrap each non-empty line of a .msgs transcript in LSP
# Content-Length framing (the bytes zls reads on its --replay input).
frameLsp: function {src: StringView} out String is {
    result: String
    for each ln: src.lines loop {
        if ln.length > 0 then {
            n: ln.length
            h: "Content-Length: \{n}"
            result.append h
            result.appendByte b: ascii.cr
            result.append "\n"
            result.appendByte b: ascii.cr
            result.append "\n"
            result.append ln
        }
    }
    return result
}

# deframeLsp -- zls output back to one JSON body per line. The server
# emits the exact form "Content-Length: N\r\n\r\n<body>"; anything
# else surfaces as a literal marker line so the diff fails loudly.
deframeLsp: function {raw: StringView} out String is {
    words: zast.Vocab.create block: runnerWord
    result: String
    pos: u64
    n: raw.length
    for pos < n loop {
        if (pos + 16) > n then {
            result.append "<<deframe error: truncated header>>"
            result.append "\n"
            return result
        }
        okHdr: false
        hd: raw.substring from: pos to: pos + 16
        if (words.slotOf text: hd) == runnerWord.slot.lspHeader then okHdr = true
        if okHdr.not then {
            result.append "<<deframe error: bad prefix>>"
            result.append "\n"
            return result
        }
        clen: u64
        i: pos + 16
        for true loop {
            bo: raw.byteAt :i
            match (
                bo
            ) case some then {
                if (ascii.isDigit b: bo) then {
                    clen = clen * 10 + (bo.u64 - 0c0)
                    i = i + 1
                } else {
                    break
                }
            } case none then {
                break
            }
        }
        i = i + 4
        j: u64
        for j < clen loop {
            bo2: raw.byteAt :i
            if bo2.some then {
                result.appendByte b: bo2
            }
            i = i + 1
            j = j + 1
        }
        result.append "\n"
        pos = i
    }
    return result
}

# runnerWord -- every word the runner reads off outside text: the LSP frame
# header and its own name. A word is classified by its
# slot here (zast.Vocab), never by comparing its text.
runnerWord: list {
    lspHeader: "Content-Length: "
    # the driver a USAGE case names when it runs the runner itself
    ownName: "ztestrunner"
    # the driver a usage case's `args` names that is the compiler under test
    zcName: "zc"
    # what a USAGE case's `cwd` file says when its driver runs in the case's
    # own empty directory
    scratchCwd: "scratch"
} out staticlist StringView

# opt -- the name of each flag and option the runner takes, as it is written
# on the command line. The spec declares them and runnerFrom reads them back by
# the same names.
opt: list {
    ccForward: "--cc-forward"
    report: "--report"
    heavy: "--heavy"
    stopEarly: "--stop-early"
    saveTemps: "--save-temps"
    regenLsp: "--regen-lsp"
    regenUsage: "--regen-usage"
    only: "--only"
    help: "--help"
    zc: "--zc"
    cc: "--cc"
    ccflags: "--ccflags"
    root: "--root"
    jobs: "--jobs"
    timeout: "--timeout"
    target: "--target"
    exec: "--exec"
    tmp: "--tmp"
    known: "--known"
    cases: "--cases"
    casesNaming: "--cases-naming"
    zcFlag: "--zc-flag"
    repeats: "--repeat"
    zcBuild: "--zc-build"
} out staticlist StringView

# kindWord -- the kinds `--only` runs alone, by the word it is given
kindWord: list {
    # the RUN cases, the only kind whose programs can be built for another
    # target (`make test-mingw`)
    run: "run"
    # the examples and the pages of the documentation (`make doc-check`)
    doccode: "doccode"
    # the nativec agreement check (`make nativec-agree-guard`)
    agree: "agree"
    # the architecture ratchet (`make arch-check`)
    arch: "arch"
    # what the emitted C holds, read from one shared emit (`make emitted-check`)
    emitted: "emitted"
    # the spec and the highlighters carry the lexer's words (also in `make test`)
    vocab: "vocab"
    # the counts the compiler's own source is held at (also in `make test`)
    pins: "pins"
    # what the fixtures themselves must hold (also in `make test`)
    fixtures: "fixtures"
    # the drivers' command lines, judged by what they print and how they exit
    usage: "usage"
    # a sanitizer reports the fault it exists to find (`make thread-tsan-guard`)
    probes: "probes"
    # the emitted C has no -Wpedantic diagnostic (`make pedantic-check`)
    pedantic: "pedantic"
    # the C test programs, tests/c/*_test.c (`make shim-guard`)
    ctest: "ctest"
    # what ci-windows built, judged on a Windows host itself (`make
    # windows-guest`)
    windows: "windows"
    # zc natives show places what zc emit --mark-natives marks (also in `make test`)
    natives: "natives"
    # a unit outside the standard library builds and runs its own natives
    # (also in `make test`)
    usernative: "usernative"
    # the emitter's needs hold to what its C calls, piece by piece (also in
    # `make test`)
    piece: "piece"
    # no libtcc symbol is linked into the drivers (also in `make test`)
    statictcc: "statictcc"
    # a unit's C source builds through the object cache (also in `make test`)
    cobj: "cobj"
    # zc --line-marks adds directives only, and they name the right lines (also
    # in `make test`)
    linemarks: "linemarks"
} out staticlist StringView

# test-runner entry point: build the compiler, run the
# run/leak/error/dump/lsp suites, and report pass/fail counts.
# Runner -- the gate's configuration, the fixture paths and the counters every
# case kind reads and advances. One per run; the kinds take it by reference.
Runner: class {
    # the repository root every other path is derived from
    root: String
    # the compiler under test
    zc: String
    # the C compiler its output is built with
    cc: String
    # flags passed to that C compiler
    ccflags: String
    # flags forwarded THROUGH zc to the C compiler, which is not the same list
    ccFwd: String
    # whether --cc-forward asked for `cc` to be forwarded; resolved after the
    # whole command line is read
    ccFwdOn: bool
    # the stdlib directory
    sys: String
    # the scratch directory (--tmp, else a pid-named one under os.tempDir); kept when
    # saveTemps is set, removed otherwise
    tmp: String
    # the RUN cases' expected failures (--known): a file of `<case> (<why>)`
    # lines; empty when none is given, and every failure fails
    known: String
    # the RUN cases --cases selects, each a name prefix or a directory column;
    # empty selects every case
    cases: List String
    # the words --cases-naming selects a RUN case by: one its source names
    cases2: List String
    # what --zc-flag adds to each RUN case's zc command line, in order
    zcFlags: List String
    # how many more times each RUN case that passed runs (--repeat), every run
    # judged against its goldens: a race shows only in some schedules
    repeats: u64
    # whether zc builds each RUN case itself (--zc-build: `zc build`, with the C
    # compiler --cc names), in place of emitting C the runner compiles
    zcBuild: bool
    # how many jobs run at once. It comes from the machine rather than a typed
    # number, a default of 1 being silently serial on a many-core box
    jobsMax: u64
    # the per-step timeout every job inherits
    timeoutSecs: i32
    # whether the heavy kinds run: the self-host ASan pass, the byte-identity
    # fixpoint and the doc ratchet
    heavy: bool
    # stop a full run once a case has failed: after the error cases, inside
    # the run cases, and after the leak cases (stopsEarly). For a run that only
    # asks whether everything passes
    stopEarly: bool
    # exit 0 whatever happened, for a run that is gathering numbers rather than
    # gating
    report: bool
    # keep the scratch directory, so a failure can be inspected after the run
    saveTemps: bool
    # rewrite the LSP goldens from this run's answers instead of comparing
    regenLsp: bool
    # rewrite the expected files each USAGE case has from this run's answers
    # instead of comparing against them
    regenUsage: bool
    # the kind `--only` runs alone, by its slot in kindWord; kindWord's length
    # when every kind runs
    only: u64
    # the triple the RUN cases are built for (zc --target); empty builds for
    # the host. Only with `--only run`: every other kind runs what it builds
    target: String
    # the program each RUN case's binary is run under (wine for a Windows
    # build); empty runs it directly
    exec: String
    # the error-case directory
    errors: String
    # where the RUN cases' expected output lives
    rungold: String
    # the examples directory
    examplesDir: String
    # the emitc corpus directory
    corpusDir: String
    # where the dump cases' expected output lives
    dumpgold: String
    # the compiler's own source, which the arch and doc ratchets walk
    srcDir: String
    # the unit-test directory
    unitDir: String
    # how many cases passed
    passN: u64
    # how many ran clean under a sanitizer
    leakclean: u64
    # how many leaked but were expected to, per tests/known/leaks.zd
    xleak: u64
    # how many failed but were expected to
    xfail: u64
    # how many were skipped, usually because a fixture or a toolchain was absent
    skip: u64
    # how many failed unexpectedly. This is the only counter that decides the
    # exit status
    fails: u64
}

# runArchCases -- the architecture ratchet. `zl lint --full --arch` over every
# compiler and front-end unit, counted per (rule, file) and compared with
# tests/fixtures/arch_baseline.zd, exactly (ratchetCheck, ratchetStale): a
# count above its baseline is a new finding and fails; a count below it fails
# until its row is lowered in the same commit; a row no finding meets is spent
# and fails until deleted; a file with no baseline row must be clean.
runArchCases: function {r: Runner} is {
    basePath: "\{r.root.stringView}/tests/fixtures/arch_baseline.zd"
    if (io.exists path: basePath).not then {
        r.skip = r.skip + 1
        return
    }
    zl: "\{r.root.stringView}/bin/zl"
    srcs: List String
    archSrcFiles root: r.root.stringView into: srcs
    archUnitFiles root: r.root.stringView sub: "lib/system" into: srcs
    archUnitFiles root: r.root.stringView sub: "tests/unit" into: srcs
    archUnitFiles root: r.root.stringView sub: "tests/unit/matrixgen" into: srcs
    srcs.sort
    pool: List PoolJob
    for each f: srcs loop {
        argv: List String
        argv.append from: zl.copy
        argv.append from: "lint".string
        argv.append from: "--full".string
        argv.append from: "--arch".string
        argv.append from: "--counts".string
        # both project roots: A007's read evidence is the whole project, and a
        # smoke harness under tests/unit is a real consumer of src's exports
        argv.append from: "--src".string
        argv.append from: "\{r.root.stringView}/src"
        argv.append from: "--src".string
        argv.append from: "\{r.root.stringView}/tests/unit"
        argv.append from: "--system".string
        argv.append from: r.sys.copy
        argv.append from: "\{r.root.stringView}/\{f.stringView}"
        oname: f.stringView.replace needle: "/" replacement: "_"
        opath: "\{r.tmp.stringView}/A_\{oname}.out"
        epath: "\{r.tmp.stringView}/A_\{oname}.err"
        steps: List PoolStep
        # the count rows go to zl's stdout, anything else it says to its stderr
        steps.append (
            zjobs.mkStep
            :argv
            cwd: ""
            outPath: opath.stringView
            errPath: epath.stringView
            timeoutSecs: r.timeoutSecs
            allowFail: true
            zlinkFrom: ""
        )
        pool.append (zjobs.mkJob name: f.stringView :steps)
    }
    statuses: ListVal i32
    failSteps: ListVal i64
    zjobs.runJobs jobs: pool maxJobs: r.jobsMax :statuses :failSteps
    baseKeys: List String
    baseCounts: ListVal u64
    readRatchetBaseline path: basePath.stringView keys: baseKeys counts: baseCounts
    # which rows a finding met: a row none meets is spent, and fails below
    seen: ListVal bool
    for each bk: baseKeys loop {
        # one flag per row; the row itself is read below
        bk.drop
        seen.append from: false
    }
    anyFail: false
    ji: u64
    for ji < pool.length loop {
        job: pool.get i: ji
        fnm: job.name.stringView
        outName: fnm.replace needle: "/" replacement: "_"
        outPath: "\{r.tmp.stringView}/A_\{outName}.out"
        outC: slurp path: outPath.stringView
        codes: List String
        counts: ListVal u64
        if (countRows text: outC.stringView :codes :counts).not then {
            print "FAIL(arch) \{fnm}: a line zl lint --counts wrote is not a count row"
            anyFail = true
        }
        ci: u64
        for ci < codes.length loop {
            code: codes.get i: ci
            c: counts.get i: ci
            ci = ci + 1
            # the A codes; --full adds the typecheck tier's own
            if (code.stringView.startsWith prefix: "A").not then continue
            key: "\{code.stringView} \{fnm}"
            failed: (
                ratchetCheck
                kind: "arch"
                key: key.stringView
                :c
                :baseKeys
                :baseCounts
                :seen
                above: "a new finding, or a function over A008's threshold that grew; fix it or justify raising the baseline"
            )
            if failed then anyFail = true
        }
        ji = ji + 1
    }
    if (ratchetStale kind: "arch" :baseKeys :baseCounts :seen) then anyFail = true
    if anyFail then {
        r.fails = r.fails + 1
    } else {
        r.passN = r.passN + 1
    }
}

# appendGoldens -- the text of every `<name><suffix>` file in `dir`, appended
# to `all`.
appendGoldens: function {dir: StringView suffix: StringView all: String} is {
    for each nm: (fixtureNames :dir :suffix) loop {
        g: slurp path: "\{dir}/\{nm}\{suffix}".stringView
        all.append g
    }
}

# runErrCodeCases -- the ERRCODE ratchet: every error the compiler can report
# (a row of zast.errFacts) is the error of at least one golden -- an ERROR
# fixture's `.err`, a PROJECT case's expected.err or a ZDATA case's `.err`. An
# error no fixture raises is untested, or nothing raises it and its arm goes.
# `fileNotFound` is the one row with no golden: the parser's own answer for a
# unit with no file, which it reports as an unknown reference where the unit
# was named.
runErrCodeCases: function {r: Runner} is {
    all: String
    appendGoldens dir: r.errors.stringView suffix: ".err" :all
    appendGoldens dir: "\{r.root.stringView}/tests/fixtures/zdata".stringView suffix: ".err" :all
    pdir: "\{r.root.stringView}/tests/fixtures/project"
    cases: io.listDir path: pdir
    if cases.err.not then {
        for each cs: cases loop {
            g: slurp path: "\{pdir}/\{cs}/expected.err".stringView
            all.append g
        }
    }
    anyFail: false
    for each f: zast.errFacts loop {
        if f.arm == zast.err.fileNotFound then continue
        code: zdiag.ecodeString code: f.code
        head: "error[\{code}]"
        if (all.stringView.contains head).not then {
            print "FAIL(errcode) \{code} \{f.label.stringView}: no golden reports it -- add an error fixture that does, or delete the arm when nothing raises it"
            anyFail = true
        }
    }
    if anyFail then {
        r.fails = r.fails + 1
    } else {
        r.passN = r.passN + 1
    }
}

# runAgreeCases -- the AGREE kind: every example and emitc_corpus program is
# emitted for the host and for x86_64-w64-mingw32 twice, once with the C rows zc
# carries and once with the standard library's rows read off its own nativec.zd
# files, checked as a user unit's are (`zc emit --nativec-files`). The two must
# emit the same C, or fail alike: one walk registers both, so this compares the
# two readers. A third emit marks each native text with where it is written
# (`--mark-natives`): it must write marks, and without them be the same C.
runAgreeCases: function {r: Runner} is {
    progs: List String
    appendPrograms :progs dir: r.examplesDir.stringView
    appendPrograms :progs dir: r.corpusDir.stringView
    dir: "\{r.tmp.stringView}/agree"
    io.mkdirp path: dir
    pool: List PoolJob
    bases: List String
    targets: List String
    for each pg: progs loop {
        for each t: agreeTargets loop {
            base: "\{dir}/a\{bases.length}"
            steps: List PoolStep
            steps.append (
                agreeStep
                :r
                prog: pg.stringView
                target: t.stringView
                option: ""
                cfile: "\{base}.served.c".stringView
            )
            (
                steps.append
                (
                    agreeStep
                    :r
                    prog: pg.stringView
                    target: t.stringView
                    option: "--nativec-files"
                    cfile: "\{base}.files.c".stringView
                )
            )
            steps.append (
                agreeStep
                :r
                prog: pg.stringView
                target: t.stringView
                option: "--mark-natives"
                cfile: "\{base}.marked.c".stringView
            )
            pool.append (zjobs.mkJob name: pg.stringView :steps)
            bases.append base.take
            targets.append t.string
        }
    }
    statuses: ListVal i32
    failSteps: ListVal i64
    zjobs.runJobs jobs: pool maxJobs: r.jobsMax :statuses :failSteps
    bad: u64
    i: u64
    for i < bases.length loop {
        base: bases.get :i
        served: slurp path: "\{base}.served.c".stringView
        files: slurp path: "\{base}.files.c".stringView
        if served != files then {
            print "FAIL(agree) \{(pool.get :i).name} \{(
                targets.get
                :i
            )}: the rows zc carries and the nativec.zd files emit different C"
            bad = bad + 1
        }
        marked: slurp path: "\{base}.marked.c".stringView
        if served.length > 0 when (marked.stringView.contains needle: markOpen).not then {
            print "FAIL(agree) \{(pool.get :i).name} \{(
                targets.get
                :i
            )}: --mark-natives wrote no mark"
            bad = bad + 1
        } else if (withoutMarks c: served.stringView) != (withoutMarks c: marked.stringView) then {
            print "FAIL(agree) \{(pool.get :i).name} \{(
                targets.get
                :i
            )}: --mark-natives changed the C beside its marks"
            bad = bad + 1
        }
        i = i + 1
    }
    if bad > 0 then {
        r.fails = r.fails + bad
    } else {
        r.passN = r.passN + bases.length
    }
}

# markOpen -- how a line `zc emit --mark-natives` adds starts
markOpen: "/* nativec: "

# withoutMarks -- C text `c`, line by line, without the lines --mark-natives adds
withoutMarks: function {c: StringView} out String is {
    r: String
    for each l: c.lines loop {
        if (l.startsWith prefix: markOpen) when (l.endsWith suffix: " */") then continue
        r.append l
        r.append "\n"
    }
    return r
}

# agreeStep -- one agree emit: `prog` for `target` ("" for the host), with
# `option` when it is not "", its C to `cfile`. A program that does not emit fails
# both ways or the C differs.
agreeStep: function {
    r: Runner.view
    prog: StringView
    target: StringView
    option: StringView
    cfile: StringView
} out PoolStep is {
    argv: List String
    argv.append from: r.zc.copy
    argv.append "emit".string
    argv.append prog.string
    if target.length > 0 then {
        argv.append "--target".string
        argv.append target.string
    }
    if option.length > 0 then argv.append option.string
    argv.append "-o".string
    argv.append cfile.string
    return (
        zjobs.mkStep
        argv: argv.take
        cwd: r.root.stringView
        outPath: os.nullDevice.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
        allowFail: true
        zlinkFrom: ""
    )
}

# agreeTargets -- the targets the agree kind emits for: the host, and Windows,
# whose rows differ by OS
agreeTargets: list { "" "x86_64-w64-mingw32" }

# appendPrograms -- each `.z` program of `dir`, by path
appendPrograms: function {progs: List String dir: StringView} is {
    for each nm: (fixtureNames :dir suffix: ".z") loop progs.append "\{dir}/\{nm}.z"
}

# runDoccodeCases -- the DOCCODE kind: every zerolang example of docs/*.pdoc and
# README.md (zdocblocks) is wrapped into a program and emitted with `zc emit
# --eager`. An unmarked block must compile; an `error=` block must fail, its
# first error that code; a `check=none` block is not compiled; an `expect=`
# block is also built and run, and must print that text. A checked block
# that parses -- every one but an error= of a syntax error (E00xx) -- must also
# be laid out as `zl fmt` lays it. The skipped and the unformatted are counted
# per page and ratcheted, exactly, against tests/fixtures/doccode_baseline.zd
# as the arch kind's findings are. The C each emit writes is compiled, and not
# linked, by the runner's C compiler. The kind runs once, and not again under
# --cc-forward (test-clang, test-tcc): the emit is nearly all of its time.
runDoccodeCases: function {r: Runner} is {
    if r.ccFwdOn then return
    # owned: a view into r would lock r for the whole kind
    rootS: r.root.copy
    root: rootS.stringView
    pages: List String
    docPages :root into: pages
    blocks: List zdocblocks.DocBlock
    for each pg: pages loop {
        pgPath: "\{root}/\{pg.stringView}"
        txt: slurp path: pgPath.stringView
        zdocblocks.scanPage page: pg.stringView text: txt.stringView into: blocks
    }
    naming: zdocblocks.checkNames :blocks
    dir: "\{r.tmp.stringView}/doccode"
    io.mkdirp path: dir
    pool: List PoolJob
    # per block, the pool index of its emit and of its format check (-1: none)
    emitAt: ListVal i64
    fmtAt: ListVal i64
    doccodeJobs :r :blocks :naming dir: dir.stringView :pool :emitAt :fmtAt
    statuses: ListVal i32
    failSteps: ListVal i64
    zjobs.runJobs jobs: pool maxJobs: r.jobsMax :statuses :failSteps
    # per page: blocks skipped, blocks not laid out as zl fmt lays them
    noneN: ListVal u64
    fmtN: ListVal u64
    for each pg: pages loop {
        pg.drop
        noneN.append from: 0
        fmtN.append from: 0
    }
    bi: u64
    for bi < blocks.length loop {
        b: blocks.get i: bi
        pi: pageIndex :pages page: b.page.stringView
        if b.check.length > 0 when b.problem.length == 0 when (naming.get i: bi).length == 0 then {
            noneN.set i: pi val: (noneN.get i: pi) + 1
        } else {
            (
                doccodeVerdict
                :r
                :b
                naming: (naming.get i: bi).stringView
                emitAt: (emitAt.get i: bi)
                :statuses
                dir: dir.stringView
                :bi
            )
        }
        fj: fmtAt.get i: bi
        if fj >= 0 when (statuses.get i: fj.u64.orPanic) != 0 then {
            fmtN.set i: pi val: (fmtN.get i: pi) + 1
        }
        bi = bi + 1
    }
    if (doccodeRatchet :pages :blocks :noneN :fmtN :fmtAt :statuses :root) then {
        r.fails = r.fails + 1
    } else {
        r.passN = r.passN + 1
    }
}

# doccodeJobs -- write each checked block's program, and the job that emits it
# and the one that checks its layout, into the pool. A block that is skipped,
# or whose arguments or names are wrong, gets neither.
doccodeJobs: function {
    r: Runner.view
    blocks: (List zdocblocks.DocBlock).view
    naming: (List String).view
    dir: StringView
    pool: List PoolJob
    emitAt: ListVal i64
    fmtAt: ListVal i64
} is {
    zl: "\{r.root.stringView}/bin/zl"
    bi: u64
    for bi < blocks.length loop {
        b: blocks.get i: bi
        emitAt.append from: -1
        fmtAt.append from: -1
        if b.problem.length == 0 when (naming.get i: bi).length == 0 when b.check.length == 0 then {
            stem: doccodeStem :dir page: b.page.stringView :bi
            # a data block is the whole file it shows, read with `zc data`
            ext: ".z"
            tool: "emit"
            prog: String
            own: String
            if b.dataFile then {
                ext = ".zd"
                tool = "data"
                prog = zdocblocks.fileText code: b.code
                own = prog.copy
            } else {
                prog = zdocblocks.wrapProgram code: (zdocblocks.programOf :blocks at: bi)
                own = zdocblocks.wrapProgram code: b.code
            }
            emitAt.set i: bi val: pool.length.i64.orPanic
            progPath: stem.stringView.concat ext
            pool.append (
                doccodeJob
                :r
                path: progPath.stringView
                content: prog.stringView
                :tool
                runs: b.hasExpect
            )
            # a syntax error lays nothing out
            if (b.errorCode.stringView.startsWith "E00").not then {
                fmtAt.set i: bi val: pool.length.i64.orPanic
                fmtName: "_fmt".string
                fmtName.append ext
                ownPath: stem.stringView.concat fmtName
                pool.append (
                    doccodeJob
                    :r
                    path: ownPath.stringView
                    content: own.stringView
                    tool: zl.stringView
                    runs: false
                )
            }
        }
        bi = bi + 1
    }
}

# doccodeStem -- the path a block's files start with: a unit name made of its
# page and its place among all the blocks (`<dir>/spec_42`).
doccodeStem: function {dir: StringView page: StringView bi: u64} out String is {
    s: dir.string
    s.append "/"
    s.append (pageStem :page)
    s.append "_"
    s.append "\{bi}"
    return s
}

# blockAt -- where a block is, as its FAIL line names it: page and line.
blockAt: function {b: zdocblocks.DocBlock.view} out String is {
    s: b.page.copy
    s.append ":"
    s.append "\{b.line}"
    return s
}

# doccodeJob -- write `content` to `path` and the job that checks it: `zc emit
# --eager` when tool is "emit", and then the C compiler over the C it wrote,
# compiled and not linked; else the zl at `tool` as `fmt --check`. An example
# that `runs` is then built and run (doccodeRunSteps). A step's exit is data,
# read by the verdicts: a step that fails ends its job there.
doccodeJob: function {
    r: Runner.view path: StringView content: StringView tool: StringView runs: bool
} out PoolJob is {
    wr: io.writeText :path :content
    if wr.err then print "FAIL(doccode) could not write \{path}"
    argv: List String
    errPath: "\{path}.err"
    if tool.endsWith "data" then {
        argv.append from: r.zc.copy
        argv.append from: "data".string
        argv.append from: path.string
        argv.append from: "--system".string
        argv.append from: r.sys.copy
    } else if tool.endsWith "emit" then {
        argv.append from: r.zc.copy
        argv.append from: "emit".string
        argv.append from: path.string
        argv.append from: "--eager".string
        argv.append from: "--system".string
        argv.append from: r.sys.copy
        argv.append from: "-o".string
        argv.append from: "\{path}.c"
    } else {
        argv.append from: tool.string
        argv.append from: "fmt".string
        argv.append from: "--check".string
        argv.append from: path.string
    }
    compiles: (tool.endsWith "emit") and (zcc.ccFamilyOf ccPath: r.cc.stringView).msvc.not
    steps: List PoolStep
    steps.append (
        zjobs.mkStep
        :argv
        cwd: ""
        outPath: os.nullDevice.stringView
        errPath: errPath.stringView
        timeoutSecs: r.timeoutSecs
        allowFail: compiles.not
        zlinkFrom: ""
    )
    if compiles then {
        ccErrPath: "\{path}.c.err"
        steps.append (
            zjobs.mkStep
            argv: (doccodeCcArgv :r :path)
            cwd: ""
            outPath: os.nullDevice.stringView
            errPath: ccErrPath.stringView
            timeoutSecs: r.timeoutSecs
            allowFail: runs.not
            zlinkFrom: ""
        )
        if runs then doccodeRunSteps :r :path :steps
    }
    return (zjobs.mkJob name: path :steps)
}

# doccodeRunSteps -- the two steps that run the example at `path`, onto
# `steps`: `zc build` makes its program, and the program runs, its output kept
# in `<path>.out` for the verdict.
doccodeRunSteps: function {r: Runner.view path: StringView steps: List PoolStep} is {
    bin: "\{path}.bin"
    build: List String
    build.append from: r.zc.copy
    build.append from: "build".string
    build.append from: path.string
    build.append from: "--system".string
    build.append from: r.sys.copy
    build.append from: "-o".string
    build.append from: bin.copy
    buildErr: "\{path}.build.err"
    steps.append (
        zjobs.mkStep
        argv: build
        cwd: ""
        outPath: os.nullDevice.stringView
        errPath: buildErr.stringView
        timeoutSecs: r.timeoutSecs
        allowFail: false
        zlinkFrom: ""
    )
    run: List String
    run.append from: bin.copy
    outPath: "\{path}.out"
    steps.append (
        zjobs.mkStep
        argv: run
        cwd: ""
        outPath: outPath.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
        allowFail: true
        zlinkFrom: ""
    )
}

# doccodeCcArgv -- the command that compiles, and does not link, the C `zc
# emit` wrote for the example at `path`: an example's C must be C the compiler
# takes, and whether it links is its program's business.
doccodeCcArgv: function {r: Runner.view path: StringView} out List String is {
    a: List String
    a.append from: r.cc.copy
    for each ccFlag: (r.ccflags.stringView.split sep: " ") loop {
        if ccFlag.length > 0 then a.append from: ccFlag.string
    }
    a.append from: "-std=c17".string
    a.append from: "-w".string
    a.append from: "-c".string
    a.append from: "\{path}.c"
    a.append from: "-o".string
    a.append from: "\{path}.o"
    return a
}

# doccodeVerdict -- one block that is not skipped: its argument or naming
# problem, else its emit's verdict, reported as a FAIL or counted as a pass.
doccodeVerdict: function {
    r: Runner
    b: zdocblocks.DocBlock.view
    # what checkNames found, "" for nothing
    naming: StringView
    # the pool index of its emit
    emitAt: i64
    statuses: (ListVal i32).view
    dir: StringView
    bi: u64
} is {
    at: blockAt :b
    problem: b.problem.copy
    if problem.length == 0 then problem = naming.string
    if problem.length == 0 then {
        stem: doccodeStem :dir page: b.page.stringView :bi
        errExt: ".z.err"
        if b.dataFile then errExt = ".zd.err"
        errPath: stem.stringView.concat errExt
        errText: slurp path: errPath.stringView
        status: statuses.get i: emitAt.u64.orPanic
        problem = emitVerdict :status errText: errText.stringView want: b.errorCode.stringView
        # an emit that wrote no error ran, and what failed is a later step
        if status != 0 when (errText.stringView.contains "error[").not then {
            later: doccodeLaterProblem stem: stem.stringView :status runs: b.hasExpect
            if later.length > 0 then problem = later.take
        }
        if problem.length == 0 when b.hasExpect then {
            problem = doccodeOutputProblem stem: stem.stringView want: (zdocblocks.expectText :b)
        }
    }
    if problem.length > 0 then {
        print "FAIL(doccode) \{at.stringView}: \{problem.stringView}"
        r.fails = r.fails + 1
    } else {
        r.passN = r.passN + 1
    }
}

# doccodeLaterProblem -- what went wrong after an emit that worked, for the
# example whose files start with `stem` and whose job ended with `status`: the
# C compiler's error, and for an example that `runs`, `zc build`'s error or the
# program's own exit status. "" when none of them says anything.
doccodeLaterProblem: function {stem: StringView status: i32 runs: bool} out String is {
    ccSaid: doccodeCcProblem :stem
    if (ccSaid.length > 0) or runs.not then return ccSaid
    buildPath: stem.concat ".z.build.err"
    buildText: slurp path: buildPath.stringView
    for each bl: buildText.stringView.lines loop {
        if bl.contains "error" then return "it does not build: \{bl}"
    }
    return "it runs and exits with status \{status}, not 0"
}

# doccodeOutputProblem -- how what the example printed differs from `want`, the
# text its `expect=` gives: the first line that differs, "" when none does.
doccodeOutputProblem: function {stem: StringView want: String} out String is {
    outPath: stem.concat ".z.out"
    got: slurp path: outPath.stringView
    if got.stringView == want then return "".string
    gotLines: List String
    for each gl: got.stringView.lines loop gotLines.append from: gl.string
    n: u64
    for each wl: want.stringView.lines loop {
        if (
            n >= gotLines.length
        ) then return "it prints \{gotLines.length} lines, and expect= has more: '\{wl}'"
        if (gotLines.get i: n).stringView != wl then {
            return "line \{n + 1} of what it prints is '\{(
                gotLines.get
                i: n
            )}', and expect= says '\{wl}'"
        }
        n = n + 1
    }
    return "it prints more than expect= says: '\{gotLines.get i: n}'"
}

# doccodeCcProblem -- what the C compiler said of the C written for the
# example whose files start with `stem`: its first error, "" when it wrote none.
doccodeCcProblem: function {stem: StringView} out String is {
    ccPath: stem.concat ".z.c.err"
    ccText: slurp path: ccPath.stringView
    for each cl: ccText.stringView.lines loop {
        if cl.contains "error" then return "the C written for it does not compile: \{cl}"
    }
    return "".string
}

# emitVerdict -- what is wrong with a checked block's emit, "" when nothing: an
# unmarked block must compile, an error= block must fail with that code as its
# first error.
emitVerdict: function {status: i32 errText: StringView want: StringView} out String is {
    first: String
    for each el: errText.lines loop {
        if first.length == 0 when el.startsWith "error[" then first = el.string
    }
    if want.length == 0 then {
        if status == 0 then return "".string
        if first.length == 0 then return "zc emit failed (status \{status}) with no error line"
        return first
    }
    if status == 0 then return "it compiles, but error=\{want}"
    got: first.stringView.substring from: 6 to: 11
    if got != want then return "its first error is \{first.stringView}, but error=\{want}"
    return "".string
}

# doccodeRatchet -- the per-page counts of skipped and unformatted blocks
# against tests/fixtures/doccode_baseline.zd (its rows of rule `none` and
# `fmt`, one per page), exactly. A page whose fmt count moved lists its
# unformatted blocks. True when anything failed.
doccodeRatchet: function {
    pages: (List String).view
    blocks: (List zdocblocks.DocBlock).view
    noneN: (ListVal u64).view
    fmtN: (ListVal u64).view
    fmtAt: (ListVal i64).view
    statuses: (ListVal i32).view
    root: StringView
} out bool is {
    basePath: "\{root}/tests/fixtures/doccode_baseline.zd"
    baseKeys: List String
    baseCounts: ListVal u64
    readRatchetBaseline path: basePath.stringView keys: baseKeys counts: baseCounts
    seen: ListVal bool
    for each bk: baseKeys loop {
        bk.drop
        seen.append from: false
    }
    anyFail: false
    pi: u64
    for pi < pages.length loop {
        pg: (pages.get i: pi).stringView
        kn: "none \{pg}"
        if (
            ratchetCheck
            kind: "doccode"
            key: kn.stringView
            c: (noneN.get i: pi)
            :baseKeys
            :baseCounts
            :seen
            above: "a new check=none block; make it compile, or justify raising the baseline"
        ) then anyFail = true
        kf: "fmt \{pg}"
        if (
            ratchetCheck
            kind: "doccode"
            key: kf.stringView
            c: (fmtN.get i: pi)
            :baseKeys
            :baseCounts
            :seen
            above: "a block zl fmt would lay out differently; format it as zl fmt does"
        ) then {
            anyFail = true
            listUnformatted :blocks :fmtAt :statuses page: pg
        }
        pi = pi + 1
    }
    if (ratchetStale kind: "doccode" :baseKeys :baseCounts :seen) then anyFail = true
    return anyFail
}

# listUnformatted -- each block of `page` whose format check failed.
listUnformatted: function {
    blocks: (List zdocblocks.DocBlock).view
    fmtAt: (ListVal i64).view
    statuses: (ListVal i32).view
    page: StringView
} is {
    bi: u64
    for bi < blocks.length loop {
        b: blocks.get i: bi
        fj: fmtAt.get i: bi
        if b.page.stringView == page when fj >= 0 when (statuses.get i: fj.u64.orPanic) != 0 then {
            at: blockAt :b
            print "  needs zl fmt: \{at.stringView}"
        }
        bi = bi + 1
    }
}

# runDocPageCases -- the DOCPAGE kind, over the rendered pages docs/*.html. A
# link from one page to another names a page that exists and an anchor that
# page defines; the renderer checks a link inside a page, and not these. And
# each page is what the renderer writes from its .pdoc now, so a source edited
# without `make docs` fails. The renderer is a program beside the repository
# (`<root>/../picodoc-c/picodoc`); where it is absent that half is skipped.
runDocPageCases: function {r: Runner} is {
    if r.ccFwdOn then return
    rootS: r.root.copy
    root: rootS.stringView
    docsDir: "\{root}/docs"
    names: fixtureNames dir: docsDir.stringView suffix: ".html"
    names.sort
    texts: List String
    for each n: names loop {
        htmlPath: "\{docsDir}/\{n}.html"
        texts.append (slurp path: htmlPath.stringView)
    }
    pi: u64
    for pi < names.length loop {
        broken: docPageBrokenLinks :names :texts at: pi dir: docsDir.stringView
        broken = broken + (docLinkForms page: (names.get i: pi).stringView dir: docsDir.stringView)
        if broken == 0 then r.passN = r.passN + 1
        r.fails = r.fails + broken
        pi = pi + 1
    }
    tableBad: docErrorTable docsDir: docsDir.stringView
    if tableBad == 0 then r.passN = r.passN + 1
    r.fails = r.fails + tableBad
    picodoc: "\{root}/../picodoc-c/picodoc"
    if (io.exists path: picodoc).not then {
        r.skip = r.skip + 1
        return
    }
    outDir: "\{r.tmp.stringView}/docpage"
    io.mkdirp path: outDir
    pi = 0
    for pi < names.length loop {
        n: names.get i: pi
        fresh: "\{outDir}/\{n}.html"
        argv: List String
        argv.append picodoc.copy
        argv.append "\{docsDir}/\{n}.pdoc"
        argv.append "-o".string
        argv.append fresh.copy
        rc: os.spawn :argv cwd: "" outPath: os.nullDevice.stringView errPath: "" timeoutSecs: 0
        current: (rc == 0) and ((slurp path: fresh.stringView) == (texts.get i: pi))
        if current then {
            r.passN = r.passN + 1
        } else {
            print "FAIL(docpage) docs/\{n}.html is not what the renderer writes from docs/\{n}.pdoc -- run `make docs` and commit it"
            r.fails = r.fails + 1
        }
        pi = pi + 1
    }
}

# docErrorTable -- the code table of docs/errors.pdoc agrees with
# zast.errFacts: each code has one row, every row names a code the compiler
# reports, and a row's meaning is the first line of the code's `explain` --
# the title `zc explain` prints. Answers how many disagreements it printed.
docErrorTable: function {docsDir: StringView} out u64 is {
    page: "\{docsDir}/errors.pdoc"
    if (io.exists path: page).not then {
        print "FAIL(docpage) docs/errors.pdoc is missing: it holds the table of error codes"
        return 1
    }
    text: slurp path: page.stringView
    codes: List String
    meanings: List String
    bad: errorTableRows text: text.stringView :codes :meanings
    for each f: zast.errFacts loop {
        code: zdiag.ecodeString code: f.code
        ex: f.explain.stringView
        title: ex.substring from: 0 to: ((ex.indexOf "\n").or d: ex.length)
        problem: errorRowProblem code: code.stringView :title :codes :meanings
        if problem.length > 0 then {
            print "FAIL(docpage) docs/errors.pdoc: \{problem}"
            bad = bad + 1
        }
    }
    for each c: codes loop {
        known: false
        for each f: zast.errFacts loop {
            if (zdiag.ecodeString code: f.code).stringView == c then known = true
        }
        if known.not then {
            print "FAIL(docpage) docs/errors.pdoc: \{c} is a row, and the compiler reports no such code"
            bad = bad + 1
        }
    }
    return bad
}

# errorTableRows -- each row of the code table in `text`, one a line, as
# `[#tr: [#td: #~"E0003"] [#td: duplicate definition]]`: its code onto
# `codes`, its meaning onto `meanings`. A line that starts as a row and is
# not one is printed; answers how many.
errorTableRows: function {text: StringView codes: List String meanings: List String} out u64 is {
    bad: u64
    for each ln: text.lines loop {
        rest: ln.trim.stripPrefix "[#tr: [#td: #~\""
        if rest.none then continue
        q: rest.indexOf "\""
        good: false
        if q.some then {
            meaning: (rest.substring from: q to: rest.length).stripPrefix "\"] [#td: "
            if meaning.some when meaning.endsWith "]]" then {
                codes.append (rest.substring from: 0 to: q).string
                meanings.append (meaning.substring from: 0 to: meaning.length - 2).string
                good = true
            }
        }
        if good.not then {
            print "FAIL(docpage) docs/errors.pdoc: a row is not `[#tr: [#td: #~\"E0000\"] [#td: meaning]]`: \{ln.trim}"
            bad = bad + 1
        }
    }
    return bad
}

# errorRowProblem -- what is wrong with the rows of `code`, whose meaning is
# `title`: none, more than one, or a meaning that differs; "" when it has one
# row with that meaning.
errorRowProblem: function {
    code: StringView
    title: StringView
    codes: (List String).view
    meanings: (List String).view
} out String is {
    rows: u64
    got: String
    i: u64
    for i < codes.length loop {
        if (codes.get :i).stringView == code then {
            rows = rows + 1
            got = (meanings.get :i).copy
        }
        i = i + 1
    }
    if rows == 0 then return "\{code} has no row -- its meaning is '\{title}'"
    if rows > 1 then return "\{code} has \{rows} rows"
    if (
        got.stringView != title
    ) then return "\{code}'s meaning is '\{got}', and zc explain gives '\{title}'"
    return "".string
}

# linkOpen -- how a link of a .pdoc page starts
linkOpen: "#> to="

# docLinkForms -- how many links of `page`'s .pdoc are written in a form the
# renderer misreads: a link not in brackets runs to the end of its line, and a
# target holding `#` and not quoted ends at the `#`
docLinkForms: function {page: StringView dir: StringView} out u64 is {
    text: slurp path: "\{dir}/\{page}.pdoc".stringView
    bad: u64
    no: u64
    for each l: text.stringView.lines loop {
        no = no + 1
        pos: u64
        for pos < l.length loop {
            at: ((l.substring from: pos to: l.length).indexOf linkOpen).or d: l.length
            if at == l.length then break
            start: pos + at
            bracketed: (start > 0) and (((l.byteAt i: start - 1).or d: 0) == ascii.bracketOpen)
            if bracketed.false then {
                print "FAIL(docpage) docs/\{page}.pdoc:\{no}: a link written bare runs to the end of its line -- write [#> to=TARGET: text]"
                bad = bad + 1
            } else if (unquotedAnchor text: (l.substring from: start + linkOpen.length to: l.length)
            ) then {
                print "FAIL(docpage) docs/\{page}.pdoc:\{no}: a target holding # must be quoted -- to=\"page.html#anchor\""
                bad = bad + 1
            }
            pos = start + linkOpen.length
        }
    }
    return bad
}

# unquotedAnchor -- a link target, `text` from just after `to=`, is not quoted
# and holds a `#` before the space, colon or quote that ends it
unquotedAnchor: function {text: StringView} out bool is {
    if text.startsWith "\"" then return false
    for each b: text.byteView loop {
        if (b == ascii.space) or (b == ascii.colon) or (b == ascii.doubleQuote) then return false
        if b == ascii.hash then return true
    }
    return false
}

# docPageBrokenLinks -- how many links of page `at` point at nothing, each
# reported: a page that is not in `dir`, or an anchor its page does not define.
# A link to another site is not followed.
docPageBrokenLinks: function {
    names: (List String).view
    texts: (List String).view
    at: u64
    dir: StringView
} out u64 is {
    broken: u64
    text: (texts.get i: at).stringView
    pos: u64
    for pos < text.length loop {
        rest: text.substring from: pos to: text.length
        found: rest.indexOf "href=\""
        if found.none then break
        start: pos + found + 6
        tail: text.substring from: start to: text.length
        close: (tail.indexOf "\"").or d: tail.length
        link: tail.substring from: 0 to: close
        pos = start + close
        if (link.contains "://") or (link.startsWith "mailto:") then continue
        why: docLinkProblem :names :texts :at :dir :link
        if why.length > 0 then {
            print "FAIL(docpage) docs/\{names.get i: at}.html: the link to \{link} \{why}"
            broken = broken + 1
        }
    }
    return broken
}

# docLinkProblem -- what is wrong with `link`, written on page `at`: "" when
# its page exists and defines its anchor.
docLinkProblem: function {
    names: (List String).view
    texts: (List String).view
    at: u64
    dir: StringView
    link: StringView
} out String is {
    hashAt: link.length
    hash: link.indexOf "#"
    if hash.some then hashAt = hash
    pageFrom: u64
    if link.startsWith "./" when hashAt >= 2 then pageFrom = 2
    page: (link.substring from: pageFrom to: hashAt).string
    target: at
    if page.length > 0 then {
        stem: page.stringView.stripSuffix s: ".html"
        if stem.none then return (docFileProblem :dir file: page.stringView)
        slot: docPageSlot :names name: stem
        if slot.none then return "names a page that does not exist".string
        target = slot
    }
    if hashAt >= link.length then return "".string
    anchor: (link.substring from: hashAt + 1 to: link.length).string
    if (texts.get i: target).stringView.contains " id=\"\{anchor}\"" then return "".string
    return "names an anchor that page does not define".string
}

# docFileProblem -- what is wrong with a link to `file`, which is no page: ""
# when it is a file of `dir`.
docFileProblem: function {dir: StringView file: StringView} out String is {
    if (io.exists path: "\{dir}/\{file}") then return "".string
    return "names a file that does not exist".string
}

# docPageSlot -- where the page `name` is in `names`, none when it is no page.
docPageSlot: function {names: (List String).view name: StringView} out optionval u64 is {
    i: u64
    for i < names.length loop {
        if (names.get :i).stringView == name then return (optionval.some i)
        i = i + 1
    }
    return (optionval.none u64)
}

# docPages -- the pages the doccode kind reads: docs/*.pdoc in name order, then
# README.md.
docPages: function {root: StringView into: List String} is {
    docsDir: "\{root}/docs"
    names: fixtureNames dir: docsDir.stringView suffix: ".pdoc"
    names.sort
    for each n: names loop into.append from: "docs/\{n.stringView}.pdoc"
    into.append from: "README.md".string
}

# pageIndex -- the slot of `page` in the kind's page order, which the per-page
# counts are kept by. Every block's page was listed, so it is always found.
pageIndex: function {pages: (List String).view page: StringView} out u64 is {
    i: u64
    for i < pages.length loop {
        if (pages.get :i).stringView == page then return i
        i = i + 1
    }
    return 0
}

# pageStem -- a page as the start of a unit name: its file name without the
# extension, lowercased, `-` as `_` (`docs/Design-OPEN.pdoc` -> design_open).
pageStem: function {page: StringView} out String is {
    baseFrom: u64
    sl: page.lastIndexOf "/"
    match sl case some then baseFrom = sl + 1 case none then null
    base: page.substring from: baseFrom to: page.length
    stemEnd: base.length
    dot: base.indexOf "."
    match dot case some then stemEnd = dot case none then null
    low: (base.substring from: 0 to: stemEnd).toLowerAscii
    return (low.stringView.replace needle: "-" replacement: "_")
}

# archUnitFiles -- the `.z` files under `<root>/<sub>`, as `<sub>/<file>`.
archUnitFiles: function {root: StringView sub: StringView into: List String} is {
    dirp: "\{root}/\{sub}"
    ents: io.listDir path: dirp
    match (
        ents
    ) case ok then {
        for each e: ents loop {
            if (e.stringView.endsWith suffix: ".z") then into.append from: "\{sub}/\{e.stringView}"
        }
    } case err then null
}

# archSrcFiles -- the `.z` files of `<root>/src` and of each folder directly
# under it. A compiler unit's subunit files live in the folder of its name, and
# a ratchet that listed `src` alone would not count them.
archSrcFiles: function {root: StringView into: List String} is {
    archUnitFiles :root sub: "src" :into
    srcDir: "\{root}/src"
    ents: io.listDir path: srcDir
    match (
        ents
    ) case ok then {
        for each e: ents loop {
            if (e.stringView.endsWith suffix: ".z").not then {
                folder: "src/\{e.stringView}"
                archUnitFiles :root sub: folder.stringView :into
            }
        }
    } case err then null
}

# readRatchetBaseline -- a ratchet baseline (a data file, tests/fixtures/*_baseline.zd)
# as parallel key / count lists, a key being "<rule> <file>" of each `row` of its
# `rows`. The arch, doc and doccode ratchets read the one row type through here.
readRatchetBaseline: function {path: StringView keys: List String counts: ListVal u64} is {
    doc: (zd.read :path).orPanic
    for each row: (doc.itemsAt path: "rows").orPanic loop {
        (
            keys.append
            from: "\{(row.textAt path: "rule").orPanic} \{(row.textAt path: "file").orPanic}"
        )
        counts.append from: (row.integerAt path: "count").orPanic.u64.orPanic
    }
}

# docRatchetCode -- true for the three codes the documentation ratchet counts: an
# undocumented definition, a doc that only re-says its declaration, a body repeated
# across a file. A run with the doc flags also reports L017 and L018 (an undocumented
# parameter or member), which are advisory: a member is documented when its name and
# type do not say enough, and no ratchet can judge that. One membership string rather
# than a compare chain: a table of literal compares is the shape A001 discourages.
docRatchetCode: function {code: StringView} out bool is {
    known: " L016 L024 L025 "
    probe: " \{code} "
    return (known.contains needle: probe)
}

# runDocCases -- the documentation ratchet. `zl lint --docs-all` over every compiler,
# stdlib and front-end unit, counted per (rule, file) and compared with
# tests/fixtures/doc_baseline.zd: a count above its baseline is a newly undocumented
# member -- or a new doc that only re-says its declaration -- and fails; a count below
# fails until its row is lowered, and a spent row until it is deleted (the same exact
# ratchet as the arch kind). Heavy: it is a full-corpus lint pass,
# so it runs in `make ci` and not in the fast gate. Unlike the arch kind this does NOT
# walk tests/unit: a test driver is not the corpus a reader learns the language from.
runDocCases: function {r: Runner} is {
    if r.heavy.not then return
    basePath: "\{r.root.stringView}/tests/fixtures/doc_baseline.zd"
    if (io.exists path: basePath).not then {
        r.skip = r.skip + 1
        return
    }
    zl: "\{r.root.stringView}/bin/zl"
    srcs: List String
    archSrcFiles root: r.root.stringView into: srcs
    archUnitFiles root: r.root.stringView sub: "lib/system" into: srcs
    archUnitFiles root: r.root.stringView sub: "lib/system/system" into: srcs
    archUnitFiles root: r.root.stringView sub: "lib/system/math" into: srcs
    srcs.sort
    pool: List PoolJob
    for each f: srcs loop {
        argv: List String
        argv.append from: zl.copy
        argv.append from: "lint".string
        argv.append from: "--docs-all".string
        argv.append from: "--counts".string
        argv.append from: "--src".string
        argv.append from: "\{r.root.stringView}/src"
        argv.append from: "--system".string
        argv.append from: r.sys.copy
        argv.append from: "\{r.root.stringView}/\{f.stringView}"
        oname: f.stringView.replace needle: "/" replacement: "_"
        opath: "\{r.tmp.stringView}/D_\{oname}.out"
        epath: "\{r.tmp.stringView}/D_\{oname}.err"
        steps: List PoolStep
        # the count rows go to zl's stdout, anything else it says to its stderr
        steps.append (
            zjobs.mkStep
            :argv
            cwd: ""
            outPath: opath.stringView
            errPath: epath.stringView
            timeoutSecs: r.timeoutSecs
            allowFail: true
            zlinkFrom: ""
        )
        pool.append (zjobs.mkJob name: f.stringView :steps)
    }
    statuses: ListVal i32
    failSteps: ListVal i64
    zjobs.runJobs jobs: pool maxJobs: r.jobsMax :statuses :failSteps
    baseKeys: List String
    baseCounts: ListVal u64
    readRatchetBaseline path: basePath.stringView keys: baseKeys counts: baseCounts
    # which rows a finding met: a row none meets is spent, and fails below
    seen: ListVal bool
    for each bk: baseKeys loop {
        # one flag per row; the row itself is read below
        bk.drop
        seen.append from: false
    }
    anyFail: false
    ji: u64
    for ji < pool.length loop {
        job: pool.get i: ji
        fnm: job.name.stringView
        outName: fnm.replace needle: "/" replacement: "_"
        outPath: "\{r.tmp.stringView}/D_\{outName}.out"
        outC: slurp path: outPath.stringView
        codes: List String
        counts: ListVal u64
        if (countRows text: outC.stringView :codes :counts).not then {
            print "FAIL(docs) \{fnm}: a line zl lint --counts wrote is not a count row"
            anyFail = true
        }
        ci: u64
        for ci < codes.length loop {
            code: codes.get i: ci
            c: counts.get i: ci
            ci = ci + 1
            if (docRatchetCode code: code.stringView).not then continue
            key: "\{code.stringView} \{fnm}"
            failed: (
                ratchetCheck
                kind: "docs"
                key: key.stringView
                :c
                :baseKeys
                :baseCounts
                :seen
                above: "a new undocumented member, or a doc that only re-says its declaration; write the doc or justify the baseline"
            )
            if failed then anyFail = true
        }
        ji = ji + 1
    }
    if (ratchetStale kind: "docs" :baseKeys :baseCounts :seen) then anyFail = true
    if anyFail then {
        r.fails = r.fails + 1
    } else {
        r.passN = r.passN + 1
    }
}

# ratchetCheck -- one (code, file) count against its baseline row, marking the
# row as met. The ratchet is EXACT: a count above its row is a new finding, and
# a count below it fails too -- the fix lowers its row in the same commit, so
# no slack is left for a later regression to hide in. True when it fails.
ratchetCheck: function {
    # `arch` or `docs`, for the message
    kind: StringView
    # "<code> <file>"
    key: StringView
    # the findings counted
    c: u64
    baseKeys: (List String).view
    baseCounts: (ListVal u64).view
    # which rows a finding met, parallel to baseKeys
    seen: ListVal bool
    # what to do about a count above its row
    above: StringView
} out bool is {
    base: u64
    bi: u64
    for bi < baseKeys.length loop {
        if (baseKeys.get i: bi).stringView == key then {
            base = baseCounts.get i: bi
            seen.set i: bi val: true
        }
        bi = bi + 1
    }
    if c > base then {
        print "FAIL(\{kind}) \{key}: \{c} against a baseline of \{base} -- \{above}"
        return true
    }
    if c < base then {
        print "FAIL(\{kind}) \{key}: \{c} against a baseline of \{base} -- the count fell: lower the row to \{c} in this commit"
        return true
    }
    return false
}

# ratchetStale -- every baseline row no finding met: its file has none of that
# code left (or is gone), and a row nothing compares would otherwise sit stale
# and hide a regression up to its count. True when any is found.
ratchetStale: function {
    kind: StringView
    baseKeys: (List String).view
    baseCounts: (ListVal u64).view
    seen: (ListVal bool).view
} out bool is {
    stale: false
    bi: u64
    for bi < baseKeys.length loop {
        if (seen.get i: bi).not then {
            bk: baseKeys.get i: bi
            bc: baseCounts.get i: bi
            print "FAIL(\{kind}) \{bk}: 0 findings, baseline \{bc} -- the row is spent: delete it in this commit"
            stale = true
        }
        bi = bi + 1
    }
    return stale
}

# archCount -- add `by` to the count of `code` in the parallel code / count
# lists.
archCount: function {codes: List String counts: ListVal u64 code: StringView by: u64} is {
    i: u64
    for i < codes.length loop {
        c: codes.get :i
        if c.stringView == code then {
            counts.set :i val: (counts.get :i) + by
            return
        }
        i = i + 1
    }
    codes.append from: code.string
    counts.append from: by
}

# countRows -- add each `<code> <file> <count>` row that `zl lint --counts`
# wrote into `text` to the parallel code / count lists. False when a line is
# not such a row: the rows are a ratchet's input, so a line it cannot read must
# fail the ratchet and never count as nothing.
countRows: function {text: StringView codes: List String counts: ListVal u64} out bool is {
    for each ln: text.lines loop {
        first: ln.indexOf needle: " "
        if first.none then return false
        last: ln.lastIndexOf needle: " "
        if last.none then return false
        if last <= first then return false
        n: (ln.substring from: last + 1 to: ln.length).parseU64
        if n.err then return false
        archCount :codes :counts code: (ln.substring from: 0 to: first) by: n
    }
    return true
}

# runRunCases -- the RUN cases kind. With --stop-early the cases run a slice
# at a time, and the kind ends at the first slice with a failure: a run that
# only asks whether everything passes has its answer there.
runRunCases: function {r: Runner} is {
    known: knownCases :r
    met: falseFlags n: known.length
    runPool: List PoolJob
    passed: List String
    windows: ztarget.targetIsWindows triple: r.target.stringView
    for each c: (runCasePrograms :r) loop {
        if (isSelected :r name: c.name.stringView dir: c.dir.stringView).false then {
            markUnselected :known :met name: c.name.stringView
        } else if c.posix when windows then {
            # what it checks has no Windows counterpart: listed, not run
            runOutcome :r :known :met name: c.name.stringView why: runWhy.slot.posix
        } else runPool.append (runCaseJob :r :c)
        if (sliceIsFull :r jobs: runPool) then {
            runRunSlice :r :known :met jobs: runPool :passed
            if (stopsEarly :r) then return
        }
    }
    runRunSlice :r :known :met jobs: runPool :passed
    if r.repeats > 0 then repeatRunCases :r names: passed
    knownLeft :r :known :met
}

# sliceIsFull -- with --stop-early, `jobs` holds a slice of RUN cases: enough
# to keep every job slot busy for a few cases
sliceIsFull: function {r: Runner.view jobs: (List PoolJob).view} out bool is {
    return r.stopEarly and (jobs.length >= (r.jobsMax * 4))
}

# runRunSlice -- the RUN case jobs `jobs` in the pool, each judged, and `jobs`
# left empty; the names of the ones that passed are added to `passed`
runRunSlice: function {
    r: Runner
    known: (List KnownCase).view
    met: ListVal bool
    jobs: List PoolJob
    passed: List String
} is {
    runStatuses: ListVal i32
    runFailSteps: ListVal i64
    zjobs.runJobs :jobs maxJobs: r.jobsMax statuses: runStatuses failSteps: runFailSteps
    rji: u64
    for rji < jobs.length loop {
        job: jobs.get i: rji
        if (
            judgeRunCase
            :r
            :known
            :met
            name: job.name.stringView
            status: (runStatuses.get i: rji)
            failStep: (runFailSteps.get i: rji)
        ) then passed.append job.name.copy
        rji = rji + 1
    }
    for jobs.length > 0 loop jobs.pop
}

# CaseProgram -- one program of a case list (tests/fixtures/*_cases.zd)
CaseProgram: class {
    name: String
    # the directory that holds <name>.z, from the repository root
    dir: String
    # more source roots its units come from, from the repository root
    roots: List String
    # it checks what only POSIX has: on Windows it is listed, not run
    posix: bool
}

# runLists -- the RUN kind's case lists under tests/fixtures: the hand-written
# one, then the ones the two matrix generators write
runLists: list { "run_cases.zd" "matrix_cases.zd" "cpar_cases.zd" } out staticlist StringView

# casePrograms -- the programs of the case list at `path`, appended to `into`
casePrograms: function {path: StringView into: (List CaseProgram).borrow} is {
    doc: (zd.read :path).orPanic
    for each row: (doc.itemsAt path: "programs").orPanic loop {
        roots: List String
        for each rt: (row.itemsAt path: "roots").orPanic loop roots.append (rt.textAt path: ""
        ).orPanic.copy
        into.append (
            CaseProgram
            name: (row.textAt path: "name").orPanic.copy
            dir: (row.textAt path: "dir").orPanic.copy
            :roots
            posix: (row.booleanAt path: "posix").orPanic
        )
    }
}

# runCasePrograms -- the RUN kind's programs, from each of runLists
runCasePrograms: function {r: Runner.view} out List CaseProgram is {
    l: List CaseProgram
    for each f: runLists loop casePrograms path: "\{r.root}/tests/fixtures/\{f}".stringView into: l
    return l
}

# runCaseJob -- RUN case `c`'s job: emit and compile (or, with --zc-build,
# zc builds it), then run it under --exec's words when it gives some
runCaseJob: function {r: Runner.view c: CaseProgram.view} out PoolJob is {
    name: c.name.stringView
    srcAbs: caseDirs root: r.root.stringView :c
    cpath: "\{r.tmp.stringView}/\{name}.c"
    bpath: "\{r.tmp.stringView}/\{name}.bin"
    opath: "\{r.tmp.stringView}/\{name}.out"
    rdir: "\{r.tmp.stringView}/run_\{name}"
    io.mkdirp path: rdir
    steps: List PoolStep
    if r.zcBuild then {
        steps.append (
            zjobs.mkStep
            argv: (zcBuildArgv :r :name srcdirs: srcAbs bin: bpath.stringView)
            cwd: ""
            outPath: os.nullDevice.stringView
            errPath: os.nullDevice.stringView
            timeoutSecs: 0
            allowFail: false
            zlinkFrom: ""
        )
    } else {
        za: (
            zcArgv
            zc: r.zc.stringView
            ccFwd: r.ccFwd.stringView
            :name
            srcdirs: srcAbs
            sys: r.sys.stringView
            outc: cpath.stringView
        )
        if r.target.length > 0 then {
            za.append from: "--target".string
            za.append from: r.target.copy
        }
        for each zf: r.zcFlags loop za.append from: zf.copy
        steps.append (
            zjobs.mkStep
            argv: za
            cwd: ""
            outPath: os.nullDevice.stringView
            errPath: os.nullDevice.stringView
            timeoutSecs: 0
            allowFail: false
            zlinkFrom: ""
        )
        ga: (
            ccArgv
            cc: r.cc.stringView
            ccflags: r.ccflags.stringView
            target: r.target.stringView
            bin: bpath.stringView
            csrc: cpath.stringView
            asan: false
        )
        steps.append (
            zjobs.mkStep
            argv: ga
            cwd: ""
            outPath: os.nullDevice.stringView
            errPath: os.nullDevice.stringView
            timeoutSecs: 0
            allowFail: false
            zlinkFrom: cpath.stringView
            zc: r.zc.stringView
        )
    }
    steps.append (
        zjobs.mkStep
        argv: (runArgv :r :name bin: bpath.stringView)
        cwd: rdir.stringView
        outPath: opath.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
        allowFail: true
        zlinkFrom: ""
    )
    return (zjobs.mkJob :name :steps)
}

# zcBuildArgv -- `zc build` of RUN case `name` into `bin` with the C compiler
# --cc names, for --zc-build: zc compiles and links the program itself
zcBuildArgv: function {
    r: Runner.view name: StringView srcdirs: (List String).view bin: StringView
} out List String is {
    a: List String
    a.append from: r.zc.copy
    a.append from: "build".string
    a.append from: name.string
    for each d: srcdirs loop {
        a.append from: "--src".string
        a.append from: d.copy
    }
    a.append from: "--system".string
    a.append from: r.sys.copy
    a.append from: "--cc".string
    a.append from: r.cc.copy
    if r.target.length > 0 then {
        a.append from: "--target".string
        a.append from: r.target.copy
    }
    for each zf: r.zcFlags loop a.append from: zf.copy
    a.append from: "-o".string
    a.append from: bin.string
    return a
}

# runArgv -- how RUN case `name`'s binary `bin` is run: under --exec's words
# when it gives some, with the arguments its .args golden lists
runArgv: function {r: Runner.view name: StringView bin: StringView} out List String is {
    argsFile: "\{r.rungold.stringView}/\{name}.args"
    ba: binArgv :bin argsFile: argsFile.stringView
    if r.exec.length == 0 then return ba
    under: List String
    for each w: (r.exec.stringView.split sep: " ") loop {
        if w.length > 0 then under.append from: w.string
    }
    for each arg: ba loop under.append from: arg.copy
    return under
}

# judgeRunCase -- RUN case `name`'s verdict from its job's `status` and
# `failStep`: refused by zc, its C not built, or its output and exit code
# against its goldens. Answers whether it passed.
judgeRunCase: function {
    r: Runner
    known: (List KnownCase).view
    met: ListVal bool
    name: StringView
    status: i32
    failStep: i64
} out bool is {
    if failStep == 0 then {
        runOutcome :r :known :met :name why: runWhy.slot.zc
        return false
    }
    if failStep == 1 then {
        runOutcome :r :known :met :name why: runWhy.slot.cc
        return false
    }
    gold: goldenFor :r :name ext: ".out"
    if (io.exists path: gold).not then {
        r.skip = r.skip + 1
        return false
    }
    opath: "\{r.tmp.stringView}/\{name}.out"
    if (matchesGoldens :r :name outPath: opath.stringView :status) then {
        r.passN = r.passN + 1
        return true
    }
    runOutcome :r :known :met :name why: runWhy.slot.run
    return false
}

# repeatDir -- where the repeated runs of RUN case `name` run: run k in the
# directory `k`, its stdout in `k.out`
repeatDir: function {r: Runner.view name: StringView} out String is {
    return "\{r.tmp.stringView}/repeat_\{name}"
}

# matchesGoldens -- a run of RUN case `name` that wrote `outPath` and exited
# with `status` printed its .out golden and exited as its .exit golden says
# (0 when it has none)
matchesGoldens: function {r: Runner name: StringView outPath: StringView status: i32} out bool is {
    gold: goldenFor :r :name ext: ".out"
    exitFile: goldenFor :r :name ext: ".exit"
    goldC: slurp path: gold.stringView
    outC: slurp path: outPath
    expStr: "0".string
    if (io.exists path: exitFile) then {
        rawx: slurp path: exitFile.stringView
        rxv: rawx.stringView
        tvw: rxv.trim
        expStr = tvw.string
    }
    codeStr: "\{status}"
    return (outC.stringView == goldC) and (codeStr.stringView == expStr)
}

# repeatRunCases -- each RUN case of `names`, which passed, run --repeat more
# times in the job pool, each in a directory of its own; a case fails when any
# run differs from its goldens. A race shows only in some schedules, and
# ThreadSanitizer's exit status for one (66) is in no golden.
repeatRunCases: function {r: Runner names: (List String).view} is {
    jobs: List PoolJob
    for each n: names loop {
        bpath: "\{r.tmp.stringView}/\{n}.bin"
        repdir: repeatDir :r name: n.stringView
        k: u64
        for k < r.repeats loop {
            rdir: "\{repdir}/\{k}"
            io.mkdirp path: rdir
            opath: "\{repdir}/\{k}.out"
            steps: List PoolStep
            steps.append (
                zjobs.mkStep
                argv: (runArgv :r name: n.stringView bin: bpath.stringView)
                cwd: rdir.stringView
                outPath: opath.stringView
                errPath: os.nullDevice.stringView
                timeoutSecs: r.timeoutSecs
                allowFail: true
                zlinkFrom: ""
            )
            jobs.append (zjobs.mkJob name: n.stringView :steps)
            k = k + 1
        }
    }
    statuses: ListVal i32
    failSteps: ListVal i64
    zjobs.runJobs :jobs maxJobs: r.jobsMax :statuses :failSteps
    ji: u64
    for each n: names loop {
        bad: u64
        repdir: repeatDir :r name: n.stringView
        k: u64
        for k < r.repeats loop {
            opath: "\{repdir}/\{k}.out"
            if (
                matchesGoldens
                :r
                name: n.stringView
                outPath: opath.stringView
                status: (statuses.get i: ji)
            ).false then {
                bad = bad + 1
            }
            ji = ji + 1
            k = k + 1
        }
        if bad > 0 then {
            print "FAIL(run) \{n} (repeat): \{bad} of \{r.repeats} more runs differ from its goldens (output or exit status)"
            r.fails = r.fails + 1
        }
    }
}

# isSelected -- the RUN case `name`, listed under directory `dir`, is one a
# selector names: its name starts with a --cases text, its directory is one,
# or its source names a --cases-naming word as a whole word; every case when
# there is no selector
isSelected: function {r: Runner.view name: StringView dir: StringView} out bool is {
    if (r.cases.length == 0) and (r.cases2.length == 0) then return true
    for each c: r.cases loop {
        if (name.startsWith c) or (dir == c) then return true
    }
    if r.cases2.length == 0 then return false
    src: slurp path: "\{r.root}/\{dir}/\{name}.z".stringView
    for each w: r.cases2 loop {
        if (namesWord text: src.stringView word: w.stringView) then return true
    }
    return false
}

# namesWord -- `text` holds `word` with no name byte on either side of it
namesWord: function {text: StringView word: StringView} out bool is {
    pos: u64
    for pos < text.length loop {
        at: ((text.substring from: pos to: text.length).indexOf word).or d: text.length
        if at == text.length then return false
        start: pos + at
        end: start + word.length
        before: (text.byteAt i: start - 1).or d: 0
        after: (text.byteAt i: end).or d: 0
        if (start == 0) or (ascii.isWord b: before).false when (ascii.isWord b: after
        ).false then return true
        pos = start + 1
    }
    return false
}

# runWhy -- why a RUN case did not pass, as an expected-failure line spells it
runWhy: list {
    # zc refused it
    zc: "zc"
    # its C did not build
    cc: "cc"
    # it ran other than its golden
    run: "run"
    # it checks something only POSIX has, and a Windows build lists it rather
    # than runs it
    posix: "posix"
} out staticlist StringView

# KnownCase -- one of the RUN cases' expected failures: the case, and why
KnownCase: class {
    name: String
    why: u64
}

# knownCases -- the expected failures the data file --known names
# (tests/known/*.zd): its list `failures`, each a `failure` whose `stage` arm
# is a runWhy word; none without --known. A file zd refuses, or a stage that is
# no runWhy word, fails the run.
knownCases: function {r: Runner} out List KnownCase is {
    cases: List KnownCase
    if r.known.length == 0 then return cases
    words: zast.Vocab.create block: runWhy
    rd: zd.read path: r.known.stringView
    match (
        rd
    ) case err then {
        print "FAIL(run) \{rd.stringView}"
        r.fails = r.fails + 1
    } case ok then {
        for each row: (rd.itemsAt path: "failures").orPanic loop {
            arm: (row.armAt path: "stage").orPanic
            why: words.slotOf text: arm.stringView
            if why < runWhy.length then {
                cases.append (KnownCase name: (row.textAt path: "program").orPanic.copy :why)
            } else {
                print "FAIL(run) \{r.known}: stage '\{arm}' of \{row.path} is none of zc, cc, run or posix"
                r.fails = r.fails + 1
            }
        }
    }
    return cases
}

# markUnselected -- a listed expected failure of RUN case `name`, which no
# selector chose, counts as met: a case this run does not build says nothing
markUnselected: function {known: (List KnownCase).view met: ListVal bool name: StringView} is {
    i: u64
    for i < known.length loop {
        if (known.get :i).name == name then met.set :i val: true
        i = i + 1
    }
}

# falseFlags -- `n` flags, each false
falseFlags: function {n: u64} out ListVal bool is {
    flags: ListVal bool
    for flags.length < n loop flags.append false
    return flags
}

# runOutcome -- RUN case `name` failed (or, for `posix`, was listed and not
# run) for reason `why`: an expected failure when `known` holds it (marked in
# `met`), a failure otherwise. A `posix` case is a skip when no --known is
# given, the leg having none to compare with.
runOutcome: function {
    r: Runner
    known: (List KnownCase).view
    met: ListVal bool
    name: StringView
    why: u64
} is {
    i: u64
    for i < known.length loop {
        k: known.get :i
        if k.name == name when k.why == why then {
            met.set :i val: true
            r.xfail = r.xfail + 1
            return
        }
        i = i + 1
    }
    if why == runWhy.slot.posix when r.known.length == 0 then {
        print "SKIP(run) \{name} (posix)"
        r.skip = r.skip + 1
        return
    }
    print "FAIL(run) \{name} (\{runWhy.get i: why})"
    if r.known.length > 0 then print "  not in \{r.known}: a new failure"
    r.fails = r.fails + 1
}

# knownLeft -- each expected failure that did not happen fails: the case
# passes now, or fails for another reason (a move from `cc` to `zc` means a
# unit now refuses what it cannot build). Delete or change its line in the
# same change.
knownLeft: function {r: Runner known: (List KnownCase).view met: (ListVal bool).view} is {
    i: u64
    for i < known.length loop {
        if (met.get :i).false then {
            k: known.get :i
            print "FAIL(run) \{k.name} (\{(
                runWhy.get
                i: k.why
            )}): in \{r.known} but did not fail so -- delete or change its line"
            r.fails = r.fails + 1
        }
        i = i + 1
    }
}

# goldenFor -- a run case's expected output (`ext` ".out") or exit status
# (".exit"): `<name>.<os><ext>` where the operating system the case is built
# for has one of its own -- output that is truly that system's -- else
# `<name><ext>`
goldenFor: function {r: Runner name: StringView ext: StringView} out String is {
    osn: ztarget.targetOrHostOs triple: r.target.stringView
    own: "\{r.rungold.stringView}/\{name}"
    own.append "."
    own.append osn
    own.append ext
    if (io.exists path: own) then return own
    return "\{r.rungold.stringView}/\{name}\{ext}"
}

# runLspCases -- the LSP (framed transcript) cases kind.
runLspCases: function {r: Runner} is {
    # ---------------- LSP (framed transcript) cases ----------------
    lspCases: "\{r.root.stringView}/tests/fixtures/lsp_cases"
    lspGold: "\{r.root.stringView}/tests/fixtures/lsp_golden"
    lspLs: io.listDir path: lspCases
    if lspLs.err then return
    zlsC: "\{r.tmp.stringView}/zls.c"
    # an extension of its own, as every binary the runner builds has: a C
    # compiler for Windows that does not add .exe (tcc) leaves a file that
    # CreateProcessW, given a name with no extension, looks for with .exe added
    zlsB: "\{r.tmp.stringView}/zls.bin"
    srcD: "\{r.root.stringView}/src"
    stage: (
        buildTool
        :r
        zc: r.zc.stringView
        name: "zls"
        srcdirs: (oneDir d: srcD.stringView)
        csrc: zlsC.stringView
        bin: zlsB.stringView
        asan: false
    )
    if stage.emit then {
        print "FAIL(lsp) zls (zc)"
        r.fails = r.fails + 1
    }
    if stage.compile then {
        print "FAIL(lsp) zls (cc)"
        r.fails = r.fails + 1
    }
    if stage.built.not then return
    names: List String
    for each fn: lspLs loop {
        keep: fn.endsWith ".msgs"
        if fn.endsWith ".raw" then keep = true
        if keep then names.append fn.copy
    }
    lspListenCase :r zlsB: zlsB.stringView
    names.sort
    for each cf: names loop {
        (
            lspCase
            :r
            zlsB: zlsB.stringView
            lspCases: lspCases.stringView
            lspGold: lspGold.stringView
            cv: cf.stringView
        )
    }
}

# lspListenCase -- `zls --listen 0` end to end over a socket: the server
# takes a free port and says which on its stdout, a client connects to that
# port and starts a session, `shutdown` is answered, and `exit` ends the server
# with status 0. A
# server that kept the port to itself could never be reached, and the
# transcript cases all go through --replay.
lspListenCase: function {r: Runner zlsB: StringView} is {
    outP: "\{r.tmp.stringView}/lsp_listen.out"
    argv: List String
    argv.append zlsB.string
    argv.append "--listen".string
    argv.append "0".string
    s: (
        os.spawnAsync
        :argv
        cwd: ""
        outPath: outP.stringView
        errPath: os.nullDevice.stringView
    )
    children: List os.Child
    match (
        s
    ) case ok then children.append from: s.take case err then {
        print "FAIL(lsp) listen (spawn)"
        r.fails = r.fails + 1
        return
    }
    deadline: os.monotonicMillis + (r.timeoutSecs.i64 * 1000)
    port: awaitListenPort path: outP.stringView :deadline
    want: frameLsp src: "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}"
    lg: ListenGot bytes: String failed: false
    if port != 0 then lg = listenExchange :port :deadline
    st: reapWithin :children :deadline
    if lg.failed then {
        print "FAIL(lsp) listen (port \{port}: the connection failed after \{lg.bytes.length} bytes instead of closing -- the server must close it before it exits, or a client can lose its last replies)"
        r.fails = r.fails + 1
    } else if lg.bytes.stringView.endsWith want when st == 0 then {
        r.passN = r.passN + 1
    } else {
        print "FAIL(lsp) listen (port \{port}: the \{lg.bytes.length} bytes answered do not end with the reply to shutdown, exit \{st})"
        r.fails = r.fails + 1
    }
}

# ListenGot -- what a listen exchange received, and whether it ended in a
# failed read or poll instead of the server's close (a read answering 0): on
# Windows a socket a process leaves open at exit is reset, and the client
# loses what it had not read yet
ListenGot: class {
    bytes: String
    failed: bool
}

# awaitListenPort -- the port `zls --listen` announces in its stdout file at
# `path`, read again every 10 ms until `deadline`: 0 if it never comes
awaitListenPort: function {path: StringView deadline: i64} out u16 is {
    port: listenPort :path
    for port == 0 loop {
        if os.monotonicMillis > deadline then return 0
        os.sleepMillis ms: 10
        port = listenPort :path
    }
    return port
}

# listenPort -- the port in the "zls: listening on 127.0.0.1:<port>" line of
# the file at `path`, or 0 while it has not been written yet
listenPort: function {path: StringView} out u16 is {
    c: slurp :path
    pre: "zls: listening on 127.0.0.1:"
    for each ln: c.stringView.lines loop {
        if (ln.startsWith prefix: pre) then {
            digits: ln.substring from: pre.length to: ln.length
            pr: digits.parseU64
            if pr.ok when pr <= 65535 then return pr.u16.orPanic
        }
    }
    return 0
}

# listenExchange -- connect to `port`, send `initialize`, `shutdown` and
# `exit`, and read what the server answers until it closes, or `deadline`
listenExchange: function {port: u16 deadline: i64} out ListenGot is {
    got: ListenGot bytes: String failed: false
    cr: net.connect :port
    match cr case ok then null case err then return got
    req: (
        frameLsp
        src: "{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{}}\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"shutdown\"}\n{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}"
    )
    wr: cr.write from: req.byteView
    if wr.err then return got
    buf: Bytes
    for os.monotonicMillis <= deadline loop {
        pr: cr.pollReadable timeoutMillis: 100
        if pr.err then {
            got.failed = true
            break
        }
        if pr then {
            rr: cr.read into: buf max: 4096
            if rr.err then {
                got.failed = true
                break
            }
            if rr == 0 then break
        }
    }
    for each c: buf loop got.bytes.appendByte b: c
    return got
}

# reapWithin -- the exit status of the one child in `children`, killing it
# once `deadline` has passed (a killed child's status is 137)
reapWithin: function {children: List os.Child deadline: i64} out i32 is {
    for true loop {
        w: os.waitAny :children
        if w.pid != 0 then return w.status
        if os.monotonicMillis > deadline then (children.getMut i: 0).kill
        os.sleepMillis ms: 10
    }
    return -1
}

# lspCase -- one transcript, framed (`.msgs`) or raw (`.raw`), replayed
# through the server and its deframed output compared with the golden --
# or written AS the golden under --regen-lsp. A missing golden is a skip. A
# file `<case>.args` beside the transcript holds flags the server is started
# with for that case alone.
lspCase: function {
    r: Runner
    zlsB: StringView
    lspCases: StringView
    lspGold: StringView
    cv: StringView
} is {
    isRaw: cv.endsWith ".raw"
    ext: 5.u64
    if isRaw then ext = 4
    nm: cv.substring from: 0 to: cv.length - ext
    cp: "\{lspCases}/\{cv}"
    caseC: slurp path: cp.stringView
    input: String
    # a framed transcript speaks the URIs a client sends: absolute, under
    # this run's root (lspAbsolute); the output is read back the same way
    uris: lspUris root: r.root.stringView
    if isRaw then {
        input = caseC.copy
    } else {
        abs: lspAbsolute text: caseC.stringView :uris
        input = frameLsp src: abs.stringView
    }
    inP: "\{r.tmp.stringView}/lsp_\{nm}.in"
    wri: io.writeText path: inP content: input
    if wri.err then {
        print "FAIL(lsp) \{nm} (write input)"
        r.fails = r.fails + 1
    }
    outP: "\{r.tmp.stringView}/lsp_\{nm}.raw"
    argsP: "\{lspCases}/\{nm}.args"
    ba: (
        lspArgv
        :zlsB
        inP: inP.stringView
        argsPath: argsP.stringView
        root: uris.dir.stringView
    )
    rc: (
        os.spawn
        argv: ba
        cwd: ""
        outPath: outP.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
    )
    goldP: "\{lspGold}/\{nm}.out"
    if r.regenLsp then {
        rawOut: slurp path: outP.stringView
        normA: deframeLsp raw: rawOut.stringView
        norm: lspRelative text: normA.stringView :uris
        wrg: io.writeText path: goldP content: norm
        if wrg.err then {
            print "FAIL(lsp) \{nm} (write golden)"
            r.fails = r.fails + 1
        } else {
            print "regenerated lsp golden \{nm}"
            r.passN = r.passN + 1
        }
    } else if (io.exists path: goldP).not then {
        r.skip = r.skip + 1
    } else {
        rawOut: slurp path: outP.stringView
        normA: deframeLsp raw: rawOut.stringView
        norm: lspRelative text: normA.stringView :uris
        goldC: slurp path: goldP.stringView
        sameOut: norm.stringView == goldC
        if sameOut when rc == 0 then {
            r.passN = r.passN + 1
        } else {
            print "FAIL(lsp) \{nm}"
            r.fails = r.fails + 1
        }
    }
}

# lspArgv -- the command that replays the transcript at `inP` through the
# server `zlsB`, with the case's own flags after it when the case has a file at
# `argsPath`: one line, in which `{ROOT}` stands for the run's root `root`
lspArgv: function {
    zlsB: StringView
    inP: StringView
    argsPath: StringView
    root: StringView
} out List String is {
    argv: List String
    argv.append zlsB.string
    argv.append "--replay".string
    argv.append inP.string
    extra: slurp path: argsPath
    for each tok: (extra.stringView.trim.split sep: " ") loop {
        if tok.length > 0 then argv.append (tok.replace needle: "{ROOT}" replacement: root)
    }
    return argv
}

# LspUris -- the run's root as a transcript spells it: `dir`, the absolute
# root with "/" separators (a JSON-safe path on either system), and `prefix`,
# the file URI naming it (file:///home/x, file:///C:/x)
LspUris: class {
    dir: String
    prefix: String
}

# lspUris -- the LspUris of `root`, made absolute from the working directory
lspUris: function {root: StringView} out LspUris is {
    wd: workingDir
    abs: path.join a: wd.stringView b: root
    d: path.toSlash p: abs.stringView
    pre: "file://".string
    if (d.stringView.startsWith "/").not then pre.append "/"
    pre.append d
    return (LspUris dir: d.take prefix: pre.take)
}

# lspAbsolute -- a transcript as a client sends it. The cases spell the
# repository's files from its root -- `file://tests/...`, `"srcDir":
# "tests/..."` -- which a server cannot tell from a host URI
# (`file://server/share/...`), so each is made absolute under the run's root
lspAbsolute: function {text: StringView uris: LspUris.view} out String is {
    t: text.replace needle: "\"file://tests/" replacement: "\"\{uris.prefix}/tests/"
    t = t.stringView.replace needle: "\"file://lib/" replacement: "\"\{uris.prefix}/lib/"
    sd: "\"srcDir\": \""
    sy: "\"systemDir\": \""
    t = t.stringView.replace needle: "\{sd}tests/" replacement: "\{sd}\{uris.dir}/tests/"
    t = t.stringView.replace needle: "\{sy}tests/" replacement: "\{sy}\{uris.dir}/tests/"
    t = t.stringView.replace needle: "\{sd}lib/" replacement: "\{sd}\{uris.dir}/lib/"
    return (t.stringView.replace needle: "\{sy}lib/" replacement: "\{sy}\{uris.dir}/lib/")
}

# lspRelative -- the server's output with the run's root dropped from its
# URIs again, and the generated unit's directory for the host
# (`.zerolang/targets/<arch>-<os>/`) spelled `targets/HOST`, so a golden reads
# the same from any root on any system
lspRelative: function {text: StringView uris: LspUris.view} out String is {
    t: text.replace needle: "\"\{uris.prefix}/" replacement: "\"file://"
    key: ztarget.targetOrHostArch triple: ""
    key.append "-"
    key.append (ztarget.targetOrHostOs triple: "")
    hostDir: "/.zerolang/targets/\{key}/"
    return (t.stringView.replace needle: hostDir replacement: "/.zerolang/targets/HOST/")
}

# knownLeakers -- the programs tests/known/leaks.zd records as expected to hold
# memory at exit under the compiler family `kind`. Keyed by family and not by
# name alone because the two sanitizers do not measure the same thing: see
# isLeak.
knownLeakers: function {root: StringView kind: StringView} out List String is {
    names: List String
    path: "\{root}/tests/known/leaks.zd"
    doc: (zd.read path: path.stringView).orPanic
    for each row: (doc.itemsAt path: "leaks").orPanic loop {
        if (row.armAt path: "family").orPanic == kind then names.append (row.textAt path: "program"
        ).orPanic.copy
    }
    return names
}

# listHas -- whether `names` contains `n`.
listHas: function {names: (List String).view n: StringView} out bool is {
    for each entry: names loop {
        if entry.stringView == n then return true
    }
    return false
}

# buildAndRunProbe -- build one probe program with this run's sanitizer
# spelling and run it, leaving whatever it said on stderr in `err`. False when
# the COMPILE failed, which is a refusal to measure rather than a measurement.
buildAndRunProbe: function {
    r: Runner
    csrc: StringView
    bin: StringView
    err: StringView
} out bool is {
    genArgs: (
        ccArgv
        cc: r.cc.stringView
        ccflags: r.ccflags.stringView
        target: r.target.stringView
        :bin
        :csrc
        asan: true
    )
    buildArgs: (
        os.spawn
        argv: genArgs
        cwd: ""
        outPath: os.nullDevice.stringView
        errPath: err
        timeoutSecs: 0
    )
    if buildArgs != 0 then {
        compileErr: slurp path: err
        print "FAIL(leak) sanitizer-probe: '\{r.cc.stringView}' cannot build a sanitized program"
        print "\{compileErr.stringView}"
        return false
    }
    runArgs: List String
    runArgs.append from: bin.string
    (
        os.spawn
        argv: runArgs
        cwd: r.tmp.stringView
        outPath: os.nullDevice.stringView
        errPath: err
        timeoutSecs: r.timeoutSecs
    )
    return true
}

# proveSanitizer -- establish that this run's sanitizer spelling really reports
# a leak, BEFORE a single leak verdict is trusted. It builds a program that
# leaks 1 KB on purpose and one that does not, runs both under the environment
# the leak pool will use, and requires the first to report and the second to
# stay silent. A third reads one past the end of a static array -- what an
# unchecked list read was -- and must be reported unsafe.
#
# This is the check the leak dimension never had. `leak-clean=453` was printed
# by every tcc run of a harness that had appended -fsanitize=address to a
# compiler which accepts the flag and ignores it -- a green number nobody had
# ever seen go red. A test that cannot fail cannot report success either, so
# the harness now falsifies its own instrument once per run.
proveSanitizer: function {r: Runner bounds: bool kind: StringView} out bool is {
    lcp: "\{r.tmp.stringView}/S_leak.c"
    ccp: "\{r.tmp.stringView}/S_clean.c"
    lbp: "\{r.tmp.stringView}/S_leak.bin"
    cbp: "\{r.tmp.stringView}/S_clean.bin"
    lep: "\{r.tmp.stringView}/S_leak.err"
    cep: "\{r.tmp.stringView}/S_clean.err"
    obp: "\{r.tmp.stringView}/S_bounds.c"
    obb: "\{r.tmp.stringView}/S_bounds.bin"
    obe: "\{r.tmp.stringView}/S_bounds.err"
    # the index is volatile, so no compiler can see the read is out of range
    boundsSrc: "static const unsigned char tab[3] = {1, 2, 3};\nstatic volatile unsigned long at = 3;\nint main(void) { return tab[at] == 0; }\n"
    wb: io.writeText path: obp content: boundsSrc
    match (
        wb
    ) case ok then null case err then {
        print "FAIL(leak) sanitizer-probe (write)"
        return false
    }
    # the pointer leaves through a file-scope sink and is then cleared, so the
    # block is unreachable at exit however the stack happens to be laid out.
    header: "#include <stdlib.h>\nstatic void *sink;\n"
    leakSrc: "\{header}static void bleed(void) { void *p = malloc(1024); sink = p; }\nint main(void) { bleed(); sink = 0; return 0; }\n"
    cleanSrc: "\{header}static void hold(void) { void *p = malloc(1024); sink = p; }\nint main(void) { hold(); free(sink); sink = 0; return 0; }\n"
    w0: io.writeText path: lcp content: leakSrc
    match (
        w0
    ) case ok then null case err then {
        print "FAIL(leak) sanitizer-probe (write)"
        return false
    }
    w1: io.writeText path: ccp content: cleanSrc
    match (
        w1
    ) case ok then null case err then {
        print "FAIL(leak) sanitizer-probe (write)"
        return false
    }
    # the probe has to run under the SAME environment the pool will, or it
    # measures a differently-configured tool than the one it is vouching for.
    envKey: sanEnvKey :bounds
    envValue: sanEnvValue :bounds
    os.setEnv key: envKey.stringView value: envValue.stringView
    proven: true
    if (buildAndRunProbe :r csrc: lcp.stringView bin: lbp.stringView err: lep.stringView).not then {
        os.unsetEnv key: envKey.stringView
        return false
    }
    if (buildAndRunProbe :r csrc: ccp.stringView bin: cbp.stringView err: cep.stringView).not then {
        os.unsetEnv key: envKey.stringView
        return false
    }
    if (buildAndRunProbe :r csrc: obp.stringView bin: obb.stringView err: obe.stringView).not then {
        os.unsetEnv key: envKey.stringView
        return false
    }
    os.unsetEnv key: envKey.stringView
    dirtyOut: slurp path: lep.stringView
    cleanOut: slurp path: cep.stringView
    if (isLeak :bounds s: dirtyOut.stringView).not then {
        print "FAIL(leak) sanitizer-probe: '\{r.cc.stringView}' (\{kind}) did not report a deliberate 1 KB leak"
        print "  the leak verdicts below would have been about a check that never ran"
        proven = false
    }
    if (isLeak :bounds s: cleanOut.stringView) then {
        print "FAIL(leak) sanitizer-probe: '\{r.cc.stringView}' (\{kind}) reports a leak for a program with none"
        proven = false
    }
    pastOut: slurp path: obe.stringView
    if (isUnsafe :bounds s: pastOut.stringView).not then {
        print "FAIL(leak) sanitizer-probe: '\{r.cc.stringView}' (\{kind}) did not report a read past a static array"
        print "  the unsafe verdicts below would miss one"
        proven = false
    }
    if (isUnsafe :bounds s: cleanOut.stringView) then {
        print "FAIL(leak) sanitizer-probe: '\{r.cc.stringView}' (\{kind}) reports unsafe memory for a program with none"
        proven = false
    }
    return proven
}

# runLeakCases -- the LEAK cases kind.
runLeakCases: function {r: Runner} is {
    # ---------------- LEAK cases ----------------
    # the leak check is AddressSanitizer's (or tcc's bounds checker), which
    # the Windows toolchain (UCRT64 gcc) does not have
    if z.build.os == z.build.oskind.windows then {
        print "SKIP(leak) all (Linux only: no AddressSanitizer on Windows)"
        r.skip = r.skip + 1
        return
    }
    kind: (zcc.ccFamilyName f: (zcc.ccFamilyOf ccPath: r.cc.stringView)).string
    bounds: usesBoundsChecker ccPath: r.cc.stringView
    if (proveSanitizer :r :bounds kind: kind.stringView).not then {
        r.fails = r.fails + 1
        return
    }
    known: knownLeakers root: r.root.stringView kind: kind.stringView
    leakDirs: List String
    leakDirs.append from: r.examplesDir.copy
    leakDirs.append from: r.corpusDir.copy
    leakPool: List PoolJob
    di: u64
    for di < leakDirs.length loop {
        ld: leakDirs.get i: di
        nmNames: fixtureNames dir: ld.stringView suffix: ".z"
        for each nmS: nmNames loop {
            nm: nmS.stringView
            lpath: "\{ld}/\{nm}.z"
            if (declaresMain path: lpath.stringView).not then {
                continue
            }
            lc: "\{r.tmp}/L_\{nm}.c"
            lb: "\{r.tmp}/L_\{nm}.bin"
            lerr: "\{r.tmp}/L_\{nm}.err"
            # the sanitized COMPILE's stderr, kept rather than dropped:
            # discarding it is what let a compiler reject -- or ignore --
            # the sanitizer flag with nobody the wiser.
            lcerr: "\{r.tmp}/L_\{nm}.cerr"
            runDir: "\{r.tmp}/leak_\{nm}"
            io.mkdirp path: runDir
            argsFile: "\{r.rungold}/\{nm}.args"
            steps: List PoolStep
            za2: (
                zcArgv
                zc: r.zc.stringView
                ccFwd: r.ccFwd.stringView
                name: nm
                srcdirs: (oneDir d: ld.stringView)
                sys: r.sys.stringView
                outc: lc.stringView
            )
            steps.append (
                zjobs.mkStep
                argv: za2
                cwd: ""
                outPath: os.nullDevice.stringView
                errPath: os.nullDevice.stringView
                timeoutSecs: 0
                allowFail: false
                zlinkFrom: ""
            )
            ga2: (
                ccArgv
                cc: r.cc.stringView
                ccflags: r.ccflags.stringView
                target: r.target.stringView
                bin: lb.stringView
                csrc: lc.stringView
                asan: true
            )
            steps.append (
                zjobs.mkStep
                argv: ga2
                cwd: ""
                outPath: os.nullDevice.stringView
                errPath: lcerr.stringView
                timeoutSecs: 0
                allowFail: false
                zlinkFrom: lc.stringView
                zc: r.zc.stringView
            )
            ba2: binArgv bin: lb.stringView argsFile: argsFile.stringView
            steps.append (
                zjobs.mkStep
                argv: ba2
                cwd: runDir.stringView
                outPath: os.nullDevice.stringView
                errPath: lerr.stringView
                timeoutSecs: r.timeoutSecs
                allowFail: true
                zlinkFrom: ""
            )
            leakPool.append (zjobs.mkJob name: nm :steps)
        }
        di = di + 1
    }
    leakStatuses: ListVal i32
    leakFailSteps: ListVal i64
    ek: sanEnvKey :bounds
    ev: sanEnvValue :bounds
    os.setEnv key: ek.stringView value: ev.stringView
    zjobs.runJobs jobs: leakPool maxJobs: r.jobsMax statuses: leakStatuses failSteps: leakFailSteps
    os.unsetEnv key: ek.stringView
    lji: u64
    for lji < leakPool.length loop {
        ljob: leakPool.get i: lji
        lnm: ljob.name.stringView
        lfail: leakFailSteps.get i: lji
        if lfail == -1 then {
            lerr: "\{r.tmp.stringView}/L_\{lnm}.err"
            errC: slurp path: lerr.stringView
            isKnown: listHas names: known n: lnm
            if (isUnsafe :bounds s: errC.stringView) then {
                print "FAIL(unsafe) \{lnm}"
                r.fails = r.fails + 1
            } else if (isLeak :bounds s: errC.stringView) then {
                if isKnown then {
                    r.xleak = r.xleak + 1
                } else {
                    print "FAIL(leak) \{lnm}"
                    r.fails = r.fails + 1
                }
            } else {
                if isKnown then {
                    print "FAIL(ratchet) \{lnm} (leak-clean)"
                    r.fails = r.fails + 1
                } else {
                    r.leakclean = r.leakclean + 1
                }
            }
        } else {
            # A job whose emit or sanitized compile died must not count as
            # NOTHING -- no failure, no skip, no clean -- or a compiler that
            # rejects every sanitized build makes the whole leak dimension
            # evaporate in silence. The two step failures are not the same
            # thing, though: zc refusing to emit is usually a toolchain refusal
            # doing its job, and the run kind already reports that program by
            # name, so this dimension has nothing to add and says so. A
            # SANITIZED COMPILE that fails is the silent-evaporation case, and
            # it fails hard, with the stderr that would otherwise go to /dev/null.
            if lfail == 0 then {
                print "SKIP(leak) \{lnm} (zc)"
                r.skip = r.skip + 1
            } else {
                lce: "\{r.tmp.stringView}/L_\{lnm}.cerr"
                cerrC: slurp path: lce.stringView
                print "FAIL(leak) \{lnm} (cc)"
                if cerrC.length > 0 then print "\{cerrC.stringView}"
                r.fails = r.fails + 1
            }
        }
        lji = lji + 1
    }
}

# runErrorCases -- the ERROR (negative) cases kind.
runErrorCases: function {r: Runner} is {
    # ---------------- ERROR (negative) cases ----------------
    errPool: List PoolJob
    enmNames: fixtureNames dir: r.errors.stringView suffix: ".z"
    for each enmS: enmNames loop {
        enm: enmS.stringView
        epe: "\{r.tmp}/\{enm}.pe"
        steps: List PoolStep
        eza: (
            zcArgv
            zc: r.zc.stringView
            ccFwd: r.ccFwd.stringView
            name: enm
            srcdirs: (oneDir d: r.errors.stringView)
            sys: r.sys.stringView
            outc: os.nullDevice.stringView
        )
        exf: "\{r.errors.stringView}/\{enm}.zcargs"
        steps.append (
            zjobs.mkStep
            argv: (withExtraArgs argv: eza file: exf.stringView)
            cwd: ""
            outPath: os.nullDevice.stringView
            errPath: epe.stringView
            timeoutSecs: 0
            allowFail: true
            zlinkFrom: ""
        )
        errPool.append (zjobs.mkJob name: enm :steps)
    }
    errStatuses: ListVal i32
    errFailSteps: ListVal i64
    zjobs.runJobs jobs: errPool maxJobs: r.jobsMax statuses: errStatuses failSteps: errFailSteps
    eji: u64
    for eji < errPool.length loop {
        ejob: errPool.get i: eji
        enmv: ejob.name.stringView
        epe: "\{r.tmp.stringView}/\{enmv}.pe"
        egold: "\{r.errors.stringView}/\{enmv}.err"
        ematch: false
        if (errStatuses.get i: eji) != 0 then {
            peC: slurp path: epe.stringView
            golden: slurp path: egold.stringView
            ne: normErr content: peC.stringView
            if ne.stringView == golden then ematch = true
        }
        if ematch then {
            r.passN = r.passN + 1
        } else {
            print "FAIL(error) \{enmv}"
            r.fails = r.fails + 1
        }
        efull: "\{r.errors.stringView}/\{enmv}.full"
        if (io.exists path: efull) then {
            fpeC: slurp path: epe.stringView
            fgoldC: slurp path: efull.stringView
            fpeN: rootFree text: fpeC.stringView root: r.root.stringView
            if (sameAcrossSeparators want: fgoldC.stringView got: fpeN.stringView) then {
                r.passN = r.passN + 1
            } else {
                print "FAIL(error-full) \{enmv}"
                r.fails = r.fails + 1
            }
        }
        eji = eji + 1
    }
}

# loneErrorLine / loneErrorReport -- the error the LONE kind writes as the
# first line of a program's `main`, and the report the program must then give
loneErrorLine: "    zqzLone: zqzLoneErrorProbe"
loneErrorReport: "error[E0023]: Unknown reference 'zqzLoneErrorProbe'\n1 error found\n"

# withLoneError -- `src` with loneErrorLine as the first line of `main`'s body,
# or "" when no line opens `main`
withLoneError: function {src: StringView} out String is {
    buf: String
    done: false
    for each ln: src.lines loop {
        buf.append ln
        buf.append "\n"
        if done.not when ln.startsWith "main: function" when ln.trimEnd.endsWith "is {" then {
            buf.append loneErrorLine
            buf.append "\n"
            done = true
        }
    }
    if done then return buf
    return "".string
}

# loneErrorJob -- queue the LONE job for RUN case `name`, whose source roots
# are `srcAbs`: the changed program goes to a directory of its own, with a copy
# of the units it keeps in a directory of its name beside it, and its other
# roots stay the case's. False when no root holds the program or it opens no
# `main`.
loneErrorJob: function {
    r: Runner.view
    name: StringView
    srcAbs: (List String).view
    pool: (List PoolJob).borrow
} out bool is {
    home: String
    for each d: srcAbs loop {
        cand: "\{d.stringView}/\{name}.z"
        if home.length == 0 when (io.exists path: cand) then home = d.copy
    }
    if home.length == 0 then return false
    srcPath: "\{home.stringView}/\{name}.z"
    src: slurp path: srcPath.stringView
    changed: withLoneError src: src.stringView
    if changed.length == 0 then return false
    work: "\{r.tmp.stringView}/lone_\{name}"
    io.mkdirp path: work
    io.writeText path: "\{work.stringView}/\{name}.z" content: changed
    own: "\{home.stringView}/\{name}"
    if (zcheck.pathKindIs path: own.stringView want: io.filekind.dir) then {
        ownCopy: "\{work.stringView}/\{name}"
        copyUnits from: own.stringView to: ownCopy.stringView
    }
    roots: List String
    roots.append from: work.copy
    for each d: srcAbs loop roots.append from: d.copy
    argv: (
        zcArgv
        zc: r.zc.stringView
        ccFwd: r.ccFwd.stringView
        :name
        srcdirs: roots
        sys: r.sys.stringView
        outc: os.nullDevice.stringView
    )
    pe: "\{r.tmp.stringView}/lone_\{name}.pe"
    steps: List PoolStep
    steps.append (
        zjobs.mkStep
        :argv
        cwd: ""
        outPath: os.nullDevice.stringView
        errPath: pe.stringView
        timeoutSecs: 0
        allowFail: true
        zlinkFrom: ""
    )
    pool.append (zjobs.mkJob :name :steps)
    return true
}

# runLoneErrorCases -- the LONE kind: AN ERROR HIDES NO OTHER ERROR, checked on
# real programs. Each RUN case, with one unrelated error written as the first
# line of `main`, must report exactly that error. Any other error in the report
# is one the first caused or uncovered: a check that runs only on a program
# with no errors, or that reports from what an error left behind. A check
# stops at the first error, so the whole kind takes about a second.
runLoneErrorCases: function {r: Runner} is {
    pool: List PoolJob
    windows: ztarget.targetIsWindows triple: r.target.stringView
    for each c: (runCasePrograms :r) loop {
        if c.posix.not or windows.not then queueLoneErrorCase :r :c :pool
    }
    statuses: ListVal i32
    failSteps: ListVal i64
    zjobs.runJobs jobs: pool maxJobs: r.jobsMax :statuses :failSteps
    for each job: pool loop checkLoneErrorJob :r name: job.name.stringView
}

# queueLoneErrorCase -- the LONE job for RUN case `c`. A POSIX-only case is
# not a program on Windows, and the LONE kind skips it there as the RUN kind
# does.
queueLoneErrorCase: function {r: Runner c: CaseProgram.view pool: (List PoolJob).borrow} is {
    srcAbs: caseDirs root: r.root.stringView :c
    if (loneErrorJob :r name: c.name.stringView :srcAbs :pool).not then {
        print "FAIL(lone) \{c.name}: no source root holds it with a line that opens `main`"
        r.fails = r.fails + 1
    }
}

# checkLoneErrorJob -- the verdict on LONE job `name`: its report is exactly
# loneErrorReport
checkLoneErrorJob: function {r: Runner name: StringView} is {
    pe: "\{r.tmp.stringView}/lone_\{name}.pe"
    got: slurp path: pe.stringView
    ne: normErr content: got.stringView
    if ne.stringView == loneErrorReport then {
        r.passN = r.passN + 1
        return
    }
    print "FAIL(lone) \{name}: one error in `main` changed what else is reported:"
    print "\{ne}"
    r.fails = r.fails + 1
}

# runZdataCases -- the ZDATA kind: each tests/fixtures/zdata/<case>.zd is read
# with `zc data` (its own directory first, then what <case>.zcargs adds). A case
# with a <case>.err golden must fail with those errors (normErr); any other
# must succeed and print exactly its <case>.out, the file's values written back.
# `zl lint --full` checks each file the same way: it must report the golden's
# errors, or pass a case that has none -- a data file's definitions are read
# by the program that opens it, so none is reported unused.
runZdataCases: function {r: Runner} is {
    dir: "\{r.root.stringView}/tests/fixtures/zdata"
    pool: List PoolJob
    names: fixtureNames dir: dir.stringView suffix: ".zd"
    for each nmS: names loop {
        nm: nmS.stringView
        argv: List String
        argv.append from: r.zc.copy
        argv.append from: "data".string
        argv.append from: "\{dir}/\{nm}.zd"
        argv.append from: "--system".string
        argv.append from: r.sys.copy
        xf: "\{dir}/\{nm}.zcargs"
        outP: "\{r.tmp.stringView}/\{nm}.zdout"
        errP: "\{r.tmp.stringView}/\{nm}.zderr"
        steps: List PoolStep
        steps.append (
            zjobs.mkStep
            argv: (withExtraArgs :argv file: xf.stringView)
            cwd: ""
            outPath: outP.stringView
            errPath: errP.stringView
            timeoutSecs: 0
            allowFail: true
            zlinkFrom: ""
        )
        pool.append (zjobs.mkJob name: nm :steps)
        largv: List String
        largv.append from: "\{r.root.stringView}/bin/zl"
        largv.append from: "lint".string
        largv.append from: "--full".string
        largv.append from: "--system".string
        largv.append from: r.sys.copy
        largv.append from: "--src".string
        largv.append from: dir.copy
        largv.append from: "\{dir}/\{nm}.zd"
        lerrP: "\{r.tmp.stringView}/\{nm}.zlerr"
        lsteps: List PoolStep
        lsteps.append (
            zjobs.mkStep
            argv: (withExtraArgs argv: largv file: xf.stringView)
            cwd: ""
            outPath: os.nullDevice.stringView
            errPath: lerrP.stringView
            timeoutSecs: 0
            allowFail: true
            zlinkFrom: ""
        )
        ljn: "\{nm}#zl"
        pool.append (zjobs.mkJob name: ljn.stringView steps: lsteps)
    }
    statuses: ListVal i32
    failSteps: ListVal i64
    zjobs.runJobs jobs: pool maxJobs: r.jobsMax :statuses :failSteps
    ji: u64
    for ji < pool.length loop {
        job: pool.get i: ji
        nm: job.name.stringView
        st: statuses.get i: ji
        ji = ji + 1
        lst: statuses.get i: ji
        ji = ji + 1
        if (zdataCaseOk :r dir: dir.stringView :nm status: st) when (
            zdataLintOk
            :r
            dir: dir.stringView
            :nm
            status: lst
        ) then {
            r.passN = r.passN + 1
        } else {
            print "FAIL(zdata) \{nm}"
            r.fails = r.fails + 1
        }
    }
}

# zdataCaseOk -- one zdata case's verdict: with a .err golden, a failure with
# those errors; without one, a success that printed exactly the .out golden
zdataCaseOk: function {r: Runner.view dir: StringView nm: StringView status: i32} out bool is {
    errGold: "\{dir}/\{nm}.err"
    if (io.exists path: errGold) then {
        errP: "\{r.tmp.stringView}/\{nm}.zderr"
        got: slurp path: errP.stringView
        return (
            (status != 0) and
            ((normErr content: got.stringView) == (slurp path: errGold.stringView))
        )
    }
    outP: "\{r.tmp.stringView}/\{nm}.zdout"
    outGold: "\{dir}/\{nm}.out"
    return (status == 0) and ((slurp path: outP.stringView) == (slurp path: outGold.stringView))
}

# zdataLintOk -- `zl lint --full` on one zdata case: the golden's error lines
# when it has a .err, a clean pass when it has none
zdataLintOk: function {r: Runner.view dir: StringView nm: StringView status: i32} out bool is {
    errGold: "\{dir}/\{nm}.err"
    lerrP: "\{r.tmp.stringView}/\{nm}.zlerr"
    if (io.exists path: errGold).not then return status == 0
    got: slurp path: lerrP.stringView
    want: slurp path: errGold.stringView
    return (
        (status != 0) and ((errorLines text: got.stringView) == (errorLines text: want.stringView))
    )
}

# errorLines -- the `error[E...]` header lines of a diagnostic report
errorLines: function {text: StringView} out String is {
    buf: String
    for each ln: text.lines loop {
        if (ln.startsWith prefix: "error[E") then {
            buf.append ln
            buf.append "\n"
        }
    }
    return buf
}

# rootFree -- zc's stderr with the runner's own root dropped from the paths it
# names, read through path.toSlash: zc prints a file by its root joined with
# its path, cleaned and in native separators, and a golden spells it from the
# repo with "/" (`tests/fixtures/errors/x.z`), so any --root and either system
# compare alike (sameAcrossSeparators). The comparison adapts; zc does not
# print "/" to suit it. Under the default `.` the clean leaves nothing to strip.
rootFree: function {text: StringView root: StringView} out String is {
    t: path.toSlash p: text
    rc: path.clean p: root
    # the current directory, as clean spells it
    here: path.clean p: ""
    if rc == here then return t
    rs: path.toSlash p: rc.stringView
    return (t.stringView.replace needle: "\{rs}/" replacement: "")
}

# dumpCaseJob -- DUMP case `c`'s job: `zc dump --canon` of it
dumpCaseJob: function {r: Runner.view c: CaseProgram.view} out PoolJob is {
    srcAbs: "\{r.root}/\{c.dir}"
    dpath: "\{r.tmp}/\{c.name}.canon"
    da: (
        dumpArgv
        zc: r.zc.stringView
        name: c.name.stringView
        srcdir: srcAbs.stringView
        sys: r.sys.stringView
    )
    # a dump case pins the whole-program model, which for a unit with no
    # `main` is the EAGER tier's -- the compiler resolves what a program
    # demands, and a program that demands nothing is entitled to an empty
    # model. `<name>.zcargs` beside the source names the flag, the way an
    # error fixture does.
    dxf: "\{srcAbs}/\{c.name}.zcargs"
    steps: List PoolStep
    steps.append (
        zjobs.mkStep
        argv: (withExtraArgs argv: da file: dxf.stringView)
        cwd: ""
        outPath: dpath.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
        allowFail: true
        zlinkFrom: ""
    )
    return (zjobs.mkJob name: c.name.stringView :steps)
}

# runDumpCases -- the DUMP (canonical state) cases kind.
runDumpCases: function {r: Runner} is {
    cases: List CaseProgram
    casePrograms path: "\{r.root}/tests/fixtures/dump_cases.zd".stringView into: cases
    dumpPool: List PoolJob
    for each c: cases loop dumpPool.append (dumpCaseJob :r :c)
    dumpStatuses: ListVal i32
    dumpFailSteps: ListVal i64
    zjobs.runJobs jobs: dumpPool maxJobs: r.jobsMax statuses: dumpStatuses failSteps: dumpFailSteps
    dji: u64
    for dji < dumpPool.length loop {
        djob: dumpPool.get i: dji
        dnm: djob.name.stringView
        dpath: "\{r.tmp.stringView}/\{dnm}.canon"
        dgold: "\{r.dumpgold.stringView}/\{dnm}.canon"
        if (io.exists path: dgold).not then {
            r.skip = r.skip + 1
        } else {
            gC: slurp path: dgold.stringView
            oC: slurp path: dpath.stringView
            okd: false
            if (dumpStatuses.get i: dji) == 0 when oC.stringView == gC then okd = true
            if okd then {
                r.passN = r.passN + 1
            } else {
                print "FAIL(dump) \{dnm}"
                r.fails = r.fails + 1
            }
        }
        dji = dji + 1
    }
}

# compareGolden -- one differential case: the file a dump tool wrote at
# `outPath` against the committed `gold`. A case with no golden fails: nothing
# would compare its output.
compareGolden: function {
    r: Runner
    # the leg's name in the FAIL line: lexer, parser, program, vfs
    kind: StringView
    name: StringView
    outPath: StringView
    gold: StringView
} is {
    if (io.exists path: gold).not then {
        print "FAIL(\{kind}) \{name}: no golden"
        r.fails = r.fails + 1
        return
    }
    want: slurp path: gold
    got: slurp path: outPath
    if got.stringView == want then {
        r.passN = r.passN + 1
    } else {
        print "FAIL(\{kind}) \{name}"
        r.fails = r.fails + 1
    }
}

# lexGoldenCase -- run the token dump over `src` and compare with `gold`
lexGoldenCase: function {
    r: Runner
    dumpBin: StringView
    src: StringView
    gold: StringView
    name: StringView
} is {
    ltoks: "\{r.tmp.stringView}/D_\{name}.tokens"
    la: List String
    la.append from: dumpBin.string
    la.append from: src.string
    (
        os.spawn
        argv: la
        cwd: ""
        outPath: ltoks.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
    )
    compareGolden :r kind: "lexer" :name outPath: ltoks.stringView :gold
}

# runDifferentialCases -- the DIFFERENTIAL (lexer / parser / program goldens) kind.
runDifferentialCases: function {r: Runner} is {
    # ---------------- DIFFERENTIAL (lexer / parser / program goldens) ----------------
    # Build the dump binaries once with the r.zc under test, then diff their
    # output over every example (and program fixture) against committed goldens.
    lexgold: "\{r.root.stringView}/tests/fixtures/lexer_golden"
    parsegold: "\{r.root.stringView}/tests/fixtures/parser_golden"
    proggold: "\{r.root.stringView}/tests/fixtures/parser_program"
    zlxC: "\{r.tmp.stringView}/D_zlexer.c"
    zlxB: "\{r.tmp.stringView}/D_zlexer.bin"
    zpsC: "\{r.tmp.stringView}/D_zparser.c"
    zpsB: "\{r.tmp.stringView}/D_zparser.bin"
    lexOk: false
    parseOk: false
    if (
        buildTool
        :r
        zc: r.zc.stringView
        name: "zlexer_dump"
        srcdirs: (oneDir d: r.unitDir.stringView)
        csrc: zlxC.stringView
        bin: zlxB.stringView
        asan: false
    ).built then lexOk = true
    if (
        buildTool
        :r
        zc: r.zc.stringView
        name: "zparser_dump"
        srcdirs: (oneDir d: r.unitDir.stringView)
        csrc: zpsC.stringView
        bin: zpsB.stringView
        asan: false
    ).built then parseOk = true
    if lexOk.not then {
        print "FAIL(diff-build) zlexer"
        r.fails = r.fails + 1
    }
    if parseOk.not then {
        print "FAIL(diff-build) zparser"
        r.fails = r.fails + 1
    }
    dnmNames: fixtureNames dir: r.examplesDir.stringView suffix: ".z"
    for each dnmS: dnmNames loop {
        dnm: dnmS.stringView
        exPath: "\{r.examplesDir}/\{dnm}.z"
        if lexOk then {
            lgold: "\{lexgold}/\{dnm}.tokens"
            (
                lexGoldenCase
                :r
                dumpBin: zlxB.stringView
                src: exPath.stringView
                gold: lgold.stringView
                name: dnm
            )
        }
        if parseOk then {
            past: "\{r.tmp}/D_\{dnm}.ast"
            pa: List String
            pa.append from: zpsB.copy
            pa.append from: exPath.copy
            (
                os.spawn
                argv: pa
                cwd: ""
                outPath: past.stringView
                errPath: os.nullDevice.stringView
                timeoutSecs: r.timeoutSecs
            )
            pgold: "\{parsegold}/\{dnm}.ast"
            (
                compareGolden
                :r
                kind: "parser"
                name: dnm
                outPath: past.stringView
                gold: pgold.stringView
            )
        }
    }
    # the lexer's edge-case fixtures, whose goldens sit beside them
    if lexOk then {
        edgeDir: "\{r.root.stringView}/tests/fixtures/zlexer_z"
        enmNames: fixtureNames dir: edgeDir.stringView suffix: ".z"
        for each enmS: enmNames loop {
            enm: enmS.stringView
            esrc: "\{edgeDir}/\{enm}.z"
            egold: "\{edgeDir}/\{enm}.tokens"
            (
                lexGoldenCase
                :r
                dumpBin: zlxB.stringView
                src: esrc.stringView
                gold: egold.stringView
                name: enm
            )
        }
    }
    if parseOk then {
        ptnmNames: fixtureNames dir: proggold.stringView suffix: ".tree"
        for each ptnmS: ptnmNames loop {
            ptnm: ptnmS.stringView
            treeDir: "\{proggold}/\{ptnm}.tree"
            pout: "\{r.tmp}/P_\{ptnm}.out"
            ppa: List String
            ppa.append from: zpsB.copy
            ppa.append from: "--program".string
            ppa.append from: treeDir.copy
            ppa.append from: "main".string
            (
                os.spawn
                argv: ppa
                cwd: ""
                outPath: pout.stringView
                errPath: os.nullDevice.stringView
                timeoutSecs: r.timeoutSecs
            )
            goldPath: "\{proggold}/\{ptnm}.expected"
            (
                compareGolden
                :r
                kind: "program"
                name: ptnm
                outPath: pout.stringView
                gold: goldPath.stringView
            )
        }
    }
}

# runVfsCases -- the VFS (zvfs script dispatch) cases kind.
runVfsCases: function {r: Runner} is {
    # ---------------- VFS (zvfs script dispatch) cases ----------------
    # Build zvfs once; run each zvfs_ops/*.script (substituting {ROOT} with the
    # sibling .tree fixture path, read-only) and diff stdout vs <name>.expected.
    vfsdir: "\{r.root.stringView}/tests/fixtures/zvfs_ops"
    zvfC: "\{r.tmp.stringView}/D_zvfs.c"
    zvfB: "\{r.tmp.stringView}/D_zvfs.bin"
    vfsOk: false
    if (
        buildTool
        :r
        zc: r.zc.stringView
        name: "zvfs_script"
        srcdirs: (oneDir d: r.unitDir.stringView)
        csrc: zvfC.stringView
        bin: zvfB.stringView
        asan: false
    ).built then vfsOk = true
    if vfsOk.not then {
        print "FAIL(vfs-build) zvfs"
        r.fails = r.fails + 1
    }
    if vfsOk then {
        vnmNames: fixtureNames dir: vfsdir.stringView suffix: ".script"
        for each vnmS: vnmNames loop {
            vnm: vnmS.stringView
            scriptPath: "\{vfsdir}/\{vnm}.script"
            treePath: "\{vfsdir}/\{vnm}.tree"
            rawScript: slurp path: scriptPath.stringView
            subst: (
                rawScript.stringView.replace
                needle: "{ROOT}"
                replacement: treePath
            )
            tmpScript: "\{r.tmp}/V_\{vnm}.script"
            io.writeText path: tmpScript content: subst
            vout: "\{r.tmp}/V_\{vnm}.out"
            va: List String
            va.append from: zvfB.copy
            va.append from: tmpScript.copy
            (
                os.spawn
                argv: va
                cwd: ""
                outPath: vout.stringView
                errPath: os.nullDevice.stringView
                timeoutSecs: r.timeoutSecs
            )
            vgold: "\{vfsdir}/\{vnm}.expected"
            (
                compareGolden
                :r
                kind: "vfs"
                name: vnm
                outPath: vout.stringView
                gold: vgold.stringView
            )
        }
    }
}

# runUsageCases -- the USAGE cases kind: a driver run with one command line,
# judged by what it says and how it exits. Each directory under
# tests/fixtures/usage is one case. Its `args` file is one line: the driver's
# name (`zc`, which is the compiler --zc names; `zl`; `ztestrunner`), then the
# arguments, where `$ROOT` stands
# for the repository root, `$SCRATCH` for an empty directory of the case's own
# and `$HOST` for this host's target triple. The driver runs in the repository
# root, or in the scratch directory when the case's `cwd` file says `scratch`.
# Its exit code is compared with the number in expected.exit; its stderr, when
# the case has an expected.err, with that; its stdout, when it has an
# expected.out (or an expected.<os>.out for the system it runs on), with that;
# and each line of an expected.lines must be a line of its stdout. The root's
# and the scratch directory's paths read as `$ROOT` and `$SCRATCH` in what it
# printed.
runUsageCases: function {r: Runner} is {
    udir: "\{r.root.stringView}/tests/fixtures/usage"
    ls: io.listDir path: udir
    if ls.err then return
    for each cs: ls loop {
        if (runUsageCase :r dir: udir.stringView name: cs.stringView) then {
            r.passN = r.passN + 1
        } else {
            print "FAIL(usage) \{cs}"
            r.fails = r.fails + 1
        }
    }
}

# runUsageCase -- one USAGE case: run the driver, compare. True when its stderr
# and its exit code are what the case states.
runUsageCase: function {r: Runner.view dir: StringView name: StringView} out bool is {
    src: "\{dir}/\{name}"
    outP: "\{r.tmp.stringView}/U_\{name}.out"
    errP: "\{r.tmp.stringView}/U_\{name}.err"
    scratch: "\{r.tmp.stringView}/U_\{name}.d"
    io.mkdirp path: scratch
    rootAbs: absoluteRoot :r
    cwd: rootAbs.copy
    words: zast.Vocab.create block: runnerWord
    cwdText: slurp path: "\{src}/cwd".stringView
    if (
        (words.slotOf text: cwdText.stringView.trim) == runnerWord.slot.scratchCwd
    ) then cwd = scratch.copy
    rc: (
        os.spawn
        argv: (
            usageArgv
            root: rootAbs.stringView
            zc: (absoluteFrom base: workingDir.stringView p: r.zc.stringView).stringView
            caseDir: src.stringView
            scratch: scratch.stringView
        )
        cwd: cwd.stringView
        outPath: outP.stringView
        errPath: errP.stringView
        timeoutSecs: r.timeoutSecs
    )
    exitP: "\{src}/expected.exit"
    gotExit: "\{rc}"
    gotErr: usageText path: errP.stringView root: rootAbs.stringView scratch: scratch.stringView
    gotOut: usageText path: outP.stringView root: rootAbs.stringView scratch: scratch.stringView
    if r.regenUsage then {
        rewriteIfThere path: exitP.stringView text: "\{rc}\n".stringView
        rewriteIfThere path: "\{src}/expected.err".stringView text: gotErr.stringView
        (
            rewriteIfThere
            path: (usageOutGolden caseDir: src.stringView).stringView
            text: gotOut.stringView
        )
        return true
    }
    wantExit: slurp path: exitP.stringView
    if gotExit.stringView != wantExit.stringView.trim then return false
    if (usageDiffers want: "\{src}/expected.err".stringView got: gotErr.stringView
    ) then return false
    if (
        usageDiffers
        want: (usageOutGolden caseDir: src.stringView).stringView
        got: gotOut.stringView
    ) then return false
    return (usageLinesIn want: "\{src}/expected.lines".stringView got: gotOut.stringView)
}

# rewriteIfThere -- the file at `path`, when there is one, holds `text`
rewriteIfThere: function {path: StringView text: StringView} is {
    if (io.exists :path).false then return
    w: io.writeText :path content: text
    w.drop
}

# usageText -- what a usage case's driver wrote to `path`, the root's and the
# scratch directory's paths read as `$ROOT` and `$SCRATCH`
usageText: function {path: StringView root: StringView scratch: StringView} out String is {
    raw: slurp :path
    s1: raw.stringView.replace needle: scratch replacement: "$SCRATCH"
    return (s1.stringView.replace needle: root replacement: "$ROOT")
}

# usageDiffers -- the golden at `want` exists and `got` is not it (path
# separators forgiven)
usageDiffers: function {want: StringView got: StringView} out bool is {
    if (io.exists path: want).not then return false
    w: slurp path: want
    return (sameAcrossSeparators want: w.stringView :got).not
}

# usageOutGolden -- a usage case's stdout golden: expected.<os>.out for the
# system the runner runs on where the case has one, else expected.out
usageOutGolden: function {caseDir: StringView} out String is {
    own: "\{caseDir}/expected."
    own.append os.hostOsName
    own.append ".out"
    if (io.exists path: own) then return own
    return "\{caseDir}/expected.out"
}

# usageLinesIn -- each non-empty line of the file at `want` is a line of `got`;
# true when there is no such file
usageLinesIn: function {want: StringView got: StringView} out bool is {
    if (io.exists path: want).not then return true
    lines: List String
    for each l: got.lines loop lines.append l.trimEnd.string
    w: slurp path: want
    for each l: w.stringView.lines loop {
        if l.trim.length > 0 when (lines.contains item: l.trimEnd.string).false then return false
    }
    return true
}

# absoluteRoot -- the runner's root as an absolute path, cleaned: what `$ROOT`
# stands for in a usage case and reads as in its output
absoluteRoot: function {r: Runner.view} out String is {
    if (path.isAbsolute p: r.root.stringView) then return (path.clean p: r.root.stringView)
    joined: path.join a: workingDir.stringView b: r.root.stringView
    return (path.clean p: joined.stringView)
}

# hostTriple -- this host's target triple, as `$HOST` in a usage case
hostTriple: function out String is {
    if z.build.os == z.build.oskind.windows then return "x86_64-w64-mingw32".string
    t: os.hostArchName
    t.append "-"
    t.append os.hostOsName
    return t
}

# usageArgv -- the command a USAGE case's `args` line gives. Its first word
# names a driver: for `zc` the compiler under test (`zc`, its path), for
# `ztestrunner` the running runner itself, else that program in the `bin`
# directory under `root`.
usageArgv: function {
    root: StringView zc: StringView caseDir: StringView scratch: StringView
} out List String is {
    argsP: "\{caseDir}/args"
    argsLine: slurp path: argsP.stringView
    words: zast.Vocab.create block: runnerWord
    host: hostTriple
    argv: List String
    for each tok: (argsLine.stringView.trim.split sep: " ") loop {
        if tok.length == 0 then continue
        t1: tok.replace needle: "$ROOT" replacement: root
        t2: t1.stringView.replace needle: "$SCRATCH" replacement: scratch
        arg: t2.stringView.replace needle: "$HOST" replacement: host
        if argv.length > 0 then {
            argv.append from: arg.take
        } else if (words.slotOf text: arg.stringView) == runnerWord.slot.ownName then {
            argv.append from: ownPath
        } else if (words.slotOf text: arg.stringView) == runnerWord.slot.zcName then {
            argv.append from: zc.string
        } else {
            argv.append from: "\{root}/bin/\{arg}"
        }
    }
    return argv
}

# ownPath -- the running runner's own file, for a USAGE case that runs it; its
# bare name where the system does not tell
ownPath: function out String is {
    ep: os.exePath
    match (
        ep
    ) case ok then {
        return ep.copy
    } case err then {
        return runnerWord.ownName.string
    }
}

# runProjectCases -- the PROJECT cases kind: zc run inside a project. Each
# directory under tests/fixtures/project is one case: its files (a project.z,
# the units) are copied to a scratch directory of their own, zc runs THERE with
# the arguments `zc.args` gives on its one line, and what it printed is
# compared with expected.out (stdout) and expected.err (stderr), whichever the
# case has; expected.files lists files the run must leave behind. A copy, because zc writes the project's .zerolang/ beside its
# project.z, and a case must start from none.
runProjectCases: function {r: Runner} is {
    pdir: "\{r.root.stringView}/tests/fixtures/project"
    ls: io.listDir path: pdir
    if ls.err then return
    for each cs: ls loop {
        if (runProjectCase :r dir: pdir.stringView name: cs.stringView) then {
            r.passN = r.passN + 1
        } else {
            print "FAIL(project) \{cs}"
            r.fails = r.fails + 1
        }
    }
}

# runProjectCase -- one PROJECT case: copy it, run zc in the copy, compare.
# True when everything it printed matches its goldens.
runProjectCase: function {r: Runner.view dir: StringView name: StringView} out bool is {
    src: "\{dir}/\{name}"
    work: "\{r.tmp.stringView}/P_\{name}"
    copyUnits from: src.stringView to: work.stringView
    outP: "\{work}.out"
    errP: "\{work}.err"
    (
        os.spawn
        argv: (projectArgv :r caseDir: src.stringView)
        cwd: work.stringView
        outPath: outP.stringView
        errPath: errP.stringView
        timeoutSecs: r.timeoutSecs
    )
    wantOut: "\{src}/expected.out"
    wantErr: "\{src}/expected.err"
    if (projectOutDiffers want: wantOut.stringView got: outP.stringView) then return false
    if (projectOutDiffers want: wantErr.stringView got: errP.stringView) then return false
    wantFiles: "\{src}/expected.files"
    return (projectFilesMissing want: wantFiles.stringView work: work.stringView).not
}

# projectFilesMissing -- a file the case's expected.files names (one path per
# line, relative to the case's directory) is not there after the run; false
# when the case lists none
projectFilesMissing: function {want: StringView work: StringView} out bool is {
    if (io.exists path: want).not then return false
    w: slurp path: want
    for each line: w.stringView.lines loop {
        p: line.trim
        if p.length > 0 when (projectFileThere :work :p).not then return true
    }
    return false
}

# projectFileThere -- `p` under `work`, or on Windows `p` with the executable
# suffix, which an executable carries there (`two` is two.exe)
projectFileThere: function {work: StringView p: StringView} out bool is {
    if (io.exists path: "\{work}/\{p}") then return true
    if z.build.os != z.build.oskind.windows then return false
    return (io.exists path: "\{work}/\{p}.exe")
}

# copyUnits -- every `.z` and `.zd` file of directory `from`, and of each
# directory under it, into a new directory `to` laid out the same way: a project
# may keep its units in several source roots, and its settings in project.zd
copyUnits: function {from: StringView to: StringView} is {
    io.mkdirp path: to
    files: io.listDir path: from
    if files.err then return
    for each fe: files loop {
        fv: fe.stringView
        fsrc: "\{from}/\{fv}"
        # a folder first: one may be named as a unit file is
        if (zcheck.pathKindIs path: fsrc.stringView want: io.filekind.dir) then {
            sub: "\{to}/\{fv}"
            copyUnits from: fsrc.stringView to: sub.stringView
        } else if (fv.endsWith ".z") or (fv.endsWith ".zd") then {
            fc: slurp path: fsrc.stringView
            io.writeText path: "\{to}/\{fv}" content: fc
        }
    }
}

# projectArgv -- zc and the arguments a PROJECT case's zc.args line gives, with
# `{SYSTEM}` standing for the stdlib. Every path is absolute, since zc runs in
# the case's own directory. The case builds with zc's own C compiler, not the
# toolchain under test: what it tests is the driver reading a project, which no
# backend changes, and a forwarded --cc would need the toolchain's flags too.
projectArgv: function {r: Runner.view caseDir: StringView} out List String is {
    here: workingDir
    sysAbs: absoluteFrom base: here.stringView p: r.sys.stringView
    argsPath: "\{caseDir}/zc.args"
    argsLine: slurp path: argsPath.stringView
    filled: argsLine.stringView.replace needle: "{SYSTEM}" replacement: sysAbs
    argv: List String
    argv.append from: (absoluteFrom base: here.stringView p: r.zc.stringView)
    for each tok: (filled.stringView.trim.split sep: " ") loop {
        if tok.length > 0 then argv.append from: tok.string
    }
    return argv
}

# projectOutDiffers -- a project case printed other than its golden `want`
# says; false when the case has no such golden. zc prints its paths natively
# ("wrote .zerolang\.gitignore" on Windows) and the golden spells them with
# "/", so what was printed is compared through path.toSlash: the comparison
# adapts, the compiler does not print "/" to suit it
projectOutDiffers: function {want: StringView got: StringView} out bool is {
    if (io.exists path: want).not then return false
    w: slurp path: want
    g: slurp path: got
    return (sameAcrossSeparators want: w.stringView got: g.stringView).not
}

# sameAcrossSeparators -- whether output that names paths matches its golden
# once both are read through path.toSlash. A golden spells paths with "/";
# a backslash elsewhere in it -- a source line quoting "\{x}" -- reads the
# same through toSlash on either side, so only the separators are forgiven.
# On POSIX toSlash changes nothing and this is plain equality.
sameAcrossSeparators: function {want: StringView got: StringView} out bool is {
    w: path.toSlash p: want
    g: path.toSlash p: got
    return w == g
}

# workingDir -- the directory the runner runs in, absolute
workingDir: function out String is {
    cw: os.cwd
    match (
        cw
    ) case ok then {
        return cw.copy
    } case err then null
    return String
}

# absoluteFrom -- `p` as a path that opens from any directory: unchanged when
# it is absolute or a bare command name (no directory part), else joined to
# `base`
absoluteFrom: function {base: StringView p: StringView} out String is {
    if (path.isAbsolute :p) then return p.string
    if (path.baseName :p).length == p.length then return p.string
    return (path.join a: base b: p)
}

# smokeCaseJob -- SMOKE case `c`'s job: emit, compile, run with no arguments
smokeCaseJob: function {r: Runner.view c: CaseProgram.view} out PoolJob is {
    srcAbs: caseDirs root: r.root.stringView :c
    cpath: "\{r.tmp.stringView}/S_\{c.name.stringView}.c"
    bpath: "\{r.tmp.stringView}/S_\{c.name.stringView}.bin"
    opath: "\{r.tmp.stringView}/S_\{c.name.stringView}.out"
    steps: List PoolStep
    za: (
        zcArgv
        zc: r.zc.stringView
        ccFwd: r.ccFwd.stringView
        name: c.name.stringView
        srcdirs: srcAbs
        sys: r.sys.stringView
        outc: cpath.stringView
    )
    steps.append (
        zjobs.mkStep
        argv: za
        cwd: ""
        outPath: os.nullDevice.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: 0
        allowFail: false
        zlinkFrom: ""
    )
    ga: (
        ccArgv
        cc: r.cc.stringView
        ccflags: r.ccflags.stringView
        target: r.target.stringView
        bin: bpath.stringView
        csrc: cpath.stringView
        asan: false
    )
    steps.append (
        zjobs.mkStep
        argv: ga
        cwd: ""
        outPath: os.nullDevice.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: 0
        allowFail: false
        zlinkFrom: cpath.stringView
        zc: r.zc.stringView
    )
    ba: binArgv bin: bpath.stringView argsFile: ""
    steps.append (
        zjobs.mkStep
        argv: ba
        cwd: ""
        outPath: opath.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
        allowFail: true
        zlinkFrom: ""
    )
    return (zjobs.mkJob name: c.name.stringView :steps)
}

# runSmokeCases -- the SMOKE (per-unit no-arg golden) cases kind.
runSmokeCases: function {r: Runner} is {
    cases: List CaseProgram
    casePrograms path: "\{r.root}/tests/fixtures/smoke_cases.zd".stringView into: cases
    smokePool: List PoolJob
    for each c: cases loop smokePool.append (smokeCaseJob :r :c)
    smokeStatuses: ListVal i32
    smokeFailSteps: ListVal i64
    (
        zjobs.runJobs
        jobs: smokePool
        maxJobs: r.jobsMax
        statuses: smokeStatuses
        failSteps: smokeFailSteps
    )
    sji: u64
    for sji < smokePool.length loop {
        sjob: smokePool.get i: sji
        snm: sjob.name.stringView
        sfail: smokeFailSteps.get i: sji
        if sfail == 0 then {
            print "FAIL(smoke-emit) \{snm}"
            r.fails = r.fails + 1
        } else if sfail == 1 then {
            print "FAIL(smoke-build) \{snm}"
            r.fails = r.fails + 1
        } else {
            opath: "\{r.tmp.stringView}/S_\{snm}.out"
            gold: "\{r.root.stringView}/tests/fixtures/\{snm}_z/smoke.expected"
            if (io.exists path: gold).not then {
                r.skip = r.skip + 1
            } else {
                goldC: slurp path: gold.stringView
                outC: slurp path: opath.stringView
                sameS: outC.stringView == goldC
                if sameS when (smokeStatuses.get i: sji) == 0 then {
                    r.passN = r.passN + 1
                } else {
                    print "FAIL(smoke) \{snm}"
                    r.fails = r.fails + 1
                }
            }
        }
        sji = sji + 1
    }
}

# runFmtCases -- the FMT (formatter golden) kind: build the formatter's dump
# tool with the r.zc under test, lay out every tests/fixtures/fmt_cases/*.z
# (with the flags its `.args` file names) against its golden under
# tests/fixtures/fmt_golden, and lay the golden out again, which must give
# the golden back: a fixture pins the layout and its idempotency at once.
runFmtCases: function {r: Runner} is {
    casesDir: "\{r.root.stringView}/tests/fixtures/fmt_cases"
    goldDir: "\{r.root.stringView}/tests/fixtures/fmt_golden"
    zfC: "\{r.tmp.stringView}/F_zfmt.c"
    zfB: "\{r.tmp.stringView}/F_zfmt.bin"
    # the unit's own directory first, then src, as a case file lists them
    srcs: oneDir d: r.unitDir.stringView
    srcs.append from: r.srcDir.copy
    built: false
    if (
        buildTool
        :r
        zc: r.zc.stringView
        name: "zfmt_dump"
        srcdirs: srcs
        csrc: zfC.stringView
        bin: zfB.stringView
        asan: false
    ).built then built = true
    if built.not then {
        print "FAIL(fmt-build) zfmt_dump"
        r.fails = r.fails + 1
        return
    }
    nmNames: fixtureNames dir: casesDir.stringView suffix: ".z"
    for each nmS: nmNames loop {
        nm: nmS.stringView
        src: "\{casesDir.stringView}/\{nm}.z"
        gold: "\{goldDir.stringView}/\{nm}.z"
        argsFile: "\{casesDir.stringView}/\{nm}.args"
        if (io.exists path: gold).not then {
            r.skip = r.skip + 1
        } else {
            (
                fmtGoldenCase
                :r
                bin: zfB.stringView
                src: src.stringView
                gold: gold.stringView
                argsFile: argsFile.stringView
                name: nm
            )
        }
    }
}

# fmtGoldenCase -- one fmt fixture: the source laid out must match the golden,
# and the golden laid out must be itself
fmtGoldenCase: function {
    r: Runner
    bin: StringView
    src: StringView
    gold: StringView
    argsFile: StringView
    name: StringView
} is {
    outP: "\{r.tmp.stringView}/F_\{name}.out"
    fa: binArgv :bin :argsFile
    fa.append from: src.string
    rc: (
        os.spawn
        argv: fa
        cwd: ""
        outPath: outP.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
    )
    gC: slurp path: gold
    oC: slurp path: outP.stringView
    if rc == 0 when oC.stringView == gC then {
        r.passN = r.passN + 1
    } else {
        print "FAIL(fmt) \{name}"
        r.fails = r.fails + 1
        return
    }
    againP: "\{r.tmp.stringView}/F_\{name}.again"
    ga: binArgv :bin :argsFile
    ga.append from: gold.string
    rc2: (
        os.spawn
        argv: ga
        cwd: ""
        outPath: againP.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
    )
    aC: slurp path: againP.stringView
    if rc2 == 0 when aC.stringView == gC then {
        r.passN = r.passN + 1
    } else {
        print "FAIL(fmt-idem) \{name}"
        r.fails = r.fails + 1
    }
}

# addSelfhostJob -- one pooled invocation of the sanitized compiler over one
# unit in one mode. ONE job per (unit, mode) and not one job with two steps,
# because runJobs reports a job's status as its LAST step's exit and the leak
# arm's precondition needs each invocation's own.
#
# `allowFail: true` throughout: a non-zero exit is data here, not a harness
# failure -- selfhostVerdict decides what it means.
addSelfhostJob: function {
    r: Runner
    pool: (List PoolJob).borrow
    names: (List String).borrow
    modes: (List String).borrow
    errs: (List String).borrow
    zcaB: StringView
    name: StringView
    srcdir: StringView
    dumpMode: bool
} is {
    # the mode arrives as a bool and the spellings are produced from it, never
    # compared against it: a literal compare here would cost the A001 ratchet,
    # and one composed path would cost A002.
    errPath: "\{r.tmp.stringView}/SA1_\{name}.err"
    if dumpMode then errPath = "\{r.tmp.stringView}/SA2_\{name}.err"
    mode: "emit-c".string
    if dumpMode then mode = "dump-sql".string
    args: List String
    args.append from: zcaB.string
    args.append from: name.string
    args.append from: "--src".string
    args.append from: srcdir.string
    args.append from: "--system".string
    args.append from: r.sys.copy
    if dumpMode then {
        args.append from: "--dump-sql".string
        args.append from: "-".string
    } else {
        args.append from: "--emit-c".string
        args.append from: os.nullDevice
    }
    steps: List PoolStep
    steps.append (
        zjobs.mkStep
        argv: args
        cwd: ""
        outPath: os.nullDevice.stringView
        errPath: errPath.stringView
        timeoutSecs: r.timeoutSecs
        allowFail: true
        zlinkFrom: ""
    )
    pool.append (zjobs.mkJob :name :steps)
    names.append from: name.string
    modes.append from: mode
    errs.append from: errPath
}

# selfhostVerdict -- judge one sanitized run of the compiler over one unit.
#
# The leak arm has a PRECONDITION the others do not: allocation balance is only
# claimed of a compile that COMPLETED. `os.exit` terminates immediately and by
# design skips zerolang's destructors, so a zc that reported an error and exited
# non-zero is holding every structure it had -- 10,812 blocks on a typical unit,
# all of them still REACHABLE, none lost. That is expected and it is what the
# kernel reclaims a moment later; freeing first would be wasted work on the path
# where the user is already waiting for a diagnostic, which is why clang's
# driver passes -disable-free by default and gcc never frees its arenas.
#
# So a non-zero exit is a SKIP, reported by name and counted, not a pass and not
# a failure. Do not "simplify" the condition away: without it every unit that
# does not compile standalone -- 41 of the 499 in examples/ + emitc_corpus,
# which is what a library unit with no `main` looks like -- reds this gate for a
# non-bug, and the leak channel is saturated so nothing real can be seen either.
# Measured before it was written this way: zls, the one long-lived process that
# reuses this machinery, re-analyses an erroring document with a CONSTANT
# imbalance (12,656 at 1, 11 and 21 analyses -- its own shutdown), so nothing
# in the tree grows unboundedly and there is nothing here to repair.
#
# `unsafe` is deliberately UNCONDITIONAL. A use-after-free or a double free is a
# defect whatever the exit status; only the balance claim depends on the
# destructors having run.
selfhostVerdict: function {
    r: Runner
    sabounds: bool
    name: StringView
    mode: StringView
    status: i32
    err: StringView
} is {
    if (isUnsafe bounds: sabounds s: err) then {
        print "FAIL(selfhost-asan) \{name} \{mode} unsafe"
        r.fails = r.fails + 1
        return
    }
    if status != 0 then {
        print "SKIP(selfhost-asan) \{name} \{mode} (zc)"
        r.skip = r.skip + 1
        return
    }
    if (isLeak bounds: sabounds s: err) then {
        print "FAIL(selfhost-asan) \{name} \{mode} leak"
        r.fails = r.fails + 1
        return
    }
    r.leakclean = r.leakclean + 1
}

# runSelfhostAsan -- the SELFHOST-ASAN (heavy) kind.
runSelfhostAsan: function {r: Runner} is {
    # ---------------- SELFHOST-ASAN (heavy) ----------------
    # Build r.zc itself with ASan, then run it as the compiler over every example
    # and corpus unit in both --emit-c and --dump-sql modes; the COMPILER must
    # be UAF-/leak-free. Heavy (one ASan gcc of r.zc.c + two runs per unit).
    if z.build.os == z.build.oskind.windows then {
        if r.heavy then {
            print "SKIP(selfhost-asan) zc (Linux only: no AddressSanitizer on Windows)"
            r.skip = r.skip + 1
        }
        return
    }
    if r.heavy then {
        # the same per-family sanitizer the leak pool uses: ccArgv picks the
        # spelling, sanEnvKey the environment. Under tcc this is the bounds
        # checker, not ASan, so the kind travels with every verdict below.
        sabounds: usesBoundsChecker ccPath: r.cc.stringView
        zcaC: "\{r.tmp.stringView}/zca.c"
        zcaB: "\{r.tmp.stringView}/zca.bin"
        zcaOk: false
        if (
            buildTool
            :r
            zc: r.zc.stringView
            name: "zc"
            srcdirs: (oneDir d: r.srcDir.stringView)
            csrc: zcaC.stringView
            bin: zcaB.stringView
            asan: true
        ).built then zcaOk = true
        if zcaOk.not then {
            print "FAIL(selfhost-asan-build) zc"
            r.fails = r.fails + 1
        }
        if zcaOk then {
            saPool: List PoolJob
            saNames: List String
            saModes: List String
            saErrs: List String
            saDirs: List String
            saDirs.append from: r.examplesDir.copy
            saDirs.append from: r.corpusDir.copy
            for each sad: saDirs loop {
                snmNames: fixtureNames dir: sad.stringView suffix: ".z"
                for each snmS: snmNames loop {
                    snm: snmS.stringView
                    (
                        addSelfhostJob
                        :r
                        pool: saPool
                        names: saNames
                        modes: saModes
                        errs: saErrs
                        zcaB: zcaB.stringView
                        name: snm
                        srcdir: sad.stringView
                        dumpMode: false
                    )
                    (
                        addSelfhostJob
                        :r
                        pool: saPool
                        names: saNames
                        modes: saModes
                        errs: saErrs
                        zcaB: zcaB.stringView
                        name: snm
                        srcdir: sad.stringView
                        dumpMode: true
                    )
                }
            }
            # pooled, like every other kind: spawning this leg serially costs
            # nothing visible under ASan (~0.085s a run, hidden in a parallel
            # corpus) and dominates everything under tcc's bounds checker
            # (~0.328s a run x 998 = over five minutes, serial).
            # Concurrency is r.jobsMax, which --jobs carries from the caller;
            # the Makefile derives it from nproc, so it follows the machine.
            saStatuses: ListVal i32
            saFailSteps: ListVal i64
            saek: sanEnvKey bounds: sabounds
            saev: sanEnvValue bounds: sabounds
            os.setEnv key: saek.stringView value: saev.stringView
            (
                zjobs.runJobs
                jobs: saPool
                maxJobs: r.jobsMax
                statuses: saStatuses
                failSteps: saFailSteps
            )
            os.unsetEnv key: saek.stringView
            svi: u64
            for svi < saPool.length loop {
                epv: saErrs.get i: svi
                evc: slurp path: epv.stringView
                (
                    selfhostVerdict
                    :r
                    :sabounds
                    name: (saNames.get i: svi).stringView
                    mode: (saModes.get i: svi).stringView
                    status: (saStatuses.get i: svi)
                    err: evc.stringView
                )
                svi = svi + 1
            }
        }
    }
}

# runFixpoint -- the FIXPOINT (heavy) kind.
runFixpoint: function {r: Runner} is {
    # ---------------- FIXPOINT (heavy) ----------------
    # Self-host byte-identity: r.zc emitted by --r.zc, rebuilt, must re-emit itself
    # identically. Heavy (two r.zc self-emits + one gcc of r.zc.c) -- opt-in.
    if r.heavy then {
        fp1: "\{r.tmp.stringView}/fp1.c"
        fp1bin: "\{r.tmp.stringView}/fp1.bin"
        fp2: "\{r.tmp.stringView}/fp2.c"
        fpOk: false
        if (
            buildTool
            :r
            zc: r.zc.stringView
            name: "zc"
            srcdirs: (oneDir d: r.srcDir.stringView)
            csrc: fp1.stringView
            bin: fp1bin.stringView
            asan: false
        ).built then {
            e2: (
                zcArgv
                zc: fp1bin.stringView
                ccFwd: r.ccFwd.stringView
                name: "zc"
                srcdirs: (oneDir d: r.srcDir.stringView)
                sys: r.sys.stringView
                outc: fp2.stringView
            )
            if (
                (
                    os.spawn
                    argv: e2
                    cwd: ""
                    outPath: os.nullDevice.stringView
                    errPath: os.nullDevice.stringView
                    timeoutSecs: 0
                ) ==
                0
            ) then {
                c1: slurp path: fp1.stringView
                c2: slurp path: fp2.stringView
                if c1.stringView == c2 then fpOk = true
            }
        }
        if fpOk then {
            r.passN = r.passN + 1
        } else {
            print "FAIL(fixpoint) zc stage1 != stage2"
            r.fails = r.fails + 1
        }
    }
}

# wrongUsage -- the exit code of a command line the runner does not accept
wrongUsage: 2

# printUsage -- the runner's flags, to STDERR, as the other drivers print theirs
printUsage: function is {
    io.eprintln "usage: ztestrunner [flags]"
    io.eprintln "  --zc ZC         the compiler under test (default out/zc)"
    io.eprintln "  --cc CC         the C compiler its output is built with (default gcc)"
    io.eprintln "  --ccflags STR   flags passed to that C compiler"
    io.eprintln "  --cc-forward    pass --cc on to zc, which then runs that compiler itself"
    io.eprintln "  --root DIR      the repository root (default .)"
    io.eprintln "  --jobs N        how many cases run at once (default: one per processor)"
    io.eprintln "  --timeout N     the seconds one step of a case may take (default 60)"
    io.eprintln "  --tmp DIR       the scratch directory (default: its own, under the system's)"
    io.eprintln "  --save-temps    keep the scratch directory"
    io.eprintln "  --heavy         add the self-host ASan run, the fixpoint and the doc ratchet"
    io.eprintln "  --stop-early    in a full run, stop once a case has failed: after the error"
    io.eprintln "                  cases, at the first slice of run cases with a failure, or"
    io.eprintln "                  after the leak cases"
    io.eprintln "  --report        exit 0 whatever failed"
    io.eprintln "  --regen-lsp     rewrite the LSP goldens from this run's answers"
    io.eprintln "  --regen-usage   rewrite each usage case's expected files from this run's answers"
    io.eprintln "  --known FILE    the run cases' expected failures, one `<case> (<why>)` a line"
    io.eprintln "  --cases TEXT    run only the run cases whose name starts with TEXT or whose"
    io.eprintln "                  directory is TEXT (repeats)"
    io.eprintln "  --cases-naming WORD  run only the run cases whose source names WORD (repeats)"
    io.eprintln "  --zc-flag FLAG  add FLAG to each run case's zc command line (repeats)"
    io.eprintln "  --zc-build      zc builds each run case itself (`zc build`, with --cc's compiler)"
    io.eprintln "  --repeat N      run each run case that passed N more times, each run judged"
    io.eprintln "  --only KIND     run one kind alone:"
    io.eprintln "                  run      the run cases; --target TRIPLE builds them for another"
    io.eprintln "                           system and --exec PROGRAM runs each one under that program"
    io.eprintln "                  doccode  the examples and the pages of the documentation"
    io.eprintln "                  agree    the nativec agreement check"
    io.eprintln "                  arch     the architecture ratchet"
    io.eprintln "                  emitted  what the emitted C holds, from one shared emit"
    io.eprintln "                  vocab    the spec and the highlighters carry the lexer's words"
    io.eprintln "                  pins     the counts the compiler's own source is held at"
    io.eprintln "                  fixtures the case lists name every program, and fixtures follow L023"
    io.eprintln "                  usage    the drivers' command lines, judged by output and exit"
    io.eprintln "                  probes   ThreadSanitizer, with --cc, reports a race made on purpose"
    io.eprintln "                  pedantic the C of the drivers and the run cases, for --target, has no"
    io.eprintln "                           -Wpedantic diagnostic under --cc and --ccflags"
    io.eprintln "                  ctest    the C test programs, tests/c/*_test.c, built by --cc"
    io.eprintln "                           (--ccflags after the file) and run under --exec"
    io.eprintln "                  natives  zc natives show places what zc emit --mark-natives marks"
    io.eprintln "                  usernative  a unit outside the standard library builds and runs its"
    io.eprintln "                           own natives, and check rows refuses a mistyped key"
    io.eprintln "                  piece    zc natives check needs reports a record taken out of the"
    io.eprintln "                           emitter, and passes the emitter itself"
    io.eprintln "                  statictcc  no libtcc symbol in the zc, zl and zls beside --zc"
    io.eprintln "                  cobj     a unit's C source builds once through the object cache"
    io.eprintln "                  linemarks  zc --line-marks adds directives only, the run cases build"
    io.eprintln "                           and run with them, and gcov reads the fixture's lines"
    io.eprintln "A value is written `--name VALUE` or `--name=VALUE`."
}

# addSwitch -- declares a flag on `sp`. It has no short alias and no help text:
# the usage is written by hand (printUsage).
addSwitch: function {sp: cli.Spec.borrow name: StringView} is {
    cli.addFlag spec: sp name: name.string shortName: "".string help: "".string
}

# addValue -- declares an option on `sp` that a command line may leave out
addValue: function {sp: cli.Spec.borrow name: StringView} is {
    (
        cli.addOption
        spec: sp
        name: name.string
        shortName: "".string
        help: "".string
        required: false
    )
}

# runnerSpec -- the runner's command line: switches and options, no operand
runnerSpec: function out cli.Spec is {
    sp: cli.Spec.create programName: "ztestrunner".string summary: "".string
    addSwitch :sp name: opt.ccForward
    addSwitch :sp name: opt.report
    addSwitch :sp name: opt.heavy
    addSwitch :sp name: opt.stopEarly
    addSwitch :sp name: opt.saveTemps
    addSwitch :sp name: opt.regenLsp
    addSwitch :sp name: opt.regenUsage
    addSwitch :sp name: opt.zcBuild
    cli.addFlag spec: sp name: opt.help.string shortName: "-h".string help: "".string
    addValue :sp name: opt.zc
    addValue :sp name: opt.cc
    addValue :sp name: opt.ccflags
    addValue :sp name: opt.root
    addValue :sp name: opt.jobs
    addValue :sp name: opt.timeout
    addValue :sp name: opt.target
    addValue :sp name: opt.exec
    addValue :sp name: opt.tmp
    addValue :sp name: opt.only
    addValue :sp name: opt.known
    addValue :sp name: opt.repeats
    (
        cli.addOption
        spec: sp
        name: opt.zcFlag.string
        shortName: "".string
        help: "".string
        required: false
        repeats: true
    )
    (
        cli.addOption
        spec: sp
        name: opt.cases.string
        shortName: "".string
        help: "".string
        required: false
        repeats: true
    )
    (
        cli.addOption
        spec: sp
        name: opt.casesNaming.string
        shortName: "".string
        help: "".string
        required: false
        repeats: true
    )
    return sp
}

# refuse -- says on stderr why the command line is not accepted, and stops the
# runner before it has made anything
refuse: function {why: StringView} is {
    io.eprintln why
    os.exit code: wrongUsage
}

# textOr -- the option `name` as written, `d` when it was not
textOr: function {p: cli.Parsed.view name: StringView d: StringView} out String is {
    v: p.option :name
    match (
        v
    ) case some then {
        return v.copy
    } case none then {
        return d.string
    }
}

# numberOf -- the option `name` read as a number; -1 when it was not written,
# or when what was written is no number an i32 holds
numberOf: function {p: cli.Parsed.view name: StringView} out i32 is {
    v: p.option :name
    match (
        v
    ) case some then {
        pv: v.stringView.parseU64
        match (
            pv
        ) case ok then {
            n: pv.i32
            match (
                n
            ) case ok then {
                return n
            } case err then null
        } case err then null
    } case none then null
    return -1
}

# jobsOf -- --jobs: how many cases run at once. One per processor when it was
# not written, so the count follows the machine: a fixed default of 1 would be
# silently serial on a many-core one.
jobsOf: function {p: cli.Parsed.view} out u64 is {
    if (p.given name: opt.jobs).not then return os.cpuCount.u64.orPanic
    n: numberOf :p name: opt.jobs
    if n < 1 then refuse "ztestrunner: --jobs needs a number, 1 or more"
    return n.u64.orPanic
}

# repeatsOf -- --repeat: how many more times a passing RUN case runs; none when
# it was not written
repeatsOf: function {p: cli.Parsed.view} out u64 is {
    if (p.given name: opt.repeats).not then return 0
    n: numberOf :p name: opt.repeats
    if n < 0 then refuse "ztestrunner: --repeat needs a number, 0 or more"
    return n.u64.orPanic
}

# timeoutOf -- --timeout: the seconds one step may take; a minute when it was
# not written
timeoutOf: function {p: cli.Parsed.view} out i32 is {
    if (p.given name: opt.timeout).not then return 60
    n: numberOf :p name: opt.timeout
    if n < 0 then refuse "ztestrunner: --timeout needs a number"
    return n
}

# onlyKind -- the slot in kindWord of the kind `p`'s `--only` names; kindWord's
# length when it names none, and when `--only` is not written
onlyKind: function {p: cli.Parsed.view} out u64 is {
    words: zast.Vocab.create block: kindWord
    v: p.option name: opt.only
    match (
        v
    ) case some then {
        return (words.slotOf text: v.stringView)
    } case none then {
        return kindWord.length
    }
}

# refuseMisuse -- stops the runner on a command line cli reads and the runner
# cannot honour: an operand, a kind `--only` does not know, a foreign target
# or compiler outside the one kind that builds for one, or a root that is not
# a repository
refuseMisuse: function {r: Runner.view p: cli.Parsed.view} is {
    if p.extraArgs.length > 0 then {
        surplus: "ztestrunner: unexpected argument '\{p.extraArgs.get i: 0}'"
        refuse surplus.stringView
    }
    written: textOr :p name: opt.only d: ""
    if written.length > 0 when r.only == kindWord.length then {
        unknown: "ztestrunner: --only takes run, doccode, agree, arch, emitted, vocab, pins, fixtures, usage, probes, pedantic, ctest, windows, natives, usernative, piece, statictcc, cobj or linemarks, not '\{written}'"
        refuse unknown.stringView
    }
    runOnly: r.only == kindWord.slot.run
    takesTarget: runOnly or (r.only == kindWord.slot.pedantic)
    if r.target.length > 0 when takesTarget.false then {
        refuse "ztestrunner: --target needs --only run or --only pedantic; no other kind emits for another system"
    }
    runsForeign: runOnly or (r.only == kindWord.slot.ctest)
    if r.exec.length > 0 when runsForeign.false then {
        refuse "ztestrunner: --exec needs --only run or --only ctest; no other kind runs a foreign binary"
    }
    if (r.zcFlags.length > 0) or (r.repeats > 0) or r.zcBuild when runOnly.false then {
        refuse "ztestrunner: --zc-flag, --zc-build and --repeat need --only run; they change how the run cases are built and run"
    }
    if (zcc.ccFamilyOf ccPath: r.cc.stringView).msvc when runsForeign.false then {
        refuse "ztestrunner: --cc cl needs --only run or --only ctest; the other kinds build with gcc's command line"
    }
    # every kind reads the repository under the root: a root without the
    # standard library would leave each kind nothing to check, and a kind that
    # checks nothing passes
    stdlib: "\{r.root}/lib/system"
    if (io.exists path: stdlib).not then {
        noRepo: "ztestrunner: the root '\{r.root}' holds no lib/system; --root names the repository's top directory"
        refuse noRepo.stringView
    }
}

# runnerFrom -- the Runner the command line `p` asks for. What `p` leaves out
# keeps its default: `out/zc` under the current directory, built with gcc, one
# job per processor, a minute per step. `ccFwd` is `cc` when --cc-forward was
# written, wherever on the line the two stand. The paths under the root are
# derived once the root is known (runnerPathsUnderRoot).
runnerFrom: function {p: cli.Parsed.view} out Runner is {
    cc: textOr :p name: opt.cc d: "gcc"
    ccFwdOn: p.hasFlag name: opt.ccForward
    ccFwd: String
    if ccFwdOn then ccFwd = cc.copy
    return (
        Runner
        root: (textOr :p name: opt.root d: ".")
        zc: (textOr :p name: opt.zc d: "out/zc")
        :cc
        ccflags: (textOr :p name: opt.ccflags d: "")
        :ccFwd
        :ccFwdOn
        sys: String
        tmp: (textOr :p name: opt.tmp d: "")
        known: (textOr :p name: opt.known d: "")
        cases: (p.optionAll name: opt.cases)
        cases2: (p.optionAll name: opt.casesNaming)
        zcFlags: (p.optionAll name: opt.zcFlag)
        repeats: (repeatsOf :p)
        zcBuild: (p.hasFlag name: opt.zcBuild)
        jobsMax: (jobsOf :p)
        timeoutSecs: (timeoutOf :p)
        heavy: (p.hasFlag name: opt.heavy)
        stopEarly: (p.hasFlag name: opt.stopEarly)
        report: (p.hasFlag name: opt.report)
        saveTemps: (p.hasFlag name: opt.saveTemps)
        regenLsp: (p.hasFlag name: opt.regenLsp)
        regenUsage: (p.hasFlag name: opt.regenUsage)
        only: (onlyKind :p)
        target: (textOr :p name: opt.target d: "")
        exec: (textOr :p name: opt.exec d: "")
        errors: String
        rungold: String
        examplesDir: String
        corpusDir: String
        dumpgold: String
        srcDir: String
        unitDir: String
        passN: 0
        leakclean: 0
        xleak: 0
        xfail: 0
        skip: 0
        fails: 0
    )
}

# runnerPathsUnderRoot -- the stdlib, fixture and source directories, all
# under the root the command line settled on.
runnerPathsUnderRoot: function {r: Runner} is {
    root: r.root.stringView
    r.sys = "\{root}/lib/system"
    r.errors = "\{root}/tests/fixtures/errors"
    r.rungold = "\{root}/tests/fixtures/run_golden"
    r.examplesDir = "\{root}/examples"
    r.corpusDir = "\{root}/tests/fixtures/emitc_corpus"
    r.dumpgold = "\{root}/tests/fixtures/dump_golden"
    r.srcDir = "\{root}/src"
    r.unitDir = "\{root}/tests/unit"
}

# sweepStaleTmp -- remove the scratch trees crashed prior runs left behind in
# `tmp`: the names are pid-scoped, and a live owner still has /proc/<pid>. Not
# on Windows, which has no /proc to ask: there a crashed run's tree stays.
sweepStaleTmp: function {tmp: StringView myPidS: StringView} is {
    if z.build.os == z.build.oskind.windows then return
    stale: io.listDir path: tmp
    if stale.err then return
    for each se: stale loop {
        sv: se.stringView
        if sv.startsWith "ztr_" then {
            spid: sv.substring from: 4 to: sv.length
            proc: "/proc/\{spid}"
            if spid != myPidS when (io.exists path: proc).not then {
                own: "ztr_\{spid}"
                dead: path.join a: tmp b: own.stringView
                io.removeTree path: dead.stringView
            }
        }
    }
}

# runKinds -- make the scratch directory, run every case kind `r` asks for in
# turn, and report the counts. The exit status is `fails`, nothing else.
runKinds: function {r: Runner} is {
    if r.tmp.length == 0 then {
        mypid: os.pid
        myPidS: "\{mypid}"
        tdir: os.tempDir
        own: "ztr_\{mypid}"
        r.tmp = path.join a: tdir.stringView b: own.stringView
        sweepStaleTmp tmp: tdir.stringView myPidS: myPidS.stringView
    }
    io.mkdirp path: r.tmp
    # A sanitizer's symbolizer fetches debug info over the network where
    # DEBUGINFOD_URLS names a server, and a run waiting on it outlives its
    # timeout with its report unwritten. The runner never reaches the network:
    # symbols come from the binaries' own DWARF.
    os.setEnv key: "DEBUGINFOD_URLS" value: ""

    if r.only < kindWord.length then {
        runOneKind :r
    } else {
        runErrorCases :r
        runLoneErrorCases :r
        if (stopsEarly :r).not then runProgramKinds :r
    }
    finishRun :r
}

# stopsEarly -- with --stop-early, a case has failed: the full run ends here
stopsEarly: function {r: Runner.view} out bool is {
    return r.stopEarly and (r.fails > 0)
}

# runProgramKinds -- the default kinds after the error cases, which come
# first because zc alone answers them, in seconds: the run cases, the LSP and
# the leak cases, then (unless the run stops early) the rest
runProgramKinds: function {r: Runner} is {
    runRunCases :r
    if (stopsEarly :r) then return
    runLspCases :r
    runLeakCases :r
    if (stopsEarly :r).not then runOtherKinds :r
}

# runOtherKinds -- the default kinds after the leak cases
runOtherKinds: function {r: Runner} is {
    runZdataCases :r
    runDumpCases :r
    runDifferentialCases :r
    runVfsCases :r
    runProjectCases :r
    runUsageCases :r
    runErrCodeCases :r
    runSmokeCases :r
    runFmtCases :r
    vocab.runVocabCases :r
    pins.runPinsCases :r
    fixtures.runFixtureCases :r
    natives.runNativesCases :r
    usernative.runUserNativeCases :r
    piece.runPieceCases :r
    statictcc.runStaticTccCases :r
    cobj.runCobjCases :r
    linemarks.runLineMarkCases :r
    runDoccodeCases :r
    runDocPageCases :r
    runSelfhostAsan :r
    runFixpoint :r
    runArchCases :r
    runDocCases :r
}

# finishRun -- the scratch directory removed unless kept, the counts printed,
# and the runner's exit: 0 when no case failed, or with --report
finishRun: function {r: Runner} is {
    if r.saveTemps then {
        print "kept test artifacts at \{r.tmp.stringView}"
    } else {
        io.removeTree path: r.tmp.stringView
    }
    print "----"
    print "pass=\{r.passN} leak-clean=\{r.leakclean} xfail=\{r.xfail} xleak=\{r.xleak} skip=\{r.skip} fails=\{r.fails}"
    if r.report then {
        os.exit code: 0
    }
    if r.fails == 0 then {
        print "CORPUS GATE GREEN"
        os.exit code: 0
    } else {
        print "CORPUS GATE FAILED (\{r.fails})"
        os.exit code: 1
    }
}

# runOneKind -- the one kind `--only` names, when it is one this file holds;
# runSubunitKind runs the kinds the subunits hold
runOneKind: function {r: Runner} is {
    if r.only == kindWord.slot.doccode then {
        runDoccodeCases :r
        runDocPageCases :r
    } else if r.only == kindWord.slot.agree then {
        runAgreeCases :r
    } else if r.only == kindWord.slot.arch then {
        runArchCases :r
    } else if r.only == kindWord.slot.run then {
        runRunCases :r
    } else if r.only == kindWord.slot.usage then {
        runUsageCases :r
    } else runSubunitKind :r
}

# runSubunitKind -- the one kind `--only` names, of those a subunit holds
runSubunitKind: function {r: Runner} is {
    if r.only == kindWord.slot.emitted then {
        emitted.runEmittedCases :r
    } else if r.only == kindWord.slot.vocab then {
        vocab.runVocabCases :r
    } else if r.only == kindWord.slot.pins then {
        pins.runPinsCases :r
    } else if r.only == kindWord.slot.fixtures then {
        fixtures.runFixtureCases :r
    } else if r.only == kindWord.slot.probes then {
        probes.runProbeCases :r
    } else if r.only == kindWord.slot.pedantic then {
        pedantic.runPedanticCases :r
    } else if r.only == kindWord.slot.ctest then {
        ctests.runCtestCases :r
    } else if r.only == kindWord.slot.natives then {
        natives.runNativesCases :r
    } else if r.only == kindWord.slot.usernative then {
        usernative.runUserNativeCases :r
    } else if r.only == kindWord.slot.piece then {
        piece.runPieceCases :r
    } else if r.only == kindWord.slot.statictcc then {
        statictcc.runStaticTccCases :r
    } else if r.only == kindWord.slot.cobj then {
        cobj.runCobjCases :r
    } else if r.only == kindWord.slot.linemarks then {
        linemarks.runLineMarkCases :r
    } else if r.only == kindWord.slot.windows then {
        windows.runWindowsCases :r
    }
}

# read the command line, build the Runner it asks for, and run its kinds. A
# command line the runner does not accept is refused on stderr with exit 2,
# before anything is made or run.
main: function is {
    sp: runnerSpec
    pr: cli.parse spec: sp args: os.args
    match (
        pr
    ) case ok then {
        if (pr.hasFlag name: opt.help) then {
            printUsage
            os.exit code: 0
        }
        r: runnerFrom p: pr
        refuseMisuse :r p: pr
        runnerPathsUnderRoot :r
        runKinds :r
    } case err then {
        io.eprintln (cli.errorText spec: sp e: pr)
        os.exit code: wrongUsage
    }
}
