# ztestrunner.z -- the self-hosted corpus test gate, driven entirely by
# os.spawn. Case kinds, each compared to a committed golden under
# tests/fixtures:
#   run      run_cases.txt -> emit -> cc -> run; stdout matches
#            run_golden/<n>.out, exit code matches <n>.exit (0 default)
#   lsp      framed JSON-RPC transcripts replayed through zls
#   leak     every buildable example + emitc_corpus program under ASan with
#            detect_leaks=1: no use-after-free, no double free, 0 bytes leaked
#   error    errors/<n>.z must fail with the error[Exxxx] lines of <n>.err
#   dump     dump_cases.txt -> `zc dump --canon` matches dump_golden/<n>.canon
#   lexer / parser / program goldens for every example
#   vfs      zvfs script dispatch
#   smoke    per-unit no-arg binaries against <unit>_z/smoke.expected
#   --heavy adds the self-host ASan run and the byte-identity fixpoint.
#
# Usage: ztestrunner --zc <zc> --cc gcc --root <repo> [--jobs N] [--heavy] [--report]

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

# slurp -- file content as an owned String, or "" when unreadable.
slurp: function {path: StringView} out String is {
    r: io.readText :path
    match (
        r
    ) case ok then {
        return r.copy
    } case err then {
        return "".string
    }
    return "".string
}

# declaresMain -- the file declares a top-level `main: function`. A unit with
# none is a LIBRARY: it exists to be opened by another program and is compiled
# through its dependant, so compiling it AS a program is E0039. The two sweeps
# below walk a whole directory rather than a case list, so they are the only
# places that would hand one to the compiler on its own. Mirrors the same
# `^main: *function` test the Makefile's case-guard uses on the other side.
declaresMain: function {path: StringView} out bool is {
    c: slurp :path
    with it: c.stringview.lines do for ln: it loop {
        if (ln.startsWith prefix: "main:") then {
            # bound, not chained: `(a.substring ...).trimStart` emits broken C
            # (the native is called undeclared, and the emitter takes & of the
            # call's result). Pre-existing; the seed compiler does it too.
            a: ln.substring from: 5 to: ln.length
            r: a.trimStart
            if (r.startsWith prefix: "function") then return true
        }
    }
    return false
}

# normErr -- keep only the stable error contract: the error code+message
# lines and the "N error(s) found" summary, each newline-terminated.
# Mirrors run_corpus.sh's grep -aE '^error\[E..\]:|[0-9]+ error(s)? found'.
normErr: function {content: StringView} out String is {
    buf: String
    with it: content.lines do for ln: it loop {
        keep: false
        if (ln.startsWith prefix: "error[E") then keep = true
        if (ln.endsWith suffix: "error found") then keep = true
        if (ln.endsWith suffix: "errors found") then keep = true
        if keep then {
            buf.append ln
            buf.append "\n"
        }
    }
    return buf
}

# isUnsafe -- ASan reported a memory-safety violation (not a mere leak).
isUnsafe: function {s: StringView} out bool is {
    if (s.contains needle: "ERROR: AddressSanitizer: heap-use-after-free") then return true
    if (s.contains needle: "ERROR: AddressSanitizer: attempting double-free") then return true
    if (s.contains needle: "ERROR: AddressSanitizer: heap-buffer-overflow") then return true
    if (s.contains needle: "ERROR: AddressSanitizer: stack-") then return true
    return false
}

# isLeak -- ASan reported leaked bytes.
isLeak: function {s: StringView} out bool is {
    if (s.contains needle: "SUMMARY: AddressSanitizer:") == false then return false
    return (s.contains needle: " byte")
}

# zcArgv -- the zc emit command argv. `ccFwd`, when non-empty, names the
# C compiler to zc ITSELF rather than only to the harness's compile step: the
# `platform` unit folds on it during type checking, so a `require:` guard
# decides differently with it than without. Empty by default, because passing
# it unconditionally would move platform.cc off `other` for every ordinary run.
zcArgv: function {
    zc: StringView
    ccFwd: StringView
    name: StringView
    srcdir: StringView
    sys: StringView
    outc: StringView
} out List String is {
    a: (List String)
    a.append from: zc.string
    a.append from: name.string
    if ccFwd.length > 0 then {
        a.append from: "--cc".string
        a.append from: ccFwd.string
    }
    a.append from: "--src".string
    a.append from: srcdir.string
    a.append from: "--system".string
    a.append from: sys.string
    a.append from: "--emit-c".string
    a.append from: outc.string
    return a
}

# dumpArgv -- the canonical-state dump command argv (dump --canon).
dumpArgv: function {
    zc: StringView
    name: StringView
    srcdir: StringView
    sys: StringView
} out List String is {
    a: (List String)
    a.append from: zc.string
    a.append from: "dump".string
    a.append from: name.string
    a.append from: "--src".string
    a.append from: srcdir.string
    a.append from: "--system".string
    a.append from: sys.string
    a.append from: "--canon".string
    return a
}

# zlinkArgs -- the `-l` flags the emitted C declares on its fixed second line,
# `/* zlink: name name */`. The generated file states its own link
# requirements, so the harness reads them off the artifact rather than being
# told separately. Only the header is parsed: these files reach 5.8 MB.
zlinkArgs: function {csrc: StringView} out List String is {
    flags9k: (List String)
    txt9k: slurp path: csrc
    if txt9k.length == 0 then return flags9k
    end9k: txt9k.length
    if end9k > 512 then end9k = 512
    head9k: txt9k.stringview.substring from: 0 to: end9k
    idx9k: u64
    with lit9k: (head9k.split sep: "\n") do for line9k: lit9k loop {
        if idx9k == 1 then {
            seen9k: false
            with tit9k: (line9k.split sep: " ") do for tok9k: tit9k loop {
                if tok9k == "*/" then seen9k = false
                if seen9k then {
                    la9k: "-l".string
                    la9k.append tok9k
                    flags9k.append from: la9k
                }
                if tok9k == "zlink:" then seen9k = true
            }
        }
        idx9k = idx9k + 1
    }
    return flags9k
}

# withZlink -- `argv` plus the `-l` flags `csrc` declares. The emitted C must
# already exist, so a pipeline step whose C is written by an earlier step
# resolves this at spawn time instead (PoolStep.zlinkFrom).
withZlink: function {argv: (List String).take csrc: StringView} out List String is {
    zl9m: zlinkArgs :csrc
    with zit9m: zl9m.iterate do for zf9m: zit9m loop {
        argv.append from: zf9m.copy
    }
    return argv
}

# withExtraArgs -- `argv` plus one element per non-empty line of `file`. An
# error fixture that needs a compiler flag -- `--cc tcc`, to prove a require:
# guard fires without tcc installed -- names it in <name>.zcargs beside its
# .err golden, the way a run case names its program's argv in <name>.args.
# An absent file reads as empty, since slurp returns "" for an unreadable path.
withExtraArgs: function {argv: (List String).take file: StringView} out List String is {
    ac9x: slurp path: file
    acv9x: ac9x.stringview
    with it9x: acv9x.lines do for ln9x: it9x loop {
        if ln9x.length > 0 then {
            argv.append from: ln9x.string
        }
    }
    return argv
}

# gccArgv -- the C build command argv; `asan` selects the ASan flags
# (-fsanitize=address -g -O0 -std=c17 -w) over the strict CF set. `ccflags`
# carries what the harness cannot infer about the compiler -- tcc needs
# `-B <payload>` or it cannot resolve its own stddef.h, since the directory it
# was configured with is not the one it is running from.
gccArgv: function {
    cc: StringView
    ccflags: StringView
    bin: StringView
    csrc: StringView
    asan: bool
} out List String is {
    a: (List String)
    a.append from: cc.string
    with cfit9g: (ccflags.split sep: " ") do for cf9g: cfit9g loop {
        if cf9g.length > 0 then a.append from: cf9g.string
    }
    if asan then {
        a.append from: "-fsanitize=address".string
        a.append from: "-g".string
        a.append from: "-O0".string
        a.append from: "-std=c17".string
        a.append from: "-w".string
    } else {
        a.append from: "-std=c17".string
        a.append from: "-Wall".string
        a.append from: "-Wextra".string
        a.append from: "-Wno-unused-function".string
        a.append from: "-Wno-unused-parameter".string
        a.append from: "-Werror=implicit-function-declaration".string
        a.append from: "-Werror=implicit-int".string
        a.append from: "-Werror=int-conversion".string
        a.append from: "-Werror=incompatible-pointer-types".string
    }
    a.append from: "-o".string
    a.append from: bin.string
    a.append from: csrc.string
    a.append from: "-lm".string
    return a
}

# binArgv -- the test-binary argv: the binary plus one element per
# non-empty line of run_golden/<name>.args (absent file -> just the bin).
binArgv: function {bin: StringView argsFile: StringView} out List String is {
    a: (List String)
    a.append from: bin.string
    ac: slurp path: argsFile
    acv: ac.stringview
    with it: acv.lines do for ln: it loop {
        if ln.length > 0 then {
            a.append from: ln.string
        }
    }
    return a
}

# PoolStep -- one spawn in a job's pipeline. allowFail steps record a
# nonzero exit without ending the job (a run step's exit code is data,
# compared against the golden -- only zc/cc steps are hard gates).
PoolStep: class {
    argv: (List String)
    cwd: String
    outPath: String
    errPath: String
    timeoutSecs: i32
    allowFail: bool
    # the emitted C whose declared link libraries this step must add, resolved
    # when the step runs because an earlier step in the pipeline writes it
    zlinkFrom: String
}

# build one pipeline step (a named command) for a test job.
mkStep: function {
    argv: (List String).take
    cwd: StringView
    outPath: StringView
    errPath: StringView
    timeoutSecs: i32
    allowFail: bool
    zlinkFrom: StringView
} out PoolStep is {
    return (PoolStep
        :argv
        cwd: cwd.string
        outPath: outPath.string
        errPath: errPath.string
        :timeoutSecs
        :allowFail
        zlinkFrom: zlinkFrom.string
    )
}

# stepArgv -- a step's argv as spawned: the link flags its C declares are
# resolved now, because the C is written by an earlier step of this pipeline.
stepArgv: function {step: PoolStep.view} out List String is {
    a9n: (List String)
    with ait9n: step.argv.iterate do for e9n: ait9n loop {
        a9n.append from: e9n.copy
    }
    if step.zlinkFrom.length == 0 then return a9n
    return (withZlink argv: a9n csrc: step.zlinkFrom.stringview)
}

# PoolJob -- a test case's sequential spawn pipeline (immutable; the
# pool's mutable per-job state lives in runJobs-local parallel arrays,
# since a list `get` hands back a non-owning shallow copy).
PoolJob: class {
    name: String
    steps: (List PoolStep)
}

# build a test job: a named sequence of steps run as a unit.
mkJob: function {name: StringView steps: (List PoolStep).take} out PoolJob is {
    return (PoolJob name: name.string :steps)
}

# runJobs -- drive every job through its steps with at most maxJobs
# children in flight. Steps within a job stay sequential; jobs overlap.
# A step past its deadline is SIGKILLed and recorded as 124 (spawn's
# timeout convention). Results land in the caller's statuses/failSteps,
# indexed by job: failStep -1 = every step ran (status = the LAST
# step's exit); otherwise the index of the hard-failing step.
runJobs: function {
    jobs: (List PoolJob).view
    maxJobs: u64
    statuses: ListVal i32
    failSteps: ListVal i64
} is {
    cap: maxJobs
    if cap == 0 then cap = 1
    total: jobs.length
    pids: (ListVal i32)
    stepIdxs: (ListVal u64)
    deadlines: (ListVal i64)
    killeds: (ListVal bool)
    pi: u64
    for pi < total loop {
        pids.append 0
        stepIdxs.append 0.u64
        deadlines.append 0.i64
        killeds.append false
        statuses.append 0
        failSteps.append -1
        pi = pi + 1
    }
    doneN: u64
    inflight: u64
    for doneN < total loop {
        ji: u64
        for ji < total while inflight < cap loop {
            jpid: pids.get i: ji
            jfail: failSteps.get i: ji
            jstep: stepIdxs.get i: ji
            j: jobs.get i: ji
            if jpid == 0 when jfail == -1 when jstep < j.steps.length then {
                st: j.steps.get i: jstep
                sargv: stepArgv step: st
                pid: (os.spawnAsync
                    argv: sargv
                    cwd: st.cwd.stringview
                    outPath: st.outPath.stringview
                    errPath: st.errPath.stringview
                )
                if pid <= 0 then {
                    statuses.set i: ji val: 127
                    failSteps.set i: ji val: jstep.i64.orPanic
                    doneN = doneN + 1
                } else {
                    pids.set i: ji val: pid
                    killeds.set i: ji val: false
                    if st.timeoutSecs > 0 then {
                        dl: os.monotonicMillis + (st.timeoutSecs.i64 * 1000)
                        deadlines.set i: ji val: dl
                    } else {
                        deadlines.set i: ji val: 0
                    }
                    inflight = inflight + 1
                }
            }
            ji = ji + 1
        }
        if inflight == 0 then return
        r: os.waitAny
        if r.pid > 0 then {
            jk: u64
            hit: false
            for jk < total while hit.false loop {
                if (pids.get i: jk) == r.pid then {
                    hit = true
                    pids.set i: jk val: 0
                    inflight = inflight - 1
                    kstep: stepIdxs.get i: jk
                    j2: jobs.get i: jk
                    stw: j2.steps.get i: kstep
                    stStatus: r.status
                    if (killeds.get i: jk) then stStatus = 124
                    statuses.set i: jk val: stStatus
                    ended: false
                    if stStatus != 0 when stw.allowFail.false then {
                        failSteps.set i: jk val: kstep.i64.orPanic
                        ended = true
                    } else {
                        kn: kstep + 1
                        stepIdxs.set i: jk val: kn
                        if kn >= j2.steps.length then ended = true
                    }
                    if ended then doneN = doneN + 1
                }
                jk = jk + 1
            }
        } else {
            now: os.monotonicMillis
            jm: u64
            for jm < total loop {
                mpid: pids.get i: jm
                mdl: deadlines.get i: jm
                if mpid > 0 when mdl > 0 when now > mdl when (killeds.get i: jm).false then {
                    os.kill pid: mpid
                    killeds.set i: jm val: true
                }
                jm = jm + 1
            }
            os.sleepMillis ms: 5
        }
    }
}

# frameLsp -- wrap each non-empty line of a .msgs transcript in LSP
# Content-Length framing (the bytes zls reads on its --replay input).
frameLsp: function {src: StringView} out String is {
    result: String
    with it: src.lines do for ln: it loop {
        if ln.length > 0 then {
            n: ln.length
            h: "Content-Length: \{n}"
            result.append h
            result.appendByte b: 13
            result.appendByte b: 10
            result.appendByte b: 13
            result.appendByte b: 10
            result.append ln
        }
    }
    return result
}

# deframeLsp -- zls output back to one JSON body per line. The server
# emits the exact form "Content-Length: N\r\n\r\n<body>"; anything
# else surfaces as a literal marker line so the diff fails loudly.
deframeLsp: function {raw: StringView} out String is {
    result: String
    pos: u64
    n: raw.length
    for pos < n loop {
        if pos + 16 > n then {
            result.append "<<deframe error: truncated header>>"
            result.appendByte b: 10
            return result
        }
        okHdr: false
        {
            hd: raw.substring from: pos to: pos + 16
            if hd == "Content-Length: " then okHdr = true
        }
        if okHdr == false then {
            result.append "<<deframe error: bad prefix>>"
            result.appendByte b: 10
            return result
        }
        clen: u64
        i: pos + 16
        for true loop {
            bo: raw.byteAt :i
            match (
                bo
            ) case some then {
                if bo >= 48 when bo <= 57 then {
                    clen = (clen * 10) + (bo.u64 - 48)
                    i = i + 1
                } else {
                    break
                }
            } case none then {
                break
            }
        }
        i = i + 4
        j: u64
        for j < clen loop {
            bo2: raw.byteAt :i
            match (
                bo2
            ) case some then {
                result.appendByte b: bo2
            } case none then null
            i = i + 1
            j = j + 1
        }
        result.appendByte b: 10
        pos = i
    }
    return result
}

# test-runner entry point: build the compiler, run the
# run/leak/error/dump/lsp suites, and report pass/fail counts.
# Runner -- the gate's configuration, the fixture paths and the counters every
# case kind reads and advances. One per run; the kinds take it by reference.
Runner: class {
    root: String
    zc: String
    cc: String
    ccflags: String
    ccFwd: String
    sys: String
    tmp: String
    jobsMax: u64
    timeoutSecs: i32
    heavy: bool
    report: bool
    saveTemps: bool
    errors: String
    rungold: String
    runcases: String
    examplesDir: String
    corpusDir: String
    dumpcases: String
    dumpgold: String
    srcDir: String
    unitDir: String
    passN: u64
    leakclean: u64
    xleak: u64
    xfail: u64
    skip: u64
    fails: u64
}

# runArchCases -- the architecture ratchet. `zl lint --full --arch` over every
# compiler and front-end unit, counted per (rule, file) and compared with
# tests/fixtures/arch_baseline.txt: a count above its baseline is a new
# finding and fails; a count below it is progress and asks for the baseline
# to be lowered; a file with no baseline row must be clean.
runArchCases: function {r: Runner} is {
    basePath: "\{r.root.stringview}/tests/fixtures/arch_baseline.txt"
    if (io.exists path: basePath) == false then {
        r.skip = r.skip + 1
        return
    }
    zl: "\{r.root.stringview}/bin/zl"
    srcs: (List String)
    archUnitFiles root: r.root.stringview sub: "src" into: srcs
    archUnitFiles root: r.root.stringview sub: "lib/system" into: srcs
    archUnitFiles root: r.root.stringview sub: "tests/unit" into: srcs
    srcs.sort
    pool: (List PoolJob)
    with sit: srcs.iterate do for f: sit loop {
        argv: (List String)
        argv.append from: zl.copy
        argv.append from: "lint".string
        argv.append from: "--full".string
        argv.append from: "--arch".string
        argv.append from: "--src".string
        argv.append from: "\{r.root.stringview}/src"
        argv.append from: "--system".string
        argv.append from: r.sys.copy
        argv.append from: "\{r.root.stringview}/\{f.stringview}"
        oname: f.stringview.replace needle: "/" replacement: "_"
        opath: "\{r.tmp.stringview}/A_\{oname}.out"
        steps: (List PoolStep)
        # diagnostics go to zl's stderr
        steps.append (mkStep
            :argv
            cwd: ""
            outPath: "/dev/null"
            errPath: opath.stringview
            timeoutSecs: r.timeoutSecs
            allowFail: true
            zlinkFrom: ""
        )
        pool.append (mkJob name: f.stringview :steps)
    }
    statuses: (ListVal i32)
    failSteps: (ListVal i64)
    runJobs jobs: pool maxJobs: r.jobsMax :statuses :failSteps
    # baseline rows: `<code> <file> <count>`
    baseKeys: (List String)
    baseCounts: (ListVal u64)
    bC: slurp path: basePath.stringview
    with blit: bC.stringview.lines do for bl: blit loop {
        if bl.length > 0 when (bl.startsWith prefix: "#") == false then {
            k0: String
            k1: String
            cnt: u64
            idx: u64
            with pit: (bl.split sep: " ") do for pc: pit loop {
                if pc.length > 0 then {
                    if idx == 0 then k0 = pc.string
                    if idx == 1 then k1 = pc.string
                    if idx == 2 then {
                        pv: pc.parseI64
                        match (
                            pv
                        ) case ok then {
                            cnt = pv.u64.orPanic
                        } case err then null
                    }
                    idx = idx + 1
                }
            }
            if idx >= 3 then {
                baseKeys.append from: "\{k0.stringview} \{k1.stringview}"
                baseCounts.append from: cnt
            }
        }
    }
    anyFail: false
    ji: u64
    for ji < pool.length loop {
        job: pool.get i: ji
        fnm: job.name.stringview
        oname2: fnm.replace needle: "/" replacement: "_"
        opath2: "\{r.tmp.stringview}/A_\{oname2}.out"
        outC: slurp path: opath2.stringview
        # count per code
        codes: (List String)
        counts: (ListVal u64)
        with olit: outC.stringview.lines do for ol: olit loop {
            if (ol.startsWith prefix: "info[A") then {
                archCount :codes :counts code: (ol.substring from: 5 to: 9)
            } else if (ol.startsWith prefix: "warning[A") then {
                archCount :codes :counts code: (ol.substring from: 8 to: 12)
            }
        }
        ci: u64
        for ci < codes.length loop {
            code: codes.get i: ci
            c: counts.get i: ci
            key: "\{code.stringview} \{fnm}"
            base: u64
            bi: u64
            for bi < baseKeys.length loop {
                bk: baseKeys.get i: bi
                if bk.stringview == key.stringview then base = baseCounts.get i: bi
                bi = bi + 1
            }
            if c > base then {
                print "FAIL(arch) \{key}: \{c} findings, baseline \{base} -- a new finding; fix it or justify raising the baseline"
                anyFail = true
            } else if c < base then {
                print "arch: \{key}: \{c} < baseline \{base} -- lower the baseline"
            }
            ci = ci + 1
        }
        ji = ji + 1
    }
    if anyFail then {
        r.fails = r.fails + 1
    } else {
        r.passN = r.passN + 1
    }
}

# archUnitFiles -- the `.z` files under `<root>/<sub>`, as `<sub>/<file>`.
archUnitFiles: function {root: StringView sub: StringView into: List String} is {
    dirp: "\{root}/\{sub}"
    ents: io.listDir path: dirp
    match (
        ents
    ) case ok then {
        with eit: ents.iterate do for e: eit loop {
            if (e.stringview.endsWith suffix: ".z") then into.append from: "\{sub}/\{e.stringview}"
        }
    } case err then null
}

# archCount -- bump the count of `code` in the parallel code / count lists.
archCount: function {codes: List String counts: ListVal u64 code: StringView} is {
    i: u64
    for i < codes.length loop {
        c: codes.get :i
        if c.stringview == code then {
            counts.set :i val: ((counts.get :i) + 1)
            return
        }
        i = i + 1
    }
    codes.append from: code.string
    counts.append from: 1
}

# runRunCases -- the RUN cases kind.
runRunCases: function {r: Runner} is {
    # ---------------- RUN cases ----------------
    rcC: slurp path: r.runcases.stringview
    rcv: rcC.stringview
    runPool: (List PoolJob)
    with rit: rcv.lines do for ln: rit loop {
        if ln.length > 0 then {
            nameStr: String
            dirStr: String
            idx: u64
            with sit: (ln.split sep: " ") do for pc: sit loop {
                if pc.length > 0 then {
                    if idx == 0 then {
                        nameStr = pc.string
                    } else if idx == 1 then dirStr = pc.string
                    idx = idx + 1
                }
            }
            if idx >= 2 then {
                srcAbs: "\{r.root.stringview}/\{dirStr.stringview}"
                cpath: "\{r.tmp.stringview}/\{nameStr.stringview}.c"
                bpath: "\{r.tmp.stringview}/\{nameStr.stringview}.bin"
                opath: "\{r.tmp.stringview}/\{nameStr.stringview}.out"
                rdir: "\{r.tmp.stringview}/run_\{nameStr.stringview}"
                io.mkdirp path: rdir
                argsFile: "\{r.rungold.stringview}/\{nameStr.stringview}.args"
                steps: (List PoolStep)
                za: (zcArgv
                    zc: r.zc.stringview
                    ccFwd: r.ccFwd.stringview
                    name: nameStr.stringview
                    srcdir: srcAbs.stringview
                    sys: r.sys.stringview
                    outc: cpath.stringview
                )
                steps.append (mkStep
                    argv: za
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                    allowFail: false
                    zlinkFrom: ""
                )
                ga: (gccArgv
                    cc: r.cc.stringview
                    ccflags: r.ccflags.stringview
                    bin: bpath.stringview
                    csrc: cpath.stringview
                    asan: false
                )
                steps.append (mkStep
                    argv: ga
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                    allowFail: false
                    zlinkFrom: cpath.stringview
                )
                ba: binArgv bin: bpath.stringview argsFile: argsFile.stringview
                steps.append (mkStep
                    argv: ba
                    cwd: rdir.stringview
                    outPath: opath.stringview
                    errPath: "/dev/null"
                    timeoutSecs: r.timeoutSecs
                    allowFail: true
                    zlinkFrom: ""
                )
                runPool.append (mkJob name: nameStr.stringview :steps)
            }
        }
    }
    runStatuses: (ListVal i32)
    runFailSteps: (ListVal i64)
    runJobs jobs: runPool maxJobs: r.jobsMax statuses: runStatuses failSteps: runFailSteps
    rji: u64
    for rji < runPool.length loop {
        rjob: runPool.get i: rji
        rnm: rjob.name.stringview
        rfail: runFailSteps.get i: rji
        if rfail == 0 then {
            print "FAIL(run) \{rnm} (zc)"
            r.fails = r.fails + 1
        } else if rfail == 1 then {
            print "FAIL(run) \{rnm} (cc)"
            r.fails = r.fails + 1
        } else {
            opath: "\{r.tmp.stringview}/\{rnm}.out"
            gold: "\{r.rungold.stringview}/\{rnm}.out"
            exitFile: "\{r.rungold.stringview}/\{rnm}.exit"
            if (io.exists path: gold) == false then {
                r.skip = r.skip + 1
            } else {
                goldC: slurp path: gold.stringview
                outC: slurp path: opath.stringview
                expStr: "0".string
                if (io.exists path: exitFile) then {
                    rawx: slurp path: exitFile.stringview
                    rxv: rawx.stringview
                    tvw: rxv.trim
                    expStr = tvw.string
                }
                codeStr: "\{runStatuses.get i: rji}"
                sameOut: outC.stringview == goldC.stringview
                sameExit: codeStr.stringview == expStr.stringview
                if sameOut when sameExit then {
                    r.passN = r.passN + 1
                } else {
                    print "FAIL(run) \{rnm}"
                    r.fails = r.fails + 1
                }
            }
        }
        rji = rji + 1
    }
}

# runLspCases -- the LSP (framed transcript) cases kind.
runLspCases: function {r: Runner} is {
    # ---------------- LSP (framed transcript) cases ----------------
    lspCases: "\{r.root.stringview}/tests/fixtures/lsp_cases"
    lspGold: "\{r.root.stringview}/tests/fixtures/lsp_golden"
    lspLs: io.listDir path: lspCases
    match (
        lspLs
    ) case ok then {
        zlsC: "\{r.tmp.stringview}/zls_bin.c"
        zlsB: "\{r.tmp.stringview}/zls_bin"
        srcD: "\{r.root.stringview}/src"
        za: (zcArgv
            zc: r.zc.stringview
            ccFwd: r.ccFwd.stringview
            name: "zls"
            srcdir: srcD.stringview
            sys: r.sys.stringview
            outc: zlsC.stringview
        )
        ec: (os.spawn
            argv: za
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        )
        built: false
        if ec != 0 then {
            print "FAIL(lsp) zls (zc)"
            r.fails = r.fails + 1
        } else {
            ga: (withZlink
                argv: (gccArgv
                    cc: r.cc.stringview
                    ccflags: r.ccflags.stringview
                    bin: zlsB.stringview
                    csrc: zlsC.stringview
                    asan: false
                )
                csrc: zlsC.stringview
            )
            bc: (os.spawn
                argv: ga
                cwd: ""
                outPath: "/dev/null"
                errPath: "/dev/null"
                timeoutSecs: 0
            )
            if bc != 0 then {
                print "FAIL(lsp) zls (cc)"
                r.fails = r.fails + 1
            } else {
                built = true
            }
        }
        if built then {
            names: (List String)
            with lit: lspLs.iterate do for fn: lit loop {
                keep: fn.endsWith ".msgs"
                if fn.endsWith ".raw" then keep = true
                if keep then names.append fn.copy
            }
            names.sort
            with nit: names.iterate do for cf: nit loop {
                cv: cf.stringview
                isRaw: cv.endsWith ".raw"
                ext: 5.u64
                if isRaw then ext = 4
                nm: cv.substring from: 0 to: cv.length - ext
                cp: "\{lspCases.stringview}/\{cv}"
                caseC: slurp path: cp.stringview
                input: String
                if isRaw then {
                    input = caseC.copy
                } else {
                    input = frameLsp src: caseC.stringview
                }
                inP: "\{r.tmp.stringview}/lsp_\{nm}.in"
                wri: io.writeText path: inP content: input
                match (
                    wri
                ) case ok then null case err then {
                    print "FAIL(lsp) \{nm} (write input)"
                    r.fails = r.fails + 1
                }
                outP: "\{r.tmp.stringview}/lsp_\{nm}.raw"
                ba: (List String)
                ba.append zlsB.copy
                ba.append "--replay".string
                ba.append inP.copy
                rc: (os.spawn
                    argv: ba
                    cwd: ""
                    outPath: outP.stringview
                    errPath: "/dev/null"
                    timeoutSecs: r.timeoutSecs
                )
                goldP: "\{lspGold.stringview}/\{nm}.out"
                if (io.exists path: goldP) == false then {
                    r.skip = r.skip + 1
                } else {
                    rawOut: slurp path: outP.stringview
                    norm: deframeLsp raw: rawOut.stringview
                    goldC: slurp path: goldP.stringview
                    sameOut: norm.stringview == goldC.stringview
                    if sameOut when rc == 0 then {
                        r.passN = r.passN + 1
                    } else {
                        print "FAIL(lsp) \{nm}"
                        r.fails = r.fails + 1
                    }
                }
            }
        }
    } case err then null
}

# runLeakCases -- the LEAK cases kind.
runLeakCases: function {r: Runner} is {
    # ---------------- LEAK cases ----------------
    leakDirs: (List String)
    leakDirs.append from: r.examplesDir.copy
    leakDirs.append from: r.corpusDir.copy
    leakPool: (List PoolJob)
    di: u64
    for di < leakDirs.length loop {
        ld: (leakDirs.get i: di)
        lr: io.listDir path: ld
        match (
            lr
        ) case ok then {
            li: u64
            for li < lr.length loop {
                ent: (lr.get i: li)
                sfx: ent.stringview.stripSuffix s: ".z"
                match (
                    sfx
                ) case some then {
                    nm: sfx
                    lpath: "\{ld}/\{ent}"
                    if (declaresMain path: lpath.stringview) == false then {
                        li = li + 1
                        continue
                    }
                    lc: "\{r.tmp}/L_\{nm}.c"
                    lb: "\{r.tmp}/L_\{nm}.bin"
                    lerr: "\{r.tmp}/L_\{nm}.err"
                    rdir2: "\{r.tmp}/leak_\{nm}"
                    io.mkdirp path: rdir2
                    argsFile2: "\{r.rungold}/\{nm}.args"
                    steps: (List PoolStep)
                    za2: (zcArgv
                        zc: r.zc.stringview
                        ccFwd: r.ccFwd.stringview
                        name: nm
                        srcdir: ld.stringview
                        sys: r.sys.stringview
                        outc: lc.stringview
                    )
                    steps.append (mkStep
                        argv: za2
                        cwd: ""
                        outPath: "/dev/null"
                        errPath: "/dev/null"
                        timeoutSecs: 0
                        allowFail: false
                        zlinkFrom: ""
                    )
                    ga2: (gccArgv
                        cc: r.cc.stringview
                        ccflags: r.ccflags.stringview
                        bin: lb.stringview
                        csrc: lc.stringview
                        asan: true
                    )
                    steps.append (mkStep
                        argv: ga2
                        cwd: ""
                        outPath: "/dev/null"
                        errPath: "/dev/null"
                        timeoutSecs: 0
                        allowFail: false
                        zlinkFrom: lc.stringview
                    )
                    ba2: binArgv bin: lb.stringview argsFile: argsFile2.stringview
                    steps.append (mkStep
                        argv: ba2
                        cwd: rdir2.stringview
                        outPath: "/dev/null"
                        errPath: lerr.stringview
                        timeoutSecs: r.timeoutSecs
                        allowFail: true
                        zlinkFrom: ""
                    )
                    leakPool.append (mkJob name: nm :steps)
                } case none then null
                li = li + 1
            }
        } case err then null
        di = di + 1
    }
    leakStatuses: (ListVal i32)
    leakFailSteps: (ListVal i64)
    os.setEnv key: "ASAN_OPTIONS" value: "detect_leaks=1"
    runJobs jobs: leakPool maxJobs: r.jobsMax statuses: leakStatuses failSteps: leakFailSteps
    os.unsetEnv key: "ASAN_OPTIONS"
    lji: u64
    for lji < leakPool.length loop {
        ljob: leakPool.get i: lji
        lnm: ljob.name.stringview
        lfail: leakFailSteps.get i: lji
        if lfail == -1 then {
            lerr: "\{r.tmp.stringview}/L_\{lnm}.err"
            errC: slurp path: lerr.stringview
            isKnown: false
            if (isUnsafe s: errC.stringview) then {
                print "FAIL(unsafe) \{lnm}"
                r.fails = r.fails + 1
            } else if (isLeak s: errC.stringview) then {
                if isKnown then {
                    r.xleak = r.xleak + 1
                } else {
                    print "FAIL(leak) \{lnm}"
                    r.fails = r.fails + 1
                }
            } else {
                if isKnown then {
                    print "FAIL(ratchet) \{lnm} now leak-CLEAN"
                    r.fails = r.fails + 1
                } else {
                    r.leakclean = r.leakclean + 1
                }
            }
        }
        lji = lji + 1
    }
}

# runErrorCases -- the ERROR (negative) cases kind.
runErrorCases: function {r: Runner} is {
    # ---------------- ERROR (negative) cases ----------------
    er: io.listDir path: r.errors
    errPool: (List PoolJob)
    match (
        er
    ) case ok then {
        ei: u64
        for ei < er.length loop {
            ent2: (er.get i: ei)
            esfx: ent2.stringview.stripSuffix s: ".z"
            match (
                esfx
            ) case some then {
                enm: esfx
                epe: "\{r.tmp}/\{enm}.pe"
                steps: (List PoolStep)
                eza: (zcArgv
                    zc: r.zc.stringview
                    ccFwd: r.ccFwd.stringview
                    name: enm
                    srcdir: r.errors.stringview
                    sys: r.sys.stringview
                    outc: "/dev/null"
                )
                exf: "\{r.errors.stringview}/\{enm}.zcargs"
                steps.append (mkStep
                    argv: (withExtraArgs argv: eza file: exf.stringview)
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: epe.stringview
                    timeoutSecs: 0
                    allowFail: true
                    zlinkFrom: ""
                )
                errPool.append (mkJob name: enm :steps)
            } case none then null
            ei = ei + 1
        }
    } case err then null
    errStatuses: (ListVal i32)
    errFailSteps: (ListVal i64)
    runJobs jobs: errPool maxJobs: r.jobsMax statuses: errStatuses failSteps: errFailSteps
    eji: u64
    for eji < errPool.length loop {
        ejob: errPool.get i: eji
        enmv: ejob.name.stringview
        epe: "\{r.tmp.stringview}/\{enmv}.pe"
        egold: "\{r.errors.stringview}/\{enmv}.err"
        ematch: false
        if (errStatuses.get i: eji) != 0 then {
            peC: slurp path: epe.stringview
            goldC2: slurp path: egold.stringview
            ne: normErr content: peC.stringview
            if ne.stringview == goldC2.stringview then ematch = true
        }
        if ematch then {
            r.passN = r.passN + 1
        } else {
            print "FAIL(error) \{enmv}"
            r.fails = r.fails + 1
        }
        efull: "\{r.errors.stringview}/\{enmv}.full"
        if (io.exists path: efull) then {
            fpeC: slurp path: epe.stringview
            fgoldC: slurp path: efull.stringview
            if fpeC.stringview == fgoldC.stringview then {
                r.passN = r.passN + 1
            } else {
                print "FAIL(error-full) \{enmv}"
                r.fails = r.fails + 1
            }
        }
        eji = eji + 1
    }
}

# runDumpCases -- the DUMP (canonical state) cases kind.
runDumpCases: function {r: Runner} is {
    # ---------------- DUMP (canonical state) cases ----------------
    ddC: slurp path: r.dumpcases.stringview
    ddv: ddC.stringview
    dumpPool: (List PoolJob)
    with ddit: ddv.lines do for ln: ddit loop {
        if ln.length > 0 then {
            nameStr: String
            dirStr: String
            idx: u64
            with sit: (ln.split sep: " ") do for pc: sit loop {
                if pc.length > 0 then {
                    if idx == 0 then {
                        nameStr = pc.string
                    } else if idx == 1 then dirStr = pc.string
                    idx = idx + 1
                }
            }
            if idx >= 2 then {
                srcAbs: "\{r.root.stringview}/\{dirStr.stringview}"
                dpath: "\{r.tmp.stringview}/\{nameStr.stringview}.canon"
                steps: (List PoolStep)
                da: (dumpArgv
                    zc: r.zc.stringview
                    name: nameStr.stringview
                    srcdir: srcAbs.stringview
                    sys: r.sys.stringview
                )
                # a dump case pins the whole-program model, which for a unit
                # with no `main` is the EAGER tier's -- the compiler resolves
                # what a program demands, and a program that demands nothing
                # is entitled to an empty model. `<name>.zcargs` beside the
                # source names the flag, the way an error fixture does.
                dxf: "\{srcAbs.stringview}/\{nameStr.stringview}.zcargs"
                steps.append (mkStep
                    argv: (withExtraArgs argv: da file: dxf.stringview)
                    cwd: ""
                    outPath: dpath.stringview
                    errPath: "/dev/null"
                    timeoutSecs: r.timeoutSecs
                    allowFail: true
                    zlinkFrom: ""
                )
                dumpPool.append (mkJob name: nameStr.stringview :steps)
            }
        }
    }
    dumpStatuses: (ListVal i32)
    dumpFailSteps: (ListVal i64)
    runJobs jobs: dumpPool maxJobs: r.jobsMax statuses: dumpStatuses failSteps: dumpFailSteps
    dji: u64
    for dji < dumpPool.length loop {
        djob: dumpPool.get i: dji
        dnm: djob.name.stringview
        dpath: "\{r.tmp.stringview}/\{dnm}.canon"
        dgold: "\{r.dumpgold.stringview}/\{dnm}.canon"
        if (io.exists path: dgold) == false then {
            r.skip = r.skip + 1
        } else {
            gC: slurp path: dgold.stringview
            oC: slurp path: dpath.stringview
            okd: false
            if (dumpStatuses.get i: dji) == 0 then {
                if oC.stringview == gC.stringview then okd = true
            }
            if okd then {
                r.passN = r.passN + 1
            } else {
                print "FAIL(dump) \{dnm}"
                r.fails = r.fails + 1
            }
        }
        dji = dji + 1
    }
}

# lexGoldenCase -- run the token dump over `src` and compare with `gold`
# (skipped when no golden exists).
lexGoldenCase: function {
    r: Runner
    dumpBin: StringView
    src: StringView
    gold: StringView
    name: StringView
} is {
    if (io.exists path: gold) == false then return
    ltoks: "\{r.tmp.stringview}/D_\{name}.tokens"
    la: (List String)
    la.append from: dumpBin.string
    la.append from: src.string
    (os.spawn
        argv: la
        cwd: ""
        outPath: ltoks.stringview
        errPath: "/dev/null"
        timeoutSecs: r.timeoutSecs
    )
    gL: slurp path: gold
    oL: slurp path: ltoks.stringview
    if oL.stringview == gL.stringview then {
        r.passN = r.passN + 1
    } else {
        print "FAIL(lexer) \{name}"
        r.fails = r.fails + 1
    }
}

# runDifferentialCases -- the DIFFERENTIAL (lexer / parser / program goldens) kind.
runDifferentialCases: function {r: Runner} is {
    # ---------------- DIFFERENTIAL (lexer / parser / program goldens) ----------------
    # Build the dump binaries once with the r.zc under test, then diff their
    # output over every example (and program fixture) against committed goldens.
    lexgold: "\{r.root.stringview}/tests/fixtures/lexer_golden"
    parsegold: "\{r.root.stringview}/tests/fixtures/parser_golden"
    proggold: "\{r.root.stringview}/tests/fixtures/parser_program"
    zlxC: "\{r.tmp.stringview}/D_zlexer.c"
    zlxB: "\{r.tmp.stringview}/D_zlexer.bin"
    zpsC: "\{r.tmp.stringview}/D_zparser.c"
    zpsB: "\{r.tmp.stringview}/D_zparser.bin"
    lexOk: false
    parseOk: false
    zlxE: (zcArgv
        zc: r.zc.stringview
        ccFwd: r.ccFwd.stringview
        name: "zlexer_dump"
        srcdir: r.unitDir.stringview
        sys: r.sys.stringview
        outc: zlxC.stringview
    )
    if (os.spawn
        argv: zlxE
        cwd: ""
        outPath: "/dev/null"
        errPath: "/dev/null"
        timeoutSecs: 0
    ) == 0 then {
        zlxG: (withZlink
            argv: (gccArgv
                cc: r.cc.stringview
                ccflags: r.ccflags.stringview
                bin: zlxB.stringview
                csrc: zlxC.stringview
                asan: false
            )
            csrc: zlxC.stringview
        )
        if (os.spawn
            argv: zlxG
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then lexOk = true
    }
    zpsE: (zcArgv
        zc: r.zc.stringview
        ccFwd: r.ccFwd.stringview
        name: "zparser_dump"
        srcdir: r.unitDir.stringview
        sys: r.sys.stringview
        outc: zpsC.stringview
    )
    if (os.spawn
        argv: zpsE
        cwd: ""
        outPath: "/dev/null"
        errPath: "/dev/null"
        timeoutSecs: 0
    ) == 0 then {
        zpsG: (withZlink
            argv: (gccArgv
                cc: r.cc.stringview
                ccflags: r.ccflags.stringview
                bin: zpsB.stringview
                csrc: zpsC.stringview
                asan: false
            )
            csrc: zpsC.stringview
        )
        if (os.spawn
            argv: zpsG
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then parseOk = true
    }
    if lexOk == false then {
        print "FAIL(diff-build) zlexer"
        r.fails = r.fails + 1
    }
    if parseOk == false then {
        print "FAIL(diff-build) zparser"
        r.fails = r.fails + 1
    }
    dr: io.listDir path: r.examplesDir
    match (
        dr
    ) case ok then {
        ddi: u64
        for ddi < dr.length loop {
            dent: (dr.get i: ddi)
            dsfx: dent.stringview.stripSuffix s: ".z"
            match (
                dsfx
            ) case some then {
                dnm: dsfx
                exPath: "\{r.examplesDir}/\{dnm}.z"
                if lexOk then {
                    lgold: "\{lexgold}/\{dnm}.tokens"
                    (lexGoldenCase
                        :r
                        dumpBin: zlxB.stringview
                        src: exPath.stringview
                        gold: lgold.stringview
                        name: dnm
                    )
                }
                if parseOk then {
                    past: "\{r.tmp}/D_\{dnm}.ast"
                    pa: (List String)
                    pa.append from: zpsB.copy
                    pa.append from: exPath.copy
                    (os.spawn
                        argv: pa
                        cwd: ""
                        outPath: past.stringview
                        errPath: "/dev/null"
                        timeoutSecs: r.timeoutSecs
                    )
                    pgold: "\{parsegold}/\{dnm}.ast"
                    if (io.exists path: pgold) then {
                        gP: slurp path: pgold.stringview
                        oP: slurp path: past.stringview
                        if oP.stringview == gP.stringview then {
                            r.passN = r.passN + 1
                        } else {
                            print "FAIL(parser) \{dnm}"
                            r.fails = r.fails + 1
                        }
                    }
                }
            } case none then null
            ddi = ddi + 1
        }
    } case err then null
    # the lexer's edge-case fixtures, whose goldens sit beside them
    if lexOk then {
        edgeDir: "\{r.root.stringview}/tests/fixtures/zlexer_z"
        edr: io.listDir path: edgeDir
        match (
            edr
        ) case ok then {
            with eit: edr.iterate do for ent: eit loop {
                esfx: ent.stringview.stripSuffix s: ".z"
                match (
                    esfx
                ) case some then {
                    enm: esfx
                    esrc: "\{edgeDir}/\{enm}.z"
                    egold: "\{edgeDir}/\{enm}.tokens"
                    (lexGoldenCase
                        :r
                        dumpBin: zlxB.stringview
                        src: esrc.stringview
                        gold: egold.stringview
                        name: enm
                    )
                } case none then null
            }
        } case err then null
    }
    if parseOk then {
        pr: io.listDir path: proggold
        match (
            pr
        ) case ok then {
            pri: u64
            for pri < pr.length loop {
                pent: (pr.get i: pri)
                ptsfx: pent.stringview.stripSuffix s: ".tree"
                match (
                    ptsfx
                ) case some then {
                    ptnm: ptsfx
                    treeDir: "\{proggold}/\{ptnm}.tree"
                    pout: "\{r.tmp}/P_\{ptnm}.out"
                    ppa: (List String)
                    ppa.append from: zpsB.copy
                    ppa.append from: "--program".string
                    ppa.append from: treeDir.copy
                    ppa.append from: "main".string
                    (os.spawn
                        argv: ppa
                        cwd: ""
                        outPath: pout.stringview
                        errPath: "/dev/null"
                        timeoutSecs: r.timeoutSecs
                    )
                    pgold2: "\{proggold}/\{ptnm}.expected"
                    if (io.exists path: pgold2) then {
                        gPr: slurp path: pgold2.stringview
                        oPr: slurp path: pout.stringview
                        if oPr.stringview == gPr.stringview then {
                            r.passN = r.passN + 1
                        } else {
                            print "FAIL(program) \{ptnm}"
                            r.fails = r.fails + 1
                        }
                    }
                } case none then null
                pri = pri + 1
            }
        } case err then null
    }
}

# runVfsCases -- the VFS (zvfs script dispatch) cases kind.
runVfsCases: function {r: Runner} is {
    # ---------------- VFS (zvfs script dispatch) cases ----------------
    # Build zvfs once; run each zvfs_ops/*.script (substituting {ROOT} with the
    # sibling .tree fixture path, read-only) and diff stdout vs <name>.expected.
    vfsdir: "\{r.root.stringview}/tests/fixtures/zvfs_ops"
    zvfC: "\{r.tmp.stringview}/D_zvfs.c"
    zvfB: "\{r.tmp.stringview}/D_zvfs.bin"
    vfsOk: false
    zvfE: (zcArgv
        zc: r.zc.stringview
        ccFwd: r.ccFwd.stringview
        name: "zvfs_script"
        srcdir: r.unitDir.stringview
        sys: r.sys.stringview
        outc: zvfC.stringview
    )
    if (os.spawn
        argv: zvfE
        cwd: ""
        outPath: "/dev/null"
        errPath: "/dev/null"
        timeoutSecs: 0
    ) == 0 then {
        zvfG: (withZlink
            argv: (gccArgv
                cc: r.cc.stringview
                ccflags: r.ccflags.stringview
                bin: zvfB.stringview
                csrc: zvfC.stringview
                asan: false
            )
            csrc: zvfC.stringview
        )
        if (os.spawn
            argv: zvfG
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then vfsOk = true
    }
    if vfsOk == false then {
        print "FAIL(vfs-build) zvfs"
        r.fails = r.fails + 1
    }
    if vfsOk then {
        vr: io.listDir path: vfsdir
        match (
            vr
        ) case ok then {
            vi: u64
            for vi < vr.length loop {
                vent: (vr.get i: vi)
                vsfx: vent.stringview.stripSuffix s: ".script"
                match (
                    vsfx
                ) case some then {
                    vnm: vsfx
                    scriptPath: "\{vfsdir}/\{vnm}.script"
                    treePath: "\{vfsdir}/\{vnm}.tree"
                    rawScript: slurp path: scriptPath.stringview
                    subst: (rawScript.stringview.replace
                        needle: "{ROOT}"
                        replacement: treePath
                    )
                    tmpScript: "\{r.tmp}/V_\{vnm}.script"
                    io.writeText path: tmpScript content: subst
                    vout: "\{r.tmp}/V_\{vnm}.out"
                    va: (List String)
                    va.append from: zvfB.copy
                    va.append from: tmpScript.copy
                    (os.spawn
                        argv: va
                        cwd: ""
                        outPath: vout.stringview
                        errPath: "/dev/null"
                        timeoutSecs: r.timeoutSecs
                    )
                    vgold: "\{vfsdir}/\{vnm}.expected"
                    if (io.exists path: vgold) then {
                        gV: slurp path: vgold.stringview
                        oV: slurp path: vout.stringview
                        if oV.stringview == gV.stringview then {
                            r.passN = r.passN + 1
                        } else {
                            print "FAIL(vfs) \{vnm}"
                            r.fails = r.fails + 1
                        }
                    }
                } case none then null
                vi = vi + 1
            }
        } case err then null
    }
}

# runSmokeCases -- the SMOKE (per-unit no-arg golden) cases kind.
runSmokeCases: function {r: Runner} is {
    # ---------------- SMOKE (per-unit no-arg golden) cases ----------------
    smokecases: "\{r.root.stringview}/tests/fixtures/smoke_cases.txt"
    scC: slurp path: smokecases.stringview
    scv: scC.stringview
    smokePool: (List PoolJob)
    with scit: scv.lines do for sln: scit loop {
        if sln.length > 0 then {
            nameStr: String
            dirStr: String
            idx: u64
            with sit: (sln.split sep: " ") do for pc: sit loop {
                if pc.length > 0 then {
                    if idx == 0 then {
                        nameStr = pc.string
                    } else if idx == 1 then dirStr = pc.string
                    idx = idx + 1
                }
            }
            if idx >= 2 then {
                srcAbs: "\{r.root.stringview}/\{dirStr.stringview}"
                cpath: "\{r.tmp.stringview}/S_\{nameStr.stringview}.c"
                bpath: "\{r.tmp.stringview}/S_\{nameStr.stringview}.bin"
                opath: "\{r.tmp.stringview}/S_\{nameStr.stringview}.out"
                steps: (List PoolStep)
                za: (zcArgv
                    zc: r.zc.stringview
                    ccFwd: r.ccFwd.stringview
                    name: nameStr.stringview
                    srcdir: srcAbs.stringview
                    sys: r.sys.stringview
                    outc: cpath.stringview
                )
                steps.append (mkStep
                    argv: za
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                    allowFail: false
                    zlinkFrom: ""
                )
                ga: (gccArgv
                    cc: r.cc.stringview
                    ccflags: r.ccflags.stringview
                    bin: bpath.stringview
                    csrc: cpath.stringview
                    asan: false
                )
                steps.append (mkStep
                    argv: ga
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                    allowFail: false
                    zlinkFrom: cpath.stringview
                )
                ba: binArgv bin: bpath.stringview argsFile: ""
                steps.append (mkStep
                    argv: ba
                    cwd: ""
                    outPath: opath.stringview
                    errPath: "/dev/null"
                    timeoutSecs: r.timeoutSecs
                    allowFail: true
                    zlinkFrom: ""
                )
                smokePool.append (mkJob name: nameStr.stringview :steps)
            }
        }
    }
    smokeStatuses: (ListVal i32)
    smokeFailSteps: (ListVal i64)
    runJobs jobs: smokePool maxJobs: r.jobsMax statuses: smokeStatuses failSteps: smokeFailSteps
    sji: u64
    for sji < smokePool.length loop {
        sjob: smokePool.get i: sji
        snm: sjob.name.stringview
        sfail: smokeFailSteps.get i: sji
        if sfail == 0 then {
            print "FAIL(smoke-emit) \{snm}"
            r.fails = r.fails + 1
        } else if sfail == 1 then {
            print "FAIL(smoke-build) \{snm}"
            r.fails = r.fails + 1
        } else {
            opath: "\{r.tmp.stringview}/S_\{snm}.out"
            gold: "\{r.root.stringview}/tests/fixtures/\{snm}_z/smoke.expected"
            if (io.exists path: gold) == false then {
                r.skip = r.skip + 1
            } else {
                goldC: slurp path: gold.stringview
                outC: slurp path: opath.stringview
                sameS: outC.stringview == goldC.stringview
                if sameS when (smokeStatuses.get i: sji) == 0 then {
                    r.passN = r.passN + 1
                } else {
                    print "FAIL(smoke) \{snm}"
                    r.fails = r.fails + 1
                }
            }
        }
        sji = sji + 1
    }
}

# runSelfhostAsan -- the SELFHOST-ASAN (heavy) kind.
runSelfhostAsan: function {r: Runner} is {
    # ---------------- SELFHOST-ASAN (heavy) ----------------
    # Build r.zc itself with ASan, then run it as the compiler over every example
    # and corpus unit in both --emit-c and --dump-sql modes; the COMPILER must
    # be UAF-/leak-free. Heavy (one ASan gcc of r.zc.c + two runs per unit).
    if r.heavy then {
        zcaC: "\{r.tmp.stringview}/zca.c"
        zcaB: "\{r.tmp.stringview}/zca.bin"
        zcaOk: false
        ea: (zcArgv
            zc: r.zc.stringview
            ccFwd: r.ccFwd.stringview
            name: "zc"
            srcdir: r.srcDir.stringview
            sys: r.sys.stringview
            outc: zcaC.stringview
        )
        if (os.spawn
            argv: ea
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then {
            gza: (withZlink
                argv: (gccArgv
                    cc: r.cc.stringview
                    ccflags: r.ccflags.stringview
                    bin: zcaB.stringview
                    csrc: zcaC.stringview
                    asan: true
                )
                csrc: zcaC.stringview
            )
            if (os.spawn
                argv: gza
                cwd: ""
                outPath: "/dev/null"
                errPath: "/dev/null"
                timeoutSecs: 0
            ) == 0 then zcaOk = true
        }
        if zcaOk == false then {
            print "FAIL(selfhost-asan-build) zc"
            r.fails = r.fails + 1
        }
        if zcaOk then {
            os.setEnv key: "ASAN_OPTIONS" value: "detect_leaks=1"
            saDirs: (List String)
            saDirs.append from: r.examplesDir.copy
            saDirs.append from: r.corpusDir.copy
            sdi: u64
            for sdi < saDirs.length loop {
                sad: (saDirs.get i: sdi)
                sar: io.listDir path: sad
                match (
                    sar
                ) case ok then {
                    sai: u64
                    for sai < sar.length loop {
                        sent: (sar.get i: sai)
                        ssfx: sent.stringview.stripSuffix s: ".z"
                        match (
                            ssfx
                        ) case some then {
                            snm: ssfx
                            saerr1: "\{r.tmp}/SA1_\{snm}.err"
                            m1: (List String)
                            m1.append from: zcaB.copy
                            m1.append from: snm.string
                            m1.append from: "--src".string
                            m1.append from: sad.copy
                            m1.append from: "--system".string
                            m1.append from: r.sys.copy
                            m1.append from: "--emit-c".string
                            m1.append from: "/dev/null".string
                            (os.spawn
                                argv: m1
                                cwd: ""
                                outPath: "/dev/null"
                                errPath: saerr1.stringview
                                timeoutSecs: r.timeoutSecs
                            )
                            e1C: slurp path: saerr1.stringview
                            if (isUnsafe s: e1C.stringview) then {
                                print "FAIL(selfhost-asan) \{snm} emit-c unsafe"
                                r.fails = r.fails + 1
                            } else if (isLeak s: e1C.stringview) then {
                                print "FAIL(selfhost-asan) \{snm} emit-c leak"
                                r.fails = r.fails + 1
                            } else {
                                r.leakclean = r.leakclean + 1
                            }
                            saerr2: "\{r.tmp}/SA2_\{snm}.err"
                            m2: (List String)
                            m2.append from: zcaB.copy
                            m2.append from: snm.string
                            m2.append from: "--src".string
                            m2.append from: sad.copy
                            m2.append from: "--system".string
                            m2.append from: r.sys.copy
                            m2.append from: "--dump-sql".string
                            m2.append from: "-".string
                            (os.spawn
                                argv: m2
                                cwd: ""
                                outPath: "/dev/null"
                                errPath: saerr2.stringview
                                timeoutSecs: r.timeoutSecs
                            )
                            e2C: slurp path: saerr2.stringview
                            if (isUnsafe s: e2C.stringview) then {
                                print "FAIL(selfhost-asan) \{snm} dump-sql unsafe"
                                r.fails = r.fails + 1
                            } else if (isLeak s: e2C.stringview) then {
                                print "FAIL(selfhost-asan) \{snm} dump-sql leak"
                                r.fails = r.fails + 1
                            } else {
                                r.leakclean = r.leakclean + 1
                            }
                        } case none then null
                        sai = sai + 1
                    }
                } case err then null
                sdi = sdi + 1
            }
            os.unsetEnv key: "ASAN_OPTIONS"
        }
    }
}

# runFixpoint -- the FIXPOINT (heavy) kind.
runFixpoint: function {r: Runner} is {
    # ---------------- FIXPOINT (heavy) ----------------
    # Self-host byte-identity: r.zc emitted by --r.zc, rebuilt, must re-emit itself
    # identically. Heavy (two r.zc self-emits + one gcc of r.zc.c) -- opt-in.
    if r.heavy then {
        fp1: "\{r.tmp.stringview}/fp1.c"
        fp1bin: "\{r.tmp.stringview}/fp1.bin"
        fp2: "\{r.tmp.stringview}/fp2.c"
        fpOk: false
        e1: (zcArgv
            zc: r.zc.stringview
            ccFwd: r.ccFwd.stringview
            name: "zc"
            srcdir: r.srcDir.stringview
            sys: r.sys.stringview
            outc: fp1.stringview
        )
        if (os.spawn
            argv: e1
            cwd: ""
            outPath: "/dev/null"
            errPath: "/dev/null"
            timeoutSecs: 0
        ) == 0 then {
            g1: (withZlink
                argv: (gccArgv
                    cc: r.cc.stringview
                    ccflags: r.ccflags.stringview
                    bin: fp1bin.stringview
                    csrc: fp1.stringview
                    asan: false
                )
                csrc: fp1.stringview
            )
            if (os.spawn
                argv: g1
                cwd: ""
                outPath: "/dev/null"
                errPath: "/dev/null"
                timeoutSecs: 0
            ) == 0 then {
                e2: (zcArgv
                    zc: fp1bin.stringview
                    ccFwd: r.ccFwd.stringview
                    name: "zc"
                    srcdir: r.srcDir.stringview
                    sys: r.sys.stringview
                    outc: fp2.stringview
                )
                if (os.spawn
                    argv: e2
                    cwd: ""
                    outPath: "/dev/null"
                    errPath: "/dev/null"
                    timeoutSecs: 0
                ) == 0 then {
                    c1: slurp path: fp1.stringview
                    c2: slurp path: fp2.stringview
                    if c1.stringview == c2.stringview then fpOk = true
                }
            }
        }
        if fpOk then {
            r.passN = r.passN + 1
        } else {
            print "FAIL(fixpoint) zc stage1 != stage2"
            r.fails = r.fails + 1
        }
    }
}

main: function is {
    argv: os.args
    n: argv.length
    zc: "out/zc".string
    cc: "gcc".string
    ccflags: String
    ccFwdOn: false
    root: ".".string
    report: false
    heavy: false
    saveTemps: false
    timeoutSecs: 60.i32
    jobsMax: 1.u64
    i: 1.u64
    for i < n loop {
        a: argv.get :i
        av: a.stringview
        if av == "--zc" then {
            i = i + 1
            zc = (argv.get :i).copy
        } else if av == "--cc" then {
            i = i + 1
            cc = (argv.get :i).copy
        } else if av == "--ccflags" then {
            i = i + 1
            ccflags = (argv.get :i).copy
        } else if av == "--cc-forward" then {
            ccFwdOn = true
        } else if av == "--root" then {
            i = i + 1
            root = (argv.get :i).copy
        } else if av == "--report" then {
            report = true
        } else if av == "--heavy" then {
            heavy = true
        } else if av == "--save-temps" then {
            saveTemps = true
        } else if av == "--jobs" then {
            i = i + 1
            jval: (argv.get :i)
            jsv: jval.stringview
            jv: jsv.parseI64
            match (
                jv
            ) case ok then {
                if jv > 0 then jobsMax = jv.u64.orPanic
            } case err then null
        } else if av == "--timeout" then {
            i = i + 1
            tval: (argv.get :i)
            tsv: tval.stringview
            tv: tsv.parseI64
            match (
                tv
            ) case ok then {
                timeoutSecs = tv.i32.orPanic
            } case err then null
        }
        i = i + 1
    }

    # resolved after the loop, not inside the --cc-forward arm: the flags may
    # arrive in either order, and reading `cc` early would make `--cc-forward
    # --cc X` forward the default instead of X.
    ccFwd: String
    if ccFwdOn then ccFwd = cc.copy

    sys: "\{root.stringview}/lib/system"
    errors: "\{root.stringview}/tests/fixtures/errors"
    rungold: "\{root.stringview}/tests/fixtures/run_golden"
    runcases: "\{root.stringview}/tests/fixtures/run_cases.txt"
    examplesDir: "\{root.stringview}/examples"
    corpusDir: "\{root.stringview}/tests/fixtures/emitc_corpus"
    dumpcases: "\{root.stringview}/tests/fixtures/dump_cases.txt"
    dumpgold: "\{root.stringview}/tests/fixtures/dump_golden"
    mypid: os.pid
    d: "/tmp/ztr_\{mypid}"
    io.mkdirp path: d
    # sweep trees crashed prior runs left behind: the names are
    # pid-scoped, and a live owner still has /proc/<pid>
    myPidS: "\{mypid}"
    stale: io.listDir path: "/tmp"
    match (
        stale
    ) case ok then {
        with sit: stale.iterate do for se: sit loop {
            sv: se.stringview
            if sv.startsWith "ztr_" then {
                spid: sv.substring from: 4 to: sv.length
                if spid != myPidS.stringview then {
                    proc: "/proc/\{spid}"
                    if (io.exists path: proc) == false then {
                        dead: "/tmp/ztr_\{spid}"
                        io.removeTree path: dead.stringview
                    }
                }
            }
        }
    } case err then null

    r0: root.copy
    r: (Runner
        root: root.take
        zc: zc.take
        cc: cc.take
        ccflags: ccflags.take
        ccFwd: ccFwd.take
        sys: sys.take
        tmp: d.take
        :jobsMax
        :timeoutSecs
        :heavy
        :report
        :saveTemps
        errors: errors.take
        rungold: rungold.take
        runcases: runcases.take
        examplesDir: examplesDir.take
        corpusDir: corpusDir.take
        dumpcases: dumpcases.take
        dumpgold: dumpgold.take
        srcDir: "\{r0}/src"
        unitDir: "\{r0}/tests/unit"
        passN: 0
        leakclean: 0
        xleak: 0
        xfail: 0
        skip: 0
        fails: 0
    )
    runRunCases :r
    runLspCases :r
    runLeakCases :r
    runErrorCases :r
    runDumpCases :r
    runDifferentialCases :r
    runVfsCases :r
    runSmokeCases :r
    runSelfhostAsan :r
    runFixpoint :r
    runArchCases :r

    # ---------------- summary ----------------
    if r.saveTemps then {
        print "kept test artifacts at \{r.tmp.stringview}"
    } else {
        io.removeTree path: r.tmp.stringview
    }
    print "----"
    print "pass=\{r.passN} leak-clean=\{r.leakclean} xfail=\{r.xfail} xleak=\{r.xleak} skip=\{r.skip} fails=\{r.fails}"
    if r.report then {
        os.exit code: 0
    }
    if r.fails == 0 then {
        print "CORPUS GATE GREEN"
        os.exit code: 0
    } else {
        print "CORPUS GATE FAILED (\{r.fails})"
        os.exit code: 1
    }
}
