# znativecheck -- `zc natives check WHAT`: what must hold of the rows zc carries
# (nativec.units, the foundation) beyond what their schema checks, checked
# against the standard library's declarations. `rows`: every native function
# of a unit with rows has a row; every hole a text spells names a declared type,
# arm or member, or one the emitter binds; no text spells a tag constant or a
# generated struct's member literally; a value row's body calls nothing; every
# native operator has a row, and every operator row implements one; every
# numeric conversion is declared, answering a resultval exactly when it can
# fail, and has the row the numeric rule gives (convRule).

public: unit {
    :checkNatives
    :nativeConvRows
}

schema: nativec.runtime.nativec

# checkWord -- the words `zc natives check` and its checks act on
checkWord: list {
    # the check of the rows against the declarations
    cRows: "rows"
    # the check of the pieces' needs (znativepieces)
    cNeeds: "needs"
    # the check of the native receivers' `.view` markers (znativeview)
    cViews: "views"
    # the units whose names every unit sees
    uSystem: "system"
    uCore: "core"
    # the operators spelt as words
    opAnd: "and"
    opOr: "or"
    opNot: "not"
    # the type a fallible conversion answers
    tResultval: "resultval"
} out staticlist StringView

# kindpair -- a conversion: the numeric kinds it converts from and to, each by
# its tag
kindpair: record {
    src: u8
    dst: u8
}

# NativeText -- one text a row, a template or a fixed file holds, and where:
# `row io.eprintln`, `template List`, `file head`
NativeText: class {
    where: String
    text: String
}

# NameSets -- a set of names per key: a unit's top-level names, a type's arms
NameSets: class {
    # the key's place in `sets`
    index: (MapRV String v: u64)
    sets: List (Set String)
} as {
    # add -- `name` into the set of `key`
    add: function {:this key: StringView name: StringView} is {
        k: (this.index.get key: key.string).or d: this.sets.length
        if k == this.sets.length then {
            this.index.set key: key.string value: k
            this.sets.append (Set String)
        }
        (this.sets.getMut i: k).add item: name.string
    }

    # has -- whether the set of `key` holds `name`
    has: function {this: this.view key: StringView name: StringView} out bool is {
        k: (this.index.get key: key.string).or d: this.sets.length
        if k == this.sets.length then return false
        return ((this.sets.get i: k).has item: name.string)
    }
}

# newNameSets -- name sets holding no name
newNameSets: function out NameSets is {
    return (NameSets index: (MapRV String v: u64) sets: List (Set String))
}

# Decls -- the standard library's declarations, as the checks read them: each
# file's top-level definitions, parsed
Decls: class {
    # every top-level name of every file
    names: Set String
    # the top-level names system and core declare
    systemNames: Set String
    # the top-level names of each unit, its subunit files' among them
    unitNames: NameSets
    # the native free functions of each unit
    natives: NameSets
    # the arms of each variant and union, by its name
    arms: NameSets
    # the members of each record, class, variant, union, protocol and facet
    members: NameSets
    # the functions each type declares, in either of its blocks
    methods: NameSets
    # the native operators of each type, and the unit declaring each such type
    operators: NameSets
    typeUnit: (Map String V: String)
    # the native conversions each numeric type declares, and those of them that
    # answer a resultval
    conversions: NameSets
    lossy: NameSets
    words: zast.Vocab
}

# checkNatives -- run check `what` over the rows zc carries: `native` against
# the declarations under `systemdir`, `piece` against the emitter's source at
# `emitter` too. Prints each finding once, then a summary. Answers the exit
# code: 0 when nothing was found, 1 when something was, 2 for an unknown check.
checkNatives: function {
    what: StringView
    systemdir: StringView
    emitter: StringView
    register: StringView
    # `rows` of one user unit: its folder holding its nativec.zd; "" for the
    # rows zc carries
    unitdir: StringView
} out i32 is {
    words: zast.Vocab.create block: checkWord
    w: words.slotOf text: what
    fails: List String
    n: String
    guard: "native-guard"
    if w == checkWord.slot.cRows then {
        d: readDecls :systemdir :words
        if unitdir.length > 0 then {
            guard = "check rows"
            n = checkUnitRows :d :unitdir :systemdir :fails
        } else {
            texts: allTexts
            n = checkNative :d :texts :fails
        }
    } else if w == checkWord.slot.cNeeds then {
        guard = "piece-guard"
        n = znativepieces.checkPieces :emitter :fails
    } else if w == checkWord.slot.cViews then {
        guard = "view-guard"
        files: List String
        for each sf: (znativedecls.sourceFiles :systemdir) loop files.append from: sf.path.copy
        n = znativeview.checkView :files :emitter :register :systemdir :fails
    } else {
        io.eprintln "zc natives check: unknown check '\{what}' (rows, needs, views)"
        return 2
    }
    said: Set String
    for each f: fails loop {
        if (said.has item: f) then continue
        said.add item: f.copy
        print "\{guard} FAIL: \{f}"
    }
    print "\{guard}: \{n}"
    if fails.length > 0 then return 1
    return 0
}

# checkUnitRows -- the `rows` check of one user unit, its folder `unitdir`
# holding its nativec.zd beside the unit's own file: every native function of
# the unit has a row, every row's key names a declaration of the unit (a typo'd
# key implements nothing), and every hole its texts spell names a known type,
# arm or member. Answers what was checked, for the summary.
checkUnitRows: function {
    d: Decls
    unitdir: StringView
    systemdir: StringView
    fails: List String
} out String is {
    dirTo: unitdir.length
    if (unitdir.endsWith suffix: "/") then dirTo = dirTo - 1
    dir: (unitdir.substring from: 0 to: dirTo).string
    unitName: dir.copy
    srcdir: ".".string
    cut: dir.stringView.lastIndexOf needle: "/"
    match (
        cut
    ) case some then {
        unitName = (dir.stringView.substring from: cut + 1 to: dir.length).string
        srcdir = (dir.stringView.substring from: 0 to: cut).string
    } case none then null
    file: "\{dir}/nativec.zd"
    if (io.exists path: file).not then {
        fails.append "\{dir} holds no nativec.zd"
        return String
    }
    for each sf: (znativedecls.unitFiles srcdir: srcdir.stringView name: unitName.stringView) loop {
        pf: znativedecls.parseFile path: sf.path.stringView
        for each k: pf.defs loop (
            readDef
            :d
            unitName: unitName.stringView
            sys: false
            tree: pf.tree
            id: k
        )
    }
    srcs: List String
    srcs.append from: srcdir.copy
    df: zdata.open file: file.stringView srcdirs: srcs :systemdir
    if df.ok.not then {
        fails.append "\{file} does not check:\n\{zdata.errorsText f: df}"
        return String
    }
    keys: List String
    texts: List NativeText
    bound: boundHoles
    unitRowTexts :df unitName: unitName.stringView :keys :texts :bound
    unitNativeRows :d unitName: unitName.stringView :keys :fails
    rowKeysDeclared :d unitName: unitName.stringView :keys :fails
    nh: holesKnown :d :bound :texts :fails
    na: prefixedHoles :d :bound :texts :fails arms: true
    nm: prefixedHoles :d :bound :texts :fails arms: false
    literalSpellings :texts :fails
    r: "unit \{unitName}: its native functions have rows, its \{keys.length} rows' keys name its "
    r.append "declarations, \{nh} holes name known types, \{na} tag-constant holes name "
    r.append "declared arms, \{nm} member holes name declared members"
    return r
}

# unitRowTexts -- a user unit's checked nativec.zd `df` read for the check: its
# rows' keys onto `keys`, every text its rows, classes and templates hold onto
# `texts`, and its canons' stems onto the holes the emitter binds (`bound`)
unitRowTexts: function {
    df: zdata.DataFile.view
    unitName: StringView
    keys: List String
    texts: List NativeText
    bound: Set String
} is {
    im: zdata.definition f: df name: "implementation"
    for each c: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: im name: "canons")) loop {
        bound.add item: (zdata.textOf f: df v: (zdata.fieldOf f: df v: c name: "stem"))
    }
    for each r: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: im name: "rows")) loop {
        key: zdata.textOf f: df v: (zdata.fieldOf f: df v: r name: "key")
        wh: rowWhere owner: unitName key: key.stringView
        bd: zdata.textOf f: df v: (zdata.fieldOf f: df v: r name: "body")
        if bd.length > 0 then texts.append (NativeText where: wh.copy text: bd.take)
        for each t: (zdata.textsOf f: df v: (zdata.fieldOf f: df v: r name: "fragments")) loop {
            texts.append (NativeText where: wh.copy text: t.copy)
        }
        for each p: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: r name: "pieces")) loop {
            texts.append (
                NativeText
                where: wh.copy
                text: (zdata.textOf f: df v: (zdata.fieldOf f: df v: p name: "text"))
            )
        }
        keys.append from: key.take
    }
    for each c: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: im name: "classes")) loop {
        ds: zdata.textOf f: df v: (zdata.fieldOf f: df v: c name: "destroy")
        if ds.length > 0 then texts.append (NativeText where: "class \{unitName}" text: ds.take)
    }
    for each t: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: im name: "templates")) loop {
        for each s: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: t name: "sections")) loop {
            texts.append (
                NativeText
                where: "template of \{unitName}"
                text: (zdata.textOf f: df v: (zdata.fieldOf f: df v: s name: "text"))
            )
        }
    }
}

# unitNativeRows -- every native free function of unit `unitName` has a row of its
# key among `keys`
unitNativeRows: function {
    d: Decls.view unitName: StringView keys: (List String).view fails: List String
} is {
    k: (d.natives.index.get key: unitName.string).or d: d.natives.sets.length
    if k == d.natives.sets.length then return
    have: Set String
    for each w: keys loop have.add item: w.copy
    fns: List String
    for each f: (d.natives.sets.get i: k) loop fns.append from: f.copy
    fns.sort
    for each f: fns loop {
        if (have.has item: f).not then (
            fails.append
            "native function \{f} of unit \{unitName} has no row keyed \"\{f}\" in its nativec.zd (add the row)"
        )
    }
}

# rowKeysDeclared -- every row key of unit `unitName` names a declaration of it:
# `name` a native function or a type of the unit, `Type.member` a member of
# one of its types; a helper's `@name` names none and is not asked
rowKeysDeclared: function {
    d: Decls.view unitName: StringView keys: (List String).view fails: List String
} is {
    for each k: keys loop {
        if k.stringView.startsWith "@" then continue
        wh: rowWhere owner: unitName key: k.stringView
        dot: k.stringView.indexOf needle: "."
        match (
            dot
        ) case some then {
            tn: k.stringView.substring from: 0 to: dot
            mn: k.stringView.substring from: dot + 1 to: k.length
            if (d.unitNames.has key: unitName name: tn).not then {
                fails.append "\{wh} names \{tn}, which unit \{unitName} does not declare (correct the key)"
            } else if (d.methods.has key: tn name: mn).not when (d.members.has key: tn name: mn
            ).not then {
                fails.append "\{wh} names member \{mn}, which \{tn} does not declare (correct the key)"
            }
        } case none then {
            if (d.natives.has key: unitName name: k.stringView).not when (
                d.unitNames.has
                key: unitName
                name: k.stringView
            ).not then {
                fails.append "\{wh} names no declaration of unit \{unitName} (correct the key)"
            }
        }
    }
}

# checkNative -- the `native` check's findings into `fails`; answers what was
# checked, for the summary
checkNative: function {
    d: Decls.view texts: (List NativeText).view fails: List String
} out String is {
    nativeRows :d :fails
    no: operatorRows :d :fails
    nc: conversionRows :d :fails
    bound: boundHoles
    nh: holesKnown :d :bound :texts :fails
    holesDeclaredOnce :d :bound :texts :fails
    na: prefixedHoles :d :bound :texts :fails arms: true
    nm: prefixedHoles :d :bound :texts :fails arms: false
    literalSpellings :texts :fails
    nv: valueRows :fails
    r: "native declarations have rows, \{nh} holes name known types, "
    r.append "\{na} tag-constant holes name declared arms, \{nm} member holes name "
    r.append "declared members, \{nv} value rows call nothing, \{no} native operators have "
    r.append "rows, \{nc} conversions are declared and written as the numeric rule gives them"
    return r
}

# readDecls -- the top-level definitions of every `.z` file under `systemdir`
# and its unit folders
readDecls: function {systemdir: StringView words: zast.Vocab.view} out Decls is {
    d: (
        Decls
        names: Set String
        systemNames: Set String
        unitNames: newNameSets
        natives: newNameSets
        arms: newNameSets
        members: newNameSets
        methods: newNameSets
        operators: newNameSets
        typeUnit: (Map String V: String)
        conversions: newNameSets
        lossy: newNameSets
        words: (zast.Vocab.create block: checkWord)
    )
    for each sf: (znativedecls.sourceFiles :systemdir) loop {
        sw: words.slotOf text: sf.owner.stringView
        sys: (sw == checkWord.slot.uSystem) or (sw == checkWord.slot.uCore)
        pf: znativedecls.parseFile path: sf.path.stringView
        for each k: pf.defs loop (
            readDef
            :d
            unitName: sf.owner.stringView
            :sys
            tree: pf.tree
            id: k
        )
    }
    return d
}

# readDef -- one top-level definition `id` of unit `unitName` into `d`
readDef: function {d: Decls unitName: StringView sys: bool tree: zast.Ast.view id: zast.nodeid} is {
    nd: tree.nodes.get i: id
    match (
        nd
    ) case namedoperation then {
        nm: zast.poolTextCopy pool: tree.names ref: nd.name
        d.names.add item: nm.copy
        d.unitNames.add key: unitName name: nm.stringView
        if sys then d.systemNames.add item: nm.copy
        op: tree.nodes.get i: nd.operation
        match (
            op
        ) case functiondef then {
            if op.isNative then d.natives.add key: unitName name: nm.stringView
        } case objectdef then {
            readMembers :d type: nm.stringView :tree items: op.isItems kind: op.kind
            readNativeMethods :d :unitName type: nm.stringView :tree items: op.isItems
            readNativeMethods :d :unitName type: nm.stringView :tree items: op.asItems
            readMethods :d type: nm.stringView :tree items: op.isItems
            readMethods :d type: nm.stringView :tree items: op.asItems
        } else null
    } else null
}

# readMembers -- a type's `is` items: its arms when it is a variant or a union,
# and, for every kind whose generated struct a hole may name, its members
readMembers: function {
    d: Decls type: StringView tree: zast.Ast.view items: zast.kidspan kind: zast.objectkind
} is {
    sum: kind.variantDef or kind.unionDef
    named: sum or kind.recordDef or kind.classDef or kind.protocolDef or kind.facetDef
    if named.not then return
    for each k: (zast.kidIds ast: tree span: items) loop {
        it: tree.nodes.get i: k
        match (
            it
        ) case namedoperation then {
            mn: zast.poolTextCopy pool: tree.names ref: it.name
            if sum then d.arms.add key: type name: mn.stringView
            d.members.add key: type name: mn.stringView
        } else null
    }
}

# readMethods -- the functions among a type's `items`, by name
readMethods: function {d: Decls type: StringView tree: zast.Ast.view items: zast.kidspan} is {
    for each k: (zast.kidIds ast: tree span: items) loop {
        it: tree.nodes.get i: k
        match (
            it
        ) case namedoperation then {
            if (tree.nodes.get i: it.operation).functiondef then {
                (
                    d.methods.add
                    key: type
                    name: (zast.poolTextCopy pool: tree.names ref: it.name).stringView
                )
            }
        } else null
    }
}

# readNativeMethods -- the native methods among a type's `items`: its
# operators, and, on a numeric type, its conversions
readNativeMethods: function {
    d: Decls unitName: StringView type: StringView tree: zast.Ast.view items: zast.kidspan
} is {
    for each k: (zast.kidIds ast: tree span: items) loop {
        it: tree.nodes.get i: k
        match (
            it
        ) case namedoperation then {
            fd: tree.nodes.get i: it.operation
            match (
                fd
            ) case functiondef then {
                if fd.isNative then readNativeMethod :d :unitName :type :tree name: it.name fn: fd
            } else null
        } else null
    }
}

# readNativeMethod -- native method `name` of type `type`, when it is an
# operator or a conversion
readNativeMethod: function {
    d: Decls
    unitName: StringView
    type: StringView
    tree: zast.Ast.view
    name: zast.nameid
    fn: zast.functionrow
} is {
    nm: zast.poolTextAt pool: tree.names ref: name
    if (isOperator words: d.words text: nm.stringView) then {
        d.operators.add key: type name: nm.stringView
        d.typeUnit.set key: type.string value: unitName.string
    }
    if (isConversion :tree :type name: nm.stringView params: fn.parameters).not then return
    d.conversions.add key: type name: nm.stringView
    if (answersResult :tree words: d.words id: fn.returntype) then (
        d.lossy.add
        key: type
        name: nm.stringView
    )
}

# isOperator -- `text` names an operator: `and`, `or`, `not`, or a run of
# operator symbols
isOperator: function {words: zast.Vocab.view text: StringView} out bool is {
    w: words.slotOf :text
    if (
        (w == checkWord.slot.opAnd) or (w == checkWord.slot.opOr) or (w == checkWord.slot.opNot)
    ) then return true
    if text.length == 0 then return false
    for each b: text.byteView loop {
        if (isOperatorByte :b).not then return false
    }
    return true
}

# isOperatorByte -- a byte a symbolic operator's name is made of (`- + * / % &
# < > = ! | ^`); the operators spelt as words are checkWord's
isOperatorByte: function {b: u8} out bool is {
    if (b == 45) or (b == 43) or (b == 42) or (b == 47) or (b == 37) or (b == 38) then return true
    return (b == 60) or (b == 62) or (b == 61) or (b == 33) or (b == 124) or (b == 94)
}

# isConversion -- method `name` of type `type` is a conversion: both name
# numeric kinds, and it takes the receiver alone
isConversion: function {
    tree: zast.Ast.view type: StringView name: StringView params: zast.kidspan
} out bool is {
    if (ztypes.numkindByName name: type).has.not then return false
    if (ztypes.numkindByName :name).has.not then return false
    if (zast.kidIds ast: tree span: params).length != 1 then return false
    return (znativedecls.receiverOf :tree :params).absent.not
}

# answersResult -- return type `id` is a resultval
answersResult: function {tree: zast.Ast.view words: zast.Vocab.view id: zast.nodeid} out bool is {
    rt: tree.nodes.get i: id
    match (
        rt
    ) case call then {
        c: tree.nodes.get i: rt.callable
        match (
            c
        ) case atomid then {
            t: zast.poolTextAt pool: tree.names ref: c.name
            return (words.slotOf text: t.stringView) == checkWord.slot.tResultval
        } else null
    } else null
    return false
}

# operatorRows -- every native operator has a row of its key in its unit's
# file, and every operator row implements a native operator of its unit;
# answers how many native operators there are
operatorRows: function {d: Decls.view fails: List String} out u64 is {
    rowOps: newNameSets
    for each u: nativec.units loop {
        for each w: u.implementation.rows loop (
            operatorRow
            :d
            owner: u.name.stringView
            key: w.key.stringView
            :rowOps
            :fails
        )
    }
    n: u64
    for each t: d.operators.index loop {
        k: (d.operators.index.get key: t.copy).or d: 0
        ops: List String
        for each o: (d.operators.sets.get i: k) loop ops.append from: o.copy
        ops.sort
        n = n + ops.length
        for each o: ops loop {
            if (rowOps.has key: t.stringView name: o.stringView).not then fails.append (
                operatorWithoutRow
                :d
                type: t.stringView
                op: o.stringView
            )
        }
    }
    return n
}

# operatorRow -- row `key` of unit `owner`, when it is an operator's: into
# `rowOps` when it implements a native operator of its unit, else a finding
operatorRow: function {
    d: Decls.view owner: StringView key: StringView rowOps: NameSets fails: List String
} is {
    dot: (key.indexOf needle: ".").or d: key.length
    if dot == key.length then return
    if (isOperator words: d.words text: (key.substring from: dot + 1 to: key.length)
    ).not then return
    if (addOperatorRow :d :owner :key :dot :rowOps) then return
    fails.append "\{(
        rowWhere
        :owner
        :key
    )} implements no native operator of unit \{owner} (declare it native, or drop the row)"
}

# addOperatorRow -- operator row `key` (its type before `dot`) into `rowOps`
# when it implements a native operator of its unit `owner`
addOperatorRow: function {
    d: Decls.view owner: StringView key: StringView dot: u64 rowOps: NameSets
} out bool is {
    t: key.substring from: 0 to: dot
    m: key.substring from: dot + 1 to: key.length
    if (d.operators.has key: t name: m).not then return false
    if (unitOf :d type: t) != owner then return false
    rowOps.add key: t name: m
    return true
}

# operatorWithoutRow -- the finding for native operator `op` of `type`, which
# has no row
operatorWithoutRow: function {d: Decls.view type: StringView op: StringView} out String is {
    u: unitOf :d :type
    return "native operator \{(
        dotted
        a: type
        b: op
    )} of unit \{u} has no row in its nativec.zd (add the row)"
}

# unitOf -- the unit declaring type `type`
unitOf: function {d: Decls.view type: StringView} out String is {
    u: d.typeUnit.get key: type.string
    match (
        u
    ) case some then {
        return u.copy
    } case none then return String
}

# dotted -- a member as a finding names it, `<type>.<name>`: the check keys
# members by their two parts and joins them only for the message
dotted: function {a: StringView b: StringView} out String is {
    r: a.string
    r.append "."
    r.append b
    return r
}

# conversionRows -- each conversion's row in system's file is the one the
# numeric rule gives (convRule: its body, needs and form), and each
# numeric type declares each conversion, answering a resultval exactly when the
# rule calls it lossy; answers how many conversions there are
conversionRows: function {d: Decls.view fails: List String} out u64 is {
    rows: rulesMet :d :fails
    kinds: convKinds
    n: u64
    for each s: kinds loop {
        for each t: kinds loop {
            n = n + 1
            sn: ztypes.numkindName k: s
            tn: ztypes.numkindName k: t
            nm: dotted a: sn.stringView b: tn.stringView
            if (rows.has item: (kindpair src: s.tag dst: t.tag)
            ).not then fails.append "conversion \{nm} has no row in system's nativec.zd (write the one `zc natives` prints)"
            lossy: (convRule srcK: s dstK: t).lossy
            if (d.conversions.has key: sn.stringView name: tn.stringView).not then {
                fails.append "conversion \{nm} is not declared native on \{sn} (declare it)"
            } else if (d.lossy.has key: sn.stringView name: tn.stringView) != lossy then {
                fails.append "conversion \{nm} must answer a resultval exactly when it can fail, and the rule says it \{(
                    failText
                    :lossy
                )}"
            }
        }
    }
    return n
}

# rulesMet -- the conversions whose plain row in system's file the check met,
# each compared with the rule's
rulesMet: function {d: Decls.view fails: List String} out SetVal kindpair is {
    r: SetVal kindpair
    for each u: nativec.units loop {
        if (d.words.slotOf text: u.name.stringView) != checkWord.slot.uSystem then continue
        for each w: u.implementation.rows loop {
            if (w.fact.length > 0) or (w.constant.length > 0) then continue
            k: conversionKey key: w.key.stringView
            if k.has.not then continue
            r.add item: (kindpair src: k.src.tag dst: k.dst.tag)
            rule: convRule srcK: k.src dstK: k.dst
            same: (w.body.stringView == rule.body) and (w.form.value == rule.value)
            if (
                same.not or (sameTexts a: w.needs b: rule.needs).not
            ) then fails.append "row system.\{w.key} is not the numeric rule's (its body, needs or form differ): write the row `zc natives` prints for it"
        }
    }
    return r
}

# convkey -- a row key read as a conversion's: `<kind>.<kind>`
convkey: record {
    # the key names two numeric kinds
    has: bool
    src: ztypes.numkind
    dst: ztypes.numkind
}

# conversionKey -- row key `key` as a conversion's
conversionKey: function {key: StringView} out convkey is {
    dot: (key.indexOf needle: ".").or d: key.length
    if dot == key.length then return (
        convkey
        has: false
        src: ztypes.numkind.i64Type
        dst: ztypes.numkind.i64Type
    )
    s: ztypes.numkindByName name: (key.substring from: 0 to: dot)
    t: ztypes.numkindByName name: (key.substring from: dot + 1 to: key.length)
    return (convkey has: s.has and t.has src: s.kind dst: t.kind)
}

# sameTexts -- a row's list `a` holds the texts of `b`, in order
sameTexts: function {a: staticlist text b: (List String).view} out bool is {
    if a.length != b.length then return false
    i: u64
    for each x: a loop {
        if x.stringView != (b.get :i) then return false
        i = i + 1
    }
    return true
}

# failText -- the rule's verdict on a conversion, as a finding says it
failText: function {lossy: bool} out String is {
    if lossy then return "can".string
    return "cannot".string
}

# allTexts -- every text the rows zc carries hold: each row's body, fragments
# and pieces, each class's destroy, each template's sections, each fixed file's
# pieces
allTexts: function out List NativeText is {
    r: List NativeText
    for each u: nativec.units loop unitTexts :r :u
    fd: nativec.systemc.foundation
    for each g: fd.groups loop {
        for each w: g.rows loop rowTexts :r owner: g.name.stringView :w
    }
    for each w: fd.structural loop rowTexts :r owner: "" :w
    for each fl: fd.files loop {
        for each p: fl.pieces loop r.append (NativeText where: "file \{fl.name}" text: p.text.string
        )
    }
    return r
}

# unitTexts -- one unit's texts onto `r`: its rows', its classes' and its
# templates'
unitTexts: function {r: List NativeText u: nativec.servedUnit} is {
    for each w: u.implementation.rows loop rowTexts :r owner: u.name.stringView :w
    for each c: u.implementation.classes loop classTexts :r owner: u.name.stringView :c
    for each t: u.implementation.templates loop {
        for each s: t.sections loop r.append (
            NativeText
            where: "template \{t.name}"
            text: s.text.string
        )
    }
}

# rowTexts -- one row's texts onto `r`
rowTexts: function {r: List NativeText owner: StringView w: schema.row} is {
    wh: rowWhere :owner key: w.key.stringView
    if w.body.length > 0 then r.append (NativeText where: wh.copy text: w.body.string)
    for each t: w.fragments loop r.append (NativeText where: wh.copy text: t.string)
    for each p: w.pieces loop r.append (NativeText where: wh.copy text: p.text.string)
}

# classTexts -- one class's destroy onto `r`
classTexts: function {r: List NativeText owner: StringView c: schema.classRow} is {
    if c.destroy.length == 0 then return
    wh: "class ".string
    wh.append owner
    wh.append "."
    wh.append c.key.stringView
    r.append (NativeText where: wh.take text: c.destroy.string)
}

# rowWhere -- `row <unit>.<key>`, the key alone for a structural row
rowWhere: function {owner: StringView key: StringView} out String is {
    r: "row ".string
    if owner.length > 0 then {
        r.append owner
        r.append "."
    }
    r.append key
    return r
}

# nativeRows -- every native free function of a unit with rows has a row of its
# key in that unit's file
nativeRows: function {d: Decls.view fails: List String} is {
    for each u: nativec.units loop {
        k: (d.natives.index.get key: u.name.string).or d: d.natives.sets.length
        if k == d.natives.sets.length then continue
        keys: Set String
        for each w: u.implementation.rows loop keys.add item: w.key.string
        fns: List String
        for each f: (d.natives.sets.get i: k) loop fns.append from: f.copy
        fns.sort
        for each f: fns loop {
            if (keys.has item: f).not then (
                fails.append
                "native function \{f} of unit \{u.name} has no row keyed \"\{f}\" in its nativec.zd (add the row)"
            )
        }
    }
}

# boundHoles -- the plain hole names the emitter binds itself (rtHole), each
# unit's canonical stems, and String and StringView
boundHoles: function out Set String is {
    r: Set String
    for each h: zemitterc.rtHole loop r.add item: h.string
    for each u: nativec.units loop {
        for each c: u.implementation.canons loop r.add item: c.stem.string
    }
    r.add item: "String".string
    r.add item: "StringView".string
    return r
}

# holesKnown -- every `z_@Name@` hole names a canon the emitter binds or a
# declared type; answers how many distinct holes the texts spell
holesKnown: function {
    d: Decls.view bound: (Set String).view texts: (List NativeText).view fails: List String
} out u64 is {
    seen: Set String
    for each t: texts loop {
        for each h: (plainHoles text: t.text.stringView) loop {
            seen.add item: h.copy
            if (bound.has item: h).not when (d.names.has item: h).not then (
                fails.append
                "\{t.where} spells hole @\{h}@, which names no known type (declare it, add a canon for it, or bind it in the emitter)"
            )
        }
    }
    return seen.length
}

# holesDeclaredOnce -- a plain hole the emitter does not bind, and system does not
# declare, is declared by one unit at most: the emitter looks it up in unit
# order, and two declarers would leave that order to decide
holesDeclaredOnce: function {
    d: Decls.view bound: (Set String).view texts: (List NativeText).view fails: List String
} is {
    seen: Set String
    for each t: texts loop {
        for each h: (plainHoles text: t.text.stringView) loop {
            if (
                (seen.has item: h) or (bound.has item: h) or (d.systemNames.has item: h)
            ) then continue
            seen.add item: h.copy
            decl: declarers :d name: h.stringView
            if decl.length > 1 then (
                fails.append
                "hole @\{h}@ is declared by more than one unit (\{(
                    joined
                    xs: decl
                )}); give it a canon naming the one it means"
            )
        }
    }
}

# declarers -- the units with rows whose files declare `name` at top level
declarers: function {d: Decls.view name: StringView} out List String is {
    r: List String
    for each u: nativec.units loop {
        if (d.unitNames.has key: u.name.stringView :name) then r.append from: u.name.string
    }
    return r
}

# prefixedHoles -- each `@ARM_<canon>.<arm>@` hole (`arms`), or each
# `@MEMBER_<canon>.<name>@`, names a known type, and that type (the canon up to
# its first `_`) declares the arm or the member; answers how many there are
prefixedHoles: function {
    d: Decls.view
    bound: (Set String).view
    texts: (List NativeText).view
    fails: List String
    arms: bool
} out u64 is {
    pre: "@MEMBER_"
    if arms then pre = "@ARM_"
    n: u64
    for each t: texts loop {
        tv: t.text.stringView
        at: u64
        for at < tv.length loop {
            h: nextPrefixed text: tv from: at :pre
            if h.found.not then break
            at = h.next
            if h.whole then {
                n = n + 1
                f: prefixedFinding :d :bound :h text: tv :arms
                if f.length > 0 then fails.append "\{t.where} spells \{f}"
            }
        }
    }
    return n
}

# prefixedhole -- an `@ARM_<canon>.<name>@` or `@MEMBER_<canon>.<name>@` hole
# as nextPrefixed finds it: offsets into its text
prefixedhole: record {
    # a prefix was found
    found: bool
    # it opens a whole hole: a canon, a dot, a name, a closing `@`
    whole: bool
    # where the search goes on
    next: u64
    # the hole's opening `@`
    at: u64
    canonFrom: u64
    canonTo: u64
    nameTo: u64
}

# nextPrefixed -- the next hole opening with `pre` in `text` from `from` on
nextPrefixed: function {text: StringView from: u64 pre: StringView} out prefixedhole is {
    r: (
        prefixedhole
        found: false
        whole: false
        next: text.length
        at: 0
        canonFrom: 0
        canonTo: 0
        nameTo: 0
    )
    o: (text.substring :from to: text.length).indexOf needle: pre
    if o.none then return r
    r.found = true
    r.at = from + o
    r.canonFrom = r.at + pre.length
    r.next = r.canonFrom
    r.canonTo = identEnd :text from: r.canonFrom
    if (r.canonTo == r.canonFrom) or (((text.byteAt i: r.canonTo).or d: 0) != 46) then return r
    r.nameTo = identEnd :text from: r.canonTo + 1
    if (r.nameTo == (r.canonTo + 1)) or (((text.byteAt i: r.nameTo).or d: 0) != 64) then return r
    r.whole = true
    r.next = r.nameTo + 1
    return r
}

# prefixedFinding -- what is wrong with hole `h` of `text`: its type names no
# known type, or that type (the canon up to its first `_`) declares no such arm
# (`arms`) or member; "" when nothing is
prefixedFinding: function {
    d: Decls.view bound: (Set String).view h: prefixedhole text: StringView arms: bool
} out String is {
    hole: text.substring from: h.at to: h.nameTo + 1
    canon: text.substring from: h.canonFrom to: h.canonTo
    name: text.substring from: h.canonTo + 1 to: h.nameTo
    head: canon.substring from: 0 to: ((canon.indexOf needle: "_").or d: canon.length)
    if (bound.has item: canon.string).not when (d.names.has item: canon.string).not then {
        return "\{hole}, whose type \{canon} names no known type"
    }
    if arms when (d.arms.has key: head :name
    ).not then return "\{hole}, but \{head} declares no arm \{name}"
    if arms.not when (d.members.has key: head :name
    ).not then return "\{hole}, but \{head} declares no member \{name}"
    return "".string
}

# literalSpellings -- no text spells a tag constant (`Z_..._TAG_`) or a
# generated struct's member (`.data.x`, `->in_x`, `vtable->x`) literally: the
# holes name them, so the backend may lay them out as it likes
literalSpellings: function {texts: (List NativeText).view fails: List String} is {
    for each t: texts loop {
        tv: t.text.stringView
        if (spellsTagConstant text: tv) then (
            fails.append
            "\{t.where} spells a tag constant literally; name it @ARM_<canon>.<arm>@ (or @@<KEY>_SOME@@ in a template)"
        )
        if (spellsGeneratedMember text: tv) then (
            fails.append
            "\{t.where} spells a member of a generated struct literally (an arm in `data`, an inline arm, a vtable slot); name it @MEMBER_<canon>.<name>@ (or @OKMEMBER@/@ERRMEMBER@ in a conversion row)"
        )
    }
}

# valueRows -- a value row's body calls nothing and opens no statement
# expression (its facts are its operands'), and a constant variant is a value
# exactly when its plain row is; answers how many value rows there are
valueRows: function {fails: List String} out u64 is {
    n: u64
    for each u: nativec.units loop n = (
        n + (valueRowsOf rows: u.implementation.rows owner: u.name.stringView :fails)
    )
    fd: nativec.systemc.foundation
    for each g: fd.groups loop n = n + (valueRowsOf rows: g.rows owner: g.name.stringView :fails)
    n = n + (valueRowsOf rows: fd.structural owner: "" :fails)
    return n
}

# valueRowsOf -- valueRows over one list of rows
valueRowsOf: function {
    rows: staticlist schema.row owner: StringView fails: List String
} out u64 is {
    n: u64
    for each w: rows loop {
        if w.form.value then {
            n = n + 1
            if (bodyCalls body: w.body.stringView) then (
                fails.append
                "\{(
                    rowWhere
                    :owner
                    key: w.key.stringView
                )}: a value row's body calls or opens a statement expression -- drop form: c.form.value, and its result is taken for a call's"
            )
        }
    }
    constantForms :rows :owner :fails
    return n
}

# constantForms -- each constant variant of `rows` is a value exactly when the
# plain row of its key is
constantForms: function {rows: staticlist schema.row owner: StringView fails: List String} is {
    plain: MapRV String v: bool
    for each w: rows loop {
        if w.constant.length == 0 then plain.set key: w.key.string value: w.form.value
    }
    for each w: rows loop {
        if w.constant.length == 0 then continue
        p: plain.get key: w.key.string
        match (
            p
        ) case some then {
            if p != w.form.value then (
                fails.append
                "\{(
                    rowWhere
                    :owner
                    key: w.key.stringView
                )}: a constant variant and its plain row disagree on form (the emitter keys the form by path)"
            )
        } case none then null
    }
}

# plainHoles -- the names of the `z_@Name@` holes `text` spells, in order
plainHoles: function {text: StringView} out List String is {
    r: List String
    at: u64
    for at < text.length loop {
        o: (text.substring from: at to: text.length).indexOf needle: "z_@"
        if o.none then return r
        s: at + o + 3
        at = s
        e: identEnd :text from: s
        if e > s when ((text.byteAt i: e).or d: 0) == 64 then {
            r.append from: (text.substring from: s to: e).string
            at = e + 1
        }
    }
    return r
}

# identEnd -- where the C identifier starting at `from` ends; `from` when none
# starts there
identEnd: function {text: StringView from: u64} out u64 is {
    i: from
    for i < text.length loop {
        b: (text.byteAt :i).or d: 0
        if (isIdentByte :b).not then break
        if i == from when (isDigit :b) then break
        i = i + 1
    }
    return i
}

# isIdentByte -- a letter, a digit or `_`
isIdentByte: function {b: u8} out bool is {
    return (isUpper :b) or (isDigit :b) or ((b >= 0ca) and (b <= 0cz)) or (b == 95)
}

# isUpper -- an ASCII capital letter
isUpper: function {b: u8} out bool is {
    return (b >= 0cA) and (b <= 0cZ)
}

# isDigit -- an ASCII digit
isDigit: function {b: u8} out bool is {
    return (b >= 0c0) and (b <= 0c9)
}

# spellsTagConstant -- whether `text` holds `Z_`, then one or more capitals,
# digits or `_`, then `_TAG_`
spellsTagConstant: function {text: StringView} out bool is {
    at: u64
    for at < text.length loop {
        o: (text.substring from: at to: text.length).indexOf needle: "_TAG_"
        if o.none then return false
        t: at + o
        at = t + 1
        s: t
        for s > 0 while (isUpperIdentByte b: ((text.byteAt i: s - 1).or d: 0)) loop s = s - 1
        p: s
        for (p + 3) <= t loop {
            if ((text.byteAt i: p).or d: 0) == 0cZ when (
                ((text.byteAt i: p + 1).or d: 0) == 95
            ) then return true
            p = p + 1
        }
    }
    return false
}

# isUpperIdentByte -- a capital letter, a digit or `_`
isUpperIdentByte: function {b: u8} out bool is {
    return (isUpper :b) or (isDigit :b) or (b == 95)
}

# spellsGeneratedMember -- whether `text` holds `.data.<x>`, `.in_<x>`,
# `->in_<x>` or `vtable-><x>`, each <x> a letter or `_`
spellsGeneratedMember: function {text: StringView} out bool is {
    if (followedByIdent :text needle: ".data.") then return true
    if (followedByIdent :text needle: ".in_") then return true
    if (followedByIdent :text needle: "->in_") then return true
    return (followedByIdent :text needle: "vtable->")
}

# followedByIdent -- whether `needle` occurs in `text` followed by a letter or `_`
followedByIdent: function {text: StringView needle: StringView} out bool is {
    at: u64
    for at < text.length loop {
        o: (text.substring from: at to: text.length).indexOf :needle
        if o.none then return false
        e: at + o + needle.length
        b: (text.byteAt i: e).or d: 0
        if (isUpper :b) or ((b >= 0ca) and (b <= 0cz)) or (b == 95) then return true
        at = at + o + 1
    }
    return false
}

# bodyCalls -- whether a body opens a statement expression `({` or calls: an
# identifier, then spaces, then `(`. A cast's type `((T)` or `((T *)` is no call.
bodyCalls: function {body: StringView} out bool is {
    b: dropCasts :body
    bv: b.stringView
    if (bv.contains needle: "({") then return true
    i: u64
    for i < bv.length loop {
        if ((bv.byteAt :i).or d: 0) == 40 when (namedBefore text: bv at: i) then return true
        i = i + 1
    }
    return false
}

# namedBefore -- whether an identifier ends just before `at` in `text`, spaces
# between: a run of letters, digits and `_` that is not all digits
namedBefore: function {text: StringView at: u64} out bool is {
    j: at
    for j > 0 while ((text.byteAt i: j - 1).or d: 0) == 32 loop j = j - 1
    for j > 0 while (isIdentByte b: ((text.byteAt i: j - 1).or d: 0)) loop {
        j = j - 1
        if (isDigit b: ((text.byteAt i: j).or d: 0)).not then return true
    }
    return false
}

# dropCasts -- `body` with each `((T)` and `((T *)` cast written `((`, T letters,
# digits, `_` and spaces after a letter or `_`
dropCasts: function {body: StringView} out String is {
    r: String
    i: u64
    for i < body.length loop {
        if (body.substring from: i to: body.length).startsWith "((" then {
            e: castEnd text: body from: i + 2
            if e > 0 then {
                r.append "(("
                i = e
                continue
            }
        }
        r.appendByte ((body.byteAt :i).or d: 0)
        i = i + 1
    }
    return r
}

# castEnd -- past the `)` of a cast's type starting at `from` (a letter or `_`,
# then letters, digits, `_` and spaces, then an optional `*`); 0 when none does
castEnd: function {text: StringView from: u64} out u64 is {
    b0: (text.byteAt i: from).or d: 0
    if (isIdentByte b: b0).not or (isDigit b: b0) then return 0
    i: from + 1
    for i < text.length loop {
        b: (text.byteAt :i).or d: 0
        if (isIdentByte :b).not when b != 32 then break
        i = i + 1
    }
    if ((text.byteAt :i).or d: 0) == 42 then i = i + 1
    if ((text.byteAt :i).or d: 0) != 41 then return 0
    return i + 1
}

# joined -- `xs`, comma-separated
joined: function {xs: (List String).view} out String is {
    r: String
    for each x: xs loop {
        if r.length > 0 then r.append ", "
        r.append x
    }
    return r
}

# --- the numeric conversion rule ---
# What each `<src>.<dst>` conversion row of system's nativec.zd must be: its
# body, needs and form, derived from the scalar kinds' C facts the emitter
# writes casts with (zemitterc.kindBits ...). The rows are the truth the
# emitter reads; this rule is what `check rows` proves them against, and what
# `zc natives` prints.

# convIsLossy -- whether `<src>.<dst>` can lose information, which is exactly
# what decides the DECLARED return: the units give a lossy conversion a
# `resultval` and a provably-safe one the target type itself. Identity and
# widening within a signedness are safe; a signed source never fits an unsigned
# target; an unsigned one needs a strictly wider signed target; and a float
# target must have significand enough for the source's whole width.
# `zc natives check rows` (native-guard) checks this against the
# declarations, so the two encodings of the rule cannot drift apart.
convIsLossy: function {srcK: ztypes.numkind dstK: ztypes.numkind} out bool is {
    if srcK == dstK then return false
    sf: zemitterc.kindIsFloat k: srcK
    df: zemitterc.kindIsFloat k: dstK
    if sf then {
        if df then return (zemitterc.kindMantissa k: srcK) > (zemitterc.kindMantissa k: dstK)
        return true
    }
    if df then return (zemitterc.kindBits k: srcK) > (zemitterc.kindMantissa k: dstK)
    sb: zemitterc.kindBits k: srcK
    db: zemitterc.kindBits k: dstK
    ss: zemitterc.kindSigned k: srcK
    ds: zemitterc.kindSigned k: dstK
    if ss == ds then return sb > db
    if ss then return true
    return sb >= db
}

# convErr -- one converror arm of a checked conversion's result, as the C of
# the result tagged with it. The two reasons a conversion can fail are the whole
# vocabulary here: the value did not fit, or it fitted and lost bits doing so.
convErr: function {
    # the converror arm, as declared
    arm: StringView
} out String is {
    e: "(z_@RT@_t){ .tag = @ERRTAG@, .data.@ERRMEMBER@@TAG_converror@ = @ARM_converror.\{arm}@ }"
    return e
}

# convOk -- a checked conversion's result holding `value`, as C.
convOk: function {value: StringView} out String is {
    o: "(z_@RT@_t){ .tag = @OKTAG@, .data.@OKMEMBER@ = \{value} }"
    return o
}

# convFloatToFloat -- a float -> float conversion. Overflowing to infinity when
# the source was finite is out of range; anything that does not survive the
# round trip back to the source type lost precision.
convFloatToFloat: function {scT: StringView tcT: StringView} out String is {
    f: "(\{tcT})(@V@)"
    b: "((isinf(\{f}) && !isinf(@V@)) ? \{convErr arm: "outOfRange"} : (\{scT}) \{f} != (@V@) ? \{(convErr
        arm: "precisionLoss"
    )} : \{convOk value: f.stringView})"
    return b
}

# convFloatRange -- the C test that a float value lies inside the destination
# INTEGER's range, written as powers of two so the bound is exact at every
# width. An unsigned destination has no negative half.
convFloatRange: function {dstK: ztypes.numkind} out String is {
    b: zemitterc.kindBits k: dstK
    if (zemitterc.kindSigned k: dstK).not then {
        u: "((@V@) >= 0.0 && (@V@) < 0x1p\{b})"
        return u
    }
    bm1: b - 1
    r: "((@V@) >= -0x1p\{bm1} && (@V@) < 0x1p\{bm1})"
    return r
}

# convFloatToInt -- a float -> integer conversion: out of range when the value
# is outside the destination's span, precision loss when truncation moved it.
# The truncated value -- `trunc`, the destination's integer as C -- is compared
# in the SOURCE type, as convFloatToFloat's round trip is: an integer truncated
# from a float is exact in that float, and a narrower type would round the
# fraction away -- through double, an f128's 2^60 + 0.5 read back as 2^60 and
# converted without an error.
convFloatToInt: function {
    scT: StringView
    trunc: StringView
    dstK: ztypes.numkind
    okValue: StringView
} out String is {
    inRange: convFloatRange :dstK
    b: "(!\{inRange} ? \{convErr arm: "outOfRange"} : (\{scT}) \{trunc} != (@V@) ? \{(convErr
        arm: "precisionLoss"
    )} : \{convOk value: okValue})"
    return b
}

# convMagExpr -- the C for an integer's MAGNITUDE, which is what the exactness
# test measures. A signed source negates rather than casting, so the sign bit
# does not read as magnitude.
convMagExpr: function {signed: bool wide: bool needs: List String} out String is {
    if wide.not then {
        if signed then return "((@V@) < 0 ? (uint64_t)(0 - (uint64_t)(@V@)) : (uint64_t)(@V@))".string
        return "(uint64_t)(@V@)".string
    }
    if signed then {
        convNeed :needs piece: "@i128_is_neg"
        convNeed :needs piece: "@u128_sub"
        convNeed :needs piece: "@u128_u64"
        convNeed :needs piece: "@i128_bits"
        return "(z_i128_is_neg(@V@) ? z_u128_sub(Z_U128_U64(0), z_i128_bits(@V@)) : z_i128_bits(@V@))".string
    }
    return "(@V@)".string
}

# convIntToFloat -- an integer -> float conversion. It is exact when the
# magnitude's significant span -- highest set bit down to lowest -- fits the
# destination's mantissa, so the test counts the span rather than comparing
# values. f16 also has a range bound, which no other float here is narrow
# enough to need.
convIntToFloat: function {
    srcK: ztypes.numkind
    dstK: ztypes.numkind
    okValue: StringView
    needs: List String
} out String is {
    p: zemitterc.kindMantissa k: dstK
    wide: (srcK == ztypes.numkind.i128Type) or (srcK == ztypes.numkind.u128Type)
    mag: convMagExpr signed: (zemitterc.kindSigned k: srcK) :wide :needs
    span: "z_span64(\{mag})"
    if wide then {
        span = "z_u128_span(\{mag})"
        convNeed :needs piece: "@u128_span"
    } else {
        convNeed :needs piece: "@span64"
    }
    rangeAnd: String
    if dstK == ztypes.numkind.f16Type then {
        rangeAnd = " && \{mag} <= 65504"
        if wide then {
            rangeAnd = " && !z_u128_lt(Z_U128_U64(65504), \{mag})"
            convNeed :needs piece: "@u128_lt"
            convNeed :needs piece: "@u128_u64"
        }
    }
    n: "((\{span} <= \{p}\{rangeAnd}) ? \{convOk value: okValue} : \{(convErr
        arm: "precisionLoss"
    )})"
    return n
}

# convNeedsLo -- does the destination have a LOWER bound the source can breach?
# Only a signed source can go below zero, and only into a narrower signed
# destination; an unsigned source never can.
convNeedsLo: function {ssig: bool dsig: bool sbits: u64 dbits: u64} out bool is {
    if ssig.not then return false
    if dsig when sbits <= dbits then return false
    return true
}

# convRange128 -- convRangeCond for a 128-bit SOURCE, whose value is no C
# arithmetic type where the C compiler has no 128-bit integer: each bound is
# asked of the int128 helpers. Every such conversion has a bound to breach.
convRange128: function {
    srcK: ztypes.numkind dstK: ztypes.numkind needs: List String
} out String is {
    if (zemitterc.kindBits k: dstK) == 128 then {
        # the other 128-bit type: only the sign, or the top bit, is out of range
        if (zemitterc.kindSigned k: srcK) then {
            convNeed :needs piece: "@i128_is_neg"
            return "z_i128_is_neg(@V@)".string
        }
        convNeed :needs piece: "@u128_hi"
        return "(z_u128_hi(@V@) >> 63) != 0".string
    }
    hi: zemitterc.kindHiStr k: dstK
    if (zemitterc.kindSigned k: srcK).not then {
        convNeed :needs piece: "@u128_lt"
        convNeed :needs piece: "@u128_u64"
        u: "z_u128_lt(Z_U128_U64(\{hi}), @V@)"
        return u
    }
    convNeed :needs piece: "@i128_lt"
    if (zemitterc.kindSigned k: dstK).not then {
        convNeed :needs piece: "@i128_is_neg"
        convNeed :needs piece: "@i128_from_u64"
        n: "z_i128_is_neg(@V@) || z_i128_lt(z_i128_from_u64(\{hi}), @V@)"
        return n
    }
    convNeed :needs piece: "@i128_from_i64"
    lo: zemitterc.kindLoStr k: dstK
    b: "z_i128_lt(@V@, z_i128_from_i64(\{lo})) || z_i128_lt(z_i128_from_i64(\{hi}), @V@)"
    return b
}

# convOkValue -- the converted value a checked conversion holds once its test
# passed, as C: a cast, except where a 128-bit integer is on either side, whose
# value moves only through the int128 helpers.
convOkValue: function {
    srcK: ztypes.numkind dstK: ztypes.numkind tcT: StringView needs: List String
} out String is {
    sw: (zemitterc.kindBits k: srcK) == 128
    dw: (zemitterc.kindBits k: dstK) == 128
    if dstK == ztypes.numkind.f16Type then {
        # an integer the bounds test has shown is exact in f16
        src: "(double)(@V@)"
        if sw then {
            src = "z_u128_to_f64(@V@)"
            if (zemitterc.kindSigned k: srcK) then src = "z_i128_to_f64(@V@)"
            convNeedCall :needs call: src
        }
        convNeed :needs piece: "@f16_from_f64"
        h: "z_f16_from_f64(\{src})"
        return h
    }
    if sw.not when dw.not then {
        c: "(\{tcT})(@V@)"
        return c
    }
    if dw then return (convOkInto128 :srcK :dstK :needs)
    return (convOkFrom128 :srcK :dstK :tcT :needs)
}

# convOkInto128 -- convOkValue for a 128-bit destination.
convOkInto128: function {
    srcK: ztypes.numkind dstK: ztypes.numkind needs: List String
} out String is {
    if (zemitterc.kindBits k: srcK) == 128 then {
        if (zemitterc.kindSigned k: srcK) then {
            convNeed :needs piece: "@i128_bits"
            return "z_i128_bits(@V@)".string
        }
        convNeed :needs piece: "@u128_signed"
        return "z_u128_signed(@V@)".string
    }
    if (zemitterc.kindIsFloat k: srcK) then return (convFloatTrunc128 :srcK :dstK :needs)
    # a signed source checked non-negative, into u128
    convNeed :needs piece: "@u128_from_u64"
    return "z_u128_from_u64((uint64_t)(@V@))".string
}

# convOkFrom128 -- convOkValue for a 128-bit source into a narrower type: a
# float reads its value, an integer its low word, which the bounds test has
# already shown holds it.
convOkFrom128: function {
    srcK: ztypes.numkind dstK: ztypes.numkind tcT: StringView needs: List String
} out String is {
    if dstK == ztypes.numkind.f128Type then {
        if (zemitterc.kindSigned k: srcK) then {
            convNeed :needs piece: "@i128_to_f128"
            return "z_i128_to_f128(@V@)".string
        }
        convNeed :needs piece: "@u128_to_f128"
        return "z_u128_to_f128(@V@)".string
    }
    val: "z_u128_lo(@V@)"
    if (zemitterc.kindIsFloat k: dstK) then {
        val = "z_u128_to_f64(@V@)"
        if (zemitterc.kindSigned k: srcK) then val = "z_i128_to_f64(@V@)"
        convNeedCall :needs call: val
    } else {
        convNeed :needs piece: "@u128_lo"
        if (zemitterc.kindSigned k: srcK) then {
            val = "z_u128_lo(z_i128_bits(@V@))"
            convNeed :needs piece: "@i128_bits"
        }
    }
    c: "(\{tcT})"
    c.append val
    return c
}

# convTruncC -- a float source truncated to the destination integer and read
# back as a float, as C: what convFloatToInt compares the value against. A
# 128-bit destination truncates and reads back through the int128 helpers.
convTruncC: function {
    srcK: ztypes.numkind dstK: ztypes.numkind tcT: StringView needs: List String
} out String is {
    if (zemitterc.kindBits k: dstK) != 128 then {
        c: "(\{tcT})(@V@)"
        return c
    }
    back: "z_i128_to_f64(".string
    if (zemitterc.kindSigned k: dstK).not then back = "z_u128_to_f64(".string
    if srcK == ztypes.numkind.f128Type then {
        back = "z_i128_to_f128(".string
        if (zemitterc.kindSigned k: dstK).not then back = "z_u128_to_f128(".string
    }
    convNeedCall :needs call: back.stringView
    back.append (convFloatTrunc128 :srcK :dstK :needs)
    back.append ")"
    return back
}

# convFloatTrunc128 -- a float source truncated to a 128-bit integer, as C: from
# f128 directly, from any narrower float through double, which holds each of
# them exactly.
convFloatTrunc128: function {
    srcK: ztypes.numkind dstK: ztypes.numkind needs: List String
} out String is {
    pfx: "z_u128"
    if (zemitterc.kindSigned k: dstK) then pfx = "z_i128"
    if srcK == ztypes.numkind.f128Type then {
        q: "\{pfx}_from_f128(@V@)"
        convNeedCall :needs call: q.stringView
        return q
    }
    d: "\{pfx}_from_f64((double)(@V@))"
    convNeedCall :needs call: d.stringView
    return d
}

# convHalfCast -- a lossless conversion with an f16 on either side: the same
# value handed back, a narrow integer widened into one, or an f16 widened to a
# wider float, each through the f16 helpers.
convHalfCast: function {
    srcK: ztypes.numkind dstK: ztypes.numkind tcT: StringView needs: List String
} out String is {
    if srcK == dstK then return "(@V@)".string
    if dstK == ztypes.numkind.f16Type then {
        convNeed :needs piece: "@f16_from_f32"
        return "z_f16_from_f32((float)@V@)".string
    }
    convNeed :needs piece: "@f16_to_f32"
    w: "((\{tcT})z_f16_to_f32(@V@))"
    return w
}

# convFloatToHalf -- a float -> f16 conversion, convFloatToFloat's test through
# the f16 helpers: rounded once from the source, out of range when that made an
# infinity of a finite value, precision lost when it does not read back. `scT`
# is the type the source is read as.
convFloatToHalf: function {srcK: ztypes.numkind scT: StringView needs: List String} out String is {
    from: "z_f16_from_f64"
    if (zemitterc.kindMantissa k: srcK) == 24 then from = "z_f16_from_f32"
    if (zemitterc.kindMantissa k: srcK) == 113 then from = "z_f16_from_f128"
    h: "\{from}(@V@)"
    convNeedCall :needs call: h.stringView
    convNeed :needs piece: "@f16_to_f32"
    b: "((isinf(z_f16_to_f32(\{h})) && !isinf(@V@)) ? \{(convErr
        arm: "outOfRange"
    )} : (\{scT})z_f16_to_f32(\{h}) != (@V@) ? \{(convErr
        arm: "precisionLoss"
    )} : \{convOk value: h.stringView})"
    return b
}

# convWideCast -- a lossless conversion with a 128-bit integer on either side:
# the same type handed back, or a narrower integer widened by the helpers.
convWideCast: function {
    srcK: ztypes.numkind dstK: ztypes.numkind needs: List String
} out String is {
    if srcK == dstK then return "(@V@)".string
    w: "z_i128_from_u64(@V@)"
    if (zemitterc.kindSigned k: dstK).not then {
        w = "z_u128_from_u64(@V@)"
    } else if (zemitterc.kindSigned k: srcK) then {
        w = "z_i128_from_i64(@V@)"
    }
    convNeedCall :needs call: w
    return w.string
}

# convIntToInt -- an integer -> integer conversion. It cannot lose precision,
# only range, so the whole body is one bounds test.
convIntToInt: function {
    srcK: ztypes.numkind dstK: ztypes.numkind okValue: StringView needs: List String
} out String is {
    sbits: zemitterc.kindBits k: srcK
    dbits: zemitterc.kindBits k: dstK
    ssig: zemitterc.kindSigned k: srcK
    dsig: zemitterc.kindSigned k: dstK
    cond: String
    if sbits == 128 then {
        cond = convRange128 :srcK :dstK :needs
    } else {
        cond = (
            zemitterc.convRangeCond
            :dstK
            needsLo: (convNeedsLo :ssig :dsig :sbits :dbits)
            needsHi: (zemitterc.convNeedsHi :ssig :dsig :sbits :dbits)
        )
    }
    b: "((\{cond}) ? \{convErr arm: "outOfRange"} : \{convOk value: okValue})"
    return b
}

# convBodyOf -- the C the rows give for the conversion `<src>.<dst>`, as a
# row body. This is the SAME derivation emitNumericCast runs -- kindBits,
# kindSigned, kindLoStr, kindHiStr -- so the checked-in rows cannot
# say anything the rule does not; `zc natives check rows` compares each
# system conversion row with convRule to keep it that way. `lossy` follows the DECLARATION: a conversion the units declare as
# returning `resultval` builds one, and one returning the type directly is a
# plain cast, so the table and the declaration agree by construction. A checked
# conversion is one expression: its tests, in order, each choosing a result.
# It names @V@ in every test, so the emitter reads a value that is not free to
# read twice into a temporary first.
convBodyOf: function {
    srcK: ztypes.numkind dstK: ztypes.numkind lossy: bool needs: List String
} out String is {
    scT: zemitterc.kindCType k: srcK
    tcT: zemitterc.kindCType k: dstK
    wide: ((zemitterc.kindBits k: srcK) == 128) or ((zemitterc.kindBits k: dstK) == 128)
    if lossy.not then {
        if (srcK == ztypes.numkind.f16Type) or (dstK == ztypes.numkind.f16Type) then {
            return (convHalfCast :srcK :dstK :tcT :needs)
        }
        if wide then return (convWideCast :srcK :dstK :needs)
        d: "((\{tcT})@V@)"
        return d
    }
    # an f16 source is read as the float it widens to exactly, so every test
    # below compares C arithmetic values
    vT: scT.string
    if srcK == ztypes.numkind.f16Type then vT = "float".string
    okValue: convOkValue :srcK :dstK :tcT :needs
    body: String
    # the four corners of float/integer, each with its own way of failing
    if (zemitterc.kindIsFloat k: srcK) then {
        if dstK == ztypes.numkind.f16Type then {
            body = convFloatToHalf :srcK scT: vT.stringView :needs
        } else if (zemitterc.kindIsFloat k: dstK) then {
            body = convFloatToFloat :scT :tcT
        } else {
            body = (
                convFloatToInt
                scT: vT.stringView
                trunc: (convTruncC :srcK :dstK :tcT :needs).stringView
                :dstK
                okValue: okValue.stringView
            )
        }
    } else {
        if (zemitterc.kindIsFloat k: dstK) then {
            body = convIntToFloat :srcK :dstK okValue: okValue.stringView :needs
        } else {
            body = convIntToInt :srcK :dstK okValue: okValue.stringView :needs
        }
    }
    if srcK == ztypes.numkind.f16Type then {
        convNeed :needs piece: "@f16_to_f32"
        return (body.stringView.replace needle: "@V@" replacement: "z_f16_to_f32(@V@)")
    }
    return body
}

# convKinds -- the numeric kinds in the order the conversion rows stand
convKinds: function out ListVal ztypes.numkind is {
    # the rows' order: the table is diffed against its checked-in self, so it
    # is fixed here rather than taken from the kinds' own order
    order: ListVal ztypes.numkind
    order.append ztypes.numkind.u8Type
    order.append ztypes.numkind.c8Type
    order.append ztypes.numkind.c32Type
    order.append ztypes.numkind.i8Type
    order.append ztypes.numkind.i16Type
    order.append ztypes.numkind.i32Type
    order.append ztypes.numkind.i64Type
    order.append ztypes.numkind.u16Type
    order.append ztypes.numkind.u32Type
    order.append ztypes.numkind.u64Type
    order.append ztypes.numkind.f32Type
    order.append ztypes.numkind.f64Type
    order.append ztypes.numkind.i128Type
    order.append ztypes.numkind.u128Type
    order.append ztypes.numkind.f16Type
    order.append ztypes.numkind.f128Type
    return order
}

# ConvRule -- what the numeric rule gives the row of one conversion
ConvRule: class {
    # the conversion can fail, so it answers a resultval
    lossy: bool
    # the row's form is a value
    value: bool
    body: String
    # the helpers the row calls, as a row's needs
    needs: List String
}

# convRule -- the row the rule gives the conversion from `srcK` to `dstK`
convRule: function {srcK: ztypes.numkind dstK: ztypes.numkind} out ConvRule is {
    lo: convIsLossy :srcK :dstK
    nds: List String
    bd: convBodyOf :srcK :dstK lossy: lo needs: nds
    return (
        ConvRule
        lossy: lo
        value: (convIsValue :srcK :dstK lossy: lo)
        body: bd
        needs: (convNeeds :srcK :dstK needs: nds)
    )
}

# convRowText -- the conversion from `srcK` to `dstK` as system's nativec.zd
# writes its row: `(c.row key: "<src>.<dst>" ...)` with the rule's needs, form
# and body
convRowText: function {
    srcK: ztypes.numkind dstK: ztypes.numkind rule: ConvRule.view
} out String is {
    sn: ztypes.numkindName k: srcK
    dn: ztypes.numkindName k: dstK
    r: "(c.row key: \"".string
    r.append sn
    r.append "."
    r.append dn
    r.append "\""
    if rule.needs.length > 0 then {
        r.append " needs: list {"
        for each n: rule.needs loop r.append " \"\{n}\""
        r.append " }"
    }
    if rule.value then r.append " form: c.form.value"
    r.append " body: "
    r.append (zdataQuoted text: rule.body.stringView)
    r.append ")"
    return r
}

# zdataQuoted -- `text` as a zdata string literal: in quotes, a quote or a
# backslash in it escaped
zdataQuoted: function {text: StringView} out String is {
    r: "\"".string
    for each b: text.byteView loop {
        if (b == 34) or (b == 92) then r.appendByte 92
        r.appendByte b
    }
    r.append "\""
    return r
}

# convIsValue -- whether the conversion's row is a value (`form=value`): a
# lossless cast, or the same value handed back. The f16 and 128-bit helpers are
# calls, and a lossy conversion builds a result of its own.
convIsValue: function {srcK: ztypes.numkind dstK: ztypes.numkind lossy: bool} out bool is {
    if lossy then return false
    if srcK == dstK then return true
    half: (srcK == ztypes.numkind.f16Type) or (dstK == ztypes.numkind.f16Type)
    wide: ((zemitterc.kindBits k: srcK) == 128) or ((zemitterc.kindBits k: dstK) == 128)
    return (half or wide).not
}

# convNeeds -- the helper fragments a conversion row calls, as its needs: the
# int128 or f16 fragment's row for a 128-bit integer or an f16 on either side,
# then each prelude piece its body calls, as the body's builders recorded them
# (convNeed), once each in the order first called
convNeeds: function {
    srcK: ztypes.numkind dstK: ztypes.numkind needs: (List String).view
} out List String is {
    r: List String
    if (
        ((zemitterc.kindBits k: srcK) == 128) or ((zemitterc.kindBits k: dstK) == 128)
    ) then r.append "prelude.int128".string
    if (
        (srcK == ztypes.numkind.f16Type) or (dstK == ztypes.numkind.f16Type)
    ) then r.append "prelude.f16".string
    seen: Set String
    for each p: needs loop {
        if (seen.has item: p) then continue
        seen.add item: p.copy
        r.append "prelude.\{p}"
    }
    return r
}

# convNeed -- a conversion body's builder calls the prelude piece `piece`
# (its demand word, `@i128_bits`): the row needs it (convNeeds).
convNeed: function {needs: List String piece: StringView} is {
    needs.append piece.string
}

# convNeedCall -- convNeed for the helper a builder's call text `z_<name>(...)`
# names: the piece `@<name>`. For the builders that compose the helper's name.
convNeedCall: function {needs: List String call: StringView} is {
    open: (call.indexOf needle: "(").or d: call.length
    name: (call.substring from: 0 to: open).stripPrefix p: "z_"
    match (
        name
    ) case some then {
        p: "@\{name}"
        needs.append p
    } case none then null
}

# nativeConvRows -- the conversion rows the numeric rule gives, one line each
# as system's nativec.zd writes them (convRowText), grouped by the kind they
# convert from: 256 pairs, generated rather than written by hand, since a bound
# written wrong on a pair no program happens to use is not something the corpus
# can catch. `zc natives check rows` requires the rows zc carries to be
# these.
nativeConvRows: function out String is {
    order: convKinds
    buf: String
    for each s: order loop {
        sn: ztypes.numkindName k: s
        if buf.length > 0 then buf.append "\n"
        buf.append "# \{sn} conversions"
        for each d: order loop {
            buf.append "\n"
            buf.append (convRowText srcK: s dstK: d rule: (convRule srcK: s dstK: d))
        }
    }
    return buf
}
