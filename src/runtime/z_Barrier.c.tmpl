/*@@needs prelude.@atomic,prelude.@cond_t,prelude.@mutex_t@@*/
/* Barrier -- where a fixed number of threads wait for each other (sync.z).
   One lock and one condition variable in a heap block every handle shares:
   each round counts its arrivals, the last one starts the next round and
   wakes the rest, and a waiter waits until the round it arrived in has ended. */
typedef struct z_@@NAME@@_blk {
    z_mutex_t m;
    z_cond_t c;
    uint64_t count;
    uint64_t waiting;
    uint64_t round;
    Z_ATOMIC(uint64_t) refs;
} z_@@NAME@@_blk;

typedef struct z_@@NAME@@_t {
    z_@@NAME@@_blk* b;
} z_@@NAME@@_t;

/*@@member create needs=prelude.@cond_init,prelude.@mutex_init,prelude.@panic,prelude.@xmalloc@@*/
static z_@@NAME@@_t z_@@NAME@@_create(uint64_t count) {
    z_@@NAME@@_t br;
    br.b = (z_@@NAME@@_blk*)z_xmalloc(sizeof(z_@@NAME@@_blk));
    if (z_mutex_init(&br.b->m) != 0 || z_cond_init(&br.b->c) != 0) {
        z_panic("sync.Barrier: the operating system could not make a lock");
    }
    br.b->count = count == 0 ? 1 : count;
    br.b->waiting = 0;
    br.b->round = 0;
    atomic_init(&br.b->refs, 1);
    return br;
}
/*@@end@@*/

/*@@member share needs=prelude.@atomic_add,prelude.@relaxed@@*/
static z_@@NAME@@_t z_@@NAME@@_share(z_@@NAME@@_t* h) {
    Z_ATOMIC_ADD(&h->b->refs, 1, Z_RELAXED);
    z_@@NAME@@_t s;
    s.b = h->b;
    return s;
}
/*@@end@@*/

/*@@member destroy needs=prelude.@acqrel,prelude.@atomic_sub,prelude.@cond_destroy,prelude.@mutex_destroy@@*/
/* the last handle to end destroys what the block holds and frees it */
static void z_@@NAME@@_destroy(z_@@NAME@@_t* h) {
    if (h->b == NULL) return;
    if (Z_ATOMIC_SUB(&h->b->refs, 1, Z_ACQREL) == 1) {
        z_cond_destroy(&h->b->c);
        z_mutex_destroy(&h->b->m);
        free(h->b);
    }
    h->b = NULL;
}
/*@@end@@*/

/*@@member wait needs=prelude.@cond_broadcast,prelude.@cond_wait,prelude.@mutex_lock,prelude.@mutex_unlock@@*/
static bool z_@@NAME@@_wait(z_@@NAME@@_t* br) {
    z_@@NAME@@_blk* b = br->b;
    z_mutex_lock(&b->m);
    uint64_t round = b->round;
    b->waiting++;
    if (b->waiting == b->count) {
        b->waiting = 0;
        b->round++;
        z_cond_broadcast(&b->c);
        z_mutex_unlock(&b->m);
        return true;
    }
    while (b->round == round) z_cond_wait(&b->c, &b->m);
    z_mutex_unlock(&b->m);
    return false;
}
/*@@end@@*/
