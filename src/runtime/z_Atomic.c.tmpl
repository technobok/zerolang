/* Atomic -- one integer every thread reads and changes whole (sync.z), one
   copy per integer type. The value sits in the struct: a thread reaches it
   through a view of its owner's, so its address holds while any thread can. */
typedef struct z_@@NAME@@_t {
    Z_ATOMIC(@@t@@) v;
} z_@@NAME@@_t;

static z_@@NAME@@_t z_@@NAME@@_create(@@t@@ value) {
    z_@@NAME@@_t a;
    atomic_init(&a.v, value);
    return a;
}

static void z_@@NAME@@_destroy(z_@@NAME@@_t* a) {
    (void)a;
}

static @@t@@ z_@@NAME@@_load(const z_@@NAME@@_t* a, z_@memoryorder@_t order) {
    return Z_ATOMIC_LOAD((Z_ATOMIC(@@t@@)*)&a->v, z_sync_load_order(order));
}

static void z_@@NAME@@_store(const z_@@NAME@@_t* a, @@t@@ value, z_@memoryorder@_t order) {
    Z_ATOMIC_STORE((Z_ATOMIC(@@t@@)*)&a->v, value, z_sync_store_order(order));
}

static @@t@@ z_@@NAME@@_exchange(const z_@@NAME@@_t* a, @@t@@ value, z_@memoryorder@_t order) {
    return Z_ATOMIC_XCHG((Z_ATOMIC(@@t@@)*)&a->v, value, z_sync_order(order));
}

static @@t@@ z_@@NAME@@_compareExchange(const z_@@NAME@@_t* a, @@t@@ current, @@t@@ next, z_@memoryorder@_t order) {
    @@t@@ seen = current;
    Z_ATOMIC_CAS((Z_ATOMIC(@@t@@)*)&a->v, &seen, next, z_sync_order(order), z_sync_fail_order(order));
    return seen;
}

static @@t@@ z_@@NAME@@_fetchAdd(const z_@@NAME@@_t* a, @@t@@ value, z_@memoryorder@_t order) {
    return Z_ATOMIC_ADD((Z_ATOMIC(@@t@@)*)&a->v, value, z_sync_order(order));
}

static @@t@@ z_@@NAME@@_fetchSub(const z_@@NAME@@_t* a, @@t@@ value, z_@memoryorder@_t order) {
    return Z_ATOMIC_SUB((Z_ATOMIC(@@t@@)*)&a->v, value, z_sync_order(order));
}
