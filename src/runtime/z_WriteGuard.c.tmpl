   one copy per value type; both classes are this template, @@P0@@ their one
   type: the lock and the value, both in the RwLock's block, which the guard's
   pins keep alive. Destroying the guard unlocks. */
typedef struct z_@@NAME@@_t {
    z_rwlock_t* l;
    @@P0@@* value;
} z_@@NAME@@_t;

static void z_@@NAME@@_destroy(z_@@NAME@@_t* g) {
    if (g->l == NULL) return;
    z_rwlock_wrunlock(g->l);
    g->l = NULL;
}

static @@P0@@* z_@@NAME@@_value(z_@@NAME@@_t* g) {
    return g->value;
}

/* the old value moves out to the caller, which owns it from here */
static @@P0@@ z_@@NAME@@_set(z_@@NAME@@_t* g, @@P0@@ value) {
    @@P0@@ old = *g->value;
    *g->value = value;
    return old;
}
