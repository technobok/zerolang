/*@@needs prelude.@atomic,prelude.@mutex_t@@*/
/* Mutex and MutexVal -- a value of @@P0@@ that one thread at a time reaches,
   through the guard `lock` answers (sync.z), one copy per value type; both
   classes are this template, @@P0@@ their one type. The lock and the
   value live in a heap block every handle shares (`share` makes another), so
   neither moves while a thread waits on it or holds it; the last handle to
   end frees it. A MutexGuard is `{z_mutex_t* m; T* value}`
   (z_MutexGuard.c.tmpl): `lock` fills one. */
typedef struct z_@@NAME@@_blk {
    z_mutex_t m;
    Z_ATOMIC(uint64_t) refs;
    @@P0@@ value;
} z_@@NAME@@_blk;

typedef struct z_@@NAME@@_t {
    z_@@NAME@@_blk* b;
} z_@@NAME@@_t;

/*@@member create needs=prelude.@mutex_init@@*/
static z_@@NAME@@_t z_@@NAME@@_create(@@P0@@ value) {
    z_@@NAME@@_t mx;
    mx.b = (z_@@NAME@@_blk*)z_xmalloc(sizeof(z_@@NAME@@_blk));
    if (z_mutex_init(&mx.b->m) != 0) z_panic("sync.Mutex: the operating system could not make a lock");
    atomic_init(&mx.b->refs, 1);
    mx.b->value = value;
    return mx;
}
/*@@end@@*/

/*@@member share needs=prelude.@atomic_add,prelude.@relaxed@@*/
static z_@@NAME@@_t z_@@NAME@@_share(z_@@NAME@@_t* h) {
    Z_ATOMIC_ADD(&h->b->refs, 1, Z_RELAXED);
    z_@@NAME@@_t s;
    s.b = h->b;
    return s;
}
/*@@end@@*/

/*@@member destroy needs=prelude.@acqrel,prelude.@atomic_sub,prelude.@mutex_destroy@@*/
/* the last handle to end destroys what the block holds and frees it */
static void z_@@NAME@@_destroy(z_@@NAME@@_t* h) {
    if (h->b == NULL) return;
    if (Z_ATOMIC_SUB(&h->b->refs, 1, Z_ACQREL) == 1) {
        @@P0_DESTROY@@(&h->b->value);
        z_mutex_destroy(&h->b->m);
        free(h->b);
    }
    h->b = NULL;
}
/*@@end@@*/

/*@@member lock needs=prelude.@mutex_lock@@*/
static z_@@OUT.lock@@_t z_@@NAME@@_lock(z_@@NAME@@_t* mx) {
    z_@@OUT.lock@@_t g;
    if (z_mutex_lock(&mx->b->m) != 0) z_panic("sync.Mutex: lock failed");
    g.m = &mx->b->m;
    g.value = &mx->b->value;
    return g;
}
/*@@end@@*/
