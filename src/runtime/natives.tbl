# natives.tbl -- the implementation of every `is native` declaration, keyed by
# its fully-qualified path. The compiler answers "which implementation" by
# looking the path up here; an absent row is an error, not a fallthrough.
#
# A row is `[<path> attr=value ...] <body>`. The body is C with holes:
#   @T@        the receiver type's C name, minus the leading z_ that a body
#              spells for itself -- so a body writes z_ then the hole
#   @L@ @R@    the emitted operands
#   @V@        the receiver of a receiver-only row -- a conversion, `bits`,
#              `not`
#   @A1@ @A2@  the arguments of an argument-taking row, 1-based with the
#              receiver excluded (the numbering `const=` uses), named by
#              DECLARED position and evaluated in written order; see
#              emitNativeArgMethod in src/zemitterc.z
# The operands are evaluated once each, in written order, ahead of the body. A
# hole fills with the operand's C as it stands when reading it twice costs
# nothing (a name, a field, a constant); a body that names a hole more than once
# gets the operand read into a temporary first otherwise. So a body may name
# any hole as often as it needs, and is an expression: C17 has no statement
# inside an expression, and a body that needs storage of its own calls a
# fragment's function instead.
#   @TAG_<type>@
#              how to reach that type's discriminator: `.tag` while it is a
#              tagged struct, NOTHING once the backend has unwrapped it -- a
#              type whose value IS its discriminator has no field to reach
#              through. A hole rather than the access itself, because this file
#              is read by both the running compiler and the committed seed, and
#              on either side of a representation change they do not agree.
#   @ARM_<type>.<arm>@
#              the tag constant of that arm of that type
#   @MEMBER_<type>.<name>@
#              that member of a struct the compiler generates for a zerolang
#              declaration: a record's or class's field, a variant's arm in its
#              `data`, a union's inline arm slot, a protocol's vtable slot. The
#              emitter chooses those spellings, so a fragment names the member
#              by its type and its name; a runtime-owned layout (`is native`:
#              String, the collections, ...) is the runtime's and keeps its own
#   @OKTAG@ @ERRTAG@ @OKMEMBER@ @ERRMEMBER@
#              a conversion row's result: the ok and err tags, and the ok and err
#              arms' members, of whatever resultval instance the row returns
# A hole naming a type must name one the loader can resolve; native-guard
# checks that, and it reads this file whole, comments included.
# Attributes:
#   needs=<n>  the body calls a demand-gated runtime fragment; without this the
#              fragment never reaches the output and the C does not compile.
#              <n> is a member of the row's own unit, or `<unit>.<member>` for
#              another unit's (`system.word`, the word primitives). A PIECE of a
#              fixed runtime file (z_head.inc, z_hash.inc, ...) is the text
#              between `/*@@row @prelude.<name> demand=... needs=...@@*/` and
#              `/*@@end@@*/`, written in place only where a need names it:
#              `prelude.@<name>` here (make piece-guard). A need `<n>?<c>`
#              holds only under the condition <c>: the body calls <n> in one
#              preprocessor branch alone (u128 division's portable form calls the
#              long division; the native one does not), so <n> is written where
#              the row is AND <c> is, inside `#if`, and no configuration
#              compiles a function it never calls (make cc-unused-guard). <c> is
#              declared once by a `[@cond <c> = <C expression>]` row; a row
#              written under no condition holds everywhere. `members=` entries
#              take `?<c>` too.
#   args=ptr   the body takes its operands by pointer, so they must be lvalues
#   pulls=<l>  demanding the member demands each `<unit>.<member>` of <l>
#              (comma-separated) at once, where the demand is recorded: the
#              helpers another unit's C supplies to this body (os.env needs
#              io's StringView-to-C-string), registered before that unit's
#              runtime is emitted
#   call=<k>   on a `system.StringView.<m>` row: how a call of <m> on a String or
#              StringView is emitted -- `simple` (the receiver and arguments by
#              pointer), `arg` (an argument, an optionval/Option result),
#              `parse` (a resultval result) or `noarg` (no arguments, its
#              fragment registered ahead of the type-method bodies). The
#              emitter keys these by the member's name id; a member with none
#              takes the general paths.
#   const=<p>  a VARIANT row, chosen over the plain one for the same path only
#              when the argument positions <p> -- comma-separated, 1-based,
#              RECEIVER EXCLUDED, so a binop's one argument is 1 -- are all
#              compile-time constants. Such a position fills with a LITERAL,
#              so the variant can spell what only a known value allows: a
#              division by a literal that is neither 0 nor -1 needs no check.
#              make const-row-guard pins both directions.
#   tmpl=<f>   on a `<unit>.<Class>.@class` row: the class is written from the C
#              template <f> in the runtime dir -- once per instance when it is
#              GENERIC, once when it is not (a class holding OS state, whose
#              layout no declaration can say) --
#              @@NAME@@ the instance's C name, and per type parameter P, @@P@@
#              the C type of its argument as a slot holds it and @@P_DESTROY@@ a
#              function `void (P* x)` destroying one in place. The template
#              defines the struct, `z_@@NAME@@_create`, `z_@@NAME@@_destroy` and
#              `z_@@NAME@@_<method>` for each native method, taking the receiver
#              by pointer; each method still has its (bodiless) row.
#              @@P.<m>@@ names the function the argument declares as its member
#              <m> (a bound's method, called with the receiver by pointer);
#              @@OUT.<m>@@ is the C name of the type the instance's method <m>
#              answers (`lock` -> its MutexGuard), @@ARG.<m>.<p>@@ of the type
#              its parameter <p> takes (`wait cond:` -> Condvar), and
#              @@SOME.<m>@@ / @@NONE.<m>@@ name functions building the option
#              <m> answers, some over one argument or none: a function
#              spelling one the program does not have is left out, since
#              nothing calls it. @@P0@@ / @@P0_DESTROY@@ name the first
#              parameter by position, so one template serves two classes. A
#              method answering `.borrow`/`.view` returns a pointer to it;
#              @@String@@ / @@StringView@@ are those types' C names, and the
#              holes a fragment spells (a type by canon, a tag constant, a
#              member) fill as in a fragment, so a lone at-sign opens a hole
#              there too. The
#              template's types come before its first function, and each
#              function's signature is one `static ...) {` line: the types are
#              written with the instance, the functions after the program's
#              prototypes, so a body may call any of them.
#   via=<m>    on a native FREE function answering an instance of a templated
#              class: the function is that instance's template function
#              `z_<instance>_<m>`, called with the function's arguments in
#              declared order (a left-out one is its default). A generic
#              function needs C per instance, and the instance it answers is
#              the one place that C is written (`thread.spawn` is JoinHandle's
#              create).
#   when=<f>   a VARIANT row, chosen over the plain row of the same key when
#              the fact <f> holds, and dropped when it does not; it stands ABOVE
#              that plain row, and a key may have a variant and no plain row
#              (the table is read once, in order). Any row may carry it: a body, a
#              fragment, an `@unit.` row's link/csrc/cdefs. <f> is declared by
#              an `@fact.<f> reach=<paths>` row ABOVE every row naming it, and
#              holds when the program reaches any of the comma-separated paths
#              -- each a free function or a type, `<unit>.<name>`, demanded by
#              the program (a generic one when any instance of it is), in a unit
#              that declares something native. A fact needs no #define: what it
#              changes is which rows the program is built from.
#   form=value the body is a VALUE computed from its holes: operators and casts
#              over them, no call and no statement expression. Its C reads
#              as its operands do -- no storage, repeated work only where an
#              operand repeats work -- so a reader may spell it twice. A row
#              without it is taken for a call's result, which a reader binds
#              to a temp before spelling it twice: a missing mark costs a
#              temp, never wrong C. native-guard refuses a value row whose
#              body calls or opens a statement expression.
#
# A path beginning `@` is a SYNTHESISED structural case -- a record's or a
# variant's `==`/`!=`, which no unit declares. The sigil is what keeps those out
# of the declaration space: a free function's path is `<unit>.<name>`, two
# segments just like theirs, and `io.readText` and a record's `==` must never be
# able to name each other.
#
# THREADS. The checker moves values between threads and lets several threads
# read one, so every native's C holds with other threads running:
#   - a native method's `.view` receiver is a const pointer (view-guard), and
#     the method writes nothing its object reaches -- no cache, count or cursor
#     kept in the object (an iterator's cursor is the iterator's own) -- so any
#     number of threads may read one object at once. A class whose reads drive
#     C state declares `thread.Unshareable` (sqlite's: a read prepares on the
#     connection); one whose value must stay on the thread that made it
#     declares `thread.ThreadBound` (the lock guards).
#   - what two values share (a sync handle's block) changes only atomically or
#     under the block's own lock; everything else a value reaches is its own,
#     and moves with it.
#   - process-wide state is written before the program's main runs, or by a
#     `when=threaded` variant that holds with threads running: the argv globals
#     and the hash seed are set in C's main ahead of z_main; setEnv/unsetEnv
#     refuse while threads run; a panic or os.exit ends the process once.
#   - libc calls are the reentrant ones (getpwuid_r; no strerror, strtok or
#     localtime). The lgamma family writes libc's `signgam`, which nothing here
#     reads; the result is the call's own.
#   - a C source a unit builds is built thread-safe in a program that starts
#     threads (sqlite's THREADSAFE=2), by its `@unit.` row's `when=threaded`
#     variant.


# the conditions a need `<n>?<c>` holds under: C preprocessor expressions
[@cond portable128 = !defined(Z_INT128_NATIVE)]
[@cond native128 = defined(Z_INT128_NATIVE)]
[@cond portable128q = !defined(Z_INT128_NATIVE) && defined(__SIZEOF_FLOAT128__)]
[@cond portable16 = !defined(Z_F16_NATIVE)]
[@cond portable16q = !defined(Z_F16_NATIVE) && defined(__SIZEOF_FLOAT128__)]
[@cond win32 = defined(_WIN32)]
[@cond posix = !defined(_WIN32)]

# system.u8
[system.u8.+ form=value]       ((uint8_t)(@L@ + @R@))
[system.u8.- form=value]       ((uint8_t)(@L@ - @R@))
[system.u8.* form=value]       ((uint8_t)(@L@ * @R@))
[system.u8./ needs=prelude.divide,prelude.@div_u32] ((uint8_t)z_div_u32(@L@, @R@))
[system.u8./ const=1]          ((uint8_t)(@L@ / @R@))
[system.u8.% needs=prelude.divide,prelude.@rem_u32] ((uint8_t)z_rem_u32(@L@, @R@))
[system.u8.% const=1]          ((uint8_t)(@L@ % @R@))
[system.u8.& form=value]       ((uint8_t)(@L@ & @R@))
[system.u8.| form=value]       ((uint8_t)(@L@ | @R@))
[system.u8.<<]                 ((uint8_t)((uint8_t)(@R@) >= 8 ? 0 : (uint8_t)((uint8_t)(@L@) << (uint8_t)(@R@))))
[system.u8.>>]                 ((uint8_t)((uint8_t)(@R@) >= 8 ? 0 : ((uint8_t)(@L@) >> (uint8_t)(@R@))))
[system.u8.^ form=value]       ((uint8_t)(@L@ ^ @R@))
[system.u8.not form=value]     ((uint8_t)(~(@V@)))
[system.u8.<= form=value]      (@L@ <= @R@)
[system.u8.< form=value]       (@L@ < @R@)
[system.u8.> form=value]       (@L@ > @R@)
[system.u8.>= form=value]      (@L@ >= @R@)
[system.u8.== form=value]      (@L@ == @R@)
[system.u8.!= form=value]      (@L@ != @R@)
[system.u8.compare]            ((int32_t)((@V@ > @A1@) - (@V@ < @A1@)))

