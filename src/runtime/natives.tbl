[system.c8.| form=value]       ((uint8_t)(@L@ | @R@))
[system.c8.<<]                 ((uint8_t)((uint8_t)(@R@) >= 8 ? 0 : (uint8_t)((uint8_t)(@L@) << (uint8_t)(@R@))))
[system.c8.>>]                 ((uint8_t)((uint8_t)(@R@) >= 8 ? 0 : ((uint8_t)(@L@) >> (uint8_t)(@R@))))
