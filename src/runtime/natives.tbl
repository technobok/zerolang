# -- String and StringView ---------------------------------------------
# The demand-gated bodies live in _Z_SV_* fragments; everything else is in the
# unconditionally loaded z_String.inc / z_StringView.inc, or is a projection --
# String's startsWith IS StringView's, reached by viewing the receiver, so the
# view owns the fragment and the String row states only that the native exists.
# The comparisons and `+` are operator rows above; these are the rest.

# system.String
[system.String.compare]
[system.String.stringView]
[system.String.substring]
[system.String.length]
[system.String.count]
[system.String.capacity]
[system.String.startsWith]
[system.String.endsWith]
[system.String.contains]
[system.String.append]
[system.String.appendByte]
[system.String.reserve]
[system.String.shrink]
[system.String.copy]
[system.String.hash]
[system.String.create]

# system.text -- static text, laid out as a StringView: each member is the
# view's own C, and its fragment is the StringView member's of the same name
[system.text.length]           ((uint64_t)(@V@).size)
[system.text.isEmpty]          ((@V@).size == 0)
[system.text.string needs=prelude.@String_from_view] z_@String@_from_view(@V@)
[system.text.stringView]       (@V@)
[system.text.== needs=prelude.@StringView_eq] z_@StringView@_eq(@L@, @R@)
[system.text.!= needs=prelude.@StringView_eq] !z_@StringView@_eq(@L@, @R@)
[system.text.< needs=prelude.@StringView_cmp] (z_@StringView@_cmp(@L@, @R@) < 0)
[system.text.<= needs=prelude.@StringView_cmp] (z_@StringView@_cmp(@L@, @R@) <= 0)
[system.text.> needs=prelude.@StringView_cmp] (z_@StringView@_cmp(@L@, @R@) > 0)
[system.text.>= needs=prelude.@StringView_cmp] (z_@StringView@_cmp(@L@, @R@) >= 0)
[system.text.compare needs=prelude.@StringView_cmp] z_@StringView@_cmp(@V@, @A1@)
# a fragment taking the view by pointer is handed one, through a compound
# literal so a receiver that is not a place is one too
[system.text.hash needs=hash]                z_@StringView@_hash((z_@StringView@_t[]){ @V@ })
[system.text.substring needs=substring]      z_@StringView@_substring((z_@StringView@_t[]){ @V@ }, @A1@, @A2@)
[system.text.trim needs=trim]                z_@StringView@_trim((z_@StringView@_t[]){ @V@ })
[system.text.trimStart needs=trimStart]      z_@StringView@_trimStart((z_@StringView@_t[]){ @V@ })
[system.text.trimEnd needs=trimEnd]          z_@StringView@_trimEnd((z_@StringView@_t[]){ @V@ })
# the members below are emitted as StringView's of the same name, keyed by its
# `call=` (the emitter reads a text receiver as the view it is laid out as)
[system.text.isAscii]
[system.text.startsWith]
[system.text.endsWith]
[system.text.contains]
[system.text.indexOf]
[system.text.lastIndexOf]
[system.text.byteAt]
[system.text.splitOnce]
[system.text.count]
[system.text.codepoints]
[system.text.toLowerAscii]
[system.text.toUpperAscii]
[system.text.replace]
[system.text.replaceFirst]
[system.text.repeated]
[system.text.concat]

# system.StringView -- ROW ORDER IS LOAD ORDER. The three shared helpers sit
# ahead of the members that pull them, each naming those members.
[system.StringView.length]
[system.StringView.string]
[system.StringView.asString]
[system.StringView.compare]
[system.StringView.split]
[system.StringView.lines call=noarg]
[system.StringView.isEmpty call=simple frag=_Z_SV_IS_EMPTY]
[system.StringView.isAscii call=simple frag=_Z_SV_IS_ASCII]
[system.StringView.startsWith call=simple frag=_Z_SV_STARTS_WITH]
[system.StringView.endsWith call=simple frag=_Z_SV_ENDS_WITH]
[@system.index_of_raw demand=contains,indexOf frag=_Z_SV_INDEX_OF_RAW]
[system.StringView.contains call=simple frag=_Z_SV_CONTAINS]
[@system.is_ascii_ws demand=trim,trimStart,trimEnd frag=_Z_SV_IS_ASCII_WS]
[system.StringView.substring needs=prelude.@panic frag=_Z_SV_SUBSTRING]
[system.StringView.hash needs=prelude.@siphash_stringview call=noarg frag=_Z_SV_HASH]
[system.StringView.fastHash needs=prelude.@fasthash_stringview call=noarg frag=_Z_SV_FAST_HASH]
[system.StringView.trim call=simple frag=_Z_SV_TRIM]
[system.StringView.trimStart call=simple frag=_Z_SV_TRIM_START]
[system.StringView.trimEnd call=simple frag=_Z_SV_TRIM_END]
[system.StringView.toLowerAscii needs=prelude.@xmalloc call=simple frag=_Z_SV_TO_LOWER_ASCII]
[@system.replace_impl needs=prelude.@xmalloc demand=replace,replaceFirst frag=_Z_SV_REPLACE_IMPL]
[system.StringView.replace call=simple frag=_Z_SV_REPLACE]
[system.StringView.replaceFirst call=simple frag=_Z_SV_REPLACE_FIRST]
[system.StringView.repeated needs=prelude.@xmalloc call=simple frag=_Z_SV_REPEAT]
[system.StringView.concat needs=prelude.@xmalloc call=simple frag=_Z_SV_CONCAT]
[system.StringView.toUpperAscii needs=prelude.@xmalloc call=simple frag=_Z_SV_TO_UPPER_ASCII]
[@system.utf8_decode demand=count,codepoints frag=_Z_SV_UTF8_DECODE]
[system.StringView.count call=noarg frag=_Z_SV_COUNT]
[system.StringView.codepoints call=noarg frag=_Z_SV_CPITER_STRUCT,_Z_SV_CODEPOINTS,_Z_SV_CPITER_CALL]
[system.StringView.indexOf call=arg frag=_Z_SV_INDEX_OF]
[system.StringView.lastIndexOf call=arg frag=_Z_SV_LAST_INDEX_OF]
[system.StringView.byteAt call=arg frag=_Z_SV_BYTE_AT]
[system.StringView.stripPrefix needs=prelude.@xmalloc call=arg frag=_Z_SV_STRIP_PREFIX]
[system.StringView.stripSuffix needs=prelude.@xmalloc call=arg frag=_Z_SV_STRIP_SUFFIX]
[system.StringView.splitOnce call=arg frag=_Z_SV_SPLIT_ONCE]
[system.StringView.parseI64 call=parse frag=_Z_SV_PARSE_I64]
[system.StringView.parseU64 call=parse frag=_Z_SV_PARSE_U64]
[system.StringView.parseF64 needs=prelude.@xmalloc call=parse frag=_Z_SV_PARSE_F64]
[system.StringView.parseF16 call=parse frag=_Z_SV_PARSE_F16 needs=prelude.f16,prelude.@xmalloc,prelude.@f16_from_f32,prelude.@f16_to_f32]
[system.StringView.parseF128 needs=prelude.@quadmath,prelude.@xmalloc,prelude.@strtoflt128 call=parse frag=_Z_SV_PARSE_F128]

# system's word primitives: the carry-chain steps and the two-word division the
# u64 rows reach with `needs=word`, one fragment for all three
[@system.word demand=@unit,word frag=_Z_SYSTEM_WORD]
# UTF-8 validation: how many bytes are valid before the first invalid sequence,
# for ByteView.stringView and the text reader alike
[@system.utf8 frag=_Z_UTF8_VALID_UPTO]
# a StringView's bytes as a ByteView, and back, over the same memory
[system.viewBytes frag=_Z_SYSTEM_VIEW_BYTES]
[collections.bytesText frag=_Z_COLLECTIONS_BYTES_TEXT]
[collections.utf8ValidUpTo needs=system.utf8 frag=_Z_COLLECTIONS_UTF8_VALID_UPTO]
# the u64 rows that answer a record: each builds it in a function of its own,
# after the record's struct
[@system.mul_wide needs=prelude.@mul128 frag=_Z_SYSTEM_MUL_WIDE]
[@system.carry_step demand=@unit,carry_step frag=_Z_SYSTEM_CARRY_STEP]
[@system.div_wide needs=word,@word_divwide frag=_Z_SYSTEM_DIV_WIDE]

# a runtime helper no declaration names: every i128 / u128 operation, and their
# decimal formatter, demanded by the rows above, the conversions and any program
# that prints or hashes one. The `@` marks it as standing outside the
# declaration space, as the synthesised comparisons do. Its unit is `prelude`
# because of WHERE it goes: emitC emits it into the header, ahead of the literal
# pool, so that a need registered inside a type method is still in time.
# z_panic, written between the prelude's head (z_head.inc) and its allocators
# (z_alloc.inc): a threaded program's reports once and ends with _exit
[@prelude.panic when=threaded frag=_Z_PANIC_THREADED]
[@prelude.panic frag=_Z_PANIC]
[@prelude.int128 frag=_Z_INT128]
[@prelude.f16 frag=_Z_F16]
[@prelude.fmt64 frag=_Z_FMT64]
# integer division and remainder by a run-time divisor: a zero one panics
[@prelude.divide needs=prelude.@panic frag=_Z_DIVIDE]
# f128's square root, correctly rounded on every libquadmath
[@prelude.f128sqrt frag=_Z_F128_SQRT]
# f64's exp2, within a unit in the last place on Windows too
[@prelude.f64exp2 frag=_Z_F64_EXP2]
# the thread shim: threads, locks, condition variables, once, atomics, demanded
# by a row that names `needs=prelude.zthread`
[@prelude.zthread frag=_Z_THREAD_SHIM]
# the Win32 layer under io, os and net (UTF-16, native paths, handles, error
# text), demanded by a row that names `needs=prelude.zwin32`; empty off Windows
[@prelude.zwin32 frag=_Z_WIN32_SHIM]
# a channel's block, which its typed ends share; a row naming
# `needs=prelude.zchan` demands it, after the shim it locks with. Each of its
# functions is a piece the template section calling it names
[@prelude.zchan needs=prelude.zthread frag=_Z_CHAN]

# thread -- a JoinHandle per result type, and its value twin, from one
# template; the shim's threads need pthread at the link. A program that only
# names the unit's markers (a sqlite type is `thread.Unshareable`) starts no
# thread and links nothing for it.
[@unit.thread when=threaded os=linux,darwin,other link=pthread]
[@unit.thread]
[thread.JoinHandle.@class tmpl=z_JoinHandle.c.tmpl needs=prelude.zthread]
[thread.JoinHandle.join]
[thread.JoinHandle.isFinished]
[thread.JoinHandle.id]
[thread.JoinHandle.detach]
[thread.JoinHandle.create]
[thread.JoinHandleVal.@class tmpl=z_JoinHandle.c.tmpl needs=prelude.zthread]
[thread.JoinHandleVal.join]
[thread.JoinHandleVal.isFinished]
[thread.JoinHandleVal.id]
[thread.JoinHandleVal.detach]
[thread.JoinHandleVal.create]
[thread.spawn via=create]
[thread.spawnVal via=create]
[thread.yieldNow needs=prelude.zthread,prelude.@thread_yield frag=_Z_THREAD_YIELD_NOW]
[thread.running needs=prelude.zthread,prelude.@thread_live frag=_Z_THREAD_RUNNING]

# sync -- what threads share: each class is written from its template, over the
# shim's atomics and locks, which need pthread at the link
[@unit.sync os=linux,darwin,other link=pthread]
