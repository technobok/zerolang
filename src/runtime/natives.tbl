[@sync.store_order demand=@store_order needs=memory_order,prelude.@panic frag=_Z_SYNC_STORE_ORDER]
[@sync.fail_order demand=@fail_order needs=memory_order frag=_Z_SYNC_FAIL_ORDER]
[sync.Atomic.@class tmpl=z_Atomic.c.tmpl needs=prelude.zthread,memory_order]
[sync.Atomic.create]
[sync.Atomic.share]
[sync.Atomic.load]
