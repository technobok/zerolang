# -- synthesised structural equality ------------------------------------
# A record or a variant that declares no `==` gets one, and its `!=` with it.
# A record whose typedef chain bottoms out at a scalar compares inline instead
# of through a helper, so it is its own shape.
[@record.== calls=eq]           z_@T@_eq(@L@, @R@)
[@record.!= calls=eq]           !z_@T@_eq(@L@, @R@)
[@variant.== calls=eq]          z_@T@_eq(@L@, @R@)
[@variant.!= calls=eq]          !z_@T@_eq(@L@, @R@)
[@scalar.== form=value]        (@L@ == @R@)
[@scalar.!= form=value]        (@L@ != @R@)


# --- canonical stems ---------------------------------------------------
# The generic instances a runtime fragment spells as a hole by a canonical stem
# -- z_@Result_String_IoError@_t -- each named here by its template and type
# arguments, which the emitter resolves through the spec trie, never from the
# mangled spelling. A part is a type name, `unit.name` for a type a unit outside
# system declares, or `@stem` for another row's instance. A hole no row names is
# a plain source name (File, IoError, Reader) and resolves by that name.
[@canon.Option_StringView spec=Option,StringView]
[@canon.Option_String spec=Option,String]
[@canon.OptionView_String spec=OptionView,String]
[@canon.ListViewVal_u8 spec=ListViewVal,u8]
[@canon.ListViewVal_u64 spec=ListViewVal,u64]
[@canon.ListViewVal_i32 spec=ListViewVal,i32]
[@canon.SpanVal_u64 spec=SpanVal,u64]
[@canon.ListVal_u8 spec=ListVal,u8]
[@canon.List_String spec=ListRef,String]
[@canon.List_Child spec=ListRef,os.Child]
[@canon.List_PositionalDef spec=ListRef,cli.PositionalDef]
[@canon.List_OptionDef spec=ListRef,cli.OptionDef]
[@canon.List_FlagDef spec=ListRef,cli.FlagDef]
[@canon.Map_String_String spec=MapRR,String,String]
[@canon.Box_filestat spec=Box,io.filestat]
[@canon.Result_filestat_IoError spec=Result,@Box_filestat,IoError]
[@canon.Result_String_IoError spec=Result,String,IoError]
[@canon.Result_File_IoError spec=Result,File,IoError]
[@canon.Result_null_IoError spec=Result,null,IoError]
[@canon.Result_Listener_IoError spec=Result,net.Listener,IoError]
[@canon.Result_Child_IoError spec=Result,os.Child,IoError]
[@canon.Result_Conn_IoError spec=Result,net.Conn,IoError]
[@canon.ResultVR_u64_IoError spec=ResultVR,u64,IoError]
[@canon.ResultVR_bool_IoError spec=ResultVR,bool,IoError]
[@canon.Result_Parsed_CliError spec=Result,cli.Parsed,cli.CliError]
[@canon.Result_List_String_IoError spec=Result,@List_String,IoError]
[@canon.optionval_u64 spec=optionval,u64]
[@canon.optionval_u32 spec=optionval,u32]
[@canon.optionval_u8 spec=optionval,u8]
[@canon.resultval_i64_parseerror spec=resultval,i64,parseerror]
[@canon.resultval_u64_parseerror spec=resultval,u64,parseerror]
[@canon.resultval_f64_parseerror spec=resultval,f64,parseerror]
[@canon.resultval_f16_parseerror spec=resultval,f16,parseerror]
[@canon.resultval_f128_parseerror spec=resultval,f128,parseerror]


# --- fragment-backed natives ------------------------------------------
# The runtime supplies these as C fragments under natives/. The row names the
# fragment because the naming is NOT one convention: most are
# _Z_<UNIT>_<UPPER_SNAKE(name)>, a File or Parsed method is named after its TYPE
# instead, os.env and cli's parse family are renamed outright, and one demand can
# pull an ordered pair. Composing that at load time meant the emitter had to know
# every exception; here it is data.
#
#   frag=A,B    the fragments this native needs, in the order they must appear
#   demand=X    the (unit, member) demand that reaches this row, when it is not
#               the path's last segment -- File's methods are demanded as
#               `file_close`, cli's Spec.create as `spec_create`
#   demand=X,Y  ANY OF. A helper several members share is ONE row naming the
#               members that reach it, loaded once if any of them fired
#   demand=@unit  the unit ITSELF was demanded. `@` marks a demand outside the
#               member space, as it marks a path outside the declaration space
#   demand=uses_T  written C spells or constructs the unit's type T
#   demand=destroys_T  written C calls the destructor of the unit's type T
#
# A class's NATIVE METHOD is `[<unit>.<Class>.<method> ...]`. Its fragment
# defines the `<Class>_<method>` function, called `(&receiver, args...)` --
# the METHOD ABI, one rule decided by each parameter's type: the receiver by
# pointer; a value view (StringView, a StringLike's `.view`, ByteView, ListView)
# BY VALUE; an owned collection (List, Map, Bytes) by pointer; anything else by
# value. A protocol slot takes the same, so a native method fills a vtable as it
# is. The row is demanded wherever the method is called or read (`f.close`), and
# when its class is live for each method its declared conformances name.
#
# A row that names a TYPE -- a method row, a `.@class` row, a `uses_<Type>`
# demand -- applies only to a type that declares something native, and a method
# row only to a native method: a user unit or type that shares the stdlib's
# name is not the one the row implements, and gets none of it.
#
# A runtime-owned CLASS is `[<unit>.<Class>.@class live=A,B destroy=F]`. Its
# struct is laid out from its declaration as a record's is, written in table
# order ahead of the fragments that dereference it, when the class is live or
# used:
#   live=A,B    the canons whose instances must ALL exist for the class to be
#               LIVE. A live class is used, and the native methods its declared
#               conformances name are demanded: their vtables take those
#               addresses whether or not anything calls them. The gate is
#               order-independent -- true exactly when what the fragments
#               reference exists -- so the C always compiles.
#   destroy=F   the fragment defining the class's `_destroy(<Class>_t* p)`:
#               what a declaration cannot say (an fd closed once, a handle
#               released), written with the struct. A destructor that calls
#               what the unit's own fragments declare is instead a row of the
#               unit's after them (sqlite's Database): the struct's destructor
#               is declared ahead of it either way.
#
# ROW ORDER IS LOAD ORDER within a unit, and the units run in the order the
# directive gives. A unit the directive does not name runs after those it does,
# which is how a unit shipping its own rows gets a slot. `prelude` is not among
# them: emitC emits it into the header, ahead of the literal pool, because a
# need registered inside a type method arrives after the pass has run.
[@units order=sviter,collections,system,io,cli,os,net,tcc,thread,sync]

# @sviter -- the split / lines iterator types. They are StringView natives, but
# they DECLARE types the collections join and the rest of system go on to spell,
# so they load ahead of both and carry a unit of their own. Their six fragments
# interleave: the shared state struct, then each type's typedef of it, then
# split's pair, then lines'.
[@sviter.splitter_struct demand=sv_split,sv_lines frag=_Z_SV_SPLITTER_STRUCT]
[@sviter.splitter demand=sv_split frag=_Z_SV_SPLITTER]
[@sviter.linesiter demand=sv_lines frag=_Z_SV_LINESITER]
[@sviter.split needs=prelude.@xmalloc demand=sv_split frag=_Z_SV_SPLIT,_Z_SV_SPLITTER_CALL]
[@sviter.lines needs=prelude.@xmalloc demand=sv_lines frag=_Z_SV_LINES,_Z_SV_LINES_CALL]

# the collections string join
[collections.stringJoin needs=prelude.@xmalloc frag=_Z_COLL_STRING_JOIN]
[@collections.window needs=prelude.@panic frag=_Z_COLL_WINDOW]

# io -- the shared helpers first, each naming the members that pull it, then the
# convention loads alphabetically, then File's methods in their own order and
# the stream bundles.
[@io.sv_to_cstr needs=prelude.@xmalloc demand=@sv_cstr frag=_Z_IO_SV_TO_CSTR]
[@io.errno_map demand=@errno needs=prelude.zwin32,prelude.@String_new,prelude.@xmalloc,prelude.@win_error_text frag=_Z_IO_ERRNO_MAP]
[@io.write_common needs=prelude.zwin32,prelude.@xmalloc,prelude.@win_open_fd,prelude.@win_write,@errno,@sv_cstr?posix demand=writeText,appendText frag=_Z_IO_WRITE_COMMON]
[@io.wrap_u64_result demand=file_read,file_write,file_seek,@wrap_u64 needs=@errno,prelude.@xmalloc frag=_Z_IO_WRAP_U64_RESULT]
[@io.wrap_null_result needs=prelude.@xmalloc,@errno demand=@wrap_null frag=_Z_IO_WRAP_NULL_RESULT]
[@io.stat_fill needs=prelude.zwin32,prelude.@win_open demand=stat,lstat frag=_Z_IO_STAT_FILL]
[io.appendText frag=_Z_IO_APPEND_TEXT]
[io.eprintln needs=prelude.@write_line frag=_Z_IO_EPRINTLN]
[io.exists needs=prelude.zwin32,prelude.@win_path,@sv_cstr?posix frag=_Z_IO_EXISTS]
[io.listDir needs=prelude.@String_new,prelude.zwin32,prelude.@xmalloc,prelude.@win_path,prelude.@win_utf8,@errno,@sv_cstr?posix frag=_Z_IO_LIST_DIR members=List_String.create,List_String.append]
[io.lstat needs=prelude.@xmalloc,@errno,@sv_cstr?posix frag=_Z_IO_LSTAT]
[io.mkdir needs=prelude.zwin32,prelude.@win_path,@sv_cstr?posix,@wrap_null frag=_Z_IO_MKDIR]
[io.mkdirp needs=prelude.zwin32,prelude.@xmalloc,prelude.@win_path,prelude.@win_root_len,@wrap_null frag=_Z_IO_MKDIRP]
[io.open needs=prelude.zwin32,prelude.@xmalloc,prelude.@win_open_fd,@errno,@sv_cstr?posix frag=_Z_IO_OPEN]
[io.readText needs=prelude.@String_append,prelude.@String_create,prelude.@String_free,prelude.zwin32,prelude.@xmalloc,prelude.@win_open_fd,prelude.@win_read,@errno,@sv_cstr?posix frag=_Z_IO_READ_TEXT]
[io.readlink needs=prelude.@String_new,prelude.zwin32,prelude.@xmalloc,prelude.@xrealloc,prelude.@win_open,prelude.@win_utf8,@errno,@sv_cstr?posix frag=_Z_IO_READLINK]
[io.remove needs=prelude.zwin32,prelude.@win_path,@sv_cstr?posix,@wrap_null frag=_Z_IO_REMOVE]
[io.rename needs=prelude.zwin32,prelude.@win_path,@sv_cstr?posix,@wrap_null frag=_Z_IO_RENAME]
[io.stat needs=prelude.@xmalloc,@errno,@sv_cstr?posix frag=_Z_IO_STAT]
[io.symlink needs=prelude.zwin32,prelude.@xmalloc,io.@wrap_null,prelude.@win_path,prelude.@win_root_len,prelude.@win_wide,@sv_cstr?posix frag=_Z_IO_SYMLINK]
[io.writeText frag=_Z_IO_WRITE_TEXT]
# a File is runtime-owned: its struct is its declaration's, its destructor closes
# the fd once, and it is live -- its Reader/Writer/Closer/Seeker natives demanded
# -- once the byte-buffer monos its read and write take exist
[io.File.@class live=ListVal_u8,ListViewVal_u8 destroy=_Z_FILE_DESTROY]
