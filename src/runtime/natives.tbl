[net.Conn.read needs=@unit,io.@wrap_u64,prelude.@xrealloc,net.@net_error,net.@net_interrupted,net.@net_recv frag=_Z_NET_CONN_READ]
[net.Conn.write needs=@unit,io.@wrap_u64,net.@net_error,net.@net_interrupted,net.@net_send frag=_Z_NET_CONN_WRITE]
