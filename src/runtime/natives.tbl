[system.StringView.endsWith frag=_Z_SV_ENDS_WITH]
[@system.index_of_raw demand=contains,indexOf,lastIndexOf frag=_Z_SV_INDEX_OF_RAW]
[system.StringView.contains frag=_Z_SV_CONTAINS]
[@system.is_ascii_ws demand=trim,trimStart,trimEnd frag=_Z_SV_IS_ASCII_WS]
[system.StringView.substring frag=_Z_SV_SUBSTRING]
[system.StringView.hash frag=_Z_SV_HASH]
[system.StringView.trim frag=_Z_SV_TRIM]
