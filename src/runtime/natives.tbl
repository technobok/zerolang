# -- synthesised structural equality ------------------------------------
# A record or a variant that declares no `==` gets one, and its `!=` with it.
# A record whose typedef chain bottoms out at a scalar compares inline instead
# of through a helper, so it is its own shape.
[@record.==]                    z_@T@_eq(@L@, @R@)
[@record.!=]                    !z_@T@_eq(@L@, @R@)
[@variant.==]                   z_@T@_eq(@L@, @R@)
[@variant.!=]                   !z_@T@_eq(@L@, @R@)
[@scalar.==]                    (@L@ == @R@)
[@scalar.!=]                    (@L@ != @R@)

# --- BEGIN GENERATED CONVERSIONS -- run `zc natives` to regenerate; do not hand-edit.
# Every numeric type converts to every other, 256 pairs. A pair the units declare
# as returning `resultval` builds one and checks; a provably-safe one is a plain
# cast. The bounds are the rule's own output, because a limit written wrong on a
# pair no program happens to use is not something the corpus can catch.

# system.u8 conversions
[system.u8.u8]                 ((uint8_t)@V@)
[system.u8.c8]                 ((uint8_t)@V@)
[system.u8.c32]                ((uint32_t)@V@)
[system.u8.i8]                 ({ uint8_t _v = @V@; z_@RT@_t _r = {0}; if (_v > 127) { _r.tag = @ERRTAG@; _r.data.err.tag = Z_CONVERROR_TAG_OUTOFRANGE; } else { _r.tag = @OKTAG@; _r.data.ok = (int8_t)_v; } _r; })
