[@canon.Result_Statement_SqliteError spec=Result,sqlite.Statement,sqlite.SqliteError]
[@canon.ResultVR_u64_SqliteError spec=ResultVR,u64,sqlite.SqliteError]
[@canon.ResultRV_StringView_columnerror spec=ResultRV,StringView,sqlite.columnerror]
[@canon.ResultRV_ByteView_columnerror spec=ResultRV,ByteView,sqlite.columnerror]
[@canon.ResultRV_Value_columnerror spec=ResultRV,sqlite.Value,sqlite.columnerror]
[@canon.resultval_i64_columnerror spec=resultval,i64,sqlite.columnerror]
[@canon.resultval_f64_columnerror spec=resultval,f64,sqlite.columnerror]
[@canon.resultval_columntype_columnerror spec=resultval,sqlite.columntype,sqlite.columnerror]
[@canon.Result_Transaction_SqliteError spec=Result,sqlite.Transaction,sqlite.SqliteError]
