[system.StringView.<=]         (z_@StringView@_cmp(@L@, @R@) <= 0)
[system.StringView.>]          (z_@StringView@_cmp(@L@, @R@) > 0)
[system.StringView.>=]         (z_@StringView@_cmp(@L@, @R@) >= 0)
[system.StringView.+ needs=concat args=ptr] z_@StringView@_concat(@L@, @R@)

