# what a reached unit needs from the C toolchain. `@unit.<path>` names a unit:
# when a program reaches it -- some declaration in it is demanded, and it
# declares something native, as a user unit that only shares its name does
# not -- `link=`
# adds a library to the link line, `nocc=` refuses the C compiler families that
# cannot build it (comma-separated) and `arch=` any target architecture but the one named, each
# by name and before any C is compiled; `os=` limits the row to builds for the
# operating systems it names (oskind arm names, comma-separated); `cfeature=` names the C feature for the
# refusal. `csrc=` names a C source under the vendor directory that the unit's
# runtime needs compiled and linked, and `cdefs=` the defines it is compiled
# with, comma-separated: the emitted C records both on a `zcsrc:` header line,
# and the driver builds the object into its cache with the compiler that links
# (zc cobj). The facts are this backend's, so they live here rather than in the
# unit.
[@unit.system.quadfloat cfeature=__float128 nocc=tcc,msvc arch=x86_64 link=quadmath]


# -- collections -------------------------------------------------------
# A container's natives are GENERATED: the emitter instantiates one of the
# shared .c.tmpl files per monomorphised container, so every method below comes
# out of one substitution and none has C of its own to name here. The rows say
# that the compiler supplies them -- which is what an absent row has to be able
# to deny.

# collections.array
[collections.array.get]
[collections.array.set]
[collections.array.length]
[collections.array.listView]
[collections.array.slice]
[collections.array.span]
[collections.array.spanSlice]
[collections.array.create]

# collections.str
[collections.str.length]
[collections.str.size]
[collections.str.string]
[collections.str.stringView]
[collections.str.substring]
[collections.str.compare needs=prelude.@StringView_cmp] z_@StringView@_cmp((z_@StringView@_t){ .size = (@V@).len, .data = (const char*)(@V@).data }, (z_@StringView@_t){ .size = (@A1@).len, .data = (const char*)(@A1@).data })
[collections.str.create]

# collections.ListRef
[collections.ListRef.append]
