# natives.tbl -- the implementation of every `is native` declaration, keyed by
# its fully-qualified path. The compiler answers "which implementation" by
# looking the path up here; an absent row is an error, not a fallthrough.
#
# A row is `[<path> attr=value ...] <body>`. The body is C with holes:
#   @T@        the receiver type's C name, minus the leading z_ that a body
#              spells for itself -- so a body writes z_ then the hole
#   @L@ @R@    the emitted operands, filled verbatim
# A hole naming a type must name one the loader can resolve; native-guard
# checks that, and it reads this file whole, comments included.
# Attributes:
#   needs=<n>  the body calls a demand-gated runtime fragment; without this the
#              fragment never reaches the output and the C does not compile
#   args=ptr   the body takes its operands by pointer, so they must be lvalues
#
# Two-segment paths are the SYNTHESISED structural cases -- a record's or a
# variant's `==`/`!=`, which no unit declares -- so they carry no unit and can
# never collide with one.


# system.u8
[system.u8.+]                  (@L@ + @R@)
[system.u8.-]                  (@L@ - @R@)
[system.u8.*]                  (@L@ * @R@)
[system.u8./]                  (@L@ / @R@)
[system.u8.%]                  (@L@ % @R@)
[system.u8.&]                  (@L@ & @R@)
[system.u8.<=]                 (@L@ <= @R@)
[system.u8.<]                  (@L@ < @R@)
[system.u8.>]                  (@L@ > @R@)
[system.u8.>=]                 (@L@ >= @R@)
[system.u8.==]                 (@L@ == @R@)
[system.u8.!=]                 (@L@ != @R@)

