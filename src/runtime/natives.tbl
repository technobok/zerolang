# system.String
[system.String.==]             z_@StringView@_eq(@L@, @R@)
[system.String.!=]             !z_@StringView@_eq(@L@, @R@)
[system.String.<]              (z_@StringView@_cmp(@L@, @R@) < 0)
[system.String.<=]             (z_@StringView@_cmp(@L@, @R@) <= 0)
[system.String.>]              (z_@StringView@_cmp(@L@, @R@) > 0)
[system.String.>=]             (z_@StringView@_cmp(@L@, @R@) >= 0)
[system.String.+ needs=concat args=ptr] z_@StringView@_concat(@L@, @R@)

# system.StringView
[system.StringView.==]         z_@StringView@_eq(@L@, @R@)
[system.StringView.!=]         !z_@StringView@_eq(@L@, @R@)
