# -- synthesised structural equality ------------------------------------
# A record or a variant that declares no `==` gets one, and its `!=` with it.
# A record whose typedef chain bottoms out at a scalar compares inline instead
# of through a helper, so it is its own shape.
[@record.==]                    z_@T@_eq(@L@, @R@)
[@record.!=]                    !z_@T@_eq(@L@, @R@)
[@variant.==]                   z_@T@_eq(@L@, @R@)
[@variant.!=]                   !z_@T@_eq(@L@, @R@)
[@scalar.==]                    (@L@ == @R@)
[@scalar.!=]                    (@L@ != @R@)


# --- fragment-backed natives ------------------------------------------
# The runtime supplies these as C fragments under natives/. The row names the
# fragment because the naming is NOT one convention: most are
# _Z_<UNIT>_<UPPER_SNAKE(name)>, a File or Parsed method is named after its TYPE
# instead, os.env and cli's parse family are renamed outright, and one demand can
# pull an ordered pair. Composing that at load time meant the emitter had to know
# every exception; here it is data.
#
#   frag=A,B    the fragments this native needs, in the order they must appear
#   demand=X    the (unit, member) demand that reaches this row, when it is not
#               the path's last segment -- File's methods are demanded as
#               `file_close`, cli's Spec.create as `spec_create`
#   demand=X,Y  ANY OF. A helper several members share is ONE row naming the
#               members that reach it, loaded once if any of them fired
#   demand=@unit  the unit ITSELF was demanded. `@` marks a demand outside the
#               member space, as it marks a path outside the declaration space
#
# ROW ORDER IS LOAD ORDER within a unit, and the units run in the order the
# directive gives. A unit the directive does not name runs after those it does,
# which is how a unit shipping its own rows gets a slot. `prelude` is not among
# them: emitC emits it into the header, ahead of the literal pool, because a
# need registered inside a type method arrives after the pass has run.
[@units order=sviter,collections,system,io,cli,os,net,tcc]

# @sviter -- the split / lines iterator types. They are StringView natives, but
# they DECLARE types the collections join and the rest of system go on to spell,
# so they load ahead of both and carry a unit of their own. Their five fragments
# interleave: the shared struct, then the lines typedef, then split's pair, then
# lines'.
[@sviter.splitter_struct demand=sv_split,sv_lines frag=_Z_SV_SPLITTER_STRUCT]
[@sviter.linesiter demand=sv_lines frag=_Z_SV_LINESITER]
[@sviter.split demand=sv_split frag=_Z_SV_SPLIT,_Z_SV_SPLITTER_CALL]
[@sviter.lines demand=sv_lines frag=_Z_SV_LINES,_Z_SV_LINES_CALL]

# the collections string join
[collections.stringJoin demand=coll_join frag=_Z_COLL_STRING_JOIN]

# io -- the shared helpers first, each naming the members that pull it, then the
# convention loads alphabetically, then File's methods in their own order and
# the stream bundles.
[@io.sv_to_cstr demand=@unit,@sv_cstr,@errno frag=_Z_IO_SV_TO_CSTR]
[@io.errno_map demand=@unit,@errno frag=_Z_IO_ERRNO_MAP]
[@io.write_common demand=writeText,appendText frag=_Z_IO_WRITE_COMMON]
[@io.wrap_u64_result demand=file_read,file_write,file_seek frag=_Z_IO_WRAP_U64_RESULT]
[@io.wrap_null_result demand=file_close,file_flush,mkdir,mkdirp,remove,rename frag=_Z_IO_WRAP_NULL_RESULT]
[@io.stat_fill demand=stat,lstat frag=_Z_IO_STAT_FILL]
[io.appendText frag=_Z_IO_APPEND_TEXT]
[io.eprintln frag=_Z_IO_EPRINTLN]
[io.exists frag=_Z_IO_EXISTS]
[io.listDir frag=_Z_IO_LIST_DIR]
[io.lstat frag=_Z_IO_LSTAT]
[io.mkdir frag=_Z_IO_MKDIR]
[io.mkdirp frag=_Z_IO_MKDIRP]
[io.open frag=_Z_IO_OPEN]
[io.readText frag=_Z_IO_READ_TEXT]
[io.readlink frag=_Z_IO_READLINK]
[io.remove frag=_Z_IO_REMOVE]
[io.rename frag=_Z_IO_RENAME]
[io.stat frag=_Z_IO_STAT]
[io.symlink frag=_Z_IO_SYMLINK]
[io.writeText frag=_Z_IO_WRITE_TEXT]
[io.File.close demand=file_close frag=_Z_FILE_CLOSE]
[io.File.write demand=file_write frag=_Z_FILE_WRITE]
[io.File.read demand=file_read frag=_Z_FILE_READ]
[io.File.seek demand=file_seek frag=_Z_FILE_SEEK]
[io.File.flush demand=file_flush frag=_Z_FILE_FLUSH]
[io.BufWriter.create demand=uses_BufWriter frag=_Z_BUFWRITER_CREATE]
[io.BufWriter.flush demand=uses_BufWriter frag=_Z_BUFWRITER_FLUSH]
[io.BufWriter.write demand=uses_BufWriter frag=_Z_BUFWRITER_WRITE]
[io.BufReader.create demand=uses_BufReader frag=_Z_BUFREADER_CREATE]
[io.BufReader.read demand=uses_BufReader frag=_Z_BUFREADER_READ]
[io.TextWriter.create demand=uses_TextWriter frag=_Z_TEXTWRITER_CREATE]
[io.TextWriter.write demand=uses_TextWriter frag=_Z_TEXTWRITER_WRITE]
[io.TextWriter.writeLine demand=uses_TextWriter frag=_Z_TEXTWRITER_WRITE_LINE]
[io.TextWriter.flush demand=uses_TextWriter frag=_Z_TEXTWRITER_FLUSH]
[@io.utf8_validate demand=uses_TextReader frag=_Z_IO_UTF8_VALIDATE]
[io.TextReader.create demand=uses_TextReader frag=_Z_TEXTREADER_CREATE]
[io.TextReader.readLine demand=uses_TextReader frag=_Z_TEXTREADER_READ_LINE]
[io.TextReader.call demand=uses_TextReader frag=_Z_TEXTREADER_CALL]

# the statement-special and the three streams: no fragment of their own, so the
# row states only that the compiler supplies them
[io.print]
[io.stdin]
[io.stdout]
[io.stderr]

# cli -- the convention loads, then parse's ordered pair and Parsed's methods
[cli.addFlag frag=_Z_CLI_ADD_FLAG]
[cli.addOption frag=_Z_CLI_ADD_OPTION]
[cli.addPositional frag=_Z_CLI_ADD_POSITIONAL]
[cli.helpText frag=_Z_CLI_HELP_TEXT]
[cli.Spec.create demand=spec_create frag=_Z_CLI_SPEC_CREATE]
[cli.parse frag=_Z_CLI_HELPERS,_Z_CLI_PARSE]
[cli.Parsed.hasFlag frag=_Z_PARSED_HAS_FLAG]
[cli.Parsed.option frag=_Z_PARSED_GET_OPTION]
[cli.Parsed.positional frag=_Z_PARSED_GET_POSITIONAL]

# os -- args (a hand-ordered pair: the argv globals main() fills, then the copy)
# and env come first, then the convention loads
[os.args demand=args frag=_Z_OS_ARGV_GLOBALS,_Z_OS_ARGS]
[os.env frag=_Z_OS_GET_ENV]
[os.buildCommit frag=_Z_OS_BUILD_COMMIT]
[os.buildCompiler frag=_Z_OS_BUILD_COMPILER]
[os.buildDate frag=_Z_OS_BUILD_DATE]
[os.cwd frag=_Z_OS_CWD]
[os.envNames frag=_Z_OS_ENV_NAMES]
[os.exePath frag=_Z_OS_EXE_PATH]
[os.exit frag=_Z_OS_EXIT]
[os.homeDir frag=_Z_OS_HOME_DIR]
[os.hostArchName frag=_Z_OS_HOST_ARCH_NAME]
[os.hostOsName frag=_Z_OS_HOST_OS_NAME]
[os.hostname frag=_Z_OS_HOSTNAME]
[os.kill frag=_Z_OS_KILL]
[os.monotonicMillis frag=_Z_OS_MONOTONIC_MILLIS]
[os.pid frag=_Z_OS_PID]
[os.ppid frag=_Z_OS_PPID]
[os.setCwd frag=_Z_OS_SET_CWD]
[os.setEnv frag=_Z_OS_SET_ENV]
[os.sleepMillis frag=_Z_OS_SLEEP_MILLIS]
[os.spawn frag=_Z_OS_SPAWN]
[os.spawnAsync frag=_Z_OS_SPAWN_ASYNC]
[os.unsetEnv frag=_Z_OS_UNSET_ENV]
[os.userName frag=_Z_OS_USER_NAME]
[os.waitAny frag=_Z_OS_WAIT_ANY]

# net -- all-or-nothing on the unit demand, loading in this order.
# Listener.close and Conn.flush share the Conn close / are no-ops.
[net.listen demand=@unit frag=_Z_NET_LISTEN]
[net.Listener.accept demand=@unit frag=_Z_NET_ACCEPT]
[net.connect demand=@unit frag=_Z_NET_CONNECT]
[net.Conn.read demand=@unit frag=_Z_NET_CONN_READ]
[net.Conn.write demand=@unit frag=_Z_NET_CONN_WRITE]
[net.Conn.close demand=@unit frag=_Z_NET_CONN_CLOSE]
[net.pollReadable demand=@unit frag=_Z_NET_POLL]
[net.Listener.close]
[net.Conn.flush]

# tcc -- the shared helpers, then the convention loads
[@tcc.helpers demand=@unit frag=_Z_TCC_HELPERS]
[tcc.available frag=_Z_TCC_AVAILABLE]
[tcc.compileToExe frag=_Z_TCC_COMPILE_TO_EXE]

# -- String and StringView ---------------------------------------------
# The demand-gated bodies live in _Z_SV_* fragments; everything else is in the
# unconditionally loaded z_String.inc / z_StringView.inc, or is a projection --
# String's startsWith IS StringView's, reached by viewing the receiver, so the
# view owns the fragment and the String row states only that the native exists.
# The comparisons and `+` are operator rows above; these are the rest.

# system.String
[system.String.compare]
[system.String.stringview]
[system.String.substring]
[system.String.length]
[system.String.count]
[system.String.capacity]
[system.String.startsWith]
[system.String.endsWith]
[system.String.contains]
[system.String.append]
[system.String.appendByte]
[system.String.reserve]
[system.String.shrink]
[system.String.copy]
[system.String.hash]
[system.String.create]

# system.StringView -- ROW ORDER IS LOAD ORDER. The three shared helpers sit
# ahead of the members that pull them, each naming those members.
[system.StringView.length]
[system.StringView.string]
[system.StringView.asString]
[system.StringView.compare]
[system.StringView.split]
[system.StringView.lines]
[system.StringView.isEmpty frag=_Z_SV_IS_EMPTY]
