   pins keep alive. Destroying the guard unlocks. */
typedef struct z_@@NAME@@_t {
    z_rwlock_t* l;
    @@P0@@* value;
} z_@@NAME@@_t;

/*@@member destroy needs=prelude.@rwlock_rdunlock@@*/
static void z_@@NAME@@_destroy(z_@@NAME@@_t* g) {
