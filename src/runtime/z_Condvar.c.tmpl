/* Condvar -- where threads wait for a condition (sync.z). The condition
   variable lives on the heap, so it holds still while threads wait on it; a
   MutexGuard's `wait` waits on it with the guard's lock. */
typedef struct z_@@NAME@@_t {
    z_cond_t* c;
} z_@@NAME@@_t;

static z_@@NAME@@_t z_@@NAME@@_create(void) {
    z_@@NAME@@_t cv;
    cv.c = (z_cond_t*)z_xmalloc(sizeof(z_cond_t));
    if (z_cond_init(cv.c) != 0) z_panic("sync.Condvar: the operating system could not make a condition variable");
    return cv;
}

static void z_@@NAME@@_destroy(z_@@NAME@@_t* cv) {
    if (cv->c == NULL) return;
    z_cond_destroy(cv->c);
    free(cv->c);
    cv->c = NULL;
}

static void z_@@NAME@@_notifyOne(const z_@@NAME@@_t* cv) {
    z_cond_signal(cv->c);
}

static void z_@@NAME@@_notifyAll(const z_@@NAME@@_t* cv) {
    z_cond_broadcast(cv->c);
}
