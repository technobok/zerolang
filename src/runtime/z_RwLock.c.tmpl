/*@@needs prelude.@atomic,prelude.@rwlock_t@@*/
/* RwLock and RwLockVal -- a value of @@P0@@ that many threads read at once or
   one writes, through the guards `read` and `write` answer (sync.z), one copy
   per value type; both classes are this template, @@P0@@ their one type. The lock and the value live in a heap block every handle shares, as a
   Mutex's do. A ReadGuard and a WriteGuard are `{z_rwlock_t* l; T* value}`
   (z_ReadGuard.c.tmpl, z_WriteGuard.c.tmpl): `read` and `write` fill one. */
typedef struct z_@@NAME@@_blk {
    z_rwlock_t l;
    Z_ATOMIC(uint64_t) refs;
    @@P0@@ value;
} z_@@NAME@@_blk;

typedef struct z_@@NAME@@_t {
    z_@@NAME@@_blk* b;
} z_@@NAME@@_t;

/*@@member create needs=prelude.@rwlock_init,prelude.@panic,prelude.@xmalloc@@*/
static z_@@NAME@@_t z_@@NAME@@_create(@@P0@@ value) {
    z_@@NAME@@_t rw;
    rw.b = (z_@@NAME@@_blk*)z_xmalloc(sizeof(z_@@NAME@@_blk));
    if (z_rwlock_init(&rw.b->l) != 0) z_panic("sync.RwLock: the operating system could not make a lock");
    atomic_init(&rw.b->refs, 1);
    rw.b->value = value;
    return rw;
}
/*@@end@@*/

/*@@member share needs=prelude.@atomic_add,prelude.@relaxed@@*/
static z_@@NAME@@_t z_@@NAME@@_share(z_@@NAME@@_t* h) {
    Z_ATOMIC_ADD(&h->b->refs, 1, Z_RELAXED);
    z_@@NAME@@_t s;
    s.b = h->b;
    return s;
}
/*@@end@@*/

/*@@member destroy needs=prelude.@acqrel,prelude.@atomic_sub,prelude.@rwlock_destroy@@*/
/* the last handle to end destroys what the block holds and frees it */
static void z_@@NAME@@_destroy(z_@@NAME@@_t* h) {
    if (h->b == NULL) return;
    if (Z_ATOMIC_SUB(&h->b->refs, 1, Z_ACQREL) == 1) {
        @@P0_DESTROY@@(&h->b->value);
        z_rwlock_destroy(&h->b->l);
        free(h->b);
    }
    h->b = NULL;
}
/*@@end@@*/

/*@@member read needs=prelude.@rwlock_rdlock,prelude.@panic@@*/
static z_@@OUT.read@@_t z_@@NAME@@_read(z_@@NAME@@_t* rw) {
    z_@@OUT.read@@_t g;
    if (z_rwlock_rdlock(&rw->b->l) != 0) z_panic("sync.RwLock: read lock failed");
    g.l = &rw->b->l;
    g.value = &rw->b->value;
    return g;
}
/*@@end@@*/

/*@@member write needs=prelude.@rwlock_wrlock,prelude.@panic@@*/
static z_@@OUT.write@@_t z_@@NAME@@_write(z_@@NAME@@_t* rw) {
    z_@@OUT.write@@_t g;
    if (z_rwlock_wrlock(&rw->b->l) != 0) z_panic("sync.RwLock: write lock failed");
    g.l = &rw->b->l;
    g.value = &rw->b->value;
    return g;
}
/*@@end@@*/
