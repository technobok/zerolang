/* getMut hands back a pointer INTO the entry's value, so an update writes the
   entry in place instead of going through `set`. Only the value is reached:
   the key, whose hash places the entry, stays behind the map. One emitted
   function for both value families: what differs is the declared return
   (OptionMut over a reference, OptionMutVal over a value), as IdMap's
   getMut is shared between IdMapR and IdMapV.

   Its own file, for the reason z_IdMapMut.c.tmpl is separate: a mono whose
   `getMut` never resolved must still emit its container, and a template read
   by a seed that cannot fill its holes writes them into the C verbatim. */

static z_@@OPTIONMUT_V@@_t z_@@NAME@@_getMut(z_@@NAME@@_t* _this, @@KEY_ARG_T@@ _key);
static z_@@OPTIONMUT_V@@_t z_@@NAME@@_getMut(z_@@NAME@@_t* _this, @@KEY_ARG_T@@ _key) {
    z_@@OPTIONMUT_V@@_t _r = {0};
    uint64_t h = z_@@NAME@@_hash_key(_key);
    int64_t idx = z_@@NAME@@_find(_this, _key, h, NULL);
    if (idx >= 0) {
        _r.tag = @@OPTIONMUT_V_SOME@@;
        _r.data = &_this->entries[idx].value;
    } else {
        _r.tag = @@OPTIONMUT_V_NONE@@;
        _r.data = NULL;
    }
    return _r;
}
