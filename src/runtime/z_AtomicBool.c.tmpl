/*@@needs prelude.@atomic@@*/
/* AtomicBool -- one flag every thread reads and changes whole (sync.z). The value lives in a heap block every handle
   shares (`share` makes another), so its address holds while any thread can
   reach it; the last handle to end frees it. */
typedef struct z_@@NAME@@_blk {
    Z_ATOMIC(bool) v;
    Z_ATOMIC(uint64_t) refs;
} z_@@NAME@@_blk;

typedef struct z_@@NAME@@_t {
    z_@@NAME@@_blk* b;
} z_@@NAME@@_t;

/*@@member create needs=prelude.@xmalloc@@*/
static z_@@NAME@@_t z_@@NAME@@_create(bool value) {
    z_@@NAME@@_t a;
    a.b = (z_@@NAME@@_blk*)z_xmalloc(sizeof(z_@@NAME@@_blk));
    atomic_init(&a.b->v, value);
    atomic_init(&a.b->refs, 1);
    return a;
}
/*@@end@@*/

/*@@member share needs=prelude.@atomic_add@@*/
static z_@@NAME@@_t z_@@NAME@@_share(z_@@NAME@@_t* a) {
    Z_ATOMIC_ADD(&a->b->refs, 1, Z_RELAXED);
    z_@@NAME@@_t s;
    s.b = a->b;
    return s;
}
/*@@end@@*/

/*@@member destroy needs=prelude.@atomic_sub@@*/
static void z_@@NAME@@_destroy(z_@@NAME@@_t* a) {
    if (a->b == NULL) return;
    if (Z_ATOMIC_SUB(&a->b->refs, 1, Z_ACQREL) == 1) free(a->b);
    a->b = NULL;
}
/*@@end@@*/

/*@@member load needs=prelude.@atomic_load,sync.@load_order@@*/
static bool z_@@NAME@@_load(const z_@@NAME@@_t* a, z_@memoryorder@_t order) {
    return Z_ATOMIC_LOAD(&a->b->v, z_sync_load_order(order));
}
/*@@end@@*/

/*@@member store needs=prelude.@atomic_store,sync.@store_order@@*/
static void z_@@NAME@@_store(z_@@NAME@@_t* a, bool value, z_@memoryorder@_t order) {
    Z_ATOMIC_STORE(&a->b->v, value, z_sync_store_order(order));
}
/*@@end@@*/

/*@@member exchange needs=prelude.@atomic_xchg@@*/
static bool z_@@NAME@@_exchange(z_@@NAME@@_t* a, bool value, z_@memoryorder@_t order) {
    return Z_ATOMIC_XCHG(&a->b->v, value, z_sync_order(order));
}
/*@@end@@*/

/*@@member compareExchange needs=prelude.@atomic_cas,sync.@fail_order@@*/
static bool z_@@NAME@@_compareExchange(z_@@NAME@@_t* a, bool current, bool next, z_@memoryorder@_t order) {
    bool seen = current;
    Z_ATOMIC_CAS(&a->b->v, &seen, next, z_sync_order(order), z_sync_fail_order(order));
    return seen;
}
/*@@end@@*/
