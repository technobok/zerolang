/* AtomicBool -- one flag every thread reads and changes whole (sync.z). The
   value sits in the struct: a thread reaches it through a view of its
   owner's, so its address holds while any thread can. */
typedef struct z_@@NAME@@_t {
    Z_ATOMIC(bool) v;
} z_@@NAME@@_t;

static z_@@NAME@@_t z_@@NAME@@_create(bool value) {
    z_@@NAME@@_t a;
    atomic_init(&a.v, value);
    return a;
}

static void z_@@NAME@@_destroy(z_@@NAME@@_t* a) {
    (void)a;
}

static bool z_@@NAME@@_load(const z_@@NAME@@_t* a, z_@memoryorder@_t order) {
    return Z_ATOMIC_LOAD((Z_ATOMIC(bool)*)&a->v, z_sync_load_order(order));
}

static void z_@@NAME@@_store(const z_@@NAME@@_t* a, bool value, z_@memoryorder@_t order) {
    Z_ATOMIC_STORE((Z_ATOMIC(bool)*)&a->v, value, z_sync_store_order(order));
}

static bool z_@@NAME@@_exchange(const z_@@NAME@@_t* a, bool value, z_@memoryorder@_t order) {
    return Z_ATOMIC_XCHG((Z_ATOMIC(bool)*)&a->v, value, z_sync_order(order));
}

static bool z_@@NAME@@_compareExchange(const z_@@NAME@@_t* a, bool current, bool next, z_@memoryorder@_t order) {
    bool seen = current;
    Z_ATOMIC_CAS((Z_ATOMIC(bool)*)&a->v, &seen, next, z_sync_order(order), z_sync_fail_order(order));
    return seen;
}
