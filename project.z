# project.z -- the zerolang repository is a zerolang project: zc, zl and zls
# started anywhere in it build and check the compiler. `zc build` builds zc
# (to ./zc); the Makefile passes every flag itself, and a flag overrides the
# setting here.

# the compiler's own units
sourceDirs: data { "src" } out stringdata

# the stdlib, in this tree
systemDir: "lib/system"

# the C runtime, in this tree
runtimeDir: "src/runtime"

# the compiler
main: "zc"
