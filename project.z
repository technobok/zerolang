# project.z -- the zerolang repository is a zerolang project: zc, zl and zls
# started anywhere in it build and check the compiler. `zc build` builds its
# four programs (to ./zc, ./zl, ./zls and ./ztestrunner); the Makefile passes
# every flag itself, and a flag overrides the setting here.

# the compiler's own units
sourceDirs: list { "src" }

# the stdlib, in this tree
systemDir: "lib/system"

# the C runtime, in this tree
runtimeDir: "src/runtime"

# the programs: the compiler, the linter and formatter, the language server,
# and the test runner
programs: list { "zc" "zl" "zls" "ztestrunner" }
