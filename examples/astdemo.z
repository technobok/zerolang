# astdemo.z -- exercises the public `tokenize` + `ast` preview API: lex a source
# string into its full token stream, then parse it to a tree whose one unit
# wraps the source.
main: function is {
    src: "add: function {a: i32 b: i32} out i32 is { return a + b }\n".string
    # a token carries its text as an id into a pool the caller owns
    pool: tokenize.StringPool.create
    toks: tokenize.scan source: src.copy :pool
    print "tokens: \{toks.length}"
    tree: ast.parseSource source: src.copy
    if tree.units.length == 1 then print "parsed: unit" else print "parsed: error"
}
