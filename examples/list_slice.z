# list_slice.z -- `slice from: to:` is the list twin of `substring`: a
# half-open [from, to) window over the SAME storage, built as a length and a
# pointer advance. It allocates nothing and copies nothing.
#
# Slicing an owner pins it SHARED, so several slices of one list coexist and
# the list stays readable; a writer is excluded, because `append` may realloc.
# Slicing a slice pins nothing further -- a view is value-passed and carries
# nothing that can dangle.

main: function is {
    nums: ListVal i64
    nums.append from: 10
    nums.append from: 20
    nums.append from: 30
    nums.append from: 40
    nums.append from: 50

    # a window over the middle
    mid: nums.slice from: 1 to: 4
    print "mid.length=\{mid.length}"
    print "mid[0]=\{mid.get i: 0} mid[2]=\{mid.get i: 2}"

    # a narrower window over the same storage
    inner: mid.slice from: 1 to: 3
    print "inner[0]=\{inner.get i: 0} inner[1]=\{inner.get i: 1}"

    # two slices of one list, both live, both readable
    head: nums.slice from: 0 to: 2
    tail: nums.slice from: 3 to: 5
    print "head=\{head.get i: 0},\{head.get i: 1}"
    print "tail=\{tail.get i: 0},\{tail.get i: 1}"

    # the whole-list window is the degenerate slice; `listView` is its shorthand
    whole: nums.slice from: 0 to: nums.length
    print "whole.length=\{whole.length}"
}
