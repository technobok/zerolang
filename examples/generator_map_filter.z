# generator_map_filter.z -- a two-stage generator pipeline.
#
# `IntRange` produces a finite stream of integers; `Doubled`
# transforms each one (the map stage); `GreaterThan` keeps only the
# values above a threshold (the filter stage); `main` drives the
# composed pipeline.
#
# Each stage is a generator with its own construction state that
# builds the next stage inline as the for-loop's iterable. A
# for-loop iterable that is a construction is hoisted to a temp
# before the loop, and that temp crosses the enclosing generator's
# suspensions, so the sub-iterator is promoted to a field of the
# outer one and persists across `.call` invocations.
#
# Pipeline shape:
#   IntRange  --(yields)-->  Doubled  --(yields)-->  GreaterThan
#
# For `lo: 1, hi: 6` the inner IntRange yields 1..5; Doubled emits
# 2/4/6/8/10; GreaterThan(threshold: 5) keeps 6/8/10.
# See doc/spec.pdoc Generator functions / Composability.

IntRange: generator { lo: i64  hi: i64 } as {
    call: function out i64 is {
        i: this.lo
        for i < this.hi loop {
            yield i
            i = i + 1
        }
    }
}

Doubled: generator { lo: i64  hi: i64 } as {
    call: function out i64 is {
        for x: (IntRange lo: this.lo hi: this.hi) loop yield x + x
    }
}

GreaterThan: generator { lo: i64  hi: i64  threshold: i64 } as {
    call: function out i64 is {
        for x: (Doubled lo: this.lo hi: this.hi) loop {
            if x > this.threshold then yield x
        }
    }
}

main: function is {
    for v: (GreaterThan lo: 1 hi: 6 threshold: 5) loop print "v: \{v}"
    print "done"
}
