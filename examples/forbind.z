# forbind.z -- counting loops.
#
# A counted loop walks a range, `for each i: n.times`, and the compiler owns the
# counter: `n.times` for a half-open count, `a.upto to: b` for a closed one.
# There is no C-style header binding -- `for i: 0 while i < n loop { i = i + 1 }`
# is refused: a plain binding is evaluated at every iteration and must answer
# an option, which is what ends the loop, and a counter answers none.
#
# A loop that must control its own step writes the counter as an ordinary local
# and tests it in the header, which is what `stepby` does below.

countup: function {n: i64} out i64 is {
    s: 0
    for each i: n.times loop s = s + i
    return s
}

# an empty walk: a count of zero yields nothing, and the body never runs
noruns: function {n: i64} out i64 is {
    seen: 0
    for each j: 0.times loop seen = seen + n
    return seen
}

# the counter is the author's when the step is not one
stepby: function {n: i64} out i64 is {
    s: 0
    i: 0
    for i < n loop {
        s = s + i
        i = i + 2
    }
    return s
}

main: function is {
    print "\{countup n: 4}"
    print "\{noruns n: 4}"
    print "\{stepby n: 8}"
}
