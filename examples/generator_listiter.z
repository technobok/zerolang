# generator_listiter.z -- container iterator written as a generator.
#
# Same shape as listiter.z's bag-with-iterator demo, but the
# iteration is a generator instead of a hand-rolled BagIter class.
# Observable output matches listiter.z byte-for-byte.
#
# Encapsulation: `public: unit { :count :iterate }` hides the
# private fields a/b/c, and `BagWalk`'s field is
# `Bag.private.borrow` so it can read them. `Bag.iterate` stays as
# the public way in -- a thin factory declared `outx`, which is
# what carries the pin from the generator's borrowed field out to
# the caller's `b`.
#
# A generator is a TYPE, so it is declared at unit level and named
# in PascalCase like every other reftype. It cannot be nested inside
# `Bag`'s `as` block: an inline type definition is refused there,
# for a generator exactly as for a class.

Bag: class { a: i64 b: i64 c: i64 count: i64 } as {
    public: unit { :count :iterate }

    # the public way in: hands back a BagWalk over this bag's
    # privates, pinned for as long as the result lives
    iterate: function {b: this.private.borrow} outx BagWalk is {
        return (BagWalk :b)
    }
}

BagWalk: generator { b: Bag.private.borrow } as {
    call: function out i64 is {
        yield this.b.a
        yield this.b.b
        yield this.b.c
    }
}

main: function is {
    b: Bag a: 10 b: 20 c: 30 count: 3
    print "Bag count: \{b.count}"

    with iter: (Bag.iterate :b) do for x: iter loop print "iter: \{x}"

    print "done"
}
