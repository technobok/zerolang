# static_data.z -- static data: a choice, a data type with a method, a list of
# data values read at compile time and walked at run time, held in a map

# how a native is written in C
nativeform: choice {
    call: null
    value: null
    template: text
}

# one native: its key, its C, how it is written, the units it needs
nativerow: data {
    key: text
    body: ""
    form: nativeform.call
    needs: staticlist text
    live: false
} as {
    hasBody: function {:this} out bool is {
        return this.body.length > 0
    }
}

first: (nativerow key: "system.exit" needs: list {})
natives: list {
    (nativerow
        key: "system.u8.+"
        body: "((uint8_t)(@L@ + @R@))"
        form: nativeform.value
        needs: list {}
    )
    (nativerow key: "system.print" needs: list { write: "io.write" })
    (nativerow key: "system.fmt" form: nativeform.template "fmt(@0@)" needs: list {})
}

words: list { "a" "b" }

main: function is {
    print natives.0.key.stringView
    print natives.1.needs.write.stringView
    for each n: natives loop {
        if n.hasBody then print n.key.stringView
    }
    byKey: MapVV text v: nativerow
    for each n: natives loop byKey.set key: n.key value: n
    if first.form.call then print "call"
    print "\{byKey.length} \{words.length}"
}
