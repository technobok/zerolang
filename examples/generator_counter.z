# generator_counter.z -- the smallest generator there is.
#
# `Counter` has no construction state, so it needs no `is` block at
# all: `generator as { ... }` is a complete definition, and the
# three spellings `generator { } as`, `generator as` and
# `generator is {} as` parse to the same thing.
#
# With no fields to fill, its bare name constructs it -- `for x:
# Counter loop` is the zero-argument construction every type gets,
# and `for x: (Counter) loop` is the same thing written out. Both
# compile to the same C.

Counter: generator as {
    call: function out i64 is {
        yield 1
        yield 2
        yield 3
    }
}

main: function is {
    for x: Counter loop print "x: \{x}"
    print "done"
}
