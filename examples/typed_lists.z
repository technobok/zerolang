# typed_lists.z -- lists whose `out` names their type.
#
# A list has ONE element type, settled where it is written:
#   - `list { ... } out list u8`  the type's argument names it
#   - `list { 1.u8 2 3 }`         the elements' own tags name it, and must agree
#   - `list { ... }`              neither: the elements are untyped, read as
#                                 literals, and the list's value holds them as
#                                 i64s, or f64s when every one is a float
#
# A value the chosen type cannot hold is an error at the declaration, not a
# truncation at each read.
#
# When the list is a constant lookup table of bytes / small ints,
# `out list u8` keeps the C-level array narrow (one byte per slot
# instead of eight) without forcing per-element `.u8` suffixes.

# Typed: every element pinned to u8. The C emitter lays this out
# as `static const uint8_t[]`.
bytemask: list {
    LOW: 0
    MID: 64
    HIGH: 250
} out list u8

# No clause and no tags: the elements are untyped, and as a value the list
# is a `list i64`.

primes: list { 2 3 5 7 11 }

# Tagged elements: `1.u8` types the whole list, so this is `out list u8`
# written the other way round, down to the C array.
masked: list { 1.u8 2 0x07 }

take_u8: function {b: u8} out u8 is { return b + 1 }

main: function is {
    # Named-label access on a typed list: the literal is inlined
    # and arrives at `take_u8` already as u8.
    print "low: \{take_u8 b: bytemask.LOW}"
    print "high: \{take_u8 b: bytemask.HIGH}"

    # No clause and no tags: `primes.0` is an i64.
    print "first prime: \{primes.0}"

    # Tagged list: its elements are u8, so they reach `take_u8` directly.
    print "masked: \{take_u8 b: masked.0}"
}
