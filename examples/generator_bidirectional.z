# generator_bidirectional.z -- a generator that receives values back
# from the caller.
#
# `call`'s parameter list declares the PER-CALL INPUT: at most one,
# and what it declares is the input's type, its ownership, and the
# label its call sites read. Inside the body, `name: yield v` yields
# `v` and binds `name` to whatever the call that RESUMES it supplies
# -- so a first yield written in expression form reads the SECOND
# `.call`'s value, not the first's. The generator yields before it
# can receive, which is why the input is not a binding made on entry.
#
# The for-loop only drives generators that receive nothing; one with
# an input is driven by hand through `with` and `.call`. See
# doc/spec.pdoc Generator functions.

# Emits the first two integers unconditionally, then asks the caller
# whether to emit a third. The caller's decision arrives on the
# second `.call`, and the expression-form yield binds it to `keep`.
Gen: generator { n: i64 } as {
    call: function {decide: bool} out i64 is {
        yield 1
        keep: yield 2
        if keep then yield 99
    }
}

main: function is {
    with g: (Gen n: 0) do {
        a: g.call decide: false
        match a case some then print "got: \{a}" case none then print "(none)"
        b: g.call decide: false
        match b case some then print "got: \{b}" case none then print "(none)"
        c: g.call decide: true
        match c case some then print "got: \{c}" case none then print "(none)"
        d: g.call decide: false
        match d case some then print "got: \{d}" case none then print "(none)"
    }
}
