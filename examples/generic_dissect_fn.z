# generic_dissect_fn.z -- compile-time dissection of a generic FREE FUNCTION's
# type parameter. `match t` selects a code path by the concrete type at each
# monomorphisation; only the matching arm survives in the generated C.
#
# One function per family: a generic declares whether it takes valtypes or
# reftypes, so `describe` dissects the former and `describeRef` the latter.

describe: function as { t: anyval.generic } in { x: t } out StringView is {
    x
    match t case i32 then {
        return "i32"
    } case i64 then {
        return "i64"
    } else {
        return "other"
    }
}

describeRef: function as { t: AnyRef.generic } in { x: t } out StringView is {
    x
    match t case String then {
        return "String"
    } else {
        return "other"
    }
}

main: function is {
    print "a = \{describe x: 42}"
    print "b = \{describe x: 42.i32}"
    print "s = \{describeRef x: "hi".string}"
    print "f = \{describe x: 3.5}"
}
