# ifnarrow.z - Flow narrowing from arm predicates in `if`
#
# A bare arm predicate in an if condition narrows its subject: the then
# branch knows the value holds the arm (bare name IS the payload, like a
# match arm); the else branch and later else-if clauses know it does not
# (the arm is excluded; when one arm remains the subject collapses to
# the payload -- the bare name reads it, exactly as in a match arm; the
# same collapse applies to a match else over one remaining arm). Negated
# forms `x.a.not`, `x.a.false` and `(x.a) == false` flip the two sides.
# Every bare conjunct of a `when` chain narrows in its then branch, and in
# the conjuncts after it -- a chain short-circuits, so a later conjunct is
# reached only where every earlier one held.

maybe: variant {
    none: null
    some: i64
}

trio: variant {
    a: null
    b: null
    c: i64
}

Pack: union {
    label: String
    nothing: null
}

mk: function {v: i64} out maybe is {
    if v > 0 then return (maybe.some v)
    return maybe.none
}

pick: function {k: i64} out trio is {
    if k == 0 then return trio.a
    if k == 1 then return trio.b
    return (trio.c k)
}

mkp: function out Pack is {
    return (Pack.label "boxed".string)
}

main: function is {
    o: mk v: 5
    if o.some then {
        print "payload \{o}"
    } else {
        print "no payload"
    }
    e: mk v: 0
    if e.some then print "unexpected" else print "e is none"
    n2: mk v: 7
    if n2.some.not then print "n2 none" else print "negated else: \{n2}"
    n3: mk v: 3
    if n3.none.false then {
        print "n3 some via .false: \{n3}"
    } else null
    t: pick k: 2
    if t.a then {
        print "t is a"
    } else if t.b then {
        print "t is b"
    } else {
        print "t is c: \{t}"
    }
    u: mk v: 4
    w: mk v: 9
    if u.some when w.some then {
        print "both: \{u} \{w}"
    } else null
    p: mkp
    if p.label then {
        print "p: \{p}"
    } else null
    q: mk v: 8
    if q.some.true then print "true-then: \{q}"
    # a conjunct narrows the conjuncts AFTER it, not only the body: `when`
    # short-circuits, so a later conjunct runs only where the earlier one held
    # and reads the payload it narrowed. This is the nested form written flat.
    c1: mk v: 5
    if c1.some when c1 > 3 then print "conjunct narrows conjunct: \{c1}"
    c2: mk v: 7
    if c2.none.not when c2 > 3 then print "negated first conjunct: \{c2}"
    c3: mk v: 9
    if c3.some when c3 > 3 when c3 < 100 then print "three conjuncts: \{c3}"
    c4: mk v: 2
    if c4.some when c4 > 40 then print "unreachable" else print "second conjunct false"
    # two exclusions leaving ONE arm collapse the subject to that arm's
    # payload, in either spelling: the conjunct chain and the nested `if`.
    x1: pick k: 2
    if x1.a.not when x1.b.not then print "chain exclusion collapse: \{x1}"
    x2: pick k: 2
    if x2.a.not then {
        if x2.b.not then print "nested exclusion collapse: \{x2}"
    }
    m: mk v: 12
    match (
        m
    ) case none then {
        print "m none"
    } else {
        print "match-else: \{m}"
    }
}
