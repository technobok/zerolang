# narrow_widths.z -- a sub-int operator result is its DECLARED type, wherever it
# is consumed. `255.u8 + 1.u8` is a u8, so it is 0: bound to a local, passed as
# an argument, compared, nested in another operator, or converted. C promotes
# both operands to `int` before adding, so the natives.tbl fragment narrows the
# result back -- without that cast the same expression was 0 when bound and 256
# inline, and a comparison against it took the wrong branch.
#
# Every operand here is a VARIABLE: two constants fold at compile time, and the
# evaluator works in i64 with no target type, which is a separate question.

takesU8: function {v: u8} out u8 is {
    return v
}

main: function is {
    one: 1.u8
    zero: u8
    u8m: 255.u8
    u8b: u8m + one
    print "u8   bound=\{u8b} inline=\{u8m + one}"
    u16m: 65535.u16
    u16o: 1.u16
    u16b: u16m + u16o
    print "u16  bound=\{u16b} inline=\{u16m + u16o}"
    i8m: 127.i8
    i8o: 1.i8
    i8b: i8m + i8o
    print "i8   bound=\{i8b} inline=\{i8m + i8o}"
    i16m: 32767.i16
    i16o: 1.i16
    i16b: i16m + i16o
    print "i16  bound=\{i16b} inline=\{i16m + i16o}"
    print "arg=\{takesU8 v: u8m + one}"
    if (u8m + one) == zero then {
        print "compare=wraps"
    } else print "compare=BROKEN"
    print "nested=\{(u8m + one) + zero}"
    print "convert=\{(u8m + one).u64}"
    big: 200.u8
    two: 2.u8
    print "mul=\{big * two}"
    print "sub=\{zero - one}"
    # FOLDED constants narrow too: the evaluator works in i64 and a cval carries
    # no type, so an inline use has no assignment to truncate it
    print "fold-mul=\{200.u8 * 2.u8}"
    print "fold-add=\{255.u8 + 1.u8}"
    print "fold-i8=\{127.i8 + 1.i8}"
}
