# generic_dissect.z -- compile-time dissection of a generic type parameter.
# `match t` selects a code path by the parameter's concrete type at
# monomorphisation; only the matching arm survives in the generated C (the
# zerolang analogue of #ifdef). An `else` handles the unmatched types.
#
# A generic names the FAMILY it takes, so dissection happens within one:
# `Holder` dissects valtypes and `RefHolder` reftypes. The two are separate
# templates because a valtype and a reftype are stored, copied and owned
# differently -- which is the whole point of the split.

Holder: class {
    val: t
    describe: function {:this} out StringView is {
        match (
            t
        ) case i32 then {
            return "i32"
        } case i64 then {
            return "i64"
        } else {
            return "other"
        }
    }
} as { t: anyval.generic }

RefHolder: class {
    val: T
    describe: function {:this} out StringView is {
        match (
            T
        ) case String then {
            return "String"
        } else {
            return "other"
        }
    }
} as { T: AnyRef.generic }

main: function is {
    a: Holder val: 42
    print "a = \{a.describe}"
    b: Holder val: 42.i32
    print "b = \{b.describe}"
    s: RefHolder val: "hi".string
    print "s = \{s.describe}"
    f: Holder val: 3.5
    print "f = \{f.describe}"
}
