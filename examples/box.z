# box.z - Box type demonstration
# Box heap-allocates one VALTYPE and gives it pointer-based semantics, so a
# large record travels as an 8-byte pointer instead of by copy. It is also
# how a union spells a valtype arm.
#
# A reftype needs no box: a class instance is already a heap pointer, so a box
# around one is a pointer to a pointer.

pt: record {
    x: i64
    y: i64
}

main: function is {
    # --- Box an integer (valtype) ---
    # heap-allocates the integer; b is int64_t*
    b: Box from: 42
    r: b + 8
    print "boxed 42 + 8 = \{r}"

    # comparison works transparently
    if b == 42 then print "b is 42"

    # --- Box a record: the case boxing is actually for ---
    p: Box from: (pt x: 1 y: 2)
    p

    # --- Box with from: syntax ---
    b2: Box from: 100
    r2: b2 * 2
    print "boxed 100 * 2 = \{r2}"

    print "done"
}
