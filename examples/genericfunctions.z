# Generic functions: inference, explicit args, defaults

# Generic identity function
identity: function as { t: anyval.generic } in {val: t} out t is {
    return val
}

# Multi-param generic: returns the first argument
first: function as { a: anyval.generic b: anyval.generic } in {x: a y: b} out a is {
    y.drop
    return x
}

# Generic with valtype constraint
id_val: function as { t: anyval.generic } in {val: t} out t is {
    return val
}

main: function is {
    # Inference from argument types
    x: identity 42
    x.drop
    y: identity 3.14
    y.drop

    # Explicit generic args (inline with value args)
    z: identity t: i64 val: 99
    z.drop

    # Multi-param inference
    r: first 42 y: 3.14
    r.drop

    # Valtype constraint
    w: id_val 100
    w.drop

    print "ok"
}
