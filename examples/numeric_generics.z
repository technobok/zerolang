# numeric_generics.z -- Numeric generic parameters

# Record with both type and numeric generic params
sized: record {
    val: t
} as {
    t: anyval.generic
    size: u64.generic
}

# Record with only a numeric generic param: no field, the type fixes cap
fixedcap: record {
    used: u32
} as {
    cap: u32.generic
}

main: function is {
    # explicit type and numeric args
    a: (sized t: i64 size: 10) val: 42
    print "\{a.val}"
    print "\{(sized t: i64 size: 10).size}"

    # different size creates different type
    b: (sized t: i64 size: 20) val: 99
    print "\{b.val}"
    print "\{(sized t: i64 size: 20).size}"

    # cap is read through the type, whose one value it is: a value reaches
    # only its type's fields and methods
    c: (fixedcap cap: 100) used: 0
    print "\{(fixedcap cap: 100).cap}"
    print "\{c.used}"

    print "ok"
}
