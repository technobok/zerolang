# range_forms.z -- the forms of an integer range in a `for` header.
#
# There are three, and each says its own convention in its name. `each` is the
# COUNT form: `N.each` walks [0, N), half-open, because a count is what it
# takes. `upto` and `downto` are the ENDPOINT forms, `[this, to]` and
# `[to, this]`, fully closed, because an endpoint is what they take.
#
# All three hand back an ordinary iterator, so a header drives one and a
# binding does too -- and the header LOWERS to a counted C loop, building no
# object at all. Integers themselves are deliberately not iterable: there is no
# bare `for x: N loop`, and no `.iterate` on a scalar.

main: function is {
    print "each:"
    for b: 5.each loop print "  \{b}"
    print "upto:"
    for c: (2.upto to: 4) loop print "  \{c}"
    print "downto:"
    for d: (2.downto to: 0) loop print "  \{d}"
    # `each` is a count, so it has no `from:`; a value form binds the range
    print "each bound:"
    r: 3.each
    for e: r loop print "  \{e}"
    lim: 3.i64
    print "variable receiver:"
    for f: lim.each loop print "  \{f}"
    # a count at or below zero walks nothing, on a literal and on a variable
    print "non-positive:"
    neg: (0 - 2).i64
    for n1: (0 - 4).each loop print "  never \{n1}"
    for n2: neg.each loop print "  never \{n2}"
    for n3: 0.each loop print "  never \{n3}"
    print "  (none)"
    # the element is the RECEIVER's type, so a narrower receiver indexes narrower
    print "unsigned widths:"
    for u: 3.u8.each loop print "  \{u}"
    # an owned temp built inside a counted loop is freed per ITERATION, not once
    # after it -- the free named a temp that had already left C scope
    buf: String
    for i: 3.each loop buf.append " \{i}"
    print "hoisted arg:\{buf}"
}
