# range_forms.z -- the two spellings of an integer range in a `for` header.
# `each` is a synonym of `iterate`, and both must reach the counted-loop path:
# the step emitter accepted either by interned id while the bound reader
# compared the spelling "iterate" alone, so `for x: N.each loop` fell through to
# the iterator protocol, never advanced, and printed the receiver forever.

main: function is {
    print "iterate:"
    for a: 5.iterate loop print "  \{a}"
    print "each:"
    for b: 5.each loop print "  \{b}"
    print "iterate from:"
    for c: (5.iterate from: 2) loop print "  \{c}"
    print "each from:"
    for d: (5.each from: 3) loop print "  \{d}"
    lim: 3.i64
    print "variable receiver:"
    for e: lim.each loop print "  \{e}"
}
