# range_forms.z -- the forms of an integer range in a `for` header.
#
# `each` is the COUNT form: `N.each` walks [0, N) and hands back an ordinary
# iterator, so a header drives it and a binding does too. `iterate` is the
# older stepper, which takes a `from:` and is not an iterator at all.
#
# Both must reach the counted-loop path: the step emitter accepted either by
# interned id while the bound reader compared the spelling "iterate" alone, so
# `for x: N.each loop` fell through to the iterator protocol, never advanced,
# and printed the receiver forever.

main: function is {
    print "iterate:"
    for a: 5.iterate loop print "  \{a}"
    print "each:"
    for b: 5.each loop print "  \{b}"
    print "iterate from:"
    for c: (5.iterate from: 2) loop print "  \{c}"
    # `each` is a count, so it has no `from:`; a value form binds the range
    print "each bound:"
    r: 3.each
    for d: r loop print "  \{d}"
    lim: 3.i64
    print "variable receiver:"
    for e: lim.each loop print "  \{e}"
    # a count at or below zero walks nothing, on a literal and on a variable
    print "non-positive:"
    neg: (0 - 2).i64
    for n1: (0 - 4).each loop print "  never \{n1}"
    for n2: neg.each loop print "  never \{n2}"
    for n3: 0.each loop print "  never \{n3}"
    print "  (none)"
    # the element is the RECEIVER's type, so a narrower receiver indexes narrower
    print "unsigned widths:"
    for u: 3.u8.each loop print "  \{u}"
    # the LEAN form: `for x: N loop` is sugar for `for x: N.iterate loop`
    print "lean literal:"
    for f: 3 loop print "  \{f}"
    print "lean suffixed:"
    for g: 3.u8 loop print "  \{g}"
    print "lean variable:"
    for h: lim loop print "  \{h}"
    # an owned temp built inside a counted loop is freed per ITERATION, not once
    # after it -- the free named a temp that had already left C scope
    buf: String
    for i: 3 loop buf.append " \{i}"
    print "hoisted arg:\{buf}"
}
