# generator_intrange.z -- a generator with construction state.
#
# `IntRange` yields i64 values from `lo` (inclusive) up to `hi`
# (exclusive). `lo` and `hi` are its `is` fields -- the state it is
# built with -- and `call` reads them through `this`. The loop
# counter `i` is an ordinary local that happens to live across a
# suspension, so the compiler promotes it to a field and drives it
# from the state machine; nothing about it is written here.
#
# Demonstrates: a generator with fields and a yielding loop. See
# doc/spec.pdoc Generator functions.

IntRange: generator { lo: i64  hi: i64 } as {
    call: function out i64 is {
        i: this.lo
        for i < this.hi loop {
            yield i
            i = i + 1
        }
    }
}

main: function is {
    for x: (IntRange lo: 10 hi: 13) loop print "x: \{x}"
    print "done"
}
