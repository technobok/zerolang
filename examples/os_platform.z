# os_platform.z -- host descriptor primitives.
#
# `platform.os` and `platform.arch` are COMPILE-TIME CONSTANTS: the compiler
# knows the build it is performing, so the branch below is chosen while
# compiling and only the taken arm reaches the C. `hostname` is a real
# syscall, so it is result-wrapped.

main: function is {
    p: platform.os
    match (
        p
    ) case linux then {
        print "platform=linux"
    } case darwin then {
        print "platform=darwin"
    } case windows then {
        print "platform=windows"
    } case other then {
        print "platform=other"
    }

    a: platform.arch
    match (
        a
    ) case x86_64 then {
        print "arch=x86_64"
    } case aarch64 then {
        print "arch=aarch64"
    } case other then {
        print "arch=other"
    }

    hn: os.hostname
    match (
        hn
    ) case ok then {
        has: hn.length > 0
        print "hostname nonempty=\{has}"
    } case err then {
        print "hostname err"
    }
}
