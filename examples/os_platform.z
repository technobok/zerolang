# os_platform.z -- host descriptor primitives.
#
# `z.build.os` and `z.build.arch` are COMPILE-TIME CONSTANTS: the compiler
# writes the target it is building for into the generated `z` unit, so each
# match below reads a value that is already decided. `hostname` is a real syscall,
# so it is result-wrapped.

main: function is {
    p: z.build.os
    match (
        p
    ) case linux then {
        print "os=linux"
    } case darwin then {
        print "os=darwin"
    } case windows then {
        print "os=windows"
    } case other then {
        print "os=other"
    }

    a: z.build.arch
    match (
        a
    ) case x86_64 then {
        print "arch=x86_64"
    } case aarch64 then {
        print "arch=aarch64"
    } case other then {
        print "arch=other"
    }

    hn: os.hostname
    match (
        hn
    ) case ok then {
        has: hn.length > 0
        print "hostname nonempty=\{has}"
    } case err then {
        print "hostname err"
    }
}
