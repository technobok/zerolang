# os_platform.z -- host descriptor primitives.
#
# `platform.os`, `platform.arch` and `platform.ccmode` are COMPILE-TIME
# CONSTANTS: the compiler knows the build it is performing, so each match
# below reads a value that is already decided. `hostname` is a real syscall,
# so it is result-wrapped.

main: function is {
    p: platform.os
    match (
        p
    ) case linux then {
        print "platform=linux"
    } case darwin then {
        print "platform=darwin"
    } case windows then {
        print "platform=windows"
    } case other then {
        print "platform=other"
    }

    a: platform.arch
    match (
        a
    ) case x86_64 then {
        print "arch=x86_64"
    } case aarch64 then {
        print "arch=aarch64"
    } case other then {
        print "arch=other"
    }

    # how zc reaches the C compiler, not which one it is -- the two are
    # separate axes, so `platform.cc` stays meaningful in either mode.
    m: platform.ccmode
    match (
        m
    ) case spawn then {
        print "ccmode=spawn"
    } case inproc then {
        print "ccmode=inproc"
    }

    hn: os.hostname
    match (
        hn
    ) case ok then {
        has: hn.length > 0
        print "hostname nonempty=\{has}"
    } case err then {
        print "hostname err"
    }
}
