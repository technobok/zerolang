# listiter.z -- Iterator over a container using a class with a friend-view field
#
# Demonstrates:
# - Container class with public/private access control
# - Class-based iterator holding a non-owned field (classes may hold locks)
# - A .private.view field: a readonly friend reference to the container's
#   private fields, which is all an iterator needs
# - Callable iterator (for-loop integration via optionval)
# - The container is locked for the lifetime of the iterator

# Container with private internals
Bag: class { a: i64 b: i64 c: i64 count: i64 } as {
    public: unit { :count :iterate }

    # Factory: borrows the container and returns an iterator. `outx` keeps
    # the container locked for the iterator's lifetime; a plain `out` would
    # be refused, since BagIter holds a reference into it.
    iterate: function {b: this.borrow} outx BagIter is {
        return (BagIter target: b.private)
    }
}

# Class iterator with a non-owned field. Classes are single-owner
# (can be moved via .take but not copied), providing the safety
# guarantees that born-borrowed records used to enforce.
BagIter: class {
    pos: i64
    max: i64
    target: Bag.private.view
} as {
    create: function {target: Bag.private.view} outx this is {
        return (meta.create pos: 0 max: 3 :target)
    }

    call: function {it: this} out (optionval t: i64) is {
        if it.pos < it.max then {
            if it.pos == 0 then {
                it.pos = it.pos + 1
                return (optionval.some it.target.a)
            }
            if it.pos == 1 then {
                it.pos = it.pos + 1
                return (optionval.some it.target.b)
            }
            it.pos = it.pos + 1
            return (optionval.some it.target.c)
        }
        return (optionval.none i64)
    }
}

main: function is {
    b: Bag a: 10 b: 20 c: 30 count: 3
    print "Bag count: \{b.count}"

    # `with` scopes the iterator; the bag is locked until the
    # iterator falls out of scope at the end of the for body.
    with iter: (Bag.iterate :b) do for x: iter loop print "iter: \{x}"

    print "done"
}
