# windows -- the record of the last green `make ci-windows`, and whether
# another run is due:
#   windows-due FILE DAYS TOUCHED PATH...
#                        one line when ci-windows is due again: its last green
#                        run (FILE) is DAYS days old, or TOUCHED days old with
#                        a commit since then touching one of PATH; nothing
#                        when it is not due. Answers 0 either way.
#   windows-record FILE  FILE written for HEAD, now: what a green ci-windows
#                        leaves, for windows-due to read
# FILE is a data file (tests/known/windows.zd) read and written through the
# standard library's zd unit: `commit`, `time` (unix seconds) and `date`. The
# time comes from `date`, the commits from git. A subunit of zgate.

# verifiedHead -- the comment block a record starts with
verifiedHead: "# windows -- the last green `make ci-windows`: the commit it ran at, and when\n# (unix seconds, and the date). Written by ci-windows (zgate windows-record);\n# read by windows-due."

# runWindowsDue -- the windows-due subcommand from its command line `p`
runWindowsDue: function {g: Gate.view p: cli.Parsed.view} out i32 is {
    file: path.join a: g.repo.stringView b: (operand :p name: "FILE").stringView
    days: (operand :p name: "DAYS").stringView.parseI64.or d: -1
    touchedDays: (operand :p name: "TOUCHED").stringView.parseI64.or d: -1
    if (days < 0) or (touchedDays < 0) then {
        io.eprintln "zgate windows-due: DAYS and TOUCHED are numbers of days"
        return wrongUsage
    }
    if (io.exists path: file).not then {
        print "windows-due: make ci-windows has never passed (tools/windows/README.md)"
        return 0
    }
    rd: zd.read path: file.stringView
    match (
        rd
    ) case err then {
        print "windows-due: \{rd.stringView} -- run make ci-windows (tools/windows/README.md)"
        return 0
    } case ok then null
    pr: recordProblem e: rd
    if pr.length > 0 then {
        print "windows-due: \{pr} -- run make ci-windows (tools/windows/README.md)"
        return 0
    }
    sha: (rd.textAt path: "commit").orPanic.copy
    at: (rd.integerAt path: "time").orPanic
    day: (rd.textAt path: "date").orPanic.copy
    now: (dateText :g format: "+%s").stringView.parseI64.or d: -1
    if (at < 0) or (now < 0) then {
        io.eprintln "zgate windows-due: no time to judge by (the record's, or date's)"
        return 1
    }
    age: now - at / 86400
    short: sha.stringView.substring from: 0 to: 8
    if age >= days then {
        print "windows-due: make ci-windows last passed \{age} days ago (\{day}, \{short}) -- run it (tools/windows/README.md)"
        return 0
    }
    touched: commitsTouching :g sha: sha.stringView paths: p.extraArgs
    if age >= touchedDays when touched > 0 then {
        print "windows-due: \{touched} commit(s) touching Windows-relevant sources since make ci-windows last passed (\{day}, \{short}) -- run it (tools/windows/README.md)"
    }
    return 0
}

# runWindowsRecord -- the windows-record subcommand from its command line `p`
runWindowsRecord: function {g: Gate.view p: cli.Parsed.view} out i32 is {
    file: path.join a: g.repo.stringView b: (operand :p name: "FILE").stringView
    sha: fullSha :g rev: "HEAD"
    now: dateText :g format: "+%s"
    day: dateText :g format: "+%F"
    if (sha.length == 0) or (now.length == 0) or (day.length == 0) then {
        io.eprintln "zgate windows-record: no commit or no time to record"
        return 1
    }
    defs: List zd.Entry
    defs.append (zd.entry name: "commit" type: "" node: zd.Node.text sha.take)
    defs.append (
        zd.entry
        name: "time"
        type: ""
        node: zd.Node.integer (now.stringView.parseI64.or d: 0)
    )
    defs.append (zd.entry name: "date" type: "" node: zd.Node.text day.take)
    doc: zd.entry name: "windows" type: "" node: zd.Node.unitValue defs.take
    w: zd.write path: file.stringView header: verifiedHead schema: "" :doc
    if w.err then {
        io.eprintln "zgate windows-record: \{w.stringView}"
        return 1
    }
    return 0
}

# recordProblem -- what is wrong with the record `e`: zd's report of the first
# of `commit`, `time` and `date` it lacks or holds as another kind; "" when it
# holds all three
recordProblem: function {e: zd.Entry.view} out String is {
    c: e.textAt path: "commit"
    if c.err then return c.stringView.string
    t: e.integerAt path: "time"
    if t.err then return t.stringView.string
    d: e.textAt path: "date"
    if d.err then return d.stringView.string
    return "".string
}

# dateText -- what `date` prints for `format`, its line break trimmed; empty
# when it cannot be run
dateText: function {g: Gate.view format: StringView} out String is {
    a: List String
    a.append from: "date".string
    a.append from: format.string
    c: captured :g argv: a cwd: "" tag: "date"
    if c.status != 0 then return String
    return c.text.stringView.trim.string
}

# commitsTouching -- the commits after `sha` up to HEAD that change one of
# `paths`; 0 when git cannot answer
commitsTouching: function {g: Gate.view sha: StringView paths: (List String).view} out u64 is {
    a: gitArgv repo: g.repo.stringView words: "log --oneline"
    a.append from: "\{sha}..HEAD"
    a.append from: "--".string
    for each pth: paths loop a.append from: pth.copy
    c: captured :g argv: a cwd: "" tag: "touched"
    if c.status != 0 then return 0
    n: u64
    for each ln: c.text.stringView.lines loop {
        if ln.trim.length > 0 then n = n + 1
    }
    return n
}
