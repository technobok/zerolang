# absplit -- `zgate ab OLDZC NEWZC OLDTREE [NEWTREE] [--fx FILE]`: the
# allocation split of a self-compile (`zc zc --src src --system lib/system
# --emit-c /dev/null` under valgrind memcheck, the perf-strict measurement),
# then both compilers' instructions. OLDTREE and NEWTREE hold src/ and
# lib/system/; NEWTREE is the repository when it is not given. It prints each
# of the four counts and the split:
#   behaviour = new compiler - old compiler, on the old source
#   source    = new source - old source, compiled by the new compiler
# A run that does not compile reads FAIL, with zc's first error: a compiler
# that refuses its input still exits through the allocator, and its small
# count would read as a real row. The four runs go in parallel. Both compilers
# are copied to paths of one length first, and each run compiles its own copy
# of its tree at a path of one length and depth: the compiler locates itself
# from its own path, and finds its project by walking up from the working
# directory, and each costs allocations by its length. A subunit of zgate.

# runAbCommand -- the ab subcommand from its command line `p`
runAbCommand: function {g: Gate.view p: cli.Parsed.view} out i32 is {
    newTree: operand :p name: "NEWTREE"
    if newTree.length == 0 then newTree = g.repo.copy
    fx: optionText :p name: opt.fx d: ""
    if fx.length > 0 then fx = absolute p: fx.stringView
    return (
        abSplit
        :g
        oldZc: (absolute p: (operand :p name: "OLDZC").stringView).stringView
        newZc: (absolute p: (operand :p name: "NEWZC").stringView).stringView
        oldTree: (absolute p: (operand :p name: "OLDTREE").stringView).stringView
        newTree: (absolute p: newTree.stringView).stringView
        fx: fx.stringView
        lines: List String
    )
}

# abSplit -- the four self-compiles and the split, then the instructions
# (instructionLines) on the self-compile and on the program `fx` when it is
# not empty; each printed line is also added to `lines`, for a gate's log.
# Answers 0, or 1 when a run failed.
abSplit: function {
    g: Gate.view
    oldZc: StringView
    newZc: StringView
    oldTree: StringView
    newTree: StringView
    fx: StringView
    lines: List String
} out i32 is {
    tmp: "\{g.home}/ab/\{os.pid}"
    io.removeTree path: tmp.stringView
    io.mkdirp path: "\{tmp}/o"
    io.mkdirp path: "\{tmp}/n"
    copyTo from: oldZc to: "\{tmp}/o/zc".stringView
    copyTo from: newZc to: "\{tmp}/n/zc".stringView
    say :lines text: "old zc: \{(versionOf :g zc: "\{tmp}/o/zc".stringView).stringView}".stringView
    say :lines text: "new zc: \{(versionOf :g zc: "\{tmp}/n/zc".stringView).stringView}".stringView
    jobs: List PoolJob
    for each run: runNames loop {
        tree: oldTree
        if run.endsWith "n" then tree = newTree
        stageTree from: tree to: "\{tmp}/w/\{run}".stringView
        side: "o"
        if run.startsWith "n" then side = "n"
        steps: List PoolStep
        steps.append (
            zjobs.mkStep
            argv: (
                perf.selfCompile
                before: "valgrind --tool=memcheck"
                zc: "\{tmp}/\{side}/zc".stringView
            )
            cwd: "\{tmp}/w/\{run}".stringView
            outPath: os.nullDevice.stringView
            errPath: "\{tmp}/\{run}.log".stringView
            timeoutSecs: 0
            allowFail: true
            zlinkFrom: ""
        )
        jobs.append (zjobs.mkJob name: run :steps)
    }
    statuses: ListVal i32
    failSteps: ListVal i64
    zjobs.runJobs :jobs maxJobs: 4 :statuses :failSteps
    counts: ListVal i64
    whys: List String
    k: u64
    for k < runNames.length loop {
        log: zjobs.slurp path: "\{tmp}/\{runNames.get i: k}.log".stringView
        n: (perf.heapUsageOf text: log.stringView).allocs
        if (statuses.get i: k) != 0 then n = -1
        counts.append n
        whys.append (firstError text: log.stringView status: (statuses.get i: k))
        k = k + 1
    }
    k = 0
    for k < runNames.length loop {
        say :lines text: "\{runLabels.get i: k}: \{countText n: (counts.get i: k)}".stringView
        k = k + 1
    }
    ok: true
    oo: counts.get i: 0
    no: counts.get i: 2
    nn: counts.get i: 3
    if (oo >= 0) and (no >= 0) then {
        say :lines text: "behaviour (new-old zc, old src): \{no - oo}".stringView
    } else {
        (
            say
            :lines
            text: "behaviour (new-old zc, old src): FAIL\{(
                failWhy
                :whys
                :counts
                a: 0
                b: 2
            )}".stringView
        )
        ok = false
    }
    if (no >= 0) and (nn >= 0) then {
        say :lines text: "source (new-old src, new zc):    \{nn - no}".stringView
    } else {
        (
            say
            :lines
            text: "source (new-old src, new zc):    FAIL\{(
                failWhy
                :whys
                :counts
                a: 2
                b: 3
            )}".stringView
        )
        ok = false
    }
    instructionLines :g :lines tmp: tmp.stringView :fx
    io.removeTree path: tmp.stringView
    if ok then return 0
    return 1
}

# instructionLines -- each compiler's user-space instructions, perf stat's
# mean of three runs, one run at a time: on the self-compile, each compiler on
# its own source (the trees of runs oo and nn), and on the program `fx` when
# it is not empty. The self-compile's change is the behaviour and the source
# together; a fixed program separates them (perf/log.md, Fixed input). No
# tree holds a project.zd: a run inside a project reads it on every compile.
# An emit finds its project from the program's directory, so `fx` runs where
# zgate does.
instructionLines: function {g: Gate.view lines: List String tmp: StringView fx: StringView} is {
    if (perf.hasTool :g argv: (wordsOf text: "perf stat -e instructions:u true")).not then {
        say :lines text: "instructions: perf stat cannot count them here"
        return
    }
    (
        sayInstructions
        :g
        :lines
        what: "self-compile"
        old: (perf.selfCompile before: "" zc: "\{tmp}/o/zc".stringView)
        new: (perf.selfCompile before: "" zc: "\{tmp}/n/zc".stringView)
        oldCwd: "\{tmp}/w/oo".stringView
        newCwd: "\{tmp}/w/nn".stringView
    )
    if fx.length == 0 then return
    (
        sayInstructions
        :g
        :lines
        what: fx
        old: (emitArgv zc: "\{tmp}/o/zc".stringView file: fx)
        new: (emitArgv zc: "\{tmp}/n/zc".stringView file: fx)
        oldCwd: ""
        newCwd: ""
    )
}

# sayInstructions -- one line: the instructions of the old compiler's run
# `old` in `oldCwd` and the new one's `new` in `newCwd`, and the change
sayInstructions: function {
    g: Gate.view
    lines: List String
    what: StringView
    old: (List String).view
    new: (List String).view
    oldCwd: StringView
    newCwd: StringView
} is {
    o: perf.instructionsOf :g argv: old cwd: oldCwd
    n: perf.instructionsOf :g argv: new cwd: newCwd
    both: "old \{perf.millionsText n: o}  new \{perf.millionsText :n}"
    if (o < 0) or (n < 0) then {
        say :lines text: "instructions, \{what}: \{both}".stringView
        return
    }
    say :lines text: "instructions, \{what}: \{both}  \{changeText :o :n}".stringView
}

# emitArgv -- the compiler `zc` emitting the program `file`, its C discarded
emitArgv: function {zc: StringView file: StringView} out List String is {
    a: List String
    a.append from: zc.string
    a.append from: "emit".string
    a.append from: file.string
    a.append from: "-o".string
    a.append from: os.nullDevice
    return a
}

# changeText -- the change from `o` to `n` as a signed percentage to two
# places, cut toward zero
changeText: function {o: i64 n: i64} out String is {
    d: n - o * 10000 / o
    sign: "+"
    if d < 0 then {
        sign = "-"
        d = 0 - d
    }
    pad: ""
    if (d % 100) < 10 then pad = "0"
    return "\{sign}\{d / 100}.\{pad}\{d % 100}%"
}

# runNames -- the four runs: old or new compiler, then old or new source
runNames: list { "oo" "on" "no" "nn" } out staticlist StringView

# runLabels -- each run as its line says it
runLabels: list {
    "old zc / old src" "old zc / new src" "new zc / old src" "new zc / new src"
} out staticlist StringView

# versionOf -- what the compiler at `zc` prints for --version, one line
versionOf: function {g: Gate.view zc: StringView} out String is {
    a: List String
    a.append from: zc.string
    a.append from: "--version".string
    c: captured :g argv: a cwd: "" tag: "abversion"
    return c.text.stringView.trim.string
}

# copyTo -- the file `from` copied to `to`, its mode kept
copyTo: function {from: StringView to: StringView} is {
    a: wordsOf text: "cp"
    a.append from: from.string
    a.append from: to.string
    rc: runTo argv: a cwd: "" outPath: "" errPath: ""
    rc.drop
}

# stageTree -- what a self-compile reads of the tree `from` -- src/ and
# lib/system/ -- copied to `to`. The self-compile names every directory it
# reads, so the tree's project.zd stays behind: an old tree saved without it
# would otherwise compile outside a project and the new one inside.
stageTree: function {from: StringView to: StringView} is {
    io.mkdirp path: "\{to}/lib"
    copyDir from: "\{from}/src".stringView to: "\{to}/src".stringView
    copyDir from: "\{from}/lib/system".stringView to: "\{to}/lib/system".stringView
}

# copyDir -- the directory `from` copied whole to `to`
copyDir: function {from: StringView to: StringView} is {
    a: wordsOf text: "cp -r"
    a.append from: from.string
    a.append from: to.string
    rc: runTo argv: a cwd: "" outPath: "" errPath: ""
    rc.drop
}

# firstError -- why a run failed: its exit status and the first line of its
# log that says error; empty when it did not fail
firstError: function {text: StringView status: i32} out String is {
    if status == 0 when (perf.heapUsageOf :text).found then return "".string
    for each ln: text.lines loop {
        if (ln.startsWith "==").not when ln.contains "error" then return "exit \{status}: \{ln}"
    }
    return "exit \{status}"
}

# countText -- a count as printed: the number, or FAIL
countText: function {n: i64} out String is {
    if n < 0 then return "FAIL".string
    return "\{n}"
}

# failWhy -- `[<run>: <why>]` for each of runs `a` and `b` that failed
failWhy: function {
    whys: (List String).view counts: (ListVal i64).view a: u64 b: u64
} out String is {
    r: String
    for each k: (twoOf :a :b) loop {
        if (counts.get i: k) < 0 then r.append " [\{runNames.get i: k}: \{whys.get i: k}]"
    }
    return r
}

# twoOf -- the indexes `a` and `b`
twoOf: function {a: u64 b: u64} out ListVal u64 is {
    l: ListVal u64
    l.append a
    l.append b
    return l
}
