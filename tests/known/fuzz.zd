# fuzz -- the findings the fixed-seed fuzz run of `make ci` is known to show,
# each a signature in `findings`, from the run of `seed` with `cases` cases.
# Each is a defect of zc that is not fixed yet. The run fails on a signature
# not listed here, and on a listed one it no longer shows: fix the defect and
# delete its line in the same change. `make fuzz-known` writes this file from
# a run.

seed: 11
cases: 2500
findings: list {} out staticlist text
