# coverage -- the functions of zc that no test enters: the build of `make
# coverage` holds them, and nothing the suite runs calls them. `make
# coverage-check` (a leg of make ci) fails on a function not listed here that
# no test enters: add a test that reaches it, or delete it when nothing can.
# It fails on a listed one too, when a test enters it now or the build no
# longer holds it: delete its line in the same change. `why` says what is
# known of it; `untriaged` is a function nobody has looked at yet. `make
# coverage-known` writes this file from a run and keeps each `why`.

# unentered -- one function no test enters: its file, and its name as the
# source writes it (`Owner.name` for one written inside another definition)
unentered: data {
    file: text
    name: text
    why: text
}

functions: list {
    (unentered file: "lib/system/ascii.z" name: "lower" why: "untriaged")
    (unentered file: "lib/system/cli.z" name: "readBundle" why: "untriaged")
