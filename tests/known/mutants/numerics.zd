# numerics -- the mutants of src/ztypecheck/numerics.z that no test can kill, each with the
# reason: `zgate mutate` (make mutate) leaves them out of the score and lists them apart in
# survivors.md. A row names a mutant by the function its edit is in, the kind of the edit (op,
# as mutsites names it) and which of the function's edits of that kind it is, from 1, so an
# edit elsewhere in the file does not move it; `code` is the line the edit is on, as the row was
# written, and a row whose line no longer reads so is listed as stale and counts for nothing.

# equivalent -- one mutant no program can tell from zc: where, which edit, why, and its line
equivalent: data {
    where: text
    op: text
    nth: u64
    why: text
    code: text
}

equivalents: list {
    (
        equivalent
        where: "typesCompatible"
        op: "bool"
        nth: 3
        why: "two staticlist instances with equal arguments are one instance (getOrMintSpec binds every parameter first), so `a == b` has answered already"
        code: "if (statics.staticListFits :ast :st have: a want: b) then return true"
    )
    (
        equivalent
        where: "alignUp"
        op: "delete"
        nth: 1
        why: "a fast path: every alignment alignUp is given is at least 1, and with 1 the result is n"
        code: "if a <= 1 then return n"
    )
    (
        equivalent
        where: "valtypeLayout"
        op: "bool"
        nth: 4
        why: "the data-handle layout is known with size and align refBytes, which is the slot's width: it always fits, and its cyclic flag is never read"
        code: "cyclic: false"
    )
    (
        equivalent
        where: "variantLayout"
        op: "delete"
        nth: 2
        why: "the tag's layout is unknown only past the depth guard, and then every payload answers the same unknown layout"
        code: "if tag.known.not then return tag"
    )
    (
        equivalent
        where: "checkInstanceContainment"
        op: "edge"
        nth: 1
        why: "the extra iteration visits the type id nextTid, which nothing in the loop mints: it has no generic origin and is skipped"
        code: "for t < last loop {"
    )
    (
        equivalent
        where: "heldInto"
        op: "delete"
        nth: 5
        why: "a typedef declares no data fields of its own, and its base is appended on the leg that follows"
        code: "return"
    )
    (
        equivalent
        where: "checkUnionArmSlots"
        op: "edge"
        nth: 1
        why: "the extra iteration visits nextTid, which nothing in the loop mints: its typetype is nullType and it is skipped"
        code: "for t < last loop {"
    )
    (
        equivalent
        where: "wideArmNode"
        op: "delete"
        nth: 3
        why: "an instance's declaration clones every arm child with the template child's node, so the instance and its origin give the same node"
        code: "if go.notZero then owner = go"
    )
    (
        equivalent
        where: "armKeyNotAfter"
        op: "notdrop"
        nth: 1
        why: "equal-node entries are one template arm, compared in ascending owner order with one arm name: armKeyNotAfter answers true either way"
        code: "if (a.owner == b.owner).not then return a.owner < b.owner"
    )
    (
        equivalent
        where: "armKeyNotAfter"
        op: "edge"
        nth: 1
        why: "the line runs only when the owners differ, where `<=` and `<` agree"
        code: "if (a.owner == b.owner).not then return a.owner < b.owner"
    )
    (
        equivalent
        where: "reportWideArms"
        op: "edge"
        nth: 3
        why: "as armKeyNotAfter's notdrop: equal-node pairs come in ascending owner order with one arm name, which armKeyNotAfter answers true for anyway"
        code: "if (an < bn) or ((an == bn) and (armKeyNotAfter a: ak b: bk)) then break"
    )
    (
        equivalent
        where: "reportWideArms"
        op: "delete"
        nth: 19
        why: "wideArmNode never answers 0 for an arm: every union and instance declaration has an arm child with its node"
        code: "if nd.isZero then continue"
    )
    (
        equivalent
        where: "isFloatLiteralTid"
        op: "andor"
        nth: 1
        why: "`or` differs from `and` only for a system integer scalar, and every caller passes an untyped arm's type"
        code: "return k.has and (ztypes.isFloatKind k: k.kind)"
    )
    (
        equivalent
        where: "armTypesAgree"
        op: "andor"
        nth: 1
        why: "with exactly one scalar arm the two-way typesCompatible is false, as the line it replaces answers"
        code: "if ka.has or kb.has then {"
    )
    (
        equivalent
        where: "checkNumericCoercion"
        op: "delete"
        nth: 11
        why: "argLiteralLexeme answers '' only for no lexeme, which reads as 0 and fits every numeric type: checkLiteralFits reports nothing"
        code: "if lex.length == 0 then return"
    )
    (
        equivalent
        where: "losslessConvTo"
        op: "edge"
        nth: 1
        why: "`to` is a system numeric here, whose name is never empty"
        code: "if toName.length > 0 then convNameId = zast.poolFind pool: ast.names text: toName"
    )
    (
        equivalent
        where: "losslessConvTo"
        op: "bool"
        nth: 2
        why: "the scalar names are interned first in every pool, so the id is never 0"
        code: "if convNameId.isZero then return false"
    )
    (
        equivalent
        where: "checkNamedArgParam"
        op: "delete"
        nth: 2
        why: "no setMemberType caller passes a zero owner, so declMemberCount of owner 0 answers 0 as the deleted return does"
        code: "if effId.isZero then return"
    )
    (
        equivalent
        where: "checkYieldedValue"
        op: "delete"
        nth: 3
        why: "iterWrapperElem of type 0 finds no origin and answers none, returning as the deleted line does"
        code: "if wr.isZero then return"
    )
    (
        equivalent
        where: "checkReturnTypeMatch"
        op: "delete"
        nth: 7
        why: "the stamp is read only by the emitter, and a text literal returned as text or StringView renders as its static either way"
        code: "if (isTextLiteralTid :st tid: argT) then stampGate :st nid: arg.operation tid: expR"
    )
    (
        equivalent
        where: "numKindOfTid"
        op: "delete"
        nth: 2
        why: "declIdOfType(0) is 0, so the next line answers none the same"
        code: "if tid.isZero then return none"
    )
    (
        equivalent
        where: "numKindOfTid"
        op: "andor"
        nth: 1
        why: "numkindAt answers no kind for every position past the sixteen scalars, so the range test is redundant"
        code: "if (nm < first) or (nm > zast.wellKnown.slot.tyF128) then return none"
    )
    (
        equivalent
        where: "numKindOfTid"
        op: "delete"
        nth: 9
        why: "as the andor edit of this test: numkindAt answers no kind for an out-of-range name"
        code: "if (nm < first) or (nm > zast.wellKnown.slot.tyF128) then return none"
    )
    (
        equivalent
        where: "checkConstantArgKind"
        op: "delete"
        nth: 8
        why: "a none-kind value has numTid 0, so every path past the deleted line answers nothing for it"
        code: "if av.kind.none then return"
    )
    (
        equivalent
        where: "constAsPayload"
        op: "delete"
        nth: 1
        why: "constValueTid of a none-kind value is 0, so the answer has kind none either way, and the caller reads only its kind"
        code: "if v.kind.none then return v"
    )
    (
        equivalent
        where: "unitPathOfDecl"
        op: "delete"
        nth: 10
        why: "the borrowed view's `.drop` emits only a void cast, and nothing later in the iteration writes the declarations"
        code: "decl.drop"
    )
    (
        equivalent
        where: "unitPathOfDecl"
        op: "bool"
        nth: 2
        why: "isBlock gates the append only with isU, and no parent-0 declaration is a unit"
        code: "isBlock: false"
    )
    (
        equivalent
        where: "unitPathOfDecl"
        op: "notadd"
        nth: 1
        why: "isBlock true implies isU false (declPublicNsOf answers only publicNs rows): the append is decided by isU alone"
        code: "if par.notZero then isBlock = (st.typing.declPublicNsOf owner: par) == cur"
    )
    (
        equivalent
        where: "unitPathOfDecl"
        op: "delete"
        nth: 12
        why: "as the notadd edit of isBlock: isBlock never decides the append"
        code: "if par.notZero then isBlock = (st.typing.declPublicNsOf owner: par) == cur"
    )
}
