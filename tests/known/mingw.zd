# RUN cases that do not pass when built for Windows by mingw-w64 (zc --target
# x86_64-w64-mingw32) and run under wine. Read by `make test-mingw`. Each
# program is a `failure`, with the stage it stops at.
#
#   (cc)   the emitted C does not compile or link for Windows: a native the
#          program reaches calls POSIX with no Win32 counterpart.
#   (posix) it checks something only POSIX has (run_cases.zd marks it), and
#          is not run: the deliberate floor of this list.
#   (run)  it builds, but its output or exit code differs from the golden:
#          the test assumes POSIX (a "/" path, /tmp, sh) or prints what is
#          truly the system's own.
#
# The gate fails on movement in EITHER direction: a program that starts
# passing is a deliberate edit here, in the commit that makes it pass. Beyond
# the (posix) floor, an entry is Win32 platform work still to do.

# stage -- where a case stops
stage: choice {
    # zc refuses it, or fails to emit it
    zc: null
    # the emitted C does not compile or link
    cc: null
    # it builds, but its output or exit status differs from its golden
    run: null
    # it checks something only POSIX has, and is listed rather than run
    posix: null
}

# failure -- one case expected to fail, and where
failure: data {
    program: text
    :stage
}

# failures -- the cases, by name
failures: list {
    (failure program: "os_spawn_fds" stage: stage.posix)
    (failure program: "os_spawn_signal" stage: stage.posix)
}
