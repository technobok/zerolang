# leaks -- programs expected to still hold memory when they exit, per
# compiler family: each a `leak` naming its family. A program listed here that comes
# up CLEAN fails the ratchet: the entry has to be deleted in the same commit as
# whatever fixed it. A program NOT listed here that leaks fails outright.
#
# Keyed by family because the two sanitizers do not measure the same thing.
# ASan reports what is definitely LOST -- unreachable at exit. tcc's bounds
# checker, under TCC_BOUNDS_PRINT_HEAP, prints every block still LIVE at exit,
# reachable or not. The zerolang invariant is the stricter one (`make
# perf-strict` asserts allocs == frees), so tcc's reading is the more useful of
# the two; it is also why a row can be right for tcc and wrong for gcc.
#
# os_basics ends in `os.exit`, which terminates immediately and by design skips
# zerolang's destructors -- the example says so in its own comment, and it is
# demonstrating exactly that. Its four blocks (argv, two env strings) are still
# reachable, so ASan is silent and the bounds checker is not. Verified with
# valgrind: 9 allocs, 5 frees, 0 definitely lost.

# family -- the compiler family whose sanitizer measures a case
family: choice {
    gcc: null
    clang: null
    tcc: null
}

# leak -- one program expected to hold memory at exit, and under which family
leak: data {
    program: text
    :family
}

# leaks -- the programs, by name
leaks: list {
    (leak program: "os_basics" family: family.tcc)
    # sync_atomic_bad_order ends in the panic it demonstrates (a load ordered
    # `release`), which exits without running destructors, while its atomic -- a
    # handle to a heap block since atomics are shared by handle -- is live. The
    # block is reachable, so ASan is silent and the bounds checker is not.
    (leak program: "sync_atomic_bad_order" family: family.tcc)
    # result_or_panic ends in the panic it demonstrates (`orPanic` on an err),
    # which exits without running destructors, while its list of words and the
    # texts it printed are live. The blocks are reachable, so ASan is silent and
    # the bounds checker is not.
    (leak program: "result_or_panic" family: family.tcc)
}
