# Programs the vendored tcc cannot build or run for Windows, built by the cross
# compiler (out/x86_64-win32-tcc) and run under wine, and the stage each fails
# at. Read by `make test-tcc-mingw`. Each program is a `failure`, with
# the stages of tests/known/tcc.zd, plus `(posix)` (a case marked
# posix in run_cases.txt, listed rather than run, as test-mingw lists it).
#
# The list is test-tcc's (Linux) plus what a Windows build reaches that a Linux
# one does not; each such line says why. The gate fails on movement in EITHER
# direction.

# __float128, refused by the C backend by name -- as under test-tcc.

# stage -- where a case stops
stage: choice {
    # zc refuses it, or fails to emit it
    zc: null
    # the emitted C does not compile or link
    cc: null
    # it builds, but its output or exit status differs from its golden
    run: null
    # it checks something only POSIX has, and is listed rather than run
    posix: null
}

# failure -- one case expected to fail, and where
failure: data {
    program: text
    :stage
}

# failures -- the cases, by name
failures: list {
    (failure program: "bound_runtime_all_arms" stage: stage.zc)
    (failure program: "bound_used_arms_f128" stage: stage.zc)
    (failure program: "f128_constant_precision" stage: stage.zc)
    (failure program: "f128_exponents" stage: stage.zc)
    (failure program: "float_constant_emission_wide" stage: stage.zc)
    (failure program: "float_functions_wide" stage: stage.zc)
    (failure program: "float_mod" stage: stage.zc)
    (failure program: "float_widths" stage: stage.zc)
    (failure program: "math_constants_wide" stage: stage.zc)
    # Reaches f128 only when built for Windows: the program's compile-time guard
    # keeps the f128 arm on Windows alone (see its header comment).
    (failure program: "fold_guarded_f128" stage: stage.zc)
    # POSIX-only checks, listed rather than run (as in mingw.zd).
    (failure program: "os_spawn_fds" stage: stage.posix)
    (failure program: "os_spawn_signal" stage: stage.posix)
}
