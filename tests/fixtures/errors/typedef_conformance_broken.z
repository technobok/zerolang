# a typedef inherits its base's conformances, while every spec method's first
# declarer on it keeps the spec's signature. `Echo` overrides `speak` with the
# same signature and still conforms; `Mute` hides it and `Loud` reshapes it, so
# neither conforms, and using either as the protocol is refused at the use.
Speaker: protocol {
    speak: function {:this} out u64
}
Dog: class { n: u64 } as {
    :Speaker
    speak: function {:this} out u64 is { return this.n }
}
Echo: typedef Dog as {
    speak: function {:this} out u64 is { return this.n * 2 }
}
Mute: typedef Dog as { speak: null }
Loud: typedef Dog as {
    speak: function {:this} out i64 is { return 1 }
}
hear: function {s: Speaker} out u64 is { return s.speak }
main: function is {
    e: Echo (Dog n: 3)
    m: Mute (Dog n: 3)
    l: Loud (Dog n: 3)
    print "\{hear s: e} \{hear s: m} \{hear s: l}"
}
