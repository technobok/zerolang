# ResultVR's `ok` is a bare value-type arm, held in the union's slot, so an
# instance over a value wider than the slot is refused -- where the program
# instantiates it, since the template is the system's -- with the `(Box t)`
# spelling that holds one in a cell. `ResultVR u64` beside it fits.
pair: record { a: i64  b: i64 }
Fail: class { why: String }

main: function is {
    n: (ResultVR u64 E: Fail).ok 5
    p: (ResultVR pair E: Fail).ok (pair a: 1 b: 2)
    if n.ok then print "\{n}"
    if p.ok then print "\{p.a}"
}
