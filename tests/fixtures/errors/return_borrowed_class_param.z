# A BORROWED REFTYPE IS THE CALLER'S, WHETHER OR NOT IT HAS ANYTHING TO DESTROY.
# Returning a borrowed class parameter bare from an `out` function takes it, as
# `return p.take` would, and is refused in the same terms. The refusal asked
# only of a type with a destructor, so a class holding plain numbers -- passed
# by reference -- reached the C as a pointer returned for a struct
# ("incompatible types when returning type 'z_t103_t *'", at 00eebdad).
Cl: class {
    n: i64
}

g: function {p: Cl} out Cl is {
    return p
}

main: function is {
    a: Cl n: 5
    b: g p: a
    print "\{b.n}"
}
