# A `match` dissects only a generic parameter some instance binds: a type name
# the unit does not declare as a parameter is a match subject like any other,
# and refused as one, and so is a named constant whose value is a numeric
# parameter (`SAME: cap`) -- a `match` never dissects a named constant. A
# dissection with no case for the bound argument and no else names that
# argument.
box: unit as {
    t: anyval.generic
    named: function {} out StringView is {
        match String case i32 then {
            return "i32"
        }
        return "x"
    }
    only: function as { m: anyval.generic } in {k: m} out StringView is {
        match t case i32 then {
            return "i32"
        }
        return "else"
    }
}

b64: (box t: i64)

Buf: class {
    used: u64
} as {
    cap: u64.generic
    SAME: cap
    label: function {b: this} out StringView is {
        return (match (SAME) case 8 then "eight" else "other")
    }
}

main: function is {
    print "\{b64.named}"
    print "\{b64.only k: 1}"
    p: (Buf cap: 8) used: 1
    print p.label
}
