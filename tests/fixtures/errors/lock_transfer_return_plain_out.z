# A lock-holding local returned through a plain `out` function would hand the
# caller a value whose locks it cannot see: the function is not `outx`, so the
# caller would write the source while the result still points into it.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

outer: function {from: Src.borrow} out W is {
    w: mk from: from
    return w
}

main: function is {
    a: Src n: 1
    w: outer from: a
    a.n = 5
    print "\{w.tag}"
}
