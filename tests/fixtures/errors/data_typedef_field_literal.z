# A data value's field of a typedef type takes a value of the typedef, as a
# record's field does in a body: a literal takes a typedef only where a
# list's `out` asks for one.

# level -- a byte with a meaning of its own
level: typedef u8

# ratio -- a fraction with a meaning of its own
ratio: typedef f64

# reading -- one meter reading
reading: data {
    at: level
    share: ratio
}

Ok: (reading at: level 3 share: ratio 0.5)
Low: (reading at: 3 share: ratio 0.5)
Half: (reading at: level 3 share: 0.5)

main: function is {
    print "\{Ok.at.u8} \{Low.at.u8} \{Half.at.u8}"
}
