# A value that cannot be hashed consistently with its `==` is no key, and has
# no `hash` to read: a type whose `==` is written by hand and whose `hash` is
# not; anything holding one; anything holding a float; anything holding a
# part with no `==`. Each is refused where it keys a container or where its
# `hash` is read. emitc_corpus/hash_follows_eq is the other half.
parity: record { val: u64.typedef } as {
    ==: function {t: this.view rhs: parity} out bool is {
        return (t.u64 % 2) == (rhs.u64 % 2)
    }
}

holder: record {
    p: parity
}

reading: record {
    celsius: f64
}

opaque: record {
    val: i64
} as {
    ==: null
}

boxed: record {
    o: opaque
}

main: function is {
    s: (SetVal parity)
    print "\{s.length}"
    h: (MapVV holder v: i64)
    print "\{h.length}"
    r: (SetVal reading)
    print "\{r.length}"
    b: (SetVal boxed)
    print "\{b.length}"
    p: parity.create from: 3
    print "\{p.hash}"
    w: holder p: p
    print "\{w.hash}"
    x: boxed o: (opaque val: 1)
    print "\{x.hash}"
}
