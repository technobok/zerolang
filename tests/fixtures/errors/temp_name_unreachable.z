# The checker's own temporaries have names no source text can spell: `_t0` and
# `_t1` here are names nothing declares, whatever temporaries the bodies make.
Box: class {
    s: String
}

mk: function {k: u64} out Box is {
    return (Box s: "abc\{k}")
}

consume: function {a: Box.take} out u64 is {
    return a.s.length
}

reads: function is {
    v: (mk k: 3).s.stringView
    n: _t1.s.length
    print "\{n} \{v}"
}

moves: function {c: bool} out u64 is {
    n: (mk k: 3).s.length
    if c then {
        return (consume a: _t0.take)
    }
    return n
}

main: function is {
    reads
    print "\{moves c: true}"
}
