# `yield` is a function, and its argument is the element the consumer receives,
# so a bare one is a call missing what the iteration produces.
#
# It wears the unregistered control placeholder that `break` and `continue`
# wear, which is why neither function leg sees it, and it is the one of the three
# that is NOT valueless. Left bare it reached the emitter, which wrote
# `(void)(yield);` into the C at exit 0 for the C compiler to reject as an
# undeclared identifier, with no zerolang location.
Ticker: generator { n: i64 } as {
    call: function out i64 is {
        yield
        yield this.n
    }
}

main: function is {
    t: Ticker n: 5
    with it: t do for v: it loop print "v=\{v}"
}
