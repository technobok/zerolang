# A FUNCTION FIELD OF THE `is` SECTION BELONGS TO EACH INSTANCE. Its body is only
# the default of that instance's slot, so there is no function to reach through
# the type: `Meter.bump m` called the default whatever the instance held, and
# `Meter.zero` bound a function pointer where its result was wanted.
Meter: class {
    count: i64
    bump: function {:this} out i64 is {
        return this.count + 1
    }
    add: function {:this n: i64} out i64 is {
        return this.count + n
    }
    zero: function out i64 is {
        return 0
    }
}

main: function is {
    m: Meter count: 1
    a: Meter.bump m
    b: Meter.bump
    c: Meter.add m n: 2
    d: Meter.zero
    print "\{a} \{b} \{c} \{d}"
}
