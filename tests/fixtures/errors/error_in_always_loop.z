# The first iteration of a loop no precondition can stop is reached, as a winning
# `if` branch is: an `error` in its body is proved, in any form of the loop.

ALWAYS: true

bare: function is {
    for loop {
        error "in a bare loop"
    }
}

folded: function is {
    for ALWAYS loop {
        error "in a loop whose condition folds true"
    }
}

doWhile: function {k: bool} is {
    for loop {
        error "in a do-while"
    } while k
}

main: function is {
    bare
    folded
    doWhile k: true
}
