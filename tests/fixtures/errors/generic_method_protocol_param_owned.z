# An owned protocol parameter of a generic METHOD (`j: (Job R).take`), called
# through a value, refuses a bare conformer once the instance fixes its type,
# as the free function's does: the check reads the parameter the argument
# binds, by name, on the instance -- whose list holds the receiver too.

# Job -- something that answers an R
Job: protocol {
    call: function {:this} out R
} as {
    R: AnyRef.generic
}

# Name -- a Job answering String
Name: class { s: String } as {
    job: (Job String).implement
    call: function {:this} out String is { return this.s.copy }
}

# Runner -- runs any Job, answering its R
Runner: class { n: i64 } as {
    run: function {:this j: (Job R).take} out R is {
        return j.call
    } as {R: AnyRef.generic}
}

main: function is {
    r: Runner n: 1
    print (r.run j: (Name s: "y".string) R: String)
}
