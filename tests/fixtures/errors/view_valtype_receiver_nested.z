# E0200: the receiver is a FIELD of a view -- `t.inner.poke` inside a `.view`
# method. The nested-receiver leg locks the whole path; the exclusive leaf
# conflicts with the readonly self-lock on `t`.
point: record {
    x: i64
} as {
    poke: function {:this} is {
        this.x = 99
    }
}
outer: record {
    inner: point
} as {
    peek: function {t: this.view} out i64 is {
        t.inner.poke
        return t.inner.x
    }
}
main: function is {
    o: outer inner: (point x: 1)
    print "\{o.peek}"
}
