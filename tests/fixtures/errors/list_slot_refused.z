# A block's `slot` names its labels' positions and nothing else: no other
# member, no value, nothing through a value, nothing on a block without
# labels -- and, for a typedef index, no unit constant.
nid: typedef u64
codes: list { ht: 9 lf: 10 } out (list u8 i: nid)
primes: list { 2 3 5 } out list u8
K: codes.slot.lf

main: function is {
    a: codes.slot.nosuch
    b: codes.slot.length
    c: codes.slot
    d: primes.slot
    v: codes
    e: v.slot
    f: K
}
