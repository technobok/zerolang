# A lock its holder releases in a condition that runs on some paths only -- an
# `if` clause's conjunct after the first, a loop's condition after the first, a
# loop's postcondition -- is released on those paths only. The code after the
# statement, and a loop body that runs before the postcondition, still find the
# source locked: writing it there and reading the holder after would read freed
# memory. Each refusal names the holder, `w`.
LfBox: class {
    name: StringView
}

whenReassignWriteAfter: function {k: bool} is {
    s: "abc".string
    o: "ooo".string
    w: LfBox name: s.stringView
    if k when (with t: k do {
        w = LfBox name: o.stringView
        t
    }) then print "then"
    s = "zzzzzzzzzzzzzzzz".string
    print "\{w.name}"
}

secondCondReassignWriteAfter: function {k: bool} is {
    s: "abc".string
    o: "ooo".string
    w: LfBox name: s.stringView
    n: 0
    if k then n = 1
    for n > 0 while (with t: n do {
        w = LfBox name: o.stringView
        t > 0
    }) loop {
        n = n - 1
    }
    s = "zzzzzzzzzzzzzzzz".string
    print "\{w.name}"
}

postcondReassignWriteAfter: function {k: bool} is {
    s: "abc".string
    o: "ooo".string
    w: LfBox name: s.stringView
    n: 0
    if k then n = 1
    for n > 0 loop {
        n = n - 1
    } while (with t: n do {
        w = LfBox name: o.stringView
        t > 0
    })
    s = "zzzzzzzzzzzzzzzz".string
    print "\{w.name}"
}

postcondReassignBodyWrite: function {k: bool} is {
    s: "abc".string
    o: "ooo".string
    w: LfBox name: s.stringView
    n: 0
    if k then n = 1
    for n < 1 loop {
        s = "zzzzzzzzzzzzzzzz".string
        print "\{w.name}"
        n = n + 1
    } while (with t: n do {
        w = LfBox name: o.stringView
        t < 1
    })
}

main: function is {
    whenReassignWriteAfter k: false
    secondCondReassignWriteAfter k: false
    postcondReassignWriteAfter k: false
    postcondReassignBodyWrite k: false
}
