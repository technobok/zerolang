# generator_yields_owned.z -- a generator hands out owned values only: a yield
# of something that keeps a source locked -- a view of the generator's own
# state, a view of what it was given -- would reach the caller with nothing
# keeping that source alive, and is refused. A view of static bytes, a value
# copied out of a walk and an owned copy are what a generator yields.
OwnView: generator { s: String } as {
    call: function out StringView is {
        yield this.s.stringView
    }
}

GivenView: generator { s: String } as {
    call: function out StringView is {
        v: this.s.substring from: 0 to: 1
        yield v
    }
}

main: function is {
    g: OwnView s: "abc".string
    h: GivenView s: "abc".string
    for p: g loop print p
    for q: h loop print q
}
