# `null` IS NO RUNTIME VALUE, SO NO FIELD HOLDS ONE, in a class as in a record.
# A record refused `foo: null` at its declaration; a class accepted it, and every
# construction then demanded an argument of no type -- `create: null` written in
# the body instead of the `as` block was reported as "missing required argument
# 'create' (type: null)".
Holder: class {
    value: i64
    foo: null
    create: null
}

main: function is {
    h: Holder value: 1
    print "\{h.value}"
}
