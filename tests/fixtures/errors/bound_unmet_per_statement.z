# bound_unmet_per_statement -- an unmet bound is reported once per failing argument per
# statement: a statement nested in one that already failed reports its own refusal for
# the same argument on another template.
Box: class {
    v: T
} as {
    T: AnyRef.generic
}

Cup: class {
    v: T
} as {
    T: AnyRef.generic
}

main: function is {
    print "start"
    if ((Box T: i64) v: 5).v > 0 then {
        c: (Cup T: i64) v: 6
        print "\{c.v}"
    }
}
