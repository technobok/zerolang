# a unit whose two errors sit at string literals: one in a generic record's
# method, one in a plain function

# a value with an offset
Off: record {
    # the value
    v: u64
} as {
    n: u64.generic
    # a String where a u64 is declared
    wrong: function {t: this.view} out u64 is {
        return "n squared"
    }
}

# label -- a String where an i64 is declared
label: function out i64 is {
    return "seven"
}
