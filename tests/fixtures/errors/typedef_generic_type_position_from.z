# in a type position too, a generic typedef's type arguments are labelled:
# `(Bag String)` puts a type in the `from:` slot.
Bag: typedef (List T) as {
    T: AnyRef.generic
}
count: function {b: (Bag String).view} out u64 is {
    return b.length
}
main: function is {
    b: Bag T: String
    print "\{count :b}"
}
