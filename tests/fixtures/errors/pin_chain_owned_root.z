# pin_chain_owned_root.z -- a reference return through a borrowed local is
# accepted only when the chain reaches a borrowed parameter. One that reaches
# an owned local, or a `.take` parameter, points at storage that dies with
# this call.

grandchild: class { n: i64 }
child: class { grandchild: grandchild }
MyClass: class { child: child }

ownedLocal: function {t: MyClass.borrow} outx grandchild.borrow is {
    c: child grandchild: (grandchild n: 1)
    d: c.grandchild
    return d
}

takenParam: function {a: MyClass.borrow t: MyClass.take} outx grandchild.borrow is {
    x: t.child
    return x.grandchild
}

main: function is {
}
