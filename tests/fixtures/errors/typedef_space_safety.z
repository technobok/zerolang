# An id typedef is not forward compatible: a bare numeric and another
# space's typedef are refused in typedef positions, and a shadowed ==
# refuses a cross-space comparison (a bare literal still compares through
# the base, so sentinel checks keep working).
declid: record { val: u64.typedef } as {
    ==: function {:this rhs: declid} out bool is {
        return this.u64 == rhs.u64
    }
}
typeid: record { val: u64.typedef } as {}

lookup: function {d: declid} out u64 is {
    return d
}

main: function is {
    raw: 9.u64
    r1: lookup d: raw
    t: typeid.create from: 3
    r2: lookup d: t
    d: declid.create from: 7
    if d == t then print "x" else print "y"
    print "\{r1} \{r2}"
}
