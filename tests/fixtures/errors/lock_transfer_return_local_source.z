# A lock-holding local whose source is another LOCAL cannot be returned even
# through `outx`: the source dies with this call, and nothing the caller
# owns could stay locked for it.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

outer: function {from: Src.borrow} outx W is {
    loc: Src n: 2
    w: mk from: loc
    return w
}

main: function is {
    a: Src n: 1
    w: outer from: a
    print "\{w.tag}"
}
