# a closed range whose two ends are constants and that holds 2^64 values is
# refused: its walk counts down a u64 trip count, `hi - lo + 1`, which wraps to
# zero at exactly 2^64, and each of these walked nothing, silently -- the
# counted lowering and the object form alike. One value short of the full span
# is a range like any other.
Max: 18446744073709551615
main: function is {
    n: u64
    for each i: (0.u64.upto to: 18446744073709551615.u64) loop n = n + 1
    for each j: (Max.u64.downto to: 0) loop n = n + 1
    for each k: ((0 - 9223372036854775807 - 1).upto to: 9223372036854775807) loop n = n + 1
    r: 0.u64.upto to: Max
    for x: r loop n = n + 1
    short: 1.u64.upto to: Max
    s: (0 - 9223372036854775807).upto to: 9223372036854775807
    print "\{n}"
    short.drop
    s.drop
}
