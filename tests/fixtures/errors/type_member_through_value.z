# E0100: a value reaches its type's fields and methods, not its types. A numeric
# generic parameter is the instance's singleton type, and an `as` alias is a
# type the type names; read through a value of the type -- a local, a
# parameter, `this` -- each is refused, and the message says where it is
# reached instead: through the type's name (`(Buffer cap: 8).cap`, `Outer.N`),
# or bare inside the type.
Buffer: class {
    used: u32
} as {
    cap: u32.generic
    twice: function {:this} out u32 is {
        return this.cap * 2
    }
}

Box: class {
    v: t
} as {
    t: anyval.generic
    Elem: t
}

Nest: record { z: i64 }
Outer: class { y: i64 } as {
    N: Nest
}

main: function is {
    b: (Buffer cap: 8) used: 0
    print "\{b.cap} \{b.twice}"
    x: (Box t: i64) v: 3
    e: x.Elem
    o: Outer y: 1
    w: o.N
    print "\{e} \{w.z}"
}
