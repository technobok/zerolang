# a typedef hides a member of its base by setting it to `null` in its as-block,
# and using the hidden member is refused. It was accepted and reached gcc.
Box: class { n: u64 } as {
    twice: function {t: this.view} out u64 is { return t.n * 2 }
}
Hidden: typedef Box as { twice: null }
main: function is {
    h: Hidden (Box n: 2)
    print "\{h.n} \{h.twice}"
}
