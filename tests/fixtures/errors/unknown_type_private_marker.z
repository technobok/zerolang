# unknown_type_private_marker.z -- a type name under `.private` that names
# nothing is E0023, as it is under `.view`. It was forced into a shell type of
# its own name instead, so nothing was reported: an unused parameter compiled,
# and two such shells met as "expected container, got container".

Iter: class {
    pos: i64
    target: container.private.view
} as {
    create: function {target: container.private.view} outx this is {
        return (meta.create pos: 0 :target)
    }
}

unused: function {x: nosuch.private.borrow} is {
}

main: function is {
}
