# comprehension_if_body_locals_refused -- the last line of a comprehension's body is the
# element appended, not a block value: an `if` choosing between two of the body's own
# locals is refused there, as it holds a lock on them.
main: function is {
    names: for each i: 3.times loop {
        s: "even \{i}"
        t: "odd \{i}"
        if (i % 2) == 0 then s else t
    }
    for each n: names loop print n
}
