# A DECLARATION'S OWN NAME IS IN SCOPE IN ITS VALUE: a field, an arm or an `as`
# item whose value starts with its own name names itself, which is no type and
# has no value -- a sum's `tag` among them. The shorthand `:nodeid` names `nodeid` as it is named outside
# the declaration -- the form these mean.
nodeid: record { v: u32 }
kind: variant { a: null b: null }
holder: class { n: i64 }

Row: class {
    nodeid: nodeid
    holder: holder.view
}

Sum: variant {
    kind: kind
    b: null
}

Lim: record { x: i64 } as {
    cap: cap
}

Tagged: union { a: i64  b: String } as {
    tag: tag
}

main: function is {
    print "checked under --eager"
}
