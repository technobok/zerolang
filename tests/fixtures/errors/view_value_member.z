# view_value_member.z -- `.view` marks a parameter type readonly and is not a
# value member. On a generic instance the unknown-member check is lenient, so
# this binding passed the checker unstamped and died as an emitter E0500 with
# no source location.

main: function is {
    xs: (ListVal u64).view
    ys: (List String).view
    print "x"
}
