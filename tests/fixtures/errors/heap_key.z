# E0400: a heap-owning value type as a Map key / SetVal element. A byte range
# cannot cover a member that lives behind a pointer, so `hk` satisfies neither
# the Map key check nor the `valhashable` bound a SetVal element names.
hk: record { s: String }

main: function is {
    m: (MapVV k: hk v: i64)
    t: (SetVal k: hk)
    print "x"
}
