# A borrowing binding cannot escape into a position that owns what it holds:
# the source still owns it, so a return, a constructor field and a taking
# argument are all refused with the borrowed-name wording.
#
# The last case is why the rule covers a bare name at all. A rename USED to
# launder a borrow into an owned value -- `sv2: sv` came out OWNED with no
# origin at all, so `return sv2` passed the escape rule that `return sv` fails,
# and the caller read freed memory.
Keep: class {
    s: String
}

returnsBorrow: function {} out String is {
    a: "one".string
    b: a
    return b
}

storesBorrow: function {} out u64 is {
    a: "one".string
    b: a
    k: Keep s: b
    return k.s.length
}

laundersView: function {} out StringView is {
    a: "abcdefghij".string
    sv: a.stringView
    sv2: sv
    return sv2
}

main: function is {
    print "\{returnsBorrow}"
    print "\{storesBorrow}"
    print "\{laundersView}"
}
