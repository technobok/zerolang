# E0200: a generic function's reference result keeps what it points into locked
# for as long as it lives, as a plain function's does -- `.borrow` exclusively,
# `.view` shared, an `outx` record holding a borrowed field -- written with its
# type arguments or inferred, through a field path (`h.xs`) as through a name,
# and a generic type's `.view` method's too. Each was accepted once the
# instance's body could return the reference.
same: function as { t: anyval.generic } in { b: (ListVal t: t).borrow } outx (ListVal t: t).borrow is {
    return b
}

peek: function as { t: anyval.generic } in { b: (ListVal t: t).view } outx (ListVal t: t).view is {
    return b
}

Ref: class {
    xs: (ListVal i64).borrow
}

wrap: function as { t: anyval.generic } in { b: (ListVal i64).borrow a: t } outx Ref is {
    return (Ref xs: b)
}

Hold: class {
    xs: ListVal i64
}

Holder: class {
    name: String
    v: t
} as {
    t: anyval.generic
    label: function {h: this.view} outx String.view is {
        return h.name
    }
}

written: function is {
    l: ListVal i64
    r: same t: i64 b: l
    l.append from: 2
    r.append from: 3
}

inferred: function is {
    l: ListVal i64
    r: same b: l
    l.append from: 2
    r.append from: 3
}

viewed: function is {
    l: ListVal i64
    r: peek t: i64 b: l
    l.append from: 2
    print "\{r.length}"
}

wrapped: function is {
    l: ListVal i64
    r: wrap t: u8 b: l a: 1
    l.drop
    print "\{r.xs.length}"
}

fieldPath: function is {
    h: Hold xs: (ListVal i64)
    r: same t: i64 b: h.xs
    h.drop
    r.append from: 3
}

labelled: function is {
    h: (Holder t: i64) name: "gen".string v: 1
    s: h.label
    h.drop
    print s
}

main: function is {
    written
    inferred
    viewed
    wrapped
    fieldPath
    labelled
}
