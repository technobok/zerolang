# A list's elements are of one type: arms of two enums, an arm and a data
# value, or a number and an arm are refused where the odd element is written,
# and so is an element its `out` cannot hold.
mode: variant { fast: null slow: null }
shade: variant { light: null dark: null }
entry: data { key: "".text }
mixed: list { mode.fast shade.dark }
kinds: list { mode.fast (entry key: "x") }
wrong: list { mode.fast } out staticlist shade
nums: list { 1 mode.slow }
main: function is {
    print "\{mixed.length} \{kinds.length} \{wrong.length} \{nums.length}"
}
