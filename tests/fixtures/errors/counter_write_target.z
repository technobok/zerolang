# A CONTAINER'S COUNTERS ARE METHODS, NOT STORAGE. A reassignment or a swap
# writes to a variable or a field, and neither `length`, `capacity` nor `size`
# is one -- on a local, through `this`, through a field path, through a borrow,
# or on any family.
holder: class {
    xs: ListVal i64
    poke: function {:this} is {
        this.xs.length = 2
        this.xs.capacity = 2
    }
}

main: function is {
    xs: ListVal i64
    n: 0.u64
    arr: (array t: i64 to: 4)
    raw: (str to: 8)
    h: holder xs: (ListVal i64)
    m: (MapVV k: i64 v: i64)
    xs.capacity = 3
    xs.length swap n
    n swap xs.capacity
    h.xs.length = 3
    arr.length = 3
    raw.size = 3
    m.capacity = 9
    b: xs.borrow
    b.length = 1
    print "\{n}"
}
