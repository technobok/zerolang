# A lock-holding value stored as a union arm payload keeps its locks in the
# union value, as a constructed field does: writing the source while `u` lives
# is refused. The arm used to drop them.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

U: union {
    w: W
    none: null
}

main: function is {
    a: Src n: 1
    w: mk from: a
    u: U.w w
    a.n = 5
    match (u) case w then print "\{u.tag}" else print "none"
}
