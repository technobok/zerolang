# E0200: the same for a Set, and for a call that returns no reference at all:
# `has` takes a shared lock on the set for its duration, which the iterator's
# exclusive lock excludes. Hoist the read above the loop.
main: function is {
    s: (Set String)
    s.add item: "a".string
    s.add item: "b".string
    with it: s.iterate do for x: it loop {
        h: s.has item: x
        print "x=\{x} h=\{h}"
    }
}
