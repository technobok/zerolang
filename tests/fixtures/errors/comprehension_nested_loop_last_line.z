# comprehension_nested_loop_last_line -- a loop nested in a comprehension's body leaves
# the body the comprehension's: its last line is still the element appended, and an `if`
# between two body locals is refused there as it is with no loop before it
main: function is {
    names: for each i: 3.times loop {
        total: 0
        for each j: i.times loop total = total + j
        s: "even \{i} \{total}"
        t: "odd \{i} \{total}"
        if (i % 2) == 0 then s else t
    }
    for each n: names loop print n
}
