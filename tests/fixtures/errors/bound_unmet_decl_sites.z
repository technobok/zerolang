# A type written outside a statement -- a parameter, a return, a field, an
# alias -- is the site of its own unmet bound. It was reported with no
# position, once for the instance and once for each instance its members
# mint (the list's view, its iterator, the get's OptionView), five errors a
# user could not find, then once more at every statement that named it.
Ints: List bool

Box: class { xs: List f64 }

pass: function {xs: List i64} out List u8 is {
    ys: List u8
    return ys
}

main: function is {
    xs: List i64
    ys: pass :xs
    zs: Ints
    b: Box xs: (List f64)
    print "\{ys.length} \{zs.length} \{b.xs.length}"
}
