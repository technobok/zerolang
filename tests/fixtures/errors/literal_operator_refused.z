# A literal against a typed operand is read as that operand's type and must fit
# it: a run-time result never narrows silently (`0 + k` is an i64, which no u8
# holds without loss), and 300 or 1000 is no u8. Two literals are computed by
# the compiler, and where that has no value the operation has none: a negative
# shift count, a float remainder, a float division by zero. A literal's
# operator takes only the numbers its bound lists: a float literal no integer
# type, an integer one's bitwise operator no float.
L: 5.u8

# u8id -- the u8 it is given
u8id: function {v: u8} out u8 is {
    return v
}

main: function is {
    k: 300
    b: 200.u8
    i: 5
    x: 2.5
    print "\{u8id v: (0 + k)}"
    print "\{u8id v: (300 + L)}"
    print "\{1000 - b}"
    print "\{1 << -1}"
    print "\{7.5 % 2.0}"
    print "\{1.0 / 0.0}"
    print "\{0.5 + i}"
    print "\{1 & x}"
}
