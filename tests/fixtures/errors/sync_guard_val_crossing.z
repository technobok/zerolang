# sync_guard_val_crossing.z -- a MutexGuardVal unlocks on the thread that
# locked, so it is `thread.ThreadBound`: a task holding one is refused.

# Holder -- holds a guard
Holder: class {
    # the guard, locked on the spawning thread
    g: sync.MutexGuardVal i64
} as {
    task: (thread.Task null)
    call: function {:this} is {
        print "\{this.g.value}"
    }
}

main: function is {
    m: (sync.MutexVal i64).create value: 1
    h: thread.spawn task: (Holder g: m.lock)
}
