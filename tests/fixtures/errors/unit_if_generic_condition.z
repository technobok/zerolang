# A NUMERIC GENERIC PARAMETER IS NOT A COMPILE-TIME CONSTANT. Monomorphized, it
# becomes a run-time field holding its value, so a unit-level `if` inside the
# template cannot fold a condition over it. It was accepted, and the method
# returning the constant emitted `return i64;`.
box: unit {
    cap: i64.generic
    BIG: if cap > 4 then { 1 } else { 2 }
    size: function out i64 is {
        return BIG
    }
}

b8: (box cap: 8)

main: function is {
    print "\{b8.size}"
}
