# bound_unmet_column_after_nested_block -- an unmet bound reported after a nested block
# of the same statement was walked is placed at the statement's own column.
Box: class {
    v: T
} as {
    T: AnyRef.generic
}

main: function is {
    print "start"
    n: (if true then {
            q: 2
            q
        } else 3) + ((Box T: i64) v: 5).v
    print "\{n}"
}
