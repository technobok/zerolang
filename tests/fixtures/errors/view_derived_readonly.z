# What is read through a `.view` is readonly: a field of a view parameter
# cannot be moved out with `.take`, and the elements of a list a `.view` result
# hands back cannot be written. Through a `.borrow` result they can.
B: class {
    v: StringView
}

takeThroughView: function {b: B.view} out StringView is {
    return b.v.take
}

Item: class {
    n: i64
}

mk: function out List Item is {
    xs: List Item
    xs.append (Item n: 1)
    return xs
}

pass: function {l: (List Item).view} outx (List Item).view is {
    return l
}

passMut: function {l: (List Item).borrow} outx (List Item).borrow is {
    return l
}

main: function is {
    h: B v: "abc"
    print (takeThroughView b: h)
    for each e: (pass l: mk) loop {
        e.n = 5
        print "\{e.n}"
    }
    for each f: (passMut l: mk) loop {
        f.n = 6
        print "\{f.n}"
    }
}
