# `null` is reference-family (user, 2026-09-30): an absent reference. It is a
# member of AnyRef and of a union bound with a null arm, and never of a
# value-family bound -- anyval, or a variant (which holds value data only),
# even one with a null arm. Both were admitted. `(Carry T: null)` over AnyRef
# stays legal, its null member carrying nothing.
Box1: record { n: u8 } as {
    t: anyval.generic
}

V: variant { a: u8  b: null }

Hold: class { n: u8 } as {
    T: V.generic
}

Carry: class { v: T  n: u8 } as {
    T: AnyRef.generic
}

main: function is {
    a: (Box1 t: null) n: 1
    h: (Hold T: null) n: 2
    c: (Carry T: null) n: 3
    print "\{a.n} \{h.n} \{c.n}"
}
