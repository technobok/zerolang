# A local a generator body binds to a borrow of a place -- another local, a
# field, an element -- is a pointer into it, and it does not live across a
# suspension: a yield is refused while one is in scope. A view is a value and
# is kept in the instance like any other local (generator_borrow_in_block).
Local: generator as {
    call: function out u64 is {
        m: List String
        m.append "a".string
        b: m
        yield b.length
    }
}

Field: generator { xs: List String } as {
    call: function out u64 is {
        n: this.xs
        yield n.length
    }
}

main: function is {
    for v: Local loop print "local \{v}"
    xs: List String
    for w: (Field :xs) loop print "field \{w}"
}
