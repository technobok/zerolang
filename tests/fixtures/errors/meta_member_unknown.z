# `meta` holds the enclosing type's raw constructor, meta.create, and nothing
# else: a call or a read of any other member names nothing. Both typed to
# nothing and reached the C compiler as an untyped binding.

# a plain value
px: record {
    v: u64
} as {
    # from a u64
    make: function {from: u64} out this is {
        return (meta.create v: from)
    }
    # through meta, called
    called: function {} out this is {
        a: meta.make from: 1
        return a
    }
    # through meta, read
    read: function {} out this is {
        a: meta.one
        return a
    }
}

main: function is {
    x: px.called
    y: px.read
    print "\{x.v} \{y.v}"
}
