# A generic function's name read bare is a call, as any function's is. It was
# left the function itself -- "type 'mk' is not printable" in an interpolation,
# a binding of the template elsewhere -- because a bare name was held to have
# nothing to instantiate from. It is the call now, and its walk infers the
# type arguments: from nothing, so a parameter is refused there.
mk: function as { t: anyval.generic } out u64 is {
    return 1
}

need: function as { t: anyval.generic } in { v: t } out t is {
    return v
}

main: function is {
    print "\{(mk)}"
    r: mk
    print "\{r}"
    print "\{need}"
}
