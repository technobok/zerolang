# A unit-level definition that calls something is refused for the reason a
# body's call is: a generic function whose argument meets its bound has no
# compile-time value (not "i64 does not satisfy anyval"); a predicate called
# with an argument is a bool, not a function; `==` of two data types is an
# argument of the wrong type.
ident: function as { t: anyval.generic } in {x: t} out t is { return x }

K: (ident x: 5)

G: "abc"
AT: G.byteAt 1
FOO: (AT.some 3)

p: data {
    x: 1
}
q: data {
    x: 1
}
A: (p x: 2)
B: (q x: 2)
E: (A == B)

main: function is {
    print "\{K} \{FOO} \{E}"
}
