# A list's `out` is a type written in the list's scope, resolved as a
# field's type is: beside a user record spelled `u8` it names that record,
# which is no integer type. It was read by spelling, as the builtin u8.
u8: record { lo: i16 }

codes: list { 1 2 } out staticlist u8

main: function is {
    print "\{codes.length}"
}
