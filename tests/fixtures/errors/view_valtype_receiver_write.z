# E0200: a `.view` receiver on a RECORD is readonly, exactly as on a class.
# Before valtype receivers passed by reference this marker was accepted and
# inert -- the write went through and was discarded; now it is refused.
point: record {
    x: i64
} as {
    poke: function {t: this.view} is {
        t.x = 99
    }
}
main: function is {
    q: point x: 1
    q.poke
    print "\{q.x}"
}
