# A FUNCTION VALUE FITS A FUNCTION-TYPED PLACE ONLY WITH THE SAME SIGNATURE: the
# same parameters in order, with the same names, types and ownership, and the
# same return. Nothing asked it, so a function of any signature stored in a
# function field or passed for a function parameter reached the C as an
# incompatible pointer. A value that is not a function does not fit one either.
neg: function {a: i64} out i64 is {
    return 0 - a
}

renamed: function {x: i64 y: i64} out i64 is {
    return x + y
}

widened: function {a: i64 b: i64} out u64 is {
    return 0
}

binop: function {a: i64 b: i64} out i64

apply: function {f: binop} out i64 is {
    r: f a: 1 b: 2
    return r
}

Calc: class {
    op: function {a: i64 b: i64} out i64 is {
        return a + b
    }
    first: function {:this} out i64 is {
        return 1
    }
}

main: function is {
    c: Calc op: neg.take
    c.op = renamed.take
    c.op = widened.take
    n: apply f: neg.take
    c.first = 5
    k: 3
    k swap c.first
    print "\{n} \{k}"
}
