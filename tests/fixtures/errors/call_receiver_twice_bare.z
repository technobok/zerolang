# E0300: the two ways to supply a receiver in a type-qualified call -- the one
# unlabelled argument, and the receiver parameter's own declared name -- are
# alternatives, not a pair. Supplying both leaves emission to pick one and drop
# the other, which is a wrong answer rather than a style question.
point: record {
    x: i64
} as {
    bump: function {t: this} out i64 is {
        return t.x + 1
    }
}
main: function is {
    p: point x: 10
    q: point x: 100
    r: point.bump p t: q
    print "\{r}"
}
