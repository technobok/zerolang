# append_view_of_unnamed_string.z -- a view of a string no name holds, appended
# to a list, keeps that string locked as `t: "abc def".string; ys.append
# t.stringView` does: the list would outlive the string the statement makes.
main: function is {
    ys: List StringView
    ys.append "abc def".string.stringView
    print (ys.get i: 0)
}
