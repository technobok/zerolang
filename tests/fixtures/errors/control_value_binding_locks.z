# E0200: a binding of an `if` borrows every arm's local while it lives, so a
# write to any of them is refused -- the arm that did not run included, and a
# `.borrow` arm as much as a bare one.
Cell: class { n: i64  s: String }
main: function is {
    d: Cell n: 1 s: "d".string
    e: Cell n: 2 s: "e".string
    c: true
    b: if c then d else e
    e.n = 5
    f: Cell n: 3 s: "f".string
    g: Cell n: 4 s: "g".string
    k: if c then f.borrow else g.borrow
    g = Cell n: 6 s: "x".string
    print "\{b.n} \{k.n}"
}
