# AN `if` OR A `match` USED AS A VALUE YIELDS ONE TYPE, and that value must fit
# where it lands. The first arm's type was taken whatever the others yielded: a
# string arm beside a number was invalid C, a u16 arm was narrowed into the u8
# the first arm gave, and 300 landed in a u8 as 44. A duplicate arm was silently
# dead, an unknown subject reached the emitter, and an `if` with no else was
# bound as a value that is missing when no condition holds.
mode: variant {
    fast: null
    slow: null
}

small: function {c: bool} out u8 is {
    if c then { 1 } else { 300 }
}

main: function is {
    c: 3 > 2
    m: mode.slow
    a: 1.u8
    b: 2.u16
    mixed: if c then { 1 } else { "one" }
    armed: match (m) case fast then { 1 } else { "one" }
    widths: if c then { a } else { b }
    missing: if c then { 1 }
    narrow: if c then { 1.u8 } else { 300 }
    a = if c then { 2 } else { 300 }
    twice: match (m) case fast then { 1 } case fast then { 2 } else { 3 }
    match (m) case slow then { print "s" } case slow then { print "t" } else { print "u" }
    match (ghost) case fast then { print "f" } else { print "g" }
    print "\{mixed} \{armed} \{widths} \{missing} \{narrow} \{a} \{twice} \{small :c}"
}
