# A SUM WITH AN ARM OF A COMPILE-TIME TYPE IS A COMPILE-TIME SUM: the literal
# type has no run-time form, so no value of the sum can be made. It may be
# declared and named, and it bounds a generic parameter (`anyint` does); only
# making a value of it is refused -- an arm's construction, or the type's name
# read as a value.
small: variant { :intliteral :u8 }

# same -- the value it is given, of any type `small` admits
same: function as { t: small.generic } in {x: t} out t is {
    return x
}

main: function is {
    print "\{same x: 7.u8}"
    a: small.u8 7
    c: anyint.i64 5
    print "\{a.u8} \{c.i64}"
}
