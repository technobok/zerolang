# facet_reftype_conformer.z -- A FACET IS CONFORMED BY A VALTYPE. A facet value
# holds its conformer INLINE, in a union, so a reference conformer would put a
# reference inside a value -- the one thing a valtype may never hold.
#
# The stdlib already splits the two by family: `valhashable` is a FACET and
# `RefHashable` is a PROTOCOL, the same constraint for the two kinds of key.
#
# It was accepted and then emitted C that does not compile, at every use. The
# emitter skips a non-record impl when it emits a facet's conformance helpers
# -- its comment said "catching that is front-end work" -- so nothing wrote
# `z_t104_m_create`, and every site that builds the facet value called a
# function that is not there:
#
#     f: sizer.create from: d      ==> z_t104_m_create(&z_v2)
#     via s: d                     ==> the same, inside the argument
#     error: implicit declaration of function 'z_t104_m_create'
#
# A typedef takes its base's family, so a typedef over a class is a reference
# type too.
#
# `Cat` is the plain class, `Kitten` a typedef over it and `Shape` a union.
# The test is the FAMILY, so a union conformer is refused in the same words.
sizer: facet {
    size: function {:this} out i64
}

Cat: class { x: i64 } as {
    m: sizer
    size: function {p: this} out i64 is {
        return p.x
    }
}

Kitten: typedef Cat as {
    k: sizer
    size: function {p: this} out i64 is {
        return 7
    }
}

Shape: union {
    sq: String
    none: null
} as {
    m: sizer
    size: function {p: this} out i64 is {
        return 3
    }
}

main: function is {
    b: Cat x: 1
    d: Kitten (Cat x: 5)
    s: Shape.sq "x".string
    print "\{b.size} \{d.size} \{s.size}"
}
