# A guard keeps the handle it locked through: a second lock through the same
# handle while the guard lives would wait for itself forever, and is refused.
# Two handles to one Mutex (`share`) may each lock; the second waits at run
# time for the first.

main: function is {
    m: (sync.Mutex (ListVal i64)).create value: ListVal i64
    g1: m.lock
    g2: m.lock
    g1.value.append 1
}
