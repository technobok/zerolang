# a default written as a bare integer literal is an i64, as the declaration's
# type is, so a decimal past i64 is refused where it is written; the converted
# form is the u64 it means. The record's field printed -1.
slot: record {
    v: 18446744073709551615
    w: 18446744073709551615.u64
}
shift: function {by: 9223372036854775808} out u64 is {
    return 0
}
main: function is {
    c: slot
    print "\{c.v} \{c.w} \{shift}"
}
