# A conformance to a generic protocol or facet names the INSTANCE the type
# conforms to, `g: (Getter v: i64)`, and is checked against that instance's
# own methods. The generic spec itself names no interface a type can
# implement: `getter: Getter.implement` and `g: Getter.implement` are refused
# at the marker, which is shown the instance form -- nothing is inferred from
# the methods.
Getter: protocol {
    get: function {t: this.view} out v
} as {
    v: anyval.generic
}

Bare: class { n: i64 } as {
    getter: Getter.implement
    get: function {t: this.view} out i64 is { return t.n }
}

Named: class { n: i64 } as {
    g: Getter.implement
    get: function {t: this.view} out i64 is { return t.n }
}

# the instance says u8, the method returns i64
Wrong: class { n: i64 } as {
    g: (Getter v: u8).implement
    get: function {t: this.view} out i64 is { return t.n }
}

# without the parentheses the grammar reads `v: i64` as a second item: an
# alias of i64, which the generic spec still lacks its instance for
Unparenthesised: class { n: i64 } as {
    g: Getter.implement v: i64
    get: function {t: this.view} out i64 is { return t.n }
}

Unknown: class { n: i64 } as {
    g: (Getter v: nosuch).implement
    get: function {t: this.view} out i64 is { return t.n }
}

main: function is {
    a: Bare n: 1
    b: Named n: 2
    c: Wrong n: 3
    d: Unparenthesised n: 4
    e: Unknown n: 5
    print "\{a.n}"
}
