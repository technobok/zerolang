# A refusal names the family of the bound the template declares: the nested
# unit's `Wide` is a union, so an i64 is refused as a value type. The reason was
# read off the file unit's `Wide`, a variant, which admits value types, so the
# refusal gave none.
Wide: variant { :i64  :i32 }

x: unit {
    Wide: union { :String  :null }

    pick: function as { T: Wide.generic } in {v: T} out T is {
        return v
    }

    run: function out i64 is {
        return (pick v: 3)
    }
}

main: function is {
    print "\{x.run}"
}
