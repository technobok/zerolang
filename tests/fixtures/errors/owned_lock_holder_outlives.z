# owned_lock_holder_outlives.z -- an OWNED value that holds locks -- a
# construction over a borrow -- moving into a place that outlives the source
# is refused, whether it is reassigned to a local, stored into a field, or
# passed to a taking argument.

W: class {
    # the borrowed source
    s: String.borrow
}

Holder: class {
    # the stored value
    w: (Option W)
}

main: function is {
    x: (Option.none W)
    h: Holder w: (Option.none W)
    lists: (List W)
    {
        src: "a string long enough to live on the heap".string
        w1: W s: src
        x = Option.some w1
        w2: W s: src
        h.w = Option.some w2
        lists.append from: (W s: src)
    }
    print "\{lists.length}"
}
