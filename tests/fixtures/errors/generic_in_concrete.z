# A concrete function signature cannot reference a type parameter. `t` names
# nothing here -- no enclosing declaration owns it -- so the argument does not
# resolve, and the shell that used to stand in for it was a name with no
# definition behind it: a struct field or parameter of a type the C never
# declares. The refusal names the argument rather than letting a later
# mismatch describe the fiction.
probe: function {x: (List T: t)} out i64 is {
    return 1
}

main: function is {
    print "\{probe x: 1}"
}
