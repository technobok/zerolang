# E0200: 's' reads 'e.label'. Replacing that field frees the string 's' points
# at -- this compiled clean and heap-use-after-freed before writes consulted
# shared locks.
Item: class {
    label: String
    value: i64
}
peek_label: function {b: Item.view} out String.view is {
    return b.label
}
main: function is {
    e: Item label: "echo".string value: 5
    s: peek_label e
    e.label = "replaced".string
    print "\{s}"
}
