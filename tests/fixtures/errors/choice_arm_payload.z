# E0100: a choice's arm carries nothing or a static value. A String, a
# StringView (with the hint that a choice's string is text), a record, a class
# and a runtime collection are each refused; an arm declared by a string literal
# is told to name its payload's type, text.
pt: record { x: u8 }
Box: class { v: u8 }

form: choice {
    s: String
    v: StringView
    lit: ""
    p: pt
    c: Box
    l: ListVal u8
}

main: function is {
    print "x"
}
