# E0100: a record or class that declares no fields is refused where it is
# written -- and only there. Refused inside an inline unit, it also used to be
# left out of the unit, so every use through the unit (`kit.Mark`) added
# "unit 'kit' has no member 'Mark'"; a top-level one never did. The definition
# still resolves, as the fieldless type it was written as.
kit: unit {
    Mark: class {
    } as {
        size: function {:this} out u64 is { return 1 }
    }
    inner: unit {
        Flag: record {
        } as {
            isOn: function {f: this} out bool is { return true }
        }
    }
}

main: function is {
    m: kit.Mark
    f: kit.inner.Flag
    print "\{m.size} \{f.isOn}"
}
