# E0300: the dot in a call of a GENERIC method supplies the receiver as it does
# for any method, so naming the receiver parameter as well supplies it twice --
# reported in the same words as for a concrete method, not as a label the
# method does not have.
Box1: class {
    n: i64
} as {
    pick: function {:this v: t} out t is {
        return v
    } as {
        t: anyval.generic
    }
}
main: function is {
    b: Box1 n: 1
    c: Box1 n: 2
    print "\{b.pick this: c v: 5}"
}
