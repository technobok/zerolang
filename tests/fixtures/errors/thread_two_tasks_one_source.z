# thread_two_tasks_one_source.z -- two running tasks cannot both borrow one
# source: each may write it, and they run at once.

# Summer -- sums a list its owner lends it
Summer: class {
    # the borrowed input
    xs: (ListVal i64).borrow
    # the answer
    total: i64
} as {
    task: thread.Task
    call: function {:this} is {
        for each x: this.xs loop this.total = this.total + x
    }
}

main: function is {
    xs: ListVal i64
    xs.append 1
    h1: thread.spawn task: (Summer xs: xs total: 0)
    h2: thread.spawn task: (Summer xs: xs total: 0)
}
