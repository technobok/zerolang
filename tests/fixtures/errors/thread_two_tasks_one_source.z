# thread_two_tasks_one_source.z -- two running tasks cannot both borrow one
# source: each may write it, and they run at once.

# Summer -- sums a list its owner lends it
Summer: class {
    # the borrowed input
    xs: (ListVal i64).borrow
} as {
    task: (thread.TaskVal i64)
    call: function {:this} out i64 is {
        total: 0.i64
        for each x: this.xs loop total = total + x
        return total
    }
}

main: function is {
    xs: ListVal i64
    xs.append 1
    h1: thread.spawnVal task: (Summer xs: xs)
    h2: thread.spawnVal task: (Summer xs: xs)
}
