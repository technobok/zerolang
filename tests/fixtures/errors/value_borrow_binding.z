# A binding of a VALUE type is an owned copy, so `b: p.borrow` borrowed
# nothing: `p` stayed free to write, and `b` went on reading the value it
# copied. The marker said a borrow that does not happen, so it is refused --
# for a record, a variant, a number and a field alike. A `.borrow` parameter,
# which is passed by reference, still refers to the caller's value.
pt: record { x: i64 }

kd: variant { k: i64  z: null }

Box: class { p: pt }

bump: function {q: pt.borrow} is { q.x = q.x + 1 }

main: function is {
    p: pt x: 29
    a: p.borrow
    k: kd.k 3
    b: k.borrow
    bx: Box p: (pt x: 5)
    c: bx.p.borrow
    n: 7
    d: n.borrow
    bump q: p
    print "\{a.x} \{p.x} \{c.x} \{d}"
}
