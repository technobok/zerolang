# private_view_field_write.z -- a `.private.view` FIELD is readonly: the holder may not
# write through it (E0200).
Bag: class { a: i64 } as {
    public: unit { :lend }
    lend: function {:this} out i64 is { return (friend h: this.private) }
    bump: function {:this} is { this.a = this.a + 1 }
}

Viewer: class { h: Bag.private.view } as {
    set: function {:this} is { this.h.a = 7 }
}

friend: function {h: Bag.private.view} out i64 is {
    v: (Viewer h: h.private)
    v.set
    return 0
}

main: function is {
    b: (Bag a: 5)
    print "\{b.lend}"
}
