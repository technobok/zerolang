# E0200: a `view` parameter cannot be handed on to a mutable parameter --
# capability may only be given up, never regained.
Item: class { value: i64 }
mutate: function {t: Item} is {
    t.value = 9
}
peek: function {c: Item.view} is {
    mutate t: c
}
main: function is {
    e: Item value: 5
    peek c: e
    print "\{e.value}"
}
