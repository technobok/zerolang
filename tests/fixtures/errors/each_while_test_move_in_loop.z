# each_while_test_move_in_loop -- The `while` test of a `for each` loop runs before
# every iteration, unlike the `each` binding's value, which runs once: a move there
# reaches the next one.
eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}

main: function is {
    e: (ListVal u32)
    e.append 1
    ys: (ListVal i64)
    ys.append 5
    ys.append 6
    n: 0
    for each y: ys while (eat xs: e) loop {
        n = n + y
    }
    print "\{n}"
}
