# E0200: a GENERIC `outx` callee keeps a valtype passed to its `.view` parameter
# locked, as a concrete one does.
headG: function as {
    t: anyval.generic
} in {
    s: (str to: 8).view
    tag: t
} outx StringView is {
    return s.stringView
}

main: function is {
    s: "abc".str to: 8
    v: headG :s tag: 1
    s = "zzz".str to: 8
    print "\{v}"
}
