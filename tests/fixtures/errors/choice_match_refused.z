# E0036/E0100: a compile-time `match` on a choice value checks its arms as a
# variant's: every arm covered or an `else`, no arm the choice does not have,
# none matched twice.
form: choice {
    call: null
    template: text
    count: intliteral
}
a: (form.template "tpl")
x: match (a) case template then a case count then 1
y: match (a) case nope then 1 else 2
z: match (a) case template then 1 case template then 2 else 3
main: function is {
    print "\{x} \{y} \{z}"
}
