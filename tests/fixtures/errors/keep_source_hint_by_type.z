# A refused move of a borrowed name offers `.copy` only where the type has
# one: a class declaring `copy` is offered it, a class with no duplicate and a
# list of Strings (whose elements would be owned twice) are offered nothing,
# and a String (whose `copy` is native) is offered it.
Plain: class {
    n: i64
}

Dup: class {
    n: i64
} as {
    copy: function {t: this.view} out Dup is {
        return (Dup n: t.n)
    }
}

usePlain: function {p: Plain} is {
    q: p.take
    print "\{q.n}"
}

useDup: function {d: Dup} is {
    e: d.take
    print "\{e.n}"
}

useString: function {s: String} is {
    t: s.take
    print t
}

useList: function {l: List String} is {
    m: l.take
    print "\{m.length}"
}

main: function is {
    usePlain p: (Plain n: 1)
    useDup d: (Dup n: 2)
    useString s: "three".string
    xs: List String
    useList l: xs
}
