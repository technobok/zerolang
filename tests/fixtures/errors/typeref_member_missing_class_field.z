# typeref_member_missing_class_field.z -- a class field typed `Bag.bogus` is reported
# even when its owner is demanded before `Bag` is: the check waits for the drain
# that resolves `Bag`. It used to peel silently to `Bag`.
Bag: class { a: i64 }

Box: class { b: Bag.bogus }

main: function is {
    x: (Box b: (Bag a: 4))
    print "\{x.b.a}"
}
