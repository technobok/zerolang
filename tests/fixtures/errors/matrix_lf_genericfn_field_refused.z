    one: ListVal i64
    one.append 1
    vs: for each q: one loop (hk.f v: (lfGFirst s: o.s))
    o.s = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz".string
    return (if ((vs.get i: 0).startsWith prefix: "abc") then 7 else 0)
}

