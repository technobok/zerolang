# A MONO PRESENTS EXACTLY THE CONCRETE TYPE'S INTERFACE. `.copy` written on a
# StringView is refused -- a view is copied by assignment and `.string` is what
# allocates -- so reaching one through a template must be refused identically.
# It was not: the instance walk waived the refusal for a view and lowered the
# copy to a bare descriptor assignment, aliasing the source bytes, and the
# template's contract then differed by instantiation -- an OWNING String at
# T=String, a BORROWING view here, from the same source text.
#
# The caret lands on the template's own `v.copy`, which is where the mistake is.
dupper: unit as {
    t: anyval.generic
    dup: function {x: t} out t is {
        return x.copy
    }
}

ds: (dupper t: StringView)

main: function is {
    sv: "hello"
    print "\{ds.dup x: sv}"
}
