# E0600: a unit-level definition whose value names the definition itself --
# directly, through another definition, or as a type argument of its own
# instantiation -- has no value and no type to give. Each is reported once, at
# the definition, when something uses it. The compiler recursed without bound
# on every one of these and died on its stack. An unused one is not looked at,
# as no unused definition is (the `idle` ones below add nothing), and --eager
# checks them all.
Wrap: record {
    v: t
} as {
    t: anyval.generic
}

bar: function {n: i64} out i64 is {
    return n
}

foo: bar foo
paren: (bar paren)
ping: bar pong
pong: bar ping
Strs: (List Strs)
W: (Wrap t: W)

idleCall: bar idleCall
idleInfix: 1 + idleInfix
IdleT: (List IdleT)

main: function is {
    a: foo
    b: paren
    c: ping
    s: Strs
    w: W v: 1
    print "x"
}
