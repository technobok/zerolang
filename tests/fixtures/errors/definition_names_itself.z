# E0600: a unit-level definition whose value names the definition itself --
# directly, through another definition, or as a type argument of its own
# instantiation -- has no value and no type to give. Each is reported once,
# at the definition. The compiler recursed without bound on every one of
# these, used or not, and died on its stack.
Wrap: record {
    v: t
} as {
    t: anyval.generic
}

foo: bar foo
paren: (bar paren)
ping: bar pong
pong: bar ping
Strs: (List Strs)
W: (Wrap t: W)

main: function is {
    print "x"
}
