# A protocol or a facet declares its generic parameters in its body, beside
# the methods they type. Written in `as` instead, the parameter was read as a
# constant: the protocol was not generic, its method returned a type nothing
# named, and a use of it named an instance of nothing.
Getter: protocol {
    get: function {t: this.view} out v
} as {
    v: anyval.generic
}

Sized: facet {
    size: function {t: this.view} out n
} as {
    n: anyval.generic
}

useGetter: function {g: Getter.view} out i64 is { return 0 }

useSized: function {s: Sized} out i64 is { return 0 }

main: function is {
    g: useGetter.take
    s: useSized.take
    print "declared"
}
