# generic_unit_view_return_locks.z -- a generic unit's function that returns a
# view (`outx String.view`) keeps its source locked through the unit's instance
# exactly as it does through a plain unit: the instance's copy of the function
# carries the template's return markers.
wrap: unit as {
    t: anyval.generic
    Item: class {
        label: String
        n: t
    }
    peek: function {it: Item.view} outx String.view is {
        return it.label
    }
}
w: (wrap t: i64)

main: function is {
    e: w.Item label: "echo".string n: 1
    s: w.peek it: e
    e.label = "x".string
    print "\{s}"
}
