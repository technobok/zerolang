# A unit-level constant is range-checked exactly as an in-body one is. It was
# not: resolveDottedConstantDef resolved the suffix as a TYPE and checked
# nothing, so this was accepted, emitted `uint8_t z_v1 = 300;` and printed 44.
# gcc's -Woverflow was the only thing that noticed, and warn-check covers only
# the four emitted drivers.
big: 300.u8

main: function is {
    v: big
    print "v=\{v}"
}
