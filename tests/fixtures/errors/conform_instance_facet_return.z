# conform_instance_facet_return.z -- a generic RECORD conforming to a facet is
# checked per instance too: `size` returns `t`, the spec's u64 only when t is
# u64. The template itself is not checked -- its methods are generic and no
# instance's signature is known until the instance exists.
sizer: facet {
    size: function {t: this.view} out u64
}
pr: record {
    a: t
} as {
    t: anyval.generic
    m: sizer
    size: function {t: this.view} out t is {
        return t.a
    }
}
measure: function {z: sizer} out u64 is {
    return z.size
}
main: function is {
    p: pr a: 3.u64
    q: pr a: 3.u16
    print "\{measure z: p} \{q.size}"
}
