# The one lock an `if` value's arms make covers `o` exclusive: a write to a part
# of `o` while the value lives is refused, once.
Inner: class {
    n: i64
}

Outer: class {
    f: Inner
    r: Inner.borrow
}

pick: function {c: bool} is {
    x: Inner n: 1
    o: Outer f: (Inner n: 3) r: x
    w: Outer f: (Inner n: 4) r: o.f
    b: if c then o else w.take
    o.f = Inner n: 9
    print "\{b.f.n}"
}

main: function is {
    pick c: true
}
