# A move inside an arm of an `if` nested in a bare block is a move on the
# path that falls out of the block: the later read is use-after-move. The
# post-if re-invalidation carried no location, so the block's close dropped it.
yep: function out bool is {
    return true
}
main: function is {
    m: "abc".string
    {
        if yep then {
            b: m.take
            print "\{b.length}"
        }
    }
    print "\{m.length}"
}
