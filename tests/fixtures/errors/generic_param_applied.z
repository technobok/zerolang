# A generic parameter stands for one type, which takes no type arguments: `t t`
# and `t i64` are refused at the parameter, as `i64 i64` is at `i64`.
#
# They were not. The type named a shell, `t_t`, which nothing defines: a
# parameter's C named an undeclared type and a field's value could not be
# printed.
Gen: class {
    val: t i64
} as {
    t: anyval.generic
    same: function {g: this v: t t} out i64 is {
        return 1
    }
}

main: function is {
    g: Gen t: i64 val: 3
    print "\{g.same v: 9}"
}
