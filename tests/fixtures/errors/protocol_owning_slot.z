# E0100 / E0200: a conformer stands in for a protocol implicitly only where the
# value is BORROWED. A place that owns what it is given -- a constructor field,
# a `.take` parameter, a list slot, a reassignment, a return -- refuses a bare
# conformer, and says how to box one that owns it. A borrowed box (`from:
# x.borrow`) cannot be moved into one either.
Shape: protocol {
    area: function {t: this.view} out u64
}
Sq: class { side: u64 } as {
    :Shape
    area: function {t: this.view} out u64 is { return t.side * t.side }
}
Holder: class { s: Shape }

keep: function {s: Shape.take} out u64 is { return s.area }
give: function {q: Sq.take} out Shape is { return q }

main: function is {
    q: Sq side: 2
    # a constructor field
    h: Holder s: (Sq side: 3)
    # a `.take` parameter
    print "\{keep s: q}"
    # a list slot
    xs: List Shape
    xs.append (Sq side: 4)
    # a reassignment
    r: Sq side: 5
    h.s = r
    # a borrowed box moved into an owning place
    b: Sq side: 6
    h.s = Shape.create from: b.borrow
    print "\{(give q: (Sq side: 7)).area} \{h.s.area} \{xs.length}"
}
