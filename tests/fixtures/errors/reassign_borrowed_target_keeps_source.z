# E0200: a borrowed local is refused as a reassignment target, and the refused
# write moves nothing -- `d` stays usable after it, with no second error.
Cell: class { n: i64  s: String }
main: function is {
    a: Cell n: 1 s: "a".string
    d: Cell n: 2 s: "d".string
    b: a
    b = d.take
    print "\{d.n} \{b.n}"
}
