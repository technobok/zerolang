# A generic type's bare name is no type: a type position names it with its
# arguments, or inside the type's own members as `type`, the instance being
# checked. Each position is refused where the name is written: its own
# member's parameter, a type argument in its own body and its own return;
# another type's field, a free function's parameter and its return.
Box: record { val: t } as {
    t: anyval.generic
    same: function {:this rhs: Box} out bool is { return true }
    many: function {:this} out u64 is {
        xs: ListVal Box
        return xs.length
    }
    twin: function {:this} out Box is { return this }
}
Holder: record { n: i64  b: (optionval t: Box) }
look: function {b: Box.view} out i64 is { return 1 }
mk: function out Box is { return ((Box t: i64) val: 1) }
main: function is {
    a: (Box t: i64) val: 1
    print "\{a.same rhs: a} \{a.many} \{a.twin.val}"
    hs: ListVal Holder
    print "\{hs.length} \{look b: a} \{mk.val}"
}
