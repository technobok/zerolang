# E0034: a list written where a member's type goes -- a data field, a record
# field, a class field, a parameter -- is the member's default, and its type is
# the list's. An empty list has no element to give it one, so it names its type
# (`list {} out staticlist text`), or the declaration is refused.
row: data { needs: list {} }
holder: record { xs: list {} }
Box: class { xs: list {} }
f: function {p: list {}} is { print "y" }

main: function is {
    print "x"
}
