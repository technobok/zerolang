# E0100: a list written where a member's type goes -- a data field, a record
# field, a class field, a parameter -- is the member's default, and a default is
# a number, a string, an arm or a function, so the declaration is refused rather
# than the member typed by nothing.
row: data { needs: list { 1 2 } }
holder: record { xs: list { 1 2 } }
Box: class { xs: list {} }
f: function {p: list { 1 }} is { print "y" }

main: function is {
    print "x"
}
