# E0200: a `hold` field is frozen -- the slot is an ordinary one, but the value
# in it is readonly, so a mutating method on the field is refused. Reading it,
# and reassigning the slot with `b.name = other`, both stay legal.
Box: class {
    name: String.hold
    value: i64
}
main: function is {
    b: Box name: "n".string value: 1
    b.name.append "x"
    print "\{b.name}"
}
