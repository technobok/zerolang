# A string default is a StringView of static memory. Two string shapes are built
# at run time instead, and so are no default: an interpolation, and an owned
# copy (`.string`, `.copy`), which allocates. Each is refused where it is
# written.
n: 3

f: function {a: "x\{n}" b: "y".string c: "z".copy} is {
    print "\{a}"
}

main: function is {
    f
}
