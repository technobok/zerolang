# A marker names a storage transfer, and a name that holds no storage is
# refused with the way to write what was meant: a constant is written without
# a marker, and a method's reference is taken off the type with `.copy`.
K: 5

point: record {
    x: i64
} as {
    add: function {:this rhs: i64} out i64 is {
        return this.x + rhs
    }
}

main: function is {
    x: K.take
    a: point x: 1
    f: a.add.take
}
