# A MATCH MAY OMIT ONLY THE ARMS ITS SUBJECT CAN NO LONGER HOLD. A name bound
# from a payload-less arm, and one a diverging guard ruled an arm out of, each
# need fewer arms -- until a write that can reach the match gives the name any
# value of its type again. Both matches below omitted an arm the value may now
# hold, and were accepted.
U: union {
    some: String
    none: null
}

T: union {
    a: String
    b: String
    c: null
}

constructed: function {flip: bool} is {
    e: U.none
    if flip then {
        e = U.some "y".string
    }
    match (
        e
    ) case none then print "none"
}

excluded: function {o: T.take flip: bool} is {
    if o.c then return
    if flip then {
        o = T.c
    }
    match (
        o
    ) case a then print "a" case b then print "b"
}

main: function is {
    constructed flip: true
    excluded o: (T.a "x".string) flip: true
}
