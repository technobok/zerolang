# E0600: a data value built from a field of itself -- directly, or through
# another value -- has no value to give, and is reported once, at the
# definition the fold reaches first.
inner: data { v: u8 }
a: (inner v: b.v)
b: (inner v: a.v)
c: (inner v: c.v)

main: function is {
    print "\{a.v} \{c.v}"
}
