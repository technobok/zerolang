# `eat w: w.take` hands a lock-holding value to a `.take` parameter of a
# function that is not `outx`: the locks have nowhere to go, as with a bare
# `w` (lock_transfer_take_free_function). Refused -- copy it first.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

eat: function {w: W.take} out i64 is {
    return w.tag
}

main: function is {
    a: Src n: 1
    w: mk from: a
    print "\{eat w: w.take}"
}
