# literal_malformed.z -- a numeric lexeme that spells no number is refused
# where it is written (E0009), a statement's value included: a character
# literal of two characters or an unknown escape, a digit its base lacks, and
# a prefix with no digits. Each used to pass the checker and reach the
# emitter (E0500) or, for 0x, the C compiler.

main: function is {
    0caa
    a: 0c\q
    b: 0xzz
    c: 0b102
    d: 0x
    print "\{a} \{b} \{c} \{d}"
}
