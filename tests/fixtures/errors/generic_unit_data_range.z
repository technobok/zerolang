# generic_unit_data_range.z -- a generic unit's data block is each instance's
# own, its elements checked against the instance's element type: 300 fits the
# i64 instance and is refused for the u8 one, with a note naming that instance.
cells: unit as {
    t: anyval.generic
    vals: data { 2 3 300 } out intdata t
    get: function {i: u64} out t is { return (vals.index :i) }
}
ci: (cells t: i64)
cu: (cells t: u8)

main: function is { print "\{ci.get i: 2} \{cu.get i: 1}" }
