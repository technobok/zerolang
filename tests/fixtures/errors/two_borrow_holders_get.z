# E0200: two holders cannot both `.borrow` one list. Were the second accepted,
# an element read through the first (`e` points into the list's buffer) would
# dangle once an append through the second grows the buffer: a use-after-free
# under SHARED borrows, reproduced under ASan.
H: class {
    xs: (List String).borrow
}

main: function is {
    src: (List String)
    src.append from: "a".string
    h1: H xs: src
    h2: H xs: src
    e: h1.xs.get i: 0
    i: 0.u64
    for i < 64 loop {
        h2.xs.append from: "grow".string
        i = i + 1
    }
    print "\{e}"
}
