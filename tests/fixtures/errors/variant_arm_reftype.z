# E0100: a valtype holds value data only. A variant arm may not carry a
# reftype payload; a null arm and a valtype arm are what a variant holds.
# Make the type a union, whose arms are the Box rule's business.
pt: record { x: i64 }
v: variant {
    none: null
    p: pt
    some: String
    list: (ListVal u64)
}

main: function is {
    w: v.none
    w
    print "x"
}
