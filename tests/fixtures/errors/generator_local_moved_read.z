# A generator's local is a local to the programmer, stored in the instance across
# suspensions: it moves as a local does, so a read of it later in the call that
# moved it is refused. The words name the storage the lowering gave it.
two: function {s: String.take n: u64} out u64 is {
    return s.length + n
}

Gen: generator as {
    call: function out u64 is {
        s: "gen".string
        yield (two s: s n: s.length)
        yield 0
    }
}

main: function is {
    for v: Gen loop print "gen \{v}"
}
