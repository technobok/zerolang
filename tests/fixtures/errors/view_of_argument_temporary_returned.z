# An owned value no name holds, lent to a call whose result keeps it locked, is
# an unnamed local of the statement's scope, as the receiver of such a call is.
# A result that reads it cannot leave the function: the value dies with the
# call. It used to be forgotten when the call's own scope ended, so the result
# kept nothing locked and a view of freed storage was returned.
mks: function {n: i64} out String is {
    return "x\{n}"
}

headOfView: function {s: String.view} outx StringView is {
    return s.stringView
}

bound: function out StringView is {
    h: headOfView s: (mks n: 1)
    return h
}

direct: function out StringView is {
    return (headOfView s: (mks n: 2))
}

main: function is {
    print (bound)
    print (direct)
}
