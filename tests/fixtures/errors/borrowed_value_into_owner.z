# A value read out of storage something else owns -- a reftype field, an element
# a call hands back -- is refused where it would move into storage that owns what
# it holds: a reassignment of an owned local or a field, a taking argument, a
# constructor field, a collection element. Both owners would free it.
Holder: class {
    p: String
    q: String
}

Box2: class {
    s: String
}

keep: function {s: String.take} out u64 is {
    return s.length
}

fieldIntoLocal: function {h: Holder} is {
    r: "init".string
    r = h.p
    print r
}

fieldIntoField: function {h: Holder} is {
    h.q = h.p
    print h.q
}

elementIntoLocal: function {l: (List String)} is {
    r: "init".string
    r = l.get i: 0
    print r
}

elementIntoArgument: function {l: (List String)} out u64 is {
    return (keep s: (l.get i: 0))
}

elementIntoField: function {l: (List String)} is {
    b: Box2 s: (l.get i: 0)
    print b.s
}

elementIntoList: function {l: (List String)} is {
    l.append from: (l.get i: 0)
}

main: function is {
    h: Holder p: "hp".string q: "hq".string
    l: List String
    l.append from: "e0".string
    fieldIntoLocal :h
    fieldIntoField :h
    elementIntoLocal :l
    print "\{elementIntoArgument :l}"
    elementIntoField :l
    elementIntoList :l
}
