# A `.private` parameter is a friend handle, and the grant is spelled at the
# call: an outsider passing a plain value would read `a` through it.
Bag: class { a: i64 count: i64 } as {
    public: unit { :count }
}

friendRead: function {h: Bag.private.borrow} out i64 is { return h.a }

main: function is {
    b: (Bag a: 42 count: 3)
    print "\{friendRead h: b}"
}
