# E0200: a `borrow` parameter is not owned, so `.take` has nothing to move --
# the caller still owns the value. The ownership question is the binding's,
# not its type's, so this holds for any type.
Inner: class {
    n: i64
}
poke: function {c: Inner.borrow} is {
    g: c.take
    print "n=\{g.n}"
}
main: function is {
    i0: Inner n: 1
    poke c: i0
}
