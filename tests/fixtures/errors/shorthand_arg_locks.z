# E0200: a `:name` shorthand argument takes the same call-scoped lock as the
# written-out `name: name` form. `b` is a view parameter, so it is readonly
# here, and handing it to a parameter that borrows mutably is refused whether
# it is written `b: b` or `:b`.
Box: class {
    n: i64
}
bump: function {b: Box} is { b.n = b.n + 1 }
peek: function {b: Box.view} is {
    bump :b
    print "n=\{b.n}"
}
main: function is {
    x: Box n: 1
    peek b: x
}
