# A NUMERIC GENERIC ARGUMENT IS A COMPILE-TIME INTEGER. A local, a type and a
# typed constant that does not convert without loss were each refused as a
# parameter the checker "cannot infer", or as a missing argument.
rec: record {
    x: i64
} as { n: u32.generic }

WIDE: 7.u64

build: function {k: u32} is {
    a: (rec n: k) x: 1
    b: (rec n: i64) x: 1
    c: (rec n: WIDE) x: 1
    print "\{a.x} \{b.x} \{c.x}"
}

main: function is {
    build k: 3
}
