# a typedef key takes `hash` and `==` from the first link of its chain that
# declares each. One that writes its own `==` must write its own `hash`: the
# base's hash knows nothing of the typedef's equality. One that hides `hash`
# is not a key at all.
Box: class { n: u64 } as {
    hash: function {t: this.view} out u64 is { return t.n }
    ==: function {t: this.view rhs: Box} out bool is { return t.n == rhs.n }
}
Odd: typedef Box as {
    ==: function {t: this.view rhs: Odd} out bool is { return (t.n % 2) == (rhs.n % 2) }
}
NoKey: typedef Box as { hash: null }
main: function is {
    m: MapRV Odd v: u64
    m.set key: (Odd (Box n: 2)) value: 1
    k: MapRV NoKey v: u64
    k.set key: (NoKey (Box n: 2)) value: 1
    print "\{m.length} \{k.length}"
}
