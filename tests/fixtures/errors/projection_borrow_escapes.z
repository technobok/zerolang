# `Speaker d.borrow` keeps `d` locked, so an `out` function cannot return it.
Speaker: protocol {
    speak: function {:this} out i64
}

Dog: class { n: i64 name: String } as {
    :Speaker
    speak: function {t: this} out i64 is { return t.n }
}

mk: function {d: Dog} out Speaker is {
    return (Speaker d.borrow)
}

main: function is {
    d: Dog n: 9 name: "rex".string
    s: mk :d
    print "\{s.speak}"
}
