# E0300/E0100: an argument to a concrete parameter of a generic function is
# checked against that parameter's type: a bool does not fit a u64, and an i64
# does not convert to one without loss.
wrap: function as { t: anyval.generic } in { v: t n: u64 } out u64 is {
    return n
}

main: function is {
    flag0: true
    print "\{wrap t: i64 v: 5 n: flag0}"
    k: 7
    print "\{wrap t: i64 v: 5 n: k}"
}
