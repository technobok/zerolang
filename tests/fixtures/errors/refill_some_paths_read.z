# E0200: a local moved out and refilled on only some paths holds nothing on the
# others, so it is not read after: an `if` with no `else`, a block a `break`
# may leave before the refill.
Cell: class { n: i64  s: String }
main: function is {
    x: Cell n: 1 s: "x".string
    y: x.take
    c: true
    if c then x = Cell n: 2 s: "r".string
    print "\{y.n} \{x.n}"
    w: Cell n: 3 s: "w".string
    z: w.take
    r: {
        if c then break
        w = Cell n: 4 s: "r".string
        1
    }
    print "\{z.n} \{w.n}"
}
