# A generic template that strikes off `==` or `hash` strikes it off for every
# instance: comparing one is an unknown member, and keying a set by one fails
# the `valhashable` bound.
NoEq: record {
    a: t
} as {
    t: anyval.generic
    ==: null
}

NoHash: record {
    a: t
} as {
    t: anyval.generic
    hash: null
}

main: function is {
    x: NoEq t: i64 a: 1
    y: NoEq t: i64 a: 1
    print "\{x == y}"
    s: SetVal (NoHash t: i64)
    print "\{s.length}"
}
