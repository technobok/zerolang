# A BORROWED NAME CANNOT BE SWAPPED, on either side, exactly as it cannot be
# reassigned: it is bound for its whole scope to storage it does not own. A
# borrowed parameter reached C that no compiler accepts, and a `with` alias of
# a field swapped the field's buffer out from under its owner -- a double free
# at run time.
Box: class {
    s: String
}

left: function {x: String} is {
    t: "t".string
    x swap t
}

right: function {x: String} is {
    t: "t".string
    t swap x
}

main: function is {
    a: "a".string
    left x: a
    right x: a
    b: Box s: "b".string
    t: "t".string
    with bs: b.s do {
        bs swap t
    }
    print "\{a} \{b.s} \{t}"
}
