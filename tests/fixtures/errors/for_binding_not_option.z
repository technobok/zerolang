# A plain `for` binding is evaluated at every iteration and ENDS THE LOOP by
# answering `none`, so it must answer an option. Nothing else ends a loop by
# itself: a counter, a string or a record bound here would run once per
# iteration and never stop. An iterator is not an option either -- its `call`
# is, and walking it is `for each`. A function REFERENCE is a value like any
# other and answers nothing until it is called.
pt: record { x: i64 y: i64 }

gen: function out optionval i64 is {
    return (optionval.none i64)
}

main: function is {
    for i: 0 while i < 3 loop {
        i = i + 1
    }
    for s: "hello".string while s.length > 3 loop null
    for p: (pt x: 1 y: 2) while p.x < 3 loop null
    for n: 5 loop print "\{n}"
    xs: ListVal i64
    for e: xs.iterate loop print "\{e}"
    f: gen.take
    for g: f loop print "\{g}"
}
