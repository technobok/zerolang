# A UNIT-LEVEL `if` IS A COMPILE-TIME CONSTANT, so every condition the fold
# reaches must fold. Each definition below has a condition that cannot: a name
# nothing declares, a comparison between an integer and a string, a run-time
# call, a `when` guard naming nothing, a second clause reached because the first
# is false, and a condition that is not a bool at all. Each was accepted, and
# the emitter spelled the definition's TYPE where its value belonged -- C no
# compiler takes.
LIMIT: 5

g: function {n: i64} out i64 is {
    return n
}

UNKNOWN: if GHOST > 9 then { 1 } else { 2 }

MISMATCH: if LIMIT > "nine" then { 5 } else { 6 }

CALLED: if (g n: 3) > 1 then { 1 } else { 4 }

GUARDED: if LIMIT > 1 when PHANTOM > 2 then { 1 } else { 2 }

REACHED: if LIMIT > 9 then { 1 } else if SPECTRE > 2 then { 2 } else { 3 }

NOTBOOL: if LIMIT then { 1 } else { 2 }

main: function is {
    print "\{UNKNOWN} \{MISMATCH} \{CALLED} \{GUARDED} \{REACHED} \{NOTBOOL}"
}
