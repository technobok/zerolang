# sync_guard_val_locks.z -- the value-type locks keep the rules of their
# reference twins: a guard keeps its MutexVal from moving, a name for a guard's
# value keeps the guard from writing until it ends, and a read guard's value
# is a view, which nothing may write.
span: record {
    lo: i64
    hi: i64
}

main: function is {
    m: (sync.MutexVal i64).create value: 1
    g: m.lock
    moved: m.take
    v: g.value
    g.set value: 2
    print "\{v}"
    rw: (sync.RwLockVal span).create value: (span lo: 0 hi: 1)
    r: rw.read
    s: r.value
    s.lo = 5
}
