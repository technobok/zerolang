# A binding declared BEFORE the source outlives it: moving a lock-holding value
# into it would leave the locks pointing at a dead source. Refused -- copy it.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

main: function is {
    x: W s: (Src n: 0) tag: 0 label: "empty".string
    {
        a: Src n: 1
        w: mk from: a
        x = w
    }
    print "\{x.tag}"
}
