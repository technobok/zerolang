# reserved_private_block.z -- a `private:` block cannot be declared: `private` is a
# keyword (E0033), and `private` already covers every member of the type.
vault: class { value: i64 } as {
    private: unit { :value }
    peek: function {:this} out i64 is { return this.value }
}
main: function is { with v: (vault value: 7) do print "\{v.peek}" }
