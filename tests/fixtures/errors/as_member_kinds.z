# An `as` member is a constant, an alias of a type, an implementation or a
# generic parameter: `extra: i64` and `Elem: String` name types, and are aliases
# of them, refused nothing. A bare name the type's own scope declares as
# something with no value, a field or a method, stops the search there with no
# value, never binding the unit's name of the same spelling. A read of a member
# whose value failed adds nothing to the failure's own report.
x: 7

cfg: record {
    x: i64
} as {
    extra: i64
    Elem: String
    twice: x * 2
    go: function {} out i64 is {
        return 1
    }
    V: go
    A: nope + 1
    FREM: 7.5 % 2.0
}

main: function is {
    c: cfg x: 1
    print "\{c.x} \{cfg.twice} \{cfg.V} \{cfg.A} \{cfg.FREM}"
}
