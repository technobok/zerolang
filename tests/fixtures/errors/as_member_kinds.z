# An `as` member is a constant, a conformance or a generic parameter. A type
# name that is none of them is refused -- a field belongs in the type's body --
# where `extra: i64` was silently nothing and `limit: page_size` became a field.
# A bare name the type's own scope declares as something with no value, a field
# or a method, stops the search there with no value, never binding the unit's
# name of the same spelling.
x: 7

cfg: record {
    x: i64
} as {
    extra: i64
    Elem: String
    twice: x * 2
    go: function {} out i64 is {
        return 1
    }
    V: go
    A: nope + 1
    FREM: 7.5 % 2.0
}

main: function is {
    c: cfg x: 1
    print "\{c.x} \{cfg.twice} \{cfg.V} \{cfg.A} \{cfg.FREM}"
}
