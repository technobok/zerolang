# A WRITE ENDS NARROWING FOR THE REST OF EVERY SCOPE IT CAN REACH, not only for
# the rest of its own block. Inside `case some` the bare name is the payload,
# and each function below writes it from a nested scope -- an `if` branch, a
# nested `match` arm, a plain block, a `with` body, a swap -- then reads the
# payload after that scope closed. The write's reset lived in the inner frame
# and died with it, so the narrowing came back and the read was accepted: the
# payload of a value that may no longer carry one.
U: union {
    some: String
    none: null
}

afterif: function {o: U.take flip: bool} is {
    match (
        o
    ) case some then {
        if flip then {
            o = U.none
        }
        n: o.length
        print "\{n}"
    } case none then null
}

aftermatch: function {o: U.take flip: bool} is {
    match (
        o
    ) case some then {
        match (
            flip
        ) case true then {
            o = U.none
        } case false then null
        n: o.length
        print "\{n}"
    } case none then null
}

afterblock: function {o: U.take flip: bool} is {
    match (
        o
    ) case some then {
        {
            o = U.none
        }
        n: o.length
        print "\{n}"
    } case none then null
}

afterwith: function {o: U.take flip: bool} is {
    match (
        o
    ) case some then {
        with f: flip do {
            if f then {
                o = U.none
            }
        }
        n: o.length
        print "\{n}"
    } case none then null
}

afterswap: function {o: U.take flip: bool} is {
    match (
        o
    ) case some then {
        spare: U.none
        if flip then {
            o swap spare
        }
        n: o.length
        print "\{n}"
    } case none then null
}

main: function is {
    afterif o: (U.some "a".string) flip: true
    aftermatch o: (U.some "b".string) flip: true
    afterblock o: (U.some "c".string) flip: true
    afterwith o: (U.some "d".string) flip: true
    afterswap o: (U.some "e".string) flip: true
}
