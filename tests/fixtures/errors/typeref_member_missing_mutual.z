# typeref_member_missing_mutual.z -- two classes whose fields each name a missing
# member of the other: both are reported, and the demand each makes of the
# other resolves without a cycle.
A: class { b: B.bogus }

B: class { a: A.bogus }

main: function is {
    x: (A b: (B a: 1))
    print "x"
}
