# A COMPILE-TIME `match` IS CHECKED AS A BODY'S IS: its subject must be an arm
# constant, each arm must name an arm of the subject's type and name it once,
# and a match with no else must cover every arm. The selected arm's `error` is
# reached. Every one of these reached the emitter ("unhandled interp part type").
mode: variant {
    fast: null
    slow: null
    eco: null
}

M: mode.eco
N: 5
S: "text"

NUMBER: match (N) case fast then { 1 } else { 2 }
STRING: match (S) case fast then { 1 } else { 2 }
UNKNOWN: match (M) case fast then { 1 } case nope then { 2 } else { 3 }
TWICE: match (M) case fast then { 1 } case fast then { 2 } else { 3 }
PARTIAL: match (M) case fast then { 1 } case slow then { 2 }
REACHED: match (M) case eco then { error "eco is not supported" } else { 1 }
GHOST: match (G) case fast then { 1 } else { 2 }

main: function is {
    print "\{NUMBER} \{STRING} \{UNKNOWN} \{TWICE} \{PARTIAL} \{REACHED} \{GHOST}"
}
