# A value of the scalar u8 assigned to a typedef the unit names `u8` too: the
# message spells each with the unit that declares it, or it would read "type
# 'u8' to 'u8'".

u8: typedef system.u8

marks: list { 5 6 } out staticlist u8

main: function is {
    for each m: marks loop {
        x: m
        x = 6.u8
        print "\{x.u64}"
    }
}
