# A list's position is a value of its element's type, and a value takes no
# arguments: an argument after `masks.2` or `rows.1` is refused where it stands,
# as one after a local or a field is.
#
# Neither was refused for that. A number list's position written with an
# argument reached the emitter, which stopped on E0500 "unhandled callee"; a
# data list's was checked as a construction of its element and refused for the
# element's fields.
row: data {
    key: text
}

masks: list { 0x01 0x80 0xFF00 }
rows: list { (row key: "a") (row key: "b") }

main: function is {
    k: masks.2 2
    r: rows.1 5
    print "\{k} \{r.key.stringView}"
}
