# const_match_no_held_arm_checks_arms -- a match on a unit constant that names no arm
# the constant holds, and has no else, folds to nothing: its arms are still checked
mode: variant {
    fast: null
    slow: null
    eco: null
}

K: mode.eco

main: function is {
    match K case fast then print missing case slow then print "slow"
    print "end"
}
