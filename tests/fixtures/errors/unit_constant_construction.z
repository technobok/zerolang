# unit_constant_construction.z -- a unit-level constant takes a LITERAL value.
# A construction is not one, in either spelling: bare (which the parser splits
# into `origin: Point.create` plus a separate constant `x: 0`) or parenthesised.
# The arm read is NOT a construction and stays legal -- it is the shape
# `false: bool.false` uses in core.z.
Point: record {
    x: i64
}

NO: bool.false

origin: Point.create x: 0

origin2: (Point.create x: 0)

main: function is {
    if NO then print "yes" else print "no"
}
