eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
nope: function out bool is {
    return false
}
# a bare name handed to a `.take` parameter moves it.
main: function is {
    e: (ListVal u32)
    e.append 1
    n: 0
    for while n < 3 loop {
        n = n + 1
        if (eat xs: e) then print "yes"
    }
}
