# the value a Box is made from is refused as an argument is when it does not
# land in the element type: a literal outside the type's range, and a value
# that would lose data in the conversion. The template's `t:` names a type, an
# instance takes no `t:`, and a Box takes no argument but its value, labelled
# `from:`.
point: record { x: i64 y: i64 }

BP: (Box point)

main: function is {
    a: (Box u8) from: 300
    s: 3.i16
    b: (Box u8) from: s
    c: Box t: u8 from: 256
    d: Box t: nosuch from: 5
    e: Box from: 5 x: 3
    p: point x: 1 y: 2
    f: BP t: point from: p
    g: BP p
    print "none"
}
