# `Speaker d.take` takes `d`: reading it afterwards reads a moved value. (An
# unmarked `Speaker d` bound to a name borrows `d` instead.)
Speaker: protocol {
    speak: function {:this} out i64
}

Dog: class { n: i64 name: String } as {
    :Speaker
    speak: function {t: this} out i64 is { return t.n }
}

main: function is {
    d: Dog n: 7 name: "rex".string
    s: Speaker d.take
    print "\{s.speak} \{d.n}"
}
