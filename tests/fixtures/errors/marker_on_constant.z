# A unit constant is its value at every reference and names no storage, so an
# ownership marker on one is refused, whatever the constant holds: a number, a
# string, another constant, or an arm. Each spelled the constant's NAME into the
# C, or took the address of its const static, or read an arm named `take`.
LIMIT: 9
GREETING: "hello, world"
SAME: GREETING
NO: bool.false
color: variant {
    red: null
    green: null
}
RED: color.red

eat: function {s: StringView.take} is {
    print "\{s}"
}

main: function is {
    a: LIMIT.take
    b: LIMIT.borrow
    c: LIMIT.hold
    d: GREETING.take
    e: GREETING.borrow
    f: SAME.take
    g: NO.take
    h: RED.take
    i: color.red.take
    eat s: GREETING.take
    print "\{a} \{b} \{c} \{d} \{e} \{f} \{g}"
}
