# match_unknown_arm_narrows_nothing -- an arm whose name is no arm of the subject
# narrows nothing: a write to the subject inside it does not end a narrowing laid before
# the match.
shape: variant {
    circle: i64
    square: i64
    dot: null
}
f: function {a: shape b: shape} out i64 is {
    x: a
    if x.dot then return 0
    match x case nosuch then {
        x = b
    } else null
    match x case circle then return x case square then return x
}
main: function is {
    print "\{f a: (shape.circle 1) b: (shape.dot)}"
}
