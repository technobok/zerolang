# A member named like a numeric generic parameter is refused: the type's `as`
# and body are one scope, and `r.cap` would read either. A record field took
# the name and a class field did too, both silently shadowing the parameter.
rec: record {
    cap: u32
    x: i64
} as { cap: u32.generic }

Box: class {
    cap: u32
    used: u32
} as { cap: u32.generic }

main: function is {
    r: (rec cap: 7) cap: 3 x: 1
    b: (Box cap: 5) cap: 3 used: 1
    print "\{r.x} \{b.used}"
}
