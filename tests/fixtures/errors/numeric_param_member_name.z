# A member named like a numeric generic parameter is refused: the parameter
# and the member would be one name. Within ONE definition -- a field beside an
# `as` parameter of that name -- the parser refuses it (its parameters and `is`
# and `as` members are one namespace; errors/definition_namespace). A type
# declared in a generic unit takes the unit's parameters as its own, which no
# single definition shows, so the checker refuses it there: a field took the
# name and silently shadowed the parameter.
buf: unit as {
    cap: u32.generic
    Cell: class { cap: u32  x: u8 }
    mk: function out Cell is {
        return (Cell cap: 1 x: 2)
    }
}

four: buf cap: 4

main: function is {
    c: four.mk
    print "\{c.x}"
}
