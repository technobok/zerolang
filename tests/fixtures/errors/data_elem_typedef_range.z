# A block whose `out` names a typedef holds the typedef's base: each element is
# range-checked against it, in the file unit and in a nested unit alike. The
# kind came from the type's NAME, so `w` named no numeric kind, nothing was
# checked, and 300 was stored in a u8 and printed 44.
w: typedef u8

d: data { 300  4 } out (intdata w)

x: unit {
    v: typedef i8

    e: data { 1  200 } out (intdata v)

    run: function out i64 is {
        return (e.index i: 0).i64
    }
}

main: function is {
    print "\{d.index i: 0}"
    print "\{x.run}"
}
