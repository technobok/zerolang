# A value type's parameter holds valtypes, so a bound that admits a reftype is
# refused where the parameter is declared -- however the bound is spelled: a
# name, a type application, and each of those reached through a unit.
Rd: protocol {
    rdn: function {t: this.view} out i64
}

Getter: protocol {
    v: anyval.generic
    get: function {t: this.view} out v
}

Holds: record {
    a: A
    b: B
    c: C
    d: D
} as {
    A: Rd.generic
    B: (Getter v: i64).generic
    C: pr.Rd.generic
    D: (pr.Getter v: i64).generic
}

main: function is {
    print "x"
}
