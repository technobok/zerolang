# E0200: `out T.view` hands back a READONLY reference into the receiver, so the
# binding it lands on may only be read.
Item: class {
    n: i64
}
Bag: class {
    a: Item
} as {
    peek: function {t: this.view} out Item.view is {
        return t.a
    }
}
main: function is {
    g: Bag a: (Item n: 1)
    x: g.peek
    x.n = 9
    print "x=\{x.n}"
}
