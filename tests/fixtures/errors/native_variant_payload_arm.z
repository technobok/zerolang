# a native variant may declare payload-LESS arms -- an arm is an ordinal, and
# `bool` is runtime-backed yet still has to spell `true` and `false` for code to
# match on. A PAYLOAD arm is storage, and the runtime owns a native type's
# layout, so declaring one is the same refusal a native record's field block
# gets from the grammar.
tri: variant is native { lo: null  mid: i64 }

main: function is {
    t: tri.lo
    match (t) case lo then print "lo" case mid then print "mid"
}
