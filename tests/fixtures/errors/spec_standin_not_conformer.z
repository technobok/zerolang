# E0100: a value written where a protocol or facet value is expected must
# conform to it. Anything else used to typecheck -- whatever its type -- and
# fail in the C compiler: the check skipped every spec-typed place.
Shape: protocol {
    area: function {t: this.view} out u64
}
measurable: facet {
    measure: function {t: this.view} out u64
}
Sq: class { side: u64 } as {
    :Shape
    area: function {t: this.view} out u64 is { return t.side * t.side }
}
Rock: class { w: u64 }
pebble: record { w: u64 }
Holder: class { s: Shape }

show: function {s: Shape} out u64 is { return s.area }
gauge: function {m: measurable} out u64 is { return m.measure }

main: function is {
    r: Rock w: 3
    # an argument of a type that does not conform
    print "\{show s: r}"
    # a literal
    print "\{show s: 5}"
    # a constructor field
    h: Holder s: (Rock w: 1)
    # a facet parameter
    print "\{gauge m: (pebble w: 2)}"
    # a reassignment
    h.s = Rock w: 4
    print "\{h.s.area}"
}
