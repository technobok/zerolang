# A tag accessor stores the discriminator as one of the system's integer
# types. A float storage was accepted and gave C a float `switch`; a record
# storage, the program's own `u8` included, either typed the accessor as that
# record or dropped it silently. Each is refused at its declaration.
u8: record {
    n: i64
}

pt: record {
    n: i64
}

kf: variant {
    a: i64
    b: i64
} as {
    tg: f64.tag
}

kp: variant {
    a: i64
    b: i64
} as {
    tg: pt.tag
}

ku: variant {
    a: i64
    b: i64
} as {
    tg: u8.tag
}

main: function is {
    f: kf.b 1
    p: kp.b 2
    u: ku.b 3
    print "made"
}
