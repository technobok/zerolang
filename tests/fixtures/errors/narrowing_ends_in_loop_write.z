# A WRITE IN A LOOP ENDS NARROWING FOR THE WHOLE LOOP AND AFTER IT. The second
# iteration reads what the first one wrote, so a read of the payload BEFORE the
# write in the body is a read of a replaced value; and the code after the loop
# sees whatever the last iteration, or a `break`, left. Each read below was
# accepted as the payload.
U: union {
    some: String
    none: null
}

readbefore: function {o: U.take flip: bool} is {
    match (
        o
    ) case some then {
        k: 0
        for k < 2 loop {
            n: o.length
            print "\{n}"
            o = U.none
            k = k + 1
        }
    } case none then null
}

readafter: function {o: U.take flip: bool} is {
    match (
        o
    ) case some then {
        k: 0
        for k < 2 loop {
            o = U.none
            k = k + 1
        }
        n: o.length
        print "\{n}"
    } case none then null
}

readaftercontinue: function {o: U.take flip: bool} is {
    match (
        o
    ) case some then {
        k: 0
        for k < 2 loop {
            k = k + 1
            n: o.length
            print "\{n}"
            if flip then {
                o = U.none
                continue
            }
        }
    } case none then null
}

readafterbreak: function {o: U.take flip: bool} is {
    match (
        o
    ) case some then {
        k: 0
        for k < 2 loop {
            if flip then {
                o = U.none
                break
            }
            k = k + 1
        }
        n: o.length
        print "\{n}"
    } case none then null
}

main: function is {
    readbefore o: (U.some "a".string) flip: true
    readafter o: (U.some "b".string) flip: true
    readaftercontinue o: (U.some "c".string) flip: true
    readafterbreak o: (U.some "d".string) flip: true
}
