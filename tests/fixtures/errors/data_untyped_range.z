# An untyped element lands where it is taken, checked by its VALUE: one the
# destination cannot hold is refused as the same literal would be.
sizes: data { small: 10 big: 300 }
halves: data { half: 0.5 }

byte: function {b: u8} out u8 is { return b }
whole: function {n: i64} out i64 is { return n }

main: function is {
    print "\{byte b: sizes.big} \{whole n: halves.half}"
}
