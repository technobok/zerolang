# A parameter given twice -- positionally and again by its label -- is refused on
# every call: a method, a generic function, a generic method, a native method.
# A receiver given twice is the receiver check's own report.
P: record {
    n: i64
} as {
    add: function {t: this.view x: i64} out i64 is {
        return t.n + x
    }
    gm: function as {u: anyval.generic} in {:this x: u} out u is {
        return x
    }
}

gf: function as {t: anyval.generic} in {x: t} out t is {
    return x
}

main: function is {
    p: P n: 1
    a: p.add 1 x: 2
    b: gf 1 x: 2
    c: p.gm 1 x: 2
    d: P.add p t: p x: 2
    s: "abc"
    e: s.startsWith "a" prefix: "b"
    print "\{a} \{b} \{c} \{d} \{e}"
}
