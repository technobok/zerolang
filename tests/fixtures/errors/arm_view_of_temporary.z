# arm_view_of_temporary.z -- a non-owned arm points into its payload's source,
# so its payload names storage: a temporary has none that outlives the
# statement, and is refused rather than copied into a cell nothing frees.

Inner: class { n: i64 }

Frozen: union {
    some: Inner.view
    none: null
}

main: function is {
    f: Frozen.some (Inner n: 1)
    match f case some then print "\{f.n}" case none then null
}
