# A pinning call on the right of a reassignment keeps its pins under the
# TARGET, exactly as a binding would. The value the target held is destroyed
# by the assignment, so its own pins go first: `a` is free again, `b` is not.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

main: function is {
    a: Src n: 1
    b: Src n: 2
    x: mk from: a
    x = mk from: b
    a.n = 10
    b.n = 20
    print "\{x.tag}"
}
