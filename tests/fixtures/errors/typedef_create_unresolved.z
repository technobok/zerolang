# typedef_create_unresolved.z -- the twin of arg_value_unresolved.z for a
# TYPEDEF constructor. `T.create from: expr` is an owned cast rather than a
# call, so it has its own checker leg, and that leg walked the from-argument
# but ignored a value that typed to 0 -- the same silent-disable the named,
# positional, constructor and method forms were fixed for. zc exited 0 and the
# emitter wrote the bare name into the C.
#
# Every id type in the compiler (ztypes.tid, vid, declid; zast.nameid, nodeid)
# is this shape, so every id construction was unchecked.

Tid: record { val: u64.typedef } as {
    isZero: function {:this} out bool is {
        return this.u64 == 0
    }
}

main: function is {
    a: (Tid.create from: ghostFrom)
    b: (Tid.create ghostPositional)
    print "\{a.u64} \{b.u64}"
}
