# arm_local_view_keeps_source.z -- an arm, a block or a `with` whose value is a
# view it declared itself hands that view's locks to what binds it: the local
# ends with its scope, its source does not. They were released with the local,
# so each binding here outlived the String it views.
main: function is {
    h: "xyz".string
    c: h.length > 1
    a: if c then {
        w: h.stringView
        w
    } else {
        x: h.stringView
        x
    }
    h = "replaced".string
    print a
    g: "xyz".string
    b: {
        y: g.stringView
        y
    }
    g = "replaced".string
    print b
    k: "xyz".string
    d: with z: k.stringView do z
    k = "replaced".string
    print d
}
