# A SUFFIXED LITERAL HAS ITS WIDTH IN A BODY as in a constant. It was coerced as
# a bare literal, its suffix ignored: `7.u8 + 7.u32` printed 14, an `i64`
# argument bound a u64 parameter, and a u16 constant a u8 one.
N: 5.u16

wide: function {c: u64} is {
    print "\{c}"
}

narrow: function {c: u8} is {
    print "\{c}"
}

main: function is {
    c: 7.u8 + 7.u32
    a: 5.u8
    d: a + 7.u32
    wide c: 8.i64
    narrow c: 8.u32
    narrow c: N
    print "\{c} \{d}"
}
