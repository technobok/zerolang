# thread_owner_uses_borrowed_source.z -- while a running task borrows a source,
# its owner may neither write nor read it (the task may be writing), nor drop it.

# Summer -- sums a list its owner lends it
Summer: class {
    # the borrowed input
    xs: (ListVal i64).borrow
    # the answer
    total: i64
} as {
    task: thread.Task
    call: function {:this} is {
        for each x: this.xs loop this.total = this.total + x
    }
}

main: function is {
    a: ListVal i64
    a.append 1
    h1: thread.spawn task: (Summer xs: a total: 0)
    a.append 2
    b: ListVal i64
    h2: thread.spawn task: (Summer xs: b total: 0)
    print "\{b.length}"
    c: ListVal i64
    h3: thread.spawn task: (Summer xs: c total: 0)
    c.drop
}
