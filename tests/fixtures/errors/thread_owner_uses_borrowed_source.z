# thread_owner_uses_borrowed_source.z -- while a running task borrows a source,
# its owner may neither write nor read it (the task may be writing), nor drop it.

# Summer -- sums a list its owner lends it
Summer: class {
    # the borrowed input
    xs: (ListVal i64).borrow
} as {
    task: (thread.TaskVal i64)
    call: function {:this} out i64 is {
        total: 0.i64
        for each x: this.xs loop total = total + x
        return total
    }
}

main: function is {
    a: ListVal i64
    a.append 1
    h1: thread.spawnVal task: (Summer xs: a)
    a.append 2
    b: ListVal i64
    h2: thread.spawnVal task: (Summer xs: b)
    print "\{b.length}"
    c: ListVal i64
    h3: thread.spawnVal task: (Summer xs: c)
    c.drop
}
