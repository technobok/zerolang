# E0200: a mutating method on a `hold` binding of a valtype: its exclusive
# receiver lock meets the binding's readonly self-lock.
counter: record { n: i64 } as {
    bump: function {:this} is {
        this.n = this.n + 1
    }
}

main: function is {
    c: counter n: 1
    h: c.hold
    h.bump
    print "\{h.n}"
}
