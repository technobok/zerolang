# A facet holds a COPY of its source, so a `.borrow` marker on the source of a
# facet projection borrows nothing: the facet keeps no reference to `p`, and
# `p` stays free to write. It was accepted and meant nothing; it is refused,
# in the bare form and the `create from:` form alike.
measurable: facet {
    measure: function {t: this.view} out i64
}

point: record { x: i64 } as {
    m: measurable
    measure: function {p: this.view} out i64 is { return p.x }
}

main: function is {
    p: point x: 3
    a: measurable p.borrow
    b: measurable.create from: p.borrow
    c: measurable p
    print "\{a.measure} \{b.measure} \{c.measure}"
}
