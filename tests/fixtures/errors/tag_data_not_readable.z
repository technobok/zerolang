# A tag whose values come from a data block IS declared, but the spec makes
# only a numeric tag source (`tag: u8.tag`) readable on an instance. The
# refusal names the block, not "declare it in the as block".
levels: list { LOW: 0  HIGH: 10 } out list u8

U: union { LOW: null  HIGH: null } as { tag: levels.tag }

main: function is {
    u: U.HIGH
    print "\{u.tag}"
}
