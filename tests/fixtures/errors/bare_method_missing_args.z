# A BARE METHOD REFERENCE IS A CALL MISSING ITS ARGUMENTS. `r.add` leaves a
# FUNCTION stamp that the emitter called with the receiver alone -- one argument
# into a two-parameter C function -- so the program was accepted at exit 0 and
# died in the C compiler. bareFnRefError already owned this message for a bare
# atom and for `unit.member`; the instance-method path declined to auto-call and
# reported nothing. Both value position and statement position are the same bug.
point: record {
    x: i64
} as {
    add: function {:this rhs: i64} out i64 is {
        return this.x + rhs
    }
}

main: function is {
    a: point x: 1
    y: a.add
    a.add
    print "\{y}"
}
