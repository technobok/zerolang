# require_target_guard.z -- a `require:` block can guard on the operating system
# the build is FOR, which is what --target names. The triple is PARSED into an
# oskind arm rather than substring-matched: `x86_64-w64-mingw32` contains no
# "windows" anywhere, so the old fold left platform.os describing the host and
# this guard silent. The flag rides in on the .zcargs sidecar; nothing is
# compiled on this path, so no cross compiler need exist for this to pass.
require: unit {
    library: if platform.os == platform.oskind.windows then {
        error "this unit has no Win32 backend"
    } else {
        "m"
    }
}

main: function is {
    print "unreachable"
}
