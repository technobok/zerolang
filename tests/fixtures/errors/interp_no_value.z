# An interpolation reads a value. Here `inst` is no instance of `lib`: the
# word after the closing parenthesis makes its value a call of the instance,
# which has no value, so a member read through it has none either. That read
# is refused; it used to pass the check and reach the emitter untyped.

# lib -- a unit over a type
lib: unit as {
    t: anyval.generic
    # says what it is
    describe: function out StringView is { return "lib" }
}

inst: (lib t: i32)
main main: function is {
    print "\{inst.describe}"
}
