# E0200: exactly ONE error -- the lock is on (o, a), so writing 'o.a.n' is
# rejected while the sibling writes 'o.b.n' and 'o.tag' stay permitted.
Inner: class { n: i64 }
Outer: class {
    a: Inner
    b: Inner
    tag: i64
}
main: function is {
    o: (Outer a: (Inner n: 1) b: (Inner n: 2) tag: 0)
    with v: o.a.borrow do {
        o.b.n = 9
        o.tag = 7
        o.a.n = 5
    }
    print "\{o.b.n} \{o.tag}"
}
