# A SHARED METHOD READ THROUGH ITS TYPE IS HANDED ITS RECEIVER AS AN ARGUMENT.
# Read with none, it auto-called with nothing to call it on, and the C bound a
# function pointer where the method's result was wanted.
Ruler: record {
    size: i64
} as {
    double: function {:this} out i64 is {
        return this.size * 2
    }
    scaled: function {r: this} out i64 is {
        return r.size * 3
    }
}

main: function is {
    a: Ruler.double
    b: Ruler.scaled
    print "\{a} \{b}"
}
