# E0300: the method bodies of a type an inline unit declares are checked, as
# a file unit's are -- this one adds a bool to an i64.
inl: unit {
    pt: record {
        x: i64
    } as {
        bad: function {a: this} out i64 is {
            return a.x + true
        }
    }
}
main: function is {
    p: inl.pt x: 1
    print "\{p.bad}"
}
