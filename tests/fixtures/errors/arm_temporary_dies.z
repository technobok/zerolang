# arm_temporary_dies.z -- an arm's value that views a temporary the arm made,
# which owns its string, is refused: the temporary dies with the arm. The
# report names it "a temporary", not the checker's own name for it.
lfFirst: function {s: String.view} outx StringView is {
    return (s.substring from: 0 to: 3)
}

main: function is {
    xs: List String
    xs.append "abc def".string
    k: xs.length > 0
    v: if k then lfFirst s: "temp text".string else lfFirst s: (xs.get i: 0)
    print v
}
