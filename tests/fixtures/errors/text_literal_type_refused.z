# E0100/E0300: textliteral is a compile-time type, so it is refused as the
# declared type of a parameter, a local or a run-time field; a run-time value
# never converts, so a StringView bound from a literal is no text.
takes: function {t: textliteral} is {
    print t
}
box: record { s: textliteral }
show: function {t: text} is {
    print t.stringView
}
main: function is {
    v: "abc"
    show t: v
}
