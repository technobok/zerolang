# E0100: a member access on a type-parameter-typed value in a function
# template body is checked in each instance; this one's i64 has no 'bogus',
# and the note names the instance and the call that made it.
f: function as { t: anyval.generic } in { v: t } out u64 is {
    x: v.bogus
    return 0
}

main: function is {
    r: f v: 5
    print "\{r}"
}
