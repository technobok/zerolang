# A bound that is an instance of a generic variant admits its arms' types and
# nothing else: a string, a StringView here, is neither `pick t: i64`'s `a`
# nor its `b`.
pick: variant {
    a: t
    b: u8
} as {
    t: anyval.generic
}

pickI: (pick t: i64)

show: function as { x: pickI.generic } in { v: x } out i64 is {
    return 1
}

main: function is {
    print "\{show v: "x"}"
}
