# E0300: a union or variant selects an arm, whether it is named bare or through
# its type arguments.
slot: variant {
    full: t
    empty: null
} as { t: anyval.generic }

Cell2: union {
    full: String
    empty: null
} as { T: AnyRef.generic }

SI: (slot t: i64)

main: function is {
    o: (Option T: String)
    v: (optionval t: i64)
    s: (slot t: i64)
    c: (Cell2 T: String)
    print "\{o.none} \{v.none} \{s.empty} \{c.empty}"
}
