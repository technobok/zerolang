# A generic class's list is each instance's own: an element the instance's
# type cannot hold is refused there, naming the instance.
Box: class {
    v: t
} as {
    t: anyval.generic
    vals: list { 2 300 } out staticlist t
    pick: function {b: this.view i: u64} out t is {
        return (vals.get :i)
    }
}

main: function is {
    b: (Box t: i64) v: 1
    print "\{b.pick i: 1}"
    c: (Box t: u8) v: 1
    print "\{c.pick i: 1}"
}
