# An RwLock lets several threads read what it holds at once (`thread.SharedReads`),
# so an RwLock over a `thread.Unshareable` Database cannot reach another thread:
# share a Database through a `sync.Mutex` instead.

# Reader -- reads through its handle to the lock
Reader: class {
    # the shared lock
    l: sync.RwLock sqlite.Database
} as {
    task: (thread.Task null)
    call: function {:this} is {
        g: this.l.read
        print "\{g.value.totalChanges}"
    }
}

main: function is {
    db: sqlite.openMemory
    if db.err then return
    l: (sync.RwLock sqlite.Database).create value: db.take
    h: thread.spawn task: (Reader l: l.share)
}
