# a window over a template's `(array t: u64 to: n)` is judged in each
# instance's walk, so a function typed over windows of another element type is
# refused there, as it would be for any (SpanVal u64)

# fillOnes -- every word of z set to 1
fillOnes: function {z: (SpanVal u32).borrow} is {
    z.fill item: 1
}

# a run of n words
vec: record {
    words: (array t: u64 to: n)
} as {
    n: u64.generic
    # n ones
    ones: function {} out type is {
        r: meta.create words: (array t: u64 to: n)
        fillOnes z: r.words.mutView
        return r
    }
}

main: function is {
    v: (vec n: 3).ones
    print "\{v.words.length}"
}
