# E0200: a `.borrow` result lends mutability, and a `.view` receiver has none
# to lend -- a view converts to no other ownership.
Item: class {
    n: i64
}

Bag: class {
    it: Item
} as {
    peek: function {t: this.view} outx Item.borrow is {
        return t.it
    }
}

main: function is {
    b: Bag it: (Item n: 1)
    p: b.peek
    print "\{p.n}"
}
