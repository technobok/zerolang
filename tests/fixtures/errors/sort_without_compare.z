# `sort` orders by the element's own `compare`, so an element type with none
# has no `sort`: a float (a NaN is unordered), a record or a class that writes
# none -- a generated `==` does not bring an order with it. Each read is the
# ordinary "no member", and a float's `compare` does not exist either.
# emitc_corpus/sort_by_compare is the other half.
point: record {
    x: i64
    y: i64
}

Cell: class {
    n: i64
}

main: function is {
    fs: ListVal f64
    fs.sort
    ps: ListVal point
    ps.sort
    cs: List Cell
    cs.sort
    z: 1.5
    print "\{z.compare rhs: 2.5}"
}
