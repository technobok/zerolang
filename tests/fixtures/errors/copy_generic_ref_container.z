# The other half of container_copy.z. `.copy` is declared on the containers
# whose elements are all valtypes; a container that can hold a REFERENCE has
# none, because a bitwise element copy would give that element two owners and
# anything else is a judgement about a layout the compiler did not write.
#
# Reaching one through a template must say the same thing. It did not: the
# instance walk waived the refusal for every native reftype, so this reached
# the EMITTER and failed there as "zemitterc: unsupported .copy of type ... in
# a generic body" -- a question about a type, answered by the code generator.
dupper: unit as {
    t: anyval.generic
    dup: function {x: t} out t is {
        return x.copy
    }
}

dl: (dupper t: (List String))

main: function is {
    xs: List String
    xs.append from: "a".string
    ys: dl.dup x: xs
    print "\{ys.length}"
}
