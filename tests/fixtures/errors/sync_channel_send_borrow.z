# sync_channel_send_borrow.z -- a method's receiver could keep a value it takes
# and later hand it out: a Sender's `send` hands it to another thread. A value
# holding a borrow would carry it there with nothing keeping the source alive,
# so it is refused -- for a native method and a user one alike.

# Peek -- a view of a list its owner keeps
Peek: class {
    # the borrowed list
    xs: (ListVal i64).borrow
}

# Relay -- passes a Peek on without keeping it
Relay: class {
    # how many it passed
    n: i64
} as {
    pass: function {t: this.view value: Peek.take} is {
        print "\{value.xs.length}"
    }
}

main: function is {
    xs: ListVal i64
    xs.append 1
    rx: (sync.Receiver Peek).create
    tx: rx.sender
    tx.send value: (Peek :xs)
    r: Relay n: 0
    r.pass value: (Peek :xs)
}
