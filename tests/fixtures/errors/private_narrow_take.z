# private_narrow_take.z -- a friend handle is a reference, so only `borrow` or `view`
# narrows `private`: `.private.take` is refused (E0022). It used to reach C.
Bag: class { a: i64 } as {
    public: unit { :lend }
    lend: function {:this} out i64 is { return (friend h: this.private) }
}

friend: function {h: Bag.private.take} out i64 is { return h.a }

main: function is {
    b: (Bag a: 5)
    print "\{b.lend}"
}
