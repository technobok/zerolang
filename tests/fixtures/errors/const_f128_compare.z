# A COMPARISON OF f128 CONSTANTS HAS NO COMPILE-TIME VALUE. The evaluator holds
# an f64, and an f128 compared through its nearest f64 can get the answer
# wrong: 2^53 + 1 and 2^53 are one f64, so `>` would fold to false. A unit
# constant must fold, so this one is refused; in a body the comparison runs.

# an integer f128 holds exactly and f64 does not
KI: 9007199254740993.f128

# whether it is past 2^53
PAST: KI > 9007199254740992.f128

main: function is {
    print "\{PAST}"
}
