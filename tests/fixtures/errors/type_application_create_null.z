# E0300: a template that strikes `create` constructs in no spelling of its
# instances: type arguments alone, with fields, or through `create`.
Sealed: class {
    a: t
} as {
    t: anyval.generic
    create: null
}

main: function is {
    s: (Sealed t: i64)
    u: Sealed t: i64 a: 3
    w: (Sealed t: i64).create a: 3
    print "x"
}
