# THE SELECTED BRANCH OF A UNIT-LEVEL `if` IS THE CONSTANT'S VALUE, so it must
# fold. Each condition below folds; the branch it selects does not: a name
# nothing declares, a run-time call, a nested `if` whose own condition names
# nothing, and no branch at all -- a false condition with no else. Each was
# accepted and emitted as the definition's type name.
LIMIT: 5

g: function {n: i64} out i64 is {
    return n
}

UNKNOWN: if LIMIT > 9 then { 4 } else { GHOST }

CALLED: if LIMIT > 1 then { g n: 3 } else { 4 }

NESTED: if LIMIT > 9 then { 1 } else { if PHANTOM > 1 then { 2 } else { 3 } }

UNSELECTED: if LIMIT > 9 then { 1 }

main: function is {
    print "\{UNKNOWN} \{CALLED} \{NESTED} \{UNSELECTED}"
}
