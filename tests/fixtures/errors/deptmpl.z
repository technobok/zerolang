# deptmpl.z -- a dependency unit naming a template declared in the MAIN unit.
# A unit sees its own definitions and core's; it does not see its consumer's,
# for a template no more than for a constant or a namespace. The callee names
# nothing in scope, so the reference is what is reported -- not the shape of
# the definition around it.
intmath: (mathops t: i64)

sum: function {a: i64 b: i64} out i64 is {
    r: (intmath.add :a :b)
    return r
}
