# A generic conformer naming a spec instance over its own parameter conforms,
# per instance, to its own substituted instance -- and is checked against it at
# the marker. `get` returns i64 whatever `t` is: it implements
# `(Getter v: i64)` for Box_i64 and nothing for Box_bool.
Getter: protocol {
    v: anyval.generic
    get: function {t: this.view} out v
}

Box: class { x: t } as {
    t: anyval.generic
    g: (Getter v: t)
    get: function {b: this.view} out i64 is { return 1 }
}

main: function is {
    a: Box x: 4
    b: Box x: true
    print "\{a.g.get} \{b.x}"
}
