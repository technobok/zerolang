# An unlabelled argument a generic function or method has no parameter for is
# refused as on a concrete call, not dropped: `mk` takes only a type argument,
# `same` only its receiver.
mk: function {} out i64 is {
    return 3
} as {
    t: anyval.generic
}

Box1: class {
    n: i64
} as {
    same: function {:this} out i64 is {
        return this.n
    } as {
        t: anyval.generic
    }
}

main: function is {
    a: mk 5 t: i64
    b: Box1 n: 1
    c: b.same 7 t: i64
    print "\{a} \{c}"
}
