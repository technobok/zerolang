# E0200: `hold` is the owned, READONLY cell -- moving it out with `.take`
# would hand back a mutable value, and capability may only be given up.
Inner: class {
    n: i64
    label: String
}
main: function is {
    i0: Inner n: 1 label: "x".string
    h: i0.hold
    gone: h.take
    print "n=\{gone.n}"
}
