eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
nope: function out bool is {
    return false
}
# a reassignment `t = m` MOVES `m`.
main: function is {
    m: "abc".string
    t: "x".string
    n: 0
    for while n < 3 loop {
        n = n + 1
        t = m
        print "\{t.length}"
    }
}
