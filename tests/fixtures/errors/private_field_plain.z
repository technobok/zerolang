# A `.private` FIELD is a friend handle too: constructing its holder from a
# plain value is the same missing grant as passing one to a parameter.
Bag: class { a: i64 count: i64 } as {
    public: unit { :count }
}

Holder: class { h: Bag.private.borrow } as {
    read: function {:this} out i64 is { return this.h.a }
}

main: function is {
    b: (Bag a: 42 count: 3)
    hd: (Holder h: b)
    print "\{hd.read}"
}
