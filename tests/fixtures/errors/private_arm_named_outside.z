# A match outside a type names its arms through the type's public interface: an
# arm the interface leaves out is refused, as a member read of it is, whether
# or not any type in the program renames a member.
shape: variant { circleArm: i64 boxArm: i64 } as {
    public: unit { :circleArm :mk :area }
    mk: function {n: i64} out shape is {
        return (shape.boxArm n)
    }
    area: function {s: this.view} out i64 is {
        match (
            s
        ) case circleArm then {
            return s * 3
        } case boxArm then {
            return s * 4
        }
    }
}

main: function is {
    s: shape.mk n: 5
    print "area \{s.area}"
    match (
        s
    ) case circleArm then {
        print "circle \{s}"
    } case boxArm then {
        print "box \{s}"
    }
}
