# E0200: the same for a nested receiver -- 'e.sub.bump' mutates through a path
# an outstanding lock covers.
Inner: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
}
Item: class { sub: Inner }
main: function is {
    e: Item sub: (Inner n: 1)
    with v: e.borrow do {
        e.sub.bump
    }
    print "\{e.sub.n}"
}
