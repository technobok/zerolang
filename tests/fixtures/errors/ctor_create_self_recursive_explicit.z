# E0300: the explicit `Type.create` spelling of the same recursion the
# bare-name fixture pins. The spec names both forms, and both route to the
# user's `create`, so both must be refused. A class `as` block, a record body
# block, and the zero-argument dotted form.
Widget: class {
    size: 0.u64
} as {
    create: function {size: 0.u64} out this is {
        w: Widget.create size: size
        return w
    }
}
Panel: record {
    size: 0.u64
    create: function {size: 0.u64} out this is {
        p: Panel.create size: size
        return p
    }
}
Dial: record {
    size: 0.u64
} as {
    create: function {size: 0.u64} out this is {
        d: Dial.create
        return d
    }
}
main: function is {
    w: Widget size: 1
    p: Panel size: 2
    d: Dial size: 3
    print "\{w.size} \{p.size} \{d.size}"
}
