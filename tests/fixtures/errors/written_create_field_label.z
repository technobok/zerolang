# written_create_field_label.z -- a generic type that writes its `create` is
# constructed with that create's parameters, not its fields: `a` is a field of
# Pair, and the construction reports it as the argument it is.
Pair: record {
    a: t
    b: i64
} as {
    t: anyval.generic
    create: function {v: t} out this is {
        return (meta.create a: v b: 40)
    }
}

main: function is {
    p: Pair a: 2.u64 b: 3
    print "\{p.a} \{p.b}"
}
