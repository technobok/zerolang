# The ListRef flavour of view_subslice_pins_val: a sub-slice of a borrowed
# window keeps the list locked, so appending while it lives is refused.
main: function is {
    xs: List String
    xs.append from: "a".string
    xs.append from: "b".string
    xs.append from: "c".string
    s2: (xs.slice from: 0 to: 3).slice from: 1 to: 3
    xs.append from: "d".string
    print "\{s2.get i: 0}"
}
