# iterate_step_readonly.z -- `iterate` is the readonly walk whether a `for`
# drives it or the program steps it by hand: what its `call` yields is an
# OptionView, so a write through the element is refused. `iterateMut` is the
# walk that may write.

Box: class {
    # the value written
    n: i64
}

main: function is {
    xs: List Box
    xs.append (Box n: 1)
    it: xs.iterate
    e: it.call
    match (e) case some then e.n = 50 case none then null
}
