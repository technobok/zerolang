# E0200: a union arm declared `.view` binds a readonly payload, so the match
# arm's narrowed name may not be mutated -- the marker is the payload's, not
# the union's.
Inner: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
}
U: union {
    some: Inner.view
    none: null
}
main: function is {
    i: Inner n: 1
    u: U.some i
    match (
        u
    ) case some then {
        u.bump
        print "n=\{u.n}"
    } else null
}
