# arm_reference_followed.z -- the arms hand back views of xs through references
# they declared (a named borrow, a hoisted temporary): v keeps xs locked, so a
# write to xs while v lives is refused.
lfFirst: function {s: String.view} outx StringView is {
    return (s.substring from: 0 to: 3)
}

main: function is {
    xs: List String
    xs.append "abc def".string
    k: xs.length > 0
    v: if k then {
        t: xs.get i: 0
        lfFirst s: t
    } else (lfFirst s: (xs.get i: 0))
    xs.set i: 0 val: "replaced".string
    print v
}
