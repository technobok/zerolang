# E0200: two holders cannot both `.borrow` one list. Were the second accepted,
# iterating through the first while appending through the second would grow the
# buffer under the iteration: a use-after-free under SHARED borrows, reproduced
# under ASan.
H: class {
    xs: (List String).borrow
}

main: function is {
    src: (List String)
    src.append from: "a".string
    h1: H xs: src
    h2: H xs: src
    for each s: h1.xs.iterate loop {
        i: 0.u64
        for i < 64 loop {
            h2.xs.append from: "grow".string
            i = i + 1
        }
        print "\{s}"
    }
}
