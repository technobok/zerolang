# A function a static value refers to is used, so its body is checked like any
# other: here it reads a name nothing defines. The body used to be walked
# while the static value was built, before any body can be judged, and the
# name reached the C.

# tick -- the shape of a clock's function
tick: function out i64

# broken -- reads a name nothing defines
broken: function out i64 is { return a }

# clock -- holds a function
clock: data {
    t: tick
}

c: (clock t: broken)

main: function is {
    f: c.t.copy
    print "\{f}"
}
