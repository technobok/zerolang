# view_result_to_writer.z -- a `.view` result lent to a parameter that may
# write it is refused, as the same result is as a receiver and as a name bound
# to it: a view converts to no other ownership. Readonly is deep, so a field of
# the result is refused too. Whether an argument is a view is its own value's
# question: a writer argument after a `.view` one is lent as usual.
ident: function as { T: StringLike.generic } in {v: T.view} outx T.view is {
    return v
}

grow: function {s: String} out u64 is {
    s.append s: "zz"
    return s.length
}

use: function {a: StringView.view b: u64} out u64 is {
    return a.length + b
}

H: class {
    name: String
}

main: function is {
    xs: List String
    xs.append "abc".string
    n: grow s: (xs.get i: 0)
    hs: List H
    hs.append (H name: "h".string)
    m: grow s: (hs.get i: 0).name
    o: "own".string
    k: use a: (ident v: "lit") b: (grow s: o)
    print "\{n} \{m} \{k}"
}
