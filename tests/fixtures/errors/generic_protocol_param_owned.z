# An owned protocol parameter of a generic function (`j: (Job R).take`) refuses
# a bare conformer once the instance fixes its type, exactly as `(Job String)`
# written out does: the value must be wrapped to be owned as the protocol.

# Job -- something that answers an R
Job: protocol {
    call: function {:this} out R
} as {
    R: AnyRef.generic
}

# Name -- a Job answering String
Name: class { s: String } as {
    job: (Job String)
    call: function {:this} out String is { return this.s.copy }
}

# run -- runs any Job, answering its R
run: function {j: (Job R).take} out R is {
    return j.call
} as {R: AnyRef.generic}

main: function is {
    print (run j: (Name s: "y".string) R: String)
}
