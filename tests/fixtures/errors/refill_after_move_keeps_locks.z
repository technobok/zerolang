# A local whose value moved out and is then refilled holds what the new value
# keeps locked, as a live local reassigned the same way does: the refill is
# a write to the same variable, and its locks are that variable's from there.
LfBox: class {
    name: StringView
}

lfFlag: function out bool is {
    return false
}

refillConstruction: function is {
    s: "abc".string
    t: "ttt".string
    w: LfBox name: s.stringView
    w.drop
    w = LfBox name: t.stringView
    t = "zzzzzzzzzzzzzzzz".string
    print "\{w.name}"
}

refillView: function is {
    s: "abc".string
    t: "ttt".string
    w: s.stringView
    w.drop
    w = t.stringView
    t = "zzzzzzzzzzzzzzzz".string
    print "\{w}"
}

refillWithTake: function is {
    s: "abc".string
    o: "ooo".string
    v: LfBox name: o.stringView
    w: LfBox name: s.stringView
    v.drop
    v = w.take
    s = "zzzzzzzzzzzzzzzz".string
    print "\{v.name}"
}

refillInEveryArm: function is {
    s: "abc".string
    t: "ttt".string
    w: LfBox name: s.stringView
    k: lfFlag
    if k then {
        w.drop
        w = LfBox name: t.stringView
    } else {
        w.drop
        w = LfBox name: t.stringView
    }
    t = "zzzzzzzzzzzzzzzz".string
    print "\{w.name}"
}

main: function is {
    refillConstruction
    refillView
    refillWithTake
    refillInEveryArm
}
