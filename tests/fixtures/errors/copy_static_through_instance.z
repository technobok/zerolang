# A STATIC METHOD IS COPIED THROUGH ITS TYPE ONLY. A function with no receiver
# belongs to the type, so it is not reached through an instance for `.copy` any
# more than for a call: `T.helper.copy` is its reference.
T: record {
    n: i64
} as {
    helper: function {n: i64} out i64 is {
        return n + 1
    }
}

main: function is {
    t: T n: 1
    f: t.helper.copy
    print "unreachable"
}
