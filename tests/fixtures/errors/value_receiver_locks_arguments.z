# a borrowed receiver value holds what it borrowed locked while the call's
# arguments are walked, as the same value bound to a name does: an argument that
# writes, moves or re-borrows that storage is refused. `(grid.getMut i: 0)` points
# into `grid`, and `(grid.pop).pop` freed the list it points at.
eat: function {g: (List (List String)).take} out String is {
    return "x".string
}
main: function is {
    grid: List (List String)
    grid.append from: (List String)
    grid.append from: (List String)
    (grid.getMut i: 0).append from: "a".string
    (grid.getMut i: 0).append from: (grid.pop).pop
    (grid.getMut i: 0).append from: (grid.getMut i: 1).pop
    (grid.getMut i: 0).append from: (eat g: grid)
    print "\{grid.length}"
}
