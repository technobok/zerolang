# A default must stay a compile-time scalar: a string constant is refused as a
# string literal default is, on a field and on a parameter. A class field or a
# parameter defaulted to one was made REQUIRED instead ("missing required
# argument").
GREETING: "hi"

Box: class {
    s: GREETING
}

greet: function {s: GREETING} is {
    print "\{s}"
}

main: function is {
    b: Box
    greet
}
