# A path-shaped argument pins exactly as a bare one does: the result keeps
# `h.inner` locked, so a write below that path is refused while it lives.
Src: class {
    n: i64
}

Holder: class {
    inner: Src
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

main: function is {
    h: Holder inner: (Src n: 1)
    w: mk from: h.inner
    h.inner.n = 5
    print "\{w.tag}"
}
