# A condition runs before its clause's body on every path that reaches the
# clause -- the clauses after it and the code after the `if` among them -- so
# a local a condition moved is consumed there, even when the clause's body
# leaves the function.
eat: function {s: String.take} out bool is {
    return s.length > 5
}

afterIf: function {c: bool} out u64 is {
    q: "q".string
    if (eat s: q.take) then return 1
    print "after: \{q}"
    return 0
}

laterConjunct: function {c: bool} out u64 is {
    r: "r".string
    if c when (eat s: r.take) then return 1
    print "after: \{r}"
    return 0
}

siblingClause: function {c: bool} out u64 is {
    t: "t".string
    if (eat s: t.take) then {
        return 1
    } else if c then {
        print "sibling \{t}"
    }
    return 0
}

main: function is {
    print "\{afterIf c: true} \{laterConjunct c: true} \{siblingClause c: true}"
}
