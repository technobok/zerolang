# `.implement` names an interface: a record, a class, a constant and an
# instance of a generic class are no protocol or facet, and each is refused
# where it is written.
Pt: record { x: i64 }
Box: class { n: i64 }
limit: 4

Q: record { y: i64 } as {
    a: Pt.implement
    b: Box.implement
    c: limit.implement
    d: (ListVal i64).implement
}

main: function is {
    q: Q y: 1
    print "\{q.y}"
}
