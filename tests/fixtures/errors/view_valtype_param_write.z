# E0200: the same for a `.view` valtype parameter. The lock is taken on the
# parameter's own name, so it needs no identity -- which is why `.view` is
# legal here while `.lock` is not.
point: record {
    x: i64
}
poke: function {p: point.view} is {
    p.x = 99
}
main: function is {
    q: point x: 1
    poke p: q
    print "\{q.x}"
}
