# E0200: an owned field is never a `.hold` binding, so a `.hold` value is
# refused there as it is for an owned local.
Cell: class { n: i64  s: String }
H: class { f: Cell }
main: function is {
    e: Cell n: 1 s: "e".string
    h: H f: (Cell n: 4 s: "h".string)
    h.f = e.hold
    print "\{h.f.n}"
}
