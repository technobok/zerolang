# ResultRV's `err` is a bare value-type arm, held in the union's slot, so an
# instance whose error is wider than the slot is refused where the program
# instantiates it, as ResultVR's `ok` is. `parseerror` beside it fits.
pair: record { a: i64  b: i64 }
Word: class { text: String }

main: function is {
    n: (ResultRV Word e: parseerror).err parseerror.empty
    p: (ResultRV Word e: pair).err (pair a: 1 b: 2)
    if n.err then print "narrow"
    if p.err then print "\{p.a}"
}
