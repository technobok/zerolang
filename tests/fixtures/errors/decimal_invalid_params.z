# a fixed decimal's precision and scale are checked where each instance is
# built: a precision past the tier's digits, or a scale past the precision, is a
# compile-time error at the instance, whichever constructor reaches it
main: function is {
    a: (math.decimal32 precision: 10 scale: 2) from: 1
    b: (math.decimal64 precision: 19 scale: 2).parse text: "1"
    c: (math.decimal128 precision: 39 scale: 0) from: 1
    d: (math.decimal256 precision: 77 scale: 0) from: 1
    e: (math.decimal64 precision: 4 scale: 5) from: 0
    f: (math.decimal32 precision: 0 scale: 0) from: 0
    print "\{a.string} \{d.string} \{e.string} \{f.string} \{c.string}"
    match b case ok then print "\{b.string}" case err then print "bad"
}
