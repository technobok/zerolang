# A numeric generic parameter read from a call's result would fold to the
# type's argument and never make the call, so it is refused.
Buffer: class {
    used: u32
} as { cap: u32.generic }

make: function out (Buffer cap: 8) is {
    print "made"
    return ((Buffer cap: 8) used: 1)
}

main: function is {
    print "\{(make).cap}"
}
