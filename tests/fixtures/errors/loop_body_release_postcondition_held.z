# loop_body_release_postcondition_held -- a lock its holder releases in a loop's body is
# released on the body's path only: a `continue` can skip the release, so the loop's
# postcondition still finds the source locked -- writing it there would leave `w`
# reading freed memory
LfBox: class {
    name: StringView
}

bodyReassignPostcondWrite: function {k: bool} is {
    s: "abc".string
    o: "ooo".string
    w: LfBox name: s.stringView
    n: 0
    for n < 2 loop {
        n = n + 1
        if k then continue
        w = LfBox name: o.stringView
    } while (with t: n do {
        s = "zzzzzzzzzzzzzzzz".string
        t < 2
    })
    print "\{w.name} \{s}"
}

main: function is {
    bodyReassignPostcondWrite k: true
}
