# A name nothing defines is an unknown reference where it is the source of a
# protocol instance, whichever way the instance is written. It used to pass
# the check and reach the emitter.

# Shape -- something with an area
Shape: protocol {
    # the area
    area: function {t: this.view} out u64
}

# make -- the bare-name form, of nothing
make: function out Shape is {
    return (Shape p)
}

main: function is {
    a: Shape.create from: b.take
    c: Shape nosuch
    d: make
    print "a"
}
