# A CONSTANT'S RIGHT-HAND OPERAND MUST CONVERT INTO THE LEFT-HAND ONE WITHOUT
# LOSS, and a literal must fit it, exactly as in a body. Every one of these
# folded: `L + 7.u16` to 12, `F + D` to 3.5 and `L > 300` to false. A typed
# constant stands in for a parameter only as its type does: `N` bound a u8.
L: 5.u8
F: 1.5.f32
D: 2.0.f64
N: 5.u16

B: L + 7.u16
G: F + D
S: 7.u8 + 7.u32
C: L > 300
K: 1 + 7.u64

take: function {n: u8} is {
    print "\{n}"
}

main: function is {
    print "\{B} \{G} \{S} \{C} \{K}"
    take n: N
}
