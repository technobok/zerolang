# span_pair_parent.z -- a split borrows the window it splits: while the two
# halves live, the whole window is not usable beside them.

main: function is {
    xs: ListVal u64
    xs.append from: 1
    xs.append from: 2
    w: xs.mutView
    p: w.split at: 1
    n: w.length
    p.lo.set i: 0 item: n
}
