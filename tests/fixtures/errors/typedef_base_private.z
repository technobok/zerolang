# a typedef's own methods reach only the base's PUBLIC members: inside the
# typedef, the base is outside code.
Acct: class { bal: i64 } as {
    public: unit { :show }
    show: function {t: this.view} out i64 is { return t.bal }
}
Alias: typedef Acct as {
    peek: function {t: this.view} out i64 is { return t.bal }
}
main: function is {
    a: Alias (Acct bal: 3)
    print "\{a.peek} \{a.show}"
}
