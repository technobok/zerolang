# a default through a unit's path names an arm as the bare spelling does, and is
# held to the same rules: an arm the type does not declare names nothing, and
# one that carries a payload cannot be a default. A missing arm was read as the
# type -- the parameter or field silently became required.

# a parameter defaulting to an arm `hue` lacks
paint: function {h: shade.hue.green} out i64 is {
    return 1
}

# a field likewise
brush: record {
    # the hue
    h: shade.hue.green
}

# an arm that carries a level
dim: function {h: shade.hue.grey} out i64 is {
    return 2
}

main: function is {
    print "\{paint h: shade.hue.red}"
    b: brush h: shade.hue.red
    print "\{b.h.red}"
    print "\{dim h: shade.hue.red}"
}
