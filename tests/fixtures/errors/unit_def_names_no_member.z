# unit_def_names_no_member.z -- a unit-level definition reading a member its type
# does not declare names nothing: it is reported as that, not as a construction
# (only a member that EXISTS, like `Point.create`, is one).

N: i64.bogus

f: function {n: N} out i64 is { return 1 }

main: function is {
    print "\{f n: 3}"
}
