# THE VALUE A FUNCTION ENDS ON IS CHECKED AS `return` CHECKS IT, and a body
# that ends on no value returns nothing it declared. None of these was checked:
# `{ x }` from a u16 into `out u8` printed 44, `{ 300 }` printed 44, `{ 5 }` into
# `out String` was invalid C, and `{ print "x" }` returned whatever the register
# held.
L: 5.u16

narrow: function {x: u16} out u8 is {
    x
}

big: function out u8 is {
    300
}

text: function out String is {
    5
}

truth: function out bool is {
    1
}

typed: function out u8 is {
    L
}

nothing: function out u8 is {
    print "x"
}

binding: function out u8 is {
    x: 5.u8
}

main: function is {
    print "\{narrow x: 3} \{big} \{text} \{truth} \{typed} \{nothing} \{binding}"
}
