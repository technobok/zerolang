# `outx` pins EVERY borrow/view input, not only the first one the call
# happened to lock. The result here is built from the SECOND argument; writing
# that source while the result lives is refused.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {a: Src.borrow b: Src.borrow} outx W is {
    return (W s: b tag: a.n)
}

main: function is {
    x: Src n: 1
    y: Src n: 2
    w: mk a: x b: y
    y.n = 5
    print "\{w.tag}"
}
