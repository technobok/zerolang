# lock_dies_with_block_after_release.z -- the run fixture's twin: inside the
# block, while t lives, o is still locked, by t.
LfOwn: class {
    s: String
}

main: function is {
    o: LfOwn s: "abc def".string
    v: o.s.stringView
    k: v.length > 0
    if k then {
        v.drop
        t: o.s.stringView
        o = LfOwn s: "zzz".string
        print t
    }
    print o.s
}
