# E0200: and when an exclusion leaves a single payload arm, which collapses to
# the same shadow narrowing.
Inner: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
}
U: union {
    some: Inner.view
    none: null
}
main: function is {
    i: Inner n: 1
    u: U.some i
    if (u.none) == false then {
        u.bump
        print "n=\{u.n}"
    }
}
