# eager_dead_else_break -- A `break` in an `else` the fold rules out leaves nothing,
# also when --eager walks that else: the loop never exits, and the function needs no
# return after it.
kind: variant {
    a: null
    b: null
}
K: kind.a

f: function out i64 is {
    for true loop {
        match K case a then return 1 else break
    }
}

main: function is {
    print "\{f}"
}

# an error of its own, so the fixture is one the compiler refuses: every other
# definition is still checked under --eager, and must report nothing more
refused: function is {
    print "\{nosuchname}"
}
