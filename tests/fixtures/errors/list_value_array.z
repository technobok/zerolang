# `.array` and `.tag` belong to a list's NAME. A value of the block -- a
# binding, a parameter -- carries its elements and length but not the count an
# array type is sized by, and a tag is declared in an `as` block; through a
# value both are refused, pointing at the block's name.
codes: list { a: 1 b: 2 } out staticlist u8

copy: function {d: staticlist u8} is {
    x: d.array
    y: d.tag
}

main: function is {
    w: codes
    z: w.array
    copy d: codes
}
