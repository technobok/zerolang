# A unit-level definition calling a string constant's method is checked against
# the method's declaration, as a body checks the same call: a member StringView
# does not declare, an unknown label, a surplus argument, a missing one, and an
# argument of the wrong kind are each the body's own error. A label starts a new
# unit-level definition, so `SPLIT` below is `SPLIT: P.substring` -- a call with
# no arguments -- beside two constants named `from` and `to`.
P: "hello"
H: "he"
BARE: P.substring
SPLIT: P.substring from: 0 to: 2
PARTIAL: (P.substring from: 0)
WRONG: (P.substring from: "a" to: 2)
LABEL: (P.substring from: 0 to: 2 step: 1)
SURPLUS: (P.length 3)
NOSUCH: P.nosuch
KIND: P.startsWith 5
SUM: (P.substring from: 1) + H
PICK: if true then { P.startsWith } else { false }
INNER: (P.substring to: 2).length

main: function is {
    print "\{BARE} \{SPLIT} \{PARTIAL} \{WRONG} \{LABEL} \{SURPLUS}"
    print "\{NOSUCH} \{KIND} \{SUM} \{PICK} \{INNER}"
}
