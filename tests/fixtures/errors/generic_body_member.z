# E0100: a member used on a type parameter is resolved in each INSTANCE, not
# refused in the template -- a bound only decides which types may instantiate
# (duck typing). An instance whose type lacks the member is refused there,
# naming the instance.
Holder9: class {
    val: t
    poke: function {:this} out t is {
        x9: this.val.bogus9
        return this.val.copy
    }
} as {
    t: anyval.generic
}

main: function is {
    h9: (Holder9 val: 1)
    print "\{h9.poke}"
}
