# span_escape_local.z -- a window over a local list cannot be returned: the list
# dies with the call, and the window would point into freed storage.

# a window over storage that is gone by the time anyone reads it
leak: function {n: u64} outx (SpanVal u64) is {
    xs: ListVal u64
    xs.append from: n
    return xs.mutView
}

main: function is {
    w: leak n: 1
    print "\{w.length}"
}
