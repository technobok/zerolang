# A float literal converts only to the float types `floatliteral` declares,
# whatever its value: `(if c then 2.5 else 1.0).i64` is refused as `2.5.i64`
# is. It said "the expression produces no value": a scalar-named member a
# literal does not declare was let through as an identity conversion, which
# only a numeric type's own name is.
main: function is {
    c: true
    a: (if c then 2.5 else 1.0).i64
    b: (match c case true then 0.5 case false then 1.5).u8
    print "\{a} \{b}"
}
