# conform_return_type.z -- a conformer whose method returns another type than the spec's.
Shape: protocol {
    area: function {t: this.view scale: u64} out u64
}

Sq: class { side: u64 } as {
    :Shape
    area: function {t: this.view scale: u64} out i64 is {
        scale
        return -1
    }
}

main: function is {
    s: Sq side: 2
    print "\{s.side}"
}
