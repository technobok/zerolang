# A reftype has no default `.copy`: what a duplicate means is the author's to
# say, so an undefined one must diagnose rather than miscompile. (A valtype's
# default IS its byte copy -- see copy_valtype_default in the corpus.)

U: union {
    a: (Box i64)
    b: String
}

main: function is {
    u: (U.a 5)
    c: u.copy
}
