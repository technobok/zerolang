# A non-owned field of a construction returned from an `outx` function or
# create is filled only from a `.borrow`/`.view` parameter -- by its label or by
# the unlabelled argument alike. Unlabelled, a local of the create was stored
# and read after it died.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
} as {
    create: function {from: Src.borrow} outx this is {
        loc: Src n: 2
        return (meta.create loc tag: 1)
    }
}

V: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx V is {
    loc: Src n: 2
    return (V loc tag: 1)
}

main: function is {
    a: Src n: 1
    b: Src n: 3
    w: W.create from: a
    v: mk from: b
    print "\{w.s.n} \{v.s.n}"
}
