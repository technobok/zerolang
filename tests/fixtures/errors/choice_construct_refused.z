# E0100/E0300: a choice value is built in a static position, through an arm
# that carries a value, with that one value fitting the arm. An arm that
# carries nothing takes no value; an unknown arm, a labelled value and one the
# arm cannot hold are refused; a choice has no `create`. In a function body a
# choice value that carries a value is not built at all.
form: choice {
    call: null
    template: text
    count: u8
}

a: (form.call 3)
b: (form.nope 1)
c: (form.count 300)
d: (form.template v: "x")
e: form.create

main: function is {
    x: (form.template "x")
    print "\{x.call}"
}
