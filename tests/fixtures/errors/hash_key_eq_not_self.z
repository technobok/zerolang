# E0400: a record whose written `==` compares it with a u64 has no `==` a Set
# can use, and the refusal says so.
pt: record { x: u64 } as {
    hash: function {t: this.view} out u64 is { return t.x }
    ==: function {t: this.view rhs: u64} out bool is { return t.x == rhs }
}
main: function is {
    s: SetVal pt
    print "\{s.length}"
}
