# elided_arg_unresolved.z -- the `:name` argument shorthand reads a LOCAL of
# that name and resolves through no other scope. A miss used to type as 0 in
# silence and reach the emitter, which wrote the bare name into the C.

kConst: 7

helper: function {} out u64 is {
    return 9
}

takes: function {tid: u64} out u64 is {
    return tid + 1
}

takesC: function {kConst: u64} out u64 is {
    return kConst + 1
}

takesF: function {helper: u64} out u64 is {
    return helper + 1
}

main: function {} is {
    a: takes :tid
    b: takesC :kConst
    c: takesF :helper
    print "\{a} \{b} \{c}"
}
