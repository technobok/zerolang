# paren_ctor_callable_args.z -- a parenthesised generic application in callable
# position is a construction of the mono it names, and its arguments are
# checked like any constructor's: a string passed to a u32 field is refused,
# and so is a name that resolves to nothing. The callable here is a call, not a
# name, and that shape alone is what routes it to the construction check.
Boxed: class {
    used: u32
} as { cap: u32.generic }

main: function is {
    a: (Boxed cap: 8) used: "x"
    b: (Boxed cap: 16) used: ghostUsed
    print "\{a.used} \{b.used}"
}
