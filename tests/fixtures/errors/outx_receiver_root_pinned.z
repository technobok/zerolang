# A bare `:this` receiver is a `.borrow` input: the result pins the receiver's
# ROOT exclusively, so a mutating method and a field write on it are both
# refused while the result lives.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

Fac: class {
    base: Src
    other: i64
} as {
    mk: function {:this} outx W is {
        return (W s: this.base tag: 1)
    }
    bump: function {:this} is {
        this.other = this.other + 1
    }
}

main: function is {
    f: Fac base: (Src n: 1) other: 0
    w: f.mk
    f.bump
    f.other = 7
    print "\{w.tag}"
}
