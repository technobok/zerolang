# a decimal literal past i64 fits only a slot wide enough to take it. An
# untyped literal is an i64, and an i64 cannot hold it: these printed -1, i64's
# minimum and i64's maximum.
main: function is {
    x: 18446744073709551615
    y: 9223372036854775808
    z: -9223372036854775809
    if 18446744073709551615 > 5 then print "gt"
    print "\{x} \{y} \{z}"
}
