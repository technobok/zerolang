# An argument of a generic call that writes arguments after a value is refused
# as it is in any other call. It used to pass the check and reach the emitter.

# Job -- work that answers a result
Job: protocol {
    call: function {:this} out R
} as {
    R: AnyRef.generic
}

# Name -- answers its own text
Name: class { s: String } as {
    job: (Job String).implement
    call: function {:this} out String is { return this.s.copy }
}

# peek -- the result of a job it borrows
peek: function {j: (Job R)} out R is {
    return j.call
} as {
    R: AnyRef.generic
}

main: function is {
    n: Name s: "lent".string
    print (peek j: n.borrow (Name s: "forwarded".string))
}
