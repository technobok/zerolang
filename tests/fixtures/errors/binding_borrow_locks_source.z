# A local binding of a reftype borrows, so it PINS its source for its whole
# scope: while the binding lives the source may be read but not written, moved
# out of, mutated through a method, or handed to a parameter that takes it.
# Each refusal is the lock rule's own wording -- the binding form invents none.
sink: function {s: String.take} out u64 is {
    return s.length
}

writeSource: function is {
    a: "one".string
    b: a
    a.append "!"
    print "\{b}"
}

moveSource: function is {
    a: "one".string
    b: a
    c: a.take
    print "\{b} \{c}"
}

mutatingMethod: function is {
    a: List String
    b: a
    a.append from: "x".string
    print "\{b.length}"
}

intoTakingParam: function is {
    a: "one".string
    b: a
    print "\{sink s: a}"
    print "\{b}"
}

reassignBinding: function is {
    a: "one".string
    b: a
    b = "other".string
    print "\{b}"
}

main: function is {
    writeSource
    moveSource
    mutatingMethod
    intoTakingParam
    reassignBinding
}
