# A move before an `if` whose arm ends the iteration with `continue`: that
# path reaches the next iteration with the name consumed, even though the
# body's last statement leaves the loop.
eats: function {s: String.take} out bool is {
    return s.length > 0
}
main: function is {
    m: "abc".string
    for while true loop {
        ok: eats s: m
        if ok then continue
        break
    }
}
