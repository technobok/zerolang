# THE NEAREST DECLARATION OF A NAME WINS IN A TYPE'S OWN SCOPE: an `as`
# constant written where a type is -- a return, a parameter -- is refused as
# the constant it is, and the unit's type of the same spelling does not answer
# for it.
limit: record { v: i64 }

Cfg: record { x: i64 } as {
    limit: 4
    f: function {c: this.view} out limit is { return (limit v: c.x) }
    g: function {c: this.view n: limit} out i64 is { return c.x }
}

main: function is {
    c: Cfg x: 1
    print "\{c.x}"
}
