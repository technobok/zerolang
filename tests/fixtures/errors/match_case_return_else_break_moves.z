# match_case_return_else_break_moves -- A match whose `case` returns and whose `else`
# breaks leaves the loop on one path: a local the loop body moved out is consumed for
# the code after the loop.
kind: variant {
    a: null
    b: null
}

keep: function {s: String.take} out u64 is {
    return s.length
}

f: function {v: kind c: bool} out u64 is {
    s: "abc".string
    for c loop {
        n: keep s: s.take
        match v case a then return n else break
    }
    return s.length
}

main: function is {
    print "\{f v: kind.b c: true}"
}
