# Two units each declare a template of one name over a numeric parameter. Their
# instances print alike (`Fixed_8`), so a mismatch between them names each by
# the unit its TEMPLATE is in -- the argument, a value, names no unit.
grab: function {f: (ua.Fixed n: 8)} out i64 is {
    return f.x
}

main: function is {
    g: (ub.Fixed n: 8) x: 1
    print "\{grab f: g}"
}
