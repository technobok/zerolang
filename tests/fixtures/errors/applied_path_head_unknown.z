# The head of a type application is a path that names no type, as a return
# type and as a parameter's type. A path names what its base holds, so nothing
# defined later can give it a meaning.
twice: function {n: i64} out io.nosuch i64 is {
    return n
}

half: function {n: io.nosuch i64} out i64 is {
    return 1
}

main: function is {
    print "\{(twice n: 2)} \{(half n: 2)}"
}
