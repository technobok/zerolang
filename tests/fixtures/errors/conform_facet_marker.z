# conform_facet_marker.z -- a FACET conformer is held to its spec the same way: here the receiver.
sized: facet {
    size: function {t: this.view} out i64
}

pt: record { x: i64 } as {
    m: sized
    size: function {:this} out i64 is {
        this.x = this.x + 0
        return this.x
    }
}

main: function is {
    p: pt x: 3
    print "\{p.size}"
}
