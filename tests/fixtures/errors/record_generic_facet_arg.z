# E0400: a facet bound admits its CONFORMERS. A String conforms to no facet,
# so the instantiation is refused twice over: by the bound, and by the record
# field rule the mono meets.
fl: facet { area: function {t: this.view} out i64 }
flat: record { s: t } as { t: fl.generic }

main: function is {
    f: flat s: "x".string
    f
    print "x"
}
