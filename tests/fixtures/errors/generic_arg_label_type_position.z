# A generic type argument's label must name a parameter of the template in a
# TYPE position too, not only at a construction. While this went unchecked the
# label was ignored and the argument bound positionally, which mints a SECOND
# mono printing under the same name as the right one -- so the first thing a
# reader saw was `expected MapRV_String_u64, got MapRV_String_u64`, with no
# indication of which spelling was wrong. The E0300/E0100 lines below are that
# cascade, kept here because they are what the check replaces.
Holder: class {
    m: (MapRV keys: String v: u64)
}

# a parameter type
count: function {h: (MapRV K: String vals: u64).view} out u64 is {
    return 0
}

# a return type
empty: function out (MapRV badkey: String v: u64) is {
    return (MapRV K: String v: u64)
}

main: function is {
    h: Holder m: (MapRV K: String v: u64)
    e: empty
    print "n=\{count h: h.m} e=\{e.capacity}"
}
