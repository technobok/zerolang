# `U.w w.take` stores a lock-holding value as an arm payload exactly as
# `U.w w` does (lock_transfer_arm_payload_keeps_locks): the union keeps the
# locks, and writing the source while it lives is refused.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

U: union {
    w: W
    none: null
}

main: function is {
    a: Src n: 1
    w: mk from: a
    u: U.w w.take
    a.n = 5
    match (u) case w then print "\{u.tag}" else print "none"
}
