# A generic INSTANCE answers for the members its template declares: a mono has
# no unit of its own, so the template's declarations substituted ARE its whole
# member set. Both shapes below were silent before -- in statement position the
# call was dropped, zc exited 0, and the member went into the C verbatim as a
# struct-field access for the C compiler to reject with no zerolang location.
Widget: class {
    val: t
} as { t: anyval.generic }

main: function is {
    ns: (ListVal i64)
    ns.append from: 1
    ns.typoMethod
    w: Widget val: 7
    w.typoMethod
    print "n=\{ns.length}"
}
