# A bare reftype key is a lock-ish argument. Before pin-all that alone
# switched the receiver pin OFF: the view into the map's storage was handed
# out with nothing pinned, and the map could be rewritten under it.
Src: class {
    n: i64
}

main: function is {
    m: (Map String V: Src)
    m.set key: "a".string value: (Src n: 1)
    k: "a".string
    v: m.get key: k
    m.set key: "c".string value: (Src n: 3)
    match (v) case some then print "\{v.n}" case none then null
}
