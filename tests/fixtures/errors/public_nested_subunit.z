# public_nested_subunit.z -- a nested unit's `public:` block may not hold
# another `public:` block either; `g` is not exported by it.

util: unit {
    public: unit {
        :f
        public: unit { :g }
    }
    f: function out i64 is { return 1 }
    g: function out i64 is { return 2 }
}

main: function is {
    print "\{util.f}"
}
