# a block takes an OUTER local, then defines a new local of the same name; the
# outer take survives the block -- it is the outer binding that was moved, and
# a take is recorded against the binding, not the name -- so the outer name is
# unusable after it (E0200).
Box: class {
    n: i64
}
main: function is {
    x: Box n: 1
    {
        y: x.take
        x: Box n: 2
        print "\{y.n} \{x.n}"
    }
    print "\{x.n}"
}
