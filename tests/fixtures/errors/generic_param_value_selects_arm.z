# A type parameter read as a value is its instance's zero-argument
# construction, checked in each instance: a union has none, for building one
# selects an arm.

# Shape -- a square's side, or nothing
Shape: union {
    sq: i64
    none: null
}

# zero -- a value of the argument's type, built from nothing
zero: function as { T: AnyRef.generic } in {a: T.view} out T is {
    b: T
    return b
}

main: function is {
    z: zero a: Shape.none
    print "\{z.none}"
}
