eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
nope: function out bool is {
    return false
}
# a later conjunct moves too, and so does one that never runs: the checker
# reads the conditions, not the values.
main: function is {
    q: (ListVal u32)
    q.append 1
    m: 0
    for while m < 5 while (eat xs: q) loop {
        m = m + 1
    }
    r: (ListVal u32)
    r.append 1
    for while nope while (eat xs: r) loop {
        print "never"
    }
    print "\{m}"
}
