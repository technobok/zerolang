# generic_method_result_pins.z -- an `outx` result pins its receiver whether
# the method is generic or not. A generic method (`as { T: ... }`) once took its
# receiver for the call alone, so `stripPrefix`, `split` and a user class's
# generic method handed back a view of a String that could then be freed.
Box: class {
    name: String
    cut: function as { T: StringLike.generic } in {t: this.view p: T.view} outx StringView is {
        return (t.name.substring from: 1 to: 2)
    }
}

main: function is {
    s: "abc def".string
    o: s.stringView.stripPrefix p: "abc"
    s = "replaced".string
    match o case some then print o case none then null
    h: "abc def".string
    it: h.stringView.split sep: " "
    h = "replaced".string
    piece: it.call
    match piece case some then print piece case none then null
    b: Box name: "abc def".string
    c: b.cut p: "x"
    b.name = "replaced".string
    print c
}
