# A LOCAL OR A PARAMETER IS NEARER THAN ANY TYPE OF ITS NAME: a type written in
# a body -- a type argument, a declaration's type -- that names one finds that
# value, which is no type. Reach the type through its unit (`system.u8`).
local: function out u64 is {
    u8: 3
    xs: ListVal u8
    return xs.length
}

param: function {u8: i64} out u64 is {
    ys: ListVal u8
    return ys.length
}

main: function is {
    print "checked under --eager"
}
