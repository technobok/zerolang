# the dependency half of hold_return_unit_member: a function that takes no
# argument and hands back a frozen value. Standalone it is a unit with no entry
# point, which is what its own .err records.
public: unit {
    :Box9
    :mk
}

# Box9 -- one count, and a method that writes it
Box9: class {
    n: i64
} as {
    bump: function {:this} is {
        this.n = this.n + 1
    }
}

# mk -- a Box9 the caller may only read
mk: function out Box9.hold is {
    return (Box9 n: 5)
}
