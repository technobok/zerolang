# E0200: .drop is a statement, not a value. It ends a lifetime and hands back
# nothing, so a binding has nothing to take from it. The docs have said so
# since the marker existed; nothing enforced it, and the emitter wrote a member
# access that the C compiler then rejected.
crate: class { label: String }

main: function is {
    h: crate label: "x".string
    y: h.drop
}
