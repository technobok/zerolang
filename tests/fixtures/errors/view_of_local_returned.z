# A view keeps the storage it reads locked. Returned, it hands the caller a
# reference into that storage, so the storage must outlive the call: a view of
# a local -- read directly, through a field, derived from another view, or held
# by a binding -- points at a value that dies with this call, whether the
# function is `out` or `outx`.
Rec: class {
    name: String
}

direct: function out StringView is {
    s: "a".string
    return s.stringView
}

derived: function out StringView is {
    s: " abc ".string
    return s.stringView.trim
}

sliced: function {p: String} outx StringView is {
    s: "abc".string
    return (s.substring from: 0 to: 1)
}

throughField: function out StringView is {
    r: Rec name: "a".string
    return r.name.stringView
}

listed: function out (ListViewVal t: i64) is {
    l: ListVal i64
    l.append from: 1
    return l.listView
}

heldByBinding: function out StringView is {
    s: " abc ".string
    t: s.stringView.trim
    return t
}

main: function is {
    q: "q".string
    print (direct)
    print (derived)
    print (sliced p: q)
    print (throughField)
    print "\{listed.length}"
    print (heldByBinding)
}
