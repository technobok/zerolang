# AN EMPTY OBJECT DEFINITION IS AN ERROR: with no fields and no members there
# is nothing to hold and nothing to call. The emitter writes no struct for one
# (an empty struct is not C), so any use as a value produced C the compiler
# rejected while zc exited 0.
#
# `is native` is the exception, and the only one -- the runtime owns those
# layouts. `null`, `never`, `anyval` and `Any` are all declared that way.
empty: record { }

main: function is {
    v: empty
    print "made"
}
