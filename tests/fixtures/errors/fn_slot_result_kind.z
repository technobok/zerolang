# fn_slot_result_kind.z -- a function value fits a slot only when its result is
# the same kind of result: `outx` keeps the call's inputs locked for as long as
# the result lives, and a call through a slot typed `out` would keep nothing,
# so the result could outlive what it reads. Either way round is refused, and
# the message spells both signatures with their markers.
firstOutFn: function {s: String.view} out StringView

firstOutxFn: function {s: String.view} outx StringView

firstOutx: function {s: String.view} outx StringView is {
    return (s.substring from: 0 to: 2)
}

lengthOut: function {s: String.view} out StringView is {
    return "ab"
}

Hooks: class {
    f: firstOutFn
}

XHooks: class {
    f: firstOutxFn
}

main: function is {
    h: Hooks f: firstOutx.copy
    x: XHooks f: lengthOut.copy
    s: "abc".string
    print (h.f :s)
    print (x.f :s)
}
