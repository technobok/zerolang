# An `outx` result's non-owned field must reference what the CALLER still
# owns: a `.borrow`/`.view` parameter, or the receiver. A local dies with the
# call, so a result pointing into it would dangle the moment it is returned.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    loc: Src n: 2
    return (W s: loc tag: 1)
}

main: function is {
    a: Src n: 1
    w: mk from: a
    print "\{w.tag}"
}
