# E0300: the dot in a method-style call already supplies the receiver, so
# naming the receiver parameter as well supplies it twice. Silently ignoring
# one of them would compute an answer from an object the reader can see being
# passed, which is the shape of a wrong answer rather than a style question.
point: record {
    x: i64
} as {
    sub: function {t: this a: i64} out i64 is {
        return t.x - a
    }
}
main: function is {
    p: point x: 10
    q: point x: 100
    r: p.sub t: q a: 2
    print "\{r}"
}
