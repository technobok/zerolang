# E0100: what a generic function returns is checked against the instance each
# call specialises its declared return to.
five: function as { t: anyval.generic } in { a: t } out (ListVal t: t) is {
    return 5
}

ints: function as { t: anyval.generic } in { a: t } out (ListVal t: t) is {
    l: (ListVal t: i64)
    return l
}

main: function is {
    f: five t: i64 a: 4
    k: ints t: u8 a: 4
    print "\{f.length} \{k.length}"
}
