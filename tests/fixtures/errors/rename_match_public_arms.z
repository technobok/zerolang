# Through a public interface a match names the arms by their public names, and
# so does the report of the ones it leaves out: 'box', never the private
# 'boxArm'. A private name written as an arm is no arm from here.
main: function is {
    s: shapes.mkShape
    match (s) case circle then print "c"
    match (s) case boxArm then print "b" else print "?"
}
