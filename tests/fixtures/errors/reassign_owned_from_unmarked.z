# E0200: an unmarked name is a borrow, and a reassignment keeps the mode its
# target was bound with: an owned local or field is refused a bare local, a
# field read through one, a borrowed parameter, and an arm that yields a bare
# local. `.take` moves; `.copy` duplicates.
Cell: class { n: i64  s: String }
H: class { f: Cell  g: Cell }

f: function {p: Cell} is {
    x: Cell n: 1 s: "x".string
    x = p
    print "\{x.n}"
}

main: function is {
    x: Cell n: 1 s: "x".string
    d: Cell n: 2 s: "d".string
    x = d
    h: H f: (Cell n: 3 s: "f".string) g: (Cell n: 4 s: "g".string)
    h.f = d
    x = h.g
    c: true
    x = if c then d else (Cell n: 5 s: "c".string)
    f p: x
    print "\{x.n} \{h.f.n}"
}
