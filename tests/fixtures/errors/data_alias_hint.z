# E0100: on a unit-level line a label after the value begins a definition of
# its own, so `origin: row v: 1` is an alias of `row` and a constant `v`. A read
# through the alias says how a data value is written: in parentheses.
row: data { v: 3.u8 }
origin: row v: 1

main: function is {
    print "\{origin.v}"
}
