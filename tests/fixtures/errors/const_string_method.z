# E0600: a method on a string constant that the evaluator cannot answer for.
# Reported because a unit-level definition REQUIRES a value; the same call in a
# body condition simply does not fold and emits a runtime branch.
LIB: "quadmath"
BAD: (LIB.compare rhs: "x") == 0
main: function is {
    if BAD then {
        print "a"
    } else {
        print "b"
    }
}
