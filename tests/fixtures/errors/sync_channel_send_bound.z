# A Sender's `send` hands its value to whichever thread receives it, so a
# `thread.ThreadBound` value -- a lock guard -- is refused there.

main: function is {
    m: (sync.Mutex (ListVal i64)).create value: ListVal i64
    rx: (sync.Receiver (sync.MutexGuard (ListVal i64))).create
    tx: rx.sender
    tx.send value: m.lock
}
