# A lock-holding value moved into a `.take` parameter of a function that is
# not `outx` has nowhere to leave its locks: the callee owns the value, its
# result holds nothing, and the sources would be unlocked while still pointed
# into. Refused -- copy it first.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

eat: function {w: W.take} out i64 is {
    return w.tag
}

main: function is {
    a: Src n: 1
    w: mk from: a
    print "\{eat w: w}"
}
