# E0300: two instances of one generic unit declare two distinct types, so an
# `uc.Cell` does not stand in for an `ic.Cell`.
cells: unit as {
    t: anyval.generic
    Cell: record {
        val: t
    }
    make: function {v: t} out Cell is {
        return (Cell val: v)
    }
}
ic: (cells t: i64)
uc: (cells t: u8)
show: function {c: ic.Cell} out i64 is {
    return c.val
}
main: function is {
    print "\{show c: (uc.make v: 7)}"
}
