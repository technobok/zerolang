# conform_instance_missing_method.z -- a generic class whose template does not
# implement a spec method fails in every instance the same way. It is checked
# per instance, and reported once: the message names the template, so the
# second instance's report is the first one again.
Speaker: protocol {
    speak: function {t: this.view} out i64
}
Dog: class { v: t } as {
    t: anyval.generic
    :Speaker
    bark: function {t: this.view} out i64 is { return 1 }
}
main: function is {
    a: Dog v: 7
    b: Dog v: 7.u8
    print "\{a.bark} \{b.bark}"
}
