# A unit-level construction whose head names a member its unit does not declare
# is reported at the member, once. The list that reads the definition adds no
# second error of its own.
shapes: unit {
    point: data { n: 0 }
}

maker: unit {
    built: (shapes.pint n: 1)
}

everyPoint: list { maker.built } out staticlist shapes.point

main: function is {
    for each p: everyPoint loop print "\{p.n}"
}
