# A union arm wider than the 8-byte slot is refused at the arm, with the
# bytes its type takes: a u128 and an f128 are 16; a record chain 31 deep over
# a u128 is still that u128's 16; a `str` up to 255 chars holds a 1-byte
# length, a longer one a 2-byte length (`str to: 255` is 256 bytes,
# `str to: 300` 302); a variant is its tag, then its payload at the payload's
# alignment, padded to the wider of the two (a u32 tag and a u8 payload, 8
# bytes; a u8 tag and a u16 payload, 4); and a variant holding a function
# reference is not measured, so it is refused too.
r0: record { x: u128 }
r1: record { x: r0 }
r2: record { x: r1 }
r3: record { x: r2 }
r4: record { x: r3 }
r5: record { x: r4 }
r6: record { x: r5 }
r7: record { x: r6 }
r8: record { x: r7 }
r9: record { x: r8 }
r10: record { x: r9 }
r11: record { x: r10 }
r12: record { x: r11 }
r13: record { x: r12 }
r14: record { x: r13 }
r15: record { x: r14 }
r16: record { x: r15 }
r17: record { x: r16 }
r18: record { x: r17 }
r19: record { x: r18 }
r20: record { x: r19 }
r21: record { x: r20 }
r22: record { x: r21 }
r23: record { x: r22 }
r24: record { x: r23 }
r25: record { x: r24 }
r26: record { x: r25 }
r27: record { x: r26 }
r28: record { x: r27 }
r29: record { x: r28 }
r30: record { x: r29 }
r31: record { x: r30 }

unop: function {v: u64} out u64

tag4: variant {
    a: u8
    b: null
} as {
    tag: u32.tag
}
held12: record { v: tag4  x: u8 }

tag2: variant {
    a: u16
    b: null
}
held10: record { x: u8  v: tag2  y: u8  z: u16 }

withFn: variant {
    a: u8
    f: unop
}

Wide: union {
    big: u128
    quad: f128
    deep: r31
    s255: (str to: 255)
    s300: (str to: 300)
    h12: held12
    h10: held10
    fn: withFn
    s: String
}

main: function is {
    w: Wide.s "x".string
    match (w) case s then print w else print "wide"
}
