# E0200: readonly reaches through. Writing a field of a `hold` field mutates
# the frozen value just as a mutating method would, so the whole path is
# refused, not only its first step.
Inner: class {
    n: i64
}
Box: class {
    it: Inner.hold
}
main: function is {
    b: Box it: (Inner n: 1)
    b.it.n = 9
    print "\{b.it.n}"
}
