# An `out` clause names one type. Three words in a row read as an operator
# between two values, which names none; the function used to be given no
# return type, and its `return` reached the C in a function that returns
# nothing.

# label -- a return type written three times
label: function {n: i64} out String String String is {
    return "x".string
}

main: function is {
    print (label n: 42)
}
