# a binding of a value-type `getMut` result is a second name for the element,
# a pointer into the list's storage: it keeps the list locked while it lives,
# so an append -- which may move the storage -- is refused until it ends.
main: function is {
    xs: ListVal i64
    xs.append 7
    c: xs.getMut i: 0
    i: 0
    for i < 100 loop {
        xs.append i
        i = i + 1
    }
    print "\{c}"
}
