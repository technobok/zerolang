# A view of a ListVal element keeps the list locked for reading while it lives,
# as a List's `get` view does: growing the list under it could move the element
# the view reads, so an append is refused.
item: record {
    n: i64
}

main: function is {
    xs: ListVal item
    xs.append (item n: 1)
    v: xs.getView i: 0
    xs.append (item n: 2)
    print "\{v.n}"
}
