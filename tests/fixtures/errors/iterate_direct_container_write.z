# E0200: the direct `for x: xs.iterate` form has no iterator binding to carry
# the container's lock, so the ELEMENT carries it. Without that the append below
# is accepted and reallocates the storage `r` points into -- a use-after-free,
# reproduced under ASan. The `with it: xs.iterate` spelling always refused this;
# only the binding-free form was open.
Row: class { n: i64 }
main: function is {
    rows: (List Row)
    rows.append from: (Row n: 1)
    for r: rows.iterate loop {
        rows.append from: (Row n: 2)
        print "n=\{r.n}"
    }
}
