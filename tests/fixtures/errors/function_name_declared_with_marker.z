# A FUNCTION-TYPED SLOT WITH NO DEFAULT IS DECLARED BY A SPEC. A declaration
# that names a function with a body declares both the type and the default
# (`f: double`); a spec -- a function with no body -- declares the type alone
# (`f: doubleFn`), and the caller passes a function of that signature. A marker
# on the function's name was an undocumented third spelling, and not even one
# rule: a `.take` parameter lost the default and a `.take` field kept it. It is
# refused wherever a declaration names a type: a parameter, a field of a record
# or a class, and a return.
double: function {n: i64} out i64 is {
    return n * 2
}

Rec: record {
    op: double.take
}

Hook: class {
    op: double.borrow
}

apply: function {f: double.take n: i64} out i64 is {
    return (f n: n)
}

give: function out double.take is {
    return double.copy
}

main: function is {
    r: Rec op: double.copy
    h: Hook op: double.copy
    g: give
    print "\{apply f: double.copy n: 1} \{r.op n: 2} \{h.op n: 3} \{g n: 4}"
}
