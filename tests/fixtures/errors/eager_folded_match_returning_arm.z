# eager_folded_match_returning_arm -- A `match` folded to an arm that returns leaves the
# function on every path: the arms the fold rules out decide nothing.
shape: choice {
    circle: i64
    square: i64
    dot: null
}
SH: (shape.square 4)
f: function out i64 is {
    match SH case circle then print "circle" case square then return SH case dot then print "dot"
}
main: function is {
    print "\{f}"
}

# an error of its own, so the fixture is one the compiler refuses: every other
# definition is still checked under --eager, and must report nothing more
refused: function is {
    print "\{nosuchname}"
}
