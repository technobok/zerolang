# conform_missing_method.z -- a conformer that does not implement a spec method. The emitter pairs spec and
# implementation by name, so this was a gcc error at the vtable, or nothing at
# all when no Shape value is ever built.
Shape: protocol {
    area: function {t: this.view scale: u64} out u64
}

Sq: class { side: u64 } as {
    :Shape
    perimeter: function {t: this.view} out u64 is { return t.side * 4 }
}

main: function is {
    s: Sq side: 2
    print "\{s.side}"
}
