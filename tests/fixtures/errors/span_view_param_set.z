# span_view_param_set.z -- a window passed as `.view` is read-only like any
# view: writing through it is refused, though the window itself can write.

# writes through a window it was lent read-only
poke: function {w: (SpanVal u64).view} is {
    w.set i: 0 item: 3
}

main: function is {
    xs: ListVal u64
    xs.append from: 1
    w: xs.mutView
    poke :w
}
