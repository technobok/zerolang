# E0300: an instance's `create` checks its arguments against the instance's
# parameters, a written one's as a synthesised one's, and requires what has
# no default.
Pair: class {
    a: t
    b: String
} as { t: anyval.generic }

Made: class {
    a: t
    b: String
} as {
    t: anyval.generic
    create: function {v: t} out this is {
        return (meta.create a: v b: "made".string)
    }
}

main: function is {
    m: (Made t: u64).create v: "no"
    yes0: true
    p: (Pair t: u64).create a: yes0 b: "x".string
    q: (Pair t: u64).create a: 1
    print "\{m.b} \{p.b} \{q.b}"
}
