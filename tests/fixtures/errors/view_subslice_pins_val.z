# A window of a window pins the list as the first window did: the sub-slice
# outlives the temporary it was cut from, so the list stays shared-locked
# while it lives and the append that would reallocate under it is refused.
main: function is {
    xs: ListVal i64
    xs.append from: 1
    xs.append from: 2
    xs.append from: 3
    s2: (xs.slice from: 0 to: 3).slice from: 1 to: 3
    xs.append from: 4
    print "\{s2.get i: 0}"
}
