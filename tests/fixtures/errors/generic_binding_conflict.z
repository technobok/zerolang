# docs/spec.pdoc, Generic types: "If both an explicit generic argument and a
# concrete value argument are provided, they must be consistent. A conflict
# produces a compilation error." The same holds between two value arguments --
# a generic parameter takes ONE type, whatever bound it.
#
# inferGenericCallSubs took the FIRST binding and dropped every later one
# without comparing, so both shapes below compiled, ran, and silently narrowed
# the f64 into the i64 instantiation.
#
# A LITERAL argument is not a conflict and must keep coercing: `pick t: u8 n: 5`
# below binds u8 explicitly and the bare 5 follows it.
pick: function as { t: anyval.generic } in { n: t } out t is {
    return n
}

pair: function as { t: anyval.generic } in { a: t b: t } out t is {
    return a
}

main: function is {
    f: 2.5
    n: 7
    coerced: pick t: u8 n: 5
    print "coerced=\{coerced}"
    explicit: pick t: i64 n: f
    print "explicit=\{explicit}"
    inferred: pair a: n b: f
    print "inferred=\{inferred}"
}
