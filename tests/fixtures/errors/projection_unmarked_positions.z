# E0200: an unmarked projection bound to a name borrows its source, so the
# source is locked while it lives; handed to a destination that owns what it
# holds it takes the source, so a later read is a use after the move. A
# `.view` parameter cannot lend the writable borrow a projection holds.
Rd: protocol {
    rdn: function {t: this.view} out i64
}

PC: class { n: i64  s: String } as {
    :Rd
    rdn: function {c: this.view} out i64 is { return c.n }
}

H: class { r: Rd }

keep: function {r: Rd.take} out i64 is { return r.rdn }

readonly: function {d: PC.view} out i64 is {
    p: Rd.create from: d
    return p.rdn
}

main: function is {
    a: PC n: 1 s: "a".string
    print "\{readonly d: a}"
    p: Rd a
    a.n = 2
    print "\{p.rdn}"
    b: PC n: 3 s: "b".string
    print "\{keep r: (Rd b)}"
    print "\{b.n}"
    e: PC n: 4 s: "e".string
    h: H r: (Rd e)
    print "\{h.r.rdn} \{e.n}"
}
