# E0400 and nothing else: a refused generic argument stops the typecheck
# short of demanding a protocol's members, and the conformance check read the
# unresolved spec return as "nothing" -- a second error, refusing a conformer
# that matched. An unresolved return is no evidence; only the refusal remains.
Shape: protocol {
    area: function {t: this.view} out u64
}
Sq: class { side: u64 } as {
    :Shape
    area: function {t: this.view} out u64 is { return t.side * t.side }
}
Rock: class { w: u64 }
Fig: union { :Sq }
idOf: function as { T: Fig.generic } in {s: T} out u64 is { return 1 }
main: function is {
    r: Rock w: 2
    print "\{idOf s: r}"
}
