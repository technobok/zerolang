# E0300: `T.create` is a construction by the type's name, refused by the same
# rules as the bare name and the name given arguments -- one refusal each, in the
# words of the rule, never as a missing member. With no argument there is
# nothing to bind a view or an iterator to, or to project.
kd: variant { k: i64  z: null }

Sh: union { c: String  e: null }

GT: union { leaf: t  node: String } as { t: anyval.generic }

GSec: class { a: t } as {
    t: anyval.generic
    create: null
}

Sp: protocol {
    get: function {t: this.view} out i64
}

OC: class { n: i64 }

Pt: record { x: i64 }

probe: function is {
    a: kd.create
    b: kd.create k: 5
    c: Sh.create c: "a".string
    d: (Option T: OC).create
    e: GT.create leaf: 5
    f: GSec.create a: 1
    g: Sp.create
    h: StringView.create
    i: (ListIterVal t: i64).create
    j: Pt.create
}

main: function is {
    probe
}
