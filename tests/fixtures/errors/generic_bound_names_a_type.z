# a bound names a type the program declares, and one that HAS a `.generic`:
# the spec gives it to a union, a variant, a protocol, a facet and a numeric
# type. Every bound here constrained NOTHING -- an unmapped name fell through
# to "other", which every argument satisfied -- and the defaulted form
# registered no constraint at all. `AnyVal` and `Any.valtype` are the retired
# spellings of `anyval`, and are unknown names like any other.
Pt: record {
    x: i64
}
Holder: class {
    n: i64
}
rec: function as { T: Pt.generic } in { val: T.view } out u64 is {
    return 1
}
cls: function as { T: Holder.generic } in { val: T.view } out u64 is {
    return 2
}
unit9: function as { t: io.generic } in { val: t.view } out u64 is {
    return 3
}
bogus: function as { T: Bogus.generic } in { val: T.view } out u64 is {
    return 4
}
qualified: function as { T: io.Bogus.generic } in { val: T.view } out u64 is {
    return 5
}
defaulted: function as { T: (Bogus2.generic default: i64) } in { val: T.view } out u64 is {
    return 6
}
retired: function as { T: AnyVal.generic } in { val: T.view } out u64 is {
    return 7
}
Box5: record {
    v: t
} as {
    t: Bogus3.valtype
}
main: function is {
    b: Box5 t: i64 v: 3
    (print
        "\{rec val: (Pt x: 1)} \{cls val: (Holder n: 1)} \{unit9 val: 3} \{bogus val: 4} \{qualified val: 5} \{defaulted val: 6} \{retired val: 7} \{b.v}"
    )
}
