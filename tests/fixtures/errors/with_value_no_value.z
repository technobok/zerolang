# A `with` binds its name to a value as a plain binding does, so an expression
# that produces no value is refused there too: a call to a function with no
# `out`, a built-in one or the program's own. Without the refusal the value
# reaches the emitter, which stops on E0500, or the C compiler, which stops on
# a void value.
quiet: function is {
    print "quiet"
}

main: function is {
    with t: print "x" do print "in"
    with u: quiet do print "in"
    print "made"
}
