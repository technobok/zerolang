# construction_type_arg_names_nothing.z -- a construction's type argument that
# names nothing is reported as naming nothing, once, where it is written: "Unknown
# type" for a labelled one, which is a type position, and "Unknown reference"
# for a leading one, which may be a value. Each was "cannot infer generic
# parameter 't'" -- for a parameter the program had just written -- and a
# labelled one on a built-in collection went on to "unknown argument 't'". A
# local written there is a value where a type goes, as with a type whose fields
# infer the parameter (value_type_argument).
Cell: record {
    v: t
} as {
    t: anyval.generic
}

main: function is {
    a: ListVal nosuchA
    b: ListVal t: nosuchB
    c: (Cell t: nosuchC) v: 1
    d: Cell nosuchD
    x: 3
    e: ListVal t: x
    print "\{a.length} \{b.length} \{c.v} \{d.v} \{e.length}"
}
