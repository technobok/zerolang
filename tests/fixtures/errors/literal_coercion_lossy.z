# A LITERAL MEETS ITS TARGET TYPE AT A CALL, and that is the third place a
# literal is resolved against one -- the other two are the suffixed forms, in a
# body and at unit level, and both ask checkLiteralFits whether it fits. This
# one never did, so the coercion that makes `takes n: 5` work also let every
# line below through: the emitter folded 300 to 44, truncated 2.5 to 2, and
# wrapped -5 to 251, and each program RAN.
#
# `300.u8` and `2.5.i64` were refused all along. Coercion is not a second set of
# rules; it is the same conversion without the dot.
i8Takes: function {n: i8} is { print "n=\{n}" }
u8Takes: function {n: u8} is { print "n=\{n}" }
i64Takes: function {n: i64} is { print "n=\{n}" }

pick: function as { t: anyval.generic } in { n: t } out t is {
    return n
}

main: function is {
    u8Takes n: 300
    i64Takes n: 2.5
    u8Takes n: -5
    i8Takes n: -129
    g: pick t: i64 n: 2.5
    print "g=\{g}"
}
