# A `substring` of a constant string is a constant, in a body as at unit level,
# so a range outside the string is an error where it is written -- on a string
# constant's value and on a literal alike. It compiled, and panicked at run
# time; a literal's methods were not folded at all.
WORD: "abcd"

main: function is {
    ok: WORD.substring from: 1 to: 3
    a: WORD.substring from: 1 to: 9
    b: "xyz".substring from: 2 to: 1
    print "\{ok} \{a} \{b}"
}
