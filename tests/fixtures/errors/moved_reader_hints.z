# A move out of a string that something still reads is refused, and the hint
# names the reader: a view bound to a name is named, and a temporary an `outx`
# result keeps is called a temporary.
lfPass: function {v: StringView.view} outx StringView is {
    return v
}

namedReader: function is {
    s: "abc".string
    v: s.stringView
    t: s.take
    print v
    print t
}

temporaryReader: function is {
    s: "abc def".string
    r: lfPass v: (s.substring from: 0 to: 3)
    g: s.take
    print r
    print g
}

main: function is {
    namedReader
    temporaryReader
}
