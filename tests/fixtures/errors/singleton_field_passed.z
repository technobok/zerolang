# E0300: a field declared by a numeric generic parameter (`stored: cap`) is a
# slot of the parameter's singleton type, which holds one value: the
# construction sets it, so neither a construction nor `meta.create` passes it,
# with its value or another.
rec: record {
    stored: cap
    x: i64
} as {
    cap: u32.generic
    mk: function {v: i64} out type is {
        return (meta.create x: v stored: 7)
    }
}
R7: (rec cap: 7)
main: function is {
    b: (rec cap: 9) stored: 2 x: 1
    c: R7.mk v: 4
    print "\{b.x} \{c.x}"
}
