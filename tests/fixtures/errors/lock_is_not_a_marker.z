# `.lock` IS NOT A MARKER. It was a second spelling of `.borrow` and is gone, so
# the parser reads it as what it looks like -- a member read -- and the type has
# no such member. There is no migration diagnostic because there is nothing to
# migrate to but the spelling that already works.
#
# What the removal BUYS is below the error: `lock` was reserved in member
# position only because the language claimed it, so a type could not name a
# member `lock`. It can now, which is what any mutex-shaped API wants; the
# corpus fixture `member_named_lock.z` runs one.
Inner: class {
    n: i64
}

peek: function {c: Inner.borrow} out i64 is {
    return c.n
}

main: function is {
    v: Inner n: 7
    # the spelling that works
    print "borrow=\{peek c: v.borrow}"
    # and the one that does not
    print "lock=\{peek c: v.lock}"
}
