# An arm that carries a function is an arm of its sum, so an else-less match
# must cover it like any other: the arms are what the type declares as arms,
# whatever their payload's type.
binop: function {a: i64 b: i64} out i64
add: function {a: i64 b: i64} out i64 is { return a + b }
step: variant {
    stop: null
    num: i64
    apply: binop
}
run: function {s: step} out i64 is {
    match (s) case num then return s case stop then return 0
}
main: function is {
    print "\{run s: (step.apply add.copy)}"
}
