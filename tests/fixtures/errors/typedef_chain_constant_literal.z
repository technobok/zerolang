# A typedef of a typedef is built from a value of its base typedef. A unit
# constant is refused a literal there, as a body is.

# level -- a byte with a meaning of its own
level: typedef u8

# floor -- a level that stands for a floor of a building
floor: typedef level

Low: floor 3
Half: floor 2.5

main: function is {
    print "\{Low.u64} \{Half.u64}"
}
