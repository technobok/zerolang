# A FUNCTION FIRST DEMANDED THROUGH A CALL BASE IS CHECKED LIKE ANY OTHER. The
# base walk of `(build).count` suppresses bare construction -- a type name there
# is a qualifier -- and the suppression leaked into `build`'s own body, so
# `part: Part` was never checked for its missing field and reached the C as the
# bare name `Part`.
Part: class {
    size: i64
}

Box: class {
    count: i64
    part: Part
}

build: function out Box is {
    part: Part
    return (Box count: 1 part: part.take)
}

main: function is {
    print "\{(build).count}"
}
