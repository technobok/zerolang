# A type application whose head names nothing, as a field's type and as a
# parameter's: refused once each, at the head. The reference names no type --
# not the record its parts glue into (`Nope_i64`), which is defined below --
# so nothing is compared with it, and a construction or a call adds nothing.
Holder: class {
    b: (Nope i64)
}

show: function {x: (Nope i64)} out i64 is {
    return 1
}

Nope_i64: record {
    v: i64
}

main: function is {
    h: Holder b: (Nope_i64 v: 5)
    print "\{show x: (Nope_i64 v: 1)}"
}
