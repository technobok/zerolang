# unit_alias_read_as_value.z -- a unit-level value takes no labelled arguments:
# a label after it on the same line begins a definition of its own. So
# `origin: Pt x: 0 y: 0` is three definitions -- `origin`, an alias of the type
# Pt, and the constants `x` and `y` -- and that is legal. Reading an instance
# member through the alias is the mistake, and only there is it certain that a
# value was meant: the refusal says why `origin` names a type. A read through
# the type's own name, a re-export under that name, or a generic instance's
# alias keeps its own hint.
Pt: record {
    x: i64
    y: i64
} as {
    norm: function {:this} out i64 is { return (this.x * this.x) + (this.y * this.y) }
}

origin: Pt x: 0 y: 0
geo: unit {
    Spot: record { lat: i64 }
}
Spot: geo.Spot
Strs: (ListVal i64)

main: function is {
    print "\{origin.x}"
    print "\{origin.norm}"
    print "\{Pt.y}"
    print "\{Strs.length}"
    print "\{Spot.lat}"
}
