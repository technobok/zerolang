# stringview_borrow_moved.z -- a bare binding of a StringView borrows it, as for
# any reference type, so the borrow cannot be moved into a holder that takes
# what it is given. A StringView has no `.copy`, so the refusal names `.string`,
# which makes an owned String, rather than a copy it cannot make -- a readonly
# parameter and a narrowed arm payload as well as a plain name. (A collection
# cannot hold a view at all.)
Holder: class {
    held: Option T
} as {
    T: AnyRef.generic
    put: function {:this x: T.take} is {
        this.held = Option.some x.take
    }
}

names: list { a: "x" } out staticlist StringView

keepView: function {h: (Holder T: StringView) v: StringView.view} is {
    h.put x: v
}

main: function is {
    h: Holder held: (Option T: StringView).none
    s: "x"
    k: s
    h.put x: k
    keepView :h v: "y"
    with it: names.iterate do {
        o: it.call
        match (o) case some then h.put x: o case none then null
    }
}
