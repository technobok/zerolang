# stringview_borrow_moved.z -- a bare binding of a StringView borrows it, as for
# any reference type, so the borrow cannot be moved into a container that takes
# what it holds. A StringView has no `.copy`, so the refusal names `.string`,
# which makes an owned String, rather than a copy it cannot make -- a narrowed
# arm payload as well as a plain name.
names: list { a: "x" } out staticlist StringView

main: function is {
    m: MapRV StringView v: u8
    s: "x"
    k: s
    m.set key: k value: 1
    l: List StringView
    l.append "y"
    for each n: l loop m.set key: n value: 2
    with it: names.iterate do {
        o: it.call
        match (o) case some then m.set key: o value: 3 case none then null
    }
    print "\{m.length}"
}
