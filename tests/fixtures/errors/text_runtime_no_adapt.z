# text_runtime_no_adapt.z -- only a literal or an untyped constant becomes text
# at a text destination. A runtime value keeps its type: a local bound to a
# literal (a StringView), a typed list's element, a view of a String. And
# `.text` is a literal's conversion, never a runtime view's.
typed: list { a: "alpha" } out staticlist StringView

shout: function {t: text} out String is {
    return t.string
}

main: function is {
    v: "view"
    print (shout t: v)
    print (shout t: typed.a)
    s: "x".string
    print (shout t: s.stringView)
    w: v.text
    print w.stringView
}
