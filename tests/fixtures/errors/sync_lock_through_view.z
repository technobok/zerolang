# A `.view` of a sync handle only reads: locking, notifying, storing and
# waiting change the shared state, so each takes a borrow of the handle, and a
# view is refused. A task that changes it holds a handle of its own (`share`).

# peek -- tries to lock a Mutex it was only shown
peek: function {m: (sync.Mutex (ListVal i64)).view} out u64 is {
    g: m.lock
    return g.value.length
}

# poke -- tries to store through an atomic it was only shown
poke: function {a: sync.AtomicI64.view} is {
    a.store value: 1
}

main: function is {
    m: (sync.Mutex (ListVal i64)).create value: ListVal i64
    print "\{peek :m}"
    a: sync.AtomicI64.create value: 0
    poke :a
    print "\{a.load}"
}
