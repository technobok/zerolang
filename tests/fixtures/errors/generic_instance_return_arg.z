# E0300: the instance a generic function returns is a type like any other, so
# it does not stand in for a bool.
mk: function as { t: anyval.generic } in { a: t } out (ListVal t: t) is {
    l: (ListVal t: t)
    l.append from: a
    return l
}

yes: function { b: bool } out bool is {
    return b
}

main: function is {
    print "\{yes b: (mk t: i64 a: 4)}"
}
