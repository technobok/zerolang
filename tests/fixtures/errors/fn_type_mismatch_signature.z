# fn_type_mismatch_signature.z -- a function type is named after what declares
# it, and that name says nothing about what it takes: a mismatch against one
# spells its signature, on a slot that defaults to an `as`-block function, a
# slot named after a method taking the receiver, and a parameter declared by a
# unit function's name.

Cfg: record { v: i64  x: helper  y: twice } as {
    helper: function {n: i64} out i64 is { return n + 1 }
    twice: function {c: this} out i64 is { return c.v * 2 }
}

add: function {a: i64 b: i64} out i64 is { return a + b }
neg: function {a: i64} out i64 is { return 0 - a }
apply: function {a: i64 b: i64 f: add} out i64 is { return (f a: a b: b) }

main: function is {
    c: Cfg v: 3 x: 5 y: true
    print "\{c.v}"
    print "\{apply a: 1 b: 2 f: neg.copy}"
}
