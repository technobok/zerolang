# `out T.takex` pins the non-owned sources the result was built from, for as
# long as the result lives. Without the marker the same signature accepts this
# write and the result's `s` field is left pointing at a value the caller is
# free to mutate -- which is what `.lock` on the PARAMETER prevents today, and
# the only thing standing between `.lock` and retirement.
Src: class {
    n: i64
}

W: class {
    s: Src.lock
    tag: i64
}

mk: function {from: Src.borrow} out W.takex is {
    return (W s: from tag: 9)
}

main: function is {
    a: Src n: 1
    w: mk from: a
    a.n = 5
    print "tag=\{w.tag}"
}
