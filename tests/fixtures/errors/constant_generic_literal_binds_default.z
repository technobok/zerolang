# E0400: a unit constant's literal argument binds a generic parameter as a
# body's does: a user function's parameter takes the literal's default, i64,
# which `small` does not admit. The unit level judged the literal type
# itself, which `small` lists, and said only that the call has no
# compile-time value.
small: variant { :intliteral :u8 }

# same -- the value it is given, of any type `small` admits
same: function as { t: small.generic } in {x: t} out t is {
    return x
}

C: (same x: 7)

main: function is {
    print "\{C}"
}
