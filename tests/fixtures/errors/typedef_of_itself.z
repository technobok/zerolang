# A typedef wraps another type. One whose base is itself, directly or through
# another typedef, has no type at the end of the chain: it is refused where it
# is declared. With an `as` block such a typedef used to stop the compiler in
# a loop that never ended; without one it was accepted.

tag: typedef tag as {
}

a: typedef b

b: typedef a

main: function is {
    x: tag 5
    y: a 5
}
