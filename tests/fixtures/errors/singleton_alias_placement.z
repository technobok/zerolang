# E0100: an alias of a numeric generic parameter's singleton type -- an `as`
# item `SAME: cap`, a unit-level `X: B5.cap` -- names that type, so it types
# only a field or a local, as the parameter does: a parameter typed by one is
# refused, naming the bound to take instead.
Box: class {
    used: u32
    grow: function {:this n: SAME} is {
        this.used = this.used + n
    }
} as {
    cap: u32.generic
    SAME: cap
}
B5: (Box cap: 5)
X: B5.cap

give: function {v: X} out u32 is { return v }

main: function is {
    b: B5 used: 0
    b.grow n: 5
    print "\{give v: 5}"
}
