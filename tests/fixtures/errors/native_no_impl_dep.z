# an unbacked `is native` in a unit the program LOADS but did not write.
# `conjure` is never called; `answer` is what this reaches. The check read only
# the MAIN unit until it read every loaded one, so this exited 0 and emitted a
# live call whose C died at `implicit declaration of function 'z_t13'` -- a
# mangled name that never mentions conjurelib.
main: function is {
    print "\{conjurelib.answer}"
}
