# E0100: a floatliteral field gives a data type `==` but no hash, as an f64
# field does, so the type is no map key; a staticlist field gives it no `==`.
fl: data { f: floatliteral }
a: (fl f: 0.5)
li: data { xs: staticlist i64 }
nums: list { 1 2 }
b: (li xs: nums)

main: function is {
    m: MapVV fl v: u8
    m.set key: a value: 1
    print "\{a == a} \{b == b}"
}
