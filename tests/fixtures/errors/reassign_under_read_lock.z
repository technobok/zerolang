# E0200: replacing the whole object destroys the field 's' reads, so a write at
# or above a shared lock is rejected as well as one below it. Also a UAF before.
Item: class {
    label: String
    value: i64
}
peek_label: function {b: Item.borrow} out String.borrow is {
    return b.label
}
main: function is {
    e: Item label: "echo".string value: 5
    s: peek_label e
    e = (Item label: "new".string value: 9)
    print "\{s}"
}
