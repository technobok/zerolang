# E0100: a default written as a conversion of an expression is a compile-time
# constant, so an expression with no compile-time value cannot declare one.
# Neither can its path, whose base names no type: without the refusal the
# value's text was minted into a type, and the C compiler refused it.
seven: function out i64 is { return 7 }

f: function {v: (seven + 1).i32} out i32 is { return v }

main: function is {
    print "\{f v: 1}"
}
