# A BARE CALLABLE OBJECT IS A CALL, so passing one where its own type is
# expected passes what `call` answers -- an option -- and is refused as any
# mismatched argument is. The object itself is handed on with a marker:
# `drain k: t.borrow`, or `.take` to move it.
Ticks: class {
    n: i64
} as {
    call: function {:this} out optionval i64 is {
        if this.n >= 3 then return (optionval.none i64)
        this.n = this.n + 1
        return (optionval.some this.n)
    }
}

drain: function {k: Ticks} out i64 is {
    total: 0
    for v: k loop total = total + v
    return total
}

main: function is {
    t: Ticks n: 0
    print "\{drain k: t}"
}
