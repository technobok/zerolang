# An instantiation of a generic unit labelled with no parameter of the unit is
# refused, and reading through the instance says what is missing. The check
# used to stop with an internal panic instead: the instance has none of the
# unit's members, and the pass that walks an instance's functions took that
# for a broken compiler.

# box -- a unit over a size
box: unit {
    cap: i64.generic
    # the size
    size: function out i64 is {
        return 1
    }
}

b8: (box zork: 8)

main: function is {
    print "\{b8.size}"
}
