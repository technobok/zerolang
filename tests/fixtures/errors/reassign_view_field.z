# E0200: a `view` field is NOT owned -- it is set at construction, backed by a
# lock on the target, and the slot is static thereafter. The diagnostic names
# the marker the author wrote rather than assuming `.lock`.
Box: class {
    name: String.view
    value: i64
}
main: function is {
    b: Box name: "n".string value: 1
    other: "z".string
    b.name = other
    print "\{b.name}"
}
