# A unit is a scope, and a scope nests. A generic unit declared inside a plain
# unit is still a template, and its instantiated body is checked like any
# other: `v + "not a number"` against t = i32 is an argument mismatch. The
# descent used to stop one level down, so this body was never walked at all --
# neither as a template nor per instance -- and the error surfaced as C the
# compiler could not build.
outer: unit {
    pairops: unit as {
        t: anyval.generic
        twice: function {v: t} out t is { return v + "not a number" }
    }
    i32pair: (pairops t: i32)
}

main: function is {
    print "twice=\{outer.i32pair.twice 21}"
}
