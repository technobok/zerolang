# A `.borrow` input is pinned EXCLUSIVE: the result may be writing through its
# reference, so the caller may not even read the source until the result dies
# -- it reads through the result instead.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {a: Src.borrow} outx W is {
    return (W s: a tag: 1)
}

main: function is {
    x: Src n: 1
    w: mk a: x
    print "read: \{x.n}"
    print "\{w.tag}"
}
