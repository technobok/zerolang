# A container cannot keep the locks of the values it holds: it cannot tell
# which element holds which, so it could hand one out (`pop`) with no lock,
# and `keep` -- declared outside the block -- would then point into a dead
# `xs`. The append is refused, which closes the round trip at its start.

# Peek -- a view of a list its owner keeps
Peek: class {
    # the borrowed list
    xs: (ListVal i64).borrow
}

main: function is {
    keep: List Peek
    {
        xs: ListVal i64
        xs.append 1
        holder: List Peek
        holder.append (Peek :xs)
        keep.append holder.pop
    }
    print "\{keep.length}"
}
