# An `error` guarded by a condition over a numeric generic parameter is reached
# at the instantiation whose argument fails it: a compile-time error there.
Buffer: class {
    used: u32
    check: function {:this} is {
        if cap == 0 then error "capacity must not be zero"
    }
} as { cap: u32.generic }

main: function is {
    good: (Buffer cap: 8) used: 0
    good.check
    empty: (Buffer cap: 0) used: 0
    empty.check
    print "unreachable"
}
