# A field moved into a taking argument is gone for the rest of that call: a
# later argument that reads it -- through its owner, again, or by value -- is
# refused as a name read after it moved is, since the callee would hold the
# owner beside the value moved out of it.
Inner: class {
    p: String
}

Holder: class {
    p: String
    q: String
    inner: Inner
} as {
    useWith: function {:this s: String.take} out u64 is {
        return s.length + this.p.length
    }
    peekWith: function {this: this.view s: String.take} out u64 is {
        return s.length + this.p.length
    }
}

both: function {s: String.take h: Holder} out u64 is {
    return s.length + h.p.length
}

bothView: function {s: String.take h: Holder.view} out u64 is {
    return s.length + h.p.length
}

bothTaken: function {s: String.take h: Holder.take} out u64 is {
    return s.length + h.p.length
}

bothInner: function {s: String.take i: Inner} out u64 is {
    return s.length + i.p.length
}

two: function {s: String.take t: String.take} out u64 is {
    return s.length + t.length
}

withLength: function {s: String.take n: u64} out u64 is {
    return s.length + n
}

withText: function {s: String.take t: String} out u64 is {
    return s.length + t.length
}

ownerFirst: function {h: Holder s: String.take} out u64 is {
    return s.length + h.p.length
}

keep: function {s: String.take} out u64 is {
    return s.length
}

outer: function {h: Holder n: u64} out u64 is {
    return h.p.length + n
}

mk: function {} out Holder is {
    return (Holder p: "abc".string q: "de".string inner: (Inner p: "in".string))
}

implicitMove: function is {
    h: mk
    print "\{both s: h.p h: h}"
}

markedMove: function is {
    h: mk
    print "\{both s: h.p.take h: h}"
}

viewOfOwner: function is {
    h: mk
    print "\{bothView s: h.p h: h}"
}

ownerTaken: function is {
    h: mk
    print "\{bothTaken s: h.p h: h}"
}

sameFieldTwice: function is {
    h: mk
    print "\{two s: h.p t: h.p}"
}

fieldReadByValue: function is {
    h: mk
    print "\{withLength s: h.p n: h.p.length}"
}

fieldReadInOperand: function is {
    h: mk
    print "\{withLength s: h.p n: h.p.length + 1}"
}

fieldReadInInterpolation: function is {
    h: mk
    print "\{withText s: h.p t: "<\{h.p}>"}"
}

ownerShorthand: function is {
    h: mk
    print "\{both s: h.p :h}"
}

main: function is {
    implicitMove
    markedMove
    viewOfOwner
    ownerTaken
    sameFieldTwice
    fieldReadByValue
    fieldReadInOperand
    fieldReadInInterpolation
    ownerShorthand
}
