# match_null_case_no_value -- a match with a `null` case arm yields no value; binding it
# to a name is refused.
kind: variant {
    a: null
    b: null
}

k: function {v: kind} out i64 is {
    x: match v case a then 5 case b then null
    return x
}

main: function is {
    print "\{k v: kind.a} \{k v: kind.b}"
}
