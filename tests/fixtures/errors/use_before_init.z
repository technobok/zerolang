# A LOCAL IS GREY WHILE ITS OWN STATEMENT IS CHECKED: code runs top to bottom,
# so a local is in scope from the statement that declares it, and until that
# statement's value -- or a binding's expression -- is done it holds nothing.
# A use of it there finds the local, the nearest declaration of the name, and
# is refused, whatever an outer scope declares by that name. Reach the outer
# one by qualifying it, or name the local differently.
n: 4

point: record {
    x: i64
}

twice: function {v: i64} out i64 is { return v * 2 }

# its own value, beside a unit constant of the name
own: function out i64 is {
    n: n + 1
    return n
}

# its own value, naming a type
ctor: function out i64 is {
    point: point x: 10
    return 0
}

# its own value, naming a unit
unitName: function out bool is {
    path: path.isSeparator b: 47
    return path
}

# its own value, calling a unit function of the name
callee: function out i64 is {
    twice: twice v: 3
    return 0
}

# its own value, as a `:x` argument beside a parameter of the name
label: function {v: i64} out i64 is {
    if v > 0 then {
        v: twice :v
        return v
    }
    return v
}

# a loop's binding, in its own iterable
loopBinding: function out i64 is {
    xs: ListVal i64
    total: 0
    for each xs: xs loop total = total + xs
    return total
}

# a `with` binding, in its own value
withBinding: function out u64 is {
    s: "ab".string
    with s: s do {
        return s.length
    }
}

main: function is {
    print "checked under --eager"
}
