# E0200: `out T.hold` freezes the binding it lands on -- owned, and readable
# only. The marker parsed and was recorded nowhere before, so this compiled
# and mutated a value the signature promised was frozen.
Box9: class {
    n: i64
} as {
    bump: function {:this} is {
        this.n = this.n + 1
    }
}
mk: function {v: i64} out Box9.hold is {
    return (Box9 n: v)
}
main: function is {
    h: mk v: 5
    h.bump
}
