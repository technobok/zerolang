# E0100: falsy is the arm whose DISCRIMINATOR is 0, not the arm written first.
# The two coincide under the default tag -- u8, sequential from 0 -- which is
# why writing the falsy arm first is the least syntax that says it. An
# author-declared `data` tag names its own values and the position then says
# nothing: `LO` here carries 0 but is written second, and `NoZero` gives
# neither arm 0, so neither type has a falsy arm to test against.
nz_values: data { ON: 1  OFF: 2 }
NoZero: union { ON: null  OFF: null } as { tag: nz_values.tag }

rev_values: data { HI: 5  LO: 0 }
Reversed: union { HI: null  LO: null } as { tag: rev_values.tag }

main: function is {
    a: NoZero.ON
    if a then print "x"
    b: Reversed.LO
    if b then print "y"
}
