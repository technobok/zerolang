# E0100: a `data`-sourced tag makes a pair boolean-like only when its two
# discriminators ARE 0 and 1. `NoZero` gives neither arm 0; `Reversed` has a
# zero arm but pairs it with 5, so it is an enumeration that happens to have
# two elements rather than a truth value. The 0-and-1 cases, in either written
# order, are pinned by emitc_corpus/truthy_data_tag_cond.
nz_values: data { ON: 1  OFF: 2 }
NoZero: union { ON: null  OFF: null } as { tag: nz_values.tag }

rev_values: data { HI: 5  LO: 0 }
Reversed: union { HI: null  LO: null } as { tag: rev_values.tag }

main: function is {
    a: NoZero.ON
    if a then print "x"
    b: Reversed.LO
    if b then print "y"
}
