# E0023: an unknown bound -- `Any`, which zerolang does not have -- is reported
# at the atom that spells it, once per bound, not at the parameter's owner.
pick: function as { T: Any.generic } in { val: T } out T is {
    return val
}

Duo: record {
    x: A
    y: B
} as {
    A: Any.generic
    B: Any.generic
}

  holder: unit as {
    T: Any.generic
    Cell: record {
        v: T
    }
    make: function {v: T} out Cell is {
        return (Cell :v)
    }
}

h: (holder T: i64)

main: function is {
    print "\{pick val: 7}"
    d: Duo A: i64 B: i64 x: 1 y: 2
    print "\{d.x}"
    c: h.make v: 1
    print "\{c.v}"
}
