# `.copy` OF A BOUND METHOD HAS NO REFERENCE FORM, as `.take` of one has none
# (method_take_on_instance). A method reference is a plain function pointer
# with nowhere to carry the receiver: copy it off the TYPE and pass the
# receiver explicitly. A method that needs no argument is not refused -- read
# through an instance it is called, and `.copy` copies its result.
#
# Both receiver spellings are refused: `:this` records a member named `this`
# and `self: this` records a receiver NAME.
point: record {
    x: i64
} as {
    add: function {:this rhs: i64} out i64 is {
        return this.x + rhs
    }
    mul: function {self: this rhs: i64} out i64 is {
        return self.x * rhs
    }
}

main: function is {
    a: point x: 1
    f: a.add.copy
    g: a.mul.copy
    print "unreachable"
}
