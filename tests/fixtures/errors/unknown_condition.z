# unknown_condition.z -- a bare name used as a TRUTHINESS condition is name-
# resolved like any other value. The condition positions (an `if` head, a
# `when` guard, a `for while` head, a `for ... while` post-condition) each
# walked the value but never asked whether it resolved, so an unknown name
# typed to 0, silently disabled the bool check, and reached the emitter --
# which wrote the bare name straight into the C. A comparison in the same
# position always diagnosed, which is why this went unnoticed.
main: function is {
    n: 1
    if ghostcond then {
        print "a"
    }
    if n > 0 when ghostguard then {
        print "b"
    }
    for ghostloop loop {
        print "c"
    }
    for n > 9 loop {
        print "d"
    } while ghostpost
}
