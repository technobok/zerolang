# conform_receiver_marker.z -- a conformer whose receiver marker differs from the spec's. A call through
# Shape takes the lock the SPEC's receiver names, a shared one for `.view`;
# the implementation, mutable, could then write through it.
Shape: protocol {
    area: function {t: this.view scale: u64} out u64
}

Sq: class { side: u64 } as {
    :Shape
    area: function {:this scale: u64} out u64 is {
        this.side = this.side + 0
        return this.side * this.side * scale
    }
}

main: function is {
    s: Sq side: 2
    print "\{s.side}"
}
