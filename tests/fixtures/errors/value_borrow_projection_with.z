# E0200: `.borrow` on a value type where the value is copied borrows nothing,
# and is refused wherever it is written: a typedef built from it and a `with`
# as much as a binding. A protocol box, which points at its source, borrows it.
Rd: protocol {
    rdn: function {t: this.view} out i64
}
pt: record { x: i64 } as {
    :Rd
    rdn: function {c: this.view} out i64 is { return c.x }
}
P: typedef pt
main: function is {
    x: pt x: 1
    a: P x.borrow
    with w: x.borrow do print "\{w.x}"
    b: Rd x.borrow
    print "\{a.x} \{b.rdn}"
}
