# A template's constant over its numeric parameter that an instance cannot fold
# is reported at its definition, in the words the same constant gets outside a
# template and with the instance's note, whether it is read or not. It was "no
# member" at each read, or nothing at all -- `cap + nosuch` reached the C,
# which the C compiler refused.
Box: class {
    used: u32
    get: function {:this} out u32 is {
        return Box.K
    }
} as {
    cap: u32.generic
    K: (cap.max y: 2)
    UNREAD: (cap + nosuch)
}

Pair: record {
    x: i64
} as {
    n: u8.generic
    CMP: (n.compare rhs: 2)
}

sized: unit as {
    cap: u32.generic
    M: (cap.nosuch)
}

eight: (sized cap: 8)

main: function is {
    b: (Box cap: 8) used: 0
    p: (Pair n: 1) x: 1
    print "\{b.get} \{p.x} \{eight.M}"
}
