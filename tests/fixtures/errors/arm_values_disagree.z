# The arms of an `if` or a `match` used as a value yield one type. Two typed
# arms that disagree are refused once, and the untyped literal arm beside
# them is not then judged against either. A typedef is not its base, and a
# program's own type named `u8` is not the system's u8: an `if` whose arms
# yield the one and the other is refused, in either order. An arm that does
# not convert to the value's destination is refused once, at the arm.
u8: record { a: u64  b: u64 }
pt: record { a: u64  b: u64 }
wpt: typedef pt
shape: variant {
    a: null
    b: null
    c: null
}

small: function {v: system.u8} out system.u8 is {
    return v
}

main: function is {
    c: true
    s: shape.b
    m: match (s) case a then 5.u16 case b then 3.i32 case c then 70000
    x: u8 a: 1 b: 2
    y: small v: 7
    v: if c then x else y
    w: if c then y else x
    p: pt a: 1 b: 2
    q: wpt p
    e: if c then p else q
    f: if c then q else p
    a: 3.u16
    r: small v: (if c then {
        a
    } else {
        4
    })
    print "\{r}"
}
