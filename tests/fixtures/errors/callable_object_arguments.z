# An object that declares `call` is called by reading it bare. Arguments
# written after it have nowhere to go: they are passed through the member
# (`a.call x: 5`). The juxtaposed form used to pass the check and reach the
# emitter.

# Add -- adds its own number to the one it is given
Add: class { k: i64 } as {
    call: function {:this x: i64} out i64 is { return this.k + x }
}

main: function is {
    a: Add k: 1
    print "\{a 5}"
}
