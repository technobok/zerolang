# E0400: member use on a type parameter waits for the instance, but ADMISSION
# does not: a type outside a union bound, and a type that does not conform to
# a protocol bound, are refused at the instantiation.
Shape: protocol {
    area: function {t: this.view} out u64
}
Sq: class { side: u64 } as {
    :Shape
    area: function {t: this.view} out u64 is { return t.side * t.side }
}
Circ: class { r: u64 }
Rock: class { w: u64 } as {
    area: function {t: this.view} out u64 is { return t.w }
}
Fig: union { :Sq :Circ }
idOf: function as { T: Fig.generic } in {s: T} out u64 is { return 1 }
areaOf: function as { T: Shape.generic } in {s: T} out u64 is { return s.area }
main: function is {
    r: Rock w: 2
    # Rock is outside Fig
    print "\{idOf s: r}"
    # Rock has an `area` but declares no :Shape
    print "\{areaOf s: r}"
}
