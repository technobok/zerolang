# `(Cell :t)` written inside a declaration that owns no `t`. The label is a real
# parameter of Cell, so the label check passes; the VALUE `t` names nothing, and
# the parameterised typeref has no partial specialisation to resolve to. That
# used to mint a record shell and emit a parameter of incomplete type.
Cell: record {
    v: i64
} as { t: anyval.generic }

Plain: class {
    n: i64
} as {
    sum: function {:this c: (Cell :t)} out i64 is { return this.n }
}

main: function is {
    p: (Plain n: 1)
    print "n=\{p.n}"
}
