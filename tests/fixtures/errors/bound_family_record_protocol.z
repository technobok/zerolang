# A protocol bound admits reference types only, though a record may conform to
# the protocol: the record is refused as the generic argument, and a protocol
# VALUE holding it (a `Named` parameter) is still accepted.
Named: protocol {
    label: function {t: this.view} out i64
}

pt: record { x: i64 } as {
    :Named
    label: function {t: this.view} out i64 is { return t.x }
}

show: function as { T: Named.generic } in { v: T.view } is {
    print "\{v.label}"
}

useN: function {n: Named} out i64 is { return n.label }

main: function is {
    show v: (pt x: 1)
    print "\{useN n: (pt x: 2)}"
}
