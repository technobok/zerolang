# A task's result crosses back to the thread that joins it, so a result type
# holding a `thread.ThreadBound` type -- a lock guard -- is refused where the
# task is handed to `thread.spawn`.

# Grabbed -- a result that would carry a guard back
Grabbed: class {
    # the guard, which unlocks on the thread that locked
    g: sync.MutexGuard (ListVal i64)
}

# Grabber -- answers a Grabbed
Grabber: class {
    # the Mutex it locks
    m: sync.Mutex (ListVal i64)
} as {
    task: (thread.Task Grabbed)
    call: function {:this} out Grabbed is {
        panic msg: "never runs: the spawn is refused"
    }
}

main: function is {
    m: (sync.Mutex (ListVal i64)).create value: ListVal i64
    h: thread.spawn task: (Grabber m: m.share)
}
