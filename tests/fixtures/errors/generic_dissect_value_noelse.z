# E0400: a compile-time `match` used as a VALUE with no case for what the
# instance bound and no else is refused at that instance, as the statement
# form is.
code: function as { t: anyval.generic } in { v: t } out i64 is {
    k: match (t) case i64 then 1 case f64 then 2
    return k
}

main: function is {
    print "\{code t: bool v: true}"
}
