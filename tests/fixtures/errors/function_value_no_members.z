# A function VALUE has no members. `.copy` of a function reference yields
# another reference, and the only things a reference does are be called and be
# assigned to a matching slot -- so every member read on one is refused where
# the type is, rather than reaching the emitter as an E0500 or the C as a field
# of a function pointer. (A reference read BARE is a call: `q.y` reads the
# result's `y`, as `mkPt.y` does -- fnref_bare_call.)
#
# Its PARAMETERS are its declared children, which is why a parameter name used
# to resolve and emit `q.a` against a function pointer: a parameter is reached
# by a CALL, by label, and is not a member of the value.
pt: record {
    x: i64
    y: i64
}

mkPt: function {} out pt is {
    return (pt x: 1 y: 2)
}

add: function {a: i64 b: i64} out i64 is {
    return a + b
}

Holder: class {
    hook: function {a: i64 b: i64} out i64
}

memberInInterp: function is {
    q: mkPt.copy
    print "\{q.copy.y}"
}

memberBound: function is {
    q: mkPt.copy
    r: q.copy.y
    print "\{r}"
}

parameterIsNotAMember: function is {
    q: add.copy
    print "\{q.copy.a}"
}

parameterThroughAField: function {h: Holder} is {
    q: h.hook.take
    print "\{q.copy.a}"
}

operatorIsAMember: function is {
    q: add.copy
    r: q.copy + 1
    print "\{r}"
}

main: function is {
    memberInInterp
    memberBound
    parameterIsNotAMember
    h: Holder hook: add.copy
    parameterThroughAField :h
    operatorIsAMember
}
