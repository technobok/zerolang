# A function VALUE has no members. `.take` on a function name yields a
# reference, and the only things a reference does are be called and be assigned
# to a matching slot -- so every member read on one is refused where the type
# is, rather than reaching the emitter as an E0500 or the C as a field of a
# function pointer.
#
# Its PARAMETERS are its declared children, which is why a parameter name used
# to resolve and emit `q.a` against a function pointer: a parameter is reached
# by a CALL, by label, and is not a member of the value.
pt: record {
    x: i64
    y: i64
}

mkPt: function {} out pt is {
    return (pt x: 1 y: 2)
}

add: function {a: i64 b: i64} out i64 is {
    return a + b
}

Holder: class {
    hook: function {a: i64 b: i64} out i64
}

memberInInterp: function is {
    q: mkPt.take
    print "\{q.y}"
}

memberBound: function is {
    q: mkPt.take
    r: q.y
    print "\{r}"
}

memberAsStatement: function is {
    q: mkPt.take
    q.y
}

memberUndeclared: function is {
    q: mkPt.take
    print "\{q.length}"
}

parameterIsNotAMember: function is {
    q: add.take
    print "\{q.a}"
}

parameterThroughAField: function {h: Holder} is {
    q: h.hook.take
    print "\{q.a}"
}

operatorIsAMember: function is {
    q: add.take
    r: q + 1
    print "\{r}"
}

copyIsAMember: function is {
    q: add.take
    print "\{q.copy}"
}

main: function is {
    memberInInterp
    memberBound
    memberAsStatement
    memberUndeclared
    parameterIsNotAMember
    h: Holder hook: add.take
    parameterThroughAField :h
    operatorIsAMember
    copyIsAMember
}
