# E0300: a parameter typed by a static list default takes a static list; a List
# built at run time is another type, and the hint says how a static list is
# written
countOf: function {xs: list { "a" }} out u64 is {
    return xs.length
}
main: function is {
    names: List StringView
    names.append "x"
    print "\{countOf xs: names}"
}
