# An owned result whose type declares a non-owned field, returned by a METHOD:
# held to `outx` as a free function is. The refusal underlines the method's own
# name, as the declaration writes it -- not its type's name joined to it.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

Maker: class {
    k: i64
} as {
    mk: function {t: this from: Src.borrow} out W is {
        return (W s: from tag: t.k)
    }
}

main: function is {
    a: Src n: 1
    m: Maker k: 9
    w: m.mk from: a
    print "\{w.tag}"
}
