# E0300: bare-name construction of the enclosing type from inside that type's
# own `create` is unbounded recursion -- the constructor calls itself. The spec
# (docs/spec.pdoc "Constructor") mandates the refusal and the hint: `meta.create`
# is how a create body produces the instance. Three shapes, one cause: an `as`
# block, a body block, and the zero-argument form (a bare type name in value
# position is a zero-argument create).
Tally: record {
    size: 0.u64
} as {
    create: function {size: 0.u64} out this is {
        t: Tally size: size
        return t
    }
}
Gauge: record {
    size: 0.u64
    create: function {size: 0.u64} out this is {
        g: Gauge size: size
        return g
    }
}
Meter: record {
    size: 0.u64
} as {
    create: function {size: 0.u64} out this is {
        m: Meter
        return m
    }
}
main: function is {
    a: Tally size: 1
    b: Gauge size: 2
    c: Meter size: 3
    print "\{a.size} \{b.size} \{c.size}"
}
