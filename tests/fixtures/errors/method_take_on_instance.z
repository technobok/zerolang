# `.take` ON A BOUND METHOD HAS NO REFERENCE FORM. A method reference is a plain
# C function pointer and a pointer has nowhere to carry the receiver, so
# `r.add.take` emitted the identical C to the bare `r.add` -- the method called
# with the receiver and none of its arguments, at exit 0. Take it off the TYPE
# and pass the receiver explicitly; method_ref_unbound.z pins that form working.
#
# Both receiver spellings are refused: `:this` records a member named `this`
# and `self: this` records a receiver NAME, and a predicate that asks only one
# of those refuses one spelling and accepts the other.
point: record {
    x: i64
} as {
    add: function {:this rhs: i64} out i64 is {
        return this.x + rhs
    }
    mul: function {self: this rhs: i64} out i64 is {
        return self.x * rhs
    }
}

main: function is {
    a: point x: 1
    f: a.add.take
    g: a.mul.take
    print "\{f} \{g}"
}
