# A list inside a data value is a value of its field's list type: its elements
# are of the field's element type, and an `out` written on it must name the
# field's type. Each was a list of its own type that the field then refused.
entry: data {
    needs: staticlist text
    codes: staticlist u8
}
a: (entry needs: list { 1 2 } codes: list { 9 })
b: (entry needs: list { "x" } codes: list { 9 } out staticlist u16)
c: (entry needs: list { "x" } codes: list { 300 })

main: function is {
    print "\{a.codes.length} \{b.codes.length} \{c.codes.length}"
}
