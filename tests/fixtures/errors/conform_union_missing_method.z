# conform_union_missing_method.z -- a union conforms to a protocol as a class
# does, and is checked the same way: one that does not implement a spec method
# is refused at its marker. The marker used to be dropped from a union's `as`
# block, so this compiled, and a `Shape` passed as a `Speaker` was refused as
# not conforming at all.
Speaker: protocol {
    speak: function {t: this.view} out i64
}
Shape: union {
    sq: String
    none: null
} as {
    :Speaker
    shout: function {t: this.view} out i64 is { return 1 }
}
main: function is {
    m: Shape.sq "x".string
    print "\{m.shout}"
}
