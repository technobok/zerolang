# `break` and `continue` are names a `for` loop or a block brings into scope:
# a loop defines both, a block only `break`. Outside every one of them each is
# refused where it is written -- in a function called from inside a loop too,
# since a body sees only its own scopes. Without the refusal the name finds the
# system builtin, and the C compiler rejects the `break;` the emitter writes.
leave: function is {
    break
}

next: function is {
    continue
}

main: function is {
    i: 0
    for i < 2 loop {
        i = i + 1
        leave
    }
    next
    {
        continue
    }
    print "made"
}
