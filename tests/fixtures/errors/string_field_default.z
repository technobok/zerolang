# A field defaulted to an OWNED String is refused: `"counter".string` allocates,
# and a default is a compile-time constant re-emitted wherever the field is left
# out. A plain string default is a StringView and is legal
# (emitc_corpus/default_string_constant); a real String field (`s: String`,
# filled by the constructor) is unaffected, and so is a numeric default.
Counter: class {
    pos: 0
    tag: "counter".string
}

main: function is {
    c: Counter
    print "pos=\{c.pos}"
}
