# A list is a value of ITS type: `staticlist u8` for a block of u8, never a
# value of another element type or of the other numeric family.
bytes: list { 1 2 3 } out staticlist u8
halves: list { 0.5 0.25 }

wide: function {d: staticlist u16} out u64 is {
    return d.length
}

ints: function {d: staticlist i64} out u64 is {
    return d.length
}

main: function is {
    print "\{wide d: bytes} \{ints d: halves}"
}
