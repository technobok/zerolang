# arg_value_unresolved.z -- an argument whose VALUE resolves nowhere. The value
# typed to 0, which silently disabled every check on that argument, and the
# emitter wrote the bare name into the C: zc exited 0 and only the C compiler
# caught it. Covers the named, positional, constructor and method forms; the
# `:name` shorthand twin is elided_arg_unresolved.z.

Box: record {
    v: 0.u64
}

Gadget: class {
    value: 0.i64
} as {
    bump: function {:this by: i64} is {
        this.value = this.value + by
    }
}

takes: function {a: u64} out u64 is {
    return a + 1
}

main: function is {
    n: takes a: ghostNamed
    p: takes ghostPositional
    b: Box v: ghostField
    g: Gadget
    g.bump by: ghostArg
    print "\{n} \{p} \{b.v} \{g.value}"
}
