# bound_unmet_reported_in_statement_file -- an unmet bound on a type made inside a
# statement is reported in the file of that statement, here another unit's function
# body.
# The error is in the subunit g5lib.z, at the line of `make` that makes the Box; the
# golden's place line names that file, not this one.
main: function is {
    print "start"
    g5lib.make
}
