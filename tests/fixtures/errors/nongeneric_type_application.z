# A type application names an instance of a generic template. Written over a
# type with no parameters it named nothing, and was accepted: a signature
# minted an instance of the record (`pt_i64`) that no value could ever be,
# and a field or a typedef took a type nothing defined.
Plain: protocol {
    get: function {t: this.view} out i64
}

pt: record { x: i64 }

Holder: class { p: (pt v: i64) }

Kit: typedef (pt v: i64)

usePlain: function {p: (Plain v: i64).view} out i64 is { return p.get }

usePt: function {q: (pt v: i64)} out i64 is { return q.x }

main: function is {
    f: usePlain.take
    g: usePt.take
    h: Holder p: (pt x: 1)
    k: Kit (pt x: 2)
    print "\{k.x}"
}
