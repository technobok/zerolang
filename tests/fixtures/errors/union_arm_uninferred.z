# An arm constructed without the type's arguments infers only the parameters
# its declared payload names. `node` holds a String and `label` a u8, so their
# values name no `t`; `none` carries nothing, so nothing does; and `pick` names
# `t` but not `e`. Each was accepted: the first two built an instance from the
# payload's type (`(Tree t: String)`, past t's own bound), the null arm reached
# the C as the uninstantiated template.
Tree: union { leaf: t node: String } as {
    t: anyval.generic
}

Tagged: union { val: t label: u8 } as {
    t: anyval.generic
}

Opt: union { some: t none: null } as {
    t: anyval.generic
}

Either: union { pick: t other: e } as {
    t: anyval.generic
    e: anyval.generic
}

main: function is {
    a: Tree.node "s".string
    b: Tagged.label 3.u8
    c: Opt.none
    d: Either.pick 1
    print "unreachable"
}
