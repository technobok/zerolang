# E0100: a choice declares its layout by its arms and is concrete: it cannot be
# native, take type parameters, or be declared in a generic unit.
nat: choice is native

gen: choice {
    v: t
} as {
    t: anyval.generic
}

box: unit {
    t: anyval.generic
    item: choice {
        a: null
        b: u8
    }
}

main: function is {
    print "x"
}
