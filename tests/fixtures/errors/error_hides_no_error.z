# AN ERROR HIDES NO OTHER ERROR: one compile reports each mistake in the
# program, whatever else is wrong in it, and each one once.
# - `main` names nothing (`missing`).
# - A slot written in a type that a generic unit declares is refused in the
#   unit instance whose argument resolves (`wb`), beside the instance whose
#   argument names nothing (`wa`), which adds no error of its own.
# - A dissection with no case for an instance's value is refused in that
#   instance, beside the other errors (`Pick` at `k: 3`).
# - An error the template's walk finds is the template's: it is reported
#   once, not again for each instance (`Gizmo`).
# - A call whose argument the bound refuses is refused at the call, and the
#   instance it asks for adds nothing more (`idv` of a `String`).
# - A generic unit with no instance asks its constants for no value (`spare`).
Pick: class {
    used: u64
    only: function {:this} out StringView is {
        match k case 1 then {
            return "one"
        }
    }
} as { k: u64.generic }

wrap: unit as {
    n: u64.generic
    bag: class {
        v: i64
    } as {
        bad: function {b: this.view} is {
            c: n
            c = 4
        }
    }
    make: function out bag is {
        return (bag v: 1)
    }
    choose: function out StringView is {
        p: (Pick k: n) used: 0
        return p.only
    }
}
wa: (wrap n: NOPE)
wb: (wrap n: 3)

Gizmo: class {
    used: u32
} as {
    cap: u32.generic
    size: function {:this} out u32 is {
        return this.nothing
    }
}

idv: function as { t: anyval.generic } in { val: t } out t is {
    return val
}

spare: unit as {
    cap: i64.generic
    D: cap.i64
    E: D * 2
    get: function {} out i64 is {
        return D + E
    }
}

main: function is {
    x: missing
    a: wa.make
    a.bad
    b: wb.make
    b.bad
    print "\{wb.choose}"
    g4: (Gizmo cap: 4) used: 0
    g5: (Gizmo cap: 5) used: 0
    print "\{g4.size} \{g5.size}"
    s: "text".string
    r: (idv val: s.take)
    print "\{r}"
}
