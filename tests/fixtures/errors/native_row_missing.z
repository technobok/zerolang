# native_row_missing.z -- a unit with its own C implementation file
# (native_row_missing/nativec.zd) that has a row for one native and none for
# the other: the missing row is refused at its declaration, and the file is
# not reported missing.
present: function {n: i64} out i64 is native

absent: function {n: i64} out i64 is native

main: function is {
    print "\{present n: 1}"
}
