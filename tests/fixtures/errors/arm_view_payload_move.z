# E0200: the payload of a `.view` arm cannot be moved out either -- a
# non-owned readonly field has nothing to give. This is the general rule
# reaching the case the view-family heuristic special-cases.
Inner: class {
    n: i64
}
U: union {
    some: Inner.view
    none: null
}
main: function is {
    i: Inner n: 1
    u: U.some i
    match (
        u
    ) case some then {
        gone: u.take
        print "n=\{gone.n}"
    } else null
}
