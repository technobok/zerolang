# A bound over another of the template's parameters, `T: (Getter v: k).generic`,
# is decided once the instantiation binds k: with k = i64, a Byte -- which
# conforms to `(Getter v: u8)` -- does not satisfy it. It was admitted
# unchecked: one argument alone cannot decide a partial instance.
Getter: protocol {
    v: anyval.generic
    get: function {t: this.view} out v
}

Byte: class { b: u8 } as {
    g: (Getter v: u8)
    get: function {t: this.view} out u8 is { return t.b }
}

read: function {t: T u: k} out k is { return t.get } as {
    k: anyval.generic
    T: (Getter v: k).generic
}

Pair: class { t: T  u: k } as {
    k: anyval.generic
    T: (Getter v: k).generic
}

main: function is {
    print "\{read t: (Byte b: 7) u: 3}"
    p: Pair t: (Byte b: 7) u: 2
    print "\{p.u}"
}
