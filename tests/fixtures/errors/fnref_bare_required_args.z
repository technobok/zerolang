# A BARE FUNCTION REFERENCE IS A CALL, so one whose function needs arguments is a
# call missing them -- the words a bare function name with required parameters
# gets -- wherever the reference is held: a local, a parameter, a field, and the
# `:name` shorthand, which passes the local's value. The reference itself is
# handed on with `.copy`.

# doubleFn -- a function reference with double's signature: the type, with no default
doubleFn: function {n: i64} out i64

double: function {n: i64} out i64 is {
    return n * 2
}

Hook: class {
    op: doubleFn
}

apply: function {f: doubleFn n: i64} out i64 is {
    return (f n: n)
}

param: function {f: doubleFn} is {
    f
}

main: function is {
    f: double.copy
    v: f
    h: Hook op: double.copy
    w: h.op
    x: apply :f n: 1
    param f: f.copy
}
