# Records spelled like the printable builtins are records: an interpolation
# asks the type, not its spelling, so each of these is refused at the checker.
u8: record { lo: i16 }
f64: record { lo: i16 }
bool: record { lo: i16 }
String: record { lo: i16 }
StringView: record { lo: i16 }

main: function is {
    a: u8 lo: 1
    b: f64 lo: 2
    c: bool lo: 3
    d: String lo: 4
    e: StringView lo: 5
    print "\{a} \{b} \{c} \{d} \{e}"
}
