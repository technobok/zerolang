# the Box hint names the arm's type AS WRITTEN. An arm whose type is an
# application, a nested one, a sized string or a dotted name spells no atom,
# and the hint read `many: (Box )` -- a suggestion the author cannot copy.
row: record {
    n: i64
}
Shape: union {
    many: (array t: row to: 2)
    deep: (array t: (array t: i64 to: 2) to: 2)
    text: (str to: 8)
    num: core.i64
    none: null
}
main: function is {
    s: Shape.none
    match (
        s
    ) case many then print "many" case deep then print "deep" case text then print "text" case num then print "num" case none then print "none"
}
