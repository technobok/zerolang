# else_write_ends_guard_narrowing -- A write in an else that completes ends the
# narrowing a diverging clause's condition gives the code after the `if`: the name reads
# the whole option.
f: function {a: optionval i64 b: optionval i64} out i64 is {
    x: a
    if x.none then return 0 else {
        x = b
    }
    return x + 1
}
main: function is {
    print "\{f a: (optionval.some 4) b: (optionval.none i64)}"
}
