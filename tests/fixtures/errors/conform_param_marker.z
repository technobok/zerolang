# conform_param_marker.z -- a conformer whose parameter marker differs from the spec's: the spec lends
# the name, the implementation would take it.
Sink: protocol {
    put: function {t: this.view s: String} out u64
}

Sq: class { side: u64 } as {
    :Sink
    put: function {t: this.view s: String.take} out u64 is { return s.length }
}

main: function is {
    s: Sq side: 2
    print "\{s.side}"
}
