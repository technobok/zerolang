# E0600: a constant derived from one over a numeric generic parameter is folded
# in each instance, so a division by zero on its way is refused there. `G`
# reads `F`, not `cap`, and its instance's value was taken as 0 with no report.
sized: unit as {
    cap: i64.generic
    F: cap / 0
    G: F + 1
    get: function {} out i64 is {
        return G
    }
}
four: (sized cap: 4)
main: function is {
    print "\{four.get}"
}
