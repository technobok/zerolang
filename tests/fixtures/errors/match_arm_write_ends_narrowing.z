# match_arm_write_ends_narrowing -- A write to the subject in an arm that completes ends
# the narrowing a diverging arm gives the code after the `match`.
f: function {a: optionval i64 b: optionval i64} out i64 is {
    x: a
    match x case none then return 0 case some then {
        x = b
    }
    return x + 1
}
main: function is {
    print "\{f a: (optionval.some 4) b: (optionval.none i64)}"
}
