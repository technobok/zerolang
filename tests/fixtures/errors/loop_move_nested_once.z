eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
nope: function out bool is {
    return false
}
# an inner loop that moves a local declared outside both loops: reported at
# the inner loop, once.
main: function is {
    e: (ListVal u32)
    e.append 1
    i: 0
    for while i < 2 loop {
        i = i + 1
        j: 0
        for while j < 2 loop {
            j = j + 1
            if (eat xs: e) then print "yes"
        }
    }
}
