# E0300: the receiver is the FIRST declared parameter, so in a type-qualified
# call it takes positional slot 0 -- and the next parameter therefore needs its
# label. Excluding the receiver from the positional count credited slot 0 to
# 'a' instead, so this ran with 'a' at zero rather than being reported.
point: record {
    x: i64
} as {
    sub: function {t: this a: i64} out i64 is {
        return t.x - a
    }
}
main: function is {
    p: point x: 10
    r: point.sub p
    print "\{r}"
}
