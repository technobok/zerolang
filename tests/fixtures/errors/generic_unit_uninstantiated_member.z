# A generic unit's contents are used through an instance of it: a function read
# through the unit itself has no argument for its parameter. It reached the
# emitter as "unhandled interp part type t".
mathops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
}

main: function is { print "\{mathops.add a: 1 b: 2}" }
