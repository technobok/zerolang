# E0100: a record or a class holds its data in fields, so one that declares
# none is refused at its definition, whatever its `as` block declares --
# methods, a generic parameter, a numeric one. Each was accepted and then
# emitted C naming a struct that was never written (`agent_C/n38`). A
# generator declares no fields legally; that stays (generator_declared_form.z).
Tagged: class {
} as {
    t: anyval.generic
}

Named: record {
} as {
    t: anyval.generic
    name: function {m: this} out u64 is {
        return 7
    }
}

Plain: record {
} as {
    name: function {m: this} out u64 is {
        return 8
    }
}

Sized: record {
} as {
    n: u64.generic
}

main: function is {
    a: (Tagged t: u8)
    b: (Named t: u8)
    c: Plain
    d: (Sized n: 3)
    print "\{b.name} \{c.name}"
}
