# A TEMPLATE declares its own member set: what instantiation mints is each
# member's substituted TYPE, never a new member NAME. A typo in a template body
# was silent while that body's single walk stayed lenient, and the member then
# went into every instance's C verbatim as a struct-field access, at exit 0.
#
# `this.cap` beside it is the contrast that must stay accepted: a generic
# PARAMETER read through the type declaring it is a member of neither the
# template nor its instances, and the parameter list is what vouches for it.
Gadget: class {
    used: u32
} as {
    cap: u32.generic

    poke: function {:this} is {
        this.typoMethod
    }

    room: function {:this} out u32 is {
        return this.cap
    }
}

main: function is {
    g: (Gadget cap: 8) used: 0
    g.poke
    print "room=\{g.room}"
}
