# thread_detached_borrow.z -- spawnDetached is `out`: nothing keeps what a
# detached task borrows alive, so a task that holds a borrow is refused.

# Peek -- reads a list it borrows
Peek: class {
    # the borrowed input
    xs: (ListVal i64).borrow
} as {
    task: thread.Task
    call: function {:this} is {
        print "\{this.xs.length}"
    }
}

main: function is {
    xs: ListVal i64
    xs.append 1
    thread.spawnDetached task: (Peek xs: xs)
}
