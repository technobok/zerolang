# E0100: an if-condition must be a bool or a 2-arm sum type. A THREE-arm
# variant has no single falsy arm to test against, so it is a type error rather
# than a struct in the C condition.
triple: variant { lo: null  mid: u64  hi: null }

main: function is {
    t: triple.mid 7
    if t then print "x"
}
