# A construction returned straight from `return` keeps every pin its fields
# took, as a named local holding it would. A view of a local String dies with
# the call, from an `out` function and an `outx` one alike, so returning it
# inside a new instance is refused.
Box: class {
    name: StringView
}

fromOut: function out Box is {
    h: String
    h.append s: "heap"
    return (Box name: h.stringView)
}

fromOutx: function {s: String.view} outx Box is {
    h: String
    h.append s: "heap"
    return (Box name: h.stringView)
}

main: function is {
    print fromOut.name
    k: String
    k.append s: "kept"
    print (fromOutx s: k).name
}
