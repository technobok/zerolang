# E0200: a non-owned field is set at construction and cannot be reassigned.
#
# The second diagnostic arrived with the `.lock` retirement and is not noise:
# the RHS used to be spelled `x.lock`, a borrow of the argument, and a bare
# name is a MOVE. There is no bare equivalent of the old suffix -- `x.borrow`
# has never emitted -- so the move is real and worth reporting. The field rule
# still fires first, which is what this fixture is for.
thing: class { v: String }
holder: class {
    item: thing.borrow
} as {
    create: function {item: thing.borrow} out this is {
        return (meta.create item: item)
    }
}
g: function {h: holder x: thing} is {
    h.item = x
}
main: function is {
    t: thing v: "z".string
    hl: holder item: t
}
