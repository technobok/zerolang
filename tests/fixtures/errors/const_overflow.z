# E0600: an untyped integer constant is exact up to 512 bits of magnitude, and
# an operation past that has no value. Wider intermediates fold: (2^128 - 1)^4
# is under 2^512, and only its product with one more factor overflows.
B: 340282366920938463463374607431768211455
B2: B * B
B4: B2 * B2
BAD: B4 * B
main: function is {
    print "\{BAD}"
}
