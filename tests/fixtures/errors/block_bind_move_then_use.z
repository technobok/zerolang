# `b: m.take` MOVES `m`; done inside a block, the move must survive the block's
# close so the read after it is refused. (Written bare the line borrows, and
# both names stay readable -- binding_borrows_by_default.)
main: function is {
    m: "abc".string
    {
        b: m.take
        print "\{b.length}"
    }
    print "\{m.length}"
}
