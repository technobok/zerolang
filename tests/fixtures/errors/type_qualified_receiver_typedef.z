# E0300: a receiver is never converted. A Tile is a typedef of Sq and may
# declare members of its own, so a call through Sq does not take a Tile as its
# receiver: `t.area` calls the member a Tile has.
Sq: record {
    side: i64
} as {
    area: function {s: this.view} out i64 is {
        return s.side * s.side
    }
}

# Tile -- a typedef of Sq
Tile: typedef Sq

main: function is {
    t: Tile (Sq side: 3)
    print "\{Sq.area t}"
}
