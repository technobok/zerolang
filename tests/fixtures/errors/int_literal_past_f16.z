# an integer past f16's largest finite value, 65504, has no f16: the nearest
# one is an infinity. The integer leg checked the mantissa alone, so each of
# these printed `inf`; 65504 itself fits.
takes: function {h: f16} out f16 is { return h }
main: function is {
    a: 65536.f16
    b: f16
    b = 131072
    c: takes h: 70000
    d: 65504.f16
    print "\{a} \{b} \{c} \{d}"
}
