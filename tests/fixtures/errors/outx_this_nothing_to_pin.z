# A constructor has no receiver -- it makes the instance -- so `outx this` on
# one with only scalar parameters pins nothing and is refused: write `out this`.
W: class {
    tag: i64
} as {
    create: function {t: i64} outx this is {
        return (meta.create tag: t)
    }
}

main: function is {
    w: W.create t: 3
    print "\{w.tag}"
}
