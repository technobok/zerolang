# In a type, only a numeric generic parameter itself completes per instance: a
# reference computed from one is refused, where it minted `array_i64_0`. The
# same expression in a body is allowed.
Buffer: class {
    used: u32
    count: function {:this a: (array t: i64 to: cap + 1)} out u64 is {
        return a.length
    }
} as { cap: u32.generic }

main: function is {
    b: (Buffer cap: 4) used: 0
    a: array t: i64 to: 5
    print "\{b.count :a}"
}
