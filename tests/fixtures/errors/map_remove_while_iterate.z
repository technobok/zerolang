# E0200: structural mutation during iteration invalidates the iterator. The
# pin is readonly, so reads pass (map_get_while_iterate) and only this fails.
main: function is {
    m: (Map String value: String)
    m.set key: "a".string value: "x".string
    with it: m.iterateItems do for e: it loop {
        m.remove key: "a".string
    }
}
