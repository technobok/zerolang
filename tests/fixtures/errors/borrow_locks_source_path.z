# E0200: a whole-object '.borrow' locks the source path '(o,)' -- the marker is
# not a path segment -- so the object cannot also be passed while the view lives.
Inner: class { n: i64 }
Outer: class { a: Inner }
sink: function {x: Outer} is {
    print "\{x.a.n}"
}
main: function is {
    o: (Outer a: (Inner n: 1))
    with v: o.borrow do {
        sink x: o
    }
}
