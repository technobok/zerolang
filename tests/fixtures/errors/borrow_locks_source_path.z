# E0200: a whole-object '.borrow' locks the source path '(o,)' -- the marker is
# not a path segment -- so the object cannot be written through its own name
# while the alias lives.
Inner: class { n: i64 }
Outer: class { a: Inner }
main: function is {
    o: (Outer a: (Inner n: 1))
    with v: o.borrow do {
        o.a = Inner n: 2
    }
}
