# A Row cannot outlive the Statement it reads: moved out of its Step arm into
# a list that outlives the Statement, it is refused.
main: function is {
    db: sqlite.openMemory
    if db.err then return
    rows: List sqlite.Row
    {
        q: db.prepare sql: "select 1"
        if q.err then return
        s: q.step
        match (s) case row then rows.append s.take else null
    }
    print "\{rows.length}"
}
