# A `.generic` bound written as a type application names the instance it
# builds, and admits what conforms to that instance. It resolved to no type
# at all -- the bound's text was read as a constraint name, and `(...)` names
# none -- so it constrained nothing: a class with no conformance and the
# wrong return type passed, and so did a non-generic head and an argument
# that names nothing.
Getter: protocol {
    v: anyval.generic
    get: function {t: this.view} out v
}

Byte: class { b: u8 } as {
    get: function {t: this.view} out u8 is { return t.b }
}

pt: record { x: i64 }

wants: function {t: T} out i64 is { return 0 } as {
    T: (Getter v: i64).generic
}

overRecord: function {t: T} out i64 is { return 0 } as {
    T: (pt v: i64).generic
}

overNothing: function {t: T} out i64 is { return 0 } as {
    T: (Getter v: nosuch).generic
}

main: function is {
    print "\{wants t: (Byte b: 7)}"
    print "\{overRecord t: (pt x: 1)}"
    print "\{overNothing t: 3}"
}
