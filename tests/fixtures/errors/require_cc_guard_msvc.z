# require_cc_guard_msvc.z -- as require_cc_guard.z, for MSVC: cl has no
# __float128, so asking for it reports quadfloat, the feature and the compiler
# by name. `nocc=` names both families on the row. No C compiler is invoked on
# this path, so cl need not be installed for this to pass.
main: function is {
    x: 1.5.f128
    print "\{x}"
}
