# E0200: a function that takes no argument is called by its bare name, and its
# `out T.hold` freezes the binding as a call written with arguments does. The
# bare call typed only as its result, so the write compiled and changed a
# value the signature promised was frozen.
Box9: class {
    n: i64
} as {
    bump: function {:this} is {
        this.n = this.n + 1
    }
}
mk: function out Box9.hold is {
    return (Box9 n: 5)
}
main: function is {
    h: mk
    h.bump
    print "\{h.n}"
}
