# Inside the type the grant is still spelled: a method hands a friend
# `this.private`, never a plain `this` binding.
Bag: class { a: i64 count: i64 } as {
    public: unit { :count :peek }
    peek: function {b: this.borrow} out i64 is { return (friendRead h: b) }
}

friendRead: function {h: Bag.private.borrow} out i64 is { return h.a }

main: function is {
    b: (Bag a: 42 count: 3)
    print "\{b.peek}"
}
