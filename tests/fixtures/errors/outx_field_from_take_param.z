# A `.take` parameter is moved into the call and dies with it -- it is owned
# here, not by the caller -- so an `outx` result may not store a reference to
# it in a non-owned field.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow own: Src.take} outx W is {
    return (W s: own tag: from.n)
}

main: function is {
    a: Src n: 1
    b: Src n: 2
    w: mk from: a own: b
    print "\{w.tag}"
}
