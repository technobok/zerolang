# E0100: a member written with a data value -- a record field, a class field, a
# parameter -- is typed by it, but a default is a number, a string, an arm or a
# function, so the default is refused rather than dropped.
inner: data { v: u8 }
x: (inner v: 2)
holder: record { r: x n: 1 }
Box: class { r: x }
f: function {r: x} is { print "y" }

main: function is {
    f r: x
    b: Box r: x
    h: holder r: x n: 3
    print "\{h.n}"
}
