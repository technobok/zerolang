# `null` IS NOT A RUNTIME VALUE. It spells an arm that carries nothing
# (`none: null`) and it undefines a member (`create: null`); those are its only
# jobs. A parameter typed by it would be a slot holding something that does not
# exist -- and it was accepted, emitting an undeclared `null` into the call so
# that zc exited 0 and only the C compiler objected.
takes: function {x: null} out i64 is {
    return 1
}

main: function is {
    print "\{takes x: null}"
}
