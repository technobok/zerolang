# E0200: a `view` field is frozen for the same reason a `hold` one is -- the
# axis is readonly-ness, not ownership. Its slot is additionally static, which
# reassign_view_field covers.
Box: class {
    name: String.view
}
main: function is {
    b: Box name: "n".string
    b.name.append "x"
    print "\{b.name}"
}
