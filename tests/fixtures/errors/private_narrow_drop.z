# private_narrow_drop.z -- `.private.drop` is refused (E0022). It used to be accepted
# silently, as a borrow.
Bag: class { a: i64 } as {
    public: unit { :lend }
    lend: function {:this} out i64 is { return (friend h: this.private) }
}

friend: function {h: Bag.private.drop} out i64 is { return h.a }

main: function is {
    b: (Bag a: 5)
    print "\{b.lend}"
}
