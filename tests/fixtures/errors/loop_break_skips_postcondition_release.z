# loop_break_skips_postcondition_release -- a loop with no precondition is still a path:
# a `break` in its body skips the postcondition, so a lock a postcondition releases is
# released on some paths only and the code after the loop still finds the source locked
LfBox: class {
    name: StringView
}

postcondReassignWriteAfter: function {k: bool} is {
    s: "abc".string
    o: "ooo".string
    w: LfBox name: s.stringView
    n: 0
    for loop {
        n = n + 1
        if k then break
    } while (with t: n do {
        w = LfBox name: o.stringView
        t < 2
    })
    s = "zzzzzzzzzzzzzzzz".string
    print "\{w.name} \{s}"
}

main: function is {
    postcondReassignWriteAfter k: true
}
