# A NUMERIC GENERIC ARGUMENT LIES IN ITS PARAMETER'S TYPE, on every path that
# instantiates. The range was checked only on the value path, with a message
# naming the parameter and template by raw ids; a negative argument on an
# unsigned bound, a c8 bound, the inference spelling and a unit instantiation
# were accepted.
rec: record {
    x: i64
} as { n: u8.generic }

crec: record {
    x: i64
} as { n: c8.generic }

sized: unit as {
    cap: u8.generic
    get: function out i64 is {
        return 1
    }
}

big: (sized cap: 300)

main: function is {
    a: (rec n: 300) x: 1
    b: (rec n: -3) x: 1
    c: (crec n: 256) x: 1
    d: rec n: 256 x: 1
    print "\{a.x} \{b.x} \{c.x} \{d.x} \{big.get}"
}
