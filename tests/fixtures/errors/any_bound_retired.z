# E0023: there is no `Any` -- a generic names the family it takes
# (AnyRef.generic / anyval.generic), and no type admits both. The bare name
# resolves like any other identifier, so without a user-defined `Any` both
# spellings are the standard unknown-name error.
pick: function as { T: Any.generic } in { val: T } out T is {
    return val
}
main: function is {
    g: pick 42
    print "\{g}"
    x: Any
    print "ok"
}
