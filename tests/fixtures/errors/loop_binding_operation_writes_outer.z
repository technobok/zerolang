# A loop's own operation runs before its binding exists: a write there to `x`
# is a write to the outer `x`, and ends its narrowing.
main: function is {
    x: optionval.some 5
    if x.none then return
    k: 0
    for y: ({
        x = optionval.none i64
        optionval.none i64
    }) loop {
        k = k + 1
    }
    print "\{x + 1} \{k}"
}
