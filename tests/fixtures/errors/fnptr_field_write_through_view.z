# Calling a function field through a view reads the slot; REPLACING it is a
# write, and a view is readonly.
Slot: class {
    g: function out i64
}

seven: function out i64 is { return 7 }
eight: function out i64 is { return 8 }

replace: function {s: Slot.view} is {
    s.g = eight.take
}

main: function is {
    b: Slot g: seven.take
    replace s: b
    print "b \{b.g}"
}
