# E0200: a `view` parameter is readonly for the whole body -- it holds a readonly
# lock on itself, so a write to it or to anything under it is rejected.
Item: class { value: i64 }
poke: function {c: Item.view} is {
    c.value = 9
}
main: function is {
    e: Item value: 5
    poke c: e
    print "\{e.value}"
}
