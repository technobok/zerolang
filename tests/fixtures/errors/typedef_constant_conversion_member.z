# A unit constant is a compile-time value. A typedef's own conversion member
# with a body runs only at run time, so a constant read through it has no
# value; a member the typedef hides is refused as a body refuses it.

# meters -- a length in whole meters
meters: typedef u8 as {
    # u32 -- the length as a wider count
    u32: function {m: this.view} out system.u32 is {
        return 42
    }
}

# sealed -- a byte that cannot widen
sealed: typedef u8 as {
    u32: null
}

M: meters 5
S: sealed 3
X: M.u32
H: S.u32

main: function is {
    print "\{X} \{H}"
}
