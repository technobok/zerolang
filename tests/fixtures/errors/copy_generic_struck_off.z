# `copy: null` in the `as` block strikes the compiler-provided copy off a
# valtype, and tests/fixtures/errors/copy_struck_off.z pins that the concrete
# spelling is then refused. Reaching the same type through a template must
# refuse identically: the author said this type has no copy, and a generic is
# not a way around an author's decision.
#
# It was not refused. The instance walk returned "handled" for anything that
# was not a class or a union, so a struck-off valtype never reached the leg
# that reads the opt-out.
pt: record {
    x: i64
    y: i64
} as {
    copy: null
}

dupper: unit as {
    t: anyval.generic
    dup: function {x: t} out t is {
        return x.copy
    }
}

dp: (dupper t: pt)

main: function is {
    a: pt x: 1 y: 2
    b: dp.dup x: a
    print "\{b.x}"
}
