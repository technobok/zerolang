# generic_method_instance_member -- a generic method's body is checked per
# instance: the instance for an i64 reads a member i64 does not have, and the
# refusal names the instance and the call that made it
public: unit {
    :main
}

# Acc -- a counter
Acc: class {
    n: u64
} as {
    # add -- count any value's length
    add: function as { t: anyval.generic } in {:this v: t} is {
        this.n = this.n + v.length
    }
}

main: function is {
    a: Acc n: 0
    a.add v: 5
}
