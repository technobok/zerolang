# A sum of literals with no compile-time value is an i64 sum
# (literal_runtime_value_lands), so a u8 context refuses it as it refuses a
# bound i64. It was taken unchecked: `w + (1 + (if c then 400 else 5))` with
# `w: 1.u8` printed 146, the low byte of 1 + 401.
main: function is {
    c: true
    w: 1.u8
    r: w + (1 + (if c then 400 else 5))
    print "\{r}"
}
