# match_first_arm_statement_no_value -- a match whose first completing arm ends on a
# statement with no value yields no value, whatever a later arm yields.
kind: variant {
    a: null
    b: null
}

tw: function {n: i64} out i64 is {
    return n * 2
}

k: function {v: kind} out i64 is {
    y: 0
    x: match v case a then {
        y = 3
    } case b then 5
    return x
}

main: function is {
    print "\{k v: kind.a} \{k v: kind.b}"
}
