# lock_move_into_reference.z -- a value holding locks cannot move into a
# REFERENCE: a `with` alias, a `getMut` result, or a field reached through
# either. The value lands in storage the reference's owner holds, which may
# outlive the source, while the reference -- and any lock moved onto it -- ends
# with its own scope.

W: class {
    # the borrowed source
    s: String.borrow
}

Holder: class {
    # the stored value
    w: W
}

main: function is {
    lists: (List W)
    outer: (List (List W))
    outer.append from: (List W)
    other: "other".string
    h: Holder w: (W s: other)
    {
        src1: "a string long enough to live on the heap".string
        src2: "a string long enough to live on the heap".string
        src3: "a string long enough to live on the heap".string
        with inner: lists do {
            w1: W s: src1
            inner.append from: w1
        }
        got: outer.getMut i: 0
        w2: W s: src2
        got.append from: w2
        with a: h do {
            w3: W s: src3
            a.w = w3.take
        }
    }
    print "\{lists.length}"
}
