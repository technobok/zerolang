# sync_guard_locks.z -- a guard keeps its lock's owner: the Mutex cannot move
# while a guard of it lives. A read guard's value is a view, so nothing that
# writes may take it.

main: function is {
    m: (sync.Mutex (ListVal i64)).create value: (ListVal i64)
    g: m.lock
    moved: m.take
    g.value.append 1
    rw: (sync.RwLock (ListVal i64)).create value: (ListVal i64)
    r: rw.read
    r.value.append 2
}
