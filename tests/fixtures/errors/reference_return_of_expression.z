# A REFERENCE RETURN OF AN EXPRESSION WITH NO ROOT. The returned value is a
# fresh String, not a path into a `.borrow`/`.view` parameter; nothing the
# caller owns is referenced, so L1 refuses -- and says so without inventing
# a variable name for it.
f: function {s: String.view} outx String.borrow is {
    return "x".string
}

main: function is {
    a: "a".string
    b: f s: a
    print "\{b.length}"
}
