# A field whose type is generic and may be a reftype in some instance is not
# returned bare: the owner still frees what the read would hand out. A bound
# that admits a string does; so does a class field whose type specializes a
# reference container over the parameter. bare_field_return.z covers AnyRef.
Named: class {
    val: T
} as {
    T: StringLike.generic
    peek: function {b: this} out T is {
        return b.val
    }
}

Bag: class {
    items: ListVal t
} as {
    t: anyval.generic
    all: function {b: this} out ListVal t is {
        return b.items
    }
}

main: function is {
    n: Named T: String val: "a".string
    print "\{n.peek}"
    b: Bag t: i64 items: (ListVal t: i64)
    print "\{b.all.length}"
}
