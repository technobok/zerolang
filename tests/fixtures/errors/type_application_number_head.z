# A type application starts with a type's name. A number written there
# (`n: 5 5`) names nothing a later definition could give a type to; it used to
# be taken for a type not yet defined, and the C named a type that never was.

# pt -- a field with a number where its type goes
pt: record {
    n: 5 5
}

main: function is {
    x: pt n: 1
    print "a"
}
