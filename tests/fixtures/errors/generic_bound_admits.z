# a bound that NAMES a declaration admits what that declaration says: a
# protocol or a facet admits its conformers, a union a member's own type (or a
# conformer of a protocol member), and a variant exactly its arms' payload
# types. Every argument here satisfied every bound before: a bound the kind
# table does not classify was read as "other", which constrained nothing.
Shape: protocol {
    area: function {t: this.view} out i64
}
fl: facet {
    side: function {t: this.view} out i64
}
Val: union {
    text: String
    none: null
}
kind: variant {
    n: i64
    none: null
}
proto: function as { T: Shape.generic } in { val: T.view } out i64 is {
    return 1
}
facet9: function as { t: fl.generic } in { val: t.view } out i64 is {
    return 2
}
union9: function as { T: Val.generic } in { val: T.view } out i64 is {
    return 3
}
variant9: function as { t: kind.generic } in { val: t.view } out i64 is {
    return 4
}
main: function is {
    s: "x".string
    print "\{proto val: 7} \{facet9 val: 7} \{union9 val: 7} \{variant9 val: s}"
}
