# a typedef is built from one value of its base, unnamed or named `from`.
# `meters val: 5` named an argument the construction does not have; it was
# ignored by the checker and emitted as the value anyway.
meters: typedef i64
main: function is {
    m: meters val: 5
    k: meters.create from: 5 by: 6
    print "\{m} \{k}"
}
