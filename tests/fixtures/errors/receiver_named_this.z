# A RECEIVER IS NAMED FOR WHAT IT IS, NEVER `this`: written `this: this.view`,
# the parameter's name is in scope in its own type, where `this` would name the
# parameter being declared. Only the `:this` shorthand receiver is named `this`.
Counter: class { n: i64 } as {
    peek: function {this: this.view} out i64 is { return this.n }
    bump: function {this: this} is { this.n = this.n + 1 }
    ok: function {:this} out i64 is { return this.n }
}

main: function is {
    print "checked under --eager"
}
