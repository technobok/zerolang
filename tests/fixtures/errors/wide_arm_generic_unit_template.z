# A union written in a generic unit, its arm over the unit's parameter: an
# instance of the unit whose argument is wider than the slot is refused, and
# the cure named is the template's -- its arm written `(Box t)` -- not one
# that would fix the template to this instance's argument.
pair: record { a: i64  b: i64 }

wrap: unit as {
    t: anyval.generic
    Tree: union {
        leaf: t
        node: String
    }
}

wi: (wrap t: pair)
wj: (wrap t: i64)

main: function is {
    a: wj.Tree.leaf 5
    b: wi.Tree.leaf (pair a: 1 b: 2)
    if a.leaf then print "\{a}"
    if b.leaf then print "\{b.a}"
}
