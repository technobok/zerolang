# A block indexed by its own id type is not a block indexed by u64: the index
# is part of its value type, `(intdata u8 i: nid)`.
nid: typedef u64
codes: data { 9 10 } out (intdata u8 i: nid)

total: function {c: intdata u8} out u64 is {
    return c.length
}

main: function is {
    print "\{total c: codes}"
}
