# E0200: a method call on a nested receiver locks the receiver's full path, so
# it conflicts with a lock on an ancestor just as a bare receiver does.
Item: class { label: String }
main: function is {
    e: Item label: "echo".string
    with v: e.borrow do {
        e.label.append "xyz"
    }
    print "\{e.label}"
}
