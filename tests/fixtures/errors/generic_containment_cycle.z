# Instances of generic value types that hold one another by value have no
# size: `(node t: i64)` holds a `(link t: i64)` in its `pair` arm, which holds a
# `(node t: i64)` in its field. The cycle is refused once, at the first
# instance's template, as a definition's own cycle is where it resolves.
#
# It was not refused: the instances were minted after resolution, and the C
# named a struct before it was defined.
node: variant {
    leaf: t
    pair: (link t: t)
} as {
    t: anyval.generic
}

link: record {
    l: (node t: t)
} as {
    t: anyval.generic
}

main: function is {
    x: (node t: i64).leaf 3
    print "made"
}
