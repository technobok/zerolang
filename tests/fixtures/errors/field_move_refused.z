# A FIELD IS NEVER MOVED. A field is borrowed from its owner whatever owns the
# owner, and a reftype field changes only by `swap`, so a field that owns what it
# holds is refused in every position that moves a value, in the words a borrowed
# name gets there: `.take` on it wherever it is written, and the bare field
# handed to a slot that takes it -- a taking parameter, a generic one, a
# constructor's field, a collection's element, from a method's own receiver and
# through a readonly root. The value comes out by swapping an empty one in
# (swap_legal_shapes); a field that owns nothing hands on a copy
# (field_value_take).
Holder: class {
    p: String
} as {
    give: function {:this} out u64 is {
        return (keep s: this.p)
    }
}

Box2: class {
    s: String
}

keep: function {s: String.take} out u64 is {
    return s.length
}

keepT: function as { T: StringLike.generic } in {b: T.take} is {
    print b
}

mk: function {} out Holder is {
    return (Holder p: "abc".string)
}

takeIntoBinding: function is {
    h: mk
    x: h.p.take
    print x
}

takeIntoArgument: function is {
    h: mk
    print "\{keep s: h.p.take}"
}

takeReturned: function {h: Holder} out String is {
    return h.p.take
}

takeReassigned: function is {
    h: mk
    r: "r".string
    r = h.p.take
    print r
}

takeInArm: function {c: bool} is {
    h: mk
    r: if c then h.p.take else "made".string
    print r
}

bareArgument: function is {
    h: mk
    print "\{keep s: h.p}"
}

bareGenericArgument: function is {
    h: mk
    keepT b: h.p
}

bareConstructorField: function is {
    h: mk
    b: Box2 s: h.p
    print b.s
}

bareElement: function is {
    h: mk
    xs: List String
    xs.append from: h.p
    print "\{xs.length}"
}

throughHold: function is {
    g: mk
    h: g.hold
    print "\{keep s: h.p}"
}

main: function is {
    takeIntoBinding
    takeIntoArgument
    h: mk
    print (takeReturned :h)
    takeReassigned
    takeInArm c: true
    bareArgument
    bareGenericArgument
    bareConstructorField
    bareElement
    print "\{h.give}"
    throughHold
}
