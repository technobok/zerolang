# E0200: `hold` owns its argument, so the caller has moved the value away and
# cannot read it afterwards -- the readonly half does not make the transfer any
# less of a transfer.
keep: function {s: String.hold} out u64 is {
    return s.length
}
main: function is {
    x: "abc".string
    n: keep s: x.take
    print "n=\{n} x=\{x}"
}
