# NAMING AN ARM GIVES ITS TAG, and a tag is the whole value only when the arm
# carries nothing. `Payload.text` names an arm holding a String that no one
# built: the definition resolves to the sum, is emitted as a bare tag, and
# reading it SEGFAULTS. `Mixed.count` is the quieter half of the same hole -- a
# tag over a zero payload.
#
# The fold cannot catch this one. A payload arm has no constant to fold to --
# `cval`'s `armKind` carries the arm's owning type and its name, and has no slot
# for a payload -- so the fold answers none and the definition falls through to
# the alias chase, which resolves it to the arm's own sum.
#
# The permitted cases sit beside the refused ones because the rule is PER-ARM:
# `Mixed.none` is a value on the same variant whose `count` is not, and `NO` is
# only the ordinary case of that -- bool's arms carry nothing.
Mixed: variant {
    count: i64
    none: null
}

Payload: union {
    text: String
    empty: null
}

# each of these names an arm that carries nothing, and each is a value
OK1: Mixed.none
OK2: Payload.empty
NO: bool.false

# each of these names an arm that carries something
BAD1: Mixed.count
BAD2: Payload.text

main: function is {
    a: OK1
    match (a) case count then print "count" case none then print "none"
    if NO then print "t" else print "f"
    b: BAD1
    match (b) case count then print "count" case none then print "none"
    c: BAD2
    match (c) case text then print "text=[\{c}]" case empty then print "empty"
}
