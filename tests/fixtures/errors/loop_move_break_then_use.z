# A move followed by `break` leaves the loop with the name consumed: the
# code after the loop must not read it. The break used to erase the move
# along with the arm's other takes, as if the path never reached here.
eats: function {s: String.take} out bool is {
    return s.length > 0
}
main: function is {
    x: "abc".string
    for while true loop {
        ok: eats s: x
        if ok then print "moved"
        break
    }
    print "\{x.length}"
}
