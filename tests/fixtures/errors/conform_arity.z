# conform_arity.z -- a conformer whose method takes a different number of parameters than the
# spec's. The vtable slot is typed by the spec, so the wrapper passed an
# argument the implementation does not take.
Shape: protocol {
    area: function {t: this.view scale: u64} out u64
}

Sq: class { side: u64 } as {
    :Shape
    area: function {t: this.view} out u64 is { return t.side * t.side }
}

main: function is {
    s: Sq side: 2
    print "\{s.side}"
}
