# A TYPE THAT DECLARES `create: null` CANNOT BE CONSTRUCTED IN ANY SPELLING.
# Every spelling of a construction is a call of the type's `create`, so each
# one finds the same answer: there is none. Only the bare name and `T.create`
# were refused; the sugar with arguments -- `Secret value: 4`, `(Secret) 4`,
# `(Secret value: 4)` -- built one anyway.
Secret: class { value: i64 } as {
    create: null
    build: function {seed: i64} out this is {
        return (meta.create value: seed * 7)
    }
}

main: function is {
    a: Secret
    b: Secret value: 4
    c: (Secret) value: 4
    d: (Secret value: 4)
    e: Secret.create value: 4
    f: Secret 4
    ok: Secret.build seed: 6
    print "\{ok.value}"
}
