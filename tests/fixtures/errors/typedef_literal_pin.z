# NO IMPLICIT LITERAL -> TYPEDEF PINNING, anywhere. A typedef is a new type and
# its safety is that construction is explicit, so a literal may not acquire one
# by wearing it as a suffix. The literal types declare conversions to the
# sixteen scalars and to nothing else, and that surface is exhaustive.
#
# The `out T` clause of a data block is the one place a literal takes a typedef,
# because there the programmer asked for it in writing.
nid: record { val: u32.typedef } as {
    ==: function {:this rhs: nid} out bool is {
        return this.u32 == rhs.u32
    }
}

Holder: record {
    slot: nid
}

takes: function {n: nid} out u32 is {
    return n.u32
}

# 1. at unit level
wkFirst: 1.nid

main: function is {
    # 2. bound to a local
    a: 2.nid
    # 3. as a call argument
    print "t=\{takes n: 3.nid}"
    # 4. in a comparison
    if a == 4.nid then print "eq"
    # 5. as a field initialiser
    h: Holder slot: 5.nid
    print "h=\{h.slot.u32}"
    # 6. reading the unit constant -- a constant nothing references is never
    # resolved, so the read is what puts it in front of the checker. The read
    # reports a second time, on the value the refused pin left behind: a
    # suffixed literal IS a constant declaration, invalid suffix and all, so it
    # folds to its integer and `.u32` off that is an ordinary lossy conversion.
    print "w=\{wkFirst.u32}"
}
