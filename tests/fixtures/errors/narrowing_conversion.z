# A NON-LITERAL NARROWS BY THE SAME RULE, and the rule is already declared:
# lib/system/system.z gives a LOSSLESS conversion a plain return (`i64.i128` is
# `out i128`) and a lossy one a `(resultval t: X e: converror)` the caller must
# handle -- 81 plain against 159 result-bearing. A literal is settled against
# its own value; a variable carries none, so the declarations answer instead.
#
# Both destinations skipped for the same reason, reading any numeric as standing
# in for any other: every line below compiled and RAN, printing 2, 44, 44, 44.
i64Takes: function {n: i64} is { print "n=\{n}" }
u8Takes: function {n: u8} is { print "n=\{n}" }

Holder: class {
    n: u8
}

main: function is {
    f: 2.5
    big: 300.u64
    i64Takes n: f
    u8Takes n: big
    h: Holder n: 1
    h.n = big
    small: 1.u8
    small = big
    print "\{h.n} \{small}"
}
