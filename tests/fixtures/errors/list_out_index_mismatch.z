# A block indexed by its own id type is not a block indexed by u64: the index
# is part of its value type, `(staticlist u8 i: nid)`.
nid: typedef u64
codes: list { 9 10 } out (staticlist u8 i: nid)

total: function {c: staticlist u8} out u64 is {
    return c.length
}

main: function is {
    print "\{total c: codes}"
}
