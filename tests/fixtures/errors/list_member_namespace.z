# A FIELD IS EACH INSTANCE'S DATA AND A CONSTANT OF THE `as` SECTION IS THE
# TYPE'S. Read across -- a field through the type, a constant through an
# instance -- the C named storage that does not exist: `Tank.level` a variable
# called `Tank`, and `t.CAPACITY` a struct field the instance never stores.
Tank: class {
    level: i64
} as {
    CAPACITY: 100
}

main: function is {
    t: Tank level: 3
    a: Tank.level
    b: t.CAPACITY
    print "\{a} \{b} \{t.level} \{Tank.CAPACITY}"
}
