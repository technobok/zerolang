# An iterator's `call` is a METHOD whose only required parameter is `:this`: a
# class that stores a function in a field named `call` is no iterator. It was
# accepted, and the emitter called the field's function type.
Holder: class {
    call: function out (optionval t: i64)
}

none: function out (optionval t: i64) is {
    return (optionval.none i64)
}

main: function is {
    h: (Holder call: none.copy)
    for each x: h loop {
        print "\{x}"
    }
}
