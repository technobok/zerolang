# A typedef declares no `create`: it is built from its base. One written anyway
# is refused, and a `create` that constructs its own type from inside itself is
# refused as well, as any type's is.
meters: typedef i64 as {
    create: function {m: i64} out meters is {
        return (meters.create from: m)
    }
}

main: function is {
    m: meters 5
    print "\{m}"
}
