# E0100: `return <value>` in a function that declares no `out` type, `main`
# included. A bare `return` is how such a function ends early; a value has no
# caller to receive it, and the C function it emits returns void.

noted: function {a: u64} is {
    if (a > 1) then return
    return a
}

main: function is {
    noted a: 2
    return 0
}
