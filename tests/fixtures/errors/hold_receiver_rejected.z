# E0200: a receiver is `borrow` (the default) or `view` -- never `take` or
# `hold`, because an object cannot own itself. Family-independent: this is a
# class, and a record is refused for the same reason.
Box: class {
    x: i64
} as {
    keep: function {t: this.hold} out i64 is {
        return t.x
    }
}
main: function is {
    b: Box x: 1
    print "\{b.keep}"
}
