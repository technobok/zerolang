# A SPEC HAS NO VALUE. A function declared with no body names a type -- of a
# parameter, a field or a return -- and a function with a body and its
# signature is what is passed there. Called, read bare, copied or taken, a spec
# reached the C as a function nothing defined: "'z_t103' undeclared" and
# "implicit declaration of function 'z_t105'" (reproduced at 00eebdad).
opFn: function {n: i64} out i64

main: function is {
    a: opFn n: 1
    b: opFn.copy
    c: opFn.take
    d: opFn
    print "unreachable"
}
