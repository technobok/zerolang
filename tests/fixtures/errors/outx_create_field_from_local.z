# The same rule through `meta.create` inside a `create`: a non-owned field is
# filled from a `.borrow`/`.view` parameter, never from a local of the create.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
} as {
    create: function {from: Src.borrow} outx this is {
        loc: Src n: 2
        return (meta.create s: loc tag: 1)
    }
}

main: function is {
    a: Src n: 1
    w: W.create from: a
    print "\{w.tag}"
}
