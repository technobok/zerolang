# A unit constant read through a unit (`vocab.codes.b`) is classified as the
# same read written in that unit: an element of a typedef-typed block is a
# value of its own type, not a literal, so it is no unit constant. It was not
# classified at all, and the emitter refused it (E0500).
vocab: unit {
    nid: typedef u64
    codes: data { a: 7 b: 8 } out intdata nid
}

K: vocab.codes.b

main: function is {
    k: K
    print "\{k.u64}"
}
