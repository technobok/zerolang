# A generator suspends at a yield and resumes in a later call, and a borrow does
# not live in the instance across the suspension: a yield is refused while a
# borrow the body bound -- here a `with` value -- is in scope. The yield after
# the block is not.
Gen: generator { xs: List String } as {
    call: function out u64 is {
        with b: this.xs.borrow do {
            yield b.length
        }
        yield 0
    }
}

main: function is {
    xs: List String
    xs.append "a".string
    for v: (Gen :xs) loop print "gen \{v}"
}
