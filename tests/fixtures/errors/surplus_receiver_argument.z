# AN UNLABELLED ARGUMENT BINDS THE FIRST PARAMETER AFTER THE RECEIVER, and a
# method whose only parameter is its receiver has none. The argument was dropped
# without a word -- `(p.first 3)` printed `p.x` -- and on a native method it
# reached the emitter as a callee it could not spell. Passing the receiver again
# is the same mistake: `c.describe c`.
pt: record { x: i64 } as {
    first: function {:this} out i64 is {
        return this.x
    }
}

twin: record { x: i64 } as {
    first: function {t: this.view} out i64 is {
        return t.x
    }
}

Container: class { val: t } as {
    t: anyval.generic
    describe: function {c: this} out StringView is {
        return "container"
    }
}

main: function is {
    p: pt x: 1
    tw: twin x: 2
    c: Container val: 42
    xs: ListVal i64
    m: (MapVV k: i64 v: i64)
    arr: (array t: i64 to: 4)
    raw: (str to: 8)
    s: "ab".string
    sv: s.stringView
    a: (p.first 3)
    b: (tw.first 3)
    d: c.describe c
    e: (xs.length 3)
    f: (xs.capacity 1)
    g: (m.length 2)
    h: (arr.length 1)
    i: (raw.size 1)
    j: (s.length 3)
    k: (sv.length 3)
    l: (s.copy 3)
    print "\{a} \{b} \{d} \{e} \{f} \{g} \{h} \{i} \{j} \{k} \{l}"
}
