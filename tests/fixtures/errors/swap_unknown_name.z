# A SWAP SIDE THAT NAMES NOTHING IS AN UNKNOWN REFERENCE, on either side. The
# swap walked both sides and checked only their write locks, so an unknown name
# on the right was written into the C as it was spelt, and one on the left
# reached the emitter with no type and panicked it.
main: function is {
    a: 1
    a swap ghost
    phantom swap a
    print "\{a}"
}
