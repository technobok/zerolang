# E0300: a union or variant is built through an arm. Its name given arguments
# constructs nothing, as its bare name does not: named directly, through its type
# arguments, or as a template whose arguments would be inferred -- one refusal
# each, the arguments still checked as values.
kd: variant { k: i64  z: null }

Sh: union { c: String  e: null }

GT: union { leaf: t  node: String } as { t: anyval.generic }

gv: variant { k: t  z: null } as { t: anyval.generic }

OC: class { n: i64 }

probe: function is {
    a: kd 5
    b: kd k: 5 z: null
    c: Sh "a".string
    d: (GT t: i64) leaf: 5
    e: (gv t: i64) 5
    f: GT leaf: 5
    g: (Option T: OC) (OC n: 1)
    h: (Result T: OC E: String) (OC n: 1)
    i: (optionval t: i64) 5
    j: (resultval t: i64 e: i64) ok: 5
    k: kd (undefined 1)
}

main: function is {
    probe
}
