# E0400: an arm constructed without its type's arguments binds only the
# parameter its payload names; a second one is inferred from nothing. It used to
# mint an instance with that parameter unbound.
either: variant {
    left: a
    right: b
} as {
    a: anyval.generic
    b: anyval.generic
}

main: function is {
    r: resultval.ok 5
    s: resultval.err true
    e: either.left 5
    print "x"
}
