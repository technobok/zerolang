# A lock-holding value taken into a constructed field keeps its locks in the
# value being built, as a bare `w` does: writing the source while `h` lives
# is refused.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

H: class {
    w: W
}

main: function is {
    a: Src n: 1
    w: mk from: a
    h: H w: w.take
    a.n = 5
    print "\{h.w.tag}"
}
