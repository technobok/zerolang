# E0200: a binop is the call form of a one-argument method, so its LEFT
# operand is the receiver and locks by the operator's marker. An `==` declared
# `{:this}` -- a writer, and this one does write -- is refused on a `view`
# parameter exactly as the named call `p.eq rhs: q` would be.
point: record {
    x: i64
} as {
    ==: function {:this rhs: point} out bool is {
        this.x = this.x + 1
        return this.x == rhs.x
    }
}
same: function {p: point.view q: point.view} out bool is {
    return p == q
}
main: function is {
    a: point x: 1
    b: point x: 2
    print "\{same p: a q: b} \{a.x}"
}
