# infix_const_cycle.z -- a unit-level constant defined in terms of itself. The
# cycle is only reported if the definition is recognised as COMPUTED, and the
# test for that asked whether the value was a binop node. Once `X + 1` parses
# as a call the test answered no, the constant folded to nothing, and the ring
# was never named.
SELF: SELF + 1

main: function is {
    print "\{SELF}"
}
