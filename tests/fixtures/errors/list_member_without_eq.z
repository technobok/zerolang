# A list's `contains`, `==` and `!=` compare elements with the element's own
# `==`, so an element type with none has none of the three: each read is the
# ordinary unknown-member error, where it is made. The list itself is legal.
# emitc_corpus/list_eq_contains is the other half. `contains` on a ListVal of
# such elements used to compare the elements' bytes.
opaque: record {
    val: i64
} as {
    ==: null
}

Cell: class {
    n: i64
}

main: function is {
    xs: ListVal opaque
    xs.append from: (opaque val: 1)
    print "\{xs.contains item: (opaque val: 1)}"
    ys: ListVal opaque
    print "\{xs == ys}"
    print "\{xs != ys}"
    cells: List Cell
    probe: Cell n: 1
    print "\{cells.contains item: probe}"
    print "\{xs.length}"
}
