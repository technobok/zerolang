# After a type, a dot introduces a marker (`.view`, `.borrow`) or a member of
# the type. A name that is neither is refused after an applied type as it is
# after a plain one; there it used to be ignored, and the parameter took the
# type with no marker at all.

# count -- a parameter whose type ends in a name that is no marker
count: function {xs: (ListVal i64).zork} out u64 is {
    return 1
}

main: function is {
    xs: ListVal i64
    print "\{count :xs}"
}
