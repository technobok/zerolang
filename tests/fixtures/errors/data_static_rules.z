# E0100: a data value is copied by binding it and never changes, so every
# marker on one is refused -- on a unit constant and on a local, `.copy`
# included -- and so is a write to its field. It has no zero value, so an array of it, or of a
# record holding one, is refused too; an array of `optionval` is not.
inner: data { v: u8 }
x: (inner v: 2)
holder: record { r: inner }
box: record { items: array inner to: 2 }

main: function is {
    a: x.take
    p: x
    c: p.copy
    d: p.hold
    e: p.borrow
    f: p.view
    p.v = 3
    h: holder r: x
    h.r.v = 4
    w: array inner to: 2
    k: array holder to: 2
    o: array (optionval inner) to: 2
    print "x"
}
