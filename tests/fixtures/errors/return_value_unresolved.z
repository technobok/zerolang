# return_value_unresolved.z -- a RETURNED value that resolves nowhere. It typed
# to 0, the return-type check below it was skipped, and the emitter wrote the
# bare name into the C.
#
# Reported only where this walk knows the enclosing function's return type:
# some bodies reach that leg degenerate (their own local bindings register no
# scope entry), and there the scope cannot answer whether a name is in scope.

produces: function out u64 is {
    return ghostReturned
}

main: function is {
    print "\{produces}"
}
