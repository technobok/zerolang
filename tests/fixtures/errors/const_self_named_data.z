# A constant whose value is built by its own name, where another unit declares
# a data type of that name. The head `foundation` names the constant being
# defined, not `sch.foundation`.
sch: unit {
    foundation: data { n: 0 }
}

su: unit {
    c: sch
    foundation: (foundation n: 3)
    inner: function out i64 is { return foundation.n }
}

main: function is {
    x: su.foundation
    print "\{x.n} \{su.inner}"
}
