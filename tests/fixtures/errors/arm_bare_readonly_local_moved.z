# An arm's local moves only when the local could: a readonly, borrowed or pinned
# one is refused, arm by arm, with the words its move gets -- `.take` into a
# binding, a bare local into a return.
viewParam: function {v: String.view c: bool} out String is {
    r: if c then v.take else "z".string
    return r
}

borrowedParam: function {v: String c: bool} out String is {
    r: if c then v.take else "z".string
    return r
}

returnedBorrow: function {v: String c: bool} out String is {
    return (if c then v else "z".string)
}

pinnedLocal: function {c: bool} out u64 is {
    o: "xy".string
    w: o.stringView
    r: if c then o.take else "z".string
    return r.length + w.length
}

main: function is {
    s: "abc".string
    print (viewParam v: s c: true)
    print (borrowedParam v: s c: true)
    print (returnedBorrow v: s c: true)
    print "\{pinnedLocal c: true}"
}
