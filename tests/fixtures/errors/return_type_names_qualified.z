# Two types of one name are told apart wherever a report sets them against each
# other: a returned value, as an argument already was, names each with the unit
# that declares it, not "expects u8, got u8".
u8: record {
    a: system.u64
}

small: function {v: system.u8} out system.u8 is {
    return v
}

big: function out system.u8 is {
    x: u8 a: 1
    return x
}

main: function is {
    x: u8 a: 1
    print "\{small v: x} \{big}"
}
