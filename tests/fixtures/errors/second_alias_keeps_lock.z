# E0200: an alias is a borrow, and a borrow excludes every other name for its
# source while it lives: a second alias of one list is refused beside the
# first, and so is writing or dropping the list under either. Were the second
# alias accepted, dropping the first would leave the list writable, and
# droppable, under the second -- `k.length` would then read the destroyed list.
written: function is {
    xs: List String
    xs.append from: "a".string
    m: xs
    k: xs
    m.drop
    xs.append from: "b".string
    print "\{k.length}"
}

dropped: function is {
    xs: List String
    xs.append from: "a".string
    m: xs
    k: xs
    m.drop
    xs.drop
    print "\{k.length}"
}

main: function is {
    written
    dropped
}
