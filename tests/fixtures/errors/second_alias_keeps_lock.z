# E0200: every name for a value holds its own lock on it. Two aliases of one
# list each lock it shared, and dropping the first leaves the second's in place:
# the list can be neither written nor dropped while `k` is live. A shared lock
# another holder already had on the same path stood in for the second one and
# recorded nothing, so after `m.drop` the list was writable, and droppable,
# under `k` -- `k.length` then read the destroyed list.
written: function is {
    xs: List String
    xs.append from: "a".string
    m: xs
    k: xs
    m.drop
    xs.append from: "b".string
    print "\{k.length}"
}

dropped: function is {
    xs: List String
    xs.append from: "a".string
    m: xs
    k: xs
    m.drop
    xs.drop
    print "\{k.length}"
}

main: function is {
    written
    dropped
}
