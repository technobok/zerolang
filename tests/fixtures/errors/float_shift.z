# Shifts are integer-only, like the rest of the bitwise set: a float has no
# bit positions to move, and gcc rejects `<<` on two doubles outright. So
# `f64 << f64` is a missing-method error rather than C the compiler cannot
# build -- an operator that typechecks has to emit code that compiles.
main: function is {
    a: 1.5.f64
    b: 2.0.f64
    c: a << b
    print "\{c}"
}
