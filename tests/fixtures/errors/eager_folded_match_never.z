# eager_folded_match_never -- a match folded on a unit constant to an arm that returns
# is `never` under --eager too: the arms the fold ruled out are walked for their own
# errors but are asked no common value type.
shape: choice {
    circle: i64
    square: i64
    dot: null
}
SH: (shape.square 4)

bump: function {n: i64} out i64 is {
    return n + 1
}

half: function {n: i64} out f64 is {
    return 0.5
}

pick: function {n: i64} out i64 is {
    k: match SH case circle then (bump :n) case square then {
        return SH * 2
    } case dot then (half :n)
    return 3
}

main: function is {
    print "\{pick n: 2}"
}
