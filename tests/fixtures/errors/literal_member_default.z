# E0100: a numeric literal's only member is its width (`0.u32`); `0.rid` reads
# a member the literal's own type does not have, in a default as in a body.
rid: typedef u32

Row: record { r: 0.rid  n: 1 }

f: function {a: i64 r: 0.rid} out i64 is {
    return a
}

main: function is {
    w: Row n: 2
    print "\{f a: w.n}"
}
