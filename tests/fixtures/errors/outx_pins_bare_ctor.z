# `outx this` on a create is a statement about what the RESULT holds -- a
# reference into one of the arguments -- so it pins that argument for as long as
# the result lives. Which spelling reached the create cannot change that.
#
# It did. `Peeker.create target: g` installed the pin; the bare-name form
# `Peeker target: g` did not, and the same move was ACCEPTED, leaving the
# result's field pointing at freed memory. The construction leg stamped the
# call kind and returned without ever asking the create what its return said.
#
# The bare-name form is the ordinary way to build a value, so the spelling that
# pinned was the rarer of the two.
Bag: class {
    a: i64
}

Peeker: class {
    target: Bag.borrow
} as {
    create: function {target: Bag.borrow} outx this is {
        return (meta.create :target)
    }
    look: function {it: this} out i64 is {
        return it.target.a
    }
}

eat: function {victim: Bag.take} is {
    print "ate \{victim.a}"
}

main: function is {
    g: Bag a: 42
    with p: (Peeker target: g) do {
        print "1: \{p.look}"
        eat victim: g.take
        print "2: \{p.look}"
    }
}
