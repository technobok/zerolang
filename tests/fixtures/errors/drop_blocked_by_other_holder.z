# E0200: `.drop` ends a name only when nothing else still points through it. A
# readonly name's own lock on itself ends with it; a second name's lock does
# not, so `m: e` keeps `e` alive, as it keeps the list `e` reads.
aliased: function is {
    xs: List String
    xs.append from: "a".string
    e: xs.get i: 0
    m: e
    e.drop
    print m
}

chained: function is {
    grid: List (List String)
    grid.append from: (List String)
    n: (grid.pop).get i: 0
    m: n
    n.drop
    print m
}

main: function is {
    aliased
    chained
}
