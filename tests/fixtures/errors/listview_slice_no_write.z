# E0200: a slice is READONLY. `get` on the window hands back a `T.view`, which
# is readonly for its whole scope, so an element write through a slice is
# refused. Writing an element in place stays on the owner (`ListRef.getMut`).
Row: class {
    n: i64
}
main: function is {
    rows: (List Row)
    rows.append (Row n: 1)
    s: rows.slice from: 0 to: 1
    e: s.get i: 0
    e.n = 99
    print "n=\{e.n}"
}
