# E0100: a field declared by a numeric generic parameter (`stored: cap`) is a
# slot of the parameter's singleton type, which has one value: no reassignment
# and no swap writes it, inside the type (where its type is the parameter's
# own, `cap`) or through a value of an instance (`(Box cap: 5).cap`).
Box: class {
    used: u32
    stored: cap
    other: cap
} as {
    cap: u32.generic
    bad: function {:this} is {
        this.stored = 9
        this.stored swap this.other
    }
}

main: function is {
    b: (Box cap: 5) used: 0
    b.bad
    b.stored = 5
}
