# A static value refers to one function. A function a generic unit declares is
# one per instance, so a data value of the unit (one value for every
# instance) cannot refer to it -- it is refused as a generic function is.
fnT: function {k: u64} out u64
box: data {
    f: fnT
}
wrap: unit as {
    n: u64.generic
    get: function {k: u64} out u64 is {
        return k + n
    }
    B: (box f: get)
    run: function out u64 is {
        return (B.f k: 1)
    }
}
w3: (wrap n: 3)

main: function is {
    print "\{w3.run}"
}
