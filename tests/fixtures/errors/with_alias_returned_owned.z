# with_alias_returned_owned.z -- a `with` that ends on its own name returns the
# reference that name is: `with w: s do w` returned from an `out` function
# hands the caller storage s still owns, refused as `w: s; return w` is.
LfBag: class {
    name: String
}

lfh0: function out LfBag is {
    s: LfBag name: "abc def".string
    return (with w: s do w)
}

main: function is {
    print lfh0.name
}
