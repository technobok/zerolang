# A `.view` receiver is readonly in a generic type too: the write is refused
# as a write, not as a lock taken by misreading the field as a call.
Slot: class {
    v: t
    bad: function {s: this.view} is {
        s.v = 7
    }
} as { t: anyval.generic }

main: function is {
    b: (Slot t: i64) v: 4
    b.bad
    print "b \{b.v}"
}
