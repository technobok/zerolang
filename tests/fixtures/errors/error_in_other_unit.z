# an error found in another unit is reported at that unit's file and line. A
# report at a string literal named no node -- the id it was given read only the
# kinds a type expression takes -- so its file fell back to the main unit's,
# and the line of elsewhere.z was shown against this file.
main: function is {
    a: (elsewhere.Off n: 2) v: 1
    print "\{a.wrong} \{elsewhere.label}"
}
