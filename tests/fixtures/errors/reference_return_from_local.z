# A reference return points into a `.borrow`/`.view` parameter or the
# receiver -- something that outlives the call. A local dies with the call,
# so returning a reference to it is refused.
Src: class {
    n: i64
}

mk: function {from: Src.borrow} outx Src.borrow is {
    loc: Src n: 2
    return loc
}

main: function is {
    a: Src n: 1
    r: mk from: a
    print "\{r.n}"
}
