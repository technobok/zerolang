# method_bound_unmet -- a method that adds a bound to its type's parameter is
# absent on an instance whose argument does not meet it: the call is refused,
# naming the bound
public: unit {
    :main
}

# Outcome -- a value or the reason there is none
Outcome: union {
    err: E
    ok: T
} as {
    T: AnyRef.generic
    E: AnyRef.generic
    # the reason's text -- only where E has text
    describe: function as { E: StringViewable.generic } in {o: this.view} outx StringView is {
        match (
            o
        ) case err then {
            return o.stringView
        } case ok then {
            return "fine"
        }
    }
}

# Code -- a reason with no text
Code: class {
    n: u32
}

main: function is {
    c: (Outcome String E: Code).err (Code n: 404)
    print "\{c.describe}"
}
