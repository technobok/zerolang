# a valtype parameter marked `.borrow` goes by pointer and an unmarked one is a
# copy, so the two are different markers when an implementation is compared
# with its spec, in either direction: the vtable's wrapper could not pass the
# one where the other is declared. A reftype parameter passes a reference
# either way, so there `.borrow` and unmarked match.
pt: record { x: i64 }

Box: class { v: i64 }

Bumper: protocol {
    bump: function {t: this.view p: pt} out i64
    grow: function {t: this.view p: pt.borrow} out i64
    fill: function {t: this.view b: Box} out i64
}

B: class { k: i64 } as {
    bumper: Bumper.implement
    bump: function {t: this.view p: pt.borrow} out i64 is {
        p.x = p.x + t.k
        return p.x
    }
    grow: function {t: this.view p: pt} out i64 is { return p.x + t.k }
    fill: function {t: this.view b: Box.borrow} out i64 is {
        b.v = t.k
        return b.v
    }
}

main: function is {
    b: B k: 5
    v: b.bumper
    a: pt x: 1
    print "\{v.bump p: a}"
}
