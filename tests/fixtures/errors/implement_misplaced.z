# `.implement` is written only as an item of a type's `as` block: a unit-level
# definition, a function's `as` item, a parameter, a field, a return, a body's
# binding and a type argument are each refused at the marker, once.
Speaker: protocol {
    speak: function {t: this.view} out i64
}
Dog: class { n: i64 } as {
    s: Speaker.implement
    speak: function {t: this.view} out i64 is { return t.n }
}
top: Speaker.implement
withAs: function as {
    s: Speaker.implement
} is {
    print "as"
}
takes: function {p: Speaker.implement} out i64 is {
    return p.speak
}
Holds: record {
    p: Speaker.implement
}
gives: function {d: Dog} out Speaker.implement is {
    return d.s
}

main: function is {
    d: Dog n: 1
    hs: Holds
    x: Speaker.implement
    l: ListVal Speaker.implement
    print "\{top} \{takes p: d}"
    withAs
    print "\{(gives :d).speak}"
}
