# E0600: a numeric generic parameter read through its generic template from
# outside the template (`Box.cap` in `main`): only an instance has a value for
# it, as for a template's constant over it (`Box.K`). The read named no value
# and reached the C as an empty expression.
Box: class {
    used: u32
} as {
    cap: u32.generic
    K: cap * 2
}

main: function is {
    x: Box.cap
    y: Box.K
    print "\{x} \{y}"
}
