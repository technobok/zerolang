# E0100: `return <value>` inside a generator. The spec says it is a compile
# error and that a bare `return` terminates the generator instead.
#
# The message used to name the `.call` wrapper -- "function expects
# optionval_i64" -- blaming the compiler's own machinery for the user's
# mistake, with a type the program never wrote and could not have satisfied.
G: generator as {
    call: function out i64 is {
        yield 1
        return 42
    }
}

main: function is {
    for x: G loop print "x: \{x}"
}
