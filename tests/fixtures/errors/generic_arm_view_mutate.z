# E0200: the same for a generic union's arm -- the shape the stdlib's
# borrowed-view optional uses. The payload of a `.view` arm is readonly in
# every instance.
Inner: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
}
Peek: union {
    some: t.view
    none: null
} as {
    t: Any.generic
}
main: function is {
    i: Inner n: 1
    p: (Peek.some i)
    match (
        p
    ) case some then {
        p.bump
        print "n=\{p.n}"
    } else null
}
