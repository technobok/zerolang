# A plain `for` binding is evaluated at every iteration, so a `.take` inside it
# moves at every iteration: the second finds the value already gone. (`for each`
# evaluates once, and may.)
eat: function {s: String.take} out optionval u64 is {
    return (optionval.some s.length)
}

main: function is {
    s: "abc".string
    for n: (eat s: s.take) loop print "\{n}"
}
