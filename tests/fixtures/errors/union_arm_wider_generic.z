# A generic union's arm over its own value-type parameter is measured per
# instance: `Tree i64` fits the slot, `Tree pair` does not, and the refusal is
# placed at the template's arm, naming the instance.
pair: record { a: i64  b: i64 }
Tree: union { leaf: t  node: String } as { t: anyval.generic }

main: function is {
    a: (Tree i64).leaf 5
    b: (Tree pair).leaf (pair a: 1 b: 2)
    if a.leaf then print "\{a}"
    if b.leaf then print "\{b.a}"
}
