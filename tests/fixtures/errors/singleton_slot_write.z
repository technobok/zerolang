# A SLOT OF A NUMERIC PARAMETER'S SINGLETON TYPE IS NEVER WRITTEN: its type has
# one value, so no reassignment and no swap gives it another, nor the same one
# again. A type or a unit written in a generic unit inherits the unit's
# parameter, and in each unit instance that parameter is one type: the slots in
# `bag`'s method and in `inner`'s function are of the unit instance's
# singleton type, `(wrap n: 3).n`, as the unit's own function's is.
Box: class {
    used: u32
} as {
    cap: u32.generic
    bad: function {:this} is {
        c: cap
        c = cap
        d: cap
        c swap d
    }
}

wrap: unit as {
    n: u64.generic
    bag: class {
        v: i64
    } as {
        bad: function {b: this.view} is {
            c: n
            c = 4
        }
    }
    inner: unit {
        bad: function is {
            c: n
            c = 5
        }
    }
    make: function out bag is {
        return (bag v: 1)
    }
    bad: function is {
        c: n
        c = 6
    }
}
wa: (wrap n: 3)

main: function is {
    b: (Box cap: 5) used: 0
    b.bad
    a: wa.make
    a.bad
    wa.inner.bad
    wa.bad
}
