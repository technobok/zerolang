# A SLOT OF A NUMERIC PARAMETER'S SINGLETON TYPE IS NEVER WRITTEN: its type has
# one value, so no reassignment and no swap gives it another, nor the same one
# again.
Box: class {
    used: u32
} as {
    cap: u32.generic
    bad: function {:this} is {
        c: cap
        c = cap
        d: cap
        c swap d
    }
}

main: function is {
    b: (Box cap: 5) used: 0
    b.bad
}
