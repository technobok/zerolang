# The same rule for a field. The record is CONSTRUCTED on purpose -- a
# definition nothing reaches is never resolved, so it is never checked either,
# and merely naming it as an uncalled function's parameter type is not enough.
# A field typed `null` carries nothing, so construction asks no value for it:
# the refusal is the only diagnostic.
Holder: record {
    slot: null
    n: 0.u32
}

main: function is {
    h: Holder
    print "n=\{h.n}"
}
