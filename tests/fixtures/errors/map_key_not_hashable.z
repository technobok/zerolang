# E0400: the three ways a key fails. A class that declares neither member has
# nothing to hash but its address; a type that struck a member off with a null
# shell said it has no equality, and the container used to supply one anyway.
Bare: class {
    n: i64
}
noeq: record {
    x: u64
} as {
    ==: null
}
main: function is {
    a: (Map Bare value: u64)
    b: (Set Bare)
    c: (Map noeq value: u64)
    d: (SetVal noeq)
    print "\{a.length} \{b.length} \{c.length} \{d.length}"
}
