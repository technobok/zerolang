# binop_operand_unresolved.z -- an unresolvable name as a binary-operation
# operand: bare, and as the root of a dotted read. Both legs report where the
# operand is consumed, like the argument and return legs do.
main: function is {
    n: 1
    if n == ghost9 then print "same"
    s: "a".string
    if s.stringview == phantom9.stringview then print "same"
}
