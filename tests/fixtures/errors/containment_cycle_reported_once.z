# A containment cycle through a non-generic record is refused once, where
# that record resolves: `Rr` holds a `(g i64)`, which holds an `Rr`. The
# instance `(g i64)` on the cycle is not blamed a second time.
g: record {
    r: Rr
    v: t
} as {
    t: anyval.generic
}

Rr: record {
    x: (g t: i64)
}

main: function is {
    k: (optionval.none Rr)
    print "made"
}
