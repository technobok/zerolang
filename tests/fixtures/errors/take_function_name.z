# A FUNCTION'S NAME NAMES NO STORAGE. `.take` moves a variable or a field and
# leaves it invalid; a unit function, a static method and a method read
# through its type are not places, so there is nothing to move or invalidate
# -- their reference is `.copy`. `.hold` and `.borrow` on one are refused the
# same way. (A variable holding a reference IS storage, and `.take` of it
# copies the reference, as it does any value -- fnref_take_copies.)
seven: function out i64 is {
    return 7
}

T: record {
    n: i64
} as {
    get: function {:this} out i64 is {
        return this.n
    }
    helper: function {n: i64} out i64 is {
        return n + 1
    }
}

main: function is {
    a: seven.take
    b: T.helper.take
    c: T.get.take
    d: seven.hold
    e: seven.borrow
    print "unreachable"
}
