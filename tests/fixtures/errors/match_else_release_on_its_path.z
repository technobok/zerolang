# match_else_release_on_its_path -- A lock its holder releases inside a match's `else`
# is released on that path only: the code after the match still finds the source locked.
LfBox: class {
    name: StringView
}

LfSide: variant {
    left: null
    right: null
}

lfSide: function {k: bool} out LfSide is {
    if k then return LfSide.left
    return LfSide.right
}

matchElseReassignWriteAfter: function {k: bool} is {
    s: "abc".string
    o: "ooo".string
    w: LfBox name: s.stringView
    match (lfSide :k) case left then print "left" else {
        w = LfBox name: o.stringView
    }
    s = "zzzzzzzzzzzzzzzz".string
    print "\{w.name}"
}

main: function is {
    matchElseReassignWriteAfter k: true
}
