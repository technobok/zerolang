# E0200: the path to a `.borrow` result passes through a `.view` field, whose
# contents are readonly for the instance's whole life.
Item: class {
    n: i64
}

W: class {
    v: Item.view
} as {
    lend: function {:this} outx Item.borrow is {
        return this.v
    }
}

main: function is {
    i: Item n: 1
    w: W v: i
    p: w.lend
    print "\{p.n}"
}
