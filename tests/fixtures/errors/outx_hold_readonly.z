# E0200: an `outx W.hold` result is READONLY as well as pinned -- that is the
# half it shares with `hold`, and the whole of its difference from `outx W`,
# whose result may be written through.
Src: class {
    n: i64
}

W: class {
    s: Src.view
    hits: i64
} as {
    bump: function {:this} is {
        this.hits = this.hits + 1
    }
}

mk: function {from: Src.view} outx W.hold is {
    return (W s: from hits: 0)
}

main: function is {
    a: Src n: 1
    w: mk from: a
    w.bump
}
