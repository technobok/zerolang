# `spawn` is the one way to start a thread: JoinHandle's `create` is the C that
# `spawn` runs, and is private to the handle.

# Hello -- prints from its thread
Hello: class {
    n: i64
} as {
    task: (thread.Task null)
    call: function {:this} is { print "hello \{this.n}" }
}

main: function is {
    h: (thread.JoinHandle null).create task: (Hello n: 1) name: "" stackSize: 0.u64
}
