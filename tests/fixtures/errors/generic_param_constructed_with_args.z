# E0300: a type parameter called with arguments constructs the type its
# instance gives it, and that construction is checked: with t = i64, `(t t)`
# passes an argument to i64's create, which takes none.
gf: function as {t: anyval.generic} in {a: t} out t is {
    b: (t t)
    return a
}

main: function is {
    x: gf a: 3
    print "\{x}"
}
