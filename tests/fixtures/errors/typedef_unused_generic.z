# every generic parameter of a typedef is a part of its base, derived from the
# value the typedef is built from. `t` appears nowhere in `ListVal i64`, so
# nothing could ever supply it.
Wrap: typedef ListVal i64 as { t: anyval.generic }
use: function {w: (Wrap t: u8).view} out u64 is { return w.length }
main: function is {
    v: ListVal i64
    print "\{use w: (Wrap v)}"
}
