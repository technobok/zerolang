# unit_value_refused_each_use -- a unit used whole where a value is wanted is refused at
# the value: as a binding's value, a `with` value and a loop condition alike
mathops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
}
intmath: (mathops t: i64)

main: function is {
    y: intmath
    with w: intmath do print "with"
    for each e: intmath loop print "each"
    for intmath loop print "while"
    print "done"
}
