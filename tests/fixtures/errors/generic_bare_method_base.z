# a generic type's bare name is no type, so a method reached through it names no
# instance for the method to belong to: written with its type arguments it is
# one, `(fx n: n)` inside its own declaration. Inside and out, `fx.make` was
# accepted and reached the C emitter with no callee.

# a value offset by n
fx: record {
    v: u64
} as {
    n: u64.generic
    # n more than from
    make: function {from: u64} out type is {
        return (meta.create v: from + n)
    }
    # through the bare name, inside
    twice: function {from: u64} out type is {
        a: fx.make :from
        return (meta.create v: a.v * 2)
    }
}

main: function is {
    a: fx.make from: 2
    b: (fx n: 3).twice from: 1
    print "\{a.v} \{b.v}"
}
