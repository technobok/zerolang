# A user method is refused a lock-holding value as a container's `append` is:
# its receiver could store the value and a later call hand it out without the
# lock. A construction and a named value are refused alike.

# Peek -- a view of a list its owner keeps
Peek: class {
    # the borrowed list
    xs: (ListVal i64).borrow
}

# Shelf -- keeps the values put on it
Shelf: class {
    # what was put on the shelf
    items: List Peek
} as {
    put: function {:this value: Peek.take} is {
        this.items.append value
    }
}

main: function is {
    xs: ListVal i64
    xs.append 1
    s: Shelf items: (List Peek)
    s.put value: (Peek :xs)
    p: Peek :xs
    s.put value: p
    print "\{s.items.length}"
}
