# E0100: a generator's `call` has an implicit receiver, and its parameter list
# declares only the per-call input. A receiver written there -- `:this`, a
# parameter typed `this` or `this.borrow`, the receiver beside an input -- was
# taken by the lowering for the input: the C `call` got an extra parameter or
# read a `value` nothing declared, `yield`'s value was typed as the generator,
# and a call site handed the generator over as an argument.
Named: generator { hi: i64 } as {
    call: function {g: this} out i64 is {
        yield this.hi
    }
}

Short: generator { hi: i64 } as {
    call: function {:this} out i64 is {
        yield this.hi
    }
}

Marked: generator { hi: i64 } as {
    call: function {this: this.borrow} out i64 is {
        yield this.hi
    }
}

Beside: generator as {
    call: function {:this step: i64} out i64 is {
        a: yield 1
        yield (a + 10)
    }
}

AsInput: generator as {
    call: function {step: this} out i64 is {
        yield 1
    }
}

main: function is {
    print "x"
}
