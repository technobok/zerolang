# An instance of a generic conformer minted only where a TYPE names it -- a
# signature, a field, a return -- is still sited: its error note says where it
# was instantiated, as a call's or a construction's does. The first place that
# names it is the site.
Getter: protocol {
    get: function {t: this.view} out i64
}
Box: class { x: t } as {
    t: anyval.generic
    :Getter
    get: function {b: this.view} out t is { return b.x }
}
use: function {b: (Box t: u8)} out i64 is { return 0 }
Holder: class { inner: (Box t: u16) }
make: function out (Box t: u32) is { return (Box x: 3.u32) }
main: function is {
    f: use.take
    h: Holder inner: (Box x: 1.u16)
    m: make
    print "x"
}
