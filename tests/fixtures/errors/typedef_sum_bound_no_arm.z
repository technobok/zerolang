# A typedef whose chain meets none of a sum bound's arms is refused, and the
# refusal names the typedef: no type on `meters`'s chain is u32 or u64.
meters: typedef u16
wide: variant { :u32 :u64 }

same: function as { t: wide.generic } in {x: t} out t is {
    return x
}

main: function is {
    m: meters 7
    a: same x: m
    print "\{a.u16}"
}
