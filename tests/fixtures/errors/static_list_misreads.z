# A list's `slot` holds its labels' positions and nothing else: a member that
# is no label, `copy` included, is refused once, where it is written. A list's
# name alone is no statement, and is refused at the line that writes it.
codes: list { ht: 9 lf: 10 } out staticlist u8
primes: list { 2 3 5 7 }

main: function is {
    b: codes.slot.copy
    primes
}
