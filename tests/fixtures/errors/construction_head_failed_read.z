# A unit-level construction whose head names nothing is reported at the head,
# once. A read of the failed definition -- directly, or through a unit alias --
# adds no "unit 'au' has no member 'impl'": the member is declared, and its
# definition's error stands for every read. A member the unit does not declare
# is still reported where it is read.
sch: unit {
    impl: data { n: 0 }
}

au: unit {
    impl: (c.impl n: 1)
}

bu: au

main: function is {
    print "\{au.impl.n}"
    print "\{bu.impl.n}"
    print "\{au.nope}"
}
