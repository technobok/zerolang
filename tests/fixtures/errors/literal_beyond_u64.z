# an integer literal past u64's maximum is read exactly, and every slot below is
# a u64, which cannot hold it: each is refused where it is written, naming the
# u64. It used to wrap silently: each of these stored or passed 0.
show: function {v: u64} is {
    print "v=\{v}"
}
big: function out u64 is {
    return 18446744073709551616
}
main: function is {
    x: 5.u64
    x = 18446744073709551616
    show v: 18446744073709551616
    y: 18446744073709551617.u64
    if x < 99999999999999999999 then print "lt"
    print "\{x} \{y} \{big}"
}
