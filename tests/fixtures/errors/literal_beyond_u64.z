# an integer literal past u64's maximum has no type to land in -- every literal
# is read in 64 bits -- so it is refused where it is written, whatever the
# slot. It used to wrap silently: each of these stored or passed 0.
show: function {v: u64} is {
    print "v=\{v}"
}
big: function out u64 is {
    return 18446744073709551616
}
main: function is {
    x: 5.u64
    x = 18446744073709551616
    show v: 18446744073709551616
    y: 18446744073709551617.u64
    if x < 99999999999999999999 then print "lt"
    print "\{x} \{y} \{big}"
}
