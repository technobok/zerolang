# An owned result whose type declares a non-owned field holds a reference into
# one of the call's inputs. A plain `out` says nothing keeps that input locked:
# the caller is free to write or drop it while the result still points at it.
# The check is not only for `out this`: a free function is held to it too.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} out W is {
    return (W s: from tag: 9)
}

main: function is {
    a: Src n: 1
    w: mk from: a
    print "\{w.tag}"
}
