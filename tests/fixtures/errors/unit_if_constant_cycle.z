# A RING OF CONSTANTS THROUGH A UNIT-LEVEL `if` IS A CYCLE, reported once as
# one. `A` selects a branch reading `B`, and `B` reads `A`, so neither has a
# value. The refusal that asks a definition with no value WHY must not ask
# again around the ring: its stand-in type looks `B` up, the lookup demands
# `B`, and `B`'s asking looks `A` up.
LIMIT: 5

A: if LIMIT > 1 then { B } else { 1 }

B: A + 1

main: function is {
    print "\{A}"
}
