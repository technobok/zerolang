# repoint_keeps_readonly -- a binding of a `.view` result is readonly, and a
# re-point keeps the mode it was bound with: after `nm = String` the binding
# still may not be written. The write was accepted, went to a copy of the
# String's header instead of the value the binding refers to, and leaked.
public: unit {
    :main
}

# Pool -- owns one text
Pool: class {
    s: String
} as {
    # the text, viewed
    name: function {p: this.view} outx String.view is {
        return p.s
    }
}

main: function is {
    p: Pool s: "pooled".string
    nm: p.name
    nm = String
    nm.append "rebuilt"
    print nm
}
