# A reference return (`.borrow`/`.view`) is a view into something the caller
# owns, so it keeps that source locked for as long as it lives. That is what
# `outx` says; a plain `out` reference is refused with the spelling to use.
Item: class {
    label: String
} as {
    peek: function {t: this.view} out String.view is {
        return t.label
    }
}

main: function is {
    e: Item label: "echo".string
    s: e.peek
    print "\{s}"
}
