# An expression of type `never` does not finish, so it has no value to pass:
# an argument of that type is refused, as a binding of one is, and `never`
# declares no members, so nothing is read off one.
#
# Neither was refused. `return` as an argument reached C as a call of an
# undeclared `z_system_return`, and `return.u64` and `(panic "a").length` were
# untyped arguments the emitter dropped -- C then said "too few arguments".
show: function {i: u64} is {
    print "\{i}"
}

main: function is {
    show i: return
    show i: return.u64
    show i: (panic "a").length
    n: (panic "b").length
}
