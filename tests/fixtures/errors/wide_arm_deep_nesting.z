# A union arm holding a record nested 32 deep over a u128 is as wide as the
# u128: past the slot, it is refused at the arm whatever the depth. The
# measure stopped at 32 levels and read the depth as a type containing itself,
# so the arm was neither inlined nor refused -- silently a heap cell.
r0: record {
    x: u128
}
r1: record {
    x: r0
}
r2: record {
    x: r1
}
r3: record {
    x: r2
}
r4: record {
    x: r3
}
r5: record {
    x: r4
}
r6: record {
    x: r5
}
r7: record {
    x: r6
}
r8: record {
    x: r7
}
r9: record {
    x: r8
}
r10: record {
    x: r9
}
r11: record {
    x: r10
}
r12: record {
    x: r11
}
r13: record {
    x: r12
}
r14: record {
    x: r13
}
r15: record {
    x: r14
}
r16: record {
    x: r15
}
r17: record {
    x: r16
}
r18: record {
    x: r17
}
r19: record {
    x: r18
}
r20: record {
    x: r19
}
r21: record {
    x: r20
}
r22: record {
    x: r21
}
r23: record {
    x: r22
}
r24: record {
    x: r23
}
r25: record {
    x: r24
}
r26: record {
    x: r25
}
r27: record {
    x: r26
}
r28: record {
    x: r27
}
r29: record {
    x: r28
}
r30: record {
    x: r29
}
r31: record {
    x: r30
}
r32: record {
    x: r31
}
U: union {
    w: r32
    s: String
}

main: function is {
    u: U.s "x".string
    match (u) case w then print "w" case s then print u
}
