# comprehension_value_take.z -- A FOR-EXPRESSION APPENDS ITS BODY'S VALUE, so
# that value answers to `.append`'s own contract: a reftype element is TAKEN
# (`ListRef.append from: T.take`) and a valtype is COPIED (`ListVal.append
# from: t`). Only the reftype half refuses anything.
#
# Nothing modelled the append, so an owning `ListRef String` was minted from a
# READONLY view of the container's storage with no diagnostic at all. It read
# as a wrong length -- `len 0` -- only because the emitter never emitted the
# loop; with the loop emitted the list owns storage the container still owns.
#
# The statement form of each of these has always been refused in exactly these
# words: `for e: xs.iterate loop { ys.append from: e }`. The refusals are the
# argument site's own, not a second derivation of them, which is why the third
# one -- an outer local moved once per iteration -- comes out of the loop-move
# rule without this file teaching it anything.
#
# `.copy` is what makes each legal, and comprehension_dispatch.z compiles it.
Box: class { s: String }

main: function is {
    xs: List String
    xs.append from: "a".string
    ys: for e: xs.iterate loop e
    b: Box s: "b".string
    zs: for x: 2.each loop b.s
    t: "c".string
    ws: for x: 2.each loop t
    print "\{ys.length} \{zs.length} \{ws.length}"
}
