# An array's `==` takes an array of the SAME type: its length and element type
# are part of it, and so is a str's capacity. Each right-hand side below is an
# argument-type mismatch, as it would be for any other method; the check used
# to never happen, because the member had no parameter to check against. The
# literal comes first: a literal's mismatch is reported only while no earlier
# error could explain it.
main: function is {
    a: (array t: i64 to: 2)
    print "\{a == 5}"
    longer: (array t: i64 to: 3)
    print "\{a == longer}"
    bytes: (array t: u8 to: 2)
    print "\{a != bytes}"
    s: "ab".str to: 8
    small: "ab".str to: 4
    print "\{s == small}"
}
