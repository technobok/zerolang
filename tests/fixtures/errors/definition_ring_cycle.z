# A definition whose value names itself through other definitions is a cycle,
# reported as `foo: foo.x` is -- whatever the ring's length. `foo: bar.x` with
# `bar: foo` was refused as "a unit-level constant takes a literal value, not a
# construction", a reason that names neither the cycle nor how to fix it.
foo: bar.x
bar: foo

a: b.x
b: c
c: a

main: function is {
    print "\{foo} \{a}"
}
