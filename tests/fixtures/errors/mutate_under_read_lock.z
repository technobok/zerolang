# E0200: 's' is a live read of 'e' -- a shared TARGET lock on (e,). Handing a
# descendant to a mutating borrow would let it realloc under 's'. Without this
# the program compiles and heap-use-after-frees.
Item: class {
    label: String
    value: i64
}
peek_label: function {b: Item.view} out String.view is {
    return b.label
}
grow: function {t: String.borrow} is {
    t.append "xyz"
}
main: function is {
    e: Item label: "echo".string value: 5
    s: peek_label e
    grow t: e.label
    print "\{s}"
}
