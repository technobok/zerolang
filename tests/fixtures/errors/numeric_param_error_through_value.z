# The same condition read through a name of the instance folds too:
# `(Buffer cap: 0).cap` is the instance's one value, so the `error` it guards is
# reached at compile time. A read through a value of the type (`b.cap`) is
# refused (errors/type_member_through_value).
Buffer: class {
    used: u32
} as { cap: u32.generic }

main: function is {
    b: (Buffer cap: 0) used: 0
    if (Buffer cap: 0).cap == 0 then error "b has no capacity"
    print "unreachable \{b.used}"
}
