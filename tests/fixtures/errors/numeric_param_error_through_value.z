# The same condition read through a value of the type folds too: `b.cap` is
# fixed by b's type. It reached the emitter unhandled.
Buffer: class {
    used: u32
} as { cap: u32.generic }

main: function is {
    b: (Buffer cap: 0) used: 0
    if b.cap == 0 then error "b has no capacity"
    print "unreachable"
}
