# A TYPEDEF'D VARIABLE IS REASSIGNED A VALUE OF ITS OWN TYPE: the same typedef,
# or one built from the base (`m = meters 9`). A value of the base alone -- a
# variable, a literal, a record -- is refused, as it is where a typedef
# parameter is expected. A swap of a typedef with its base stays allowed.
meters: typedef i64

pt: record {
    x: i64
}

spot: typedef pt

main: function is {
    m: meters 5
    m = meters 9
    x: 7
    m swap x
    m = x
    m = 7
    s: spot (pt x: 1)
    q: pt x: 2
    s = q
    print "\{m} \{s.x}"
}
