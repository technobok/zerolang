# A protocol value wraps its conformer and stands in for its own protocol
# only: passing a Job where a marker Job declares is expected is refused.

# Mark -- a marker
Mark: protocol {}

# Job -- declares the marker
Job: protocol {
    # the work
    run: function {:this}
} as {
    :Mark
}

# W -- a Job
W: class {
    # its number
    n: i64
} as {
    job: Job
    run: function {:this} is { print "w \{this.n}" }
}

# marked -- takes any Mark
marked: function {m: Mark} is { print "marked" }

main: function is {
    j: Job.create from: (W n: 1)
    marked m: j
}
