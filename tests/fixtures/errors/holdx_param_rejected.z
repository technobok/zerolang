# E0200: `.holdx` says what a RESULT does with the sources it was built from,
# so only a return can carry it. On a parameter it answered plain `owned` --
# `.hold` wearing a word that promised a pin nobody installed.
Src: class {
    n: i64
}
f: function {b: Src.holdx} out i64 is {
    return b.n
}
main: function is {
    a: Src n: 5
    print "\{f b: a}"
}
