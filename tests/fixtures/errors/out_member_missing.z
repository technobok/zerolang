# out_member_missing.z -- `out Bag.bogus` names no member of Bag: reported at the
# declaration. It used to type the return as null and report the first use
# ("'null' cannot be used as a value").
Bag: class { a: i64 }

f: function out Bag.bogus is { return (Bag a: 2) }

main: function is {
    b: f
    print "\{b.a}"
}
