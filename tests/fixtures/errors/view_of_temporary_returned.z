# An owned value that is never named -- a call's result read as a view -- is a
# temporary of the statement that made it. Returning the view hands the caller
# a reference into that temporary, which dies with this call.
mks: function {n: i64} out String is {
    return "x\{n}"
}

direct: function out StringView is {
    return (mks n: 1).stringView
}

sliced: function {p: String} outx StringView is {
    return ((mks n: 2).substring from: 0 to: 1)
}

heldByBinding: function out StringView is {
    v: (mks n: 3).stringView
    return v
}

main: function is {
    q: "q".string
    print (direct)
    print (sliced p: q)
    print (heldByBinding)
}
