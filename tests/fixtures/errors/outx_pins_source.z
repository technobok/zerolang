# `outx W` pins the non-owned sources the result was built from, for as long
# as the result lives. Through a plain `out` the same signature would accept
# this write and leave the result's `s` field pointing at a value the caller
# is free to mutate. `outx` on the declaration is what pins it.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 9)
}

main: function is {
    a: Src n: 1
    w: mk from: a
    a.n = 5
    print "tag=\{w.tag}"
}
