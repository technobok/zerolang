# THE LITERAL TYPES CANNOT BE WRITTEN AS A DECLARED TYPE. `intliteral` and
# `floatliteral` are what the checker gives a lexeme until context pins one:
# compile-time only, with no C representation. Written as a field's, a
# parameter's or a return's type they reached emission as an undefined
# `z_t1_t`, and the C did not compile -- at exit 0.
#
# A unit-level ALIAS may still name a literal type: that binds the type, it
# does not declare a value of it. emitc_corpus/literal_type_alias pins that
# side, and errors/literal_type_annotation pins the bare-name binding.
R: record {
    f: intliteral
}

takes: function {v: floatliteral} out f64 is {
    return 1.0
}

gives: function out intliteral is {
    return 1
}

main: function is {
    r: (R f: 1)
    print "\{r.f} \{(takes v: 1.5)} \{(gives)}"
}
