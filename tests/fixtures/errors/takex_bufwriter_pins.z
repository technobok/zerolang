# `BufWriter.create to: Writer.borrow ... out this.takex` -- the motivating case
# for the marker, and the reason `.lock` could not simply become `borrow`.
#
# The result OWNS a `sink` field that is a reference into `to`, so `to` has to
# stay pinned for as long as the bufwriter lives. io.z has always documented
# this ("while the bufwriter is alive, the original writer cannot be mutated,
# borrowed again, or locked"), but with `.lock` on the parameter the pin did not
# actually reach a unit-qualified constructor call -- this program was accepted.
# `takex` is what makes the documented claim true.
main: function is {
    f: io.stdout
    bw: io.BufWriter.create to: f capacity: 64
    rr: f.flush
    match (
        rr
    ) case ok then {
        print "flushed the raw writer out from under the buffer"
    } case err then {
        print "err"
    }
    print "cap ok"
}
