# A Row pins its Statement exclusively until its Step goes out of scope, so a
# second step while a row -- or a text view read from it -- is still in hand is
# refused: the view would point at the previous row's memory.
main: function is {
    db: sqlite.openMemory
    if db.err then return
    q: db.prepare sql: "select 'a' union all select 'b'"
    if q.err then return
    s: q.step
    match (
        s
    ) case row then {
        v: s.text column: 0
        next: q.step
        match (v) case ok then print "\{v}" else null
    } else null
}
