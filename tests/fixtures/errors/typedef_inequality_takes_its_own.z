# a typedef record's `!=` is the `==` its author wrote, negated, and takes what
# that `==` takes. It used to fall through to the BASE type's comparison, so an
# argument the declared `==` refuses was accepted by `!=` and compared as a raw
# u64 -- the opposite answer, silently.
pid: record {
    val: u64.typedef
} as {
    ==: function {this: this.view rhs: pid} out bool is {
        return (this.u64 % 2) == (rhs.u64 % 2)
    }
}
main: function is {
    a: pid.create from: 1
    x: 7.u64
    print "\{a != x}"
    print "\{a == x}"
}
