# A BARE CALLABLE OBJECT IS A CALL, so one whose `call` needs input is a call
# missing it -- the words any bare call missing its arguments gets. The input is
# written in the call (`g.call step: 1`), and the object itself is handed on
# with a marker (`g.borrow`).
Acc: generator { total: i64 } as {
    call: function {step: i64} out i64 is {
        for loop {
            s: yield this.total
            this.total = this.total + s
        }
    }
}

main: function is {
    g: Acc total: 0
    v: g
    print "unreachable"
}
