# A Statement keeps its Database viewed for as long as it lives: moving one to
# another thread would leave the owner and the thread on one connection, so it
# is refused like a view of the Database itself.

# Stepper -- steps a statement on its own thread
Stepper: class {
    # the statement, moved in with the view of its database it holds
    q: sqlite.Statement
} as {
    task: (thread.Task null)
    call: function {:this} is {
        s: this.q.step
        print "stepped"
    }
}

main: function is {
    db: sqlite.openMemory
    if db.err then return
    q: db.prepare sql: "select 1"
    if q.err then return
    h: thread.spawn task: (Stepper q: q.take)
}
