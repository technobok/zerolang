# a protocol or facet spec with no `this` parameter is refused: a value of
# the interface calls each spec on the value it holds, through its vtable,
# and a function with no receiver has nothing to be called on there. Both
# spellings of the receiver, `:this` and `t: this.view`, are accepted. For the
# same reason a method that takes no receiver does not implement a spec.
Shape: protocol {
    area: function {t: this.view} out i64
    scale: function {:this by: i64} out i64
    unitArea: function {} out i64
}

measurable: facet {
    measure: function {t: this.view} out i64
    base: function {} out i64
}

Sq: class { s: i64 } as {
    shape: Shape.implement
    area: function {t: this.view} out i64 is { return t.s * t.s }
    scale: function {by: i64} out i64 is { return by }
    unitArea: function {} out i64 is { return 1 }
}

main: function is {
    print "none"
}
