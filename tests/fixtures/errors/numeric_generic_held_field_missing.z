# E0100: a numeric generic parameter with a marker (`cap.hold`) is refused as a
# field's type: as a type the parameter has one value, which a field declared
# by the bare parameter (`stored: cap`) holds, and the construction sets it. A
# construction leaving the refused field out says nothing more.
Box: class {
    used: u32
    stored: cap.hold
} as {
    cap: u32.generic
}
main: function is {
    a: (Box cap: 5) used: 1
    print "\{a.used}"
}
