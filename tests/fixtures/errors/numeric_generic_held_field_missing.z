# E0300: a field declared by a marked numeric generic parameter (`cap.hold`)
# is a required field of the bound's type, as one marked from a unit constant
# is, and the report names that type.
Box: class {
    used: u32
    stored: cap.hold
} as {
    cap: u32.generic
}
main: function is {
    a: (Box cap: 5) used: 1
    print "\{a.stored}"
}
