# A data block is a value of ITS type: `intdata u8` for a block of u8, never a
# value of another element type or of the other numeric family.
bytes: data { 1 2 3 } out intdata u8
halves: data { 0.5 0.25 }

wide: function {d: intdata u16} out u64 is {
    return d.length
}

ints: function {d: intdata i64} out u64 is {
    return d.length
}

main: function is {
    print "\{wide d: bytes} \{ints d: halves}"
}
