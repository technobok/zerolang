# out_return_through_temp.z -- an `out` function returns a pinning call over a
# parameter through a hoisted temporary: the result keeps the parameter locked
# through the temporary, which the caller cannot see, as a bare return of
# `s.substring ..` could not.
lfPass: function {v: StringView.view} outx StringView is {
    return v
}

f: function {s: String.view} out StringView is {
    return (lfPass v: (s.substring from: 0 to: 3))
}

main: function is {
    s: "abc def".string
    v: f :s
    print v
}
