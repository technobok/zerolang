# `_` stands for the parameter's type by spelling its name into the call, so
# a type that has no name -- an instance of a generic -- cannot be reached
# through it, and the `_` is reported. Writing the type out is the way.
total: function {xs: ListVal i64} out u64 is {
    return xs.length
}

main: function is {
    print "\{total xs: _.create}"
}
