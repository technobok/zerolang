# arg_value_unresolved_nested.z -- the unresolvable name is an OPERAND of the
# argument expression, not the whole argument, so finding it means descending
# through the binop.

takes: function {a: u64} out u64 is {
    return a + 1
}

main: function is {
    r: takes a: ghostOperand + 1
    print "\{r}"
}
