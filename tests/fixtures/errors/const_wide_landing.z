# an untyped integer is exact wherever it is computed, and checked where it
# lands: in the type a destination gives it, or in i64 where nothing does. Each
# landing below names its destination; the intermediates do not err.
Big: 9223372036854775808

# n -- an i64 parameter
n: function {v: i64} out i64 is { return v }

# b -- a u8 parameter
b: function {v: u8} out u8 is { return v }

main: function is {
    x: Big
    y: n v: Big - 1 + 1
    z: b v: 256 * 1000000000000000000000 / 1000000000000000000000
    r: 9223372036854775807 + 1
    print "\{x} \{y} \{z} \{r} \{Big}"
    ok: n v: Big - 1
    print "\{ok}"
}
