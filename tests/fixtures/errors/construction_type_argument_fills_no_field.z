# A construction's leading type argument binds the type parameter, not the
# first field: leaving that field out is reported as it is when the type
# argument is labelled. It ran with the field zero.
Pair: record {
    a: t
    b: t
} as {
    t: anyval.generic
}

main: function is {
    p: Pair i64 b: 2
    q: Pair t: i64 b: 3
    print "\{p.a} \{p.b} \{q.a}"
}
