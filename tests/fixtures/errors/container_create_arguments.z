# `T.create` IS THE SAME CALL AS EVERY OTHER CONSTRUCTION OF T, so its arguments
# are checked against the same `create {capacity: 0.u64}`: a capacity that is not
# a u64, a label create does not declare, and a generic template named without
# its type arguments are refused in the explicit spelling as in the sugar.
main: function is {
    a: (ListVal t: i64).create capacity: "eight"
    b: (MapVV k: i64 v: i64).create size: 8
    c: ListVal.create capacity: 8
    d: MapVV.create
    print "\{a.length} \{b.length}"
}
