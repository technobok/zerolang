# E0200: a mutable element reference excludes every other reference to the
# container, so a second `getMut` while the first is live is refused. This is
# the other half of the flip: `get` may alias because it cannot write, and
# `getMut` may write because it cannot alias.
Row: class {
    n: i64
}
main: function is {
    rows: (List Row)
    rows.append (Row n: 10)
    a: rows.getMut i: 0
    b: rows.getMut i: 0
    a.n = 20
    print "a=\{a.n} b=\{b.n}"
}
