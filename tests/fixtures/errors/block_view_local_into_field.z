# block_view_local_into_field.z -- a block that declares a view and hands it
# back hands back a view: stored in a field, it keeps the string locked as
# `ho.v = s.stringView` does, through a block or a `with` alike.
LfHold: class {
    v: StringView
}

viaBlock: function out i64 is {
    s: "abc def".string
    ho: LfHold v: "init"
    ho.v = {
        w: s.stringView
        w
    }
    s = "zzz".string
    return ho.v.length.i64.orPanic
}

viaWith: function out i64 is {
    s: "abc def".string
    ho: LfHold v: "init"
    ho.v = with w: s.stringView do w
    s = "zzz".string
    return ho.v.length.i64.orPanic
}

main: function is {
    print "\{viaBlock} \{viaWith}"
}
