# The head of a type application is a literal: a text, a list. No definition
# could give either a type, so each is refused, once, where it is written --
# the reference names no type, and was once accepted in silence.
Holder: class {
    t: ("s" i64)
    l: (list { 1 } i64)
}

main: function is {
    print "hi"
}
