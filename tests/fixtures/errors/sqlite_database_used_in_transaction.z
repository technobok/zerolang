# A Transaction pins its Database exclusively until it ends: statements run
# on the Transaction, and using the Database inside its `with` is refused.
main: function is {
    db: sqlite.openMemory
    if db.err then return
    with tx: db.transaction do {
        if tx.err then return
        r: db.executeBatch sql: "select 1"
        c: tx.commit
    }
}
