# A data element is any compile-time constant: one that has no value is refused
# where it is written. A call has a value only at run time, an arm is not a
# number, and an element that reads its own block is a cycle. Each was skipped
# with no value, and the emitter wrote whatever it made of the expression into
# the block's static initializer.
shade: variant { light: null dark: null }

pick: function out i64 is {
    return 3
}

calls: data { 1 (pick) }
arms: data { 1 shade.dark }
loops: data { 1 loops.0 }

main: function is {
    print "\{calls.index 1} \{arms.index 1} \{loops.index 1}"
}
