# bound_unmet_after_demanded_body_file -- after a statement's walk demanded another
# unit's function body, an unmet bound later in the same statement is still reported in
# the statement's own file.
# `g5lib.quiet` is walked first, from this statement; the Box made after it is still
# reported in this file.
main: function is {
    print "start"
    n: g5lib.quiet + ((g5lib.Box T: i64) v: 5).v
    print "\{n}"
}
