# A function without an `out` returns nothing, and `null` has no members. A
# member read, a method call or an operator on such a call is refused where the
# type is -- as binding it, printing it or testing it already were -- rather
# than reaching the emitter as an E0500 or the C as a member of a `void` call.
noret: function is {
    print "hi"
}

Box: class {
    n: i64
} as {
    touch: function {:this} is {
        this.n = 1
    }
}

memberBound: function is {
    n: noret.length
    print "\{n}"
}

memberInInterp: function is {
    print "\{noret.length}"
}

memberAsStatement: function is {
    noret.length
}

memberInCondition: function is {
    if noret.length > 0 then print "yes"
}

parenthesised: function is {
    n: (noret).length
    print "\{n}"
}

methodCall: function is {
    x: (noret.pick n: 1)
}

operator: function is {
    x: (noret) + 1
    print "\{x}"
}

comparison: function is {
    x: noret == noret
    print "\{x}"
}

nothingMethod: function {b: Box} is {
    m: b.touch.n
    print "\{m}"
}

copied: function is {
    x: noret.copy
}

main: function is {
    memberBound
    memberInInterp
    memberAsStatement
    memberInCondition
    parenthesised
    methodCall
    operator
    comparison
    nothingMethod b: (Box n: 0)
    copied
    f: noret.take
    f
}
