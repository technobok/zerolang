# A returned value refused for dying with the call says what its root is: a
# function called there, whose value is new; a `.view` parameter re-pointed at
# a value the call made; a view parameter re-pointed at a local's view. Each
# was called "a local", or said to view what the caller passed.
Node: class {
    name: String
}

mk: function out Node is {
    return (Node name: "t".string)
}

made: function {n: Node.view} outx Node.view is {
    return (mk)
}

repointed: function {n: Node.view} outx Node.view is {
    n = mk
    return n
}

viewed: function {s: StringView} out StringView is {
    loc: "abc".string
    t: loc.stringView
    s = t
    return s
}

main: function is {
    m: Node name: "m".string
    print "\{(made n: m).name} \{(repointed n: m).name} \{viewed s: "x"}"
}
