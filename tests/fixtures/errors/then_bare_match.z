# E0029: a bare `match` as a `then` body. `match` reads a trailing `else` in
# caseClausesTail, so an `else` after this one would be swallowed by the inner
# match rather than the enclosing `if`. Braces settle it.
V: variant {
    x: null
    y: null
}

main: function is {
    v: V.x
    b: 5
    if b > 3 then match v case x then print "x" case y then print "y"
    print "done"
}
