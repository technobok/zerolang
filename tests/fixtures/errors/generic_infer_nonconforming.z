# A generic parameter inferred through another argument's conformance cannot be
# inferred from an argument that conforms to no instance of the protocol: the
# bound is unmet, and that is what is reported.

# Job -- something that answers an R
Job: protocol {
    call: function {:this} out R
} as {
    R: AnyRef.generic
}

# Plain -- conforms to nothing
Plain: class { s: String }

# run -- runs any Job, answering its R
run: function {j: J.take} out R is {
    return j.call
} as {R: AnyRef.generic J: (Job R).generic}

main: function is {
    print (run j: (Plain s: "x".string))
}
