# generic_tmpl_from_dep.z -- the main unit declares the template that deptmpl.z
# tries to instantiate. Loading the dependency does not make the consumer's
# definitions visible to it.
mathops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
}

main: function is {
    print "sum=\{deptmpl.sum a: 3 b: 5}"
}
