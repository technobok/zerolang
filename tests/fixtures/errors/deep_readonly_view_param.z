# E0200: readonly is deep. Reading a reftype field out of a `view` receiver
# yields a readonly binding, so the intermediate name cannot launder the
# restriction away -- `c.sub.bump` is refused directly, and binding it first
# must be refused too.
Inner: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
}
Outer: class {
    sub: Inner
}
peek: function {c: Outer.view} is {
    i: c.sub
    i.bump
    print "n=\{i.n}"
}
main: function is {
    o: Outer sub: (Inner n: 1)
    peek c: o
}
