# E0400: the three ways a type fails a hashable bound.
#   Heavy -- a record owning a String: a byte range cannot reach a member that
#            lives behind a pointer, so there is no synthesised hash for it.
#   Bare  -- a class declaring neither member: nothing says whether it means
#            identity or value, and guessing produced invalid C for a Map key.
#   Bare against ValHashable -- wrong family outright.
Heavy: record {
    s: String
}

Bare: class {
    n: i64
}

keyv: function as { k: ValHashable.generic } in { v: k } out u64 is {
    v
    return 1
}

keyr: function as { k: RefHashable.generic } in { v: k } out u64 is {
    v
    return 2
}

main: function is {
    a: keyv v: (Heavy s: "x".string)
    b: Bare n: 1
    c: keyr v: b
    d: keyv v: b
    print "\{a} \{c} \{d}"
}
