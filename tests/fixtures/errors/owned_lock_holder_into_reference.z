# owned_lock_holder_into_reference.z -- an owned value holding locks cannot
# move into a reference either: the locks would end with the reference.

W: class {
    # the borrowed source
    s: String.borrow
}

Holder: class {
    # the stored value
    w: (Option W)
}

main: function is {
    h: Holder w: (Option.none W)
    lists: (List W)
    src: "a string long enough to live on the heap".string
    with a: h do {
        w1: W s: src
        a.w = Option.some w1
    }
    with inner: lists do inner.append from: (W s: src)
    print "\{lists.length}"
}
