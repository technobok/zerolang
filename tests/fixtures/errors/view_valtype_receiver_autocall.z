# E0200: the zero-argument AUTO-CALL leg of the same rule -- `p.poke` with no
# call node locks the receiver through lockAutoCallReceiver, which used to
# skip every valtype.
point: record {
    x: i64
} as {
    poke: function {:this} is {
        this.x = 99
    }
}
reader: function {p: point.view} is {
    p.poke
}
main: function is {
    q: point x: 1
    reader p: q
    print "\{q.x}"
}
