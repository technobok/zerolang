# A Statement pins the Database it was prepared on, so it cannot be kept past
# the Database's scope: moving it into a list that outlives the Database is
# refused (rusqlite's Statement<'conn> borrow, here a lock).
main: function is {
    kept: List sqlite.Statement
    {
        db: sqlite.openMemory
        if db.err then return
        q: db.prepare sql: "select 1"
        if q.err then return
        kept.append q.take
    }
    print "\{kept.length}"
}
