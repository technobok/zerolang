# E0200: a write is rejected while an exclusive lock overlapping its target is
# outstanding -- the holder reaches through that path.
Inner: class { n: i64 }
Outer: class {
    a: Inner
    pub: i64
}
main: function is {
    o: (Outer a: (Inner n: 1) pub: 3)
    with v: o.borrow do {
        o.pub = 5
        o.a.n = 9
    }
    print "\{o.pub} \{o.a.n}"
}
