# E0600: constant folding is the same wherever it is written. A constant
# integer operation that overflows its type, and a division or a remainder by a
# constant zero, have no value at run time either -- C wraps the one (`-fwrapv`)
# and traps on the other -- so a body refuses them as a unit-level definition
# does (const_overflow.z). The narrow forms wrapped in their width, and `1 / 0`
# and `7 % 0` trapped.
#
# An UNTYPED operation is exact: `BIG + BIG` and `BIG * 2` are values past
# i64, and each is refused where it lands -- here in i64, the receiver of a
# comparison with an i64 and an interpolated part -- naming that type (E0100).
# They reached C as a wrap. A typed u64 operation folds in u64:
# `9223372036854775807.u64 + 1.u64` fits its type and is not reported.
BIG: 9223372036854775807

main: function is {
    n: 3
    if (BIG + BIG) > n then print "sum above n"
    if (BIG * 2) > n then print "product above n"
    print "\{9223372036854775807 + 1}"
    print "\{200.u8 * 2.u8} \{127.i8 + 1.i8}"
    print "\{1 / 0} \{7 % 0}"
    print "\{9223372036854775807.u64 + 1.u64}"
}
