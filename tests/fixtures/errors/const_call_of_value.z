# A unit-level definition that writes an argument after a constant or a
# literal is a call of a value, which has no value: it is refused as it is in
# a body. It used to be accepted with no type, and a read of it reached the
# emitter.

C: 5
Twice: C 1
Literal: 1 1
Half: C / 2 + 1 1

main: function is {
    print "\{Twice} \{Literal} \{Half}"
}
