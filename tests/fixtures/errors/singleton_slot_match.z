# E0100: a slot of a numeric parameter's singleton type holds a run-time value,
# and a `match` dissects no run-time value: `match cap` dissects the parameter
# itself, in each instance. The refusal names the slot's type as the template
# writes it, `cap`.
Box: class {
    used: u32
    kind: function {:this} out StringView is {
        c: cap
        match c case 5 then {
            return "five"
        } else {
            return "other"
        }
    }
} as { cap: u32.generic }

main: function is {
    b: (Box cap: 5) used: 0
    print "\{b.kind}"
}
