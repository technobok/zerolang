# E0200: a `.view` receiver is readonly for the whole body -- the alias holds a
# readonly lock on itself, exactly as a `view` parameter does.
Item: class {
    value: i64
} as {
    poke: function {t: this.view} is {
        t.value = 9
    }
}
main: function is {
    e: Item value: 5
    e.poke
    print "\{e.value}"
}
