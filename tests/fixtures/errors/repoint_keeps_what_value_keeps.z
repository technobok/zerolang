# After a re-point `x = v` the borrowed `x` keeps what `v` keeps. A view of a
# local String, re-pointed into `x` -- directly, in an arm, through an `if`
# value, through a second name -- keeps that local locked, and the local dies
# with the call, so `x` cannot be returned. A parameter re-pointed at an owned
# value refers to the value's place in this call, which dies with it too.
Node: class {
    name: String
}

mk: function out Node is {
    return (Node name: "made".string)
}

viaOut: function {p: String.view} out StringView is {
    loc: "abc".string
    s2: p.stringView
    s2 = loc.stringView
    return s2
}

viaOutx: function {p: String.view} outx StringView is {
    loc: "abc".string
    s2: p.stringView
    s2 = loc.stringView
    return s2
}

inArm: function {p: String.view c: bool} outx StringView is {
    loc: "abc".string
    s2: p.stringView
    if c then s2 = loc.stringView
    return s2
}

ifValue: function {p: String.view c: bool} outx StringView is {
    loc: "abc".string
    s2: p.stringView
    s2 = if c then loc.stringView else p.stringView
    return s2
}

secondName: function {p: String.view} outx StringView is {
    loc: "abc".string
    s2: p.stringView
    s2 = loc.stringView
    w: s2
    return w
}

selfDerived: function {p: String.view} outx StringView is {
    loc: "abc".string
    s2: loc.stringView
    s2 = s2.substring from: 1 to: s2.length
    return s2
}

param: function {n: Node.view} outx Node.view is {
    n = mk
    return n
}

main: function is {
    p: "x".string
    m: Node name: "m".string
    print "\{viaOut :p} \{viaOutx :p} \{inArm :p c: true} \{ifValue :p c: true}"
    print "\{secondName :p} \{selfDerived :p} \{(param n: m).name}"
}
