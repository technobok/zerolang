# E0200: an `outx W.hold` result pins the non-owned sources it was built from,
# so the source cannot be written while the result is live. This is the half
# `.hold` shares with the plain `outx W`; `hold_return.z` is the same shape
# WITHOUT the pin (a plain `out W.hold`), and there the write is allowed.
Src: class {
    n: i64
}

W: class {
    s: Src.view
}

mk: function {from: Src.view} outx W.hold is {
    return (W s: from)
}

main: function is {
    a: Src n: 1
    w: mk from: a
    a.n = 5
    print "\{w.s.n}"
}
