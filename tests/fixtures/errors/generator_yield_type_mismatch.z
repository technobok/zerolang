# A yielded value is checked against the generator's element type, as a
# returned value is against a function's declared return: a checked conversion's
# result is not the number it converts to, and a String is not a number.
Gen: generator as {
    call: function out u64 is {
        x: 5
        yield x.u64
        yield "text".string
        yield 3
    }
}

main: function is {
    for v: Gen loop print "gen \{v}"
}
