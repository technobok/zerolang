# E0100: a list's `out` names the list's own type, `list T`. An element type, or
# any other type, is refused where it is written, and the hint writes the list
# type when the `out` names an element.
a: list { 1 2 } out u8
b: list { 1 2 } out String

main: function is {
    print "\{a.length} \{b.length}"
}
