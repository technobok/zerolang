# E0100: a list's `out` names the list's own type, `list T`, and a data
# block's names an intdata, floatdata or stringdata. An element type, or the
# other family's type, is refused where it is written.
a: list { 1 2 } out u8
b: list { 1 2 } out intdata u8
c: data { 1 2 } out list u8

main: function is {
    print "\{a.length} \{b.length} \{c.length}"
}
