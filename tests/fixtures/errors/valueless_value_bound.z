# An expression that produces no value cannot be used as one: a call to a
# function with no `out` (generic or not), or a block whose last line has no
# value -- one that ends in `break`, or in such a call. Without the refusal the
# value reaches the emitter, which stops on E0500.
pass: function {a: i64} out i64 is {
    return a
}

quiet: function is {
    print "quiet"
}

main: function is {
    c: true
    a: print "a"
    b: pass a: print "b"
    q: quiet
    d: {
        if c then break
        print "d"
    }
    e: {
        break
    }
    print "made"
}
