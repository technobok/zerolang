# repoint_through_arm_reference_keeps.z -- r re-pointed in an arm through the
# arm's reference keeps the list locked after the arm: writing it is refused.
pick: function {s: String.view} outx String.view is {
    return s
}

main: function is {
    o: "other".string
    xs: List String
    xs.append "abc def".string
    k: xs.length > 0
    r: pick s: o
    if k then {
        t: xs.get i: 0
        r = t
    }
    xs.set i: 0 val: "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz".string
    print r
}
