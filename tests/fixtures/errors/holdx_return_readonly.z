# E0200: a `holdx` result is READONLY as well as pinned -- that is the half it
# shares with `hold`, and the whole of its difference from `takex`, whose
# result may be written through.
Src: class {
    n: i64
}

W: class {
    s: Src.view
    hits: i64
} as {
    bump: function {:this} is {
        this.hits = this.hits + 1
    }
}

mk: function {from: Src.view} out W.holdx is {
    return (W s: from hits: 0)
}

main: function is {
    a: Src n: 1
    w: mk from: a
    w.bump
}
