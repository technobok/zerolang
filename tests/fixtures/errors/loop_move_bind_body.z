eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
nope: function out bool is {
    return false
}
# a bare reftype binding `b: m` MOVES `m`.
main: function is {
    m: "abc".string
    n: 0
    for while n < 3 loop {
        n = n + 1
        b: m
        print "\{b.length}"
    }
}
