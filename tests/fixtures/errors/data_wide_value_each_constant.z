# A data value's untyped number past i64 is refused where the value is used at
# run time, once for each constant it is used through: `huge` and `also` are
# two constants of one value, each a mistake of its own (equal values share
# one static object, which was reported once); `huge` used twice is one.
row: data { big: intliteral }
huge: (row big: 99999999999999999999999)
also: (row big: 99999999999999999999999)
show: function {r: row} is { print "\{r.big}" }
main: function is {
    show r: huge
    show r: huge
    show r: also
}
