# A unit-level constant calling a method of a literal is a call on a value, and
# is reported as a body reports it: the method's own reason, once. The literal
# at its root was also reported as "Unknown reference '8'".
a: (8.u32.compare rhs: 2)
b: (8.nosuch y: 2)
c: (8.u32.max y: 2)

main: function is {
    print "\{a} \{b} \{c}"
}
