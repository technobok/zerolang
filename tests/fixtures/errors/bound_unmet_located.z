# An argument that does not meet its parameter's bound is reported at the
# statement that asked for the instance -- the instance has no position of its
# own. The instances minted as its members (a list's view and iterator) fail
# over the same argument and are not reported again, and neither is the
# instance itself at a later site (line 13 names `Tree t: String` again).
Tree: union { leaf: t node: String } as {
    t: anyval.generic
}

main: function is {
    ys: List i64
    a: (Tree t: String).node "s".string
    b: Tree.leaf "x".string
    print "\{ys.length}"
}
