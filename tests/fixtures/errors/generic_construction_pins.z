# E0200: a construction of a generic class keeps the source of its borrowed field
# locked, as the same construction of a non-generic class does, in each spelling:
# inferred, applied, wrapped, through a written `outx this` create, a `.view`
# field, and through another unit. Each dropped `b` while `p` still pointed into
# it and read the freed Bag.
Bag: class {
    name: String
}

Peeker: class {
    target: Bag.borrow
    tag: t
} as {
    t: anyval.generic
}

Viewer: class {
    target: Bag.view
    tag: t
} as {
    t: anyval.generic
}

Keeper: class {
    target: Bag.borrow
    tag: t
} as {
    t: anyval.generic
    create: function {target: Bag.borrow tag: t} outx this is {
        return (meta.create :target :tag)
    }
}

inferred: function is {
    b: Bag name: "inferred".string
    p: Peeker target: b tag: 2.i64
    b.drop
    print "\{p.target.name} \{p.tag}"
}

applied: function is {
    b: Bag name: "applied".string
    p: Peeker t: i64 target: b tag: 2
    b.drop
    print "\{p.target.name} \{p.tag}"
}

wrapped: function is {
    b: Bag name: "wrapped".string
    p: (Peeker t: i64) target: b tag: 2
    b.drop
    print "\{p.target.name} \{p.tag}"
}

written: function is {
    b: Bag name: "written".string
    p: Keeper target: b tag: 2.i64
    b.drop
    print "\{p.target.name} \{p.tag}"
}

viewed: function is {
    b: Bag name: "viewed".string
    p: Viewer target: b tag: 2.i64
    b.drop
    print "\{p.target.name} \{p.tag}"
}

crossUnit: function is {
    b: peek.Bag name: "cross".string
    p: peek.Peeker target: b tag: 2.i64
    b.drop
    print "\{p.target.name} \{p.tag}"
}

main: function is {
    inferred
    applied
    wrapped
    written
    viewed
    crossUnit
}
