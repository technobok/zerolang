# field_of_failed_constant.z -- a field declared by a constant takes the
# constant's type; when the constant's own definition fails, that is reported
# where it is written, and the field takes no type from it. A read of the field
# reports nothing further -- not "type 'LIMIT' is not printable", which named
# the constant as though it were a type.
LIMIT: i64.bogus

Box: record {
    v: LIMIT
    w: k
} as {
    k: u8.nope
}

main: function is {
    b: Box v: 3 w: 4
    x: b.v
    print "\{b.v} \{x} \{b.w}"
}
