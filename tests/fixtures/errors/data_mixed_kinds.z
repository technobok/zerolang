# A data block holds one kind of element: all integers, all floats, or all
# strings. A string among numbers, and an integer among floats -- a float block
# is written in floats -- are refused where the element is written.
mixed: data { 1 "two" 3 }
floats: data { 0.5 1 }

main: function is {
    print "\{mixed.length} \{floats.length}"
}
