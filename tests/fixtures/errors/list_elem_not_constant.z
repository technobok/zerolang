# A list element is any compile-time constant: one that has no value is refused
# where it is written. A call has a value only at run time, an arm among
# numbers is not of the list's one type, and an element that reads its own list
# is a cycle. Each was skipped with no value, and the emitter wrote whatever it
# made of the expression into the list's static initializer.
shade: variant { light: null dark: null }

pick: function out i64 is {
    return 3
}

calls: list { 1 (pick) }
arms: list { 1 shade.dark }
loops: list { 1 loops.0 }

main: function is {
    print "\{calls.get 1} \{arms.get 1} \{loops.get 1}"
}
