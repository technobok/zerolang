# E0023: `yield` is an ordinary name that the compiler defines into a
# generator body's scope, and nowhere else. In a function whose declared return
# does not reach the Iterator protocol nothing defines it, so it simply does
# not resolve -- the legality rule is a resolution fact, not a syntax check.
# The note and hint are what keep that from reading as a typo.
gen: function out i64 is {
    yield 1
    return 2
}

main: function is {
    print "v: \{gen}"
}
