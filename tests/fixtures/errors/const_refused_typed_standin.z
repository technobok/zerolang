# a refused constant stands in with its own type, so each use is not a second
# report of the same mistake. A conversion (`10.u64`) typed nothing in the
# stand-in walk, which then took the literal divisor's i64: every use below
# added "'i64' does not convert to 'u64' without loss".
wide: 10.u64 / 0
narrow: 10.u8 % 0

# scaled -- a u64 use of the u64 constant
scaled: function {x: u64} out u64 is { return x + wide }

# small -- a u8 use of the u8 constant
small: function {x: u8} out u8 is { return x + narrow }

main: function is {
    print "\{scaled x: 1} \{small x: 1}"
}
