# an instantiation argument that names nothing is reported where the
# instantiation is written (it used to reach the emitter as E0500).
mathops: unit as {
    t: anyval.generic
    first: function {a: t b: t} out t is { return a }
}

recs: (mathops t: Nope)

main: function is {
    print "\{recs.first a: 1 b: 2}"
}
