# E0100: a bound decides which types may instantiate, and nothing more. `Fig`
# admits Circ, so `edgeOf s: c` instantiates -- and that instance is refused,
# because Circ has no `edge`. The error points at the template's text and the
# note names the instance and the call that made it.
Sq: class { side: u64 } as {
    area: function {t: this.view} out u64 is { return t.side * t.side }
    edge: function {t: this.view} out u64 is { return t.side }
}
Circ: class { r: u64 } as {
    area: function {t: this.view} out u64 is { return t.r * t.r * 3 }
}
Fig: union { :Sq :Circ }
edgeOf: function as { T: Fig.generic } in {s: T} out u64 is { return s.edge }
main: function is {
    q: Sq side: 3
    c: Circ r: 1
    print "\{edgeOf s: q}"
    print "\{edgeOf s: c}"
}
