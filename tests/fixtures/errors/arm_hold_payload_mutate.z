# E0200: `hold` is the owned half of readonly, so a `.hold` arm freezes its
# payload's contents the same way.
Inner: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
}
U: union {
    some: Inner.hold
    none: null
}
main: function is {
    i: Inner n: 1
    u: U.some i.take
    match (
        u
    ) case some then {
        u.bump
        print "n=\{u.n}"
    } else null
}
