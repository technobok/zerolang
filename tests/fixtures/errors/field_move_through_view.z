# A field handed to a parameter that takes it is moved out of, which leaves the
# field empty: a write, and a `view` parameter may only be read.
keep: function {s: String.take n: i64} out i64 is {
    return s.length.i64.orPanic + n
}

Holder: class {
    p: String
}

look: function {h: Holder.view} out i64 is {
    return (keep s: h.p n: 1)
}

main: function is {
    h: Holder p: "abc".string
    print "\{look :h}"
}
