# A COPIED REFERENCE GOES ONLY WHERE ITS SIGNATURE DOES. Copying a function into
# an existing reference -- a reassignment, a field write, an argument -- needs
# the exact signature the slot was declared with.
seven: function out i64 is {
    return 7
}

# doubleFn -- a function reference with double's signature: the type, with no default
doubleFn: function {n: i64} out i64

double: function {n: i64} out i64 is {
    return n * 2
}

Hook: class {
    op: doubleFn
}

apply: function {f: doubleFn n: i64} out i64 is {
    return (f n: n)
}

main: function is {
    d: double.copy
    d = seven.copy
    h: Hook op: double.copy
    h.op = seven.copy
    print "\{apply f: seven.copy n: 1}"
}
