# A method called on the result of a call still checks that call: a name the
# inner call reads that nothing defines is an unknown reference, wherever the
# outer call stands. It used to pass the check and reach the emitter.

main: function is {
    a: (y.f n: 1).g 2
    b: (y.f n: 1).g
    print "\{(y.f n: 1).g 2} \{a} \{b}"
}
