# A template written in a generic unit takes the unit's parameters from the
# instance it is reached through, so an application names only its own. `t:`
# written inside `wrap t: i64` used to be dropped without a word: the type
# was `wrap`'s i64 copy whatever was written.
wrap: unit as {
    t: anyval.generic
    Cell: record {
        a: t
        b: u
    } as { u: anyval.generic }
    CF: (Cell t: f64 u: f64)
    mk: function {v: t} out t is {
        c: CF a: v b: 2.5
        return c.a
    }
}
wi: (wrap t: i64)

main: function is { print "\{wi.mk v: 5}" }
