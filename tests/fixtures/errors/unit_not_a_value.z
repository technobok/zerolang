# E0100: a unit is a namespace, not a value -- an instance written in place
# and an instance's binding are refused as a binding's value alike.
mathops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
}
intmath: (mathops t: i64)
main: function is {
    x: (mathops t: i64)
    y: intmath
    print "done"
}
