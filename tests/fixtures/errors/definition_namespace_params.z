# A definition's parameters and its `as` members are one namespace: a value
# parameter may not take a generic parameter's name. `in { k: k }` was
# accepted, the value shadowed the type, and the call reached the emitter.
f: function as { k: anyval.generic } in { k: k } out u64 is {
    return 1
}

main: function is {
    print "\{f k: 1}"
}
