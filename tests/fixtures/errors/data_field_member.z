# E0100: a data field holds a static value. A String, a StringView, a record, a
# class, a variant whose arm carries a value and a runtime collection are each
# refused; a StringView field with the hint that a data field's string is text.
pt: record { x: u8 }
Box: class { v: u8 }
opt: variant { some: u8 none: null }

row: data {
    s: String
    v: StringView
    p: pt
    c: Box
    o: opt
    l: ListVal u8
}

main: function is {
    print "x"
}
