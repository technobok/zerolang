# A local bound from an `if` or a `match` whose arm yields an element a call
# hands back is a second name for that element, as `r: l.get i: 0` is: it
# locks the list, so a write that could free the element is refused while the
# local lives -- through a `match`, and through a nested `if`, alike.
Mode: variant {
    a: null
    b: null
}

viaIf: function {l: (List String) c: bool} out u64 is {
    r: if c then (l.get i: 0) else (l.get i: 1)
    old: l.set i: 0 val: "replaced".string
    old.drop
    return r.length
}

viaMatch: function {l: (List String) m: Mode} out u64 is {
    r: match (m) case a then (l.get i: 0) case b then "made".string
    old: l.set i: 0 val: "replaced".string
    old.drop
    return r.length
}

nested: function {l: (List String) c: bool d: bool} out u64 is {
    r: if c then (if d then (l.get i: 0) else (l.get i: 1)) else (l.get i: 1)
    old: l.set i: 0 val: "replaced".string
    old.drop
    return r.length
}

main: function is {
    l: List String
    l.append from: "e0".string
    l.append from: "e11".string
    print "\{viaIf :l c: true} \{viaMatch :l m: Mode.a} \{nested :l c: true d: true}"
}
