# a binding of a value-type `getMut` result names the element in place: it is
# written through its fields, and the whole element is replaced with the
# list's `set`.
main: function is {
    xs: ListVal i64
    xs.append 1
    {
        v: xs.getMut i: 0
        v = v + 41
    }
    xs.set i: 0 val: 42
    print "\{xs.get i: 0}"
}
