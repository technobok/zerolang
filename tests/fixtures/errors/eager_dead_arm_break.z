# eager_dead_arm_break -- A `break` in an arm the fold rules out, walked only under
# --eager, leaves nothing: the endless loop it stands in still never exits.
shape: choice {
    circle: i64
    square: i64
    dot: null
}
SH: (shape.square 4)
f: function out i64 is {
    n: 0
    for true loop {
        n = n + 1
        match SH case circle then break case square then {
            if n > 3 then return n
        } case dot then break
    }
}
main: function is {
    print "\{f}"
}

# an error of its own, so the fixture is one the compiler refuses: every other
# definition is still checked under --eager, and must report nothing more
refused: function is {
    print "\{nosuchname}"
}
