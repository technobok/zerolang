# private_narrow_take_field.z -- a `.private.take` field is refused (E0022): the handle it
# would hold is a reference.
Bag: class { a: i64 } as {
    public: unit { :lend }
    lend: function {:this} out i64 is { return (friend h: this.private) }
}

Holder: class { h: Bag.private.take } as {
    get: function {this: this.view} out i64 is { return this.h.a }
}

friend: function {h: Bag.private.borrow} out i64 is {
    hd: (Holder h: h.private)
    return hd.get
}

main: function is {
    b: (Bag a: 5)
    print "\{b.lend}"
}
