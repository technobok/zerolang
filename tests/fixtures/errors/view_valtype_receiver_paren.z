# E0200: the parenthesised value-position legs -- a bound `(p.poke)` and one
# read in a condition -- resolve the same receiver and take the same lock.
point: record {
    x: i64
} as {
    poke: function {:this} out bool is {
        this.x = this.x + 1
        return true
    }
}
reader: function {p: point.view} out i64 is {
    b: (p.poke)
    if (p.poke) then return 1
    if b then return 2
    return 0
}
main: function is {
    q: point x: 1
    r: reader p: q
    print "\{r} \{q.x}"
}
