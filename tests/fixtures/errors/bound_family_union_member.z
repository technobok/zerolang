# A union bound admits reference types only, so a value-type member is one no
# argument can satisfy it through: the bound is refused where it is spelled,
# naming the member, even when the argument given is a reference type. The
# union itself stays legal as a type.
Choice: union { num: i64 text: String nothing: null }

pick: function as { T: Choice.generic } in { v: T.view } is {
    print "picked"
}

main: function is {
    c: Choice.text "s".string
    if c.text then print "text"
    pick v: "s".string
}
