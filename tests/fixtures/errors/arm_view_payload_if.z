# E0200: the same rule under if-narrowing -- an arm predicate shadows the
# subject to the payload exactly as a match arm does.
Inner: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
}
U: union {
    some: Inner.view
    none: null
}
main: function is {
    i: Inner n: 1
    u: U.some i
    if u.some then {
        u.bump
        print "n=\{u.n}"
    }
}
