# A REASSIGNMENT OR A SWAP WRITES TO STORAGE: a variable, or a field reached
# through one. None of the targets below names storage -- a call, a literal, a
# unit constant, a type, a function, a method leaf, a method in the middle of a
# path -- and each was accepted: C refused most of them ("lvalue required"),
# and `xs.length = 3` compiled and overwrote the list's length.
LIMIT: 5

g: function {n: i64} out i64 is {
    return n
}

h: function out i64 is {
    return 7
}

pt: record {
    x: i64
    y: i64
    first: function {:this} out i64 is {
        return this.x
    }
}

holder: record {
    p: pt
    corner: function {:this} out pt is {
        return this.p
    }
}

main: function is {
    a: 1
    p: pt x: 1 y: 2
    q: holder p: (pt x: 3 y: 4)
    xs: ListVal i64
    (g n: 1) = a
    3 = a
    LIMIT = a
    i64 = a
    h = a
    p.first = a
    q.corner.x = a
    xs.length = 3
    a swap (g n: 1)
    a swap 3
    a swap LIMIT
    a swap h
    a swap p.first
    print "\{a} \{p.x} \{q.p.x} \{xs.length}"
}
