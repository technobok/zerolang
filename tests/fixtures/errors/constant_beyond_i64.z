# a unit constant outside i64 is a value, untyped and exact, and the
# definition stands; each USE settles it where it lands. A u64 slot takes MAXU
# and TYPED; EDGE and HEX interpolated land in i64, which cannot hold them.
# (Before constants were exact, all four definitions were refused: the
# evaluator held an i64 and a definition without a value was spelled as its
# type.)
MAXU: 18446744073709551615
EDGE: 9223372036854775808
TYPED: 18446744073709551615.u64
HEX: 0xFFFFFFFFFFFFFFFF
LOW: 9223372036854775807
main: function is {
    x: 5.u64
    x = MAXU
    print "\{x} \{EDGE} \{TYPED} \{HEX} \{LOW}"
}
