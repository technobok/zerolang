# the compile-time evaluator holds an i64, so a unit constant outside it has no
# value -- and a definition without one was spelled as its type (invalid C, or
# an emitter failure). Refused until constants are arbitrary precision.
MAXU: 18446744073709551615
EDGE: 9223372036854775808
TYPED: 18446744073709551615.u64
HEX: 0xFFFFFFFFFFFFFFFF
LOW: 9223372036854775807
main: function is {
    x: 5.u64
    x = MAXU
    print "\{x} \{EDGE} \{TYPED} \{HEX} \{LOW}"
}
