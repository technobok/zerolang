# E0100: a numeric generic parameter's singleton type named through an instance
# -- `(Box cap: 5).cap`, `B5.cap` with `B5: (Box cap: 5)`, a unit instance's
# `w3.n` -- types only a field or a local, as the bare name does. A parameter,
# a marked parameter, a return and a type argument so typed are each refused,
# naming the bound to take instead, and keep the bound, so their uses say
# nothing more. A field typed by the template's parameter through the template
# itself, outside it, is refused (E0600): only an instance has a value for it.
# A field so typed takes no argument: the construction sets it.
Box: class { used: u32 } as { cap: u32.generic }
B5: (Box cap: 5)
wrap: unit as { n: u32.generic }
w3: (wrap n: 3)

viaApp: function {x: (Box cap: 5).cap} out u32 is { return x }
viaAlias: function {x: B5.cap} out u32 is { return x }
viaUnit: function {x: w3.n} out u32 is { return x }
marked: function {x: B5.cap.hold} out u32 is { return x }
giveApp: function out (Box cap: 5).cap is { return (Box cap: 5).cap }
giveUnit: function out w3.n is { return w3.n }

Holder: class {
    items: (ListVal t: B5.cap)
    used: u32
}
Loose: class {
    k: Box.cap
}
Fixed: class {
    k: B5.cap
    used: u32
}

main: function is {
    print "\{viaApp x: 5} \{viaAlias x: 5} \{viaUnit x: 3} \{marked x: 5}"
    print "\{giveApp} \{giveUnit}"
    h: Holder used: 1 items: (ListVal t: u32)
    l: (ListVal t: B5.cap)
    print "\{h.used} \{l.length}"
    f: Fixed used: 1 k: 5
    print "\{f.used}"
    print "\{(Loose k: 1).k}"
}
