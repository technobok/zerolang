# A call that already passes an owner cannot have a later argument move a field
# out of it: the callee would hold the owner beside the moved value. The words
# are those a name the call passes gets when an argument moves it.
Inner: class {
    p: String
}

Holder: class {
    p: String
    q: String
    inner: Inner
} as {
    useWith: function {:this s: String.take} out u64 is {
        return s.length + this.p.length
    }
    peekWith: function {this: this.view s: String.take} out u64 is {
        return s.length + this.p.length
    }
}

both: function {s: String.take h: Holder} out u64 is {
    return s.length + h.p.length
}

bothView: function {s: String.take h: Holder.view} out u64 is {
    return s.length + h.p.length
}

bothTaken: function {s: String.take h: Holder.take} out u64 is {
    return s.length + h.p.length
}

bothInner: function {s: String.take i: Inner} out u64 is {
    return s.length + i.p.length
}

two: function {s: String.take t: String.take} out u64 is {
    return s.length + t.length
}

withLength: function {s: String.take n: u64} out u64 is {
    return s.length + n
}

withText: function {s: String.take t: String} out u64 is {
    return s.length + t.length
}

ownerFirst: function {h: Holder s: String.take} out u64 is {
    return s.length + h.p.length
}

keep: function {s: String.take} out u64 is {
    return s.length
}

outer: function {h: Holder n: u64} out u64 is {
    return h.p.length + n
}

mk: function {} out Holder is {
    return (Holder p: "abc".string q: "de".string inner: (Inner p: "in".string))
}

sameCall: function is {
    h: mk
    print "\{ownerFirst h: h s: h.p}"
}

enclosingCall: function is {
    h: mk
    print "\{outer h: h n: (keep s: h.p)}"
}

main: function is {
    sameCall
    enclosingCall
}
