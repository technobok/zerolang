# conform_param_type.z -- a conformer whose parameter has another type than the spec's.
Shape: protocol {
    area: function {t: this.view scale: u64} out u64
}

Sq: class { side: u64 } as {
    :Shape
    area: function {t: this.view scale: u32} out u64 is { return t.side * t.side * scale.u64 }
}

main: function is {
    s: Sq side: 2
    print "\{s.side}"
}
