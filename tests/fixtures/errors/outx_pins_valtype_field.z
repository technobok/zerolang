# E0200: a valtype FIELD passed by pointer to an `outx` parameter stays locked
# while the result lives; a sibling field stays writable.
headView: function {s: (str to: 8).view} outx StringView is {
    return s.stringView
}

box: record {
    s: (str to: 8)
    n: i64
}

main: function is {
    b: box s: ("abc".str to: 8) n: 1
    v: headView s: b.s
    b.n = 2
    b.s = "zzz".str to: 8
    print "\{v} \{b.n}"
}
