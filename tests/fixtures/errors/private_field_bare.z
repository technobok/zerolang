# private_field_bare.z -- a field holding a friend handle says which kind: a bare
# `.private` field is refused (E0100). It used to reach C.
Bag: class { a: i64 } as {
    public: unit { :lend }
    lend: function {:this} out i64 is { return (friend h: this.private) }
    bump: function {:this} is { this.a = this.a + 1 }
}

Holder: class { h: Bag.private } as {
    get: function {this: this.view} out i64 is { return this.h.a }
}

friend: function {h: Bag.private.borrow} out i64 is {
    hd: (Holder h: h.private)
    return hd.get
}

main: function is {
    b: (Bag a: 5)
    print "\{b.lend}"
}
