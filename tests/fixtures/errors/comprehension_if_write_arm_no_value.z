# comprehension_if_write_arm_no_value -- A loop in value position whose body ends on an
# `if` whose first arm ends on a write and whose else ends on a value.
num: function {k: i64} out i64 is {
    return k + 1
}

main: function is {
    ys: ListVal i64
    ys.append 1
    ys.append 5
    n: 0
    xs: for each y: ys loop {
        if y > 2 then {
            n = n + 1
        } else {
            num k: 0
        }
    }
    print "\{n}"
}
