# A numeric generic parameter is not storage, read through a record value as
# through a class one. With the synthesised record field gone, the write reached
# the C as an assignment to the argument's literal; before, it wrote the copy.
rec: record {
    x: i64
} as { cap: u32.generic }

main: function is {
    r: (rec cap: 8) x: 1
    r.cap = 5
    print "\{r.x}"
}
