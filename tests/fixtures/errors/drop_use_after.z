# E0200: `.drop` ends a lifetime, so the name is gone afterwards -- for every
# family. The docs say a valtype drop has no runtime effect and only invalidates
# the name; nothing pinned the invalidation, and the eight existing
# after-ownership-transfer fixtures all use `.take`.
point: record {
    x: i64
    y: i64
}

shade: variant {
    red: null
    blue: null
}

Crate: class { label: String }

main: function is {
    p: point x: 1 y: 2
    p.drop
    print "\{p.x}"

    n: 7
    n.drop
    print "\{n}"

    s: shade.red
    s.drop
    print "\{s.red}"

    h: Crate label: "z".string
    h.drop
    print "\{h.label}"
}
