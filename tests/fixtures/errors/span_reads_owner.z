# span_reads_owner.z -- a window borrows its list EXCLUSIVELY: while it lives the
# list can be neither read nor written, since the window writes the storage a
# read would see.

main: function is {
    xs: ListVal u64
    xs.append from: 1
    w: xs.mutView
    n: xs.length
    w.set i: 0 item: n
}
