# generic_fnptr_field.z -- a function written in an `is` section is a field, and
# each instance holds one function of one type, so it cannot declare type
# parameters of its own. It once passed the checker and stopped the emitter ("a
# function type spelled after its typedefs were written"). In the `as` section
# the same function is a method.
Box: class {
    name: String
    cut: function as { T: StringLike.generic } in {t: this.view p: T.view} out u64 is {
        return t.name.length
    }
}

pt: record {
    x: u64
    pick: function as { t: anyval.generic } in {a: t b: t} out t is {
        return a
    }
}

main: function is {
    b: Box name: "abc".string
    print "\{b.cut p: "x"}"
    p: pt x: 1
    print "\{p.x}"
}
