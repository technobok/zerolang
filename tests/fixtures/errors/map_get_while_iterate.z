# E0200: an iterator holds its container exclusively for its lifetime, so no
# other reference to it may exist while the loop runs -- `get` returns a
# reference into the map's storage. To read the map while walking it, iterate
# a snapshot of the keys.
main: function is {
    m: (Map String value: String)
    m.set key: "a".string value: "x".string
    m.set key: "b".string value: "y".string
    with it: m.iterate do for k: it loop {
        v: m.get key: k.copy
        match (
            v
        ) case some then {
            print "k=\{k} v=\{v}"
        } case none then {
            print "k=\{k} missing"
        }
    }
}
