# A generic function's parameter that no argument is declared over, and that
# the call does not write, cannot be inferred. The call was accepted with no
# instance behind it and reached the emitter ("unhandled binding type"). A
# parameter declared over it whose argument is missing, or an argument that
# did not type, reports that instead.
mk: function as { T: anyval.generic } in { n: u64 } out u64 is {
    return n
}

pair: function as { K: anyval.generic V: AnyRef.generic } in { k: K } out u64 is {
    return 1
}

main: function is {
    r: mk n: 5
    print "\{r}"
    print "\{pair k: 1}"
    print "\{mk T: u8 n: 6}"
}
