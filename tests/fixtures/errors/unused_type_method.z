# unused_type_method.z -- a method body is checked because something reached the
# type. This fixture used to assert the opposite -- that a type NOTHING
# references is checked anyway, by the completion sweep -- and that is the
# assertion the demand root reversed: a definition the program cannot reach is
# not the compiler's to spend time on. `main` reaches this one.
Unused: class {
    n: i64
} as {
    badbody: function {:this} out i64 is {
        return true + 1
    }
}

main: function is {
    u: Unused.create n: 1
    print "ok \{u.badbody}"
}
