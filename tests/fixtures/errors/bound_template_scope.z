# A bound is read where it is WRITTEN, in the template's scope: `twice` takes
# x's own `wide`, which admits i64 and u8, so an i32 is refused however the
# call is spelled. The bound was looked up from the CALL's scope, where main
# sees the file unit's `wide`, which admits i32.
wide: variant { :i64  :i32 }

x: unit {
    wide: variant { :i64  :u8 }

    twice: function as { t: wide.generic } in {v: t} out t is {
        return v + v
    }
}

main: function is {
    print "\{x.twice v: 3.i32}"
}
