# A literal type is compile-time only: written as a type argument it would be
# the declared type of what an instance holds at run time -- a list's
# element, a record's field, a function's parameter -- and is refused there.
# Accepted, a float literal landed in it as an integer: `2.5` was stored as 2.
g: function {x: n y: n} out n as { n: anynumber.generic } is {
    return x + y
}

Box1: record {
    v: n
} as {
    n: anynumber.generic
}

main: function is {
    xs: ListVal t: intliteral
    xs.append 2.5
    b: Box1 n: intliteral v: 2.5
    print "\{xs.get i: 0} \{g n: intliteral x: 1 y: 2.5} \{b.v}"
}
