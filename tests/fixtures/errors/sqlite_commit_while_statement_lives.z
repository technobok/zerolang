# A Statement prepared on a Transaction pins it, so committing while the
# statement lives is refused: let the statement go first.
main: function is {
    db: sqlite.openMemory
    if db.err then return
    with tx: db.transaction do {
        if tx.err then return
        q: tx.prepare sql: "select 1"
        c: tx.commit
        if q.ok then print "\{q.columnCount}"
    }
}
