# view_result_writer_receiver.z -- a `.view` result is read-only wherever it
# lands: a method that writes its receiver cannot be called straight on one,
# as it cannot through a name bound to one. `get` answers `T.view`.

# Shelf -- hands out a view of its list
Shelf: class {
    # what it holds
    xs: ListVal i64
} as {
    # the list, to read
    peek: function {t: this.view} outx (ListVal i64).view is {
        return t.xs
    }
}

main: function is {
    xs: List (ListVal i64)
    xs.append (ListVal i64)
    (xs.get i: 0).append 1
    s: Shelf xs: (ListVal i64)
    s.peek.append 2
}
