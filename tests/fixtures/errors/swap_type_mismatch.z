# THE TWO SIDES OF A SWAP HOLD THE SAME TYPE. There is no source and destination
# to convert between -- each side receives the other's value -- so numeric
# coercion does not apply: `i64 swap i32` compiled, ran, and silently narrowed.
# A string against an integer and a record against a class reached C that no
# compiler accepts.
pt: record {
    x: i64
    y: i64
}

Box: class {
    s: String
}

main: function is {
    a: 1
    s: "x"
    a swap s
    b: 2.i32
    a swap b
    p: pt x: 1 y: 2
    bx: Box s: "q".string
    p swap bx
    print "\{a} \{b} \{p.x} \{bx.s}"
}
