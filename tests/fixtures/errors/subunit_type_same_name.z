# a member's types are the OWNER's: `rem.grab` takes rem's `point`, and this
# unit's own `point` is a different type however the two are spelled. The
# report names the unit each type is declared in -- both read `point` before,
# and an instance over each reads `ListVal_point` twice.
point: record {
    x: i64
    y: i64
    z: i64
}
main: function is {
    l: point x: 1 y: 2 z: 3
    ps: ListVal point
    ps.append from: l
    print "\{rem.grab p: l} \{rem.count ps: ps}"
}
