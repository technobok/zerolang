# conform_instance_return.z -- a marker on a generic type is a promise for
# EVERY instance, and each instance is checked against the spec with its own
# substituted methods. `get` returns `t`, which is the spec's i64 only when t
# is i64: Box_i64 conforms and Box_u8 does not. The failure is reported at the
# template's marker -- the promise that failed -- and the note names the
# instance and the construction that made it.
Getter: protocol {
    get: function {t: this.view} out i64
}
Box: class {
    v: t
} as {
    t: anyval.generic
    :Getter
    get: function {t: this.view} out t is {
        return t.v
    }
}
use: function {g: Getter} out i64 is {
    return g.get
}
main: function is {
    a: Box v: 7
    b: Box v: 7.u8
    print "\{use g: a} \{b.get}"
}
