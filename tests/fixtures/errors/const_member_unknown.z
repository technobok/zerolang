# A member read on a unit-level constant is the member a body finds on the
# value's type: a name the type does not declare is refused, whatever the
# constant's kind -- an arm predicate on it is no `false`, and a folded `none`
# answers nothing for it either.
color: choice {
    red: null
    green: null
}
pt: data {
    x: i64
}
rid: typedef u32
S: "abc"
C: color.red
P: (pt x: 1)
N: 5
NONE: rid 0
L: list {1 2 3}
NoArm: C.blue
NoneMember: (S.byteAt 9).foo
NoField: P.zork
NoNumMember: N.zork
NoTypedefMember: NONE.zork
GetWithoutIndex: L.get
main: function is {
    print "unreached"
}
