# E0600: a unit constant's typed argument binds a generic parameter as its own
# type, as a body's does: `7.u8` meets `small`, so the only refusal is that a
# user function has no compile-time value. The unit level judged every integer
# as i64 and refused the bound, naming a type the argument does not have.
small: variant { :intliteral :u8 }

# same -- the value it is given, of any type `small` admits
same: function as { t: small.generic } in {x: t} out t is {
    return x
}

C: (same x: 7.u8)

main: function is {
    print "\{C}"
}
