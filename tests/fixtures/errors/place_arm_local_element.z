# An arm may not yield an element of a list it declared itself: the list dies
# as the arm ends, and the local bound from the `if` would name freed storage.
own: function {c: bool} out u64 is {
    r: if c then {
        t: List String
        t.append from: "inner".string
        t.get i: 0
    } else "made".string
    return r.length
}

main: function is {
    print "\{own c: true}"
}
