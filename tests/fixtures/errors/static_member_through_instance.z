# A TYPE'S STATIC MEMBERS BELONG TO THE TYPE. A function declared with no
# receiver -- a shared function of the `as` section, or `create` -- is reached
# through the type, never through an instance. Through an instance the call
# dropped the instance on the floor (`p.helper n: 3` ran as `T.helper n: 3`), and
# `create` on a value was silently accepted or reached the emitter.
Gauge: class {
    level: i64
} as {
    helper: function {n: i64} out i64 is {
        return n + 1
    }
    zero: function out i64 is {
        return 0
    }
}

main: function is {
    g: Gauge level: 5
    xs: ListVal i64
    s: "text".string
    n: 4
    a: g.helper n: 3
    b: g.zero
    c: g.zero.take
    d: g.create level: 2
    e: xs.create
    f: s.create
    h: n.create
    print "\{a} \{b}"
}
