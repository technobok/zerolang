# `is native` IS the is-clause: it says the RUNTIME supplies the body. An
# is-block says the body is written here. A definition has one or the other,
# never both -- a second is-clause is not a body the reader can act on.
tri: variant is native { lo: null  mid: null }

main: function is {
    t: tri.lo
    match (t) case lo then print "lo" case mid then print "mid"
}
