# A literal type is an argument of a data block's `out` only: a parameter may
# not name one. And an untyped block is an `intdata i64` as a value, not an
# `intdata u8`: one static array per block.
f: function {c: (list intliteral)} out u64 is {
    return c.length
}

blk: list { 1 2 }

g: function {c: list u8} out u64 is {
    return c.length
}

main: function is {
    print "\{f c: blk} \{g c: blk}"
}
