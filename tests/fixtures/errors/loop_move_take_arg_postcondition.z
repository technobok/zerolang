eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
nope: function out bool is {
    return false
}
# a do-while postcondition runs after every iteration.
main: function is {
    p: (ListVal u32)
    p.append 1
    k: 0
    for loop {
        k = k + 1
    } while (eat xs: p)
    print "\{k}"
}
