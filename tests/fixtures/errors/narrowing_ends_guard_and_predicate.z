# EVERY FORM OF NARROWING ENDS AT A WRITE THAT CAN REACH IT. An `if o.some`
# branch and the rest of a scope after a diverging `if o.none then return` both
# narrow the bare name to the payload; a conditional write inside either left
# the narrowing standing, and the payload read after it was accepted.
U: union {
    some: String
    none: null
}

inpredicate: function {o: U.take flip: bool} is {
    if o.some then {
        if flip then {
            o = U.none
        }
        n: o.length
        print "\{n}"
    }
}

afterguard: function {o: U.take flip: bool} is {
    if o.none then return
    if flip then {
        o = U.none
    }
    n: o.length
    print "\{n}"
}

main: function is {
    inpredicate o: (U.some "a".string) flip: true
    afterguard o: (U.some "b".string) flip: true
}
