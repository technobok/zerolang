# A callee takes arguments only if it is a function, a type, or a value whose
# type declares `call`. Each callee below is a value -- a number, a unit
# constant, a string, a conversion of a literal, the result of a call -- and
# each call was run with its arguments dropped or reached the emitter as a
# callee it could not spell. A function that declares no parameters takes no
# labelled argument either. value_called_with_arguments.z covers locals, fields
# and predicates.
LIMIT: 4

five: function out i64 is {
    return 5
}

add: function {a: i64 b: i64} out i64 is {
    return a + b
}

numberCallee: function is {
    x: 1 y: 2
    print "\{x}"
}

floatCallee: function is {
    x: 1.5 y: 2
    print "\{x}"
}

constantCallee: function is {
    x: LIMIT y: 2
    print "\{x}"
}

stringCallee: function is {
    x: "a" y: 2
    print "\{x}"
}

conversionCallee: function is {
    x: 5.u8 y: 2
    print "\{x}"
}

callResultCallee: function is {
    x: (add a: 1 b: 2) y: 2
    print "\{x}"
}

noParameters: function is {
    five y: 2
}

main: function is {
    numberCallee
    floatCallee
    constantCallee
    stringCallee
    conversionCallee
    callResultCallee
    noParameters
}
