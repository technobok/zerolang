# E0200: a valtype bound to a `.borrow` or `.view` parameter goes by pointer,
# so it aliases its source as a reftype argument does -- the same value may
# not be passed twice where either side can write.
point: record { x: i64 } as {
    addFrom: function {:this o: point.view} is { this.x = this.x + o.x }
}
pair: record { l: point r: point }

twoB: function {a: point.borrow b: point.borrow} is {
    a.x = a.x + 1
    b.x = b.x * 10
}
bv: function {a: point.borrow b: point.view} out i64 is {
    a.x = 100
    return b.x
}

main: function is {
    q: point x: 1
    # two `.borrow`s of one value
    twoB a: q b: q
    # a `.borrow` beside a `.view`: the view would see the write
    print "\{bv a: q b: q}"
    # a mutating receiver with a `.view` of itself
    q.addFrom o: q
    # the same field twice
    p: pair l: (point x: 1) r: (point x: 2)
    twoB a: p.l b: p.l
    print "\{q.x} \{p.l.x}"
}
