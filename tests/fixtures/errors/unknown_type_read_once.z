# unknown_type_read_once.z -- a type-ref naming nothing is reported once, where
# it is written. What it types -- a field, a parameter, a return -- is read as
# having no type, so no use of it adds a report of its own: not printing it,
# not adding it to a string, not binding a call's result. A construction that
# leaves the field out is still refused: that is a mistake of its own.

Point: record {
    x: i64
    o: NoSuchType
} as {
    show: function {this: Point.view a: NoSuchType} is {
        print "\{a} \{this.o}"
    }
}

made: function out NoSuchType is {
    return 1
}

main: function is {
    p: Point x: 1 o: 2
    print "\{p.o}"
    v: p.o
    print "\{v}"
    s: "a" + p.o
    p.show a: 3
    m: made
    print "\{m}"
    q: Point x: 1
    print "\{q.x}"
}
