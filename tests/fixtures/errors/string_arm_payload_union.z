# A union arm declared by a string literal is refused as a variant arm is
# (`string_arm_payload.z`), and the message names the ARM.
#
# It named nothing: `arm '' is declared by a string literal`, and the hint
# offered `: String`. The union path passed the PAYLOAD's name to the message
# -- and a string literal has none -- where the variant path passed the arm's.
u: union {
    one: "x"
    two: i64
}

main: function is {
    a: u.two 5
    print "made"
}
