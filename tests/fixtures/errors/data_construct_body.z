# E0300: a data value is built only in a static position -- at unit level, as a
# type constant, or inside another data value -- so each body spelling of a
# construction is refused: with arguments, in parentheses, `.create` with and
# without arguments, and the bare name.
row: data { v: 3.u8 }

main: function is {
    a: row v: 1
    b: (row v: 2)
    c: row.create
    d: row
    e: row.create v: 4
    print "x"
}
