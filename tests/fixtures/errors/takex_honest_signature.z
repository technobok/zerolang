# E0200: a constructor that hands back an owned instance holding a reference
# INTO one of its arguments must say `.takex` on the return.
#
# `W` has a non-owned field, so a `W` is only sound while whatever `s` points at
# outlives it. With a bare `out this` nothing pins the source: the caller is free
# to drop or mutate `a` while `w` still points at it. `out this.takex` is the
# signature that states the obligation, and the pin follows from it.
#
# This is the rule `.lock` on the PARAMETER used to enforce by accident, back
# when a `.lock` argument transferred its lock to the return. Losing that was the
# reason `takex` had to exist before `.lock` could retire; this check is what
# stops a signature quietly going back to the unpinned form.
#
# `takex_marker.z` is the accepted counterpart.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
} as {
    create: function {from: Src.borrow} out this is {
        return (meta.create s: from tag: 9)
    }
}

main: function is {
    a: Src n: 1
    w: W.create from: a
    print "\{w.tag}"
}
