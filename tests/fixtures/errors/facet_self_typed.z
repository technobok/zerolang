# E0300: `type` inside an interface is the INTERFACE, so a member that names it
# in a parameter asks for a conformer-to-conformer call. A vtable slot cannot
# carry one -- it would have to name a single implementation's argument, and
# there may be many -- so such a member has no slot and no wrapper, and
# reaching for it through the interface is refused here rather than by the C
# compiler two stages later.
#
# Both call forms are refused, because an operator is the call form for a
# one-argument method: `near` is a named method and `==` is spelled `rhs: type`
# the way every operator is.
sim: facet {
    near: function {:this rhs: type} out bool
    ==: function {:this rhs: type} out bool
}

pt: record {
    x: u64
} as {
    m: sim
    near: function {p: this rhs: pt} out bool is {
        return p.x == rhs.x
    }
    ==: function {p: this rhs: pt} out bool is {
        return p.x == rhs.x
    }
}

main: function is {
    a: pt x: 3
    f: sim.create from: a
    print "\{f.near rhs: a}"
    print "\{f == a}"
}
