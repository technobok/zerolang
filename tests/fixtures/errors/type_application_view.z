# E0300: a borrowed view binds from an owner, whether it is named bare or through
# its type arguments.
main: function is {
    a: (ListView String)
    b: ListView String
    c: ListViewVal i64
    d: (ListViewVal t: i64)
    e: OptionView String
    print "\{a.length} \{b.length} \{c.length} \{d.length}"
}
