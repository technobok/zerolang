# infix_take_use_after_move.z -- a member that CONSUMES its argument, reached
# infix. `a op b` compiles as `a.op b`, so the argument gets the same ownership
# treatment either way and using the source afterwards is a move violation.
#
# The infix leg used to stamp only the operator's owner, method and result: it
# never ran stampArgDisposition, lockCallArg or argOwnershipOf, so this program
# COMPILED CLEAN and aborted with a double free at run time, while the dotted
# spelling was correctly refused. The refusal is the fix, and this pins it.
Sink: class {
    held: String
} as {
    put: function {:this item: String.take} out i64 is {
        this.held = item
        return 1
    }
}

main: function is {
    k: Sink held: "z".string
    s: "a".string
    n: k put s
    print "n=\{n} s=\{s} held=\{k.held}"
}
