# E0200: a binding narrowed to an Option's payload (`o: snap.st`) is a borrow
# of that field, so `snap` cannot be handed to a borrowing callee while it
# lives: `clear` replaces the field and frees the payload `o` still reads -- a
# segfault under SHARED borrows, reproduced under ASan.
T: class {
    s: String
}

R: class {
    st: Option T
}

clear: function {r: R} is {
    r.st = Option.none T
}

use: function {snap: R} is {
    o: snap.st
    match (
        o
    ) case some then {
        clear r: snap
        print "\{o.s}"
    } case none then null
}

main: function is {
    r: R st: (Option.some (T s: "a string long enough to live on the heap".string))
    use snap: r
}
