# alias_ring_across_units.z -- a ring of definitions through units' names is a
# ring like any other: `Here` names `there.There`, which names
# `alias_ring_across_units.Here`. It is reported as the definition being written
# in terms of itself, where it is written, as a bare ring is -- not as the
# compiler finding the other end still resolving.
Here: there.There

probe: function {x: Here} is {
    print "never"
}

main: function is {
    probe x: 1
}
