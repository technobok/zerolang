# A template's constant that reads a numeric generic parameter has a value only
# in an instance: read through the template itself it is refused. Refused at its
# definition before instances folded it; read through the template, it reached
# the C as the template's name.
Pair: record {
    x: i64
} as {
    n: u8.generic
    WIDTH: n + 1
}

sized: unit as {
    cap: i64.generic
    DOUBLE: cap * 2
    get: function {} out i64 is {
        return 1
    }
}

eight: (sized cap: 8)

main: function is {
    p: (Pair n: 9) x: 1
    print "\{Pair.WIDTH} \{sized.DOUBLE} \{p.x} \{eight.get}"
}
