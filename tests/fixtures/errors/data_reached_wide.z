# E0100: an untyped number keeps its full value in a data value, and lands in
# i64 only where the value is used at run time: the read that folds is fine, the
# value handed to a function is refused at that use.
row: data { big: intliteral }
huge: (row big: 99999999999999999999999)
folded: (row big: 99999999999999999999999)
show: function {r: row} is { print "\{r.big}" }
main: function is {
    print "\{folded.big / 100000000000000}"
    show r: huge
}
