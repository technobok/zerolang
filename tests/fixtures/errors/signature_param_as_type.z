# A FUNCTION'S PARAMETERS ARE IN SCOPE IN ITS OWN SIGNATURE: a type written
# there that names a parameter finds the parameter, which is no type -- a later
# parameter's type, the `out`, and a parameter typed by its own name alike. The
# `:nodeid` shorthand names the type as it is named outside the declaration,
# and the outer type is reached through its unit (signature_scope).
nodeid: record { v: u32 }

f: function {
    u8: i64
    m: u8
} out u8 is {
    return m
}

g: function {nodeid: nodeid} out u32 is { return nodeid.v }

Box: class { v: t } as {
    t: anyval.generic
    get: function {t: this.view} out t is { return t.v }
}

main: function is {
    print "checked under --eager"
}
