# control_value_outx_pins.z -- an `if`, a block and a `with` hand their value's
# pins to what binds it, as the value bound alone would: an `outx` result keeps
# its source locked. They were dropped at the arm's last line, so each binding
# here once outlived the String it views. A pin on storage the arm, block or
# `with` declared is refused: that storage dies first.
main: function is {
    s: "abc def".string
    c: s.length > 2
    a: if c then s.stringView.trim else s.stringView.substring from: 1 to: 3
    s = "replaced".string
    print a
    t: "abc def".string
    b: {
        t.stringView.stripPrefix p: "abc"
    }
    t = "replaced".string
    match b case some then print b case none then null
    u: "abc def".string
    d: {
        it: u.stringView.split sep: " "
        it.call
    }
    match d case some then print d case none then null
    e: with v: u.stringView do v.stripPrefix p: "abc"
    match e case some then print e case none then null
}
