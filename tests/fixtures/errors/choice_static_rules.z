# E0100: a choice value is copied by binding it and never moved, borrowed or
# freed, so a marker is refused; a bare choice name in a body is a sum built
# without an arm; and a choice value has no zero, so an array of one is refused.
form: choice {
    call: null
    count: u8
}

main: function is {
    f: form.call
    g: f.take
    z: form
    a: array form to: 2
    print "\{g.call}"
}
