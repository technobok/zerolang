# A type application names every parameter of the type. One that left a
# parameter out was accepted: the missing one stayed a parameter, the trie
# could not key the instance, and each application minted an instance of its
# own -- a parameter typed `(Either t: i64)` refused the `(Either t: i64)`
# built in a body with "expected Either_i64, got Either_i64". A one-parameter
# type takes its unlabelled argument, and so does a leading unlabelled one.
Either: union { pick: t other: e } as {
    t: anyval.generic
    e: anyval.generic
}

Two: class { a: t  b: u8 } as {
    t: anyval.generic
    e: anyval.generic
}

show: function {x: (Either t: i64)} is {
    if x.pick then print "pick \{x}"
}

main: function is {
    d: (Either t: i64).pick 1
    w: (Two t: i64) a: 1 b: 2
    ok: (Either i64 e: u8).pick 2
    show x: ok
    print "\{w.a}"
}
