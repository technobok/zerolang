# A type constant written as a construction whose head is a path: a root that
# names nothing is reported at the root, and a unit that declares no such member
# at the member, as a unit-level construction is. Nothing was said at either
# definition, and a read of the constant reported "type 'pt' has no member"
# instead. A read of a constant whose definition failed adds nothing; nor does a
# read of a constant that is not a compile-time value.
sch: unit {
    row: data { n: 0 }
}

pt: record { x: i64 } as {
    origin: (c.row n: 1)
    corner: (sch.rwo n: 2)
    go: function {} out i64 is {
        return 1
    }
    edge: go
}

main: function is {
    print "\{pt.origin.n}"
    print "\{pt.corner.n}"
    print "\{pt.edge}"
}
