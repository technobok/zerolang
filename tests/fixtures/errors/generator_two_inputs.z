# `call` receives AT MOST ONE value per call: the argument its call sites hand
# it, read through `yield`'s own value. A second parameter has nothing to fill
# it -- the receiver is supplied by the dot and the input by the call -- and was
# accepted in silence.
G: generator as {
    call: function {a: i64  b: i64} out i64 is {
        yield 1
    }
}

main: function is {
    print "x"
}
