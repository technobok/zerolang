# E0200: a mutating method takes an exclusive receiver lock, which a `view`
# parameter's readonly self-lock refuses. Reader methods still work.
Item: class {
    value: i64
} as {
    bump: function {:this} is { this.value = this.value + 1 }
}
peek: function {c: Item.view} is {
    c.bump
}
main: function is {
    e: Item value: 5
    peek c: e
    print "\{e.value}"
}
