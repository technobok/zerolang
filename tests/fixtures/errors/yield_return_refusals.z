# A binding named `yield` is the program's own name, read as any binding is,
# even before any loop or generator is checked and even when its value did
# not type: only that value is refused. A generator's body returns no value:
# what it produces comes from `yield`, as the refusal's note says.
G: generator as {
    call: function out String is {
        yield "a".string
        return "b".string
    }
}

main: function is {
    yield: nosuchName
    print "\{yield}"
    for each s: G loop print "\{s}"
}
