# E0029: the same rule in a `case` body. A case clause is still open -- more
# `case`s and an `else` may follow -- so a bare `if` here has the identical
# two-owner problem a `then` body does.
V: variant {
    x: null
    y: null
}

main: function is {
    v: V.x
    b: 5
    match v case x then if b > 3 then print "deep" case y then print "y"
    print "done"
}
