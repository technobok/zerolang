# E0600: an integer `/` or `%` whose divisor is a constant zero has no value at
# run time either, so it is refused though its dividend is not a constant. A
# float division by zero is IEEE's to answer and compiles.
Z: 0

quot: function {x: i64} out i64 is {
    return x / 0
}

rem: function {x: u8} out u8 is {
    return x % Z
}

ratio: function {x: f64} out f64 is {
    return x / 0.0
}

main: function is {
    print "\{quot x: 7} \{rem x: 7} \{ratio x: 1.0}"
}
