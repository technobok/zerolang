# E0100: a default that is refused is reported once, where it is written. The
# member it declares is still declared: a call or a construction that leaves it
# out is not missing an argument, and a read of it reports nothing further.
mode: variant { a: null b: null }
byMatch: function {x: match mode.a case zz then 1 else 2} is {
    print "\{x}"
}
byIf: function {x: if mode.zz then 1 else 2} is {
    print "\{x}"
}
byList: function {x: list { 1 2 }} is {
    print "\{x.length}"
}
row: record {
    m: match mode.a case zz then 1 else 2
    l: list { 1 }
}
main: function is {
    byMatch
    byIf
    byList
    r: row.create
    print "\{r.m} \{r.l.length}"
}
