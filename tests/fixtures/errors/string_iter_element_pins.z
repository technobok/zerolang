# string_iter_element_pins.z -- an element a Splitter or a LinesIter hands back
# views the iterated text, which the iterator keeps locked: the element keeps the
# iterator, as an element of a collection's iterator does.
main: function is {
    s: "a b".string
    it: s.stringView.split sep: " "
    a: it.call
    b: it.call
    match a case some then print a case none then null
    match b case some then print b case none then null
    t: "x\ny".string
    lit: t.stringView.lines
    l: lit.call
    lit = t.stringView.lines
    match l case some then print l case none then null
}
