# an instance of Box is made from its one value, as the template is: an
# argument other than `from:`, a value of another type, and no value at all
# are each refused once, whether the instance is named by an alias or by its
# own spelling.
point: record { x: i64 y: i64 }

BP: (Box point)

main: function is {
    a: BP x: 1 y: 2
    b: (Box point) x: 1 y: 2
    c: BP from: 5
    d: (Box point) from: 5
    e: BP
    f: (Box point)
    print "none"
}
