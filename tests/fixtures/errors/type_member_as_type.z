# THE NEAREST DECLARATION OF A NAME WINS IN A TYPE'S OWN SCOPE, whatever it
# is: a method, a field, an arm or an implementation written where a type is
# -- a return, a parameter, a field, a payload -- is refused as what it is, and
# no type of that spelling outside the type answers for it. The outer type is
# reached through its unit (type_member_qualified).
nodeid: record { v: u32 }

Getter: protocol {
    get: function {g: this.view} out i64
}

Row: class {
    :nodeid
    other: nodeid
} as {
    u8: function {r: this.view} out u8 is { return 1 }
    getter: Getter.implement
    get: function {r: this.view} out i64 is { return 2 }
    pick: function {r: this.view g: getter} out i64 is { return 3 }
}

Sum: union {
    u16: Box u16
    none: null
}

main: function is {
    print "checked under --eager"
}
