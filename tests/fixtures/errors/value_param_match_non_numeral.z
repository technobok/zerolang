# A compile-time match over a VALUE parameter dissects by value: each `case`
# names one, an integer numeral. A case that is no numeral could never match,
# and is refused (a case name is never looked up as a constant).
Box: class {
    used: u32
    which: function {:this} out StringView is {
        match cap case other then {
            return "other"
        } case 0 then {
            return "zero"
        } else {
            return "else"
        }
    }
} as { cap: u32.generic }

main: function is {
    b: (Box cap: 0) used: 0
    print "\{b.which}"
}
