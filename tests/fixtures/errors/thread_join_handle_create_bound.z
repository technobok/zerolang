# `thread.JoinHandle.create` starts a thread as `spawn` does: its `task`
# parameter is typed by `thread.Task`, a `thread.Crossing` protocol, so the
# task is checked there exactly as at `spawn`.

# Locker -- holds a lock guard
Locker: class {
    # the guard, which unlocks on the thread that locked
    g: sync.MutexGuard (ListVal i64)
} as {
    task: (thread.Task null)
    call: function {:this} is { print "started" }
}

main: function is {
    m: (sync.Mutex (ListVal i64)).create value: ListVal i64
    h: (thread.JoinHandle null).create task: (Locker g: m.lock) name: "" stackSize: 0.u64
}
