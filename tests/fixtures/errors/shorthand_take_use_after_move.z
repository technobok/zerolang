# E0200: a `:name` shorthand argument at a `.take` parameter transfers
# ownership exactly as the written-out `name: name` form does, so the
# source is gone afterwards and a later use is refused.
Box: class {
    n: u64
}

consume: function {b: Box.take} is {
    x: b.n
}

main: function is {
    b: Box n: 7
    consume :b
    print "\{b.n}"
}
