# One mistake, one error: what a refusal leaves behind is not refused again.
# A method read without its arguments leaves its binding without a type, so
# its uses say nothing more; a function named as the base of a member read is
# refused as a call, and the member is not looked up on the function; a data
# field whose type is refused is still the type's field, so a construction
# naming it is not refused for an unknown argument.
twice: function {n: i64} out i64 is { return n * 2 }
box: data {
    f: (optionval t: u64)
}
B: (box f: 3)
C: (box f: 4)
main: function is {
    k: 7
    v: k.compare
    print "\{v} \{v}"
    w: twice.zork
    print "\{w}"
}
