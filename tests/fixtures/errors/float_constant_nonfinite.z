# A FLOAT CONSTANT MUST BE FINITE: a division by a constant zero and a result
# beyond the type's range have no value a constant can hold, for a float as for
# an integer. Each folded to an infinity or a NaN and was emitted as `inf` or
# `-nan`, which is no C.
INF: 1.0 / 0.0
NAN: 0.0 / 0.0
HUGE: 1.0e308 * 10.0
NARROW: 1.7014118346046923e38.f32 * 4.0
ZERO: 1.0.f32 / 0.0

main: function is {
    print "\{INF} \{NAN} \{HUGE} \{NARROW} \{ZERO}"
}
