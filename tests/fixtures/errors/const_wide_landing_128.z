# an untyped integer past u128 lands in no 128-bit slot, and is refused there
# naming the destination and its whole range (gcc and clang: tcc has no
# __int128).
Huge: 340282366920938463463374607431768211456
Low: 0 - 170141183460469231731687303715884105729

# w -- a u128 parameter
w: function {v: u128} out u128 is { return v }

# s -- an i128 parameter
s: function {v: i128} out i128 is { return v }

main: function is {
    print "\{w v: Huge} \{s v: Low}"
}
