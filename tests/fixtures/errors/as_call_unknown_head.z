# An `as` item written as a call -- a constant expression, or a type
# application naming a conformance -- whose head names nothing. It was left a
# constant that never folds, and said nothing: a misspelled spec in a marker
# vanished, and a later read of the item reported a missing member instead.
Speaker: protocol {
    speak: function {t: this.view} out i64
}

Cell: class { n: i64 } as {
    g: (Speker v: i64)
    speak: function {t: this.view} out i64 is { return t.n }
}

pt: record { x: i64 } as {
    k: (nosuch a: 1)
}

Loud: protocol {
    shout: function {t: this.view} out i64
} as {
    w: (missing b: 2)
}

useLoud: function {l: Loud.view} out i64 is { return l.shout }

main: function is {
    c: Cell n: 1
    p: pt x: 2
    f: useLoud.take
    print "\{c.n} \{p.x}"
}
