# A view derived from a view -- a trim, a substring -- reads the first view's
# source, so it keeps that source locked for as long as it lives, as the first
# view does; and a view read out of a borrowed element keeps the container
# locked. A write to the source while such a view is live is refused. So is a
# function that returns a slice of its view parameter as `out`: the result
# keeps the argument locked, which only `outx` tells the caller.
head: function {p: StringView} out StringView is {
    return (p.substring from: 0 to: 1)
}

main: function is {
    s: " abc ".string
    t: s.stringView.trim
    s = "replaced".string
    print t

    l: List String
    l.append from: "abc".string
    v: (l.get i: 0).stringView
    l.set i: 0 val: "q".string
    print v

    print (head p: "abc")
}
