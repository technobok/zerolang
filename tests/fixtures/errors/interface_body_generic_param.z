# A protocol or a facet declares its generic parameters in its `as` block, as
# every type does; its body holds only its specs. A parameter written in the
# body is refused where it is written.
Getter: protocol {
    v: anyval.generic
    get: function {t: this.view} out v
}

Sized: facet {
    n: anyval.generic
    size: function {t: this.view} out n
}

useGetter: function {g: Getter.view} out i64 is { return 0 }

useSized: function {s: Sized} out i64 is { return 0 }

main: function is {
    g: useGetter.copy
    s: useSized.copy
    print "declared"
}
