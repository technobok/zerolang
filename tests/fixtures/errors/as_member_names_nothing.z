# A member whose value names nothing is reported once, at its definition, as
# the same name is in a body -- a type's `as` member and a nested unit's alias
# alike, read or not. A read of it added "has no member" of its own (a bare
# name), or was the only report (a path through a unit), or nothing was
# reported at all (an unread path whose root names nothing).
point: record {
    x: i64
} as {
    origin: nosuch
    corner: io.nosuch
    far: other.nosuch
}

u: unit {
    k: nosuch
    j: other.nosuch
}

main: function is {
    print "\{point.origin} \{point.corner} \{u.k} \{u.j}"
}
