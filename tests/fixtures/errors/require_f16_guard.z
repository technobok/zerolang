# require_f16_guard.z -- halffloat's `require:` block guards on the C compiler
# the way quadfloat's does, and this is the only program that isolates it:
# every other f16 user in the corpus also uses f128 or i128, so their output
# is whichever guards fire together. tcc has no _Float16 on Linux, and on
# macOS its headers define one as `short unsigned int` -- so the alternative
# to this message is not a parse error but a wrong answer.
main: function is {
    h: 1.5.f16
    print "\{h}"
}
