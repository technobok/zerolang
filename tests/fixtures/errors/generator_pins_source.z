# A generator's non-owned `is` field is a reference into whatever it was built
# with, so the generated `create` returns `this.takex` and the source stays
# pinned for the instance's lifetime. Moving it out from under a live generator
# leaves every later `.call` reading freed memory.
#
# The pin has to reach the CALLER's variable, not just the field: before it did,
# the same move was accepted and the second `.call` printed `0`.
Bag: class {
    a: i64
}

Walk: generator { b: Bag.borrow } as {
    call: function out i64 is {
        yield this.b.a
        yield this.b.a
    }
}

eat: function {victim: Bag.take} is {
    print "ate \{victim.a}"
}

main: function is {
    g: Bag a: 42
    with it: (Walk b: g) do {
        p: it.call
        match (p) case some then print "1: \{p}" case none then print "1: none"
        eat victim: g.take
        q: it.call
        match (q) case some then print "2: \{q}" case none then print "2: none"
    }
}
