# A path through fields alone (`g.inner.firstItem`) reads storage `g` holds: a
# view read off it keeps `g` locked, bound or passed on, and `g` cannot be
# written while the view lives.
Item: class {
    s: String
}

Bag: class {
    items: List Item
} as {
    firstItem: function {t: this.view} outx Item.view is {
        return (t.items.get i: 0)
    }
}

Wrap: class {
    inner: Bag
}

keep: function {v: Item.view} outx Item.view is {
    return v
}

direct: function is {
    g: Wrap inner: (Bag items: List Item)
    g.inner.items.append (Item s: "one".string)
    w: g.inner.firstItem
    g = Wrap inner: (Bag items: List Item)
    print w.s
}

hoisted: function is {
    g: Wrap inner: (Bag items: List Item)
    g.inner.items.append (Item s: "one".string)
    w: keep v: g.inner.firstItem
    g = Wrap inner: (Bag items: List Item)
    print w.s
}

main: function is {
    direct
    hoisted
}
