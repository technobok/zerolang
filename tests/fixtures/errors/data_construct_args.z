# E0300/E0100: a data value's arguments are checked as a construction's are --
# an unknown field, a missing one, a number out of its field's range, a value
# of another type (a typed StringView constant is no text), and a value that is
# not a constant.
mode: variant { fast: null slow: null }
other: variant { a: null b: null }
inner: data { v: u8 }
pair: data { k: text m: mode }
typedsv: list { a: "x" } out staticlist StringView

getv: function out u8 is { return 1 }

bad1: (inner w: 1)
bad3: (inner v: 300)
bad4: (pair k: typedsv.a m: mode.fast)
bad5: (pair k: "x" m: other.a)
bad6: (pair k: "x" m: (inner v: 1))
bad7: (inner v: getv)
bad8: inner.create

main: function is {
    print "x"
}
