# eager_dead_clause_break -- A clause a constant condition rules out decides nothing,
# also when --eager walks it: its `break` does not leave the loop, so the loop never
# exits and the function needs no return after it.
slow: false

count: function {n: i64} out i64 is {
    k: 0
    for loop {
        if slow then {
            break
        }
        k = k + 1
        if k > n then return k
    }
}

main: function is {
    print "\{count n: 3}"
}

# an error of its own, so the fixture is one the compiler refuses: every other
# definition is still checked under --eager, and must report nothing more
refused: function is {
    print "\{nosuchname}"
}
