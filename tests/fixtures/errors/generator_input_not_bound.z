# A generator `call`'s per-call input is no body binding: its parameter's name
# names nothing in the body, and `yield`'s value is the only way to the input.
Bag: class {
    x: i64
    tag: String
}

Peek: generator { n: i64 } as {
    call: function {bag: Bag.take} out i64 is {
        yield bag.x
        b: yield 2
        yield b.x
    }
}

main: function is {
    with p: (Peek n: 0) do {
        a: p.call bag: (Bag x: 1 tag: "one".string)
        match (a) case some then print "peek: \{a}" case none then print "peek: none"
    }
}
