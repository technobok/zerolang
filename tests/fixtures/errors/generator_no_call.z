# `call` IS the generator's body. Without one there is nothing to suspend and
# nothing to iterate, and the definition is an ordinary class wearing the
# keyword. It was accepted in silence: the program compiled and the generator
# simply did nothing.
G: generator { n: i64 } as {
    helper: function out i64 is {
        return 1
    }
}

main: function is {
    print "x"
}
