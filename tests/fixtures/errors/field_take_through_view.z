# `.take` on a field moves it out and leaves the field empty -- a write, which a
# readonly receiver refuses, whether the value is bound or passed.
Holder: class {
    p: String
} as {
    peek: function {t: this.view} out u64 is {
        x: t.p.take
        return x.length
    }
}

main: function is {
    h: Holder p: "abc".string
    print "\{h.peek}"
}
