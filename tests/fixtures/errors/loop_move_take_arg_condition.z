eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
nope: function out bool is {
    return false
}
# a loop CONDITION runs before every iteration: a move there reaches the
# next one unless the body always leaves the loop.
main: function is {
    e: (ListVal u32)
    e.append 1
    n: 0
    for while (eat xs: e) loop {
        n = n + 1
    }
    print "\{n}"
}
