# require_in_type.z -- `require:` states what a UNIT needs from the host
# toolchain, so a `require:` unit in a type's `as` block is refused (E0038)
# rather than read as a plain namespace that links nothing.

pt: record {x: i64} as {
    require: unit { library: "m" }
}

main: function is {
    p: pt x: 1
    print "\{p.x}"
}
