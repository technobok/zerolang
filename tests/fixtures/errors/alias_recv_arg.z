# E0200: one reftype cannot be both the receiver and an argument of the same
# call -- 'this' and the parameter would alias.
Item: class {
    v: i64
} as {
    poke: function {:this other: Item} is {
        print "\{this.v} \{other.v}"
    }
}
main: function is {
    r: Item v: 1
    r.poke other: r
}
