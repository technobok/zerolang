# E0300: a typedef is constructed from exactly its base type. The construction
# converts nothing, so a typed number of another width -- narrower or wider --
# is refused in every spelling, as is a typedef over the same base. A u64 given
# to a u32 typedef was cast and silently lost its high bits.
pid: record {
    val: u32.typedef
}

wide: record {
    val: u64.typedef
}

gid: record {
    val: u32.typedef
}

main: function is {
    big: 7.u64
    small: 8.u16
    a: pid big
    b: pid.create from: big
    c: wide small
    g: gid 3
    d: pid g
    print "\{a.u32} \{b.u32} \{c.u64} \{d.u32}"
}
