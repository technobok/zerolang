# E0300: a type application written with its type arguments alone constructs
# the instance as its bare name would, so a field without a default is required
# -- as a local, an argument, a field value, a return and a record alike. It
# used to build the value anyway: invalid C for a class, a silent zero for a
# record.
Pair: class {
    a: t
    b: String
} as { t: anyval.generic }

Row: record {
    a: t
    b: i64
} as { t: anyval.generic }

Buffer: class {
    stored: u64
} as { cap: u64.generic }

Stack: class {
    items: (ListVal t: t)
} as { t: anyval.generic }

Holder: class {
    p: (Pair t: u64)
}

show: function {p: (Pair t: u64)} out u64 is {
    return p.a
}

mk: function out (Pair t: u64) is {
    return (Pair t: u64)
}

main: function is {
    p: (Pair t: u64)
    q: Pair t: u64
    print "\{show p: (Pair t: u64)}"
    h: Holder p: (Pair t: u64)
    r: (Row t: u64)
    b: (Buffer cap: 8)
    s: Stack t: i64
    m: mk
    print "\{p.b} \{q.b} \{h.p.b} \{r.b} \{b.cap} \{s.items.length} \{m.b}"
}
