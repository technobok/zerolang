# E0100: a numeric generic parameter as a type has one value, the instance's
# argument, so it types only a field or a local, which hold that value. A
# parameter, a return, a marker and a type argument would carry it into code
# that every instance shares: each is refused, naming the bound to take
# instead, whether the parameter is the method's type's, the function's own,
# or a generic unit's. A method call or a construction that leaves a refused
# declaration out says nothing more.
Box: class {
    used: u32
    held: cap.hold
    items: (ListVal t: cap)
} as {
    cap: u32.generic
    room: function {b: this.view n: cap} out u32 is {
        return n
    }
    roomHeld: function {b: this.view n: cap.hold} out u32 is {
        return n
    }
    limit: function {b: this.view} out cap is {
        return cap
    }
    pick: function as { k: u32.generic } in {b: this.view a: k} out u32 is {
        return a
    }
    bag: function {b: this.view} out u64 is {
        l: (ListVal t: cap)
        return l.length
    }
}
wrap: unit as {
    n: u64.generic
    f: function {x: n} out u64 is {
        return x
    }
}
wa: (wrap n: 3)
own: function as { k: u32.generic } in {x: u32} out k is {
    return x
}
main: function is {
    c: (Box cap: 5) used: 1
    print "\{c.room} \{c.room n: 9} \{c.roomHeld n: 9} \{c.limit} \{c.pick k: 2 a: 1} \{c.bag}"
    print "\{wa.f x: 1} \{own k: 3 x: 10}"
}
