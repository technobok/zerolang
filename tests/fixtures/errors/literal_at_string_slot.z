# literal_at_string_slot.z -- a string literal is a view, and a String allocates:
# the literal becomes one only where `.string` is written. At a String
# parameter, field, `out String` return, reassignment or `List String` element
# a bare literal is the ordinary mismatch. The compiler once made the copy
# there by itself.
Named: class {
    name: String
}

greet: function {who: String} is {
    print who
}

label: function out String is {
    return "fixed"
}

main: function is {
    greet who: "bob"
    n: Named name: "x"
    s: "a".string
    s = "b"
    xs: List String
    xs.append "c"
    print "\{n.name} \{s} \{xs.length} \{label}"
}
