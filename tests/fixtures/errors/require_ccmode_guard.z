# require_ccmode_guard.z -- a `require:` block can guard on HOW zc reaches the
# compiler, not only on which one it is. `platform.ccmode` is folded during
# type checking exactly as `platform.cc` is, so the mode has to be resolved
# before the parse and seeded the same way. The flag rides in on the .zcargs
# sidecar; nothing is compiled on this path.
require: unit {
    library: if platform.ccmode == platform.ccmodekind.inproc then {
        error "this unit cannot be built with an in-process C compiler"
    } else {
        "m"
    }
}

main: function is {
    print "unreachable"
}
