# An error an instance's walk raises carries a note naming the instance by every
# argument it took, a numeric one included: `pick` with n = 3 and n = 4 are two
# instances that the note told apart only by the call's line, and an instance
# of a generic unit had no note at all. A negative argument keeps its sign.
pick: function as { t: anyval.generic n: u64.generic } in {v: t} out t is {
    match n case 3 then {
        return v + "three"
    } else {
        return v
    }
}

sized: unit as {
    t: anyval.generic
    cap: i64.generic
    get: function {v: t} out t is {
        match cap case -2 then {
            return v + "neg"
        } else {
            return v
        }
    }
}
s: (sized t: i64 cap: -2)

main: function is {
    print "\{pick n: 3 v: 1} \{pick n: 4 v: 1} \{s.get v: 1}"
}
