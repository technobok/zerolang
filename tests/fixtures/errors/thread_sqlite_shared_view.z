# A sqlite Database is `thread.Unshareable`: SQLite allows one thread at a time
# on a connection, reads included. A task holding a view of one would share it
# with the thread that owns it, so the spawn is refused.

# Reader -- counts rows through a view of its owner's database
Reader: class {
    # the connection, viewed
    db: sqlite.Database.view
} as {
    task: (thread.Task null)
    call: function {:this} is {
        print "\{this.db.totalChanges}"
    }
}

main: function is {
    db: sqlite.openMemory
    if db.err then return
    h: thread.spawn task: (Reader :db)
}
