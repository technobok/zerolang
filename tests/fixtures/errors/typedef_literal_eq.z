# A shadowed == narrows equality to the same typedef, so a bare literal
# operand is refused too; sentinel checks read the base explicitly
# (d.u64 == 0).
declid: typedef u64 as {
    ==: function {:this rhs: declid} out bool is {
        return this.u64 == rhs.u64
    }
}

main: function is {
    d: declid.create from: 7
    if d == 0 then print "z" else print "w"
}
