# E0100: a data block is a declaration, built once into static storage. It is
# declared at unit level and read by name; written in a function body, as a
# binding's value, a reassignment's value or either arm of an `if`, it is refused.
main: function is {
    x: data { 1 2 }
    y: 0
    y = data { 3 }
    z: if y == 0 then data { 1 } else 2
    w: if y == 0 then 1 else data { 2 }
    print "\{y}"
}
