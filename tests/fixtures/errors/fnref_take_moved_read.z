# A VARIABLE WHOSE FUNCTION REFERENCE WAS MOVED WITH `.take` IS INVALID after
# the move, as any moved variable is: a later read -- a bare call of it, or a
# copy of it -- is refused.
double: function {n: i64} out i64 is {
    return n * 2
}

seven: function out i64 is {
    return 7
}

main: function is {
    f: double.copy
    g: f.take
    a: f.copy
    s: seven.copy
    t: s.take
    v: s
    print "\{g n: 1} \{t} \{v}"
}
