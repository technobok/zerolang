# A DEFAULT NAMES AN ARM. It cannot supply what the arm carries, because the
# constant that records it -- `cval` with `armKind` -- holds the arm's owning
# type and its name, and has no slot for a payload.
#
# That is why bool works as a default and is not special for being bool: its
# arms carry nothing, so the discriminator IS the whole value. Any
# discriminator-only arm is the same, INCLUDING a payload-less arm of a sum
# whose other arms do carry things -- the rule is per-arm, not per-type, and
# `Mixed.none` below is a default while `Mixed.count` is refused.
#
# Nothing checked before. `n: Mixed.count` defaulted the field to arm `count`
# over a zero payload, which merely reads wrong; `n: Payload.text` defaulted it
# to a String that was never constructed, and reading THAT segfaults.
Mixed: variant {
    count: i64
    none: null
}

Payload: union {
    text: String
    empty: null
}

# both of these are fine and are here to keep the refusal honest
Fine: class {
    a: Mixed.none
    b: Payload.empty
    c: false
}

Bad: class {
    # a valtype payload: silently defaulted to 0
    n: Mixed.count
    # a reftype payload: silently defaulted to an unconstructed String
    s: Payload.text
}

main: function is {
    f: Fine
    print "fine"
    b: Bad
    print "bad"
}
