# A data block's `out` names an integer, float or string type. A record is
# none of them, and a name that resolves to nothing is an unknown type; both
# were accepted and the block read as if no `out` had been written.
pt: record { lo: i16 }

points: data { 1 2 } out pt
widths: data { 3 4 } out nosuch

main: function is {
    print "\{points.length} \{widths.length}"
}
