# E0200: the same rule for `.takex`, which had the same hole. It was accepted
# on a parameter and answered plain `owned`, so a signature could promise a pin
# in a position where no pin exists.
Src: class {
    n: i64
}
f: function {b: Src.takex} out i64 is {
    return b.n
}
main: function is {
    a: Src n: 5
    print "\{f b: a}"
}
