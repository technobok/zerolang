# A 2-arm sum is a condition (`if o then`), but `and` / `or` / `not` are bool's
# methods alone: negating an option-shaped value is a "no member" error, and
# the arm predicate (`o.none`) is the spelling that says what is meant.
maybe: variant {
    none: null
    some: i64
}

main: function is {
    o: maybe.some 3
    if o.not then print "none"
}
