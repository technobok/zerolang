# E0200: a binding of an `if` or `match` whose arms read fields is a second name
# for whichever the arm that ran reads, so EVERY arm's field is locked while it
# lives -- not only the first arm's.
Cell: class { n: i64  s: String }
H: class { p: Cell  q: Cell }
main: function is {
    h: H p: (Cell n: 1 s: "p".string) q: (Cell n: 2 s: "q".string)
    c: false
    r: if c then h.p else h.q
    h.q.n = 9
    h.p.n = 8
    print "\{r.n}"
}
