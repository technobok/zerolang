# return_labelled_arg.z -- `return` is itself a call, so a LABELLED argument
# binds to RETURN rather than to the expression being returned: `return f a: 1`
# hands `a: 1` to return and leaves `f` bare. That is by design; the correct
# form wraps the returned call in parentheses, `return (f a: 1)`.
#
# It used to be diagnosed from the wrong end -- the bare callee was blamed for
# the argument it had been denied, then the return type was blamed for the
# function value -- two errors, neither naming the real mistake.

f: function {a: u64} out u64 is {
    return a + 1
}

wrong: function out u64 is {
    return f a: 1
}

main: function is {
    print "\{wrong}"
}
