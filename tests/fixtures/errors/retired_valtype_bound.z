# retired_valtype_bound.z -- `.valtype` and `.reftype` no longer declare a
# generic parameter (only `.generic` does), so `t` here is an ordinary member
# and `Box` takes no type argument.

Box: record {
    v: i64
} as {
    t: i64.valtype
}

Cell: record {
    v: i64
} as {
    t: anyval.reftype
}

main: function is {
    b: Box t: i64 v: 3
    c: Cell t: i64 v: 4
    print "\{b.v} \{c.v}"
}
