# E0300: a numeric generic parameter's singleton type has one value, so its
# create takes no argument -- not the value it already holds, and not another.
Box: class {
    used: u32
} as {
    cap: u32.generic
    info: function {:this} out u32 is {
        a: cap.create from: 5
        b: cap.create 7
        return a + b
    }
}
main: function is {
    b: (Box cap: 5) used: 1
    print "\{b.info}"
}
