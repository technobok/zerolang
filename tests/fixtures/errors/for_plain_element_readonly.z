# THE PLAIN BINDING'S ELEMENT IS AS READONLY AS THE WALK THAT HANDS IT OUT. A
# `with`-bound `iterate` is the readonly walk, and `for each r: it` refused a
# write through its element; the plain binding `for r: it.call` -- the same
# walk, the iterator called every iteration -- took no notice of the iterator
# it called, and accepted `r.n = 5` (reproduced at e109debe). Both forms now
# ask the iterator binding.
Row: class { n: i64 }

main: function is {
    rows: (List Row)
    rows.append (Row n: 1)
    with it: rows.iterate do for r: it.call loop {
        r.n = 5
    }
    print "\{rows.length}"
}
