# require_cc_guard.z -- quadfloat's `require:` block guards on the C compiler,
# so asking for tcc reports that unit's own message instead of letting tcc
# reject the emitted C. The flag rides in on the .zcargs sidecar; no C compiler
# is invoked on this path, so tcc need not be installed for this to pass.
main: function is {
    x: 1.5.f128
    print "\{x}"
}
