# A TYPE REFERENCE WHOSE NUMERIC ARGUMENT IS REFUSED NAMES NO TYPE: the refusal
# is the one error. The parameter it declares is still the callee's, so a call
# that passes it is not told the argument is unknown or mistyped -- a report
# that named the reference by an internal name (`array_i64_99999...`).
Buffer: class {
    used: u32
    count: function {:this a: (array t: i64 to: 99999999999999999999999)} out u64 is {
        return 1
    }
}

total: function {a: (array t: i64 to: 99999999999999999999999)} out u64 is {
    return 2
}

main: function is {
    b: Buffer used: 0
    a: array t: i64 to: 5
    print "\{b.count :a} \{total :a}"
}
