# a typedef has no constructor of its own: it is built from its base, as
# `meters x` or `meters.create from: x`. A `create` in its as-block was never
# called -- the construction below printed 5 and never "user create".
meters: typedef i64 as {
    create: function {m: meters} out meters is {
        print "user create"
        return m
    }
}
main: function is {
    m: meters 5
    print "\{m}"
}
