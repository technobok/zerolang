# E0200: a reassignment keeps the ownership its target was bound with: a
# borrow is stored in no owned or held variable.
Cell: class { n: i64  s: String }
main: function is {
    e: Cell n: 1 s: "e".string
    x: Cell n: 3 s: "x".string
    hs: Cell n: 5 s: "h".string
    h: hs.hold
    x = e.borrow
    h = e.borrow
    print "\{x.n} \{h.n}"
}
