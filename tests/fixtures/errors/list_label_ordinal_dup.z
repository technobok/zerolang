# Every name in a list is distinct. An unlabelled element is named by its
# index, so a label that spells an index an unlabelled element already holds
# collides with it: `nums.1` would name two elements. It was accepted, and the
# label lost.
nums: list { 0 1 1: 3 }
named: list { a: 1 2 1: 3 }

main: function is {
    print "\{nums.1} \{named.1}"
}
