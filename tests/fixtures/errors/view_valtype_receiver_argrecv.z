# E0200: the receiver handed over as a NAMED ARGUMENT (`Pt.shift p: a`) is the
# receiver still -- it is passed by reference, so through a view it is refused
# like a dotted call would be.
point: record {
    x: i64
} as {
    shift: function {p: this by: i64} out i64 is {
        p.x = p.x + by
        return p.x
    }
}
reader: function {q: point.view} out i64 is {
    return (point.shift p: q by: 5)
}
main: function is {
    a: point x: 1
    r: reader q: a
    print "\{r} \{a.x}"
}
