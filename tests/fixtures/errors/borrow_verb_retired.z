# borrow_verb_retired.z -- the `T.borrow from:` verb is gone: a projection puts
# the marker on its SOURCE (`Bytes xs.borrow`, `Speaker d.borrow`), and a type
# names no storage to borrow.
Speaker: protocol {
    speak: function {:this} out i64
}

Dog: class { n: i64 } as {
    :Speaker
    speak: function {t: this} out i64 is { return t.n }
}

main: function is {
    xs: ListVal u8
    b: Bytes.borrow from: xs
    d: Dog n: 7
    s: Speaker.borrow from: d
    print "\{b.length} \{s.speak}"
}
