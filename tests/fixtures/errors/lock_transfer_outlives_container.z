# A container declared BEFORE the source outlives it: appending a lock-holding
# value would leave the container pointing at a dead source. Refused -- copy.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

main: function is {
    xs: (List W)
    {
        a: Src n: 1
        w: mk from: a
        xs.append w
    }
    print "\{xs.length}"
}
