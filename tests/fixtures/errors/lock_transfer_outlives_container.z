# A container in an ENCLOSING scope outlives the source: appending a
# lock-holding value would leave the container pointing at a dead source.
# Refused -- copy. (Declaration order within ONE scope is not an outlives:
# see the corpus twin lock_transfer_same_scope.)
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

main: function is {
    xs: (List W)
    {
        a: Src n: 1
        w: mk from: a
        xs.append w
    }
    print "\{xs.length}"
}
