# A protocol instance wraps a value that implements the protocol. A value that
# is already an instance has no implementer to hand over; writing the protocol
# over it used to pass the check and reach the emitter.

# Provider -- answers a number for a seed
Provider: protocol {
    get: function {:this seed: i64} out i64
}

# Mul -- multiplies the seed
Mul: class {
    factor: i64
} as {
    prov: Provider.implement
    get: function {:this seed: i64} out i64 is { return this.factor * seed }
}

main: function is {
    m: Mul factor: 5
    again: Provider m.prov
    print "a"
}
