# E0200: `.view` on a valtype receiver is refused. Readonly is enforced by a
# lock on the receiver's own path and a valtype has none, so the marker would
# compile and then do nothing -- the write below would go through. `.lock` on a
# valtype receiver stays legal: that is how str.stringview reads.
Pt: record {
    x: i64
} as {
    poke: function {t: this.view} is {
        t.x = 99
    }
}
main: function is {
    q: Pt x: 1
    q.poke
    print "\{q.x}"
}
