# A bare local an arm moves into where the value lands is spent after the `if`
# or `match`, whichever arm ran: a later read is a read after its move.
keep: function {s: String.take} out u64 is {
    return s.length
}

afterBinding: function {c: bool} is {
    o: "x".string
    r: if c then o else "z".string
    print o
    print r
}

afterBothArms: function {c: bool} is {
    a: "a".string
    b: "b".string
    r: if c then a else b
    print b
    print r
}

afterArgument: function {c: bool} is {
    o: "x".string
    z: "z".string
    n: keep s: (if c then o else z)
    print "\{n} \{o}"
}

afterReassignment: function {c: bool} is {
    o: "x".string
    r: "r".string
    r = if c then o else "z".string
    print o
    print r
}

main: function is {
    afterBinding c: true
    afterBothArms c: true
    afterArgument c: true
    afterReassignment c: true
}
