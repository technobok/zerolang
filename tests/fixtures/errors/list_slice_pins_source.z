# E0200: slicing an owner pins it SHARED for the slice's lifetime. Readers --
# further slices included -- stay legal beside it, but a writer is excluded,
# because `append` may realloc and leave the slice pointing at freed storage.
main: function is {
    ns: (ListVal i64)
    ns.append from: 10
    s: ns.slice from: 0 to: 1
    ns.append from: 20
    print "len=\{s.length}"
}
