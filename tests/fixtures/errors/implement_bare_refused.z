# An implementation is written `label: X.implement`, and only so: a type's
# `as` item naming an interface bare -- the shorthand `:Speaker`, a label
# `m: sizer`, a path through a unit, a generic instance -- names a type, which
# no `as` member does. Each is refused where it is written, once, and the type
# implements nothing by it.
Speaker: protocol {
    speak: function {t: this.view} out i64
}
sizer: facet {
    size: function {t: this.view} out u64
}
Getter: protocol {
    get: function {t: this.view} out v
} as {
    v: anyval.generic
}

Dog: class { n: i64 } as {
    :Speaker
    speak: function {t: this.view} out i64 is { return t.n }
}
pt: record { x: u64 } as {
    m: sizer
    size: function {t: this.view} out u64 is { return t.x }
}
Guard: class { n: i64 } as {
    bound: thread.ThreadBound
}
Cell: class { n: i64 } as {
    g: (Getter v: i64)
    get: function {t: this.view} out i64 is { return t.n }
}

main: function is {
    d: Dog n: 1
    p: pt x: 2
    g: Guard n: 3
    c: Cell n: 4
    print "\{d.speak} \{p.size} \{g.n} \{c.get}"
}
