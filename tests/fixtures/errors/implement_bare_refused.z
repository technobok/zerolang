# An implementation is written `label: X.implement`, and only so. A type's `as`
# item naming an interface bare -- `m: sizer`, a generic instance `g: (Getter
# v: i64)` -- is an alias of it, which implements nothing: each type is refused
# where it stands in for the interface. The shorthand `:Speaker` would name the
# item itself, which no `as` member can, and is refused where it is written.
Speaker: protocol {
    speak: function {t: this.view} out i64
}
sizer: facet {
    size: function {t: this.view} out u64
}
Getter: protocol {
    get: function {t: this.view} out v
} as {
    v: anyval.generic
}

Dog: class { n: i64 } as {
    :Speaker
    speak: function {t: this.view} out i64 is { return t.n }
}
pt: record { x: u64 } as {
    m: sizer
    size: function {t: this.view} out u64 is { return t.x }
}
Cell: class { n: i64 } as {
    g: (Getter v: i64)
    get: function {t: this.view} out i64 is { return t.n }
}

hear: function {s: Speaker} out i64 is { return s.speak }
measure: function {m: sizer} out u64 is { return m.size }
fetch: function {g: (Getter v: i64)} out i64 is { return g.get }

main: function is {
    d: Dog n: 1
    p: pt x: 2
    c: Cell n: 4
    print "\{hear s: d} \{measure m: p} \{fetch g: c}"
}
