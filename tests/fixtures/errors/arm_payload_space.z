# A tagged type's arm payload is fixed by the instance, so a value only fits
# when its type matches. `at` names a declid-like typedef and a bare u64 is
# not one -- that direction is never implicit. Before this check the
# construction wore the parent type whatever it held, so the return and
# argument checks downstream compared the parent against itself and could
# never fire; the mismatch surfaced only as C the compiler had already
# claimed was good.
#
# The reverse (a typedef offered where the arm declares its BASE) stays
# legal: an arm payload is a typed slot like a parameter, so a typedef
# substitutes into it as a whole value. `slot.raw d` below must NOT error.
did: record { val: u64.typedef } as {
    ==: function {:this rhs: did} out bool is {
        return this.u64 == rhs.u64
    }
}

slot: variant {
    none: null
    at: did
    raw: u64
} as { tag: u8.tag }

main: function is {
    n: 7.u64
    d: did.create from: 7
    s1: (slot.at n)
    s2: (slot.raw d)
    match (
        s1
    ) case at then {
        print "at"
    } else null
    match (
        s2
    ) case raw then {
        print "raw"
    } else null
}
