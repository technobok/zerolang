# dotted_value_unresolved.z -- the unresolvable name is the ROOT of a dotted
# VALUE, not the whole value. The callee leg has always made this check for
# `ghost.method`; a dotted value in argument or return position escaped it and
# reached the emitter, which wrote the bare root into the C.
#
# The check lives on the value path, not in the shared helper: the statement
# and binding report sites reach bodies whose locals are absent from the scope
# table, where the same proof would reject a real name.

takes: function {a: u64} out u64 is {
    return a + 1
}

viaArg: function out u64 is {
    return (takes a: ghostRoot.field)
}

viaReturn: function out u64 is {
    return ghostOther.field
}

main: function is {
    print "\{viaArg} \{viaReturn}"
}
