# `outx` needs something to keep locked. A `.take` parameter is moved into the
# call and dies with it, so a reference return with only that as an input has
# no pinned parent to point into -- the declaration is refused.
Box: class {
    item: String
}

label: function {b: Box.take} outx String.borrow is {
    return b.item
}

main: function is {
    b: (Box item: "hi".string)
    print "\{(label b: b).length}"
}
