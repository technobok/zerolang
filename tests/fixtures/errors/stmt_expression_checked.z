# stmt_expression_checked.z -- every statement line that is not a binding is
# checked, whatever its shape. One error per line below, each raised only by
# walking that statement: a call, an `if`, a `match`, a `for`, a bare block, a
# `with`, a `swap` and a reassignment. A statement line holds its value bare,
# with no wrapper row to dispatch on, so the walk must not care which it is.
Item: class { v: i64 }

f: function {n: i64} is {
    print "\{n}"
}

main: function is {
    a: Item v: 1
    b: Item v: 2
    k: 1
    o: optionval.some 3
    f n: "text"
    if ghostIf then print "if"
    match (
        o
    ) case some then f n: "match" else null
    for e: ghostFor loop {
        print "for"
    }
    {
        f n: "block"
    }
    with w: ghostWith do print "with"
    h: a.borrow
    a swap b
    k = ghostAssign
    print "\{h.v} \{b.v} \{k}"
}
