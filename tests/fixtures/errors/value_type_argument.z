# A type argument names a type. A value written in its place -- a local, a
# literal, a string, a field, a record value -- was ignored whenever the
# construction's fields let the parameter be inferred, and the program ran as
# though the argument had not been written.
pair: record {
    first: t
} as {
    t: anyval.generic
}

Box: class {
    val: t
} as {
    t: anyval.generic
}

pt: record {
    n: 0
}

localArg: function is {
    x: 3
    p: pair t: x first: 4
    print "\{p.first}"
}

classArg: function is {
    x: 3
    b: Box t: x val: 4
    print "\{b.val}"
}

literalArg: function is {
    p: pair t: 5 first: 4
    print "\{p.first}"
}

stringArg: function is {
    p: pair t: "a" first: 4
    print "\{p.first}"
}

recordValueArg: function is {
    q: pt n: 2
    p: pair t: q first: (pt n: 5)
    print "\{p.first.n}"
}

main: function is {
    localArg
    classArg
    literalArg
    stringArg
    recordValueArg
}
