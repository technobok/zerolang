# generic_method_bound -- a generic method's bound is checked at the call
# that instantiates it, as a generic function's is
public: unit {
    :main
}

# Acc -- a counter
Acc: class {
    n: u64
} as {
    # add -- count any text's bytes
    add: function as { T: StringLike.generic } in {:this text: T.view} is {
        this.n = this.n + text.length
    }
}

main: function is {
    a: Acc n: 0
    a.add text: 5
}
