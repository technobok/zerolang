# E0300: a function-style call whose base is a TYPE leaves the receiver to be
# supplied -- as the one unlabelled argument, or by its declared name. Supplying
# neither omits a required parameter, and the receiver is required like any
# other. Reported here rather than left to the C compiler.
point: record {
    x: i64
} as {
    sub: function {t: this a: i64} out i64 is {
        return t.x - a
    }
}
main: function is {
    p: point x: 10
    r: point.sub a: 2
    print "\{r}"
}
