# AN `as` ALIAS READ AS A VALUE IS THE TYPE'S BARE CONSTRUCTION, refused as the
# bare name is when a field has no default: `w: p.Inner` reports what `w: inner`
# reports, where it emitted C with no value in it.
inner: record {
    y: i64
}

p: record {
    x: i64
} as {
    Inner: inner
}

main: function is {
    v: p x: 1
    w: p.Inner
    print "\{v.x} \{w.y}"
}
