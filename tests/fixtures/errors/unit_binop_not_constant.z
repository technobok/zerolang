# A UNIT-LEVEL DEFINITION BUILT FROM AN OPERATOR IS A COMPILE-TIME CONSTANT, so
# the expression must fold. None of these can: a name nothing declares, a
# comparison between an integer and a string, a run-time call, and an operator
# the evaluator does not fold over its operands (`%` on floats; every integer
# operator folds). Each was accepted and emitted as the definition's type name,
# or as the definition's own name. An operand that carries a type is named by
# it: an f32 is not reported as the f64 an untyped float reads as.
LIMIT: 5

g: function {n: i64} out i64 is {
    return n
}

UNKNOWN: GHOST + 1

MISMATCH: LIMIT > "nine"

CALLED: (g n: 3) + 1

REMAINDER: 7.5 % 2.0

TYPED: 7.5.f32 % 2.0.f32

main: function is {
    print "\{UNKNOWN} \{CALLED} \{REMAINDER} \{TYPED}"
    if MISMATCH then print "yes"
}
