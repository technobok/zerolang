# A UNIT-LEVEL DEFINITION BUILT FROM AN OPERATOR IS A COMPILE-TIME CONSTANT, so
# the expression must fold. None of these can: a name nothing declares, a
# comparison between an integer and a string, a run-time call, and operators the
# evaluator does not fold (`<<`, `|`, `%`). Each was accepted and emitted as the
# definition's type name, or as the definition's own name.
LIMIT: 5

g: function {n: i64} out i64 is {
    return n
}

UNKNOWN: GHOST + 1

MISMATCH: LIMIT > "nine"

CALLED: (g n: 3) + 1

SHIFTED: 1 << 3

MASKED: 6 | 1

REMAINDER: 7 % 3

main: function is {
    print "\{UNKNOWN} \{CALLED} \{SHIFTED} \{MASKED} \{REMAINDER}"
    if MISMATCH then print "yes"
}
