# A non-owned arm of a valtype payload points at its source as a reftype's
# does, and pins it at the arm's strength: SHARED for `.view`, so the source
# is not written while the value built lives.
Num: union {
    some: i64.view
    none: null
}
main: function is {
    x: 4
    f: Num.some x
    x = 5
    match (f) case some then print "\{f}" else null
}
