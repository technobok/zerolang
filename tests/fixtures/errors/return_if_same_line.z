# `return` takes its value as a call takes an unlabelled argument, which is a
# binop; an `if` is not one, so the statement ends at `return` and the `if` is
# left over on its line. A line ends at `;`, a new line or `}`. The value form
# is `return (if c then 1 else 2)`.
pick: function {c: bool} out i64 is {
    return if c then 1 else 2
}

main: function is {
    print "\{pick c: true}"
}
