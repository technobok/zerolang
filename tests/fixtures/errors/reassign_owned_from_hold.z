# E0200: a reassignment keeps the ownership its target was bound with. `x` is
# owned, so `.hold` -- which rebinds only a `.hold` binding -- is refused.
Cell: class { n: i64  s: String }
main: function is {
    e: Cell n: 1 s: "e".string
    x: Cell n: 3 s: "x".string
    x = e.hold
    print "\{x.n}"
}
