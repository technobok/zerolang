# A definition's `is` and `as` members are one namespace, as each block's own
# items are. A field and an `as` method of the same name were both accepted,
# and the construction reached the C compiler with no `create` for the type.
C: class { n: u8 } as {
    n: function {:this} out u8 is {
        return 1
    }
}

main: function is {
    c: C n: 1
    print "\{c.n}"
}
