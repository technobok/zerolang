# E0200: a call whose result is a `.view` cannot be handed on as a `.borrow`
# result -- the view converts to no other ownership.
Item: class {
    n: i64
}

Bag: class {
    it: Item
} as {
    peekV: function {t: this.view} outx Item.view is {
        return t.it
    }
    lend: function {:this} outx Item.borrow is {
        return this.peekV
    }
}

main: function is {
    b: Bag it: (Item n: 1)
    p: b.lend
    print "\{p.n}"
}
