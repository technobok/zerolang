# E0040: `main` is called by the runtime, which has no arguments to pass it.
# The emitter writes `void z_main(void)` whatever the declaration says, so a
# parameter here produced C that read an undeclared variable. A program reads
# its command line through `os.args`.
main: function {args: (List String).view} is {
    print "n=\{args.length}"
}
