# E0200: an `outx` result keeps its VALTYPE argument locked when the parameter
# takes it by pointer (`.view`), exactly as it keeps a reftype one: `v` views
# `s`'s bytes, so reassigning `s` while `v` lives is refused. It used to be
# accepted, and `v` printed the new value.
headView: function {s: (str to: 8).view} outx StringView is {
    return s.stringView
}

main: function is {
    s: "abc".str to: 8
    v: headView :s
    s = "zzz".str to: 8
    print "\{v}"
}
