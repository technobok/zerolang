# E0200: a zero-argument method auto-calls through the dotted path rather than
# as a Call, and locks its receiver just the same -- so a mutating one conflicts
# with an outstanding reference to its receiver.
Ctr: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
}
main: function is {
    c: Ctr n: 1
    with v: c.borrow do {
        c.bump
    }
    print "\{c.n}"
}
