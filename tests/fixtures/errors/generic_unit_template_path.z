# A generic unit's contents are used through an instance of it, which binds the
# unit's parameters. A template it declares reached through the unit itself
# (`wrap.pairs`) is refused even with every parameter written: its instance
# typechecked and then reached the C as a call of a function nothing emitted.
wrap: unit as {
    t: anyval.generic
    pairs: unit as {
        u: anyval.generic
        both: function {a: t b: u} out t is { return a }
    }
}
wp: (wrap.pairs t: i64 u: f64)

main: function is { print "\{wp.both a: 5 b: 1.5}" }
