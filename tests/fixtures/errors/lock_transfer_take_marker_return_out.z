# `return w.take` hands back a lock-holding local exactly as `return w` does:
# through a plain `out` function the caller could not see the locks, so it is
# refused. P declares no non-owned field, so only the pin -- not the type --
# says the result depends on `a`.
Src: class {
    n: i64
}

P: class {
    tag: i64
}

mk: function {from: Src.borrow} outx P is {
    return (P tag: from.n)
}

bad: function out P is {
    a: Src n: 1
    w: mk from: a
    return w.take
}

main: function is {
    print "\{bad.tag}"
}
