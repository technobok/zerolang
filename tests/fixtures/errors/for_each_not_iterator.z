# `for each` evaluates its value ONCE and walks it: through its `iterate` when
# its type has one, else as the iterator itself, whose `call` answers an
# option. An option is neither -- evaluated once it answers once -- and a
# record or an integer has no walk at all.
Tick: class {
    n: i64
} as {
    next: function {:this} out optionval i64 is {
        this.n = this.n + 1
        return (optionval.some this.n)
    }
}

pt: record { x: i64 }

main: function is {
    t: Tick n: 0
    for each v: t.next loop print "\{v}"
    for each w: 5 loop print "\{w}"
    p: pt x: 1
    for each q: p loop print "\{q.x}"
}
