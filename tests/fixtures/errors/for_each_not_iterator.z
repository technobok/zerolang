# `for each` evaluates its value ONCE and walks it, so the value must be an
# iterator: a type whose `call` answers an option. An option itself is not one
# -- evaluated once it answers once -- and neither is a plain value.
Tick: class {
    n: i64
} as {
    next: function {:this} out optionval i64 is {
        this.n = this.n + 1
        return (optionval.some this.n)
    }
}

main: function is {
    t: Tick n: 0
    for each v: t.next loop print "\{v}"
    for each w: 5 loop print "\{w}"
}
