eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
nope: function out bool is {
    return false
}
# `.take` of a local declared outside the loop, on a path that reaches the
# next iteration: refused.
main: function is {
    x: "abc".string
    n: 0
    for while n < 3 loop {
        n = n + 1
        b: x.take
        print "\{b.length}"
    }
}
