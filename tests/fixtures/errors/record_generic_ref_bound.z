# E0100: a valtype holds value data only, and a template's bound reaches every
# mono: a record's or variant's parameter may not be bounded by a family that
# admits reftypes (AnyRef, RefHashable, StringLike) or by a protocol. A facet
# bound is a valtype bound and passes. A template resolves when it is
# instantiated, and the instantiation then meets the mono's own refusal.
Shape: protocol { area: function {t: this.view} out i64 }
fl: facet { area: function {t: this.view} out i64 }
pair: record { a: T } as { T: AnyRef.generic }
keyed: record { k: K } as { K: RefHashable.generic }
texty: record { s: T } as { T: StringLike.generic }
shaped: record { s: T } as { T: Shape.generic }
flat: record { s: t } as { t: fl.generic }
vsum: variant { none: null  some: T } as { T: AnyRef.generic }

main: function is {
    a: pair a: "x".string
    b: keyed k: "x".string
    c: texty s: "x".string
    d: shaped s: "x".string
    e: vsum.none
    a
    b
    c
    d
    e
    print "x"
}
