# A yield moves its value out to the caller, as a `return` does: a field stays
# in its owner, so yielding one is refused, whether the owner is the generator
# itself or a local of its body.
Holder: class {
    name: String
}

Names: generator { base: String  n: u64 } as {
    call: function out String is {
        h: Holder name: "hn".string
        i: 0.u64
        for i < this.n loop {
            yield this.base
            yield h.name
            i = i + 1
        }
    }
}

main: function is {
    for each s: (Names base: "abc".string n: 3) loop print s
}
