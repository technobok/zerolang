# E0200: a marker on a GENERIC type's field reaches its instances -- `hold`
# freezes the contents whether or not the declaring class is a template.
Wrap: class {
    it: t.hold
} as {
    t: AnyRef.generic
}
main: function is {
    s: "abc".string
    w: Wrap it: s.take
    w.it.append s: "def".string
    print "it=\{w.it}"
}
