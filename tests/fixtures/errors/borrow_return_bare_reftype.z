# E0200: a bare return of a BORROWED reftype hands the caller an owned value it
# does not own. Parameters borrow by default and a receiver is always borrowed,
# so both of these alias storage the caller still frees -- the callee's binding
# and the source both destroy it. docs/ownership.pdoc names the three
# remediations: `.copy`, a `.take` parameter, or an `out T.borrow` return.
Holder: class {
    val: String
} as {
    mirror: function {h: this} out Holder is {
        return h
    }
}

pick: function {a: Holder b: Holder} out Holder is {
    return b
}

main: function is {
    x: Holder val: "one".string
    y: Holder val: "two".string
    p: pick a: x b: y
    print "\{p.val}"
    q: x.mirror
    print "\{q.val}"
}
