# E0100/E0300: a typedef's construction casts a value of its base type: a
# literal must fit the base, and a conversion that can fail is a result, not
# a number to cast.
tiny: typedef u8
pid: typedef u32
main: function is {
    a: tiny 300
    big: 7.u64
    c: pid.create from: big.u32
    print "\{a.u8} \{c.u32}"
}
