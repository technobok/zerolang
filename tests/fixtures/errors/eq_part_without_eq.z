# A GENERATED `==` COMPARES EACH PART WITH THAT PART'S OWN `==`, so a part with
# none leaves its container with none. `==: null` strikes a part's off, a facet
# has none, and a written `==` comparing its type with something else (`pt`
# takes a u64) is not the part's. Every holder below is refused where it is
# compared -- infix, `!=`, the call form -- however the part is reached: a
# field, a variant payload, an array element, a generic argument, optionval,
# two levels down, a typedef, a part declared after its holder and one from
# another unit. The same holders compile when nothing compares them:
# emitc_corpus/eq_part_holders.
opaque: record {
    val: i64
} as {
    ==: null
}

inner: record {
    o: opaque
}

outer: record {
    i: inner
}

pick: variant {
    one: opaque
    none: null
}

row: record {
    xs: (array t: opaque to: 2)
}

Pair: record {
    a: t
} as {
    t: anyval.generic
}

later: record {
    p: shown
}

shown: record {
    val: i64
} as {
    !=: null
}

sized: facet {
    size: function {:this} out u64
}

pt: record {
    x: u64
} as {
    m: sized
    size: function {p: this} out u64 is {
        return p.x
    }
    ==: function {p: this rhs: u64} out bool is {
        return p.x == rhs
    }
}

viaFacet: record {
    s: sized
}

viaPt: record {
    p: pt
}

wrapped: record { val: opaque.typedef }

remote: record {
    o: eqparts.opaque
}

main: function is {
    a: inner o: (opaque val: 1)
    print "\{a == a}"
    print "\{a != a}"
    print "\{(a.== rhs: a)}"
    b: outer i: a
    print "\{b == b}"
    c: pick.one (opaque val: 1)
    print "\{c == c}"
    d: row xs: (array t: opaque to: 2)
    print "\{d == d}"
    e: Pair t: opaque a: (opaque val: 1)
    print "\{e == e}"
    f: (optionval t: opaque).some (opaque val: 1)
    print "\{f == f}"
    g: later p: (shown val: 1)
    print "\{g == g}"
    q: pt x: 1
    h: viaFacet s: (sized.create from: q)
    print "\{h == h}"
    k: viaPt p: q
    print "\{k == k}"
    w: wrapped from: (opaque val: 1)
    print "\{w == w}"
    r: remote o: (eqparts.opaque val: 1)
    print "\{r == r}"
}
