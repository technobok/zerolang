# A loop's iterable binding runs once per entry to the loop -- which, inside
# an OUTER loop, is once per outer iteration: an outer-outer local moved
# there reaches the outer loop's next iteration.
G: generator { s: String } as {
    call: function out u64 is {
        yield this.s.length
    }
}
main: function is {
    src: "hello".string
    i: 0
    for while i < 2 loop {
        i = i + 1
        for r: (G s: src) loop print "\{r}"
    }
}
