# as_member_names_no_member.z -- an `as` member whose value reads a member its
# type does not declare. `v: t` follows `t`, so the declaration is checked and
# reports the read -- not a mismatch against a type named after the member.

Point: record { x: i64 }

Box: record {
    v: t
} as {
    t: i64.bogus
}

Crate: record {
    w: u
} as {
    u: Point.nope
}

main: function is {
    b: Box v: 3
    c: Crate w: 4
    print "\{b.v} \{c.w}"
}
