# A create that constructs its own type from inside itself calls itself: it is
# refused for a generic class in each of its spellings, as for a plain one --
# `type.create`, `(Cell t: t).create`, the bare `Bin args`, and an instance
# named by its arguments (`(Twin t: u8 ..)`, refused in the u8 instance).
Box: class {
    v: t
    n: i64
} as {
    t: anyval.generic
    create: function {v: t k: i64} out this is {
        if k > 0 then return (type.create :v k: k - 1)
        return (meta.create :v n: k)
    }
}

Cell: class {
    v: t
    n: i64
} as {
    t: anyval.generic
    create: function {v: t k: i64} out this is {
        if k > 0 then return ((Cell :t).create :v k: k - 1)
        return (meta.create :v n: k)
    }
}

Bin: class {
    v: t
    n: i64
} as {
    t: anyval.generic
    create: function {v: t k: i64} out this is {
        if k > 0 then return (Bin :v k: k - 1)
        return (meta.create :v n: k)
    }
}

Plain: class {
    n: i64
} as {
    create: function {k: i64} out this is {
        if k > 0 then return (type.create k: k - 1)
        return (meta.create n: k)
    }
}

Twin: class {
    v: t
    n: i64
} as {
    t: anyval.generic
    create: function {v: t k: i64} out this is {
        if k > 0 then return (meta.create :v n: (Twin t: u8 v: 1 k: 0).n)
        return (meta.create :v n: k)
    }
}

main: function is {
    b: Box v: 1 k: 2
    c: Cell v: 1 k: 2
    d: Bin v: 1 k: 2
    p: Plain k: 2
    print "\{b.n} \{c.n} \{d.n} \{p.n}"
    tw: Twin v: 5 k: 1
    print "\{tw.n}"
}
