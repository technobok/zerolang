# E0100: a generic function's instance is checked as its own copy of the body,
# so a marker the template writes on `t` is refused in the instance for a data
# type, while the instance for a number stands.
inner: data { v: u8 }
x: (inner v: 2)

dup: function as { t: anyval.generic } in {a: t} out t is {
    b: a.copy
    return b
}

main: function is {
    p: x
    q: dup a: p
    n: dup a: 5
    print "\{n}"
}
