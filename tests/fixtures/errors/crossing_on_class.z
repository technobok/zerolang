# `thread.Crossing` marks a protocol: a parameter typed or bounded by one hands
# its argument to another thread. A class declaring it would mean nothing, so
# it is refused.

# Job -- declares the marker it cannot carry
Job: class {
    # the work's size
    n: i64
} as {
    crossing: thread.Crossing
}

main: function is {
    j: Job n: 1
    print "\{j.n}"
}
