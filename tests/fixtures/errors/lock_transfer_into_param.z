# A lock-holding value cannot be handed to a parameter: the parameter is the
# caller's, and locks moved into it would leave with the callee unseen.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

Holder: class {
    slot: W
}

fill: function {h: Holder.borrow from: Src.borrow} is {
    w: mk from: from
    h.slot = w
}

main: function is {
    a: Src n: 1
    h: Holder slot: (W s: a tag: 0 label: "first".string)
    fill h: h from: a
    print "\{h.slot.tag}"
}
