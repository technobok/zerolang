# A user protocol may declare `thread.Crossing`: a parameter bounded by it
# hands its argument to another thread (here a user's own thread pool would do
# so), so a lock guard in the job is refused at the call.

# Job -- work a pool runs on one of its threads
Job: protocol {
    # the work
    run: function {:this}
} as {
    crossing: thread.Crossing
}

# submit -- hand `job` to the pool
submit: function {job: J.take} is {
    job.run
} as {
    J: Job.generic
}

# Locker -- a job that holds a lock guard
Locker: class {
    # the guard
    g: sync.MutexGuard (ListVal i64)
} as {
    job: Job
    run: function {:this} is { print "ran" }
}

main: function is {
    m: (sync.Mutex (ListVal i64)).create value: ListVal i64
    submit job: (Locker g: m.lock)
}
