# Reassigning a pinned source would destroy the value the result points into;
# the pin refuses it, on the second argument as on the first.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {a: Src.borrow b: Src.borrow} outx W is {
    return (W s: b tag: a.n)
}

main: function is {
    x: Src n: 1
    y: Src n: 2
    w: mk a: x b: y
    y = Src n: 9
    print "\{w.s.n}"
}
