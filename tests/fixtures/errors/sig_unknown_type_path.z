# sig_unknown_type_path.z -- a dotted type-ref whose root names nothing is
# unknown at its root. A path with a member leaf peels to its root, as an arm
# default does (`shade.green`), and the peel minted a type of the root's name
# that nothing defines: the first signature was accepted and its C named a type
# no translation unit declares, and the second reported a missing member of a
# type that does not exist.
peel: function {o: nosuch.os} out bool is {
    return true
}

deeper: function {o: nosuch.os.deeper} out bool is {
    return true
}

# Holder -- a field typed the same way
Holder: record {
    f: other.kind
}

main: function is {
    print "\{peel o: 1}"
    print "\{deeper o: 1}"
    h: Holder f: 1
    print "\{h.f == h.f}"
}
