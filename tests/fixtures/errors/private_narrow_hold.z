# private_narrow_hold.z -- `.private.hold` is refused (E0022): a friend handle is a
# reference, never owned. It used to reach C.
Bag: class { a: i64 } as {
    public: unit { :lend }
    lend: function {:this} out i64 is { return (friend h: this.private) }
}

friend: function {h: Bag.private.hold} out i64 is { return h.a }

main: function is {
    b: (Bag a: 5)
    print "\{b.lend}"
}
