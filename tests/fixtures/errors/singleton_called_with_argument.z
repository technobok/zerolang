# E0300: a numeric generic parameter written with an argument is its
# singleton's create, which takes none -- refused as `cap.create 5` is.
#
# It was accepted as the construction of a type, and the emitter stopped on
# E0500 "unhandled callee cap".
sized: unit as {
    cap: u32.generic
    describe: function {} out u32 is {
        x: cap 5
        y: (cap cap)
        return x + y
    }
}

c: (sized cap: 64)

main: function is {
    print "\{c.describe}"
}
