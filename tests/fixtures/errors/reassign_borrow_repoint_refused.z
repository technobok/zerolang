# E0200: a re-point keeps the borrow sound. Written in a branch or a nested
# block it adds to what the name borrowed, so the old source stays locked
# (`a.n = 5`); the new source must live as long as the name; `.take` and an
# owned value are refused as a mode change; a writable borrow cannot be
# re-pointed at a readonly one; and a borrow another borrow aliases (`c: b4`)
# is not re-pointed under it.
Cell: class { n: i64  s: String }

readonly: function {q: Cell.view} is {
    w: Cell n: 1 s: "w".string
    b: w
    b = q
    print "\{b.n}"
}

main: function is {
    a: Cell n: 1 s: "a".string
    d: Cell n: 2 s: "d".string
    b: a
    c: true
    if c then b = d
    a.n = 5
    b2: a
    {
        e: Cell n: 3 s: "e".string
        b2 = e
    }
    b3: d
    b3 = d.take
    b4: d
    c4: b4
    b4 = a
    print "\{b.n} \{b2.n} \{b3.n} \{c4.n}"
    readonly q: d
}
