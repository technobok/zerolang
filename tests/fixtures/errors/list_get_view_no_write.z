# E0200: `List.get` hands back a READONLY reference, so two of them can be
# live at once and neither can be written through. Before the flip this
# program compiled, ran, and printed `a=20 b=20` -- two independent-looking
# element references silently aliasing. Use `getMut` to write.
Row: class {
    n: i64
}
main: function is {
    rows: (List Row)
    rows.append (Row n: 10)
    a: rows.get i: 0
    b: rows.get i: 0
    a.n = 20
    print "a=\{a.n} b=\{b.n}"
}
