# E0200: a live non-owned reference that may write -- a `.borrow` field, a
# `with` alias, an `outx` result over a `.borrow` argument -- pins its source
# EXCLUSIVE, so the owner may not even read the source while it lives: the
# reference may write it, or free what it points at, under the reader
# (emitc_corpus/nonowned_reference_reads holds the reads that are allowed).
C: class {
    s: String.borrow
}

Bag: class {
    x: i64
}

D: class {
    b: Bag.borrow
}

Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {a: Src.borrow} outx W is {
    return (W s: a tag: 1)
}

count: function {s: String.view} out u64 is {
    return s.length
}

both: function {a: String.borrow n: u64} is {
    a.append "+"
    print "both: \{a} \{n}"
}

field: function is {
    src: "hello".string
    c: C s: src
    print "\{src.length} \{c.s}"
}

fieldValtype: function is {
    bag: Bag x: 7
    d: D b: bag
    v: bag.x
    print "\{v} \{d.b.x}"
}

alias: function is {
    src: "hello".string
    with w: src.borrow do {
        print "\{src} \{w}"
    }
}

outxResult: function is {
    x: Src n: 3
    w: mk a: x
    print "\{x.n} \{w.tag}"
}

main: function is {
    field
    fieldValtype
    alias
    outxResult
}
