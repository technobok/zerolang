# match_null_else_no_value -- a match whose `else` is `null` yields no value; binding it
# to a name is refused.
kind: variant {
    a: null
    b: null
}

tw: function {n: i64} out i64 is {
    return n * 2
}

k: function {v: kind} out i64 is {
    x: match v case a then 5 else null
    return x
}

main: function is {
    print "\{k v: kind.a} \{k v: kind.b}"
}
