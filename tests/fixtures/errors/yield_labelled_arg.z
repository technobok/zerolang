# E0034: `yield` is itself a call, so a labelled argument binds to YIELD rather
# than to the value being yielded -- the same trap `return` carries, and it
# earns the same sentence instead of a complaint about the bare callee.
mk: function {n: i64} out i64 is {
    return n
}

g: function out (Iterator Gives: i64) is {
    yield mk n: 1
}

main: function is {
    for x: g loop print "x: \{x}"
}
