# A generator's construction is GENERATED from its `is` fields, in order, with
# each parameter's ownership taken from the field it fills. Writing one by hand
# is refused rather than merged: the pass appends the generated `create` before
# the class resolves, so a hand-written one would collide with it -- as a C
# redefinition, which is not a diagnostic anyone can act on.
G: generator { n: i64 } as {
    create: function {n: i64} out this is {
        return (meta.create :n)
    }
    call: function out i64 is {
        yield this.n
    }
}

main: function is {
    for v: (G n: 1) loop print "v: \{v}"
}
