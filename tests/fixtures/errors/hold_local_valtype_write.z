# E0200: a `hold` binding of a VALTYPE is frozen too. `.hold` moves the value in
# and freezes it, in both families; a valtype leaf normally takes no lock, the
# read being a copy, but the binding is the value itself, so a field write
# through it is refused. `.copy` (or a plain binding) is the way out.
point: record { x: i64 y: i64 }

main: function is {
    p: point x: 1 y: 2
    h: p.hold
    h.x = 5
    print "\{h.x}"
}
