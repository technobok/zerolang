# E0100/E0300: a function reference in a static position names one function
# with a body, of the slot's signature, by name. A spec has no body; a native
# function, a generic one and a method are no single function a static value
# can hold; a call is never a static value; a function of another signature is
# refused, its return type included; a field declared by a spec has no default.
binop: function {a: i64 b: i64} out i64
unop: function {a: i64} out i64
add: function {a: i64 b: i64} out i64 is { return a + b }
neg: function {a: i64} out i64 is { return 0 - a }
less: function {a: i64 b: i64} out bool is { return a < b }
nat: function {a: i64 b: i64} out i64 is native
pick: function as { t: anyval.generic } in {a: t b: t} out t is { return a }
box: record { n: i64 } as {
    twice: function {:this a: i64 b: i64} out i64 is { return a + b }
}
op: data {
    f: binop
}
step: data {
    run: function {a: i64} out i64
}
op2: data {
    f: binop
    n: u8
}
a: (op f: binop)
b: (op f: neg)
c: (op f: nat)
d: (op f: pick)
e: (op f: box.twice)
g: (op2 n: 1)
h: (op f: (add a: 1 b: 2))
i: (op f: less)
j: (step run: less)
main: function is {
    print "x"
}
