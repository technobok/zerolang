# The sibling of arm_default_carries_payload.z on the PARAMETER side.
# docs/spec.pdoc Restrictions: "Defaulting to an arm that carries a non-null
# payload is rejected" -- a default names an arm, and cannot supply what the
# arm holds. The field side refused it; the parameter side recorded the default
# and carried on.
kind: variant {
    num: i64
    blob: null
} as { tag: u8.tag }

opt: function {k: kind.num} is {
    if k.blob then print "b" else print "n"
}

main: function is {
    opt k: kind.blob
}
