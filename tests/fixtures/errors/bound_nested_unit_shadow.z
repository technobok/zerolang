# A bound names the nearest declaration of its name: the nested unit's `wide`
# below admits i64 and u8, so an i32 is refused. The file unit's `wide`, which
# admits i32, answered instead.
wide: variant { :i64  :i32 }

x: unit {
    wide: variant { :i64  :u8 }

    twice: function as { t: wide.generic } in {v: t} out t is {
        return v + v
    }

    run: function out i32 is {
        return (twice v: 3.i32)
    }
}

main: function is {
    print "\{x.run}"
}
