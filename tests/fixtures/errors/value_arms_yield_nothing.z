# The value of a statement list is its last line's value, and a line that is a
# binding, a write or an exchange yields none: an `if` or a `match` used as a
# value whose arm ends on one, or whose arm is itself a value with an arm that
# yields nothing (`else null`), yields no value. A loop's value is its body's,
# so an `if` ending its body yields one type from both arms.
kind: variant {
    a: null
    b: null
}

num: function {k: i64} out i64 is {
    return k + 1
}

word: function {k: i64} out bool is {
    return k > 1
}

bindingArms: function {c: bool n: i64} out i64 is {
    k: if c then {
        x: n + 1
    } else {
        y: n + 2
    }
    return k
}

writeArm: function {v: kind n: i64} out i64 is {
    m: n
    k: match v case a then {
        m = 3
    } case b then {
        m + 1
    }
    return k
}

nestedNullArm: function {v: kind c: bool} out i64 is {
    x: if c then {
        match v case a then 5 else null
    } else 7
    return x
}

loopArmsDisagree: function {ys: (ListVal i64).view} out u64 is {
    xs: for each y: ys loop {
        if y > 2 then {
            num k: y
        } else {
            word k: 0
        }
    }
    return xs.length
}

main: function is {
    ys: ListVal i64
    print "\{bindingArms c: true n: 1} \{writeArm v: kind.a n: 1} \{nestedNullArm v: kind.a c: true} \{loopArmsDisagree :ys}"
}
