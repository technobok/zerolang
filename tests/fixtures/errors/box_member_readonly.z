# E0200: a Box's fields and methods are its element's, and a readonly Box is
# readonly all the way through: a field write, and a mutating method, through a
# `.view` Box parameter are refused as they are on the element itself.
big: record {
    a: i64
} as {
    grow: function {s: this.borrow by: i64} is {
        s.a = s.a + by
    }
}

peek: function {x: (Box t: big).view} out i64 is {
    x.a = 5
    x.grow by: 1
    return x.a
}

main: function is {
    bx: Box from: (big a: 3)
    print "\{peek x: bx}"
}
