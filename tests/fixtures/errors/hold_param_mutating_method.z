# E0200: `hold` is owned and readonly. The value moves in, so the caller gives
# it up, and it is frozen for the body -- a mutating method takes an exclusive
# receiver lock, which the readonly self-lock refuses.
Item: class {
    value: i64
} as {
    bump: function {:this} is { this.value = this.value + 1 }
}
keep: function {c: Item.hold} out i64 is {
    c.bump
    return c.value
}
main: function is {
    e: Item value: 5
    print "\{keep c: e.take}"
}
