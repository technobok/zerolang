# A unit-level call is checked as a body checks it, and only then asked for
# its value: an argument that does not fit its parameter is the body's error,
# a well-formed call that does not fold has no compile-time value, and an
# interpolated part must be printable. One mistake, one error.
K: 300.u64
N: 7
C: color.red
color: choice {
    red: null
    green: null
}
twice: function {n: i64} out i64 is { return n * 2 }
Compared: (N.compare rhs: 3)
CompareText: (N.compare rhs: "x")
Twice: (twice n: 2)
TwiceText: (twice n: "x")
Shown: "\{C}"
Narrowed: (K.u8.or d: 7)
main: function is {
    print "unreached"
}
