# for_each_split_pins_source.z -- `for each` over a string's `split` or `lines`
# hands out views into the string, so the string stays locked for the loop's
# body: reassigning it or appending to it there is refused, as writing a list
# inside a walk of it is.
main: function is {
    s: "a b c".string
    for each p: (s.stringView.split sep: " ") loop {
        s = "zzzz".string
        print p
    }
    t: "a\nb".string
    for each l: t.stringView.lines loop {
        t.append s: "zz"
        print l
    }
}
