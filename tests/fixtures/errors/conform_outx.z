# conform_outx.z -- a conformer declared `out` where its spec is `outx`. Text's stringView is
# `outx`, so a caller going through the protocol pins the source; an `out`
# implementation would hand back a view that pins nothing.
Label: class { data_: String } as {
    :Text
    stringView: function {m: this.view} out StringView is {
        return m.data_.stringView
    }
}

main: function is {
    l: Label data_: "hello".string
    print l
}
