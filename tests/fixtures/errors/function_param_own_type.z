# A parameter typed by its own function, or by a function that is typed by
# this one, has a signature with no end. A mismatch at such a parameter is
# reported with the inner one spelled by its name; rendering it used to
# recurse until the stack ran out.

# consume -- takes a function shaped like itself
consume: function {s: consume} out u64 is { return 1 }

# f -- takes a g
f: function {s: g} out u64 is { return 1 }

# g -- takes an f
g: function {s: f} out u64 is { return 1 }

main: function is {
    print "\{consume s: 5} \{f s: 5}"
}
