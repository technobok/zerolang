# A generator hands out its elements with `yield`. One whose `call` holds none
# is refused; it used to stop the compiler with an internal panic once
# something walked it.

# Empty -- a generator with nothing to hand out
Empty: generator { lo: i64 } as {
    call: function out i64 is {
        i: this.lo
    }
}

main: function is {
    for each v: (Empty lo: 1) loop print "\{v}"
}
