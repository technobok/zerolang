# A name nothing defines is an unknown reference where it is an arm's payload
# and where it is what a `yield` hands out, as it is anywhere a value is read.
# Both were accepted, and the name reached the C.

# Words -- yields a name nothing defines
Words: generator as {
    call: function out String is {
        yield scopy
    }
}

# U -- an arm with a payload
U: union {
    a: i64
    b: null
}

# wide -- arms that take a payload of their own name's type
wide: variant { :f64 :f128 }

main: function is {
    u: U.a nosuch
    w: wide.f64 length
    for each s: Words loop print s
}
