# E0300: a method called through a protocol takes a value of the protocol as
# its receiver, which it dispatches on. A Sq stands in for a Shape where a
# Shape is passed, but as a receiver it is not converted: `q.area` calls the
# Sq's own member.
Shape: protocol {
    area: function {s: this.view} out i64
}

# Sq -- a square implementing Shape
Sq: record {
    side: i64
} as {
    shape: Shape.implement
    area: function {s: this.view} out i64 is {
        return s.side * s.side
    }
}

main: function is {
    q: Sq side: 3
    print "\{Shape.area q}"
}
