# A constant `.get K` reads its element through the declaration, so a K the
# block does not hold is an error where it is written -- in a body and in a
# unit-level definition alike -- rather than a read past the array at run time.
codes: list { 10 20 30 } out list u8
LAST: 3
X: codes.get -1

main: function is {
    print "\{codes.get 3} \{codes.get LAST} \{X}"
}
