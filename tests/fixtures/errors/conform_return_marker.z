# conform_return_marker.z -- a conformer whose return marker differs from the spec's.
Holder: protocol {
    get: function {b: this.borrow} outx String.borrow
}

Box: class { s: String } as {
    :Holder
    get: function {b: this.borrow} outx String.view is { return b.s }
}

main: function is {
    b: Box s: "x".string
    print "\{b.s}"
}
