# sig_unknown_type.z -- a signature typeref naming a nonexistent type is an
# error. The signature is resolved because the call demands the function, which
# is what makes this a diagnostic at all: the compiler spends time on what the
# root reaches. Before the demand root the function was checked whether anything
# called it or not, and this fixture asserted that.
deadfn: function {a: NoSuchType} is {
    print "x"
}

main: function is {
    deadfn a: 1
    print "ok"
}
