# E0200: an `outx` result pinning a valtype TEMPORARY is a borrowed binding, so
# it cannot be reassigned in an inner block to a view of a temporary that dies
# there -- the String twin was always refused the same way.
headView: function {s: (str to: 8).view} outx StringView is {
    return s.stringView
}

mk: function {n: i64} out (str to: 8) is {
    if n > 0 then return ("pos".str to: 8)
    return ("neg".str to: 8)
}

main: function is {
    v: headView s: (mk n: 1)
    {
        v = headView s: (mk n: -1)
    }
    print "\{v}"
}
