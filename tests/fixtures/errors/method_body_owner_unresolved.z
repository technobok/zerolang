# E0100: a method body is checked against its owner's DECLARED return type even
# when nothing references the owner. Before outside-in resolution the class was
# never minted, `this` typed as notype, and the return check silently stopped
# asking -- this body was accepted.
Gadget: class {
    n: u64
} as {
    isPositive: function {:this} out bool is {
        return 5.u64
    }
}

main: function is {
    g: Gadget.create n: 1.u64
    print "widget \{g.isPositive}"
}
