# A FUNCTION IS NOT A PRINTABLE VALUE. A function reference in an interpolation
# -- a copy of a local holding one, or a `.take` written in place -- printed the
# function's address as an integer. (The local read bare is a CALL, and `add`
# needs arguments: that is refused as a call missing them.)
add: function {a: i64 b: i64} out i64 is {
    return a + b
}

Dial: class {
    level: i64
    zero: function out i64 is {
        return 0
    }
}

main: function is {
    d: Dial level: 2
    f: add.copy
    print "\{f.copy}"
    print "\{f}"
    print "\{d.zero.take} \{add.copy}"
}
