# private_view_to_borrow.z -- a `.private.view` handle does not become a
# `.private.borrow` one by forwarding it (E0200).
Bag: class { a: i64 } as {
    public: unit { :lend }
    lend: function {:this} out i64 is { return (friend h: this.private) }
    bump: function {:this} is { this.a = this.a + 1 }
}

friend: function {h: Bag.private.view} out i64 is { return (inner h: h.private) }

inner: function {h: Bag.private.borrow} out i64 is {
    h.a = 1
    return h.a
}

main: function is {
    b: (Bag a: 5)
    print "\{b.lend}"
}
