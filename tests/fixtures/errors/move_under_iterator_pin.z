# E0200: and under an iterator's pin -- moving a container out from under its
# own live iterator. The pin is readonly, which still forbids the move.
main: function is {
    xs: (List String)
    xs.append from: "a".string
    with it: xs.iterate do for e: it loop {
        g: xs.take
        print "g=\{g.length}"
    }
}
