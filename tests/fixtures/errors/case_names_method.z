# A `case` names one of the subject's arms -- the set an exhaustive match
# covers. A method of the sum is a member of it but no arm, whether the sum is
# a union, a generic union or a variant.
Val: union {
    text: String
    none: null
} as {
    show: function {v: this.view} out i64 is { return 1 }
}

Res: union {
    good: t
    bad: String
} as {
    t: anyval.generic
    isGood: function {r: this.view} out bool is {
        match (r) case good then return true case bad then return false
    }
}

kd: variant {
    k: i64
    z: null
} as {
    getn: function {u: this.view} out i64 is {
        match (u) case k then return u case z then return 0
    }
}

main: function is {
    u: Val.text "u".string
    match u case show then print "m" else print "e"
    r: (Res t: i64).good 3
    match (r) case isGood then print "g" else print "b"
    v: kd.k 4
    match (v) case getn then print "n" else print "z"
}
