# an arm is constructed on the union or variant that declares it; a typedef
# over it is built from that value. `ShapeAlias.sq 4` read the base's arm
# through the typedef and was accepted.
Shape: union {
    sq: (Box u64)
    name: String
}
ShapeAlias: typedef Shape
main: function is {
    s: ShapeAlias.sq 4
    print "\{s.sq}"
}
