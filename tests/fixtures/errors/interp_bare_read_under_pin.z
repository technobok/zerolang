# E0200: a bare name spliced into an interpolation is a READ of its storage,
# refused while another variable holds an exclusive pin on it -- as a field
# read (`\{c.s}`) and a method read (`s.length`) are.
sid: typedef String
main: function is {
    s: "hello".string
    k: sid.create from: s.borrow
    print "after: \{s} \{k}"
}
