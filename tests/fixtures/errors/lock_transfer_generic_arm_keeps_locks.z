# A generic arm payload (`Option.some w`, whose instance the payload decides)
# keeps the locks of the value it stores, bare or taken, as a concrete union
# arm does: writing the source while `o` lives is refused.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

main: function is {
    a: Src n: 1
    w: mk from: a
    o: Option.some w.take
    a.n = 5
    match (o) case some then print "\{o.tag}" else print "none"
}
