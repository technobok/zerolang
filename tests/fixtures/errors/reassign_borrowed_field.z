# E0200: a non-owned field is set at construction and cannot be reassigned.
# The bare `x` on the right is a borrow, which is what such a field holds, so
# the field rule is the one refusal.
thing: class { v: String }
holder: class {
    item: thing.borrow
} as {
    create: function {item: thing.borrow} out this is {
        return (meta.create item: item)
    }
}
g: function {h: holder x: thing} is {
    h.item = x
}
main: function is {
    t: thing v: "z".string
    hl: holder item: t
    g h: hl x: t
}
