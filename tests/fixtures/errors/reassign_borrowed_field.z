# E0200: a non-owned field is set at construction and cannot be reassigned.
#
# The second diagnostic is not noise: a bare name on the RHS is a MOVE, and
# there is no bare spelling that borrows instead -- `x.borrow` does not emit --
# so the move is real and worth reporting. The field rule
# still fires first, which is what this fixture is for.
thing: class { v: String }
holder: class {
    item: thing.borrow
} as {
    create: function {item: thing.borrow} out this is {
        return (meta.create item: item)
    }
}
g: function {h: holder x: thing} is {
    h.item = x
}
main: function is {
    t: thing v: "z".string
    hl: holder item: t
    g h: hl x: t
}
