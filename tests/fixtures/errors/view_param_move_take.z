# E0200: a `view` parameter is readonly, so `.take` cannot move it out. It is
# also not owned, so the move has nothing to give: the emitter builds a value
# from the parameter's pointer and the C does not compile.
Inner: class {
    n: i64
}
peek: function {c: Inner.view} is {
    g: c.take
    print "n=\{g.n}"
}
main: function is {
    i0: Inner n: 1
    peek c: i0
}
