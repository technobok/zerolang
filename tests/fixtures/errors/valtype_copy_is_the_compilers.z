# A VALUE TYPE'S `.copy` IS THE COMPILER'S BYTE COPY. A value type holds no
# reftype, so copying its bytes copies the whole value: the copy is always
# complete, costs what a move costs, and can be neither written in the `as`
# block nor struck off with `copy: null` -- for a record or a variant alike. A
# value that must never be duplicated -- a file descriptor -- owns something,
# and is a class. (A class has no default copy; its author writes one.)
Handle: record {
    fd: i32
} as {
    copy: null
}

Tagged: record {
    n: i64
} as {
    copy: function {t: this} out Tagged is {
        return (Tagged n: t.n + 100)
    }
}

shade: variant {
    red: null
    grey: i64
} as {
    copy: function {s: this} out shade is {
        return s
    }
}

main: function is {
    h: Handle fd: 3
    t: Tagged n: 1
    s: shade.grey 2
    print "\{h.fd} \{t.n} \{s.grey}"
}
