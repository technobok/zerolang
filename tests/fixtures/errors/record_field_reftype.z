# E0100: a valtype holds value data only. A record field may not be a reftype
# -- a heap native, a user class (declared after the record: resolution is on
# demand), a view, a collection mono or a union. The synthesised `==` and
# hash read the value's bytes, and a member behind a pointer has none to
# read. Make the type a class; a valtype that must live on the heap is a
# `Box from:` local.
r1: record { s: String }
r2: record { c: C }
r3: record { sv: StringView }
r4: record { xs: (ListVal u64) }
r5: record { o: (Option String) }
C: class { n: i64 }

main: function is {
    a: ListVal r1
    b: ListVal r2
    c: ListVal r3
    d: ListVal r4
    e: ListVal r5
    print "\{a.length} \{b.length} \{c.length} \{d.length} \{e.length}"
}
