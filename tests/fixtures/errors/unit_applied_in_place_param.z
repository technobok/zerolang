# A parameter typed by a member of a unit applied in place is that member's
# type: a field it does not declare is refused, and so is a return of the wrong
# type. The type-ref used to reach no resolver, the parameter was typed as
# nothing, and both went through to the C compiler.
cells: unit as {
    t: anyval.generic
    Cell: record {
        val: t
    }
}

missing: function {x: (cells t: i64).Cell} out i64 is {
    return x.nope
}

wrong: function {x: (cells t: i64).Cell} out String is {
    return x.val
}

main: function is {
    k: (cells t: i64).Cell val: 10
    print "\{missing x: k} \{wrong x: k}"
}
