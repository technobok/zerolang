# A numeric generic parameter has its bound's type, in the template walk as in
# every instance: it was "Unknown reference", and it is not storage to write.
Buffer: class {
    used: u32
    name: function {:this} out String is {
        return cap
    }
    grow: function {:this} is {
        cap = 3
    }
} as { cap: u32.generic }

main: function is {
    b: (Buffer cap: 8) used: 0
    b.grow
    b.cap = 4
    print "\{b.name}"
}
