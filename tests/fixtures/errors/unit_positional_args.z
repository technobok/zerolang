# A call takes at most one unlabelled argument, at unit level as in a body: a
# second written without its name makes three paths, the operator form, and a
# numeric literal is no operator. Both positions report the grammar.
pt: data {
    x: i64
    y: i64
}
R: (pt 9 4)
main: function is {
    q: (pt 9 4)
    print "unreached"
}
