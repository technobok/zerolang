# An `outx` function's body could store a value its `.take` parameter takes
# wherever it can write -- here a list its `.borrow` parameter lends -- so the
# value's locks cannot follow it into the result: the list would keep a W over
# `a` past `a`'s scope. A lock-holding value is refused at a bodied function's
# `.take` parameter.

W: class {
    xs: (ListVal i64).borrow
}
stash: function {dst: (List W).borrow w: W.take from: (ListVal i64).view} outx u64 is {
    dst.append w
    return from.length
}
main: function is {
    keep: List W
    {
        a: ListVal i64
        a.append 7
        b: ListVal i64
        r: stash dst: keep w: (W xs: a) from: b
        print "\{r}"
    }
    v: keep.get i: 0
    print "\{v.xs.get i: 0}"
}
