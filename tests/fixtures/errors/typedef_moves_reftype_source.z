# E0200: a typedef's `create from:` of a `.take` source CONSUMES a reftype --
# the payload is owned, so the name no longer holds it. Unmarked and bound to a
# name it borrows the source instead. The valtype case copies and is pinned by
# emitc_corpus/typedef_create_valtype.
sid: typedef String

main: function is {
    s: "hello".string
    k: sid.create from: s.take
    print "after: \{s}"
}
