# E0200: a typedef's `create from:` CONSUMES a reftype source -- the payload is
# owned, so the name no longer holds it. The valtype case is the opposite and
# is pinned by emitc_corpus/typedef_create_valtype. The wrapper is a class:
# a record holds value data only.
sid: class { val: String.typedef }

main: function is {
    s: "hello".string
    k: sid.create from: s
    print "after: \{s}"
}
