# E0300: a parameter typed by a SPEC, a function with no body, is required:
# a spec names a type and has no value to default to. The parameter took the
# spec itself as its default, and a call that left it out compiled to C that
# named a function nothing declares.
Op: function out i64

apply: function {f: Op} out i64 is {
    return f
}

main: function is {
    print "\{apply}"
}
