# E0200: a mutating method on a VALTYPE takes an exclusive receiver lock, which a
# `view` parameter's readonly self-lock refuses -- exactly as it does for a
# class. Before valtype receivers locked, this call was accepted, gcc warned
# about the discarded qualifier, and the caller's record was written through
# the view.
point: record {
    x: i64
} as {
    poke: function {:this by: i64} is {
        this.x = this.x + by
    }
    peek: function {t: this.view} out i64 is {
        return t.x
    }
}
reader: function {p: point.view} out i64 is {
    p.poke by: 98
    return p.peek
}
main: function is {
    q: point x: 1
    r: reader p: q
    print "\{r} \{q.x}"
}
