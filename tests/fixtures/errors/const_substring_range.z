# E0600: a constant `substring` outside the string. The run-time native panics
# rather than clamping, so the compile-time answer is that there is no value.
LIB: "quadmath"
BAD: (LIB.substring from: 0 to: 99) == "x"
main: function is {
    if BAD then {
        print "a"
    } else {
        print "b"
    }
}
