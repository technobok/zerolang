# A data block is compile-time data: its elements and its length fold to
# constants, and only `.array` and `.index` put the block in the program. Neither
# the block nor an element names storage, so a marker on either is refused, and
# the block itself is not a value to bind or to state. `w: primes` stopped at the
# emitter, `primes.0.take` spelled the marker as a literal suffix, and
# `primes.0.borrow` was accepted.
primes: data { 2 3 5 7 }
codes: data {
    ht: 9
    lf: 10
} out u8

main: function is {
    a: primes.take
    b: primes.borrow
    c: primes.0.take
    d: primes.0.borrow
    e: codes.ht.hold
    w: primes
    primes
    with v: primes do print "x"
    for p: primes loop print "y"
    print "\{c} \{d} \{e}"
}
