# A data block's name is a value -- a view of its static array -- but neither
# the block nor an element names storage, so a marker on either is refused.
# `primes.0.take` spelled the marker as a literal suffix, and `primes.0.borrow`
# was accepted. The name written alone as a statement does nothing, and is
# refused too.
primes: data { 2 3 5 7 }
codes: data {
    ht: 9
    lf: 10
} out u8

main: function is {
    a: primes.take
    b: primes.borrow
    c: primes.0.take
    d: primes.0.borrow
    e: codes.ht.hold
    primes
    print "\{c} \{d} \{e}"
}
