# A lock-holding value cannot be appended to a container, even one declared
# after the source in an inner scope: the container could later hand the value
# out (`pop`) without the lock, free to outlive what it points into.
# Refused -- copy.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

main: function is {
    a: Src n: 1
    {
        xs: (List W)
        w: mk from: a
        xs.append w
        print "held: \{xs.length}"
    }
    a.n = 5
    print "after: \{a.n}"
}
