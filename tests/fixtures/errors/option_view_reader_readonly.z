# option_view_reader_readonly.z -- a reader that takes its container `.view`
# hands back an OptionView, whose `some` is a READONLY view: writing through it
# is refused, for a Map and an IdMapR alike. `getMut` is the writable twin.

Box: class {
    # the value written
    n: i64
}

main: function is {
    m: (Map String V: Box)
    m.set key: "a".string value: (Box n: 1)
    {
        g: m.get key: "a".string
        match (g) case some then g.n = 13 case none then null
    }
    ids: (IdMapR u64 V: Box)
    ids.set key: 3 value: (Box n: 5)
    {
        h: ids.get key: 3
        match (h) case some then h.n = 99 case none then null
    }
}
