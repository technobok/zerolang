# A unit-level call binds its arguments as a body's call does, and is refused
# for the same reasons: a parameter given twice, the receiver supplied by the
# dot and again by its label. Each folded anyway, to the first value given.
G: "abc"
A: (G.byteAt 1 i: 2)
B: (G.byteAt t: G i: 1)
main: function is {
    print "\{A.or d: 0} \{B.or d: 0}"
}
