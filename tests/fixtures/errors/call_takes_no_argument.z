# An argument written after something that takes none is refused where it
# stands: a unit's name, `null`, and a function with no parameters
# reached through a unit -- a user's or a native one, the argument labelled or
# not. Each was accepted by the check: the first two reached the emitter as
# a call it could not write, and the last compiled, the argument dropped.
# `meta` is call_meta_argument.

# u -- a unit with a function that takes nothing
u: unit {
    # one
    one: function out i64 is { return 1 }
}

main: function is {
    io 5
    null 5
    a: u.one 5
    b: os.pid 5
    c: os.pid x: 5
    print "\{a} \{b} \{c}"
}
