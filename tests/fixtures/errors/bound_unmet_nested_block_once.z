# bound_unmet_nested_block_once -- one statement reports one unmet bound per failing
# argument, also when a nested block (an `if` value's arm) is walked between the two
# instantiations.
Box: class {
    v: T
} as {
    T: AnyRef.generic
}

Cup: class {
    v: T
} as {
    T: AnyRef.generic
}

main: function is {
    print "start"
    n: ((Box T: i64) v: 5).v + (if true then {
            q: 2
            q
        } else 3) + ((Cup T: i64) v: 6).v
    print "\{n}"
}
