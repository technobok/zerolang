# A take in an `if` arm still consumes the outer local, whether the take comes
# before a shadow of its name, after a shadowing block has closed, or beside a
# shadow in the other arm: the declaration taken is the outer one.
main: function is {
    c: 3 > 2
    a: "a".string
    if c then {
        t: a.take
        a: 5
        print "\{t} \{a}"
    }
    print "\{a}"
    b: "b".string
    if c then {
        {
            b: 5
            print "\{b}"
        }
        t2: b.take
        print "\{t2}"
    }
    print "\{b}"
    d: "d".string
    if c then {
        d: 5
        print "\{d}"
    } else {
        t3: d.take
        print "\{t3}"
    }
    print "\{d}"
}
