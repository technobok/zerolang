# match_else_write_ends_narrowing -- A write to the subject in a match's `else` that
# completes ends the narrowing the diverging arms leave: after the match the subject can
# hold any arm again.
Shape: union {
    text: String
    num: i64
    none: null
}

shape: function {k: i64} out Shape is {
    if k == 0 then return (Shape.text "hello".string)
    if k == 1 then return (Shape.num 4)
    return Shape.none
}

f: function {k: i64} out i64 is {
    u: shape :k
    match u case text then return 1 else {
        u = shape k: 0
    }
    match u case num then return 2 case none then return 3
}

main: function is {
    print "\{f k: 0} \{f k: 1} \{f k: 2}"
}
