# private_view_mutating_call.z -- a `.private.view` handle is readonly: a friend may not
# call a method that writes the receiver (E0200).
Bag: class { a: i64 } as {
    public: unit { :lend }
    lend: function {:this} out i64 is { return (friend h: this.private) }
    bump: function {:this} is { this.a = this.a + 1 }
}

friend: function {h: Bag.private.view} out i64 is {
    h.bump
    return h.a
}

main: function is {
    b: (Bag a: 5)
    print "\{b.lend}"
}
