# A `for` element locks the iterator it came from in the called header form
# too (`for f: jt.call`), as for_element_locks_iterator shows for the named
# form: reassigning the iterator while the element lives is refused.
main: function is {
    xs: List String
    xs.append "a".string
    ys: List String
    ys.append "c".string
    with jt: xs.iterate do {
        for f: jt.call loop {
            jt = ys.iterate
            print f
        }
    }
}
