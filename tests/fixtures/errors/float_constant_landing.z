# AN UNTYPED NUMBER LANDS IN A FLOAT TYPE AS ITS NEAREST VALUE, but not as an
# infinity and not as a zero it is not: each refusal names the destination,
# whether the type is a conversion's, a parameter's or the f64 default.

# takes an f32
eat: function {x: f32} is {
    print "\{x}"
}

main: function is {
    a: 1e39.f32
    b: 1e-50.f32
    c: 70000.f16
    d: 1e400
    e: 1e-400
    eat x: 1e300
    eat x: 1e-300
    print "\{a} \{b} \{c} \{d} \{e}"
}
