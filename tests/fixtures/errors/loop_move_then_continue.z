eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
nope: function out bool is {
    return false
}
# `continue` ends the iteration and starts the next one: the move reaches it.
main: function is {
    e: (ListVal u32)
    e.append 1
    n: 0
    for while n < 3 loop {
        n = n + 1
        if (eat xs: e) then continue
        print "no"
    }
}
