# An `out` function whose body ends on a control construct some path falls out
# of returns nothing on that path: refused, pointing at the construct.

Pick: union {
    a: u32
    b: u32
}

ifNoElse: function {k: bool} out u32 is {
    if k then return 1
}

runtimeLoop: function {k: bool} out u32 is {
    for k loop {
        return 2
    }
}

bareLoopBreak: function {k: bool} out u32 is {
    for loop {
        if k then break
    }
}

withDoBreak: function {k: bool} out u32 is {
    with z: 1.u32 do {
        if k then break
        return z
    }
}

matchFallsThrough: function {p: Pick} out u32 is {
    match (
        p
    ) case a then {
        return 3
    } else {
        print "no return"
    }
}

deadLoop: function out u32 is {
    for false loop {
        return 4
    }
}

# each instance answers for itself: this one folds past the `return`
Sized: class {
    used: u32
    get: function {:this} out u32 is {
        if cap == 0 then return 5
    }
} as { cap: u32.generic }

main: function is {
    full: (Sized cap: 8) used: 0
    print "\{full.get}"
    print "\{ifNoElse k: true}"
    print "\{runtimeLoop k: true}"
    print "\{bareLoopBreak k: true}"
    print "\{withDoBreak k: true}"
    print "\{matchFallsThrough p: (Pick.a 0)}"
    print "\{deadLoop}"
}
