# A data block comes with its own members already defined -- `length` its
# element count, `index` its run-time element read, `array` its copy into a
# sized array, as `tag` its discriminator -- so an element of one of those
# names is a second definition of the name, refused where it is written.
# Before, `codes.length` read such an element while `codes.array` copied the
# block and left its element unreadable.
codes: data { length: 9  index: 3  array: 1  other: 2 }

main: function is {
    print "o=\{codes.other}"
}
