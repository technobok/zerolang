# A bound's family is the system's declaration of that name, so a program's
# own `anyval` or `u32` is that program's type when it bounds a parameter: a
# record, which has no `.generic`. Both were read by their names as the family
# (any value type; a u32 compile-time value), and the bound check passed them.
anyval: record {
    n: i64
}

u32: record {
    n: i64
}

Wrap: record {
    v: t
} as {
    t: anyval.generic
}

Num: record {
    v: w
} as {
    w: u32.generic
}

main: function is {
    a: Wrap t: i64 v: 3
    b: Num w: 4 v: 4
    print "\{a.v} \{b.v}"
}
