# A reftype field bound to a local is a second name for the field -- a field is
# always borrowed, whatever owns its parent -- so the binding pins the field's
# path for its scope: a write to the field, a move out of it and a mutating
# method on its owner are refused while the binding lives.
Holder: class {
    p: String
    q: String
} as {
    reset: function {:this} is {
        this.q = "reset".string
    }
}

writeField: function {h: Holder} is {
    r: h.p
    h.p = "new".string
    print r
}

moveField: function {h: Holder} is {
    r: h.p
    x: h.p.take
    print r
    print x
}

mutateOwner: function {h: Holder} is {
    r: h.p
    h.reset
    print r
}

main: function is {
    h: Holder p: "hp".string q: "hq".string
    writeField :h
    moveField :h
    mutateOwner :h
}
