# A generic parameter stands for one type, which takes no type arguments,
# whichever declaration owns it: a free function's own parameter (`a: t t`), a
# return (`out t i64`, a method's `out t t`) and an argument of another
# application (`(ListVal (t t))`) are refused as a class's field is.
#
# They were not. A free function's signature resolves in the unit's scope,
# where its own parameters are no names, so `t t` named a shell, `t_t`: the
# call said "cannot infer generic parameter 't'", or with `t: i64` written
# "got t_t". A return of one typed nothing, and the call said its expression
# "produces no value".
pick: function as { t: anyval.generic } in {a: t t} out t is {
    return a
}

wrap: function as { t: anyval.generic } in {a: t} out t i64 is {
    return a
}

count: function as { t: anyval.generic } in {xs: (ListVal (t t)).view} out u64 is {
    return xs.length
}

Cell: class { v: t } as {
    t: anyval.generic
    get: function {:this} out t t is { return this.v }
}

main: function is {
    xs: ListVal i64
    c: Cell i64 v: 4
    print "\{pick a: 1} \{wrap a: 2} \{count :xs} \{c.get}"
}
