# A call with arguments needs a FUNCTION for its callee. A value -- a local, a
# field read, an arm predicate -- takes no parameters, so its first argument is
# refused where it stands, whatever the value's type. Each of these reached the
# emitter as a callee it could not spell. A function-typed local or field is a
# function and is called as one.
slot: variant {
    full: t
    empty: null
} as { t: anyval.generic }

SI: (slot t: i64)

Pt: class {
    n: i64
    s: String
    l: List String
    hook: function {a: i64 b: i64} out i64
} as {
    poke: function {:this} out i64 is {
        return (this.n 3)
    }
}

pr: record {
    x: i64
}

add: function {a: i64 b: i64} out i64 is {
    return a + b
}

localCalled: function is {
    x: 5
    a: x 3
    b: (x n: 3)
    s: "abc".string
    c: s 3
}

fieldCalled: function {p: Pt r: pr} is {
    a: p.n 3
    b: p.s 3
    c: (p.l n: 3)
    d: (r.x 1)
}

predicateCalled: function is {
    v: SI.empty
    a: v.full 4
    b: (v.full n: 4)
}

functionsAreCalled: function {p: Pt} out i64 is {
    f: add.take
    return (p.hook a: 1 b: 2) + (f a: 3 b: 4)
}

main: function is {
    localCalled
    p: (Pt n: 1 s: "a".string l: (List String) hook: add.take)
    fieldCalled :p r: (pr x: 1)
    print "\{p.poke}"
    predicateCalled
    print "\{functionsAreCalled :p}"
}
