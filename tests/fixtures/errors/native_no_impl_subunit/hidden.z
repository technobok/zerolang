# a SUBUNIT declaring an unbacked native. A subunit is not in the program's
# unit table -- lib/system/system/wideint.z is this shape -- so the walk over
# that table cannot reach it and the declaration check has to descend. Its
# members key under the PARENT unit's name, which is why the expected path
# below says native_no_impl_subunit and not hidden.
spirit: function {n: i64} out i64 is native

value: function out i64 is {
    return 7
}
