# A NEGATIVE NUMERIC GENERIC ARGUMENT IS NAMED AS THE PROGRAM WRITES IT: an
# instance of a parameter with a signed bound is `(irec n: -5)` in every
# message that names it, and a dissection with no case for it says "-2".
irec: record {
    x: i64
    stored: n
} as {
    n: i64.generic
}

Shift: class {
    used: i64
    only: function {:this} out StringView is {
        match by case 1 then {
            return "one"
        }
    }
} as { by: i64.generic }

main: function is {
    r: (irec n: -5) x: 1
    print "\{r.n}"
    s: (irec n: -5) x: 1 stored: -5
    print "\{s.x}"
    t: (Shift by: -2) used: 0
    print "\{t.only}"
}
