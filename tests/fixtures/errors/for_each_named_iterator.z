# `for each` EVALUATES ITS VALUE ONCE, AND A BARE ITERATOR IS A CALL. A
# variable holding an iterator, read bare, is called -- once, since `for each`
# evaluates its value once -- and what it answers is an option, which has no
# walk. A named iterator is walked by the plain binding, which calls it every
# iteration: `with it: xs.iterate do for x: it loop`. (A marker keeps the
# iterator itself: `for each x: it.borrow`.)
Ticks: class {
    n: i64
} as {
    call: function {:this} out optionval i64 is {
        if this.n >= 3 then return (optionval.none i64)
        this.n = this.n + 1
        return (optionval.some this.n)
    }
}

main: function is {
    xs: ListVal i64
    xs.append 1
    with it: xs.iterate do for each x: it loop print "\{x}"
    t: Ticks n: 0
    for each y: t loop print "\{y}"
}
