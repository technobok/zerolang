# A generator's local moved into a call is gone for the rest of the body, as any
# local's move is: a read of it after the call -- here past a suspension -- is
# refused, not read as the empty value the move left behind.
keep: function {s: String.take} out u64 is {
    return s.length
}

Gen: generator as {
    call: function out u64 is {
        s: "gen".string
        yield (keep s: s)
        yield s.length
    }
}

main: function is {
    for v: Gen loop print "gen \{v}"
}
