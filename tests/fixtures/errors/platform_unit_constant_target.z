# platform_unit_constant_target.z -- a unit-level constant folds the platform
# the build is FOR: under --target x86_64-w64-mingw32 the windows branch is the
# one selected, and the `error` in it is the program's to hear. The previous
# compiler could not fold `platform.os` here at all (E0600).
BACKEND: if platform.os.windows then {
    error "this program has no Win32 backend"
} else {
    "posix"
}

main: function is { print "\{BACKEND}" }
