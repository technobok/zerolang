# A generic parameter's default is a member of its constraint, and is checked
# where it is written: a name that is no type, a chain of defaults that names
# itself, and a type the bound does not admit are each refused at the default
# (once), and the instantiation that asked stops there. A parameter with no
# default is still refused where nothing names it, in a type position too.
A: class { n: u8 } as {
    t: (anyval.generic default: Nope)
}

B: class { n: u8 } as {
    t: (anyval.generic default: e)
    e: (anyval.generic default: t)
}

C: class { n: u8 } as {
    t: (anyval.generic default: String)
}

D: class { n: u8 } as {
    t: (anyval.generic default: i64)
    e: anyval.generic
}

use: function {d: D} out u8 is {
    return d.n
}

main: function is {
    a: A n: 1
    b: B n: 2
    c: C n: 3
    d: D n: 4
    print "\{a.n} \{b.n} \{c.n} \{d.n} \{use :d}"
}
