# A local taken in any arm of a `match` is consumed after it, and a sibling
# arm's own later statement still sees its own take.
Mode: variant {
    fast: null
    slow: null
}

main: function is {
    m: Mode.fast
    o: "x".string
    match (
        m
    ) case fast then {
        t: o.take
        print "\{t}"
    } case slow then {
        print "\{o}"
    }
    print "\{o}"
    p: "y".string
    match (
        m
    ) case fast then {
        q: p.take
        print "\{q} \{p}"
    } else null
}
