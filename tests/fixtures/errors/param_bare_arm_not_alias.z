# The negative half of const_name_param_default.z, and the line docs/spec.pdoc
# draws: a null-payload subtype default may be spelled `<Type>.<subtype>`, or as
# "a bare name that is a unit-level alias of such a subtype" -- and "a bare name
# that is not such an alias still cannot stand in for a subtype".
#
# `quiet` is an arm, not an alias. An arm lives in its sum's namespace and no
# unit declares it, so the fold that answers for `false`, and for a user's own
# `hush: mode.quiet`, is asked here too and has nothing to say. What is left is
# what was always true of a name nothing declares: it is unknown, reported where
# it was written, and the parameter it was meant to type stays required.
mode: variant {
    quiet: null
    loud: null
}

f: function {m: quiet} is {
    if m.loud then print "loud" else print "quiet"
}

main: function is {
    f
}
