# A BARE `Type.arm` IS A TAG, and a tag is the whole value only for an arm that
# carries nothing. With no argument to fill it, an arm that carries something
# has nothing to build: the emitter falls through its tagged-read leg to the
# raw-name fallback and spells the TYPE into the C (`z_v1 = U.a`), which no C
# compiler accepts.
#
# `Type.arm` is ONE PATH whether an argument follows it or not, so the read
# cannot tell a construction from a bare read on its own -- only the callable
# walk knows a call is coming. That is why `Mixed.count 7` below is a value and
# `Mixed.count` is not.
Mixed: variant {
    count: i64
    none: null
}

Payload: union {
    text: String
    empty: null
}

want: function {m: Mixed} out i64 is {
    match (
        m
    ) case count then {
        return m
    } case none then {
        return -1
    }
}

main: function is {
    # an arm that carries nothing is a value in every position
    ok1: Mixed.none
    match (ok1) case count then print "count" case none then print "none"
    print "want=\{want m: Mixed.none}"

    # supplying the payload is what makes the arm a value
    ok2: Mixed.count 7
    match (ok2) case count then print "count=\{ok2}" case none then print "none"
    ok3: Payload.text "hi".string
    match (ok3) case text then print "text=[\{ok3}]" case empty then print "empty"

    # neither of these supplies one
    bad1: Mixed.count
    match (bad1) case count then print "count" case none then print "none"
    bad2: Payload.text
    match (bad2) case text then print "text" case empty then print "empty"

    # nor does this, in argument position
    print "want=\{want m: Mixed.count}"
}
