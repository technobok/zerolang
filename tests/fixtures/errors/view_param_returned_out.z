# view_param_returned_out.z -- a view parameter returned through a plain `out`
# hands the caller a view it cannot see is still of what it passed: the caller
# could free the String while the result lives. A function returning its view
# parameter is `outx`, as one returning a slice of it is.
first: function {s: StringView} out StringView is {
    return s
}

main: function is {
    h: "abc".string
    v: first s: h.stringView
    print v
}
