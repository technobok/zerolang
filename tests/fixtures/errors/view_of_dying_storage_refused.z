# A view derived from a view reads the first one's source: when that source is
# a local, or a value no name holds, it dies with the call and the view cannot
# be returned; a view of a parameter needs `outx`.
mks: function {n: i64} out String is {
    return "made \{n}"
}

ofLocal: function out StringView is {
    s: "local".string
    v: s.stringView
    return (v.substring from: 0 to: 2)
}

ofLocalOutx: function {p: String.view} outx StringView is {
    s: "local".string
    v: s.stringView
    w: v.substring from: 0 to: 2
    return w
}

ofTemp: function {p: String.view} outx StringView is {
    return ((mks n: 1).stringView.substring from: 0 to: 2)
}

viewOfParamOut: function {p: String.view} out StringView is {
    a: p.stringView
    return (a.substring from: 0 to: 1)
}

main: function is {
    p: "param".string
    print "\{ofLocal} \{ofLocalOutx :p} \{ofTemp :p} \{viewOfParamOut :p}"
}
