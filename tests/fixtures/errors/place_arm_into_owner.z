# An arm that reads storage something else owns cannot move into storage that
# owns what it holds: a reassignment of an owned local, or a return. A field arm
# handed to a slot that takes it moves out of the field instead, so it is not
# here; an element cannot move out of its list at all.
Holder: class {
    p: String
    q: String
}

keep: function {s: String.take} out u64 is {
    return s.length
}

reassignField: function {h: Holder c: bool} is {
    r: "init".string
    r = if c then h.p else "made".string
    print r
}

reassignElement: function {l: (List String) c: bool} is {
    r: "init".string
    r = if c then (l.get i: 0) else "made".string
    print r
}

returnField: function {h: Holder c: bool} out String is {
    return (if c then h.p else "made".string)
}

returnElement: function {l: (List String) c: bool} out String is {
    return (if c then (l.get i: 0) else "made".string)
}

takeElement: function {l: (List String) c: bool} out u64 is {
    return (keep s: (if c then (l.get i: 0) else "made".string))
}

main: function is {
    h: Holder p: "hp".string q: "hq".string
    l: List String
    l.append from: "e0".string
    reassignField :h c: true
    reassignElement :l c: true
    print (returnField :h c: true)
    print (returnElement :l c: true)
    print "\{takeElement :l c: true}"
}
