# borrow_result_through_view_arms.z -- an `if` value lends what each arm lends:
# a `.borrow` read out of a `.view` parameter is refused through the arms as
# it is returned directly, since a view converts to no other ownership.
LfBag: class {
    name: String
}

pick: function {s: LfBag.view k: bool} outx LfBag.borrow is {
    return (if k then s.borrow else s.borrow)
}

main: function is {
    b: LfBag name: "abc".string
    r: pick s: b k: true
    print r.name
}
