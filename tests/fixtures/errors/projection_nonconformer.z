# projection_nonconformer.z -- a projection's source must conform to the
# protocol or facet it is projected to, as an argument at a spec parameter
# must. It was never checked: `Speaker.create from: r.take` over a class that
# declares no `:Speaker` typechecked, and zc stopped in the emitter with
# "unhandled callee" -- for the borrow form and the facet's create alike.
Speaker: protocol {
    speak: function {t: this.view} out i64
}
Rock: class { n: i64 }

sizer: facet {
    size: function {t: this.view} out u64
}
stone: record { x: u64 }

main: function is {
    r: Rock n: 1
    q: Rock n: 2
    b: Speaker q.borrow
    s: Speaker.create from: r.take
    z: sizer.create from: (stone x: 2)
    print "\{s.speak} \{b.speak} \{z.size}"
}
