# A `.borrow`/`.view` leaf on a generator's `call` return asks for a VIEW into
# what the generator captured. Nothing implements that: a generator's element
# is owned (the wrapper is `Option` for a reftype, `optionval` for a valtype),
# and a yield of a borrowed field would have been moved out as if it were
# owned. The declaration is refused rather than accepted and miscompiled.
Bag: class {
    a: i64
}

Walk: generator { bag: Bag.borrow } as {
    call: function out Bag.borrow is {
        yield this.bag
    }
}

main: function is {
    g: Bag a: 1
    with it: (Walk bag: g) do {
        p: it.call
        match (p) case some then print "\{p.a}" case none then null
    }
}
