# E0400: a generic function whose instances instantiate it again at a larger
# type argument never runs out of instances; it is refused once, at its
# definition, however many calls in its body grow the argument.
wrap: record {
    v: t
} as {
    t: anyval.generic
}
pair: record {
    a: t
    b: t
} as {
    t: anyval.generic
}
deep: function as { t: anyval.generic } in { a: t n: i64 } out i64 is {
    if n <= 0 then return 0
    w: wrap t: t v: a
    p: pair t: t a: a b: a
    x: deep t: (wrap t: t) a: w n: n - 1
    y: deep t: (pair t: t) a: p n: n - 1
    return x + y
}
main: function is {
    print "\{deep t: i64 a: 1 n: 3}"
}
