# generic_record_field_return_not_refused -- a bare field read returned from a method of
# a generic record is never the "a field stays in its owner" refusal, whatever the
# parameter's bound says: a record holds value data.
Rd: protocol {
    rdn: function {t: this.view} out i64
}
pt: record { n: i64 } as {
    r: Rd.implement
    rdn: function {c: this.view} out i64 is { return c.n }
}
Box: record {
    val: T
} as {
    T: Rd.generic
    get: function {b: this} out T is { return b.val }
}
main: function is {
    a: Box val: (pt n: 3)
    g: a.get
    print "\{g.rdn}"
}
