# a type's fields and methods are not names in its methods' scope: each is
# reached through `this`, a value or the type. A bare one -- a field, an
# instance method, a static -- typed to nothing and reached the C compiler as
# an undeclared name.

# a plain value
px: record {
    v: u64
} as {
    # one
    one: function {} out this is {
        return (meta.create v: 1)
    }
    # from a u64
    make: function {from: u64} out this is {
        return (meta.create v: from)
    }
    # the field, bare
    field: function {t: this.view} out u64 is {
        return v
    }
    # a static, bare and read
    readOne: function {} out this is {
        return one
    }
    # a static, bare and called
    callMake: function {} out this is {
        return (make from: 2)
    }
}

main: function is {
    x: px v: 3
    print "\{x.field} \{px.readOne.v} \{px.callMake.v}"
}
