# A TYPE'S MEMBERS ARE IN SCOPE IN ITS METHODS' BODIES, nearest after the
# body's own names: a bare static or constant is the type's own (body_member_bare),
# and a bare field or arm -- an instance's, with no value to read it from -- is
# refused as what it is, read through a value instead.

# a plain value
px: record {
    v: u64
} as {
    # the field, bare
    field: function {t: this.view} out u64 is {
        return v
    }
}

# a choice of two
pick: union {
    one: u64
    other: null
} as {
    # an arm, bare
    which: function {p: this.view} out bool is {
        return one
    }
}

main: function is {
    x: px v: 3
    p: pick.other
    print "\{x.field} \{p.which}"
}
