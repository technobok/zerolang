# `outx` promises that the result keeps the call's borrow/view inputs locked.
# A function with no such input -- a scalar parameter only -- has nothing to
# keep locked, so the promise is empty and the declaration is refused: write
# `out`.
W: class {
    tag: i64
}

mk: function {t: i64} outx W is {
    return (W tag: t)
}

main: function is {
    w: mk t: 3
    print "\{w.tag}"
}
