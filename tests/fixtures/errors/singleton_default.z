# E0100: a field's or a parameter's default is one value for every instance, so
# none is computed from a numeric generic parameter, which each instance gives
# another value: not by an operator (`cap * 2`), a conversion (`cap.u64`) or a
# constant computed from one (`D`, `D: cap * 3`). The member is declared by its
# type instead and set where it is made. A field declared by the bare
# parameter (`stored: cap`) is no default: it is a slot of the parameter's
# singleton type. A construction or a call that leaves a refused member out
# says nothing more.
Box: class {
    used: u32
    twice: cap * 2
    wide: cap.u64
    third: D
} as {
    cap: u32.generic
    D: cap * 3
    room: function {b: this.view n: cap * 2} out u32 is {
        return n - b.used
    }
}
main: function is {
    c: (Box cap: 5) used: 1
    print "\{c.used} \{c.room}"
}
