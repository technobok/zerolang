# E0200: `iterate` is the readonly walk, so the elements it hands out are
# readonly -- writing through one would write through a container the iterator
# only claimed to read. `iterateMut` is the spelling for that (see
# for_element_reference, which does exactly this and compiles).
#
# Both loop forms are here: the element rule follows the strength of the lock
# its HOLDER has on the container, and the two forms find that holder
# differently -- the `with` binding carries it, the binding-free form carries it
# on the element itself.
Row: class { n: i64 }
main: function is {
    rows: (List Row)
    rows.append from: (Row n: 1)

    with it: rows.iterate do for r: it loop {
        r.n = r.n + 10
    }

    for q: rows.iterate loop {
        q.n = q.n + 10
    }
}
