# A compile-time `if` with no value says why at the condition that stopped the
# fold, not at one after a false, which never runs.

runtime1: function out bool is {
    return true
}

runtime2: function out bool is {
    return true
}

X: if false when runtime1 then 1 else if runtime2 then 2 else 3

main: function is {
    print "\{X}"
}
