# E0200: 's' borrows 'e.label'. Appending to that field reallocates it, so 's'
# would dangle -- this program compiled clean and heap-use-after-freed until the
# nested receiver started taking a lock.
Item: class {
    label: String
    value: i64
}
peek_label: function {b: Item.lock} out String.borrow is {
    return b.label
}
main: function is {
    e: Item label: "echo".string value: 5
    s: peek_label e
    e.label.append "-padding-to-force-a-realloc"
    print "peeked: \{s}"
}
