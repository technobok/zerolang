# E0200: a bare argument cannot alias the root of the receiver's path -- the
# call would hold 'p' exclusively while also reaching 'p.reg'.
Reg: class {
    count: u64
} as {
    tally: function {:this owner: Prog} out u64 is {
        return this.count + owner.tag
    }
}
Prog: class {
    reg: Reg
    tag: u64
}
main: function is {
    p: (Prog reg: (Reg count: 2) tag: 7)
    print "\{p.reg.tally owner: p}"
}
