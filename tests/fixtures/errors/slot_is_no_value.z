# A list's `slot` names its labels' positions and is no value: it is refused
# wherever a value is read -- a generic or a concrete argument, a return, an
# interpolation, a field, a list element, an operand, an `if` arm, a `with`
# value, a loop's sequence. Read through, `codes.slot.lf` is a label's
# position, which is a value.
codes: list { ht: 9 lf: 10 } out staticlist u8

Pair: record {
    a: u8
}

touch: function {x: t} is { print "touched" } as {
    t: anyval.generic
}

ident: function {x: t} out t is { return x } as {
    t: anyval.generic
}

takesU8: function {v: u8} out u8 is {
    return v
}

backOut: function out u8 is {
    return codes.slot
}

main: function is {
    touch x: codes.slot
    d: ident x: codes.slot
    k: takesU8 v: codes.slot
    print "\{codes.slot}"
    p: Pair a: codes.slot
    xs: ListVal u8
    xs.append codes.slot
    n: 1 + codes.slot
    c: true
    e: if c then codes.slot else codes.slot
    with w: codes.slot do print "w"
    for each z: codes.slot loop print "z"
    print "\{codes.slot.lf} \{backOut}"
}
