# `xs.append w.take` moves a lock-holding value exactly as `xs.append w`
# does: its locks go with it, and a container in an ENCLOSING scope outlives
# the source, so the move is refused (lock_transfer_outlives_container is the
# bare twin). The take used to release the locks, which let xs keep a borrow
# into a dead a.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

main: function is {
    xs: (List W)
    {
        a: Src n: 1
        w: mk from: a
        xs.append w.take
    }
    print "\{xs.length}"
}
