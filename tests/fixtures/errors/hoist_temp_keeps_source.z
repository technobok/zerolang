# hoist_temp_keeps_source.z -- an `outx` result keeps the temporary its argument
# was hoisted to, and the temporary keeps what it views: `s` stays locked while
# r lives, as with the named hoist `t: s.substring ..; r: lfPass v: t`.
lfPass: function {v: StringView.view} outx StringView is {
    return v
}

main: function is {
    s: "abc def".string
    r: lfPass v: (s.substring from: 0 to: 3)
    s = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz".string
    print r
}
