# z_build_unit_constant_target.z -- a unit-level constant folds the target the
# build is FOR: under --target x86_64-w64-mingw32 the windows branch is the one
# selected, and the `error` in it is the program's to hear.
BACKEND: if z.build.os.windows then {
    error "this program has no Win32 backend"
} else {
    "posix"
}

main: function is { print "\{BACKEND}" }
