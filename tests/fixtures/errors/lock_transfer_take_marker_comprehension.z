# A comprehension appends its element to a list the loop builds, which
# nothing names yet, so a lock-holding element has nowhere to leave its locks:
# `w.take` is refused exactly as a bare `w` is.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

main: function is {
    a: Src n: 1
    ws: for each i: (1.upto 2) loop {
        w: mk from: a
        w.take
    }
    print "\{ws.length}"
}
