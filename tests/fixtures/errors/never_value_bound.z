# An expression of type `never` does not finish, so there is nothing to bind:
# binding one is refused, as binding `null` is.
#
# It was not refused at all. The binding reached the emitter, which stopped on
# E0500 "unhandled binding type never" -- for a call that returns `never` and
# for the type `never` itself alike.
stop: function {} out never is {
    panic "stopped"
}

main: function is {
    a: stop
    b: never
    print "made"
}
