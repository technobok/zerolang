# span_field_read.z -- a window over a record's array field locks that field:
# reading it while the window lives is refused, though a sibling field stays
# readable and writable (span_array_field).

# a word array with a count beside it
pair: record {
    # the words
    words: (array t: u64 to: 2)
    # how many are in use
    used: u64
}

main: function is {
    r: pair words: (array t: u64 to: 2) used: 0
    w: r.words.mutView
    x: r.words.get i: 0
    w.set i: 0 item: x
}
