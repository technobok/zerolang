# A protocol implements no members of its own, so its `as` block names only
# markers (empty protocols); conforming to a protocol with members is refused.

# Named -- has a member
Named: protocol {
    # the name
    name: function {t: this.view} out String
}

# Labelled -- would conform to Named
Labelled: protocol {
    # the label
    label: function {t: this.view} out String
} as {
    :Named
}

# Tag -- conforms to Labelled
Tag: class {
    # the text
    text: String
} as {
    labelled: Labelled
    label: function {t: this.view} out String is { return t.text.copy }
}

main: function is {
    t: Tag text: "a".string
    print t.label
}
