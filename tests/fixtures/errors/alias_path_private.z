# A TYPE'S ALIAS OUT OF ITS `public:` BLOCK IS THE TYPE'S OWN: reached through
# the type from another unit, as a parameter's type and as a construction, it is
# refused where it is written -- `public:` hides the name, as it hides any
# member's.
keep: function {p: treeunit.Tree.Hidden} out i64 is { return p.x }

main: function is {
    h: treeunit.Tree.Hidden x: 1 y: 2
    print "\{keep p: h}"
}
