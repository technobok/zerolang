# A `for` binding is what the loop WALKS, so it has to be able to: an iterator
# answers `none` when it is done, and nothing else ends a loop by itself.
#
# A value bound here used to be an INITIALISER -- run once, read at the loop's
# own test -- which is the C-style counter loop. With no test to read it at,
# the emitted C was `while (1)`: an infinite loop with no diagnostic.
pt: record { x: i64 y: i64 }

main: function is {
    for i: 0 while i < 3 loop {
        i = i + 1
    }
    for s: "hello".string while s.length > 3 loop null
    for p: (pt x: 1 y: 2) while p.x < 3 loop null
    for n: 5 loop print "\{n}"
}
