# `a: yield e` binds the value the NEXT `.call` supplies. A generator whose
# `call` declares no input is never handed one, so the binding names a value
# nothing can produce. It was accepted and emitted C referring to a resume slot
# the class does not have.
G: generator as {
    call: function out i64 is {
        a: yield 1
        yield a
    }
}

main: function is {
    for v: G loop print "v: \{v}"
}
