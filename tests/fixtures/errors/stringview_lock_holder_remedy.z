# A StringView of a String holds a lock on that String, so moving it where the
# lock cannot follow is refused. Its remedy is an owned String (`.string`),
# which holds no lock: a StringView has no `.copy`.
main: function is {
    l: List StringView
    h: String
    h.append s: "heap"
    l.append from: h.stringView
    keep: "start"
    {
        inner: String
        inner.append s: "inner"
        keep = inner.stringView
    }
    print keep
}
