# A StringView of a String holds a lock on that String, so moving it where the
# lock cannot follow is refused. Its remedy is an owned String (`.string`),
# which holds no lock: a StringView has no `.copy`. (A collection cannot hold a
# view at all; a holder of its own, taking what it is given, is where the lock
# cannot follow.)
Holder: class {
    held: Option T
} as {
    T: AnyRef.generic
    put: function {:this x: T.take} is {
        this.held = Option.some x.take
    }
}

main: function is {
    l: Holder held: (Option T: StringView).none
    h: String
    h.append s: "heap"
    l.put x: h.stringView
    keep: "start"
    {
        inner: String
        inner.append s: "inner"
        keep = inner.stringView
    }
    print keep
}
