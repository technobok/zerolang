# A non-owned arm holds a pointer to its payload's source, whatever the
# payload's family: the payload must name a variable or a field of one. A
# literal, a constant, a function's name (an auto-call) and a call's result
# name no storage the arm could point at.
Inner: class {
    n: i64
}

Num: union {
    some: i64.view
    none: null
}

Ref: union {
    some: Inner.view
    none: null
}

Txt: union {
    some: StringView.view
    none: null
}

K: 5
NAME: "static name"

calc: function out i64 is { return 4 }
mk: function out Inner is { return (Inner n: 4) }

main: function is {
    a: Num.some 4
    b: Num.some K
    c: Num.some calc
    d: Ref.some mk
    e: Ref.some (mk)
    f: Txt.some NAME
    g: Txt.some "lit"
}
