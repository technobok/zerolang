# E0100: a data type declares its layout by its fields and is concrete: it
# cannot be native, take type parameters, be declared in a generic unit, or
# declare no field.
nat: data is native

gen: data {
    v: t
} as {
    t: anyval.generic
}

empty: data { }

box: unit {
    t: anyval.generic
    item: data {
        v: u8
    }
}

main: function is {
    print "x"
}
