# A unit's name is no value: it is refused as an argument and as a statement
# of its own, as it is in a binding. Both used to pass the check, and the name
# reached the C.

# slot -- one number
slot: record {
    v: i64
}

# valueOf -- the number of a slot it borrows
valueOf: function {c: slot.borrow} out i64 is {
    return c.v
}

main: function is {
    g: valueOf c: z
    io
    print "\{g}"
}
