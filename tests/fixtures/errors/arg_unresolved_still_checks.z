# arg_unresolved_still_checks.z -- an argument whose value does not resolve
# must not take the argument's LABEL checks down with it: the unknown label,
# the duplicate binding and the too-many-arguments check all answer from the
# parameter list alone and are reported alongside the unresolved value.

one: function {a: u64} out u64 is {
    return a + 1
}

none: function out u64 is {
    return 0
}

main: function is {
    d: one 1 a: ghostDup
    u: one zzz: ghostLabel
    t: none ghostExtra
    print "\{d} \{u} \{t}"
}
