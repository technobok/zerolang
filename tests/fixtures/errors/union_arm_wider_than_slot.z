# A bare value-type union arm is stored in the union's pointer-wide slot, so
# one wider than the slot is refused at the arm, with its size, the slot's and
# the target, and the `(Box T)` that makes it a heap cell. A facet is a vtable
# and a copy, which no slot holds. A `str 8` is its length byte and 8 chars,
# 9 bytes; nine u8s are 9. The arms that fit -- `small` and four u16s, eight
# bytes each -- and the boxed one are accepted.
pair: record { a: i64  b: i64 }
small: record { a: i32  b: i32 }
sized: facet {
    size: function {t: this.view} out i64
}
Wide: union {
    two: pair
    three: (array t: u32 to: 3)
    any: sized
    text: (str to: 8)
    nine: (array t: u8 to: 9)
    four: (array t: u16 to: 4)
    ok: small
    boxed: (Box pair)
    none: null
}

main: function is {
    w: Wide.ok (small a: 1 b: 2)
    if w.ok then print "\{w.a}"
}
