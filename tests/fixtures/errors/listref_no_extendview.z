# `extendView` is declared on ListVal and NOT on ListRef: the emitted body is a
# bitwise copy of the window's elements, which for a reference element would
# leave the same pointer owned twice and freed twice. A mono answers for the
# members its template declares, so the refusal is the CHECKER's, at the
# member, naming the instance.
main: function is {
    xs: List String
    ys: List String
    with v: xs.listView do {
        ys.extendView from: v
    }
    print "n=\{ys.length}"
}
