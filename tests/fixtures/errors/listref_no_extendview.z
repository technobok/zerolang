# `extendView` is declared on ListVal and NOT on ListRef: the emitted body is a
# bitwise copy of the window's elements, which for a reference element would
# leave the same pointer owned twice and freed twice. The refusal is the
# emitter's rather than the checker's -- a container mono is lenient about
# members it does not declare -- so this pins an E0500; it becomes an E0100 the
# day that leniency tightens.
main: function is {
    xs: List String
    ys: List String
    with v: xs.listView do {
        ys.extendView from: v
    }
    print "n=\{ys.length}"
}
