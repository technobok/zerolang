# A text, a static list, and a type holding one are measured -- a pointer and a
# length, 16 bytes -- and a bare union arm holding one is refused at the arm:
# none fits the 8-byte slot.
primes: list { 2 3 5 7 } out staticlist u8
named: record {
    t: text
}
V: variant {
    a: u8
    b: text
}
U: union {
    t: text
    l: staticlist u8
    n: named
    v: V
    s: String
}

main: function is {
    u: U.s "x".string
    match (u) case s then print u else print "other"
}
