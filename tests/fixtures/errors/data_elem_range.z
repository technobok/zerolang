# A data element beyond the block's declared width is an error where it is
# WRITTEN. Before, resolveData typed every element `literal_int` and never read
# `out T` except to name the tag, so this landed in a `static const uint8_t[]`
# as 44 -- gcc's -Woverflow was the only thing that noticed.
codes: data { 10 300 30 } out u8

main: function is {
    print "c=\{codes.index 1.u64}"
}
