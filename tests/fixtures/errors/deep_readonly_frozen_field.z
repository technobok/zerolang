# E0200: the same rule through a frozen field rather than a readonly receiver.
# `it` is a `hold` field, so a reftype read out of it is readonly and the
# binding carries that.
Inner: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
}
Box: class {
    it: Inner.hold
}
main: function is {
    b: Box it: (Inner n: 1)
    i: b.it
    i.bump
    print "n=\{i.n}"
}
