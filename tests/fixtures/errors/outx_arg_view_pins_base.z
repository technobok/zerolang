# An `outx` argument that is a call returning a view of its base (`b.sv`)
# keeps that base locked for the result's life: writing b.s is refused.

Box: class {
    s: String
} as {
    # a view of the field
    sv: function {this: this.view} outx String.view is {
        return this.s
    }
}

# keep -- hands back the view it was given
keep: function {v: String.view} outx String.view is {
    return v
}

main: function is {
    b: Box s: "a".string
    seen: keep v: b.sv
    b.s.append "y"
    print seen
}
