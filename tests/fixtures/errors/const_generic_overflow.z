# N74: a numeric generic parameter folds per instance, in its own type. `n`
# is a u64, so `n * 18446744073709551615` overflows u64 in the instance
# `(Box2 n: 2)` and is refused there, at compile time. It ran and wrapped: the
# evaluator held an i64, and a u64 operation it could not hold was left to run.
Box2: class {
    v: u64
} as {
    n: u64.generic
    scaled: function {t: this.view} out u64 is { return n * 18446744073709551615 }
}
main: function is {
    b: (Box2 n: 2) v: 1
    print "\{b.scaled}"
}
