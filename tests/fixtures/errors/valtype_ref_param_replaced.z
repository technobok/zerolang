# E0200: a value-type parameter passed by reference -- `.borrow`, `.view` -- is
# the caller's value, written through its fields, not replaced whole. An
# unmarked one is the callee's copy and is reassigned freely.
pt: record { x: i64 }
b: function {r: pt.borrow} is {
    r = pt x: 5
}
v: function {r: pt.view} is {
    r = pt x: 5
}
main: function is {
    p: pt x: 1
    b r: p
    v r: p
}
