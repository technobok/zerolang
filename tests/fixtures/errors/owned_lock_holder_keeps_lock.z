# owned_lock_holder_keeps_lock.z -- an owned value holding locks moved into a
# container or a field passes its locks to the owner: the source stays locked
# while the owner lives, so dropping it is refused.

W: class {
    # the borrowed source
    s: String.borrow
}

Holder: class {
    # the stored value
    w: (Option W)
}

main: function is {
    src: "hello".string
    lists: (List W)
    lists.append from: (W s: src)
    src.drop
    src2: "hello".string
    h: Holder w: (Option.none W)
    w: W s: src2
    h.w = Option.some w
    src2.drop
    print "\{lists.length}"
}
