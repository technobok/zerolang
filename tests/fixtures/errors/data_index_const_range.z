# A constant `.index K` reads its element through the declaration, so a K the
# block does not hold is an error where it is written -- in a body and in a
# unit-level definition alike -- rather than a read past the array at run time.
codes: data { 10 20 30 } out intdata u8
LAST: 3
X: codes.index -1

main: function is {
    print "\{codes.index 3} \{codes.index LAST} \{X}"
}
