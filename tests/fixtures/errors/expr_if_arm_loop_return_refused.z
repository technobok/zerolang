# expr_if_arm_loop_return_refused -- an `if` used inside an expression may not leave it
# from an arm: a `return` inside a loop in the arm leaves it all the same
show: function {n: i64} is {
    print "n \{n}"
}

main: function is {
    k: true
    show n: (if k then { for k loop { return }
        2 } else 1)
}
