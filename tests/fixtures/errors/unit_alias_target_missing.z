# A unit-level definition naming something that does not exist is the body's
# error for the same reference, reported at the definition. Each typed to
# nothing and raised nothing: a read reached the emitter ("unhandled interp part
# type", a C name nothing declares), a bare unknown name became a shell type
# ("cannot construct 'Nope'"), and a sum type's unknown arm folded to a value.
mode: variant {
    fast: null
    slow: null
}

inner: unit {
    A: 1
}

GONE: io.nope
NOUNIT: nounit.thing
NESTED: inner.B
UNKNOWN: Nope
ARM: mode.medium
FARARM: platform.oskind.nosuch

main: function is {
    print "\{GONE} \{NOUNIT} \{NESTED}"
    u: UNKNOWN
    m: ARM
    f: FARARM
}
