-l,1,--output,--verbose,a => verbose x0 false output=[--verbose] level=[1] src=[a] dst=none extra= undeclared=false,none,none
-l,1,--output=,a => verbose x0 false output=[] level=[1] src=[a] dst=none extra= undeclared=false,none,none
-l,1,-o,x,-o,y,--output=z,a => verbose x0 false output=[z] level=[1] src=[a] dst=none extra= undeclared=false,none,none
-l,1,-v,-v,--verbose,a => verbose x3 true output=none level=[1] src=[a] dst=none extra= undeclared=false,none,none
-l,1,a,b,c,-v,d => verbose x1 true output=none level=[1] src=[a] dst=[b] extra=[c][d] undeclared=false,none,none
-l,1,a,--,-o,x,--nope => verbose x0 false output=none level=[1] src=[a] dst=none extra=[-o][x][--nope] undeclared=false,none,none
-l,1,-, => verbose x0 false output=none level=[1] src=[-] dst=[] extra= undeclared=false,none,none
--level=3=4,a => verbose x0 false output=none level=[3=4] src=[a] dst=none extra= undeclared=false,none,none
-vvl,5,a => verbose x2 true output=none level=[5] src=[a] dst=none extra= undeclared=false,none,none
-vvl5,-ox,a => verbose x2 true output=[x] level=[5] src=[a] dst=none extra= undeclared=false,none,none
--nope => unknownFlag --nope
 => missingRequired --level
a => missingRequired --level
-l,1 => missingRequired src
-l,1,-- => missingRequired src
