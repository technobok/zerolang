# matrix_cases -- the RUN programs matrixgen writes from the table
# tests/fixtures/matrix_expect.zd, read by the runner beside run_cases.zd.
# `make regen-matrix` writes the whole file: edit the table, not this file.

# program -- one test program: <dir>/<name>.z from the repository root, its
# units also read from each of `roots`
program: data {
    name: text
    dir: text
    roots: list {} out staticlist text
    # it checks what only POSIX has (file descriptors, signals): on Windows it
    # is listed as (posix) and not run
    posix: false
}

programs: list {
    (program name: "matrix_class" dir: "tests/fixtures/emitc_corpus")
