# closer_comment -- an own-line comment in front of a call's closing paren
# belongs to the call: the call breaks one argument per line and the comment
# ends its argument list

# a pair the grammar needs, the closer taken by the path after it
needed: function is {
    v1: (g a: tb
    # c
    ).u64
    n4: (g a: tb
    # one
    # two
    ).u64
}

# a pair only the author wrote, one argument or two
written: function is {
    v2: (g a: tb
    # c
    )
    v3: (h a: tb b: tb
    # c
    )
}

# a call nested as an argument: the inner call breaks, the outer one hugs it
# or breaks as its own arguments say
nested: function is {
    n1: h a: (g a: tb
    # inner
    ) b: tb
    n5: g a: (g a: tb
    # deep
    )
}

# a lone unnamed argument: the comment is the call's, not the argument's
lone: function is {
    s1: (k tb
    # sole
    ).u64
    s2: (k
        # lead
        tb
    ).u64
}

# a comment trailing the last argument breaks the call as one on its own line
# does: a closer on its own line never sits under arguments left on the call's
# line. Written after the closer, it keeps the call on one line
trailing: function is {
    v6: (g a: tb # c
    )
    t1: (k tb # sole
    ).u64
    t2: (h a: tb b: tb # last
    )
    t3: (h a: (g a: tb) # after a pair
    ).u64
    t4: (h a: (g a: tb)
    # own line after a pair
    ).u64
    t5: (g a: tb).u64 # after the closer
}

# a comment inside a hugged construction is the construction's, not the call's:
# the construction breaks and the call hugs it
hugged: function is {
    f a: 1 b: (Pt x: 1 y: 2 # inside
    )
}

# unchanged: a comment inside a binary operation's own pair, and an already
# broken call
unchanged: function is {
    n2: g a: (tb + tb
    # in binop
    )
    v5: (g
        a: tb
        # c
    )
}
