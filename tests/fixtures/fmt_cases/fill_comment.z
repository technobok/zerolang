# fill_comment -- a filled list whose element follows a comment: the element is
# laid out by its own fit, as it would be without the comment, so the layout is
# the formatter's fixpoint (it was printed flat, with its inner list wrapped,
# and laid out only on a second pass)
part: data {
    key: ""
    needs: list {} out staticlist StringView
    body: ""
}
rows: list {
    (part key: "a")
    # a row too long for one line
    (part key: "f16.u128" needs: list { "prelude.int128" "prelude.f16" "prelude.@u128_from_f64" "prelude.@u128_to_f64" "prelude.@f16_to_f32" } body: "(!(z_f16_to_f32(@V@) >= 0.0) ? 0 : 1)")
} out staticlist part
main: function is {
    print "\{rows.length}"
}
