# for -- every header shape
main: function is {
    n: 3
    for i < n loop {
        print "\{i}"
    }
    for each i: 0 while i < n loop {
        i = i + 1
    }
    for each x: xs loop print "\{x}"
    for while ready loop { tick }
    for i < n while ok loop {
        i = i + 1
    } while i < 10
    for true loop {
        break
    }
    for n < n loop {
    }
    for each x: xs loop null
    for each e: xs loop {
        print "\{e}"
    }
    squares: for each x: 5.times loop x * x
    for   each   y:   xs loop print "\{y}"
    cubes: for each z: 3.times while z < 2 loop z * z * z
    for (i < n) loop print "\{i}"
}
