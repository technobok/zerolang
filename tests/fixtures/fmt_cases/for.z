# for -- every header shape
main: function is {
    n: 3
    for i < n loop {
        print "\{i}"
    }
    for i: 0 while i < n loop {
        i = i + 1
    }
    for x: xs loop print "\{x}"
    for while ready loop { tick }
    for i < n while ok loop {
        i = i + 1
    } while i < 10
    for true loop {
        break
    }
    for n < n loop {
    }
    for x: xs loop null
    with it: xs.iterate do for e: it loop {
        print "\{e}"
    }
    squares: for x: 5.iterate loop x * x
    for (i < n) loop print "\{i}"
}
