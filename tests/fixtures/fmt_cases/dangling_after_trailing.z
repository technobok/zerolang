# dangling_after_trailing -- own-line comments before a block's closer, after a
# statement with a trailing comment, keep the blank lines the author wrote: none
# or one, never one more

none: function is {
    print "x"    # trailing
    # dangling
}

one: function is {
    print "x"    # trailing

    # dangling
}

two: function is {
    print "x"    # trailing
    # first
    # second
}

paragraph: function is {
    print "x"    # trailing

    # first

    # second
}
