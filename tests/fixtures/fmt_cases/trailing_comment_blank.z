# trailing_comment_blank -- a blank line after a line that ends in a trailing
# comment is kept, as it is after a line with none: at top level and in a body

LIMIT: 9    # the most there may be

SCALE: 3

main: function is {
    x: LIMIT * SCALE    # computed once

    print "\{x}"
    y: x + 1    # no blank below
    print "\{y}"
}
