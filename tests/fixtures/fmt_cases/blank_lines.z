# blank_lines -- runs capped, required blanks
a: 1
b: 2



c: 3
# doc without a blank before it
d: function is {
    x: 1


    y: 2
}
e: 5
f: function is {
    z: 1
}
g: 6


# a comment block

# separated from its definition by a blank
h: 7

# inside an expression or a signature no blank line is kept, except one between
# two comments: the comment block's own paragraph break
k: function {
    # first

    # second
    a: u64

    b: u64
    # trailing one

    # trailing two
} out u64 is {
    v1: (h
        a: 1

        b: 2
    )
    v2: (h
        # one

        # two
        a: 1
        b: 2
    )
    v3: (h
        a: 1
        b: 2
        # one

        # two
    )
    return a
}
