# reassign_swap -- reassignment and swap forms
main: function is {
    a: 1
    b: 2
    a = b
    a = (b)
    a = b + 1
    a = (b + 1)
    p.x = a
    a swap b
    (a) swap b
    a = if b == 1 then 2 else 3
    a = aVeryLongOperandNameNumberOne + aVeryLongOperandNameNumberTwo + aVeryLongOperandNameNumberThree + four
}
