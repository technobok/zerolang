# grouped_marker_base -- parentheses round the base of a value marker force the
# base's call, so the marker applies to the result: `(mk).copy` keeps its pair,
# for a name and for a path, under every value marker. Anywhere else a pair
# round a name or a path is grouping alone and goes
main: function is {
    a: (mk).copy
    b: ((mk)).copy
    c: (e.key).copy
    d: (it).take
    e: (g).borrow
    f: (h).view
    k: (q).hold
    m: (mk.copy).length
    n: (e.key).length
    p: (mk)
    q: mk.copy
}
