# multiline_string_gap -- the newlines inside a multi-line literal are content,
# not blank lines: nothing is inserted after one, an author blank is kept, a
# comment after one is not pushed away, and a unit-level one is followed by
# exactly the blank a multi-line definition earns
banner: """
    one
    two
    """
main: function is {
    a: "
        interp
        "
    print a
    b: """
        raw
        """
    print b
    c: """
        kept blank
        """

    print c
    d: """
        comment next
        """
    # leads the print
    print d
    g: """
        last
        """
    # dangling
}
