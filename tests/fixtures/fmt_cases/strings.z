# strings -- escapes, holes, empty, raw, multi-line in and out of parens
main: function is {
    a: "plain"
    b: ""
    c: "tab\there"
    d: "hole \{a} and \{b}"
    e: "nested \{(f x: 1)}"
    f: """raw "quoted" text"""
    g: """
        multi
        line
        """
    h: ("""
        multi
        line
        """)
    i: "
        interp \{a}
        "
    j: (g.concat other: """
        arg
        """)
    print "\{a}\{b}\{c}\{d}\{e}\{f}\{g}\{h}\{i}\{j}"
}
