# comments -- leading, trailing, dangling, after an open paren, doc blocks

# a doc block that sits on its definition
first: function is {
    x: 1  # trailing, author spacing kept
    y: 2    # aligned by hand
    # own line before a statement
    z: 3
    # dangling at the end of the body
}
# a comment separated from the next definition by nothing

second: function is {
    v: (foo  # after the open paren
        a: 1
    )
    w: (foo
        # before the first argument
        a: 1
        # before the second
        b: 2
        # dangling before the close
    )
    # the last argument closes its own pair before the comment: the comment
    # still stays inside the call's pair, where it was written
    w2: (foo
        a: 1
        b: (bar c: 2)
        # dangling after a parenthesised last argument
    )
    w3: (foo
        a: (bar
            c: (baz d: 3)
            # dangling two pairs in
        )
        b: (bar c: (baz d: 4))  # trailing after a closed argument
    )
    if x then {
        # only a comment
    }
    match (
        r  # trailing on the subject
    ) case a then null else null
}

# trailing comment at the end of the file
