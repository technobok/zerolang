# function_signatures -- the four rungs, clause order, native, nested literal
short: function {a: u64} out u64 is {
    return a
}

oneLine: function {a: u64} out u64 is { return a }

rungTwo: function {alphaArgumentNameHere: i64 betaArgumentNameHere: i64 gammaArgumentName: i64 deltaArgument: i64} out i64 is {
    return 1
}

rungThree: function {alphaArgumentNameHere: (ListVal u64).take betaArgumentNameHere: zenv.ZSymbolTable.view gammaArgumentName: i64 deltaArgument: i64 epsilon: bool} out i64 is {
    return 1
}

spread: function {
    a: u64
    b: u64
} out u64 is {
    return a + b
}

documented: function {
    # the first
    a: u64
    # the second
    b: u64
} out u64 is {
    return a + b
}

nat: function {s: StringView} out u64 is native

pinned: function {t: (List u8).view} outx u8 is {
    return 0
}

generic: function as { T: Any.generic } in {x: T} out T is {
    return x
}

asFirst: function as { h: u8 } in { :this } is {
    return 0
}
