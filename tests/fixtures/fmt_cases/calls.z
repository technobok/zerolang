# calls -- bare, labelled and unnamed calls; wrapping; hugging; sole terms
main: function is {
    print "hello"
    xs.append 1
    (recv.method a: 1 b: 2)
    recv.method a: 1 b: 2
    recv.method aVeryLongArgumentName: someValueOfConsiderableLength bAnotherLongName: anotherValueHere c: 3
    x: (recv.method
        a: 1
        b: 2
    )
    y: recv.method a: (inner x: 1 y: 2) b: 3
    rs.append (Thing
        id: 1
        name: "n".string
    )
    z: f (a + b)
    w: List u8
    v: (List u8)
    u: (f x: 1)
    print (format value: 42 width: 6)
    print "a very long string literal that will not be wrapped because a lone term gains nothing from parens"
}
