# a data or choice value at unit level takes parentheses only round a labelled
# argument, which would otherwise start the next definition
row: data { n: u8 }
form: choice { call: null count: u8 }
a: (row 5)
b: (form.count 3)
c: (row n: 7)
d: form.call
e: (list { 1 2 })
# a list ends at its brace, so a labelled argument or a dot after it needs no
# parentheses; with an `out` clause a dot would continue the clause's type
row2: data {
    needs: staticlist text
    n: 0
}
f: (row2 needs: (list { "a" }) n: 3)
g: (row2 needs: (list { "a" } out staticlist text) n: 3)
h: (list { 1 2 }).length
k: (list { 1 2 } out staticlist u8).length
