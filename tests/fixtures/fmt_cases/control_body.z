# an `if` or a `match` as a bare `then` or `case` body keeps its parentheses:
# written bare, a following `else` would bind to it
v: variant { a: null b: null }
pick: function {x: v y: v} out i64 is {
    return (match (x) case a then (match (y) case a then 1 else 2) else 3)
}
also: function {c: bool d: bool} out i64 is {
    return (if c then (if d then 1 else 2) else 3)
}
