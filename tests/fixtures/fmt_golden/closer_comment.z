# closer_comment -- an own-line comment in front of a call's closing paren
# belongs to the call: the call breaks one argument per line and the comment
# ends its argument list

# a pair the grammar needs, the closer taken by the path after it
needed: function is {
    v1: (g
        a: tb
        # c
    ).u64
    n4: (g
        a: tb
        # one
        # two
    ).u64
}

# a pair only the author wrote, one argument or two
written: function is {
    v2: (g
        a: tb
        # c
    )
    v3: (h
        a: tb
        b: tb
        # c
    )
}

# a call nested as an argument: the inner call breaks, the outer one hugs it
# or breaks as its own arguments say
nested: function is {
    n1: (h
        a: (g
            a: tb
            # inner
        )
        b: tb
    )
    n5: g a: (g
        a: tb
        # deep
    )
}

# a lone unnamed argument: the comment is the call's, not the argument's
lone: function is {
    s1: (k
        tb
        # sole
    ).u64
    s2: (k
        # lead
        tb
    ).u64
}

# unchanged: a comment inside a binary operation's own pair, a trailing
# comment on the argument's line, and an already broken call
unchanged: function is {
    n2: g a: (
        tb +
        tb
        # in binop
    )
    v6: g a: tb # c
    v5: (g
        a: tb
        # c
    )
}
