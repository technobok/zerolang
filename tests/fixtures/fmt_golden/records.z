# records -- item definitions, clause order, native spellings, unit blocks
public: unit {
    :Point
    :Holder
}

pub2: unit { :a :b }

Point: record {
    # the x
    x: i64
    y: i64
}

Holder: class {
    xs: List String
    ys: List String
    zs: (Map u8 value: u8)
    opt: (Option T: String)
    vw: (List u8).view
} as {
    create: function {} out this is {
        (return
            (meta.create
                xs: List String
                ys: List String
                zs: (Map u8 value: u8)
                opt: (Option T: String)
                vw: (List u8).view
            )
        )
    }
    m: function {:this} is native
}

Empty: class { f: u8 }

Native: class is native

Native2: class native

Rev: class as { t: i64 } is { x: i64 }

sev: variant {
    error: null
    warning: null
} as { tag: u8.tag }

Strs: List String
Strs2: List String
lv: (a + b)

inner: unit as {
    :x
}
