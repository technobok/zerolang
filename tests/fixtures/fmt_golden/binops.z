# binops -- chains, symmetry, associativity, wrapping
main: function is {
    a: b + c + d
    e: (b + c) * d
    f: (b == c) == false
    g: (b == c) and (d == e)
    h: b == c and d == e
    i: b + c + d + e
    j: b + c
    k: (
        aVeryLongOperandNameNumberOne +
        aVeryLongOperandNameNumberTwo +
        aVeryLongOperandNameNumberThree +
        four
    )
    l: (
        (aVeryLongOperandNameNumberOne + aVeryLongOperandNameNumberTwo) *
        (aVeryLongOperandNameNumberThree + four)
    )
    m: Map u8 u8
    n: x.y + 1
    o: (f x: 1) + 1
    p: 1 + (f x: 1)
}
