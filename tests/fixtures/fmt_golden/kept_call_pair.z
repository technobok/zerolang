# a call inside written parentheses, written with a newline after the opener:
# the kept marker keeps the call open, broken after its callable as a call
# breaks -- the layout the next pass reads back as the call's own marker
check: function {a: i64 b: i64} out bool is {
    return a > b
}

main: function is {
    x: 1.i64
    y: 2.i64
    if x > 0 when (check
        a: x
        b: y
    ) then print "yes"
    ok: check a: y b: x
    print "\{ok}"
}
