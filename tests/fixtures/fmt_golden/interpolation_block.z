# interpolation_block -- a string whose interpolation hole spans lines or holds
# a comment is kept as written, as one holding a newline is; a one-line hole is
# laid out

main: function is {
    a: "one: \{
        shout "hello"    # even with comments
    } and more"
    b: "two: \{
        shout "spaced"
    }"
    c: "three: \{shout "tight"}"
}
