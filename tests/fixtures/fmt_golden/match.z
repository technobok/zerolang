# match -- one-line, multi-line, on, null arms, subject shapes
main: function is {
    r: 1
    match r case some then print "found" case none then print "missing"
    match r case some then print "found" case none then print "missing"
    match (
        r
    ) case some then {
        print "found"
    } case none then {
        print "missing"
    }
    match (
        r
    ) case ok then {
        print "value"
    } case err then {
        print "failed"
    }
    match on r case a then null case b then null else null
    match (foo x: 1) case a then print "a" else null
    match (
        foo x: 1
    ) case a then {
        print "a"
    } else {
        print "b"
    }
    match (
        r
    ) case a then null case b then {
        print "b"
    }
    match r.kind case a then null else null
    match r < 7 case true then print "below" case false then print "not below"
    v: match r == 1 case true then 1 case false then 2
    match r case x then {} else {}
}
