# argument_parens -- a labelled argument's value keeps its parentheses only
# where the grammar needs them: around a call with a labelled argument, whose
# label would otherwise return to the outer call, and around any call in the
# unnamed slot; a single-argument application loses them
main: function is {
    a: (foo x: bar 1 y: 2)
    b: (foo x: (bar k: 1) y: 2)
    c: (foo (bar 1) y: 2)
    d: (foo x: v y: 2)
    e: (foo x: ListVal u64 y: (IdMapV u64 v: tid))
    f: (foo x: bar baz.qux y: 2)
    g: (foo x: (bar (baz 1)) y: 2)
    h: (foo x: bar "s" y: 2)
}
