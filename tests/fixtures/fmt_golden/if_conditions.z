# if_conditions -- paren policy, when chains, else if, null bodies, long conditions
main: function is {
    a: 1
    b: 2
    if a == b then print "eq"
    if a == b then print "eq"
    if a then print "a"
    if (foo x: a) then print "call"
    if a == b when b == a then print "both"
    if a == b then {
        print "one"
    } else if b == a then {
        print "two"
    } else {
        print "three"
    }
    if a == b then null else print "no"
    if a == b then null else null
    if (
        (aVeryLongVariableNameIndeed == anotherVeryLongVariableName) and
        (yetAnotherLongName == andOneMoreLongName)
    ) then print "long"
    if (
        aVeryLongVariableNameIndeed ==
        anotherVeryLongVariableName and
        yetAnotherLongName ==
        andOneMoreLongName
    ) then print "long"
    if (
        a == b
    ) then print "marker"
    if (
        (a == b) and (b == a)
    ) then print "chain"
    if isTab == false then print "term"
    if (a == b) == false then print "cmp"
}
