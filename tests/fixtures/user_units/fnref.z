# fnref -- functions other units name as defaults, for user_unit_fn_defaults

# seven -- the default the other units name
seven: function out i64 is {
    return 7
}

# Box -- a class whose field defaults to this unit's own function
Box: class {
    # the hook, seven unless told
    k: seven
}

# viaOwn -- a parameter defaulting to this unit's own function
viaOwn: function {k: seven} out i64 is {
    return k
}
