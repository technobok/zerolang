# a default naming an arm through its unit's path -- `armhue.hue.red` -- is a
# default, as `hue.red` is in the unit that declares it. It was read as the
# type: the parameter or field had no default and every use that left it out
# was refused for a missing argument. A free function's parameter, a method's,
# a record field and a class field, each left out and given; and a subunit's
# parameter defaulting through its sibling subunit (armpal's kit through
# tones), which typed the parameter as the sibling unit itself.

# whiteness -- 1 for red, 2 for blue
whiteness: function {h: armhue.hue.red} out i64 is {
    if h.red then return 1
    return 2
}

# a brush, red unless told
brush: record {
    # the hue
    h: armhue.hue.red
    # its width
    w: i64
}

# a pen, blue unless told
Pen: class {
    # the hue
    h: armhue.hue.blue
} as {
    # tint -- 1 for red, else 2
    tint: function {t: this.view over: armhue.hue.blue} out i64 is {
        if over.red then return 1
        return 2
    }
}

main: function is {
    print "free \{whiteness} \{whiteness h: armhue.hue.blue}"
    b: brush w: 1
    c: brush h: armhue.hue.blue w: 2
    print "record \{b.h.red} \{c.h.red}"
    p: Pen
    q: Pen h: armhue.hue.red
    print "class \{p.h.red} \{q.h.red}"
    print "method \{p.tint} \{p.tint over: armhue.hue.red}"
    print "sibling \{armpal.shadeOf}"
}
