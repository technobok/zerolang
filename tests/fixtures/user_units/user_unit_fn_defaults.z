# a default naming a function another unit declares -- `fnref.seven` -- is a
# function reference, as a bare `seven` is in the unit that declares it. The
# parameter was read as the function's type with no default, so every call
# that left it out was refused for a missing argument. A field took the
# default, but a construction that left it out never walked the function,
# so a function declared in another unit was named in the C and never
# emitted, and the link failed -- for `fnref.Box`'s own bare `seven` too.

# eight -- the explicit override
eight: function out i64 is {
    return 8
}

# viaPath -- a parameter defaulting through the unit's path
viaPath: function {k: fnref.seven} out i64 is {
    return k
}

# Hook -- a record field defaulting through the unit's path
Hook: record {
    # the hook
    k: fnref.seven
    # its weight
    w: i64
}

# Gear -- a class field defaulting through the unit's path
Gear: class {
    # the hook
    k: fnref.seven
}

main: function is {
    print "param \{viaPath} \{fnref.viaOwn}"
    h: Hook w: 1
    print "record \{h.k}"
    g: Gear
    print "class \{g.k}"
    b: fnref.Box
    print "unit class \{b.k}"
    e: Gear k: eight.copy
    print "given \{e.k}"
}
