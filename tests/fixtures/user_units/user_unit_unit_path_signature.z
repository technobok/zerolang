# user_unit_unit_path_signature -- a parameter and a return typed by a file
# unit's choice through an alias of the unit, and one by a data type in a unit
# the file unit declares.
u: unitpath
lin: u.os.linux
deep: (unitpath.inner.deeplink library: "c" weight: 3)

name: function {o: u.os} out StringView is {
    match (o) case linux then return "linux" case other then return "other"
}

linux: function out u.os is {
    return lin
}

weightOf: function {l: unitpath.inner.deeplink} out i64 is {
    return l.weight
}

main: function is {
    print "\{name o: linux} \{weightOf l: deep}"
}
