# A method may call a function of an instance of a generic FILE unit: the
# instance's functions are declared with the other forward declarations, ahead
# of the method that calls one.
gi: (gutri t: i64)

Box: class {
    v: u8
} as {
    # 4 tripled, through the instance
    tri: function {:this} out i64 is { return (gi.thrice 4) }
}

main: function is {
    b: Box v: 1
    print "\{b.tri}"
}
