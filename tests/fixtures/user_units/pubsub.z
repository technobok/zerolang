# pubsub.z -- a unit whose `public:` block re-exports its hidden subunit's
# definitions without listing the subunit. A definition in the block resolves
# outward -- the block, then this unit, whose member `impl` is -- so
# `Foo: impl.Foo` names the subunit loaded from pubsub/impl.z.
public: unit {
    Foo: impl.Foo
    twice: impl.twice
    SCALE: impl.SCALE
    Cell: impl.Cell
}
