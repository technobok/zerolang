# aliasinst -- a generic record and a unit-level alias of one of its instances

# a value offset by n
fx: record {
    # the stored value
    v: u64
} as {
    # the offset every construction adds
    n: u64.generic
    # from a u64, plus n; 0 plus n when left out
    create: function {from: 0.u64} out this is {
        return (meta.create v: from + n)
    }
}

# the instance offsetting by 2
F2: (fx n: 2)
