# user_unit_named_t.z -- a program whose unit `t` is next door, while the
# system library's generics still name their parameter `t`: a ListVal's iterator
# (OptionViewVal's `t.borrow` arm), a generic record and a generic function.
Pair: record {
    a: t
    b: t
} as {
    t: anyval.generic
}

firstOf: function {xs: (ListVal t).view} out t is {
    return (xs.get i: 0)
} as {
    t: anyval.generic
}

boxed: function {b: t.Box.view} out u64 is {
    return b.n
}

main: function is {
    xs: ListVal u64
    xs.append from: 3
    xs.append from: 4
    total: 0.u64
    for each x: xs.iterate loop total = total + x
    p: (Pair t: u64 a: 1 b: 2)
    bx: t.Box n: 9
    print "total=\{total} first=\{firstOf :xs} pair=\{p.a + p.b}"
    print "t.double 21=\{t.double x: 21} boxed=\{boxed b: bx}"
}
