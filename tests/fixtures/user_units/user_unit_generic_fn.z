# user_unit_generic_fn.z -- a generic function of another unit, called
# `genfns.fn`, runs the instance its type arguments select: explicit or
# inferred, with a defaulted parameter left out or written, as an argument,
# as a statement, and from a generic function over its own parameter.
grow: function as { t: anyval.generic } in { a: t } out (ListVal t: t) is {
    l: genfns.mk t: t a: a
    l.append from: a
    return l
}
main: function is {
    a: genfns.mk t: i64 a: 2
    b: genfns.mk a: 7.u8
    c: grow t: i64 a: 5
    print "mk: \{a.length} \{b.length} \{c.length}"
    print "pad: \{genfns.pad t: i64 a: 2} \{genfns.pad t: u8 a: 2 n: 9}"
    print "arg: \{(genfns.mk t: i64 a: 4).length}"
    (genfns.note t: i64 a: 6)
}
