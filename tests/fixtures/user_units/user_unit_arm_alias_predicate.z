# user_unit_arm_alias_predicate -- `value.arm` is always the arm PREDICATE,
# also when the value is another unit's alias of an arm (`armal.k`, `k:
# pair.b`) and when that unit is a subunit (`armal.deep.k2`). Both read as
# constructions of the named arm: `armal.k.a` was `pair.a`, so a bound
# predicate held the wrong arm's tag, and a subunit's alias typed as the
# variant, not bool.

# folded at unit level
KB: (if armal.k.b then { 1 } else { 0 })

main: function is {
    ka: armal.k.a
    kb: armal.k.b
    print "k.a=\{ka} k.b=\{kb}"
    tx: armal.t.x
    ty: armal.t.y
    tz: armal.t.z
    print "t.x=\{tx} t.y=\{ty} t.z=\{tz}"
    dup: armal.deep.k2.up
    ddown: armal.deep.k2.down
    print "deep.up=\{dup} deep.down=\{ddown}"
    if armal.k.b then print "if k.b" else print "if not k.b"
    if armal.deep.k2.down then print "if deep.down" else print "if not deep.down"
    print "KB=\{KB}"
}
