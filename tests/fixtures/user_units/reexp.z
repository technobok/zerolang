# a unit re-exporting a TYPE, a CONSTANT and a FUNCTION from its own hidden
# subunit -- the only way a subunit's contents can be reached at all, since
# reaching past this unit into `impl` is E0101.
Thing: impl.Thing
SCALE: impl.SCALE
scaled: impl.scaled

make: function {n: i64} out Thing is {
    return (Thing n: n)
}
