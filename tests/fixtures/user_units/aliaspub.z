# aliaspub -- an instance alias listed in a public block, as math lists i256

public: unit {
    # the instance offsetting by 5
    F5: (fx n: 5)
}

# a value offset by n
fx: record {
    # the stored value
    v: u64
} as {
    # the offset every construction adds
    n: u64.generic
    # from a u64, plus n
    create: function {from: 0.u64} out this is {
        return (meta.create v: from + n)
    }
}
