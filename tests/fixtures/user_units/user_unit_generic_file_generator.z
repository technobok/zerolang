# A GENERATOR A GENERIC FILE UNIT DECLARES is lowered with the unit's other
# definitions, and each instance of the unit yields its own element type: an
# i64 instance's `call` returns optionval i64, an f64 instance's optionval f64.
ints: (genseq t: i64)
reals: (genseq t: f64)

main: function is {
    for each v: (ints.Times item: 3 n: 2) loop print "\{v}"
    for each r: (reals.Times item: 1.5 n: 3) loop print "\{r}"
}
