# A unit's own type wins over the prelude's of the same name when its `as`
# constant is read as a default -- before anything else has used the type. This
# unit's `Box` is not core's `Box`, and `n: Box.seven` is its constant, not a
# required parameter typed by core's class; `idconsts.Box.seven` is that unit's.
Box: class {
    v: i64
} as {
    seven: 7
}

row: record {
    n: Box.seven
}

show: function {n: Box.seven} out i64 is {
    return n
}

fromUnit: function {n: idconsts.Box.seven} out i64 is {
    return n
}

main: function is {
    r: row
    print "\{show} \{r.n} \{show n: 2} \{fromUnit}"
}
