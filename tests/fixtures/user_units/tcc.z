# tcc.z -- a user unit named `tcc`. This one was safe only by omission: no
# routing site listed `tcc`, so nothing misfired. It is a fixture so the
# declaration-driven route is pinned for every convention unit, not just the
# ones that happened to break. `available` shadows a real native's name.
available: function out i64 is {
    return 7
}

compileToExe: function {n: i64} out i64 is {
    return n * 3
}
