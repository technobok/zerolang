# user_unit_sqlite.z -- a program whose `sqlite` is the user unit next door.
main: function is {
    print "sqlite.version=\{sqlite.version}"
    r: sqlite.Database.open path: "abcd"
    if r.err then return
    db: r.take
    print "Database.changes=\{db.changes}"
    st: db.prepare sql: "select 1"
    s: st.step
    print "Step.row.n=\{s.row.n}"
}
