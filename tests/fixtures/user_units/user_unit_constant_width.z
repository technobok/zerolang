# A CONSTANT'S WIDTH CROSSES UNITS: another unit's suffixed constant, and its
# type's `as` constant, read as the width they were declared with, in a body
# and in a constant built on them.
NEXT: widths.W + 1

main: function is {
    a: widths.W
    a = a - 6
    b: widths.Wide.K
    b = b - 6
    c: NEXT
    c = c - 7
    print "\{a} \{b} \{c}"
}
