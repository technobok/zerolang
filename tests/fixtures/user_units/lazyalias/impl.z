# a hidden subunit that demands a library nothing can link. Its parent
# re-exports a type from it, and the program never names that re-export -- so
# a compiler that resolves the alias to classify it links a library that does
# not exist, and one that resolves on demand never hears of it.
require: unit {
    library: "nosuchlib"
}

Thing: record {
    n: i64
}
