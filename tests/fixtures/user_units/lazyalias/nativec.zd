# nativec -- lazyalias's C implementation, a runtime.nativec file
c: runtime.nativec

# implementation -- its hidden subunit `impl` links a library that does not
# exist: a program that reaches impl cannot link
implementation: (
    c.implementation
    rows: list {
        (
            c.row
            key: "probe"
            fragments: list {
                """
                static int64_t z_lazyalias_probe(void) {
                    return 1;
                }
                """
            }
        )
    }
    links: list { (c.link library: "nosuchlib" subunit: "impl") }
)
