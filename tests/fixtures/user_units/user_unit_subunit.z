# user_unit_subunit.z -- a dependency unit's hidden subunits, to any depth.
# The main unit's body walk reaches only its OWN namespaces; a dependency's
# are reached by the demand drain, and without it their bodies arrive at the
# emitter unstamped (E0500) instead of being type-checked.
main: function is {
    print "carrier.wrap 3 = \{carrier.wrap n: 3}"
}
