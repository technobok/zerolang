# A type's `as` constant is a default however its type is reached: through the
# type's unit (`r: idconsts.rid.zero`), through an alias of the type from
# another unit (`rid: idconsts.rid`, then `r: rid.zero`), or through an alias in
# the same unit (`lid: local`). Each declares a defaulted member -- not a
# required one typed by the path's head, and not an arm of the alias.
rid: idconsts.rid
shade: idconsts.shade

local: typedef u32 as {
    ==: function {this: this.view rhs: local} out bool is {
        return this.u32 == rhs.u32
    }
    zero: local 0
}

lid: local

row: record {
    r: idconsts.rid.zero
    a: rid.zero
    s: idconsts.shade.usual
}

viaUnit: function {r: idconsts.rid.zero} out bool is {
    return r.isZero
}

viaAlias: function {r: rid.zero} out bool is {
    return r.isZero
}

viaLocalAlias: function {l: lid.zero} out u32 is {
    return l.u32
}

shadeViaUnit: function {s: idconsts.shade.usual} out bool is {
    return s.light
}

shadeViaAlias: function {s: shade.usual} out bool is {
    return s.light
}

main: function is {
    w: row
    print "\{viaUnit} \{viaAlias} \{viaLocalAlias} \{shadeViaUnit} \{shadeViaAlias}"
    print "\{w.r.isZero} \{w.a.isZero} \{w.s.light}"
    print "\{viaUnit r: (rid 3)} \{viaLocalAlias l: (local 4)} \{shadeViaAlias s: shade.dark}"
}
