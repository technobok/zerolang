# user_generic_borrow_return.z -- another unit's generic function returning a
# `.borrow` of its argument: the result writes through to the caller's list,
# written with its type argument or inferred.
main: function is {
    l: ListVal i64
    l.append from: 1
    (glref.same t: i64 b: l).append from: 5
    {
        r: glref.same b: l
        r.append from: 6
    }
    print "\{l.length}"
}
