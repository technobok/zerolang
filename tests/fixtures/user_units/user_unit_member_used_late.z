# a bodied member of a runtime-owned type first used after its owner's walk is
# walked then. Reading a typed constant of another unit inside a method walks
# the scalars' owners -- u64's included -- during the program's own walk, which
# leaves `times` deferred: nothing has used it yet. Its first use is in
# latecount's namespace, walked after, and the owner never walked again -- so
# `times` reached the C as its unstamped template, `create(0, v.u64, false)`,
# and the C did not compile.
Flags: class {
    cap: u32
} as {
    # capped -- the cap, or latecount's when none was set
    capped: function {this: this.view} out u32 is {
        c: this.cap
        if this.cap == 0 then c = latecount.limit
        return c
    }
}

main: function is {
    f: Flags cap: 0
    print "\{f.capped} \{latecount.inner.count n: 4}"
}
