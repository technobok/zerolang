# A HIDDEN `.implement` LABEL STILL IMPLEMENTS: implunit's Dog keeps its label
# `s` out of its public members, and this unit passes a Dog as implunit's
# Speaker all the same -- `public:` hides names, never the fact that a type
# implements an interface.
hear: function {s: implunit.Speaker} out u64 is {
    return s.speak
}

main: function is {
    d: implunit.Dog n: 2
    print "\{hear s: d} \{d.speak}"
}
