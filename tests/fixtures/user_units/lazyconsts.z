# lazyconsts -- a dependency of user_unit_namespace_constant_lazy: constants in
# a nested unit, a unit nested in that, and a hidden subunit, each beside a
# constant that has no value and that nothing reads

# a reading with a level
gauge: data {
    level: 0
}

# the hidden subunit's step, times n
subSteps: function {n: i64} out i64 is {
    return (sub.stepTimes :n)
}

# never read: a text where the level is a number
topWrong: (gauge level: "top")

inner: unit {
    # read through inner
    ok: (gauge level: 2)
    # never read: a text where the level is a number
    wrong: (gauge level: "high")
    deep: unit {
        base: 5
        # read through deep, and found from base
        next: base + 1
        # never read: a number added to a text
        wrong: 1 + "x"
    }
}
