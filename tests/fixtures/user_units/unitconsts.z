# unitconsts -- constants another unit converts, for
# user_unit_constant_conversion: defined in the public block, re-exported
# there from a subunit, and outside it
public: unit {
    # five
    five: 5
    # a half
    half: 0.5
    # a typed quarter
    quarter: 0.25.f64
    # seven, from the inner subunit
    seven: inner.seven
}

# eight, outside the public block
eight: 8
