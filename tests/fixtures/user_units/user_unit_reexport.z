# user_unit_reexport.z -- a hidden subunit's type, constant and function,
# each reached through the re-export its parent declares. The subunit itself
# stays unreachable: naming `reexp.impl` from here is E0101.
main: function is {
    t: reexp.Thing n: 7
    print "reexp.Thing n = \{t.n}"
    m: reexp.make n: 9
    print "reexp.make n = \{m.n}"
    print "reexp.SCALE = \{reexp.SCALE}"
    print "reexp.scaled 5 = \{reexp.scaled n: 5}"
}
