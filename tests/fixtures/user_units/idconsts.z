# types whose `as` constants another unit names as a default
public: unit {
    :rid
    :shade
    :Box
}

# an id with its zero inside the type
rid: typedef u32 as {
    # identity by id
    ==: function {this: this.view rhs: rid} out bool is {
        return this.u32 == rhs.u32
    }
    # the sentinel test
    isZero: function {this: this.view} out bool is {
        return this.u32 == 0
    }
    # the zero id
    zero: rid 0
}

# a sum whose constant names one of its arms
shade: variant {
    # dark
    dark: null
    # light
    light: null
} as {
    # the shade a slot starts in
    usual: shade.light
}

# a class named like the prelude's `Box`, whose constant another unit reads
Box: class {
    # the boxed value
    v: i64
} as {
    # a constant of this Box, not of core's
    seven: 7
}
