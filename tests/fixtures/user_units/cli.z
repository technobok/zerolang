# cli.z -- a user unit named `cli`. The registry classification sweep used to
# read a type's UNIT NAME, so a record or class declared here was filed under
# the io/cli worklists and emitted early -- ahead of the function-pointer
# typedefs its own members need. This file emitted C that would not compile,
# while the same bytes in a file called `clix.z` compiled and ran. Nothing
# here collides with a real cli name: it was the UNIT's name that decided it.
#
# All three member forms appear: a function-pointer field and a per-instance
# bodied method in the body block, and a shared method in `as`.
double: function {v: u64} out u64 is {
    return v * 2
}

Gadget: record {
    size: u64
    # a function-POINTER field and a per-instance bodied method: both store the
    # callable in the object, so both need the `_ft` typedef this unit's name
    # used to suppress.
    op: function {v: u64} out u64
    twice: function {this: this.view} out u64 is {
        return this.size + this.size
    }
}

Widget: class {
    size: u64
} as {
    grow: function {this: this.view} out u64 is {
        return this.size + 1
    }
}
