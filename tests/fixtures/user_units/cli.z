# cli.z -- a user unit named `cli`. The registry classification sweep used to
# read a type's UNIT NAME, so a record or class declared here was filed under
# the io/cli worklists and emitted early -- ahead of the function-pointer
# typedefs its own members need. This file emitted C that would not compile,
# while the same bytes in a file called `clix.z` compiled and ran. Nothing
# here collides with a real cli name: it was the UNIT's name that decided it.
Gadget: record {
    size: u64
    doubleSize: function {this: this.view} out u64 is {
        return this.size * 2
    }
}

Widget: class {
    size: u64
    grow: function {this: this.view} out u64 is {
        return this.size + 1
    }
}
