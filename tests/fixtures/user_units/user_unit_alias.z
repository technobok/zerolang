# user_unit_alias -- an alias of a FILE unit (`l: aliaslib`) is that unit: a
# function called through it, a constant read through it. And the case it is
# for: inside a type that has a member named like a file unit, the member is
# the nearer declaration, so the unit is reached through an alias the type
# does not hide (`pathunit.join` beside the type's own `path`).

l: aliaslib
pathunit: path

Fs: class { root: String } as {
    path: function {f: this.view rel: StringView} out String is {
        return (pathunit.join a: f.root.stringView b: rel)
    }
}

# a join's separator is the platform's, so each is compared with the unit's
# own call rather than printed
main: function is {
    print "\{aliaslib.twice n: 2} \{l.twice n: 3} \{l.K}"
    viaAlias: pathunit.join a: "x" b: "y"
    direct: path.join a: "x" b: "y"
    print "alias joins as the unit does: \{viaAlias.stringView == direct.stringView}"
    f: Fs root: "/a".string
    inType: f.path rel: "b"
    rooted: path.join a: "/a" b: "b"
    print "and inside the type: \{inType.stringView == rooted.stringView}"
}
