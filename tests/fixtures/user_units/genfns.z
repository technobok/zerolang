# genfns.z -- generic free functions called from another unit
# (user_unit_generic_fn.z).
mk: function as { t: anyval.generic } in { a: t } out (ListVal t: t) is {
    l: (ListVal t: t)
    l.append from: a
    return l
}
pad: function as { t: anyval.generic } in { a: t n: 3 } out i64 is {
    l: (ListVal t: t)
    l.append from: a
    return n
}
note: function as { t: anyval.generic } in { a: t } is {
    print "note \{a}"
}
