# user_unit_generic_file_own_fn.z -- a generic FILE unit's function with a type
# parameter of its own (gencell.tagged), called through an instance of the unit
# at two types: each call mints an instance of the instance's copy.
gi: (gencell t: i64)

main: function is {
    c: gi.mk x: 6
    print "tagged \{gi.tagged :c x: true} \{gi.tagged :c x: 2.5}"
}
