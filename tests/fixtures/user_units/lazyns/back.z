# back -- the sibling front uses. A signature names a sibling type, and a
# subunit of its own does the adding. Each unused definition below is wrong,
# and nothing reaches it.

# one term of a sum
Piece: record {
    # the term
    v: u64
} as {
    # never called: no member `w`
    weight: function {:this} out u64 is {
        return this.w
    }
}

# never used: a field of no type at all
Broken: record {
    v: nothing
}

# pieces -- 1..n, one piece each
pieces: function {n: u64} out (ListVal Piece) is {
    r: ListVal Piece
    i: 1.u64
    for i <= n loop {
        r.append (Piece v: i)
        i = i + 1
    }
    return r
}

# sumOf -- the pieces' total
sumOf: function {ps: (ListVal Piece).view} out u64 is {
    t: 0.u64
    for each p: ps loop t = deep.plus a: t b: p.v
    return t
}

# never called: a String where a u64 is declared
label: function out u64 is {
    return "back"
}
