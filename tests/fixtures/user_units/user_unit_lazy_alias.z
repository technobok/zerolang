# user_unit_lazy_alias.z -- a behavioural pin, not a golden: `lazyalias.Thing`
# re-exports a type out of a hidden subunit whose `require:` block asks for a
# library that does not exist, and this program never names it. It links and
# runs only while the alias resolves on demand; resolving it to classify the
# definition pulls the subunit in and the link fails.
main: function is {
    print "lazyalias.greet = \{lazyalias.greet}"
}
