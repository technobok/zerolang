# A TYPE'S PUBLIC ALIAS IS REACHED THROUGH ITS UNIT AND THE TYPE
# (`aliasunit.Tree.Node`): as a construction, a parameter's type and a type
# argument. The private one stays the type's own (errors/alias_path_private).
keep: function {p: aliasunit.Tree.Node} out i64 is { return p.x + p.y }

main: function is {
    n: aliasunit.Tree.Node x: 1 y: 2
    t: aliasunit.Tree root: n
    l: ListVal aliasunit.Tree.Node
    l.append t.peek
    print "\{keep p: t.root} \{l.length}"
}
