# user_unit_unit_path -- a file unit's data types reached through an alias of
# the unit and through the unit it declares: a construction head, a type alias
# and a data field's type.
u: unitpath
lk: u.link
viaAlias: (lk library: "a")
viaUnit: (u.link library: "b" weight: 2)
deep: (unitpath.inner.deeplink library: "c" weight: 3)
holder: data {
    a: u.link
    b: unitpath.link
    d: unitpath.inner.deeplink
}
h: (holder a: viaAlias b: viaUnit d: deep)

main: function is {
    print "\{viaAlias.weight} \{viaUnit.weight} \{deep.weight}"
    print "\{h.a.library.stringView} \{h.b.weight} \{h.d.weight}"
}
