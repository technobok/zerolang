# a record whose method does not type in any instance: a program that never
# names one never walks it, as with any unused definition
Bad: record {
    # a value
    v: u64
} as {
    n: u64.generic
    # a String where a u64 is declared
    wrong: function {t: this.view} out u64 is {
        return "n squared"
    }
}
