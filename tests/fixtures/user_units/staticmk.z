# staticmk -- types whose members take no receiver, for
# user_unit_static_autocall: one with every parameter defaulted, one with none
# at all, on a class and on a record.

# a counter that starts where it is told
Counter: class {
    # the count so far
    n: i64
} as {
    # a counter at `start`
    starting: function {start: 7} out Counter is {
        return (meta.create n: start)
    }

    # a counter at zero
    fresh: function out Counter is {
        return (meta.create n: 0)
    }
}

# a point on a line
spot: record {
    # its place
    x: i64
} as {
    # the spot at x
    at: function {x: 9} out spot is {
        return (spot :x)
    }
}
