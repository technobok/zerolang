# user_unit_os.z -- a program whose `os` is the user unit next door. Reaching
# `os.pid` without parens auto-calls a bodied zero-parameter member, which the
# old no-arg name list turned into a `z_os_pid()` native call.
main: function is {
    print "os.pid=\{os.pid}"
    print "os.cwd=\{os.cwd}"
    print "os.describe=\{os.describe 41}"
    h: os.Handle n: 7
    print "os.Handle.readLine=\{h.readLine}"
}
