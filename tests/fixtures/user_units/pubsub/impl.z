# impl -- pubsub's hidden subunit, never listed in its public block
SCALE: 3

Foo: record {
    n: i64
}

twice: function {x: i64} out i64 is {
    return x * 2
}

# a class whose methods are reached through the block's alias wherever a type
# is written
Cell: class {
    n: i64
} as {
    show: function {c: this.view} out String is {
        return "cell \{c.n}"
    }
}
