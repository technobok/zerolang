# gencell.z -- a generic FILE unit: its body declares `t`, so the file is a
# template, and a binding of it (`gi: (gencell t: i64)`) is an instance whose
# types are that instance's own copies (user_unit_generic_file_types.z).
t: anyval.generic

# Cell -- one value of the instance's type
Cell: record {
    v: t
}

# mk -- a cell holding `x`
mk: function {x: t} out Cell is {
    return (Cell v: x)
}
