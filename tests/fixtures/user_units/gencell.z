# gencell.z -- a generic FILE unit: its body declares `t`, so the file is a
# template, and a binding of it (`gi: (gencell t: i64)`) is an instance whose
# types and functions are that instance's own copies
# (user_unit_generic_file_types.z, user_unit_generic_file_own_fn.z).
t: anyval.generic

# Cell -- one value of the instance's type
Cell: record {
    v: t
}

# mk -- a cell holding `x`
mk: function {x: t} out Cell is {
    return (Cell v: x)
}

# tagged -- any value, after the cell's own: a function with a type parameter
# of its own, a template on each instance of the unit
tagged: function as { u: anyval.generic } in {c: Cell x: u} out u is {
    print "cell \{c.v}"
    return x
}
