# unitpath -- a data type and a choice at the top of a unit, and a data type in
# a unit it declares, for user_unit_unit_path and user_unit_unit_path_signature
link: data {
    library: text
    weight: 1
}
os: choice {
    linux: null
    other: link
}
inner: unit {
    deeplink: data {
        library: text
        weight: 1
    }
}
