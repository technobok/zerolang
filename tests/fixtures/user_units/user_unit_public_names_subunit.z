# user_unit_public_names_subunit.z -- reaching a hidden subunit's definitions
# through the public block of the unit next door (pubsub.z). The block's alias
# looked its target's unit up in the block alone, so `impl` was an unknown
# reference; and the constant fold that tries an alias first marked `impl`
# defined without resolving it as a unit, so `Foo` arrived with no fields.
main: function is {
    f: pubsub.Foo n: 4
    print "twice f.n=\{pubsub.twice x: f.n} SCALE=\{pubsub.SCALE}"
}
