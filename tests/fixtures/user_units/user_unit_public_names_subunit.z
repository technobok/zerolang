# user_unit_public_names_subunit.z -- reaching a hidden subunit's definitions
# through the public block of the unit next door (pubsub.z). The block's alias
# looked its target's unit up in the block alone, so `impl` was an unknown
# reference; and the constant fold that tries an alias first marked `impl`
# defined without resolving it as a unit, so `Foo` arrived with no fields.
# And a qualified type-ref looked the member up from the unit's scope, which no
# bare name of the unit's reaches into the block from: a parameter typed
# `pubsub.Cell` stayed unstamped, unreported, and `c.show` reached the C as a
# field read. Every type position is here: parameter, marked parameter,
# return, field and element.
Holder: class {
    c: pubsub.Cell
}

make: function {n: i64} out pubsub.Cell is {
    return (pubsub.Cell :n)
}

shown: function {c: pubsub.Cell} out String is {
    return c.show
}

viewed: function {c: pubsub.Cell.view} out String is {
    return c.show
}

main: function is {
    f: pubsub.Foo n: 4
    print "twice f.n=\{pubsub.twice x: f.n} SCALE=\{pubsub.SCALE}"
    h: Holder c: (make n: 3)
    print "\{h.c.show} \{viewed c: h.c}"
    xs: ListRef pubsub.Cell
    xs.append (pubsub.Cell n: 5)
    print "\{(xs.get i: 0).show} \{shown c: (make n: 6)}"
}
