# latecount -- a dependency of user_unit_member_used_late: a typed constant the
# program reads, and a namespace whose function counts with `times`. A
# dependency's namespace is walked after the program's own bodies, so the
# count is the first use of `u64.times`.

# the cap the program reads
limit: 15.u32

# counting, in a namespace of its own
inner: unit {
    # count -- the sum of 0 .. n - 1
    count: function {n: u64} out u64 is {
        s: u64
        for each i: n.times loop s = s + i
        return s
    }
}
