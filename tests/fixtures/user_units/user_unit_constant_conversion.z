# another unit's constant converts as written in that unit: an untyped one as
# its literal does -- `unit.N.u8` is `5.u8`, a constant of the target type --
# and a typed one through its type's surface. Whether the unit's public block
# defines it, re-exports it from a subunit, or its root defines it. The read
# was never folded at the use (the conversion took its default's runtime form,
# a resultval); a constant the public block defines or re-exports was not
# found, so `unit.seven` reached the C as the path itself; and a typed one
# (`quarter: 0.25.f64`, indexed as a re-export) read as a TYPE, so `.f32`
# demanded a receiver.
main: function is {
    a: unitconsts.five.u8
    b: unitconsts.half.f32
    c: unitconsts.seven.u16
    d: plainconsts.three.u16
    e: plainconsts.nine3.f32
    print "\{a} \{b} \{c} \{d} \{e} \{unitconsts.seven} \{unitconsts.quarter}"
    q: unitconsts.quarter.f32
    match q case ok then print "q \{q}" case err then print "q err"
    r: plainconsts.quarter.f32
    match r case ok then print "r \{r}" case err then print "r err"
}
