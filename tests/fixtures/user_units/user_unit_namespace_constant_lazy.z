# A program that reads a constant of a nested unit checks that constant and
# what it reads, as it does for a file unit's constant, and no other. Each
# unit below holds a constant that has no value and that nothing reads, and
# the program compiles and runs: lazyconsts's topWrong, inner.wrong,
# inner.deep.wrong and sub.wrong, and `own.wrong` below.

own: unit {
    # read below
    seven: 7
    # never read: a number added to a text
    wrong: 1 + "x"
}

main: function is {
    print "\{lazyconsts.inner.ok.level} \{lazyconsts.inner.deep.next} \{own.seven}"
    print "\{lazyconsts.subSteps n: 3}"
}
