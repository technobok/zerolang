# user_unit_subunit_constant_fold -- a constant read through a SUBUNIT
# (`armal.deep.k2`) folds like one read straight off a unit: at unit level, in
# an `if` there, and as a definition naming the subunit's arm. The evaluator
# only followed a bare unit base, so `K` was "not a compile-time constant" and
# `L` typed to nothing, which the emitter was first to notice.

# a predicate on a subunit's constant, folded
K: (if armal.deep.k2.up then { 1 } else { 0 })

# a subunit's arm, named through two units
L: armal.deep.duo.up

# a subunit's constant itself
C: armal.deep.k2

main: function is {
    print "K=\{K}"
    if L == armal.deep.duo.up then print "L up" else print "L down"
    m: L
    if m.up then print "m up"
    if C == L then print "C is L"
}
