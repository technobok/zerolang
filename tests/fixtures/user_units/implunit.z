# implunit -- a class whose `.implement` label is no public member: the label is
# a name, and hiding it hides the name only. That the class implements the
# protocol is no member at all, so another unit passes it as the protocol.
public: unit {
    :Speaker
    :Dog
}

Speaker: protocol {
    speak: function {t: this.view} out u64
}

Dog: class { n: u64 } as {
    s: Speaker.implement
    speak: function {t: this.view} out u64 is { return t.n + 40 }
    public: unit {
        :speak
    }
}
