# armal -- value aliases that name an arm (`k: pair.b`), read through the unit
# and through its subunit, for user_unit_arm_alias_predicate
public: unit {
    :pair
    :k
    :tri
    :t
    :deep
}

# two arms: a bool-shaped variant
pair: variant {
    # the first arm
    a: null
    # the second arm
    b: null
}

# three arms: a tag-shaped variant
tri: variant {
    # the first arm
    x: null
    # the second arm
    y: null
    # the third arm
    z: null
}

# a value alias of pair's second arm
k: pair.b

# a value alias of tri's second arm
t: tri.y
