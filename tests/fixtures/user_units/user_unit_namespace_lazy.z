# A namespace resolves a member when a use names it, as a file unit does: a
# hidden subunit, a subunit of a subunit and an inline namespace each check
# only what the program reaches. Every unused definition in them is wrong --
# lazyns's back and deep beside, and `shapes` below -- and the program compiles
# and runs. `shapes.Sq` is reached from two places, and is one type.

shapes: unit {
    # a square
    Sq: record {
        # its side
        side: u64
    } as {
        # its area
        area: function {:this} out u64 is {
            return this.side * this.side
        }
    }
    # a square of side s
    sq: function {s: u64} out Sq is {
        return (Sq side: s)
    }
    # never called: a String where a u64 is declared
    perimeter: function {s: Sq} out u64 is {
        return "four sides"
    }
}

main: function is {
    a: shapes.sq s: 3
    b: shapes.Sq side: 4
    print "\{lazyns.total n: 4} \{a.area} \{b.area}"
}
