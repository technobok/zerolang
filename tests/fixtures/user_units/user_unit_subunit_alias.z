# user_unit_subunit_alias -- a unit-level alias whose target is reached through
# a SUBUNIT (`armal.deep.duo`): a type alias, an arm and a constant. The target
# pair carried only the qualifier's last segment, which names no file unit, so
# the type alias resolved to nothing and its every use reached the emitter
# ("unhandled binding type"), and a missing member was reported by nobody.

# the subunit's type, by another name
T: armal.deep.duo

# one of its arms
U: armal.deep.duo.down

# its constant
K: armal.deep.k2

# up -- whether `d` holds the first arm, read through the alias in a type
# position
up: function {d: T} out bool is {
    return d.up
}

main: function is {
    x: T.up
    print "x up=\{up d: x}"
    u: U
    print "U up=\{up d: u}"
    if K == T.up then print "K is up"
}
