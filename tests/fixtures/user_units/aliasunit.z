# aliasunit -- a type with two aliases, one in its `public:` block. The type's
# own method names the other, which is private to the type.
public: unit {
    :Tree
    :Point
}

Point: record { x: i64 y: i64 }

Tree: class { root: Node } as {
    Node: Point
    Hidden: Point
    public: unit {
        :Node
        :root
        :peek
    }
    peek: function {t: this.view} out Hidden is { return t.root }
}
