Lim: typeconsts.Limits
NEXT: typeconsts.Limits.PAGE + 1
HALF: typeconsts.Limits.RATIO * 2.0

Local: record {
    x: i64
} as {
    BIG: typeconsts.Limits.TWICE + 1
    VIA: Lim.PAGE
}

consume: function {n: i64 r: f64 s: StringView} is {
    print "take \{n} \{r} \{s}"
}

main: function is {
    print "\{typeconsts.Limits.PAGE} \{typeconsts.Limits.LABEL} \{typeconsts.Limits.RATIO}"
    p: typeconsts.Limits.PAGE
    r: typeconsts.Limits.RATIO
    s: typeconsts.Limits.LABEL
    print "\{p} \{r} \{s} \{s.length}"
    consume n: typeconsts.Limits.TWICE r: typeconsts.Limits.RATIO s: typeconsts.Limits.LABEL
    print "\{Lim.PAGE} \{Lim.RATIO} \{NEXT} \{HALF} \{Local.BIG} \{Local.VIA}"
}
