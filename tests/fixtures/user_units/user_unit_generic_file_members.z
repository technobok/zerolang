# user_unit_generic_file_members.z -- every member of a generic FILE unit is the
# instance's: its alias is the argument in the instance's signatures and through
# the instance (`gi.elem`), a zero value through it is the argument's zero, and
# its data block is the instance's own copy, read inside and through it, and
# so is its nested unit.
gi: (genmembers t: i64)
gf: (genmembers t: f64)

# twice -- an i64 through the instance's alias, in a parameter and a return
twice: function {v: gi.elem} out gi.elem is { return v * 2 }

main: function is {
    print "\{gi.get v: 4} \{gf.get v: 2.5} \{gi.zero} \{gf.zeroT}"
    print "\{twice v: 21} \{gf.nothing}"
    print "\{gi.pick i: 2} \{gf.pick i: 3} \{gi.primes.length} \{gf.primes.index i: 1}"
    print "\{gi.viaInner v: 4} \{gf.inner.twice v: 1.5} \{gi.inner.third} \{gf.again v: 0.5}"
}
