# user_unit_generic_file_members.z -- every member of a generic FILE unit is the
# instance's: its alias is the argument in the instance's signatures and through
# the instance (`gi.elem`), and a zero value through it is the argument's zero.
gi: (genmembers t: i64)
gf: (genmembers t: f64)

# twice -- an i64 through the instance's alias, in a parameter and a return
twice: function {v: gi.elem} out gi.elem is { return v * 2 }

main: function is {
    print "\{gi.get v: 4} \{gf.get v: 2.5} \{gi.zero} \{gf.zeroT}"
    print "\{twice v: 21} \{gf.nothing}"
}
