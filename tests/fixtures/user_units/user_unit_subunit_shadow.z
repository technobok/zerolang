# user_unit_subunit_shadow.z -- a hidden subunit and a top-level unit of the
# same name. The typechecker binds `util.tag` inside holder to the SUBUNIT; the
# emitter resolved the base through the file-unit name index and called the
# top-level one instead, so the program returned the wrong answer with no
# diagnostic anywhere.
main: function is {
    print "holder.pick=\{holder.pick} util.tag=\{util.tag}"
}
