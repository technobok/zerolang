# genseq.z -- a generic FILE unit declaring a generator: each instance of the
# unit (`gs: (genseq t: i64)`) has its own copy of the generator, lowered and
# checked over the instance's element (user_unit_generic_file_generator.z).
t: anyval.generic

# Times -- `item`, `n` times
Times: generator { item: t n: i64 } as {
    call: function out t is {
        for each i: this.n.times loop yield this.item
    }
}
