# user_unit_cli.z -- a program whose `cli` is the user unit next door. A record
# with a function-pointer field and a class with an as-block method each emitted
# invalid C for as long as the unit was called `cli`: zc reported success and
# the C did not compile.
main: function is {
    g: cli.Gadget size: 21 op: cli.double.take
    print "cli.Gadget.op=\{g.op v: 21}"
    print "cli.Gadget.twice=\{g.twice}"
    w: cli.Widget size: 5
    print "cli.Widget.grow=\{w.grow}"
    print "cli.Gadget.flush=\{g.flush}"
    print "cli.Widget.close=\{w.close}"
    print "cli.Widget.write=\{w.write from: 3}"
}
