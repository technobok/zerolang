# user_unit_cli.z -- a program whose `cli` is the user unit next door. A record
# carrying a function-typed member and a class carrying a bodied method each
# emitted invalid C for as long as the unit was called `cli`; zc reported
# success and the C did not compile.
main: function is {
    g: cli.Gadget size: 21
    print "cli.Gadget.doubleSize=\{g.doubleSize}"
    w: cli.Widget size: 5
    print "cli.Widget.grow=\{w.grow}"
}
