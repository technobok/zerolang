# genmeths -- a type of another unit whose method has a type parameter of its
# own; user_unit_generic_method.z calls it
public: unit {
    :Sink
}

# Sink -- the bytes of every text it is given
Sink: class {
    total: u64
} as {
    # add -- count the text's bytes
    add: function as { T: StringLike.generic } in {:this text: T.view} is {
        this.total = this.total + text.length
    }
}
