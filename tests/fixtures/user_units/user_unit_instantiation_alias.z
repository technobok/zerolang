# a unit-level alias of a generic instance, reached through its unit's path,
# names that instance as the bare name does. `aliasinst.F2 from: 7` constructs
# it -- the path was read as a constant VALUE, which takes no arguments -- as
# does the same alias listed in a public block, the shape math's i256 has; and
# `aliasinst.F2` as a parameter's type is the instance, not a shell named F2
# minted when the signature resolved before anything folded the alias. A field
# declared with an instantiation is still a value through its path.

# show -- the value of an aliased instance, typed through the path
show: function {x: aliasinst.F2.view} out u64 is {
    return x.v
}

# a record whose field is declared with an instantiation
holder: record {
    # a value that may be absent
    o: (optionval t: u64)
}

main: function is {
    a: aliasinst.F2 from: 7
    b: aliaspub.F5 from: 1
    c: aliasinst.F2
    h: holder o: (optionval t: u64).some 4
    print "\{a.v} \{b.v} \{c.v} \{show x: a} \{h.o.or d: 0}"
}
