# sqlite.z -- a user unit named `sqlite`, whose types share the stdlib unit's
# names and declare nothing native. The stdlib's natives.tbl rows name unit
# `sqlite` and its classes by spelling; applied here, they built and linked the
# SQLite library for a program that never calls it, gave these classes the
# runtime's struct and destroy, and bound their methods to its fragments.
version: function out String is {
    v: String
    v.append "user sqlite 1"
    return v
}

SqliteError: class {
    code: i64
}

Database: class {
    handle: u64
} as {
    open: function {path: StringView} out (Result Database E: SqliteError) is {
        if path.length == 0 then return ((Result Database E: SqliteError).err (SqliteError code: 1))
        return ((Result Database E: SqliteError).ok (Database handle: path.length))
    }
    changes: function {this: this.view} out u64 is {
        return this.handle * 2
    }
    prepare: function {this: this.view sql: StringView} out Statement is {
        return (Statement sql: sql.string)
    }
}

Statement: class {
    sql: String
} as {
    step: function {this: this.view} out Step is {
        return (Step row: (Row n: this.sql.length))
    }
}

Step: class {
    row: Row
}

Row: class {
    n: u64
}
