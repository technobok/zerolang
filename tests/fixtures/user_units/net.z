# net.z -- a user unit named `net`. A `net.<member>` call injected all seven
# net fragments, which reference Listener and Conn -- types this program does
# not have -- so the emitted C did not compile. The member resolves to a
# bodied declaration here, so nothing is injected.
listen: function {port: i64} out i64 is {
    return port + 1
}

pollReadable: function {fd: i64} out i64 is {
    return fd * 2
}

# `accept` is admitted by the native no-arg list ONLY when the receiver's unit
# is spelled `net`, so this is the one member name the cli and os fixtures
# above cannot reach.
Sock: class {
    fd: u64
} as {
    accept: function {this: this.view} out u64 is {
        return this.fd + 1
    }
    write: function {this: this.view from: u64} out u64 is {
        return this.fd + from
    }
}
