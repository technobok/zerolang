# os.z -- a user unit named `os`. The emitter used to route native calls by
# comparing the callee's unit NAME, so every `os.<member>` here demanded a
# runtime fragment for a member this unit declares itself, and `pid` matched
# the hardcoded no-arg list and emitted a bare `z_os_pid()` call. Routing asks
# the resolved declaration now: these are bodied, so they gate no fragment and
# emit as the ordinary unit members they are. The names deliberately collide
# with real os natives, `pid` and `cwd` taking no parameters like theirs do.
pid: function out i64 is {
    return 4242
}

cwd: function out StringView is {
    return "/user/os/cwd"
}

describe: function {n: i64} out i64 is {
    return n + 1
}

# the member-read half of the same question the free functions above ask: a
# no-arg read whose NAME is on the emitter's native list, on a receiver whose
# unit is merely spelled `os`.
Handle: class {
    n: u64
} as {
    readLine: function {this: this.view} out u64 is {
        return this.n + 1
    }
    seek: function {this: this.view to: u64} out u64 is {
        return this.n + to
    }
}
