# user_unit_generic_method.z -- a generic method of another unit's type,
# called on an instance and type-qualified, runs the instance its argument's
# type selects.
main: function is {
    k: genmeths.Sink total: 0
    k.add text: "abcd"
    k.add text: "ef".string
    genmeths.Sink.add k text: "ghi"
    print "total: \{k.total}"
}
