# user_unit_generic_file_types.z -- a type a generic FILE unit's instance
# declares, named through the instance in a field, a parameter and a return
# (`gi.Cell`), is that instance's own copy; so is one another unit's instance
# names in its own signature. Plain and `--eager` alike: eager-guard resolves
# the signatures before any instantiation pass.
gi: (gencell t: i64)

# Box -- an instance's type held in a field
Box: record {
    c: gi.Cell
}

# show -- the value an i64 cell holds
show: function {c: gi.Cell} out i64 is {
    return c.v
}

# make -- an i64 cell, through the instance's own function
make: function {x: i64} out gi.Cell is {
    return (gi.mk :x)
}

main: function is {
    b: Box c: (make x: 4)
    print "\{show c: (gi.mk x: 5)} \{b.c.v} \{gencellhalf.half c: (gencellhalf.gx.mk x: 3.0)}"
}
