# genmembers.z -- a generic FILE unit whose members are each instance's own: an
# alias of the parameter, a zero value through it, a data block, and a nested
# unit.
t: anyval.generic
elem: t
nothing: t
primes: data { 2 3 5 7 }

# get -- the value, typed through the alias
get: function {v: elem} out elem is { return v }

# again -- a sibling's result over the parameter: the unit's function is no
# generic function of its own, so the template's walk checks the call
again: function {v: t} out t is { return (get v: v) }

# zero -- the argument's zero, read through the alias
zero: function out t is { return nothing }

# zeroT -- the argument's zero, read as the parameter
zeroT: function out t is { return t }

# pick -- one of the instance's primes, read inside the unit
pick: function {i: u64} out i64 is { return (primes.index :i) }

# inner -- a unit the instance has its own instance of
inner: unit {
    twice: function {v: t} out t is { return v + v }
    third: function out i64 is { return (primes.index i: 2) }
}

# viaInner -- the nested instance's function, read inside the unit
viaInner: function {v: t} out t is { return (inner.twice v: v) }
