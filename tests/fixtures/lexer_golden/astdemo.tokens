8:24 WS " "
8:25 LABEL "source"
8:31 COLON ":"
8:32 WS " "
8:33 REFID "src"
8:36 DOT "."
8:37 REFID "copy"
8:41 WS " "
8:42 COLON ":"
8:43 LABELPRE "pool"
8:47 EOL "\n"
9:1 WS "    "
9:5 REFID "print"
9:10 WS " "
9:11 STRBEG "\""
9:12 STRMID "tokens: "
9:20 STREXPRBEG "\\"
9:21 BRACEOPEN "{"
9:22 REFID "toks"
9:26 DOT "."
9:27 REFID "length"
9:33 BRACECLOSE "}"
9:34 STREND "\""
9:35 EOL "\n"
10:1 WS "    "
10:5 LABEL "node"
10:9 COLON ":"
10:10 WS " "
10:11 REFID "ast"
10:14 DOT "."
10:15 REFID "parseSource"
10:26 WS " "
10:27 LABEL "source"
10:33 COLON ":"
10:34 WS " "
10:35 REFID "src"
10:38 DOT "."
10:39 REFID "copy"
10:43 EOL "\n"
11:1 WS "    "
11:5 MATCH "match"
11:10 WS " "
11:11 PARENOPEN "("
11:12 EOL "\n"
12:1 WS "        "
12:9 REFID "node"
12:13 EOL "\n"
13:1 WS "    "
13:5 PARENCLOSE ")"
13:6 WS " "
13:7 CASE "case"
13:11 WS " "
13:12 REFID "program"
13:19 WS " "
13:20 THEN "then"
13:24 WS " "
13:25 BRACEOPEN "{"
13:26 EOL "\n"
14:1 WS "        "
14:9 IF "if"
14:11 WS " "
