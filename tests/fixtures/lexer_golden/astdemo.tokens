1:1 COMMENT "# astdemo.z -- exercises the public `tokenize` + `ast` preview API: lex a source"
1:81 EOL "\n"
2:1 COMMENT "# string into its full token stream, then parse it to a program node"
2:69 EOL "\n"
3:1 COMMENT "# wrapping the source as one unit (the master node table rides inside)."
3:72 EOL "\n"
4:1 LABEL "main"
4:5 COLON ":"
4:6 WS " "
4:7 FUNCTION "function"
4:15 WS " "
4:16 IS "is"
4:18 WS " "
4:19 BRACEOPEN "{"
4:20 EOL "\n"
5:1 WS "    "
5:5 LABEL "src"
5:8 COLON ":"
5:9 WS " "
5:10 STRBEG "\""
5:11 STRMID "add: function {a: i32 b: i32} out i32 is { return a + b }"
5:68 STRCHR "\n"
5:70 STREND "\""
5:71 DOT "."
5:72 REFID "string"
5:78 EOL "\n"
6:1 WS "    "
6:5 COMMENT "# a token carries its text as an id into a pool the caller owns"
6:68 EOL "\n"
7:1 WS "    "
7:5 LABEL "pool"
7:9 COLON ":"
7:10 WS " "
7:11 REFID "tokenize"
7:19 DOT "."
