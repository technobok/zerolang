31:28 STREXPRBEG "\\"
31:29 BRACEOPEN "{"
31:30 REFID "r2"
31:32 BRACECLOSE "}"
31:33 STREND "\""
31:34 EOL "\n"
32:1 EOL "\n"
33:1 WS "    "
33:5 REFID "print"
33:10 WS " "
33:11 STRBEG "\""
33:12 STRMID "done"
33:16 STREND "\""
33:17 EOL "\n"
34:1 BRACECLOSE "}"
