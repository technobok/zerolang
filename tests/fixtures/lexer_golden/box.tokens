1:1 COMMENT "# box.z - Box type demonstration"
1:33 EOL "\n"
2:1 COMMENT "# Box heap-allocates one VALTYPE and gives it pointer-based semantics, so a"
2:76 EOL "\n"
3:1 COMMENT "# large record travels as an 8-byte pointer instead of by copy. It is also"
3:75 EOL "\n"
4:1 COMMENT "# how a union spells a valtype arm."
4:36 EOL "\n"
5:1 COMMENT "#"
5:2 EOL "\n"
6:1 COMMENT "# A reftype needs no box: a class instance is already a heap pointer, so a box"
6:79 EOL "\n"
7:1 COMMENT "# around one is a pointer to a pointer."
7:40 EOL "\n"
8:1 EOL "\n"
9:1 LABEL "pt"
9:3 COLON ":"
9:4 WS " "
9:5 RECORD "record"
9:11 WS " "
9:12 BRACEOPEN "{"
9:13 EOL "\n"
10:1 WS "    "
10:5 LABEL "x"
10:6 COLON ":"
10:7 WS " "
10:8 REFID "i64"
10:11 EOL "\n"
11:1 WS "    "
11:5 LABEL "y"
11:6 COLON ":"
11:7 WS " "
11:8 REFID "i64"
11:11 EOL "\n"
12:1 BRACECLOSE "}"
12:2 EOL "\n"
13:1 EOL "\n"
14:1 LABEL "main"
14:5 COLON ":"
14:6 WS " "
14:7 FUNCTION "function"
14:15 WS " "
14:16 IS "is"
14:18 WS " "
14:19 BRACEOPEN "{"
14:20 EOL "\n"
15:1 WS "    "
15:5 COMMENT "# --- Box an integer (valtype) ---"
15:39 EOL "\n"
16:1 WS "    "
16:5 COMMENT "# heap-allocates the integer; b is int64_t*"
16:48 EOL "\n"
17:1 WS "    "
17:5 LABEL "b"
17:6 COLON ":"
17:7 WS " "
17:8 REFID "Box"
17:11 WS " "
17:12 LABEL "from"
17:16 COLON ":"
17:17 WS " "
17:18 REFID "42"
17:20 EOL "\n"
18:1 WS "    "
18:5 LABEL "r"
18:6 COLON ":"
18:7 WS " "
18:8 REFID "b"
18:9 WS " "
18:10 REFID "+"
18:11 WS " "
18:12 REFID "8"
18:13 EOL "\n"
19:1 WS "    "
19:5 REFID "print"
19:10 WS " "
19:11 STRBEG "\""
19:12 STRMID "boxed 42 + 8 = "
19:27 STREXPRBEG "\\"
19:28 BRACEOPEN "{"
19:29 REFID "r"
19:30 BRACECLOSE "}"
19:31 STREND "\""
19:32 EOL "\n"
20:1 EOL "\n"
21:1 WS "    "
21:5 COMMENT "# comparison works transparently"
21:37 EOL "\n"
22:1 WS "    "
22:5 IF "if"
22:7 WS " "
22:8 REFID "b"
22:9 WS " "
22:10 REFID "=="
22:12 WS " "
22:13 REFID "42"
22:15 WS " "
22:16 THEN "then"
22:20 WS " "
22:21 REFID "print"
22:26 WS " "
22:27 STRBEG "\""
22:28 STRMID "b is 42"
22:35 STREND "\""
22:36 EOL "\n"
23:1 EOL "\n"
24:1 WS "    "
24:5 COMMENT "# --- Box a record: the case boxing is actually for ---"
24:60 EOL "\n"
25:1 WS "    "
25:5 LABEL "p"
25:6 COLON ":"
25:7 WS " "
25:8 REFID "Box"
25:11 WS " "
25:12 LABEL "from"
25:16 COLON ":"
25:17 WS " "
25:18 PARENOPEN "("
25:19 REFID "pt"
25:21 WS " "
25:22 LABEL "x"
25:23 COLON ":"
25:24 WS " "
25:25 REFID "1"
25:26 WS " "
25:27 LABEL "y"
25:28 COLON ":"
25:29 WS " "
25:30 REFID "2"
25:31 PARENCLOSE ")"
25:32 EOL "\n"
26:1 WS "    "
26:5 REFID "p"
26:6 EOL "\n"
27:1 EOL "\n"
28:1 WS "    "
28:5 COMMENT "# --- Box with from: syntax ---"
28:36 EOL "\n"
29:1 WS "    "
29:5 LABEL "b2"
29:7 COLON ":"
29:8 WS " "
29:9 REFID "Box"
29:12 WS " "
29:13 LABEL "from"
29:17 COLON ":"
29:18 WS " "
29:19 REFID "100"
29:22 EOL "\n"
30:1 WS "    "
30:5 LABEL "r2"
30:7 COLON ":"
30:8 WS " "
30:9 REFID "b2"
30:11 WS " "
30:12 REFID "*"
