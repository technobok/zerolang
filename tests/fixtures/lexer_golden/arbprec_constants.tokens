35:15 WS " "
35:16 IS "is"
35:18 WS " "
35:19 BRACEOPEN "{"
35:20 EOL "\n"
36:1 WS "    "
36:5 COMMENT "# Call-arg coercion: bare 100 coerces to u8 (fits)."
36:56 EOL "\n"
37:1 WS "    "
37:5 REFID "push_byte"
37:14 WS " "
37:15 LABEL "b"
37:16 COLON ":"
37:17 WS " "
37:18 REFID "100"
37:21 EOL "\n"
38:1 EOL "\n"
39:1 WS "    "
39:5 COMMENT "# Call-arg coercion: explicit suffix still works."
39:54 EOL "\n"
40:1 WS "    "
40:5 REFID "push_byte"
40:14 WS " "
40:15 LABEL "b"
40:16 COLON ":"
40:17 WS " "
40:18 REFID "100"
40:21 EOL "\n"
41:1 EOL "\n"
42:1 WS "    "
42:5 COMMENT "# Call-arg coercion: constant expression folds and fits."
42:61 EOL "\n"
43:1 WS "    "
43:5 REFID "push_byte"
43:14 WS " "
43:15 LABEL "b"
43:16 COLON ":"
43:17 WS " "
43:18 REFID "50"
43:20 WS " "
43:21 REFID "+"
43:22 WS " "
43:23 REFID "25"
43:25 WS " "
43:26 REFID "+"
43:27 WS " "
43:28 REFID "25"
43:30 EOL "\n"
44:1 EOL "\n"
45:1 WS "    "
45:5 COMMENT "# Call-arg coercion: arithmetic where the intermediate exceeds"
45:67 EOL "\n"
46:1 WS "    "
46:5 COMMENT "# u8 but the final value fits."
46:35 EOL "\n"
47:1 WS "    "
47:5 REFID "push_byte"
47:14 WS " "
47:15 LABEL "b"
47:16 COLON ":"
47:17 WS " "
47:18 REFID "200"
47:21 WS " "
47:22 REFID "+"
47:23 WS " "
47:24 REFID "100"
47:27 WS " "
47:28 REFID "-"
47:29 WS " "
47:30 REFID "250"
47:33 EOL "\n"
48:1 EOL "\n"
49:1 WS "    "
49:5 COMMENT "# An intermediate past u64: `0xff...ff + 1` is `2^64`, held exactly,"
49:73 EOL "\n"
50:1 WS "    "
50:5 COMMENT "# and the u64 parameter takes the folded `2^64 - 1`."
50:57 EOL "\n"
51:1 WS "    "
51:5 REFID "push_u64"
51:13 WS " "
51:14 LABEL "x"
51:15 COLON ":"
51:16 WS " "
51:17 REFID "0xffffffffffffffff"
51:35 WS " "
51:36 REFID "+"
51:37 WS " "
51:38 REFID "1"
51:39 WS " "
51:40 REFID "-"
51:41 WS " "
51:42 REFID "1"
51:43 EOL "\n"
52:1 EOL "\n"
53:1 WS "    "
53:5 COMMENT "# Reassignment coercion: bare literal coerces to a's u8 type."
53:66 EOL "\n"
54:1 WS "    "
54:5 LABEL "a"
54:6 COLON ":"
54:7 WS " "
54:8 REFID "10"
54:10 DOT "."
54:11 REFID "u8"
54:13 EOL "\n"
55:1 WS "    "
55:5 REFID "a"
55:6 WS " "
55:7 EQUALS "="
55:8 WS " "
55:9 REFID "100"
55:12 EOL "\n"
56:1 WS "    "
56:5 REFID "a"
56:6 WS " "
56:7 EQUALS "="
56:8 WS " "
56:9 REFID "200"
56:12 WS " "
56:13 REFID "+"
56:14 WS " "
56:15 REFID "100"
56:18 WS " "
56:19 REFID "-"
56:20 WS " "
56:21 REFID "250"
56:24 EOL "\n"
57:1 EOL "\n"
58:1 WS "    "
58:5 COMMENT "# The small_value function exercises return-value coercion at"
58:66 EOL "\n"
59:1 WS "    "
59:5 COMMENT "# its own definition (`200 + 100 - 250` returning u8)."
59:59 EOL "\n"
60:1 WS "    "
