1:1 COMMENT "# arbprec_constants.z \u{2014} literal-coercion ergonomics demo."
1:58 EOL "\n"
2:1 COMMENT "#"
2:2 EOL "\n"
3:1 COMMENT "# Numeric literals (and constant expressions built from them) coerce"
3:69 EOL "\n"
4:1 COMMENT "# losslessly to a target numeric type at typed-location boundaries"
4:67 EOL "\n"
5:1 COMMENT "# without needing an explicit `.u8` / `.u32` / `.i32` suffix."
5:62 EOL "\n"
6:1 COMMENT "#"
6:2 EOL "\n"
7:1 COMMENT "# A literal that doesn't fit the target is rejected at compile time"
7:68 EOL "\n"
8:1 COMMENT "# with a literal-aware diagnostic (\"literal value 300 cannot be"
8:64 EOL "\n"
9:1 COMMENT "# losslessly stored in u8 (range 0..255)\") \u{2014} no runtime overflow."
9:66 EOL "\n"
10:1 COMMENT "#"
10:2 EOL "\n"
11:1 COMMENT "# Constant arithmetic is NOT unbounded: the compile-time evaluator"
11:67 EOL "\n"
12:1 COMMENT "# works in i64, so an expression whose operands do not fit one is not"
12:70 EOL "\n"
13:1 COMMENT "# folded at all \u{2014} it survives as runtime arithmetic and agrees with"
13:68 EOL "\n"
14:1 COMMENT "# the folded answer only where the target type's own wraparound makes"
14:70 EOL "\n"
15:1 COMMENT "# it agree. `push_u64` below is that case. See the arbitrary-precision"
15:71 EOL "\n"
16:1 COMMENT "# section of Design-OPEN.pdoc."
16:31 EOL "\n"
17:1 COMMENT "#"
17:2 EOL "\n"
18:1 COMMENT "# Explicit suffixes still work; they remain the user-facing escape"
18:67 EOL "\n"
19:1 COMMENT "# hatch when the surrounding context does not pin the type."
19:60 EOL "\n"
20:1 EOL "\n"
21:1 COMMENT "# Call-arg coercion: bare 8-bit byte literals into a u8 parameter."
21:67 EOL "\n"
22:1 LABEL "push_byte"
22:10 COLON ":"
22:11 WS " "
22:12 FUNCTION "function"
22:20 WS " "
22:21 BRACEOPEN "{"
22:22 LABEL "b"
22:23 COLON ":"
22:24 WS " "
22:25 REFID "u8"
22:27 BRACECLOSE "}"
22:28 WS " "
22:29 IS "is"
22:31 WS " "
22:32 BRACEOPEN "{"
22:33 EOL "\n"
23:1 WS "    "
23:5 REFID "b"
23:6 EOL "\n"
24:1 WS "    "
24:5 COMMENT "# Body is a no-op \u{2014} the call sites below are the point."
24:60 EOL "\n"
25:1 BRACECLOSE "}"
25:2 EOL "\n"
26:1 EOL "\n"
27:1 COMMENT "# Call-arg coercion: u64 parameter accepts an arbitrarily wide"
27:63 EOL "\n"
28:1 COMMENT "# intermediate."
28:16 EOL "\n"
29:1 LABEL "push_u64"
29:9 COLON ":"
29:10 WS " "
29:11 FUNCTION "function"
29:19 WS " "
29:20 BRACEOPEN "{"
29:21 LABEL "x"
29:22 COLON ":"
29:23 WS " "
29:24 REFID "u64"
29:27 BRACECLOSE "}"
29:28 WS " "
29:29 IS "is"
29:31 WS " "
29:32 BRACEOPEN "{"
29:33 WS " "
29:34 REFID "x"
29:35 WS " "
29:36 BRACECLOSE "}"
29:37 EOL "\n"
30:1 EOL "\n"
31:1 COMMENT "# Function-return coercion: the body `200 + 100 - 250` folds to 50"
31:67 EOL "\n"
32:1 COMMENT "# (which fits u8) \u{2014} the intermediate 300 does not block the coercion"
32:69 EOL "\n"
33:1 COMMENT "# because the final value is range-checked at the return boundary,"
33:67 EOL "\n"
34:1 COMMENT "# not in the middle of the expression."
34:39 EOL "\n"
35:1 LABEL "small_value"
35:12 COLON ":"
35:13 WS " "
35:14 FUNCTION "function"
35:22 WS " "
35:23 OUT "out"
35:26 WS " "
35:27 REFID "u8"
35:29 WS " "
35:30 IS "is"
35:32 WS " "
35:33 BRACEOPEN "{"
35:34 WS " "
35:35 REFID "200"
35:38 WS " "
35:39 REFID "+"
35:40 WS " "
35:41 REFID "100"
35:44 WS " "
35:45 REFID "-"
35:46 WS " "
35:47 REFID "250"
35:50 WS " "
35:51 BRACECLOSE "}"
35:52 EOL "\n"
36:1 EOL "\n"
37:1 LABEL "main"
37:5 COLON ":"
37:6 WS " "
37:7 FUNCTION "function"
37:15 WS " "
37:16 IS "is"
37:18 WS " "
37:19 BRACEOPEN "{"
37:20 EOL "\n"
38:1 WS "    "
38:5 COMMENT "# Call-arg coercion: bare 100 coerces to u8 (fits)."
38:56 EOL "\n"
39:1 WS "    "
39:5 REFID "push_byte"
39:14 WS " "
39:15 LABEL "b"
39:16 COLON ":"
39:17 WS " "
39:18 REFID "100"
39:21 EOL "\n"
40:1 EOL "\n"
41:1 WS "    "
41:5 COMMENT "# Call-arg coercion: explicit suffix still works."
41:54 EOL "\n"
42:1 WS "    "
42:5 REFID "push_byte"
42:14 WS " "
42:15 LABEL "b"
42:16 COLON ":"
42:17 WS " "
42:18 REFID "100"
42:21 EOL "\n"
43:1 EOL "\n"
44:1 WS "    "
44:5 COMMENT "# Call-arg coercion: constant expression folds and fits."
44:61 EOL "\n"
45:1 WS "    "
45:5 REFID "push_byte"
45:14 WS " "
45:15 LABEL "b"
45:16 COLON ":"
45:17 WS " "
45:18 REFID "50"
45:20 WS " "
45:21 REFID "+"
45:22 WS " "
45:23 REFID "25"
45:25 WS " "
45:26 REFID "+"
45:27 WS " "
45:28 REFID "25"
45:30 EOL "\n"
46:1 EOL "\n"
47:1 WS "    "
47:5 COMMENT "# Call-arg coercion: arithmetic where the intermediate exceeds"
47:67 EOL "\n"
48:1 WS "    "
48:5 COMMENT "# u8 but the final value fits."
48:35 EOL "\n"
49:1 WS "    "
49:5 REFID "push_byte"
49:14 WS " "
49:15 LABEL "b"
49:16 COLON ":"
49:17 WS " "
49:18 REFID "200"
49:21 WS " "
49:22 REFID "+"
49:23 WS " "
49:24 REFID "100"
49:27 WS " "
49:28 REFID "-"
49:29 WS " "
49:30 REFID "250"
49:33 EOL "\n"
50:1 EOL "\n"
51:1 WS "    "
51:5 COMMENT "# An intermediate wider than i64: `0xff...ff + 1` is `2^64`. The"
51:69 EOL "\n"
52:1 WS "    "
52:5 COMMENT "# evaluator cannot hold it, so this is not folded -- it reaches C"
52:70 EOL "\n"
53:1 WS "    "
53:5 COMMENT "# as arithmetic and lands on `u64::MAX` because the destination is"
53:71 EOL "\n"
54:1 WS "    "
54:5 COMMENT "# unsigned and wraps. Bound to a local it would print -1."
54:62 EOL "\n"
55:1 WS "    "
55:5 REFID "push_u64"
55:13 WS " "
55:14 LABEL "x"
55:15 COLON ":"
55:16 WS " "
55:17 REFID "0xffffffffffffffff"
55:35 WS " "
55:36 REFID "+"
55:37 WS " "
55:38 REFID "1"
55:39 WS " "
55:40 REFID "-"
55:41 WS " "
55:42 REFID "1"
55:43 EOL "\n"
56:1 EOL "\n"
57:1 WS "    "
57:5 COMMENT "# Reassignment coercion: bare literal coerces to a's u8 type."
57:66 EOL "\n"
58:1 WS "    "
58:5 LABEL "a"
58:6 COLON ":"
58:7 WS " "
58:8 REFID "10"
58:10 DOT "."
58:11 REFID "u8"
58:13 EOL "\n"
59:1 WS "    "
59:5 REFID "a"
59:6 WS " "
59:7 EQUALS "="
59:8 WS " "
59:9 REFID "100"
59:12 EOL "\n"
60:1 WS "    "
60:5 REFID "a"
60:6 WS " "
60:7 EQUALS "="
60:8 WS " "
60:9 REFID "200"
60:12 WS " "
60:13 REFID "+"
60:14 WS " "
60:15 REFID "100"
60:18 WS " "
60:19 REFID "-"
60:20 WS " "
60:21 REFID "250"
60:24 EOL "\n"
61:1 EOL "\n"
62:1 WS "    "
62:5 COMMENT "# The small_value function exercises return-value coercion at"
62:66 EOL "\n"
63:1 WS "    "
63:5 COMMENT "# its own definition (`200 + 100 - 250` returning u8)."
63:59 EOL "\n"
64:1 WS "    "
64:5 REFID "print"
64:10 WS " "
64:11 STRBEG "\""
64:12 STRMID "ok"
64:14 STREND "\""
64:15 EOL "\n"
65:1 BRACECLOSE "}"
65:2 EOL "\n"
66:1 EOF ""
