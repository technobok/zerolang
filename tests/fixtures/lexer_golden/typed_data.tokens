37:39 DOT "."
37:40 REFID "HIGH"
37:44 BRACECLOSE "}"
37:45 STREND "\""
37:46 EOL "\n"
38:1 EOL "\n"
39:1 WS "    "
39:5 COMMENT "# No clause and no tags: `primes.0` is an i64."
39:51 EOL "\n"
40:1 WS "    "
40:5 REFID "print"
40:10 WS " "
40:11 STRBEG "\""
40:12 STRMID "first prime: "
40:25 STREXPRBEG "\\"
40:26 BRACEOPEN "{"
40:27 REFID "primes"
40:33 DOT "."
40:34 REFID "0"
40:35 BRACECLOSE "}"
40:36 STREND "\""
40:37 EOL "\n"
41:1 EOL "\n"
42:1 WS "    "
42:5 COMMENT "# Tagged block: its elements are u8, so they reach `take_u8` directly."
42:75 EOL "\n"
43:1 WS "    "
43:5 REFID "print"
43:10 WS " "
43:11 STRBEG "\""
43:12 STRMID "masked: "
43:20 STREXPRBEG "\\"
43:21 BRACEOPEN "{"
