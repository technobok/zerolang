34:19 BRACEOPEN "{"
34:20 EOL "\n"
35:1 WS "    "
35:5 COMMENT "# Named-label access on a typed block: the literal is inlined"
35:66 EOL "\n"
36:1 WS "    "
36:5 COMMENT "# and arrives at `take_u8` already as u8."
36:46 EOL "\n"
37:1 WS "    "
37:5 REFID "print"
