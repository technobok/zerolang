28:19 WS " "
28:20 REFID "5"
28:21 WS " "
28:22 REFID "7"
28:23 WS " "
28:24 REFID "11"
28:26 WS " "
28:27 BRACECLOSE "}"
28:28 EOL "\n"
29:1 EOL "\n"
30:1 COMMENT "# Tagged elements: `1.u8` types the whole block, so this is `out intdata u8`"
30:77 EOL "\n"
31:1 COMMENT "# written the other way round, down to the C array."
31:52 EOL "\n"
