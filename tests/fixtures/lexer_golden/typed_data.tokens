42:5 COMMENT "# No clause and no tags: `primes.0` is an i64."
42:51 EOL "\n"
43:1 WS "    "
43:5 REFID "print"
43:10 WS " "
43:11 STRBEG "\""
43:12 STRMID "first prime: "
43:25 STREXPRBEG "\\"
43:26 BRACEOPEN "{"
