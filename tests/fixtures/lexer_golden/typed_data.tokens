43:35 BRACECLOSE "}"
43:36 STREND "\""
43:37 EOL "\n"
44:1 EOL "\n"
45:1 WS "    "
45:5 COMMENT "# Tagged block: its elements are u8, so they reach `take_u8` directly."
45:75 EOL "\n"
46:1 WS "    "
46:5 REFID "print"
46:10 WS " "
46:11 STRBEG "\""
46:12 STRMID "masked: "
46:20 STREXPRBEG "\\"
