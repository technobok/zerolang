37:42 BRACECLOSE "}"
37:43 STREND "\""
37:44 EOL "\n"
38:1 WS "    "
38:5 REFID "print"
38:10 WS " "
38:11 STRBEG "\""
38:12 STRMID "high: "
38:18 STREXPRBEG "\\"
38:19 BRACEOPEN "{"
38:20 REFID "take_u8"
38:27 WS " "
38:28 LABEL "b"
38:29 COLON ":"
38:30 WS " "
38:31 REFID "bytemask"
38:39 DOT "."
38:40 REFID "HIGH"
38:44 BRACECLOSE "}"
38:45 STREND "\""
38:46 EOL "\n"
39:1 EOL "\n"
40:1 WS "    "
40:5 COMMENT "# No clause and no tags: `primes.0` is an i64."
40:51 EOL "\n"
41:1 WS "    "
41:5 REFID "print"
41:10 WS " "
41:11 STRBEG "\""
41:12 STRMID "first prime: "
41:25 STREXPRBEG "\\"
41:26 BRACEOPEN "{"
41:27 REFID "primes"
41:33 DOT "."
41:34 REFID "0"
41:35 BRACECLOSE "}"
41:36 STREND "\""
41:37 EOL "\n"
42:1 EOL "\n"
43:1 WS "    "
43:5 COMMENT "# Tagged block: its elements are u8, so they reach `take_u8` directly."
43:75 EOL "\n"
44:1 WS "    "
44:5 REFID "print"
44:10 WS " "
44:11 STRBEG "\""
44:12 STRMID "masked: "
44:20 STREXPRBEG "\\"
44:21 BRACEOPEN "{"
44:22 REFID "take_u8"
44:29 WS " "
44:30 LABEL "b"
44:31 COLON ":"
44:32 WS " "
44:33 REFID "masked"
44:39 DOT "."
44:40 REFID "0"
44:41 BRACECLOSE "}"
