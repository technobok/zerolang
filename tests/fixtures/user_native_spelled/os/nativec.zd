# nativec -- the program's own os unit's C implementation, a runtime.nativec file
c: runtime.nativec

# implementation -- the C behind os.z's natives: fixed answers, so the output
# says whose rows ran
implementation: (
    c.implementation
    rows: list {
        (
            c.row
            key: "cpuCount"
            fragments: list {
                """
                static int32_t z_os_cpuCount(void);
                static int32_t z_os_cpuCount(void) {
                    return 4242;
                }
                """
            }
        )
        (
            c.row
            key: "conjure"
            fragments: list {
                """
                static int64_t z_os_conjure(int64_t n);
                static int64_t z_os_conjure(int64_t n) {
                    return n * 6;
                }
                """
            }
        )
    }
)
