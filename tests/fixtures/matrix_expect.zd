    # -- known defects: each cell waits on its fix (the M2 worklist)

    # -- a bare value-type union arm is stored in the union's pointer-wide slot, and
    #    one wider than the slot is refused at the arm (spec §union): a tagged
    #    variant (its tag and payload, 16 bytes) and a facet (a vtable and a copy)
    #    are both wider, and `(Box T)` is what holds them
    (
        row
        selector: "@val&sum"
        position: "union_arm"
        verdict: outcome.refused
        detail: "E0100 arm `a` of `UnionArm` holds `@N` (16 bytes), wider than a union's 8-byte slot; write `(Box @N)`"
    )
    (
        row
        selector: "@val&interface"
        position: "union_arm"
        verdict: outcome.refused
        detail: "E0100 arm `a` of `UnionArm` holds the facet `@N` (a vtable and a copy), which no union slot holds; write `(Box @N)`"
    )
    (
        row
        selector: "@val&sum"
        position: "match_arm"
        verdict: outcome.refused
