# zdata_flags -- the ZDATA kind's files that take flags for `zc data` and
# `zl lint` -- a source root of their own. Read once by the runner: a file not
# listed takes none.

# flagged -- a program that takes compiler flags: its name, and the flags it
# is compiled with after the kind's own, one argument each
flagged: data {
    name: text
    args: list {} out staticlist text
}

programs: list {
    (
        flagged
        name: "crossfile"
        args: list {
            "--src"
            "tests/fixtures/zdata/lib"
        }
    )
    (
        flagged
        name: "reach"
        args: list {
            "--src"
            "tests/fixtures/zdata/lib"
        }
    )
    (
        flagged
        name: "reach_nested_member_only"
        args: list {
            "--src"
            "tests/fixtures/zdata/lib"
        }
    )
    (
        flagged
        name: "reach_other_nested_unit"
        args: list {
            "--src"
            "tests/fixtures/zdata/lib"
        }
    )
    (
        flagged
        name: "reach_own_nested_type"
        args: list {
            "--src"
            "tests/fixtures/zdata/lib"
        }
    )
    (
        flagged
        name: "unitalias"
        args: list {
            "--src"
            "tests/fixtures/zdata/lib"
        }
    )
}
