# string_dir: a StringProvider folder reads as its entry names, sorted.
#
# Coverage:
#   - the root lists the files and folders added under it
#   - a folder made by addFile lists its own files
#   - a name walked and missed is cached as notfound, and is not listed
#   - a file still reads as its contents
provider string
addFile 0 /src/main.z hello
addFile 0 /src/util.z world
addFile 0 /readme alpha
walk 0 src 0
walk 0 nothere 1
open 0 0
open 0 1
open 0 2
