{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/lintfull/probe.z", "version": 1, "languageId": "zerolang", "text": "Gadget: class {\n    value: u64\n} as {\n    public: unit { :peek }\n    peek: function {:this} out u64 is {\n        return this.value\n    }\n    deadm: function {:this} out u64 is {\n        return this.value\n    }\n}\n\ndeadp: function {x: u64 y: u64} out u64 is {\n    return x\n}\n\nmain: function is {\n    g: Gadget value: 5\n    s: g.peek\n    t: deadp x: 1 y: 2\n    dead: 5.u64\n    if s == 0.u64 then print \"zero\"\n    print \"\\{s} \\{t}\"\n}\n\nBox: class {\n    label: String\n} as {\n    rename: function {:this to: StringView} is {\n        this.label = to.string\n    }\n}\n\n# L022 fires: a copy that is only read, whose source is a plain local.\nviewable: function {src: String} out u64 is {\n    keep: src.copy\n    return keep.length\n}\n\n# NO L022, from the FIELD-READ rule alone: nothing in this body writes `b`,\n# so only \"the source is a field\" can exclude it. A call elsewhere may rebind\n# the field, and the lint cannot see which.\nsaved: function {b: Box} out u64 is {\n    was: b.label.copy\n    return was.length\n}\n\n# NO L022: the source is written in the same body, so a view of it is not\n# a view of the same bytes.\nrebound: function {a: String b: String} out u64 is {\n    cur: a.copy\n    snap: cur.copy\n    cur = b.copy\n    return snap.length + cur.length\n}\n"}}}
