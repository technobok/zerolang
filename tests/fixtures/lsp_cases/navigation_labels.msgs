{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/refs/main.z", "version": 1, "languageId": "zerolang", "text": "main: function is {\n    b: shapes.Box size: 1 shade: shapes.tone.warm\n    b.grow by: shapes.STEP\n    k: kit.Box size: 2 shade: shapes.tone.cool\n    k.grow by: (twice w: shapes.STEP)\n    print \"🎉 \\{b.size} \\{k.size}\"\n    print \"\\{shapes.sizeOf x: b}\"\n    w: 4\n    print \"\\{twice :w}\"\n    print \"\\{twice w: w}\"\n}\n\n# twice `w`\ntwice: function {w: i64} out i64 is {\n    return w + w\n}\n"}}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/refs/shapes.z", "version": 1, "languageId": "zerolang", "text": "# shapes.z -- the names the references tests look up across files\n\n# how warm a box is\ntone: variant { warm: null cool: null }\n\n# the most a box grows by at once\nSTEP: 3\n\n# a sized holder\nBox: class {\n    size: i64\n    shade: tone\n} as {\n    # add `by` to the box's size\n    grow: function {:this by: i64} is {\n        this.size = this.size + by\n    }\n}\n\n# the size of box `x`\nsizeOf: function {x: Box.view} out i64 is {\n    return x.size\n}\n"}}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/refs/kit.z", "version": 1, "languageId": "zerolang", "text": "# kit.z -- a unit that re-exports one of shapes' types under its own name\n\n# the box, as kit names it\nBox: shapes.Box\n\n# leave with status 3\nquit: function is {\n    os.exit code: 3\n}\n"}}}
