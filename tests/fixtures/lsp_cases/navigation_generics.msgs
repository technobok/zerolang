{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/generics/main.z", "version": 1, "languageId": "zerolang", "text": "# generics -- each use of a generic parameter is the parameter\n\n# what `t` is, decided per instance\npick: function as { t: anyval.generic } in {v: t} out String is {\n    k: match (t) case i64 then \"int\" else \"other\"\n    return \"\\{k} \\{v}\"\n}\n\n# a template unit over `t`\nmathops: unit as {\n    t: anyval.generic\n    describe: function {v: t big: bool} out String is {\n        k: match (t) case i64 then \"int\" else \"other\"\n        r: if big then \"\\{k} big \\{v}\" else \"\\{k} small\"\n        return r\n    }\n}\n\n# a pair of `t`\npair: record {\n    first: t\n    second: t\n} as {\n    t: anyval.generic\n}\n\nmain: function is {\n    p: pair i64 first: 1 second: 2\n    print \"\\{pick v: 2} \\{(mathops i64).describe v: 1 big: true} \\{p.first}\"\n}\n"}}}
