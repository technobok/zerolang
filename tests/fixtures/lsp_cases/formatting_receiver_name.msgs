{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/lintrecv/app.z", "version": 1, "languageId": "zerolang", "text": "# one type, one receiver name: `t` here, the name most methods declare\n\nCounter: class { n: i64 name: String } as {\n    value: function {t: this.view} out i64 is {\n        return t.n\n    }\n    label: function {t: this.view} out String is {\n        return t.name.copy\n    }\n    # rewritten by the fix, the reads in the text included\n    bump: function {:this by: i64} is {\n        this.n = this.n + by\n        print \"now \\{this.n} for \\{this.name}\"\n    }\n    # reported only: the body has a `t` of its own\n    reset: function {:this} is {\n        t: 0\n        this.n = t\n    }\n    # reported only: a receiver with a name of its own may be passed by it\n    same: function {c: this.view n: i64} out bool is {\n        return c.n == n\n    }\n}\n\n# every method writes `:this`: nothing to report\nFlag: class { lit: bool } as {\n    set: function {:this} is {\n        this.lit = true\n    }\n    clear: function {:this} is {\n        this.lit = false\n    }\n}\n\nmain: function is {\n    c: Counter n: 1 name: \"c\".string\n    c.bump by: 2\n    c.reset\n    f: Flag lit: false\n    f.set\n    f.clear\n    print \"\\{c.value} \\{c.same n: 0} \\{c.label} \\{f.lit}\"\n}\n"}}}
