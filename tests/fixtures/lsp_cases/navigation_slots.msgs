{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/slots/main.z", "version": 1, "languageId": "zerolang", "text": "# slots -- a label's position (`blk.slot.label`) is the label's, as its element is\nmain: function is {\n    a: vocab.words.slot.ht\n    c: vocab.codes.slot.lf\n    print \"\\{vocab.wordAt w: a} \\{c} \\{vocab.codes.lf} \\{vocab.words.ht}\"\n}\n"}}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/slots/vocab.z", "version": 1, "languageId": "zerolang", "text": "# vocab -- words read by their position\n\n# the id of a word\nwordid: typedef u64\n\n# the words a reader knows\nwords: list {\n    # a tab\n    ht: \"tab\"\n    lf: \"line feed\"\n} out (list StringView i: wordid)\n\n# the bytes the words stand for\ncodes: list { ht: 9 lf: 10 } out list u8\n\n# the word at position `w`\nwordAt: function {w: wordid} out String is {\n    if w == words.slot.lf then return \"lf\"\n    return (words.get i: w).string\n}\n"}}}
