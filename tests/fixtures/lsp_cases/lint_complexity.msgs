{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/lint1/appcc.z", "version": 1, "languageId": "zerolang", "text": "kind: variant {\n    one: null\n    two: null\n}\n\n# edge -- scores exactly 15 and is not reported: 1, 2 and 3 for the ifs one\n# inside the other and 1 for the innermost else, 1 for the else-if and 1 for\n# its when chain, 1 for the outer else, 1 for the for and 1 for its chained\n# header, 1 for the match and 2 for the if inside its arm\nedge: function {a: bool b: bool c: bool k: kind} out u64 is {\n    n: u64\n    if a then {\n        if b then {\n            if c then {\n                n = 1\n            } else {\n                n = 2\n            }\n        } else if c when a then {\n            n = 3\n        }\n    } else {\n        n = 4\n    }\n    for a while b loop {\n        n = n + 1\n    }\n    match (\n        k\n    ) case one then {\n        if b then {\n            n = 5\n        }\n    } else null\n    return n\n}\n\n# over -- edge with one more if inside the loop, two deep: 17\nover: function {a: bool b: bool c: bool k: kind} out u64 is {\n    n: u64\n    if a then {\n        if b then {\n            if c then {\n                n = 1\n            } else {\n                n = 2\n            }\n        } else if c when a then {\n            n = 3\n        }\n    } else {\n        n = 4\n    }\n    for a while b loop {\n        if c then {\n            n = n + 1\n        }\n    }\n    match (\n        k\n    ) case one then {\n        if b then {\n            n = 5\n        }\n    } else null\n    return n\n}\n\n# rec -- 14 from its nesting and 2 for the two recursive calls: 16\nrec: function {a: bool b: bool c: bool k: kind depth: u64} out u64 is {\n    if depth == 0 then {\n        return 0\n    }\n    n: u64\n    if a then {\n        if b then {\n            if c then {\n                n = rec :a :b :c :k depth: (depth - 1)\n            } else {\n                n = 2\n            }\n        } else if c when a then {\n            n = 3\n        }\n    } else {\n        n = rec :a :b :c :k depth: (depth - 1)\n    }\n    match (\n        k\n    ) case one then {\n        if b then {\n            n = 5\n        }\n    } else null\n    return n\n}\n\nmain: function is {\n    x: edge a: true b: false c: true k: kind.one\n    y: over a: true b: false c: true k: kind.one\n    z: rec a: true b: false c: true k: kind.one depth: 2\n    print \"\\{x} \\{y} \\{z}\"\n}\n"}}}
