{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/lint1/appcc.z", "version": 1, "languageId": "zerolang", "text": "kind: variant {\n    one: null\n    two: null\n    three: null\n    four: null\n    five: null\n    six: null\n}\n\n# edge -- scores exactly 15 and is not reported: 1, 2 and 3 for the ifs one\n# inside the other and 1 for the innermost else, 1 for the else-if and 1 for\n# its when chain, 1 for the outer else, 1 for the for and 1 for its chained\n# header, 1 for the match and 2 for the if inside its arm\nedge: function {a: bool b: bool c: bool k: kind} out u64 is {\n    n: u64\n    if a then {\n        if b then {\n            if c then {\n                n = 1\n            } else {\n                n = 2\n            }\n        } else if c when a then {\n            n = 3\n        }\n    } else {\n        n = 4\n    }\n    for a while b loop {\n        n = n + 1\n    }\n    match (\n        k\n    ) case one then {\n        if b then {\n            n = 5\n        }\n    } else null\n    return n\n}\n\n# over -- edge with one more if inside the loop, two deep: 17\nover: function {a: bool b: bool c: bool k: kind} out u64 is {\n    n: u64\n    if a then {\n        if b then {\n            if c then {\n                n = 1\n            } else {\n                n = 2\n            }\n        } else if c when a then {\n            n = 3\n        }\n    } else {\n        n = 4\n    }\n    for a while b loop {\n        if c then {\n            n = n + 1\n        }\n    }\n    match (\n        k\n    ) case one then {\n        if b then {\n            n = 5\n        }\n    } else null\n    return n\n}\n\n# rec -- 14 from its nesting and 2 for the two recursive calls: 16\nrec: function {a: bool b: bool c: bool k: kind depth: u64} out u64 is {\n    if depth == 0 then {\n        return 0\n    }\n    n: u64\n    if a then {\n        if b then {\n            if c then {\n                n = rec :a :b :c :k depth: (depth - 1)\n            } else {\n                n = 2\n            }\n        } else if c when a then {\n            n = 3\n        }\n    } else {\n        n = rec :a :b :c :k depth: (depth - 1)\n    }\n    match (\n        k\n    ) case one then {\n        if b then {\n            n = 5\n        }\n    } else null\n    return n\n}\n\n# dispatch -- 4 and not reported: 1 for the match and 3 for its worst arm, an\n# if one level deep and its else-if. A match runs one arm, so the six arms are\n# not added up, which would make 19\ndispatch: function {a: bool b: bool k: kind} out u64 is {\n    match (\n        k\n    ) case one then {\n        if a then {\n            return 1\n        } else if b then {\n            return 2\n        }\n    } case two then {\n        if a then {\n            return 3\n        } else if b then {\n            return 4\n        }\n    } case three then {\n        if a then {\n            return 5\n        } else if b then {\n            return 6\n        }\n    } case four then {\n        if a then {\n            return 7\n        } else if b then {\n            return 8\n        }\n    } case five then {\n        if a then {\n            return 9\n        } else if b then {\n            return 10\n        }\n    } case six then {\n        if a then {\n            return 11\n        } else if b then {\n            return 12\n        }\n    }\n    return 0\n}\n\n# shared -- 17: 12 for the ifs above the match (6, 3 and 3), 1 for the match,\n# 2 for its worst arm, and 1 each for `n` and `m`, the locals the arms write.\n# Its worst arm alone would make 15, which is not reported\nshared: function {a: bool b: bool c: bool k: kind} out u64 is {\n    n: u64\n    m: u64\n    if a then {\n        if b then {\n            if c then {\n                n = 1\n            }\n        }\n    }\n    if b then {\n        if c then {\n            m = 1\n        }\n    }\n    if c then {\n        if a then {\n            n = 2\n        }\n    }\n    match (\n        k\n    ) case one then {\n        if a then n = 3\n    } case two then {\n        if b then m = 4\n    } case three then {\n        if c then n = 5\n    } else null\n    return n + m\n}\n\nmain: function is {\n    x: edge a: true b: false c: true k: kind.one\n    y: over a: true b: false c: true k: kind.one\n    z: rec a: true b: false c: true k: kind.one depth: 2\n    d: dispatch a: false b: true k: kind.four\n    s: shared a: true b: true c: true k: kind.two\n    print \"\\{x} \\{y} \\{z} \\{d} \\{s}\"\n}\n"}}}
