{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://tests/fixtures/lsp_ws/decls", "initializationOptions": {"srcDir": "tests/fixtures/lsp_ws/decls", "systemDir": "lib/system"}, "capabilities": {}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/decls/main.z", "version": 1, "languageId": "zerolang", "text": "# decls -- references list each declaration, when the client asks for it\nmain: function is {\n    b: shapes.Box size: 1\n    b.grow by: shapes.STEP\n    n: shapes.sizeOf x: b\n    n = n + (twice w: n)\n    t: shapes.tone.warm\n    names: List String\n    names.append \"x\"\n    ok: true\n    for each s: names loop print s\n    print \"\\{n} \\{ok} \\{shapes.words.ht} \\{shapes.words.slot.lf} \\{kindOf v: 1}\"\n    match (t) case warm then print \"w\" case cool then null\n}\n\n# twice `w`\ntwice: function {w: i64} out i64 is {\n    return w + w\n}\n\n# what `t` is, decided per instance\nkindOf: function as { t: anyval.generic } in {v: t} out String is {\n    k: match (t) case i64 then \"int\" else \"other\"\n    return \"\\{k} \\{v}\"\n}\n"}}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/decls/shapes.z", "version": 1, "languageId": "zerolang", "text": "# shapes -- a declaration of each kind, for references\n\n# how warm a box is\ntone: variant { warm: null cool: null }\n\n# the step a box grows by\nSTEP: 3\n\n# a sized holder\nBox: class {\n    size: i64\n} as {\n    # add `by` to the box's size\n    grow: function {:this by: i64} is {\n        this.size = this.size + by\n    }\n}\n\n# the words a box knows\nwords: list { ht: \"tab\" lf: \"line feed\" }\n\n# the size of box `x`\nsizeOf: function {x: Box.view} out i64 is {\n    return x.size\n}\n"}}}
