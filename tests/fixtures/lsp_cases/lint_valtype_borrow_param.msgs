{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://tests/fixtures/lsp_ws/lintfull/valborrow.z", "version": 1, "languageId": "zerolang", "text": "point: record {\n    x: i64\n} as {\n    bump: function {:this} is {\n        this.x = this.x + 1\n    }\n}\nreadOnly: function {p: point.borrow} out i64 is {\n    return p.x\n}\nwrites: function {p: point.borrow} is {\n    p.x = p.x + 1\n}\ninner: function {p: point.borrow} is {\n    p.x = p.x + 1\n}\npassOn: function {p: point.borrow} is {\n    inner :p\n}\nviaMethod: function {p: point.borrow} is {\n    p.bump\n}\ncopied: function {p: point} out i64 is {\n    return p.x\n}\nviewed: function {p: point.view} out i64 is {\n    return p.x\n}\nmain: function is {\n    q: point x: 3\n    writes p: q\n    passOn p: q\n    viaMethod p: q\n    print \"\\{readOnly p: q} \\{copied p: q} \\{viewed p: q}\"\n}\n"}}}
