    (row selector: "int" reader: "arg" at: "L" verdict: outcome.run detail: "7")
    (row selector: "int" reader: "field" verdict: outcome.run detail: "7")
    (row selector: "int" reader: "read" verdict: outcome.run detail: "7")
    # -- u8
    (row selector: "u8" reader: "mem" verdict: outcome.run detail: "248")
