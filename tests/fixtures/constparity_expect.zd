# constparity_expect -- the constant-parity matrix's expectations, the input
# of tests/unit/constparitygen.z (`make regen-constparity`). Every kind of
# unit-level constant crossed with every reader is read in three positions: U
# (a unit constant computed from it), D (the same expression in a body) and L
# (the expression on a body local holding it).
#
# The LAST row selecting a cell decides it; every cell needs a row. The
# positions of a reader must agree -- the same value, or the same error code --
# except U's E0600 "no compile-time value" beside a body that runs the read.
# The generator refuses a table that breaks this: a disagreement is KNOWN.

# outcome -- what a cell is expected to do
outcome: choice {
    # it runs and prints the row's detail
    run: null
    # the compiler refuses it with the row's detail
    refused: null
    # it cannot be written; the detail says why
    na: null
    # it waits on the defect the detail names, and is emitted nowhere
    known: null
}

# row -- one expectation: the cells it selects and what they do
row: data {
    # a kind, `*`, or a group `@<tag>` (num lit str static sum opt fn)
    selector: text
    # the reader's name
    reader: text
    # the one position the row selects, U, D or L; empty -- all three
    at: ""
    verdict: outcome
    # RUN: the value printed; REFUSED: `Ennnn message`, `@N` the type as the
    # compiler names it; NA and KNOWN: the reason
    detail: text
}

# rows -- the rows, in the order they apply
rows: list {
    # -- intlit
    (row selector: "intlit" reader: "mem" verdict: outcome.run detail: "7")
    (
        row
        selector: "intlit"
        reader: "unknown"
        at: "U"
        verdict: outcome.refused
        detail: "E0100 type 'intliteral' has no member 'zork'"
    )
    (
        row
        selector: "intlit"
        reader: "unknown"
        at: "D"
        verdict: outcome.refused
        detail: "E0100 type 'intliteral' has no member 'zork'"
    )
    (
        row
        selector: "intlit"
        reader: "unknown"
        at: "L"
        verdict: outcome.refused
        detail: "E0100 type 'i64' has no member 'zork'"
    )
    (
        row
        selector: "intlit"
        reader: "interp"
        at: "U"
        verdict: outcome.refused
        detail: "E0600 an interpolated string has no compile-time value"
    )
    (row selector: "intlit" reader: "interp" at: "D" verdict: outcome.run detail: "7")
    (row selector: "intlit" reader: "interp" at: "L" verdict: outcome.run detail: "7")
    (row selector: "intlit" reader: "eq" verdict: outcome.run detail: "true")
    (row selector: "intlit" reader: "read" verdict: outcome.run detail: "7")
    # -- int
    (row selector: "int" reader: "mem" verdict: outcome.run detail: "-8")
    (
        row
        selector: "int"
        reader: "unknown"
        verdict: outcome.refused
        detail: "E0100 type 'i64' has no member 'zork'"
    )
    (
        row
        selector: "int"
        reader: "meth"
        at: "U"
        verdict: outcome.refused
        detail: "E0600 'C.compare' has no compile-time value"
    )
    (row selector: "int" reader: "meth" at: "D" verdict: outcome.run detail: "1")
    (row selector: "int" reader: "meth" at: "L" verdict: outcome.run detail: "1")
    (
        row
        selector: "int"
        reader: "methBad"
        at: "U"
        verdict: outcome.refused
        detail: "E0300 argument 'rhs' type mismatch: expected i64, got textliteral"
    )
    (
        row
        selector: "int"
        reader: "methBad"
        at: "D"
        verdict: outcome.refused
        detail: "E0300 argument 'rhs' type mismatch: expected i64, got textliteral"
    )
    (
