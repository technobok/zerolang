# show -- reads the generated unit's values. os and arch are the host's, so
# only what every host agrees on is printed.
main: function is {
    print "main=\{z.build.main} project.main=\{z.project.main}"
    print "sourceDir=\{z.build.sourceDir} outputDir=\{z.build.outputDir}"
    print "eager=\{z.build.eager} release=\{z.build.release} project.eager=\{z.project.eager}"
    known: z.build.os.other.not
    print "os named=\{known}"
    if z.build.arch == z.build.archkind.other then print "arch unnamed" else print "arch named"
}
