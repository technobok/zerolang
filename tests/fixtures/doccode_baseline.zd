# doccode_baseline.zd -- the doccode ratchet: per page, the zerolang examples
# marked `check=none` (not compiled) and the checked ones `zl fmt` would lay out
# differently. Each a `row`: the kind (`none` or
# `fmt`) its rule, the page its file. The ratchet is EXACT, as
# arch_baseline.zd's: a count above its row fails, a count below fails until
# the row is lowered in the same commit, and a row nothing meets fails until it
# is deleted. ztestrunner's doccode kind enforces it (`make doc-check` alone).
#
# The target for every fmt row is zero. A none row stays only for what cannot
# compile by design: a Design-OPEN proposal, a grammar outline whose `...` is
# the point, or a data file that reads units of another file the page shows
# (zdata.pdoc), or a unit whose native rows the file beside it holds
# (native_units.pdoc), which one block cannot hold either.

# row -- one ratchet row: the rule, the file, and the count held
row: data {
    rule: text
    file: text
    count: u64
}

# rows -- the rows, by rule then file
rows: list {
    (row rule: "none" file: "docs/compiler.pdoc" count: 1)
    (row rule: "none" file: "docs/Design-OPEN.pdoc" count: 5)
    (row rule: "none" file: "docs/errors.pdoc" count: 2)
    (row rule: "none" file: "docs/native_units.pdoc" count: 1)
    (row rule: "none" file: "docs/spec.pdoc" count: 11)
    (row rule: "none" file: "docs/zdata.pdoc" count: 3)
}
