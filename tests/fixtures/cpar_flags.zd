# cpar_flags -- the flags of the REFUSED programs constparitygen writes from the
# table tests/fixtures/constparity_expect.zd, read by the runner beside
# errors_flags.zd. `make regen-constparity` writes the whole file: edit the
# table, not this file.

# flagged -- a program that takes compiler flags: its name, and the flags it
# is compiled with after the kind's own, one argument each
flagged: data {
    name: text
    args: list {} out staticlist text
}

programs: list {
    (
        flagged
        name: "cpar_intlit_unknown"
        args: list {
            "--eager"
