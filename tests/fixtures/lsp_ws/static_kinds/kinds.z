# kinds.z -- a data type and a choice name their kind on hover; a field read and
# an arm predicate on a static value show the folded value

inner: data { v: u8 }
form: choice {
    call: null
    template: text
    sub: inner
}
row: data {
    key: text
    kind: form
}
a: (form.template "x")
r: (row key: "k" kind: a)
main: function is {
    print "\{r.key.stringView} \{r.kind.template} \{a.template}"
    f: form.call
    if f.call then print "c"
}
