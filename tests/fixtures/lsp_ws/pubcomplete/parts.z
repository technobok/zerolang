# parts.z -- a unit whose public block lists two of its three functions, one
# under another name
public: unit {
    :shown
    twice: double
}

# shown -- one
shown: function out i64 is {
    return 1
}

# double -- `n` times two
double: function {n: i64} out i64 is {
    return n * 2
}

# hidden -- read only inside this unit
hidden: function out i64 is {
    return 3
}
