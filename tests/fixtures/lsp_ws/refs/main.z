main: function is {
    b: shapes.Box size: 1 shade: shapes.tone.warm
    b.grow by: shapes.STEP
    k: kit.Box size: 2 shade: shapes.tone.cool
    k.grow by: (twice w: shapes.STEP)
    print "🎉 \{b.size} \{k.size}"
    print "\{shapes.sizeOf x: b}"
    w: 4
    print "\{twice :w}"
    print "\{twice w: w}"
}

# twice `w`
twice: function {w: i64} out i64 is {
    return w + w
}
