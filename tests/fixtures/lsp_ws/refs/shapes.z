# shapes.z -- the names the references tests look up across files

# how warm a box is
tone: variant { warm: null cool: null }

# the most a box grows by at once
STEP: 3

# a sized holder
Box: class {
    size: i64
    shade: tone
} as {
    # add `by` to the box's size
    grow: function {:this by: i64} is {
        this.size = this.size + by
    }
}

# the size of box `x`
sizeOf: function {x: Box.view} out i64 is {
    return x.size
}
