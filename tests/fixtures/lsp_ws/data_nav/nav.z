# nav -- hover and go-to-definition on a data block's elements and members

# the first four primes
primes: data { 2 3 5 7 }
codes: data { ht: 9 lf: 10 } out intdata u8
names: data { a: "x" } out stringdata

main: function is {
    a: primes.0
    b: codes.ht
    n: primes.length
    i: 1.u64
    k: primes.index :i
    s: names.a
    for each p: primes loop print "\{p}"
    print "\{a} \{b} \{n} \{k} \{s}"
}
