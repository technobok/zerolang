# L023 fires: `t` is lowercase where its bound `AnyRef` is not.
Holder: class {
    get: function {t: this.view i: u64} outx t.view is native
} as {
    t: AnyRef.generic
}

# L023 fires the other way too -- the rule is a case comparison, not a
# preference for capitals.
pair: record { a: K  b: K } as { K: anyval.generic }

# L023 fires through the parenthesised default form, which a reader that
# unwrapped only `expression` would never look inside.
Walker: protocol {
    Gives: AnyRef.generic
    accepts: (AnyRef.generic default: null)
}

# NO L023: the case already matches the bound, in both families.
Keeper: class {
    one: function {t: this.view} outx T.view is native
} as {
    T: AnyRef.generic
}
point: record { x: v  y: v } as { v: anyval.generic }

# NO L023: a value parameter's bound is a numeric type, which is lowercase, so
# the rule already yields a lowercase parameter with no carve-out.
sized: record { n: u64 } as { to: u64.generic }

main: function is {
    print "params"
}
