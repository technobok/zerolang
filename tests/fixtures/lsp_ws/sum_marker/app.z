# A union and a variant carrying a conformance marker: the marker is a member
# (completion after the dot, hover and definition on the label), never an arm
# (a `case` completion offers only the arms left to write).
Speaker: protocol {
    speak: function {t: this.view} out i64
}
sizer: facet {
    size: function {t: this.view} out i64
}
Cell: class { n: i64 }
Shape: union { circle: Cell square: Cell } as {
    Speaker: Speaker
    speak: function {s: this.view} out i64 is { return 1 }
}
kind: variant { small: i64 big: i64 } as {
    m: sizer
    size: function {k: this.view} out i64 is { return 2 }
}
main: function is {
    s: Shape.circle (Cell n: 1)
    k: kind.small 3
    v: s.Speaker.speak
    w: k.m.size
    match (s) case circle then print "c" else print "q"
    match (k) case small then print "s" else print "b"
    print "\{v} \{w}"
}
