# app.z -- a method called through its type is checked as the call on its
# receiver; the type it was written through still answers hovers, definitions
# and references

# Counter -- a class counting up
Counter: class {
    n: i64
} as {
    # bump -- one more
    bump: function {c: this} is {
        c.n = c.n + 1
    }
}

main: function is {
    c: Counter n: 1
    Counter.bump c
    print "\{c.n}"
}
