# generics -- each use of a generic parameter is the parameter

# what `t` is, decided per instance
pick: function as { t: anyval.generic } in {v: t} out String is {
    k: match (t) case i64 then "int" else "other"
    return "\{k} \{v}"
}

# a template unit over `t`
mathops: unit as {
    t: anyval.generic
    describe: function {v: t big: bool} out String is {
        k: match (t) case i64 then "int" else "other"
        r: if big then "\{k} big \{v}" else "\{k} small"
        return r
    }
}

# a pair of `t`
pair: record {
    first: t
    second: t
} as {
    t: anyval.generic
}

main: function is {
    p: pair i64 first: 1 second: 2
    print "\{pick v: 2} \{(mathops i64).describe v: 1 big: true} \{p.first}"
}
