# other.z -- a call and a match laid out on the lines and columns where main.z
# hovers and completes

# how big
size: variant {
    small: null
    large: null
} as { tag: u8.tag }

# twice x
helper: function {x: i64} out i64 is {
    return x * 2
}

# helper's result, printed once x is positive
total: function {x: i64} out i64 is {
    k: size.small
    value: (helper :x)
    print "\{value}"
    if x > 0 then {
        match (
            k
        ) case small then {
            print "small"
        } else {
            print "large"
        }
    }
    return value
}
