# main.z -- hovers and completes where other.z has a call or match alike

# shows the text
show: function {t: String.view} is {
    print t
}

# a primary colour
color: variant {
    red: null
    green: null
    blue: null
} as { tag: u8.tag }

main: function is {
    s: String
    s.append "hi"
    show t: s
    n: other.total x: 2
    c: color.green
    match (
        c
    ) case red then {
        print "red"
    } else {
        print "\{n}"
    }
}
