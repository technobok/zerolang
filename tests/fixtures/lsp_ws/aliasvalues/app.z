part: data {
    name: text
    weight: 1
}
mode: variant { slow: null fast: null }
K: 7
bolt: (part name: "bolt")
again: bolt
twice: K
S: mode.slow
T: S
W: lim.MAXBATCH
ST: lim.START
TR: bool.true
Held: lim.Thing
Same: Held

main: function is {
    h: Same v: W
    print "\{again.weight} \{twice} \{h.v} \{TR}"
    if T == mode.slow then print "slow"
    if ST == lim.mode.slow then print "lim slow"
}
