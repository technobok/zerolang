# nav -- hover and go-to-definition on a list's elements and members

# the first four primes
primes: list { 2 3 5 7 }
codes: list { ht: 9 lf: 10 } out staticlist u8
names: list { a: "x" } out staticlist StringView

main: function is {
    a: primes.0
    b: codes.ht
    n: primes.length
    i: 1.u64
    k: primes.get :i
    s: names.a
    for each p: primes loop print "\{p}"
    print "\{a} \{b} \{n} \{k} \{s}"
}
