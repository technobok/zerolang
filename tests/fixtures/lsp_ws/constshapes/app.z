part: data {
    name: text
    weight: 1
}
mode: variant { slow: null fast: null }
K: 7
bolt: (part name: "bolt")
again: bolt
twice: K
S: mode.slow
T: S
nut: (part name: "nut" weight: K)

main: function is {
    print "\{again.weight} \{twice} \{nut.weight} \{bolt.weight} \{K}"
    if T == mode.slow then print "slow"
    if S == mode.fast then print "fast"
}
