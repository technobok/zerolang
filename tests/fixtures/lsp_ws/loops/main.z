# loops -- one `for` binding of each shape the checker binds differently
main: function is {
    names: List String
    names.append "a"
    total: i64
    for each s: names loop {
        total = total + s.length.i64.orPanic
    }
    for each k: 3.times loop {
        total = total + k
    }
    for each w: ("x y".split sep: " ") loop {
        total = total + w.length.i64.orPanic
    }
    for v: (os.env key: "Z") loop {
        total = total + v.length.i64.orPanic
        return
    }
    print "\{total}"
}
