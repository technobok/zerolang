# main.z -- a type with a public block: completion on one of its values offers
# its private members only where they may be read, in its own methods and
# through a `.private` handle
Bag: class { a: i64 count: i64 } as {
    public: unit { :count :total }
    total: function {:this} out i64 is {
        return (inner h: this.private) + this.count
    }
    helper: function {t: this.view} out i64 is {
        return t.a
    }
}

inner: function {h: Bag.private.view} out i64 is {
    return h.a + h.helper
}

main: function is {
    b: Bag a: 21 count: 3
    print "\{b.total}"
}
