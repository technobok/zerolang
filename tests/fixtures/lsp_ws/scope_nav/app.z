# scope_nav -- the nearest declaration, as zls follows it: a type's members in
# its methods' bodies, a parameter in its function, a qualified outer name, and
# a body read top to bottom (the unit constant before the local of its name,
# the local after it)

# the unit constant main reads before its own `n`
n: 40

Cfg: class {
    v: i64
} as {
    K: 5
    helper: function {n: i64} out i64 is { return n + 1 }
    use: function {c: this.view} out i64 is {
        a: helper n: c.v
        return a + K
    }
}

f: function {u8: i64 m: system.u8} out i64 is { return u8 + m }

main: function is {
    c: Cfg v: 3
    before: n
    n: 2
    after: n
    print "\{c.use} \{f u8: 1 m: 2} \{before} \{after}"
}
