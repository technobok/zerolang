# shapes -- a declaration of each kind, for references

# how warm a box is
tone: variant { warm: null cool: null }

# the step a box grows by
STEP: 3

# a sized holder
Box: class {
    size: i64
} as {
    # add `by` to the box's size
    grow: function {:this by: i64} is {
        this.size = this.size + by
    }
}

# the words a box knows
words: data { ht: "tab" lf: "line feed" }

# the size of box `x`
sizeOf: function {x: Box.view} out i64 is {
    return x.size
}
