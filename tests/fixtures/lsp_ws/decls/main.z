# decls -- references list each declaration, when the client asks for it
main: function is {
    b: shapes.Box size: 1
    b.grow by: shapes.STEP
    n: shapes.sizeOf x: b
    n = n + (twice w: n)
    t: shapes.tone.warm
    names: List String
    names.append "x"
    ok: true
    for each s: names loop print s
    print "\{n} \{ok} \{shapes.words.ht} \{shapes.words.slot.lf} \{kindOf v: 1}"
    match (t) case warm then print "w" case cool then null
}

# twice `w`
twice: function {w: i64} out i64 is {
    return w + w
}

# what `t` is, decided per instance
kindOf: function as { t: anyval.generic } in {v: t} out String is {
    k: match (t) case i64 then "int" else "other"
    return "\{k} \{v}"
}
