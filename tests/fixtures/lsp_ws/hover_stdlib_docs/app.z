# Hover over the STDLIB surface the documentation arc filled in: a union ARM,
# an OPERATOR, a CONVERSION and a container MEMBER. Before the arc each
# answered with a bare signature and nothing else.
#
# The operator is the one that needed language-server work as well. An operator
# IS a method here, and the method it resolves to is stamped against the BINOP,
# so a span row keyed by the operator's own atom resolved to nothing at all.
# The row carries the binop's node id instead.

main: function is {
    e: io.IoError.notfound
    match (
        e
    ) case notfound then {
        print "missing"
    } else {
        print "other"
    }
    b: 255.u8
    one: 1.u8
    s: b + one
    w: b.i16
    xs: (List String)
    n: xs.length
    print "\{s} \{w} \{n}"
}
