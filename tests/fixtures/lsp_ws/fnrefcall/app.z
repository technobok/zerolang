# app.z -- a function reference read bare is a call, and its name is still the
# variable: a definition at it answers the variable, as a hover does

# sevenFn -- a function with seven's signature
sevenFn: function out i64

# seven -- the number seven
seven: function out i64 is {
    return 7
}

# give -- calls the reference it is handed
give: function {g: sevenFn} out i64 is {
    return g
}

main: function is {
    f: seven.copy
    v: f
    print "\{v} \{give g: f.copy}"
}
