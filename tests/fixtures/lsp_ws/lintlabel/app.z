# every construct whose first argument is written with the name it may leave out

meters: typedef is i64

point: record is {
    x: i64
    y: i64
}

Gen: generator is {
    n: i64
} as {
    call: function out i64 is {
        yield this.n
    }
}

ops: unit as {
    one: 1
}

add: function in {a: i64 b: i64} out i64 is {
    return a + b
}

kind: variant is {
    a: null
    b: null
}

# `is native` keeps its `is`
Clock: class is native

main: function is {
    k: kind.a
    match on k case a then print "a" case b then print "b"
    n: 0
    for while n < 3 loop n = n + 1
    p: point x: 1 y: 2
    print "\{p.x} \{add a: 1 b: 2} \{ops.one}"
}
