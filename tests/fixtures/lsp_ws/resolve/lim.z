# lim.z -- the batch limits a program reads through `lim.`

# mode -- how a batch runs
mode: variant { fast: null slow: null }

# the most a batch holds
MAXBATCH: 64

# the batch width, pinned to a byte
WIDTH: 8.u8

# the mode a batch starts in
START: mode.slow

# the label a batch prints
LABEL: "lim"

# the sizes a batch may take
sizes: list { 1 2 4 } out list u8
