# L003 fires on each of the three groups `primaryGenericParam` knows: the list
# family's element label, the map family's key label, and the option/result
# family's payload label. The table is nineteen literals with no other reader,
# so a stale entry stops the rule firing and nothing else goes red -- and the
# thirty-odd real findings all sit in examples/, which no lint gate reaches.
Holder: class {
    xs: (ListRef T: String)
    m: (MapRR K: String V: u64)
    o: (Option T: String)
}

# NO L003: the label is elided already, which is what the rule asks for.
Elided: class {
    ys: (ListRef String)
}

main: function is {
    print "elide"
}
