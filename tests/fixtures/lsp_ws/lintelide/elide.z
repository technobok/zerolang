# L003 in the editor: zls runs the typecheck-tier rules on its checked
# snapshot, so a labelled first argument is reported for each of the stdlib's
# three families -- the list family's element label, the map family's key
# label, and the option/result family's payload label -- read from the
# template's own declaration.
Holder: class {
    xs: (ListRef T: String)
    m: (MapRR K: String V: String)
    o: (Option T: String)
}

# NO L003: the label is elided already, which is what the rule asks for.
Elided: class {
    ys: (ListRef String)
}

main: function is {
    print "elide"
}
