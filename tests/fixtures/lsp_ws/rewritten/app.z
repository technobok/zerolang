# app.z -- the checker writes a callable object read bare as a read of its
# `call`, a bare member as one reached through `type`, and the literal of a
# typed call as a conversion to its type. Nobody wrote those names: a hover or
# a definition at the source answers the names that were written

# Doubler -- a callable object: read bare, it is called
Doubler: class {
    k: i64
} as {
    # call -- twice the factor
    call: function {d: this} out i64 is {
        return d.k * 2
    }
}

# Holder -- holds a callable object in a field
Holder: class {
    d: Doubler
}

# Box -- a value with a helper
Box: class {
    v: i64
} as {
    # hp -- the value times x
    hp: function {b: this x: i64} out i64 is {
        return b.v * x
    }
    # twice -- hp, called bare from a sibling method
    twice: function {b: this} out i64 is {
        return (hp b x: 2)
    }
}

main: function is {
    w: Doubler k: 3
    va: w
    h: Holder d: (Doubler k: 2)
    vb: h.d
    ve: (i64.u64 5).orPanic
    bx: Box v: 1
    print "\{va} \{vb} \{ve} \{bx.twice}"
}
