# vocab -- words read by their position

# the id of a word
wordid: typedef u64

# the words a reader knows
words: list {
    # a tab
    ht: "tab"
    lf: "line feed"
} out (list StringView i: wordid)

# the bytes the words stand for
codes: list { ht: 9 lf: 10 } out list u8

# the word at position `w`
wordAt: function {w: wordid} out String is {
    if w == words.slot.lf then return "lf"
    return (words.get i: w).string
}
