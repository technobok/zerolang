# m -- marker completion probes; a { brace in a comment
pt: record {
    x: i64
    y: i64
}

Bag: class {
    items: List String
} as {
    count: function {:this} out u64 is {
        return this.items.length
    }
}

light: variant {
    lit: null
    dark: null
}

double: function {n: i64} out i64 is {
    return n * 2
}

use: function {b: Bag p: pt} out u64 is {
    return p.x.u64.orPanic + b.count
}

main: function is {
    b: Bag items: (List String)
    p: pt x: 1 y: 2
    f: light.lit
    if f.lit then print "\{use :b :p} {"
    print "\{double n: 2}"
    if z.build.release then print "release"
}
