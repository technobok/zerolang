Gadget: class {
    value: u64
} as {
    public: unit { :peek }
    peek: function {:this} out u64 is {
        return this.value
    }
    deadm: function {:this} out u64 is {
        return this.value
    }
}

deadp: function {x: u64 y: u64} out u64 is {
    return x
}

main: function is {
    g: Gadget value: 5
    s: g.peek
    t: deadp x: 1 y: 2
    dead: 5.u64
    if s == 0.u64 then print "zero"
    print "\{s} \{t}"
}

Box: class {
    label: String
} as {
    rename: function {:this to: StringView} is {
        this.label = to.string
    }
}

# L022 fires: a copy that is only read, whose source is a plain local.
viewable: function {src: String} out u64 is {
    keep: src.copy
    return keep.length
}

# NO L022, from the FIELD-READ rule alone: nothing in this body writes `b`,
# so only "the source is a field" can exclude it. A call elsewhere may rebind
# the field, and the lint cannot see which.
saved: function {b: Box} out u64 is {
    was: b.label.copy
    return was.length
}

# NO L022: the source is written in the same body, so a view of it is not
# a view of the same bytes.
rebound: function {a: String b: String} out u64 is {
    cur: a.copy
    snap: cur.copy
    cur = b.copy
    return snap.length + cur.length
}
