# nativec -- cobjdemo's C implementation, a runtime.nativec file
c: runtime.nativec

# implementation -- cobjdemo's runtime is a C source of its own, compiled into
# the object cache with the define named here (cobj-guard)
implementation: (
    c.implementation
    rows: list {
        (
            c.row
            key: "answer"
            fragments: list {
                """
                /* cobjdemo.answer -- what the unit's own C source, linked from the object
                   cache, answers. */
                int cobj_answer(void);
                static int64_t z_cobjdemo_answer(void) {
                    return (int64_t)cobj_answer();
                }

                """
            }
        )
    }
    sources: list { (c.source path: "answer/answer.c" defines: list { "COBJ_ANSWER=42" }) }
)
