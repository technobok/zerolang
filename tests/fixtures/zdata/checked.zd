# checked -- zerolang's checker checks a data file: a value that does not fit
# its field, and a name nothing declares in a definition nothing reads. A value
# with no value of its own inside a data value -- a choice arm the choice does
# not have, a name nothing declares -- reports its own reason there, as it does
# written alone.
part: data {
    weight: 1
}
heavy: (part weight: "lots")
unused: nowhere
size: choice {
    small: null
    large: null
}
box: data {
    fits: size
    count: 1
}
mid: (box fits: size.medium)
far: (box fits: size.small count: elsewhere)
