# flawed -- a schema unit with a mistake in a definition nothing else reads,
# at the top and in a nested unit: this unit's own check reports them, never
# the check of a file that opens the unit for its other definitions
gauge: data {
    level: 0
}

wrong: (gauge level: "high")
inner: unit {
    ok: (gauge level: 2)
    wrong: (gauge level: "high")
}
