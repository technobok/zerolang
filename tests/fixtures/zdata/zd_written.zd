# zd_written -- the zd writer's output for the run case zd_read_write

stage: choice {
    cc: null
    posix: null
    paid: seats
}

seats: data {
    count: 1
    monthly: true
}

failure: data {
    program: text
    :stage
    weight: f64
    notes: list {} out staticlist text
}

port: 8080.u16
offset: -3
mask: 255
ratio: 2.5
name: "relay \"one\"\tend"
debug: false
failures: list {
    (
        failure
        program: "os_spawn_fds"
        stage: stage.posix
        weight: 2.0
        notes: list {} out staticlist text
    )
    (
        failure
        program: "x"
        stage: stage.paid (seats count: 12 monthly: true)
        weight: 0.5
        notes: list {
            "a"
            "b"
        }
    )
}

sizes: list {
    small: 1
    large: 9
}

site: unit {
    title: "Docs"
}
