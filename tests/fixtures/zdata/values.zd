# values -- every kind of value a data file holds, written back by `zc data`
# with every data value's fields, defaults included
name: "zgrep"
quote: "say \"hi\"\tthen go"
count: 5
small: 7.u8
ratio: 0.5
enabled: true
tags: list { "a" "b" }
sizes: list { small: 1 large: 9 }
part: data {
    name: text
    weight: 1
    labels: list { "core" }
}
bolt: (part name: "bolt")
nut: (part name: "nut" weight: 2 labels: list {})
inner: unit {
    k: 3
    washer: (part name: "washer" weight: 4)
}
os: choice {
    linux: null
    windows: null
    other: part
}
host: os.linux
odd: (os.other bolt)
again: name
