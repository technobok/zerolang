# wide -- A014: a head with eight parameters or more, the receiver among them.
# `eight` and `Box.fill` are reported; `seven` is not.

# eight -- eight parameters
eight: function {a: i64 b: i64 c: i64 d: i64 e: i64 f: i64 g: i64 h: i64} out i64 is {
    return a + b + c + d + e + f + g + h
}

# seven -- seven parameters: under the line
seven: function {a: i64 b: i64 c: i64 d: i64 e: i64 f: i64 g: i64} out i64 is {
    return a + b + c + d + e + f + g
}

# Box -- one number
Box: class {
    # the number
    n: i64
} as {
    # fill -- the receiver and seven numbers
    fill: function {t: this a: i64 b: i64 c: i64 d: i64 e: i64 f: i64 g: i64} is {
        t.n = a + b + c + d + e + f + g
    }
}
