# bare_zero_shadow.z -- the same two initializers in a unit that declares its
# own `String` and `u64`. The bare names reach those records here, so writing
# them would change the program: L011 reports neither.
String: record {
    n: i64
}

u64: record {
    n: i64
}

main: function is {
    s: "".string
    z: 0.u64
    print "len=\{s.length} z=\{z}"
}
