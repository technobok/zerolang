# elide -- zl-full-guard's L003 fixture: a generic reference's first argument
# labelled with its template's first parameter. The parameter is read from the
# template the checker resolved, so the rule covers a user template as it does
# the stdlib's three families (list, map, option).
Cell: record {
    v: t
} as { t: anyval.generic }

Pair: record {
    a: k
    b: w
} as { k: anyval.generic w: anyval.generic }

Holder: class {
    xs: (ListRef T: String)
    m: (MapRR K: String V: String)
    o: (Option T: String)
    c: (Cell t: i64)
    p: (Pair k: (Cell t: i64) w: i64)
}

# NO L003: elided already, or a label that is not the first parameter's
Elided: class {
    ys: (ListRef String)
    q: (Pair (Cell i64) w: i64)
}

# NO L003: a function whose first parameter shares the name is no generic reference
mk: function {t: i64} out (Cell i64) is {
    return (Cell v: t)
}

main: function is {
    c: mk t: 4
    print "\{c.v}"
}
