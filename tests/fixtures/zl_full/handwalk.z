# handwalk -- A013 reports countDots, and only countDots: five match arms that
# only recurse. The others walk the same shapes without a hand-written walk:
# one generic arm, arms with work of their own, or a second argument changed.

public: unit {
    :main
}

# shape -- a value that holds a smaller one, down to a dot
shape: variant {
    dot: null
    line: null
    box: null
    ring: null
    star: null
    grid: null
}

# inner -- the shape one step smaller than `s`; a dot holds itself
inner: function {s: shape} out shape is {
    match (
        s
    ) case grid then {
        return shape.star
    } case star then {
        return shape.ring
    } case ring then {
        return shape.box
    } case box then {
        return shape.line
    } else return shape.dot
}

# countDots -- reported: five arms only recurse, each into the next shape
countDots: function {s: shape} out u64 is {
    match (
        s
    ) case dot then {
        return 1
    } case line then {
        return (countDots s: shape.dot)
    } case box then {
        return (countDots s: shape.line)
    } case ring then {
        return (countDots s: shape.box)
    } case star then {
        return (countDots s: shape.ring)
    } case grid then {
        return (countDots s: shape.star)
    }
}

# countGeneric -- not reported: the one generic arm is the `else`
countGeneric: function {s: shape} out u64 is {
    match (
        s
    ) case dot then {
        return 1
    } else return (countGeneric s: (inner :s))
}

# countTraced -- not reported: each arm prints before it recurses
countTraced: function {s: shape} out u64 is {
    match (
        s
    ) case dot then {
        return 1
    } case line then {
        print "line"
        return (countTraced s: shape.dot)
    } case box then {
        print "box"
        return (countTraced s: shape.line)
    } case ring then {
        print "ring"
        return (countTraced s: shape.box)
    } case star then {
        print "star"
        return (countTraced s: shape.ring)
    } case grid then {
        print "grid"
        return (countTraced s: shape.star)
    }
}

# depthOf -- not reported: each arm changes `level` as well as the shape
depthOf: function {s: shape level: u64} out u64 is {
    match (
        s
    ) case dot then {
        return level
    } case line then {
        return (depthOf s: shape.dot level: level + 1)
    } case box then {
        return (depthOf s: shape.line level: level + 1)
    } case ring then {
        return (depthOf s: shape.box level: level + 1)
    } case star then {
        return (depthOf s: shape.ring level: level + 1)
    } case grid then {
        return (depthOf s: shape.star level: level + 1)
    }
}

main: function is {
    a: countDots s: shape.grid
    b: countGeneric s: shape.grid
    c: countTraced s: shape.box
    d: depthOf s: shape.grid level: 0
    print "\{a} \{b} \{c} \{d}"
}
