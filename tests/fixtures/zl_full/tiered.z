# tiered -- zl-full-guard's fixture: a finding only the typecheck tier makes
# (L030), in a unit that lives outside every root zl would assume.
pt: record { x: i64 }

# readX -- a value type taken `.borrow` and never mutated: L030.
readX: function {p: pt.borrow} out i64 is { return p.x }

main: function is {
    q: pt x: 1
    print "\{readX p: q}"
}
