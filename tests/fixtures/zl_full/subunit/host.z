# host -- a unit with a hidden subunit `inner`, which it names, and an `orphan`
# file in its subunit folder that it never names.
answer: function out i64 is {
    return (inner.twice n: base)
}

# reaches inner's `label`, so the typed walk over host meets its body
tag: function out String is {
    return inner.label
}

# a parent definition the subunit reads: resolvable only when inner.z is linted
# AS host's subunit, never as a top-level unit of its own
base: 21
