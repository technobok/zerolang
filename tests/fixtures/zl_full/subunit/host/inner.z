# inner -- host's subunit, which reads host's `base`. Linted as itself, its
# unused local is reported at THIS file's path and line.
twice: function {n: i64} out i64 is {
    unusedLocal: 5
    return (n * 2) + (base - base)
}

# a redundant `.string`, the typed walk's finding: reported when THIS file is
# linted, at this path, and never when host is
label: function out String is {
    return "inner".string
}
