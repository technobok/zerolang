# negated_twin -- zl-full-guard's L033 fixture: a negated test whose type has
# the positive twin. Four findings: two ids with both tests, and two options.
public: unit {
    :main
}

rowid: typedef u32 as {
    isZero: function {t: this.view} out bool is {
        return t.u32 == 0
    }
    notZero: function {t: this.view} out bool is {
        return t.u32 != 0
    }
}

# NO L033: this id has no positive twin to write
bareid: typedef u32 as {
    isZero: function {t: this.view} out bool is {
        return t.u32 == 0
    }
}

# NO L033: `none` is one arm of three, so `some` is not its opposite
slot: variant {
    none: null
    some: null
    many: null
}

Row: class {
    id: rowid
    next: optionval i64
}

pick: function {i: i64} out optionval i64 is {
    if i > 0 then return (optionval.some i)
    return (optionval i64).none
}

main: function is {
    r: rowid.create from: 3
    if r.isZero.not then print "row"
    row: Row id: r next: (pick i: 2)
    if row.id.isZero.not then print "field"
    if row.next.none.not then print "option field"
    if (pick i: 0).none.not then print "call"
    b: bareid.create from: 3
    if b.isZero.not then print "bare"
    s: slot.many
    if s.none.not then print "slot"
    # NO L033: the twins themselves
    if r.notZero when row.next.some then print "twins"
}
