# nested_receiver_write -- the zl_full usage cases' L027 fixture: a method that
# writes its receiver only through a call on one of its fields
# (`this.items.append`) mutates the receiver, so L027 does not ask for `.view`;
# a method that only reads its receiver is told to take it as `.view`.
Bag: class {
    items: ListVal i64
} as {
    add: function {:this x: i64} is {
        this.items.append x
    }
    size: function {:this} out u64 is {
        return this.items.length
    }
}

main: function is {
    b: Bag items: ListVal i64
    b.add x: 1
    print "\{b.size}"
}
