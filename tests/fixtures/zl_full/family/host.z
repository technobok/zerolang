# host -- a unit family: this file and its hidden subunits `alpha` and `beta`.
# The rules that compare definitions (L012, A006, L025) read the three files as
# one unit.

public: unit {
    :total
}

# a number the family fixture reads, nothing more
total: function out i64 is {
    return (alpha.count n: 3) + (beta.count n: 4) + alpha.viaBeta
}

# scale -- read by `alpha` only: a use from a subunit is a use
scale: function {n: i64} out i64 is {
    return n * 2
}
