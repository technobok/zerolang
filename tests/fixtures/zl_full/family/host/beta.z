# beta -- host's second subunit

# count -- the numbers below `n`, the even ones through `step`: A006, the body
# of `alpha.count`
count: function {n: i64} out i64 is {
    acc: 0
    i: 0
    for i < n loop {
        if (i % 2) == 0 then {
            acc = acc + (step n: i)
        } else {
            acc = acc - 1
        }
        i = i + 1
    }
    return acc + (step n: 1)
}

# step -- one more than `n`
step: function {n: i64} out i64 is {
    return n + 1
}

# a number the family fixture reads, nothing more
forAlpha: function {n: i64} out i64 is {
    return n * 3
}
