# alpha -- host's first subunit

# count -- the numbers below `n`, the even ones through the parent's `scale`.
# `beta.count` has this body's shape: the first in family order is the original
count: function {n: i64} out i64 is {
    acc: 0
    i: 0
    for i < n loop {
        if (i % 2) == 0 then {
            acc = acc + (scale n: i)
        } else {
            acc = acc - 1
        }
        i = i + 1
    }
    return acc + (scale n: 1)
}

# a number the family fixture reads, nothing more
viaBeta: function out i64 is {
    return (beta.forAlpha n: 2)
}

# neverRead -- no file of the family names it: L012
neverRead: function out i64 is {
    return 7
}
