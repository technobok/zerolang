# arm_widen -- L031 at a construction: an arm's payload takes its type
# exactly, so `.i64` on a narrower value there is the conversion the arm needs
# and is not reported; a record field widens by itself, so there it is

# pick -- a variant whose arm carries an i64
pick: variant {
    n: i64
    z: null
}

# box -- a record whose field is an i64
box: record {
    n: 0.i64
}

main: function is {
    b: 7.u8
    v: pick.n b.i64
    r: box n: b.i64
    match v case n then print "\{v} \{r.n}" case z then null
}
