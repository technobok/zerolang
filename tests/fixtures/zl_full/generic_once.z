# generic_once.z -- a generic method instantiated twice. Each instance walks its
# own copy of the body, and a copy reports from its template's line, so a
# typecheck-tier finding in the body must be reported ONCE, not once per copy.
Holder: class {
    v: t
} as {
    t: anyval.generic
    peek: function {this: this.view} out i64 is {
        unusedLocal: 5
        label: "abc".string
        print label
        return 1
    }
}

main: function is {
    a: Holder v: 1
    b: Holder v: 2.5
    print "\{a.peek} \{b.peek}"
}
