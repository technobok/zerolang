# marks -- the program the linemarks kind builds with `zc --line-marks` and
# gcc's --coverage: the lines gcov then reports as run, and as not run, are
# marks.lines. Each shape here is one a statement's C is written through: a
# guard that leaves, an `if` used as a value with a block arm, a tail value, a
# generic at two types, a loop, a branch chain with arms not taken, a function
# never entered, and a unit in another file.

# pick -- a guard, then an `if` value whose else arm is a block
pick: function {x: i64} out i64 is {
    if x > 3 then {
        return x * 2
    }
    y: if x > 1 then 10 else {
        z: x + 5
        z
    }
    y + 1
}

# same -- a generic: each instance counts on these lines
same: function as { t: anyval.generic } in {v: t} out t is {
    v
}

# never -- reached only from an arm main does not take
never: function {x: i64} out i64 is {
    x + 1
}

main: function is {
    total: 0
    for each i: (0.upto to: 5) loop {
        total = total + (pick x: i)
    }
    print "\{total} \{same v: 4} \{same v: 2.5}"
    names: List String
    names.append "a".string
    if names.length > 5 then {
        print "\{never x: 1}"
    } else if names.length == 1 then {
        print "one \{shapes.area w: 2 h: 3}"
    } else {
        print "other"
    }
}
