# dump_flags -- the DUMP kind's programs that take compiler flags: a unit with
# no `main` is dumped as the eager tier models it (`--eager`). Read once by the
# runner: a program not listed takes none.

# flagged -- a program that takes compiler flags: its name, and the flags it
# is compiled with after the kind's own, one argument each
flagged: data {
    name: text
    args: list {} out staticlist text
}

programs: list {
    (
        flagged
        name: "choice_decl"
        args: list {
            "--eager"
        }
    )
    (
        flagged
        name: "data_construct"
        args: list {
            "--eager"
        }
    )
    (
        flagged
        name: "data_decl"
        args: list {
            "--eager"
        }
    )
    (
        flagged
        name: "static_fn_ref"
        args: list {
            "--eager"
        }
    )
    (
        flagged
        name: "tagconsts"
        args: list {
            "--eager"
        }
    )
    (
        flagged
        name: "tagminimal"
        args: list {
            "--eager"
        }
    )
    (
        flagged
        name: "text_fold"
        args: list {
            "--eager"
        }
    )
    (
        flagged
        name: "text_option_fold"
        args: list {
            "--eager"
        }
    )
}
