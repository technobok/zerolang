    (row rule: "A008" file: "src/ztypecheck/declare.z" count: 154)
    (row rule: "A008" file: "src/ztypecheck/flow.z" count: 74)
    (row rule: "A008" file: "src/ztypecheck/instantiate.z" count: 113)
