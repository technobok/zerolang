    (row rule: "A005" file: "tests/unit/zast_smoke.z" count: 1)
    (row rule: "A005" file: "tests/unit/zenv_smoke.z" count: 1)
    (row rule: "A005" file: "tests/unit/ztyping_smoke.z" count: 1)
    (row rule: "A006" file: "lib/system/json.z" count: 1)
    (row rule: "A006" file: "lib/system/system.z" count: 3)
    (row rule: "A006" file: "src/zenv.z" count: 1)
    (row rule: "A006" file: "src/zls.z" count: 2)
