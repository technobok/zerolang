    (row rule: "A006" file: "tests/unit/zparser_dump.z" count: 2)
    # A008 counts POINTS, not functions: each function over the threshold adds how far over
    # it scores (score - 15, the finding's weight in `zl lint --counts`). A function already
    # over the threshold that grows moves its row, and one that is simplified lowers it.
    (row rule: "A008" file: "lib/system/zast.z" count: 8)
    (row rule: "A008" file: "lib/system/zparser.z" count: 150)
    (row rule: "A008" file: "src/zcheck.z" count: 2)
    (row rule: "A008" file: "src/zdoc.z" count: 12)
