    (row rule: "A008" file: "src/ztypecheck/typeref.z" count: 10)
    (row rule: "A008" file: "src/ztypecheck/valuechecks.z" count: 72)
    (row rule: "A008" file: "tests/unit/zast_smoke.z" count: 18)
    (row rule: "A008" file: "tests/unit/zfmt_dump.z" count: 1)
    (row rule: "A008" file: "tests/unit/zlexer_dump.z" count: 24)
    # SANCTIONED, A013 src/zemitterc.z (collectLiterals) and lib/system/zparser.z
    # (externWalk): each is correct, and each visits every node of every body or parse.
    # Walked through zast.childCount and childAt they cost 2.0% and 1.25% more
    # instructions on a self-compile, because the emitter copies a node's whole union
    # on each `match` and each `ast.nodes.get`, and a generic walk visits more nodes.
    # When a match on a viewed node no longer copies it, both are rewritten and these
    # rows go.
    (row rule: "A013" file: "lib/system/zparser.z" count: 1)
    (row rule: "A013" file: "src/zemitterc/emitplan.z" count: 1)
    #
    # A014 (a head of eight parameters or more), per file as every row is. The rows only go
    # down: the parameters that travel together become one value, as the emitter passes
    # `prog`, the program as the checker left it.
    (row rule: "A014" file: "lib/system/zlexer.z" count: 3)
    (row rule: "A014" file: "lib/system/zparser.z" count: 13)
