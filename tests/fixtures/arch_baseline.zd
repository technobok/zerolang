    (row rule: "A002" file: "src/zls.z" count: 1)
    (row rule: "A002" file: "src/zsource.z" count: 4)
    (row rule: "A002" file: "src/zsqldump.z" count: 3)
    (row rule: "A002" file: "src/ztypecheck/bodies.z" count: 3)
    (row rule: "A002" file: "src/ztypecheck/conform.z" count: 1)
    (row rule: "A002" file: "src/ztypecheck/resolve.z" count: 1)
    (row rule: "A002" file: "src/ztypecheck/statics.z" count: 1)
    (row rule: "A002" file: "src/ztypecheck/stdtypes.z" count: 1)
    (row rule: "A002" file: "src/ztypecheck/typeargs.z" count: 1)
    (row rule: "A002" file: "src/ztypes.z" count: 1)
    (row rule: "A002" file: "tests/unit/zlexer_dump.z" count: 1)
    (row rule: "A002" file: "tests/unit/zfmt_dump.z" count: 1)
    (row rule: "A002" file: "tests/unit/matrixgen.z" count: 1)
    (row rule: "A002" file: "tests/unit/constparitygen.z" count: 4)
    (row rule: "A003" file: "src/ztypes.z" count: 16)
    (row rule: "A004" file: "src/zsource.z" count: 1)
    (row rule: "A005" file: "lib/system/zparser.z" count: 4)
