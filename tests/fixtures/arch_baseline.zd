# arch_baseline.zd -- the architecture ratchet: findings of zl lint --full --arch per
# (rule, file). The ratchet is EXACT: a count above its row fails (a new finding), a count
# below it fails until the row is lowered in the same commit, and a row whose file has no
# such finding left fails until it is deleted. The target for every row is zero.
# ztestrunner's arch kind enforces it.
#
# OUTSIDE TEXT IS A VOCABULARY. A word read off text the compiler does not own -- a
# command-line flag, a JSON-RPC method, a test script's command, a nativec.zd field
# -- is a string data block read through zast.Vocab: the word is interned into the
# vocabulary's pool and compared by its slot (`w == zcWord.slot.vBuild`), never by its
# bytes. zc, zl, zls, the test runner and the tests/unit harnesses (zvfs_script,
# matrixgen, constparitygen, zfmt_dump, zparser_dump) carry no A001 for it.
#
# SANCTIONED EXCEPTION, A001 and A003 src/ztypes.z: the numeric-suffix table names
# zerolang's width suffixes and is the lexer's own classifier for the TEXT of a literal
# (`5u8`), so it compares a spelling; all 16 findings in each rule are that table,
# written as a family per spelling length (numkindShort / numkindWide / numkindQuad,
# keyed on the length the table's `len` field records). The row rises only with a new
# numeric kind, named in the commit message. Every other row still only goes down.
#
# TRANSITIONAL, 4 of A002 src/zemitterc.z: what STAGE D of the embedded-nativec plan
# left of the readers' composed strings, the rows themselves keyed by declaration and
# pieces read as data. servedKey (2) is the `@<unit>.<name>` path `zc natives check
# needs` (znativepieces) still addresses a row by -- tool code, which goes with that
# check's rework; servedSubunit (1) is a requirement's unit path, the key RowFacts
# files a variant's replaced links and sources under; fragmentName's suffix (1) names a
# fragment's text. Each goes when its reader is keyed by ids.

# row -- one ratchet row: the rule, the file, and the count held
row: data {
    rule: text
    file: text
    count: u64
}

# rows -- the rows, by rule then file
rows: list {
    (row rule: "A001" file: "src/ztypes.z" count: 16)
    (row rule: "A002" file: "lib/system/zast.z" count: 26)
    (row rule: "A002" file: "lib/system/zd.z" count: 5)
    (row rule: "A002" file: "lib/system/zvfs.z" count: 5)
    (row rule: "A002" file: "src/zc.z" count: 1)
    (row rule: "A002" file: "src/zdiag.z" count: 2)
    (row rule: "A002" file: "src/zemitterc.z" count: 2)
    (row rule: "A002" file: "src/zemitterc/argforms.z" count: 9)
    (row rule: "A002" file: "src/zemitterc/callorder.z" count: 9)
    (row rule: "A002" file: "src/zemitterc/consts.z" count: 1)
    (row rule: "A002" file: "src/zemitterc/emitplan.z" count: 5)
    (row rule: "A002" file: "src/zemitterc/memberreads.z" count: 6)
    (row rule: "A002" file: "src/zemitterc/narrowfacts.z" count: 3)
    (row rule: "A002" file: "src/zemitterc/nativepieces.z" count: 2)
    (row rule: "A002" file: "src/zemitterc/nativerows.z" count: 3)
    (row rule: "A002" file: "src/zemitterc/parttexts.z" count: 2)
    (row rule: "A002" file: "src/zemitterc/stmtblocks.z" count: 4)
