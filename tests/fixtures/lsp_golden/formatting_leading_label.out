{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file://tests/fixtures/lsp_ws/lintlabel/app.z","version":1,"diagnostics":[{"range":{"start":{"line":2,"character":16},"end":{"line":2,"character":18}},"severity":2,"code":"L004","source":"zl","message":"redundant `is`: the first argument of `typedef` leaves out its name"},{"range":{"start":{"line":4,"character":14},"end":{"line":4,"character":16}},"severity":2,"code":"L004","source":"zl","message":"redundant `is`: the first argument of `record` leaves out its name"},{"range":{"start":{"line":9,"character":15},"end":{"line":9,"character":17}},"severity":2,"code":"L004","source":"zl","message":"redundant `is`: the first argument of `generator` leaves out its name"},{"range":{"start":{"line":17,"character":10},"end":{"line":17,"character":12}},"severity":2,"code":"L004","source":"zl","message":"redundant `as`: the first argument of `unit` leaves out its name"},{"range":{"start":{"line":21,"character":14},"end":{"line":21,"character":16}},"severity":2,"code":"L004","source":"zl","message":"redundant `in`: the first argument of `function` leaves out its name"},{"range":{"start":{"line":25,"character":14},"end":{"line":25,"character":16}},"severity":2,"code":"L004","source":"zl","message":"redundant `is`: the first argument of `variant` leaves out its name"},{"range":{"start":{"line":35,"character":10},"end":{"line":35,"character":12}},"severity":2,"code":"L004","source":"zl","message":"redundant `on`: the first argument of `match` leaves out its name"},{"range":{"start":{"line":37,"character":8},"end":{"line":37,"character":13}},"severity":2,"code":"L004","source":"zl","message":"redundant `while`: the first argument of `for` leaves out its name"}]}}
{"jsonrpc":"2.0","id":2,"result":[{"range":{"start":{"line":0,"character":0},"end":{"line":42,"character":0}},"newText":"# every construct whose first argument is written with the name it may leave out\n\nmeters: typedef i64\n\npoint: record {\n    x: i64\n    y: i64\n}\n\nGen: generator {\n    n: i64\n} as {\n    call: function out i64 is {\n        yield this.n\n    }\n}\n\nops: unit {\n    one: 1\n}\n\nadd: function {a: i64 b: i64} out i64 is {\n    return a + b\n}\n\nkind: variant {\n    a: null\n    b: null\n}\n\n# `is native` keeps its `is`\nClock: class is native\n\nmain: function is {\n    k: kind.a\n    match k case a then print \"a\" case b then print \"b\"\n    n: 0\n    for n < 3 loop n = n + 1\n    p: point x: 1 y: 2\n    print \"\\{p.x} \\{add a: 1 b: 2} \\{ops.one}\"\n}\n"}]}
