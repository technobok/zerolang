# A class field typed by a program's own `String`, `Box` or `List` is that
# program's type, and these own nothing: no holder below has a destructor
# (the `types` row's fifth column). Whether a field needs cleanup is asked of
# its resolved type; it used to be asked of its NAME, so each holder here got
# an empty destructor and every local of it a call to one.
String: record {
    n: i64
}

Box: class {
    n: i64
}

List: record {
    n: i64
} as {
    t: anyval.generic
}

HoldS: class {
    s: String
}

HoldB: class {
    b: Box
}

HoldL: class {
    l: List i64
}

main: function is {
    hs: HoldS s: (String n: 1)
    hb: HoldB b: (Box n: 2)
    hl: HoldL l: (List i64 n: 3)
    print "\{hs.s.n} \{hb.b.n} \{hl.l.n}"
}
