# The dump's `destroy` section says, for each local a destroy point lists,
# whether it still holds its value (owned), was moved on every path there
# (moved), or only on some (maybe) -- the last zeroed where it moves and
# destroyed all the same: an arm of an `if` value yields one local and
# another arm something else; an arm moves a local on one of its own inner
# paths; a narrowed subject gives up its payload but keeps what holds it; a
# `break` leaves a block before the block moves a local; a condition after the
# first moves a local only when the first holds.
Doc: class {
    name: String
}

eat: function {s: String.take} out bool is {
    return s.length > 0
}

partialArm: function {c: bool} out u64 is {
    o: "o".string
    r: if c then o else "other".string
    return r.length
}

innerArm: function {c: bool d: bool} out u64 is {
    p: "p".string
    r: if c then (if d then "inner".string else p.take) else p.take
    return r.length
}

payload: function {m: (Map String V: Doc)} out u64 is {
    rem: m.remove key: "k".string
    match (
        rem
    ) case some then {
        d: rem.take
        return d.name.length
    } case none then {
        return 0
    }
}

blockBreak: function {n: u64} out u64 is {
    total: 0.u64
    i: 0.u64
    for i < n loop {
        i = i + 1
        t: "t".string
        r: {
            if i == 2 then break
            eat s: t.take
        }
        if r.some then total = total + 1
    }
    return total
}

laterCondition: function {c: bool} out u64 is {
    q: "q".string
    if c when (eat s: q.take) then return 1
    return 0
}

main: function is {
    m: (Map String V: Doc)
    m.set key: "k".string value: (Doc name: "doc".string)
    print "\{partialArm c: true} \{innerArm c: true d: false} \{payload :m}"
    print "\{blockBreak n: 3} \{laterCondition c: false}"
}
