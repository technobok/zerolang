# static_fn_ref.z -- a function reference held by a static value: the dump's
# constant reads `FN:<name>` inside the data value's AGG row.
binop: function {a: i64 b: i64} out i64
add: function {a: i64 b: i64} out i64 is { return a + b }

op: data {
    f: binop
}

plus: (op f: add)

main: function is {
    print "\{plus.f a: 1 b: 2}"
}
