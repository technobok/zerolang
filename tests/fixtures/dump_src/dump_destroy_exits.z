# The dump's `destroy` section lists what each exit destroys before it leaves:
# a `return` the owned locals of every scope of its function, innermost first,
# but the local it hands back; a `break` those of every scope inside what it
# leaves -- its loop, or a bare block -- and a `continue` those of every scope
# inside its loop; a `.drop` the local it drops; a reassignment the old value
# of the local it writes; and a value-returning body's last line (`tail`) what
# a `return` of its value would.
deep: function {c: bool} out u64 is {
    a: "a".string
    if c then {
        b: "b".string
        {
            d: "d".string
            return d.length + b.length + a.length
        }
    }
    return a.length
}

handBack: function {c: bool} out String is {
    kept: "kept".string
    other: "other".string
    if c then return kept
    print other
    return other.copy
}

looping: function {n: i64} is {
    outer: "outer".string
    i: 0
    for i < n loop {
        each: "each".string
        i = i + 1
        if i == 2 then continue
        if i == 3 then {
            inner: "inner".string
            print inner
            break
        }
        print each
    }
    print outer
}

# a bare block binds `break` to itself: a break there leaves the block, not the
# loop around it, and destroys only what the block holds
doBreak: function {n: i64} is {
    i: 0
    for i < n loop {
        kept: "kept".string
        {
            local: "local".string
            if i == 1 then break
            print local
        }
        print kept
        i = i + 1
    }
}

# a value-returning body's last line is its return: what it destroys is
# listed against the line (`tail`), and a `with` block in that place hands it
# to its own last line
tailing: function {c: bool} out u64 is {
    gone: "gone".string
    n: eat s: gone
    kept: "kept".string
    kept.length + n
}

withTail: function {c: bool} out u64 is {
    outer: "outer".string
    with w: outer.length do {
        inner: "inner".string
        inner.length + w
    }
}

eat: function {s: String.take} out u64 is {
    return s.length
}

dropping: function is {
    gone: "gone".string
    gone.drop
    again: "one".string
    again = "two".string
    print again
}

main: function is {
    print "\{deep c: true}"
    h: handBack c: false
    print h
    looping n: 5
    doBreak n: 3
    dropping
    print "\{tailing c: true} \{withTail c: true}"
}
