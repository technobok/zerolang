# The dump's `destroy` section lists what each exit destroys before it leaves:
# a `return` the owned locals of every scope of its function, innermost first,
# but the local it hands back; a `break` or a `continue` those of every scope
# inside its loop; a `.drop` the local it drops; and a reassignment the old
# value of the local it writes.
deep: function {c: bool} out u64 is {
    a: "a".string
    if c then {
        b: "b".string
        {
            d: "d".string
            return d.length + b.length + a.length
        }
    }
    return a.length
}

handBack: function {c: bool} out String is {
    kept: "kept".string
    other: "other".string
    if c then return kept
    print other
    return other.copy
}

looping: function {n: i64} is {
    outer: "outer".string
    i: 0
    for i < n loop {
        each: "each".string
        i = i + 1
        if i == 2 then continue
        if i == 3 then {
            inner: "inner".string
            print inner
            break
        }
        print each
    }
    print outer
}

dropping: function is {
    gone: "gone".string
    gone.drop
    again: "one".string
    again = "two".string
    print again
}

main: function is {
    print "\{deep c: true}"
    h: handBack c: false
    print h
    looping n: 5
    dropping
}
