# The dump's `scope` table shows the rows a compile makes, named by the node
# each scope brackets: a scope gets a row only when something is declared in it
# (a binding, a loop payload, a `with` value, a hoisted temporary) or it proves
# unreachable. Here: a function body, an if branch that binds and one that
# returns, a loop, a match arm that binds, a `with`, a call whose argument is
# a temporary, and a generic function walked for two instances (whose walks the
# dump leaves out, as it does the template's).
Shape: union {
    text: String
    none: null
}

first: function as { t: anyval.generic } in { v: t } out t is {
    w: v
    return w
}

size: function {s: String} out u64 is {
    return s.length
}

main: function is {
    n: 3
    if n > 2 then {
        k: n + 1
        print "\{k}"
    } else if n > 100 then return
    for i: n.iterate loop print "\{i}"
    u: Shape.text "abc".string
    match u case text then {
        m: u.length
        print "\{m}"
    } case none then null
    with t: "held".string do print t
    print "\{size s: "tmp".string}"
    print "\{first v: 1} \{first v: 2.5}"
}
