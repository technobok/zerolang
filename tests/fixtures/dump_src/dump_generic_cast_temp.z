# A generic typedef cast over a non-trivial source hoists it to a temporary
# the cast consumes: `Bag2 (Bag l6)` moves l6 into the inner Bag, whose
# temporary is OWNED and moved into the outer one. The dry run that infers
# Bag2's T walks the inner cast as a borrow of l6; none of what it left may
# reach the temporary (it read BORROWED from l6 before D7 C7b).
Bag: typedef (List T) as {
    T: AnyRef.generic
    first: function {t: this.view} out u64 is {
        return t.length
    }
}

Bag2: typedef (Bag T: T) as {
    T: AnyRef.generic
}

main: function is {
    l6: List String
    l6.append from: "f".string
    ch: Bag2 (Bag l6)
    print "chain \{ch.first}"
}
