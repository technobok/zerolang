# loop_first_condition_take_moved -- what a loop's first condition moves is moved on
# every path: an `each` binding runs once, before the loop, and the local it consumed is
# gone after it
letters: function {s: String.take} out List String is {
    parts: List String
    parts.append s
    return parts
}

main: function is {
    s: "abc".string
    for each c: (letters :s) loop print c
    print "done"
}
