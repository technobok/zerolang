# The dump's `destroy` section lists what the fall-through end of each scope
# destroys: its owned locals whose type can own something, newest first, each
# in the state the walk reached the end in -- owned, moved on every path, or
# maybe moved (moved on some path only: an `if` arm, a `break` out of a loop).
# A number, a record, a borrow and a view own nothing and are not listed;
# neither is a scope whose end is not reached.
keep: function {s: String.take} out u64 is {
    return s.length
}

pt: record {
    x: 0
}

states: function {c: bool xs: List String} is {
    a: "a".string
    b: "b".string
    d: "d".string
    e: "e".string
    f: "f".string
    n: 1
    p: pt x: 2
    v: a.stringView
    w: xs
    keep s: b
    if c then keep s: d
    if c then keep s: e else keep s: e
    if c then keep s: f else print "\{n}"
    print "\{v.length} \{p.x} \{w.length}"
}

nested: function {c: bool} is {
    outer: "o".string
    {
        inner: "i".string
        print inner
    }
    for i: 3.iterate loop {
        each: "each".string
        print "\{i} \{each}"
    }
    if c then {
        gone: "gone".string
        print gone
        return
    }
    print outer
}

broken: function {c: bool} is {
    x: "x".string
    i: 0
    for i < 3 loop {
        if c then {
            keep s: x
            break
        }
        i = i + 1
    }
}

Pick: union {
    one: String
    two: null
}

matched: function {p: Pick} is {
    y: "y".string
    match p case one then keep s: y case two then keep s: y
}

taking: function {s: String.take} is {
    print s
}

main: function is {
    xs: List String
    states c: true :xs
    nested c: false
    broken c: true
    matched p: (Pick.one "o".string)
    taking s: "t".string
}
