# data_construct.z -- a data value is built in a static position: a unit-level
# constant in parentheses, `T.create`, a type's `as` constant, or nested inside
# another data value. Each field is its argument or else its default, fitted to
# the field's type: an untyped number stays untyped in an intliteral field, a
# string is text. Equal values are one aggregate row (`leaf` and `same`).
mode: variant { fast: null slow: null }

inner: data {
    v: 3.u8
} as {
    ONE: (inner v: 1)
}

row: data {
    key: "k".text
    body: "".text
    n: 5
    w: 5.u8
    big: intliteral
    live: false
    m: mode
    sub: inner
}

leaf: (inner v: 7)
same: (inner v: 7)
first: (row key: "a" big: 99999999999999999999999 m: mode.slow sub: leaf)
second: (row key: "b" big: 1 sub: (inner v: 2) w: 9 live: true m: mode.fast)
dflt: inner.create
one: inner.ONE

main: function is {
    print "ok"
}
