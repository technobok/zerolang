# generator_loop_spills_only_suspending -- in a generator body, only a loop whose body
# suspends keeps what its header binds in the instance: a loop that never yields binds
# plain locals
Sums: generator { n: i64 } as {
    call: function out i64 is {
        total: 0
        for each x: this.n.times loop total = total + x
        yield total
        for each y: this.n.times loop yield y
    }
}

main: function is {
    for each s: (Sums n: 4) loop print "sum \{s}"
}
