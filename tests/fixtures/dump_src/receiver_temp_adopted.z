# A call's receiver that is a temporary -- a String built only to be viewed --
# is adopted by the value that keeps it: the field holds a view of it, so the
# temporary lives as long as the class value, and the call's own scope no
# longer lists it as owned (the dump's temp_destroy row reads `moved`).

# Label -- a name viewed from text it does not own
Label: class {
    name: StringView
}

main: function is {
    b: Label name: "abc def".string.stringView
    print b.name
}
