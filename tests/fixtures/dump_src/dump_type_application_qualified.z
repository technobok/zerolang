# dump_type_application_qualified.z -- a type application through its unit at a
# dotted base (`(pr.Getter v: i64).create from:`) names the instance, as the bare
# spelling does: no temporary holds the base, and no scope lists one.
GC: class { n: i64 s: String } as {
    g: (pr.Getter v: i64)
    get: function {c: this.view} out i64 is { return c.n }
}

mkQ: function out (pr.Getter v: i64) is {
    return ((pr.Getter v: i64).create from: (GC n: 4 s: "q".string))
}

main: function is {
    g: mkQ
    s: (pr.slot t: i64).full 3
    r: 0
    match (s) case full then r = s case empty then null
    print "\{g.get} \{r}"
}
