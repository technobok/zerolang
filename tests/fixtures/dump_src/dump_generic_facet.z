# A facet may be generic: its parameters sit in its body, beside the methods
# they type, as a protocol's do. Nothing registered a facet's parameters, so
# a method typed by one read it as an unknown name ("Unknown type 'n'") and
# the facet could not be declared at all.
#
# Each instance substitutes its own argument: `size` answers u32 through
# `(Sized n: u32)` and i64 through `(Sized n: i64)`. The references demand
# the bodies; building a value of an instance needs a conformer, so the case
# is a dump: the program typechecks.
Sized: facet {
    n: anyval.generic
    size: function {t: this.view} out n
    fits: function {t: this.view limit: n} out bool
}

measure: function {z: (Sized n: u32)} out u32 is {
    if (z.fits limit: 10) then return z.size
    return 0
}

measureView: function {z: (Sized n: i64).view} out i64 is { return z.size }

main: function is {
    m: measure.take
    v: measureView.take
    print "declared"
}
