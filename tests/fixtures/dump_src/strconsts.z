# strconsts.z -- string compile-time values, pinned through the canonical dump
# AND through the run. A folded string that IS read at run time materialises as
# a `_zcs` static, so this unit has a `main`: the values below are the same
# ones the dump asserts, printed.
#
# LIB and ECHO fold to the same text and share one `_zcs` -- the pool is
# deduplicated by bytes, because a folded value has no node identity to key on.

LIB: "quadmath"

# comparison is by interned text
SAME: "abc" == "abc"
DIFF: "abc" == "xyz"
NEQ: "abc" != "xyz"

# a constant reading another constant
ECHO: LIB

# a string comparison selecting a branch, which is the shape a `require:`
# guard takes: the condition folds, and the value is the winning arm's string
PICK: if LIB == "quadmath" then { "yes" } else { "no" }

main: function is {
    print LIB
    print ECHO
    print PICK
    if SAME then print "same" else print "SAME BAD"
    if DIFF then print "DIFF BAD" else print "diff"
    if NEQ then print "neq" else print "NEQ BAD"
}
