# Each generic instance walks its own copy of the body, so each records its own
# destroy lists -- the two instances of `pairUp` list their locals separately,
# at the template's position. A generator's locals are ordinary locals, kept in
# the instance across suspensions, and are listed where their scope ends.
pairUp: function as { t: anyval.generic } in { v: t } out u64 is {
    label: "pair".string
    n: label.length
    return n
}

Gen: generator as {
    call: function out u64 is {
        s: "gen".string
        yield s.length
        {
            inner: "inner".string
            yield inner.length
        }
    }
}

main: function is {
    print "\{pairUp v: 1} \{pairUp v: 2.5}"
    for g: Gen loop print "\{g}"
}
