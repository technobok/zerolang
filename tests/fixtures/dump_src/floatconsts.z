# floatconsts -- untyped float constants as the canonical dump spells them:
# exactly, whichever pool holds them -- a fraction's terminating decimal, a
# fraction that does not terminate, a value past what a fraction holds (512
# bits), and a negative zero.
SUM: 0.1 + 0.2
THIRD: 1.0 / 3
HUGE: 1e4000
NEGZERO: -0.0

main: function is {
    a: SUM
    b: THIRD
    c: HUGE.f128
    d: NEGZERO
    print "\{a} \{b} \{d}"
}
