# dump_lent_field_temp.z -- an argument read out of storage something else
# owns is held by a temporary that owns nothing. `(hs.get i: 0).parts` is a
# field of the list's element: its hoisted temporary is BORROWED, and no scope
# lists it to destroy. The temporary of an owned value (`mk`) still owns.
measure: function {parts: List String} out u64 is {
    return parts.length
}

H: class {
    parts: List String
}

mk: function out List String is {
    r: (List String)
    r.append "x".string
    return r
}

main: function is {
    p: (List String)
    p.append "a".string
    h: (H parts: p.take)
    hs: (List H)
    hs.append h
    n: measure parts: (hs.get i: 0).parts
    o: measure parts: mk
    print "n=\{n} o=\{o}"
}
