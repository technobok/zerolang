# discard_plain_class_no_temp -- a discarded result whose type needs no destructor (a
# class of plain values) is evaluated for its effect alone, with no discard temporary.
C: class {
    v: u64
}

mkc: function {n: u64} out C is {
    print "make \{n}"
    return (C v: n)
}

main: function is {
    mkc n: 1
    C v: 2
    print "done"
}
