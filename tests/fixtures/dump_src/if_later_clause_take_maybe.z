# if_later_clause_take_maybe -- A `.take` argument in the condition of a clause after
# the first moves its source only when the clauses before it failed: where an earlier
# clause held, the source is still owned and the scope's end frees it, once.
eats: function {s: String.take} out bool is {
    return s.length > 3
}

yep: function out bool is {
    return true
}

nope: function out bool is {
    return false
}

main: function is {
    m: "a string long enough to live on the heap, never eaten".string
    if yep then {
        print "m first"
    } when (eats s: m) then {
        print "m never"
    }
    n: "a string long enough to live on the heap, eaten".string
    if nope then {
        print "n never"
    } when (eats s: n) then {
        print "n eaten"
    }
    print "end"
}
