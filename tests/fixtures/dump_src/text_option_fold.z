# text_option_fold.z -- a text method answering an option, called on a string
# constant with constant arguments, folds to a known `some` (a choice-shaped
# value of the optionval) or `none` (its arm); `.or d:` and the arm predicates
# fold on it. The dump shows each value.
G: "hello # world"
AT: G.indexOf "#"
MISS: G.indexOf "%"
LAST: G.lastIndexOf "o"
CUT: G.splitOnce "#"
BYTE: G.byteAt 1
PAST: G.byteAt 100
REST: G.stripPrefix "hello "
NOREST: G.stripSuffix "x"
OR: (AT.or d: 0)
ORNONE: (MISS.or d: 7)
HAS: AT.some
NONE: MISS.none
main: function is {
    print G
}
