# text_fold.z -- a text method called on a string constant with constant
# arguments folds to a constant: a number answer is untyped, a yes-or-no one a
# bool, and a new string is a textliteral. The dump shows each value.
NAME: "  Zero lang  "
LEN: NAME.length
COUNT: "héllo".count
EMPTY: "".isEmpty
ASCII: "héllo".isAscii
STARTS: (NAME.startsWith prefix: "  Z")
ENDS: (NAME.endsWith suffix: "x")
HAS: (NAME.contains needle: "lang")
SUB: (NAME.substring from: 2 to: 6)
TRIM: NAME.trim
LEFT: NAME.trimStart
RIGHT: NAME.trimEnd
SWAP: (NAME.replace needle: " " replacement: "_")
FIRST: (NAME.replaceFirst needle: "  " replacement: "")
UP: NAME.toUpperAscii
DOWN: TRIM.toLowerAscii
REP: ("ab".repeated n: 3)
CAT: ("ab".concat other: "cd")
PLUS: "ab" + "cd"
main: function is {
    print UP
}
