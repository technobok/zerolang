# if_first_condition_take_moved -- what the first condition of an `if` moves is moved on
# every path: the local is gone after the `if`, not owed a destroy on some paths
eat: function {s: String.take} out bool is {
    return s.length > 2
}

main: function is {
    s: "abc".string
    if (eat :s) then print "long"
    print "done"
}
