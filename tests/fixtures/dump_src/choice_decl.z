# choice_decl.z -- `choice` declares a static sum type: a variant the dump marks
# is_static. An arm carries nothing (`null`) or one static value -- a number (a
# literal type kept untyped), bool or another enum, text, a static list, a data
# value or another choice.
inner: data {
    v: u8
}

mode: choice {
    fast: null
    slow: null
}

form: choice {
    call: null
    template: text
    count: intliteral
    width: u8
    live: bool
    sub: inner
    nested: mode
    nums: staticlist u8
}

main: function is {
    print "x"
}
