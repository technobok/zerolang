# dump_arm_return_temp.z -- a temporary bound in an arm that returns, whose
# value the return moves out: `Sp.create from:` takes its source into the box,
# so the source's temporary is MOVED on that path, as it is at the function's
# own level. The arm's walk ends by leaving the function, which drops the arm's
# takes of outer locals; a temporary bound in the arm dies with it and keeps
# its take, so its scope's record says moved rather than owned.
Sp: protocol {
    get: function {t: this.view} out i64
}

PC: class { n: i64 s: String } as {
    :Sp
    get: function {c: this.view} out i64 is { return c.n }
}

U: union { a: PC e: null }

atTop: function out Sp is {
    return (Sp.create from: (PC n: 1 s: "p".string))
}

inIf: function {k: i64} out Sp is {
    if k > 0 then return (Sp.create from: (PC n: 2 s: "p".string))
    return (Sp.create from: (PC n: 3 s: "p".string))
}

inMatch: function {u: U} out Sp is {
    match (
        u
    ) case a then {
        return (Sp.create from: (PC n: 4 s: "p".string))
    } case e then {
        return (Sp.create from: (PC n: 5 s: "p".string))
    }
}

inBlock: function {k: i64} out Sp is {
    if k > 0 then {
        return (Sp.create from: (PC n: 6 s: "p".string))
    }
    return (Sp.create from: (PC n: 7 s: "p".string))
}

main: function is {
    u: U.e
    a: atTop
    b: inIf k: 1
    c: inMatch :u
    d: inBlock k: 1
    print "\{a.get} \{b.get} \{c.get} \{d.get}"
}
