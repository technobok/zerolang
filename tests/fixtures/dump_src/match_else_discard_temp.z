# match_else_discard_temp -- the last line of a statement match's `else` block is a
# discarded statement: a fresh owned result there is held in a temporary and destroyed.
kind: variant {
    a: null
    b: null
}

mk: function out String is {
    return "beta".string
}

run: function {k: kind} is {
    match (
        k
    ) case a then {
        print "a"
    } else {
        print "other"
        mk
    }
    print "after"
}

main: function is {
    run k: kind.a
    run k: kind.b
}
