# data_decl.z -- `data` declares a static record type: a valtype the dump marks
# is_static. Its fields hold static values -- numbers (a literal type kept
# untyped), bool and other enums, text, a function reference, a static list and
# another data type -- and a default is written by value, as a record's is.
mode: variant { fast: null slow: null }

inner: data {
    v: u8
}

row: data {
    key: text
    body: "".text
    n: 5
    w: 5.u8
    big: intliteral
    ratio: floatliteral
    live: false
    m: mode
    needs: staticlist text
    sub: inner
    f: function {x: u8} out u8
}

main: function is {
    print "ok"
}
