# tagconsts.z -- variant-tag and bool compile-time values, pinned through the
# canonical dump. No `main`: the emitter cannot render a tag constant yet, so
# this unit is type-checked and dumped but never built.

cckind: variant {
    gcc: null
    clang: null
    tcc: null
    other: null
}

# an arm read is a compile-time value even when nothing else mentions the
# variant -- the read is itself the use that brings the type into being
CC: cckind.tcc

# equality compares arm IDENTITY, not rendered text
ISTCC: CC == cckind.tcc
ISGCC: CC == cckind.gcc
NOTGCC: CC != cckind.gcc

# `value.arm` is always a predicate, which is the form `if platform.os.linux`
# takes -- a different path from `==` against a tag, and both must agree
PRED: CC.tcc
PREDF: CC.gcc

# bool's arms fold to plain bool values
YES: bool.true
NO: bool.false
SAME: YES == NO

# reached THROUGH a unit: an arm of a type the unit declares, and both
# spellings of the question against a constant the unit declares. `tagsrc.os`
# is a CONSTANT whose type is a variant, so the predicate must win over reading
# `os` as a qualified type name.
QUAL: tagsrc.oskind.linux
QMATCH: tagsrc.os == tagsrc.oskind.linux
QPRED: tagsrc.os.linux
QPREDF: tagsrc.os.darwin

# a predicate as an `if` condition, and as an else-if guard
PICKED: if CC.tcc then { 128 } else { 64 }
GUARDED: if CC == cckind.gcc then { 1 } else if CC.tcc then { 2 } else { 3 }
