# if_value_park_temp_scope -- the temporary that parks an owned arm of a value `if`
# whose other arm is a place belongs to the `if`'s own scope, not to its else body's.
pick: function {c: bool s: String} out u64 is {
    x: if c then "own \{s}" else s
    print x.stringView
    return x.length
}
pick2: function {c: bool s: String} out u64 is {
    x: if c then s else "own \{s}"
    print x.stringView
    return x.length
}
main: function is {
    s: "outer".string
    print "\{pick c: true :s} \{pick c: false :s}"
    print "\{pick2 c: true :s} \{pick2 c: false :s}"
}
