# A parameter's borrow default is decided by its type, and a program's own
# `List` or `StringView` is its own type. A `decl_child` row's last column is
# a parameter's recorded ownership: the record `List` passes by value
# (NULL), the class `StringView`'s `this` borrows (1), as the system ListVal
# and String parameters do. By name, the record borrowed and the class's
# `this` did not.
List: record {
    n: i64
} as {
    t: anyval.generic
}

StringView: class {
    n: i64
} as {
    bump: function {:this} is {
        this.n = this.n + 1
    }
}

count: function {l: List i64} out i64 is {
    return l.n
}

sizes: function {r: ListVal i64 s: String} out u64 is {
    return r.length + s.length
}

main: function is {
    v: StringView n: 1
    v.bump
    r: ListVal i64
    r.append 4
    print "\{count l: (List i64 n: 5)} \{v.n} \{sizes :r s: "ab".string}"
}
