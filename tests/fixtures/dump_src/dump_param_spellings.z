# A parameter's recorded ownership is decided by its resolved type, not by how
# it is spelled. An unmarked class parameter written as an application, a
# typedef of one, a bare name or a path into a unit borrows in every case: each
# `decl_child` row below for fa..fd ends in 1. By the spelling, the
# application and the path recorded nothing.
Cell: class {
    n: i64
} as {
    t: anyval.generic
}

CellT: Cell i64

Box: class {
    n: i64
}

kit: unit {
    Box: class {
        n: i64
    }
}

fa: function {c: Cell i64} out i64 is {
    return c.n
}

fb: function {c: CellT} out i64 is {
    return c.n
}

fc: function {b: Box} out i64 is {
    return b.n
}

fd: function {b: kit.Box} out i64 is {
    return b.n
}

main: function is {
    c: Cell i64 n: 1
    b: Box n: 2
    k: kit.Box n: 3
    print "\{fa :c} \{fb :c} \{fc :b} \{fd b: k}"
}
