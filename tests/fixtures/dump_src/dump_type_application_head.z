# dump_type_application_head.z -- a dotted path whose base applies a type to
# type arguments (`(Option T: PC).some`) names an arm of that TYPE: the base
# computes no value, so no temporary holds it and no scope lists one. A
# projection written the same way over a VALUE (`(Rd c).rdn`) is a value, and
# its temporary stays.
Rd: protocol {
    rdn: function {t: this.view} out i64
}

PC: class { n: i64 s: String } as {
    :Rd
    rdn: function {c: this.view} out i64 is { return c.n }
}

someOf: function out (Option T: PC) is {
    return ((Option T: PC).some (PC n: 1 s: "p".string))
}

noneOf: function out (Option T: PC) is {
    return (Option T: PC).none
}

okOf: function out (Result T: PC E: String) is {
    return ((Result T: PC E: String).ok (PC n: 2 s: "p".string))
}

main: function is {
    a: someOf
    b: noneOf
    c: okOf
    p: PC n: 3 s: "p".string
    print "\{a.some} \{b.none} \{c.ok} \{(Rd p).rdn}"
}
