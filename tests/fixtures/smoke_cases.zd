# smoke_cases -- the SMOKE kind's programs: built, then run with no
# arguments, their output equal to tests/fixtures/<name>_z/smoke.expected. A
# smoke harness over the compiler's own units reads them from src.

# program -- one test program: <dir>/<name>.z from the repository root, its
# units also read from each of `roots`
program: data {
    name: text
    dir: text
    roots: list {} out staticlist text
    # it checks what only POSIX has (file descriptors, signals): on Windows it
    # is listed as (posix) and not run
    posix: false
}

programs: list {
    (program name: "zparser_dump" dir: "tests/unit")
    (program name: "zast_smoke" dir: "tests/unit")
    (program name: "zenv_smoke" dir: "tests/unit" roots: list { "src" })
    (program name: "ztypes_smoke" dir: "tests/unit" roots: list { "src" })
    (program name: "ztyping_smoke" dir: "tests/unit" roots: list { "src" })
    (program name: "io_list_dir" dir: "examples")
    (program name: "io_lstat" dir: "examples")
    (program name: "xunit_main" dir: "tests/fixtures/emitc_corpus")
    (program name: "zdoc_smoke" dir: "tests/unit" roots: list { "src" })
    (program name: "zproject_smoke" dir: "tests/unit" roots: list { "src" })
}
