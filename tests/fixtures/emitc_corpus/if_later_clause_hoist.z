# AN `if` MAY HAVE MORE THAN ONE CLAUSE, and a later clause's conditions may
# need temporaries -- here an owned String passed to a `.view` parameter. They
# run only when every earlier clause failed, so they are declared on that path:
# a later clause that needs any opens a block of its own. Its `} else if` header
# had nowhere to put them, and the C named a temporary it never declared.
mks: function {n: i64} out String is {
    print "s\{n}"
    return "x\{n}"
}

lenv: function {a: String.view} out u64 is {
    return a.length
}

lt: function {a: u64 b: u64} out bool is {
    return a < b
}

main: function is {
    open: true
    if open then print "first" when (lt a: 1 b: (lenv a: (mks n: 1))) then print "never"
    if open.not then {
        print "never"
    } when (lt a: 1 b: (lenv a: (mks n: 2))) when (lt a: 9 b: (lenv a: (mks n: 3))) then {
        print "never"
    } when (lt a: 1 b: (lenv a: (mks n: 4))) then {
        print "third clause"
    } else {
        print "never"
    }
    w: if open.not then "never" when (lt a: 1 b: (lenv a: (mks n: 5))) then "bound" else "never"
    print w
    print "end"
}
