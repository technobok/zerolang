# A GENERIC FUNCTION'S CONCRETE PARAMETERS KEEP THEIR TYPES. Only a parameter
# declared as one of the function's own generic parameters binds one; a `u64`
# or `u8` parameter binds nothing, whatever its argument is. A literal passed
# to one used to bind a stray "parameter" named after the type, so the
# instance's `n` -- and a return declared `u64` -- became the literal's i64,
# and the FIRST call decided that for every later call.
wrap: function as { t: anyval.generic } in { v: t n: u64 } out u64 is {
    i: 0.u64
    for i < n loop {
        i = i + 1
    }
    return i
}

narrow: function as { t: anyval.generic } in { v: t n: u8 } out u8 is {
    i: 0.u8
    for i < n loop {
        i = i + 1
    }
    return i
}

sum: function as { t: anyval.generic } in { v: t n: u64 m: u64 } out u64 is {
    return n + m
}

big: function as { t: anyval.generic } in { v: t n: u64 } out u64 is {
    return n
}

total: function as { t: anyval.generic } in { l: (ListVal t: t) n: u64 } out u64 is {
    return l.length + n
}

pick: function as { t: anyval.generic } in { v: t a: f64 b: f64 } out f64 is {
    return a + b
}

main: function is {
    print "\{wrap t: i64 v: 6 n: 4}"
    print "\{wrap t: i64 v: 5 n: 3.u64}"
    print "\{wrap v: 5 n: 2}"
    print "\{narrow t: i64 v: 5 n: 3}"
    k: 3.u64
    print "\{sum t: i64 v: 5 n: 3 m: k}"
    x: big t: i64 v: 5 n: 3
    y: x + 18446744073709551000
    print "\{y}"
    xs: (ListVal t: i64)
    xs.append from: 3
    print "\{total l: xs n: 4}"
    print "\{pick v: true a: 2 b: 0.25}"
}
