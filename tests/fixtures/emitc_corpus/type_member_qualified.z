# type_member_qualified.z -- inside a type, its members are the nearest
# declarations of their names, so an outer type of the same spelling is reached
# through its unit: a type with a conversion named after a scalar spells the
# scalar `system.u8`; a field named after its type is the `:nodeid` shorthand,
# and a sibling typed by that type names it through the program's own unit; an
# arm named after the type it boxes spells it `system.u16`.
nodeid: record { v: u32 }

Num: record { v: i64 } as {
    u8: function {n: this.view} out (resultval system.u8 e: converror) is { return n.v.u8 }
    twice: function {n: this.view} out system.i64 is {
        w: system.i64
        w = n.v * 2
        return w
    }
}

Row: record {
    :nodeid
    other: type_member_qualified.nodeid
}

Sum: union {
    u16: Box system.u16
    none: null
}

main: function is {
    n: Num v: 21
    b: n.u8
    match b case ok then print "u8 \{b}" case err then print "out of range"
    print "twice \{n.twice}"
    r: Row nodeid: (nodeid v: 1) other: (nodeid v: 2)
    print "row \{r.nodeid.v} \{r.other.v}"
    s: Sum.u16 7
    match s case u16 then print "boxed \{s}" case none then print "none"
}
