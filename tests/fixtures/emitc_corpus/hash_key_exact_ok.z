# Keys whose `hash` and `==` match the key spec exactly: a class declaring
# both, a record writing both, and String, whose `==` is generic over
# StringLike and admits a String.
Key: class { n: u64 } as {
    hash: function {t: this.view} out u64 is { return t.n }
    ==: function {t: this.view rhs: Key} out bool is { return t.n == rhs.n }
}
pt: record { x: u64 } as {
    hash: function {t: this.view} out u64 is { return t.x * 31 }
    ==: function {t: this.view rhs: pt} out bool is { return t.x == rhs.x }
}

main: function is {
    m: MapRV Key v: u64
    m.set key: (Key n: 1) value: 7
    s: SetVal pt
    s.add item: (pt x: 3)
    s.add item: (pt x: 3)
    names: MapRV String v: u64
    names.set key: "a".string value: 1
    print "\{m.length} \{s.length} \{names.length}"
}
