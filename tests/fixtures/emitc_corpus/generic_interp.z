# generic_interp.z -- interpolating a generic-param value inside a template:
# the fn-mono re-walk resolves the bare param through the mono's concrete
# param child (numeric, float, StringView, String).
show: function as { t: anyval.generic } in {v: t} is {
    print "v=\{v} end"
}

showRef: function as { T: AnyRef.generic } in {v: T} is {
    print "v=\{v} end"
}

main: function is {
    show v: 7
    show v: 2.5
    sv: "text"
    showRef v: sv
    s0: "owned".string
    showRef v: s0
}
