# interpolation_block.z -- an interpolated block may span lines, with comments
# among its lines (spec.pdoc: `\{ blocklines }`). It was refused as "Bad
# expression in string interpolation": the parser read the line break after
# `\{` where it expected the expression.

shout: function {s: StringView} out String is {
    return "\{s}!"
}

main: function is {
    a: "one: \{
        shout "hello"    # even with comments
    } and more"
    print a
    b: "two: \{

        shout "spaced"

    }"
    print b
}
