# `tagger` is DECLARED and CONFORMED TO but never used as a value. Every
# existing facet program constructs one (`measurable.create from: p`), and that
# construction is what demanded the facet's resolution -- an interface is not
# eager, so without a demand the conformance marker resolved to nothing and
# reported "Unknown type 'tagger'".
#
# Conforming without ever constructing is the normal case for a constraint
# facet: a type says it can be hashed, it does not build a Hashable.
#
# `sizer` is the control: it IS constructed, so it demanded itself and worked
# before this fix. Both must keep working.
sizer: facet {
    size: function {:this b: i64} out i64
}

tagger: facet {
    tag: function {:this} out i64
}

pt: record {
    x: i64
} as {
    m: sizer
    t2: tagger
    size: function {p: this b: i64} out i64 is {
        return p.x + b
    }
    tag: function {p: this} out i64 is {
        return p.x * 100
    }
}

main: function is {
    q: pt x: 5
    print "direct=\{q.size b: 10}"
    print "tag=\{q.tag}"
    f: sizer.create from: q
    print "through=\{f.size b: 10}"
}
