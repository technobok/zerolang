# data_narrowed_argument.z -- a data value narrowed out of a sum and handed on
# whole: as an argument, a record field, a list element and a reassigned
# local. The payload is the data value's handle, so it is passed as it is.
link: data {
    weight: 1
}
os: choice {
    linux: null
    other: link
}
seven: (link weight: 7)
oth: (os.other seven)
holder: record {
    l: link
}

weightOf: function {l: link} out i64 is {
    return l.weight
}

guarded: function {o: optionval link} out i64 is {
    if o.none then return 0
    return (weightOf l: o)
}

main: function is {
    o: oth
    if o.other then print "if \{weightOf l: o}"
    if o.linux then print "linux" else print "else \{weightOf l: o}"
    match (o) case other then print "match \{weightOf l: o}" case linux then print "linux"
    p: optionval.some seven
    if p.some then {
        h: holder l: p
        xs: ListVal link
        xs.append p
        last: seven
        last = p
        print "opt \{weightOf l: p} \{h.l.weight} \{(xs.get i: 0).weight} \{last.weight}"
    }
    print "guarded \{guarded o: p}"
}
