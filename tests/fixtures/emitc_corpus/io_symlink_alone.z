# io.symlink is the only io call: its fragment wraps the result with the
# shared null-result helper, which it now names as a need (io.@wrap_null)
# instead of firing only with the calls that happened to list its demand
# (mkdir, remove, ...). The call is compiled, never run: its directory does
# not exist on any host, and a link's success differs between them.
main: function is {
    dir: "z_io_symlink_alone_missing_dir"
    if (io.exists path: dir) then {
        r: io.symlink target: "nowhere" link: "z_io_symlink_alone_missing_dir/link"
        match (
            r
        ) case ok then {
            print "linked"
        } case err then {
            print "failed"
        }
    }
    print "compiled"
}
