# A field moved into an argument is empty from the point the move is written:
# whatever the same statement runs afterwards -- an enclosing call's later
# argument, the other operand, the next interpolation part, a later conjunct --
# reads it empty, and a second call that moves it again moves nothing twice.
Holder: class {
    p: String
    q: String
}

keep: function {s: String.take} out u64 is {
    return s.length
}

show: function {h: Holder n: u64} out u64 is {
    print "show sees '\{h.p}' after \{n}"
    return n
}

mk: function {} out Holder is {
    return (Holder p: "abc".string q: "de".string)
}

main: function is {
    a: mk
    print "enclosing \{show n: (keep s: a.p) h: a}"
    b: mk
    print "twice \{(keep s: b.p) + (keep s: b.p.take)}"
    c: mk
    print "operand \{(keep s: c.p) + c.p.length}"
    d: mk
    print "parts \{keep s: d.p} '\{d.p}' \{keep s: d.q}"
    e: mk
    if (keep s: e.p) > 0 when e.p.length == 0 then print "conjunct '\{e.p}'"
    f: mk
    n: (keep s: f.p) + (keep s: f.q)
    print "both fields \{n} '\{f.p}' '\{f.q}'"
}
