# nested_unit_alias_type.z -- a unit-level alias of a type reached through a
# NESTED unit (`B: inner.T`) is a type alias, as it is through a file unit: it
# constructs, it is a declared type, and a value of it is the aliased record.
# An alias of the nested unit's constant, or of a type's arm, stays a value.
outer: unit {
    inner: unit {
        T: record {s: i64}
        E: variant {lo: null hi: null}
        N: 5
    }
    B: inner.T
    K: inner.E
    V: inner.N
    L: K.lo
    mk: function out B is { return (B s: 4) }
    show: function {b: B} is { print "s \{b.s}" }
    top: function out K is { return K.hi }
    side: function {k: K} out StringView is {
        match (k) case lo then return "lo" case hi then return "hi"
    }
}

main: function is {
    print "mk \{outer.mk.s}"
    b: outer.B s: 9
    outer.show :b
    t: outer.inner.T s: 3
    outer.show b: t
    print "top \{outer.side k: outer.top}"
    print "v \{outer.V + 1}"
    print "L \{outer.side k: outer.L}"
}
