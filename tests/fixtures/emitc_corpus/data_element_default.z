# data_element_default.z -- a default may be a data block's element that folds to
# a string: the parameter and the field are StringView, filled from the
# element's static bytes.
verbs: data { build: "build" run: "run" } out StringView

act: function {verb: verbs.run} is {
    print "act=\{verb}"
}

Cmd: class {
    verb: verbs.build
}

main: function is {
    act
    act verb: verbs.build
    c: Cmd
    print "cmd=\{c.verb}"
}
