# an iterator holds an exclusive lock on its container for the loop; writes to
# everything else stay permitted
Tally: class { total: i64 }
main: function is {
    xs: (List i64)
    xs.append 3
    xs.append 4
    t: Tally total: 0
    n: 0
    with it: xs.iterate do for e: it loop {
        t.total = t.total + e
        n = n + 1
    }
    print "\{t.total} \{n}"
}
