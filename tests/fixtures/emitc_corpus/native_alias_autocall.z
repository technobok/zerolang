# A native function with no parameters is called by its bare name through an
# alias as it is through its unit: the prelude's `stdout`, and a program's own
# alias of `os.pid`. The alias used to be emitted as a call of a C function
# named after the function's type, which a native does not have.

# pidOf -- the process id, under a name of this program's
pidOf: os.pid

main: function is {
    p: pidOf
    print "\{p > 0} \{p == os.pid}"
    w: stdout
    print "bound"
}
