# span_slice_oob.z -- a window over [from, to) must lie inside what lends it:
# `to` past the list's length panics ("zpanic: <msg>" on stderr, exit 1) rather
# than lend storage the list does not have.

main: function is {
    xs: ListVal u64
    xs.append from: 1
    print "before"
    w: xs.mutSlice from: 0 to: 2
    print "\{w.length}"
}
