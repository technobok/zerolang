# generic_partial_members -- a generic type's own walk reads a member of a
# partial instance -- a field of type `(array u64 to: n)` -- through the
# partial's template, and the member's type takes the partial's own arguments
# back: its `listView` is a `(ListViewVal t: u64)`, so a `for each` over it
# yields u64 words, not the array template's `t`.
public: unit {
    :main
}

# Box -- n words in an array
Box: record {
    a: (array u64 to: n)
} as {
    n: u64.generic
    # sum -- the words added
    sum: function {t: this.view} out u64 is {
        s: u64
        for each w: t.a.listView loop s = s + w
        return s
    }
    # first -- the first word, read by index, plus one
    first: function {t: this.view} out u64 is {
        return (t.a.get i: 0) + 1
    }
}

main: function is {
    b: (Box n: 3) a: (array u64 to: 3)
    b.a.set i: 0 item: 2
    b.a.set i: 1 item: 5
    b.a.set i: 2 item: 7
    print "\{b.sum} \{b.first}"
    c: (Box n: 1) a: (array u64 to: 1)
    c.a.set i: 0 item: 9
    print "\{c.sum} \{c.first}"
}
