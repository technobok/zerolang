# A bound names what its spelling resolves to, like any other name: a name, a
# type application, and each of those reached through a unit admit the types
# that conform to them; a conformance marker through a unit is one; and a
# unit's own declaration of a family's name (`StringLike`) is that declaration,
# not the family.
Rd: protocol {
    rdn: function {t: this.view} out i64
}

Getter: protocol {
    v: anyval.generic
    get: function {t: this.view} out v
}

StringLike: protocol {
    size: function {t: this.view} out i64
}

C: class { n: i64 } as {
    r: Rd
    q: pr.Rd
    g: (Getter v: i64)
    h: (pr.Getter v: i64)
    s: StringLike
    rdn: function {c: this.view} out i64 is { return c.n }
    get: function {c: this.view} out i64 is { return c.n + 1 }
    size: function {c: this.view} out i64 is { return c.n + 2 }
}

byName: function {x: T} out i64 is { return x.rdn } as {
    T: Rd.generic
}

byApp: function {x: T} out i64 is { return x.get } as {
    T: (Getter v: i64).generic
}

byQualName: function {x: T} out i64 is { return x.rdn } as {
    T: pr.Rd.generic
}

byQualApp: function {x: T} out i64 is { return x.get } as {
    T: (pr.Getter v: i64).generic
}

byShadow: function {x: T} out i64 is { return x.size } as {
    T: StringLike.generic
}

main: function is {
    c: C n: 10
    print "\{byName x: c} \{byApp x: c} \{byQualName x: c} \{byQualApp x: c} \{byShadow x: c}"
}
