# io_file_by_fields.z -- a runtime-owned class built by its fields: a File over
# standard output that does not own it (`open: false`), so dropping it closes
# nothing and a second one still writes.

say: function {text: StringView} is {
    stdout: io.File fd: 1 open: false
    b: Bytes
    i: u64
    for i < text.length loop {
        c: text.byteAt :i
        match (c) case some then b.append from: c case none then null
        i = i + 1
    }
    b.append from: 10.u8
    w: stdout.write from: b.byteView
    match (w) case ok then null case err then io.eprintln "write failed"
}

main: function is {
    say text: "written through a File built by its fields"
    say text: "and standard output is still open"
}
