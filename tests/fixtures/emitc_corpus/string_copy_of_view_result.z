# string_copy_of_view_result.z -- `.copy` of a String a call hands back as a
# view (`outx String.view`) copies the call's result, which C cannot address:
# the result is bound to a temporary first, in a return and in an argument as
# in a binding. The call runs once.
Holder: class {
    s: String
    reads: u64
}

textOf: function {h: Holder} outx String.view is {
    h.reads = h.reads + 1
    return h.s
}

copied: function {h: Holder} out String is {
    return (textOf :h).copy
}

show: function {s: String} is {
    print s
}

main: function {} is {
    h: Holder s: "abc".string reads: 0
    print (copied :h)
    show s: (textOf :h).copy
    c: (textOf :h).copy
    c.append "d"
    print c
    print "\{h.s} \{h.reads}"
}
