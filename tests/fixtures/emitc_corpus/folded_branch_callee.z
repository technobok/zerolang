# folded_branch_callee.z -- a function only another system's folded-away
# branch calls is not walked on this one, so it is not emitted either: the
# emitter asks whether a definition was walked for the main unit as for any.
# Its caller is reached through a class method, which is when the reference
# is resolved but the body never walked.
toPath: function {uri: StringView} out String is {
    r: uri.string
    if z.build.os == z.build.oskind.windows then return (windowsOnly p: r.stringView)
    return r
}

windowsOnly: function {p: StringView} out String is {
    return (path.clean :p)
}

Server: class {
    root: String
} as {
    open: function {:this uri: StringView} is {
        this.root = toPath :uri
    }
}

main: function is {
    s: Server root: "".string
    s.open uri: "a/b"
    print s.root
}
