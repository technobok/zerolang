# Operators a type writes answer for its constants as at run time: a choice's
# written `<`, a typedef field's written `==` inside a data type's generated
# `==`. A float fold that fails in a body is no reason a later constant `if`
# stops folding. `false == (b.some)` guards as `b.some.not` does.
form: choice {
    none: null
    tpl: text
} as {
    <: function {:this rhs: form} out bool is {
        return true
    }
}
N: form.none
T: (form.tpl "x")

parity: typedef u64 as {
    ==: function {t: this.view rhs: parity} out bool is {
        return (t.u64 % 2) == (rhs.u64 % 2)
    }
}
outer: data {
    n: 5
    p: parity
}
PA: (outer p: (parity 1))
PB: (outer p: (parity 3))

color: variant {
    red: null
    green: null
}
K: color.green
J: K

same: function {a: outer b: outer} out bool is {
    return a == b
}

pickOne: function out i64 is {
    a: 1.0.f64 / 0.0
    if J == color.green then {
        print "\{a > 1.0}"
        return 1
    }
}

guarded: function {b: optionval i64} out i64 is {
    if false == (b.some) then {
        return 7
    }
    return b
}

main: function is {
    print "\{N < T}"
    print "\{PA == PB} \{PA != PB} \{same a: PA b: PB} \{PA.p == PB.p}"
    print "\{pickOne}"
    print "\{guarded b: (optionval i64).none} \{guarded b: (optionval i64).some 3}"
}
