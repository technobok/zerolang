# Deep readonly is about reading a reftype FIELD out of a readonly path. A
# CALL's result carries its signature's ownership instead, so `.copy` -- the
# escape hatch every readonly diagnostic points at -- and an owned return read
# off a readonly receiver both bind fresh mutable values, while the frozen
# source stays readable.
Inner: class {
    n: i64
    label: String
} as {
    labelOf: function {t: this.view} out String is {
        return t.label.copy
    }
}
main: function is {
    s0: "abc".string
    h: s0.hold
    c: h.copy
    c.append s: "def".string
    print "copy=\{c} held=\{h} \{h.length}"

    i0: Inner n: 1 label: "src".string
    f: i0.hold
    l: f.labelOf
    l.append s: "!".string
    print "label=\{l} held=\{f.label} \{f.n}"
}
