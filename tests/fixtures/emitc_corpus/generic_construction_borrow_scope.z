# generic_construction_borrow_scope.z -- a generic class holding a borrowed
# reference locks its source for as long as it lives, and no longer: once it
# goes out of scope the source is the caller's to change and drop again, and a
# function may return one built from a `.borrow` parameter.
Bag: class {
    name: String
}

Peeker: class {
    target: Bag.borrow
    tag: t
} as {
    t: anyval.generic
}

make: function {b: Bag.borrow} outx (Peeker t: i64) is {
    return (Peeker target: b tag: 7.i64)
}

main: function is {
    b: Bag name: "one".string
    {
        p: Peeker target: b tag: 2.i64
        q: (Peeker t: u8) target: b tag: 3
        print "\{p.target.name} \{p.tag} \{q.tag}"
    }
    b.name = "two".string
    {
        r: make :b
        print "\{r.target.name} \{r.tag}"
    }
    b.drop
    print "done"
}
