# shadow_lowered_types.z -- a user type spelled like a system type that the
# compiler's own lowering builds (a `{ ... break ... }` value's optionval or
# Option, a comprehension's ListVal or ListRef) does not capture that lowering:
# the compiler names its types by well-known slot, never by spelling in the
# user's scope.
optionval: record {a: i64}
Option: record {a: i64}
ListVal: record {a: i64}
ListRef: record {a: i64}

main: function is {
    n: {
        if 1 > 2 then break
        42
    }
    match (n) case some then print "n \{n}" case none then print "no n"
    s: {
        if 1 > 2 then break
        "text".string
    }
    match (s) case some then print "s \{s}" case none then print "no s"
    xs: for each i: (0.upto to: 3) loop i * 2
    print "xs \{xs.length} \{xs.get i: 2}"
    ws: for each i: (0.upto to: 2) loop "w\{i}"
    print "ws \{ws.length} \{ws.get i: 1}"
    u: optionval a: 1
    print "user \{u.a}"
}
