# suffix_type_user_scalar.z -- a dotted numeric literal declares its SUFFIX's
# type, and a suffix is the system's scalar wherever it is written: in an
# expression (`q: 4.u64`) and in a type position (the field `k: 4.u64`, the
# parameter `k: 5.u64`) alike, whatever the program declares under the name.
# Both type positions used to resolve the suffix in the program's scope and
# took the program's own `u64` record.
u64: record {
    n: i64
}

pt: record {
    k: 4.u64
}

show: function {k: 5.u64} is {
    print "t=\{k * 2}"
}

main: function is {
    p: pt
    q: 4.u64
    print "k=\{p.k} q=\{q}"
    show
}
