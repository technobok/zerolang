# A scan that consumes its hit and returns: every path after the move leaves
# the function, so the loop never sees the moved name again.
eats: function {s: String.take} out bool is {
    return s.length > 0
}
scan: function {hit: u64} out u64 is {
    s: "abc".string
    n: 0.u64
    for while n < 5 loop {
        n = n + 1
        if n == hit then {
            if (eats s: s) then print "hit at \{n}"
            return n
        }
    }
    return 0
}
main: function is {
    print "\{scan hit: 3}"
    print "\{scan hit: 9}"
}
