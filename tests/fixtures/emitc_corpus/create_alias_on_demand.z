# A record's or a class's `#define <T>_create <T>_meta_create` is written only
# where written C calls `<T>_create`: a generator's state is built by its own
# create, which calls `_meta_create` itself, and `Point` by its fields.
Steps: generator { n: i64 } as {
    call: function out i64 is {
        i: 0
        for i < this.n loop {
            yield i
            i = i + 1
        }
    }
}

Point: record {
    x: i64
    y: i64
}

main: function is {
    s: i64
    for each v: (Steps n: 4) loop s = s + v
    p: Point x: 2 y: 3
    print "\{s} \{p.x + p.y}"
}
