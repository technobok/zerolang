# A generator yields any value that converts to its `out` type without loss:
# an i32, a literal and a u8 into an i64 come out as i64s. A function may
# return a `never` value, such as a panic, where it declares an i64.
Widen: generator as {
    call: function out i64 is {
        a: 7.i32
        yield a
        yield 3
        b: 2.u8
        yield b
    }
}

nev: function {b: bool} out i64 is {
    if b then return 5
    return (panic msg: "never")
}

main: function is {
    for each v: Widen loop print "\{v}"
    print "\{nev b: true}"
}
