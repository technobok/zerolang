# own_method_names_private_arm -- inside a type's own method a match may name an arm the
# type's `public:` block does not list.
shape: variant { circleArm: i64 boxArm: i64 } as {
    public: unit { :circleArm :mk :area }
    mk: function {n: i64} out shape is {
        return (shape.boxArm n)
    }
    area: function {s: this.view} out i64 is {
        match (
            s
        ) case circleArm then {
            return s * 3
        } case boxArm then {
            return s * 4
        }
    }
}

main: function is {
    s: shape.mk n: 5
    print "area \{s.area}"
    match (
        s
    ) case circleArm then {
        print "circle \{s}"
    } else {
        print "other"
    }
}
