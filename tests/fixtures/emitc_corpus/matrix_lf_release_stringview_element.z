    xs.append "abc def".string
    r: 0
    v: (xs.get i: 0).stringView
    n: 0
    for n > 0 loop {
        n = n - 1
    } while (with z: 0 do {
        v = "init"
        xs.set i: 0 val: "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz".string
        true
    })
    return 7
}

lfStringviewWhilepostElementWithinReassignT: function out i64 is {
    xs: List String
    xs.append "abc def".string
    r: 0
    v: (xs.get i: 0).stringView
    n: 0
    for n > 0 loop {
        n = n - 1
    } while (with z: 0 do {
        r = r + (if (v.startsWith prefix: "abc") then 7 else 0)
        v = "init"
        xs.set i: 0 val: "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz".string
        true
    })
    return 7
}

