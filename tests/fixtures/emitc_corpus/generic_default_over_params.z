# A generic parameter's default may be an instance over the declaration's
# other parameters: `u` defaults to `(Wrap t: t)`, so each instance's `u` is
# its own `t` wrapped -- those parameters bound first, then the default
# specialised with them (defaultOverParams).
Wrap: record {
    v: t
} as {
    t: anyval.generic
}

Outer: record {
    a: t
    w: u
} as {
    t: (anyval.generic default: i64)
    u: (anyval.generic default: (Wrap t: t))
}

main: function is {
    o: (Outer t: u8) a: 3 w: (Wrap t: u8 v: 4)
    print "\{o.a} \{o.w.v}"
    p: Outer a: 5 w: (Wrap t: i64 v: 6)
    print "\{p.a} \{p.w.v}"
}
