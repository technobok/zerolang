# match_never_arms_are_no_return -- A match whose arms all call a function that never
# returns is no `return`: the arm of the `if` around it still leaves by the `return`
# after it, so what that arm moved out is not consumed for the code after the `if`.
kind: variant {
    a: null
    b: null
}

pick: function {k: bool} out kind is {
    if k then return kind.a
    return kind.b
}

die: function {n: i64} out never is {
    panic msg: "die \{n}"
}

keep: function {s: String.take} out u64 is {
    return s.length
}

f: function {c: bool} out u64 is {
    s: "abc".string
    if c then {
        match (pick k: c) case a then die n: 1 case b then die n: 2
        n: keep s: s.take
        return n
    }
    return s.length + 10
}

main: function is {
    print "\{f c: false}"
}
