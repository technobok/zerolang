# iter_call_result.z -- `with x: (call).iterate do for e: x loop` iterates a
# value the call returns. The receiver is not an lvalue, so building the
# iterator expression hoists it to an _ahN temp; the binding must declare that
# temp before the line that reads it.

mk: function {} out List String is {
    r: (List String)
    r.append from: "alpha".string
    r.append from: "beta".string
    return r
}

main: function is {
    with it: (mk).iterate do for e: it loop {
        print e
    }
}
