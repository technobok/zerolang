# getmut_writes_in_place.z -- the writable readers: `getMut` on every Map form
# and on IdMapR, and `iterateMut` over ListRef and ListVal, stepped by hand and
# driven by a `for`. Each hands back an OptionMut (or OptionMutVal), whose
# `some` is written in place; a later `get` reads the write back.

Box: class {
    # the value written
    n: i64
}

pt: record {
    # the coordinate written
    x: i64
}

main: function is {
    rr: (Map String V: Box)
    rr.set key: "a".string value: (Box n: 1)
    {
        g: rr.getMut key: "a".string
        match (g) case some then g.n = 11 case none then null
    }
    {
        g: rr.getMut key: "zz".string
        match (g) case some then print "rr miss is some" case none then print "rr miss is none"
    }
    r1: rr.get key: "a".string
    match (r1) case some then print "MapRR \{r1.n}" case none then null

    rv: (MapRV String v: pt)
    rv.set key: "a".string value: (pt x: 2)
    {
        g: rv.getMut key: "a".string
        match (g) case some then g.x = 22 case none then null
    }
    r2: rv.get key: "a".string
    match (r2) case some then print "MapRV \{r2.x}" case none then null

    vr: (MapVR u32 V: Box)
    vr.set key: 7 value: (Box n: 3)
    {
        g: vr.getMut key: 7
        match (g) case some then g.n = 33 case none then null
    }
    r3: vr.get key: 7
    match (r3) case some then print "MapVR \{r3.n}" case none then null

    vv: (MapVV u32 v: pt)
    vv.set key: 7 value: (pt x: 4)
    {
        g: vv.getMut key: 7
        match (g) case some then g.x = 44 case none then null
    }
    r4: vv.get key: 7
    match (r4) case some then print "MapVV \{r4.x}" case none then null

    ids: (IdMapR u64 V: Box)
    ids.set key: 3 value: (Box n: 5)
    {
        g: ids.getMut key: 3
        match (g) case some then g.n = 55 case none then null
    }
    r5: ids.get key: 3
    match (r5) case some then print "IdMapR \{r5.n}" case none then null

    xs: List Box
    xs.append (Box n: 1)
    xs.append (Box n: 2)
    {
        it: xs.iterateMut
        e: it.call
        match (e) case some then e.n = 60 case none then null
    }
    for each b: xs.iterateMut loop {
        b.n = b.n + 1
    }
    for each b: xs loop print "ListRef \{b.n}"

    ps: ListVal pt
    ps.append (pt x: 1)
    ps.append (pt x: 2)
    {
        it: ps.iterateMut
        e: it.call
        match (e) case some then e.x = 70 case none then null
    }
    for each p: ps.iterateMut loop {
        p.x = p.x + 1
    }
    for each p: ps loop print "ListVal \{p.x}"
}
