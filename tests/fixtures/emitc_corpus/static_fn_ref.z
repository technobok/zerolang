# static_fn_ref.z -- a function reference in a static position is the
# function's bare name, or its name through a unit: a data field declared by a
# spec or by a written-out signature takes one of that signature, a field
# declared by a function's name defaults to that function, and a choice arm
# carries one. Two references are equal when they name one function, folded or
# at run time. A value read at run time calls the function its field holds --
# by its name when the value folded -- and a field whose function takes no
# argument is called by reading it; the functions a static value holds are
# emitted though no body names them.
binop: function {a: i64 b: i64} out i64
add: function {a: i64 b: i64} out i64 is { return a + b }
mul: function {a: i64 b: i64} out i64 is { return a * b }

util: unit {
    sub: function {a: i64 b: i64} out i64 is { return a - b }
}

op: data {
    name: text
    f: binop
    g: add
}

tick: function out i64
one: function out i64 is { return 1 }
two: function out i64 is { return 2 }

clock: data {
    t: tick
}

step: data {
    run: function {x: i64} out i64
}
twice: function {x: i64} out i64 is { return x * 2 }
dbl: (step run: twice)

c1: (clock t: one)
c2: (clock t: two)
clocks: list { c1 c2 }

hook: choice {
    none: null
    run: binop
}

plus: (op name: "plus" f: add)
times: (op name: "times" f: mul g: mul)
minus: (op name: "minus" f: util.sub)
plus2: (op name: "plus" f: add)
h: (hook.run mul)
ops: list { plus times minus }
same: plus == plus2
diff: plus == times

apply: function {o: op x: i64} out i64 is {
    return (o.f a: x b: 2)
}

main: function is {
    print "\{plus.g a: 4 b: 5} \{same} \{diff} \{minus.f a: 9 b: 4}"
    for each o: ops loop print "\{o.name.stringView} \{apply :o x: 3} \{o.g a: 1 b: 1}"
    hh: h
    match (hh) case run then print "\{hh a: 6 b: 7}" case none then print "none"
    a: plus
    b: plus2
    print "\{a == b} \{a == times}"
    print "\{c1.t} \{c2.t}"
    for each c: clocks loop print "\{c.t}"
    print "\{dbl.run 4}"
}
