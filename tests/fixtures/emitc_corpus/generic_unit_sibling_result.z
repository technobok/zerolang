# generic_unit_sibling_result -- inside a generic unit, a call to a sibling
# function is typed by the instance's copy of it: its result, of the unit's
# parameter type, binds, interpolates and passes on as that instance's type.
public: unit {
    :main
}

# wrap -- a value of any type, kept and shown
wrap: unit as {
    t: anyval.generic
    # keep -- the value as given
    keep: function {v: t} out t is {
        return v
    }
    # show -- the value through `keep`: bound, interpolated and passed on
    show: function {v: t} out t is {
        k: keep :v
        print "bound \{k} direct \{keep :v}"
        return (keep v: (keep :v))
    }
}
wi: (wrap t: i64)
wf: (wrap t: f64)

main: function is {
    print "i64 \{wi.show v: 3}"
    print "f64 \{wf.show v: 1.5}"
}
