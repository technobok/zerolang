# A NON-OWNED SHADOW INSIDE AN `if` ARM LEAVES THE OUTER LOCAL LIVE. Arm take
# tracking asked which owned locals were live by NAME, and a shadow of the name
# answered for it: an `o: 5` in a then arm, an else arm, a nested `if`, an
# `else if`, both arms, an arm of a narrowing `if` or an `if` inside a loop made
# the outer String read as moved after the `if` (or "inside a loop").
Box: class {
    v: String
}

Val: union {
    text: String
    none: null
}

main: function is {
    c: 3 > 2
    o: "x".string
    if c then {
        o: 5
        print "then \{o}"
    }
    if c.not then {
        print "a"
    } else {
        o: "y"
        print "else \{o}"
    }
    if c then {
        if c then {
            o: 6
            print "nested \{o}"
        }
    }
    if c.not then {
        print "b"
    } else if c then {
        o: 7
        print "else if \{o}"
    }
    b: Box v: "boxed".string
    if c then {
        b: "sv"
        print "both \{b}"
    } else {
        b: 9
        print "both \{b}"
    }
    for i: 2.iterate loop {
        if c then {
            o: i
            print "loop \{o}"
        }
    }
    u: Val.text "u".string
    if u.text then {
        if c then {
            u: 8
            print "narrowed \{u}"
        }
        print "narrowed \{u}"
    }
    print "\{o} \{b.v}"
}
