# A CONTAINER CONSTRUCTED IN VALUE POSITION IS ITS OWN VALUE, whatever holds it
# next. A Map or Set built inline as an argument, or read straight off the call
# that returns one, was hoisted into a temporary typed as the struct rather than
# the pointer a Map or Set is held through. An explicit `.create` read without
# arguments built no capacity for a map, a set or an id container, and a sized
# array or str was handed its size as an argument its create does not take.
capacityOf: function {m: (MapVV k: i64 v: i64)} out u64 is {
    return m.capacity
}

keys: function out (SetVal k: i64) is {
    s: SetVal k: i64
    s.add item: 7
    return s
}

main: function is {
    print "\{capacityOf m: ((MapVV k: i64 v: i64) capacity: 8)} \{capacityOf m: ((MapVV k: i64 v: i64).create capacity: 8)}"
    print "\{keys.length} \{(IdSet k: u32).create.length} \{(MapRV K: String v: i64).create.length}"
    a: (array t: i64 to: 4).create
    s: (str to: 8).create
    xs: ListVal i64
    xs = (ListVal t: i64).create capacity: 9
    print "\{a.length} \{s.size} \{xs.capacity}"
}
