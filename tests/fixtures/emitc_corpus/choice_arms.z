# choice_arms.z -- a choice whose arms carry nothing is static, as a data type
# is, and used as a variant is: an arm is read by name in a body, tested by its
# predicate, matched, compared, held in a ListVal and a data field, and passed.
mode: choice {
    fast: null
    slow: null
    off: null
}

setting: data {
    m: mode.slow
    level: 1.u8
}

quick: (setting m: mode.fast level: 3)
calm: setting.create

name: function {m: mode} out StringView is {
    match (m) case fast then return "fast" case slow then return "slow" case off then return "off"
}

main: function is {
    m: mode.off
    if m.off then print "off"
    print "\{name m: quick.m} \{name m: calm.m} \{name :m}"
    print "\{quick.m == mode.fast} \{calm.m == quick.m} \{m != mode.slow}"
    ms: ListVal mode
    ms.append mode.slow
    ms.append quick.m
    for each e: ms loop print (name m: e)
}
