# variant_method_match_this.z -- a valtype variant's method narrows `this`:
# the match arm and the arm test both read the PAYLOAD. The receiver arrives
# by pointer, and the arm's shadow of it is a value; a read that still
# dereferenced it was C the compiler rejected.
opt3: variant {
    none: null
    some: u64
} as {
    or: function {:this d: u64} out u64 is {
        match (
            this
        ) case some then {
            return this
        } case none then {
            return d
        }
    }
    orIf: function {:this d: u64} out u64 is {
        if this.some then return this
        return d
    }
}
main: function is {
    a: opt3.some 7.u64
    b: opt3.none
    print "\{a.or d: 1} \{b.or d: 1} \{a.orIf d: 2} \{b.orIf d: 2}"
}
