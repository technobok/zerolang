# typedef_user_string_zero.z -- a program's own `String` is not the system's.
# A typedef over it is that record's zero; it used to be the system String's
# empty value, because the zero was chosen by the base's NAME.
String: record {
    n: 5
}

name: typedef String

main: function is {
    x: name
    print "n=\{x.n}"
}
