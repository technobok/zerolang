# A CONTAINER'S `length` AND `capacity` ARE METHODS -- `str` adds `size` -- and
# every family reads them the same way from every receiver: a local, a borrow,
# a view parameter, `this`, a field path, and the value a call returns. Each is
# a u64, so each goes into a u64 slot without conversion.
holder: class {
    xs: ListVal i64
    names: ListRef String
    m: (MapVV k: i64 v: i64)
    ids: (IdSet u32)
    total: function {:this} out u64 is {
        return (this.xs.length + this.xs.capacity) + (this.names.length + this.m.length)
    }
}

viewTotal: function {v: (ListVal i64)} out u64 is {
    return v.length + v.capacity
}

mk: function out holder is {
    h: holder xs: (ListVal i64) names: (ListRef String) m: (MapVV k: i64 v: i64) ids: (IdSet u32)
    h.xs.append 7
    h.ids.add item: 3
    return h
}

main: function is {
    xs: ListVal i64
    xs.append 1
    xs.append 2
    rs: ListRef String
    rs.append "r".string
    rr: (MapRR K: String V: String)
    rv: (MapRV K: String v: i64)
    vr: (MapVR k: i64 V: String)
    vv: (MapVV k: i64 v: i64)
    vv.set key: 1 value: 10
    sr: (SetRef K: String)
    sv: (SetVal k: i64)
    sv.add item: 4
    imr: (IdMapR k: u32 V: String)
    imv: (IdMapV k: u32 v: i64)
    ims: (IdSet u32)
    arr: (array t: i64 to: 4)
    raw: (str to: 8)
    s: "abc".string
    {
        lv: xs.listView
        print "view \{lv.length}"
    }
    print "\{xs.length} \{rs.length} \{rr.length} \{rv.length} \{vr.length} \{vv.length}"
    print "\{sr.length} \{sv.length} \{imr.length} \{imv.length} \{ims.length} \{arr.length} \{raw.length} \{s.length}"
    caps: xs.capacity + rs.capacity + rr.capacity + rv.capacity + vr.capacity + vv.capacity
    caps2: sr.capacity + sv.capacity + imr.capacity + imv.capacity + ims.capacity + raw.size
    print "\{caps > 0} \{caps2 > 0}"
    w: 0.u64
    w = arr.length
    w = raw.size
    b: xs.borrow
    print "\{b.length} \{viewTotal v: xs} \{w}"
    h: mk
    print "\{h.xs.length} \{h.ids.length} \{h.total} \{h.m.capacity > 0}"
    print "\{(mk).xs.length} \{(mk).ids.capacity > 0}"
}
