# default_string_constant.z -- a field and a parameter defaulted to a unit
# string constant: each is a StringView default, filled from the constant's
# static bytes wherever it is left out, and overridden like any default.
GREETING: "hi"

Box: class {
    s: GREETING
}

greet: function {s: GREETING} is {
    print "\{s}"
}

main: function is {
    b: Box
    print "box=\{b.s}"
    c: Box s: "yo"
    print "box=\{c.s}"
    greet
    greet s: "hey"
}
