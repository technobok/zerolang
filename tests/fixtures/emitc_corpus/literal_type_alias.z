# A unit-level alias may name a literal type. `core` re-exports `intliteral` and
# `floatliteral`, so the alias binds the REAL type (registry rows 1 and 2)
# rather than a shell that merely shares the spelling.
#
# The usability is deliberately thin: `create: null` means nothing constructs
# one, so the alias names a type a program can refer to but not make -- which is
# the point, since a literal's type is what the checker gives a lexeme. A body
# binding that names it bare is refused by the general non-constructible rule;
# errors/literal_type_annotation pins that side.
lit: intliteral
flit: floatliteral

main: function is {
    # the literals themselves still behave exactly as before the alias existed
    a: 65.u8
    b: 2.5.f32
    print "a=\{a} b=\{b}"
}
