# float_functions.z -- the everyday float functions, methods on f32 and f64,
# against values computed exactly and rounded once to each width. An exact
# operation -- sqrt, fma, the roundings, abs, copySign, min, max -- must match
# to the bit; a transcendental one may be off by the ulp the platform's libm
# allows, and no more. The same golden is checked under every C compiler.

# a bit pattern turned into a position on the number line, so the distance
# between two positions is how many values lie between: the negatives count
# down from the middle, the positives up, and -0 and 0 meet there
ordered64: function {b: u64} out u64 is {
    mag: b & 9223372036854775807
    if (b >> 63) == 1 then return 9223372036854775808.u64 - mag
    return mag + 9223372036854775808
}

# the f32 positions, as ordered64 gives f64's
ordered32: function {b: u32} out u32 is {
    mag: b & 2147483647
    if (b >> 31) == 1 then return 2147483648.u32 - mag
    return mag + 2147483648
}

# `ok`, or the bits got and wanted and how many values apart they are
check64: function {name: StringView got: f64 want: u64 tol: u64} is {
    x: ordered64 b: got.bits
    y: ordered64 b: want
    gap: 0.u64
    if x >= y then gap = x - y else gap = y - x
    if gap <= tol then {
        print "\{name} ok"
    } else {
        print "\{name} MISMATCH \{got.bits} \{want} \{gap} ulps"
    }
}

# check64 at f32
check32: function {name: StringView got: f32 want: u32 tol: u32} is {
    x: ordered32 b: got.bits
    y: ordered32 b: want
    gap: 0.u32
    if x >= y then gap = x - y else gap = y - x
    if gap <= tol then {
        print "\{name} ok"
    } else {
        print "\{name} MISMATCH \{got.bits} \{want} \{gap} ulps"
    }
}

# the values no table row can be: the NaN, the infinities and the two zeros,
# through every predicate, and the functions that must answer them exactly
specials64: function is {
    nan: (0.0 - 1.0).sqrt
    inf: 1.0.scaleB n: 2000
    ninf: 0.0 - inf
    nz: -0.0
    print "f64 isNaN \{nan.isNaN} \{inf.isNaN} \{nz.isNaN} \{1.0.isNaN}"
    print "f64 isInf \{nan.isInf} \{inf.isInf} \{ninf.isInf} \{1.0.isInf}"
    print "f64 isFinite \{nan.isFinite} \{inf.isFinite} \{nz.isFinite} \{1.0.isFinite}"
    print "f64 signBit \{nz.signBit} \{0.0.signBit} \{ninf.signBit} \{(0.0 - 2.0).signBit}"
    print "f64 log 0 \{0.0.log.isInf} \{0.0.log.signBit}, log -1 \{(0.0 - 1.0).log.isNaN}"
    print "f64 sqrt -0 \{nz.sqrt.signBit}, abs -0 \{nz.abs.signBit}, copySign \{(1.0.copySign y: nz).signBit}"
    print "f64 min nan \{(nan.min y: 1.0) == 1.0} max nan \{(1.0.max y: nan) == 1.0}"
    print "f64 exp -inf \{ninf.exp == 0.0}, atan inf \{(inf.atan * 2.0) == (1.0.atan * 4.0)}"
    # the product rounds to 1, where fma keeps the -2^-104 it was below 1 by
    e: 1.0.scaleB n: (0 - 52)
    a: 1.0 + e
    b: 1.0 - e
    print "f64 fma \{(a.fma y: b z: (0.0 - 1.0)) == (0.0 - (1.0.scaleB n: (0 - 104)))} product \{((a * b) - 1.0) == 0.0}"
}

# specials64 at f32
specials32: function is {
    nan: (0.0.f32 - 1.0.f32).sqrt
    inf: 1.0.f32.scaleB n: 200
    ninf: 0.0.f32 - inf
    nz: -0.0.f32
    print "f32 isNaN \{nan.isNaN} \{inf.isNaN} \{nz.isNaN} \{1.0.f32.isNaN}"
    print "f32 isInf \{nan.isInf} \{inf.isInf} \{ninf.isInf} \{1.0.f32.isInf}"
    print "f32 isFinite \{nan.isFinite} \{inf.isFinite} \{nz.isFinite} \{1.0.f32.isFinite}"
    print "f32 signBit \{nz.signBit} \{0.0.f32.signBit} \{ninf.signBit} \{(0.0.f32 - 2.0.f32).signBit}"
    print "f32 min nan \{(nan.min y: 1.0.f32) == 1.0.f32} max nan \{(1.0.f32.max y: nan) == 1.0.f32}"
    e: 1.0.f32.scaleB n: (0 - 23)
    a: 1.0.f32 + e
    b: 1.0.f32 - e
    print "f32 fma \{(a.fma y: b z: (0.0.f32 - 1.0.f32)) == (0.0.f32 - (1.0.f32.scaleB n: (0 - 46)))} product \{((a * b) - 1.0.f32) == 0.0.f32}"
}

