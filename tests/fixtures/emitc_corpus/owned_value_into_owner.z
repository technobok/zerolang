# What a reassignment, a taking argument or a constructor field is given owns
# its storage: a copy, a call's result, a fresh value. A field is borrowed from
# its owner and never moves out, so it goes in as a copy.
Holder: class {
    p: String
    q: String
}

Box2: class {
    s: String
}

keep: function {s: String.take} out u64 is {
    return s.length
}

mk: function {} out String is {
    return "made".string
}

main: function is {
    h: Holder p: "hp".string q: "hq".string
    l: List String
    l.append from: "e0".string
    r: "init".string
    r = h.p.copy
    print r
    r = mk
    print r
    r = (l.get i: 0).copy
    print r
    h.q = h.p.copy
    print "\{h.q} \{keep s: (l.get i: 0).copy} \{keep s: h.p.copy} '\{h.p}'"
    r = h.q.copy
    b: Box2 s: r.take
    print "\{b.s} '\{h.q}'"
    h.p = "new".string
    print h.p
}
