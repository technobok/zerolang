# const_fold_integer_operators.z -- every integer operator folds over constant
# operands, at unit level and in a body: `%` (the sign is the dividend's, as
# C's), `&`, `|`, `^`, `<<`, `>>` and `not`. A typed operand folds in its own
# width, as the runtime computes it: a shift by the width or more shifts
# everything out -- 0, or the sign for a signed `>>` -- and a left shift keeps
# the low bits. Each line below prints the folded value beside the same
# operator over variables. `1 << 3` at unit level was "has no compile-time
# value".
REM: 17 % 5
NEGREM: (0 - 17) % 5
AND: 12 & 10
OR: 12 | 3
XOR: 12 ^ 10
SHL: 1 << 3
SAR: (0 - 16) >> 2
NOT: 5.i64.not
OUT: 1 << 64
TOP: 1 << 63
FLAGS: (1 << 4) | (1 << 1)

main: function is {
    print "\{REM} \{NEGREM} \{AND} \{OR} \{XOR} \{SHL} \{SAR} \{NOT} \{OUT} \{TOP} \{FLAGS}"
    a: 1.u8
    s7: 7.u8
    s8: 8.u8
    print "\{1.u8 << 7} \{a << s7} | \{1.u8 << 8} \{a << s8}"
    m: (0 - 128).i8
    one: 1.i8
    nine: 9.i8
    print "\{(0 - 128).i8 >> 1} \{m >> one} | \{(0 - 128).i8 >> 9} \{m >> nine}"
    z: 0.u8
    print "\{0.u8.not} \{z.not} | \{5.u16.not} \{0.i32.not}"
    n: 0 - 7
    t: 3
    print "\{(0 - 7) % 3} \{n % t} | \{200.u8 % 7.u8} \{0xF0.u8 | 0x0F.u8} \{0xFF.u8 ^ 0x0F.u8}"
    print "\{1.u32 << 31} \{1.i32 << 31} \{3.u64 << 2} \{1.u64 << 63}"
}
