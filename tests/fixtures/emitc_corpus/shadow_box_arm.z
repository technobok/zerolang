# shadow_box_arm.z -- a user class named Box is no builtin Box. Only the
# builtin's `(Box T)` arm collapses to T, so the arm is resolved where it is
# written: the user's Box is an ordinary parameterized arm holding the class,
# and its payload reads the class's field.

Box: class {
    v: t
} as { t: anyval.generic }

Tree: union {
    leaf: i64
    node: Box i64
}

main: function is {
    t: Tree.node (Box v: 5)
    match (
        t
    ) case leaf then print "leaf" case node then print "node v=\{t.v}"
}
