# An untyped float folds exactly and is rounded once, where it lands: in an f128
# argument or field as in an assignment, at f128's own precision -- never
# through f64's 53 bits. The f32 landings are float_constant_lands_once's.
q: function {v: f128} out f128 is {
    return v
}

r: record {
    a: f128
}

main: function is {
    w: (1.0 / 3.0).f128
    x: r a: (1.0 / 3.0)
    b: f128
    b = (1.0 / 3.0)
    print "\{(q v: (1.0 / 3.0)) == w} \{x.a == w} \{b == w} \{(q v: 0.33333333333333333333333333333333333) == w}"
}
