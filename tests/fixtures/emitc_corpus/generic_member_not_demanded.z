# An instance of a generic type checks the methods the program uses, one at a
# time, and no other: `audit` is wrong for every instance and nothing calls it,
# so neither instance walks it. A method only another method calls is used, and
# so is one the program reaches after the instance was first walked.
Box: class {
    v: t
} as {
    t: anyval.generic
    # the value
    get: function {:this} out t is {
        return this.v
    }
    # the value, through get
    twice: function {:this} out t is {
        return this.get
    }
    # never called: no member `missing`
    audit: function {:this} out t is {
        return this.missing
    }
}

main: function is {
    a: (Box t: i64) v: 4
    b: (Box t: u8) v: 7
    print "\{a.twice} \{b.get}"
}
