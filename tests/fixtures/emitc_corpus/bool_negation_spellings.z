# Every spelling of a negated or affirmed condition the compiler supports, so
# that none of them regresses while `.not` is the idiom the tree writes. The
# `.true` / `.false` suffixes are the arm predicates every 2-arm sum has;
# `== true` / `== false` / `!= true` / `!= false` compare with the literal;
# `.not` is bool's negation method. On an arm predicate the negated forms flip
# which side narrows: the else branch holds the arm and reads the payload.
kind: variant {
    a: i64
    b: null
}

maybe: variant {
    none: null
    some: i64
}

main: function is {
    b0: true
    b1: false
    # a bool local, every spelling
    if b0.not then print "wrong" else print "b0.not"
    if b1.not then print "b1.not"
    if b0.false then print "wrong" else print "b0.false"
    if b0.true then print "b0.true"
    if b0 == false then print "wrong" else print "b0 == false"
    if b0 == true then print "b0 == true"
    if b0 != true then print "wrong" else print "b0 != true"
    if b1 != false then print "wrong" else print "b1 != false"
    if b1 != true then print "b1 != true"
    if b1 == false then print "b1 == false"
    # an arm predicate with a payload: the negated forms narrow the else side
    k: kind.a 7
    if k.a.not then print "wrong" else print "not: \{k}"
    if k.a.false then print "wrong" else print "false: \{k}"
    if (k.a) == false then print "wrong" else print "== false: \{k}"
    if k.a.true then print "true: \{k}"
    if (k.a) == true then print "== true: \{k}"
    if k.a then print "bare: \{k}"
    # the else-if chain: an excluded arm collapses what remains
    k2: kind.b
    if k2.a.not then print "k2 is not a" else print "wrong"
    if k2.a then print "wrong" else if k2.b then print "k2 is b"
    # an option-shaped pair
    o: maybe.some 5
    if o.some.not then print "wrong" else print "some: \{o}"
    if o.none.not then print "not none: \{o}"
    if o.none.false then print "none.false: \{o}"
    if (o.none) == false then print "none == false: \{o}"
    o2: maybe.none
    if o2.some.not then print "o2 none" else print "wrong"
    if o2.some == false then print "o2 some == false" else print "wrong"
}
