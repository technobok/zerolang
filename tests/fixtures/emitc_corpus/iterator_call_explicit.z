# iterator_call_explicit.z -- an iterator's `call`, written out, calls the same
# C function the `for each` walk calls.
#
# A native iterator's `call` has no body: its template writes it as
# `{type}_call`. The walk spelled it that way, while an explicit `it.call` was
# spelled as any other method, by its own id -- a symbol nothing defines, so
# `zc` exited 0 and the C compiler refused the call. Every native family is
# driven here by hand, from a binding, a nested (field) receiver and a match
# subject; the bodied ones (an integer range, a generator) beside them.

Count: generator { n: i64 } as {
    call: function out i64 is {
        for each x: this.n.times loop yield x
    }
}

Holder: class {
    xs: ListVal i64
}

main: function is {
    xs: ListVal i64
    xs.append 5
    xs.append 6
    with it: xs.iterate do {
        a: it.call
        match a case some then print "list \{a}" case none then print "list none"
    }
    with rt: xs.iterateReverse do {
        match rt.call case some then print "reverse" case none then print "reverse none"
    }
    ls: List String
    ls.append "s".string
    with lt: ls.iterate do {
        b: lt.call
        match b case some then print "listref \{b}" case none then print "listref none"
    }
    h: Holder xs: xs.copy
    with ht: h.xs.iterate do {
        c: ht.call
        match c case some then print "field \{c}" case none then print "field none"
    }
    m: MapVV i64 v: i64
    m.set key: 1 value: 10
    with mk: m.iterate do {
        d: mk.call
        match d case some then print "mapkey \{d}" case none then print "mapkey none"
    }
    with mi: m.iterateItems do {
        e: mi.call
        match e case some then print "mapitem" case none then print "mapitem none"
    }
    s: SetVal i64
    s.add item: 3
    with si: s.iterate do {
        f: si.call
        match f case some then print "set \{f}" case none then print "set none"
    }
    sv: "ab"
    with cp: sv.codepoints do {
        g: cp.call
        match g case some then print "codepoint" case none then print "codepoint none"
    }
    with rg: 2.times do {
        r: rg.call
        match r case some then print "range \{r}" case none then print "range none"
    }
    with gn: (Count n: 2) do {
        q: gn.call
        match q case some then print "generator \{q}" case none then print "generator none"
    }
}
