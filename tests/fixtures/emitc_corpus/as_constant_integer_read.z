# A TYPE'S INTEGER `as` CONSTANT read in an interpolation, on a record and on a
# class. Every other read of an `as` constant is as_constants.
config: record {
    x: i64
} as {
    max_val: 100
}

Holder: class {
    n: i64
} as {
    CAP: 8
}

main: function is {
    print "\{config.max_val} \{Holder.CAP}"
}
