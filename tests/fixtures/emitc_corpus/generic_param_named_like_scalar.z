# A generic parameter may be named like a scalar. Every position of the
# signature and the body finds the nearest declaration -- the parameter, not
# the scalar it shadows -- so `ident` returns what it is given, of whatever
# type the call binds.
ident: function as { u8: anyval.generic } in {x: u8} out u8 is {
    return x
}

twice: function as { i64: anyval.generic } in {a: i64 b: i64} out i64 is {
    return b
}

pick: function as { f32: anyval.generic } in {c: bool v: f32 w: f32} out f32 is {
    if c then return v
    return w
}

same: function as { bool: anyval.generic } in {v: bool} out bool is {
    return v
}

main: function is {
    print "\{ident x: 300} \{twice a: 1.5 b: 2.5} \{pick c: false v: 7 w: 9} \{same v: 12}"
}
