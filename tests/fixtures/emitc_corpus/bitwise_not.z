# `not` is the bitwise complement. zerolang has NO unary operators -- `-a` is
# not an expression, and a negative literal is the only leading-minus form --
# so the complement is a named method on the receiver rather than a `~`.
main: function is {
    a: 12.u64
    print "u64 not 12: \{a.not}"
    b: 0.u64
    print "u64 not 0: \{b.not}"

    c: 12.u8
    print "u8 not 12: \{c.not}"
    d: 0.u8
    print "u8 not 0: \{d.not}"

    e: 12.u16
    print "u16 not 12: \{e.not}"
    f: 12.u32
    print "u32 not 12: \{f.not}"

    # on a signed type the complement is the value's negation minus one
    g: 12.i64
    print "i64 not 12: \{g.not}"
    h: (0.i64 - 1.i64)
    print "i64 not -1: \{h.not}"
    i: 0.i32
    print "i32 not 0: \{i.not}"

    # complement is its own inverse
    print "round trip: \{a.not.not}"

    # the character types carry it too, because they carry the bitwise set
    j: 12.c8
    print "c8 not 12: \{j.not}"

    # de Morgan, as an algebraic pin over the whole set
    p: 12.u8
    q: 10.u8
    print "de morgan: \{(p & q).not} \{p.not | q.not}"
}
