# data_methods.z -- a data type's methods take `{:this}`, the handle: called on a
# unit constant and on a local, with and without arguments, and from each other.
row: data {
    key: "k".text
    n: 5
} as {
    doubled: function {:this} out i64 is { return this.n * 2 }
    label: function {:this} out String is {
        s: this.key.string
        s.append "!"
        return s
    }
    bump: function {:this by: i64} out i64 is { return this.n + by }
    twice: function {:this} out i64 is { return (this.bump by: this.n) }
}
a: (row key: "alpha" n: 4)

main: function is {
    print "\{a.doubled} \{a.bump by: 10} \{a.twice}"
    print a.label
    p: a
    print "\{p.doubled} \{p.bump by: 1} \{p.twice}"
}
