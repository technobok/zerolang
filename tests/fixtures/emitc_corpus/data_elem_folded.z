# data_elem_folded.z -- a data element is any compile-time constant: an
# expression, a unit constant, another block's element, each folded where the
# block is declared and emitted as its value. A label, an ordinal, a constant
# `.index` and a run-time `.index` all read the folded value.
KB: 1024
base: data { 7 9 }

sizes: data {
    small: (KB / 2)
    page: (KB * 4)
    big: (KB * KB)
} out u32

mixed: data { (KB + 4) KB base.1 (0 - 3) }

halves: data { 0.5 (1.0 / 4.0) }

main: function is {
    print "small=\{sizes.small} page=\{sizes.page} big=\{sizes.big}"
    print "m0=\{mixed.0} m2=\{mixed.index 2} m3=\{mixed.3}"
    i: 0.u64
    for i < mixed.length loop {
        print "mixed \{i} = \{mixed.index i}"
        i = i + 1
    }
    j: 1.u64
    print "h1=\{halves.index j} h0=\{halves.0}"
}
