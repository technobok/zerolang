# view_ternary_receiver.z -- an `if` value of a view type used as a method's
# receiver. The receiver is passed by address, and a C conditional is no
# lvalue: `&((c) ? (a) : (b))` is rejected by C, so the value is bound to a
# temp first, as a call's is. A compound literal, which also opens with `((`,
# already has an address.
pick: function {c: bool} out StringView is {
    a: "alpha"
    b: "beta"
    return ((if c then a else b).substring from: 1 to: 3)
}

main: function is {
    print "\{pick c: true} \{pick c: false}"
    a: "hello"
    b: "world"
    c: true
    n: (if c then a else b).length
    print "\{n}"
    s: (if c then a else b).substring from: 0 to: 2
    print "\{s}"
}
