# StringView.asString -- the borrowed-String projection -- probes String-keyed
# containers without materializing a key: Map get/has and Set has/delete accept
# `sv.asString` against their existing `key.view` / `of.view` signatures.
main: function is {
    m: (MapRV K: String v: i64)
    m.set key: "alpha".string value: 7
    m.set key: "beta".string value: 9

    line: "alpha,beta,gamma".string
    sv: line.substring from: 0.u64 to: 5.u64
    if (m.has key: sv.asString) then print "has alpha"
    g: m.get key: sv.asString
    match g case some then print "got \{g}" case none then print "none"
    missing: line.substring from: 11.u64 to: 16.u64
    if (m.has key: missing.asString) == false then print "no gamma"

    s: Set String
    s.add item: "beta".string
    s.add item: "gamma".string
    bv: line.substring from: 6.u64 to: 10.u64
    if (s.has item: bv.asString) then print "set has beta"
    gv: line.substring from: 11.u64 to: 16.u64
    if (s.delete item: gv.asString) then print "deleted gamma"
    print "set len=\{s.length}"
}
