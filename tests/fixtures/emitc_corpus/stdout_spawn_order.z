# A child's output lands after what the parent printed before spawning it,
# even when both go to a file: print reaches the OS at once, so nothing the
# parent wrote is still buffered when the child writes.
main: function is {
    args: os.args
    if args.length > 1 then {
        print "child"
        return
    }
    print "parent before"
    me: os.exePath
    match (me) case ok then {
        xs: List String
        xs.append me.copy
        xs.append "c".string
        rc: os.spawn argv: xs cwd: "" outPath: "" errPath: "" timeoutSecs: 10
        print "parent after \{rc}"
    } case err then print "no exe"
}
