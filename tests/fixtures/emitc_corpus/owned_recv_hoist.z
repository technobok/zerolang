# owned_recv_hoist.z -- a call returning an owned value, read through a member.
# The result is a TEMPORARY: emitting the call inline and reading `.length` off
# it dropped the only reference to its heap, in every position that reads one.
# The receiver is hoisted into a statement temp instead, and freed with it --
# per iteration inside a loop.
mk: function {n: i64} out String is {
    s: "xyz".string
    return s
}

want: function {n: u64} out u64 is {
    return n
}

main: function is {
    a: (mk n: 1).length
    b: want n: (mk n: 2).length
    c: 0
    if (mk n: 3).length > 0 then c = 1
    hits: 0
    i: 0
    for i < 3 loop {
        if (mk n: i).length > 0 then hits = hits + 1
        i = i + 1
    }
    print "a=\{a} b=\{b} c=\{c} hits=\{hits} d=\{(mk n: 4).length}"
}
