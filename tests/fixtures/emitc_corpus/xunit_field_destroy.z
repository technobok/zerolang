# xunit_field_destroy -- a class whose ONLY field is a class from another unit
# must be destroyed at scope exit like any other holder. The typechecker once
# asked whether a field needs cleanup by the type's bare NAME, which a dotted
# `unit.Type` is not visible under in this unit, so such a holder got no
# destructor registered and its field leaked; the resolved type answers by id.
# Runs under the leak kind: a leak here fails outright.
public: unit { :main }
PoolHolder: class { names: zast.StringPool }
AstHolder: class { ast: zast.Ast }
pooled: function out u64 is {
    h: (PoolHolder names: zast.StringPool.create)
    return h.names.length
}
treed: function out u64 is {
    h: (AstHolder ast: zast.Ast.create)
    return h.ast.names.length
}
main: function is {
    print "pool=\{pooled} ast>0=\{treed > 0}"
}
