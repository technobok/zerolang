# statement_if_arm_local_freed -- the last line of an arm of an `if` standing as a
# statement yields nothing: an owned local named there is not moved out, and is freed at
# the arm's end.
show: function {c: bool} is {
    if c then {
        t: "inner".string
        t.append "!"
        t
    } else {
        print "no"
    }
    print "after"
}

main: function is {
    show c: true
    show c: false
}
