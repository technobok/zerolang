# call_base_member_reads.z -- a member read or method call whose base is a
# zero-argument function reads what the function RETURNS. `(mkList).length`
# and `mkList.length` are one tree: a parenthesis records grouping, not a node,
# so the base is the bare function name either way, and it is a call, never a
# local to take the address of. Each line reads a different receiver family
# through a different emitter leg: a collection native, a user record's method
# and field, a class method and field, a StringView native with and without
# arguments, and an iterator.
Point: record {
    x: i64
    y: i64
    sum: function {:this} out i64 is {
        return this.x + this.y
    }
}

Box: class {
    label: String
    size: function {:this} out u64 is {
        return this.label.length
    }
}

mkList: function {} out List String is {
    r: (List String)
    r.append from: "alpha".string
    r.append from: "beta".string
    return r
}

mkVals: function {} out ListVal i64 is {
    r: ListVal i64
    r.append 4
    r.append 5
    return r
}

mkPoint: function {} out Point is {
    return (Point x: 2 y: 3)
}

mkBox: function {} out Box is {
    return (Box label: "four".string)
}

mkView: function {} out StringView is {
    return "view"
}

main: function is {
    print "list \{(mkList).length} vals \{(mkVals).length}"
    print "point \{(mkPoint).sum} \{(mkPoint).x}"
    print "box \{(mkBox).size} \{(mkBox).label}"
    print "view \{(mkView).length} \{(mkView).startsWith prefix: "vi"}"
    with it: (mkList).iterate do for e: it loop {
        print e
    }
}
