# narrow_write_arm_test.z -- a write THROUGH a subject narrowed by an arm test
# (`if s.one then { s.n = 22 }`), which reaches the payload exactly as the
# match-arm form does. The emitter used to read the body's `s.n = ...` as a
# rebind of `s` and seed no alias, so the write was emitted against the union
# and the C named a member the union does not have.
Pay: class {
    n: i64
}
Sum: union {
    one: Pay
    two: null
}
setViaMatch: function {s: Sum} is {
    match (
        s
    ) case one then {
        s.n = 11
    } else null
}
setViaIf: function {s: Sum} is {
    if s.one then {
        s.n = 22
    }
}
readOf: function {s: Sum.view} out i64 is {
    if s.one then return s.n
    return 0
}
main: function is {
    a: Sum.one (Pay n: 1)
    setViaMatch s: a
    print "\{readOf s: a}"
    setViaIf s: a
    print "\{readOf s: a}"
}
