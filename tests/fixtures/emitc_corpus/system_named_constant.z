# system_named_constant.z -- a program may name its own definitions as a unit
# is named: core's re-exports are read in core, so `text: system.text` still
# names the system unit's type while the program's `system` is a list of data
# values with text fields, being built.
row: data { key: text }
first: (row key: "first")
system: list { first (row key: "second") }

main: function is {
    print first.key.stringView
    for each r: system loop print r.key.stringView
}
