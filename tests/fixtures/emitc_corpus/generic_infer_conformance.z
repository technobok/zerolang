# generic_infer_conformance.z -- a generic parameter no argument names is
# inferred through another argument's conformance: `J: (Job R).generic` met by
# a Name declaring `job: (Job String)` binds R to String, for a reference result
# and a value one, and so does a lent `(Job R)` parameter. A generic function
# forwarding its own `J` conforms by J's bound, so the callee's R binds to the
# caller's.

# Job -- something that answers an R
Job: protocol {
    call: function {:this} out R
} as {
    R: AnyRef.generic
}

# JobVal -- something that answers an r
JobVal: protocol {
    call: function {:this} out r
} as {
    r: anyval.generic
}

# Name -- a Job answering String
Name: class { s: String } as {
    job: (Job String)
    call: function {:this} out String is { return this.s.copy }
}

# Sum -- a JobVal answering i64
Sum: class { a: i64 b: i64 } as {
    job: (JobVal i64)
    call: function {:this} out i64 is { return this.a + this.b }
}

# run -- runs any Job, answering its R
run: function {j: J.take} out R is {
    return j.call
} as {R: AnyRef.generic J: (Job R).generic}

# runVal -- runs any JobVal, answering its r
runVal: function {j: J.take} out r is {
    return j.call
} as {r: anyval.generic J: (JobVal r).generic}

# forward -- hands its Job on to run
forward: function {j: J.take} out R is {
    return (run j: j.take)
} as {R: AnyRef.generic J: (Job R).generic}

# forwardVal -- hands its JobVal on to runVal
forwardVal: function {j: J.take} out r is {
    return (runVal j: j.take)
} as {r: anyval.generic J: (JobVal r).generic}

# peek -- runs a Job it is lent
peek: function {j: (Job R)} out R is {
    return j.call
} as {R: AnyRef.generic}

main: function is {
    print (run j: (Name s: "named".string))
    print "\{runVal j: (Sum a: 1 b: 2)}"
    n: Name s: "lent".string
    print (peek j: n.borrow)
    print (forward j: (Name s: "forwarded".string))
    print "\{forwardVal j: (Sum a: 3 b: 4)}"
}
