# A statement list's value is its last line's, and a `for` comprehension is a
# value: a block, an `if` or `match` arm, a `with` body and a function's tail
# may end on one, and it builds its list where the value lands. When the other
# arm of the `if` is a place, the value is a reference, and the comprehension's
# list is parked for as long as the binding lives.
K: variant { a: null b: null }
words: function {n: i64} out (ListRef String) is {
    {
        for each i: n.times loop "w\{i}"
    }
}
main: function is {
    c: true
    x: if c then {
        for each i: 3.times loop i * 2
    } else {
        for each i: 2.times loop i
    }
    k: K.b
    y: match k case a then {
        for each i: 1.times loop i
    } case b then {
        for each i: 4.times loop i + 1
    }
    z: with m: 5 do {
        for each i: m.times loop i
    }
    w: words n: 3
    print "\{x.length} \{y.length} \{z.length} \{w.length} \{w.get i: 2}"
    ys: (ListVal i64).create
    ys.append 9
    {
        r: if c.not then {
            for each i: 2.times loop i
        } else ys
        print "ref \{r.length}"
    }
    ss: (ListRef String).create
    ss.append "kept".string
    {
        q: if c then {
            for each i: 3.times loop "p\{i}"
        } else ss
        print "ref taken \{q.length} \{q.get i: 1}"
    }
    print "after \{ss.length}"
}
