# A TEMPLATE'S CONSTANTS ARE EACH INSTANCE'S. A unit template's constant over a
# numeric generic parameter was "'cap' has no compile-time value"; a binding of
# the parameter in a unit function typed as the parameter's name and reached
# the emitter; a unit instance's constant was "no member", even one that reads
# no parameter; a generic class's `as` constant was no member of it; and a
# generic record's `as` constant became a field every construction had to pass.
sized: unit as {
    cap: i64.generic
    LIMIT: 5
    BIG: if cap > 4 then { 1 } else { 0 }
    DOUBLE: cap * 2
    get: function {} out i64 is {
        x: cap
        return BIG + DOUBLE + x
    }
}

eight: (sized cap: 8)
two: (sized cap: 2)

Box: class {
    used: u32
    twice: function {:this} out u32 is {
        return Box.K + Box.L
    }
} as {
    cap: u32.generic
    K: cap * 2
    L: 7
}

Cell: class {
    item: t
} as {
    t: anyval.generic
    SIZE: 3
}

Pair: record {
    x: i64
} as {
    n: u8.generic
    WIDTH: n + 1
}

main: function is {
    print "\{eight.get} \{two.get} \{eight.LIMIT} \{eight.BIG} \{two.DOUBLE}"
    b: (Box cap: 8) used: 0
    c: (Box cap: 3) used: 0
    print "\{b.twice} \{c.twice}"
    holder: (Cell t: u32) item: 4
    print "\{Cell.SIZE} \{holder.item}"
    p: (Pair n: 9) x: 1
    print "\{p.x}"
}
