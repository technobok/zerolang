# data_value_index_bounds.z -- `index` on a data VALUE checks its bounds as the
# block's own `.index` does: a read past the end panics ("zpanic: data index:
# index 4 out of bounds (length 4)" on stderr, exit 1).
primes: data { 2 3 5 7 } out intdata u8

at: function {d: intdata u8 i: u64} out u8 is {
    return (d.index :i)
}

main: function is {
    print "last=\{at d: primes i: 3}"
    past: at d: primes i: 4
    print "past=\{past}"
}
