# unit_arm_constant.z -- a unit constant naming one ARM of a tagged type is a
# VALUE of that type, the shape core.z uses for `false: bool.false`. The arm's
# type may be declared in this same file, which the typeref walk cannot see
# while constants resolve.
mode: variant {
    ready: null
    busy: null
}

READY: mode.ready
BUSY: mode.busy

name: function {m: mode} out String is {
    match (
        m
    ) case ready then {
        return "ready".string
    } case busy then {
        return "busy".string
    }
}

main: function is {
    a: READY
    b: BUSY
    print "\{name m: a}/\{name m: b}"
}
