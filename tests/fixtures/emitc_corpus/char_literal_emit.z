# char_literal_emit.z -- `0c<char>` literals lower to their codepoint in
# the emitted C: comparisons against u8 (free function and method), and
# the typed-suffix forms `0cZ.u8` / `0cA.u32`, and the string escapes a body
# may be (`0c\n`, `0c\\`, `0c\x41`, `0c\u0000e9`). Pins the emitter decode
# (the raw lexeme is not a C token).

isUpperA: function {b: u8} out bool is {
    if b == 0cA then return true
    return false
}

isNewline: function {b: u8} out bool is {
    if b == 0c\n then return true
    return false
}

Sc: class {
    cur: u8
} as {
    isT: function {:this} out bool is {
        b: this.cur
        if b == 0ct then return true
        return false
    }
}

main: function is {
    r1: (isUpperA b: 65)
    print "cmp fn: \{r1}"
    s: (Sc cur: 116)
    r2: s.isT
    print "cmp method: \{r2}"
    pin: 0cZ.u8
    print "suffix u8: \{pin}"
    wide: 0cA.u32
    print "suffix u32: \{wide}"
    d8: 0c8
    print "digit body: \{d8}"
    r3: (isNewline b: 10)
    print "cmp escape: \{r3}"
    print "escapes: \{0c\n} \{0c\t} \{0c\b} \{0c\\}"
    print "hex: \{0c\x41} codepoint: \{0c\u0000e9}"
    top8: 0c\u0000ff.c8
    print "codepoint c8: \{top8}"
}
