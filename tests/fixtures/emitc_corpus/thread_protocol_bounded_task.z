# A task typed by a parameter the protocol bounds keeps the implementer's
# type in sight, so it crosses to another thread where a protocol value
# would not (errors/thread_protocol_value_crossing).

# Shape -- something to poke
Shape: protocol {
    # poke it, answering how often it has been poked
    poke: function {:this} out i64
}

# Counter -- a Shape that counts its pokes
Counter: class {
    # the pokes so far
    n: i64
} as {
    shape: Shape.implement
    poke: function {:this} out i64 is {
        this.n = this.n + 1
        return this.n
    }
}

# Poker -- a task that pokes its Shape three times
Poker: class {
    # the shape, of whatever type implements Shape
    s: T
} as {
    T: Shape.generic
    task: (thread.TaskVal i64).implement
    call: function {:this} out i64 is {
        this.s.poke
        this.s.poke
        return this.s.poke
    }
}

main: function is {
    h: thread.spawnVal task: (Poker s: (Counter n: 0))
    print "\{h.join}"
}
