# user_never_not_demanded.z -- a loop and `return` produce the SYSTEM's `never`, so
# they demand that declaration by its unit. A user `never` is the program's own
# type and, like any unused declaration, only parses: its unknown field type is
# never resolved, exactly as under any other name.

never: record { y: nosuchtype }

main: function is {
    i: 0
    for i < 3 loop {
        i = i + 1
    }
    print "i=\{i}"
}
