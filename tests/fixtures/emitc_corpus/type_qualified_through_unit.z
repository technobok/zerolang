# A TYPE'S MEMBERS ARE REACHED THROUGH ITS UNIT AS THROUGH ITS BARE NAME:
# `nsq_gauge.Gauge.bump n: 3` and `nsq_gauge.Gauge.doubled g` reached the emitter
# as an unhandled callee, where `Gauge.bump n: 3` in the unit itself was fine.
main: function is {
    g: nsq_gauge.Gauge level: 5
    a: nsq_gauge.Gauge.bump n: 3
    b: nsq_gauge.Gauge.doubled g
    print "\{a} \{b}"
}
