# resultvr_basic.z -- ResultVR, the mixed result: a value on success, a
# reference error. Its `ok` is a bare value-type arm that fits the union's
# slot at u64 and at bool, so a success is stored in the slot with no heap
# cell, while the error is a cell as every reference arm is. Both arms are
# constructed, returned, matched and narrowed, and the error's String freed.

Fail: class { why: String }

half: function {n: u64} out (ResultVR u64 E: Fail) is {
    if n % 2 == 1 then return ((ResultVR u64 E: Fail).err (Fail why: "odd \{n}"))
    return ((ResultVR u64 E: Fail).ok n / 2)
}

isBig: function {n: u64} out (ResultVR bool E: Fail) is {
    if n == 0 then return ((ResultVR bool E: Fail).err (Fail why: "zero".string))
    return ((ResultVR bool E: Fail).ok n > 100)
}

main: function is {
    for each i: 4.u64.times loop {
        r: half n: i
        match (r) case ok then print "half \{r}" case err then print "err \{r.why}"
    }
    b: isBig n: 500
    if b.ok then print "big \{b}"
    z: isBig n: 0
    if z.err then print "err \{z.why}"
}
