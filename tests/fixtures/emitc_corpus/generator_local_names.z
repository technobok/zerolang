# A generator's local is kept in a field of its own, one per variable, so its
# name cannot collide with anything else the instance holds: two sibling blocks
# may bind one name with two types, a local may be named `state` (the state
# machine's cursor), and a local may share a name with an `is` field, which it
# shadows in the body without touching the field.
Sibling: generator { pick: bool } as {
    call: function out u64 is {
        if this.pick then {
            x: 7.u64
            yield x
        } else {
            x: "seven".string
            yield x.length
        }
    }
}

State: generator as {
    call: function out u64 is {
        state: 5.u64
        yield state
        yield state + 1
    }
}

Shadow: generator { limit: u64 } as {
    call: function out u64 is {
        limit: "shadow".string
        yield limit.length
        yield this.limit
    }
}

main: function is {
    for a: (Sibling pick: true) loop print "sibling \{a}"
    for b: (Sibling pick: false) loop print "sibling \{b}"
    for c: State loop print "state \{c}"
    for d: (Shadow limit: 9) loop print "shadow \{d}"
}
