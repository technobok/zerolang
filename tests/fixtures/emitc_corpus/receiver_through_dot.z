# THE DOT SUPPLIES THE RECEIVER to a function field that declares one, whatever
# else the call passes, and whatever the base is -- a variable, `this`, or the
# value a call returns. `m.add n: 2` demanded the receiver again as an argument,
# and `(mk).grow n: 2` -- a call of `mk` -- was read as if `mk` named a type.
Meter: class {
    count: i64
    add: function {:this n: i64} out i64 is {
        return this.count + n
    }
    twice: function {:this} out i64 is {
        r: this.add n: this.count
        return r
    }
}

Ruler: record {
    size: i64
} as {
    grow: function {:this n: i64} out i64 is {
        return this.size + n
    }
}

mk: function out Ruler is {
    return (Ruler size: 4)
}

main: function is {
    m: Meter count: 5
    print "\{m.add n: 2} \{m.twice} \{(mk).grow n: 2}"
}
