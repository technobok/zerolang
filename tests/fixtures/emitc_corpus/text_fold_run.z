# text_fold_run.z -- a text method on a string literal folds when its
# arguments are constants, and runs on the StringView the literal becomes when
# one is not. A folded string read at run time is one static array; one read
# only at compile time is none.
NAME: "Zero"
UP: NAME.toUpperAscii
ONLY: NAME.toLowerAscii
main: function is {
    print UP
    print "\{ONLY.length}"
    x: "er"
    print "\{"Zero".contains needle: x} \{NAME.startsWith prefix: x}"
    s: "  pad  ".trim
    print s
    n: "abc".length
    m: n + 1
    print "\{m}"
    t: "abc".toUpperAscii
    print t
    owned: "abc".toUpperAscii.string
    print owned.stringView
}
