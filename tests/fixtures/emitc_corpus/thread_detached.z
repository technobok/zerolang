# thread_detached.z -- a detached task runs to its end with nothing waiting on
# it, and destroys its task on its thread; `thread.running` reads 0 once every
# thread the program started has finished and freed its task, so main waits on
# it before it ends.

# Greeter -- prints from its own thread, and holds an owned label it frees
Greeter: class {
    # what it prints
    label: String
} as {
    task: (thread.Task null)
    call: function {:this} is {
        print "hello from \{this.label}"
    }
}

main: function is {
    thread.spawnDetached task: (Greeter label: "the detached task".string) name: "greeter"
    for thread.running > 0 loop thread.yieldNow
    print "running: \{thread.running}"
    print "done"
}
