# `+` on strings BUILDS a new owned String; `append` is the in-place
# accumulator. Both receivers reach one native, so `a + b` does not change
# meaning with the ownership of `a`.
#
# The chained case is the one with teeth: the inner `+` is an owned String and
# not an lvalue, so it hoists into a temp before its view is taken. Without the
# hoist svValueForm spells it twice -- once for `.data`, once for `.size` --
# and two concats allocate two buffers and leak both. The ASan pool in
# `make test` is what pins that.

JOINED: ("hello, " + "world") == "hello, world"

main: function is {
    v: "foo"
    w: "bar"
    o: "own".string

    bound: v + w
    print bound

    print (v + w)
    print (v + w + "!")

    print (o + w)
    print (v + o)

    acc: "acc".string
    acc.append w
    print acc

    if JOINED then {
        print "joined folded"
    } else {
        print "joined NOT folded"
    }
}
