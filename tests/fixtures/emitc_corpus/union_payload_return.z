# A bare name narrowed to one arm reads the arm's PAYLOAD, and a `return` of
# it hands back a copy of the payload, not the union. The union -- an owned
# `.take` parameter or local -- was still spared as if it were what the return
# handed back, and the cell its arm is held in leaked. The same union returned
# through a local assigned first, or through the other arm, was freed.
Tree: union { leaf: (Box i64) node: String }

Gen: union { leaf: t node: String } as {
    t: anyval.generic
}

eat: function {x: Tree.take} out i64 is {
    match (x) case leaf then return x case node then return 1
}

fromLocal: function {n: i64} out i64 is {
    x: Tree.leaf n
    match (x) case leaf then return x case node then return 0
}

fromGuard: function {n: i64} out i64 is {
    g: (Gen t: i64).leaf n
    if g.leaf then return g
    return 0
}

main: function is {
    print "\{eat x: (Tree.leaf 9)} \{eat x: (Tree.node "s".string)}"
    print "\{fromLocal n: 3} \{fromGuard n: 4}"
}
