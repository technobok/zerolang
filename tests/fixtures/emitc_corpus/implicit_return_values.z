# EVERY VALUE A FUNCTION ENDS ON IS ITS RESULT, as the value handed to `return`
# is. Only a bare name, a string and a `with` or `do` block were returned: an
# operator, a comparison, a call, a field read, an `if`, a `match` and a list
# comprehension were emitted as statements and the function returned whatever
# the register held (`{ a + b }` printed a stack address), and a function whose
# type is written as a call (`out (ListVal u64)`) returned none of them.
mode: variant {
    fast: null
    slow: null
}

Pair: record {
    left: i64
    right: i64
}

N: 5

sum: function {a: i64 b: i64} out i64 is {
    a + b
}

less: function {a: i64 b: i64} out bool is {
    a < b
}

twice: function {a: i64} out i64 is {
    sum :a b: a
}

leftOf: function {p: Pair} out i64 is {
    p.left
}

pick: function {a: i64} out i64 is {
    if a > 1 then {
        b: a * 10
        b + 1
    } else {
        0
    }
}

speed: function {m: mode} out i64 is {
    match (m) case fast then { 100 } else { 1 }
}

squares: function {n: u64} out (ListVal u64) is {
    for x: n.each loop { x * x }
}

held: function {v: u64} out (ListVal u64) is {
    l: ListVal u64
    l.append v
    l
}

owned: function out String is {
    "text".string
}

five: function out u8 is {
    N
}

main: function is {
    p: Pair left: 3 right: 4
    print "\{sum a: 4 b: 5} \{less a: 4 b: 5} \{twice a: 6} \{leftOf :p}"
    print "\{pick a: 4} \{pick a: 0} \{speed m: mode.fast} \{speed m: mode.slow}"
    sq: squares n: 4
    h: held v: 3
    print "\{sq.length} \{sq.get i: 3} \{h.length} \{owned} \{five}"
}
