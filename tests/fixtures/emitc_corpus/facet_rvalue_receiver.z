# facet_rvalue_receiver.z -- a facet method called on a value that is no C
# lvalue: a call's result, a construction, a conformance label read. Facet
# dispatch hands the wrapper the address of the facet's inline data, and
# `&f().data` is no C; the receiver is bound to a temp first, so it also runs
# once where the table and the data used to read it twice. A record's facet
# label (`p.m`) reads as the facet, as a protocol label does.
sizer: facet {
    size: function {t: this.view} out u64
    scaled: function {t: this.view by: u64} out u64
}
pt: record { x: u64 } as {
    m: sizer
    size: function {t: this.view} out u64 is { return t.x }
    scaled: function {t: this.view by: u64} out u64 is { return t.x * by }
}
Calls: class { n: u64 }
mk: function {c: Calls} out sizer is {
    c.n = c.n + 1
    return (sizer.create from: (pt x: 5))
}
measure: function {z: sizer} out u64 is { return z.size }

Speaker: protocol {
    speak: function {t: this.view} out i64
}
Dog: class { v: i64 } as {
    :Speaker
    speak: function {t: this.view} out i64 is { return t.v }
}

main: function is {
    c: Calls n: 0
    print "\{(mk :c).size} \{c.n}"
    print "\{(mk :c).scaled by: 3} \{c.n}"
    print "\{(sizer.create from: (pt x: 6)).size}"
    p: pt x: 7
    print "\{measure z: p.m}"
    print "\{p.m.size} \{p.m.scaled by: 2}"
    d: Dog v: 9
    print "\{d.Speaker.speak}"
}
