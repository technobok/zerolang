# data_untyped_elements.z -- a block that names no type (no `out`, no tagged
# element) reads its elements through the declaration UNTYPED, as a unit
# constant reads: each lands in whatever numeric type takes it, checked by its
# value. Only what reaches run time -- the value, a run-time `.index`, a walk --
# is the i64 / f64 default. A block that names its type reads at that type.
sizes: data { small: 10 big: 300 }
ratios: data { half: 0.5 }

byte: function {b: u8} out u8 is { return b }
word: function {w: u16} out u16 is { return w }
single: function {f: f32} out f32 is { return f }

main: function is {
    print "byte=\{byte b: sizes.small} word=\{word w: sizes.big}"
    print "single=\{single f: ratios.half}"
    sum: sizes.small + sizes.big
    i: 1.u64
    print "sum=\{sum} at1=\{sizes.index :i}"
}
