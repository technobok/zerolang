# record_iterator.z -- an iterator that is a RECORD, not a class. Iterator-shaped
# is a question about the `call` member, not about the family: a record with a
# `call` returning an optionval drives a `for` header under both dispatch rules,
# and costs no heap doing it.
#
# The name of that `call` in the C is whoever wrote its body, which is what
# objIterCallC answers. Asking whether the iterator was a CLASS spelled the
# collection template's `{type}_call` for this one, which nothing defines -- the
# compiler emitted C and the C compiler refused it.
counter: record { i: i64  max: i64 } as {
    call: function {c: this} out (optionval t: i64) is {
        if c.i < c.max then {
            result: optionval.some c.i
            c.i = c.i + 1
            return result
        }
        result: optionval.none i64
        return result
    }
}

main: function is {
    # rule 4: a non-call expression whose type is iterator-shaped
    r: counter i: 0 max: 4
    for x: r loop print "r \{x}"
    # rule 1: a call expression returning an iterator-shaped value
    for y: (counter i: 10 max: 13) loop print "c \{y}"
    # the cursor is a value, so a second walk from a fresh one starts over
    r2: counter i: 0 max: 2
    for z: r2 loop print "z \{z}"
}
