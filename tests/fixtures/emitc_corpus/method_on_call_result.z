# A method whose receiver is the RESULT OF A CALL. The receiver is passed by
# address, and a call result is not an lvalue, so the value must be hoisted
# into a temp first -- `&f(x)` is C the compiler rejects.
point: record {
    x: u64
} as {
    isZero: function {t: this.view} out bool is {
        return t.x == 0
    }

    plus: function {t: this.view n: u64} out point is {
        return (point x: t.x + n)
    }
}

mk: function {n: u64} out point is {
    return (point x: n)
}

main: function is {
    p: mk n: 0
    if p.isZero then print "bound zero" else print "bound nonzero"
    if (mk n: 0).isZero then print "direct zero" else print "direct nonzero"
    if (mk n: 7).isZero then print "seven zero" else print "seven nonzero"
    q: (mk n: 2).plus n: 3
    print "chained \{q.x}"
}
