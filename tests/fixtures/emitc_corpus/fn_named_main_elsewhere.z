# Only the main unit's own `main` is the program's entry point. A function named
# `main` anywhere else -- a namespace's, a type's method -- is an ordinary
# function with its own parameters and result.
#
# The emitter gave EVERY function spelled `main` the entry signature `void
# z_main(void)`, so `helper.main x: 5` reached gcc as a void function returning
# a value through an undeclared parameter. It now asks whether the function IS
# the main unit's `main` declaration.
helper: unit as {
    main: function {x: i64} out i64 is {
        return x + 1
    }
}

counter: class {
    n: i64
} as {
    main: function {:this} out i64 is {
        return this.n * 2
    }
}

main: function is {
    c: counter 4
    print "\{helper.main x: 5} \{c.main}"
}
