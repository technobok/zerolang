# public_subunit_listed.z -- a hidden subunit listed in its unit's `public:`
# block IS public: `pubsub_host.impl.V` is reachable from outside, and the
# parser loads pubsub_host/impl.z on the strength of the listing alone (the
# host's body never names impl).
main: function is {
    print "V=\{pubsub_host.impl.V}"
}
