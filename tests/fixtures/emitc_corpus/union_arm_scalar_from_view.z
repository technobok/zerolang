# union_arm_scalar_from_view -- a union arm built from a number or a bool read
# through a view (a field of a List's item) holds a copy, so the union keeps
# no lock on the list and can be returned out of the function that owns it.
# Before the fix it was refused: "Cannot return this value: it keeps 'xs'
# locked, which dies with this call".

Box: class {
    m1: 0.u32
    m2: false
}

Un: union {
    c1: u32
    c2: bool
    c3: null
}

firstCount: function out Un is {
    xs: List Box
    xs.append (Box m1: 7.u32 m2: true)
    return (Un.c1 (xs.get i: 0).m1)
}

firstFlag: function out Un is {
    xs: List Box
    xs.append (Box m1: 1.u32 m2: true)
    return (Un.c2 (xs.get i: 0).m2)
}

main: function is {
    a: firstCount
    b: firstFlag
    print "\{a.c1} \{b.c2}"
    match a case c1 then print "count \{a}" else null
    match b case c2 then print "flag \{b}" else null
}
