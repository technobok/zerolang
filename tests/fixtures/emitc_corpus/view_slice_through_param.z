# view_slice_through_param.z -- a list view sliced inside a function, where the
# view arrives from a parameter: the list itself as `.view` or `.borrow`, or
# the view as a parameter of its own. `slice` is declared `outx type`, and the
# ListViewVal instance these reach is minted while the library is still being
# read, carrying the template's member, which records no return of its own. The
# slice of a view is a view of that same instance, at the call and in the C
# that backs it; it was the template, which nothing emits.

# the second element, read through a slice of the list's view
viaView: function {xs: (ListVal u64).view} out u64 is {
    v: xs.listView
    s: v.slice from: 1 to: 2
    return (s.get i: 0)
}

# the same through a borrowed list
viaBorrow: function {xs: (ListVal u64).borrow} out u64 is {
    v: xs.listView
    s: v.slice from: 1 to: 3
    return s.length
}

# a view passed as a parameter, sliced
viaViewParam: function {v: (ListViewVal u64)} out u64 is {
    s: v.slice from: 0 to: 1
    return (s.get i: 0)
}

main: function is {
    xs: ListVal u64
    xs.append from: 4
    xs.append from: 5
    xs.append from: 6
    print "\{viaView :xs} \{viaBorrow :xs} \{viaViewParam v: xs.listView}"
}
