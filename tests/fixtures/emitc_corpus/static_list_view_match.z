# A static list's cursor yields a view of its element, held as a pointer to
# the static storage whatever the element's size: a match on what `call`
# returns reads it through that pointer.
ts: list { "ab" "cd" }
ns: list { 10 20 30 }

main: function is {
    with it: ts.iterate do {
        v: it.call
        match (v) case some then print "some \{v}" case none then print "none"
    }
    with jt: ns.iterate do {
        w: jt.call
        match (w) case some then print "n \{w}" case none then print "none"
    }
    for each t: ts loop print "\{t}"
}
