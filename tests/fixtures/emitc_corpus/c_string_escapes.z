# every byte of a literal reaches the program as written: a control byte the
# C string has no letter escape for (a carriage return, a bell, DEL), a digit
# right after one, and `??` sequences, which C reads as trigraphs
main: function is {
    s: "a\x0db\x07c\x7fd\x011"
    acc: u64
    i: u64
    for i < s.length loop {
        acc = (acc * 31) + ((s.byteAt :i).or d: 0).u64
        i = i + 1
    }
    print "\{s.length} \{acc}"
    print "what??! ??= ??( ??/ ok"
}
