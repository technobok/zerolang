# a `view` argument takes a READONLY lock, so the caller may still read it while
# the call is in flight -- the whole point of the marker
Item: class {
    label: String
    value: i64
}
show: function {c: Item.view note: String} is {
    print "\{c.value} \{note}"
}
main: function is {
    e: Item label: "echo".string value: 5
    show c: e note: "\{e.label}"
    print "still owned: \{e.label}"
}
