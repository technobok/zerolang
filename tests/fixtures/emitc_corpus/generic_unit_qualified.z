# A generic unit substitutes ITS OWN parameters and the types it declares, by
# what they are: `generic_unit_qualified_lib.T` is another unit's record that
# happens to be spelled like the parameter `T`, and stays that record -- as a
# parameter, a return and a field. The substitution used to key on the type's
# NAME, so all three became `String`; a return naming another unit's type was
# also left unresolved on the instance.
wrap: unit as {
    T: AnyRef.generic
    Rec: record {
        v: generic_unit_qualified_lib.T
    }
    f: function {x: generic_unit_qualified_lib.T} out i64 is {
        return x.n
    }
    h: function out generic_unit_qualified_lib.T is {
        return generic_unit_qualified_lib.mk
    }
    rec: function out Rec is {
        return (Rec v: generic_unit_qualified_lib.mk)
    }
    keep: function {x: T} out T is {
        return x.copy
    }
}
w: (wrap T: String)

main: function is {
    print "f \{w.f x: generic_unit_qualified_lib.mk}"
    q: w.h
    print "h \{q.n} \{w.h.n}"
    print "rec \{w.rec.v.n}"
    print "keep \{w.keep x: "s".string}"
}
