# generic_arg_pun.z -- a numeric generic argument written as a pun, `(fx :n)`
# for `(fx n: n)` -- the formatter's own spelling of the long form -- reads the
# enclosing type's parameter as the long form does: in a type position, in a
# construction, and as the base of a static call. The pun's value was read as
# no name at all, so each was refused as an unknown `n`, and the instance
# walk built `(fx)`.

# a value offset by n
fx: record {
    v: u64
} as {
    n: u64.generic
    # n more than from
    make: function {from: u64} out type is {
        return (meta.create v: from + n)
    }
    # one more, typed and built through the pun
    next: function {s: this.view} out (fx :n) is {
        r: (fx :n) v: s.v + 1
        return r
    }
    # twice the make, called through the pun
    twice: function {from: u64} out type is {
        a: (fx :n).make :from
        return (meta.create v: a.v * 2)
    }
}

main: function is {
    a: (fx n: 3).twice from: 4
    b: ((fx n: 5) v: 1).next
    print "\{a.v} \{b.v}"
}
