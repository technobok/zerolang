Conf: record {
    retries: 3
    limit: 100
}

Tally: class {
    count: 0.u64
} as {
    bump: function {:this} is {
        this.count = this.count + 1
    }
}

# a bare-form alias of the class above: it names a TYPE without carrying the
# type's registry name, which is what a bare use of it has to see through
Same: Tally

# an alias whose value INSTANTIATES a generic names a type through a
# call-shaped value
XStrs: (List String)
