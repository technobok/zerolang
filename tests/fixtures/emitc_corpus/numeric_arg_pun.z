# numeric_arg_pun.z -- a numeric generic parameter passed on under its own name
# may be written as the pun `:to`, which is `to: to` (and is what zl fmt
# writes). The pun was refused as "Unknown reference 'to'" when a recorded
# signature reference was re-resolved without its enclosing declaration.

Ring: record { slots: (array t: u8 :to) } as {
    to: u64.generic
}

Spelled: record { slots: (array t: u8 to: to) } as {
    to: u64.generic
}

main: function is {
    r: (Ring to: 4) slots: (array t: u8 to: 4)
    s: (Spelled to: 4) slots: (array t: u8 to: 4)
    print "pun: \{r.slots.length} spelled: \{s.slots.length}"
}
