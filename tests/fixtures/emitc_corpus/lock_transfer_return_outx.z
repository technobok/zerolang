# A lock-holding local returned through an `outx` function hands its locks to
# the caller's binding: every source is a parameter, which the caller still
# owns and keeps locked for the result's lifetime.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

outer: function {from: Src.borrow} outx W is {
    w: mk from: from
    return w
}

main: function is {
    a: Src n: 1
    {
        w: outer from: a
        print "chained: \{w.tag} \{w.s.n}"
    }
    a.n = 5
    print "after: \{a.n}"
}
