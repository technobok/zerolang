# sum_stem_case.z -- a valtype `shape` beside a reftype `Shape` is the language's
# own naming pair. Spelled from the name upper-cased, the two once declared
# `Z_SHAPE_TAG_ONE` twice; a tag enumerator is spelled from the type's id and
# the arm's ordinal, so they are apart.

shape: variant {
    one: i64
    two: i64
}

Shape: union {
    one: i64
    two: String
}

main: function is {
    s: shape.one 7
    u: Shape.one 9
    match (
        s
    ) case one then print "variant one \{s}" case two then print "variant two"
    match (
        u
    ) case one then print "union one \{u}" case two then print "union two"
}
