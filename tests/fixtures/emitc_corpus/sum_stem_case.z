# sum_stem_case.z -- a valtype `shape` beside a reftype `Shape` is the language's
# own naming pair. A sum's C tag enumerators are spelled from its name
# upper-cased, so the two share a stem and would declare `Z_SHAPE_TAG_ONE`
# twice; one is renamed apart, as two units' sums of one name are.

shape: variant {
    one: i64
    two: i64
}

Shape: union {
    one: i64
    two: String
}

main: function is {
    s: shape.one 7
    u: Shape.one 9
    match (
        s
    ) case one then print "variant one \{s}" case two then print "variant two"
    match (
        u
    ) case one then print "union one \{u}" case two then print "union two"
}
