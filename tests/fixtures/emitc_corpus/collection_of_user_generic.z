# A collection or array whose element is an instance of a user generic type.
# The collection pass writes those instances last, after every collection, so a
# list's iterator and bodies indexed an element whose struct came later -- and
# an array embedded one by value before it existed. Such a container is ordered
# by dependency instead: lists of class, record and variant instances, a map
# value, a class field, a nested instance, and arrays.
Pair: class {
    a: t
} as {
    t: anyval.generic
}

prec: record {
    a: t
} as {
    t: anyval.generic
}

slot: variant {
    full: t
    empty: null
} as {
    t: anyval.generic
}

Holder: class {
    ps: List (Pair t: u64)
}

main: function is {
    ps: List (Pair t: u64)
    ps.append (Pair t: u64 a: 3)
    ps.append (Pair t: u64 a: 4)
    for p: ps.iterate loop {
        print "class instance \{p.a}"
    }

    rs: ListVal (prec t: u64)
    rs.append from: (prec t: u64 a: 2)
    lv: rs.listView
    print "record instances \{rs.length}, view \{lv.length}"

    slots: ListVal (slot t: i64)
    print "variant instances \{slots.length}"

    h: (Holder ps: (List (Pair t: u64)))
    h.ps.append (Pair t: u64 a: 9)
    print "class field \{h.ps.length}"

    m: (MapVV k: i64 v: (prec t: u64))
    (m.set key: 1 value: (prec t: u64 a: 5))
    byName: (MapRR K: String V: (Pair t: u64))
    print "map values \{m.length} \{byName.length}"

    nested: List (Pair t: (prec t: u64))
    print "nested instance \{nested.length}"

    arr: (array t: (prec t: u64) to: 2)
    arr.set i: 1 item: (prec t: u64 a: 7)
    got: arr.get i: 1
    arms: (array t: (slot t: i64) to: 2)
    print "arrays \{got.a} \{arms.length}"
}
