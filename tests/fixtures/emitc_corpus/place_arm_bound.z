# A local bound from an `if` or a `match` whose arm reads storage something else
# owns is a second name for it, as `r: h.p` is: nothing frees it, the arm that
# yields a value of its own parks it until the binding's block ends, and a
# sibling field or another element stays free.
Holder: class {
    p: String
    q: String
}

Mode: variant {
    a: null
    b: null
}

fieldArms: function {h: Holder c: bool} out u64 is {
    r: if c then h.p else h.q
    return r.length
}

fieldOrMade: function {h: Holder c: bool} out u64 is {
    r: if c then h.p else "made".string
    return r.length + h.p.length
}

elementArms: function {l: (List String) c: bool} out u64 is {
    r: if c then (l.get i: 0) else (l.get i: 1)
    return r.length
}

elementOrMade: function {l: (List String) m: Mode} out u64 is {
    r: match (m) case a then (l.get i: 0) case b then "made".string
    return r.length + l.length
}

blockArm: function {h: Holder c: bool} out u64 is {
    r: if c then {
        t: "block".string
        t
    } else h.q
    return r.length
}

main: function is {
    h: Holder p: "hp".string q: "hqq".string
    l: List String
    l.append from: "e0".string
    l.append from: "e11".string
    print "field \{fieldArms :h c: true} \{fieldArms :h c: false}"
    print "made \{fieldOrMade :h c: true} \{fieldOrMade :h c: false}"
    print "element \{elementArms :l c: true} \{elementArms :l c: false}"
    print "elementMade \{elementOrMade :l m: Mode.a} \{elementOrMade :l m: Mode.b}"
    print "block \{blockArm :h c: true} \{blockArm :h c: false}"
    print "kept \{h.p} \{h.q} \{l.length}"
}
