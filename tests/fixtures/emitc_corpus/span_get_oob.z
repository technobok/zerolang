# span_get_oob.z -- a window is bounded by its own length, not its owner's: an
# index past it panics ("zpanic: <msg>" on stderr, exit 1).

main: function is {
    xs: ListVal u64
    xs.append from: 1
    xs.append from: 2
    print "before"
    w: xs.mutSlice from: 0 to: 1
    x: w.get i: 1
    print "after \{x}"
}
