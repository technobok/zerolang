# generic_nested_signature.z -- a generic instantiation whose argument is the
# enclosing template's own generic parameter, `(Cell :t)`, in a METHOD
# PARAMETER. That shape refused with an E0300 naming a fabricated `Cell_t`
# that no pass ever defined: the typeref resolved with no enclosing
# declaration, so `t` was not recognised as a parameter and a fresh record
# shell was minted under the composed name.
#
# The label matters and is easy to get wrong: `:t` means `t: t`, and the label
# is matched against the TARGET's parameter name, so Cell's own parameter has
# to be spelled `t` as well.
#
# Values are printed rather than merely compiled, so a substitution that lands
# on the wrong type shows up as a wrong number instead of passing.
Cell: record {
    v: i64
} as { t: anyval.generic }

Pair: record {
    a: i64
    b: i64
} as { t: anyval.generic }

Holder: class {
    n: i64
} as {
    t: anyval.generic
    sum: function {:this c: (Cell :t)} out i64 is { return this.n + c.v }
    # two parameters over the same template parameter resolve to the SAME
    # partial, and each completes independently per instance
    both: function {:this x: (Cell :t) y: (Cell :t)} out i64 is { return x.v + y.v }
    # an argument that is itself an instantiation: the partial nests, and the
    # declared type completes to Pair_Cell_i64 rather than stopping at Pair_Cell
    nested: function {:this p: (Pair t: (Cell :t))} out i64 is { return p.a + p.b }
}

main: function is {
    h: (Holder t: i64 n: 10)
    c: (Cell t: i64 v: 32)
    d: (Cell t: i64 v: 5)
    print "sum=\{h.sum c: c}"
    print "both=\{h.both x: c y: d}"
}
