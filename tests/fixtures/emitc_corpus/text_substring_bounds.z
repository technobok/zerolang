# text_substring_bounds.z -- a slice of text is checked against the text at run
# time, as a view's is: a range past its end panics.
names: list { a: "beta" } out staticlist text

main: function is {
    t: names.a
    print (t.substring from: 1 to: 3).stringView
    bad: t.substring from: 2 to: 9
    print bad.stringView
}
