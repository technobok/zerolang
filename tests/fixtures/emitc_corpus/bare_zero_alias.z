# bare_zero_alias.z -- a bare type name in value position is the zero-argument
# construction whatever NAME reaches the type. An alias whose value
# INSTANTIATES a generic (`Strs: (List String)`) names its type through a
# call-shaped value, and a unit-qualified alias names one through another
# unit; neither carries the type's registry name, so the alias's own shape is
# what has to say so. Argument and RETURN position sit here beside the
# binding: the binding is served by its own emitter leg and was never the
# broken one, so a fixture that only binds proves nothing.
Strs: (List String)

count: function {xs: Strs.view} out u64 is {
    return xs.length
}

fresh: function out Strs is {
    return Strs
}

main: function is {
    a: Strs
    a.append "x".string
    print "bind=\{count xs: a}"
    print "arg=\{count xs: Strs}"
    f: fresh
    print "ret=\{count xs: f}"
    print "xarg=\{count xs: xunit_zero.XStrs}"
    x: xunit_zero.XStrs
    x.append "y".string
    print "xbind=\{x.length}"
    t: xunit_zero.Same
    t.bump
    print "xalias=\{t.count}"
}
