# The literal spellings of a numeric generic argument that already worked, kept
# working by the one reader: a negative on a signed bound, a hex
# literal, a `str` capacity and a unit literal.
irec: record {
    x: i64
} as { n: i64.generic }

urec: record {
    x: i64
} as { n: u64.generic }

sized: unit as {
    cap: u32.generic
    describe: function {} out StringView is {
        match (
            cap
        ) case 0 then {
            return "empty"
        } else {
            return "some"
        }
    }
}

zero: (sized cap: 0)

main: function is {
    r: (irec n: -5) x: 1
    print "\{r.x} \{r.n}"
    h: (urec n: 0x10) x: 3
    print "\{h.x} \{h.n}"
    s: str to: 4
    a: array t: i64 to: 3
    print "\{s.size} \{a.length} \{zero.describe}"
}
