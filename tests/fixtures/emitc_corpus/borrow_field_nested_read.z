# A borrowed field is a pointer wherever it sits: read through a NESTED owned
# field (`p.left.s`), it is still reached with `->`. The outer value owns the
# inner one inline, and the inner one's borrowed field points elsewhere.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

Pair: class {
    left: W
    tag: i64
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

main: function is {
    a: Src n: 7
    {
        w: mk from: a
        p: Pair left: w tag: 2
        print "nested: \{p.left.s.n} \{p.left.tag} \{p.tag}"
    }
    a.n = 9
    print "after: \{a.n}"
}
