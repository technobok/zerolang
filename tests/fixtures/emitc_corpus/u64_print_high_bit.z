# A u64 with the high bit set prints as the value it is. Interpolation
# formatted every integer type through `%ld` and a cast to int64_t, so the
# top half of u64's range came out negative: u64 max printed as -1. i128 and
# u128 already had their own formatters; u64 is the one that fell through to
# the signed path, and it is the width where the gap is reachable -- every
# narrower unsigned type fits in int64_t and printed correctly all along.
main: function is {
    a: 18446744073709551615.u64
    print "max: \{a}"
    b: 18446744073709551608.u64
    print "max-7: \{b}"
    c: 9223372036854775808.u64
    print "2^63: \{c}"
    d: 9223372036854775807.u64
    print "2^63-1: \{d}"
    e: 4294967296.u64
    print "2^32: \{e}"
    f: 0.u64
    print "zero: \{f}"
    # arithmetic that wraps into the top half stays readable
    g: a - 1
    print "max-1: \{g}"
    # the narrower unsigned types were never affected
    h: 255.u8
    i: 65535.u16
    j: 4294967295.u32
    print "narrow: \{h} \{i} \{j}"
}
