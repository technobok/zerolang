# nested_unit_env.z -- a unit nested two deep could not see the unit enclosing
# it, an inline unit inside a subunit could not see the subunit, and one inline
# unit could not reach a sibling by qualified path. All three resolved against
# the file unit or nothing, because the environment held a single nested frame.
main: function is {
    print "all=\{nestenv.outer.inner.all} viaSub=\{nestenv.viaSub}"
}
