# generic_same_spec.z -- one specialisation per argument set: three bindings
# with identical arguments, two at file level and one inside a namespace,
# resolve to the SAME mono (one generic_child row, one mathops_i64 unit).
mathops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
}

first: (mathops t: i64)
second: (mathops t: i64)

inner: unit {
    third: (mathops t: i64)
}

main: function is {
    print "first=\{first.add a: 1 b: 2} second=\{second.add a: 3 b: 4} third=\{inner.third.add a: 5 b: 6}"
}
