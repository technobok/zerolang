# cli.z -- a user unit that lands on the DEMAND path. isFileUnit's denylist is
# keyed by NAME, so a unit called `cli` is demand-gated exactly as the stdlib
# unit of that name is -- which is both how this exercises the demand path and
# why the list is the wrong mechanism. Its namespace is resolved by
# resolveDemandedUnitBody, which had one arm and one call before this: every
# demanded member went to resolveDef, which knows nothing of a nested unit.
# The public block adds the RENAME case: `perimeter: perimImpl` records the
# demand on `perimeter` while the definition that must resolve is `perimImpl`,
# which no name demand reaches -- resolveDemandedUnitBody reads the block's Decl
# edges to cross that gap. `secret` is exposed under no name, so nothing demands
# it and it must not emit.
box: unit {
    LIMIT: 9
}

scale: function {v: i64} out i64 is {
    return v * 2
}

perimImpl: function {w: i64 h: i64} out i64 is {
    return (w + h) + (w + h)
}

secret: function {n: i64} out i64 is {
    return n + 1
}

public: unit { :box :scale perimeter: perimImpl }
