# A `for` used as a statement discards its body's value, so it makes no List:
# the f64 the body's last line answers mints no ListVal f64 (nor its view or
# iterator). Only a `for` in value position is a comprehension.
note: function {xs: (ListVal u8).borrow} out f64 is {
    xs.append from: 1
    return 1.5
}

main: function is {
    xs: ListVal u8
    for each k: 2.times loop {
        note :xs
    }
    print "\{xs.length}"
}
