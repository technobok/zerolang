# A list indexed by a narrow type holds no more rows than the type can number:
# the append whose index would fall past the type's range panics.
slot: typedef u8

main: function is {
    xs: ListVal u8 i: slot
    n: u64
    for n < 300 loop {
        s: xs.append from: 1
        n = n + 1
        if n == 256 then print "256 appended, the last at \{s.u8}"
    }
    print "not reached"
}
