# A typedef constant read through the typedef's own member, which is named
# like a scalar conversion but returns something else: the member runs on
# the constant's value, whatever text that value is written as.

# heading -- a compass heading in degrees, below zero when measured anticlockwise
heading: typedef i16 as {
    # u8 -- whether the heading is anticlockwise
    u8: function {h: this.view} out bool is {
        return h.i16 < 0
    }
}

# level -- a fill level, from 0 to 1
level: typedef f64 as {
    # f32 -- whether the level is past half
    f32: function {l: this.view} out bool is {
        return l.f64 > 0.5
    }
}

North: heading 5
West: heading -90
Full: level 1.0
Half: level 0.25

main: function is {
    print "\{North.u8} \{West.u8} \{Full.f32} \{Half.f32}"
    local: heading 7
    print "\{local.u8}"
}
