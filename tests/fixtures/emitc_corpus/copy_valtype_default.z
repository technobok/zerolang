# `.copy` by family. A valtype's DEFAULT copy is the byte copy its assignment
# already performs, so `.copy` is spelled out where a reader wants to see the
# duplication; the two values are independent afterwards. Writing `copy` in
# the `as` block overrides that default -- a reftype has no default at all, so
# writing one there is the only way to have it.
Pt: record {
    x: i64
    y: i64
}
Tagged: record {
    n: i64
} as {
    copy: function {t: this} out Tagged is {
        return (Tagged n: t.n + 100)
    }
}
Inner: class {
    n: i64
    label: String
} as {
    copy: function {t: this.view} out Inner is {
        return (Inner n: t.n label: t.label.copy)
    }
}
main: function is {
    p: Pt x: 1 y: 2
    q: p.copy
    q.x = 9
    print "pt=\{p.x},\{p.y} copy=\{q.x},\{q.y}"

    t: Tagged n: 5
    u: t.copy
    print "tagged=\{t.n} copy=\{u.n}"

    a: Inner n: 3 label: "src".string
    b: a.copy
    b.n = 7
    b.label = "dup".string
    print "inner=\{a.n},\{a.label} copy=\{b.n},\{b.label}"
}
