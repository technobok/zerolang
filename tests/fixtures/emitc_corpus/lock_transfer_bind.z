# A lock-holding value moved into another binding takes its locks with it:
# the new binding is inside the source's scope, so the source stays locked
# for exactly as long as the value lives, and is writable once it dies.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

main: function is {
    a: Src n: 1
    {
        w: mk from: a
        b: w
        print "moved: \{b.tag} \{b.s.n} \{b.label}"
    }
    a.n = 5
    print "after: \{a.n}"
}
