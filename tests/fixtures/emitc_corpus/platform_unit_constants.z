# A unit-level constant may guard on the target, as platform.z promises:
# each fact folds here, where the main unit's definitions resolve -- before the
# main pass would seed them, which used to leave every one "not a compile-time
# constant". Each line compares the unit-level answer with the same question
# asked in a body, so the output is the same on every host.
IS_LINUX: if platform.os.linux then { 1 } else { 0 }
IS_X86: if platform.arch == platform.archkind.x86_64 then { 1 } else { 0 }
TARGET: platform.target
OS: platform.os
FAMILY: if OS.windows then { 1 } else if OS.darwin then { 2 } else { 3 }

main: function is {
    linux: if platform.os.linux then { 1 } else { 0 }
    x86: if platform.arch == platform.archkind.x86_64 then { 1 } else { 0 }
    family: if platform.os.windows then { 1 } else if platform.os.darwin then { 2 } else { 3 }
    print "os \{IS_LINUX == linux} arch \{IS_X86 == x86}"
    print "family \{FAMILY == family} target \{TARGET == platform.target}"
}
