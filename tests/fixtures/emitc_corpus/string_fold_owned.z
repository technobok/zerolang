# A FOLDED STRING WHERE AN OWNED String IS WANTED. `"ab" + "cd"` folds, but `+`
# yields a String its binding owns and frees, and the fold's static is a
# StringView of program memory: binding the static in its place was not C. The
# owned buffer is built at run time, from operands that still render as their
# statics.
GREETING: "hello"
SHOUT: GREETING + "!"

eat: function {s: String.take} is {
    print "eat \{s}"
}

joined: function out String is {
    return "ab" + "cd"
}

main: function is {
    u: "ab" + "cd"
    u.append "!"
    j: joined
    print "\{u} \{"ab" + "cd"} \{j}"
    eat s: GREETING + SHOUT
    pick: if u.length > 2 then "x" + "y" else "z".string
    print "\{pick} \{SHOUT}"
}
