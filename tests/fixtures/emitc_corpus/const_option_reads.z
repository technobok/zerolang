# A unit-level constant whose value is an option a folded method answers is a
# VALUE in a body, as a local holding it is: its arm predicates, its methods
# and its comparisons read the option. A definition that instantiates a
# generic template (`Names`) still names that instance, a type.
G: "a#b"
AT: G.indexOf "#"
NOAT: G.indexOf "%"
Names: (List String)
main: function is {
    print "\{AT.some} \{AT.none} \{NOAT.some} \{NOAT.none}"
    print "\{(AT.or d: 9)} \{(NOAT.or d: 9)}"
    print "\{AT == AT} \{AT == NOAT}"
    ns: Names
    ns.append "x".string
    print "\{ns.length}"
}
