# A FLOAT DIVIDED BY A CONSTANT ZERO IS IEEE'S TO ANSWER: an infinity signed
# as the operands' signs give it, or a NaN for a zero dividend. The checker
# folds no such division (no literal spells the answer), and C compilers fold
# a division of two constants themselves -- MSVC refuses one by zero -- so the
# emitter spells the answer from math.h. A variable dividend divides as
# written.

# show -- whether an f64 is an infinity, a NaN, and negative
show: function {name: StringView v: f64} is {
    print "\{name} inf \{v.isInf} nan \{v.isNaN} neg \{v.signBit}"
}

# show32 -- show for an f32
show32: function {name: StringView v: f32} is {
    print "\{name} inf \{v.isInf} nan \{v.isNaN} neg \{v.signBit}"
}

main: function is {
    show name: "1/0" v: 1.0 / 0.0
    show name: "-1/0" v: -1.0 / 0.0
    show name: "1/-0" v: 1.0 / -0.0
    show name: "-1/-0" v: -1.0 / -0.0
    show name: "0/0" v: 0.0 / 0.0
    show32 name: "f32 2/0" v: 2.0.f32 / 0.0.f32
    show32 name: "f32 -2/0" v: -2.0.f32 / 0.0.f32
    x: 3.0
    show name: "x/0" v: x / 0.0
    show name: "-x/0" v: (0.0 - x) / 0.0
}
