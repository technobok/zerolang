# const_match_dead_else_unwalked -- A match on a unit constant folds to the arm the
# constant holds. The `else` the fold rules out is not walked: what it reads need not
# type.
shape: choice {
    circle: i64
    square: i64
    dot: null
}
SH: (shape.square 4)

main: function is {
    match SH case square then print "side \{SH}" else print "\{SH + 1}"
}
