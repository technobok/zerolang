# optionval_or.z -- `.or d:` on an optionval: the payload when some, the
# default when none, on a bound value and on a call's result alike.
main: function is {
    m: (IdMapV u64 v: u64)
    m.set key: 1 value: 9
    got: m.get key: 1
    a: got.or d: 0
    b: (m.get key: 2).or d: 4
    print "\{a} \{b}"
}
