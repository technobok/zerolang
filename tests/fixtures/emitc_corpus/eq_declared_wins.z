# A declared `==` beats the synthesised byte compare. `odd` says two values
# are equal when their PARITY matches, which disagrees with a byte compare on
# purpose -- if the author's method is skipped this prints the wrong answer
# and still exits 0, which is how the defect hid.
#
# `plain` is the other half: a record that declares nothing keeps the
# byte-compare default. A rule that only ever overrides is indistinguishable
# from one that overrides everything.
odd: record {
    x: u64
} as {
    ==: function {p: this rhs: odd} out bool is {
        return (p.x % 2) == (rhs.x % 2)
    }
}

plain: record {
    x: u64
}

main: function is {
    a: odd x: 1
    b: odd x: 3
    c: odd x: 2
    print "declared 1==3 (same parity): \{a == b}"
    print "declared 1==2 (differs): \{a == c}"
    print "declared 1!=2: \{a != c}"

    p: plain x: 1
    q: plain x: 1
    r: plain x: 2
    print "default 1==1: \{p == q}"
    print "default 1==2: \{p == r}"
}
