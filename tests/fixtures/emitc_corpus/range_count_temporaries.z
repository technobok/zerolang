# A COUNTED LOOP'S BOUNDS MAY NEED TEMPORARIES. `(count) + (count)` reads its
# first call into a temporary before the second runs, and a loop whose count
# or ends are such an expression declares that temporary ahead of the loop,
# where it computes the count -- not inside the body, where the count could
# not see it.

# count -- prints, and answers 1: a call with an effect
count: function out u64 is {
    print "count"
    return 1
}

main: function is {
    for each k: ((count) + (count)).times loop print "half-open \{k}"
    for each k: ((count).upto to: (count) + (count)) loop print "closed \{k}"
}
