# net's runtime loads each native's fragment on that native's own demand. It
# loaded the whole unit for any use, and a fragment names the types its member
# returns -- a Listener, a Result over a Conn -- which exist only when that
# member is used: a program that only polls failed with "hole names no type".
# This one listens and only polls, no peer waiting; net_client_only,
# net_listener_only and net_accept_only are the other partial uses.
main: function is {
    lr: net.listen port: 29336
    match (
        lr
    ) case ok then {
        r: lr.pollReadable timeoutMillis: 0
        match r case ok then print "polled: \{r}" case err then print "poll failed"
    } case err then print "listen failed"
}
