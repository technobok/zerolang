# A function with a body written in the `is` section is a field that holds a
# function, with that body as its default, in a generic class and in a class of
# a generic unit as in a plain class. It is called as a method is, and replaced
# by a reference (`.copy`) at construction or by assignment.

# a generic class whose only member is the function
Only: class {
    get: function {c: this.view} out i64 is {
        return 1
    }
} as {
    t: anyval.generic
}

Cell: class {
    k: t
    add: function {c: this.view n: i64} out i64 is {
        return n + 1
    }
} as {
    t: anyval.generic
    twice: function {c: this.view n: i64} out i64 is {
        return n * 2
    }
}

plus9: function {c: (Cell t: i64).view n: i64} out i64 is {
    return n + 9
}

cells: unit as {
    t: anyval.generic
    Box: class {
        get: function {c: this.view} out i64 is {
            return 7
        }
    }
    Pair: class {
        k: t
        get: function {c: this.view} out i64 is {
            return 8
        }
    }
}

ic: (cells t: i64)

main: function is {
    o: Only t: i64
    print "only \{o.get}"

    a: (Cell t: i64) k: 1
    b: (Cell t: i64) k: 1 add: plus9.copy
    print "cell \{a.add n: 2} \{a.twice n: 2} \{b.add n: 2}"
    a.add = plus9.copy
    print "assigned \{a.add n: 2}"

    x: ic.Box
    p: ic.Pair k: 5
    print "unit \{x.get} \{p.get} \{p.k}"
}
