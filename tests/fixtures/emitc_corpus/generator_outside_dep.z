# A sibling unit for generator_outside_main: generators, and a hand-written
# iterator class, declared outside the unit that drives them.
Count: generator { hi: i64 } as {
    call: function out i64 is {
        i: 0
        for i < this.hi loop {
            yield i
            i = i + 1
        }
    }
}

Adder: generator as {
    call: function {step: i64} out i64 is {
        a: yield 1
        yield (a + 10)
    }
}

Tick: class {
    n: i64
    lim: i64
} as {
    call: function {:this} out optionval i64 is {
        if this.n >= this.lim then return (optionval.none i64)
        this.n = this.n + 1
        return (optionval.some this.n)
    }
}
