# Each parameter is bound once: positionally, by its label, or a mix where the
# label names the next one -- on a method, through the type, and on a native.
P: record {
    n: i64
} as {
    add2: function {t: this.view x: i64 y: i64} out i64 is {
        return t.n + x + y
    }
}

main: function is {
    p: P n: 1
    q: P 4
    s: "abc"
    print "\{p.add2 1 y: 2} \{p.add2 y: 2 x: 1} \{P.add2 p x: 1 y: 2} \{s.startsWith "a"} \{q.n}"
}
