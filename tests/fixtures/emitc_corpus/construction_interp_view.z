# construction_interp_view.z -- a construction handed a view of an
# interpolation stores the view, not the string: `LfBox name: "x=\{n}".stringView`
# reads the view off the string's temporary, which lives as long as b and is
# freed once.
LfBox: class {
    name: StringView
}

main: function is {
    n: 5.i64
    b: LfBox name: "x=\{n}".stringView
    c: LfBox name: "y".string.stringView
    print b.name
    print c.name
}
