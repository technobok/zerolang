# `out T.view` is the readonly half of `out T.borrow`: a reference into the
# receiver, pinned for the binding's scope, but SHARED -- several may be live
# at once, which a mutable reference could never allow. Reads through them work
# and the receiver stays readable.
Item: class {
    n: i64
    label: String
}
Bag: class {
    a: Item
    b: Item
} as {
    peekA: function {t: this.view} out Item.view is {
        return t.a
    }
    peekB: function {t: this.view} out Item.view is {
        return t.b
    }
    total: function {t: this.view} out i64 is {
        return t.a.n + t.b.n
    }
}
main: function is {
    g: Bag a: (Item n: 1 label: "one".string) b: (Item n: 2 label: "two".string)
    x: g.peekA
    y: g.peekB
    print "x=\{x.n},\{x.label} y=\{y.n},\{y.label} total=\{g.total}"
}
