# A facet spec may declare an OPERATOR member, and it dispatches through the
# vtable. Two things had to be true for this to work: the slot needs a C-safe
# name (`==` is not an identifier), and the impl's receiver must be a pointer
# like every other method's -- an operator's was emitted by value, so the
# wrapper handed it a pointer and gcc refused.
#
# The operator's argument is a CONCRETE type on purpose. An interface member
# that names the interface in a parameter -- which `rhs: type` does, since
# `type` inside a facet is the facet -- asks for a conformer-to-conformer call,
# and no single vtable slot can carry one. Such a member has no slot and no
# wrapper, and calling it is refused; tests/fixtures/errors/facet_self_typed
# pins that. This one is dispatchable, and says so by being dispatched.
comparable: facet {
    hash: function {:this} out u64
    ==: function {:this rhs: u64} out bool
}

pt: record {
    x: u64
} as {
    m: comparable
    hash: function {p: this} out u64 is {
        return p.x * 7
    }
    ==: function {p: this rhs: u64} out bool is {
        return p.x == rhs
    }
}

main: function is {
    a: pt x: 3
    print "direct eq: \{a == 3} \{a == 4}"
    print "direct hash: \{a.hash}"
    f: comparable.create from: a
    print "through facet hash: \{f.hash}"
}
