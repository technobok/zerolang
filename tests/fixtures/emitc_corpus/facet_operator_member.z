# A facet spec may declare an OPERATOR member, and it dispatches through the
# vtable. Two things had to be true for this to work: the slot needs a C-safe
# name (`==` is not an identifier), and the impl's receiver must be a pointer
# like every other method's -- an operator's was emitted by value, so the
# wrapper handed it a pointer and gcc refused.
comparable: facet {
    hash: function {:this} out u64
    ==: function {:this rhs: type} out bool
}

pt: record {
    x: u64
} as {
    m: comparable
    hash: function {p: this} out u64 is {
        return p.x * 7
    }
    ==: function {p: this rhs: pt} out bool is {
        return p.x == rhs.x
    }
}

main: function is {
    a: pt x: 3
    b: pt x: 3
    c: pt x: 4
    print "direct eq: \{a == b} \{a == c}"
    print "direct hash: \{a.hash}"
    f: comparable.create from: a
    print "through facet hash: \{f.hash}"
}
