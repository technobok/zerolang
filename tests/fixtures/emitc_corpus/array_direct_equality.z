# Arrays and strs compare DIRECTLY, in every spelling -- `==`, `!=` and the
# call form -- with the generated `==` every value type has. It used to exist
# only as a bare native with no implementation behind it, so a direct compare
# was "no native implementation" and only a record holding the array could
# compare one. An integer or bool array is one memcmp; a float element is
# compared with the float's own `==`, so NaN is unequal to itself and the two
# zeros are equal; a record element is compared field by field, never by its
# padding; a str compares its content. A right-hand side of another length,
# element type or capacity is refused: errors/array_equality_mismatch.
row: record {
    n: i64
    tag: u8
}

main: function is {
    a: (array t: i64 to: 3)
    b: (array t: i64 to: 3)
    print "i64: \{a == b} \{a != b} \{(a.== rhs: b)}"
    b.set i: 2 item: 7
    print "i64 one differs: \{a == b} \{a != b} \{(a.!= rhs: b)}"

    flags: (array t: bool to: 2)
    other: (array t: bool to: 2)
    other.set i: 1 item: true
    print "bool: \{flags == flags} \{flags == other}"

    z: 0.0
    nan: z / z
    fs: (array t: f64 to: 2)
    fs.set i: 0 item: nan
    copied: fs
    print "NaN element: \{fs == copied} \{fs != copied}"
    pz: (array t: f64 to: 2)
    nz: (array t: f64 to: 2)
    nz.set i: 1 item: 0.0 * (0.0 - 1.0)
    print "zeros: \{pz == nz}"

    rs: (array t: row to: 2)
    ts: (array t: row to: 2)
    ts.set i: 1 item: (row n: 5 tag: 1)
    print "records: \{rs == ts}"
    rs.set i: 1 item: (row n: 5 tag: 1)
    print "records: \{rs == ts}"

    grid: (array t: (array t: i64 to: 2) to: 2)
    same: grid
    print "nested: \{grid == same}"

    s: "ab".str to: 8
    t: "ab".str to: 8
    u: "ac".str to: 8
    print "str: \{s == t} \{s != u} \{(s.== rhs: u)}"
}
