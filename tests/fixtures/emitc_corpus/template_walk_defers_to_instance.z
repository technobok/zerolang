# A template's own walk cannot tell which instance it checks, so it leaves to
# each instance what only the instance decides: a `match` whose arms read two
# type parameters, an argument of one type parameter given another; a
# typedef over an instance of the template assigned to a local of the
# template's type; an array over a generic unit's own `n`, whose windows are
# passed where windows over u64 are asked for. Every instance here is valid.
Two: record {
    a: t
    b: u
} as {
    t: anyval.generic
    u: anyval.generic
    pick: function {:this c: bool} out t is {
        return (match (c) case true then this.a case false then this.b)
    }
    takeT: function {:this x: t} out t is {
        return x
    }
    viaB: function {:this} out t is {
        return (this.takeT x: this.b)
    }
}

p8: typedef (Pair t: u8)

Pair: record {
    a: t
} as {
    t: anyval.generic
    viaTd: function {:this} out t is {
        q: p8 (Pair t: u8 a: 1)
        r: this
        r = q
        return r.a
    }
}

fillOnes: function {z: (SpanVal u64).borrow} is {
    z.fill item: 1
}

sumAll: function {x: (ListViewVal u64).view} out u64 is {
    s: u64
    for each w: x loop s = s + w
    return s
}

takeArr: function {a: (array t: u64 to: 3).view} out u64 is {
    return a.length
}

vecs: unit as {
    n: u64.generic
    make: function out u64 is {
        a: (array t: u64 to: n)
        fillOnes z: a.span
        return (sumAll x: a.listView)
    }
    three: function out u64 is {
        a: (array t: u64 to: n)
        return (takeArr :a)
    }
}

main: function is {
    two: Two t: i64 u: i64 a: 1 b: 2
    print "\{two.pick c: true} \{two.pick c: false} \{two.viaB}"
    pair: Pair t: u8 a: 5
    print "\{pair.viaTd}"
    print "\{(vecs n: 3).make} \{(vecs n: 3).three}"
}
