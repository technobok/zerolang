# data_empty.z -- an empty data block is legal when it names its element type
# with `out`, for every kind of block. Its length is 0, its walk ends at once,
# and its value carries no array: C has no empty initializer, so the view's
# pointer is NULL. A run-time index into it panics like any index past the end.
nums: data {} out intdata u8
fls: data {} out floatdata f64
strs: data {} out stringdata

count: function {d: intdata u8} out u64 is {
    return d.length
}

main: function is {
    print "n=\{nums.length} f=\{fls.length} s=\{strs.length} c=\{count d: nums}"
    for each x: strs.iterate loop print "never \{x}"
    w: fls
    for each y: w.iterate loop print "never \{y}"
    print "walked"
    i: 0.u64
    past: nums.index :i
    print "past=\{past}"
}
