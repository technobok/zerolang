# A NAMED UNTYPED FLOAT CONVERTS AS ITS LITERAL DOES: `TENTH.f32` is
# `0.5.f32`, a constant of the target type, as `N.u8` is `5.u8`. It was read
# as its f64 default's runtime conversion, which answers a resultval -- so the
# value was no f32 -- and a fold of such constants did the same. A typed
# constant still converts through its type's surface: `K.f32` from an f64 can
# lose data, and answers a resultval.
TENTH: 0.5
HALVES: TENTH + TENTH
K: 0.25.f64

# echo -- an f32 back
echo: function {x: f32} out f32 is {
    return x
}

main: function is {
    a: TENTH.f32
    b: HALVES.f32
    c: TENTH.f64
    print "\{a == 0.5.f32} \{b == 1.0.f32} \{c} \{echo x: a} \{echo x: TENTH}"
    k: K.f32
    match k case ok then print "k \{k}" case err then print "k err"
}
