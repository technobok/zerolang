# AN UNTYPED FLOAT FOLDS EXACTLY AND ROUNDS ONCE, WHERE IT LANDS. Its value is
# the fraction its literals spell -- `0.1 + 0.2` is 3/10, equal to `0.3` --
# where f64 arithmetic is not; a mixed integer and float fold is exact too;
# an intermediate past f64's range is a value like any other; and a landing
# in a float type takes that type's nearest value, a tie to the even one:
# 16777217 in an f32 is 16777216, 0.1 the f32 nearest a tenth.
TENTH: 0.1
SUM: 0.1 + 0.2
THIRD: 1 / 3.0
BACK: 1e400 / 1e399

# twice -- an f32 doubled
twice: function {x: f32} out f32 is {
    return x * 2.0
}

main: function is {
    print "\{SUM == 0.3} \{(0.1.f64 + 0.2.f64) == 0.3} \{(THIRD * 3) == 1}"
    print "\{BACK} \{16777217.f32 == 16777216.f32} \{twice x: 0.1}"
    t: TENTH.f32
    print "\{t == 0.1.f32} \{(twice x: 16777217) == 33554432.f32}"
    print "\{1e-320 > 0.0} \{(2.5e-1 * 4) == 1}"
}
