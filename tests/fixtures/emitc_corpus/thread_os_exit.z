# thread_os_exit.z -- a thread that calls `os.exit` ends the process once: what
# was printed before is flushed, and a second thread exiting meanwhile waits for
# that end rather than ending the process again. main never gets past its
# joins.

# Leaver -- exits the process from its thread
Leaver: class {
    n: i64
} as {
    task: (thread.Task null)
    call: function {:this} is { os.exit code: 0 }
}

main: function is {
    print "main starts two leavers"
    a: thread.spawn task: (Leaver n: 1)
    b: thread.spawn task: (Leaver n: 2)
    a.join
    b.join
    print "never printed"
}
