# A local of the loop's body, or the element its binding owns, moved on a path
# that ends the iteration with `continue`: the code after that path still
# holds it on the paths that reach it, and reads it. The next iteration binds
# a fresh one.
Tags: generator { n: u64 } as {
    call: function out String is {
        i: 0.u64
        for i < this.n loop {
            yield "tag\{i}"
            i = i + 1
        }
    }
}

main: function is {
    xs: List String
    i: 0
    for i < 4 loop {
        i = i + 1
        s: "body\{i}"
        if i == 2 then {
            xs.append s
            continue
        }
        print "after \{s}"
    }
    for each t: (Tags n: 4) loop {
        if t == "tag1" then {
            xs.append t
            continue
        }
        print "after \{t}"
    }
    # the move sits in an inner block that ends the iteration
    for each u: (Tags n: 3) loop {
        {
            if u == "tag0" then {
                xs.append u
                continue
            }
        }
        print "after \{u}"
    } while xs.length < 10
    print "moved \{xs.length}"
}
