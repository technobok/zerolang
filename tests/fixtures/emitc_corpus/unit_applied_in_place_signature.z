# A signature may name a member type of a unit applied in place, as a parameter
# and as a return: each is the member's type. The type-ref used to reach no
# resolver, so the parameter was typed as nothing and the return as null (the
# call's result was refused as a null value).
cells: unit as {
    t: anyval.generic
    Cell: record {
        val: t
    }
}

mk: function {v: i64} out (cells t: i64).Cell is {
    return ((cells t: i64).Cell val: v)
}

twice: function {x: (cells t: i64).Cell} out i64 is {
    return x.val * 2
}

main: function is {
    m: mk v: 21
    print "\{m.val} \{twice x: m}"
}
