# AN OPTIONVAL OR RESULTVAL MAY CARRY AN INSTANCE. The type an empty arm names
# is resolved whole -- `optionval.none (array t: i64 to: 2)` is the optionval of
# that array, not of the `array` template -- and a value sum is written after the
# array, str or value sum its payload is, however deeply nested: it embeds it.
Cell: record {
    val: t
} as { t: anyval.generic }

row: record {
    o: (optionval (array t: i64 to: 2))
}

pick: function {ok: bool} out (optionval (array t: i64 to: 2)) is {
    if ok then return (optionval.some (array t: i64 to: 2))
    return (optionval.none (array t: i64 to: 2))
}

noCell: function out (optionval (Cell t: i64)) is {
    return (optionval.none (Cell t: i64))
}

noStr: function out (optionval (str to: 4)) is {
    return (optionval.none (str to: 4))
}

has: function {o: (optionval (array t: i64 to: 2))} out bool is {
    return o.some
}

nothing: function as { t: anyval.generic } in { v: t } out (optionval t: t) is {
    return (optionval.none t)
}

check: function {bad: bool} out (resultval t: i64 e: (array t: u8 to: 3)) is {
    if bad then return ((resultval t: i64 e: (array t: u8 to: 3)).err (array t: u8 to: 3))
    return ((resultval t: i64 e: (array t: u8 to: 3)).ok 5)
}

deep: function out (optionval (resultval t: (optionval (array t: i64 to: 2)) e: i64)) is {
    return (optionval.some ((resultval t: (optionval (array t: i64 to: 2)) e: i64).ok (optionval.some (array t: i64 to: 2))))
}

main: function is {
    a: optionval.some (array t: i64 to: 2)
    print "\{a.some} \{has o: (optionval.some (array t: i64 to: 2))}"
    print "\{(pick ok: true).some} \{(pick ok: false).some}"
    print "\{noCell.some} \{noStr.some}"
    r: row o: (optionval.none (array t: i64 to: 2))
    print "\{r.o.none}"
    n: nothing t: (array t: u8 to: 2) v: (array t: u8 to: 2)
    print "\{n.none}"
    c: check bad: true
    match c case ok then print "ok \{c}" case err then print "err \{c.length}"
    d: optionval.some (optionval.some (array t: (array t: u8 to: 2) to: 2))
    print "\{d.some} \{deep.some}"
}
