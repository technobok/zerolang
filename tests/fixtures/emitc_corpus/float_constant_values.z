# A FLOAT CONSTANT IS EMITTED AS ITS EXACT VALUE. Its C literal kept six
# significant digits: `PI: 3.141592653589793` emitted `3.14159`, `0.1 + 0.2`
# emitted `0.3`, and an f32 `16777216.0.f32 + 1.0` emitted `1.67772e+07`, so the
# program ran on a different number than the one the compiler folded. `-0.0`
# lost its sign where the literal was read.
PI: 3.141592653589793
SUM: 0.1 + 0.2
THIRD: 1.0 / 3.0
WIDE: 16777216.0.f32 + 1.0
NEGZERO: -0.0
HALF: -2.5

cfg: record {
    x: i64
} as {
    TAU: PI * 2.0
}

Circle: record {
    ratio: PI
}

main: function is {
    pi: PI
    sum: SUM
    third: THIRD
    print "\{pi == 3.141592653589793} \{sum == 0.30000000000000004} \{(third * 3.0) == 1.0}"
    wide: WIDE
    exact: 16777216.0.f32
    print "\{wide == exact} \{HALF}"
    nz: NEGZERO
    one: 1.0
    print "\{(one / nz) < 0.0}"
    x: 2.0
    print "\{(x * PI) == 6.283185307179586} \{cfg.TAU == 6.283185307179586}"
    c: Circle
    print "\{c.ratio == 3.141592653589793}"
}
