# receiver_value_position.z -- an as-block method's receiver is a C POINTER, and
# using it where a VALUE is wanted never dereferenced it. Three constructs build
# their C from the expression and none asked: `return b` handed back the address
# into a by-value return, a local bound from the receiver declared a struct and
# initialised it with a pointer, and a `match` subject temp did the same. `.copy`
# on a valtype is deliberately the value itself, which is exactly the assumption
# a pointer receiver breaks.
Box: record {
    val: i64
} as {
    twin: function {b: this} out Box is { return b }
    copied: function {b: this} out Box is {
        n: b.copy
        return n
    }
}

Slot: variant {
    full: i64
    empty: null
} as {
    isFull: function {s: this} out bool is {
        match (
            s
        ) case full then {
            return true
        } case empty then {
            return false
        }
    }
}

main: function is {
    a: Box val: 5
    t: a.twin
    print "twin \{t.val}"
    c: a.copied
    print "copied \{c.val}"

    f: Slot.full 3
    e: Slot.empty
    print "isFull \{f.isFull} \{e.isFull}"
}
