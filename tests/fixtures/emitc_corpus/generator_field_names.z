# A generator's fields are the author's, whatever they are named. The fields the
# suspension transform adds -- its resume cursor, its input slot, a local kept
# across a suspension -- are named so that no source can spell them, so they
# never meet one. Each generator below read the wrong field when they were
# named `state`, `_resume_input` and `<local>_<n>`: Count printed 1 and 3, Echo
# yielded its input for the first value, and Spill read its local back for the
# field.
Count: generator { state: i64 } as {
    call: function out i64 is {
        yield this.state
        yield this.state + 1
    }
}

Echo: generator { _resume_input: i64 } as {
    call: function {k: i64} out i64 is {
        yield this._resume_input
        b: yield k
        yield b
    }
}

Spill: generator { default_1: i64 } as {
    call: function out i64 is {
        default: this.default_1 + 10
        yield default
        yield this.default_1
    }
}

main: function is {
    for each v: (Count state: 5) loop print "count \{v}"
    with g: (Echo _resume_input: 7) do {
        a: g.call k: 1
        b: g.call k: 2
        match (a) case some then print "echo \{a}" case none then null
        match (b) case some then print "echo \{b}" case none then null
    }
    for each v: (Spill default_1: 5) loop print "spill \{v}"
}
