# inline_unit_bodies.z -- a namespace's functions have real bodies: locals get
# stamped types, and a name written inside the namespace resolves against it
# first (SCALE below) before the file unit (OFFSET).
OFFSET: 100

m: unit {
    SCALE: 3

    scaled: function {n: i64} out i64 is {
        r: n * SCALE
        t: r + OFFSET
        return t
    }
}

n: unit {
    SCALE: 10

    scaled: function {n: i64} out i64 is {
        r: n * SCALE
        return r
    }
}

main: function is {
    print "m.scaled 5 = \{m.scaled 5}"
    print "n.scaled 5 = \{n.scaled 5}"
}
