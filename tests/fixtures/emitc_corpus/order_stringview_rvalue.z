# A view reads a String's data and its size. A String no name holds -- a call's
# result -- used to be spelled once for each, so the call ran twice (four times
# inside an append) and every copy it made leaked. It is now bound once, to a
# temporary that is released when it owns what it holds. Each call below prints
# its trace exactly once.
mks: function {n: i64} out String is {
    print "s\{n}"
    return "x\{n}"
}

mkl: function {n: i64} out (ListVal t: i64) is {
    print "l\{n}"
    l: ListVal i64
    l.append from: n
    return l
}

len1: function {a: StringView} out u64 is {
    return a.length
}

lenl: function {a: (ListViewVal t: i64)} out u64 is {
    return a.length
}

headOf: function {s: StringView} outx StringView is {
    return s
}

main: function is {
    v: (mks n: 1).stringView
    a: len1 a: (mks n: 2).stringView
    buf: "".string
    buf.append (mks n: 3).stringView
    print "\{(mks n: 4).stringView}"
    m: (mks n: 5).stringView.length
    t: (mks n: 6).stringView.trim
    print (mks n: 7).stringView
    eq: (mks n: 8).stringView == "x8"
    lv: lenl a: (mkl n: 9).listView
    h: headOf s: (mks n: 10).stringView
    w: (mks n: 11).substring from: 0 to: 1
    i1: (mks n: 18) == "x18"
    i2: "x19" == (mks n: 19)
    i3: (mks n: 20).stringView == (mks n: 21).stringView
    i4: (mks n: 22) + "!"
    print "infix \{i1} \{i2} \{i3} \{i4}"
    sw: (mks n: 12).startsWith prefix: "x"
    ix: (mks n: 13).stringView.indexOf needle: "1"
    cp: (mks n: 14).compare rhs: "x14".string
    ct: (mks n: 15).contains needle: "5"
    cn: (mks n: 16).count
    for piece: ((mks n: 17).stringView.split sep: "1") loop {
        print "piece \{piece}"
    }
    print "\{v} \{a} \{buf} \{m} \{t} \{eq} \{lv} \{h} \{w} \{sw} \{ix.or d: 0} \{cp} \{ct} \{cn}"
}
