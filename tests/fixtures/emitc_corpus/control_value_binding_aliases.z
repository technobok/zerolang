# A binding of an `if` or `match` whose arms read places is a second name for
# the storage of the arm that ran: a write through it reaches that storage, an
# append that grows it leaves no stale owner behind, and an arm yielding a value
# of its own is held for as long as the binding. It was bound as a copy that
# shared the owner's heap: the append's realloc left the owner pointing at
# freed memory.
Cell: class { n: i64  s: String }
H: class { p: Cell  q: Cell  l: ListVal i64 }
mk: function {n: i64} out Cell is { return (Cell :n s: "m".string) }
main: function is {
    c: true
    h: H p: (Cell n: 1 s: "p".string) q: (Cell n: 2 s: "q".string) l: (ListVal i64)
    {
        r: if c then h.p else h.q
        r.n = 7
        r.s.append "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    }
    {
        g: if c then h.l else (ListVal i64)
        i: 0
        for i < 40 loop {
            g.append from: i
            i = i + 1
        }
    }
    w: if c.not then h.q else (mk n: 3)
    print "\{h.p.n} \{h.p.s.length} \{h.l.length} \{w.n} \{w.s}"
}
