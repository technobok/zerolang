# generic_protocol_param.z -- a generic function whose parameter is an instance of a
# generic protocol over its own parameter (`j: (Job R)`) takes a value of that
# instance: wrapped where the parameter owns it, lent where it borrows it.

# Job -- something that answers an R
Job: protocol {
    call: function {:this} out R
} as {
    R: AnyRef.generic
}

# Name -- a Job answering String
Name: class { s: String } as {
    job: (Job String)
    call: function {:this} out String is { return this.s.copy }
}

# run -- runs a Job it is given, answering its R
run: function {j: (Job R).take} out R is {
    return j.call
} as {R: AnyRef.generic}

# peek -- runs a Job it is lent
peek: function {j: (Job R)} out R is {
    return j.call
} as {R: AnyRef.generic}

main: function is {
    print (run j: ((Job String).create from: (Name s: "wrapped".string)) R: String)
    n: Name s: "lent".string
    print (peek j: n.borrow R: String)
}
