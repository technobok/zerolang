# A generic parameter's bound may be an instance of a generic variant, named
# through an alias: no declaration of its own answers it, so its arms are read
# off the instance (sumBoundAdmits) -- `i64` (its `a`, bound to i64) and `u8`
# (its `b`) are admitted.
pick: variant {
    a: t
    b: u8
} as {
    t: anyval.generic
}

pickI: (pick t: i64)

show: function as { x: pickI.generic } in { v: x } out i64 is {
    return 1
}

main: function is {
    print "\{show v: 3}"
    print "\{show v: 4.u8}"
}
