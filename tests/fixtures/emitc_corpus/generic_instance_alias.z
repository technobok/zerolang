# A UNIT-LEVEL DEFINITION WHOSE VALUE INSTANTIATES A GENERIC TEMPLATE OF THIS
# UNIT NAMES THE INSTANCE, as `Ints: (ListVal t: i64)` does for a library
# template. `B8: (Buffer cap: 8)` was "Unknown reference 'Buffer'" (the template
# was looked up before its own unit declared it), and a constant read through
# the alias (`Bi.K`) was refused as a read through a value.
Buffer: class {
    used: u32
    twice: function {:this} out u32 is {
        return Buffer.K
    }
} as {
    cap: u32.generic
    K: cap * 2
}

B8: (Buffer cap: 8)
B3: (Buffer cap: 3)

Box2: record {
    v: t
} as {
    t: anyval.generic
    K: 7
}

Bi: (Box2 t: i64)

main: function is {
    b: B8 used: 0
    c: B3 used: 1
    print "\{b.used} \{c.used} \{B8.cap} \{b.cap} \{B8.K} \{B3.K} \{b.twice} \{c.twice}"
    d: Bi v: 3
    print "\{d.v} \{Bi.K}"
}
