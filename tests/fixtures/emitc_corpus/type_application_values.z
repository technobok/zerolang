# A TYPE APPLICATION CONSTRUCTS WHAT ITS BARE NAME WOULD. `(Cfg t: u8)` with
# every field defaulted is the defaulted value, a collection instance is the
# empty collection, and an application that only names its type -- the callee of
# a call that supplies the fields, the base of an arm or a `create` -- constructs
# nothing by itself. Through a unit (`xunit_generic_pairs.Pair t: u64 a: 3 b: 4`)
# it is the same construction.
Cfg: class {
    lo: 1
    hi: 7
} as { t: anyval.generic }

Boxed: class {
    used: String
} as { cap: u64.generic }

slot: variant {
    full: t
    empty: null
} as { t: anyval.generic }

count: function {lv: (ListView String)} out u64 is {
    return lv.length
}

main: function is {
    c: (Cfg t: u8)
    d: Cfg t: i64
    print "\{c.lo} \{c.hi} \{d.hi}"
    l: (ListVal t: i64)
    l.append from: 3
    m: ListVal t: u8
    s: (str to: 8)
    a: (array t: i64 to: 2)
    print "\{l.length} \{m.length} \{s.length} \{a.length}"
    b: (Boxed cap: 8) used: "x".string
    print "\{b.used} \{b.cap}"
    z: (slot t: i64).empty
    o: (Option T: String).none
    print "\{z.empty} \{o.none}"
    xs: List String
    print "\{count lv: xs.listView}"
    p: (xunit_generic_pairs.Pair t: u64 a: 3 b: 4)
    q: xunit_generic_pairs.Pair a: 5 b: 6
    r: (xunit_generic_pairs.Cls t: u64 a: 7 b: "hi".string)
    print "\{p.a} \{p.b} \{q.a} \{r.b}"
}
