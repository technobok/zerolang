# A function's type does not depend on how its parameters spell their types. An
# unmarked class parameter borrows whether it is written as an application, a
# typedef of one, a bare name or a path into another unit, so `f2` is a
# `cellop` and `h` is a `kit.boxop`. The recorded ownership used to follow the
# spelling, and both calls below were refused as type mismatches.
Cell: class {
    n: i64
} as {
    t: anyval.generic
}

CellT: Cell i64

cellop: function {c: Cell i64} out i64

mine: function {b: kit.Box} out i64

f1: function {c: Cell i64} out i64 is {
    return c.n
}

f2: function {c: CellT} out i64 is {
    return c.n + 1
}

h: function {b: kit.Box} out i64 is {
    return b.n * 2
}

applyCell: function {fn: cellop c: Cell i64} out i64 is {
    return (fn c: c)
}

applyKit: function {fn: kit.boxop b: kit.Box} out i64 is {
    return (fn b: b)
}

applyMine: function {fn: mine b: kit.Box} out i64 is {
    return (fn b: b)
}

main: function is {
    c: Cell i64 n: 3
    b: kit.Box n: 4
    print "\{applyCell fn: f1.copy c: c} \{applyCell fn: f2.copy c: c}"
    print "\{applyKit fn: h.copy b: b} \{applyMine fn: kit.unbox.copy b: b}"
}
