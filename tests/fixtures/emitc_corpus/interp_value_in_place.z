# AN INTERPOLATION USED AS A VALUE IS BUILT WHERE IT IS READ. Handed to a
# function, it is built at the call; in a loop's test, at every test, from the
# values the test sees then. A part that is a call returning an owned String
# is released once it is appended.

# mk -- an owned String naming n
mk: function {n: u64} out String is {
    return "m\{n}"
}

# len -- the length of the view it is handed
len: function {s: StringView} out u64 is {
    return s.length
}

main: function is {
    i: 7.u64
    ok: true
    print "\{len s: "a\{i} \{ok} \{mk n: i} \{1.5}".stringView}"
    j: 0.u64
    for (len s: "x\{mk n: j}".stringView) < 5 loop j = j + 1
    print "\{j}"
}
