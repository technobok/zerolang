# a `getMut` element -- a pointer into storage its container owns -- in the
# positions that want a place or a value: the receiver of a zero-argument
# method (in an argument, a statement, a binding, a `with` header), a
# by-value parameter (with other arguments, of a function and of a method),
# and a `.view` parameter, which takes the pointer as it stands.
Pt: record {
    x: i64
}
one: function {p: Pt} out i64 is {
    return p.x
}
two: function {p: Pt v: (ListVal i64).take} out i64 is {
    return p.x + (v.length.i64.or d: 0)
}
look: function {p: Pt.view} out i64 is {
    return p.x
}
Acc: class {
    t: i64
} as {
    add: function {:this p: Pt v: (ListVal i64).take} out i64 is {
        return this.t + p.x + (v.length.i64.or d: 0)
    }
    peek: function {:this p: Pt.view} out i64 is {
        return this.t + p.x
    }
}
main: function is {
    grid: List (ListVal i64)
    other: List (ListVal i64)
    grid.append from: (ListVal i64)
    other.append from: (ListVal i64)
    (other.getMut i: 0).append from: 4
    (other.getMut i: 0).append from: 9
    (grid.getMut i: 0).append from: (other.getMut i: 0).pop
    (grid.getMut i: 0).append from: 1
    (grid.getMut i: 0).sort
    p: (other.getMut i: 0).pop
    t: 0
    with it: (grid.getMut i: 0).iterate do for e: it loop {
        t = t + e
    }
    print "lists: \{(grid.get i: 0).get i: 0} \{p} \{t} \{(other.get i: 0).length}"
    pts: ListVal Pt
    pts.append from: (Pt x: 4)
    a: Acc t: 1
    print "values: \{one p: (pts.getMut i: 0)} \{two p: (pts.getMut i: 0) v: (ListVal i64)} \{a.add p: (pts.getMut i: 0) v: (ListVal i64)}"
    print "views: \{look p: (pts.getMut i: 0)} \{a.peek p: (pts.getMut i: 0)}"
}
