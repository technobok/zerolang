# `.copy` of an all-valtype container is its family's copy, whatever the
# receiver: a field two levels down, a SetVal, a MapVV and an IdSet field, a
# call's result, an argument, and a method's own field.
Inner: class {
    xs: ListVal i64
}
Box: class {
    inner: Inner
    ss: SetVal i64
    ms: (MapVV k: i64 v: i64)
    ids: IdSet u64
} as {
    xsCopy: function {this: this.view} out (ListVal i64) is {
        return this.inner.xs.copy
    }
}
mk: function out (ListVal i64) is {
    l: ListVal i64
    l.append from: 1
    l.append from: 2
    return l
}
count: function {l: ListVal i64} out u64 is {
    return l.length
}
main: function is {
    b: Box inner: (Inner xs: (ListVal i64)) ss: (SetVal i64) ms: (MapVV k: i64 v: i64) ids: (IdSet u64)
    b.inner.xs.append from: 3
    b.ss.add item: 4
    b.ms.set key: 1 value: 2
    b.ids.add item: 5
    a: b.inner.xs.copy
    s: b.ss.copy
    m: b.ms.copy
    i: b.ids.copy
    c: (mk).copy
    print "\{a.length} \{s.length} \{m.length} \{i.length} \{c.length} \{count l: b.inner.xs.copy} \{b.xsCopy.length}"
}
