# Two classes that hold Lists of each other. Each class's struct holds the
# other's ListRef by value, and each ListRef's bodies index its element: no
# order of whole types is valid, so the emitter writes each List's struct and
# prototypes first and its bodies after both classes. The C used to name an
# incomplete element ("invalid use of undefined type").
A: class { name: String bs: ListRef B }

B: class { n: i64 others: ListRef A }

main: function is {
    a: (A name: "a".string bs: (ListRef B))
    b1: (B n: 1 others: (ListRef A))
    b1.others.append (A name: "inner".string bs: (ListRef B))
    a.bs.append b1.take
    a.bs.append (B n: 2 others: (ListRef A))
    total: 0
    for b: a.bs.iterate loop total = total + b.n + (b.others.length.i64.or d: 0)
    print "\{a.name} \{a.bs.length} \{total}"
}
