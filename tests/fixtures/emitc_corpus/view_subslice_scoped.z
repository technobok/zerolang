# A sub-slice's pin on the list ends with the sub-slice: read it inside a
# block, and the list is free to grow once the block closes.
main: function is {
    xs: ListVal i64
    xs.append from: 1
    xs.append from: 2
    xs.append from: 3
    {
        s2: (xs.slice from: 0 to: 3).slice from: 1 to: 3
        print "window=\{s2.get i: 0},\{s2.get i: 1}"
    }
    xs.append from: 4
    print "length=\{xs.length}"
}
