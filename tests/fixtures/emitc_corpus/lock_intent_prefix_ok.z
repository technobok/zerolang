# the shared locks an acquisition takes on its own path prefixes are INTENT:
# they exist so the leaf can be locked and must never block it
Leaf: class { n: i64 }
Mid: class { b: Leaf }
Top: class { a: Mid }
bump: function {t: Leaf} is {
    t.n = t.n + 1
}
main: function is {
    o: (Top a: (Mid b: (Leaf n: 1)))
    bump t: o.a.b
    print "\{o.a.b.n}"
}
