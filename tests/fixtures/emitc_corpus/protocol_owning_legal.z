# Every legal way to hand a conformer to a protocol place. A BORROWING place
# -- a borrow or view parameter, or a `Shape d` binding -- takes the
# conformer implicitly; an OWNING place takes a box that owns it,
# `Shape.create from: x.take` (or an unmarked source, which is taken the same
# way). No box leaks and no source is freed twice.
Shape: protocol {
    area: function {t: this.view} out u64
}
Sq: class { side: u64 name: String } as {
    :Shape
    area: function {t: this.view} out u64 is { return t.side * t.side }
}
Holder: class { s: Shape }

show: function {s: Shape} out u64 is { return s.area }
peek: function {s: Shape.view} out u64 is { return s.area }
keep: function {s: Shape.take} out u64 is { return s.area }
make: function {n: u64} out Shape is {
    q: Sq side: n name: "made".string
    return (Shape.create from: q.take)
}

main: function is {
    a: Sq side: 2 name: "a".string
    # borrowing places
    print "\{show s: a} \{peek s: a}"
    d: Shape a
    print "\{d.area}"
    # owning places, each given a box that owns its source
    b: Sq side: 3 name: "b".string
    h: Holder s: (Shape.create from: b.take)
    c: Sq side: 4 name: "c".string
    print "\{keep s: (Shape.create from: c.take)}"
    f: Sq side: 6 name: "f".string
    h.s = Shape.create from: f
    m: make n: 7
    e: Holder s: (Shape.create from: (Sq side: 5 name: "e".string))
    print "\{h.s.area} \{e.s.area} \{m.area}"
}
