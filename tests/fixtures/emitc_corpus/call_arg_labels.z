# THE UNLABELLED ARGUMENT IS DECIDED BY TWO LOOKUPS, NOT BY THE SHAPE OF THE
# CALL. Ask the callee's declaration whether it has a receiver parameter, then
# resolve the dotted base: a VALUE supplies the receiver through the dot, a TYPE
# leaves the receiver to be supplied as the call's one unlabelled argument.
# Every other argument carries its declared parameter name, in any order -- and
# the receiver may carry its own declared name instead of taking the slot.
#
# Each line prints the same answer computed several ways. A leg that binds by
# call ORDER rather than by label shows up as a differing column.
Counter: class {
    n: i64
} as {
    sub: function {:this a: i64 b: i64} out i64 is {
        return (this.n + a) - b
    }
}

point: record {
    x: i64
} as {
    sub: function {t: this a: i64 b: i64} out i64 is {
        return (t.x + a) - b
    }
}

main: function is {
    c: Counter n: 0
    p: point x: 0

    # function style: the unlabelled argument is the receiver, and the
    # remaining labels are in declared order and then reversed
    cls1: Counter.sub c a: 10 b: 3
    cls2: Counter.sub c b: 3 a: 10
    print "cls \{cls1} \{cls2}"

    rec1: point.sub p a: 10 b: 3
    rec2: point.sub p b: 3 a: 10
    print "rec \{rec1} \{rec2}"

    # the receiver by its DECLARED name, before and after the other arguments
    nam1: point.sub t: p a: 10 b: 3
    nam2: point.sub a: 10 b: 3 t: p
    nam3: point.sub b: 3 t: p a: 10
    print "byname \{nam1} \{nam2} \{nam3}"

    # method style: the dot supplies the receiver, so the unlabelled argument
    # is the first declared NON-receiver parameter
    met1: c.sub a: 10 b: 3
    met2: c.sub b: 3 a: 10
    met3: c.sub 10 b: 3
    print "method \{met1} \{met2} \{met3}"
}
