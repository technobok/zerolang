# written_create_labels.z -- a generic type that writes its `create` is
# constructed with that create's parameters: a defaulted one may be left out,
# they infer the type arguments, and one may be a type over a type argument.
# Written against a record they were refused as "unknown type argument 'v'".
# Each parameter keeps its own ownership: `v` borrows the list, which stays
# its caller's (it was moved in and leaked), and `.take` moves it.
Pair: record {
    a: t
    b: i64
} as {
    t: anyval.generic
    create: function {v: t w: 5} out this is {
        return (meta.create a: v b: w)
    }
}

Head: record {
    a: t
    n: u64
} as {
    t: anyval.generic
    create: function {v: (ListVal t: t)} out this is {
        return (meta.create a: (v.get i: 0) n: v.length)
    }
}

Tally: class {
    n: t
    step: i64
} as {
    t: anyval.generic
    create: function {start: t by: 2} out this is {
        return (meta.create n: start step: by)
    }
}

Bag: class {
    items: (ListVal t: t)
} as {
    t: anyval.generic
    create: function {src: (ListVal t: t).take} out this is {
        return (meta.create items: src)
    }
}

main: function is {
    p: (Pair t: u64).create v: 2
    q: Pair t: u64 v: 3
    r: Pair v: 4.u64 w: 6
    s: Pair v: 7.i32
    print "\{p.a} \{p.b} \{q.a} \{q.b} \{r.a} \{r.b} \{s.a} \{s.b}"
    l: (ListVal t: u64)
    l.append from: 11
    l.append from: 12
    h: Head t: u64 v: l
    w: (Head t: u64) v: l
    print "\{h.a} \{h.n} \{w.a} \{l.length}"
    g: Bag t: u64 src: l.take
    print "\{g.items.length}"
    k: Tally start: 9.u8
    print "\{k.n} \{k.step}"
}
