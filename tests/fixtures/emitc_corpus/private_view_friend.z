# A friend handle's kind decides what the friend may do. `.private.view` reads
# a private member, as a parameter and as a field; a bare `.private` parameter
# is `.private.borrow`, so its writes and mutating calls reach the owner.
Bag: class { a: i64 } as {
    public: unit { :peek :read :keep :poke }
    peek: function {this: this.view} out i64 is { return this.a }
    read: function {:this} out i64 is { return (readView h: this.private) }
    keep: function {:this} out i64 is { return (holdView h: this.private) }
    poke: function {:this} out i64 is { return (writeBare h: this.private) }
    bump: function {:this} is { this.a = this.a + 1 }
}

Viewer: class { h: Bag.private.view } as {
    get: function {this: this.view} out i64 is { return this.h.a }
}

readView: function {h: Bag.private.view} out i64 is { return h.a }

holdView: function {h: Bag.private.view} out i64 is {
    v: (Viewer h: h.private)
    return v.get
}

writeBare: function {h: Bag.private} out i64 is {
    h.a = 10
    h.bump
    return h.a
}

main: function is {
    b: (Bag a: 5)
    print "read=\{b.read} keep=\{b.keep}"
    print "poke=\{b.poke} peek=\{b.peek}"
}
