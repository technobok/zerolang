# A list holds any static value: bools, enum arms, lists and data values, as
# well as numbers and strings. Its elements are of one type, its first
# element's when no `out` names one; a nested list is of the element type the
# `out` names. Elements read through paths (`system.1.needs.write`) are
# constants, and a walk at run time hands out each element -- a data value as
# its handle.
mode: variant { fast: null slow: null }

entry: data {
    key: "".text
    needs: staticlist text
    live: false
}

flags: list { yes: true no: false }
modes: list { a: mode.fast b: mode.slow }
grid: list { a: list { 1 2 } b: list { 3 } } out (staticlist (staticlist u8))
system: list {
    (entry key: "system.exit" needs: list {})
    (entry key: "system.print" needs: list { write: "io.write" } live: true)
}

main: function is {
    print "\{flags.yes} \{modes.b == mode.slow} \{grid.b.0} \{grid.0.length}"
    print system.1.key.stringView
    print system.1.needs.write.stringView
    for each e: system loop {
        if e.live then print e.key.stringView
    }
    for each m: modes loop if m == mode.fast then print "fast"
    for each row: grid loop print "\{row.length}"
}
