# A GENERIC UNIT'S TEXT CONSTANT IS READ THROUGH ITS INSTANCE as a number is.
# An instance's constant was typed only when its value was a number, falling
# back to the template's member for anything else -- which a unit with no
# function of its own had not typed -- so `two.K` with `K: "small"` was "unit
# 'words_2' has no member 'K'". An `if` choosing between two texts by the
# parameter, and a unit whose function reads its constants, read them as well.
words: unit as {
    cap: i64.generic
    K: "small"
    L: if cap > 4 then { 1 } else { 2 }
}

sized: unit as {
    cap: i64.generic
    K: "small"
    M: if cap > 4 then { "big" } else { "small" }
    label: function {} out String is {
        return "\{M}:\{cap}"
    }
}

two: (words cap: 2)
nine: (words cap: 9)
eight: (sized cap: 8)
one: (sized cap: 1)

main: function is {
    print "\{two.K} \{nine.K} \{two.L} \{nine.L}"
    print "\{one.M} \{eight.M} \{one.K}"
    print "\{one.label} \{eight.label}"
}
