# A GENERIC TYPE'S INSTANCE HAS A `create`, AS ANY TYPE DOES. Without a written
# one it is the field-wise constructor, with one parameter per substituted
# field; a `create` the template writes is cloned for each instance with its
# parameters, their defaults and its `this` return specialised -- whether the
# instance is written as an application or reached through an alias. A field's
# default holds in every instance, so a type-arguments-alone construction
# fills it rather than zeroing it.
Pair: class {
    a: t
    b: String
} as { t: anyval.generic }

Rec: record {
    a: t
    b: i64
} as { t: anyval.generic }

Made: class {
    a: t
    b: String
} as {
    t: anyval.generic
    create: function {v: t n: 5} out this is {
        return (meta.create a: v b: "made \{n}")
    }
}

Built: record {
    a: t
    b: i64
} as {
    t: anyval.generic
    create: function {v: t} out this is {
        return (meta.create a: v b: 40)
    }
    sum: function {p: this} out i64 is {
        return p.b + 2
    }
}

Holder: class {
    val: T
    tag: i64
} as {
    T: AnyRef.generic
    create: function {v: T.take} out this is {
        return (meta.create val: v tag: 3)
    }
}

Keep: record {
    val: t
} as {
    t: anyval.generic
    me: function {h: this} out this is {
        return h
    }
}

Cfg: class {
    lo: 1
    hi: 7
} as { t: anyval.generic }

PU: (Pair t: u64)
BU: (Built t: u8)
MU: (Made t: u8)
KI: (Keep t: i64)

main: function is {
    p: (Pair t: u64).create a: 1 b: "x".string
    q: PU.create a: 5 b: "y".string
    print "\{p.a} \{p.b} \{q.a} \{q.b}"
    r: (Rec t: u64).create a: 1 b: 2
    print "\{r.a} \{r.b}"
    m: (Made t: u64).create v: 1
    n: (Made t: f64).create v: 2.5 n: 9
    o: MU.create v: 2
    print "\{m.a} \{m.b} \{n.a} \{n.b} \{o.a} \{o.b}"
    b: (Built t: u64).create v: 2
    c: BU.create v: 3
    print "\{b.a} \{b.sum} \{c.a} \{c.sum}"
    h: (Holder T: String).create v: "abc".string
    print "\{h.val} \{h.tag}"
    k: KI val: 4
    print "\{k.me.val}"
    d: (Cfg t: u8)
    e: Cfg t: u8
    f: (Cfg t: u8).create hi: 9
    g: (Cfg t: u8 lo: 2)
    print "\{d.lo} \{d.hi} \{e.hi} \{f.lo} \{f.hi} \{g.lo} \{g.hi}"
}
