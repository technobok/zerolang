# Every spelling a container is constructed and passed in: the positional
# type argument, the `of:` label, a `capacity:` create argument riding the
# construction sugar, a class field, and a parameter. `capacity:` is admitted
# by TEMPLATE IDENTITY -- a native create's params carry no modeled children,
# so the label has to be allowed by name against each container template, and
# ListVal is a container template like its twin.
Holder: class {
    items: (ListVal u32)
}

takes: function {xs: (ListVal of: u64)} out u64 is {
    return xs.length
}

main: function is {
    a: (ListVal u64 capacity: 8)
    a.append 1
    b: (ListVal of: u32)
    b.append 2
    h: Holder items: (ListVal u32 capacity: 4)
    h.items.append 3
    n: takes xs: a
    print "cap=\{a.length} of=\{b.length} field=\{h.items.length} param=\{n}"
}
