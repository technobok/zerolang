# data_index_const_fold.z -- a constant `.get K` reads its element through the
# declaration, as a label does: a literal K, a unit constant K and a unit-level
# definition all fold to the element, and a block read only that way carries no
# array into the program. A run-time index still reads the array.
codes: list { 10 20 30 } out list u8
primes: list { 2 3 5 7 }
MID: 1
LAST: codes.get 2

main: function is {
    a: codes.get 0
    print "a=\{a} mid=\{codes.get MID} last=\{LAST}"
    i: 3.u64
    print "p\{i}=\{primes.get i} p0=\{primes.get 0}"
}
