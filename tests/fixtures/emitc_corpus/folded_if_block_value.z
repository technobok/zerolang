# A condition that folds leaves one live branch, and only it is emitted --
# in a value position too. A live branch that is a block of several lines
# runs its lines ahead of the value it yields, wherever that value is read:
# an argument, an interpolation, a binding.
#
# As an argument or an interpolation it was emitted as a bare expression,
# which a block of several lines is not: the emitter stopped on E0500
# "unhandled expr (multi-statement)". A binding already took the block's
# path.
show: function {b: i64} is {
    print "\{b}"
}

main: function is {
    show b: (if true then {
        y: 3
        y + 2
    } else 444)
    show b: (if false then 555 else {
        z: 7
        z + 1
    })
    print "\{(if true then {
        w: 10
        w * 2
    } else 0)}"
    v: (if true then {
        u: 4
        u - 1
    } else 0)
    print "\{v}"
}
