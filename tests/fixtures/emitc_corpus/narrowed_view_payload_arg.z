# a `.view` variant parameter narrowed to its payload and handed to a
# `payload.view` parameter: the variable is held through a pointer, but the
# narrowed read is the payload's VALUE, so the callee's pointer needs `&`
# (free function, method, and a plain record control).
circ: record {
    r: u64
}

shape: variant {
    circle: circ
    dot: null
}

scaler: record {
    k: u64
} as {
    scaled: function {t: this.view c: circ.view} out u64 is {
        return c.r * t.k
    }
}

area: function {c: circ.view} out u64 is {
    return c.r * 3
}

measure: function {s: shape.view sc: scaler.view} out u64 is {
    if s.circle then return (area c: s) + (sc.scaled c: s)
    return 0
}

main: function is {
    sh: shape.circle (circ r: 7)
    sc: (scaler k: 2)
    cc: (circ r: 5)
    print "\{measure s: sh :sc} \{area c: cc}"
}
