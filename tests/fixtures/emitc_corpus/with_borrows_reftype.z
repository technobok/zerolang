# A `with` NAME BORROWS A REFTYPE, as a new local name does: a write through it
# reaches the source. `with w: a do` over a class emitted a struct copy of `a`
# -- sharing its buffers, never destroyed -- so `w.n = 6` left `a.n` at 5 (at
# 00eebdad). The binding is now a second name for the source, as `b: a` is.
Cl: class {
    n: i64
    s: String
}

bump: function {c: Cl} is {
    with w: c do w.n = w.n + 10
}

main: function is {
    a: Cl n: 5 s: "hi".string
    with w: a do {
        w.n = w.n + 1
        w.s.append "!"
    }
    print "\{a.n} \{a.s}"
    bump c: a
    print "\{a.n}"
}
