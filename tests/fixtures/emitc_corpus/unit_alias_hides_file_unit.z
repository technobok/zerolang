# A unit alias named like a file unit hides that unit inside its scope: a name
# resolves from the scope outward and reaches the file units last, whether or
# not a unit of that name is loaded. One alias here is named like this file's
# own unit and one like the prelude's `io`. Each read goes to the unit the
# alias names: a construction, a constant, a function body and a parameter
# type.
shapes: unit {
    point: data { n: 0 }
    seven: 7
    four: (point n: 4)
}

hides: unit {
    unit_alias_hides_file_unit: shapes
    io: shapes
    built: (unit_alias_hides_file_unit.point n: 1)
    kept: unit_alias_hides_file_unit.seven
    viaIo: io.seven
    read: function out i64 is { return io.seven }
    size: function {p: unit_alias_hides_file_unit.point} out i64 is { return p.n }
}

main: function is {
    print "\{hides.built.n} \{hides.kept} \{hides.viaIo} \{hides.read} \{hides.size p: shapes.four}"
}
