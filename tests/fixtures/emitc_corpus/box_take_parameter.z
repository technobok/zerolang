# A parameter declared `.take` owns what it is given and releases it when the
# function returns. A box is already the pointer its release takes; the release
# was handed the parameter's address instead, and freed memory it never
# allocated.
keep: function {b: (Box t: u64).take} out u64 is {
    return 9
}

main: function is {
    owned: Box from: 5.u64
    k: keep b: owned.take
    j: keep b: (Box from: 6.u64)
    print "\{k} \{j}"
}
