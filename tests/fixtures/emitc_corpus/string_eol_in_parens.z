# string_eol_in_parens -- a multi-line string literal keeps its newlines and its
# closing-delimiter indentation stripping inside parentheses exactly as it does
# outside them: the lexer's EOL filter inside parens must not drop the EOL tokens
# the tokenizer emits between string chunks. Each literal is printed beside its
# unparenthesised twin, in brackets so a lost newline or a kept indent shows.

# tag -- the literal in angle brackets, so a call argument is covered too.
tag: function {s: StringView} out String is {
    return "<\{s}>"
}

main: function is {
    bare: """
        abc
        def
        """
    wrapped: ("""
        abc
        def
        """)
    print "[\{bare}]"
    print "[\{wrapped}]"
    x: 7
    ibare: "
        x=\{x}
        y
        "
    iwrapped: ("
        x=\{x}
        y
        ")
    print "[\{ibare}]"
    print "[\{iwrapped}]"
    print (tag s: """
        one
        two
        """)
}
