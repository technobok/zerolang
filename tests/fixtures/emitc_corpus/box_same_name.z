# box_same_name.z -- two units each declare a record `pt`, and a program boxes
# one of each. A Box's element was found by cutting the element's NAME out of
# the instance's name and resolving it, so both Boxes held whichever `pt` the
# name found first and gcc refused the other's assignment. The element is the
# instance's type argument.
main: function is {
    bl: Box from: (box_name_left.mk x: 1)
    br: Box from: (box_name_right.mk a: 10)
    print "x=\{bl.x} c=\{br.c}"
}
