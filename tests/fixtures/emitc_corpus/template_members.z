# template_members.z -- a template body sees the template's OWN members: a
# method calls a sibling method by bare name (the instance walk substitutes
# the mono's member, so its parameters and return carry the argument), and
# reads a template-level constant, which resolves once in the template's frame
# and inlines in every instance.
scaler: unit as {
    t: anyval.generic
    K: 2
    twice: function {v: t} out t is { return v + v }
    quad: function {v: t} out t is { return (twice (twice v)) }
    kay: function out i64 is { return K }
}

isc: (scaler t: i64)
fsc: (scaler t: f64)

main: function is {
    print "\{isc.quad 5} \{isc.kay} \{fsc.quad 1.5}"
}
