# A typedef over a generic INSTANCE (`Bytes` over `ListVal u8`, `ByteView` over
# `ListViewVal u8`, a user class over `ListRef String`) is built from exactly
# that instance, and the result is the value re-typed -- not an empty
# collection of the typedef's type.
Names: typedef ListRef String

mk: function out Bytes is {
    xs: ListVal u8
    xs.append from: 65
    xs.append from: 66
    return (Bytes xs)
}

main: function is {
    xs: ListVal u8
    xs.append from: 65
    b: Bytes xs
    ys: ListVal u8
    ys.append from: 1
    ys.append from: 2
    c: Bytes.create from: ys.take
    lv: c.listView
    bv: ByteView lv
    ns: ListRef String
    ns.append from: "a".string
    n: Names ns
    r: mk
    zs: ListVal u8
    zs.append from: 9
    b = Bytes zs
    print "bytes=\{b.length} create=\{c.length} view=\{bv.length} names=\{n.length} returned=\{r.length}"
}
