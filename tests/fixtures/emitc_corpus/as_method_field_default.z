# as_method_field_default.z -- a field declared by the name of a function in
# its type's `as` block is a function slot defaulting to that function, as one
# named after an `is`-block function is (record_method_ref_default.z). The
# fields attach before the `as` block does, so the field forces the function's
# signature first, and the function keeps it: called directly beside the slot,
# it is still the type's member. Record and class, a plain function and one
# taking the receiver; a construction that omits the slots, one that supplies
# them, and a reassignment.

Rec: record { v: i64  plain: helper  recv: twice } as {
    helper: function {n: i64} out i64 is { return n + 1 }
    other: function {n: i64} out i64 is { return n * 100 }
    twice: function {r: this} out i64 is { return r.v * 2 }
    thrice: function {r: this} out i64 is { return r.v * 3 }
}

Obj: class { v: i64  plain: helper  recv: twice } as {
    helper: function {n: i64} out i64 is { return n + 2 }
    twice: function {o: this.view} out i64 is { return o.v * 2 }
    thrice: function {o: this.view} out i64 is { return o.v * 3 }
}

main: function is {
    r: Rec v: 3
    print "rec default: \{r.plain n: 4} \{r.recv}"
    print "rec direct: \{Rec.helper n: 1} \{r.twice}"
    s: Rec v: 5 plain: Rec.other.copy recv: Rec.thrice.copy
    print "rec supplied: \{s.plain n: 4} \{s.recv}"
    r.recv = Rec.thrice.copy
    print "rec reassigned: \{r.recv}"
    o: Obj v: 7
    print "class default: \{o.plain n: 4} \{o.recv}"
    print "class direct: \{Obj.helper n: 1} \{o.twice}"
    o.recv = Obj.thrice.copy
    print "class reassigned: \{o.recv}"
}
