# A variant of two payload-less arms is laid out as a C `bool`, and a typedef
# is laid out as the end of its chain: a match over the typedef (`hand`) is
# written as a test of that bool, as one over the variant is -- not a `switch`
# on a bool, which gcc warns about (-Wswitch-bool). A typedef of a union is
# matched on its base's tag.
Shape: union {
    circle: i64
    label: String
    dot: null
}

Fig: typedef Shape

side: variant {
    left: null
    right: null
}

hand: typedef side

name: function {f: Fig} out String is {
    match f case circle then {
        return "circle \{f}"
    } case label then {
        return "label \{f}"
    } case dot then {
        return "dot".string
    }
}

which: function {h: hand} out StringView is {
    match h case left then {
        return "left"
    } case right then {
        return "right"
    }
}

main: function is {
    a: Fig (Shape.circle 3)
    b: Fig (Shape.label "x".string)
    print (name f: a)
    print (name f: b)
    print (which h: (hand side.left))
    r: match a case circle then a + 1 else 0
    print "\{r}"
}
