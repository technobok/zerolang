# view_native_names_elsewhere.z -- members spelled like the String/StringView
# natives -- split, lines, parseI64, substring -- on a type of the program's
# own. The runtime those natives need is registered ahead of emission by
# NAME, and before that registration asked for the receiver it pulled the
# split and lines iterator fragments into a program that has no Splitter or
# LinesIter, and failed at their holes. A member of one of those names on any
# other type is that type's own, and needs no runtime.

# answers to the view natives' names with plain arithmetic
Measure: class {
    # the quantity every member reads
    n: u64
} as {
    # what is left past `at`
    split: function {t: this.view at: u64} out u64 is {
        return t.n - at
    }
    # one past the quantity
    lines: function {t: this.view} out u64 is {
        return t.n + 1
    }
    # the quantity doubled
    parseI64: function {t: this.view} out u64 is {
        return t.n * 2
    }
    # what is left past `from`
    substring: function {t: this.view from: u64} out u64 is {
        return t.n - from
    }
}

main: function is {
    m: Measure n: 10
    a: m.split at: 3
    b: m.lines
    c: m.parseI64
    d: m.substring from: 4
    print "\{a} \{b} \{c} \{d}"
}
