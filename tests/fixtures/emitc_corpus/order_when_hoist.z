# A `when` chain short-circuits: a condition past the first runs only when the
# ones before it held. A condition whose argument needs a temporary -- here an
# owned String passed to a `.view` parameter -- used to have that temporary
# built before the whole `if`, so its call ran on the path the chain skipped.
# Each temporary is now built where its condition is evaluated.
mks: function {n: i64} out String is {
    print "s\{n}"
    return "x\{n}"
}

lenv: function {a: String.view} out u64 is {
    return a.length
}

lt: function {a: u64 b: u64} out bool is {
    return a < b
}

main: function is {
    shut: false
    open: true
    if shut when (lt a: 1 b: (lenv a: (mks n: 1))) then print "never"
    if open when (lt a: 1 b: (lenv a: (mks n: 2))) when (lt a: 9 b: (lenv a: (mks n: 3))) then print "never"
    if open when (lt a: 1 b: (lenv a: (mks n: 4))) when (lt a: 1 b: (lenv a: (mks n: 5))) then print "both held"
    if shut then {
        print "never"
    } else if open when (lt a: 9 b: (lenv a: (mks n: 6))) then {
        print "never"
    } else if (lt a: 1 b: (lenv a: (mks n: 7))) then {
        print "third clause"
    }
    print "end"
}
