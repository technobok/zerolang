# span_array_field.z -- an array's inline storage lent as a window or a view,
# where the array is a field of a record: written from a `:this` method while a
# sibling field is written beside it, read back through listView and slice, and
# written in part through mutSlice. The array is a value, so the window lends
# the place it lives; a copy of the record taken earlier keeps its own elements.

# a four-word number with an exponent beside it
quad: record {
    # the words, low first
    limbs: (array t: u64 to: 4)
    # how far the words are shifted
    exp: i32
} as {
    # add one to the low word, and to the exponent beside it
    bump: function {:this} is {
        w: this.limbs.mutView
        w.set i: 0 item: (w.get i: 0) + 1
        this.exp = this.exp + 1
    }
}

main: function is {
    q: quad limbs: (array t: u64 to: 4) exp: 0
    before: q
    {
        w: q.limbs.mutView
        q.exp = 5
        w.set i: 3 item: 9
        w.set i: 1 item: 2
    }
    q.bump
    {
        v: q.limbs.listView
        print "words \{v.get i: 0} \{v.get i: 1} \{v.get i: 2} \{v.get i: 3} exp \{q.exp}"
    }
    {
        m: q.limbs.mutSlice from: 1 to: 3
        m.fill item: 4
    }
    {
        s: q.limbs.slice from: 1 to: 4
        print "slice \{s.length} \{s.get i: 0} \{s.get i: 2}"
    }
    print "copy \{before.limbs.get i: 3} \{before.exp}"
}
