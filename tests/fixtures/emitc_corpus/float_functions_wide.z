# float_functions_wide.z -- the everyday float functions at f16 and f128, the
# two widths only gcc and clang build. An f16 function is computed in f32 and
# rounded once to f16; an f128 one is libquadmath's. Each is checked against the
# exact value rounded once to its width: an exact operation to the bit, a
# transcendental one within the ulps the library allows.

# a bit pattern turned into a position on the number line, so the distance
# between two positions is how many values lie between: the negatives count
# down from the middle, the positives up, and -0 and 0 meet there
ordered16: function {b: u16} out u16 is {
    mag: b & 32767
    if (b >> 15) == 1 then return 32768.u16 - mag
    return mag + 32768
}

# the f128 positions, as ordered16 gives f16's
ordered128: function {b: u128} out u128 is {
    top: 1.u128 << 127
    mag: b & (top - 1)
    if (b >> 127) == 1 then return top - mag
    return mag + top
}

# an f128 bit pattern written as its two words, high first: an integer literal
# is read in 64 bits
wide128: function {hi: u64 lo: u64} out u128 is {
    return (hi.u128 << 64) | lo.u128
}

# `ok`, or the bits got and wanted and how many values apart they are
check16: function {name: StringView got: f16 want: u16 tol: u16} is {
    x: ordered16 b: got.bits
    y: ordered16 b: want
    gap: 0.u16
    if x >= y then gap = x - y else gap = y - x
    if gap <= tol then {
        print "\{name} ok"
    } else {
        print "\{name} MISMATCH \{got.bits} \{want} \{gap} ulps"
    }
}

# check16 at f128
check128: function {name: StringView got: f128 want: u128 tol: u128} is {
    x: ordered128 b: got.bits
    y: ordered128 b: want
    gap: 0.u128
    if x >= y then gap = x - y else gap = y - x
    if gap <= tol then {
        print "\{name} ok"
    } else {
        print "\{name} MISMATCH \{got.bits} \{want} \{gap} ulps"
    }
}

# the NaN, the infinities and the two zeros through every predicate, at both
# widths
specials: function is {
    hn: (0.0.f16 - 1.0.f16).sqrt
    hi: 1.0.f16.scaleB n: 100
    hz: -0.0.f16
    print "f16 isNaN \{hn.isNaN} isInf \{hi.isInf} isFinite \{hi.isFinite} \{hz.isFinite} signBit \{hz.signBit}"
    print "f16 min nan \{(hn.min y: 1.0.f16) == 1.0.f16} roundEven \{2.5.f16.roundEven == 2.0.f16}"
    qn: (0.0.f128 - 1.0.f128).sqrt
    qi: 1.0.f128.scaleB n: 20000
    qz: -0.0.f128
    print "f128 isNaN \{qn.isNaN} isInf \{qi.isInf} isFinite \{qi.isFinite} \{qz.isFinite} signBit \{qz.signBit}"
    print "f128 min nan \{(qn.min y: 1.0.f128) == 1.0.f128} roundEven \{2.5.f128.roundEven == 2.0.f128}"
    # the product rounds to 1, where fma keeps the -2^-224 it was below 1 by
    e: 1.0.f128.scaleB n: (0 - 112)
    a: 1.0.f128 + e
    b: 1.0.f128 - e
    m1: 0.0.f128 - 1.0.f128
    print "f128 fma \{(a.fma y: b z: m1) == (0.0.f128 - (1.0.f128.scaleB n: (0 - 224)))} product \{((a * b) - 1.0.f128) == 0.0.f128}"
}

