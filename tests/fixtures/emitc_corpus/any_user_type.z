# There is no builtin `Any`, so a unit may name its own type `Any` as it may
# any other name, and it resolves like any user type. As a bound it would be
# refused the way every record is (a record has no `.generic`), so it is used
# here only as a type.
Any: record {
    n: u64
}
show: function {a: Any} out u64 is {
    return a.n
}
main: function is {
    a: Any n: 7
    print "\{show :a}"
}
