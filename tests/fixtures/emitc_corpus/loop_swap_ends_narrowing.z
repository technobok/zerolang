# loop_swap_ends_narrowing -- a swap in a loop writes both its sides: a narrowing of
# either ends at the loop's entry, so a read in the loop BEFORE the swap sees the
# declared type -- the previous iteration may have swapped another arm in
half: function {n: i64} out optionval i64 is {
    if (n % 2) == 0 then return (optionval.some n / 2)
    return (optionval.none i64)
}

left: function {n: i64} is {
    x: half n: 8
    y: half n: 3
    if x.none then return
    print "narrowed \{x + 1}"
    k: 0
    for k < n loop {
        match x case some then print "left some \{x}" case none then print "left none"
        x swap y
        k = k + 1
    }
}

right: function {n: i64} is {
    x: half n: 8
    y: half n: 3
    if x.none then return
    print "narrowed \{x + 1}"
    k: 0
    for k < n loop {
        match x case some then print "right some \{x}" case none then print "right none"
        y swap x
        k = k + 1
    }
}

main: function is {
    left n: 2
    right n: 2
}
