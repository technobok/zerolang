# A method called through its type, `T.m v`, is the call on its receiver,
# `v.m`: a member that takes only its receiver reads the same through the type
# as through the value, a protocol's methods dispatch through the protocol, and
# a literal receiver first takes the type, as it would as the type's argument
# -- `i64.u64 5` converts the i64 5 and answers a result.

# Shape -- a protocol with a method that takes only its receiver, and one that
# takes another argument
Shape: protocol {
    area: function {s: this.view} out i64
    scaled: function {s: this.view by: i64} out i64
}

# Sq -- a square implementing Shape
Sq: record {
    side: i64
} as {
    shape: Shape.implement
    area: function {s: this.view} out i64 is {
        return s.side * s.side
    }
    scaled: function {s: this.view by: i64} out i64 is {
        return s.side * by
    }
}

# Counter -- a class whose methods write and read it
Counter: class {
    n: i64
} as {
    bump: function {c: this} is {
        c.n = c.n + 1
    }
    get: function {c: this.view} out i64 is {
        return c.n
    }
}

# total -- the protocol's methods called through the protocol
total: function {sh: Shape.view} out i64 is {
    return (Shape.area sh) + (Shape.scaled sh by: 10)
}

# count -- an instance's member called through the instance's type
count: function as {t: anyval.generic} in {xs: ListVal t} out u64 is {
    return ((ListVal t).length xs)
}

main: function is {
    xs: List String
    xs.append "a".string
    ys: ListVal i64
    ys.append 4
    ys.append 5
    print "\{xs.length} \{(List String).length xs} \{(ListVal i64).length ys} \{(
        ((ListVal i64).capacity ys) >= 2
    )}"
    s: "hello"
    w: "hi".string
    print "\{StringView.length s} \{String.length w} \{StringView.length "abc"}"
    b: 7.u8
    f: 2.0
    k: 6.u64
    print "\{u8.u64 b} \{f64.sqrt f} \{u64.popCount k}"
    print "\{(i64.u64 5).orPanic} \{(i64.u32 (2 + 3)).orPanic} \{(i64.u64 -5).err}"
    c: Counter n: 1
    Counter.bump c
    print "\{Counter.get c} \{c.get}"
    q: Sq side: 3
    print "\{total sh: q} \{Sq.area q} \{Sq.scaled q by: 2} \{Sq.scaled by: 4 s: q}"
    zs: ListVal u8
    zs.append 1
    print "\{count xs: ys} \{count xs: zs}"
}
