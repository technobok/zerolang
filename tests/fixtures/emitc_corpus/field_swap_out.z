# field_swap_out -- a field's value comes out by swapping an empty one in: a bare
# type name constructs it, and `swap` exchanges the two, so the binding owns the
# String or the collection from then on and the holder's field holds the empty
# value its destructor frees. Printed after the swap so the value is read
# through its new owner, and the holder is still alive to be destroyed
# afterwards.
Holder: class {
    s: String
    xs: (ListVal u32)
    names: (List String)
}

main: function is {
    h: (Holder s: "abc".string xs: (ListVal u32) names: (List String))
    h.xs.append 7
    h.xs.append 8
    h.names.append "n1".string
    s2: String
    s2 swap h.s
    print s2
    xs2: ListVal u32
    xs2 swap h.xs
    print "\{xs2.length}"
    names2: List String
    names2 swap h.names
    print "\{names2.length}"
    print "\{h.xs.length} \{h.names.length} '\{h.s}'"
}
