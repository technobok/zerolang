# A data type's generated `==` compares each part with that part's own `==`: a
# field or a choice arm holding a data type whose `==` is written calls it with
# the handle the data value already is.
inner: data {
    v: 3.u8
} as {
    ==: function {:this rhs: inner} out bool is {
        return (this.v % 2) == (rhs.v % 2)
    }
}
outer: data {
    n: 5
    sub: inner
}
pick: choice {
    one: inner
    none: null
}
A: (outer sub: (inner v: 1))
B: (outer sub: (inner v: 3))
C: (outer sub: (inner v: 2))
P1: pick.one (inner v: 1)
P2: pick.one (inner v: 5)
P3: pick.one (inner v: 2)

same: function {a: outer b: outer} out bool is {
    return a == b
}

sameP: function {a: pick b: pick} out bool is {
    return a == b
}

main: function is {
    print "\{same a: A b: B} \{same a: A b: C} \{sameP a: P1 b: P2} \{sameP a: P1 b: P3} \{A.sub == C.sub}"
}
