# typedef_declarator.z -- `T: typedef Base`, the declarator form. The family is
# the base's: an id over u64 is a valtype that writes its own `==` and `hash`
# and keys a map; a name over String and a buffer over `ListVal u8` are
# reftypes that reach the base's methods; a typedef over a user record reads
# the base's field and passes where the base is expected.
tag: typedef u64 as {
    ==: function {t: this.view rhs: tag} out bool is { return t.u64 == rhs.u64 }
    hash: function {t: this.view} out u64 is { return t.u64 % 7 }
}

Name: typedef String
Buf: typedef is ListVal u8
pt: record { n: u64 }
ptAlias: typedef pt

nOf: function {p: pt} out u64 is { return p.n }

main: function is {
    a: tag 5
    b: tag 12
    print "tag \{a} \{a == b} \{a == (tag 5)}"
    seen: MapVV tag v: u64
    seen.set key: a value: 1
    seen.set key: b value: 2
    print "keys \{seen.length}"
    nm: Name "abc".string
    print "name \{nm.count}"
    buf: Buf
    buf.append from: 7
    buf.append from: 9
    print "buf \{buf.length}"
    p: ptAlias (pt n: 3)
    print "pt \{p.n} \{nOf :p}"
}
