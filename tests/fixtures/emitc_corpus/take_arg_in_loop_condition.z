# A `.take` argument inside a LOOP condition moves its source on every
# evaluation, so the zeroing follows the call inside the loop: the next
# iteration hands the callee the emptied value, and the scope-exit destructor
# frees nothing twice. A conjunct that never ran leaves its source owned.
eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
nope: function out bool is {
    return false
}
main: function is {
    e: (ListVal u32)
    e.append 1
    n: 0
    for while (eat xs: e) loop {
        n = n + 1
        print "while \{n}"
    }
    p: (ListVal u32)
    p.append 1
    k: 0
    for loop {
        k = k + 1
        print "post \{k}"
    } while (eat xs: p)
    q: (ListVal u32)
    q.append 1
    m: 0
    for while m < 5 while (eat xs: q) loop {
        m = m + 1
        print "chain \{m}"
    }
    r: (ListVal u32)
    r.append 1
    for while nope while (eat xs: r) loop {
        print "never"
    }
    print "done"
}
