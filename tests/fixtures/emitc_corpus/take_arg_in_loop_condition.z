# A `.take` argument inside a LOOP condition moves its source when the
# condition runs, so the zeroing follows the call inside the loop. The
# checker admits the shape only when the body always leaves the loop, so
# the condition runs at most once. (A do-while postcondition has no legal
# live shape: it runs after every body, so a move there always reaches the
# next iteration.) A conjunct that never ran leaves its source owned, and
# the scope-exit destructor frees nothing twice.
eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
nope: function out bool is {
    return false
}
main: function is {
    e: (ListVal u32)
    e.append 1
    n: 0
    for while (eat xs: e) loop {
        n = n + 1
        print "while \{n}"
        break
    }
    q: (ListVal u32)
    q.append 1
    m: 0
    for while m < 5 while (eat xs: q) loop {
        m = m + 1
        print "chain \{m}"
        break
    }
    r: (ListVal u32)
    r.append 1
    for while nope while (eat xs: r) loop {
        print "never"
        break
    }
    print "done"
}
