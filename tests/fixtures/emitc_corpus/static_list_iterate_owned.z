# static_list_iterate_owned.z -- a static list's element belongs to whoever
# reads it: the list lives as long as the program and nothing writes it. A walk
# hands each element out as its own value, so a text element goes into a
# container that takes it, as the same literal written in place does, and a
# number is the loop var's own copy.

names: list { first: "alpha" second: "beta" third: "alpha" } out staticlist text
sizes: list { 3 5 8 } out staticlist u8

# a generator whose walk suspends saves the element itself across the yield
Twice: generator { k: u64 } as {
    call: function out text is {
        for each n: names loop {
            yield n
            yield n
        }
    }
}

main: function is {
    seen: MapVV text v: u8
    for each n: names loop seen.set key: n value: 1
    print "distinct \{seen.length}"

    kept: ListVal text
    for each n: names loop kept.append n
    print "kept \{kept.length}"

    total: u8
    for each s: sizes loop {
        t: s
        total = total + t
    }
    print "total \{total}"

    # a named iterator read bare is its call: the plain binding walks it
    found: ListVal text
    with it: names.iterate do for n: it loop found.append n
    print "found \{found.length}"
    for each w: (Twice k: 0) loop print "twice \{w}"
}
