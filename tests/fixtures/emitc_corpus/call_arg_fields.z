# What the one-appearance rule leaves alone, now that a field argument's lock is
# held by the call: two fields of one value are two values, even where the
# callee writes through both; two views of one field only read it; a view into
# a field passes beside a read-only owner; and a copy (`s.copy`) holds nothing
# of its source, which the same call may move.
Item: class {
    v: i64
}

Pair: class {
    a: Item
    b: Item
}

Holder: class {
    s: String
}

bump: function {x: Item y: Item} is {
    x.v = x.v + 10
    y.v = y.v + 20
}

views: function {a: String.view b: String.view} is {
    print "\{a}=\{b}"
}

peek: function {a: StringView h: Holder.view} is {
    print "\{a} of \{h.s}"
}

keep: function {a: String t: String.take} is {
    print "\{a} \{t}"
}

main: function is {
    p: Pair a: (Item v: 1) b: (Item v: 2)
    bump x: p.a y: p.b
    print "\{p.a.v} \{p.b.v}"
    h: Holder s: "field".string
    views a: h.s b: h.s
    peek a: (h.s.substring from: 0 to: 3) :h
    s: "fresh".string
    keep a: s.copy t: s.take
}
