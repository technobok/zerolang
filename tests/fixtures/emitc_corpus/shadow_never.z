# shadow_never.z -- `never` is predefined, not a keyword: a user record of that
# name is an ordinary record. It is returned and bound like any value, while the
# system's `never` -- the type of `return`, and of a loop that can end without
# one -- keeps working beside it.

never: record { y: i64 }

mk: function {v: i64} out never is {
    return (never y: v)
}

count: function {lim: i64} out i64 is {
    i: 0
    for i < lim loop {
        if i == 3 then return i
        i = i + 1
    }
    return lim
}

main: function is {
    n: mk v: 4
    print "y=\{n.y} c=\{count lim: 10}"
}
