# A CONTROL VALUE RUNS AFTER WHAT IS WRITTEN BEFORE IT. A `match` or an `if`
# with block arms used as a value is no C expression, so it runs as statements
# ahead of the statement it sits in. Everything the statement evaluates before
# it -- a call with an effect, a read of a local one of its arms moves or
# changes -- is made a statement first, in the order it is written; what comes
# after it stays in the statement.
Mode: variant {
    fast: null
    slow: null
}

# tick -- prints, and answers its argument: a call with an effect
tick: function {n: u64} out u64 is {
    print "tick \{n}"
    return n
}

# keep -- takes the String it is given
keep: function {s: String.take} out u64 is {
    return s.length
}

add3: function {a: u64 b: u64 c: u64} out u64 is {
    return a + b + c
}

main: function is {
    m: Mode.fast
    s: "moved".string
    # the left operand reads `s` before the arm moves it
    a: (tick n: s.length) + (keep s: (match (m) case fast then {
        print "arm"
        s.take
    } case slow then "slow".string))
    print "a \{a}"
    n: 1.u64
    # the arm changes `n` after the first argument read it; the last argument
    # reads it after
    b: add3 a: (tick n: n) b: (match (m) case fast then {
        n = n + 10
        n
    } case slow then 0) c: (tick n: n)
    print "b \{b}"
    print "end"
}
