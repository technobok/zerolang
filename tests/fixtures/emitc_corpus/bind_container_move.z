# bind_container_move.z -- `b: a.take` where `a` is an owned container is a
# MOVE: `b` holds the elements and `a`'s scope-exit destroy must no-op. The
# binding emitter recognised only call-shaped and dotted-path values, so a bare
# name fell through to the capacity default and built an EMPTY container
# instead. `.take` is the only spelling that moves -- the bare `b: a` form
# borrows, which binding_borrows_by_default pins.

consume: function {xs: (List String).take} out List String is {
    ys: xs.take
    ys.append from: "moved".string
    return ys
}

main: function is {
    a: (List String)
    a.append from: "one".string
    a.append from: "two".string
    b: a.take
    print "list=\{b.length}"

    m: (Map String V: String)
    m.set key: "k".string value: "v".string
    n: m.take
    print "map=\{n.length}"

    s: (Set String)
    s.add item: "x".string
    t: s.take
    print "set=\{t.length}"

    p: (List String)
    p.append from: "held".string
    q: consume xs: p
    print "take=\{q.length}"
}
