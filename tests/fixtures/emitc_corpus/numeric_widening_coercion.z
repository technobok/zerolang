# numeric_widening_coercion.z -- the ACCEPTED side of the conversion rule, which
# the error fixtures can only pin by their absence. system.z declares a lossless
# conversion with a plain return (`i64.i128` is `out i128`) and a lossy one with
# `(resultval t: X e: converror)`, and coercion at a typed destination follows
# exactly that: every widening below passes in silence, and a literal that fits
# its destination coerces as it always has.
#
# The twin is tests/fixtures/errors/narrowing_conversion.z. Both must hold, or
# the rule has become either a leak or a wall.
u64Takes: function {n: u64} out u64 is { return n }
i64Takes: function {n: i64} out i64 is { return n }
f64Takes: function {n: f64} out f64 is { return n }

Holder: class {
    wide: u64
}

main: function is {
    a: 7.u8
    b: 3.i32
    c: 1.5.f32
    print "widened \{u64Takes n: a} \{i64Takes n: b} \{f64Takes n: c}"

    # a literal that fits its destination still coerces, bare and negative
    print "fits \{u64Takes n: 5} \{i64Takes n: -5}"

    # the same rule at an assignment and at a construction
    h: Holder wide: a
    h.wide = a
    print "slot \{h.wide}"
}
