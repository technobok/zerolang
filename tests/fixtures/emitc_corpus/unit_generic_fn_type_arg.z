# inside a generic unit's instance, a generic function called with the unit's
# own parameter as an explicit type argument binds the instance's type -- the
# same type its value arguments carry -- for the unit's functions and for the
# methods of a type the unit declares, beside a concrete type argument.
mk: function as { t: anyval.generic } in { a: t } out (ListVal t: t) is {
    l: (ListVal t: t)
    l.append from: a
    return l
}
G: unit as {
    t: anyval.generic
    grow: function {a: t} out (ListVal t: t) is {
        l: mk t: t a: a
        l.append from: a
        return l
    }
    both: function {a: t} out u64 is {
        l: mk t: u8 a: 5
        m: mk t: t a: a
        return l.length + m.length
    }
    Cell: class {
        v: t
    } as {
        many: function {c: this} out u64 is {
            l: mk t: t a: c.v
            l.append from: c.v
            l.append from: c.v
            return l.length
        }
    }
}
gi: (G t: i64)
gu: (G t: u16)
main: function is {
    l: gi.grow a: 2
    c: gu.Cell v: 3
    print "\{l.length} \{gi.both a: 4} \{gu.both a: 5} \{c.many}"
}
