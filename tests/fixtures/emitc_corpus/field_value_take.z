# `.take` and `.hold` on a FIELD holding a value -- a number, a record's field --
# hand on the field's own value. The marker was spelled as a member the struct
# does not have (`z_v2.n.take`).
Pt: record {
    x: i64
    y: i64
}

Box: class {
    n: i64
    at: Pt
    label: String
}

main: function is {
    b: Box n: 7 at: (Pt x: 1 y: 2) label: "box".string
    n: b.n.take
    p: Pt x: 3 y: 4
    x: p.x.take
    y: p.y.hold
    corner: b.at.take
    print "\{n} \{x} \{y} \{corner.x} \{corner.y} \{b.label}"
}
