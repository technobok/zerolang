# What a borrow may be given: a borrowed typedef is re-pointed at another
# value's borrow and stays writable; a writable borrow re-pointed at an `if`
# whose arms lock one place at two strengths, exclusive and shared, holds it
# once, exclusive, and may write through; and an `outx` result may come from a
# plain call whose argument shares a name with one of the result's fields.
Box: class {
    v: i64
}

get2: function {a: Box.borrow b: Box.view} outx Box.borrow is {
    a.v = a.v + b.v
    return a
}

W: class {
    s: String.borrow
}

mkW: function {src: String.borrow s: i64} outx W is {
    return (W s: src)
}

wrap: function {p: String.borrow} outx W is {
    return (mkW src: p s: 5)
}

typedefRepoint: function is {
    xs: ListVal u8
    ys: ListVal u8
    b: Bytes xs.borrow
    b.append from: 1
    b = Bytes ys.borrow
    b.append from: 2
    print "\{b.length}"
}

ifRepoint: function is {
    q: Box v: 1
    v: Box v: 2
    w: Box v: 3
    c: q.v > 0
    x: q
    x = if c then w else get2 a: v b: w
    x.v = 10
    print "\{x.v}"
}

main: function is {
    typedefRepoint
    ifRepoint
    p: "x".string
    w: wrap :p
    print "\{w.s}"
}
