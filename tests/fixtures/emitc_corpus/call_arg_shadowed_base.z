# A DOTTED BASE IS RESOLVED IN THE ENVIRONMENT, NEVER BY ITS SPELLING. A local
# binding that shadows a type name is a VALUE, so the call is a method call on
# that value and the receiver comes through the dot -- the unlabelled argument
# is then the first declared NON-receiver parameter, exactly as for any other
# method call. Valtypes are lowercase by convention, so a local is often named
# after its type: the type is then reached through its unit
# (`point: call_arg_shadowed_base.point x: 10`), since the local's own name
# finds the local, and the two readings are told apart by the lookup rather
# than by the name.
point: record {
    x: i64
} as {
    plusit: function {t: this a: i64} out i64 is {
        return t.x + a
    }
}

main: function is {
    point: call_arg_shadowed_base.point x: 10
    a1: point.plusit 2
    a2: point.plusit a: 5
    print "shadowed \{a1} \{a2}"
}
