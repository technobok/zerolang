# A METHOD WHOSE ONLY PARAMETER IS ITS RECEIVER is called without arguments
# through the dot, and function style on the type with the receiver as the one
# unlabelled argument or under its declared name. A method with a parameter after
# the receiver takes the unlabelled argument there.
pt: record { x: i64 } as {
    first: function {:this} out i64 is {
        return this.x
    }
    plus: function {:this n: i64} out i64 is {
        return this.x + n
    }
}

twin: record { x: i64 } as {
    first: function {t: this.view} out i64 is {
        return t.x
    }
}

main: function is {
    p: pt x: 1
    tw: twin x: 2
    xs: ListVal i64
    xs.append 5
    s: "abc".string
    print "\{p.first} \{pt.first p} \{pt.first this: p} \{(p.plus 3)} \{pt.plus p n: 4}"
    print "\{tw.first} \{twin.first tw} \{twin.first t: tw}"
    print "\{xs.length} \{s.length} \{s.copy}"
}
