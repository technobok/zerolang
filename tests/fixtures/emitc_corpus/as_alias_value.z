# AN `as` ALIAS READ AS A VALUE CONSTRUCTS, AS THE TYPE'S OWN NAME DOES: a path
# through a type to its alias (`Canvas.P`, `shapes.Grid.Cell`) in value
# position is the zero-argument construction of the type it names -- a binding,
# an argument, a return, an appended element alike, and a scalar or String
# alias is its zero. Such a path emitted no C value at all, since an `as` item
# is declared as a member and the emitter read it as a field.
shapes: unit as {
    Grid: record {
        w: i64
    } as {
        Cell: point
    }
    point: record {
        x: 3
        y: 4
    }
}

point: record {
    x: 1
    y: 2
}

Canvas: class {
    used: u32
} as {
    P: point
    Count: u32
    Name: String
    origin: function {c: this.view} out P is {
        return P
    }
}

sum: function {p: point} out i64 is {
    return p.x + p.y
}

fresh: function out point is {
    return Canvas.P
}

main: function is {
    a: Canvas.P
    c: Canvas used: 0
    l: ListVal point
    l.append Canvas.P
    n: Canvas.Count
    s: Canvas.Name
    g: shapes.Grid.Cell
    print "\{a.x} \{sum p: Canvas.P} \{fresh.y} \{l.length} \{(c.origin).x} \{n} [\{s}] \{g.x}"
}
