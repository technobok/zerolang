# comprehension_dispatch.z -- a `for` used as an EXPRESSION walks whatever the
# statement form walks.
#
# It used to emit one shape of its own -- a counted `N.times` header, and one
# that re-read its bound after emitCountedRangeFor had stopped doing that --
# and for every other source it emitted NOTHING, leaving the already-created
# list empty with no diagnostic. Five shapes answered `len 0`: a container
# iterator, a closed range, a bare condition, a `while:` arm, and a do-while.
#
# Now the target is recorded against the loop's BODY NODE and emitForStmt is
# asked for the loop, so every shape reaches the emitter it reaches as a
# statement, and brings the loop labels, the arms, the scope destroys and the
# per-iteration cleanup with it. `Words` is the one that needs the cleanup: its
# element is OWNED, so the append moves it and the loop's own payload destroy
# must not run again -- it was a double free before the move was zeroed.
#
# `snapshot` pins what the shared lowering buys: the count is read ONCE, so a
# body that writes the bound does not steer the loop it is running in.
# the TAIL position is the comprehension's other entry point
# (emitControlBindValue), and it declined every non-counted source too
tripled: function {src: (ListVal i64).view} out (ListVal i64) is {
    for each e: src.iterate loop e * 3
}

Words: generator {} as {
    call: function out String is {
        yield "a".string
        yield "b".string
    }
}

main: function is {
    xs: ListVal i64
    xs.append from: 5
    xs.append from: 7

    iter: for each e: xs.iterate loop e * 2
    print "iter \{iter.length}"
    for each v: iter.iterate loop print "  \{v}"

    tail: tripled src: xs
    print "tail \{tail.length}"
    for each v: tail.iterate loop print "  \{v}"

    n: 3
    closed: for each i: (0.upto to: n) loop i * 10
    print "closed \{closed.length}"
    for each v: closed.iterate loop print "  \{v}"

    down: for each i: (2.downto to: 0) loop i
    print "down \{down.length}"
    for each v: down.iterate loop print "  \{v}"

    counted: for each i: n.times loop i + 1
    print "counted \{counted.length}"
    for each v: counted.iterate loop print "  \{v}"

    k: 0
    bare: for k < 3 loop {
        k = k + 1
        k * 100
    }
    print "bare \{bare.length}"
    for each v: bare.iterate loop print "  \{v}"

    armed: for each x: 5.times while x < 3 loop x * 2
    print "armed \{armed.length}"
    for each v: armed.iterate loop print "  \{v}"

    j: 0
    dw: for loop {
        j = j + 1
        j
    } while j < 3
    print "dw \{dw.length}"
    for each v: dw.iterate loop print "  \{v}"

    none: for each x: 0.times loop x
    print "none \{none.length}"

    g: (Words)
    owned: for each e: g loop e
    print "owned \{owned.length}"
    for each s: owned.iterate loop print "  \{s}"

    texts: for each x: 2.times loop "v\{x}"
    print "texts \{texts.length}"
    for each s: texts.iterate loop print "  \{s}"

    src: List String
    src.append from: "p".string
    copies: for each e: src.iterate loop e.copy
    print "copies \{copies.length}"
    for each s: copies.iterate loop print "  \{s}"

    m: 3
    snapshot: for each i: m.times loop {
        m = m + 100
        i
    }
    print "snapshot \{snapshot.length} m=\{m}"
}
