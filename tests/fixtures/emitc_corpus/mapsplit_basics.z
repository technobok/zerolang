# The four Map forms side by side. They differ only where the family shows:
# a valtype key or value is passed BY VALUE rather than taken or viewed, and a
# valtype value comes back as an `optionval` -- a copy -- where a reference
# value comes back as an `OptionView` into the entry storage. `remove` returns
# an owned `Option` on the reference side and the same `optionval` on the
# value side.
#
# A StringView probes the reference-key forms through `asString` -- the
# borrowed-String projection -- so no key is materialized for the lookup.
main: function is {
    rr: (Map String value: String)
    rr.set key: "k".string value: "v".string
    krr: "k".string
    grr: rr.get key: krr
    match (
        grr
    ) case some then {
        print "rr k=\{grr}"
    } else null
    print "rr len=\{rr.length} has=\{rr.has key: krr}"

    rv: (MapRV String value: u64)
    rv.set key: "a".string value: 1
    rv.set key: "b".string value: 2
    grv: rv.get key: "b".asString
    match (
        grv
    ) case some then {
        print "rv b=\{grv}"
    } else null
    rrv: rv.remove key: "a".string
    match (
        rrv
    ) case some then {
        print "rv removed a=\{rrv}"
    } else null
    print "rv len=\{rv.length}"

    vr: (MapVR u64 value: String)
    vr.set key: 1 value: "one".string
    gvr: vr.get key: 1
    match (
        gvr
    ) case some then {
        print "vr 1=\{gvr}"
    } else null
    print "vr len=\{vr.length} has=\{vr.has key: 1}"

    vv: (MapVV u64 value: u64)
    vv.set key: 7 value: 70
    vv.set key: 9 value: 90
    gvv: vv.get key: 7
    match (
        gvv
    ) case some then {
        print "vv 7=\{gvv}"
    } else null
    rvv: vv.remove key: 7
    match (
        rvv
    ) case some then {
        print "vv removed 7=\{rvv}"
    } else null
    with kt: vv.iterate do for k: kt loop print "vv key \{k}"
    with et: vv.iterateItems do for e: et loop print "vv item \{e.key}=\{e.value}"
}
