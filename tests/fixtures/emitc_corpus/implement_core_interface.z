# A TYPE IMPLEMENTS AN INTERFACE ANOTHER UNIT DECLARES, named bare: core's
# `StringViewable` is reached through the environment, as a type-ref naming it
# is. The marker's target was looked up in this unit alone, so the name was
# found by no lookup but the walk: `.implement` refused it as no interface, and
# the bare labelled form (`sv: StringViewable`) recorded no implementation at
# all, and the value was refused where it stood in for the interface.
Name: class { s: String } as {
    sv: StringViewable.implement
    stringView: function {t: this.view} outx StringView is { return t.s.stringView }
}

show: function {v: StringViewable} is {
    print "\{v.stringView}"
}

main: function is {
    n: Name s: "hello".string
    show v: n
    show v: n.sv
}
