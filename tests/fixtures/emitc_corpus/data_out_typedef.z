# `out T` naming a scalar TYPEDEF rather than a builtin. The `out` clause is the
# programmer's explicit request for that type, so the elements are it -- reads
# bind at the typedef and reach its methods, and the block still folds its
# labels to constants.
byteid: record { val: u8.typedef } as {
    ==: function {:this rhs: byteid} out bool is {
        return this.u8 == rhs.u8
    }
}

codes: data {
    ht: 9
    lf: 10
    space: 32
} out byteid

widen: function {b: byteid} out u64 is {
    return b.u8.u64
}

main: function is {
    print "ht=\{widen b: codes.ht}"
    print "space=\{widen b: codes.space}"
    if codes.lf == codes.lf then print "eq" else print "ne"
}
