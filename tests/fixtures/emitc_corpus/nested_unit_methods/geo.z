# a hidden subunit of nested_unit_methods, declaring types with methods.
pt: record {
    x: i64
    y: i64
} as {
    sum: function {a: this} out i64 is {
        return a.x + a.y
    }
    bump: function {a: this} out pt is {
        return (pt x: a.x y: a.y + 1)
    }
    ==: function {this: this.view rhs: pt} out bool is {
        return (this.x == rhs.x) and (this.y == rhs.y)
    }
}
box: record {
    v: t
} as {
    t: anyval.generic
    twice: function {a: this} out t is {
        return a.v + a.v
    }
}
total: function {x: i64 y: i64} out i64 is {
    p: pt x: x y: y
    return p.sum
}
