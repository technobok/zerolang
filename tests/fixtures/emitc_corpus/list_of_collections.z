# A collection whose element is another collection. The early type passes
# write one family at a time -- views before lists -- so a view's iterator,
# which indexes its element, was written before the element's own struct. A
# collection holding a collection is ordered by dependency instead: a list of
# lists, a list of lists of lists, a view and an iteration over one, and a
# class field holding one.
Holder: class {
    items: List (ListVal i64)
}

main: function is {
    ll: List (ListVal i64)
    first: ListVal i64
    first.append from: 1
    first.append from: 2
    ll.append from: first.take
    second: ListVal i64
    second.append from: 3
    ll.append from: second.take
    for e: ll.iterate loop {
        print "inner length \{e.length}"
    }
    {
        g: ll.get i: 1
        print "get \{g.length}"
    }
    lv: ll.listView
    print "view length \{lv.length}"

    names: List (List String)
    words: List String
    words.append "a".string
    words.append "b".string
    names.append from: words.take
    print "list of string lists \{names.length}"

    deep: List (List (ListVal i64))
    level: List (ListVal i64)
    level.append from: (ListVal i64)
    deep.append from: level.take
    print "three levels \{deep.length}"

    h: (Holder items: (List (ListVal i64)))
    h.items.append from: (ListVal i64)
    print "class field \{h.items.length}"
}
