# public_inline_def.z -- a `public:` block is a unit body: it may DEFINE.
# From outside the surface is spelled `pubinl_host.MAX` / `pubinl_host.plusone`;
# the host's own body reaches the block by the qualified path `public.MAX`;
# inside the block a bare `MAX` is the block's own member.
main: function is {
    print "MAX=\{pubinl_host.MAX} twice=\{pubinl_host.twice} plusone=\{pubinl_host.plusone 5}"
}
