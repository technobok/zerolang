# paren_control_flow_argument.z -- a parenthesised `if` value is an ordinary
# unnamed argument. The calls below pass one as their first argument, alone and
# followed by a labelled argument, and as the value of `return`, and the value
# must arrive: the call is built from the node inside the parentheses, whatever
# shape that node has.
pad: function {s: StringView width: u64} out String is {
    acc: s.string
    for acc.length < width loop {
        acc.append "."
    }
    return acc
}

twice: function {n: i64} out i64 is {
    return n * 2
}

pick: function {wanted: bool} out i64 is {
    return (if wanted then 1 else 2)
}

main: function is {
    yes: true
    a: twice (if yes then 10 else 20)
    b: twice (if yes.not then 30 else 40)
    c: pad (if yes then "if" else "no") width: 4
    d: pad (if yes.not then "no" else "labelled") width: 10
    print "\{a} \{b} \{c}| \{d}| \{pick wanted: true} \{pick wanted: false}"
}
