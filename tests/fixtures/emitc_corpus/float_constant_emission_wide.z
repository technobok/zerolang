# AN f16 OR f128 CONSTANT REACHES C AS ITS FORMAT'S NEAREST VALUE, rounded once
# from the exact value: an f128 as 28 hexadecimal digits with `Q`, an f16 as
# the exact double that is its value, cast. `1e4000` is past every narrower
# format, and `(0.1 + 0.2).f128` a fold no lexeme spells; each is checked
# against its bit pattern.
main: function is {
    a: 1.1.f128
    b: 1e4000.f128
    c: (0.1 + 0.2).f128
    d: 0.1.f16
    e: 65519.f16
    print "\{a.bits}"
    print "\{b.bits}"
    print "\{c.bits}"
    print "\{d.bits} \{e.bits}"
}
