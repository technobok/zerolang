# A unit-level constant narrows as a local does: in a `match` arm, and in the
# branch an arm predicate guards, its bare name IS the payload the arm carries.
# The constant never changes, so the match folds to the arm it holds, as an
# `if` on a constant condition folds: only that arm runs and is walked, and an
# `error` in another arm is never reached. A guard that is seen to diverge
# rules its arm out for the rest of the body, as a local's guard does.
G: "a#b"
AT: G.indexOf "#"
NOAT: G.indexOf "%"
shape: choice {
    circle: i64
    square: i64
    dot: null
}
SH: (shape.square 4)
guarded: function out u64 is {
    if AT.none then return 0
    return AT + 10
}
main: function is {
    match AT case some then print "at \{AT}" case none then print "none"
    match NOAT case some then print "at \{NOAT}" case none then print "no #"
    match SH case circle then error "SH is a square" case square then print "side \{SH}" case dot then print "dot"
    if SH.square then print "square \{SH}" else print "not square"
    if NOAT.some then print "\{NOAT}" else print "else none"
    if AT.none then print "none" else print "else \{AT}"
    print "\{guarded}"
    side: match SH case circle then SH case square then SH * 2 case dot then 0
    print "value \{side}"
}
