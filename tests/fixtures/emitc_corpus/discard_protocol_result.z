# A protocol value owns its implementer's box. Discarded as a statement -- a
# call's result or a construction -- it is destroyed where the statement ends,
# and a protocol local ended by `.drop`, or moved out by a `.take` nothing
# receives, is destroyed there.
Shape: protocol {
    area: function {t: this.view} out u64
}

Sq: class { side: u64 name: String } as {
    shape: Shape.implement
    area: function {t: this.view} out u64 is { return t.side * t.side }
}

make: function {n: u64} out Shape is {
    q: Sq side: n name: "made".string
    print "make \{n}"
    return (Shape.create from: q.take)
}

main: function is {
    make n: 7
    Shape.create from: (Sq side: 5 name: "built".string)
    s: Shape.create from: (Sq side: 3 name: "dropped".string)
    print "area \{s.area}"
    s.drop
    u: Shape.create from: (Sq side: 4 name: "taken".string)
    u.take
    print "done"
}
