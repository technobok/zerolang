# choice_match.z -- a `match` on a choice value folds at compile time, at unit
# level: the value selects its arm, and inside that arm the subject's name
# reads the value the arm carries -- a text, an untyped number kept exact, a
# data value read through. A match nested in an arm folds too.
inner: data { v: u8 name: text }
form: choice {
    call: null
    template: text
    count: intliteral
    sub: inner
}
a: (form.template "tpl")
c: (form.count 41)
s: (form.sub (inner v: 7 name: "seven"))
k: form.call
ta: match (a) case template then a else "none"
tc: match (c) case count then c + 1 else 0
ts: match (s) case sub then s.v else 0
tsn: match (s) case sub then s.name else ""
tk: match (k) case call then 1 case template then 2 case count then 3 case sub then 4
nested: match (a) case count then c case template then (match (c) case count then c * 2 else 0) else 0
main: function is {
    print "\{ta} \{tc} \{ts} \{tsn} \{tk} \{nested}"
}
