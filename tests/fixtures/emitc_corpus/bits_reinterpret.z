# `bits` reinterprets a value as the same-width UNSIGNED integer. It is a
# REPRESENTATION reinterpretation, not a conversion: every other numeric
# conversion is a checked VALUE conversion that can fail, and that is exactly
# why both exist. `(0.i64 - 8.i64).u64` panics -- -8 is not a u64 -- while
# `(0.i64 - 8.i64).bits` is the bit pattern -8 is stored as, and cannot fail.
#
# Width-preserving, and one direction only. Sending everything to u64 would
# sign-extend first, so an i8 of -8 would read as 0xFFFFFFFFFFFFFFF8 and a
# shift of it would move 56 bits that were never part of the value.
main: function is {
    a8: (0.i8 - 8.i8)
    print "i8 -8: \{a8.bits}"
    b8: (0.i8 - 1.i8)
    print "i8 -1: \{b8.bits}"

    a16: (0.i16 - 8.i16)
    print "i16 -8: \{a16.bits}"

    a32: (0.i32 - 8.i32)
    print "i32 -8: \{a32.bits}"

    a64: (0.i64 - 8.i64)
    print "i64 -8: \{a64.bits}"
    b64: (0.i64 - 1.i64)
    print "i64 -1: \{b64.bits}"

    # a non-negative value reinterprets to itself
    p: 42.i64
    print "i64 42: \{p.bits}"

    # the floats copy their representation rather than converting it: a float
    # CAST is a value conversion that truncates, so these are the patterns,
    # not the numbers.
    f1: (0.0.f64 - 2.0.f64)
    print "f64 -2.0: \{f1.bits}"
    f2: 1.0.f32
    print "f32 1.0: \{f2.bits}"
    f3: 0.0.f64
    print "f64 0.0: \{f3.bits}"
    f5: -1.5.f64
    print "f64 -1.5: \{f5.bits}"

    # the two zeros are the clearest case for why this is a representation
    # view and not a value conversion: they compare EQUAL as values and have
    # different bits, so no value conversion could tell them apart.
    zp: 0.0.f32
    zn: -0.0.f32
    print "f32 +0.0: \{zp.bits}  f32 -0.0: \{zn.bits}"
    if zp == zn then print "and they compare equal" else print "compare-BAD"
}
