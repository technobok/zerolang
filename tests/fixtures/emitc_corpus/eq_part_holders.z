# The holders errors/eq_part_without_eq refuses to compare are ordinary values
# otherwise: they are built, read and passed around, and a facet part -- which
# C cannot compare at all -- costs its holder nothing until something asks for
# `==`. The holders whose parts all have `==` still compare: a struck-off
# `copy` or `hash` is not a part, a conformance marker is not a part, a str
# part compares its content, and a field with a literal default is an i64.
opaque: record {
    val: i64
} as {
    ==: null
}

holder: record {
    o: opaque
    n: i64
}

sized: facet {
    size: function {:this} out u64
}

pt: record {
    x: u64
} as {
    m: sized
    size: function {p: this} out u64 is {
        return p.x
    }
}

viaFacet: record {
    s: sized
}

nested: record {
    v: viaFacet
}

plain: record {
    x: 0
    y: 0
} as {
    copy: null
    hash: null
}

marked: record {
    p: pt
    s: (str to: 8)
}

show: function {h: holder} out i64 is {
    return h.o.val + h.n
}

main: function is {
    h: holder o: (opaque val: 2) n: 3
    print "holder \{show :h} \{h.n == 3}"
    v: nested v: (viaFacet s: (sized.create from: (pt x: 4)))
    print "facet part \{v.v.s.size}"
    a: plain
    b: plain x: 1
    print "struck-off copy and hash: \{a == a} \{a == b}"
    m: marked p: (pt x: 1) s: ("ab".str to: 8)
    n: marked p: (pt x: 1) s: ("ac".str to: 8)
    print "marker and str: \{m == m} \{m == n}"
}
