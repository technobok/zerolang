# A LOCK-HOLDING VALUE MAY MOVE ANYWHERE IN ITS OWN FRAME. `xs` is declared
# before `a`, and `w` -- which keeps `a` locked -- is appended to it. The
# move is accepted: the outlives test is a SCOPE test, not a declaration
# order. Within one frame the lock keeps `a` bound, unwritten and undropped
# until the frame closes, and no destructor reads a non-owned field, so no
# order in which the frame's locals die can read through `xs` into a dead
# `a`. A destination in an ENCLOSING frame is what is refused (see the
# errors twins lock_transfer_outlives_bind / lock_transfer_outlives_container).
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

main: function is {
    xs: (List W)
    a: Src n: 1
    w: mk from: a
    xs.append w
    print "\{xs.length} \{(xs.get i: 0.u64).s.n}"
}
