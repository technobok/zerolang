# A LOCK-HOLDING VALUE MAY MOVE INTO AN OWNER IN ITS OWN FRAME. `h` is
# declared before `a`, and `w` -- which keeps `a` locked -- is stored in its
# field. The move is accepted: the outlives test is a SCOPE test, not a
# declaration order. Within one frame the lock keeps `a` bound, unwritten and
# undropped until the frame closes, and no destructor reads a non-owned field,
# so no order in which the frame's locals die can read through `h` into a dead
# `a`. A destination in an ENCLOSING frame is what is refused (see the errors
# twin lock_transfer_outlives_bind), and so is a container at any depth (see
# lock_transfer_method_arg).
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

Holder: class {
    w: (Option W)
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

main: function is {
    h: Holder w: (Option.none W)
    a: Src n: 1
    w: mk from: a
    h.w = Option.some w
    with o: h.w do match (o) case some then print "\{o.tag} \{o.s.n}" case none then null
}
