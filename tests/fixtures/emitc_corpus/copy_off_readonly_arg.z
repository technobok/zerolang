# `.copy` is the escape hatch every readonly diagnostic recommends, and as an
# ARGUMENT off a readonly binding it did not work: the hoisted temp treated
# `h.copy` as a field read and took an EXCLUSIVE lock on the path, whose root is
# readonly. A call's result ownership is its signature's business -- `.copy`
# hands back a fresh value -- so the temp owns it and locks nothing.
#
# Values are printed because the compile alone proves too little: the copy must
# be a real copy, with the readonly source left intact and still readable after.
main: function is {
    m: (MapRV String value: u64)
    k0: "a".string
    v0: 7.u64
    m.set key: k0 value: v0

    s: "a".string
    h: s.hold
    got: m.get key: h.copy
    n: 0.u64
    match (
        got
    ) case some then {
        n = got
    } case none then {
        n = 0.u64
    }
    print "lookup=\{n} source=\{h} len=\{h.length}"
}
