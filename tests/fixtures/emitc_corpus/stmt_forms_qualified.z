# stmt_forms_qualified.z -- the statement forms reached by their QUALIFIED
# spelling. `print`, `panic` and `return` are core aliases onto natives in `io`
# and `system`, and the statement dispatch used to read the callee's ATOM, so
# a qualified spelling fell through to the generic native path: `io.print`
# failed at emit for want of a fragment it does not have, and `system.panic`
# and `system.return` emitted the mono's own cname as a function. The dispatch
# asks the resolved declaration, so both spellings reach one emitter.

clamp: function {n: u64} out u64 is {
    if n > 1000 then system.panic "unreachable"
    if n > 10 then system.return 10.u64
    return n
}

main: function is {
    io.print "qualified print"
    a: clamp n: 3.u64
    b: clamp n: 99.u64
    io.print "\{a} \{b}"
}
