# A user method's `outx T.borrow` hands back a REFERENCE, so a write through the
# result reaches the source.
#
# It used to hand back a COPY: the C function returned the struct by value, the
# binding copied it, and `p.n = 20` landed on the copy. `b.it.n` stayed 1 and
# nothing anywhere reported a problem -- a silently wrong answer, not a crash.
# Both binding forms lost it, the plain one and `with`.
#
# `borrow_return_view_param.z` is the read-only half of this pair; it only reads
# through the reference, which is why the copy went unnoticed there. This one
# writes, which is the whole point of a mutable borrow.
#
# The `label` field owns heap on purpose: if the reference were ever bound as an
# owned value again, its destructor would double-free the String and the corpus
# leak pass would say so.
#
# The UNION case is here because it is the counter-example, and it is easy to get
# backwards. A union is a reftype like a class, but the C ABI treats the two
# differently: only a class is passed and returned by reference. A union is a
# `{tag, void* data}` fat pointer returned BY VALUE, and that copy already
# aliases its source through `data`, so it must NOT be given a `*` -- a starred
# union return cannot be matched on at all. The rule keys on `isReftypeParam`
# (the ABI question) rather than `isReftypeOf` (the ownership family).
Item: class {
    n: i64
    label: String
}

Bag: class {
    it: Item
} as {
    peek: function {t: this.borrow} outx Item.borrow is {
        return t.it
    }
}

Pl: record {
    n: i64
}

Fy: record {
    n: i64
}

Arm: union {
    plain: (Box Pl)
    fancy: (Box Fy)
}

Holder: class {
    a: Arm
} as {
    look: function {t: this.borrow} outx Arm.borrow is {
        return t.a
    }
}

main: function is {
    b: Bag it: (Item n: 1 label: "held".string)
    {
        p: b.peek
        p.n = 20
    }
    print "plain binding wrote through: \{b.it.n}"
    with q: b.peek do {
        q.n = q.n + 5
    }
    print "with binding wrote through:  \{b.it.n}"
    # a value DERIVED from the reference is a fresh value, not a reference
    d: b.peek.n + 100
    print "derived value:               \{d}"
    print "source still owns its label: \{b.it.label}"
    # a union borrow-return stays a by-value fat pointer, and must still match
    h: Holder a: (Arm.plain (Pl n: 7))
    u: h.look
    match (
        u
    ) case plain then {
        print "union borrow matched:        plain n=\{u.n}"
    } case fancy then {
        print "union borrow matched:        fancy n=\{u.n}"
    }
}
