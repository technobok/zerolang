# nonowned_native_field.z -- a class whose non-owned field is a NATIVE reftype
# (`String.borrow`), constructed inline. The checker decides the argument's
# disposition -- the field borrows, so the source is pinned, not moved -- and
# the emitter reads that one answer: the source keeps its buffer, the holder
# writes through the field, and the owner reads the result back once the
# holder has died. The emitter used to presume every construction moves its
# arguments and zeroed the source, which emptied the field and leaked the
# buffer.
C: class {
    s: String.borrow
}

main: function is {
    src: "hello".string
    {
        c: C s: src
        print "held: \{c.s.length}"
        c.s.append " world"
    }
    print "after: \{src}"
}
