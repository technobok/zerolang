# A Box is a heap pointer, so a Box operand auto-derefs for arithmetic and for
# comparison. A Box PARAMETER is held through a second pointer -- a reftype
# parameter passes by reference -- so its value is two derefs away, and with one
# the C added to an address and compared one.
#
# The arithmetic half was invalid C, which at least stops the build. The compare
# half COMPILED and printed the wrong answer: `b == 7` on a box holding 7 was
# false. A Box LOCAL is one deref away and was always right; it is the control.
bump: function {b: (Box t: u64)} out u64 is {
    return b + 0
}

bumpBound: function {b: (Box t: u64)} out u64 is {
    r: b + 1
    return r
}

same: function {b: (Box t: u64)} out bool is {
    return b == 7
}

less: function {b: (Box t: u64)} out bool is {
    return b < 3
}

main: function is {
    v: 7.u64
    bx: Box t: u64 from: v

    # the parameter: two derefs
    print "param=\{bump b: bx}"
    print "bound=\{bumpBound b: bx}"
    print "eq=\{same b: bx}"
    print "lt=\{less b: bx}"

    # the control: a local box is one deref, and was always right
    print "local=\{bx + 1}"
    print "localeq=\{bx == 7}"
}
