# int128_literal_products.z -- an operation on two 128-bit literals is computed
# in 128 bits. C has no 128-bit literal and reads the digits as a 64-bit type,
# so `9223372036854775807.i128 * 9223372036854775807.i128` was emitted as a
# product of two `long`s that overflowed -- printing 1 -- before the result
# reached the 128-bit destination. A literal of either 128-bit type is cast to
# it now, and so is a folded constant of one; a variable operand was always
# promoted and was right.
K: 9223372036854775807.i128
U: 4611686018427387904.u128

main: function is {
    print "\{9223372036854775807.i128 * 9223372036854775807.i128}"
    print "\{4611686018427387904.u128 * 8.u128}"
    print "\{(0.i128 - 9223372036854775807.i128 * 9223372036854775807.i128 * 2) - 1}"
    print "\{K * K} \{U * 8.u128}"
    k: 3.i128
    print "\{9223372036854775807.i128 * k * k}"
}
