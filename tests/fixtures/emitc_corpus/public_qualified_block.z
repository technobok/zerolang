# public_qualified_block.z -- the block's contents ARE the surface, spelled
# `pubinl_host.MAX` from outside; the block itself is a nested unit named
# `public`, so `pubinl_host.public.MAX` reaches the same definition (the block
# pseudo-member is never private). Pinned.
main: function is {
    print "\{pubinl_host.public.MAX}"
}
