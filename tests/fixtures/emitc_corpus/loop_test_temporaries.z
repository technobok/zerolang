# A LOOP'S TEST MAY BUILD A VALUE THAT OWNS MEMORY. `(mk n: i).length` makes a
# String at every test. It is declared once, ahead of the loop, assigned where
# the test runs, and released as soon as the test has its answer, so no test
# leaks the one before it. `and` evaluates both sides, so the second loop's
# String is made, and released, at every test.

# mk -- a String that owns its bytes
mk: function {n: u64} out String is {
    return "x".string
}

main: function is {
    i: 0.u64
    for (mk n: i).length + i < 4 loop {
        i = i + 1
    }
    print "\{i}"
    xs: ListVal u64
    xs.append 1
    xs.append 2
    j: 0.u64
    for (j < xs.length) and ((mk n: j).length > 0) loop j = j + 1
    print "\{j}"
}
