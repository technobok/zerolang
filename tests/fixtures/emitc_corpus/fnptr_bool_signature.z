# `bool` is an ORDINAL variant -- the value is its own discriminator -- so it
# reaches the C as a plain scalar. The fnptr-typedef emitter refused every
# VARIANT as "not cleanly forward-declarable", which is true of a tagged one and
# false of this: any signature mentioning a bool lost its `_ft` typedef while
# the struct field went on using the name, and the C had no such type.
#
# It is the whole signature, not the parameter the note recorded: a bool RETURN
# with no bool parameter fails the same way, and so does a function taking none.
Holder: class {
    boolParam: function {n: bool} out i64
    boolReturn: function {n: i64} out bool
    bothBool: function {n: bool} out bool
    noParams: function {} out bool
    neither: function {n: i64} out i64
}

takesBool: function {n: bool} out i64 is {
    if n then return 1
    return 0
}

givesBool: function {n: i64} out bool is {
    return n > 0
}

roundTrip: function {n: bool} out bool is {
    return n
}

alwaysTrue: function {} out bool is {
    return true
}

plain: function {n: i64} out i64 is {
    return n + 1
}

main: function is {
    h: (Holder
        boolParam: takesBool.take
        boolReturn: givesBool.take
        bothBool: roundTrip.take
        noParams: alwaysTrue.take
        neither: plain.take
    )
    print "param=\{h.boolParam n: true}"
    print "return=\{h.boolReturn n: 5}"
    print "both=\{h.bothBool n: true}"
    print "none=\{h.noParams}"
    print "neither=\{h.neither n: 1}"
}
