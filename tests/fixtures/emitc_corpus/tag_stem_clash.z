# A sum's C tag enumerators are spelled from its name. Two units may each
# declare a sum of one name, an Option over each unit's own `Foo` is two
# instances of one name, and a program may declare a sum the stdlib also
# declares (`converror`, whose tags the runtime fragments spell): each pair
# was refused by the emitter as colliding enumerators. Each now keeps its own.
converror: variant { tooBig: null tooSmall: null }

main: function is {
    a: tag_stem_left.pick k: 5
    b: tag_stem_right.pick k: 5
    match (a) case lo then print "left lo" case hi then print "left hi"
    match (b) case lo then print "right lo" case mid then print "right mid" case hi then print "right hi"
    print "boxed \{tag_stem_left.boxed k: 4} \{tag_stem_right.boxed k: 4}"
    x: 300
    y: x.u8
    match (y) case ok then print "converted \{y}" case err then print "out of range"
    c: converror.tooSmall
    match (c) case tooBig then print "too big" case tooSmall then print "too small"
}
