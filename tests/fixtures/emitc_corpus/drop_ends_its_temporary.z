# drop_ends_its_temporary.z -- a temporary belongs to the borrows of it and lives
# no longer than they do. `n: (grid.pop).get i: 0` borrows an element of the
# popped list, which no name owns: `n.drop` releases the last borrow of it, so
# the list is destroyed there, and the block's own destroy of it at its end
# finds nothing left to free. Dropped in a loop, on one branch, before a
# `return` or a `break`, it is destroyed once. A temporary nothing borrows on a
# line that keeps another one ends with its statement.
fill: function {grid: (List (List String)).borrow} is {
    i: 0
    for i < 3 loop {
        row: List String
        row.append from: "a-long-enough-string-to-be-on-the-heap-\{i}"
        grid.append from: row.take
        i = i + 1
    }
}

mkL: function out (List String) is {
    r: List String
    r.append from: "b".string
    return r
}

first: function {grid: (List (List String)).borrow} out u64 is {
    n: (grid.pop).get i: 0
    k: n.length
    n.drop
    if k > 3 then return k
    return 0
}

main: function is {
    grid: List (List String)
    fill :grid
    for grid.length > 1 loop {
        n: (grid.pop).get i: 0
        print n
        n.drop
        print "dropped"
    }
    fill :grid
    c: (grid.pop).get i: 0
    if grid.length > 2 then c.drop
    print "\{first :grid}"
    for true loop {
        b: (grid.pop).get i: 0
        print b
        b.drop
        break
    }
    fill :grid
    u: (grid.pop).get i: ((mkL).get i: 0).length - 1
    print u
}
