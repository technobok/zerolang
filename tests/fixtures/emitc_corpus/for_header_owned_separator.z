# for_header_owned_separator.z -- a for header over split whose separator is an
# owned string a call makes: the separator's temporary owns it and frees it
# once. The split's receiver is pinned by the iterator, not by the separator.
sepOf: function out String is {
    return ",".string
}

main: function is {
    s: "a,b".string
    for each d: (s.stringView.split sep: sepOf) loop {
        print d
    }
}
