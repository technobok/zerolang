# arm_predicate_on_own_receiver -- inside a generic sum's own method, the
# receiver's `.arm` is the arm PREDICATE, as on any value: it was typed as the
# arm's payload (and refused where a bool was wanted) because the receiver of
# a template's own method has the template's type, not a partial of it
public: unit {
    :main
}

# Pick -- a value or the text saying why not
Pick: union {
    no: String
    ok: T
} as {
    T: AnyRef.generic
    # whether this holds a value
    holds: function {p: this.view} out bool is {
        return p.ok
    }
    # whether this holds the reason
    refused: function {p: this.view} out bool is {
        return p.no
    }
}

# slot -- a number or nothing, by value
slot: variant {
    empty: null
    full: n
} as {
    n: anyval.generic
    # whether a number is in it
    filled: function {s: this} out bool is {
        return s.full
    }
}

main: function is {
    a: (Pick String).ok "x".string
    b: (Pick String).no "none".string
    print "a: \{a.holds} \{a.refused}"
    print "b: \{b.holds} \{b.refused}"
    c: (slot n: u32).full 7
    d: (slot n: u32).empty
    print "c: \{c.filled} d: \{d.filled}"
}
