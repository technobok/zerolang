# xunit_tdconst -- a scalar typedef plus unit-level values typed by it, held in
# a data block. `out nameid` is what types the elements, so each reads as a
# nameid without any literal wearing a type suffix -- the shape zast.names uses
# for the 33 well-known ids.
nameid: record { val: u32.typedef } as {
    ==: function {:this rhs: nameid} out bool is {
        return this.u32 == rhs.u32
    }
}

names: data {
    wkThis: 1
    wkCreate: 5
} out nameid

localSum: function {} out u32 is {
    return names.wkThis.u32 + names.wkCreate.u32
}
