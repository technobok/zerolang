# xunit_tdconst -- a scalar typedef plus unit-level constants typed by it.
# The suffix on a constant's literal may name a typedef, not just a builtin
# scalar; the constant still folds to the base's C literal.
nameid: record { val: u32.typedef } as {
    ==: function {:this rhs: nameid} out bool is {
        return this.u32 == rhs.u32
    }
}

wkThis: 1.nameid
wkCreate: 5.nameid

localSum: function {} out u32 is {
    return wkThis.u32 + wkCreate.u32
}
