# typedef_param_shorthand.z -- a typedef's generic parameter may appear in its
# base as `:t`, which is `t: t`; zl fmt writes the second as the first. Both
# spellings name the parameter, so both typedefs check, and each is built from
# a list and reads its length. The file keeps both spellings: do not format it.

Wrap: typedef (ListVal t: t) as { t: anyval.generic }
Short: typedef (ListVal :t) as { t: anyval.generic }

wrapLength: function {w: (Wrap t: u8).view} out u64 is { return w.length }
shortLength: function {w: (Short t: u8).view} out u64 is { return w.length }

main: function is {
    v: ListVal u8
    v.append 7
    v.append 9
    print "\{wrapLength w: (Wrap v)} \{shortLength w: (Short v)}"
}
