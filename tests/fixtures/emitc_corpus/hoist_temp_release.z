# hoist_temp_release.z -- a hoisted argument is the user's named hoist made
# explicit: `r: lfPass v: (s.substring from: 0 to: 3)` keeps its temporary, and
# the temporary keeps `s` locked, as `t: s.substring ..; r: lfPass v: t` would.
# Releasing r -- a drop, an owned reassignment -- releases the temporaries it
# kept and their locks, so `s` may be written after it.
lfPass: function {v: StringView.view} outx StringView is {
    return v
}

main: function is {
    s: "abc def".string
    r: lfPass v: (s.substring from: 0 to: 3)
    print r
    r.drop
    s = "after the drop".string
    w: lfPass v: (s.substring from: 0 to: 5)
    print w
    w = "lit"
    s = "after the reassignment".string
    print "\{w} \{s}"
}
