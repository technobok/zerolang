# alias_generic_template.z -- a BARE unit-level alias of a GENERIC template is
# that template under another name: `(MyList String)` constructs, iterates,
# reports its length and binds a parameter exactly as `(List String)` does.
# `List`, `Set` and `Map` are core aliases whose targets carry a DIFFERENT
# name (`collections.ListRef`), so each of these aliases a re-export that
# RENAMES -- the written name is no member of the unit the target lives in,
# and only the binding Decl knows what it stands for. The dotted twin is
# container_alias.z.
MyList: List
MySet: Set
MyMap: Map

total: function {xs: (MyList String).view} out u64 is {
    return xs.length
}

main: function is {
    xs: (MyList String)
    xs.append "a".string
    xs.append "b".string
    with it: xs.iterate do for v: it loop print "x \{v}"
    print "xlen=\{total :xs}"

    s: (MySet String)
    s.add "k".string
    k9: "k".string
    print "s has=\{s.has item: k9}"

    m: (MyMap String V: String)
    m.set key: "k".string value: "v".string
    with mt: m.iterateItems do for e: mt loop print "m \{e.key}=\{e.value}"
}
