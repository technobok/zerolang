# A three-segment qualified sum-arm construction, `unit.Type.arm payload`. The
# leg that resolves the middle segment through its defining unit accepted only
# unions, so a VARIANT arm with a payload matched no handler and reached the
# emitter's backstop as E0500 "unhandled callee" -- while the same arm written
# through a local alias, and the payload-less qualified form, both worked. A
# variant is a valtype and carries its payload inline; only a union boxes one.
main: function is {
    s: xunit_sum_ctor.shape.dot (xunit_sum_ctor.pt x: 1 y: 2)
    match (
        s
    ) case dot then print "dot \{s.x},\{s.y}" case empty then print "empty"
    e: xunit_sum_ctor.shape.empty
    match (
        e
    ) case dot then print "dot" case empty then print "empty"
    u: xunit_sum_ctor.Slot.full (xunit_sum_ctor.Cell n: 42)
    match (
        u
    ) case full then print "full \{u.n}" case hole then print "hole"
}
