# A typedef's `create from:` takes a COPY of a valtype source: a valtype owns
# no heap, so there is nothing to transfer and the source name stays live.
# Reftype sources still transfer -- see errors/typedef_moves_reftype_source.
myid: record { val: u64.typedef }
pair: record { a: u64  b: u64 }

main: function is {
    n: 7.u64
    p: pair a: n b: n
    print "record built, n still live: n=\{n} p=\{p.a}"
    k: myid.create from: n
    print "typedef built, n still live: n=\{n} k=\{k.u64}"
    m: myid.create from: n
    print "and again: n=\{n} m=\{m.u64}"
}
