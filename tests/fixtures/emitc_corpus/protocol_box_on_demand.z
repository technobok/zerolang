# protocol_box_on_demand.z -- a conformance's helpers (wrappers, vtable,
# create) are written only for a pair written C makes a protocol value of:
# Cat is boxed as a Greeter, so its helpers are written and called; Dog
# conforms too but is only ever used as itself, so its C carries none, and
# its `greet` is still called directly.
Greeter: protocol {
    greet: function {:this n: i64} out i64
}

Cat: class {
    k: i64
} as {
    :Greeter
    greet: function {c: this n: i64} out i64 is {
        return c.k + n
    }
}

Dog: class {
    k: i64
} as {
    :Greeter
    greet: function {d: this n: i64} out i64 is {
        return d.k * n
    }
}

main: function is {
    c: Cat k: 40
    g: Greeter c.borrow
    print "cat=\{g.greet n: 2}"
    d: Dog k: 3
    print "dog=\{d.greet n: 5}"
}
