# generator_local_cleanup.z -- EVERY generator-body local that lives across a
# suspension promotes to a field on the class (a resumable body has no
# persistent stack frame): a local bound and dropped before any yield, one
# yielded bare (moved into the boxed payload, source zeroed), one used across
# yields, and one bound per loop iteration all clean up through the instance
# destructor -- no fn-exit frees ever run on a fresh frame.

Drop: generator { base: String } as {
    call: function out u64 is {
        s2: this.base.copy
        y: s2.length
        yield y
        yield 1
    }
}

Give: generator { base: String } as {
    call: function out String is {
        s2: this.base.copy
        yield s2
        yield this.base.copy
    }
}

Span: generator { base: String } as {
    call: function out u64 is {
        s2: this.base.copy
        yield s2.length
        yield s2.length
    }
}

Looped: generator { base: String  n: u64 } as {
    call: function out u64 is {
        i: 0.u64
        for i < this.n loop {
            t: this.base.copy
            yield t.length
            i = i + 1
        }
    }
}

main: function is {
    for a: (Drop base: "alpha".string) loop print "a=\{a}"
    for s: (Give base: "gamma".string) loop print "s=\{s}"
    for b: (Span base: "beta".string) loop print "b=\{b}"
    for c: (Looped base: "delta".string n: 2) loop print "c=\{c}"
    print "done"
}
