# An empty String owns no buffer, so appending NOTHING to one must not write a
# terminator through the null it holds -- `s: String` then `s.append ""` was a
# segfault, and `reserve` is why: zero bytes needed is zero bytes reserved, so
# the buffer stayed absent while append wrote `data[0]`. The same null reaches
# `==` between two empty Strings, which now answers before it compares bytes.
# Appending an empty view to a String that DOES own a buffer, and a non-empty
# view to one that does not, are the two neighbours that must not move.
main: function is {
    bare: String
    bare.append ""
    print "bare \{bare.length} \{bare.capacity}"

    grown: String
    grown.append "ab"
    grown.append ""
    print "grown \{grown} \{grown.length}"

    src: "abcdef".string
    sv: src.stringView
    slice: sv.substring from: 2 to: 2
    empty2: String
    empty2.append slice
    print "slice \{empty2.length}"

    e1: String
    e2: String
    if e1 == e2 then print "eq yes" else print "eq no"
    if e1 == grown then print "mix yes" else print "mix no"
}
