# A Set or a Map lives on the HEAP and its value IS the pointer, so a parameter
# of one is a pointer whatever its ownership. `.take` is not an exception: what
# it takes is the pointer, and there is no by-value form of one to move.
#
# Declared by value, three things disagreed at once -- the body read the struct
# with `->`, the caller zeroed the moved-out source with a struct literal where
# a pointer was wanted, and the callee's destroy was skipped entirely (so the
# value it took leaked). All three are the same fact stated in three places.
#
# The controls are the families that really are by value -- a List, a ListVal,
# an IdMapV -- which must keep moving by value, and a plain (borrowed) Map
# parameter, which was already right.
eatMap: function {m: (MapRV K: String v: i64).take} out u64 is {
    return m.length
}

eatMapRR: function {m: (Map String V: String).take} out u64 is {
    return m.length
}

eatSet: function {s: (SetVal u64).take} out u64 is {
    return s.length
}

readMap: function {m: (MapRV K: String v: i64)} out u64 is {
    return m.length
}

eatList: function {l: (ListVal u64).take} out u64 is {
    return l.length
}

eatIdMap: function {m: (IdMapV u64 v: u64).take} out u64 is {
    return m.length
}

main: function is {
    a: (MapRV K: String v: i64)
    a.set key: "k".string value: 1
    print "borrowed=\{readMap m: a}"
    print "map=\{eatMap m: a.take}"

    b: (Map String V: String)
    b.set key: "k".string value: "v".string
    print "maprr=\{eatMapRR m: b.take}"

    c: (SetVal u64)
    c.add item: 7.u64
    print "set=\{eatSet s: c.take}"

    d: ListVal u64
    d.append from: 1.u64
    d.append from: 2.u64
    print "list=\{eatList l: d.take}"

    e: (IdMapV u64 v: u64)
    e.set key: 1.u64 value: 2.u64
    print "idmap=\{eatIdMap m: e.take}"
}
