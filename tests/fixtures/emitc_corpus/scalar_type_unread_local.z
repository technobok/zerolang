# scalar_type_unread_local -- locals of the scalar types whose C type is a
# prelude piece (f16, i128, u128), declared and never read. A declaration
# spells its type, so it demands the piece itself: no other use of the type
# is there to bring it in.
main: function is {
    half: 1.5.f16
    zero: f16
    big: -5.i128
    wide: u128
    print "built"
}
