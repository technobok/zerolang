# box_value_lands.z -- the value a Box is made from lands in its element type
# as an argument lands in its parameter's type: a literal takes the element
# type when its value fits, and a value of another type converts to it without
# loss. The element type is the instance's own, or the template's `t:`
# argument, written before or after the value. A Box's conversions are its
# element's, read through the cell.
B8: (Box u8)

widened: function {b: (Box u8)} out u64 is {
    return b.u64
}

main: function is {
    a: B8 from: 5
    b: (Box u8) from: 250
    c: Box t: u8 from: 7
    d: Box from: 9 t: u8
    small: 3.u8
    e: (Box i64) from: small
    f: (Box i64) from: 300
    g: f.u8.or d: 1
    print "\{a.u64} \{b.u64} \{widened b: c} \{widened b: d} \{e.i64} \{g}"
}
