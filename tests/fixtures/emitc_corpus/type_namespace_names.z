# the names a type's own namespace and the scope around it share: a local named
# `meta` is an ordinary value; a member is nearer than a unit function of its
# name, so the unit's is reached through the unit; and a generic type's static
# is reached through the type applied to its own parameters

# make -- the unit's own, a hundred more
make: function {from: u64} out u64 is {
    return from + 100
}

# a pair of numbers
pr: record {
    make: u64
    one: u64
}

# a plain value
px: record {
    v: u64
} as {
    # one more
    make: function {from: u64} out this is {
        return (meta.create v: from + 1)
    }
    # the unit function, through its unit: the bare name is the member
    again: function {t: this.view} out u64 is {
        return (type_namespace_names.make from: t.v)
    }
}

# a value offset by n
fx: record {
    v: u64
} as {
    n: u64.generic
    # n more than from
    make: function {from: u64} out type is {
        return (meta.create v: from + n)
    }
    # through the instance being checked
    twice: function {from: u64} out type is {
        a: (fx :n).make :from
        return (meta.create v: a.v * 2)
    }
}

main: function is {
    meta: pr make: 3 one: 4
    x: px v: 3
    y: (fx n: 3).twice from: 4
    print "\{meta.make + meta.one} \{x.again} \{y.v}"
}
