# A temporary an argument needs is released at the end of its statement, so a
# long block does not hold every one it made. A binding that still reads one --
# a view of a value no name holds -- keeps it to the end of the block. Returns,
# breaks and continues release what their statement made on the way out. Run
# under the address sanitizer, a release too early reads freed storage and a
# release missed leaks.
mks: function {n: i64} out String is {
    return "x\{n}"
}

len1: function {a: StringView} out u64 is {
    return a.length
}

headOfView: function {s: String.view} outx StringView is {
    return s.stringView
}

early: function {k: i64} out u64 is {
    a: len1 a: (mks n: k).stringView
    if k > 1 then return (len1 a: (mks n: k).stringView) + a
    b: len1 a: (mks n: 99).stringView
    return a + b
}

main: function is {
    held: (mks n: 1).stringView
    through: headOfView s: (mks n: 22)
    n: len1 a: (mks n: 333).stringView
    m: len1 a: (mks n: 4444).stringView
    print "held \{held} through \{through} lens \{n} \{m}"
    print "early \{early k: 1} \{early k: 2}"
    i: 0
    total: 0.u64
    for i < 5 loop {
        i = i + 1
        total = total + (len1 a: (mks n: i).stringView)
        if i == 2 then continue
        if (len1 a: (mks n: i).stringView) > 1 then break
    }
    if (len1 a: (mks n: 55).stringView) == 3 then {
        print "if body \{total}"
    }
    print "still held \{held} \{through}"
}
