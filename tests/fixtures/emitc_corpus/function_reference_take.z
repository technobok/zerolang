# A `.take` OF A SHARED FUNCTION WITH NO PARAMETERS IS ITS REFERENCE, not a
# call of it: `f: Clock.tick.take` emitted `z_tN()` into a function pointer.
Clock: class {
    now: i64
} as {
    tick: function out i64 is {
        return 42
    }
}

Timer: class {
    source: function out i64
}

main: function is {
    f: Clock.tick.take
    t: Timer source: f
    t.source = Clock.tick.take
    print "\{t.source} \{Clock.tick}"
}
