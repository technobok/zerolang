# An `outx T.view` result makes its BINDING readonly, because that binding IS the
# reference handed back. A value merely DERIVED from one is a fresh value that
# aliases nothing, and inheriting the restriction made ordinary arithmetic
# unassignable -- a `bool` from a comparison cannot be a reference into anything.
#
# Every derived form is here, and each is written to afterwards, which is what
# the bug refused. The reference itself stays readonly: view_return_readonly is
# the other half of this pair.
Item: class {
    n: i64
    label: String
}
Bag: class {
    a: Item
} as {
    peek: function {t: this.view} outx Item.view is {
        return t.a
    }
}
main: function is {
    g: Bag a: (Item n: 1 label: "one".string)

    # a valtype field read off the readonly reference: a copy
    x: g.peek.n
    x = x + 4

    # a comparison: a fresh bool
    hit: g.peek.n == 1
    hit = false

    # the reference on the right-hand side too
    rhit: 2 == g.peek.n
    rhit = true

    # arithmetic
    s: g.peek.n + 10
    s = s * 2

    print "x=\{x} hit=\{hit} rhit=\{rhit} s=\{s} src=\{g.peek.n}"
}
