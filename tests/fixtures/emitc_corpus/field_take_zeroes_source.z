# field_take_zeroes_source -- `x: h.f.take` moves a String or a collection out
# of a local's field: the binding owns the heap buffer from then on, and the
# holder's destructor must find the field empty. Printed after the take so the
# moved value is read through its new owner, and the holder is still alive to
# be destroyed afterwards.
Holder: class {
    s: String
    xs: (ListVal u32)
    names: (List String)
}

main: function is {
    h: (Holder s: "abc".string xs: (ListVal u32) names: (List String))
    h.xs.append 7
    h.xs.append 8
    h.names.append "n1".string
    s2: h.s.take
    print s2
    xs2: h.xs.take
    print "\{xs2.length}"
    names2: h.names.take
    print "\{names2.length}"
    print "\{h.xs.length} \{h.names.length}"
}
