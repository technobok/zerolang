# generic_variant_method.z -- as-block METHODS on a user generic VARIANT, at two
# instantiations. attachVariantMethods is the record path's twin and marked its
# methods no more than that one did, so a generic variant's method was never a
# clone candidate: the mono's member stayed the template's function type and the
# call had no callee at all.
Slot: variant {
    full: t
    empty: null
} as {
    t: anyval.generic
    matches: function {s: this rhs: Slot} out bool is { return true }
    scaled: function {s: this by: i64} out i64 is { return by * 2 }
}

main: function is {
    a: Slot.full 4
    b: Slot.empty i64
    print "i64 matches \{a.matches rhs: b}"
    print "i64 scaled \{a.scaled by: 5}"

    c: Slot.full 3.i32
    d: Slot.full 9.i32
    print "i32 matches \{c.matches rhs: d}"
    print "i32 scaled \{c.scaled by: 6}"
}
