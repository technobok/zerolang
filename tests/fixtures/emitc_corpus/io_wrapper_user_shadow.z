# io_wrapper_user_shadow.z -- a program declares its own class `BufWriter`, and
# uses io's. The io wrapper's create resolved the member name `BufWriter` in
# the program, so `io.BufWriter.create` built the program's class (gcc: storage
# size not known). It is the io unit's own member.
BufWriter: class {
    n: i64
} as {
    create: function {n: i64} out BufWriter is {
        return (meta.create :n)
    }
}

main: function is {
    w: io.stdout
    bw: io.BufWriter.create to: w capacity: 16
    mine: BufWriter.create n: 3
    outbuf: Bytes
    outbuf.append from: 111.u8
    outbuf.append from: 10.u8
    wr: bw.write from: outbuf.byteView
    match (wr) case ok then null case err then null
    fr: bw.flush
    match (fr) case ok then null case err then null
    print "mine=\{mine.n}"
}
