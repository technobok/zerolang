# if_fold_order.z -- the conditions of an `if` fold in the order they run: a
# constant `true` is passed over, a constant `false` loses the clause before any
# later condition is read, and a condition with a run-time value stops the fold.
#
# Every `if` here folds, or leaves no dead C. The forms the fold stops short of
# are in fold_stops/fold_stops.z.

DEBUG: false
ON: true

Count: class {
    n: i64
} as {
    tick: function {:this} out bool is {
        this.n = this.n + 1
        return true
    }
}

main: function is {
    c: Count n: 0
    # a false first: the clause loses and the run-time condition never runs
    if DEBUG when c.tick then {
        print "lost"
    } else {
        print "else after false"
    }
    print "ticks \{c.n}"
    # a true first: passed over, and the run-time condition decides
    if ON when c.tick then {
        print "true then runtime"
    } else {
        print "not reached"
    }
    print "ticks \{c.n}"
    # true, then false: the clause loses at the false, before the run-time one
    if ON when DEBUG when c.tick then {
        print "lost"
    } else {
        print "else after true, false"
    }
    print "ticks \{c.n}"
    # a losing clause hands over to the next, which wins
    if DEBUG when c.tick then {
        print "lost"
    } else if ON then {
        print "second clause"
    } else {
        print "lost"
    }
    print "ticks \{c.n}"
    # no else: nothing runs
    if DEBUG when c.tick then print "lost"
    print "ticks \{c.n}"
}
