# A FUNCTION FIELD HOLDS A FUNCTION OF ITS OWN SIGNATURE, given at construction
# or assigned later: a free function, or a shared method of the `as` section
# reached through the type. A field that names a sibling function defaults to
# it, and a field that declares a receiver is handed the instance it is read
# through.
twice: function {t: Gauge} out i64 is {
    return t.level * 2
}

add: function {a: i64 b: i64} out i64 is {
    return a + b
}

mul: function {a: i64 b: i64} out i64 is {
    return a * b
}

Gauge: class {
    level: i64
    base: function {t: this} out i64 is {
        return t.level + 1
    }
    hook: base
    probe: function {t: this} out i64
    op: function {a: i64 b: i64} out i64
} as {
    tenfold: function {t: this} out i64 is {
        return t.level * 10
    }
}

main: function is {
    g: Gauge level: 5 probe: twice.take op: add.take
    print "\{g.hook} \{g.probe} \{g.op a: 3 b: 4}"
    h: Gauge level: 7 hook: Gauge.tenfold probe: Gauge.tenfold op: mul.take
    print "\{h.hook} \{h.probe} \{h.op a: 3 b: 4}"
    g.hook = Gauge.tenfold
    g.probe = Gauge.tenfold
    g.op = mul.take
    print "\{g.hook} \{g.probe} \{g.op a: 3 b: 4}"
}
