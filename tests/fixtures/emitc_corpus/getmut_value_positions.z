# a value-type `getMut` result -- a pointer into the list's storage -- read
# where a value is wanted: an interpolation, an operand, a comparison, a
# condition, the right side of a reassignment. Each reads the element it
# points at. A reassignment copies the element into a name that owns its
# value, so the list stays free to change after.
pt: record {
    x: i64
    y: i64
}

main: function is {
    xs: ListVal i64
    xs.append 7
    ps: ListVal pt
    ps.append (pt x: 3 y: 4)
    bs: ListVal bool
    bs.append true
    print "interpolated: \{xs.getMut i: 0}"
    a: (xs.getMut i: 0) + 1
    print "operand: \{a} and \{(xs.getMut i: 0) * 2}"
    if (xs.getMut i: 0) == 7 then print "compared equal"
    if (bs.getMut i: 0) then print "condition held"
    c: 0.i64
    c = xs.getMut i: 0
    q: pt x: 0 y: 0
    q = ps.getMut i: 0
    xs.append 8
    ps.append (pt x: 5 y: 6)
    print "copied: \{c}, \{q.x} \{q.y}; lists now \{xs.length} and \{ps.length}"
}
