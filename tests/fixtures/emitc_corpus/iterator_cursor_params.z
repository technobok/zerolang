# an iterator taken as a parameter -- a list's, a value list's, a set's, a
# map's keys', a string's lines, and one a method takes -- is its cursor type,
# declared once.
count: function {it: (ListIter T: String)} out u64 is {
    n: 0.u64
    for s: it loop n = n + 1
    return n
}
countVal: function {it: (ListIterVal t: i64)} out u64 is {
    n: 0.u64
    for s: it loop n = n + 1
    return n
}
countSet: function {it: (SetIter K: String)} out u64 is {
    n: 0.u64
    for s: it loop n = n + 1
    return n
}
countKeys: function {it: (MapKeyIter K: String V: String)} out u64 is {
    n: 0.u64
    for s: it loop n = n + 1
    return n
}
countLines: function {it: LinesIter} out u64 is {
    n: 0.u64
    for s: it loop n = n + 1
    return n
}
Counter: class { n: u64 } as {
    feed: function {c: this.borrow it: (ListIter T: String)} is {
        for s: it loop c.n = c.n + 1
    }
}
main: function is {
    xs: List String
    xs.append from: "a".string
    xs.append from: "b".string
    vs: ListVal i64
    vs.append 4
    ss: Set String
    ss.add item: "a".string
    m: Map String V: String
    m.set key: "a".string value: "b".string
    t: "a\nb\nc"
    c: Counter n: 0
    c.feed it: xs.iterate
    print "\{count it: xs.iterate} \{countVal it: vs.iterate} \{countSet it: ss.iterate} \{countKeys it: m.iterate} \{countLines it: t.lines} \{c.n}"
}
