# `ListVal` -- the valtype twin of `List`. A valtype has no ownership to
# transfer and no interior to alias, so `append` copies rather than taking and
# `get` returns the element BY VALUE: no view, so no lock on the container and
# no aliasing question at all. Whole-element replacement is `set`.
#
# There is deliberately no `getMut` yet -- see collections.z.
pt: record {
    x: i64
    y: i64
}

main: function is {
    xs: (ListVal u64)
    xs.append 10
    xs.append 20
    print "len=\{xs.length} first=\{xs.get i: 0} has20=\{xs.contains item: 20}"
    xs.set i: 0 val: 99
    print "after set: \{xs.get i: 0}"

    # a COMPOUND valtype element: contains and sort compare by bytes, which is
    # a total order; an element wanting a meaningful one declares `<`.
    ps: (ListVal pt)
    ps.append (pt x: 1 y: 2)
    ps.append (pt x: 3 y: 4)
    print "compound len=\{ps.length} has=\{ps.contains item: (pt x: 3 y: 4)}"
    ps.set i: 0 val: (pt x: 41 y: 2)
    q: ps.get i: 0
    print "compound after set: x=\{q.x} y=\{q.y}"

    with it: xs.iterate do for v: it loop print "iter \{v}"
}
