# GENERATED by tests/unit/matrixgen.z from tests/fixtures/matrix_expect.txt --
# `make regen-matrix`; do not edit. The `record` family (pt) in every
# position whose cell is RUN: one function per cell, called from main.
Rd: protocol {
    rdn: function {t: this.view} out i64
}
pt: record { x: i64 } as {
    :Rd
    rdn: function {c: this.view} out i64 is { return c.x }
    getn: function {c: this.view} out i64 is { return c.x }
    getd: function {c: this.view d: i64} out i64 is { return c.x + d }
    +: function {c: this.view o: i64} out i64 is { return c.x + o }
}
readF: function {v: pt.view} out i64 is { return v.x }
atConfLabel: function out i64 is {
    x: (pt x: 63)
