# generic_variant_mono.z -- a USER generic variant, monomorphised at two
# instantiations. The system's optionval/resultval are generic variants too, but
# their monos reach the emitter through their own origin-keyed worklist; a user
# one was classified into no worklist at all, so neither its mono struct nor its
# tag enum was ever written and every program declaring one emitted invalid C.
Slot: variant {
    full: t
    empty: null
} as { t: anyval.generic }

main: function is {
    a: Slot.full 42
    b: Slot.full 7.i32
    c: Slot.empty i64
    match (
        a
    ) case full then {
        print "a full \{a}"
    } case empty then {
        print "a empty"
    }
    match (
        b
    ) case full then {
        print "b full \{b}"
    } case empty then {
        print "b empty"
    }
    match (
        c
    ) case full then {
        print "c full \{c}"
    } case empty then {
        print "c empty"
    }
}
