# gfu_cells.z -- a generic FILE unit (its parameter at the file's top) that
# declares a type over its parameter, and functions that build and read it.
t: anyval.generic

Cell: record {
    v: t
}

mk: function {x: t} out Cell is {
    return (Cell v: x)
}

get: function {c: Cell} out t is {
    return c.v
}
