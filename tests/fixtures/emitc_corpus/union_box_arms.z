# The Box rule: a union holds reftypes; a valtype arm is spelled (Box T) and
# collapses to T -- the arm child IS the boxed valtype, so construction takes
# the bare value, match narrows to it, and a record payload projects its
# fields, exactly as a bare valtype arm did before the rule.
pt: record { x: i64 y: i64 }
Mixed: union {
    nothing: null
    num: (Box i64)
    pair: (Box pt)
    label: String
}
main: function is {
    a: Mixed.num 42
    match ( a ) case num then print "num \{a}" else null
    b: Mixed.pair (pt x: 3 y: 4)
    match ( b ) case pair then print "pair \{b.x},\{b.y}" else null
    c: Mixed.label "hi".string
    match ( c ) case label then print "label \{c}" else null
    d: Mixed.nothing
    match ( d ) case nothing then print "nothing" else null
}
