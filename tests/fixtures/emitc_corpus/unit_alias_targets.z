# The unit-level definitions that name something that exists: a nested unit's
# member, a same-unit arm, another unit's arm and constant, and a bare type.
mode: variant {
    fast: null
    slow: null
}

inner: unit {
    A: 1
}

FROM_INNER: inner.A
FAST: mode.fast
LINUX: platform.oskind.linux
Text: String

main: function is {
    t: Text
    t.append "ok"
    if FAST == mode.fast then print "fast" else print "slow"
    if LINUX == platform.oskind.linux then print "linux arm" else print "no"
    print "\{FROM_INNER} \{t}"
}
