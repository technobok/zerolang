# A native method of a number takes its argument unlabelled as it takes it
# labelled: the dot supplies the receiver, so the argument binds the first
# parameter after it. The unlabelled form used to pass the check and stop in
# the emitter, which read the argument into the receiver's slot.

main: function is {
    a: 5
    print "\{a.compare 3} \{a.compare rhs: 7}"
    q: 0.5
    print "\{q.scaleB 3} \{q.scaleB n: 3}"
    print "\{q.copySign 0.0 - 2.0} \{q.copySign y: 2.0}"
    r: (q.scaleB 3).scaleB 0 - 3
    print "\{r}"
}
