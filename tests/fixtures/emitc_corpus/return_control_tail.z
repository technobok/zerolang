# return_control_tail.z -- an `out` function whose body ends on a control
# construct is accepted when no path reaches the end: every arm returns, or the
# loop never exits, or the block hands its last line back.

ALWAYS: true

Pick: union {
    a: u32
    b: u32
    c: u32
}

ifElse: function {k: bool} out u32 is {
    if k then {
        return 1
    } else {
        return 2
    }
}

bareLoop: function out u32 is {
    for loop {
        return 3
    }
}

trueLoop: function out u32 is {
    for true loop {
        return 4
    }
}

constLoop: function out u32 is {
    for ALWAYS loop {
        return 5
    }
}

doWhileTrue: function out u32 is {
    for loop {
        return 6
    } while true
}

withDo: function out u32 is {
    with z: 7.u32 do {
        return z
    }
}

matchElse: function {p: Pick} out u32 is {
    match (
        p
    ) case a then {
        return 8
    } else {
        return 9
    }
}

matchAll: function {p: Pick} out u32 is {
    match (
        p
    ) case a then {
        return 10
    } case b then {
        return 11
    } case c then {
        return 12
    }
}

nested: function {k: bool} out u32 is {
    if k then {
        for loop {
            return 13
        }
    } else {
        with z: 14.u32 do {
            return z
        }
    }
}

panics: function {k: bool} out u32 is {
    if k then {
        return 15
    } else {
        panic "not taken"
    }
}

foldedIf: function out u32 is {
    if ALWAYS then return 16
}

# each instance answers for itself: this one folds to the `return`
Sized: class {
    used: u32
    get: function {:this} out u32 is {
        if cap == 0 then return 17
    }
} as { cap: u32.generic }

main: function is {
    empty: (Sized cap: 0) used: 0
    print "\{empty.get}"
    print "\{ifElse k: true} \{ifElse k: false}"
    print "\{bareLoop} \{trueLoop} \{constLoop} \{doWhileTrue} \{withDo}"
    print "\{matchElse p: (Pick.a 0)} \{matchElse p: (Pick.b 0)}"
    print "\{matchAll p: (Pick.a 0)} \{matchAll p: (Pick.b 0)} \{matchAll p: (Pick.c 0)}"
    print "\{nested k: true} \{nested k: false}"
    print "\{panics k: true} \{foldedIf}"
}
