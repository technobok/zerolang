# list_value.z -- a list's name is a value: `staticlist t`,
# a view of the block's static array. It is bound, passed, returned, held in a
# field, read with `index` and `length`, and walked with `iterate`; binding
# copies the view, takes no lock, and leaves the block readable. A block whose
# `out` is a typedef reads its elements as that typedef.
primes: list { 2 3 5 7 11 } out staticlist u8
halves: list { 0.5 0.25 0.125 }
byteid: typedef u8
codes: list { 9 10 32 } out staticlist byteid

total: function {d: staticlist u8} out u64 is {
    t: 0.u64
    for each p: d.iterate loop t = t + p.u64
    return t
}

pick: function out staticlist u8 is {
    return primes
}

Table: class {
    vals: staticlist u8
}

main: function is {
    print "total=\{total d: primes}"
    w: primes
    print "w0=\{w.get i: 0} wlen=\{w.length} p4=\{primes.4}"
    x: pick
    i: 3.u64
    print "x3=\{x.get :i}"
    t: Table vals: primes
    print "tlen=\{t.vals.length} t2=\{t.vals.get i: 2}"
    n: 0.u64
    for each q: t.vals.iterate loop n = n + q.u64
    print "tsum=\{n}"
    with v: primes do print "with=\{v.length}"
    for each p: primes.iterate loop print "p=\{p}"
    f: halves
    s: 0.0
    for each h: f.iterate loop s = s + h
    print "s=\{s} f1=\{f.get i: 1}"
    m: 0.u64
    for each p: primes loop m = m + p.u64
    for each q: w loop m = m + q.u64
    for each r: t.vals loop m = m + r.u64
    print "each=\{m}"
    j: 1.u64
    c: codes.get i: j
    print "c=\{c.u8}"
}
