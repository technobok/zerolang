# The same for a Set: a reader (has) runs while the set is iterated, because
# the iterator only pins it readonly.
main: function is {
    s: (Set String)
    s.add item: "a".string
    s.add item: "b".string
    with it: s.iterate do for x: it loop {
        h: s.has item: x
        print "x=\{x} h=\{h} of \{s.length}"
    }
}
