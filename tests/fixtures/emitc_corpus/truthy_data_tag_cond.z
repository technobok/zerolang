# A `data`-sourced tag names its own discriminators, and a 2-arm type whose
# values are 0 and 1 is a truth value like any other -- the arm carrying 0 is
# the falsy one WHEREVER it is written. `Rev` below declares the truthy arm
# first and still reads correctly.
#
# Values other than 0 and 1 are an enumeration, not a truth value; those are
# rejected, and errors/cond_data_tag_not_falsy_first pins that.
fwd_values: data { OFF: 0  ON: 1 }
Fwd: union { OFF: null  ON: null } as { tag: fwd_values.tag }

rev_values: data { ON: 1  OFF: 0 }
Rev: union { ON: null  OFF: null } as { tag: rev_values.tag }

main: function is {
    a: Fwd.OFF
    if a then print "Fwd.OFF truthy" else print "Fwd.OFF falsy"
    b: Fwd.ON
    if b then print "Fwd.ON truthy" else print "Fwd.ON falsy"
    c: Rev.OFF
    if c then print "Rev.OFF truthy" else print "Rev.OFF falsy"
    d: Rev.ON
    if d then print "Rev.ON truthy" else print "Rev.ON falsy"
}
