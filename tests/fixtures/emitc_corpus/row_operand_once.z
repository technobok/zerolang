# AN OPERAND IS EVALUATED ONCE, IN WRITTEN ORDER, however often its row names
# it. A natives.tbl row is a C expression that may spell a hole more than once:
# a shift compares its count with the width and then shifts by it, `compare`
# reads each side twice, `leadingZeros` tests for zero first. An operand that
# is a call is read into a temporary before the row spells it, so each `tick`
# below prints once, in the order the operands are written.
#
# `and` and `or` evaluate both sides, left first: they are calls, not the
# short-circuit `when`.

# tick -- prints its label and hands back `v`: a call with an effect
tick: function {label: StringView v: u64} out u64 is {
    print "  \{label}"
    return v
}

# tick64 -- tick for an i64
tick64: function {label: StringView v: i64} out i64 is {
    print "  \{label}"
    return v
}

# truth -- tick for a bool
truth: function {label: StringView v: bool} out bool is {
    print "  \{label}"
    return v
}

# wide -- tick for an i128
wide: function {label: StringView v: i128} out i128 is {
    print "  \{label}"
    return v
}

main: function is {
    print "shift: \{(tick label: "lhs" v: 3) << (tick label: "count" v: 4)}"
    print "signed shift: \{(tick64 label: "lhs" v: -64) >> (tick64 label: "count" v: 2)}"
    print "compare: \{(tick label: "receiver" v: 5).compare rhs: (tick label: "rhs" v: 9)}"
    print "leading zeros: \{(tick label: "receiver" v: 1).leadingZeros}"
    print "trailing zeros: \{(tick label: "receiver" v: 0).trailingZeros}"
    print "bit length: \{(tick label: "receiver" v: 255).bitLength}"
    print "i128 shift: \{(wide label: "lhs" v: 1) << (wide label: "count" v: 100)}"
    print "and: \{(truth label: "left" v: false) and (truth label: "right" v: true)}"
    print "or: \{(truth label: "left" v: true) or (truth label: "right" v: false)}"
}
