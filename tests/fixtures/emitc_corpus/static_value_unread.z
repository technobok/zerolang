# static_value_unread.z -- a static value is written into the C only where
# run-time code reads it. A call through a folded data value's function field
# calls the function by its name, and a copy of that field is the function
# itself, so neither reads the value. A choice value inside another static
# value is written in its holder. static-value-guard checks that nothing
# written goes unread.
unop: function {x: i64} out i64
op: data {
    name: text
    run: unop
}
mode: choice {
    off: null
    level: u8
}
cfg: data {
    m: mode
    n: 0
}
twice: function {x: i64} out i64 is {
    return x * 2
}
dbl: (op name: "dbl" run: twice)
lit: (cfg m: mode.level 3 n: 1)
show: function {c: cfg} is {
    print "\{c.n} \{c.m.level}"
}
main: function is {
    print "\{dbl.run 4}"
    f: dbl.run.copy
    print "\{f x: 5}"
    show c: lit
}
