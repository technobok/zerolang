# match_subject_rebind_hidden.z -- an arm that rebinds the matched subject
# writes the variable wherever the rebind sits: in a binding's value, in a
# reassignment's value, or in a call's argument. Each write must reach the
# variable, not the arm's narrowed payload, so the match after it sees a square.

shape: variant {
    circle: i64
    square: i64
}

describe: function {s: shape} out String is {
    match (
        s
    ) case circle then {
        return "circle \{s}"
    } case square then {
        return "square \{s}"
    }
}

twice: function {x: i64} out i64 is { return x * 2 }

inBinding: function {go: bool} is {
    s: shape.circle 3
    match (
        s
    ) case circle then {
        k: if go then {
            s = shape.square 7
            1
        } else 2
        print "binding \{k}"
    } case square then null
    print (describe :s)
}

inReassignment: function {go: bool} is {
    s: shape.circle 3
    m: 0
    match (
        s
    ) case circle then {
        m = if go then {
            s = shape.square 8
            1
        } else 2
        print "reassignment \{m}"
    } case square then null
    print (describe :s)
}

inArgument: function {go: bool} is {
    s: shape.circle 3
    match (
        s
    ) case circle then {
        r: twice x: (
            if go then {
                s = shape.square 9
                5
            } else 6
        )
        print "argument \{r}"
    } case square then null
    print (describe :s)
}

main: function is {
    inBinding go: true
    inReassignment go: true
    inArgument go: true
}
