# A COMPILE-TIME `match` OVER A GENERIC PARAMETER IS A VALUE. Each instance
# takes the one arm naming what it bound the parameter to (or the else), and
# that arm's value is the match's value there: bound to a local, interpolated,
# converted, returned, of the parameter's own type, or from a value parameter.
# The arm reads the instance's own parameters, and a local an arm declares is
# freed at the arm's end, in the statement form as in the value form.
mathops: unit as {
    t: anyval.generic
    describe: function {v: t big: bool} out String is {
        k: match (t) case i64 then "int" case f64 then "float" else "other"
        r: if big then "\{k} big" else "\{k} small"
        return r
    }
    owned: function {v: t} out String is {
        k: match (t) case i64 then "int" else "other"
        return k.string
    }
    code: function {v: t} out i64 is {
        k: match (t) case i64 then 7 else 9
        return k
    }
}

ints: (mathops t: i64)
flts: (mathops t: f64)

named: function as { t: anyval.generic } in {v: t} out String is {
    return (match (t) case i64 then "int".string else "other".string)
}

inline: function as { t: anyval.generic } in {v: t} out String is {
    return "is \{match (t) case i64 then "int" else "other"}"
}

same: function as { t: anyval.generic } in { v: t } out t is {
    k: match (t) case i64 then v else v
    return k
}

bump: function as { t: anyval.generic } in { v: t big: bool } out i64 is {
    k: match (t) case i64 then (if big then 100 else 1) else 0
    return k + 1
}

echo: function as { t: anyval.generic } in { v: t label: String } out String is {
    k: match (t) case i64 then "\{label}=\{v}" else label.copy
    return k
}

Tag: class {
    n: i64
}

wrap: function as { T: AnyRef.generic } in { v: T } out String is {
    k: match (T) case String then {
        s: "str:".string
        s.append "x"
        s
    } else "plain".string
    return k
}

say: function as { T: AnyRef.generic } in { v: T } is {
    match (T) case String then {
        s: "s=".string
        s.append "y"
        print s
    } else {
        w: "other".string
        print w
    }
}

Buf: class {
    used: u64
} as {
    cap: u64.generic
    label: function {b: this} out String is {
        k: match (cap) case 8 then "eight" case 16 then "sixteen" else "other"
        return "\{k} \{b.used}"
    }
}

main: function is {
    print (ints.describe v: 1 big: true)
    print (flts.describe v: 1.0 big: false)
    print (ints.owned v: 1)
    print "\{ints.code v: 1} \{flts.code v: 1.0}"
    print (named t: i64 v: 1)
    print (named t: bool v: true)
    print (inline t: i64 v: 5)
    print (inline t: bool v: true)
    print "\{same t: i64 v: 5} \{same t: f64 v: 2.5}"
    print "\{bump t: i64 v: 5 big: true} \{bump t: u8 v: 5 big: true}"
    print (echo t: i64 v: 4 label: "a".string)
    print (echo t: bool v: true label: "b".string)
    print (wrap T: String v: "abc".string)
    print (wrap T: Tag v: (Tag n: 3))
    say T: String v: "x".string
    say T: Tag v: (Tag n: 1)
    a: (Buf cap: 8) used: 1
    b: (Buf cap: 3) used: 3
    print a.label
    print b.label
}
