# qualified_type_arg_positional.z -- a type argument written with its unit
# (`system.u8`) binds a construction's leading type parameter as the bare
# name does, with value arguments beside it or without; a unit's constant
# given for a field stays a value.

Box: record { v: t } as {
    t: anyval.generic
}

cfg: unit {
    K: 7
}

bare: function out (intrange t: u8) is { return (intrange u8 cur: 1 left: 3 down: false) }

qualified: function out (intrange t: u8) is {
    return (intrange system.u8 cur: 2 left: 4 down: false)
}

main: function is {
    a: bare
    b: qualified
    print "bare \{a.left} qualified \{b.left}"
    c: (Box system.u8 v: 200)
    d: (Box u8 v: 201)
    print "boxes \{c.v} \{d.v}"
    e: (Box v: cfg.K)
    print "value \{e.v}"
    l: (ListVal system.u16)
    l.append 65535
    print "list \{l.length}"
}
