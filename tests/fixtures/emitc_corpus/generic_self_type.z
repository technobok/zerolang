# Inside a GENERIC type's own members `type` is the instance being checked: the
# type applied to its own parameters, as `(Box t: t)` spells it. Every position
# takes the instance -- a parameter, marked or not; a type argument, in a
# signature, a field and a body; a return; a construction -- at two
# instantiations each, and over a numeric parameter (`cap`) as well as a type
# one. `type` used to be the TEMPLATE, which held only where the whole
# signature type was substituted: `(List type)` named a list of the template,
# and a body's list of it did not compile.
Box: class { v: t  next: (Option T: type) } as {
    t: anyval.generic
    same: function {:this rhs: type.view} out t is { return rhs.v }
    count: function {:this xs: (List type).view} out u64 is { return xs.length }
    fresh: function {:this} out type is { return (type v: this.v next: (Option T: type).none) }
    kids: function {:this} out u64 is {
        xs: List type
        xs.append (type v: this.v next: (Option T: type).none)
        return xs.length
    }
}

Pt: record { x: t } as {
    t: anyval.generic
    plus: function {:this o: type} out type is { return (type x: this.x + o.x) }
    within: function {:this os: (ListVal type).view} out u64 is { return os.length }
}

Ring: record { n: t } as {
    t: anyval.generic
    cap: u64.generic
    same: function {:this o: type} out u64 is { return cap }
    held: function {:this} out u64 is {
        xs: ListVal type
        xs.append this
        return xs.length + cap
    }
}

main: function is {
    a: (Box t: i64) v: 4 next: (Option T: (Box t: i64)).none
    b: (Box t: i64) v: 9 next: (Option T: (Box t: i64)).none
    bs: List (Box t: i64)
    bs.append (a.fresh)
    print "box i64 \{a.same rhs: b} \{a.count xs: bs} \{a.fresh.v} \{a.kids}"
    f: (Box t: f64) v: 0.5 next: (Option T: (Box t: f64)).none
    g: (Box t: f64) v: 2.5 next: (Option T: (Box t: f64)).none
    print "box f64 \{f.same rhs: g} \{f.fresh.v} \{f.kids}"

    p: (Pt t: i64) x: 2
    ps: ListVal (Pt t: i64)
    ps.append p
    print "pt i64 \{(p.plus o: p).x} \{p.within os: ps}"
    q: (Pt t: f64) x: 1.5
    print "pt f64 \{(q.plus o: q).x}"

    r: (Ring t: i64 cap: 4) n: 1
    r8: (Ring t: i64 cap: 8) n: 1
    print "ring \{r.same o: r} \{r.held} \{r8.same o: r8} \{r8.held}"
}
