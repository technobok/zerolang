# word_carry_only.z -- one carry step and nothing else of the word primitives.
# It pulls the runtime the carry steps share with the two-word division, and
# that runtime names no record type: the records the other primitives answer
# are never made here, and a runtime that spelled one would not compile.

main: function is {
    s: 18446744073709551615.u64.addCarry rhs: 2 carry: 0
    print "\{s.value} \{s.carry}"
}
