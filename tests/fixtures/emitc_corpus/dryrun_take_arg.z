# a generic construction whose argument is a `.take`: the inference dry run
# must not leave the take behind, or the real walk reports use-after-move.
Box: class {
    n: i64
}
Pair: class {
    a: t
    b: t
} as { t: AnyRef.generic }
main: function is {
    x: (Box n: 1)
    y: (Box n: 2)
    p: (Pair a: x.take b: y.take)
    print "\{p.a.n} \{p.b.n}"
}
