# `iterateMut` is the mutable walk over a List: an exclusive receiver whose
# elements may be written through. It exists so that `iterate` can become the
# readonly twin and keep the plain name -- the same inversion as get/getMut,
# and for the same reason: most walks only read.
#
# Nothing here calls `iterate`, which is the point. The ListIter cursor and its
# entry point must be emitted from the mutable name alone, and the values below
# are printed rather than merely compiled: a routing bug that emits the wrong
# symbol dies at gcc, but one that emits the RIGHT symbol over a stale copy of
# the list would still compile clean.
Row: class {
    n: i64
    label: String
}
main: function is {
    rows: (List Row)
    rows.append from: (Row n: 1 label: "a".string)
    rows.append from: (Row n: 2 label: "b".string)

    with it: rows.iterateMut do for r: it loop {
        r.n = r.n + 10
        r.label.append s: "!".string
    }
    a: rows.get i: 0
    b: rows.get i: 1
    print "rows=\{a.n},\{a.label} \{b.n},\{b.label}"

    # the direct form, with no intermediate iterator binding
    names: (List String)
    names.append from: "x".string
    names.append from: "y".string
    for s: names.iterateMut loop {
        s.append s: "z".string
    }
    n0: names.get i: 0
    n1: names.get i: 1
    print "names=\{n0} \{n1}"
}
