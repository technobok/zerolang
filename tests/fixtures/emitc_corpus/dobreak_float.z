# dobreak_float.z -- a break-carrying block value whose result is a FLOAT
# literal. The block wraps in optionval and the payload keeps its literal
# type all the way to the emitter, so literal_float needs the same scalar
# C spelling literal_int has. Without it the generated optionval's
# structural `==` compares two opaque structs and the C does not compile,
# while zc itself reports success.
main: function is {
    x: {
        if 1 > 2 then break
        4.5
    }
    match (
        x
    ) case some then {
        print "x some"
    } case none then {
        print "x none"
    }
    y: {
        if 1 < 2 then break
        2.25
    }
    match (
        y
    ) case some then {
        print "y some"
    } case none then {
        print "y none"
    }
}
