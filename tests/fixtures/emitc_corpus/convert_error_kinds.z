# convert_error_kinds -- the error a lossy conversion to a float reports at the
# top of the destination's range, and a NaN narrowed between float types. A
# NaN narrows to a NaN, as an infinity narrows to an infinity. A value the
# conversion would round past the largest finite value is outOfRange whatever
# type it comes from, an integer as much as a float; an inexact one below that
# is precisionLoss. Every value reaches its conversion as an argument, so each
# test is the run-time row's.

# kindOf -- the name of a conversion's error
kindOf: function {e: converror} out String is {
    k: "outOfRange".string
    match e case outOfRange then null case precisionLoss then k = "precisionLoss".string
    return k
}

# f64f32 -- an f64 narrowed to f32: its bits, `nan`, or the error
f64f32: function {x: f64} out String is {
    r: x.f32
    s: String
    match (
        r
    ) case ok then {
        s = "\{r.bits}"
        if r != r then s = "nan".string
    } case err then {
        s = kindOf e: r
    }
    return s
}

# f64f16 -- an f64 narrowed to f16
f64f16: function {x: f64} out String is {
    r: x.f16
    s: String
    match (
        r
    ) case ok then {
        s = "\{r.bits}"
        if r != r then s = "nan".string
    } case err then {
        s = kindOf e: r
    }
    return s
}

# f32f16 -- an f32 narrowed to f16
f32f16: function {x: f32} out String is {
    r: x.f16
    s: String
    match (
        r
    ) case ok then {
        s = "\{r.bits}"
        if r != r then s = "nan".string
    } case err then {
        s = kindOf e: r
    }
    return s
}

# i32f16 -- an i32 converted to f16
i32f16: function {x: i32} out String is {
    r: x.f16
    s: String
    match r case ok then { s = "\{r.bits}" } case err then { s = kindOf e: r }
    return s
}

# u16f16 -- a u16 converted to f16
u16f16: function {x: u16} out String is {
    r: x.f16
    s: String
    match r case ok then { s = "\{r.bits}" } case err then { s = kindOf e: r }
    return s
}

# u32f16 -- a u32 converted to f16
u32f16: function {x: u32} out String is {
    r: x.f16
    s: String
    match r case ok then { s = "\{r.bits}" } case err then { s = kindOf e: r }
    return s
}

# i64f16 -- an i64 converted to f16
i64f16: function {x: i64} out String is {
    r: x.f16
    s: String
    match r case ok then { s = "\{r.bits}" } case err then { s = kindOf e: r }
    return s
}

# i128f16 -- an i128 converted to f16
i128f16: function {x: i128} out String is {
    r: x.f16
    s: String
    match r case ok then { s = "\{r.bits}" } case err then { s = kindOf e: r }
    return s
}

# u128f16 -- a u128 converted to f16
u128f16: function {x: u128} out String is {
    r: x.f16
    s: String
    match r case ok then { s = "\{r.bits}" } case err then { s = kindOf e: r }
    return s
}

# u128f32 -- a u128 converted to f32
u128f32: function {x: u128} out String is {
    r: x.f32
    s: String
    match r case ok then { s = "\{r.bits}" } case err then { s = kindOf e: r }
    return s
}

main: function is {
    z: 0.0.f64
    nan: z / z
    inf: 1.0.f64 / z
    zf: 0.0.f32
    print "f64.f32 nan \{f64f32 x: nan} inf \{f64f32 x: inf} -inf \{f64f32 x: z - inf}"
    print "f64.f16 nan \{f64f16 x: nan} inf \{f64f16 x: inf}"
    print "f32.f16 nan \{f32f16 x: (zf / zf)} 65504 \{f32f16 x: 65504.0.f32} 65505 \{f32f16 x: 65505.0.f32} 65520 \{(
        f32f16
        x: 65520.0.f32
    )}"
    print "i32.f16 65504 \{i32f16 x: 65504.i32} 65505 \{i32f16 x: 65505.i32} 65519 \{(
        i32f16
        x: 65519.i32
    )}"
    print "i32.f16 65520 \{i32f16 x: 65520.i32} -65520 \{i32f16 x: -65520.i32} -65519 \{(
        i32f16
        x: -65519.i32
    )}"
    print "u16.f16 65504 \{u16f16 x: 65504.u16} 65535 \{u16f16 x: 65535.u16}"
    print "u32.f16 70000 \{u32f16 x: 70000.u32} i64.f16 -100000 \{i64f16 x: -100000.i64}"
    print "i128.f16 65520 \{i128f16 x: 65520.i128} 2048 \{i128f16 x: 2048.i128}"
    print "u128.f16 65519 \{u128f16 x: 65519.u128} 65520 \{u128f16 x: 65520.u128}"
    print "u128.f32 below \{u128f32 x: 340282356779733661637539395458142568447.u128}"
    print "u128.f32 at \{u128f32 x: 340282356779733661637539395458142568448.u128}"
    print "u128.f32 max \{u128f32 x: 340282366920938463463374607431768211455.u128}"
    print "u128.f32 2^127 \{u128f32 x: 170141183460469231731687303715884105728.u128}"
}
