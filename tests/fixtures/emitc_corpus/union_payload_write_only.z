# union_payload_write_only -- a union parameter's class payload is written
# through the name a match arm narrows it to, and the class is built nowhere:
# the write is the only place its C type is spelled, so the write demands it.
# Before the fix the C named an undeclared type (`z_tN_t`) and did not
# compile.

Box: class {
    m1: 0.i8
    m2: 0.i8
}

Un: union {
    c1: null
    c2: Box
}

clear: function {u: Un} out i32 is {
    match (
        u
    ) case c2 then {
        u.m2 = -126.i8
        return 1.i32
    } else null
    return 0.i32
}

main: function is {
    print "cleared \{clear u: Un.c1}"
}
