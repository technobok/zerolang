# a generic instance holding, by value, a mono that embeds a user type -- an
# array of records or of instances, an optionval of an instance, a variant arm
# over one -- is written after that mono, and so is a record or instance that
# holds such an instance in turn; `==` on it compares every part.
Plain: record {
    v: i64
}
Cell: record {
    val: t
} as { t: anyval.generic }
Row: record {
    cells: (array t: Plain to: 2)
    x: t
} as { t: anyval.generic }
Line: record {
    cells: (array t: (Cell t: t) to: 2)
    x: t
} as { t: anyval.generic }
Maybe: record {
    c: (optionval (Cell t: t))
} as { t: anyval.generic }
Slot: variant {
    many: (array t: (Cell t: t) to: 2)
    none: null
} as { t: anyval.generic }
Holder: record {
    r: (Row t: i64)
    n: i64
}
Grid: record {
    a: (Line t: t)
    b: (optionval (Row t: t))
} as { t: anyval.generic }
main: function is {
    h: Holder r: (Row t: i64 cells: (array t: Plain to: 2) x: 1) n: 7
    print "holder: \{h.r.cells.length} \{h.r.x} \{h.n}"
    m: Maybe t: i64 c: (optionval.some (Cell t: i64 val: 4))
    print "maybe: \{m.c.some}"
    s: (Slot t: i64).none
    print "slot: \{s.none}"
    g: Grid t: u8 a: (Line t: u8 cells: (array t: (Cell t: u8) to: 2) x: 3) b: (optionval.none (Row t: u8))
    print "grid: \{g.a.x} \{g.b.none}"
    l: ListVal (Row t: i64)
    l.append from: (Row t: i64 cells: (array t: Plain to: 2) x: 5)
    print "list: \{l.length}"
    a: Line t: i64 cells: (array t: (Cell t: i64) to: 2) x: 1
    b: Line t: i64 cells: (array t: (Cell t: i64) to: 2) x: 1
    c: Line t: i64 cells: (array t: (Cell t: i64) to: 2) x: 2
    print "eq: \{a == b} \{a == c}"
}
