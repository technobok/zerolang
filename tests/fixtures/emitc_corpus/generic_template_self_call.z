# generic_template_self_call.z -- a method on a GENERIC template calling a
# sibling method on `this`. It could not be written: inside a template body the
# receiver stamps as the TEMPLATE, so the read resolved the template's own
# member and named a function that is never emitted -- only the per-instance
# clones are.
#
# Both families are here because they failed differently. A generic CLASS
# emitted a struct-field function pointer (`_this->get(_this)`), which no
# emitted struct has, because every method of a generic template was marked as
# an fnptr slot. A generic RECORD emitted a direct call to the template's
# function id. The marking was one bug; the stamp was the other, and a class
# receiver reaches the nested-base leg where a record's reaches the atom one,
# so both legs had to learn the same rule.
Cel: class {
    v: i64
} as {
    t: anyval.generic
    get: function {:this} out i64 is { return this.v }
    twice: function {:this} out i64 is { return this.get + this.get }
}

Rec: record {
    v: i64
} as {
    t: anyval.generic
    get: function {:this} out i64 is { return this.v }
    twice: function {:this} out i64 is { return this.get + this.get }
}

main: function is {
    c: (Cel t: i64 v: 21)
    r: (Rec t: i64 v: 50)
    print "cls=\{c.twice}"
    print "rec=\{r.twice}"
}
