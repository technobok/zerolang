# nested_block_break_in_expr_if_arm -- a `break` inside a block nested in an arm leaves
# that block, not the `if`: an `if` used inside an expression may hold one
show: function {n: i64} is {
    print "n \{n}"
}

main: function is {
    k: true
    show n: (if k then {
        v: {
            if k then break
            2
        }
        if v.none then 5 else 6
    } else 1)
}
