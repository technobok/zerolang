# Constants and data read in a body, and a plain string constant joined with an
# escaped literal: the shapes that already folded before an escaped constant or
# a data element could be a unit-level constant.
primes: data { 2 3 5 7 }
codes: data {
    ht: 9
    lf: 10
} out u8
PLAIN: "plain"
WITHNL: PLAIN + "\n"

main: function is {
    n: "a\nb".length
    print "\{primes.1} \{codes.ht} \{primes.length} \{n} \{WITHNL.length}"
}
