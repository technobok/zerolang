# shadow_bool.z -- a user record SHADOWS the builtin `bool`. Scalar names are not
# reserved, and `bool` is the one name the C-type table knows that cannot carry
# `is native`: it is a variant with arms, and the grammar gives the marker only
# to a type with no is-block. So the emitter cannot ask its declaration and asks
# its canonical id instead. The user value must be built AND stored as its struct,
# while the real `bool` behind a comparison must stay the C scalar.

bool: record {
    hi: 0
    lo: 0
}

main: function is {
    x: bool hi: 1 lo: 2
    ok: 1 < 2
    print "hi=\{x.hi} lo=\{x.lo} ok=\{ok}"
}
