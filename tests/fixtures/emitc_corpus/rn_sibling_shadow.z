# Two SIBLING blocks may each bind a local of the same name -- only a nested
# block shadows, and these two do not nest. The emitter flattens a bare block
# into its enclosing C block, so the two bindings land in one C scope: the
# variable id is what keeps their C identifiers apart, and `--readable-names`
# spells a local by its source name. The second `n` therefore carries its id.
Box: class {
    n: i64
}

twice: function {b: Box.view} out i64 is {
    r: 0
    {
        n: b.n
        r = n
    }
    {
        n: b.n + 1
        r = r + n
    }
    return r
}

main: function is {
    x: Box n: 4
    print "\{twice b: x}"
}
