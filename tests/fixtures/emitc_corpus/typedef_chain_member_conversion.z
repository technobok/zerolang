# A typedef's own member wins, and any other is found through the whole chain:
# the first link that declares it answers. A conversion member a typedef
# declares (`meters.u32`) is that member through a typedef of it too (`inner`),
# not the chain-end scalar's native conversion; a typedef that declares none
# (`plain`) converts as its base.
meters: typedef u8 as {
    u32: function {t: this.view} out system.u32 is {
        return 42
    }
}
inner: typedef meters
plain: typedef u8

main: function is {
    m: meters 5
    i: inner m
    p: plain 7
    print "\{m.u32} \{i.u32} \{p.u32}"
}
