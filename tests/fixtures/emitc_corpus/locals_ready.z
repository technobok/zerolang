# locals_ready.z -- code runs top to bottom: a local is the name's meaning from
# the statement that declares it on, and before that statement the name means
# what it meant: an outer local, a unit constant, a type. A nested block's local
# ends with the block; a loop's, a `with`'s and a match arm's bindings are their
# own; a parameter is always available, in value position too; an outer name a
# local hides is reached through its unit.
n: 40

# a parameter, read as a value
copyOf: function {u8: i64} out i64 is {
    v: u8
    return v + 1
}

# the unit constant before the local of its name, then the local; the unit's
# reached through the unit after it
shadowsUnit: function out i64 is {
    before: n
    n: 2
    return before + n + locals_ready.n
}

# the type before the local of its name
typeBefore: function out u64 is {
    v: u64
    u64: 7.u64
    return v + u64
}

main: function is {
    x: 1
    if true then {
        # the outer x, until this block declares its own
        print "outer in block \{x}"
        x: 2
        print "inner \{x}"
    }
    print "outer \{x}"
    xs: ListVal i64
    xs.append 4
    for each k: xs loop print "loop \{k}"
    k: 5
    s: "ab".string
    with w: s do {
        print "with \{w}"
    }
    w: 6
    o: optionval.some 7.i64
    match (
        o
    ) case some then {
        m: o + 1
        print "arm \{m}"
    } case none then null
    m: 9
    print "\{k} \{w} \{m} \{copyOf u8: 10} \{shadowsUnit} \{typeBefore}"
}
