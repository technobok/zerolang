# A reassignment keeps the mode its target was bound with. An owned local or
# field takes an owned value: `.take` of a local, a construction, a call's
# result. A local moved out is refilled the same way -- on every path
# (straight on, after a move in a branch, in a plain block, in every arm of an
# `if`/`else` or a `match`), inside a branch alone (the local is then held on
# some paths only, and freed at its end whichever ran), or inside a loop that
# consumes it and refills it before the next iteration. An unmarked value-type
# parameter is the callee's own copy, reassigned whole as a local is.
Cell: class { n: i64  s: String }
H: class { f: Cell }

keep: function {c: Cell.take} out i64 is { return c.n }

mk: function {n: i64} out Cell is { return (Cell :n s: "made".string) }

pt: record { x: i64 }

bump: function {p: i64 q: pt} out i64 is {
    p = p + 1
    q = pt x: q.x + p
    return q.x
}

main: function is {
    x: Cell n: 1 s: "x".string
    d: Cell n: 2 s: "d".string
    x = d.take
    h: H f: (Cell n: 3 s: "h".string)
    e: Cell n: 4 s: "e".string
    h.f = e.take
    x = mk n: 5
    h.f = mk n: 55
    print "owned \{x.n} \{h.f.n}"
    y: x.take
    x = Cell n: 6 s: "refill".string
    print "refill \{y.n} \{x.n}"
    c: true
    if c then {
        z: x.take
        print "branch \{z.n}"
    }
    x = mk n: 7
    print "after branch \{x.n}"
    w: x.take
    if c then x = Cell n: 8 s: "some paths".string
    print "moved \{w.n}"
    v: Cell n: 10 s: "v".string
    t: 0
    i: 0
    for i < 3 loop {
        t = t + (keep c: v.take)
        v = mk n: i
        i = i + 1
    }
    print "loop \{t} \{v.n}"
    g: Cell n: 11 s: "g".string
    r: Cell n: 12 s: "r".string
    r = if c then g.take else (mk n: 13)
    print "arm \{r.n}"
    u: r.take
    {
        r = mk n: 14
    }
    print "block \{u.n} \{r.n}"
    u2: r.take
    if c then r = mk n: 15 else r = mk n: 16
    print "every arm \{u2.n} \{r.n}"
    u3: r.take
    match (c) case true then r = mk n: 17 case false then r = mk n: 18
    print "match arms \{u3.n} \{r.n}"
    k: 1
    kp: pt x: 2
    print "param copy \{bump p: k q: kp} \{k} \{kp.x}"
}
