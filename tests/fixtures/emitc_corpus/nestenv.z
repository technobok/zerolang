# nestenv -- the environment a definition inside a nested unit resolves
# against: its own unit, then each unit ENCLOSING it, then the file unit, then
# the prelude. Reading one nested frame instead of the chain left every unit
# between the innermost and the file unit invisible.
HOSTV: 10

sibling: unit {
    SIBV: 3
}

outer: unit {
    OUTERV: 20
    inner: unit {
        INNERV: 30
        # its own, the enclosing inline unit, the file unit, and a sibling
        # inline unit reached by a qualified path
        all: function out i64 is {
            return INNERV + OUTERV + HOSTV + sibling.SIBV
        }
    }
}

# an inline unit inside a hidden SUBUNIT sees the subunit it is written in
viaSub: function out i64 is {
    return sub.inl.reach
}
