# An arm predicate and a tag read on a variant receiver: the receiver is a C
# pointer in a method body, and an ordinal variant's discriminator IS its value,
# so both have to load the pointee rather than test the pointer.
colour: variant {
    red: null
    blue: null
    green: null
} as {
    tag: u8.tag

    isRed: function {:this} out i64 is {
        if this.red then return 1
        return 0
    }

    isGreenNamed: function {t: this} out i64 is {
        if t.green then return 1
        return 0
    }

    num: function {:this} out u8 is {
        return this.tag
    }
}

# a two-arm variant is ordinal-PAIR shaped: the discriminator is a C bool and
# the predicate is an identity or a negation, with the same load to do
toggle: variant {
    off: null
    lit: null
} as {
    isOff: function {:this} out i64 is {
        if this.off then return 1
        return 0
    }
}

main: function is {
    r: colour.red
    g: colour.green
    b: colour.blue
    print "\{r.isRed} \{g.isRed} \{b.isRed}"
    print "\{r.isGreenNamed} \{g.isGreenNamed}"
    print "\{r.num} \{b.num} \{g.num}"
    lit9: toggle.lit
    off9: toggle.off
    print "\{lit9.isOff} \{off9.isOff}"
}
