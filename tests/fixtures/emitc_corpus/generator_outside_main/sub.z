# a hidden subunit of generator_outside_main: its generators are lowered and
# driven like the main unit's.
Count: generator { hi: i64 } as {
    call: function out i64 is {
        i: 0
        for i < this.hi loop {
            yield i
            i = i + 1
        }
    }
}

Words: generator as {
    call: function out String.take is {
        yield "alpha".string
        yield "beta".string
    }
}

total: function out i64 is {
    t: 0
    for v: (Count hi: 4) loop t = t + v
    return t
}
