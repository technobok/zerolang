# Every Map form iterates its own family: Map keeps MapKeyIter / MapItemIter /
# MapEntry, and MapRV / MapVR / MapVV each have their RV / VR / VV forms. The
# entry projections view the bucket, so interpolating `e.key` / `e.value` must
# append inline; a String key (rv) and a String value (rr, vr) walk that
# exemption per entry form.
main: function is {
    rr: (Map String V: String)
    rr.set key: "a".string value: "one".string
    rr.set key: "b".string value: "two".string
    for each k: rr loop print "rr key \{k}"
    for each e: rr.iterateItems loop print "rr item \{e.key}=\{e.value}"

    rv: (MapRV String v: u64)
    rv.set key: "x".string value: 10
    rv.set key: "y".string value: 20
    for each k2: rv loop print "rv key \{k2}"
    for each e2: rv.iterateItems loop print "rv item \{e2.key}=\{e2.value}"

    vr: (MapVR u64 V: String)
    vr.set key: 1 value: "one".string
    vr.set key: 2 value: "two".string
    for each k3: vr loop print "vr key \{k3}"
    for each e3: vr.iterateItems loop print "vr item \{e3.key}=\{e3.value}"

    vv: (MapVV u64 v: u64)
    vv.set key: 7 value: 70
    vv.set key: 9 value: 90
    for each k4: vv loop print "vv key \{k4}"
    for each e4: vv.iterateItems loop print "vv item \{e4.key}=\{e4.value}"
}
