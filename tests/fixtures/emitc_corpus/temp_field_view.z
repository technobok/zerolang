# A view of a field of a value no name holds -- a call's result -- keeps that
# value until the view's block ends: a view bound to the field, a bare borrow
# of it, a nested field, an element of a list field, a substring of a field,
# and a local named like the field beside it, which the view does not reach.
Inner: class { s: String }
Box: class { s: String  inner: Inner  items: List String }

mk: function {k: u64} out Box is {
    xs: List String
    xs.append "item\{k}"
    return (Box s: "abc\{k}" inner: (Inner s: "in\{k}") items: xs.take)
}

viewField: function is {
    v: (mk k: 1).s.stringView
    print "view \{v}"
}

borrowField: function is {
    b: (mk k: 2).s
    print "borrow \{b}"
}

nested: function is {
    v: (mk k: 3).inner.s.stringView
    print "nested \{v}"
}

getOfField: function is {
    e: (mk k: 4).items.get i: 0
    print "get \{e}"
}

substr: function is {
    v: (mk k: 5).s.substring from: 0 to: 2
    print "sub \{v}"
}

sameName: function is {
    s: "local".string
    v: (mk k: 6).s.stringView
    print "same \{v} \{s}"
}

main: function is {
    viewField
    borrowField
    nested
    getOfField
    substr
    sameName
}
