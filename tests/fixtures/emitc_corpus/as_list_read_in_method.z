# A list a class's `as` block declares is read at run time from the class's
# methods -- by `get`, bound to a name -- and its array is written out, as a
# unit's list is. A generic class's list is each instance's own: typed by the
# instance's argument, its elements held at that type.
Plain: class {
    v: i64
} as {
    vals: list { 2 3 250 } out staticlist i64
    pick: function {b: this.view i: u64} out i64 is {
        return (vals.get :i)
    }
    bound: function {b: this.view i: u64} out i64 is {
        w: vals
        return (w.get :i)
    }
}

Box: class {
    v: t
} as {
    t: anyval.generic
    vals: list { 2 3 250 } out staticlist t
    pick: function {b: this.view i: u64} out t is {
        return (vals.get :i)
    }
    show: function {b: this.view} is {
        for each x: vals loop print "\{x}"
        print "n=\{vals.length}"
    }
}

main: function is {
    p: Plain v: 1
    print "\{p.pick i: 2} \{p.bound i: 0}"
    b: (Box t: i64) v: 1
    print "\{b.pick i: 2}"
    b.show
    c: (Box t: u8) v: 1
    print "\{c.pick i: 1}"
    c.show
}
