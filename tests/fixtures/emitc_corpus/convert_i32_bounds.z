# A CHECKED CONVERSION TO i32 READS ITS BOUNDS AS SIGNED on every C compiler.
# The lower bound is -2^31. A C compiler whose `long` is 32 bits may read the
# decimal 2147483648 as unsigned, so `-2147483648` would be +2^31 there, and
# every value below it -- -5 among them -- would read as out of range. The
# bound, and a folded constant at it, are spelled so no compiler can.
main: function is {
    vals: ListVal i64
    vals.append (0 - 5)
    vals.append (0 - 2147483648)
    vals.append (0 - 2147483649)
    vals.append 2147483647
    vals.append 2147483648
    for each v: vals loop {
        r: v.i32
        match (r) case ok then print "\{v}: ok \{r}" case err then print "\{v}: out of range"
    }
    print "folded: \{(0 - 2147483648).i64} \{1.i32 << 31}"
}
