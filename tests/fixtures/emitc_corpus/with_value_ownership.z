# with_value_ownership.z -- a `with` binds and hands back values as a binding
# does. A `with` over an `if` whose arms yield a place is a reference to that
# place: the `with`'s end frees nothing, and the source stays readable. A `with`
# whose body hands back its own owned value moves it out to what binds the
# `with`, which owns it from then on.
Bag: class {
    name: String
}

mk: function out String is {
    return "made".string
}

flagOn: function out bool is {
    return true
}

main: function is {
    s: Bag name: "abc".string
    k: flagOn
    with v: (if k then s else s) do print v.name
    print s.name
    xs: List String
    xs.append "elem".string
    with e: (if k then (xs.get i: 0) else (xs.get i: 0)) do print e
    print (xs.get i: 0)
    m: (with w: mk do w)
    print m
    b: {
        t: mk
        t
    }
    print b
}
