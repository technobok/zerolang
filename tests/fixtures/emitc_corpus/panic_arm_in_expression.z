# An `if` or a `match` used inside an expression -- an argument, an operator's
# operand -- may have an arm that leaves through `panic`: the arm yields no
# value, so the construct runs as statements, the arm as the statement it is.
# A literal operation whose operand is such a value (`1 + (if c then 4 else
# 5)`) has no compile-time value, so it lands in the literal's default type.
add: function {a: u64 b: u64} out u64 is {
    return a + b
}
len: function {s: String} out u64 is {
    return s.length
}
U: union {
    some: u64
    none: null
}
main: function is {
    c: false
    r: add a: 1 b: (if c then { panic msg: "no" } else 2)
    print "\{r}"
    r2: add a: 1 b: (if c then panic msg: "no" else 3)
    print "\{r2}"
    r3: 1 + (if c.not then 4 else panic msg: "no")
    print "\{r3}"
    u: U.some 5
    r4: add a: 1 b: (match (u) case some then u case none then panic msg: "none")
    print "\{r4}"
    r5: len s: (if c then { panic msg: "no" } else "abc".string)
    print "\{r5}"
    r6: add a: 0 b: (if c then 1 else if c.not then 6 else panic msg: "x")
    print "\{r6}"
    k: if c.not then 1 else 0
    r7: add a: 1 b: (if k == 1 then 2 else panic msg: "taken")
    print "\{r7}"
    r8: 1 + (if c then 4 else 5)
    r9: (if c then 4 else 5) + (if c.not then 10 else 20)
    rA: 2 * (match (u) case some then 3 case none then 4)
    print "\{r8} \{r9} \{rA}"
}
