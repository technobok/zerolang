# A `.borrow` return may be backed by a `.view` parameter, not just a `.borrow`
# one: the returned view's parent is pinned either way -- readonly here,
# exclusive for `.borrow`. Reading through the returned view while the
# parent stays readable is the point of the readonly pin.
Item: class {
    n: i64
}
Bag: class {
    it: Item
} as {
    peek: function {t: this.view} out Item.borrow is {
        return t.it
    }
    size: function {t: this.view} out i64 is {
        return t.it.n
    }
}
main: function is {
    b: Bag it: (Item n: 1)
    {
        p: b.peek
        # the parent is only readonly-pinned, so it stays readable here
        print "peek=\{p.n} size=\{b.size}"
    }
    print "read=\{b.it.n}"
}
