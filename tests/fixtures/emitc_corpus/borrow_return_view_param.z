# What a `.view` receiver can lend is a `.view`: the returned view's parent is
# readonly-pinned, and a view converts to no other ownership, so `outx
# Item.borrow` here is refused (errors/borrow_result_through_view). Reading
# through the returned view while the parent stays readable is the point of
# the readonly pin.
Item: class {
    n: i64
}

Bag: class {
    it: Item
} as {
    peek: function {t: this.view} outx Item.view is {
        return t.it
    }
    size: function {t: this.view} out i64 is {
        return t.it.n
    }
}

main: function is {
    b: Bag it: (Item n: 1)
    {
        p: b.peek
        # the parent is only readonly-pinned, so it stays readable here
        print "peek=\{p.n} size=\{b.size}"
    }
    print "read=\{b.it.n}"
}
