# text_api.z -- text reads as a StringView does: the queries, and the methods
# that build a new String, run the StringView members of the same name.
words: list { "alpha" "Beta gamma" }
show: function {t: text} is {
    x: "ph"
    print "\{t.isAscii} \{t.startsWith prefix: "al"} \{t.endsWith suffix: x} \{t.contains needle: "a g"}"
    i: t.indexOf needle: "a"
    j: t.lastIndexOf needle: "a"
    print "\{i.or d: 99} \{j.or d: 99} \{(t.byteAt i: 0).or d: 0} \{(t.splitOnce sep: " ").or d: 99} \{t.count}"
    up: t.toUpperAscii
    lo: t.toLowerAscii
    r: t.replace needle: "a" replacement: "A"
    f: t.replaceFirst needle: "a" replacement: "_"
    rep: t.repeated n: 2
    c: t.concat other: "!"
    p: t + "?"
    print "\{up} \{lo} \{r} \{f} \{rep} \{c} \{p}"
    n: u64
    cps: t.codepoints
    for cp: cps loop n = n + 1
    print "\{n}"
}
main: function is {
    for each w: words loop show t: w
}
