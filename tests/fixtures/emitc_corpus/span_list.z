# span_list.z -- a ListVal's storage lent as a writable window: mutView over the
# whole list and mutSlice over part of it, written through, filled, cleared and
# copied into; a window handed to a function that writes through it; a read view
# of a window; and resize, which grows with zeros and shrinks. Every write lands
# in the list the window was lent by.

# the list's elements, space-separated
show: function {xs: (ListVal u64).view} out String is {
    r: String
    for each x: xs.iterate loop {
        if r.length > 0 then r.append " "
        r.append "\{x}"
    }
    return r
}

# double every element the window spans
double: function {w: (SpanVal u64).borrow} is {
    i: 0.u64
    for i < w.length loop {
        w.set :i item: (w.get :i) * 2
        i = i + 1
    }
}

main: function is {
    xs: ListVal u64
    for each n: 5.u64.times loop xs.append from: n + 1
    {
        w: xs.mutView
        w.set i: 0 item: 10
        print "length \{w.length} first \{w.get i: 0}"
        double :w
    }
    print "doubled \{show :xs}"
    {
        m: xs.mutSlice from: 1 to: 3
        m.fill item: 7
    }
    print "filled \{show :xs}"
    {
        m: xs.mutSlice from: 3 to: 5
        m.clear
    }
    print "cleared \{show :xs}"
    src: ListVal u64
    src.append from: 100
    src.append from: 200
    {
        w: xs.mutView
        w.copyFrom from: src.listView
        v: w.listView
        print "copied \{v.length} \{v.get i: 1}"
    }
    print "after copy \{show :xs}"
    xs.resize to: 7
    print "grown \{show :xs}"
    xs.resize to: 2
    print "shrunk \{show :xs}"
}
