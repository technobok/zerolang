# typedef_projection.z -- a typedef of a conformer conforms through its base,
# and a projection -- `P.create from: v`, `P v.borrow` -- builds it from the
# row the typedef takes over from its base. That row was recorded only where
# the typedef stood in at a spec PARAMETER, so a typedef that was only ever
# projected had no helpers: zc stopped at "unhandled callee", the create
# declined for want of a label. A projection's source is now checked as a
# stand-in, as an argument is.
Speaker: protocol {
    speak: function {t: this.view} out i64
}
Cat: class { n: i64 } as {
    :Speaker
    speak: function {t: this.view} out i64 is { return t.n }
}
Kit: typedef Cat

sizer: facet {
    size: function {t: this.view} out u64
}
pt: record { x: u64 } as {
    m: sizer
    size: function {t: this.view} out u64 is { return t.x }
}
Dot: typedef pt

main: function is {
    xs: List Speaker
    xs.append (Speaker.create from: (Kit (Cat n: 9)))
    k: Kit (Cat n: 4)
    {
        b: Speaker k.borrow
        print "\{b.speak}"
    }
    xs.append (Speaker.create from: k.take)
    n: 0.i64
    for x: xs.iterate loop n = n + x.speak
    print "\{n} \{xs.length}"
    d: Dot (pt x: 6)
    z: sizer.create from: d
    print "\{z.size}"
}
