# generator_counted_for.z -- a COUNTED `for` whose body suspends.
#
# `for x: n loop` emits a C `for (int64_t x = 0; x < n; x++)`, and the resume
# `goto` lands inside the loop, PAST that init clause. A counter on the frame is
# therefore indeterminate on the second `.call`: the loop yielded 0 once and
# then reported itself exhausted -- a wrong answer with no diagnostic. It cannot
# be promoted to a field the way a local is, because a `for` label is a nameid
# on the header's namedoperation rather than an assignment, so the crossing
# analysis never sees it and it carries no variable id either. The counter keeps
# its C local and is SPILLED to a state field across each suspension instead,
# which leaves the header, `continue` and the increment exactly as they were.
#
# `Skips` proves `continue` still runs the increment; `Grid` proves nested loops
# take a slot each; `AddK` proves a counter slot and a resume slot coexist, and
# drives past exhaustion so a short answer cannot pass.

Count: generator { n: i64 } as {
    call: function out i64 is {
        for x: this.n loop yield x
    }
}

Skips: generator { n: i64 } as {
    call: function out i64 is {
        for x: this.n loop {
            if x == 2 then continue
            yield x
        }
    }
}

Grid: generator { n: i64 } as {
    call: function out i64 is {
        for a: this.n loop {
            for b: this.n loop yield (a * 10) + b
        }
    }
}

AddK: generator { n: i64 } as {
    call: function {step: i64} out i64 is {
        for x: this.n loop {
            k: yield x
            yield x + k
        }
    }
}

main: function is {
    for c: (Count n: 4) loop print "c: \{c}"
    for s: (Skips n: 4) loop print "s: \{s}"
    for g: (Grid n: 3) loop print "g: \{g}"
    with h: (AddK n: 3) do {
        i: 0
        for i < 8 loop {
            r: h.call step: 100
            match r case some then print "a: \{r}" case none then print "a: (none)"
            i = i + 1
        }
    }
    print "done"
}
