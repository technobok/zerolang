# A map whose VALUE is a collection. The entry's value field is spelled from
# the value's type id; asking for it by the value's composed name found nothing
# and left the field with no type at all. Every member that touches the value
# is exercised: an overwrite that frees the displaced list, get, has, the item
# walk, remove, an id-keyed map written through getMut, and a map keyed by a
# value type.
main: function is {
    m: (MapRR K: String V: (List String))
    words: List String
    words.append "a".string
    words.append "b".string
    m.set key: "k".string value: words.take
    again: List String
    again.append "c".string
    m.set key: "k".string value: again.take
    k: "k".string
    {
        g: m.get key: k
        match (g) case some then print "get \{g.length}" case none then print "none"
    }
    print "has \{m.has key: k}, \{m.length} entry"
    with mt: m.iterateItems do for e: mt loop print "item \{e.key} holds \{e.value.length}"
    r: m.remove key: k
    match (r) case some then print "removed \{r.length}" case none then print "none"

    ids: (IdMapR u64 V: (ListVal i64))
    xs: ListVal i64
    xs.append from: 4
    ids.set key: 1 value: xs.take
    {
        w: ids.getMut key: 1
        match (w) case some then w.append from: 5 case none then null
    }
    v: ids.get key: 1
    match (v) case some then print "id-keyed \{v.length}" case none then print "none"

    byNum: (MapVR k: i64 V: (ListVal i64))
    ys: ListVal i64
    ys.append from: 9
    byNum.set key: 3 value: ys.take
    with nt: byNum.iterateItems do for e: nt loop print "value-keyed \{e.key} holds \{e.value.length}"
}
