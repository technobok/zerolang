# generic_copy.z -- `.copy` on a generic-param value inside a template: the
# fn-mono re-walk resolves the bare param through the mono's concrete param
# child. String deep-copies, a valtype copies bitwise, and a container that
# declares a copy calls its own.
#
# EVERY ARM IS A TYPE WHOSE CONCRETE SPELLING ACCEPTS `.copy`, because a mono
# presents exactly the concrete type's interface. A StringView arm lived here
# until the per-mono waiver was removed: `sv.copy` is refused when written
# directly, so reaching a view through a template is refused too, and
# tests/fixtures/errors/copy_generic_stringview.z holds that half now.
point: record {
    x: i64
}

dup: function as { t: anyval.generic } in {v: t} out t is {
    return v.copy
}

dupRef: function as { T: AnyRef.generic } in {v: T} out T is {
    return v.copy
}

main: function is {
    n: dup v: 7
    print "int: \{n}"
    s0: "own".string
    s1: dupRef v: s0
    print "string: \{s1}"
    xs: ListVal i64
    xs.append from: 5
    ys: dupRef v: xs
    print "listval: \{ys.length}"
    p: point x: 3
    q: dup v: p
    print "record: \{q.x}"
}
