# A data block's elements read through its unit by label -- the same reads as
# from inside the declaring unit.
main: function is {
    b: 9.u8
    if b == data_consts.codes.ht then print "ht"
    x: data_consts.codes.lf
    print "\{x}"
    sp: data_consts.codes.space
    if sp == 32 then print "space"
}
