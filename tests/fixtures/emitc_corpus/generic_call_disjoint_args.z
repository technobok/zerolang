# The arguments of a GENERIC call that are not one value passed twice: two
# fields of one value are two values (`x: o.s y: o.t`), two views of one field
# coexist, a view of a field sits beside a copy of its sibling, and a fresh copy
# (`s.copy`) holds nothing of its source, which may be moved or written in the
# same call. A field itself never moves into a taking parameter
# (field_move_refused), so its owner still holds it after the call.
Outer: class {
    s: String
    t: String
}

Item: class {
    v: i64
}

Pair: class {
    a: Item
    b: Item
}

keepView: function as { T: StringLike.generic } in {a: T.view b: String.take} is {
    print "\{a} \{b}"
}

keep: function as { T: StringLike.generic } in {b: T.take} is {
    print b
}

views: function as { T: StringLike.generic } in {a: T.view b: T.view} is {
    print "\{a}=\{b}"
}

siblings: function as { T: AnyRef.generic } in {x: T y: T} is {
    print "siblings"
}

keepFirst: function as { T: StringLike.generic } in {b: String.take t: T.view} is {
    print "\{b}\{t}"
}

copyThenTake: function as { T: StringLike.generic } in {a: T b: String.take} is {
    print "\{a} \{b}"
}

copyThenWrite: function as { T: StringLike.generic } in {a: T o: Outer} is {
    o.s = "changed".string
    print "\{a} \{o.s}"
}

main: function is {
    o: Outer s: "left".string t: "right".string
    keepView a: o.s b: o.t.copy
    print "after a view and a copy: [\{o.t}]"
    p: Outer s: "one".string t: "two".string
    keep b: p.t.copy
    print "after a copy: [\{p.t}]"
    views a: p.s b: p.s
    q: Pair a: (Item v: 1) b: (Item v: 2)
    siblings x: q.a y: q.b
    b: "named".string
    keepFirst :b t: "!"
    c: "fresh".string
    copyThenTake a: c.copy b: c.take
    w: Outer s: "orig".string t: "t".string
    copyThenWrite a: w.s.copy o: w
    print "done"
}
