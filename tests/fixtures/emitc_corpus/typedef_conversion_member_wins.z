# A typedef's own conversion member wins over its base's, in a constant's
# read as in a local's: the member runs. A typedef that declares no
# conversion converts as its base does, and a constant's conversion folds
# where the base's is lossless.

# meters -- a length in whole meters, reported to a wider counter as a fixed
# figure
meters: typedef u8 as {
    # u32 -- the figure the counter takes
    u32: function {m: this.view} out system.u32 is {
        return 42
    }
}

# plain -- a byte with no members of its own
plain: typedef u8

M: meters 5
P: plain 7
Wide: P.u32
Same: P.u8

main: function is {
    m: meters 5
    a: m.u32
    b: M.u32
    print "\{a} \{b} \{M.u32 + 1}"
    p: plain 7
    print "\{Wide} \{Same} \{P.u64} \{p.u32}"
}
