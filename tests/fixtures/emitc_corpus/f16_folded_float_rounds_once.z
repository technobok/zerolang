# An untyped float lands in an f16 rounded once, from its exact value, at
# every site -- an argument, a field, a return, an assignment -- whether it is
# written as a literal, read from a name or folded from an expression.
# 1.0004882812500001 is just above the midpoint of 1 and the next f16,
# 1 + 2^-10, so it lands as 1.00098; rounded first to an f64 it would be that
# midpoint, and then the even f16 below, 1. 2049 + 1e-13 lands as 2050, not
# as the even 2048, for the same reason.
H: 1.0004882812500001

takeH: function {v: f16} out f64 is {
    return v.f64
}

retH: function out f16 is {
    return (H + 0)
}

ph: record { x: f16 }

main: function is {
    print "arg \{takeH v: 1.0004882812500001} \{takeH v: H} \{takeH v: (H + 0)}"
    print "arg \{takeH v: (2049.0 + 0.0000000000001)}"
    print "return \{retH.f64}"
    p: ph x: (H - 0)
    print "field \{p.x.f64}"
    y: 0.0.f16
    y = (H * 1)
    print "assign \{y.f64}"
}
