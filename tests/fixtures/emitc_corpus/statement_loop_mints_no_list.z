# statement_loop_mints_no_list -- a loop in statement position discards its body's value
# and builds no list of it: the last line may be a value no list can hold, such as a
# function's reference
twice: function {n: i64} out i64 is {
    return n * 2
}

main: function is {
    n: 0
    for n < 3 loop {
        n = n + 1
        twice.copy
    }
    print "n \{n}"
}
