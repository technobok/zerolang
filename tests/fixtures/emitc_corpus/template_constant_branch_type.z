# A TEMPLATE'S CONSTANT WHOSE `if` READS ITS NUMERIC PARAMETER IS EACH
# INSTANCE'S, type and all. The parameter read in an `if`'s condition, or only
# in a branch's value, went unseen: the template took the constant for its own
# and typed it by its first branch, so `(Box cap: 3).K` held the `u8` of one
# branch typed as the `u64` of the other -- `+ 255` did not wrap -- and a text
# branch reached the C as a number, which the C compiler refused.
Box: class {
    used: u32
    peek: function {:this} out u64 is {
        return Box.W + 1
    }
    near: function {:this} out u64 is {
        k: Box.K
        s: k + 255
        return s.u64
    }
} as {
    cap: u32.generic
    K: if cap > 4 then { 300.u64 } else { 3.u8 }
    T: if cap > 4 then { "big" } else { "small" }
    W: if true then { cap.u64 } else { 0.u64 }
}

Pair: record {
    x: i64
} as {
    n: u8.generic
    K: if n > 4 then { 300.u64 } else { 3.u8 }
}

main: function is {
    small: (Box cap: 3).K
    big: (Box cap: 8).K
    s2: small + 255
    b2: big + 255
    print "\{s2} \{b2}"
    print "\{(Box cap: 3).T} \{(Box cap: 8).T}"
    b: (Box cap: 8) used: 0
    c: (Box cap: 3) used: 0
    print "\{b.peek} \{c.peek} \{b.used + c.used} \{b.near} \{c.near}"
    p: (Pair n: 2) x: 1
    q: (Pair n: 9) x: 1
    pk: (Pair n: 2).K + 255
    print "\{pk} \{(Pair n: 9).K} \{p.x + q.x}"
}
