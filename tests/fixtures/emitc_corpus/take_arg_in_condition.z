# A `.take` argument inside a CONDITION moves its source, so the source must be
# zeroed after the call ran -- and only then: a `when` conjunct or an `else if`
# condition that never ran leaves its source owned, and the scope-exit destructor
# frees it exactly once. Every shape prints so the golden observes the value.
eat: function {xs: (ListVal u32).take} out bool is {
    return xs.length > 0
}
eats: function {s: String.take} out bool is {
    return s.length > 0
}
# runtime bools, so no clause folds away
nope: function out bool is {
    return false
}
yep: function out bool is {
    return true
}
main: function is {
    a: (ListVal u32)
    a.append 1
    if (eat xs: a) then print "a yes" else print "a no"
    c: (ListVal u32)
    c.append 1
    if nope when (eat xs: c) then print "c never" else print "c untouched"
    d: (ListVal u32)
    d.append 1
    if yep when (eat xs: d) then print "d yes" else print "d no"
    e: (ListVal u32)
    e.append 1
    v: if (eat xs: e) then 1 else 2
    print "e \{v}"
    f: (ListVal u32)
    f.append 1
    if nope then print "f no" else if (eat xs: f) then print "f yes" else print "f none"
    m: (ListVal u32)
    m.append 1
    if yep then print "m first" else if (eat xs: m) then print "m never"
    g: (ListVal u32)
    g.append 1
    if (eat xs: g.take) then print "g yes"
    s: "hello".string
    if (eats s: s) then print "s yes"
    h: (ListVal u32)
    h.append 1
    if (eat xs: h).not then print "h not" else print "h yes"
    k: (ListVal u32)
    ok: (eat xs: k).not
    if ok then print "k not" else print "k yes"
}
