# generic_record_method.z -- as-block METHODS on a user generic RECORD, at two
# instantiations. A generic class's methods are marked clonable blanket, whatever
# their signature; the record path marked none of them, so the mono's member was
# the TEMPLATE's function type and no method on a user generic record worked at
# all. The three signatures fail three different ways when it does not:
# a concrete return emits a body against a struct no instance has, a parameter
# typed as the generic parameter has no callee, and one typed as the TEMPLATE
# reports the template against its own instance.
Box: record {
    val: t
} as {
    t: anyval.generic
    doubled: function {b: this} out t is { return b.val + b.val }
    combined: function {b: this other: t} out t is { return b.val + other }
    same: function {b: this rhs: Box} out bool is { return b.val == rhs.val }
}

main: function is {
    a: Box val: 21
    b: Box val: 5
    print "i64 doubled \{a.doubled}"
    print "i64 combined \{a.combined other: 9}"
    print "i64 same \{a.same rhs: b}"
    print "i64 same self \{a.same rhs: a}"

    c: Box val: 3.i32
    d: Box val: 3.i32
    print "i32 doubled \{c.doubled}"
    print "i32 combined \{c.combined other: 8.i32}"
    print "i32 same \{c.same rhs: d}"
}
