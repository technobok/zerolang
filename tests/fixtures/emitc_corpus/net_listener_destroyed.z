# A Listener closes its socket when it goes out of scope, as File and Conn do:
# its destructor runs though its fields (an fd and a flag) own nothing a
# declaration can show. The second listen on the same port succeeds only
# because the first listener, never closed by hand, was destroyed with its
# block. The first takes a free port; the second asks for that same one.
main: function is {
    held: 0.u16
    {
        first: net.listen port: 0
        match (
            first
        ) case ok then {
            held = first.port
            print "first listening"
        } case err then print "first failed"
    }
    second: net.listen port: held
    match (
        second
    ) case ok then print "second listening" case err then print "second failed: the first still holds the port"
}
