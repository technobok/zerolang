# A guard on a name a guard already narrowed reads the ARM off the payload:
# after `if a.none then return` -- or inside `if a.some then` -- `a` is the
# option's payload, and a second guard (`if a.w then return`) leaves `a` the
# remaining arm's payload, read off that payload rather than off the option.
shape: variant {
    n: i64
    w: u64
}

pick: function {k: i64} out optionval shape is {
    if k < 0 then return (optionval.none shape)
    if k == 0 then return (optionval.some (shape.w 7))
    return (optionval.some (shape.n k))
}

afterGuard: function {k: i64} out i64 is {
    a: pick :k
    if a.none then return 0 - 1
    if a.w then return 0 - 2
    return a + 100
}

insideIf: function {k: i64} out i64 is {
    a: pick :k
    if a.some then {
        if a.w then return 0 - 2
        return a + 300
    }
    return 0 - 1
}

main: function is {
    print "\{afterGuard k: 0 - 1} \{afterGuard k: 0} \{afterGuard k: 5}"
    print "\{insideIf k: 0 - 1} \{insideIf k: 0} \{insideIf k: 5}"
}
