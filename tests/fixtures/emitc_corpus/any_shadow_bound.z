# A unit may define its own `Any`; the name then resolves like any other
# user type, including as a (vacuous) generic bound.
Any: record {
    n: u64
}
pick: function as { t: Any.generic } in { val: t } out t is {
    return val
}
main: function is {
    a: Any n: 7
    g: pick val: a
    print "\{g.n}"
}
