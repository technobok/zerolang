# identity_conversion.z -- `x.T` where x is ALREADY T is a redundant but
# valid cast. The member check admitted it, but nothing gave it a result
# type: binding one produced no symbol-table entry at all, and the emitter
# fell to its unhandled-binding leg. It hit a plain numeric and a typedef
# whose base is that numeric alike -- and `.u64` is the documented way to
# unwrap a scalar typedef, so the spelling the spec recommends did not
# survive being bound to a local. The identity is now declared on every
# numeric type, yielding the base.
m: record { val: u64.typedef } as {
    ==: function {:this rhs: m} out bool is { return this.u64 == rhs.u64 }
}

main: function is {
    x: 5.u64
    t: x.u64
    print "t=\{t}"
    a: m.create from: 3
    s: a.u64
    print "s=\{s}"
    n: s + 1
    print "n=\{n}"
    w: 7.u32
    v: w.u32
    print "v=\{v}"
}
