# protocol_marker.z -- a protocol with no specs is a marker: a type conforms,
# by a named label or a bare one, to say something about itself, and is used as
# any other value of its type -- a value of the marker itself included.

# Pinned -- a marker: a type that conforms says it stays where it is made
Pinned: protocol {}

# G -- a type that says so
G: class { n: i64 } as {
    pinned: Pinned
}

# H -- says so by label
H: class { s: String } as {
    :Pinned
}

# keep -- takes a value of the marker, which has nothing to call
keep: function {p: Pinned} is {
    print "kept"
}

# show -- reads a G
show: function {g: G} is {
    print "g \{g.n}"
}

main: function is {
    g: G n: 1
    show :g
    keep p: g.pinned
    h: H s: "x".string
    hs: List H
    hs.append h.take
    print "\{hs.length}"
}
