# local_named_like_constant_no_fold -- a local named like a unit constant is the local:
# a match on it does not fold to the arm the constant holds
mode: variant {
    fast: null
    slow: null
    eco: null
}

M: mode.slow

describe: function {M: mode} out i64 is {
    match M case fast then return 1 case slow then return 2 case eco then return 3
}

main: function is {
    a: describe M: mode.fast
    b: describe M: mode.eco
    print "param \{a} \{b}"
    M: mode.eco
    match M case fast then print "local fast" case slow then print "local slow" case eco then print "local eco"
}
