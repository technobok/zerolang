# if_later_clause_rules_out_arm -- A later clause of an `if` runs only where the clauses
# before it failed: the arm an earlier clause tested is ruled out in it, so a `match`
# there needs only the arms left.
U: union {
    some: String
    none: null
    count: i64
}

f: function {o: U.take c: bool} is {
    if o.none then {
        print "none"
    } when c then {
        match (
            o
        ) case some then print "some \{o}" case count then print "count \{o}"
    } else {
        print "not asked"
    }
}

main: function is {
    f o: (U.some "abc".string) c: true
    f o: U.none c: true
    f o: (U.count 4) c: true
    f o: (U.count 5) c: false
}
