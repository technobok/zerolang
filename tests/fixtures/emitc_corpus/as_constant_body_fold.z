# A TYPE'S `as` CONSTANT READ IN ONE OF ITS METHODS FOLDS AS THE BODY READS IT.
# A method body reads its type's bare `C` as `type.C`, and the compiler must
# compute the value wherever one is needed: an operation on two literals
# (`C * 2` with `C: 5`) and a type's numeric argument (`to: C`, `to: C * 2`).
# The constant evaluator looked for `C` in the enclosing units only, and knew no
# `type`: the operation was refused ("'*' has no compile-time value"), the
# argument named an unknown `C`, and in a generic type an argument over a
# constant of its numeric parameter did not compile.
Plain: class {
    used: u32
} as {
    C: 5
    info: function {:this} out String is {
        k: C * 2
        a: array t: i64 to: C
        b: array t: i64 to: C * 2
        return "\{k} \{a.length} \{b.length}"
    }
}

Box: class {
    used: u32
} as {
    cap: u32.generic
    C: cap * 1
    info: function {:this} out String is {
        a: array t: i64 to: C
        b: array t: i64 to: C * 2
        return "\{a.length} \{b.length}"
    }
}

main: function is {
    p: Plain used: 1
    b: (Box cap: 3) used: 1
    c: (Box cap: 4) used: 1
    print "plain \{p.info}"
    print "box \{b.info} | \{c.info}"
}
