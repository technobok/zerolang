# A UNIT'S MEMBER IS NO FIELD. The checker asked "is this member read a field"
# by what the member is not -- a function, an `as` constant, a conformance
# label -- so a unit's data block or type read through the unit counted as a
# field of it. `return w.primes` was refused as a field moved out of its owner,
# and `with g: kit.Words do`, a construction through the unit, was taken for a
# value lent by that owner: the binding never destroyed it, and the
# generator's state leaked.
w: unit {
    primes: data { 2 3 5 7 }
}

kit: unit {
    Words: generator as {
        call: function out String is {
            s: "abc".string
            yield s.copy
            s.append "d"
            yield s.copy
        }
    }
}

primesOf: function out intdata i64 is {
    return w.primes
}

main: function is {
    for each p: primesOf.iterate loop print "returned \{p}"
    with g: kit.Words do {
        x: g.call
        match (x) case some then print x case none then print "none"
    }
}
