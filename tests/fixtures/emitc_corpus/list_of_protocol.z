# A container of PROTOCOL values: a user protocol and Text, in a List (append,
# iterate, get, set, pop), in a class field, and as a Map value. The protocol's
# struct, vtable and destroy come before the monos that store it by value --
# they used to follow them, and even an empty `List Shape` failed in C. Every
# element is destroyed through its box, so nothing leaks.
Shape: protocol {
    area: function {t: this.view} out u64
}
Sq: class { side: u64 name: String } as {
    :Shape
    area: function {t: this.view} out u64 is { return t.side * t.side }
}
Label: class { data_: String } as {
    :Text
    stringView: function {m: this.view} outx StringView is {
        return m.data_.stringView
    }
}
Gallery: class { shapes: List Shape }

total: function {xs: (List Shape).view} out u64 is {
    n: 0.u64
    for x: xs.iterate loop n = n + x.area
    return n
}

main: function is {
    xs: List Shape
    xs.append (Shape.create from: (Sq side: 2 name: "a".string))
    q: Sq side: 3 name: "b".string
    xs.append (Shape.create from: q.take)
    print "\{total :xs} \{xs.length}"
    {
        g: xs.get i: 1
        print "\{g.area}"
    }
    old: xs.set i: 0 val: (Shape.create from: (Sq side: 5 name: "c".string))
    print "\{old.area}"
    p: xs.pop
    print "\{p.area}"
    gal: Gallery shapes: List Shape
    gal.shapes.append (Shape.create from: (Sq side: 4 name: "d".string))
    print "\{gal.shapes.length}"
    ts: List Text
    ts.append (Text.create from: (Label data_: "hi".string))
    ts.append (Text.create from: "str".string)
    for t: ts.iterate loop print "\{t.stringView}"
    m: MapRR String V: Shape
    m.set key: "k".string value: (Shape.create from: (Sq side: 6 name: "e".string))
    print "\{m.length}"
}
