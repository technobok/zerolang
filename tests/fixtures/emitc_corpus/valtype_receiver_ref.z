# A valtype method takes its receiver BY REFERENCE, as docs/ownership.pdoc has
# always said: "the exception is `this` in methods which is passed by reference
# so that methods can act on the fields directly". A record method therefore
# mutates the caller's instance rather than a copy that is thrown away.
#
# A parameter that merely has the enclosing type is NOT the receiver and is
# still a copy -- `shift` takes a second point and leaves the caller's alone.
Pt: record {
    x: i64
    y: i64
} as {
    bump: function {:this} is {
        this.x = this.x + 1
    }
    shift: function {p: this other: Pt} out i64 is {
        p.x = p.x + other.x
        other.x = 999
        return p.x
    }
}
main: function is {
    a: Pt x: 1 y: 2
    a.bump
    a.bump
    print "bumped: \{a.x}"

    b: Pt x: 10 y: 0
    r: Pt.shift p: a other: b
    print "shifted: \{r} a.x=\{a.x} b.x=\{b.x}"
}
