# match_narrows_afresh -- A match on a bare name narrows it afresh from its declared
# sum: inside the match, what an earlier guard ruled out is no longer known, so the
# `else` reads a subject that can hold every arm no case covered.
Shape: union {
    text: String
    num: i64
    none: null
}

shape: function {k: i64} out Shape is {
    if k == 0 then return (Shape.text "hello".string)
    if k == 1 then return (Shape.num 4)
    return Shape.none
}

f: function {k: i64} out i64 is {
    u: shape :k
    if u.none then return 0
    match u case text then return 1 else {
        match u case num then return u + 1 case none then return 3
    }
}

main: function is {
    print "\{f k: 0} \{f k: 1} \{f k: 2}"
}
