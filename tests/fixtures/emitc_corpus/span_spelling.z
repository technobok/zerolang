# span_spelling.z -- a writable window is a `span`: `span` over the whole of a
# ListVal or an array, `spanSlice` over part of one. Every write through it
# lands in the storage it was lent by.

# double every element the window spans
double: function {w: (SpanVal u64).borrow} is {
    i: 0.u64
    for i < w.length loop {
        w.set :i item: (w.get :i) * 2
        i = i + 1
    }
}

main: function is {
    xs: ListVal u64
    for each n: 4.u64.times loop xs.append from: n + 1
    {
        w: xs.span
        double :w
    }
    {
        w: xs.spanSlice from: 1 to: 3
        w.fill item: 0
    }
    print "\{xs.get i: 0} \{xs.get i: 1} \{xs.get i: 2} \{xs.get i: 3}"
    a: (array t: u64 to: 3).create
    {
        w: a.span
        w.set i: 0 item: 7
        w.set i: 2 item: 9
    }
    {
        w: a.spanSlice from: 1 to: 2
        w.set i: 0 item: 8
    }
    print "\{a.get i: 0} \{a.get i: 1} \{a.get i: 2}"
}
