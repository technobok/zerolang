# The protocol half of protocol_receiver_alias_xunit.z. It lives in a
# NON-MAIN unit on purpose: a protocol spec's receiver is dropped
# (`resolveFunction`'s skipThisType branch) only when the protocol is not
# reached through `protocolThisContext`, which is populated for the MAIN unit
# alone. The two same-unit fixtures therefore keep their receiver as a real
# parameter and exercise the other branch; this one is the only coverage of
# the drop.
#
# Every method takes an argument: a zero-arg auto-call through a protocol
# field is not dispatched at all, which is a separate gap.
Reader: protocol {
    peek: function {t: this.view scale: i64} out i64
    tally: function {t: this.view extra: i64} out i64
    bump: function {:this by: i64}
}

Counter: class {
    n: i64
} as {
    :Reader
    peek: function {t: this.view scale: i64} out i64 is {
        return t.n * scale
    }

    tally: function {t: this.view extra: i64} out i64 is {
        return t.n + extra
    }

    bump: function {:this by: i64} is {
        this.n = this.n + by
    }
}

Box: class {
    r: Reader
}

mkBox: function {start: i64} out Box is {
    im: Counter n: start
    prov: Reader.create from: im.take
    return (Box r: prov)
}
