# The flip's runnable half: a scoped `getMut` writes through to the element,
# and a later `get` reads the new value back. A rule that only ever refuses
# is indistinguishable from one that refuses everything.
Row: class {
    n: i64
}
main: function is {
    rows: (List Row)
    rows.append (Row n: 10)
    rows.append (Row n: 11)
    {
        a: rows.getMut i: 0
        a.n = 20
    }
    b: rows.get i: 0
    c: rows.get i: 1
    print "b=\{b.n} c=\{c.n}"
}
