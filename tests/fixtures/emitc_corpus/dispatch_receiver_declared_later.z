# A spec method's receiver need not be its first parameter. Dispatched through
# the protocol, the implementation is called with the receiver where it
# declares it -- named or the `:this` shorthand -- not first.
Shape: protocol {
    area: function {scale: i64 t: this} out i64
    grow: function {by: i64 :this} out i64
}

Sq: class {
    s: i64
} as {
    shape: Shape.implement
    area: function {scale: i64 t: this} out i64 is {
        return (t.s * t.s) * scale
    }
    grow: function {by: i64 :this} out i64 is {
        return this.s + by
    }
}

total: function {sh: Shape scale: i64} out i64 is {
    return (sh.area :scale) + (sh.grow by: 100)
}

main: function is {
    q: Sq s: 3
    sh: Shape.create from: q.take
    print "\{total :sh scale: 2}"
}
