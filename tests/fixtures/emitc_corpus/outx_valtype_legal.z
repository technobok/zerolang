# outx_valtype_legal.z -- the shapes an `outx` result over valtypes passed by
# pointer keeps legal: two `.view` arguments pinned at once, a by-copy argument
# (no lock: the result cannot point into a copy), and a view used and dropped
# before its source changes.
pickView: function {a: (str to: 8).view b: (str to: 8).view first: bool} outx StringView is {
    if first then return a.stringView
    return b.stringView
}

headOf: function {s: (str to: 8).view n: i64} outx StringView is {
    n
    return s.stringView
}

main: function is {
    a: "left".str to: 8
    b: "right".str to: 8
    {
        v: pickView :a :b first: false
        print "\{v}"
    }
    a = "LEFT".str to: 8
    b = "RIGHT".str to: 8
    k: 3
    w: headOf s: a n: k
    k = 4
    print "\{w} \{k}"
    {
        u: headOf s: b n: k
        print "\{u}"
    }
    b = "done".str to: 8
    print "\{b}"
}
