# static_value_bare.z -- at unit level the head's kind decides what `x: Head
# args` is: a data type's or a choice arm's value, with or without parentheses.
# Parentheses are needed only round a labelled argument, since a label starts
# the next definition. A bare data type names the type, and a value of it with
# every field at its default is `row.create`.
row: data {
    n: 0
    m: 1
}
form: choice {
    none: null
    count: u8
    name: text
}
a: row 5
b: form.count 3
c: (row n: 7 m: 2)
d: row
e: row.create
f: form.name "f"
g: d 9
k: match (b) case count then b else 0
main: function is {
    print "\{a.n} \{a.m} \{c.n} \{c.m} \{e.n} \{g.n} \{k}"
    print "\{b.count} \{f.name} \{f.none}"
}
