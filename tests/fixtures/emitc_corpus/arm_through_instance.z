# An arm is built through its sum TYPE, and a type application written in
# place -- `(Option T: String)` -- names the type just as an alias of it does.
# Whether the base of `.arm` is a type or a value is one question with one
# answer (a call is a value unless it is a type application), and the arm
# check asked a second one of its own that called every call a value: the arm
# became a bool predicate called with a payload. Every family builds here --
# Option, optionval, Result, resultval, a user generic variant and union -- and
# the call's stamped type, not the spelling of its base, says what is built.
slot: variant {
    full: t
    empty: null
} as { t: anyval.generic }

SI: (slot t: i64)

Holder: union {
    one: T
    none: null
} as { T: AnyRef.generic }

Pair: class {
    a: i64
}

Err: class {
    why: String
}

main: function is {
    x: 5
    o: (Option T: String).some "v\{x}"
    match (o) case some then print "Option some \{o}" case none then print "none"
    n: (Option T: String).none
    print "Option none \{n.none}"

    ov: (optionval t: i64).some 3
    match (ov) case some then print "optionval some \{ov}" case none then print "none"

    r: (Result T: String E: Err).ok "fine".string
    match (r) case ok then print "Result ok \{r}" case err then print "err \{r.why}"
    e: (Result T: String E: Err).err (Err why: "bad".string)
    match (e) case ok then print "ok \{e}" case err then print "Result err \{e.why}"

    rv: (resultval t: i64 e: u8).ok 5
    match (rv) case ok then print "resultval ok \{rv}" case err then print "err \{rv}"

    s: (slot t: i64).full 4
    match (s) case full then print "variant full \{s}" case empty then print "empty"
    a: SI.full 6
    b: (SI).full 7
    match (a) case full then print "through an alias \{a}" case empty then print "empty"
    match (b) case full then print "through a parenthesised alias \{b}" case empty then print "empty"

    h: (Holder T: Pair).one (Pair a: 8)
    match (h) case one then print "union one \{h.a}" case none then print "none"
    hn: (Holder T: Pair).none
    print "union none \{hn.none}"
}
