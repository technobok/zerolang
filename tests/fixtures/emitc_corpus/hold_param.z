# `hold` is the owned, readonly cell of the ownership grid: the argument moves
# in (the caller gives it up) and is frozen for the body, so reader methods and
# reads of its fields work while every mutation is rejected. The callee owns it,
# so it is destroyed at scope exit.
Item: class {
    name: String
    value: i64
} as {
    label: function {t: this.view} out String is {
        return t.name.copy
    }
}
describe: function {it: Item.hold} out String is {
    l: it.label
    r: "\{l}=\{it.value}"
    return r
}
total: function {s: String.hold} out u64 is {
    return s.length
}
main: function is {
    e: Item name: "width".string value: 12
    print "\{describe it: e.take}"
    x: "abcdef".string
    print "len=\{total s: x.take}"
}
