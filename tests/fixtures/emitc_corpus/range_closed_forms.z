# range_closed_forms.z -- `upto` and `downto` are FULLY CLOSED: `to` is walked,
# not stopped at. `times` is half-open because it is a COUNT; the name says which
# convention applies.
#
# A closed range cannot be driven by an endpoint comparison, which is why the
# cursor counts instead. Two cases below have no value past their last one for a
# comparison to reach: `n.downto to: 0` on an unsigned type would compare
# `i >= 0`, true forever, and step by wrapping at zero; and a range ending at the
# type's MAXIMUM would compare `i <= 255` on a u8, true forever, and wrap at 255.
# Counting reaches neither. The count is of the values after the current one, so
# it fits a u64 even when a range covers all 2^64 values of a 64-bit type: those
# walks run, and each one here stops itself after three values.
main: function is {
    for each a: (2.upto to: 5) loop print "up \{a}"

    n: 3.u8
    for each b: (n.downto to: 0.u8) loop print "down \{b}"

    # a signed range spanning zero: the count is a two's-complement subtraction
    # (`.bits`), which is why it does not overflow the way `to - from` would
    for each c: ((0 - 3).i64.upto to: 2.i64) loop print "signed \{c}"

    # an inverted range walks nothing -- the one guard, outside the loop
    for each d: (5.upto to: 2) loop print "never \{d}"
    for each e: (2.downto to: 5) loop print "never \{e}"

    # a range of one
    for each f: (7.upto to: 7) loop print "one \{f}"

    # the type's MAXIMUM as the last value
    m: 255.u8
    for each g: ((m - 2).upto to: m) loop print "max \{g}"

    # the value form: a closed range is an ordinary iterator like any other
    r: 1.upto to: 3
    for h: r loop print "bound \{h}"

    # the FULL span of a 64-bit type, in each direction and in both forms
    top: 18446744073709551615.u64
    k: 0
    for each i: (0.u64.upto to: top) loop {
        print "full up \{i}"
        k = k + 1
        if k == 3 then break
    }
    k = 0
    for each i: (top.downto to: 0.u64) loop {
        print "full down \{i}"
        k = k + 1
        if k == 3 then break
    }
    low: (0 - 9223372036854775808).i64
    k = 0
    for each i: (low.upto to: 9223372036854775807.i64) loop {
        print "full signed \{i}"
        k = k + 1
        if k == 3 then break
    }
    whole: 0.u64.upto to: top
    k = 0
    for w: whole loop {
        print "full bound \{w}"
        k = k + 1
        if k == 3 then break
    }
    print "done"
}
