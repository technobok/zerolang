# range_closed_forms.z -- `upto` and `downto` are FULLY CLOSED: `to` is walked,
# not stopped at. `each` is half-open because it is a COUNT; the name says which
# convention applies.
#
# A closed range cannot be driven by an endpoint comparison, which is why the
# cursor counts instead. Two cases below have no value past their last one for a
# comparison to reach: `n.downto to: 0` on an unsigned type would compare
# `i >= 0`, true forever, and step by wrapping at zero; and a range ending at the
# type's MAXIMUM would compare `i <= 255` on a u8, true forever, and wrap at 255.
# Counting reaches neither.
main: function is {
    for a: (2.upto to: 5) loop print "up \{a}"

    n: 3.u8
    for b: (n.downto to: 0.u8) loop print "down \{b}"

    # a signed range spanning zero: the count is a two's-complement subtraction
    # (`.bits`), which is why it does not overflow the way `to - from` would
    for c: ((0 - 3).i64.upto to: 2.i64) loop print "signed \{c}"

    # an inverted range walks nothing -- the one guard, outside the loop
    for d: (5.upto to: 2) loop print "never \{d}"
    for e: (2.downto to: 5) loop print "never \{e}"

    # a range of one
    for f: (7.upto to: 7) loop print "one \{f}"

    # the type's MAXIMUM as the last value
    m: 255.u8
    for g: ((m - 2).upto to: m) loop print "max \{g}"

    # the value form: a closed range is an ordinary iterator like any other
    r: 1.upto to: 3
    for h: r loop print "bound \{h}"
    print "done"
}
