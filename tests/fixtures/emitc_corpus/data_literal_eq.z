# data_literal_eq.z -- a data field typed by an untyped number compares as that
# number does. A comparison that folds compares the numbers exactly, as they
# were written; at run time the field holds the i64 or f64 it is emitted as, and
# compares as that. So 0.1 and 0.10000000000000000001 differ when folded and are
# one f64 at run time. An intliteral field hashes as its i64, so a data type
# holding one is a map key; a floatliteral field has `==` and no hash, as an f64
# field has.
row: data { n: intliteral f: floatliteral }
r: (row n: 7 f: 0.1)
s: (row n: 7 f: 0.10000000000000000001)
t: (row n: 8 f: 0.1)
wa: (row n: 100000000000000000000 f: 0.5)
wb: (row n: 100000000000000000001 f: 0.5)

foldedEq: r == s
foldedNe: r != t
foldedWide: wa == wb
foldedField: r.f == s.f

key: data { id: intliteral mark: 3.u8 }
k1: (key id: 5)
k2: (key id: 5)
k3: (key id: 6)

same: function {a: row b: row} out bool is {
    return a == b
}

main: function is {
    print "\{foldedEq} \{foldedNe} \{foldedWide} \{foldedField}"
    print "\{same a: r b: s} \{same a: r b: t}"
    print "\{r == s} \{k1 == k2}"
    m: MapVV key v: u8
    m.set key: k1 value: 1
    m.set key: k2 value: 2
    m.set key: k3 value: 3
    print "\{m.length} \{(m.get key: k1).or d: 0} \{(m.get key: k3).or d: 0}"
}
