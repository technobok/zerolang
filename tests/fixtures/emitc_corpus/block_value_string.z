# block_value_string.z -- a block whose value is a String or a StringView is
# bound as any block value is: the local declared, the block assigning its last
# value. The emitter once had no leg for it ("unhandled String binding"). An
# owned String built in the block moves out and is freed once; a view keeps
# what it views locked, whether the block slices it or yields a local view.
main: function is {
    n: {
        k: 2
        k + 3
    }
    s: {
        q: "lo".string
        q.append "cal"
        q
    }
    h: "abc def".string
    v: {
        h.stringView.substring from: 0 to: 3
    }
    w: {
        x: h.stringView
        x
    }
    print "\{n} \{s}"
    print v
    print w
    print h
}
