# option_view_construct.z -- a non-owned union arm (`some: T.borrow`) built by
# name pins its source, as a non-owned field does: the owner keeps it and may
# still read it, and the arm points at it. It used to MOVE the source into a
# heap cell the arm never freed: the owner lost it, and the cell leaked.

Inner: class { n: i64 }

Holder: class { inner: Inner }

Frozen: union {
    some: Inner.view
    none: null
}

peek: function {v: String} is {
    ov: OptionView.some from: v
    match ov case some then print "param: \{ov}" case none then null
}

main: function is {
    s: "kept".string
    ov: OptionView.some from: s
    match ov case some then print "local: \{ov}" case none then null
    print "owner: \{s}"
    peek v: s
    with w: s do {
        o2: OptionView.some from: w
        match o2 case some then print "with: \{o2}" case none then null
    }
    h: Holder inner: (Inner n: 4)
    f: Frozen.some h.inner
    match f case some then print "path: \{f.n}" case none then null
    print "holder: \{h.inner.n}"
}
