# A `for` body whose LAST statement is a bare `return` -- the shape of a scan
# that stops at its first hit -- was refused with `generic argument 'return'
# does not satisfy constraint 'AnyRef'`: the loop's last statement is what a
# comprehension yields, and a bare `return` atom has a type, the builtin's
# own, so a `List` of it was minted. A diverging body yields nothing. The
# same scan written with a value return, a `break` and a `continue` never
# tripped it, and all four are here.
Job: class {
    name: String
}

# the bare form: the first job named `want` is printed and the scan ends
sayFirst: function {jobs: (List Job).view want: StringView} is {
    jk: u64
    for jk < jobs.length loop {
        j: jobs.get i: jk
        if j.name.stringView != want then {
            jk = jk + 1
            continue
        }
        print "found \{j.name} at \{jk}"
        return
    }
    print "no \{want}"
}

# the valued form
indexOf: function {jobs: (List Job).view want: StringView} out u64 is {
    jk: u64
    for jk < jobs.length loop {
        j: jobs.get i: jk
        if j.name.stringView == want then return jk
        jk = jk + 1
    }
    return 999
}

# the loop that stops by `break`, and the one that counts by `continue`
countUntil: function {jobs: (List Job).view stop: StringView} out u64 is {
    n: u64
    jk: u64
    for jk < jobs.length loop {
        j: jobs.get i: jk
        jk = jk + 1
        if j.name.stringView == stop then break
        n = n + 1
    }
    return n
}

main: function is {
    js: List Job
    js.append (Job name: "a".string)
    js.append (Job name: "b".string)
    js.append (Job name: "c".string)
    sayFirst jobs: js want: "b"
    sayFirst jobs: js want: "z"
    print "\{indexOf jobs: js want: "c"} \{indexOf jobs: js want: "z"}"
    print "\{countUntil jobs: js stop: "c"}"
}
