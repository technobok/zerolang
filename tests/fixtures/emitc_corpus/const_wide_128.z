# untyped integer constants past u64 land in the 128-bit types exactly, and
# typed 128-bit shifts and `not` fold (gcc and clang: tcc has no __int128).
U128Max: 340282366920938463463374607431768211455
Sq: 18446744073709551615 * 18446744073709551615
I128Min: 0 - 170141183460469231731687303715884105728

# w -- the value a u128 parameter receives
w: function {v: u128} out u128 is { return v }

# s -- the value an i128 parameter receives
s: function {v: i128} out i128 is { return v }

# deflt -- a u128 default past u64
deflt: function {v: 340282366920938463463374607431768211455.u128} out u128 is { return v }

pair: record {
    a: u128
    b: i128
}

main: function is {
    print "\{w v: U128Max}"
    print "\{w v: Sq}"
    print "\{s v: I128Min}"
    print "\{s v: Sq / 18446744073709551615 - 18446744073709551615 - 1}"
    print "\{deflt}"
    p: pair a: U128Max / 2 b: I128Min + 1
    print "\{p.a} \{p.b}"
    print "\{1.u128 << 100}"
    print "\{(1.u128 << 127) >> 3}"
    print "\{0.u128.not}"
    print "\{(0 - 1).i128.not}"
    t: 18446744073709551616.u128 - 1
    print "\{t}"
}
