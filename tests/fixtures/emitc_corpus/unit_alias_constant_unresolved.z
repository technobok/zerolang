# A unit-level constant read through a unit alias (`dd.seven`) folds even when
# nothing else has resolved the alias yet: the unit is read off the alias's
# written value.
shapes: unit {
    seven: 7
}

reader: unit {
    dd: shapes
    viaAlias: dd.seven
}

main: function is {
    print "\{reader.viaAlias}"
}
