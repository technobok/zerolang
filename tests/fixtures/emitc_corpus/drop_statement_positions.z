# `.drop` ends a lifetime on a line whose value nothing uses: an ordinary
# statement, the last line of a function with no `out`, and a statement inside
# an arm. (Where a line's value IS used it is refused: errors/drop_as_value.)
Cell: class {
    s: String
}

tail: function {c: Cell} is {
    print "tail \{c.s}"
    c.drop
}

arm: function {yes: bool c: Cell} is {
    if yes then {
        c.drop
    } else print "kept \{c.s}"
}

main: function is {
    a: Cell s: "a".string
    a.drop
    b: Cell s: "b".string
    tail c: b
    arm yes: true c: b
    arm yes: false c: b
    print "done \{b.s}"
}
