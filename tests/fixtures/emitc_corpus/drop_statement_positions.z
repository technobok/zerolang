# drop_statement_positions.z -- `.drop` is legal on the node that IS the
# statement, at every depth a statement can sit: the function body, an `if`
# body, a match arm, a `for` body, a `with` body and a bare block. The nested
# bodies each save and restore the statement being checked, so a drop inside
# one must still be recognised as a statement after the walk comes back out.
# A statement line holds its value bare, and the rule keys on that node.
Crate: class {
    label: String
}

main: function is {
    top: Crate label: "top".string
    print top.label
    top.drop

    wanted: true
    if wanted then {
        inIf: Crate label: "if".string
        print inIf.label
        inIf.drop
    }

    o: optionval.some 1
    match (
        o
    ) case some then {
        inArm: Crate label: "arm".string
        print inArm.label
        inArm.drop
    } else null

    i: 0
    for i < 2 loop {
        inFor: Crate label: "for".string
        print inFor.label
        inFor.drop
        i = i + 1
    }

    xs: ListVal i64
    xs.append 5
    with it: xs.iterate do {
        inWith: Crate label: "with".string
        print inWith.label
        inWith.drop
    }

    {
        inBlock: Crate label: "block".string
        print inBlock.label
        inBlock.drop
    }

    after: Crate label: "after".string
    print after.label
    after.drop
}
