# owned_lock_holder_same_scope.z -- an owned value holding locks moves into an
# owner inside the source's scope: appended as a construction, stored into a
# field as a construction, and appended through a `with` alias when it holds
# no locks. Each read afterwards sees the source.

W: class {
    # the borrowed source
    s: String.borrow
}

Holder: class {
    # the stored value
    w: (Option W)
}

Box: class {
    # the value counted
    n: i64
}

main: function is {
    src: "hello".string
    lists: (List W)
    lists.append from: (W s: src)
    e: lists.get i: 0
    print "appended \{e.s}"
    src2: "world".string
    h: Holder w: (Option.none W)
    h.w = Option.some (W s: src2)
    with o: h.w do match (o) case some then print "stored \{o.s}" case none then null
    boxes: List Box
    with inner: boxes do inner.append from: (Box n: 4)
    print "boxes \{boxes.length}"
}
