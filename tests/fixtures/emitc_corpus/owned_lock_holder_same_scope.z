# owned_lock_holder_same_scope.z -- an owned value holding locks moves into an
# owner inside the source's scope: stored into a field as a construction. One
# that holds no locks is appended through a `with` alias. Each read afterwards
# sees the source. (Appending a lock-holding value to a container is refused:
# errors/lock_transfer_method_arg.)

W: class {
    # the borrowed source
    s: String.borrow
}

Holder: class {
    # the stored value
    w: (Option W)
}

Box: class {
    # the value counted
    n: i64
}

main: function is {
    src2: "world".string
    h: Holder w: (Option.none W)
    h.w = Option.some (W s: src2)
    with o: h.w do match (o) case some then print "stored \{o.s}" case none then null
    boxes: List Box
    with inner: boxes do inner.append from: (Box n: 4)
    print "boxes \{boxes.length}"
}
