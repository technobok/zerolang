# trie_node_name_collision.z -- an interior node of the specialisation trie is
# labelled after the template it hangs under, and `isTrieNode` on its row is
# what says it is one. So a two-parameter template mints a row carrying EXACTLY
# the template's own name, and the two must not be confused.
#
# The risk is specific. A pass sweeps every GENERIC_PARAM-typed row to collect
# the names that denote type PARAMETERS; a node wears that typetype too, so an
# unfiltered sweep interns the template's name as a parameter name -- and a node
# reaches that sweep in 559 of 602 corpus programs. The filter asks the flag,
# not the name shape.
#
# Two parameters matter: a single-key path has no interior node at all, so a
# one-parameter template would not exercise this.
pick2: unit as {
    k: anyval.generic
    v: anyval.generic
    first: function {a: k b: v} out k is { return a }
    second: function {a: k b: v} out v is { return b }
}

# an ordinary type beside it, to show the sweep still resolves normal names
holder: record {
    n: i64
}

both: (pick2 k: i64 v: i64)

main: function is {
    h: (holder n: 7)
    print "first=\{both.first a: 3 b: 9}"
    print "second=\{both.second a: 3 b: 9}"
    print "h=\{h.n}"
}
