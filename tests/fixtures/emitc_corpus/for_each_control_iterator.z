# for_each_control_iterator.z -- `for each` walks an iterator an `if` or a
# `match` hands back as it walks one written alone: the element is the loop's
# variable, declared under the name the body reads it by.
Pick: variant {
    left: null
    right: null
}

pickOne: function out Pick is {
    return Pick.left
}

flagOn: function out bool is {
    return true
}

main: function is {
    s: "a b".string
    k: flagOn
    for each p: (if k then (s.stringView.split sep: " ") else (s.stringView.split sep: ",")) loop print p
    xs: List String
    xs.append "x".string
    xs.append "y".string
    kv: pickOne
    for each e: (match (kv) case left then xs.iterate case right then xs.iterate) loop print e
}
