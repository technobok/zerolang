# A type a nested unit declares -- inline, one level deeper, a hidden subunit --
# given as a type argument was read as a VALUE: `ListVal rem.point` in a body
# was a bare construction missing its fields, `(ListVal t: rem.point)` and
# `(MapVV k: i64 v: rem.point)` could not infer their parameter, and a class
# field `(ListVal rem.point)` "does not name a type here". The resolvers that
# decide whether a dotted argument names a type knew file units only; the
# qualifier is followed through the units it declares, however deep.
rem: unit {
    point: record {
        x: i64
        y: i64
    }
    deeper: unit {
        tag: record {
            k: i64
        }
    }
}

Pair: record {
    a: t
    b: t
} as {
    t: anyval.generic
}

Holder: class {
    pts: (ListVal rem.point)
}

mk: function out (ListVal rem.point) is {
    xs: ListVal rem.point
    xs.append (rem.point x: 5 y: 6)
    return xs
}

main: function is {
    a: ListVal rem.point
    a.append (rem.point x: 1 y: 2)
    b: (ListVal t: rem.point)
    b.append (rem.point x: 3 y: 4)
    m: (MapVV k: i64 v: rem.point)
    m.set key: 7 value: (rem.point x: 8 y: 9)
    h: Holder pts: mk
    p: (Pair t: rem.point) a: (rem.point x: 1 y: 2) b: (rem.point x: 3 y: 4)
    d: ListVal rem.deeper.tag
    d.append (rem.deeper.tag k: 9)
    s: ListVal sub.slot
    s.append (sub.slot v: 11)
    print "\{a.length} \{b.length} \{m.length} \{h.pts.length} \{p.b.y} \{d.length} \{s.length}"
}
