# A TYPE AND ITS INSTANCES HAVE A NAMESPACE EACH. A shared method of the `as`
# section is called through an instance or, with its receiver as an argument,
# through the type; a shared function with no receiver is called through the
# type; a function field of the `is` section is called through an instance.
# An interface's members are its conformers' methods, reached through a value.
Speaker: protocol {
    speak: function out i64
}

Dog: class {
    volume: i64
    speak: function {:this} out i64 is {
        return this.volume
    }
    bark: function {n: i64} out i64 is {
        return n * 2
    }
    quiet: function out i64 is {
        return 0
    }
    loud: function {:this} out i64 is {
        return this.volume * 10
    }
} as {
    :Speaker
    grow: function {:this n: i64} out i64 is {
        return this.volume + n
    }
    twice: function {d: this} out i64 is {
        return d.volume * 2
    }
    one: function out i64 is {
        return 1
    }
    plusOne: function {n: i64} out i64 is {
        return n + 1
    }
}

main: function is {
    d: Dog volume: 3
    print "\{d.twice} \{Dog.twice d} \{(d.grow n: 4)} \{Dog.grow d n: 5}"
    print "\{Dog.one} \{Dog.plusOne n: 6}"
    ref: Dog.twice.take
    print "\{ref d: d}"
    print "\{d.bark n: 7} \{d.quiet} \{d.loud} \{d.speak}"
    s: d.Speaker
    print "\{s.speak}"
}
