# A value of type `never` -- a `match` or an `if` every arm of which leaves --
# does not finish: returned or ending a body, it runs as the statement it is.
kind: variant {
    a: null
    b: null
}
k: function {v: kind} out i64 is {
    return (match v case a then panic msg: "pa" case b then panic msg: "pb")
}
k2: function {v: kind} out i64 is {
    match v case a then panic msg: "qa" case b then panic msg: "qb"
}
k3: function {v: kind c: bool} out i64 is {
    if c then return 1
    return (if c then panic msg: "ra" else panic msg: "rb")
}
main: function is {
    print "\{k3 v: kind.a c: true}"
    # the panicking ones are reached by the program, and run on no path
    none: ListVal i64
    if none.length > 0 then {
        print "\{k v: kind.b} \{k2 v: kind.a} \{k3 v: kind.a c: false}"
    }
    print "done"
}
