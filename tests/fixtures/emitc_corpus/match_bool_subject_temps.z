# match_bool_subject_temps -- a `match` on a bool whose subject is built with
# temps: the operands of a comparison whose right side can panic are read into
# temps in written order, and a subject that is itself a `match` value is held
# in one. The temps are declared before the subject is tested, as a value and
# as a statement.

# pick -- a match value over a comparison whose right side is a remainder
pick: function {i: u32} out i64 is {
    return (match (i << 6.u32) < (7.u32 % i) case true then 1.i64 case false then 9.i64)
}

main: function is {
    i: 3.u32
    v: match (i << 6.u32) < (7.u32 % i) case true then 1.i64 case false then 9.i64
    w: 5.i64
    w = match (i << 1.u32) > (100.u32 % i) case true then w case false then 2.i64
    ready: false
    nested: match (
        match ready case true then ready case false then true
    ) case true then 4.i16 case false then 5.i16
    match (i * 2.u32) == (8.u32 / i) case true then print "equal" case false then print "unequal"
    print "\{v} \{w} \{nested} \{pick :i}"
}
