# A data block's `out` may leave its element or its index untyped by naming the
# literal type: `(intdata intliteral)` reads its elements as literals, as a
# block with no `out` does, and `(intdata u8 i: intliteral)` reads its slots
# untyped. As a value an untyped element is an i64 -- the block is an
# `intdata i64` -- and an untyped index a u64.
nid: typedef u64
u1: list { a: 1 b: 300 c: 7 } out (staticlist intliteral)
u2: list { a: 9 b: 10 } out (staticlist u8 i: intliteral)
t3: list { a: 9 b: 10 } out (staticlist u8 i: nid)
f4: list { 0.5 1.5 } out (staticlist floatliteral)

# the count of a block of i64
wide: function {c: staticlist i64} out u64 is {
    return c.length
}

main: function is {
    x: u1.b
    small: u1.c.u8
    print "\{x + 1} \{small} \{wide c: u1}"
    p: u2.slot.b
    print "\{p} \{p + 1} \{u2.get i: u2.slot.b}"
    print "\{t3.get i: t3.slot.b} \{f4.get i: 1}"
}
