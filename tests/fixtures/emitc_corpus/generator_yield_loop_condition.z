# generator_yield_loop_condition.z -- `yield` in a loop CONDITION.
#
# A suspension has to land on a statement, so it cannot be written inside the
# `while (...)` header; and a loop condition runs once per ITERATION, so it
# cannot be hoisted above the loop either. Both hold if the test moves into the
# body: `while (1) { <suspend>; if (!c) break; ... }` is the same loop, and is
# what the condition would be hand-written as to make this work.
#
# Resuming the condition with a value below the threshold keeps the loop going;
# one at or above it breaks out, and the generator continues past the loop.

counter: function out (Iterator Gives: i64 Accepts: i64) is {
    i: 0
    for while (yield i) < 3 loop { i = i + 1 }
    yield 99
}

main: function is {
    with g: (counter) do {
        k: 0
        for k < 6 loop {
            send: 1
            if k > 2 then send = 9
            r: g.call value: send
            match r case some then print "r: \{r}" case none then print "(none)"
            k = k + 1
        }
    }
    print "done"
}
