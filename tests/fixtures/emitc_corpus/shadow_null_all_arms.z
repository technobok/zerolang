# shadow_null_all_arms.z -- a sum whose every arm is written `null` is ordinal
# (payload-less) only when that `null` is the system's. Under a user `null`
# record each arm carries the record: the arm's operand is looked up where the
# sum is defined, not compared by its spelling.

null: record { x: i64 }

k: variant {
    a: null
    b: null
}

K: union {
    a: null
    b: null
}

main: function is {
    v: k.b (null x: 4)
    u: K.a (null x: 5)
    match (
        v
    ) case a then print "variant a \{v.x}" case b then print "variant b \{v.x}"
    match (
        u
    ) case a then print "union a \{u.x}" case b then print "union b \{u.x}"
}
