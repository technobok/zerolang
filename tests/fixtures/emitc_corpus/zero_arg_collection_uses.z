# A FUNCTION OF NO ARGUMENTS RETURNING A COLLECTION, NAMED BARE, IS CALLED: read
# through, passed, stored in a field and reassigned into a local.
mk: function out (ListVal u64) is {
    l: ListVal u64
    l.append 3
    return l
}

count: function {l: (ListVal u64).view} out u64 is {
    return l.length
}

Holder: class {
    items: ListVal u64
}

main: function is {
    h: Holder items: mk
    a: ListVal u64
    a = mk
    print "\{mk.length} \{count l: mk} \{h.items.length} \{a.length}"
}
