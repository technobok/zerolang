# After a re-point `x = v` the borrowed `x` keeps what `v` keeps: re-pointed at
# another parameter's view, or at a view of its own parameter or of itself, it
# is returned
# through `outx`; re-pointed at a literal, it views the program's own bytes and
# is returned through `out`. A re-point at an owned value is used in place.
Node: class {
    name: String
}

mk: function out Node is {
    return (Node name: "made".string)
}

other: function {p: String.view q: String.view} outx StringView is {
    s2: p.stringView
    s2 = q.stringView
    return s2
}

own: function {p: String.view} outx StringView is {
    s2: p.stringView
    s2 = p.substring from: 0 to: 2
    return s2
}

self: function {p: String.view} outx StringView is {
    s2: p.stringView
    s2 = s2.substring from: 1 to: s2.length
    return s2
}

literal: function {p: String.view} out StringView is {
    s2: "lit"
    s2 = "other"
    return s2
}

inPlace: function {n: Node.view} out u64 is {
    n = mk
    return n.name.length
}

main: function is {
    p: "param".string
    q: "qq".string
    m: Node name: "m".string
    print "\{other :p :q} \{own :p} \{self :p} \{literal :p} \{inPlace n: m}"
}
