# A `create` PARAMETER'S DEFAULT IS ITS VALUE WHEN THE CALL OMITS IT, in every
# spelling of the construction. The default was looked up on the constructed
# type, which has no such member, and `T.create` wrote 0 for any omitted
# parameter: `n: 5` constructed with 0.
Pair: class {
    a: u64
    b: String
} as {
    create: function {v: u64 n: 5} out this is {
        return (meta.create a: v b: "made \{n}")
    }
}

main: function is {
    p: Pair.create v: 1
    q: Pair v: 2
    r: Pair.create v: 1 n: 8
    print "\{p.b} \{q.b} \{r.b}"
}
