# A member the receiver's OWN type declares wins over a conversion its typedef
# chain end would offer. A typedef converts as its chain end -- that is where
# the conversion is declared -- but only the conversions THEMSELVES are
# declared there, and the numeric types declare them `is native`. A record
# over `i64.typedef` that declares its own `u32` declared a METHOD, and the
# chase used to answer with i64's conversion instead of calling it: the
# conversion row's resultval holes then bound to nothing and the compiler
# reported four E0500s against a program that was well formed.
m: record { val: i64.typedef } as {
    u32: function {:this} out i64 is { return 42 }
    i16: function {:this} out i64 is { return this.i64 + 1 }
}

main: function is {
    a: m.create from: 7
    print "own u32: \{a.u32}"
    print "own i16: \{a.i16}"
    # the conversions the record did NOT shadow still chase to the base
    print "chased u8: \{(a.u8).orPanic}"
    # and a plain numeric receiver converts exactly as before
    b: 200.u8
    print "plain: \{b.u64} \{(b.i8).or d: 99}"
}
