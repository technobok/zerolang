# A generator's local is a local to the programmer. The lowering stores it in
# the instance across suspensions, and the walk reads it as `this.s`, but it
# moves as a local does -- into a taking parameter, a generic one, through
# `.take`, and from the arm of a value a taking slot receives -- and it is zeroed
# where it moves, so the instance's destructor frees nothing twice. A read of
# one after the move in the same call is refused (generator_local_moved_read).
keep: function {s: String.take n: u64} out u64 is {
    return s.length + n
}

keepT: function as { T: StringLike.generic } in {b: T.take} is {
    print b
}

Gen: generator as {
    call: function out u64 is {
        s: "gen".string
        yield (keep s: s n: 2)
        t: "generic".string
        keepT b: t
        yield 0
        u: "taken".string
        v: u.take
        yield v.length
        c: true
        w: "arm".string
        yield (keep s: (if c then w else "made".string) n: 0)
        x: "arm take".string
        r: if c then x.take else "other".string
        yield r.length
    }
}

main: function is {
    for g: Gen loop print "gen \{g}"
}
