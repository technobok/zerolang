# A field declared by a NAME that denotes a compile-time CONSTANT takes the
# constant's type and the constant as its default. The question asked is what
# the name DENOTES, not what it looks like.
#
# `false` is not a type and never was: core binds it to `bool.false`, and a
# truth value is an ARM CONSTANT over bool's type -- bool being a variant like
# any other. So the two spellings below are one declaration, and they were only
# ever different because the gate read the first byte of the name: a leading
# digit meant "numeric literal", and everything else was looked up as a TYPE.
# `false` is not a type, so it resolved to nothing and the field was left with
# no type at all.
#
# The same rule gives a user-declared alias the same standing as the arm it
# names -- `First` below -- which is what makes this a rule rather than two
# builtins special-cased.
Colour: variant {
    red: null
    green: null
}

First: Colour.red

Flags: class {
    # the bare spelling and the dotted one, which must agree
    a: false
    b: bool.false
    c: true
    d: bool.true
    # a user alias of an arm, resolved the same way
    e: First
}

# a TYPE is still a type: no default, so construction must supply it
Typed: class {
    n: i64
}

show: function {f: Flags.borrow} is {
    print "a=\{f.a} b=\{f.b} c=\{f.c} d=\{f.d}"
    match (
        f.e
    ) case red then {
        print "e=red"
    } case green then {
        print "e=green"
    }
}

main: function is {
    d: Flags
    show f: d

    # an explicit argument overrides the default, in either spelling
    o: Flags a: true c: false
    print "overridden a=\{o.a} c=\{o.c}"

    t: Typed n: 7
    print "typed n=\{t.n}"
}
