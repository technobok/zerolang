# io_error_other.z -- an OS error no IoError arm names arrives as `other`,
# carrying the OS's message and its error number: removing a directory that is
# not empty (ENOTEMPTY; ERROR_DIR_NOT_EMPTY on Windows). The wording is the
# system's, in its language, so the test reads the payload's shape: some text,
# then "(os error N)". N is the system's own, so Windows has its own golden.

# shape -- "a message, (os error N)" for "<text> (os error N)"
shape: function {text: StringView} out String is {
    at: text.lastIndexOf needle: " (os error "
    match (
        at
    ) case some then {
        s: String
        if at > 0 then s.append "a message, " else s.append "no message, "
        s.append (text.substring from: at + 1 to: text.length)
        return s
    } case none then return "no os error number".string
}

main: function is {
    made: io.mkdirp path: "z_err_full/inner"
    match (made) case ok then null case err then print "mkdirp failed"
    r: io.remove path: "z_err_full"
    match (
        r
    ) case ok then print "removed a directory with something in it" case err then {
        match (
            r
        ) case other then {
            print "other: \{shape text: r.stringView}"
        } else print "another error"
    }
    io.removeTree path: "z_err_full"
}
