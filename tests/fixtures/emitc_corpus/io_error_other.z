# io_error_other.z -- an OS error no IoError arm names arrives as `other`,
# carrying the C library's message and the error number: a file name longer
# than the filesystem allows.

main: function is {
    name: "n".repeated n: 300
    r: io.open path: name.stringView mode: io.openmode.read
    match (
        r
    ) case ok then print "opened a 300-byte name" case err then {
        match (r) case other then print "other: \{r}" else print "another error"
    }
}
