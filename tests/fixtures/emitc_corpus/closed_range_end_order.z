# A CLOSED RANGE'S ENDS RUN IN THE ORDER THEY ARE WRITTEN: the start, then the
# end. Each end may need work done ahead of the statement that reads it -- an
# owned String it takes the length of, or an `if` with block arms -- and that
# work runs where it is declared. The end's work therefore has to be declared
# after the start, or it runs before it.

# tag -- prints its name, and answers n: a call with an effect
tag: function {name: StringView n: u64} out u64 is {
    print name
    return n
}

# mk -- prints its name, and answers an owned String of length n
mk: function {name: StringView n: u64} out String is {
    print name
    s: String
    for each i: n.times loop s.append "x"
    return s
}

main: function is {
    yes: (tag name: "flag" n: 1) == 1
    for each k: ((mk name: "start" n: 1).length.upto to: (mk name: "end" n: 2).length) loop {
        print "strings \{k}"
    }
    for each k: ((
        if yes then {
            print "start arm"
            1
        } else 0
    ).upto to: (
        if yes then {
            print "end arm"
            2
        } else 0
    )
    ) loop print "arms \{k}"
    for each k: ((tag name: "start" n: 2).downto to: (
        if yes then {
            print "end arm"
            1
        } else 0
    )
    ) loop print "call then arm \{k}"
}
