# sv.asString as a value: an argument of a function and of a list probe, a
# bound local, off a call's result and off a field, and through a pointer
Box: class {
    name: String
}

len: function {s: String.view} out u64 is {
    return s.length
}

viaParam: function {v: StringView xs: (List String).view} out bool is {
    return (xs.contains item: v.asString)
}

main: function is {
    xs: List String
    xs.append "abc".string
    n: "abc"
    print "\{len s: n.asString}"
    k: n.asString
    a: len s: k
    b: xs.contains item: k
    c: xs.contains item: n.asString
    print "\{a} \{b} \{c}"
    line: "abc,def".string
    d: xs.contains item: (line.substring from: 0 to: 3).asString
    e: xs.contains item: (line.substring from: 4 to: 7).asString
    print "\{d} \{e}"
    bx: Box name: "abc".string
    f: xs.contains item: bx.name.stringView.asString
    print "\{f} \{viaParam v: "abc" :xs} \{viaParam v: "abd" :xs}"
    m: Map String V: String
    m.set key: "abc".string value: "v".string
    print "\{m.has key: n.asString} \{m.has key: k}"
}
