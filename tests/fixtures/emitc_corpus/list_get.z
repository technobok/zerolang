# data_get.z -- a data block's element is read with `.get i:`, as a list's and
# an array's are: a constant index folds, a runtime one is bounds-checked, and
# an int, a float and a string block read alike.
primes: list {
    2
    3
    5
    7
}

ratios: list {
    0.5
    1.25
}

names: list {
    "ab"
    "cd"
}

sumOf: function {n: u64} out i64 is {
    t: 0
    k: 0.u64
    for k < n loop {
        t = t + (primes.get i: k)
        k = k + 1
    }
    return t
}

main: function {} is {
    k: 2.u64
    print "\{primes.get i: 1} \{primes.get i: k}"
    print "\{ratios.get i: 1} \{names.get i: 0} \{names.get i: k - 1}"
    print "\{sumOf n: primes.length}"
}
