# Each generic instance is checked and emitted from its own copy of the body,
# so no instance reads another's answer: the u8 instance's sum wraps before it
# is compared and the i64 instance's does not. With the i64 instance declared
# first, the u8 instance's walk came last and its wrap had reached the i64 one.
ops: unit as {
    t: anyval.generic
    grows: function {v: t} out bool is { return (v + v) > v }
}

o64: (ops t: i64)
o8: (ops t: u8)

main: function is {
    a: 200.u8
    b: 200
    if (o8.grows v: a) then print "u8 grows" else print "u8 wraps"
    if (o64.grows v: b) then print "i64 grows" else print "i64 wraps"
}
