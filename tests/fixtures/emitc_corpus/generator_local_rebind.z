# A generator's local declared in a loop body is bound afresh on every pass,
# kept in the instance across the suspension inside the pass: each pass frees
# what the previous one left unless it was moved out, and the instance's
# destructor frees the last one.
keep: function {s: String.take} out u64 is {
    return s.length
}

Moved: generator as {
    call: function out u64 is {
        i: 0
        for i < 3 loop {
            s: "it\{i}"
            yield (keep s: s)
            i = i + 1
        }
    }
}

Kept: generator as {
    call: function out u64 is {
        i: 0
        for i < 3 loop {
            s: "kept\{i}"
            yield s.length
            i = i + 1
        }
    }
}

main: function is {
    for a: Moved loop print "moved \{a}"
    for b: Kept loop print "kept \{b}"
    with k: Kept do {
        first: k.call
        match first case some then print "abandoned after \{first}" case none then print "none"
    }
}
