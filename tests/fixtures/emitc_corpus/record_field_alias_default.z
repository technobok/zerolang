# A RECORD FIELD DEFAULTS TO AN ARM NAMED BY A BARE ALIAS, as a class field and
# a parameter already did: `off: false` is the default `bool.false`, so a
# construction may leave it out. The record path read only the dotted spelling
# and demanded every alias-defaulted field ("missing required argument").
shade: variant {
    red: null
    blue: null
    tinted: u8
}

red: shade.red

row: record {
    n: u32
    lit: true
    off: false
    s: red
    d: bool.false
}

wrap: variant {
    one: row
    none0: null
}

main: function is {
    r: row n: 3
    t: row n: 4 lit: false s: shade.blue
    w: wrap.one (row n: 5)
    print "\{r.n} \{r.lit} \{r.off} \{r.s.red} \{r.d}"
    print "\{t.n} \{t.lit} \{t.s.blue}"
    match (w) case one then print "\{w.n} \{w.lit} \{w.s.red}" case none0 then null
}
