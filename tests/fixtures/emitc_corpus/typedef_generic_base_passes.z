# a typedef passes where its base is expected, and a typedef over a generic
# instance passes where THAT instance is expected: `Bytes` is a `ListVal u8`.
# The compatibility walk compared each link's template (`ListVal`) with the
# instance the parameter names, so both calls below were refused.
names: typedef ListRef String

lenOf: function {xs: (ListVal u8).view} out u64 is { return xs.length }

count: function {xs: (ListRef String).view} out u64 is { return xs.length }

main: function is {
    b: Bytes
    b.append from: 7
    b.append from: 8
    print "bytes \{lenOf xs: b}"
    n: names
    n.append from: "a".string
    print "names \{count xs: n}"
}
