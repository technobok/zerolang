# drop_ends_a_borrow.z -- `.drop` ends a name. A name that owns what it names
# destroys it; one that borrows -- a `.view` result such as `get`, a `view` or
# `.borrow` parameter, a readonly field read -- releases its locks and leaves
# the value to its owner, which may change it again at once.
#
# A readonly name keeps a lock on itself (that is what makes it readonly), and
# the drop took that for someone else's: "Cannot drop 'e': shared lock held by
# 'e'". A borrowed parameter's drop was accepted and destroyed the caller's
# value -- invalid C only because the pointer types disagreed.
Box2: class {
    items: List String
}

viewed: function {xs: (List String).view} out u64 is {
    n: xs.length
    xs.drop
    return n
}

borrowed: function {xs: (List String).borrow} out u64 is {
    n: xs.length
    xs.drop
    return n
}

plain: function {xs: List String} out u64 is {
    n: xs.length
    xs.drop
    return n
}

inner: function {b: Box2.view} out u64 is {
    i: b.items
    n: i.length
    i.drop
    return n
}

main: function is {
    xs: List String
    xs.append from: "a".string
    e: xs.get i: 0
    print e
    e.drop
    xs.append from: "b".string
    print "\{xs.length}"
    print "\{viewed :xs} \{borrowed :xs} \{plain :xs} \{xs.length}"
    b: Box2 items: xs.take
    print "\{inner :b} \{b.items.length}"
}
