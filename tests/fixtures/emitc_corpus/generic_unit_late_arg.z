# generic_unit_late_arg.z -- an instantiation whose argument is a user type
# declared AFTER it and referenced nowhere else: the mint pass demands and
# drains the arguments before keying the mono on the trie, so `Late` is a
# resolved type by then, not a name.
mathops: unit as {
    t: anyval.generic
    first: function {a: t b: t} out t is { return a }
}

recs: (mathops t: Late)

Late: record {
    n: i64
}

main: function is {
    x: Late n: 3
    y: Late n: 4
    print "\{(recs.first a: x b: y).n}"
}
