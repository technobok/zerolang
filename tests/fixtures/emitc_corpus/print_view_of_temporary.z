# print_view_of_temporary -- a method's view of its receiver, read off a
# temporary receiver: printed directly it was hoisted and FREED as if the
# String were the reader's, and the receiver's destroy freed it again (double
# free). Each position here reads the view and frees nothing of it.
public: unit {
    :main
}

# Holder -- owns one text
Holder: class {
    s: String
} as {
    # the held text, viewed: the holder still owns it
    shown: function {h: this.view} outx String.view is {
        return h.s
    }
}

# mk -- a fresh holder, which a caller reads as a temporary
mk: function out Holder is {
    return (Holder s: "held".string)
}

# size -- a viewed text's length
size: function {t: String.view} out u64 is {
    return t.length
}

main: function is {
    print mk.shown
    print "a \{mk.shown}"
    t: "b \{mk.shown}"
    print t
    if mk.shown == "held" then print "c same"
    print "d \{size t: mk.shown}"
    print "e \{mk.shown.length}"
}
