# reexport_chain.z -- a re-export OF a re-export, all three channels. Resolving
# the outer alias has to follow the inner one, and the inner one is a member of
# a subunit, so nothing on the path is reachable through the file-unit index.
main: function is {
    d: xunit_rexchain.D n: 4
    print "D.n=\{d.n} K=\{xunit_rexchain.K} sq=\{xunit_rexchain.sq n: 6}"
}
