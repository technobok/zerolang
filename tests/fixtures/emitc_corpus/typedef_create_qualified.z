# a typedef record constructed through the unit that declares it -- a hidden
# subunit, an inline unit -- is the same cast as the bare spelling: bare,
# parenthesised, `.create from:`, and from a narrower integer once it is
# converted to the base type (the construction itself converts nothing).
inl: unit {
    pid: typedef u64
}
main: function is {
    a: ids.oid 5
    b: (ids.oid 6)
    c: ids.oid.create from: 7
    small: 8.u32
    d: inl.pid small.u64
    e: inl.pid.create from: 9
    print "\{a.twice} \{b.twice} \{c.twice} \{d.u64} \{e.u64}"
}
