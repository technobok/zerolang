# if_later_clause_reads_payload -- A later clause of an `if` runs only where the
# clauses before it failed: an arm an earlier bare predicate tested is ruled out,
# and a negated one names the arm the subject holds. When one arm is left, the
# subject reads as its payload in the later clause's conditions and body, as it
# does in the else -- in a statement `if` and in one whose value is bound.
U: union {
    some: String
    none: null
}
T: union {
    a: String
    b: i64
    c: null
}
f: function {o: U.take c: bool} out u64 is {
    if o.none then {
        return 0
    } when o.length > 3 then {
        return o.length
    } when c then {
        return o.length + 100
    } else {
        return 1
    }
}
g: function {t: T} out i64 is {
    if t.c then return 0 when t.b then return t when t.length > 0 then return 7 else return 8
}
h: function {o: U c: bool} out u64 is {
    r: if o.none then 0 when c then o.length else 5
    return r
}
k: function {o: U} out u64 is {
    if o.some.not then return 9 when o.length == 2 then return 22 else return o.length
}
main: function is {
    print "\{f o: (U.some "abcd".string) c: false} \{f o: (U.some "ab".string) c: true} \{f o: U.none c: true} \{f o: (U.some "x".string) c: false}"
    print "\{g t: T.c} \{g t: (T.b 5)} \{g t: (T.a "q".string)} \{g t: (T.a "".string)}"
    print "\{h o: (U.some "abc".string) c: true} \{h o: U.none c: true} \{h o: (U.some "abc".string) c: false}"
    print "\{k o: U.none} \{k o: (U.some "ab".string)} \{k o: (U.some "abc".string)}"
}
