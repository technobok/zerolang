# generator_yield_expression.z -- `yield` used in EXPRESSION position.
#
# A suspension has to land at a statement boundary -- you cannot `return` from
# the middle of a C expression, nor `goto` into one -- so a yield written
# inside an expression is hoisted to its own statement and its resumed value
# read back afterwards.
#
# That value lives in a SLOT ON THE STATE CLASS, not a C local. The suspension
# returns from `.call`, so a local would be gone by the next one; the lowering
# allocates one slot per suspension point for the same reason it promotes
# yield-crossing locals to fields. That is what lets `(yield a) + (yield b)`
# work: the first operand's value survives the second suspension.
#
# Positions covered: a binop operand, a call argument, an interpolation, a
# statement-form yield's own operand, and two yields in one expression.

add1: function {v: i64} out i64 is {
    return v + 1
}

gen: function out (Iterator Gives: i64 Accepts: i64) is {
    a: yield 1
    b: (yield a) + 1
    c: add1 v: (yield b)
    print "interp: \{yield c}"
    yield (yield b) + (yield c)
}

main: function is {
    with g: (gen) do {
        i: 0
        for i < 9 loop {
            r: g.call value: i * 10
            match r case some then print "r: \{r}" case none then print "(none)"
            i = i + 1
        }
    }
    print "done"
}
