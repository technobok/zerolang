# Locals and parameters named as the system headers name macros -- windows.h
# defines `near` and `far` as nothing and `FAR`, `IN`, `OUT` likewise, the C
# runtime defines `errno`, `stdin` and `environ` as expressions -- and as C
# keywords. Under --readable-names each carries its variable id, so none of them
# is spelled as the macro or the keyword.

span: function {near: i64 far: i64} out i64 is {
    return far - near
}

main: function is {
    near: 2
    far: 9
    FAR: 1
    IN: 3
    OUT: 4
    errno: 5
    stdin: 6
    environ: 7
    int: 8
    print "\{span :near :far} \{FAR + IN + OUT} \{errno + stdin + environ + int}"
}
