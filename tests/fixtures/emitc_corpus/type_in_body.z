# `type` is a predefined identifier naming the object a definition is in, and in
# a method's BODY it means what the type's name means there, as it does in the
# method's signature: a type argument (`List type`), a construction (`type v:
# 5`), an application's argument (`(Option T: type)`). A local named `type`
# redefines it.
Node: class { v: i64 } as {
    kids: function {:this} out u64 is {
        xs: List type
        xs.append (Node v: 1)
        ys: List Node
        ys.append (type v: 2)
        return xs.length + ys.length
    }
    made: function {:this} out i64 is {
        n: type v: 5
        return n.v
    }
    none: function {:this} out i64 is {
        o: (Option T: type).none
        r: 0
        if o.none then r = 6
        return r
    }
    shadowed: function {:this} out i64 is {
        type: 40
        return type + 2
    }
    pick: function {:this xs: (List type).view} out u64 is { return xs.length }
}

main: function is {
    n: Node v: 0
    zs: List Node
    zs.append (Node v: 3)
    print "\{n.kids} \{n.made} \{n.none} \{n.shadowed} \{n.pick xs: zs}"
}
