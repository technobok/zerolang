# A STRING CONSTANT WITH AN ESCAPE is still a constant. An escape is a chunk of
# its own, already decoded, so `"a\nb"` is three chunks; the evaluator took any
# literal of more than one chunk for an interpolation and refused it (E0600
# "an interpolated string has no compile-time value").
LINES: "first\nsecond"
TABBED: "a\tb"
QUOTED: "say \"hi\""
SLASH: "back\\slash"
HEX: "\x41\x42"
JOINED: LINES + "\nthird"
N: LINES.length
STARTS: LINES.startsWith "first\n"
SAME: LINES == "first\nsecond"
HEAD: (LINES.substring from: 0 to: 5)

main: function is {
    print "\{LINES}|\{TABBED}|\{QUOTED}|\{SLASH}|\{HEX}"
    print "\{JOINED}"
    print "\{N} \{STARTS} \{SAME} \{HEAD} \{LINES.count}"
    with it: LINES.lines do for line: it loop {
        print "line \{line}"
    }
}
