# each_value_moves_once -- The value of a `for each` binding runs once, before the loop:
# what it moves is not moved again by an iteration a `continue` ends.
pass: function {xs: (ListVal i64).take} out (ListVal i64) is {
    return xs
}

main: function is {
    e: (ListVal i64)
    e.append 1
    e.append 7
    e.append 2
    n: 0
    for each y: (pass xs: e) loop {
        if y > 5 then continue
        n = n + y
    }
    print "\{n}"
}
