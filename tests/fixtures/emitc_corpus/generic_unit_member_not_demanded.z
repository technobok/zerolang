# An instance of a generic unit checks the functions the program uses, one at
# a time, and no other: `audit` is wrong for every instance and nothing calls
# it, so neither instance walks it. `quad` reaches `twice` only from its own
# body, and `kay` is read through the alias alone.
scaler: unit as {
    t: anyval.generic
    K: 3
    # v doubled
    twice: function {v: t} out t is { return v + v }
    # v four times
    quad: function {v: t} out t is { return (twice (twice v)) }
    # the constant
    kay: function out i64 is { return K }
    # never called: no member `missing`
    audit: function {v: t} out t is { return v.missing }
}

isc: (scaler t: i64)
fsc: (scaler t: f64)

main: function is {
    print "\{isc.quad 5} \{isc.kay} \{fsc.twice 1.5}"
}
