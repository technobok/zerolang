# A spec instance projects a conforming value as the spec's own name does:
# `(Getter v: i64) c.borrow` borrows `c`, `(Getter v: i64) (Cell ...)` owns its
# source, `(sized n: i64) p` copies. The parenthesised head was recorded as an
# ordinary call (stampConstructionKind knew no projection), so its arguments
# were refused: "the callee is a value of type 'Getter_i64'".
Getter: protocol {
    v: anyval.generic
    get: function {t: this.view} out v
}
sized: facet {
    n: anyval.generic
    size: function {t: this.view} out n
}
Cell: class { n: i64  s: String } as {
    g: (Getter v: i64)
    get: function {c: this.view} out i64 is { return c.n }
}
pt: record { x: i64 } as {
    m: (sized n: i64)
    size: function {p: this.view} out i64 is { return p.x }
}
main: function is {
    c: Cell n: 4 s: "c".string
    a: (Getter v: i64) c.borrow
    b: (Getter v: i64) (Cell n: 5 s: "own".string)
    p: pt x: 7
    f: (sized n: i64) p
    g: (sized n: i64) (pt x: 8)
    xs: List (Getter v: i64)
    xs.append ((Getter v: i64) (Cell n: 6 s: "l".string))
    print "\{a.get} \{b.get} \{f.size} \{g.size} \{xs.length}"
}
