# `ListVal.getView` reads an element in place: a record's fields, a field of a
# field, a variant matched through the view, and the view passed on to a
# `.view` parameter. The C binds a pointer into the list, never a copy.
pair: record {
    a: i64
    b: i64
}

item: record {
    p: pair
    n: i64
}

shape: variant {
    dot: i64
    box: item
}

sumOf: function {it: item.view} out i64 is {
    return it.p.a + it.p.b + it.n
}

total: function {xs: (ListVal item).view} out i64 is {
    t: 0
    i: u64
    for i < xs.length loop {
        it: xs.getView :i
        t = t + (sumOf :it)
        i = i + 1
    }
    return t
}

main: function is {
    xs: ListVal item
    xs.append (item p: (pair a: 1 b: 2) n: 3)
    xs.append (item p: (pair a: 10 b: 20) n: 30)
    print "\{total :xs}"
    v: xs.getView i: 1
    print "\{v.p.a} \{v.n}"
    ss: ListVal shape
    ss.append (shape.dot 4)
    ss.append (shape.box (item p: (pair a: 5 b: 6) n: 7))
    k: u64
    for k < ss.length loop {
        s: ss.getView i: k
        k = k + 1
        match (
            s
        ) case dot then {
            print "dot \{s}"
        } case box then {
            print "box \{s.p.b} \{s.n}"
        }
    }
}
