# An array's and a str's members are written only where written C calls them:
# this program reads an array's length and an element, and a str's size and
# its String, so the array's `set` and the str's conversion from a String are
# not written -- nor is the `==` of either, which nothing compares.
holder: record {
    arr: (array t: i64 to: 4)
    raw: (str to: 8)
}

main: function is {
    h: holder arr: (array t: i64 to: 4) raw: (str to: 8)
    print "\{h.arr.length} \{h.arr.get i: 1} \{h.raw.size}"
    s: h.raw.string
    print "[\{s.stringView}]"
}
