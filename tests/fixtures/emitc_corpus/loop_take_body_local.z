# A local declared inside the loop body is fresh each iteration, so moving
# it is fine; so is moving the loop variable of an owned iteration.
eats: function {s: String.take} out bool is {
    return s.length > 0
}
main: function is {
    n: 0
    for while n < 3 loop {
        n = n + 1
        s: "abc".string
        if (eats s: s) then print "took \{n}"
    }
    xs: (List String)
    xs.append from: "a".string
    xs.append from: "bb".string
    for v: xs.iterate loop {
        print "\{v.length}"
    }
    print "done"
}
