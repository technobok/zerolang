# IN AN INSTANCE, A NUMERIC GENERIC PARAMETER IS ITS SINGLETON TYPE'S ONE VALUE:
# `cap` in `(Box cap: 5)` is a value of the type `(Box cap: 5).cap`, a typedef
# over u32 whose one value is 5, known when the instance is checked. Read
# inline it folds as its bound does -- `cap * 2` is a u32, `cap > 4` decides the
# instance's arm, `match cap` dissects, `cap.u64` converts, an array sized
# `cap * 2` is sized per instance -- and it is the receiver of its bound's
# methods (`cap.times`); a literal against it is read as that bound (`4 + cap`
# is a u32, `4 < cap` compares u32s). A local `c: cap` is a slot of the singleton type: it
# holds the value at run time, and arithmetic over it is a u32. Reached through
# a unit instance's name (`four.cap`) it is the same value. The type's create
# takes no argument and makes its one value: `cap.create` is `cap`, in a body
# and in a constant (`C: cap.create` is a constant of the singleton type).
Box: class {
    used: u32
} as {
    cap: u32.generic
    C: cap.create
    W: C.u64 + 1
    made: function {:this} out String is {
        m: cap.create
        return "\{m} \{m + 1} \{C} \{W} \{cap.create.u64}"
    }
    info: function {:this} out String is {
        twice: cap * 2
        wide: cap.u64 + 1
        c: cap
        a: array t: i64 to: cap * 2
        r: "small".string
        if cap > 4 then r = "big".string
        k: match cap case 5 then "five" else "other"
        steps: 0
        for each i: cap.times loop steps = steps + 1
        return "\{twice} \{wide} \{c} \{a.length} \{r} \{k} \{c + 1} \{steps} \{u32id v: 4 + cap} \{4 < cap}"
    }
}

# u32id -- the u32 it is given: a literal operand of `cap` is read as cap's
# bound, so `4 + cap` is a u32
u32id: function {v: u32} out u32 is {
    return v
}

sized: unit as {
    cap: u32.generic
    D: cap.create
    E: D * 2
    width: function out u32 is {
        return cap + 1
    }
}

four: (sized cap: 4)

main: function is {
    b: (Box cap: 5) used: 0
    d: (Box cap: 3) used: 0
    print "\{b.info}"
    print "\{d.info}"
    print "\{b.made} | \{d.made}"
    print "\{four.cap} \{four.width} \{four.cap.create} \{four.D} \{four.E}"
}
