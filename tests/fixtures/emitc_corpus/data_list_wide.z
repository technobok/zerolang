# data_list_wide.z -- a static list's element is static storage and is never
# boxed, so a walk yields it whole whatever its size: a data value is held as a
# handle, which fits a union's slot whatever its fields hold, and a choice
# value is held by value, wider than a slot. A list of either is walked by
# `for each`; a data value is held in an optionval and a variant's arm.
pair: data { a: u64 b: u64 c: u64 }
ps: list { (pair a: 1 b: 2 c: 3) (pair a: 4 b: 5 c: 6) }
slot: variant { none: null one: pair }
wide: choice { none: null n: u64 p: pair }
ws: list { (wide.n 7) wide.none (wide.p (pair a: 7 b: 8 c: 9)) }

main: function is {
    for each p: ps loop print "\{p.a + p.b + p.c}"
    o: optionval.some (ps.get i: 1)
    match o case some then print "\{o.c}" case none then print "none"
    s: slot.one (ps.get i: 0)
    match (s) case one then print "\{s.b}" case none then print "none"
    for each w: ws loop {
        match (w) case n then print "n \{w}" case p then print "p \{w.c}" case none then print "none"
    }
}
