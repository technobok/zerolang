# a variable reassigned from a call that takes the variable itself keeps the
# call's result: the move out of it is complete before its old value is freed,
# so neither the free nor the move's zeroing touches what the call returned --
# a String, a List grown twice, a class's field, and a construction taking the
# target's own field.
Box: class {
    s: String
}
Holder: class {
    s: String
    n: i64
}
wrap: function {s: String.take} out String is {
    return s
}
grow: function {l: (ListVal i64).take} out (ListVal i64) is {
    l.append from: 9
    return l
}
main: function is {
    a: "abc".string
    a = (wrap s: a.take)
    xs: ListVal i64
    xs.append from: 1
    xs = (grow l: xs.take)
    xs = (grow l: xs.take)
    b: Box s: "def".string
    b.s = (wrap s: b.s.take)
    h: Holder s: "ghi".string n: 1
    h = (Holder s: h.s.take n: 2)
    print "[\{a}] \{xs.length} [\{b.s}] [\{h.s}] \{h.n}"
}
