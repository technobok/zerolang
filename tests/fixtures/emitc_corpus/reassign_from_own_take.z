# a variable reassigned from a call that takes the variable itself keeps the
# call's result: the move out of it is complete before its old value is freed,
# so neither the free nor the move's zeroing touches what the call returned --
# a String and a List grown twice.
wrap: function {s: String.take} out String is {
    return s
}
grow: function {l: (ListVal i64).take} out (ListVal i64) is {
    l.append from: 9
    return l
}
main: function is {
    a: "abc".string
    a = (wrap s: a.take)
    xs: ListVal i64
    xs.append from: 1
    xs = (grow l: xs.take)
    xs = (grow l: xs.take)
    print "[\{a}] \{xs.length}"
}
