# A protocol call reads both its vtable and its data through the receiver, and a
# call through a function field reads the field through the receiver and passes
# it the receiver. A receiver that is a call's result used to be spelled at each
# read: the protocol call built its receiver twice and leaked one, and the field
# call took the address of a call, which C rejects. It is now bound once.
Reader: protocol {
    read: function {:this b: i64} out i64
}

MyFile: class {
    fd: i64
} as {
    myreader: Reader
    read: function {f: this b: i64} out i64 is {
        return f.fd + b
    }
}

mkr: function {n: i64} out Reader is {
    print "r\{n}"
    f: MyFile fd: n
    return (Reader.create from: f.take)
}

Holder: class {
    k: i64
    op: function {:this a: i64} out i64 is {
        return this.k + a
    }
}

mkh: function {n: i64} out Holder is {
    print "h\{n}"
    return (Holder k: n)
}

main: function is {
    x: (mkr n: 1).read b: 2
    y: (mkh n: 3).op a: 4
    print "\{x} \{y}"
}
