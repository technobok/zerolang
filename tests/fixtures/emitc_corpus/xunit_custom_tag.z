# A unit whose union takes its tag from the unit's OWN `codes` block -- the main
# program declares a `codes` of its own, with the values the other way round
# (custom_tag_nearest_decl). The tag was bound after the fact in the MAIN unit's
# scope, so this union carried main's values and `U.b` read truthy.
codes: data { a: 1  b: 0 }

U: union { a: null  b: null } as { tag: codes.tag }

# `U.b` as a condition: its discriminator is 0 here, so it is falsy
which: function out String is {
    u: U.b
    if u then return "truthy"
    return "falsy"
}
