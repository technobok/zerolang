# A list written inside a data value takes its type from the field it lands
# in: `needs: list { ... }` is a `staticlist text` without an `out`, and an
# empty one needs none. Its labels, `slot` and `length` are read through the
# path to it (`first.needs.write`), and the value it is held by carries it at
# run time as any field.
entry: data {
    key: "".text
    needs: staticlist text
    codes: (staticlist u8 i: u64)
}

first: (entry key: "system.exit" needs: list { write: "io.write" read: "io.read" } codes: list { 9 10 })
none: (entry key: "none" needs: list {} codes: list {})

# the needs of an entry, one per line
show: function {n: entry} is {
    for each d: n.needs loop print d.stringView
}

main: function is {
    print first.needs.write.stringView
    print "\{first.needs.length} \{first.needs.slot.read} \{first.codes.1} \{none.needs.length}"
    show n: first
    show n: none
    for each c: first.codes loop print "\{c}"
}
