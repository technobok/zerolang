# A type parameter read as a value in a generic body is its zero-argument
# construction, in each instance: a function's own parameter, written `t` or
# `T`, and a generic class's, in a method.

# Pt -- a point whose fields default
Pt: record { x: 7 y: 8 }

# zero -- a value of the argument's type, built from nothing
zero: function as { t: anyval.generic } in {a: t} out t is {
    b: t
    return b
}

# empty -- an empty value of the reference type the argument has
empty: function as { T: AnyRef.generic } in {a: T.view} out T is {
    return T
}

# Box -- a value held in a class
Box: class { v: t } as {
    t: anyval.generic
    # blank -- a value of the held type, built from nothing
    blank: function {:this} out t is { return t }
}

main: function is {
    x: zero a: 3
    y: zero a: 2.5
    p: zero a: (Pt x: 1 y: 2)
    s: empty a: "hi".string
    print "[\{x}] [\{y}] [\{p.x} \{p.y}] [\{s}] [\{(Box u8 v: 7).blank}]"
}
