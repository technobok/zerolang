# match_cases_leave_else_yields -- A match whose every `case` leaves and whose `else`
# yields has the else's value.
kind: variant {
    a: null
    b: null
}

f: function {v: kind} out i64 is {
    x: match v case a then return 1 else 5
    return x + 10
}

main: function is {
    print "\{f v: kind.a} \{f v: kind.b}"
}
