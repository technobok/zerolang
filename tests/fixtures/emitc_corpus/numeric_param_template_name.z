# A NUMERIC GENERIC PARAMETER READ THROUGH ITS TEMPLATE'S OWN NAME INSIDE THE
# TEMPLATE IS EACH INSTANCE'S: `Box.cap` in Box's method reads as the bare `cap`,
# 5 in `(Box cap: 5)` and 9 in `(Box cap: 9)`, as the template's constants read
# through its name (`Box.K`) do. It read 0 in every instance. Outside the
# template the template has no value for it (errors/numeric_param_through_template).
Box: class {
    used: u32
    show: function {:this} out u32 is {
        return Box.cap + Box.K + this.used
    }
} as {
    cap: u32.generic
    K: cap * 10
}

main: function is {
    a: (Box cap: 5) used: 1
    b: (Box cap: 9) used: 2
    print "\{a.show} \{b.show}"
}
