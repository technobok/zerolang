# An `if` used as a value runs only the arm its conditions choose, and a
# condition after the first only when the ones before it failed. A temporary an
# arm's or a later condition's argument needs -- an owned String passed to a
# `.view` parameter, a boxed value -- used to be built before the statement, so
# its call ran whichever arm was chosen. It is now zeroed before the statement
# and assigned where its arm runs; a `Box` arm, which cannot be assigned inside
# an expression, builds the whole `if` as statements.
mks: function {n: i64} out String is {
    print "s\{n}"
    return "x\{n}"
}

lenv: function {a: String.view} out u64 is {
    return a.length
}

lt: function {a: u64 b: u64} out bool is {
    return a < b
}

pair: function {a: u64 b: u64} out u64 is {
    return a + b
}

unbox: function {b: (Box t: u64)} out u64 is {
    return 7
}

main: function is {
    shut: false
    open: true
    r1: (lenv a: (mks n: 1)) + (if shut then (lenv a: (mks n: 2)) else 0)
    r2: 1.u64 + (if shut then 1 else if (lt a: 1 b: (lenv a: (mks n: 3))) then 2 else 3)
    r3: pair a: (if shut then (lenv a: (mks n: 4)) else 5) b: 1
    r4: 1.u64 + (if open then 7 else (lenv a: (mks n: 5)))
    r5: 1.u64 + (if open then (if shut then (lenv a: (mks n: 6)) else (lenv a: (mks n: 7))) else 0)
    r6: 1.u64 + (if shut then (unbox b: (Box from: (lenv a: (mks n: 8)))) else 2)
    print "\{r1} \{r2} \{r3} \{r4} \{r5} \{r6} \{(if shut then (lenv a: (mks n: 9)) else 0)}"
    i: 0
    for i < 2 loop {
        q: 1.u64 + (if open then (lenv a: (mks n: 10)) else 0)
        print "loop \{q}"
        i = i + 1
    }
    s: "abc".string
    t: if shut then (mks n: 11) else s.take
    print "took \{t}"
}
