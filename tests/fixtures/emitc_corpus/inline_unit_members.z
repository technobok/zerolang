# inline_unit_members.z -- an inline unit holds every static definition, and its
# members belong to IT: two namespaces each declaring a `twice` get their own C
# function rather than colliding, and a record declared in one constructs
# through the namespace that owns it.
m: unit {
    twice: function {n: i64} out i64 is {
        return n * 2
    }
}

n: unit {
    twice: function {n: i64} out i64 is {
        return n * 3
    }
}

shape: unit {
    point: record { x: i64 y: i64 }
}

main: function is {
    print "m.twice=\{m.twice 21} n.twice=\{n.twice 21}"
    p: shape.point x: 3 y: 4
    print "p=\{p.x},\{p.y}"
}
