# generic_unit_instance_path -- a template written in a generic unit is reached
# from outside through an instance of the unit, which binds the unit's
# parameters, and an application names the template's own: a unit-level alias
# (`wp: (wi.pairs u: f64)`, `CF: (wi.Cell u: f64)`), an application in a body
# (`(wi.pairs u: bool).both`), and one through an instance written in place
# (`((wrap t: i64).pairs u: f64)`), which is the same instance as `wi`'s. A
# unit-level one was refused as "a unit-level constant takes a literal value".
wrap: unit as {
    t: anyval.generic
    pairs: unit as {
        u: anyval.generic
        both: function {a: t b: u} out t is { return a }
        second: function {a: t b: u} out u is { return b }
    }
    Cell: record {
        a: t
        b: u
    } as { u: anyval.generic }
}

wi: (wrap t: i64)
wp: (wi.pairs u: f64)
CF: (wi.Cell u: f64)

main: function is {
    print "wp \{wp.both a: 5 b: 1.5} \{wp.second a: 5 b: 1.5}"
    c: CF a: 7 b: 2.5
    print "cf \{c.a} \{c.b}"
    print "body \{(wi.pairs u: bool).both a: 6 b: true} \{(wi.pairs u: bool).second a: 6 b: true}"
    print "in place \{((wrap t: i64).pairs u: f64).both a: 8 b: 0.5}"
}
