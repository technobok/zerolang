# A class that holds a List of itself: a tree. The List's bodies index the
# element, so they follow the class's struct; the List's own struct, which
# holds the element by pointer, precedes it. The C used to name an incomplete
# element ("invalid use of undefined type").
Node: class { n: i64 kids: ListRef Node }

sumTree: function {t: Node.view} out i64 is {
    s: t.n
    for k: t.kids.iterate loop s = s + (sumTree t: k)
    return s
}

main: function is {
    t: (Node n: 1 kids: (ListRef Node))
    c: (Node n: 2 kids: (ListRef Node))
    c.kids.append (Node n: 4 kids: (ListRef Node))
    t.kids.append c.take
    t.kids.append (Node n: 3 kids: (ListRef Node))
    print "kids=\{t.kids.length} sum=\{sumTree t: t}"
}
