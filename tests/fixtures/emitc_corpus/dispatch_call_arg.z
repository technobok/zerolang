# A value a call returns, passed to a protocol method that takes it by address:
# a view (`io.stdout.write from: (ByteView b.listView)`) and an owned list
# (`s.count xs: mk`) are each bound to a temp first. The view's temp frees
# nothing; the owned list's temp frees it.
Sink: protocol {
    count: function {:this xs: ListVal i64} out u64
}

C: class { n: i64 } as {
    :Sink
    count: function {:this xs: ListVal i64} out u64 is { return xs.length }
}

mk: function out ListVal i64 is {
    r: ListVal i64
    r.append from: 1
    r.append from: 2
    return r
}

main: function is {
    b: Bytes
    b.append from: 111
    b.append from: 107
    b.append from: 10
    io.stdout.write from: (ByteView b.listView)
    io.stdout.write from: (ByteView.create from: b.listView)
    c: C n: 1
    s: c.Sink
    print "count=\{s.count xs: mk}"
}
