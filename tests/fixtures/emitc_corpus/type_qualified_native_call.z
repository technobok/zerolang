# A method called through its type, `T.m v a`, takes the receiver as its
# unlabelled argument: a native method of each family gives what the call
# through the value, `v.m a`, gives -- the receiver a local, a parameter held
# by pointer, a field path, and a call's result.

# Shelf -- a class holding a list in a field
Shelf: class {
    ids: ListVal i64
}

# has -- whether the list holds the text, asked through its type
has: function {xs: List String s: String} out bool is {
    loc: s.copy
    return ((List String).contains xs item: loc)
}

# made -- a fresh list holding 3
made: function out ListVal i64 is {
    l: ListVal i64
    l.append 3
    return l
}

main: function is {
    xs: List String
    xs.append "a".string
    (List String).append xs from: "b".string
    t: "b".string
    print "\{xs.get 1} \{(List String).get xs i: 1} \{xs.contains item: t} \{(
        (List String).contains
        xs
        item: t
    )}"
    print "\{has :xs s: "a".string} \{has :xs s: "c".string}"
    print "\{(List String).pop xs} \{xs.length}"
    ys: ListVal i64
    ys.append 4
    (ListVal i64).append ys from: 5
    print "\{(ListVal i64).get ys i: 1} \{(ListVal i64).contains ys item: 4} \{(
        (ListVal i64).contains
        made
        item: 3
    )}"
    sh: Shelf ids: ListVal i64
    (ListVal i64).append sh.ids from: 7
    print "\{sh.ids.length} \{(ListVal i64).contains sh.ids item: 7}"
    s: "hello"
    print "\{StringView.substring s from: 1 to: 3} \{StringView.compare s rhs: "help"} \{(
        StringView.startsWith
        s
        prefix: "he"
    )}"
    w: "hello".string
    String.append w s: " there"
    print "\{w}"
    st: SetVal i64
    st.add item: 3
    print "\{st.has item: 3} \{(SetVal i64).has st item: 3} \{(SetVal i64).has st item: 4}"
    m: MapVV i64 v: i64
    m.set key: 1 value: 9
    (MapVV i64 v: i64).set m key: 2 value: 8
    print "\{((MapVV i64 v: i64).get m key: 1).or d: 0} \{(
        ((MapVV i64 v: i64).get m key: 2).or
        d: 0
    )}"
    o: (optionval i64).some 3
    print "\{o.or d: 0} \{(optionval i64).or o d: 0} \{(
        (optionval i64).or
        (optionval i64).none
        d: 5
    )}"
}
