# a library unit that USES its own private definition. `secret` is exposed under
# no name, so an external reference to it is E0101 -- but `openCount`, which is
# public, calls it freely. Which of those two a call is depends on the unit the
# CALLER is being walked as, so this pair is what a walk that derives the unit
# from anything but the definition itself gets wrong: walk openCount's body as
# though it belonged to its caller and its own private call reads as external.
public: unit { :openCount }

secret: function {n: i64} out i64 is {
    return n * 2
}

openCount: function {n: i64} out i64 is {
    return (secret n: n) + 1
}
