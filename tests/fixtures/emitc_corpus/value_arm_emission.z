# EVERY ARM OF AN `if` OR A `match` USED AS A VALUE IS EMITTED, not only an arm
# that is one expression. An arm that leaves -- a return, a panic, a continue --
# was assigned as a value ("unhandled callee return"); a `match` arm running a
# block, a `match` yielding a String, and a `match` as an `if` arm's value
# reached the emitter unhandled; an `error` in an arm counted as reached though
# the arm runs only when selected; and an `if` or `match` arm of literals nested
# in another was refused as a second type.
mode: variant {
    fast: null
    slow: null
}

guard: function {c: bool} out i64 is {
    v: if c then { 5 } else { return 0 }
    return v + 1
}

pick: function {m: mode} out i64 is {
    v: match (m) case fast then { 5 } else { return 0 }
    return v + 1
}

main: function is {
    c: 3 > 2
    m: mode.fast
    print "\{guard :c} \{guard c: c.not} \{pick :m} \{pick m: mode.slow}"
    block: match (m) case fast then {
        a: 2
        a * 3
    } else { 4 }
    safe: match (m) case fast then { 1 } else { panic msg: "never selected" }
    trap: match (m) case fast then { 2 } else { error "only a run-time trap" }
    total: 0
    for i: 5.iterate loop {
        step: if i > 2 then { i } else { continue }
        total = total + step
    }
    inner: match (m) case fast then { if c then { 7 } else { 8 } } else { 9 }
    outer: if c then { match (m) case fast then { 10 } else { 11 } } else { 12 }
    print "\{block} \{safe} \{trap} \{total} \{inner} \{outer}"
    owned: match (m) case fast then {
        t: "moved".string
        t
    } else { "copied".string }
    view: match (m) case fast then { "view" } else { "other" }
    print "\{owned} \{view}"
}
