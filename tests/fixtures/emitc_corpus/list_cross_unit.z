# A list's elements read through its unit by label -- the same reads as
# from inside the declaring unit.
main: function is {
    b: 9.u8
    if b == list_consts.codes.ht then print "ht"
    x: list_consts.codes.lf
    print "\{x}"
    sp: list_consts.codes.space
    if sp == 32 then print "space"
}
