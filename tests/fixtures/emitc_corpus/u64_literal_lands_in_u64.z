# a decimal literal past i64 is accepted wherever a u64 takes it -- a
# parameter, a reassignment, a comparison, a converted binding, a field
# default, a return, an interpolated conversion, an array element -- and is
# written with its unsigned suffix. i64's minimum is the one negative literal
# past i64's maximum in magnitude that an i64 holds.
show: function {v: u64} out u64 is {
    return v
}
big: function out u64 is {
    return 18446744073709551615
}
slot: record {
    v: 18446744073709551615.u64
}
main: function is {
    x: 5.u64
    if x == 18446744073709551615 then print "max" else print "not max"
    x = 9223372036854775808
    print "\{x}"
    x = 18446744073709551615
    y: 18446744073709551614.u64
    c: slot
    print "\{show v: 18446744073709551615} \{x} \{y} \{c.v} \{big}"
    print "\{18446744073709551615.u64}"
    n: 5
    n = -9223372036854775808
    print "\{n}"
    xs: (array t: u64 to: 2)
    xs.set i: 1 item: 18446744073709551615
    print "\{xs.get i: 1}"
}
