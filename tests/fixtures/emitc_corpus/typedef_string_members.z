# A typedef over String or StringView (`Path`, `PathView`) shares its base's
# struct and methods: a counter read and a method call reach them whether the
# receiver is a local or a field.
Holder: class { p: Path v: PathView }

main: function is {
    s: "abcd".string
    p: Path s
    print "local: \{p.length} \{p.startsWith prefix: "ab"}"
    t: "efghij".string
    u: "klm".string
    h: Holder p: (Path t) v: (PathView u.stringView)
    print "field: \{h.p.length} \{h.p.endsWith suffix: "ij"} \{h.v.length} \{h.v.contains needle: "l"}"
    w: "nop".string
    pv: PathView w.stringView
    print "view: \{pv.startsWith prefix: "n"}"
}
