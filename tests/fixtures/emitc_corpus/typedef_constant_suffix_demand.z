# typedef_constant_suffix_demand.z -- a unit whose ONLY use of a scalar typedef
# is a data block's `out T`. Definitions resolve after the demand walk, so the
# `out` clause has to seed the demand itself or the typedef is never
# materialised and every read of an element reports an unknown reference.
nid: record {
    val: u32.typedef
} as {
    ==: function {:this rhs: nid} out bool is {
        return this.u32 == rhs.u32
    }
    isZero: function {:this} out bool is {
        return this.u32 == 0
    }
}

names: data {
    wkFirst: 1
} out nid

main: function is {
    # an element INLINES as its value, and a shadowed `==` is a record method
    # taking `&receiver`, so the comparison binds first.
    v: names.wkFirst
    if v == names.wkFirst then print "first"
    if v.isZero then print "zero" else print "set"
}
