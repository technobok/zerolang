# typedef_constant_suffix_demand.z -- a unit whose ONLY use of a scalar typedef
# is a constant's literal suffix. Constants resolve after the demand walk, so
# the suffix has to seed the demand itself or the typedef is never materialised
# and every read of the constant reports an unknown reference.
nid: record {
    val: u32.typedef
} as {
    ==: function {:this rhs: nid} out bool is {
        return this.u32 == rhs.u32
    }
    isZero: function {:this} out bool is {
        return this.u32 == 0
    }
}

wkFirst: 1.nid

main: function is {
    # a unit constant INLINES as its literal, and a shadowed `==` is a record
    # method taking `&receiver`, so the comparison binds first.
    v: wkFirst
    if v == 1.nid then print "first"
    if v.isZero then print "zero" else print "set"
}
