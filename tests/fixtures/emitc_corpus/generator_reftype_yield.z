# generator_reftype_yield.z -- generators yielding REFTYPES wrap in Option
# (boxed payload): the yield leg boxes the owned value, the consumer loop
# moves it out and frees box + payload per iteration, and the loop-owned
# instance destroys at block exit (freeing its owned fields).

Tags: generator { base: String  n: u64 } as {
    call: function out String is {
        i: 0.u64
        for i < this.n loop {
            yield this.base.copy
            i = i + 1
        }
    }
}

Pair: generator { base: String } as {
    call: function out String.take is {
        yield this.base.copy
        yield this.base.copy
    }
}

main: function is {
    for s: (Tags base: "alpha".string n: 3) loop print "s: \{s}"
    xs: (List String)
    for t: (Pair base: "gamma".string) loop {
        xs.append t
    }
    n: xs.length
    print "collected: \{n}"
    i: 0.u64
    for i < n loop {
        e: xs.get i: i
        print "e: \{e}"
        i = i + 1
    }
    print "done"
}
