# A FIELD TYPED BY AN INSTANCE'S NUMERIC GENERIC PARAMETER, NAMED THROUGH THE
# INSTANCE, IS A SLOT OF THAT INSTANCE'S SINGLETON TYPE: `(Box cap: 5).cap`,
# `B5.cap` with `B5: (Box cap: 5)`, and a unit instance's `w3.n` each hold
# their one value, in a class and in a record alike. The construction sets
# each and takes no argument for it, and a read passes where the bound is
# expected. Inside the template, `Box.cap` is the parameter itself, as `cap`
# is: each instance's slot holds its own value.
Box: class {
    used: u32
    mine: Box.cap
} as {
    cap: u32.generic
    get: function {b: this.view} out u32 is { return b.mine + b.used }
}
B5: (Box cap: 5)

wrap: unit as {
    n: u64.generic
}
w3: (wrap n: 3)

Holder: class {
    k: (Box cap: 5).cap
    j: B5.cap
    m: w3.n
    used: u32
}

Pair: record {
    j: B5.cap
    x: i64
}

twice: function {v: u32} out u32 is { return v * 2 }

main: function is {
    h: Holder used: 1
    print "\{h.k} \{h.j} \{h.m} \{h.used} \{twice v: h.j}"
    p: Pair x: 4
    print "\{p.j} \{p.x}"
    b5: (Box cap: 5) used: 1
    b7: (Box cap: 7) used: 1
    print "\{b5.mine} \{b5.get} \{b7.mine} \{b7.get}"
}
