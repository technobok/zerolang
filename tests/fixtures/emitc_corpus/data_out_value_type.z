# A data block's `out` names its VALUE type -- `intdata u8`, `floatdata f32`,
# `stringdata`, or an instance with its own index type `(intdata u8 i: nid)`.
# Its elements are the element type's, and its index is the instance's: read
# through the name or passed as a value.
nid: typedef u64

codes: data { 9 10 200 } out intdata u8
verbs: data { "build" "run" } out stringdata
halves: data { 0.5 0.25 } out floatdata f32
marks: data { a: 9 b: 10 c: 11 } out (intdata u8 i: nid)

# every element of a block of bytes, summed
total: function {c: intdata u8} out u64 is {
    t: 0.u64
    for each x: c loop t = t + x.u64
    return t
}

# the element of a nid-indexed block at `k`
pick: function {c: (intdata u8 i: nid) k: nid} out u8 is {
    return (c.index i: k)
}

main: function is {
    print "\{codes.index i: 1} \{codes.length} \{verbs.index i: 1} \{halves.index i: 0}"
    v: codes
    k: 2
    print "\{total c: v} \{v.index i: k.u64.orPanic}"
    m: nid 2
    print "\{marks.index i: m} \{pick c: marks k: (nid 1)}"
}
