# `takex` AND `holdx` ARE ORDINARY MEMBER NAMES. The language reserved them
# in member position for as long as they were return markers; a result that
# keeps its inputs locked is declared `outx` now, the markers are gone, and
# the reservation went with them -- a type can declare members called `takex`
# and `holdx`, which is what an API about taking and holding wants to call
# its own methods.
Ledger: class {
    # what has been taken so far
    taken: i64
    # what is held back
    kept: i64
} as {
    # take `n` more
    takex: function {:this n: i64} is { this.taken = this.taken + n }
    # hold `n` back
    holdx: function {:this n: i64} is { this.kept = this.kept + n }
}

report: function {l: Ledger.view} is {
    print "  taken=\{l.taken} kept=\{l.kept}"
}

main: function is {
    l: Ledger taken: 0 kept: 0
    report l: l
    l.takex n: 3
    report l: l
    l.holdx n: 2
    report l: l
}
