# needs_in_method.z -- a native whose runtime fragment is reached ONLY inside a
# type method. Method bodies are written after the runtime pass, so the demand
# they raise arrives late; the fragment must still load, ahead of the method
# that calls it. String `+` (its row's `needs=concat`) is used nowhere else
# here, in a class method and in a record method.

# joins its own text to another
Joiner: class {
    # the left half of every join
    left: String
} as {
    # the two texts end to end
    join: function {t: this.view right: StringView} out String is {
        return t.left + right
    }
}

# a value whose method concatenates
tally: record {
    # how many marks to add
    n: i64
} as {
    # the text with one mark appended
    label: function {t: this.view s: StringView} out String is {
        return s + "!"
    }
}

main: function is {
    j: Joiner left: "ab".string
    print (j.join right: "cd")
    p: tally n: 1
    print (p.label s: "hi")
}
