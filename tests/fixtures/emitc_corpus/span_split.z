# span_split.z -- a window split into two disjoint windows, both written at once:
# through each half in turn, as two arguments of one call, and by copying one
# half over the other. A half splits again, and a split at either end leaves
# one half empty.

# add `x`'s elements into `z`'s, word by word
addInto: function {z: (SpanVal u64).borrow x: (SpanVal u64).view} is {
    i: 0.u64
    for i < z.length loop {
        z.set :i item: (z.get :i) + (x.get :i)
        i = i + 1
    }
}

main: function is {
    buf: ListVal u64
    for each n: 6.u64.times loop buf.append from: n + 1
    {
        w: buf.mutView
        p: w.split at: 3
        p.lo.set i: 0 item: 10
        p.hi.set i: 0 item: 40
        addInto z: p.lo x: p.hi
        print "lo \{p.lo.get i: 0} \{p.lo.get i: 1} \{p.lo.get i: 2} hi \{p.hi.length}"
        p.hi.copyFrom from: p.lo.listView
        q: p.lo.split at: 1
        q.hi.fill item: 0
        print "inner \{q.lo.length} \{q.hi.length}"
    }
    print "buf \{buf.get i: 0} \{buf.get i: 1} \{buf.get i: 2} \{buf.get i: 3} \{buf.get i: 4} \{buf.get i: 5}"
    {
        w: buf.mutView
        e0: w.split at: 0
        print "at 0: \{e0.lo.length} \{e0.hi.length}"
    }
    {
        w: buf.mutView
        e6: w.split at: 6
        print "at 6: \{e6.lo.length} \{e6.hi.length}"
    }
}
