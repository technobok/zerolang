# A GENERIC SUM'S TAG ACCESSOR IS ITS INSTANCES'. `k: u8.tag` in the `as` block
# of a generic variant or union exposes each instance's arm ordinal as `x.k`,
# read directly, through an alias or in the template's own method; and the
# storage the block declares (`u16.tag`) is the instance's. It used to be
# "type 'slot_i64' has no member 'k'", and the instance's tag was a u8.
slot: variant {
    full: t
    empty: null
} as {
    t: anyval.generic
    k: u8.tag
    kind: function {s: this} out u8 is {
        return s.k
    }
}

wide: variant {
    full: t
    empty: null
} as {
    t: anyval.generic
    k: u16.tag
}

Cellu: union {
    full: T
    empty: null
} as {
    T: AnyRef.generic
    k: u16.tag
    kind: function {c: this} out u16 is {
        return c.k
    }
}

SI: (slot t: i64)

main: function is {
    s: (slot t: i64).full 4
    e: SI.empty
    print "\{s.k} \{e.k} \{s.kind} \{e.kind}"
    w: (wide t: f64).empty
    print "\{w.k}"
    a: (Cellu T: String).full "x".string
    b: (Cellu T: String).empty
    print "\{a.kind} \{b.kind} \{a.k} \{b.k}"
}
