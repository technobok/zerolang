# An append whose interpolation reads the receiver itself keeps the String it
# builds: every part is read before the receiver changes, so `buf` appears
# with its old text, as written. A part reached through a field of the
# receiver's own path reads it too.
Box: class {
    name: String
}

main: function is {
    buf: "ab".string
    buf.append "<\{buf}>"
    print buf
    b: Box name: "x".string
    b.name.append "(\{b.name}|\{b.name})"
    print b.name
}
