# A source name spelled like a checker temporary (`_t0`, `_t1`) is an ordinary
# local: the temporaries beside it -- a call's result read for a field, an
# argument hoisted for a call -- are other variables, and each is freed once.
Box: class {
    s: String
}

mk: function {k: u64} out Box is {
    return (Box s: "abc\{k}")
}

size: function {b: Box} out u64 is {
    return b.s.length
}

main: function is {
    _t0: mk k: 1
    _t1: "user".string
    n: (mk k: 22).s.length
    m: size b: (mk k: 333)
    print "\{_t0.s} \{_t1} \{n} \{m}"
}
