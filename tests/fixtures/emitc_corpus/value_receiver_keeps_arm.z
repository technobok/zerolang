# A method called on a value -- an `if`, a `match`, a `with` -- runs on the arm
# that ran. A result that views an owned value keeps that value alive while the
# result lives: the value is an unnamed local of the caller's.
Doc: class {
    s: String
} as {
    addFrom: function {:this o: Doc.view} is {
        this.s.append o.s.stringView
    }
    look: function {t: this.view k: u64} outx StringView is {
        return (t.s.substring from: k to: t.s.length)
    }
}

Mode: variant {
    one: null
    two: null
}

writes: function {a: Doc.borrow b: Doc.borrow c: bool} is {
    x: Doc s: "yz".string
    (if c then a else b).addFrom o: x
    (with q: a do q).addFrom o: x
}

views: function {a: Doc.view b: Doc.view c: bool m: Mode} is {
    v: (if c then a else b).look k: 1
    print v
    w: (match (m) case one then a case two then b).look k: 0
    print w
}

owned: function {c: bool} is {
    n: (if c then (Doc s: "owned".string) else (Doc s: "o".string)).look k: 2
    print n
    k: (if c then "abc".string else "d".string).length
    print "\{k}"
    o: (with q: (Doc s: "own".string) do q).look k: 1
    print o
}

main: function is {
    a: Doc s: "abc".string
    b: Doc s: "x".string
    writes a: a.borrow b: b.borrow c: true
    print a.s
    views :a :b c: true m: Mode.two
    owned c: true
}
