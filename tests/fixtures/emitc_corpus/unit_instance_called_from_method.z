# A method may call a function of a generic unit's instance. Methods are
# written ahead of the unit's functions, so an instance's functions are
# declared with the other forward declarations; they were not, and the call
# reached the C compiler before any declaration of its callee.
scaler: unit as {
    t: anyval.generic
    # v doubled
    twice: function {v: t} out t is { return v + v }
    # v tripled
    thrice: function {v: t} out t is { return v + v + v }
}

isc: (scaler t: i64)

Box: class {
    v: u8
} as {
    # 4 tripled, through the instance
    tri: function {:this} out i64 is { return (isc.thrice 4) }
}

main: function is {
    b: Box v: 1
    print "\{isc.twice 2} \{b.tri}"
}
