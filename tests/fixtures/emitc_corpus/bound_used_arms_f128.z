# An f128 instance of a `wide` bound uses the f128 arm, so the program reaches
# quadfloat and links libquadmath (bound_used_arms: an f64 instance does not).
wide: variant { :f64  :f128 }

twice: function as { t: wide.generic } in {x: t} out t is {
    return x + x
}

main: function is {
    print "\{twice x: 1.5.f128}"
}
