# tail_block_hands_return_position -- a bare block as a function's last line hands
# return position to its own last line: the block's value is the function's result, and
# the locals of both scopes are destroyed at that return.
mk: function {n: i64} out String is {
    return "s\{n}"
}

tailDo: function {n: i64} out i64 is {
    a: mk :n
    {
        b: mk n: n + 1
        print "\{a} \{b}"
        n * 2
    }
}

tailDoReturns: function {n: i64} out String is {
    a: mk :n
    {
        b: mk n: n + 1
        if n > 5 then return b
        a
    }
}

main: function is {
    print "\{tailDo n: 3}"
    print "\{tailDoReturns n: 3}"
    print "\{tailDoReturns n: 7}"
}
