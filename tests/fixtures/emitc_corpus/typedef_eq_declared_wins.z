# A typedef record's `!=` is the `==` it declares, negated -- not the base
# type's comparison. `parity` calls two ids equal when their low bit matches,
# which disagrees with a raw u64 compare on purpose: 1 and 3 are equal here and
# different underneath, so an inequality that chased past the declaration to
# the base would print the opposite answer and still exit 0.
parity: record {
    val: u64.typedef
} as {
    ==: function {:this rhs: parity} out bool is {
        return (this.u64 % 2) == (rhs.u64 % 2)
    }
}

main: function is {
    a: parity.create from: 1
    b: parity.create from: 3
    c: parity.create from: 2
    print "1==3 (same parity): \{a == b}"
    print "1!=3 (same parity): \{a != b}"
    print "1!=2 (differs): \{a != c}"
}
