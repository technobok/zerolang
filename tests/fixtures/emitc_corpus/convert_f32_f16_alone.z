# convert_f32_f16_alone -- an f32 narrowed to f16, the program's only f16
# conversion. Its row needs the f32 helper and no other: where the C compiler
# has _Float16 that helper is a cast, and a helper written beside it that
# nothing calls is dead C (clang reports it unused).

# kindOf -- the name of a conversion's error
kindOf: function {e: converror} out String is {
    k: "outOfRange".string
    match e case outOfRange then null case precisionLoss then k = "precisionLoss".string
    return k
}

# narrow -- `x` narrowed to f16: its bits, or the error
narrow: function {x: f32} out String is {
    r: x.f16
    s: String
    match (
        r
    ) case ok then {
        s = "\{r.bits}"
    } case err then {
        s = kindOf e: r
    }
    return s
}

main: function is {
    print "1.5 \{narrow x: 1.5.f32} 65504 \{narrow x: 65504.0.f32} 0.1 \{narrow x: 0.1.f32}"
    print "65520 \{narrow x: 65520.0.f32} 1e-8 \{narrow x: 0.00000001.f32}"
}
