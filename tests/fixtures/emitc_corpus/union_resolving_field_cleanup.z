# A CLASS FIELD OF A UNION STILL BEING RESOLVED GIVES THE CLASS A DESTRUCTOR.
# `main` reads `U.n` first, so U is resolved first: its arm `a: A` resolves A,
# whose field `u: U` asks whether U needs cleanup while U is still resolving.
# A union's destructor is known only at its end, and one with a payload arm
# owns that payload, so the field needs cleanup (fieldTypeNeedsCleanup's
# still-resolving leg). The same through a typedef of a union (`W` over `V`).
# Answered "no", A and Box had no destructor, and `outer` and `bo` leaked what
# their union field held.
U: union {
    a: A
    n: null
}

A: class { u: U k: i64 }

W: typedef V

V: union {
    b: Box
    n: null
}

Box: class { w: W k: i64 }

main: function is {
    u: U.n
    v: V.n
    inner: A u: U.n k: 1
    outer: A u: U.a inner.take k: 3
    bi: Box w: W V.n k: 4
    bo: Box w: W (V.b bi.take) k: 5
    print "\{outer.k} \{bo.k} \{u.n} \{v.n}"
}
