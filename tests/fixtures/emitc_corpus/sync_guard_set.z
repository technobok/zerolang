# sync_guard_set.z -- a writing guard's `set` replaces the whole value a lock
# holds and answers the one it held, which the caller then owns: over a Mutex
# of lists, and an RwLock's write guard, whose old list is dropped unread.

main: function is {
    m: (sync.Mutex (ListVal i64)).create value: (ListVal i64)
    {
        g: m.lock
        g.value.append 1
        old: g.set value: (ListVal i64)
        g.value.append 2
        g.value.append 3
        print "old held \{old.length}, now \{g.value.length}"
    }
    rw: (sync.RwLock (ListVal i64)).create value: (ListVal i64)
    {
        w: rw.write
        w.value.append 9
        w.set value: (ListVal i64)
    }
    r: rw.read
    print "rw holds \{r.value.length}"
}
