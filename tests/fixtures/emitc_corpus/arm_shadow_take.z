# an if-arm defines its own owned `x` shadowing an outer owned `x`, and takes
# the INNER one; the outer x is untouched and still usable after the if.
Box: class {
    n: i64
}
main: function is {
    x: (Box n: 1)
    cond9: true
    if cond9 then {
        x: (Box n: 2)
        y: x.take
        print "\{y.n}"
    }
    print "\{x.n}"
}
