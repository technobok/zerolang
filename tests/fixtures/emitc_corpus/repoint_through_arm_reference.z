# repoint_through_arm_reference.z -- a borrowed name re-pointed, in an arm, at
# a reference the arm declares borrows what that reference borrows: the
# reference owns nothing and dies with the arm, the element it views does not.
# Two scopes down, and through a reference to a reference, alike.
pick: function {s: String.view} outx String.view is {
    return s
}

main: function is {
    o: "other".string
    xs: List String
    xs.append "abc def".string
    k: xs.length > 0
    r: pick s: o
    if k then {
        t: xs.get i: 0
        r = t
    }
    print r
    q: pick s: o
    if k then {
        t2: xs.get i: 0
        if k then {
            u: pick s: t2
            q = u
        }
    }
    print q
    w: pick s: o
    with h: (xs.get i: 0) do {
        w = h
    }
    print w
}
