# The family names are the real templates: ListRef / SetRef / MapRR are the
# collections declarations, and List / Set / Map are their core aliases. Both
# spellings resolve to one template, so both construct, populate and iterate
# the same monos.
main: function is {
    xs: (ListRef String)
    xs.append "a".string
    ys: (List String)
    ys.append "b".string
    for each v: xs loop print "ref \{v}"
    for each w: ys loop print "alias \{w}"
    s: (SetRef String)
    s.add "k".string
    print "s \{s.length}"
    m: (MapRR String V: String)
    m.set key: "k".string value: "v".string
    for each e: m.iterateItems loop print "m \{e.key}=\{e.value}"
}
