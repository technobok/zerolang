# The family names are the real templates: ListRef / SetRef / MapRR are the
# collections declarations, and List / Set / Map are their core aliases. Both
# spellings resolve to one template, so both construct, populate and iterate
# the same monos.
main: function is {
    xs: (ListRef String)
    xs.append "a".string
    ys: (List String)
    ys.append "b".string
    with it: xs.iterate do for v: it loop print "ref \{v}"
    with jt: ys.iterate do for w: jt loop print "alias \{w}"
    s: (SetRef String)
    s.add "k".string
    print "s \{s.length}"
    m: (MapRR String value: String)
    m.set key: "k".string value: "v".string
    with mt: m.iterateItems do for e: mt loop print "m \{e.key}=\{e.value}"
}
