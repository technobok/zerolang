# `T src.borrow` on a typedef is a second name for `src`, locked exclusively
# while it lives: a write through it reaches the source, and it frees nothing.
# `T.create from: src.borrow` is the same projection. A source that is itself a
# view a call returned has no storage to name and is copied.
grow: function {xs: ListVal u8} is {
    b: Bytes xs.borrow
    b.append from: 9
}

main: function is {
    xs: ListVal u8
    xs.append from: 1
    {
        b: Bytes xs.borrow
        b.append from: 2
        print "through=\{b.length}"
    }
    {
        v: Bytes.create from: xs.borrow
        v.append from: 3
    }
    grow :xs
    print "source=\{xs.length}"
    s: "abc".string
    {
        p: Path s.borrow
        print "path=\{p.length}"
    }
    s.append "d"
    bb: Bytes
    bb.append from: 65
    lv: bb.listView
    bv: ByteView lv.borrow
    cv: ByteView bb.listView
    print "after=\{s.length} view=\{bv.length} \{cv.length}"
}
