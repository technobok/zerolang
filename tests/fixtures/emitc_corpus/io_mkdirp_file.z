# io_mkdirp_file.z -- mkdirp makes a path a directory, or says why it cannot:
# a path that is already a directory is fine, one that is a file is `exists`,
# and one under a file is `notdir`.

report: function {what: StringView r: (Result null E: IoError).view} is {
    match (
        r
    ) case ok then print "\{what}: ok" case err then {
        match (
            r
        ) case exists then {
            print "\{what}: exists"
        } case notdir then {
            print "\{what}: notdir"
        } else print "\{what}: another error"
    }
}

main: function is {
    made: io.mkdirp path: "z_mkdirp_dir/inner"
    report what: "a new tree" r: made
    again: io.mkdirp path: "z_mkdirp_dir/inner"
    report what: "the same tree again" r: again
    w: io.writeText path: "z_mkdirp_file" content: "x"
    match (w) case ok then null case err then print "writeText failed"
    onfile: io.mkdirp path: "z_mkdirp_file"
    report what: "a file" r: onfile
    under: io.mkdirp path: "z_mkdirp_file/inner"
    report what: "under a file" r: under
    io.removeTree path: "z_mkdirp_dir"
    gone: io.remove path: "z_mkdirp_file"
    match (gone) case ok then null case err then print "remove failed"
}
