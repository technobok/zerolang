# the shared locks on a read's path PREFIXES are intent, not a live read of the
# whole subtree, so a sibling of the read path stays writable
Outer: class {
    items: (ListVal i64)
    tag: i64
}
main: function is {
    o: (Outer items: (ListVal i64) tag: 0)
    o.items.append 5
    e: o.items.get i: 0
    o.tag = 7
    print "\{e} \{o.tag}"
}
