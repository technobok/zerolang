# An append of an interpolation whose parts only read -- literals, and chains
# of field reads off a variable -- writes each part straight into the
# receiver, in the order written, with no String of its own. The receiver may
# be a local, a field of a local, a field reached through a class parameter,
# or a borrowed String parameter; a part may be a number, a bool, a String, a
# view of another String, or a field of the receiver's own object that is not
# the receiver itself. Run under ASan and UBSan.
pt: record {
    x: i64
    y: i64
}

# Box -- a name and a count
Box: class {
    name: String
    n: i64
    lit: bool
}

# tag -- `<k>` appended to the caller's String
tag: function {s: String k: i64} is {
    s.append "<\{k}>"
}

# label -- the box's count and flag appended to its own name
label: function {b: Box} is {
    b.name.append "[\{b.n} \{b.lit}]"
}

main: function is {
    buf: String
    k: 7
    p: pt x: 1 y: 2
    buf.append "<\{k}:\{p.x},\{p.y}>"
    tag s: buf k: 3
    other: "other".string
    v: other.stringView
    buf.append " \{other}/\{v}"
    b: Box name: "box".string n: 4 lit: true
    label :b
    b.name.append "!\{b.n}"
    print buf
    print b.name
}
