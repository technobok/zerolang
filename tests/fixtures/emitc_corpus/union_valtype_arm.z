# Every union arm's payload lives in a heap cell the union owns, so an arm
# holds a value type as it holds a reference type: `num: i64` and `p: pt` are
# the value in its cell, exactly as `(Box i64)` and `(Box pt)` spell (the Box
# collapses to its element). A plain union refused the bare spelling ("box the
# valtype") while a generic union's `leaf: t` with t = i64 was accepted; both
# take it now (user decision 2026-09-26). An array, a sized string and a
# qualified name are value types too.
row: record {
    n: i64
}

pt: record { x: i64 }

Shape: union {
    many: (array t: row to: 2)
    text: (str to: 8)
    num: core.i64
    p: pt
    boxed: (Box pt)
    s: String
    none: null
}

show: function {s: Shape.view} out i64 is {
    match (
        s
    ) case many then return 1 case text then return 2 case num then return s case p then {
        return s.x
    } case boxed then return s.x + 100 case s then return 9 case none then return 0
}

main: function is {
    a: Shape.num 5
    b: Shape.p (pt x: 7)
    c: Shape.boxed (pt x: 8)
    d: Shape.s "x".string
    e: Shape.none
    b = Shape.p (pt x: 6)
    print "\{show s: a} \{show s: b} \{show s: c} \{show s: d} \{show s: e}"
}
