# A union arm's layout is what its declaration writes. A bare value-type arm
# is stored in the union's pointer-wide slot -- `num: i64` and `p: pt`, eight
# bytes each, need no heap cell -- and `(Box pt)` is a cell whatever the size.
# A bare arm wider than the slot is refused; the 16-byte array and the 9-byte
# `str 8` here are written `(Box ...)` for that. An array, a sized string and a
# qualified name are value types too.
row: record {
    n: i64
}

pt: record { x: i64 }

Shape: union {
    many: (Box (array t: row to: 2))
    text: (Box (str to: 8))
    num: core.i64
    p: pt
    boxed: (Box pt)
    s: String
    none: null
}

show: function {s: Shape.view} out i64 is {
    match (
        s
    ) case many then return 1 case text then return 2 case num then return s case p then {
        return s.x
    } case boxed then return s.x + 100 case s then return 9 case none then return 0
}

main: function is {
    a: Shape.num 5
    b: Shape.p (pt x: 7)
    c: Shape.boxed (pt x: 8)
    d: Shape.s "x".string
    e: Shape.none
    b = Shape.p (pt x: 6)
    f: Shape.text ("abc".str to: 8)
    print "\{show s: a} \{show s: b} \{show s: c} \{show s: d} \{show s: e} \{show s: f}"
}
