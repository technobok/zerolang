# bare_local_bind_move.z -- a bare bind of an owned local is a MOVE, exactly as a
# reassignment from one is: the binding takes the heap and the source is zeroed,
# so its scope-exit destroy no-ops. Covers a String local, a class local with a
# heap field, and a move that happens inside a branch.
Holder: class {
    text: String
}

mkText: function {} out String is {
    s: "payload".string
    return s
}

main: function is {
    a: mkText
    b: a
    print "string=\{b}"

    h: Holder text: "held".string
    g: h
    print "class=\{g.text}"

    c: mkText
    if c.length > 0 then {
        d: c
        print "branch=\{d}"
    }
    print "done"
}
