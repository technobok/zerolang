# bare_local_bind_move.z -- `b: a.take` over an owned local is a MOVE, exactly
# as a reassignment from one is: the binding takes the heap and the source is
# zeroed, so its scope-exit destroy no-ops. Covers a String local, a class local
# with a heap field, and a move that happens inside a branch. Written bare the
# same line BORROWS -- see binding_borrows_by_default.
Holder: class {
    text: String
}

mkText: function {} out String is {
    s: "payload".string
    return s
}

main: function is {
    a: mkText
    b: a.take
    print "string=\{b}"

    h: Holder text: "held".string
    g: h.take
    print "class=\{g.text}"

    c: mkText
    if c.length > 0 then {
        d: c.take
        print "branch=\{d}"
    }
    print "done"
}
