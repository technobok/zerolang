# StringView.fastHash: the same bytes hash the same within a run, whatever
# view they arrive through. The value itself is seeded per process, so only
# comparisons are printed.
main: function is {
    s: "interned"
    owned: "inter".string
    owned.append "ned"
    print "\{s.fastHash == owned.stringView.fastHash}"
    print "\{s.fastHash == "intern".fastHash}"
}
