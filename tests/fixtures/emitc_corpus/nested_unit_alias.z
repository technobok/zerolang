# nested_unit_alias.z -- a re-export written INSIDE an inline unit. The alias
# is a member of the unit it is written in, so it registers on that unit's own
# id; keying it on the file-unit name index instead put it nowhere an inline
# unit could be reached through, and `inner.T` reported no such member.
inner: unit {
    T: xunit_nestalias.Thing
    M: xunit_nestalias.MAX
}

main: function is {
    v: inner.T n: 7
    print "inner.T.n=\{v.n} inner.M=\{inner.M}"
}
