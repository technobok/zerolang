# or_default_evaluated -- `.or d:` is a call, and a call evaluates every
# argument: its default runs whichever arm the result or option holds, after
# the receiver. Each `note` call prints, so the output shows each one that ran.

# note -- `v` after printing it: a default whose evaluation shows
note: function {v: u16} out u16 is {
    print "evaluated \{v}"
    return v
}

# first -- the first item of `xs`, or none
first: function {xs: (ListVal u16).view} out optionval u16 is {
    if xs.length == 0 then return (optionval t: u16).none
    return (optionval.some (xs.get i: 0))
}

main: function is {
    big: 70000.i32
    small: 3.i32
    print "err: \{big.u16.or d: (note v: 9)}"
    print "ok: \{small.u16.or d: (note v: 8)}"
    print "literal: \{small.u16.or d: 7}"
    xs: ListVal u16
    print "none: \{(first :xs).or d: (note v: 6)}"
    xs.append 5
    print "some: \{(first :xs).or d: (note v: 4)}"
}
