# generic_unit_view_return -- a generic unit's function returning a view of its
# argument (`outx String.view`), called through the unit's instance: the
# instance's copy returns the view as the template declares, and the result
# reads its source while the source lives.
public: unit {
    :main
}

# wrap -- a labelled item over any value, and a view of its label
wrap: unit as {
    t: anyval.generic
    # Item -- a label and a value
    Item: class {
        label: String
        n: t
    }
    # peek -- the item's label, read in place
    peek: function {it: Item.view} outx String.view is {
        return it.label
    }
}
w: (wrap t: i64)

main: function is {
    e: w.Item label: "echo".string n: 1
    s: w.peek it: e
    print "\{s} \{s.length}"
}
