# generator_hidden_subunit.z -- a generator in a unit that also owns a hidden
# subunit. Demanding the subunit resolves it mid-drain, and the stamp pass that
# runs then must not report the generator's class as an unknown type while its
# declaration is still queued: the type-ref stamps on a later pass, once the
# class has resolved.
Cell: impl.Cell

Lits: generator as {
    call: function out String is {
        yield "alpha".string
        yield "beta".string
    }
}

main: function is {
    for s: Lits loop print "s: \{s}"
    c: Cell v: 3
    print "cell \{c.v}"
}
