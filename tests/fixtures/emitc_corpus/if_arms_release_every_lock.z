# if_arms_release_every_lock -- A lock every arm of an exhaustive `if` released is
# released after it, and that holds for each lock the arms released, not only the first:
# both borrows are re-pointed in both arms, so both sources are writable again after the
# `if`.
f: function {sel: bool} is {
    m1: "one".string
    m2: "two".string
    o1: "x".string
    o2: "y".string
    o3: "z".string
    o4: "w".string
    b1: m1
    b2: m2
    if sel then {
        b1 = o1
        b2 = o2
    } else {
        b1 = o3
        b2 = o4
    }
    m1.append "!"
    m2.append "?"
    print "\{m1} \{m2} \{b1} \{b2}"
}

main: function is {
    f sel: true
    f sel: false
}
