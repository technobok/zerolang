# A listener that accepts but never talks: the accepted Conn is the program's
# only Conn, and it alone loads the Conn natives its conformance names. Nobody
# connects, so the accept is never reached at run time.
main: function is {
    lr: net.listen port: 49333
    match (
        lr
    ) case ok then {
        pr: net.pollReadable fd: lr.fd timeoutMillis: 0
        match (
            pr
        ) case ok then {
            if pr then {
                ar: lr.accept
                match ar case ok then print "accepted" case err then print "accept failed"
            } else {
                print "nobody waiting"
            }
        } case err then print "poll failed"
        cl: lr.close
        match cl case ok then print "closed" case err then print "close failed"
    } case err then {
        print "listen failed"
    }
}
