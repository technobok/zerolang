# a binding that borrows from a fresh value reached through a variable's
# path -- a List popped off a variable or off a field, a method's owned
# result -- keeps that value alive while it borrows, as a call's result is
# kept: the element is read after an unrelated allocation, and through a
# second borrow of the first.
Holder: class {
    lists: List (List String)
}
Maker: class {
    seed: String
} as {
    make: function {:this} out (List String) is {
        r: List String
        r.append from: this.seed.copy
        return r
    }
}
main: function is {
    grid: List (List String)
    grid.append from: (List String)
    (grid.getMut i: 0).append from: "popped-off-a-variable-and-long-enough-for-the-heap".string
    n: (grid.pop).get i: 0
    h: Holder lists: (List (List String))
    h.lists.append from: (List String)
    (h.lists.getMut i: 0).append from: "popped-off-a-field-and-long-enough-for-the-heap".string
    f: (h.lists.pop).get i: 0
    mk: Maker seed: "made-by-a-method-and-long-enough-for-the-heap".string
    k: (mk.make).get i: 0
    c: k
    x: "an-unrelated-allocation-that-could-reuse-a-freed-block".string
    print "\{n}"
    print "\{f}"
    print "\{c}"
    print "\{x} \{grid.length} \{h.lists.length}"
}
