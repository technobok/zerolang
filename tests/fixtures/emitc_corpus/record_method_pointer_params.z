# a record's or a variant's method takes a parameter the way a call passes it,
# as a class's method does: a List (of its own type or another), a borrowed
# String, a class and a `.view` record arrive by pointer.
Box: class {
    n: i64
}
pt: record {
    v: i64
}
point: record {
    x: i64
    y: i64
} as {
    total: function {a: this ps: ListVal point} out i64 is {
        t: a.x
        for p: ps.iterate loop {
            t = t + p.x
        }
        return t
    }
    len: function {a: this s: String} out u64 is {
        return s.length
    }
    plus: function {a: this b: Box q: pt.view} out i64 is {
        return a.x + b.n + q.v
    }
}
shape: variant {
    sq: i64
    rect: i64
} as {
    named: function {s: this label: String} out u64 is {
        return label.length
    }
}
main: function is {
    q1: point x: 7 y: 1
    ps: ListVal point
    ps.append from: (point x: 3 y: 4)
    s: "abcd".string
    b: Box n: 4
    q: pt v: 6
    sh: shape.sq 2
    print "\{q1.total ps: ps} \{q1.len s: s} \{q1.plus b: b q: q} \{sh.named label: s}"
}
