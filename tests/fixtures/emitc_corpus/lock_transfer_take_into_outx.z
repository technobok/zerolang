# A lock-holding value moved into an `outx` callee's `.take` parameter hands
# its locks to that call's result: the result now holds the value, and keeps
# what it pointed into locked.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

Pair: class {
    left: W
    tag: i64
}

wrap: function {w: W.take from: Src.borrow} outx Pair is {
    return (Pair left: w tag: from.n)
}

main: function is {
    a: Src n: 1
    b: Src n: 2
    {
        w: mk from: a
        p: wrap w: w from: b
        print "wrapped: \{p.left.s.n} \{p.tag}"
    }
    a.n = 5
    b.n = 6
    print "after: \{a.n} \{b.n}"
}
