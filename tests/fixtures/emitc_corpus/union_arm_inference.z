# A generic union's arm, constructed without the type's arguments, infers only
# the parameters its DECLARED payload names: a payload that is the parameter
# takes the value's type, and one that applies it (`(List T)`) takes the
# element's. It took the payload's type whole instead -- `Tree.node s` built
# `(Tree t: String)` from an arm holding no `t` -- and a null arm's argument
# skipped the parameter's bound. Each spelling below builds the instance a
# `(Tree t: i64)` / `(Bag T: String)` parameter asks for.
Tree: union { leaf: t node: String } as {
    t: anyval.generic
}

Bag: union { one: T many: (List T) } as {
    T: AnyRef.generic
}

Opt: union { some: t none: null } as {
    t: anyval.generic
}

show: function {x: (Tree t: i64)} is {
    if x.leaf then print "leaf \{x}" else print "not a leaf"
}

size: function {b: (Bag T: String)} out u64 is {
    if b.many then return b.length
    return 1
}

isNone: function {o: (Opt t: i64)} out bool is {
    return o.none
}

main: function is {
    # the payload is the parameter
    show x: (Tree.leaf 5)
    # the arm holds no `t`: the type's arguments are written
    show x: ((Tree t: i64).node "written".string)
    # the payload applies the parameter: T is the list's element
    xs: List String
    xs.append "a".string
    xs.append "b".string
    print "many \{size b: (Bag.many xs.take)}"
    print "one \{size b: (Bag.one "solo".string)}"
    # a null arm: its argument names the type
    print "none \{isNone o: (Opt.none i64)}"
    print "some \{isNone o: (Opt.some 3)}"
}
