# `array.get` reads an element back. The instance's `get` is the template's
# method cloned for the instance, so its `t: this.view` receiver is known as a
# receiver and supplied by the dot. A hand-built replacement that carried only a
# return type dropped that, and every read was refused as "missing required
# argument 't'" -- bound, interpolated, as an operand, through a field or a
# parameter, and in a generic function alike. Only `set` worked, because its
# receiver is spelled `:this`.
#
# The index is a u64: a position is a COUNT from the start, like `length`, and
# `pick` below takes one so a caller's index crosses a function boundary as the
# type the array indexes with.
holder: record {
    arr: (array t: i64 to: 4)
}

Box: class {
    arr: (array t: u8 to: 4)
}

sum: function {a: (array t: i64 to: 3)} out i64 is {
    return (a.get i: 0) + (a.get i: 1) + (a.get i: 2)
}

pick: function {a: (array t: i64 to: 3) i: u64} out i64 is {
    return (a.get :i)
}

first: function as { t: anyval.generic } in { a: (array t: t to: 2) } out t is {
    return (a.get i: 0)
}

main: function is {
    a: (array t: i64 to: 3)
    i: 0.u64
    # the index counts in u64 and the element is an i64: the two are separate
    # counters because they are separate types, which is the point of the change
    v: 10
    for i < 3 loop {
        a.set :i item: v
        i = i + 1
        v = v + 10
    }
    bound: a.get i: 1
    paren: (a.get i: 2)
    print "bound=\{bound} paren=\{paren} inline=\{a.get i: 0}"
    print "sum=\{sum :a} pick=\{pick :a i: 2}"

    old: a.set i: 0 item: 5
    print "set returned \{old}, now \{a.get i: 0}"

    h: (holder arr: (array t: i64 to: 4))
    h.arr.set i: 3 item: 9
    hv: h.arr.get i: 3
    print "record field \{hv} \{h.arr.get i: 3}"

    b: (Box arr: (array t: u8 to: 4))
    b.arr.set i: 1 item: 200
    print "class field \{b.arr.get i: 1}"

    flags: (array t: bool to: 2)
    flags.set i: 1 item: true
    if (flags.get i: 1) then print "flag set"

    f: (array t: f64 to: 2)
    f.set i: 0 item: 1.5
    x: (f.get i: 0) + 2.0
    print "f64 \{x}"

    u: (array t: u32 to: 2)
    u.set i: 0 item: 11
    print "generic \{first a: u}"
}
