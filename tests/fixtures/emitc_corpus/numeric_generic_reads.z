# A NUMERIC GENERIC PARAMETER IS A COMPILE-TIME CONSTANT OF EACH MONO, read
# bare in the template, through a name of the instance (`B8.cap`,
# `(Buffer cap: 3).cap`), and through a unit instance. A bare read was "Unknown
# reference", a read through an instance reached the emitter unhandled, a
# generic function could not name its own parameter, and a unit instance had
# "no member". A value reaches only its type's fields and methods
# (errors/numeric_param_error_through_value).
consume: function {n: u32} out u32 is {
    return n + 100
}

Buffer: class {
    used: u32
    get: function {:this} out u32 is {
        return cap
    }
    plus: function {:this} out u32 is {
        return cap + 1
    }
    doubled: function {:this} out u32 is {
        return cap * 2
    }
    big: function {:this} out bool is {
        return cap > 4
    }
    bound: function {:this} out u32 is {
        x: cap
        y: x + cap
        return y
    }
    passed: function {:this} out u32 is {
        return (consume n: cap)
    }
    text: function {:this} out String is {
        return "cap=\{cap} twice=\{cap * 2}"
    }
    pick: function {:this} out u32 is {
        if cap > 4 then {
            return 1
        } else {
            return 0
        }
    }
} as { cap: u32.generic }

rep: function as { n: i64.generic } in { v: i64 } out i64 is {
    return v * n
}

sized: unit as {
    cap: i64.generic
    twice: function {} out i64 is {
        return cap * 2
    }
}

four: (sized cap: 4)
B8: (Buffer cap: 8)

main: function is {
    a: (Buffer cap: 8) used: 0
    b: (Buffer cap: 3) used: 0
    print "\{a.get} \{a.plus} \{a.doubled} \{a.big} \{a.bound} \{a.passed} \{a.pick}"
    print "\{b.get} \{b.plus} \{b.doubled} \{b.big} \{b.bound} \{b.passed} \{b.pick}"
    print "\{a.text}"
    print "\{b.text}"
    print "\{B8.cap} \{(Buffer cap: 3).cap} \{B8.cap + (Buffer cap: 3).cap}"
    print "\{rep n: 3 v: 4} \{rep n: -2 v: 4}"
    print "\{four.twice} \{four.cap}"
}
