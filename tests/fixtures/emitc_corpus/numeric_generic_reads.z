# A NUMERIC GENERIC PARAMETER IS A COMPILE-TIME CONSTANT OF EACH MONO, read
# bare in the template, through `this` or any value of the type, and through a
# unit instance. A bare read was "Unknown reference", `this.cap + 1` and a
# class instance's `b.cap` reached the emitter unhandled, a generic function
# could not name its own parameter, and a unit instance had "no member".
take: function {n: u32} out u32 is {
    return n + 100
}

Buffer: class {
    used: u32
    get: function {:this} out u32 is {
        return cap
    }
    plus: function {:this} out u32 is {
        return cap + 1
    }
    viaThis: function {:this} out u32 is {
        return this.cap * 2
    }
    big: function {:this} out bool is {
        return cap > 4
    }
    bound: function {:this} out u32 is {
        x: cap
        y: x + this.cap
        return y
    }
    passed: function {:this} out u32 is {
        return (take n: cap)
    }
    text: function {:this} out String is {
        return "cap=\{cap} this=\{this.cap}"
    }
    pick: function {:this} out u32 is {
        if cap > 4 then {
            return 1
        } else {
            return 0
        }
    }
} as { cap: u32.generic }

rep: function as { n: i64.generic } in { v: i64 } out i64 is {
    return v * n
}

sized: unit as {
    cap: i64.generic
    twice: function {} out i64 is {
        return cap * 2
    }
}

four: (sized cap: 4)

main: function is {
    a: (Buffer cap: 8) used: 0
    b: (Buffer cap: 3) used: 0
    print "\{a.get} \{a.plus} \{a.viaThis} \{a.big} \{a.bound} \{a.passed} \{a.pick}"
    print "\{b.get} \{b.plus} \{b.viaThis} \{b.big} \{b.bound} \{b.passed} \{b.pick}"
    print "\{a.text}"
    print "\{b.text}"
    print "\{a.cap} \{b.cap} \{a.cap + b.cap}"
    print "\{rep n: 3 v: 4} \{rep n: -2 v: 4}"
    print "\{four.twice} \{four.cap}"
}
