# a method body calls an instance of a generic function declared AFTER its
# type: the instances are declared before any method body, for a class, a
# record, a generic class's method over its own parameter, and one template
# called from two types with two different instances.
Box: class {
    v: i64
} as {
    grow: function {h: this} out (ListVal t: i64) is {
        l: mk t: i64 a: h.v
        return l
    }
}
Cell: class {
    v: t
} as {
    t: anyval.generic
    grow: function {h: this} out (ListVal t: t) is {
        l: mk t: t a: h.v
        l.append from: h.v
        return l
    }
}
pt: record {
    x: i64
} as {
    twice: function {p: this} out i64 is {
        return (dbl t: i64 a: p.x)
    }
}
Small: class {
    w: u8
} as {
    same: function {h: this} out u8 is {
        return (pick t: u8 a: h.w)
    }
}
Wide: class {
    v: i64
} as {
    same: function {h: this} out i64 is {
        return (pick t: i64 a: h.v)
    }
}
mk: function as { t: anyval.generic } in { a: t } out (ListVal t: t) is {
    l: (ListVal t: t)
    l.append from: a
    return l
}
dbl: function as { t: anyval.generic } in { a: t } out t is {
    return a + a
}
pick: function as { t: anyval.generic } in { a: t } out t is {
    return a
}
main: function is {
    b: Box v: 2
    c: Cell t: i64 v: 5
    p: pt x: 4
    s: Small w: 3
    w: Wide v: 9
    print "\{b.grow.length} \{c.grow.length} \{p.twice} \{s.same} \{w.same}"
}
