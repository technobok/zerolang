# a method declaring `{t: this.view}` reads its receiver, so the call takes a
# SHARED receiver lock and composes with a live read of the same object --
# declared readonly-ness, with no name whitelist involved
Item: class {
    label: String
    value: i64
} as {
    peek: function {t: this.view} out i64 is {
        return t.value
    }
}
peek_label: function {b: Item.lock} out String.borrow is {
    return b.label
}
main: function is {
    e: Item label: "echo".string value: 5
    s: peek_label e
    print "\{e.peek} \{s}"
}
