        match (u) case c then return u.n + o case e then return o
    }
}
readF: function {v: Sh.view} out i64 is {
    match (v) case c then return v.n case e then return 0
}
useConfFn: function {r: Rd} out i64 is { return r.rdn }
useConfFnIn: function {r: Rd} out i64 is { return r.rdn }
ConfMeth: class { k: i64 } as {
    useIt: function {:this r: Rd} out i64 is { return r.rdn + this.k }
}
ConfMethQ: class { k: i64 } as {
    useIt: function {u: this.view r: Rd} out i64 is { return r.rdn + u.k }
}
ConfPk: protocol {
    pick: function {t: this.view r: Rd} out i64
}
ConfPC: class { k: i64 } as {
    :ConfPk
    pick: function {p: this.view r: Rd} out i64 is { return r.rdn + p.k }
}
ConfAcc: class { k: i64 } as {
    +: function {a: this.view r: Rd} out i64 is { return a.k + r.rdn }
}
ConfHB: class { r: Rd.borrow }
mkConfArm: function {k: i64} out Rd is {
    if k > 0 then return (Rd.create from: (Sh.c (Cell n: 105 s: "u".string)))
    return (Rd.create from: (Sh.c (Cell n: 1 s: "u".string)))
}
atConfLabel: function out i64 is {
    x: (Sh.c (Cell n: 63 s: "u".string))
