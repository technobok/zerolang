Rd: protocol {
    rdn: function {t: this.view} out i64
}
Cell: class { n: i64  s: String }
Sh: union { c: Cell  e: null } as {
    :Rd
    rdn: function {u: this.view} out i64 is { match (u) case c then return u.n case e then return 0 }
    getn: function {u: this.view} out i64 is {
        match (u) case c then return u.n case e then return 0
