# hoist_call_arg_bind -- a call result handed to a by-pointer parameter, in a
# binding of a collection: the temporary it is hoisted into must be declared
# before the line that takes its address. The emitter once declared it after.
public: unit { :main }
main: function is {
    src: "a: 1".string
    toks: tokenize.scan source: src.copy pool: zast.StringPool.create
    print "n=\{toks.length}"
}
