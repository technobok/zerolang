# drop_valtype.z -- `.drop` on an OWNED VALTYPE. The docs say it invalidates the
# name and has no runtime effect: no destructor call, no zeroing, because a
# valtype holds no heap. Every other `.drop` in the tree is on a class, a union
# or a borrow, so this is the leg nothing exercised.
#
# What this pins is that all three valtype families accept the marker and the
# program still runs correctly. The stronger claim -- that the emitted C is
# byte-identical to the same program without the drops -- is checked by hand
# (it is), not here: the corpus runner compiles a program, it does not diff one
# against a twin.
point: record {
    x: i64
    y: i64
}

shade: variant {
    red: null
    blue: null
}

main: function is {
    p: point x: 3 y: 4
    print "record \{p.x},\{p.y}"
    p.drop

    n: 7
    print "int \{n}"
    n.drop

    s: shade.blue
    print "variant \{s.blue}"
    s.drop

    print "done"
}
