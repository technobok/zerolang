# A NUMERIC GENERIC PARAMETER IS A COMPILE-TIME CONSTANT OF EACH INSTANCE, so
# a unit-level `if` inside the template folds per instance. It was refused as
# "'cap' has no compile-time value" (and, before that, accepted with the method
# returning the constant emitting `return i64;`).
box: unit {
    cap: i64.generic
    BIG: if cap > 4 then { 1 } else { 2 }
    size: function out i64 is {
        return BIG
    }
}

b8: (box cap: 8)
b2: (box cap: 2)

main: function is {
    print "\{b8.size} \{b2.size} \{b8.BIG} \{b2.BIG}"
}
