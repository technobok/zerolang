# cross_unit_explicit_create.z -- constructing another unit's class through
# the fully qualified three-segment create (`unit.Type.create args`): the
# emitter's explicit-create leg must match the LEFT-nested dotted shape.
main: function is {
    w: xunit_xcreate.Widget.create n: 5
    print "\{w.n}"
    p: xunit_xcreate.Pair.create a: 2 b: 3
    print "\{p.a + p.b}"
}
