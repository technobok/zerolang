# AN UNWRAP READS ITS RESULT ONCE. `r.orPanic` and `r.or d:` test the result's
# tag and then read its payload, so a receiver that is a call is read into a
# temporary first: each `mk` below prints once. A name is read where it is.

# mk -- prints, and answers v: a call with an effect
mk: function {v: i64} out i64 is {
    print "mk \{v}"
    return v
}

main: function is {
    a: (mk v: 5).u8.orPanic
    n: 7.i64
    b: n.u8.orPanic
    c: (mk v: 300).u8.or d: 9
    e: (mk v: 6).u8.or d: 0
    print "\{a} \{b} \{c} \{e}"
}
