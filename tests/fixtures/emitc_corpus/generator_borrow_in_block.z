# A generator's local that borrows a place is a pointer into it, and it may not
# be in scope at a yield (generator_borrow_across_yield) -- but one whose block
# closes before the next yield is an ordinary borrow. A view is a value, kept in
# the instance like any other local, so it may cross a suspension.
Block: generator as {
    call: function out u64 is {
        m: List String
        m.append "a".string
        k: 0.u64
        {
            b: m
            k = b.length
        }
        yield k
    }
}

View: generator as {
    call: function out u64 is {
        s: "hello".string
        v: s.stringView
        yield v.length
        w: v
        yield w.length + s.length
    }
}

main: function is {
    for a: Block loop print "block \{a}"
    for b: View loop print "view \{b}"
}
