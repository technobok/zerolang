# option_view_of_view_param -- an OptionView built `from:` a `.view` parameter:
# the parameter is a const pointer in C and the arm's slot a `void*`, so the
# view went in without its const and the C did not compile
public: unit {
    :main
}

# Counter -- one number
Counter: class {
    n: u32
}

# same -- the counter it was given, viewed
same: function {c: Counter.view} outx OptionView Counter is {
    return ((OptionView Counter).some from: c)
}

main: function is {
    c: Counter n: 7
    o: same :c
    match (
        o
    ) case some then print "\{o.n}" case none then print "none"
}
