# An owned protocol instance keeps its source's locks, so an `outx` function
# may answer one over what its parameter lends: the caller's list is locked
# while the instance lives and writable again after it.

# Shape -- something to look at
Shape: protocol {
    # the first element
    peek: function {t: this.view} out i64
}

# Peek -- looks at a list its owner keeps
Peek: class {
    # the borrowed list
    xs: (ListVal i64).borrow
} as {
    shape: Shape.implement
    peek: function {t: this.view} out i64 is { return (t.xs.get i: 0) }
}

# over -- a Shape over `a`
over: function {a: (ListVal i64).borrow} outx Shape is {
    return (Shape.create from: (Peek xs: a))
}

# overNamed -- the same through a local, by the bare-name form
overNamed: function {a: (ListVal i64).borrow} outx Shape is {
    p: Peek xs: a
    return (Shape p)
}

main: function is {
    b: ListVal i64
    b.append 9
    {
        t: over a: b
        print "\{t.peek}"
    }
    {
        t: overNamed a: b
        print "\{t.peek}"
    }
    b.append 10
    s: Shape.create from: (Peek xs: b)
    print "\{s.peek}"
}
