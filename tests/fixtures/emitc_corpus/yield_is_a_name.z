# yield_is_a_name.z -- `yield` is an ordinary identifier.
#
# This is the observable difference between a keyword and a compiler-provided
# function, and it did not parse before: `yield` was a token, so binding the
# name was a syntax error. It is now defined into scope only inside a generator
# body, exactly as `break` and `continue` are defined into a `for`, so
# everywhere else the name is the program's to use.
#
# Both halves are here on purpose: the generator below still suspends while a
# function two lines away binds `yield` to an integer.

counter: function {n: i64} out (Iterator Gives: i64) is {
    i: 0
    for i < n loop {
        yield i
        i = i + 1
    }
}

useName: function out i64 is {
    yield: 7
    return yield + 1
}

main: function is {
    for x: (counter n: 3) loop print "x: \{x}"
    print "name: \{useName}"
    print "done"
}
