# A construction's non-owned first field filled by the unlabelled argument is
# passed by address as a labelled one is: from a `.borrow` parameter, and from a
# local. Unlabelled, the struct itself was passed and the C was refused.
Src: class {
    n: i64
}

V: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Src.borrow} outx V is {
    return (V from tag: 1)
}

main: function is {
    a: Src n: 7
    b: Src n: 8
    v: mk from: a
    w: V b tag: 2
    print "\{v.s.n} \{v.tag} \{w.s.n} \{w.tag}"
}
