# A member exposed under a public name that is not its own, read from another
# unit (rename_xunit_lib). Every pass that asks WHICH member a path reads must
# answer with the member the name renames. Read by its written name, the
# String field bound here was not a reference into its owner and was freed
# twice; the arm predicate, a construction and a match arm did not narrow or
# were refused; the generic instance had no such members at all.
show: function {s: String.view} is {
    print "arg \{s}"
}

back: function {h: rename_xunit_lib.Holder.view} outx String.view is {
    return h.name
}

main: function is {
    h1: rename_xunit_lib.make
    n: h1.name
    print "\{n} \{h1.name}"
    h2: rename_xunit_lib.make
    m: "x \{h2.name}"
    print m
    show s: h2.name
    c: h2.name.copy
    print c
    h3: rename_xunit_lib.make
    l: h3.label
    print "\{l}"
    h4: rename_xunit_lib.make
    print "\{h4.label}"
    show s: h4.label
    print "count \{h4.count} add \{h4.add delta: 5} fn \{h4.fn x: 4}"
    i: 0
    for i < h4.count loop {
        i = i + 1
    }
    print "loop \{i} \{back h: h4}"
    h4.name = "world".string
    print "set \{h4.name}"
    s: rename_xunit_lib.mkShape
    if s.circle then print "circle \{s}" else print "box"
    match (s) case circle then {
        print "arm \{s}"
    } case box then print "b"
    u: (rename_xunit_lib.Shape.box 4)
    match (u) case circle then print "c" case box then print "box \{u}"
    match (u) case box then print "box again" else print "other"
    b: rename_xunit_lib.mkBox
    print "generic \{b.value} \{b.get}"
    print "greet \{rename_xunit_lib.greet}"
}
