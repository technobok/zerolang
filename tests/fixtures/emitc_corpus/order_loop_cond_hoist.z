# A loop's test runs at every iteration and a do-while's trailing test after
# every pass, so a temporary its argument needs is built and released there,
# each time. It used to be declared once, inside the body, after the header
# that read it -- C the compiler rejected. A local bound from a call before the
# loop keeps its temporary until the enclosing scope ends, `break` or not.
mks: function {n: i64} out String is {
    print "s\{n}"
    return "x\{n}"
}

lenv: function {a: String.view} out u64 is {
    return a.length
}

lt: function {a: u64 b: u64} out bool is {
    return a < b
}

Gen: generator as {
    call: function out u64 is {
        g: 0.u64
        for while (lt a: g b: (lenv a: (mks n: 9))) loop {
            yield g
            g = g + 1
        }
    }
}

main: function is {
    i: 0.u64
    for while (lt a: i b: (lenv a: (mks n: 1))) loop {
        i = i + 1
    }
    print "while ran to \{i}"
    j: 0.u64
    for loop {
        j = j + 1
    } while (lt a: j b: (lenv a: (mks n: 2)))
    print "do-while ran to \{j}"
    k: (lenv a: (mks n: 3))
    for k > 0 loop {
        k = k - 1
        if k == 0 then break
    }
    b: 0.u64
    for while (lt a: b b: (lenv a: (mks n: 4))) loop {
        b = b + 1
        if b == 1 then continue
        if b == 2 then break
    }
    print "break at \{b}"
    d: 0.u64
    for loop {
        d = d + 1
        if d == 1 then continue
        if d > 3 then break
    } while (lt a: d b: (lenv a: (mks n: 5)))
    print "do-while stopped at \{d}"
    for v: Gen loop {
        print "yielded \{v}"
    }
}
