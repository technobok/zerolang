# A custom tag's base is found as any written type is: the nearest declaration
# answers, whatever has demanded it so far.
#
# - `u8` below is the program's data block, not the system scalar: a variant
#   tagged `u8.tag` takes its values (b is 0, so falsy). Core answered.
# - a union in a nested unit takes the nested unit's `codes`, not the file
#   unit's (whose values run the other way): the tag was ignored outside the
#   main unit.
# - another unit's union takes that unit's `codes` (xunit_custom_tag): it was
#   bound in the main unit's scope and carried main's values.
u8: data { a: 1  b: 0 }

V: variant { a: null  b: null } as { tag: u8.tag }

codes: data { a: 0  b: 1 }

x: unit {
    codes: data { a: 1  b: 0 }

    U: union { a: null  b: null } as { tag: codes.tag }

    run: function out String is {
        u: U.b
        if u then return "truthy"
        return "falsy"
    }
}

main: function is {
    v: V.b
    if v then print "V.b truthy" else print "V.b falsy"
    print "x.U.b \{x.run}"
    print "xunit U.b \{xunit_custom_tag.which}"
}
