# generic_nested_spec.z -- a generic argument that is itself a specialisation:
# `(pairops t: (Cell t: i64))` resolves the argument where the instantiation is
# written and keys the trie on the specialisation's id, one level per
# parameter, down to a concrete definition. The instantiation's own label
# carries the argument's ("pairops_Cell_i64"); a second binding with the same
# nested argument resolves to the SAME mono.
Cell: record {
    val: t
} as { t: anyval.generic }

pairops: unit as {
    t: anyval.generic
    first: function {a: t b: t} out t is { return a }
    second: function {a: t b: t} out t is { return b }
}

boxed: (pairops t: (Cell t: i64))
again: (pairops t: (Cell t: i64))

main: function is {
    x: Cell val: 4
    y: Cell val: 9
    f: boxed.first a: x b: y
    s: again.second a: x b: y
    print "first=\{f.val} second=\{s.val}"
}
