# A CONSTANT HAS ITS VALUE'S WIDTH. A suffixed literal is its suffix's type,
# a name is its constant's, an operator takes its left-hand operand's (a bare
# literal on the left is i64, as in a body), an `if` its selected branch's, a
# lossless conversion its target's, and `"ab".length` the u64 the method
# returns. Every constant here was an i64 or an f64 whatever it was built from.
# Each result is proven by wrapping where only its own width wraps.
L: 5.u8
S: 3.u16
N: 5
F: 16777216.0.f32
data8: data { 1.u8 2 3 }

Q: L
P: (L)
M: L + 1
LL: L + L
ONE: 1 + L
SL: S + L
U32: 7.u32 + 1
MIX: 7.u32 + 7.u8
W: if L > 1 then { L } else { 7.u8 }
WIDE: L.u32
WIDE64: L.u64
NARROW: N.u8
G: F + 1.0
GF: F.f64
LEN: "ab".length
E: data8.1

cfg: record {
    x: i64
} as {
    K: 5.u8
    J: K + 1
}

Rec: record {
    n: L
}

scaled: function {n: L} out u8 is {
    return n - 6
}

main: function is {
    q: Q
    q = q - 6
    p: P
    p = p - 6
    m: M
    m = m - 7
    ll: LL
    ll = ll - 11
    one: ONE
    one = one - 7
    sl: SL
    sl = sl - 9
    print "\{q} \{p} \{m} \{ll} \{one} \{sl}"
    u: U32
    u = u - 9
    mix: MIX
    mix = mix - 15
    w: W
    w = w - 6
    wide: WIDE
    wide = wide - 6
    wide64: WIDE64
    wide64 = wide64 - 6
    narrow: NARROW
    narrow = narrow - 6
    print "\{u} \{mix} \{w} \{wide} \{wide64} \{narrow}"
    same: G == F
    gf: GF + 1.0
    len: LEN
    len = len - 3
    e: E
    e = e - 3
    print "\{same} \{gf == F} \{len} \{e}"
    k: cfg.K
    k = k - 6
    j: cfg.J
    j = j - 7
    r: Rec
    rn: r.n
    rn = rn - 6
    print "\{k} \{j} \{rn} \{scaled}"
}
