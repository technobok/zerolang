# Untyped integer constants fold exactly, past i64 as well, and only the final
# value lands: an intermediate outside i64 that comes back in range is that
# value. A shift by a count past u64 shifts every bit out. A comparison folds
# to a bool whatever its operands' types, typed or untyped.
MAXI: 9223372036854775807
MIN: 0 - 9223372036854775807 - 1
A: (MAXI - (0 - 1)).u64
B: (MIN - 1) + 1
C: (MIN / (0 - 1)).u64
D: 5 >> 18446744073709551616
U: 3.u8
LE1: (U <= 4)
LE2: (2.5.f64 <= 3.0)
LE3: (5.i32 <= 4.i32)
P: 3
Q: 4
NE1: P != Q
NE2: (P + 1) != Q
BIG: 18446744073709551616
NE3: BIG != (BIG + 1)
LT1: 1.5 < 2.5
LT2: 1.5.f64 < 2.5.f64
LT3: 2.5.f32 < 1.5.f32
LT4: 1 < 2.5

main: function is {
    print "\{A} \{B} \{C} \{D}"
    print "\{LE1} \{LE2} \{LE3}"
    print "\{NE1} \{NE2} \{NE3}"
    print "\{LT1} \{LT2} \{LT3} \{LT4}"
}
