# A `for each` OVER A LENT PLACE KEEPS NOTHING NEW IN A SUSPENDING GENERATOR.
# A header walking storage that already has a home -- a variable, a field --
# leaves it where it is across a suspension; anything new is kept in a state
# field. `x.borrow` lends the place and moves nothing, but read as new, so the
# walk copied the iterator (or list) into a second field, and both were
# destroyed: "attempting double-free" (ASan, reproduced at e109debe).
Words: generator { tag: String } as {
    call: function out u64 is {
        yield this.tag.length
        yield this.tag.length + 1
    }
}

Holder: class {
    w: Words
}

Outer: generator { n: i64 } as {
    call: function out u64 is {
        it: (Words tag: "hello".string)
        for each x: it.borrow loop yield x
        names: List String
        names.append "ab".string
        names.append "cde".string
        for each s: names.borrow loop yield s.length
        h: Holder w: (Words tag: "hi".string)
        for each y: h.w.borrow loop yield y
    }
}

main: function is {
    for each v: (Outer n: 1) loop print "v \{v}"
}
