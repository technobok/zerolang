# A generic typedef built from a value of ITSELF takes it unchanged, its type
# arguments the value's own (bindTypedefOwnArgs): `Bag b` with `b` a
# `(Bag T: String)` is a `(Bag T: String)`, inferred, not written.
Bag: typedef (List T) as {
    T: AnyRef.generic
    first: function {t: this.view} out u64 is {
        return t.length
    }
}

main: function is {
    l: List String
    l.append "a".string
    l.append "b".string
    b: Bag l.take
    c: Bag b.take
    c.append "c".string
    print "\{c.first}"
}
