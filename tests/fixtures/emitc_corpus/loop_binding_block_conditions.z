# A block condition after a loop's binding -- a binding loop, a `for each`, a
# counted range -- runs its statements at every test, as a loop with no
# binding does.
main: function is {
    k: 0
    for x: (optionval.some k) while ({
        k = k + 1
        k < 3
    }) loop {
        print "\{x}"
    }
    print "done \{k}"
    xs: List String
    xs.append from: "a".string
    xs.append from: "b".string
    xs.append from: "c".string
    n: 0
    for each s: xs while ({
        n = n + 1
        n < 3
    }) loop {
        print "each \{s} \{n}"
    }
    i: 0
    for j: (optionval.some i) while ({
        i = i + 1
        i < 4
    }) loop {
        print "bind \{j}"
    }
    for each r: (0.upto to: 9) while ({
        n = n + 1
        n < 6
    }) loop {
        print "range \{r}"
    }
}
