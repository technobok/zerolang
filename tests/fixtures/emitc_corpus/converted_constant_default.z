# A default written as a constant expression CONVERTED to a numeric type --
# `(0 - 7).i64`, `(2 * 3).u8` -- is that typed constant, on a parameter as on a
# field. The path's base is an expression, not a name, so it names no type; it
# was read as a type-ref and minted one from its text, `_7`, which the C
# compiler then refused as an unknown type.

# a parameter defaulting to a converted negative
neg: function {v: (0 - 7).i64} out i64 is { return v }

# a parameter defaulting to a converted product
prod: function {v: (2 * 3).u8} out u8 is { return v }

# a record whose field defaults to a converted constant
Box: record {
    # the converted default
    w: (40 + 2).i32
}

main: function is {
    b: Box
    c: Box w: 5
    print "\{neg} \{neg v: 3} \{prod} \{b.w} \{c.w}"
}
