# list_sv_natives.z -- ListVal text generated natives: contains uses
# length+memcmp equality and sort orders lexicographically via the
# StringView cmp (struct == / < are not valid C on views; text is laid out as
# one). The literals land in the list as text.
main: function is {
    xs: (ListVal text)
    xs.append from: "cherry"
    xs.append from: "apple"
    xs.append from: "banana"
    xs.sort
    for each e: xs loop print "e=\{e}"
    if (xs.contains item: "apple") then print "has apple"
    if (xs.contains item: "durian") == false then print "no durian"
}
