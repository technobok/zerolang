# A reftype with nothing to destroy moves on a take too: a take of a class
# holding only an i64 in one `if` arm left the sibling arm's read "cannot use
# after ownership transfer", because arm take tracking asked only after locals
# whose type needs a destructor.
Box: class {
    n: i64
}

run: function {c: bool} is {
    b: Box n: 4
    if c then {
        d: b.take
        print "took \{d.n}"
    } else {
        print "kept \{b.n}"
    }
}

main: function is {
    run c: true
    run c: false
}
