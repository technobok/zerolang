# A method's receiver need not be its first parameter. Called through a TYPE,
# the unlabelled argument is the receiver wherever it is declared; called
# through a value, the dot supplies it and every other argument is labelled.
Sq: class {
    s: i64
} as {
    area: function {scale: i64 t: this} out i64 is {
        return (t.s * t.s) * scale
    }
    grow: function {by: i64 :this} out i64 is {
        return this.s + by
    }
}

main: function is {
    q: Sq s: 3
    print "\{q.area scale: 2} \{Sq.area q scale: 2}"
    print "\{q.grow by: 4} \{Sq.grow q by: 5}"
}
