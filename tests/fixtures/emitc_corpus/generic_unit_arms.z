# A SUM TYPE A GENERIC UNIT DECLARES IS CONSTRUCTED BY ARM INSIDE THE UNIT. The
# unit instance's walk reads each type the unit declares as the instance's own
# copy; the copies were bound from the instance's member rows, which leave out
# types, so an arm construction met the template and tried to infer the unit's
# parameter from the payload: "cannot infer generic parameter 't'" for an arm
# that carries none, or carries another type.
shapes: unit as {
    t: anyval.generic
    # arms that never name t
    lamp: variant { lit: null dark: null }
    # a payload of another type
    level: variant { at: i64 none: null }
    # a payload of the unit's parameter
    color: variant { red: t blue: null }
    # a reftype sum, with an owned payload beside t's
    Shape: union { named: String count: t none: null }
    pick: function {c: color d: t} out t is {
        match c case red then return c case blue then return d
    }
    go: function {v: t} out t is {
        f: lamp.dark
        if f.dark then print "dark"
        l: level.at 4
        if l.at then print "at \{l}"
        r: pick c: (color.red v) d: v
        b: pick c: color.blue d: v
        print "\{r} \{b}"
        s: Shape.named "sq".string
        n: Shape.count v
        z: Shape.none
        match s case named then print s case count then print "n" case none then print "none"
        match n case named then print n case count then print "count \{n}" case none then print "none"
        if z.none then print "none"
        return v
    }
    mk: function {v: t} out color is { return (color.red v) }
}
ints: (shapes t: i64)
reals: (shapes t: f64)

main: function is {
    print "\{ints.go v: 5}"
    print "\{reals.go v: 2.5}"
    c: ints.mk v: 4
    match c case red then print "red \{c}" case blue then print "blue"
    d: reals.color.blue
    if d.blue then print "blue"
}
