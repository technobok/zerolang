# `lines` WITHOUT `split`. The two iterators share one state struct, which was
# declared under Splitter's name: a program that iterated lines and never split
# had no Splitter type, and the fragment's hole stopped the emitter.
TEXT: "first line"

main: function is {
    v: "one\ntwo\nthree"
    with it: v.lines do for line: it loop {
        print "line \{line}"
    }
    with it2: TEXT.lines do for line: it2 loop {
        print "text \{line}"
    }
}
