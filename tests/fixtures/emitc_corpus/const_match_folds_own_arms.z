# const_match_folds_own_arms -- a match on a unit constant folds to one of ITS OWN arms:
# the else when no clause names the arm the constant holds, whatever match is written
# next
mode: variant {
    fast: null
    slow: null
    eco: null
}

K: mode.eco

both: function {m: mode} is {
    match K case fast then print "fast" case slow then print "slow" else print "neither fast nor slow"
    match m case eco then {} case fast then {} case slow then {}
    print "reached the end"
}

main: function is {
    both m: mode.slow
}
