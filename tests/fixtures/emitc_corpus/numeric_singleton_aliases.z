# A NAME FOR A NUMERIC GENERIC PARAMETER IS AN ALIAS OF ITS SINGLETON TYPE: an
# `as` item or a generic unit's definition `SAME: cap`, and a unit-level
# definition through an instance -- `X: B5.cap`, `Y: (Box cap: 5).cap`,
# `Z: w3.n`. Read as a value, each is the type's one value, folded as the bare
# parameter is, and a member of it (`SAME.u64`) is read on that value. As a
# type it types a local or a field, a slot the construction sets, in the
# template, in each instance and outside alike. In a generic unit's own
# function its alias passes where the bound is expected, as the parameter does.
Box: class {
    used: u32
    k: SAME
} as {
    cap: u32.generic
    SAME: cap
    info: function {b: this.view} out String is {
        s: SAME
        return "\{SAME} \{s} \{SAME.u64} \{b.k} \{b.k + s}"
    }
}
B5: (Box cap: 5)

sized: unit as {
    cap: u32.generic
    SAME: cap
    Inner: record {
        k: SAME
        x: i64
    }
    get: function out u32 is {
        i: Inner x: 1
        return i.k + SAME
    }
}
eight: (sized cap: 8)

wrap: unit as { n: u32.generic }
w3: (wrap n: 3)

X: B5.cap
Y: (Box cap: 5).cap
Z: w3.n

Holder: record {
    k: X
    used: u32
}

main: function is {
    b: B5 used: 1
    c: (Box cap: 7) used: 1
    print "\{b.info} | \{c.info} | \{B5.SAME}"
    print "\{eight.get} \{eight.SAME} \{eight.SAME.u64}"
    x: X
    h: Holder used: 2
    print "\{X} \{Y} \{Z} \{x} \{X.u64} \{h.k} \{h.used}"
}
