# A data block a nested unit declares -- inline, one level deeper, a hidden
# subunit -- was unreadable from anywhere: `.get` reached the emitter as an
# unhandled callee, and a label, an ordinal or `.length` was written into the C
# as the dotted path itself (`inl.primes.length`, `codes.ht` undeclared). The
# checker looked the block's type up by name in the file unit, which knew none,
# the emitter's tables walked file units only, and `.get` asked for a bare
# name. A unit constant naming such a block's element had no value either.
# A top-level `primes` of its own must stay its own.
primes: list {
    100 200 300 400
} out list u16

inl: unit {
    primes: list {
        2 3 5 7
    } out list u8
    codes: list {
        ht: 9
        lf: 10
    } out list u8
    at: function {i: u64} out u8 is {
        return (primes.get i)
    }
    tab: function out u8 is {
        return codes.ht
    }
    TAB: codes.ht
    deeper: unit {
        marks: list {
            lo: 1
            hi: 99
        } out list u8
    }
}

LF: inl.codes.lf

main: function is {
    i: 2.u64
    print "index \{inl.primes.get i} \{inl.primes.get 0} top \{primes.get i}"
    print "inside \{inl.at i: 3} \{inl.tab} \{inl.TAB}"
    print "named \{inl.codes.lf} ordinal \{inl.primes.1} length \{inl.primes.length} \{primes.length}"
    print "deeper \{inl.deeper.marks.hi} \{inl.deeper.marks.length}"
    print "subunit \{tbl.codes.lf} \{tbl.pick i: 0}"
    print "constant \{LF}"
    arr: inl.primes.array
    print "array \{arr.get i: 3}"
}
