# A FIELD DECLARED BY A NUMERIC GENERIC PARAMETER IS A SLOT OF ITS SINGLETON
# TYPE. In each instance `stored: cap` is of type `(rec cap: 7).cap`, whose one
# value is 7; in the template it is of the parameter's own type, a typedef over
# u32. Either way its members are u32's and it passes where a u32 is expected,
# and a type parameter inferred from it is u32. The construction sets it and
# takes no argument for it, so a positional argument binds the next field;
# `meta.create` sets it too, and `==` compares it as any field. A field typed by
# a type built from the parameter (`(array t: i64 to: cap)`) is an ordinary
# field of each instance's own array type.
rec: record {
    stored: cap
    x: i64
} as {
    cap: u32.generic
    twice: function {r: this} out u32 is { return r.stored * 2 }
    mk: function {v: i64} out type is { return (meta.create x: v) }
}

Box: class {
    stored: cap
    used: u32
    cells: (array t: i64 to: cap)
} as {
    cap: u32.generic
    room: function {b: this.view} out u32 is { return b.stored - b.used }
    show: function {b: this.view} out String is {
        c: b.stored
        return "\{b.stored} \{c} \{c + 1} \{u32id v: b.stored} \{pick v: b.stored} \{b.cells.length}"
    }
}

# u32id -- the u32 it is given
u32id: function {v: u32} out u32 is { return v }

# pick -- the value it is given, of the type inferred from it
pick: function as { t: anyval.generic } in {v: t} out t is { return v }

R7: (rec cap: 7)

main: function is {
    a: R7 5
    e: R7 x: 5
    m: R7.mk v: 4
    print "rec \{a.stored} \{a.x} \{a.twice} \{m.stored} \{m.x}"
    if a == e then print "a equals e" else print "a differs from e"
    b: (Box cap: 3) used: 1 cells: (array t: i64 to: 3)
    d: (Box cap: 4) used: 2 cells: (array t: i64 to: 4)
    print "box \{b.room} \{b.show} | \{d.room} \{d.show}"
}
