# callee_body_own_receiver.z -- a function body checked while a call's argument
# is still pending is checked on its own terms. Here `lfWr`'s body is first
# reached from the second argument of `lfUse`, while the first argument's
# `.view` result waits for its call; `s.append` writes `lfWr`'s own borrowed
# parameter and is legal, whichever body the checker happened to walk first.
lfIdent: function as { T: StringLike.generic } in {v: T.view} outx T.view is {
    return v
}

lfUse: function {a: StringView.view b: i64} out i64 is {
    return b
}

lfWr: function {s: String} out i64 is {
    s.append s: "zz"
    return 0
}

main: function is {
    s: "abc".string
    n: lfUse a: (lfIdent v: "lit") b: (lfWr :s)
    print "\{n} \{s}"
}
