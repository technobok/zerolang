# A constant reached through a unit is a default like a bare one: `n: cfg.LIMIT`
# defaults to the unit's LIMIT, and `r: cfg.NONE` to its typedef constant.
cfg: unit as {
    LIMIT: 5
    NONE: rid 0
}

rid: typedef u32

f: function {a: i64 n: cfg.LIMIT} out i64 is {
    return a + n
}

g: function {a: i64 r: cfg.NONE} out u32 is {
    return r.u32
}

main: function is {
    print "\{f a: 1} \{f a: 1 n: 2} \{g a: 1} \{g a: 1 r: (rid 4)}"
}
