# generic_numeric_elided.z -- the first argument of a generic reference may drop
# its label, and a numeric first parameter is no exception: `(blk 4)` is
# `(blk n: 4)` in a type position and in a construction, and a constant serves
# as the value as a literal does.

blk: record {
    a: i64
} as { n: u64.generic }

size: 6

keep: record {
    b: (blk 4)
    c: (blk size)
}

main: function is {
    k: keep b: (blk 4 a: 1) c: (blk size a: 2)
    print "b: a=\{k.b.a} n=\{k.b.n}"
    print "c: a=\{k.c.a} n=\{k.c.n}"
}
