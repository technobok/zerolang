# view_arm_value_payload_writable -- A `view` arm's readonly lock is for a payload that
# is a reference: a value payload is the name's own, and the subject is written inside
# its arm.
Frozen: union {
    some: i64.view
    none: null
}
main: function is {
    n: 4
    f: Frozen.some n
    match (
        f
    ) case some then {
        print "some \{f}"
        f = Frozen.none
    } else null
    print "\{f.none}"
}
