# THE ARMS OF AN `if` OR A `match` USED AS A VALUE AGREE ON ONE TYPE: a typed
# arm governs a literal one wherever it stands, so `{ 8 } else { 7.u32 }` is a
# u32 as `{ 7.u32 } else { 8 }` is; integer and float literals yield a float;
# a nested `if` yields the type its own arms agree on. Each width is proven by
# wrapping where only it wraps.
mode: variant {
    fast: null
    slow: null
}

pick: function {c: bool} out u8 is {
    if c then { 2 } else { 3.u8 }
}

main: function is {
    c: 3 > 2
    m: mode.slow
    late: if c then { 8 } else { 7.u32 }
    late = late - 9
    early: if c then { 7.u32 } else { 8 }
    early = early - 8
    half: if c then { 1 } else { 2.5 }
    arm: match (m) case fast then { 5 } else { 6.u16 }
    arm = arm - 7
    nested: if c then { if c then { 4.u8 } else { 5 } } else { 6 }
    nested = nested - 5
    small: 1.u8
    small = if c then { 2 } else { 3 }
    print "\{late} \{early} \{half * 0.5} \{arm} \{nested} \{small} \{pick :c}"
}
