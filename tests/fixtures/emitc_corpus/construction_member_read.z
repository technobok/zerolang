# construction_member_read.z -- a member read or a method call on a
# parenthesised construction applies to the instance it builds: parentheses
# force the call, and a construction is a call like any other. Every call whose
# callee named a type was read as a type, so `(Cell n: 2).show` demanded the
# receiver the dot had already handed over ("missing required argument"), and
# a field read was refused as "not a member of the type". Only an
# instantiation -- a type applied to type arguments alone,
# `(ListVal i64).create` -- names a type.
Cell: class {
    n: i64
} as {
    show: function {c: this.view} out i64 is {
        return c.n
    }
}

Box: class {
    n: i64
} as {
    create: function {from: i64} out this is {
        return (meta.create n: from * 2)
    }
    twice: function {b: this.view by: i64} out i64 is {
        return b.n * by
    }
}

Pair: class {
    a: t
    b: t
} as {
    t: anyval.generic
    sum: function {p: this.view} out t is {
        return p.a + p.b
    }
}

Tag: union {
    word: String
    none: null
} as {
    show: function {g: this.view} out String is {
        match (g) case word then return g.copy case none then return "none".string
    }
}

main: function is {
    print "\{(Cell n: 2).show} \{(Cell n: 5).n}"
    print "\{(Box from: 3).n} \{(Box from: 3).twice by: 2}"
    print "\{(Pair t: u64 a: 1 b: 2).sum} \{(Pair t: u64 a: 3 b: 4).a}"
    print "\{(Tag.word "w".string).show}"
    xs: (ListVal i64).create
    print "\{xs.length}"
}
