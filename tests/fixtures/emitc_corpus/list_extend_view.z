# list_extend_view.z -- `extendView from:` appends a window's elements to the
# end of a ListVal. VALTYPE ONLY: the emitted body is a bitwise copy, so a
# reftype element would end up with two owners and be freed twice, and ListRef
# declares no twin (tests/fixtures/errors/listref_no_extendview.z pins that).
#
# The window may be one over the receiver itself: every element is read before
# the append writes, so self-extension is well defined and doubles the list.
main: function is {
    xs: ListVal i64
    xs.append 10
    xs.append 20
    xs.append 30

    # a window that is a strict subrange
    ys: ListVal i64
    ys.append 1
    with v: (xs.slice from: 1 to: 3) do {
        ys.extendView from: v
    }
    with it: ys.iterate do for e: it loop { print "sub=\{e}" }

    # an EMPTY window: the guard returns before touching either pointer
    zs: ListVal i64
    with w: (xs.slice from: 2 to: 2) do {
        zs.extendView from: w
    }
    print "empty=\{zs.length}"

    # the whole of one list onto another
    ws: ListVal i64
    with u: xs.listView do {
        ws.extendView from: u
    }
    print "whole=\{ws.length}"
}
