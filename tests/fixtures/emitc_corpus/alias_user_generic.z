# alias_user_generic.z -- the alias machinery reaches USER templates too: a
# re-export that RENAMES a user generic template (`Gadget` names `Widget` next
# door), a bare alias of that, and one more hop through it. Every hop must
# reach the ONE canonical id rather than mint a shell of its own, and two
# argument types must give two monos of that same template. No container is
# involved, so aliasedContainerTwin's List/Set/Map table cannot answer any of
# it.
Gadget: xunit_aliasgeneric.Widget
MyGadget: Gadget
Rewrapped: MyGadget

main: function is {
    a: Gadget val: 7
    b: MyGadget val: 8
    c: Rewrapped val: 9
    print "a=\{a.val} b=\{b.val} c=\{c.val}"

    f: Rewrapped val: 1.5
    print "f=\{f.val}"
}
