# proto_c_keyword.z -- protocol and facet MEMBERS named after C reserved words.
# A vtable slot is the one place a method keeps its source spelling (every other
# method symbol is `z_t<id>_...`), and cSlotName spelled a reserved word through
# untouched: `int64_t (*default)(void*);` is not C. The slot's four spellings --
# the vtable field, the wrapper symbol, the vtable row and the dispatch site --
# all come from cSlotName, so mangling it there keeps them in step. The wrapper
# PARAMETER names are emitted from the member list and need the same mangler.
#
# A FACET IS CONFORMED BY A VALTYPE, so `Mark`'s conformer is a record while
# `Slot`'s is a class -- and each is now CONSTRUCTED as well as called
# directly, which is what puts the mangled slot on the dispatch path for both
# families rather than only the protocol's.

Slot: protocol {
    default: function {:this} out i64
    register: function {:this const: i64} out i64
}

Mark: facet {
    short: function {:this} out i64
}

Impl: class {
    n: i64
} as {
    :Slot
    default: function {:this} out i64 is {
        return this.n
    }
    register: function {:this const: i64} out i64 is {
        return this.n + const
    }
}

Val: record {
    n: i64
} as {
    :Mark
    short: function {:this} out i64 is {
        return this.n * 2
    }
}

main: function is {
    i: Impl n: 5
    v: Val n: 5
    print "direct=\{i.default},\{i.register const: 3},\{v.short}"
    s: Slot.create from: i.take
    print "proto=\{s.default},\{s.register const: 4}"
    m: Mark.create from: v
    print "facet=\{m.short}"
}
