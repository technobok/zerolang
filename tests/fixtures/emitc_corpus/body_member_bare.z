# body_member_bare.z -- a type's members are in scope in its methods' bodies,
# nearest after the body's own names, as they are in its signatures: a bare
# static is called as the type's, a bare constant read as the type's, a bare
# method that takes the receiver called with one; in a generic type each is the
# instance's being checked. A local of a member's name is nearer still.
Cfg: record { v: i64 } as {
    K: 5
    helper: function {n: i64} out i64 is { return n + 1 }
    twice: function {c: this.view} out i64 is { return c.v * 2 }
    use: function {c: this.view} out i64 is {
        a: helper n: c.v
        b: twice c: c
        return a + b + K
    }
    shadowed: function {c: this.view} out i64 is {
        helper: 100
        return helper + c.v
    }
}

Cell: record { v: t } as {
    t: anyval.generic
    mk: function {x: t} out type is { return (meta.create v: x) }
    again: function {g: this.view} out type is { return (mk x: g.v) }
}

main: function is {
    c: Cfg v: 3
    print "\{c.use} \{c.shadowed}"
    g: (Cell t: i64 v: 4)
    h: (Cell t: u8 v: 9)
    print "\{g.again.v} \{h.again.v}"
}
