# convert_f128_narrow -- an f128 narrowed to f64, f32 and f16 at run time:
# exact, precision lost, out of range (a finite value past the destination's
# largest), an infinity (an infinity) and a NaN (a NaN). The run-time row tests
# its f128 source with arithmetic, not libm's isinf and isnan, which take
# float, double and long double only (mingw's trap on any other type).

# kindOf -- the name of a conversion's error
kindOf: function {e: converror} out String is {
    k: "outOfRange".string
    match e case outOfRange then null case precisionLoss then k = "precisionLoss".string
    return k
}

# f128f64 -- an f128 narrowed to f64: its bits, `nan`, or the error
f128f64: function {x: f128} out String is {
    r: x.f64
    s: String
    match (
        r
    ) case ok then {
        s = "\{r.bits}"
        if r != r then s = "nan".string
    } case err then {
        s = kindOf e: r
    }
    return s
}

# f128f32 -- an f128 narrowed to f32
f128f32: function {x: f128} out String is {
    r: x.f32
    s: String
    match (
        r
    ) case ok then {
        s = "\{r.bits}"
        if r != r then s = "nan".string
    } case err then {
        s = kindOf e: r
    }
    return s
}

# f128f16 -- an f128 narrowed to f16
f128f16: function {x: f128} out String is {
    r: x.f16
    s: String
    match (
        r
    ) case ok then {
        s = "\{r.bits}"
        if r != r then s = "nan".string
    } case err then {
        s = kindOf e: r
    }
    return s
}

main: function is {
    z: 0.0.f128
    nan: z / z
    inf: 1.0.f128 / z
    third: 1.0.f128 / 3.0.f128
    print "f128.f64 1.5 \{f128f64 x: 1.5.f128} third \{f128f64 x: third} 1e400 \{(
        f128f64
        x: 1.0e400.f128
    )}"
    print "f128.f64 inf \{f128f64 x: inf} -inf \{f128f64 x: z - inf} nan \{f128f64 x: nan}"
    print "f128.f32 1.5 \{f128f32 x: 1.5.f128} third \{f128f32 x: third} 1e40 \{(
        f128f32
        x: 1.0e40.f128
    )}"
    print "f128.f32 inf \{f128f32 x: inf} -inf \{f128f32 x: z - inf} nan \{f128f32 x: nan}"
    print "f128.f16 1.5 \{f128f16 x: 1.5.f128} 65504 \{f128f16 x: 65504.0.f128} 65505 \{(
        f128f16
        x: 65505.0.f128
    )}"
    print "f128.f16 65520 \{f128f16 x: 65520.0.f128} inf \{f128f16 x: inf} nan \{f128f16 x: nan}"
}
