# unit_path_data.z -- a data type declared in an inline unit, reached through a
# unit path in every static position: a construction head, a type alias and a
# data field's type; directly, two units deep, and through an alias of the unit.
runtime: unit {
    nativec: unit {
        link: data {
            library: text
            weight: 1
        }
    }
}
inner: unit {
    part: data {
        count: 1
    }
}
c: runtime.nativec
direct: (inner.part count: 3)
deep: (runtime.nativec.link library: "m" weight: 2)
aliased: (c.link library: "z")
linkType: c.link
viaType: (linkType library: "t" weight: 5)
holder: data {
    near: c.link
    far: runtime.nativec.link
    piece: inner.part
}
held: (holder near: aliased far: deep piece: direct)

main: function is {
    print "\{direct.count} \{deep.weight} \{aliased.weight} \{viaType.weight}"
    print "\{held.near.library.stringView} \{held.far.weight} \{held.piece.count}"
}
