# typedef_unit_constant.z -- a unit-level constant whose literal suffix names
# a scalar typedef folds to a C constant and reads across the unit boundary.
# The emitter gated the fold on the suffix NAME (builtin scalars only), so a
# typedef-typed constant fell through and emitted the source path
# "unit.NAME" as a C identifier: zc exited 0 and only the C compiler caught it.

takes: function {n: xunit_tdconst.nameid} out u32 is {
    return n.u32
}

main: function is {
    a: xunit_tdconst.wkThis
    b: xunit_tdconst.wkCreate
    if a == b then print "eq-BAD" else print "ne"
    print "vals: \{takes n: a} \{takes n: b}"
    print "insame: \{xunit_tdconst.localSum}"
}
