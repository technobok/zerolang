# typedef_unit_constant.z -- a data block typed by a scalar TYPEDEF, its
# elements folding to C constants and read across the unit boundary. The
# elements are `nameid`, not the base u32: `out T` types them, so `takes` binds
# them directly and the `==` the typedef declares is what compares them.
#
# The emitter once gated a constant's fold on the suffix NAME (builtin scalars
# only), so a typedef-typed constant fell through and emitted the source path
# "unit.NAME" as a C identifier: zc exited 0 and only the C compiler caught it.
# The fold is exercised here by the element reads.

takes: function {n: xunit_tdconst.nameid} out u32 is {
    return n.u32
}

main: function is {
    a: xunit_tdconst.names.wkThis
    b: xunit_tdconst.names.wkCreate
    if a == b then print "eq-BAD" else print "ne"
    print "vals: \{takes n: a} \{takes n: b}"
    print "insame: \{xunit_tdconst.localSum}"
}
