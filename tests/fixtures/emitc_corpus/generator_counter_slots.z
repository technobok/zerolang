# generator_counter_slots.z -- a COUNTED `for` whose body suspends draws its
# counter slot at the ELEMENT's width, and every such loop draws its own.
#
# The counter lives only in the C header and `goto L_resume_k` re-enters the
# loop past the init clause, so it is spilled to a state field across each
# suspension. `U64s` proves the field is typed from the RANGE rather than
# assumed i64; `Twice` proves two SIBLING loops draw two slots and may share a
# name; `Nest` proves an inner suspending loop draws one of its own.
Count: generator { n: i64 } as {
    call: function out i64 is {
        for each i: this.n.times loop {
            yield i
        }
    }
}

U64s: generator { n: u64 } as {
    call: function out u64 is {
        for each i: this.n.times loop {
            yield i
        }
    }
}

Twice: generator { n: i64 } as {
    call: function out i64 is {
        for each i: this.n.times loop {
            yield i
        }
        for each i: this.n.times loop {
            yield i + 100
        }
    }
}

Nest: generator { n: i64 } as {
    call: function out i64 is {
        for each a: this.n.times loop {
            for each b: this.n.times loop {
                yield (a * 10) + b
            }
        }
    }
}

main: function is {
    for each c: (Count n: 4) loop print "c: \{c}"
    for each u: (U64s n: 3.u64) loop print "u: \{u}"
    for each t: (Twice n: 2) loop print "t: \{t}"
    for each g: (Nest n: 3) loop print "g: \{g}"
    print "done"
}
