# EVERY MEMBER OF A GENERIC UNIT IS THE INSTANCE'S. A unit-level alias of the
# parameter (`elem: t`), of a type the unit declares (`P: pt`) or of an
# instantiation over the parameter (`Vals: (ListVal t: t)`) is the instance's
# own: its signatures read the argument, and so does a read through the
# instance (`wi.elem`). A zero value through an alias (`nothing`), or of the
# parameter itself (`t`), is the argument's zero.
wrap: unit as {
    t: anyval.generic
    elem: t
    nothing: t
    pt: record { x: t }
    P: pt
    Vals: (ListVal t: t)
    get: function {v: elem} out elem is { return v }
    zero: function out t is { return nothing }
    zeroT: function out t is { return t }
    mk: function {v: t} out P is { return (P x: v) }
    pair: function {v: t} out Vals is {
        r: Vals
        r.append v
        r.append v
        return r
    }
}
wi: (wrap t: i64)
wf: (wrap t: f64)

# twice -- an i64 through the instance's alias, in a parameter and a return
twice: function {v: wi.elem} out wi.elem is { return v * 2 }

# xOf -- the instance's record, named through its alias
xOf: function {p: wi.P} out i64 is { return p.x }

main: function is {
    print "\{wi.get v: 4} \{wf.get v: 2.5} \{wi.zero} \{wf.zero} \{wi.zeroT}"
    print "\{twice v: 21} \{wf.nothing} \{xOf p: (wi.mk v: 3)} \{(wf.mk v: 1.5).x}"
    l: wf.pair v: 0.5
    print "\{l.length}"
}
