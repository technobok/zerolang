# EVERY MEMBER OF A GENERIC UNIT IS THE INSTANCE'S. A unit-level alias of the
# parameter (`elem: t`), of a type the unit declares (`P: pt`) or of an
# instantiation over the parameter (`Vals: (ListVal t: t)`) is the instance's
# own: its signatures read the argument, and so does a read through the
# instance (`wi.elem`). A zero value through an alias (`nothing`), or of the
# parameter itself (`t`), is the argument's zero. A data block is the instance's
# own copy: read inside the unit and through the instance, its elements typed by
# the instance's `out intdata t` and evaluated over its numeric parameter.
wrap: unit as {
    t: anyval.generic
    primes: data { 2 3 5 7 }
    elem: t
    nothing: t
    pt: record { x: t }
    P: pt
    Vals: (ListVal t: t)
    get: function {v: elem} out elem is { return v }
    zero: function out t is { return nothing }
    zeroT: function out t is { return t }
    first: function out i64 is { return (primes.index i: 0) + primes.length }
    mk: function {v: t} out P is { return (P x: v) }
    pair: function {v: t} out Vals is {
        r: Vals
        r.append v
        r.append v
        return r
    }
}
wi: (wrap t: i64)
wf: (wrap t: f64)

cells: unit as {
    t: anyval.generic
    vals: data { 2 3 250 } out intdata t
    get: function {i: u64} out t is { return (vals.index :i) }
    all: function out intdata t is { return vals }
    sum: function out t is {
        s: t
        for each v: vals.iterate loop s = s + v
        return s
    }
}
ci: (cells t: i64)
cu: (cells t: u8)

sq: unit as {
    n: u64.generic
    vals: data { n (n * n) (n * 3) } out intdata u64
    get: function {i: u64} out u64 is { return (vals.index :i) }
}
s3: (sq n: 3)
s5: (sq n: 5)

# twice -- an i64 through the instance's alias, in a parameter and a return
twice: function {v: wi.elem} out wi.elem is { return v * 2 }

# xOf -- the instance's record, named through its alias
xOf: function {p: wi.P} out i64 is { return p.x }

main: function is {
    print "\{wi.get v: 4} \{wf.get v: 2.5} \{wi.zero} \{wf.zero} \{wi.zeroT}"
    print "\{twice v: 21} \{wf.nothing} \{xOf p: (wi.mk v: 3)} \{(wf.mk v: 1.5).x}"
    l: wf.pair v: 0.5
    print "\{l.length}"
    print "\{wi.primes.index i: 3} \{wf.primes.length} \{wi.first}"
    print "\{ci.get i: 2} \{cu.get i: 1} \{ci.sum} \{cu.vals.length} \{ci.vals.index i: 0}"
    for each v: cu.all.iterate loop print "\{v}"
    print "\{s3.get i: 1} \{s5.get i: 2} \{s5.vals.index i: 0} \{s3.vals.length}"
}
