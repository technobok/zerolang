# A function FIELD named `call` is a value its class stores: calling it calls
# the stored function, as any other field does. The emitter took `h.call x: 4`
# for a user iterator's `.call` method and emitted a call of the field's
# function TYPE (gcc: implicit declaration of z_tN).
Holder: class {
    call: function {x: i64} out i64
    run: function {x: i64} out i64
}

dbl: function {x: i64} out i64 is {
    return x * 2
}

main: function is {
    h: (Holder call: dbl.copy run: dbl.copy)
    print "run \{h.run x: 4}"
    r: h.call x: 5
    print "call \{r} \{h.call x: 6}"
}
