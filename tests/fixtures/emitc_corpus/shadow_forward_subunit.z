# shadow_forward_subunit.z -- this unit's own `Box` shadows core's, and a
# function's return type names it while it is still unresolved: main reaches
# the function first and the hidden subunit second, so the subunit resolves
# in the middle of the drain, and the stamp pass that runs then must not let
# core's Box answer for a name this unit declares -- the reference waits.
Box: class { v: i64 }

makeBox: function out Box is {
    return (Box v: 3)
}

main: function is {
    b: makeBox
    print "box \{b.v} \{impl.V}"
}
