# A holder reassigned with a value that keeps nothing locked lets go of what
# its old value locked, wherever the reassignment is written: on a plain
# line, in a block, in an arm (on that path), in a loop body (on that path).
# So the old source is written after it, and the holder read.
LfBox: class {
    name: StringView
}

LfOwn: class {
    s: String
}

onALine: function is {
    s: "abc".string
    w: LfBox name: s.stringView
    w = LfBox name: "init"
    s = "zzz".string
    print "line \{w.name} \{s}"
}

throughAField: function is {
    o: LfOwn s: "abc".string
    w: LfBox name: o.s.stringView
    w = LfBox name: "init"
    o.s = "zzz".string
    print "field \{w.name} \{o.s}"
}

inABlock: function is {
    s: "abc".string
    w: LfBox name: s.stringView
    {
        w = LfBox name: "init"
    }
    s = "zzz".string
    print "block \{w.name} \{s}"
}

inAnArm: function {k: bool} is {
    s: "abc".string
    v: s.stringView
    if k then {
        v = "init"
        s = "zzz".string
        print "arm \{v} \{s}"
    } else {
        print "else \{v}"
    }
}

inALoopBody: function is {
    s: "abc".string
    w: LfBox name: s.stringView
    one: ListVal i64
    one.append 1
    for each q: one loop {
        w = LfBox name: "init"
        s = "zzz".string
        print "loop \{w.name} \{s}"
    }
}

main: function is {
    onALine
    throughAField
    inABlock
    inAnArm k: true
    inAnArm k: false
    inALoopBody
}
