# A member's C name is its family's letter and its ordinal, so no source name
# can collide in C: not with a keyword (`default`, and `v_default`, which the
# old keyword escape also produced), a libc macro (`errno`, `st_mtime`, a
# function-like `isnan` on a function field), the constructor's own local
# (`_this`), or another member (`op_eq`, the C spelling `==` had). gcc refused
# every one of these when members were spelled by name.
pt: record {
    default: i64
    v_default: i64
    errno: i64
    st_mtime: i64
    _this: i64
}

pred: function {x: f64} out bool

isPos: function {x: f64} out bool is {
    return x > 0.0
}

h: class {
    isnan: pred
}

Sized: protocol {
    ==: function {:this rhs: u64} out bool
    op_eq: function {:this rhs: u64} out bool
}

Box: class {
    n: u64
} as {
    s: Sized
    ==: function {b: this rhs: u64} out bool is {
        return b.n == rhs
    }
    op_eq: function {b: this rhs: u64} out bool is {
        return (b.n == rhs).not
    }
}

check: function {s: Sized} out String is {
    return "eq=\{s == 3} op=\{s.op_eq rhs: 3}"
}

main: function is {
    p: pt default: 1 v_default: 2 errno: 3 st_mtime: 4 _this: 5
    print "\{p.default} \{p.v_default} \{p.errno} \{p.st_mtime} \{p._this}"
    k: h isnan: isPos.copy
    print "isnan: \{k.isnan x: 1.0}"
    b: Box n: 3
    print (check s: b)
}
