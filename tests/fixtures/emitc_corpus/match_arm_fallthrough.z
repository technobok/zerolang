# A match arm whose body ends in a match that does NOT diverge: the inner
# `else null` falls through, so the arm must keep its C `break;`. Inferring
# divergence from the `never` STAMP alone drops it and the switch falls into
# the next case -- classify returns 1 instead of 9, silently.
Wrap: union { pair: (Box u64)  vacant: null }

classify: function {w: Wrap x: Wrap} out u64 is {
    match (
        w
    ) case pair then {
        match (
            x
        ) case pair then {
            return 7
        } else null
    } case vacant then {
        return 1
    }
    return 9
}

main: function is {
    a: Wrap.pair 5
    b: Wrap.vacant
    print "classify=\{classify w: a x: b}"
}
