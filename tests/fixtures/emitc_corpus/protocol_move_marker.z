# `.take` and `.hold` on a protocol value hand the value itself on, as they do
# for a class, a union or a String: a protocol value owns its box. The emitter
# decided which bases a move marker hands on from a list of families that left
# protocols out, and the marker fell through to the vtable leg, which spelled
# it as a method: "'z_t503_vtable_t' has no member named 'take'".
Sp: protocol {
    get: function {t: this.view} out i64
}

Getter: protocol {
    v: anyval.generic
    get: function {t: this.view} out v
}

PC: class { n: i64  s: String } as {
    :Sp
    g: (Getter v: i64)
    get: function {c: this.view} out i64 is { return c.n }
}

eat: function {p: Sp.take} out i64 is { return p.get }

eatG: function {p: (Getter v: i64).take} out i64 is { return p.get }

main: function is {
    a: Sp.create from: (PC n: 1 s: "a".string)
    b: Sp.create from: (PC n: 2 s: "b".string)
    c: (Getter v: i64).create from: (PC n: 3 s: "c".string)
    d: Sp.create from: (PC n: 4 s: "d".string)
    moved: d.take
    held: moved.hold
    print "\{eat p: a.take} \{eat p: b} \{eatG p: c.take} \{held.get}"
}
