# inline_unit_consts.z -- an inline unit is a namespace of static definitions,
# and its constants are members of IT: two namespaces may each declare a `NUM`
# without colliding, and nesting is not capped at one level.
m: unit {
    NUM: 7
    NAME: "zed"
}

n: unit {
    NUM: 11
}

outer: unit {
    inner: unit {
        X: 42
    }
}

main: function is {
    print "m.NUM=\{m.NUM} n.NUM=\{n.NUM} m.NAME=\{m.NAME}"
    print "outer.inner.X=\{outer.inner.X}"
}
