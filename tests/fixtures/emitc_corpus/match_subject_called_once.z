# match_subject_called_once -- a `match` on a bool reads its subject once, so
# a subject that calls a function -- a bare name of a function without
# parameters included -- calls it once, whichever arm it takes: as a value, as
# a statement, and when the first arm's test fails.

# ask -- false, after printing that it was asked
ask: function out bool is {
    print "asked"
    return false
}

main: function is {
    v: match ask case true then 1.i32 case false then 2.i32
    match ask case true then print "yes" case false then print "no"
    print "v \{v}"
}
