# A program's own type spelled like a scalar is the program's type, in a data
# block's `out` as anywhere: `u8` below is an i64, and 300 fits it. The block's
# element kind was read off the NAME `u8`, so the element was refused as out of
# range for the system u8.
u8: typedef i64

d: data { 300  70000 } out (intdata u8)

main: function is {
    print "\{d.index i: 0}"
    print "\{d.index i: 1}"
}
