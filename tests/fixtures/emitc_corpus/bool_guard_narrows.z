# bool is an ordinary 2-arm variant: a diverging guard over it narrows it in
# every spelling -- `if b`, `b.true`, `b.false`, `b.not`, `b == false`,
# `false == b` -- so a later match needs only the arm that remains. Holding an
# arm that carries nothing (`o.yes`) records it exactly, for any sum type.
o: variant { no: null yes: null }

f1: function {b: bool} out u64 is {
    if b then return 0
    match b case false then return 1
}
f2: function {b: bool} out u64 is {
    if b == false then return 2
    match b case true then return 3
}
f3: function {b: bool} out u64 is {
    if false == b then return 4
    match b case true then return 5
}
f4: function {b: bool} out u64 is {
    if b.true then return 6
    match b case false then return 7
}
f5: function {b: bool} out u64 is {
    if b.not then return 8
    match b case true then return 9
}
f6: function {b: bool} out u64 is {
    if b then {
        match b case true then return 10
    }
    return 11
}
f7: function {b: bool} out u64 is {
    if b.false then return 12
    match b case true then return 13
}
g1: function {b: o} out u64 is {
    if b.yes.not then return 20
    match b case yes then return 21
}
g2: function {b: o} out u64 is {
    if (b.yes) == false then return 22
    match b case yes then return 23
}
g3: function {b: o} out u64 is {
    if b.no.false then return 24
    match b case no then return 25
}
h1: function {v: optionval i64} out i64 is {
    if v.none.not then return 30
    match v case none then return 31
}

main: function is {
    print "\{f1 b: true} \{f1 b: false} \{f2 b: false} \{f2 b: true} \{f3 b: false} \{f3 b: true}"
    print "\{f4 b: true} \{f4 b: false} \{f5 b: false} \{f5 b: true} \{f6 b: true} \{f6 b: false} \{f7 b: false} \{f7 b: true}"
    print "\{g1 b: o.yes} \{g1 b: o.no} \{g2 b: o.yes} \{g3 b: o.no} \{h1 v: optionval.none i64} \{h1 v: optionval.some 1}"
}
