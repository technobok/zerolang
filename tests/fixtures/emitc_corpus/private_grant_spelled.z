# The grants a `.private` parameter accepts: `this.private` spelled by the
# type's own method, and a friend forwarding the handle it was given, whether
# re-spelled (`h.private`) or passed as the plain binding it already is.
Bag: class { a: i64 count: i64 } as {
    public: unit { :count :peek }
    peek: function {:this} out i64 is { return (forward h: this.private) }
}

forward: function {h: Bag.private.borrow} out i64 is { return (respell h: h) + (inner h: h.private) }
respell: function {h: Bag.private.borrow} out i64 is { return (inner h: h) }
inner: function {h: Bag.private.borrow} out i64 is { return h.a }

main: function is {
    b: (Bag a: 21 count: 3)
    print "peek=\{b.peek} count=\{b.count}"
}
