# integer_divide_zero.z -- an integer division by a zero known only at run time
# panics ("zpanic: division by zero" on stderr, exit 1), and the trailing print
# never runs.

quot: function {a: u64 b: u64} out u64 is {
    return a / b
}

main: function is {
    print "before"
    q: quot a: 7 b: 0
    print "after \{q}"
}
