# A NUMERIC GENERIC PARAMETER IN A DECLARATION. As a type it has one value, the
# instance's argument: it types a field (`stored: cap`) and a local, which hold
# that value, and a type built from it (`(array t: i64 to: cap)`) is a type like
# any other. A parameter, a return, a marker and a type argument name the
# bound instead and read the parameter for its value: `n: u32` with `cap` read
# in the body, `out u32` with `return cap` (errors/singleton_placement refuses
# the parameter itself there). This holds wherever the parameter comes from: a
# method's type, a generic unit, the function's own generic parameters, or two
# of them at once.
Box: class {
    used: u32
    stored: cap
} as {
    cap: u32.generic
    room: function {b: this.view n: u32} out u32 is {
        return n + cap - b.used
    }
    limit: function {b: this.view} out u32 is {
        return cap + b.used
    }
    pick: function as { k: u32.generic } in {b: this.view a: u32} out u32 is {
        return a + k + b.stored + b.used
    }
    cells: function {b: this.view} out u64 is {
        a: array t: i64 to: cap
        c: b.stored
        return a.length + c.u64
    }
}

rec: record {
    x: i64
} as {
    cap: u32.generic
    plus: function {r: this n: u32} out u32 is {
        return n + cap
    }
}

wrap: unit as {
    n: u64.generic
    f: function {x: u64} out u64 is {
        return x + n
    }
    g: function as { k: u64.generic } in {a: u64} out u64 is {
        return a * 10 + k + n
    }
}
wa: (wrap n: 3)
wb: (wrap n: 8)

own: function as { k: u32.generic } in {x: u32} out u32 is {
    return x + k
}

main: function is {
    c: (Box cap: 5) used: 1
    d: (Box cap: 7) used: 2
    print "method \{c.room n: 9} \{d.room n: 9} \{c.limit} \{d.limit}"
    print "pick \{c.pick k: 2 a: 10} \{d.pick k: 3 a: 10} \{c.cells} \{d.cells}"
    r: (rec cap: 4) x: 1
    print "record \{r.plus n: 10}"
    print "unit \{wa.f x: 10} \{wb.f x: 20} \{wa.g k: 2 a: 5} \{wb.g k: 4 a: 1}"
    print "own \{own k: 3 x: 10}"
}
