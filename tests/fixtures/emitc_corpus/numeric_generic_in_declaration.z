# A NUMERIC GENERIC PARAMETER IN A DECLARATION NAMES A VALUE. A parameter
# declared by it (`n: cap`) is of the bound's type, and its default is the
# argument of the instance it is called through, as a field declared by it is.
# A marked one (`n: cap.hold`) and a return (`out cap`) are of the bound's type
# too, as a unit constant's name is the constant's type. This holds wherever
# the parameter comes from: a method's type, a generic unit, the function's own
# generic parameters, or two of them at once. Read as a type parameter instead,
# these were refused or compiled to invalid C.
Box: class {
    used: u32
    held: cap.hold
} as {
    cap: u32.generic
    room: function {b: this.view n: cap} out u32 is {
        return n - b.used
    }
    roomHeld: function {b: this.view n: cap.hold} out u32 is {
        return n - b.used
    }
    limit: function {b: this.view} out cap is {
        return cap + b.used
    }
    pick: function as { k: u32.generic } in {b: this.view a: k c: cap} out u32 is {
        return a + c + b.used
    }
}

rec: record {
    x: i64
} as {
    cap: u32.generic
    plus: function {r: this n: cap} out u32 is {
        return n + 1
    }
}

wrap: unit as {
    n: u64.generic
    f: function {x: n} out u64 is {
        return x + 1
    }
    g: function as { k: u64.generic } in {a: k b: n} out u64 is {
        return a * 10 + b
    }
}
wa: (wrap n: 3)
wb: (wrap n: 8)

own: function as { k: u32.generic } in {x: k} out u32 is {
    return x + 1
}

ownHeld: function as { k: u32.generic } in {x: u32 y: k.hold} out k is {
    return x + y + k
}

main: function is {
    c: (Box cap: 5) used: 1 held: 6
    d: (Box cap: 7) used: 2 held: 9
    print "method \{c.room} \{c.room n: 9} \{d.room} \{d.room n: 9}"
    print "held \{c.held} \{d.held} \{c.roomHeld n: 9}"
    print "return \{c.limit} \{d.limit}"
    print "pick \{c.pick k: 2} \{c.pick k: 2 a: 10} \{c.pick k: 2 c: 100}"
    r: (rec cap: 4) x: 1
    print "record \{r.plus} \{r.plus n: 10}"
    print "unit \{wa.f} \{wa.f x: 10} \{wb.f} \{wb.f x: 20}"
    print "unit own \{wa.g k: 2} \{wa.g k: 2 a: 5} \{wb.g k: 4 b: 9}"
    print "own \{own k: 3} \{own k: 3 x: 10} \{ownHeld k: 3 x: 1 y: 2}"
}
