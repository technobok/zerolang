# byteView reads a String, a StringView or a text as its bytes in place, and
# ByteView.stringView reads bytes back as text: a StringView over the same
# bytes when they are UTF-8, else where the first invalid sequence starts.
# Nothing is copied either way.
show: function {b: ByteView} is {
    r: b.stringView
    match r case ok then print "text \{r}" case err then print "not UTF-8 from byte \{r.validUpTo}"
}

main: function is {
    s: "héllo".string
    for each b: s.byteView loop print "\{b}"
    v: "abc"
    print "\{v.byteView.length} \{"xyz!".text.byteView.length}"
    w: io.stdout
    line: "written through the stream\n"
    wr: w.write from: line.byteView
    match wr case ok then print "wrote \{wr}" case err then print "write failed"
    good: Bytes
    good.append from: 104.u8
    good.append from: 105.u8
    show b: good.byteView
    bad: Bytes
    bad.append from: 104.u8
    bad.append from: 105.u8
    bad.append from: 255.u8
    bad.append from: 33.u8
    show b: bad.byteView
    cut: Bytes
    cut.append from: 97.u8
    cut.append from: 195.u8
    show b: cut.byteView
}
