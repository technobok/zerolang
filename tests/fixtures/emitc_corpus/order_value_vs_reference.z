# Arguments are evaluated in written order, and what an argument hands the call
# depends on how it is passed. A value -- a number, a record, a field read --
# is copied where it is written, so a later argument that changes its source
# does not change it. A reference -- a class, a `.borrow` parameter -- is the
# object itself, so the callee sees it as it is once every argument has run.
Counter: class {
    count: i64
}

bumpit: function {c: Counter} out i64 is {
    c.count = c.count + 100
    return c.count
}

pt: record { x: i64 y: i64 }

setv: function {p: pt.borrow v: i64} out i64 is {
    p.x = v
    return v
}

pair: function {a: i64 b: i64} out i64 is {
    print "pair a=\{a} b=\{b}"
    return a
}

pairv: function {a: pt b: i64} out i64 is {
    print "pairv a.x=\{a.x} b=\{b}"
    return a.x
}

pairc: function {a: Counter b: i64} out i64 is {
    print "pairc a.count=\{a.count} b=\{b}"
    return a.count
}

main: function is {
    c: Counter count: 1
    pair a: c.count b: (bumpit c: c)
    pair a: (bumpit c: c) b: c.count
    q: pt x: 1 y: 2
    pair a: q.x b: (setv p: q v: 7)
    q.x = 1
    pairv a: q b: (setv p: q v: 8)
    n: 1
    t: true
    pair a: n b: (if t then {
        n = 5
        n
    } else 0)
    k: Counter count: 1
    pairc a: k b: (bumpit c: k)
}
