# A unit constant of a typedef is built as a body builds one: from exactly the
# typedef's base, or from the typedef itself. A typedef of a typedef takes a
# value of its base typedef, and its conversions are the chain end's.

# level -- a byte with a meaning of its own
level: typedef u8

# floor -- a level that stands for a floor of a building
floor: typedef level

Ground: level 0
Top: level 9
Same: level Top
Roof: floor Top
Lift: floor (level 4)
RoofWide: Roof.u64

main: function is {
    print "\{Ground.u8} \{Same.u8} \{Roof.u64} \{Lift.u32} \{RoofWide}"
    r: floor (level 9)
    s: level Top
    print "\{r.u64} \{s.u8}"
}
