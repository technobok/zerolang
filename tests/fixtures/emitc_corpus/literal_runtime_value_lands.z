# An operation on a literal value only run time knows -- an `if` or a `match`
# of literal arms on a run-time condition -- runs in the literal's default type,
# as it does once the value is bound: `(if c then 1 else 2).u8` is i64's
# conversion, which answers a Result, and `1 + (if c then 400 else 5)` is an
# i64 sum.
#
# Neither did. The conversion checked as the literal's own `u8`, a bare u8,
# while the emitter wrote i64's, whose Result was never made (E0500: "hole
# @ERRTAG@ is bound to nothing"). The sum kept the literal type, so a u8
# context took its i64 value unchecked: `w + (1 + (if c then 400 else 5))`
# with `w: 1.u8` printed 146.
pick: function {c: bool} out i64 is {
    return (match c case true then 7 case false then 8)
}

main: function is {
    c: true
    v: (if c then 1 else 2).u8
    match v case ok then print "u8 \{v}" case err then print "u8 err"
    big: (if c then 300 else 2).u8
    match big case ok then print "big \{big}" case err then print "big out of range"
    neg: (if c then -1 else 2).u64
    match neg case ok then print "neg \{neg}" case err then print "neg out of range"
    f: (if c then 3 else 4).f64
    match f case ok then print "f64 \{f}" case err then print "f64 err"
    m: (match c case true then 5 case false then 6).u16
    match m case ok then print "match \{m}" case err then print "match err"
    s: 1 + (if c then 400 else 5)
    print "sum \{s} \{s + (pick :c)}"
}
