# native_method_computed_receiver.z -- a native method called on a receiver a
# call computes, with no variable to name it: an element borrowed out of a list
# (`(files.getMut i: 0).write`, `.close` read as a member) and a value a
# function returns. Each is the method's own fragment call on the place the
# receiver names, so the element itself is written and closed.

openFor: function {path: StringView} out io.File is {
    r: io.open :path mode: io.openmode.write
    match (r) case ok then return r.take case err then panic msg: "open failed"
}

main: function is {
    files: List io.File
    files.append from: (openFor path: "z_computed_recv.txt")
    b: Bytes
    b.append from: 104.u8
    b.append from: 105.u8
    w: (files.getMut i: 0).write from: b.byteView
    match (w) case ok then print "wrote \{w}" case err then print "write failed"
    c: (files.getMut i: 0).close
    match (c) case ok then print "closed the element" case err then print "close failed"
    t: io.readText path: "z_computed_recv.txt"
    match (t) case ok then print "read back: \{t}" case err then print "read failed"
    c2: (openFor path: "z_computed_recv2.txt").close
    match (c2) case ok then print "closed a returned file" case err then print "close failed"
}
