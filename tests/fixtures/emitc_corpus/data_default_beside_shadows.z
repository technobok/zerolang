# A data block with no `out` is untyped: its elements read as literals, and as
# a value it is a block of the prelude's i64, f64 or StringView. A unit that
# declares its own records under those names keeps them its own -- the blocks
# still read as the builtins, even once the records have been resolved first.
StringView: record { lo: i16 }
i64: record { lo: i16 }
f64: record { lo: i16 }

words: data { "a" "bb" "ccc" }
counts: data { 1 2 3 }
rates: data { 0.5 1.5 }

main: function is {
    s: StringView lo: 1
    n: i64 lo: 2
    r: f64 lo: 3
    print "records \{s.lo} \{n.lo} \{r.lo}"
    w: words
    c: counts
    f: rates
    print "words \{w.length} \{w.index i: 2} \{words.index i: 1}"
    print "counts \{c.length} \{c.index i: 2} \{counts.index i: 0}"
    print "rates \{f.length} \{f.index i: 1} \{rates.index i: 0}"
}
