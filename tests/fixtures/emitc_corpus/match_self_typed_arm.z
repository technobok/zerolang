# An arm whose payload is the sum itself (`more: Chain`) narrows the subject to
# that payload: a nested match reads the inner value. A write in the arm ends
# the narrowing, and later reads see the whole local.
Chain: union {
    last: i64
    more: Chain
}

depth: function {c: Chain} out i64 is {
    match (c) case last then return 0 case more then return 1 + (depth c: c)
}

main: function is {
    c: Chain.last 5
    d: Chain.more c
    match (d) case last then print "last \{d}" case more then {
        match (d) case last then print "inner last \{d}" case more then print "deeper"
    }
    e: Chain.more (Chain.more (Chain.last 7))
    print "\{depth c: e}"
    f: Chain.more (Chain.last 1)
    match (f) case more then {
        f = Chain.last 9
        match (f) case last then print "rewritten \{f}" case more then print "still more"
    } case last then print "last"
}
