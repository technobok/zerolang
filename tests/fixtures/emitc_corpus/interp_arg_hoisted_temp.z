# An interpolated string written inline as a call's argument is built in a
# statement expression of its own, and a part that reads a call's OWNED result
# through `.stringView` hoists that result into a temporary inside it. The
# temporary was owed to the expression's own counter, which nothing drained, so
# every such call leaked the result; the leak kind reports it.
mk: function out String is {
    return "0.1.0"
}

echo: function {s: StringView} out String is {
    return s.string
}

main: function is {
    t: String
    t.append "v: \{echo s: mk.stringView}"
    print t
}
