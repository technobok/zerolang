# A TYPE'S `as` CONSTANTS are its constants the way a unit's are: folded when the
# type resolves, typed by their value, and inlined at every read. Only a bare
# integer in an interpolation used to work -- each constant was a fake record
# type named after its literal, so `pi` printed 3, a binding or an argument was
# invalid C or "expected i64, got i64", and a string, an expression, a suffixed
# literal or another constant was "no member". The type's `as` and `is` members
# are one scope for these expressions, searched first, forward references
# included, so a sibling hides a unit constant of the same name; an `if` is a
# value as at unit level. Another unit's are user_unit_type_constants.
page_size: 4096
max_val: 1

config: record {
    x: i64
} as {
    max_val: 100
    pi: 3.14159
    buffer_size: 16 * 1024
    limit: page_size
    greeting: "hello"
    small: 7.u8
    derived: later + 1
    later: max_val * 2
    large: max_val > 50
    head: (greeting.substring from: 0 to: 3)
    glen: greeting.length
    pick: if max_val > 10 then { 1 } else { 2 }
    mode: kind.fast
    outer: max_val
}

kind: variant {
    fast: null
    slow: null
} as {
    COUNT: 2
}

Shape: union {
    circle: String
    none: null
} as {
    SIDES: 0
}

Holder: class {
    n: i64
} as {
    CAP: config.max_val + 8
    sized: function {t: this.view} out i64 is {
        return Holder.CAP + t.n
    }
}

Reader: protocol {
    read: function {:this} out i64
} as {
    CHUNK: 512
}

Measure: facet {
    size: function {:this} out i64
} as {
    UNIT: 1.5
}

AFTER: config.max_val + 1

show: function {n: i64} is {
    print "show \{n}"
}

main: function is {
    print "\{config.max_val} \{config.pi} \{config.buffer_size} \{config.limit}"
    print "\{config.greeting} \{config.small} \{config.derived} \{config.later}"
    print "\{config.large} \{config.head} \{config.glen} \{config.pick}"
    bound: config.max_val
    show n: config.max_val
    sum: config.max_val + 1
    if config.max_val > 10 then print "big \{bound} \{sum}" else print "small"
    g: config.greeting
    m: config.small + 1.u8
    if config.mode == kind.fast then print "fast \{g.length} \{m}" else print "slow"
    h: Holder n: 2
    print "\{h.sized} \{kind.COUNT} \{Shape.SIDES} \{Reader.CHUNK} \{Measure.UNIT} \{AFTER}"
    print "\{config.outer} \{max_val}"
}
