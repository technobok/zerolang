# A unit-level constant may guard on the target: each of z.build's values folds
# here, where the main unit's definitions resolve. Each line compares the
# unit-level answer with the same question asked in a body, so the output is
# the same on every host.
IS_LINUX: (if z.build.os.linux then { 1 } else { 0 })
IS_X86: (if z.build.arch == z.build.archkind.x86_64 then { 1 } else { 0 })
TRIPLE: z.build.triple
OS: z.build.os
FAMILY: (if OS.windows then { 1 } else if OS.darwin then { 2 } else { 3 })

main: function is {
    linux: if z.build.os.linux then { 1 } else { 0 }
    x86: if z.build.arch == z.build.archkind.x86_64 then { 1 } else { 0 }
    family: if z.build.os.windows then { 1 } else if z.build.os.darwin then { 2 } else { 3 }
    print "os \{IS_LINUX == linux} arch \{IS_X86 == x86}"
    print "family \{FAMILY == family} triple \{TRIPLE == z.build.triple}"
}
