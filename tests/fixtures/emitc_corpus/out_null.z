# out_null.z -- `out null` names the absence of a return, exactly as no `out`
# does: a body ends on no value, `return null` or a call answering nothing
# hands back nothing, either form implements a spec's `out R` where R is null,
# and a generic instance whose `out R` is null returns what its call gives.

# Job -- something that answers an R
Job: protocol {
    call: function {:this} out R
} as {
    R: AnyRef.generic
}

# Quiet -- answers nothing, written with no `out`
Quiet: class { n: i64 } as {
    job: (Job null)
    call: function {:this} is { print "quiet \{this.n}" }
}

# Said -- answers nothing, written `out null`, returning on purpose
Said: class { n: i64 } as {
    job: (Job null)
    call: function {:this} out null is {
        if this.n > 1 then return null
        print "said \{this.n}"
    }
}

# run -- runs any Job, answering its R
run: function {j: J.take} out R is {
    return j.call
} as {R: AnyRef.generic J: (Job R).generic}

# note -- answers nothing, its body ending on a call that answers nothing
note: function {msg: StringView} out null is {
    print msg
}

main: function is {
    run j: (Quiet n: 1)
    run j: (Said n: 1)
    run j: (Said n: 2)
    note msg: "noted"
}
