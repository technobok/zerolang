# `print` takes a view: a String it is handed that no name holds is freed after
# printing only when it is owned. An element read out of a list is the list's
# own storage, printed and left in place.
mkText: function {n: i64} out String is {
    return "made \{n}"
}

main: function is {
    l: List String
    l.append from: "first".string
    l.append from: "second".string
    print (l.get i: 0)
    print (l.get i: 1)
    print (mkText n: 3)
    print "still \{l.get i: 0} \{l.length}"
}
