# typedef_record_zero.z -- a typedef's bare zero is its base's zero: a record
# base builds the record with its field defaults, a String base the empty
# String, a scalar base the scalar's zero. A record base used to come out as a
# scalar cast of the struct, which the C compiler refuses.
pt: record {
    x: i64
    y: 3
}

spot: typedef pt
Label: typedef String
meters: typedef i64

main: function is {
    s: spot
    l: Label
    m: meters
    print "s=\{s.x},\{s.y} l=[\{l.length}] m=\{m.i64}"
}
