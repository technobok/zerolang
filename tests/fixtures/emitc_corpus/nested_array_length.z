# AN ARRAY'S `length` REACHED THROUGH A FIELD is its size parameter, as it is on a
# local. The array struct stores no length, and a read through a field -- or
# through a call's result -- spelled one anyway: `b.h.arr.length` emitted
# `z_v7.h.arr.length` and the C compiler refused it.
holder: record {
    arr: (array t: i64 to: 4)
    raw: (str to: 8)
}

box: class {
    h: holder
    sizes: function {:this} out u64 is {
        return this.h.arr.length + this.h.raw.size
    }
}

mk: function out box is {
    return (box h: (holder arr: (array t: i64 to: 4) raw: (str to: 8)))
}

main: function is {
    b: mk
    n: 0.u64
    n = b.h.arr.length
    print "\{n} \{b.h.raw.length} \{b.h.raw.size} \{b.sizes} \{(mk).h.arr.length}"
}
