# generator_accepts_param.z -- a generator whose per-call input is a borrowed
# reftype, driven with `g.call bag: <p>` where p is a Bag PARAM (already a
# pointer). emitUserIterCall emitted &p (a Bag**) for the input; a local source
# correctly needs the &.

Bag: class {
    x: i64
}

Peek: generator { n: i64 } as {
    call: function {bag: Bag.borrow} out i64 is {
        yield 1
        b: yield 2
        yield b.x
    }
}

drive: function {p: Bag} out i64 is {
    total: 0
    with g: (Peek n: 0) do {
        a: g.call bag: p
        b: g.call bag: p
        c: g.call bag: p
        match (
            c
        ) case some then {
            total = c
        } case none then {}
    }
    return total
}

main: function is {
    bag: Bag x: 42
    r: drive p: bag
    print "r=\{r}"
}
