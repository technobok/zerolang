# typedef_generic_instance.z -- an instance of a GENERIC typedef wraps the
# instance of its base: `Bag t: String` is a `List String` with Bag's own
# members. The base's members forward per instance, the typedef's own methods
# are checked per instance and win over the base's, an instance passes where
# its base instance is wanted, and a typedef over an instance of another
# generic typedef forwards through both.
# No instance of a generic typedef had any member: the template's base never
# resolved, so there was nothing to substitute.
Bag: typedef (List t) as {
    t: AnyRef.generic
    first: function {this: this.view} out u64 is {
        return this.length
    }
}

Nums: typedef (ListVal t) as {
    t: anyval.generic
    depth: function {this: this.view} out u64 is {
        return this.length
    }
    length: function {this: this.view} out u64 is {
        return 42
    }
}

Index: typedef (MapVR k V: v) as {
    k: anyval.generic
    v: AnyRef.generic
}

Ages: typedef (MapRV String v: v) as {
    v: anyval.generic
}

Bag2: typedef (Bag t) as {
    t: AnyRef.generic
    twice: function {this: this.view} out u64 is {
        return this.first * 2
    }
}

Names: typedef (Bag t: String)
Shelf: class {
    items: (Bag t: String)
}

count: function {b: (Bag t: String).view} out u64 is {
    return b.length
}

takesList: function {l: (List String).view} out u64 is {
    return l.length
}

main: function is {
    b: Bag t: String
    b.append from: "x".string
    print "bag \{b.length} \{b.first} \{count :b} \{takesList l: b}"
    n: Nums t: i64
    n.append from: 4
    n.append from: 5
    print "nums \{n.length} \{n.depth} \{n.get i: 1}"
    m: Index k: i64 v: String
    m.set key: 1 value: "one".string
    a: Ages v: i64
    a.set key: "a".string value: 1
    print "maps \{m.length} \{a.length}"
    c: Bag2 t: String
    c.append from: "y".string
    c.append from: "z".string
    s: Names
    s.append from: "w".string
    print "chain \{c.length} \{c.first} \{c.twice} \{s.first}"
    x: Shelf items: (Bag t: String)
    x.items.append from: "v".string
    print "field \{x.items.length}"
}
