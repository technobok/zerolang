# A CALL'S VALUE IS EVALUATED ONCE where the emitter reads a view's data and its
# size. Each callee below announces itself, so a call spelled twice shows up
# twice: an interpolated StringView call ran twice, a bare zero-argument String
# function ran twice and leaked both results, and so did a StringView call
# appended to a String and a call converted with `.str`. The call is bound to a temp
# first. A StringView call as an operand of `+` was not an lvalue for `&`, and
# a bare function name given to `print` was spelled as the function's name.
# The parts run left to right, and so do the operands of a part that is an
# operation.
sv: function out StringView is {
    print "[sv]"
    return "x"
}

sv2: function {n: i64} out StringView is {
    print "[sv2 \{n}]"
    return "y"
}

tick: function {n: i64} out i64 is {
    print "[tick \{n}]"
    return n
}

mk: function out String is {
    print "[mk]"
    return "m".string
}

Obj: class {
    tag: String
} as {
    name: function {t: this.view} out StringView is {
        print "[name]"
        return "o"
    }
}

main: function is {
    print "\{sv} \{sv2 n: 1} \{(sv)}"
    print "\{mk}"
    o: Obj tag: "t".string
    print "\{o.name}"
    print "\{if o.tag.length > 0 then sv else "z"}"
    b: "".string
    b.append sv
    b.append (sv2 n: 2)
    b.append o.name
    print "\{b}"
    c: sv.str to: 8
    d: mk.str to: 8
    print "\{c} \{d}"
    joined: sv + "!"
    joinedR: "!" + sv
    print "\{joined} \{joinedR}"
    print sv
    print mk
    print "\{(tick n: 1) + (tick n: 2)} \{tick n: 3} \{(tick n: 4) * (tick n: 5) - (tick n: 6)}"
}
