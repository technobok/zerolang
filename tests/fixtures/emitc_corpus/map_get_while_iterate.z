# Reading a map while iterating it: the iterator's receiver is `.view`, so the
# pin it holds is READONLY -- `get` and `length` pass, and only mutation is
# refused (map_remove_while_iterate). This is the motivating case for the
# readonly pin.
main: function is {
    m: (Map String value: String)
    m.set key: "a".string value: "x".string
    m.set key: "b".string value: "y".string
    with it: m.iterate do for k: it loop {
        v: m.get key: k.copy
        match (
            v
        ) case some then {
            print "k=\{k} v=\{v} of \{m.length}"
        } case none then {
            print "k=\{k} missing"
        }
    }
}
