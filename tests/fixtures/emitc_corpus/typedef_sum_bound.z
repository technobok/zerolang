# A sum bound admits a typedef when the typedef, or any type up its chain, is
# one of its arms' types: the chain is walked one base at a time, so a typedef
# over a typedef meets the arm its root names. The parameter binds the typedef
# itself, never its base. The same holds for a union's arm, and for `idkey`,
# an ordinary variant bound, so an id space and a list index may be a typedef
# over a typedef.
meters: typedef u32
cm: typedef meters
wide: variant { :u32 :u64 }

Cell: class { v: i64 }
Wrap: typedef Cell
holders: union { :Cell :String }

rowid: typedef u32
subrow: typedef rowid
marks: list { a: 9 b: 10 c: 11 } out (staticlist u8 i: subrow)

# the value itself, typed as the argument was
same: function as { t: wide.generic } in {x: t} out t is {
    return x
}

# the centimetres given, unchanged: the parameter type proves the binding
centimetres: function {v: cm} out u32 is {
    return v.u32
}

# a value a holder bound admits, read as 1
held: function as { t: holders.generic } in {x: t.view} out i64 is {
    return 1
}

main: function is {
    m: meters 7
    c: cm (meters 9)
    print "\{(same x: m).u32} \{centimetres v: (same x: c)} \{same x: 5.u64}"
    print "\{held x: (Wrap (Cell v: 3))}"
    ids: IdMapV subrow v: i64
    ids.set key: (subrow (rowid 3)) value: 30
    print "\{ids.length} \{marks.get i: (subrow (rowid 2))}"
}
