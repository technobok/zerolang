# generic_unit_instance_over_param -- a generic unit's alias that instantiates
# another unit template over the unit's own parameter (`pu: (pairs u: t)`) is,
# in each instance, that template's instance at the instance's argument, built
# with its members as every unit instance is. It used to be minted without
# them: a use read "unit 'pairs_f64' has no member 'both'", and a unit that
# did not use it sent the compiler round its instance walk for ever.
pairs: unit as {
    u: anyval.generic
    both: function {a: i64 b: u} out u is { return b }
}

wrap: unit as {
    t: anyval.generic
    pu: (pairs u: t)
}

wf: (wrap t: f64)
wb: (wrap t: bool)

main: function is {
    print "\{wf.pu.both a: 5 b: 2.5} \{wb.pu.both a: 5 b: true}"
}
