# generic_unit_nested.z -- a namespace is a scope for instantiations too.
# `inner` instantiates a template declared at file level; `outer` declares its
# own template and instantiates it beside it. Collection used to descend one
# level only, so neither binding was ever collected and both read as malformed
# unit constants.
mathops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
}

inner: unit {
    intmath: (mathops t: i64)
}

outer: unit {
    pairops: unit as {
        t: anyval.generic
        twice: function {v: t} out t is { return v + v }
    }
    i32pair: (pairops t: i32)
}

main: function is {
    print "inner.intmath.add=\{inner.intmath.add a: 3 b: 5}"
    print "outer.i32pair.twice=\{outer.i32pair.twice 21}"
}
