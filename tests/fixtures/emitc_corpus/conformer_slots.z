# A conformer written where a spec is expected is boxed as the spec wherever it
# stands, as `Sz.create from: r` would box it: the checker records each stand-in
# and the emitter boxes it at every slot. Covered for a FACET (the matrix covers
# the protocol Rd): a method argument, a construction field, a list element, a
# reassignment -- and an interpolated literal handed to a `Text` parameter, which
# String conforms to.
Sz: facet {
    sz: function {t: this.view} out i64
}

R: record { n: i64 } as {
    :Sz
    sz: function {r: this.view} out i64 is { return r.n }
}

U: class { k: i64 } as {
    useS: function {:this s: Sz} out i64 is { return s.sz + this.k }
}

H: class { s: Sz }

useT: function {t: Text} out u64 is { return t.stringView.length }

main: function is {
    u: U k: 0
    a: u.useS s: (R n: 1)
    h: H s: (R n: 2)
    xs: ListVal Sz
    xs.append (R n: 3)
    s: Sz.create from: (R n: 0)
    r: R n: 4
    s = r
    n: 12
    print "\{a} \{h.s.sz} \{(xs.get i: 0).sz} \{s.sz} \{useT t: "ab\{n}"}"
}
