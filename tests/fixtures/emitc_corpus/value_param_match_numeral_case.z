# value_param_match_numeral_case -- A compile-time match over a VALUE parameter takes
# the first case whose name is the bound numeral: a case that is no integer numeral
# names no value.
Box: class {
    used: u32
    which: function {:this} out StringView is {
        match cap case other then {
            return "other"
        } case 0 then {
            return "zero"
        } else {
            return "else"
        }
    }
} as { cap: u32.generic }

main: function is {
    b: (Box cap: 0) used: 0
    c: (Box cap: 9) used: 0
    print "\{b.which} \{c.which}"
}
