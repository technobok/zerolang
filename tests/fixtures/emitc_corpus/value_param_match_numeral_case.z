# value_param_match_numeral_case -- A compile-time match over a VALUE parameter takes
# the case whose name is the bound numeral, else the else. (A case that is no
# integer numeral names no value and is refused: errors/value_param_match_non_numeral.)
Box: class {
    used: u32
    which: function {:this} out StringView is {
        match cap case 7 then {
            return "seven"
        } case 0 then {
            return "zero"
        } else {
            return "else"
        }
    }
} as { cap: u32.generic }

main: function is {
    b: (Box cap: 0) used: 0
    c: (Box cap: 9) used: 0
    print "\{b.which} \{c.which}"
}
