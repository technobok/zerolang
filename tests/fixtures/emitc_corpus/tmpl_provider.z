# tmpl_provider.z -- a dependency unit that only DECLARES a generic template,
# for another unit to instantiate through a dotted callable. It never
# instantiates its own, so nothing here names the mono.
mathops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
    double: function {v: t} out t is { return v + v }
}
