# data_holders.z -- a data value is a valtype, so runtime code holds it anywhere a
# valtype goes: a ListVal (iterated and indexed), a MapVV value and key, a
# SetVal, an optionval, a record field, and a generic function's parameter. Each
# holds the handle; nothing copies the value or frees it.
inner: data { v: u8 tag: "t".text }
x: (inner v: 2 tag: "two")
y: (inner v: 7 tag: "seven")
holder: record { r: inner n: u8 }

ident: function as { t: anyval.generic } in {a: t} out t is { return a }

main: function is {
    xs: ListVal inner
    xs.append x
    xs.append y
    for each e: xs loop print "\{e.v} \{e.tag.stringView}"
    g: xs.get i: 1
    print "\{g.v}"
    m: MapVV text v: inner
    m.set key: "a" value: x
    got: m.get key: "a"
    match got case some then print "\{got.v}" case none then print "none"
    o: optionval.some y
    match o case some then print "\{o.v}" case none then print "none"
    h: holder r: x n: 1
    print "\{h.r.v} \{h.r.tag.stringView}"
    z: ident a: y
    print "\{z.v}"
    s: SetVal inner
    s.add x
    print "\{s.has item: x} \{s.has item: y}"
    k: MapVV inner v: u8
    k.set key: y value: 9
    print "\{(k.get key: y).or d: 0}"
}
