# A 2-arm sum type answers as a condition: it holds either its falsy arm --
# the one its declaration writes FIRST -- or the other one. `if x` is true
# when it does not hold the falsy arm.
#
# bool is the stdlib instance of the shape (`variant { false: null true: null }`),
# and a user variant that follows the falsy-first convention reads the same way.
mood: variant { sad: null  happy: null }

main: function is {
    s: mood.sad
    if s then print "sad truthy" else print "sad falsy"
    h: mood.happy
    if h then print "happy truthy" else print "happy falsy"

    # a payload-carrying pair: the lossy numeric conversion's resultval, whose
    # falsy arm is `err`. `if` reads as "did the conversion succeed".
    small: 5.u64
    if small.u32 then print "small fits" else print "small overflows"
    big: 999999999999.u64
    if big.u32 then print "big fits" else print "big overflows"

    # a generic MONO: the arm record lives on the optionval template it was
    # minted from, so the condition has to follow the origin to find it.
    mp: (MapVV u64 value: u64)
    mp.set key: 1 value: 2
    hit: mp.get key: 1
    if hit then print "hit" else print "no hit"
    miss: mp.get key: 9
    if miss then print "found miss" else print "no miss"

    # NARROWING: `if x` states the same fact `if x.<arm>` states, so the then
    # branch sees the payload through the bare name and the else branch still
    # sees the whole sum.
    if hit then print "narrowed to \{hit}" else print "not narrowed"
    if miss then {
        print "BAD: miss narrowed to \{miss}"
    } else {
        match (
            miss
        ) case some then {
            print "BAD: some in the else branch"
        } case none then {
            print "else branch still holds the sum"
        }
    }
    conv: 5.u64
    okv: conv.u32
    if okv then print "conversion yielded \{okv}"

    # the same rule in both loop positions
    n: 0.u64
    for while n.u32 loop {
        n = n + 1
        if n > 2 then break
    }
    print "pre-condition loop ran to \{n}"
    k: 0.u64
    for loop {
        k = k + 1
        if k > 2 then break
    } while k.u32
    print "post-condition loop ran to \{k}"
}
