# A returned view whose storage outlives the call is legal: a view of a
# parameter or of the receiver (through `outx`), a slice of a view parameter
# (through `outx`), a string literal, and a view read through a local that
# borrows from a parameter.

first: function {p: String} outx StringView is {
    return p.stringView
}

head: function {p: StringView} outx StringView is {
    return (p.substring from: 0 to: 1)
}

label: function out StringView is {
    return "static"
}

Bag: class {
    items: List String
} as {
    firstItem: function {t: this.view} outx StringView is {
        got: t.items.get i: 0
        return got.stringView
    }
}

mkbag: function out Bag is {
    b: Bag items: (List String)
    b.items.append from: "one".string
    return b
}

main: function is {
    q: "zz".string
    print (first p: q)
    print (head p: "abc")
    print (label)
    g: mkbag
    print g.firstItem
    print (label).trim
}
