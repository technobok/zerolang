# A STRING CONSTANT READ AS A VALUE: bound, compared, converted, and folded
# where a unit-level definition requires a value. The same constant as a
# method receiver in a body is string_constant_receiver.
GREETING: "hello, world"
SHOUT: GREETING + "!"
N: GREETING.length
HAS: GREETING.contains "lo, w"
HEAD: (GREETING.substring from: 0 to: 5)
HEADLEN: (GREETING.substring from: 0 to: 5).length
OTHER: text_consts.NAME.length

main: function is {
    v: GREETING
    owned: GREETING.string
    same: GREETING == "hello, world"
    print "\{v} \{owned} \{same} \{SHOUT}"
    print "\{N} \{HAS} \{HEAD} \{HEADLEN} \{OTHER}"
    if GREETING.startsWith "hello" then print "starts" else print "no"
    with w: GREETING do print "\{w.length}"
    x: "?"
    x = GREETING
    word: (text_consts.FULL.substring from: 0 to: 4)
    print "\{x.length} \{text_consts.FULL.count} \{word}"
}
