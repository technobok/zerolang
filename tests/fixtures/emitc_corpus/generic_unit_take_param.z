# A GENERIC UNIT INSTANCE'S FUNCTION TAKES WHAT ITS TEMPLATE TAKES. The
# instance's parameters were given the template's types but not its ownership,
# so a `.take` parameter left the caller freeing the String it had handed over
# -- a double free.
boxes: unit as {
    T: AnyRef.generic
    keepIt: function {v: T.take} out T is {
        return v
    }
}

bs: (boxes T: String)

main: function is {
    o: bs.keepIt v: "x".string
    print o
}
