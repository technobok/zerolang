# A generic bound admits one family, but a protocol VALUE holds either: a
# record and a `str` conform to protocols and are held as `Named` and `Text`
# values, while the generic parameter bounded by `Named` takes the class. A
# `str` reaches a StringLike parameter as its `stringView`.
Named: protocol {
    label: function {t: this.view} out i64
}

pt: record { x: i64 } as {
    :Named
    label: function {t: this.view} out i64 is { return t.x }
}

Cell: class { n: i64 } as {
    :Named
    label: function {t: this.view} out i64 is { return t.n }
}

show: function as { T: Named.generic } in { v: T.view } is {
    print "\{v.label}"
}

useN: function {n: Named} out i64 is { return n.label }

measure: function {t: Text} out u64 is { return t.stringView.length }

main: function is {
    c: Cell n: 1
    show v: c
    print "\{useN n: (pt x: 2)} \{useN n: c}"
    g: "hello".str to: 16
    print "\{measure t: g}"
    print g.stringView
    h: "hello".string
    if h == g.stringView then print "eq"
}
