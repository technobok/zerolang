# A compile-time `match` over a type parameter takes the arm whose written type
# IS the bound type, the name resolved where the template writes it. The arm was
# chosen by the bound type's NAME, so another unit's `Point` took the arm written
# for this program's `Point`, and the builtin `i64` took the arm written for the
# program's own `i64` record.
Point: record { x: u8 }

i64: record { x: u8 }

kind: function as { t: anyval.generic } in {v: t} out String is {
    return (match (t) case Point then "this Point".string case i64 then "this i64".string else "other".string)
}

main: function is {
    print "\{kind v: (Point x: 1)}"
    print "\{kind v: dissect_by_type_lib.mk}"
    print "\{kind v: (i64 x: 1)}"
    print "\{kind v: 5.i64}"
    print "\{kind v: true}"
}
