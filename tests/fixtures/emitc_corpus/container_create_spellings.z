# EVERY CONTAINER IS CONSTRUCTED BY ITS `create`, whichever way the construction
# is written: the sugar, the parenthesised type with a labelled or positional
# capacity, and the explicit `.create` with a labelled, positional or no
# capacity. `.create` reached the C with the template's type on every family, or
# with the wrong argument count on the maps, sets and id containers.
main: function is {
    a: (ListVal t: i64).create
    b: (ListVal t: i64).create capacity: 8
    c: (ListVal t: i64).create 8
    d: (ListRef T: String).create capacity: 4
    e: (MapVV k: i64 v: i64).create
    f: (MapRR K: String V: String).create capacity: 4
    g: (MapRV K: String v: i64).create 4
    h: (MapVR k: i64 V: String).create
    i: (SetVal k: i64).create capacity: 4
    j: (SetRef K: String).create
    k: (IdMapV k: u32 v: i64).create capacity: 4
    l: (IdMapR k: u32 V: String).create
    m: (IdSet k: u32).create 4
    b.append 1
    e.set key: 1 value: 2
    print "\{a.length} \{b.length} \{b.capacity >= 8} \{c.capacity >= 8} \{d.capacity >= 4}"
    print "\{e.length} \{f.length} \{g.length} \{h.length} \{i.length} \{j.length} \{k.length} \{l.length} \{m.length}"
}
