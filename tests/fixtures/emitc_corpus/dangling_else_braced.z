# dangling_else_braced.z -- both readings of the dangling else, written out.
#
# `if a then if b then x else y` used to parse, binding the `else` to the INNER
# `if` because that clause's tail consumed it first -- deterministic, and
# invisible to a reader. A bare `if` or `match` is now refused as a `then` or
# `case` body, so the two readings have to be spelled apart. They are both here
# and they differ: `inner` runs its else, `outer` runs nothing.
#
# The rest of the clause-body grammar is exercised alongside, because the same
# production carries it: reassignment, swap, a call, a binop, `then null`, and
# `else if` -- which needs no braces, since by then the enclosing `if` has
# already taken its own `else`.

main: function is {
    a: 0
    b: 5
    c: 1

    # the else belongs to the INNER if
    if b > 3 then { if b > 99 then a = 1 else a = 2 }
    print "inner: a=\{a}"

    # the else belongs to the OUTER if
    a = 0
    if b > 3 then { if b > 99 then a = 1 } else a = 2
    print "outer: a=\{a}"

    # else if needs no braces: one candidate owner by construction
    if b > 99 then a = 4 else if b > 3 then a = 5 else a = 6
    print "chain: a=\{a}"

    # the other clause-body forms
    if b > 3 then a swap c
    if b > 3 then print "call body"
    if b > 3 then a = a + c
    if b > 3 then null else null
    print "rest: a=\{a} c=\{c}"
}
