# static_text_default.z -- an untyped string in a static position is text: a
# data field written `body: ""` is a text field, and a list of untyped strings
# is a `staticlist text`, which a data field of that type takes by name. A
# folded read of such an element is the literal it was written as, so it lands
# in a StringView slot and in a text slot alike; a read at run time is text,
# and reaches a StringView through `.stringView`.
row: data {
    body: ""
    tags: staticlist text
}
words: list { first: "alpha" second: "beta" }
a: (row body: "hello" tags: words)
b: (row tags: list { "x" })

viewLength: function {s: StringView} out u64 is {
    return s.length
}

textLength: function {s: text} out u64 is {
    return s.length
}

count: function {d: staticlist text} out u64 is {
    return d.length
}

main: function is {
    print words.first
    print "\{viewLength s: words.second} \{textLength s: words.first} \{count d: words}"
    print "\{textLength s: a.body} \{textLength s: b.body} \{count d: a.tags} \{count d: b.tags}"
    print a.body.stringView
    w: words
    for each e: w loop print e.stringView
    r: b
    print "\{r.tags.length} \{textLength s: (r.tags.get i: 0)}"
}
