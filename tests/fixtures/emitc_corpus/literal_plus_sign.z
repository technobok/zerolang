# literal_plus_sign.z -- `+` is a decimal literal's sign as `-` is: a value, an
# argument, a conversion's receiver and a parameter default.

half: function {n: i64 by: +2} out i64 is {
    return n / by
}

main: function is {
    a: +5
    print "plus: \{a} \{a + 1}"
    print "arg: \{half n: +42}"
    print "float: \{+1.5}"
    w: (+200).u8
    print "u8: \{w}"
}
