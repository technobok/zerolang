# A borrowed local or parameter keeps its mode: `x = v` RE-POINTS it at what
# `v` borrows -- nothing is written through it and nothing freed. Every shape
# a borrow comes in re-points: a class through its alias, a parameter's
# pointer (the caller's value untouched), a `.view` parameter, `.borrow`, a
# field read, an element a call hands back, a view, a borrowed protocol box,
# a map's pointer, a String. Written in the borrow's own scope the re-point
# releases the old source (`a` is written after); in a loop it re-points each
# iteration.
Cell: class { n: i64  s: String }
H: class { f: Cell }
Rd: protocol {
    rdn: function {t: this.view} out i64
}
PC: class { n: i64  s: String } as {
    :Rd
    rdn: function {c: this.view} out i64 is { return c.n }
}
viaParam: function {p: Cell} out i64 is {
    d: Cell n: 90 s: "d".string
    p = d
    p.n = p.n + 1
    return d.n
}
viewParam: function {q: Cell.view r: Cell.view} out i64 is {
    q = r
    return q.n
}
main: function is {
    a: Cell n: 1 s: "a".string
    d: Cell n: 2 s: "d".string
    b: a
    b = d
    b.n = 20
    a.n = 10
    print "local \{a.n} \{d.n}"
    print "param \{viaParam p: a} \{a.n} view \{viewParam q: a r: d}"
    e: Cell n: 3 s: "e".string
    c: a
    i: 0
    for i < 2 loop {
        c = e.borrow
        c.n = c.n + 1
        i = i + 1
    }
    print "loop \{c.n}"
    h: H f: (Cell n: 4 s: "f".string)
    f: d
    f = h.f
    print "field \{f.n}"
    xs: List Cell
    xs.append (Cell n: 5 s: "x5".string)
    xs.append (Cell n: 6 s: "x6".string)
    g: xs.get i: 0
    g = xs.get i: 1
    print "get \{g.n}"
    ys: ListVal i64
    ys.append from: 1
    zs: ListVal i64
    zs.append from: 2
    zs.append from: 3
    lv: ys.listView
    lv = zs.listView
    print "view \{lv.length}"
    pa: PC n: 7 s: "p".string
    pb: PC n: 8 s: "q".string
    pr: Rd pa
    pr = Rd pb
    print "box \{pr.rdn}"
    m1: (MapRV String v: i64)
    m1.set key: "a".string value: 1
    m2: (MapRV String v: i64)
    m2.set key: "b".string value: 2
    m2.set key: "c".string value: 3
    bm: m1
    bm = m2
    print "map \{bm.length}"
    s1: "one".string
    s2: "three".string
    bs: s1
    bs = s2
    print "string \{bs}"
}
