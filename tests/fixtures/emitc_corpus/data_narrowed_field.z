# data_narrowed_field.z -- a field read on a data value that `if` narrowed out of
# a sum: an optionval and a choice, in the then branch, in the else branch, and
# after a guard that returns. A data value is a handle, so each read goes
# through the pointer the sum holds.
part: data {
    name: text
    count: 1
}
bolt: (part name: "bolt" count: 40)
shape: choice {
    none: null
    one: part
}
held: (shape.one bolt)
pair: data {
    left: part
    right: 2
}
both: (pair left: bolt)

find: function {want: bool} out optionval part is {
    if want then return (optionval.some bolt)
    return (optionval t: part).none
}

guarded: function {o: optionval part} out i64 is {
    if o.none then return 0
    return o.count
}

main: function is {
    h: held
    if h.one then print "choice \{h.count} \{h.name.stringView}"
    o: find want: true
    if o.some then print "some \{o.count}"
    if o.none then print "none" else print "else \{o.count}"
    print "guarded \{guarded :o} \{guarded o: (find want: false)}"
    p: optionval.some both
    if p.some then print "nested \{p.left.count} \{p.right}"
}
