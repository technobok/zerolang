# choice_construct.z -- a choice value that carries a value is built in a
# static position, in parentheses: as a unit constant, as a data field's value,
# or inside another choice value. Its value folds to the arm and the value it
# carries, so an arm predicate and `==` read through it fold too -- exactly,
# for an untyped number -- and the value itself is never emitted.
inner: data { v: u8 }

form: choice {
    call: null
    template: text
    count: intliteral
    sub: inner
}

bag: choice {
    empty: null
    nums: staticlist u8
}

outer: choice {
    none: null
    wrap: form
}

row: data {
    kind: form
    alt: form.call
}

a: (form.template "x{}")
b: (form.template "x{}")
c: (form.count 100000000000000000000)
d: (form.count 100000000000000000001)
e: (form.sub (inner v: 3))
f: (bag.nums list { 1 2 3 })
e3: (form.sub (inner v: 3))
r: (row kind: (form.count 7))
w: (outer.wrap (form.template "w"))
notCall: a == form.call

main: function is {
    print "\{a.template} \{a.call} \{a == b} \{a == c} \{c == d} \{c != d}"
    print "\{e.sub} \{f.nums} \{r.kind.count} \{r.alt.call} \{w.wrap} \{w.none}"
    print "\{notCall} \{r.alt == form.call} \{e == e3} \{f.empty}"
}
