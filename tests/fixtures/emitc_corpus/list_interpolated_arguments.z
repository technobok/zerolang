# A List method's String argument may be an interpolation or an owned temporary:
# `set` and `insert` take it over, `contains` reads it and releases it after the
# statement. Built in either label order.
mks: function {n: i64} out String is {
    return "m\{n}"
}

main: function is {
    x: 3
    ls: List String
    ls.append from: "a\{x}"
    old: ls.set i: 0 val: "v\{x}"
    old2: ls.set val: "w\{x}" i: 0
    ls.insert from: "i\{x}" at: 0
    ls.insert at: 1 from: "j\{x}"
    print "\{old} \{old2} \{ls.get i: 0} \{ls.get i: 1} \{ls.get i: 2}"

    has: ls.contains item: "j\{x}"
    missing: ls.contains item: "k\{x}"
    owned: ls.contains item: (mks n: 1)
    old3: ls.set i: 2 val: (mks n: 1)
    ls.insert from: (mks n: 2) at: 0
    found: ls.contains item: (mks n: 1)
    print "\{has} \{missing} \{owned} \{old3} \{found} \{ls.length}"

    c: ls.length > 3
    either: if c then ls.contains item: "m\{x - 2}" else false
    print "\{either}"
}
