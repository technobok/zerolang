# unit_path_create.z -- `T.create` at unit level, the data type named through
# an inline unit, two units deep and through an alias of the unit: every field
# takes its default.
runtime: unit {
    nativec: unit {
        link: data {
            library: "c".text
            weight: 1
        }
    }
}
inner: unit {
    part: data {
        count: 3
    }
}
c: runtime.nativec
direct: inner.part.create
deep: runtime.nativec.link.create
aliased: c.link.create

main: function is {
    print "\{direct.count} \{deep.weight} \{aliased.library.stringView}"
}
