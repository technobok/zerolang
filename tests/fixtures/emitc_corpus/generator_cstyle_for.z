# generator_cstyle_for.z -- a C-STYLE `for` binding whose loop body suspends.
#
# `for i: 0 while i < n loop` initialises `i` once and tests it per iteration,
# so the emitter writes `int64_t i = 0;` ahead of a `while`. The resume `goto`
# re-enters the loop PAST that line, leaving `i` indeterminate on the second
# `.call`: the loop yielded 0 once and then reported itself exhausted -- a wrong
# answer with no diagnostic, in the idiom `examples/forbind.z`, `factorial.z`
# and `fibonacci.z` all use. `IntRange` escaped it only by writing `i: this.lo`
# as a separate STATEMENT, which the crossing analysis does see.
#
# The binding is now hoisted to exactly that statement form, so it promotes to a
# state field like any other local. `U64s` proves the field is typed from the
# binding rather than assumed to be i64; `Twice` proves two sibling loops may
# share a name; `Nest` proves an inner suspending loop still works.

Count: generator { n: i64 } as {
    call: function out i64 is {
        for i: 0 while i < this.n loop {
            yield i
            i = i + 1
        }
    }
}

U64s: generator { n: u64 } as {
    call: function out u64 is {
        for i: 0.u64 while i < this.n loop {
            yield i
            i = i + 1.u64
        }
    }
}

Twice: generator { n: i64 } as {
    call: function out i64 is {
        for i: 0 while i < this.n loop {
            yield i
            i = i + 1
        }
        for i: 0 while i < this.n loop {
            yield i + 100
            i = i + 1
        }
    }
}

Nest: generator { n: i64 } as {
    call: function out i64 is {
        for a: 0 while a < this.n loop {
            for b: 0 while b < this.n loop {
                yield (a * 10) + b
                b = b + 1
            }
            a = a + 1
        }
    }
}

main: function is {
    for c: (Count n: 4) loop print "c: \{c}"
    for u: (U64s n: 3.u64) loop print "u: \{u}"
    for t: (Twice n: 2) loop print "t: \{t}"
    for g: (Nest n: 3) loop print "g: \{g}"
    print "done"
}
