# `Box from: v` builds a heap cell. Handed to a parameter that only borrows it,
# the box belongs to no one after the call and is released with the statement;
# it used to be leaked. Bound, taken by a parameter or returned, the box has an
# owner that releases it once.

peek: function {b: (Box t: u64)} out u64 is {
    return 7
}

keep: function {b: (Box t: u64).take} out u64 is {
    return 9
}

mkbox: function {n: u64} out (Box t: u64) is {
    return (Box from: n)
}

main: function is {
    a: peek b: (Box from: 7.u64)
    bound: Box from: 8.u64
    k: keep b: (Box from: 9.u64)
    r: mkbox n: 10
    c: false
    q: 1.u64 + (if c then (peek b: (Box from: 12.u64)) else 2)
    print "\{a} \{bound + 0} \{k} \{r + 0} \{q}"
}
