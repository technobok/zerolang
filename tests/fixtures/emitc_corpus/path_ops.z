# path_ops.z -- the path unit on the system the program is built for: roots,
# isAbsolute, dirname, baseName, clean and join over POSIX-, drive-, share-
# and verbatim-shaped paths. Windows reads them all as its own, POSIX only the
# first kind, so each system has its own golden.

show: function {p: StringView} is {
    print "[\{p}] abs=\{path.isAbsolute :p} root=[\{path.root :p}] dir=[\{path.dirname :p}] base=[\{path.baseName :p}] clean=[\{path.clean :p}]"
}

main: function is {
    print "sep=[\{path.separator}]"
    show p: ""
    show p: "/"
    show p: "a"
    show p: "a/b/c"
    show p: "/a/b/"
    show p: "a/../../b/./c//"
    show p: "/../x"
    show p: "C:\\x\\y"
    show p: "C:x"
    show p: "\\\\srv\\share\\d\\f.txt"
    show p: "\\\\?\\C:\\long\\p"
    show p: "\\x"
    print "join=[\{path.join a: "a/b" b: "../c"}] [\{path.join a: "a" b: "/abs"}] [\{path.join a: "" b: "x"}]"
}
