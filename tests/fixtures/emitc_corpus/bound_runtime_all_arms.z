# A value of a sum at run time may be any arm, so every arm is used: a `wide`
# variable reaches quadfloat and links libquadmath even when it holds an f64
# (bound_used_arms: as a bound only, it does not).
wide: variant { :f64  :f128 }

main: function is {
    w: wide.f64 1.5
    match (
        w
    ) case f64 then print "f64" case f128 then print "f128"
}
