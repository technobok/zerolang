# A borrow/view field may be initialised from a FIELD path of a borrow/view
# input -- the receiver's own field, a field of a parameter -- and not only
# from a bare parameter. The C stores such a field as a pointer while the
# source field is stored inline in its container, so the construction passes
# the source's address. Both construction forms are here: the bare type name
# and `meta.create` inside a `create`.
Src: class {
    n: i64
}

Holder: class {
    inner: Src
}

W: class {
    s: Src.borrow
    tag: i64
}

V: class {
    s: Src.view
    tag: i64
} as {
    create: function {src: Src.view tag: i64} outx this is {
        return (meta.create s: src :tag)
    }
}

Fac: class {
    base: Src
} as {
    fromThis: function {:this} outx W is {
        return (W s: this.base tag: 1)
    }
    fromView: function {t: this.view} outx V is {
        return (V.create src: t.base tag: 2)
    }
}

fromParamField: function {h: Holder.borrow} outx W is {
    return (W s: h.inner tag: 3)
}

main: function is {
    f: Fac base: (Src n: 10)
    {
        w: f.fromThis
        print "this.base: \{w.tag} \{w.s.n}"
    }
    {
        v: f.fromView
        print "t.base: \{v.tag} \{v.s.n}"
    }
    h: Holder inner: (Src n: 30)
    {
        w2: fromParamField h: h
        print "h.inner: \{w2.tag} \{w2.s.n}"
    }
}
