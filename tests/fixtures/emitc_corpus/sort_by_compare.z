# `sort` ORDERS A LIST BY THE ELEMENT'S OWN `compare` -- a total order as -1,
# 0 or 1. The integers, chars, bool and str carry a native one (answering
# `x.compare rhs: y` directly), String and StringView already did, and a
# record or a class sorts by the `compare` its author writes: `task` by
# priority, whatever its fields' bytes say. A record's list used to sort by
# its bytes, and a str's by its whole buffer. A float has no `compare`, and
# neither does a record that writes none: errors/sort_without_compare.
task: record {
    id: i64
    priority: u8
} as {
    compare: function {t: this.view rhs: task} out i32 is {
        return (t.priority.compare rhs: rhs.priority)
    }
}

Job: class {
    weight: i64
} as {
    compare: function {j: this rhs: Job} out i32 is {
        return (j.weight.compare rhs: rhs.weight)
    }
}

slot: record { val: u64.typedef }

main: function is {
    a: 3
    b: 7
    t: true
    print "i64: \{a.compare rhs: b} \{b.compare rhs: a} \{a.compare rhs: a}"
    print "bool: \{t.compare rhs: false} \{false.compare rhs: t}"
    s: "abc".str to: 8
    u: "abd".str to: 8
    v: "ab".str to: 8
    print "str: \{s.compare rhs: u} \{s.compare rhs: v} \{v.compare rhs: s} \{s.compare rhs: s}"

    tasks: ListVal task
    tasks.append from: (task id: 1 priority: 3)
    tasks.append from: (task id: 2 priority: 1)
    tasks.append from: (task id: 3 priority: 2)
    tasks.sort
    with ti: tasks.iterate do for x: ti loop print "task \{x.id} priority \{x.priority}"

    jobs: List Job
    jobs.append (Job weight: 20)
    jobs.append (Job weight: 10)
    jobs.sort
    with ji: jobs.iterate do for j: ji loop print "job \{j.weight}"

    names: ListVal (str to: 8)
    names.append from: ("pear".str to: 8)
    names.append from: ("fig".str to: 8)
    names.append from: ("figs".str to: 8)
    names.sort
    with ni: names.iterate do for n: ni loop print "name \{n.stringView}"

    slots: ListVal slot
    slots.append from: (slot.create from: 9)
    slots.append from: (slot.create from: 4)
    slots.sort
    with si: slots.iterate do for x: si loop print "slot \{x}"
}
