# text_view_param.z -- a readonly `StringViewable.view` parameter reads its bytes.
# The StringViewable spec declares `stringView: function {t: this.view} outx
# StringView`, so the call through a readonly parameter takes a shared lock:
# twice in one expression, on two parameters at once, and for a String, a str
# and a user class.

Label: class { data_: String } as {
    :StringViewable
    stringView: function {m: this.view} outx StringView is {
        return m.data_.stringView
    }
}

show: function {t: StringViewable.view} out u64 is { return t.stringView.length }

both: function {a: StringViewable.view b: StringViewable.view} out u64 is {
    return a.stringView.length + b.stringView.length
}

twice: function {t: StringViewable.view} out u64 is {
    return t.stringView.length + t.stringView.length
}

main: function is {
    s: "abc".string
    l: Label data_: "hello".string
    g: "fixed".str to: 16
    print "\{show t: s} \{show t: l} \{show t: g}"
    print "\{both a: s b: l} \{twice t: l}"
}
