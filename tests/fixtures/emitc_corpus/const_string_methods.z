# The statically evaluable string methods. Every answer is computed by calling
# the method the RUN TIME would call, so a folded result and a run-time one
# cannot disagree about an empty prefix, an empty needle, or a boundary index.
#
# Argument labels are optional, so both `startsWith prefix: P` and the bare
# positional `startsWith P` reach the same fold. At unit level a labelled call
# needs parentheses -- EOL ends a statement, so the bare form would read
# `prefix:` as a new definition.
#
# Every `if` here folds, so deadcode-guard is the second gate: an unfolded
# condition leaves the untaken branch in the C and clang reports it unreachable.

LIB: "quadmath"

LENOK: LIB.length == 8
LITLENOK: "abcd".length == 4
SW: (LIB.startsWith prefix: "quad")
SWPOS: LIB.startsWith "quad"
SWEMPTY: (LIB.startsWith prefix: "")
EW: (LIB.endsWith suffix: "math")
CT: (LIB.contains needle: "adm")
CTEMPTY: (LIB.contains needle: "")
CTMISS: (LIB.contains needle: "zz")
SUB: (LIB.substring from: 0 to: 4) == "quad"
SUBEMPTY: (LIB.substring from: 2 to: 2) == ""
SUBEND: (LIB.substring from: 4 to: 8) == "math"

# a substring feeding `+`, so the two folds compose without a runtime step
JOINED: ((LIB.substring from: 4 to: 8) + "!") == "math!"

main: function is {
    if LENOK then print "length" else print "LENGTH BAD"
    if LITLENOK then print "literal length" else print "LITLEN BAD"
    if SW then print "startsWith" else print "SW BAD"
    if SWPOS then print "startsWith positional" else print "SWPOS BAD"
    if SWEMPTY then print "empty prefix matches" else print "SWEMPTY BAD"
    if EW then print "endsWith" else print "EW BAD"
    if CT then print "contains" else print "CT BAD"
    if CTEMPTY then print "empty needle matches" else print "CTEMPTY BAD"
    if CTMISS then print "CTMISS BAD" else print "contains says no"
    if SUB then print "substring" else print "SUB BAD"
    if SUBEMPTY then print "empty substring" else print "SUBEMPTY BAD"
    if SUBEND then print "substring to end" else print "SUBEND BAD"
    if JOINED then print "substring joined" else print "JOINED BAD"

    # the same fold reached from a BODY condition rather than a definition
    if (LIB.startsWith prefix: "quad") then {
        print "body condition folded"
    } else {
        print "BODY BAD"
    }
}
