# A non-owned arm of a valtype payload (`some: i64.view`, `some: P.view`)
# points at the variable it is built from: reads through it see the source,
# and the source is written again once the value built has gone.
Num: union {
    some: i64.view
    none: null
}
P: record { x: i64 }
Box: union {
    some: P.view
    none: null
}
use: function {f: Num} out i64 is {
    match (f) case some then return f else return 0
}
main: function is {
    x: 4
    {
        f: Num.some x
        print "\{use :f}"
    }
    x = 5
    p: P x: 7
    {
        b: Box.some p
        match (b) case some then print "\{b.x}" else null
    }
    p.x = 8
    print "\{x} \{p.x}"
}
