# Three units each declare a `Cell` with its own fields and its own `get`: a
# nested unit, a sibling file unit, and this one. A type another unit declares
# was looked up by its NAME in the main unit in three places, which answered
# this unit's Cell: the nested Cell's methods were checked against its fields
# ("type 'Cell' has no member 'v'"), a method read on either other Cell called
# this unit's `get`, and a `with` over a nested unit's type found no C type at
# all and declared an int64_t. Each is the type the stamp names now.
kit: unit {
    Cell: class {
        v: i64
    } as {
        get: function {c: this} out i64 is {
            return c.v
        }
    }
    Cfg: class {
        n: 4
    }
}

Cell: class {
    s: String
} as {
    get: function {c: this} out String is {
        return c.s.copy
    }
}

main: function is {
    a: kit.Cell v: 3
    b: Cell s: "top".string
    d: same_name_dep.Cell v: 5
    print "\{a.get} \{b.get} \{d.get}"
    with c: kit.Cfg do print "with \{c.n}"
    with k: (kit.Cell v: 7) do print "with args \{k.get}"
    with e: (same_name_dep.Cell v: 8) do print "with file \{e.get}"
}
