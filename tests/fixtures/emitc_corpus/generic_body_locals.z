# A LOCAL BOUND IN A GENERIC BODY HAS ITS INSTANCE'S TYPE. A generic function,
# a generic unit's function and a generic class's method each walk once per
# instance, and the emitter read a binding's type from the stamp the walks
# share, where a generic parameter's is suppressed: every such local -- `x:
# val` over `t` -- was "unhandled binding type".
keep: function as { T: AnyRef.generic } in { val: T.take } out T is {
    x: val
    return x
}

twice: function as { t: anyval.generic } in { val: t } out t is {
    x: val
    y: x
    return y
}

wrap: unit as {
    t: anyval.generic
    same: function {v: t} out t is {
        z: v
        return z
    }
}
ints: (wrap t: i64)

Pair: class {
    left: t
    trade: function {:this other: t} out t is {
        old: this.left
        this.left = other
        return old
    }
} as { t: anyval.generic }

main: function is {
    s: keep val: "abc".string
    print "\{s} \{twice val: 3} \{twice val: 4.u8} \{ints.same v: 9}"
    p: (Pair t: i64) left: 1
    print "\{p.trade other: 2} \{p.left}"
}
