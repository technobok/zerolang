# bodyless_loop_in_expr_if_arm -- a loop with no body in an arm of an `if` used inside
# an expression leaves nothing
Counter: class {
    n: i64
} as {
    tick: function {c: this} out bool is {
        c.n = c.n + 1
        return c.n < 3
    }
}

show: function {n: i64} is {
    print "n \{n}"
}

main: function is {
    c: Counter n: 0
    show n: (if c.n == 0 then { for c.tick
        2 } else 1)
    print "ticks \{c.n}"
}
