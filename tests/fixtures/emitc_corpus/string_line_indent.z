# string_line_indent.z -- the closing delimiter's indentation comes off the
# front of every line, whatever follows it there: text, an escape or an
# interpolation (a and b). Stripping is all or nothing: one line without that
# indentation, opening with an escape (c) or indented less (d), leaves every
# line as written.
main: function is {
    n: 7
    a: "
        x
        \{n}
        y
        "
    print "[\{a}]"
    b: "
        x
        \tt
        "
    print "[\{b}]"
    c: "
        x
\tt
        "
    print "[\{c}]"
    d: "
        x
    \{n}
        "
    print "[\{d}]"
}
