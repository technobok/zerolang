# block_option_only_own_break -- a block's value is wrapped in an option only when the
# block itself can be left by `break`: a nested block, with or without a `break` of its
# own, changes nothing
main: function is {
    plain: {
        inner: {
            7
        }
        inner + 1
    }
    print "plain \{plain + 1}"
    nested: {
        inner: {
            if plain > 100 then break
            7
        }
        match inner case some then print "inner some \{inner}" case none then print "inner none"
        5
    }
    print "nested \{nested + 1}"
}
