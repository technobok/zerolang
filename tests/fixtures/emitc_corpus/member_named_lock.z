# `lock` IS AN ORDINARY MEMBER NAME. The language reserved it in member
# position for as long as `.lock` was an ownership marker; the marker is gone,
# so the reservation went with it and a type can declare a member called
# `lock` -- which is what a mutex-shaped API wants to call its own method.
#
# The ownership LOCK MODEL is untouched by any of that, and this fixture holds
# both at once: `held` is read here through a `.borrow` parameter, which takes
# a real lock on the path for the call's duration. The word means two things
# and only the marker was retired.
Mutex: class {
    # whether the guard is currently taken
    held: bool
} as {
    # take the guard
    lock: function {:this} is { this.held = true }
    # release it
    unlock: function {:this} is { this.held = false }
}

report: function {m: Mutex.borrow} is {
    print "  held=\{m.held}"
}

main: function is {
    m: Mutex held: false
    report m: m.borrow
    m.lock
    report m: m.borrow
    m.unlock
    report m: m.borrow
}
