# nsq_gauge -- the unit type_qualified_through_unit.z reaches a type's members
# through: a shared function, and a shared method taking its receiver.
Gauge: record {
    level: i64
} as {
    bump: function {n: i64} out i64 is {
        return n + 1
    }
    doubled: function {g: this} out i64 is {
        return g.level * 2
    }
}
