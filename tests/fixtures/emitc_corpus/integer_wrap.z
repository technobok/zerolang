# integer_wrap.z -- signed arithmetic wraps on every C compiler and at every
# optimisation level: a C compiler may otherwise assume that `x + 1 > x` always
# holds and fold it away. A signed minimum divided by -1 wraps back to the
# minimum and its remainder is 0. Each operand reaches the operator through a
# parameter, so nothing here is folded at compile time.

grows: function {x: i64} out bool is {
    return (x + 1) > x
}

grows32: function {x: i32} out bool is {
    return (x + 1) > x
}

add: function {a: i64 b: i64} out i64 is {
    return a + b
}

sub32: function {a: i32 b: i32} out i32 is {
    return a - b
}

mul: function {a: i64 b: i64} out i64 is {
    return a * b
}

mul16: function {a: u16 b: u16} out u16 is {
    return a * b
}

quot: function {a: i64 b: i64} out i64 is {
    return a / b
}

rem: function {a: i64 b: i64} out i64 is {
    return a % b
}

quot32: function {a: i32 b: i32} out i32 is {
    return a / b
}

quot8: function {a: i8 b: i8} out i8 is {
    return a / b
}

quot128: function {a: i128 b: i128} out i128 is {
    return a / b
}

main: function is {
    big: 9223372036854775807
    small: (0 - big) - 1
    print "\{grows x: big} \{grows32 x: 2147483647.i32}"
    print "\{add a: big b: 1} \{sub32 a: -2147483648.i32 b: 1.i32}"
    print "\{mul a: big b: 3} \{mul16 a: 65535.u16 b: 65535.u16}"
    print "\{quot a: small b: -1} \{rem a: small b: -1}"
    print "\{quot32 a: -2147483648.i32 b: -1.i32} \{quot8 a: -128.i8 b: -1.i8}"
    print "\{quot a: -7 b: 2} \{rem a: -7 b: 3}"
    m128: (0.i128 - 170141183460469231731687303715884105727.i128) - 1
    print "\{quot128 a: m128 b: -1.i128}"
    p: "-9223372036854775808".parseI64
    match p case ok then print "\{p}" case err then print "parse failed"
}
