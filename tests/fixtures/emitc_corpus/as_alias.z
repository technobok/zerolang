# A TYPE'S `as` ITEM THAT NAMES A TYPE IS AN ALIAS OF IT: a name local to the
# type, seen in its fields, its method signatures and its bodies -- a
# construction by the alias among them -- and through a path from outside
# (`Canvas.P`), in a type position, a type argument and a construction alike.
# An alias may name another (`Pts: (ListVal P)`), a generic instance, or the
# type's own generic parameter, which each instance completes (`Box.Elem` is
# i64 in one and bool in another). An `as` item naming an arm is a constant, as
# before (`fast: mode.fast`).
Point: record { x: i64 y: i64 }

mode: variant {
    fast: null
    slow: null
}

Canvas: class {
    origin: P
    pts: Pts
} as {
    P: Point
    Pts: (ListVal P)
    fast: mode.fast
    mid: function {c: this.view} out P is {
        q: P x: (c.origin.x + 1) y: c.origin.y
        return q
    }
    count: function {c: this.view} out u64 is { return c.pts.length }
    firstOr: function {c: this.view d: P} out P is {
        if c.pts.length == 0 then return d
        return (c.pts.get i: 0)
    }
}

Box: class {
    items: Elems
    first: Elem
} as {
    t: anyval.generic
    Elem: t
    Elems: (ListVal Elem)
    top: function {b: this.view} out Elem is { return b.first }
    size: function {b: this.view} out u64 is { return b.items.length }
}

Words: record { n: i64 } as {
    S: String
    Ws: (List S)
    make: function {w: this.view} out Ws is {
        l: Ws
        l.append "w".string
        return l
    }
}

Other: class { at: Canvas.P } as {
    moved: function {o: this.view} out Canvas.P is {
        return (Canvas.P x: (o.at.x * 10) y: o.at.y)
    }
}

main: function is {
    c: Canvas origin: (Point x: 1 y: 2) pts: (ListVal Point)
    c.pts.append (Canvas.P x: 3 y: 4)
    m: c.mid
    f: c.firstOr d: (Point x: 0 y: 0)
    print "\{m.x} \{m.y} \{c.count} \{f.x} \{Canvas.fast == mode.fast}"
    b: Box items: (ListVal i64) first: 5
    b.items.append 9
    k: Box items: (ListVal bool) first: true
    w: Words n: 1
    print "\{b.top} \{b.size} \{k.top} \{(w.make).length}"
    o: Other at: (Canvas.P x: 2 y: 7)
    mv: o.moved
    l: ListVal Canvas.P
    l.append mv
    t: ListVal t: Canvas.P
    t.append (Canvas.P x: 1 y: 1)
    print "\{mv.x} \{mv.y} \{l.length} \{t.length}"
}
