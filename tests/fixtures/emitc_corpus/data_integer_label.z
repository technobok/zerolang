# data_integer_label.z -- an integer label is a name like any other: it does not
# place its element at that index, and it is read through the block by that
# name. `codes.4` reads the element labelled 4, which sits at index 2.
codes: data { 1 2 4: 40 }

ids: data {
    7: 70
    3: 30
} out byteid

byteid: typedef u8

widen: function {b: byteid} out u64 is {
    return b.u8.u64
}

main: function is {
    print "len=\{codes.length} c0=\{codes.0} c4=\{codes.4}"
    i: 2.u64
    print "at2=\{codes.index i}"
    print "id7=\{widen b: ids.7} id3=\{widen b: ids.3}"
}
