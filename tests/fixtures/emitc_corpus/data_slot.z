# `slot` is a data block's label positions: `codes.slot.cr` is 2, typed as the
# block's index. Read through the block's name -- in its own unit or through
# another -- it is a constant when the index is a number, and a value of the
# index type when the index is a typedef.
nid: typedef u64
codes: data { ht: 9 lf: 10 cr: 13 } out (intdata u8 i: nid)
plain: data { x: 1 y: 2 } out intdata u8
P: plain.slot.y

vocab: unit {
    words: data { none: "" first: "alpha" second: "beta" } out stringdata
    marks: data { a: 7 b: 8 } out (intdata u8 i: nid)
}

# the mark at `k`, through its index type
mark: function {k: nid} out u8 is {
    return (vocab.marks.index i: k)
}

main: function is {
    s: codes.slot.cr
    print "\{codes.index i: s} \{codes.index i: codes.slot.ht}"
    v: codes
    print "\{v.index i: codes.slot.lf}"
    p: plain.slot.y
    print "\{p} \{p + 1} \{P}"
    print "\{vocab.words.index i: vocab.words.slot.second} \{mark k: vocab.marks.slot.b}"
}
