# combinator_in_condition.z -- `.or d:` in an `if` and a `while` condition. The
# combinators lower to a statement expression `({ ... })`, whose leading paren
# an `if (` swallows unless the condition is wrapped: the C then reads a block
# where an expression belongs and the compiler rejects the file.
main: function is {
    m: (IdMapV u64 v: bool)
    m.set key: 1 value: true
    if ((m.get key: 1).or d: false) then print "one"
    if ((m.get key: 2).or d: false) then print "two" else print "no two"
    n: (IdMapV u64 v: u64)
    n.set key: 0 value: 3
    i: (n.get key: 0).or d: 0
    for i > 0 loop {
        print "\{i}"
        i = i - 1
    }
}
