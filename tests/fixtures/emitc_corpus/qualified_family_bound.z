# qualified_family_bound.z -- a generic parameter bounded by a family written
# through the unit that declares the families (`system.u64.generic`,
# `core.anyval.generic`) is that family's parameter, as with the bare name: a
# numeric one is a compile-time value, read as a value and in a type argument.

Counted: record {
    v: t
} as {
    t: core.anyval.generic
    n: system.u64.generic

    size: function {c: this.view} out system.u64 is { return n }
    cells: function {c: this.view} out system.u64 is {
        a: (array system.u8 to: n)
        return a.length
    }
}

main: function is {
    c: (Counted t: i64 n: 4 v: 9)
    print "\{c.v} \{c.size} \{c.cells}"
}
