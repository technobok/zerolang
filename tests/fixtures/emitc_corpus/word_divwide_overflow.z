# word_divwide_overflow.z -- a high word at or above the divisor makes a
# quotient wider than a word, so the division panics rather than answer the
# low 64 bits of it ("zpanic: <msg>" on stderr, exit 1).

main: function is {
    print "before"
    hi: 7.u64
    q: hi.divWide lo: 0 by: 7
    print "after \{q.quo}"
}
