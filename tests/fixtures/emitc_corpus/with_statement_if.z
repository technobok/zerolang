# with_statement_if.z -- a `with` standing as a statement discards its body's
# value, so an `if` attached to it is a statement `if` and needs no else
# (grammar.pdoc: a with-expression statement can come immediately before the
# `if`). It was refused as "an `if` used as a value needs an else". A `with`
# whose value is bound still needs one.

main: function is {
    with v: 7 do if v > 5 then print "seven is big"
    with w: 3 do if w > 5 then {
        print "unreachable"
    }
    with a: 2 do with b: a do if b < 5 then print "nested: \{b}"
    chosen: with c: 4 do if c > 3 then 100 else 200
    print "chosen: \{chosen}"
}
