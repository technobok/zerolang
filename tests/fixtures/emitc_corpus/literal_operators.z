# A LITERAL'S OPERATORS ARE ITS OWN. Against another literal the compiler
# computes the operation exactly and the result is a literal again: `2 + 3`,
# `1 + 0.5` and `0.5 + 1` alike, an integer under a float operator read as a
# float. Against a typed operand the literal is read as that operand's type,
# must fit it, and the operation is that type's, in either order: `4 - w` is a
# u64 subtraction that wraps, `2 * b` a u8 product, `4 + m` a meters,
# `1 << k` a u8 shift. An integer literal's `times`, `upto` and `downto` walk
# an i64.
meters: typedef u32

# scaled -- n times m, m defaulting to a literal operation: the default reads
# intliteral's `*` before anything else reaches intliteral, under --eager too
scaled: function {n: 9 m: 2 * 3} out i64 is {
    return n * m
}

# meterValue -- the u32 under a meters, which only a meters can give
meterValue: function {m: meters} out u32 is {
    return m.u32
}

main: function is {
    n: 7.u32
    w: 10.u64
    x: 2.0.f32
    b: 200.u8
    m: meters 5
    k: 3.u8
    j: 9.i32
    big: 9223372036854775807.i64
    print "\{2 + 3} \{1 + 0.5} \{0.5 + 1} \{1 / 3.0} \{7 / 2} \{0 - 7} \{1 << 70 >> 68} \{5.not}"
    print "\{4 < n} \{n > 4} \{4 - w} \{18446744073709551615 > w} \{0xff & k}"
    print "\{0.5 * x} \{x * 0.5} \{2 * b} \{b * 2} \{meterValue m: 4 + m} \{1 << k} \{0 - j}"
    print "\{5 < big.i128} \{(0 - big.i128) * 1000} \{scaled}"
    t: 0
    for each i: 5.times loop t = t + i
    for each u: (2.upto to: 4) loop t = t + u
    for each d: (3.downto to: 1) loop t = t + d
    print "\{t}"
}
