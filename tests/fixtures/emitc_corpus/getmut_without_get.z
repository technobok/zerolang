# A list's `getMut` is written on its own demand. It was written only beside
# `get`, so a program that used `getMut` and never `get` called a function that
# did not exist -- for a class, a record and a String element alike, in a
# binding and as a parenthesised receiver. Each write below is read back
# through `iterate`, not `get`, so the program stays one that never calls `get`.
Row: class {
    n: i64
} as {
    bump: function {:this} is {
        this.n = this.n + 1
    }
}

pt: record {
    x: i64
}

main: function is {
    rows: List Row
    rows.append (Row n: 1)
    {
        r: rows.getMut i: 0
        r.n = 41
    }
    (rows.getMut i: 0).bump
    for r: rows.iterate loop {
        print "class element \{r.n}"
    }

    ps: ListVal pt
    ps.append from: (pt x: 1)
    {
        p: ps.getMut i: 0
        p.x = 9
    }
    for q: ps.iterate loop {
        print "record element \{q.x}"
    }

    names: List String
    names.append "a".string
    (names.getMut i: 0).append "b"
    for n: names.iterate loop {
        print "string element \{n}"
    }
}
