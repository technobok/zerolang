    """

held: data {
    a: text
    b: text
}

both: (held a: long b: huge)

# sum -- the bytes of `t` added up, to show every byte arrived
sum: function {t: StringView} out u64 is {
    s: u64
    i: u64
    for i < t.length loop {
        s = s + ((t.byteAt :i).or d: 0)
        i = i + 1
    }
    return s
}

main: function is {
    print "\{long.length} \{sum t: long}"
    print "\{huge.length} \{sum t: huge}"
    print "\{both.a.length} \{both.b.length} \{sum t: both.b.stringView}"
