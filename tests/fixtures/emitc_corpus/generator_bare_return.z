# generator_bare_return.z -- a bare `return` terminates a generator.
#
# The spec has always said so; the checker refused it anyway, demanding a value
# of the synthesised `.call` wrapper type. The emitter was already right --
# `goto L_done`, straight to the absorbing terminal state -- so only the
# checker had to stop asking.
#
# The second generator has a yield made UNREACHABLE by an unconditional
# return. It is still counted, so it still has an arm in the resume switch,
# and the epilogue lands that arm on the terminal state rather than leaving
# the C with a `goto` to a label nothing wrote.

upto: function {stop: bool} out (Iterator Gives: i64) is {
    yield 1
    if stop then return
    yield 2
    yield 3
}

deadTail: function out (Iterator Gives: i64) is {
    yield 10
    return
    yield 20
}

main: function is {
    for x: (upto stop: false) loop print "all: \{x}"
    for y: (upto stop: true) loop print "cut: \{y}"
    for z: deadTail loop print "dead: \{z}"
    print "done"
}
