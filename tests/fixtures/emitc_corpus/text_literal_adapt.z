# text_literal_adapt.z -- a string literal is a StringView where nothing asks
# for more, and coerces to its destination where one is known, as an integer
# literal does to a u8: at a `text` parameter, record and class field (filled
# and reassigned), ListVal element, MapVV key and `out text` return it is text.
# So is an untyped unit constant read by name, an untyped list's element (the
# list is a `staticlist text`), an `if` of literals, and a literal made text
# outright with `.text`.
greeting: "hi"
names: list { a: "alpha" b: "beta" }

pair: record {
    key: text
    n: u64
}

Tag: class {
    label: text
}

shout: function {t: text} out String is {
    s: t.string
    s.append "!"
    return s
}

name: function out text is {
    return "fixed"
}

main: function is {
    print (shout t: "lit")
    print (shout t: greeting)
    print (shout t: names.a)
    c: names.a.length > 2
    print (shout t: (if c then "yes" else "no"))
    p: pair key: "k" n: 1
    g: Tag label: "lab"
    g.label = "relabel"
    xs: ListVal text
    xs.append "e1"
    xs.append "e2"
    m: MapVV text v: u64
    m.set key: "k1" value: 3
    got: m.get key: "k1"
    match got case some then print "\{got}" case none then print "none"
    t: name
    u: "forced".text
    print "\{p.key} \{g.label} \{xs.length} \{m.length} \{t} \{u.length}"
    v: "a view"
    print v
}
