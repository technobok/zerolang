# A unit-level re-export of a container is the container under another name:
# `(MyList String)` must construct, take `capacity:`, and iterate exactly as
# `(List String)` does. The emitter classifies a construction by its stamped
# callKind and origin family, not the written head name -- these aliases are
# the fixture for that.
MyList: collections.List
MySet: collections.Set
MyMap: collections.Map
MyListVal: collections.ListVal
main: function is {
    xs: (MyList String)
    xs.append "a".string
    xs.append "b".string
    with it: xs.iterate do for v: it loop print "x \{v}"

    ys: (MyListVal u64 capacity: 4)
    ys.append 7
    print "y len=\{ys.length} cap=\{ys.capacity}"

    s: (MySet String)
    s.add "k".string
    k9: "k".string
    print "s has=\{s.has item: k9}"

    m: (MyMap String value: String)
    m.set key: "k".string value: "v".string
    with mt: m.iterateItems do for e: mt loop print "m \{e.key}=\{e.value}"
}
