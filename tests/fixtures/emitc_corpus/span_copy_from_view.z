# span_copy_from_view.z -- SpanVal.copyFrom only reads its source, so it takes
# it as a view: a function holding a readonly `.view` parameter may copy from
# it, and one view may be the source while it is also read elsewhere in the
# call. Declared as a borrow, both were refused ("'x' is readonly here").
fill: function {dst: (SpanVal u64).borrow src: (ListViewVal u64).view} is {
    dst.copyFrom from: src
}

main: function is {
    a: ListVal u64
    for each i: 4.u64.times loop a.append from: i + 1
    b: ListVal u64
    b.resize to: 4
    {
        w: b.mutView
        fill dst: w src: a.listView
    }
    print "\{b.get i: 0} \{b.get i: 3}"
    {
        w: b.mutSlice from: 1 to: 3
        v: a.listView
        w.copyFrom from: (v.slice from: 2 to: 4)
    }
    print "\{b.get i: 1} \{b.get i: 2} \{b.length}"
}
