# a StringView native read whose base is not a bare atom. Every native leg in the
# dotted-path arm sat behind a base with an atom NAME, so a projection or a call
# fell through to the user-method path and named the callee by the method's
# function-type id -- a symbol nothing defines. The call shapes also need the
# receiver bound to a temp: `&` wants an lvalue and C rejects `&f(x)`.
Holder: class {
    text: String
}

mk: function {s: StringView} out StringView is {
    return s
}

main: function is {
    s: "  hello  "
    h: Holder.create text: "  hi  ".string

    # base is a PROJECTION (already an lvalue: a compound literal)
    print "[\{h.text.stringView.trim}]"

    # base is a no-paren native read that auto-calls
    print "[\{s.trim.trimStart}]"

    # base is a parenthesised native call
    print "[\{(s.substring from: 2 to: s.length).trimStart}]"

    # base is a parenthesised USER call
    print "[\{(mk s: s).trim}]"

    # a predicate native over the same shape
    print "\{(s.substring from: 2 to: s.length).isEmpty}"
}
