# wordops -- the sibling totals.z names by its bare name
double: function {x: u64} out u64 is {
    return x * 2
}

# never called: a function nothing reaches is not walked, and its copy must not
# be emitted unwalked either
widen: function {x: u64} out u64 is {
    p: x.mulWide rhs: x
    return p.lo
}
