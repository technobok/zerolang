# sync_in_collections.z -- a collection holding a templated class -- a sync
# type or an atomic -- is written after the class it holds, generic or not.

main: function is {
    cvs: List sync.Condvar
    cvs.append sync.Condvar.create
    counts: List sync.AtomicI64
    counts.append (sync.AtomicI64.create value: 4)
    locks: Map String V: (sync.Mutex (ListVal i64))
    locks.set key: "a".string value: ((sync.Mutex (ListVal i64)).create value: (ListVal i64))
    for each c: counts loop print "count \{c.load}"
    for each cv: cvs loop cv.notifyAll
    print "\{cvs.length} \{locks.length}"
}
