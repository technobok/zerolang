# A STRING LITERAL'S MEMBERS ARE ITS OWN. textliteral declares StringView's
# read-only members again, with StringView's signatures, and each reads the
# literal as the StringView over its bytes: on constant arguments the compiler
# computes the call (`"ab".length` folds), on a run-time one it runs as
# StringView's (`"abcdef".substring from: i to: 4`, `"ab" < w`). The sized `str`
# conversion takes a literal as it takes a StringView.
S: "hello"

main: function is {
    w: "wor".string
    i: 1.u64
    print "\{"ab".length} \{"abc".toUpperAscii} \{"x" == "x"} \{"ab" < w} \{"abc".startsWith "ab"}"
    print "\{"abcdef".substring from: i to: 4} \{S.length} \{"a,b".contains ","} \{"ab".str to: 4}"
    n: "ab".length
    v: "  hi ".trim
    print "\{n} \{v} \{"ab".string.length} \{"abc".byteView.length} \{"ab".compare rhs: w.stringView}"
}
