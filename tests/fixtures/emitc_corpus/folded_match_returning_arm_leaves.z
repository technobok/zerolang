# folded_match_returning_arm_leaves -- A `match` folded to an arm that returns leaves
# the function on every path: the arms the fold rules out decide nothing.
shape: choice {
    circle: i64
    square: i64
    dot: null
}
SH: (shape.square 4)
f: function out i64 is {
    match SH case circle then print "circle" case square then return SH case dot then print "dot"
}
main: function is {
    print "\{f}"
}
