# arm_reference_followed.z -- a value an arm hands back that keeps a reference
# the arm declared locked -- a named borrow `t`, a hoisted temporary -- keeps
# what that reference borrows instead: the reference owns nothing and dies with
# the arm, and `v` keeps `xs` locked. Dropping v frees xs for the write.
lfFirst: function {s: String.view} outx StringView is {
    return (s.substring from: 0 to: 3)
}

main: function is {
    xs: List String
    xs.append "abc def".string
    k: xs.length > 0
    v: if k then {
        t: xs.get i: 0
        lfFirst s: t
    } else (lfFirst s: (xs.get i: 0))
    print v
    v.drop
    xs.set i: 0 val: "replaced".string
    print "\{xs.get i: 0}"
}
