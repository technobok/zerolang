# nonowned_reference_reads.z -- A LIVE NON-OWNED REFERENCE THAT MAY WRITE PINS
# ITS SOURCE EXCLUSIVE. A `.borrow` field, a `with` alias and an `outx` result
# over a `.borrow` argument are read through while they live, and the owner
# reads, passes and writes the source again once they end; reading it beside
# them is refused (errors/nonowned_reference_reads_refused). A call's own pins
# start when the call starts: an argument that reads the source another
# argument of the same call borrows is evaluated first, so it reads beside
# nothing.
C: class {
    s: String.borrow
}

Bag: class {
    x: i64
}

D: class {
    b: Bag.borrow
}

Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {a: Src.borrow} outx W is {
    return (W s: a tag: 1)
}

count: function {s: String.view} out u64 is {
    return s.length
}

both: function {a: String.borrow n: u64} is {
    a.append "+"
    print "both: \{a} \{n}"
}

main: function is {
    src: "hello".string
    {
        # a borrowed field is read through the holder
        c: C s: src
        print "field: \{c.s}"
    }
    n: src.length
    m: count s: src
    print "field after: \{n} \{m} \{src}"
    bag: Bag x: 7
    {
        d: D b: bag
        print "field valtype: \{d.b.x}"
    }
    print "bag: \{bag.x}"
    with w: src.borrow do {
        w.append "!"
        print "with: \{w}"
    }
    # an `outx` result over a `.borrow` argument is read through the result
    x: Src n: 3
    {
        w: mk a: x
        print "outx: \{w.tag} \{w.s.n}"
    }
    print "outx after: \{x.n}"
    # a `.borrow` argument beside a read of the same source in one call
    both a: src n: src.length
    both a: src n: (count s: src)
    print "end: \{src}"
}
