# shadow_fnlocal.z -- a fn-typed LOCAL that shadows a function of the same name.
# The callee's identity is the checker's stamp on the callable atom, not the
# name: re-resolving `addit` at the call site finds the FUNCTION the local
# shadows, and the call then goes to the wrong body -- silently, with a wrong
# answer rather than an error. The local's variable id says "this is a local",
# which routes the call through the function pointer it holds.

addit: function {a: u64 b: u64} out u64 is {
    return a + b
}

mulit: function {a: u64 b: u64} out u64 is {
    return a * b
}

main: function is {
    # shadowing: the local `addit` holds `mulit`
    addit: mulit.take
    r: addit a: 3 b: 4
    # no shadowing: the same call through a distinctly named local
    op: addit.take
    s: op a: 5 b: 6
    print "r=\{r} s=\{s}"
}
