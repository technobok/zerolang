# a dotted zero-arg call answers for its OWN result wherever it is hoisted,
# whatever its base: an owned return read off a borrowed element is a temp the
# statement frees, and a `.view` return read off a named base belongs to that
# base and is never freed
Cell: class {
    name: String
} as {
    label: function {c: this.view} outx String.view is {
        return c.name
    }
    shout: function {c: this.view} out String is {
        return "\{c.name}!"
    }
}
say: function {s: String} is {
    print s
}
main: function is {
    l: List Cell
    l.append from: (Cell name: "bob".string)
    c: Cell name: "amy".string
    print "\{(l.get i: 0).shout} \{(l.get i: 0).name.copy} \{c.label}"
    say s: c.label
    say s: (l.get i: 0).shout
    s: "x".string
    s.append c.label
    s.append (l.get i: 0).shout
    print s
    names: List String
    names.append from: "amy!".string
    if (names.contains item: c.shout) then print "has shout"
    if (names.contains item: c.label) then print "has label"
    if (l.get i: 0).shout == "bob!" then print "eq"
    print "\{c.label.length} \{(l.get i: 0).shout.length}"
}
