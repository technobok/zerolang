# `.take` on a value that owns nothing -- a number, a truth value, a float, a
# record of such -- moves it by copying it, wherever it is written: a binding, an
# argument, an interpolation part, an operand, an arm, a reassignment. The
# source is spent all the same.
Pt: record {
    x: i64
    y: i64
}

show: function {n: i64} out i64 is {
    return n
}

showPt: function {p: Pt} out i64 is {
    return p.x + p.y
}

pick: function {c: bool} out i64 is {
    k: 5
    r: if c then k.take else 7
    return r
}

main: function is {
    a: 5
    r: a.take
    b: 6
    c: 7
    d: 8
    n: d.take + 1
    p: Pt x: 1 y: 2
    q: Pt x: 3 y: 4
    t: true
    f: 2.5
    w: 9.u8
    k: 5
    k2: 0
    k2 = k.take
    print "binding \{r} argument \{show n: b.take} part \{c.take} operand \{n}"
    print "record \{showPt p: p.take} bound \{(q.take).y}"
    print "bool \{t.take} float \{f.take} u8 \{w.take} reassigned \{k2}"
    print "arm \{pick c: true} \{pick c: false}"
}
