# `.view` is legal on a valtype, in every position, and is enforced by a lock
# on the binding's own NAME -- which a record has just as much as a class does.
# Reading through it is free; the writes are refused in
# tests/fixtures/errors/view_valtype_*.
#
# `.lock` and `.borrow` still need an identity to point at and stay refused on
# a valtype (tests/fixtures/errors/lock_on_valtype).
point: record {
    x: i64
    y: i64
} as {
    sum: function {p: this.view} out i64 is {
        return p.x + p.y
    }
}
show: function {p: point.view} out i64 is {
    return p.x * 10
}
keep: function {p: point.hold} out i64 is {
    return p.y
}
main: function is {
    q: point x: 3 y: 4
    print "sum=\{q.sum} show=\{show p: q} keep=\{keep p: q}"
    print "unchanged: \{q.x} \{q.y}"
}
