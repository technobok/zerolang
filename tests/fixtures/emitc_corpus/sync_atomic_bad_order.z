# sync_atomic_bad_order.z -- a load cannot take release ordering: C leaves it
# undefined, so the atomic panics rather than run it, before anything after.

main: function is {
    n: sync.AtomicI64.create value: 1
    print "before \{n.load order: sync.memoryorder.acquire}"
    v: n.load order: sync.memoryorder.release
    print "after \{v}"
}
