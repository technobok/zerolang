# with_body_returns.z -- a `with` whose body returns on every path: each return
# destroys the bound value, and nothing is emitted after the body for a path
# that never reaches it (deadcode-guard's -Wunreachable-code).
label: function {n: i64} out String is {
    s: String
    s.append "v"
    s.append "\{n}"
    return s
}

describe: function {n: i64} out bool is {
    with s: (label :n) do {
        if n < 0 then return false
        print s
        return true
    }
    return false
}

main: function is {
    print "\{describe n: 3}"
    print "\{describe n: -1}"
    n: i64
    for n < 2 loop {
        n = n + 1
        with s: (label :n) do {
            print "loop \{s}"
            continue
        }
    }
}
