# A typedef over a numeric type applied to one value is a constant of that
# typedef (`NONE: rid 0`), and such a constant is a default like any numeric
# constant: the parameter or field takes the typedef as its type, so an
# argument still passes a `rid`, and an omitted one is the constant.
rid: typedef u32
NONE: rid 0
SEVEN: (rid from: 7)
BYTE: (bid 255)
bid: typedef u8

use: function {a: i64 r: NONE} out u32 is {
    return r.u32 + a.u32.orPanic
}

Row: record { r: SEVEN  n: 1 }

main: function is {
    print "\{use a: 1} \{use a: 1 r: (rid 9)} \{use a: 0 r: SEVEN}"
    w: Row n: 2
    v: Row r: (rid 3) n: 4
    print "\{w.r.u32} \{v.r.u32} \{w.r == SEVEN} \{NONE == SEVEN} \{BYTE.u8}"
}
