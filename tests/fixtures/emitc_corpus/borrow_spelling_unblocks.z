# A generator that reads another type's PRIVATE fields, reached through the
# public method that hands one out.
#
# `BagWalk`'s field is `Bag.private.borrow`, so it can read what
# `public: unit { :count :walk }` hides -- and because the field is non-owned,
# `Bag.walk` is `outx BagWalk`, which is what carries the pin out to the
# caller's `g` rather than stopping at the method boundary.
#
# The generator is declared at unit level: it is a TYPE, and an inline type
# definition inside `Bag`'s `as` block is refused for a generator exactly as for
# a class. `Bag.walk` stays as the way in, so the call site is unchanged.
#
# This fixture RUNS rather than merely compiling: the loop variable must come
# back as the YIELDED type and not the iterator, and a compile alone cannot tell
# the difference -- the symptom was a type error wherever the value was finally
# used.
Bag: class {
    a: i64
    b: i64
    count: i64
} as {
    public: unit { :count :walk }
    walk: function {b: this.private.borrow} outx BagWalk is {
        return (BagWalk b: b)
    }
}

BagWalk: generator { b: Bag.private.borrow } as {
    call: function out i64 is {
        yield this.b.a
        yield this.b.b
    }
}

main: function is {
    g: Bag a: 10 b: 20 count: 2
    print "count=\{g.count}"
    # `x` must be the YIELDED type, not the iterator
    with it: (Bag.walk b: g) do for x: it loop print "walk: \{x}"
}
