# A class that holds a Box owns the cell. Its destructor never freed one -- a
# Box field did not count as needing cleanup, so the class had no destructor at
# all -- and reassigning the field handed the old cell's destroy the FIELD's
# address, which is not what malloc returned (ASan: bad-free). A box is the
# pointer its destroy takes, as a heap collection is.
big: record {
    a: i64
}

Holder: class {
    bx: (Box t: big)
}

Gen: class {
    bx: (Box t: t)
} as {
    t: anyval.generic
}

keep: function {b: (Box t: big).take} out u64 is {
    return 1
}

main: function is {
    h: Holder bx: (Box from: (big a: 1))
    h.bx = Box from: (big a: 2)
    k: keep b: h.bx.take
    g: Gen t: i64 bx: (Box from: 5)
    n: Box from: 3
    n = Box from: 4
    print "\{k} \{n + 0}"
}
