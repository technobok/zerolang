# An untyped float folds exactly and is rounded once, where it lands: in an f32
# or f128 argument, field or return as in an assignment -- never through f64.
G: 1.00000005960464478

takeF: function {v: f32} out bool is {
    return v > 1.0
}

retF: function out f32 is {
    return (G + 0)
}

pt: record {
    x: f32
}

q: function {v: f128} out f128 is {
    return v
}

r: record {
    a: f128
}

main: function is {
    print "\{takeF v: 1.00000005960464478} \{takeF v: G} \{takeF v: (G + 0)} \{takeF v: (1.00000005960464478 * 1)} \{retF > 1.0}"
    p: pt x: (G - 0)
    y: 0.0.f32
    y = (G * 1)
    print "\{p.x > 1.0} \{y > 1.0}"
    w: (1.0 / 3.0).f128
    x: r a: (1.0 / 3.0)
    b: f128
    b = (1.0 / 3.0)
    print "\{(q v: (1.0 / 3.0)) == w} \{x.a == w} \{b == w} \{(q v: 0.33333333333333333333333333333333333) == w}"
}
