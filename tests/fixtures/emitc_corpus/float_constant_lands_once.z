# An untyped float folds exactly and is rounded once, where it lands: in an f32
# argument, field or return as in an assignment -- never through f64. The f128
# landings are f128_constant_lands_once's (the C backend tcc has no f128).
G: 1.00000005960464478

takeF: function {v: f32} out bool is {
    return v > 1.0
}

retF: function out f32 is {
    return (G + 0)
}

pt: record {
    x: f32
}

main: function is {
    print "\{takeF v: 1.00000005960464478} \{takeF v: G} \{takeF v: (G + 0)} \{takeF v: (1.00000005960464478 * 1)} \{retF > 1.0}"
    p: pt x: (G - 0)
    y: 0.0.f32
    y = (G * 1)
    print "\{p.x > 1.0} \{y > 1.0}"
}
