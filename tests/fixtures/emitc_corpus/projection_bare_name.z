# The bare-name projection `P src`: the source's marker picks the result's
# ownership. `Speaker d.borrow` borrows `d` for the binding's life, as
# `d.Speaker` does; `Speaker d` takes it, as `Speaker.create from: d.take`
# does. A record source and a facet project the same way.
Speaker: protocol {
    speak: function {:this} out i64
}

Dog: class { n: i64 name: String } as {
    :Speaker
    speak: function {t: this} out i64 is { return t.n }
}

Pup: record { n: i64 } as {
    :Speaker
    speak: function {t: this} out i64 is { return t.n }
}

Area: facet {
    area: function {:this} out i64
}

Sq: record { s: i64 } as {
    :Area
    area: function {t: this} out i64 is { return t.s * t.s }
}

use: function {s: Speaker} out i64 is { return s.speak }

main: function is {
    d: Dog n: 7 name: "rex".string
    {
        b: Speaker d.borrow
        print "borrowed=\{b.speak}"
    }
    print "after=\{d.n} \{d.name} inline=\{use s: (Speaker d.borrow)}"
    o: Speaker d
    print "owned=\{o.speak}"
    p: Pup n: 3
    ps: Speaker p
    print "record=\{ps.speak}"
    q: Sq s: 4
    a: Area q
    print "facet=\{a.area} \{q.s}"
}
