# string_viewable_conformance.z -- a type that conforms to StringViewable joins
# StringLike: `print` takes it as it takes a String, through its `stringView`.
Label: class {
    t: String
} as {
    :StringViewable
    stringView: function {l: this.view} outx StringView is {
        return l.t.stringView
    }
}

main: function is {
    l: Label t: "named".string
    print l
}
