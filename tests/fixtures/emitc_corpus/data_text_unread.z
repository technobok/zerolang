# data_text_unread.z -- a text laid out at run time though no view is read: a
# data value's text field nothing reads, a static list of text passed whole, walked
# for its count, or held in a data field. Each writes the StringView typedef the
# text is laid out as.
part: data {
    name: text
    tags: staticlist text
    count: 1
}
washer: (part name: "washer" tags: list { "a" "b" } count: 4)
regions: list { "eu" "us" }

lengthOf: function {xs: staticlist text} out u64 is {
    return xs.length
}

main: function is {
    a: washer
    print "\{a.count} \{a.tags.length}"
    print "\{lengthOf xs: regions}"
    n: 0
    for each r: regions loop n = n + 1
    print "\{n}"
}
