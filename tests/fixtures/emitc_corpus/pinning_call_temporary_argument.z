# A call whose result points into its argument keeps that argument alive for as
# long as the result lives. An argument that was a TEMPORARY -- a function a
# bare name auto-calls (`mkl`, `(mkl)`), a type a bare name constructs
# (`Holder`), or, at a generic callee, any call's result -- was freed with the
# statement, and the result read freed memory (valgrind: invalid reads; the
# element printed as garbage). A bare name that is no variable was taken for one
# and pinned nothing, and a generic call pinned only variables. Each is now held,
# as a concrete call's `(mkn n: 1)` already was.
Holder: class {
    n: 5
}

pick: function {l: (List String).view i: u64} outx String.view is {
    return (l.get :i)
}

gpick: function as { T: AnyRef.generic } in {l: (List T: T).view i: u64} outx T.view is {
    return (l.get :i)
}

peek: function {h: Holder.view} outx Holder.view is {
    return h
}

Shelf: class {
    k: i64
} as {
    first: function {s: this.view h: Holder.view} outx Holder.view is {
        return h
    }
}

mkl: function out (List String) is {
    l: List String
    l.append "a".string
    l.append "b".string
    return l
}

mkn: function {n: i64} out (List String) is {
    l: List String
    l.append "n\{n}"
    return l
}

mk: function out String is {
    return "x".string
}

main: function is {
    a: pick l: mkl i: 0
    b: pick l: (mkl) i: (mk).length
    c: pick l: (mkn n: 1) i: 0
    d: gpick l: mkl i: 1
    e: gpick l: (mkn n: 2) i: 0
    f: peek h: Holder
    sh: Shelf k: 1
    g: sh.first h: Holder
    print "\{a} \{b} \{c} \{d} \{e} \{f.n} \{g.n}"
}
