# tcc_no_library.z -- the in-process compiler where no libtcc can be loaded:
# `available` answers false and both compiles report 127, without trying the
# compile. On Windows nothing is ever loaded, so this is every tccDir there;
# elsewhere it is a directory with no libtcc.so in it.
main: function is {
    dir: "z_no_tcc_here"
    print "available=\{tcc.available tccDir: dir}"
    none: List String
    rc: (tcc.compileToExe
        csrc: "z_none.c"
        exe: "z_none"
        tccDir: dir
        release: false
        cflags: ""
        libs: none
        objs: none
    )
    print "compileToExe=\{rc}"
    ro: tcc.compileToObject csrc: "z_none.c" obj: "z_none.o" tccDir: dir cflags: ""
    print "compileToObject=\{ro}"
}
