# if_arms_call_never_function -- Every arm of an `if` with an else ends on a call of a
# function declared `out never`.
die: function {code: i64} out never is {
    panic msg: "die \{code}"
}

pick: function {c: bool} is {
    if c then {
        die code: 1
    } else {
        die code: 2
    }
    print "after"
}

main: function is {
    n: 0
    if n > 0 then pick c: true
    print "done"
}
