# A CONSTANT ARGUMENT SELECTS A DIFFERENT ROW. `x << 3` and `x << n` mean the
# same thing and must answer the same, but they do not have to be the same C.
# The count is compared against the width so an over-wide one is defined rather
# than undefined; when the count is a literal that compare is a constant
# expression the C compiler folds away, and when it is not, it is a branch that
# has to be there.
#
# The variant row names @R@ MORE THAN ONCE, which the ordinary rows must never
# do -- holes fill verbatim, so a call on the right would be evaluated twice.
# A position declared `const=` fills with a literal, which is what makes the
# duplication free and the condition foldable at the same time.
#
# make const-row-guard reads the emitted C and pins both directions: the
# constant form binds no `_r`, the variable form does. This fixture answers for
# the VALUES; the guard answers for the FORM.
main: function is {
    x: 12.u64
    n: 3.u64
    print "const count: \{x << 3} \{x >> 1}"
    print "variable count: \{x << n} \{x >> n}"

    # the over-wide constant stays defined: the guard folds to the zero arm
    print "const over-wide: \{x << 64} \{x >> 64}"

    # a signed receiver: `>>` fills with the sign, and the constant form must
    # keep that arm
    s: (0.i64 - 8.i64)
    print "signed const: \{s >> 1} \{s >> 64}"

    # THE OPERAND IS STILL EVALUATED ONCE. A non-constant right operand cannot
    # reach the variant row, and `noisy` prints once to prove it.
    print "call operand: \{x << (noisy)}"
}

noisy: function out u64 is {
    print "  (rhs evaluated)"
    return 2
}
