# A CONSTANT COUNT FOLDS. `x << 3` and `x << n` are the same row. The count is
# compared against the width so an over-wide one is defined rather than
# undefined, and the row names the count twice to do it. A constant count fills
# both places with its literal, so the compare is a constant expression the C
# compiler folds away; a variable count keeps the branch it needs.
#
# A count the row names twice is still EVALUATED ONCE: a call operand is read
# into a temporary first, and `noisy` prints once to prove it.
main: function is {
    x: 12.u64
    n: 3.u64
    print "const count: \{x << 3} \{x >> 1}"
    print "variable count: \{x << n} \{x >> n}"

    # the over-wide constant stays defined: the guard folds to the zero arm
    print "const over-wide: \{x << 64} \{x >> 64}"

    # a signed receiver: `>>` fills with the sign, a constant count included
    s: (0.i64 - 8.i64)
    print "signed const: \{s >> 1} \{s >> 64}"

    # a call for the count: read once, into a temporary
    print "call operand: \{x << (noisy)}"
}

noisy: function out u64 is {
    print "  (rhs evaluated)"
    return 2
}
