# loop_moved_holder_spent_after -- a holder moved out in a loop's body is spent after
# the loop: nothing reads it again, so the lock it held on its source is gone and the
# source is written
LfBox: class {
    name: StringView
}

loopTakeWriteAfter: function {k: bool} is {
    s: "abc".string
    w: LfBox name: s.stringView
    n: 0
    if k then n = 1
    for n > 0 loop {
        v: w.take
        print "taken \{v.name}"
        break
    }
    s = "zzz".string
    print "after \{s}"
}

main: function is {
    loopTakeWriteAfter k: true
    loopTakeWriteAfter k: false
}
