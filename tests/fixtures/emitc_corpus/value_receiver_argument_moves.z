# a receiver that is a borrowed value -- an element `getMut` hands back, a
# reference a method returns -- keeps its own pins, never its argument's: an
# owned value moved into a taking parameter of a method called on it is a move,
# by name or by construction. It was refused as "Cannot move borrowed variable".
Box2: class {
    rows: List (ListVal i64)
} as {
    rowsMut: function {this: this.borrow} outx (List (ListVal i64)).borrow is {
        return this.rows
    }
}
main: function is {
    grid: List (List (ListVal i64))
    grid.append from: (List (ListVal i64))
    v: ListVal i64
    (grid.getMut i: 0).append from: v
    (grid.getMut i: 0).append from: (ListVal i64)
    ((grid.getMut i: 0).getMut i: 0).append from: 3
    ls: List (List String)
    ls.append from: (List String)
    (ls.getMut i: 0).append from: String
    s: "s".string
    (ls.getMut i: 0).insert at: 0 from: s
    x: "x".string
    (ls.getMut i: 0).append from: x
    b: Box2 rows: (List (ListVal i64))
    b.rowsMut.append from: (ListVal i64)
    (b.rowsMut).append from: (ListVal i64)
    print "\{(grid.get i: 0).length} \{((grid.get i: 0).get i: 0).length} \{(ls.get i: 0).length} \{b.rows.length}"
}
