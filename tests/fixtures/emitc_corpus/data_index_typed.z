# A data block records its `out T` as the name of its tag child, so
# `tab.index i` yields one element of that type -- it binds to a local, feeds
# an operator that resolves against u8, and widens like any other u8. Before
# the element type was derived, only the inline form worked: the result had no
# type at all, so binding it was `Unknown reference` and every operator over it
# resolved nothing and reached the emitter untyped.
tab: data {
    0b0001 0b0011 0b0010
} out u8

main: function is {
    i: 1.u64
    x: tab.index i
    print "elem: \{x}"
    if (x & 0b0010) != 0 then print "bit set" else print "bit clear"
    w: x.u32
    print "widened: \{w}"
}
