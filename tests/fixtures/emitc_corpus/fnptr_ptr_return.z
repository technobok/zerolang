# fnptr_ptr_return.z -- a function-pointer FIELD whose function returns a
# heap-pointer collection. The `_ft` typedef is the field's C type, and it was
# built without the two return promotions the signature itself takes, so the
# typedef said `T (*)(...)` while the function was `T* (...)` -- a different
# function type from the one it names. Nothing assigned such a typedef before,
# so the mismatch sat in the output unread by the C compiler.
buildMap: function {n: i64} out (MapVV k: i64 v: i64) is {
    m: (MapVV k: i64 v: i64)
    m.set key: n value: 100
    m.set key: 7 value: 200
    return m
}

Reg: class {
    make: function {n: i64} out (MapVV k: i64 v: i64)
}

main: function is {
    reg: Reg make: buildMap.take
    got: reg.make n: 3
    print "len \{got.length}"
    r: got.get key: 7
    match r case some then print "has 7" case none then print "no 7"
}
