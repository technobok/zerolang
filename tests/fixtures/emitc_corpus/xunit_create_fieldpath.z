# xunit_create_fieldpath -- a FIELD PATH handed to a `create` in another unit
# whose parameter is a class from a third unit: the argument must arrive as a
# pointer. The emitter once passed it by value, so the C did not compile.
public: unit { :main }
Holder: class { ast: zast.Ast } as {
    run: function {:this} out u64 is {
        t: xufp_thing.Thing.create pool: this.ast.names
        return t.v
    }
}
main: function is {
    h: (Holder ast: zast.Ast.create)
    print "hasNames=\{h.run > 0}"
}
