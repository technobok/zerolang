# AN OPERATOR IS THE SAME METHOD IN EITHER FORM. Operators are declared methods
# since the single-source arc, so `a + b` and `a.+ rhs: b` name one declaration
# and must emit one thing. A USER-declared operator already did -- its body is
# an ordinary method the dotted-call legs reach -- but a NATIVE one is nobody's
# dedicated dispatcher to emit, and the call form fell through to `unhandled
# callee` at exit 0 for every numeric, every char and String.
#
# The infix form emits through the natives.tbl leg; the call form now arrives at
# the same emitter with the same operands, so the two spellings are
# byte-identical C rather than merely equivalent.

V: record {
    n: i64
} as {
    +: function {:this rhs: V} out V is {
        return (V n: (this.n + rhs.n))
    }
}

main: function is {
    x: 4.i64
    b: 1.u8
    f: 1.5
    s: "a".string

    # arithmetic, comparison, and the bitwise operators the later arc added --
    # `| ^ << >>` are absent from opCnameOf, so the route cannot key on it
    print "\{(x.+ rhs: 2)} \{(x.* rhs: 3)} \{(x.- rhs: 1)}"
    print "\{(x.== rhs: 4)} \{(x.!= rhs: 4)} \{(x.< rhs: 9)}"
    print "\{(b.<< rhs: 3)} \{(b.| rhs: 2)} \{(b.^ rhs: 3)} \{(b.& rhs: 1)}"
    print "\{(f.+ rhs: 0.5)} \{(f.* rhs: 2.0)}"
    print "\{(s.+ rhs: "b")}"

    # a LITERAL receiver: the checker materialises the base before member
    # lookup, so the literal reaches i64's operator like any other member
    print "\{(65.+ rhs: 2)}"

    # a user-declared operator, which worked in both forms already
    p: (V n: 1)
    q: (V n: 2)
    print "\{(p.+ rhs: q).n} \{(p + q).n}"
}
