# A UNIT-LEVEL `if` CONSTANT HAS THE TYPE OF THE BRANCH THAT WINS, whatever
# family the other branches hold. The branch walk types numeric literals and
# names but not a string, so a string winner used to take the type of the first
# branch that did type -- an f64 here -- and the C formatted a string as a double.
LIMIT: 5

LATE: if LIMIT > 9 then { 1.5 } else { "seven" }

EARLY: if LIMIT > 1 then { "eight" } else { 2.5 }

NUMBER: if LIMIT > 9 then { "nine" } else { 3.5 }

main: function is {
    print "\{LATE} \{EARLY}"
    n: NUMBER + 0.25
    print "\{n}"
}
