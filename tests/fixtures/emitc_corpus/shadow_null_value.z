# shadow_null_value.z -- `null` is predefined, not a keyword: a user record of
# that name is an ordinary record in its unit. Only the system unit's own `null`
# declaration is the empty type, so the user's is built and read like any
# record.

null: record { x: i64 }

main: function is {
    a: null x: 5
    print "x=\{a.x}"
}
