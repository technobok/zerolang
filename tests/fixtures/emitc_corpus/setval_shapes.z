# Every spelling a SetVal is constructed and passed in: the positional type
# argument, the `of:` label, `capacity:` inside the parens and outside them, a
# class field, and a parameter. `capacity:` is admitted by TEMPLATE IDENTITY --
# a native create's params carry no modeled children, so the label is allowed
# by name against each container template.
#
# The class field is also what proves the auto-destructor: a SetVal mono owns a
# heap table exactly as a Set does, and a field holding one leaks it otherwise.
Holder: class {
    names: (SetVal u64)
}

takes: function {s: (SetVal of: u64).view} out u64 is {
    return s.length
}

main: function is {
    a: (SetVal u64 capacity: 8)
    a.add item: 1
    b: (SetVal of: u32)
    b.add item: 2
    c: (SetVal of: u64) capacity: 32.u64
    c.add item: 3
    h: Holder names: (SetVal u64 capacity: 4)
    h.names.add item: 4
    n: takes s: a
    print "in=\{a.length} of=\{b.length} out=\{c.length} cap=\{c.capacity} field=\{h.names.length} param=\{n}"
}
