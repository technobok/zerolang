# A lock-holding value stored into a field of a local takes its locks to that
# local's root: the holder is inside the source's scope, so the store is
# allowed and the source stays locked while the holder lives.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

Holder: class {
    slot: W
}

main: function is {
    a: Src n: 1
    {
        h: Holder slot: (W s: a tag: 0 label: "first".string)
        w: mk from: a
        h.slot = w
        print "stored: \{h.slot.tag} \{h.slot.label}"
    }
    a.n = 5
    print "after: \{a.n}"
}
