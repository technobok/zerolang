# protocol_view_single_call.z -- a protocol method's view result, read for its
# data and its size, is a call: `(*b).vtable->m((*b).data)` opens like a deref,
# and was taken for a place and spelled twice, so the method ran twice. It is
# bound to a temp and runs once, in an interpolation and in an append.
Counted: class { data_: String } as {
    :Text
    stringView: function {m: this.view} outx StringView is {
        print "called"
        return m.data_.stringView
    }
}

main: function is {
    ts: List Text
    ts.append (Text.create from: (Counted data_: "hi".string))
    for each t: ts loop print "\{t.stringView}"
    acc: "".string
    for each t: ts loop acc.append t.stringView
    print "\{acc}"
}
