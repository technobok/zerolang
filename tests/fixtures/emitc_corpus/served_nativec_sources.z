# served_nativec_sources.z -- every build serves the generated unit `nativec`
# beside z.z, made from runtime.zd and each unit's nativec.zd when a program
# names it. Its first source is runtime.zd, and every source has a length.
main: function is {
    first: nativec.sources.get i: 0
    print "\{first.path}"
    ok: true
    for each s: nativec.sources loop {
        if s.length == 0 then ok = false
    }
    print "\{ok}"
}
