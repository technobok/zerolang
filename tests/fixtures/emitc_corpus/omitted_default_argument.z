# a parameter a call leaves out is its declared default, whatever declares it:
# a class or record method called on a value or through its type, a function
# in a subunit, a generic function, a method of a generic class or record, and
# a function or method of a generic unit's instance. A method call used to
# pass 0 in its place; the generic forms were refused or were invalid C.
Holder: class {
    val: i64
} as {
    same: function {h: this v: i64 k: 2} out i64 is {
        return (v * 10) + k
    }
    label: function {h: this.view a: StringView times: 3} out String is {
        return "\{a}\{times}"
    }
}
Cell: record {
    val: i64
} as {
    same: function {c: this v: i64 k: 2} out i64 is {
        return (v * 10) + k
    }
}
U: unit {
    same: function {v: i64 k: 2} out i64 is {
        return (v * 10) + k
    }
}
Gen: class {
    val: t
} as {
    t: anyval.generic
    plus: function {h: this n: 5} out i64 is {
        return n + 1
    }
    kk: function {h: this v: t k: 2} out i64 is {
        return k
    }
}
Grec: record {
    val: t
} as {
    t: anyval.generic
    kk: function {c: this v: t k: 2} out i64 is {
        return k
    }
}
cells: unit as {
    t: anyval.generic
    Box: class {
        v: t
    } as {
        get: function {c: this.view extra: 7} out i64 is {
            return extra
        }
    }
    add: function {a: t b: 1} out i64 is {
        return b
    }
}
ic: (cells t: i64)
gplus: function as { t: anyval.generic } in { a: t n: 5 } out i64 is {
    return n
}
main: function is {
    h: Holder val: 3
    c: Cell val: 3
    print "\{h.same v: 9} \{c.same v: 9} \{U.same v: 9} \{Holder.same h: h v: 9}"
    print (h.label a: "x")
    g: Gen t: i64 val: 3
    r: Grec t: i64 val: 3
    print "\{g.plus} \{g.kk v: 9} \{(Gen t: i64).plus h: g} \{r.kk v: 9}"
    b: ic.Box v: 5
    print "\{b.get} \{ic.add a: 3} \{gplus a: 2} \{gplus t: i64 a: 2 n: 8}"
}
