# take_string_arg.z -- a String argument moved into a `.take` parameter. The
# callee owns it and the caller must zero its source, or both free the buffer.

grow: function {xs: String.take} out String is {
    ys: xs
    ys.append "!"
    return ys
}

main: function is {
    a: "one".string
    r: grow xs: a
    print "got=\{r}"
}
