# A VALUE'S WIDTH IN A BODY: the left-hand operand governs, a literal operand
# coerces into it, and an `if` takes its branches' type. A constant built only
# from bare literals is an untyped literal and coerces by value wherever it
# lands; a suffixed constant has its width. Each result is proven by wrapping
# where only its own width wraps.
L: 5.u8
N: 5

consume: function {n: u8} out u8 is {
    return n
}

main: function is {
    a: L + 1
    a = a - 7
    b: 7.u32 + 1
    b = b - 9
    c: if a > 1 then { L } else { 7.u8 }
    c = c - 6
    d: "ab".length
    d = d - 3
    e: 1.u8
    f: e + N
    f = f - 7
    print "\{a} \{b} \{c} \{d} \{f} \{consume n: N}"
}
