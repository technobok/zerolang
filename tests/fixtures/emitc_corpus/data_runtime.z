# data_runtime.z -- a data value used at run time is a handle to the static object
# the compiler built: held in a local, passed, returned, compared with the
# generated `==`, read through at any depth. Only the values run time reaches
# are emitted.
mode: variant { fast: null slow: null }
inner: data { v: 3.u8 }
row: data {
    key: "k".text
    n: 5
    big: intliteral
    live: false
    m: mode
    sub: inner
}
first: (row key: "alpha" big: 70000 m: mode.slow sub: (inner v: 9))
second: (row key: "beta" big: 1 m: mode.fast sub: (inner v: 2))

show: function {r: row} is {
    print "\{r.key.stringView} \{r.n} \{r.big} \{r.live} \{r.sub.v}"
}

pick: function {b: bool} out row is {
    if b then return first
    return second
}

main: function is {
    p: first
    show r: p
    q: pick b: false
    show r: q
    print "\{p.sub.v} \{q.n}"
    if q.m == mode.fast then print "fast"
    a: p.sub
    if a == first.sub then print "eq"
    if a != q.sub then print "ne"
}
