# A typedef built inline as an argument borrows its source into a borrowing
# parameter (`len p: (Path s)`), which leaves it its name's, and consumes it
# into a taking one (`eat p: (Path t)`), whose temporary the call's end frees --
# by value or by reference, one argument or two.
len: function {p: Path} out u64 is { return p.length }
eat: function {p: Path.take} out u64 is { return p.length }
both: function {a: Path b: Path} out u64 is { return a.length + b.length }
count: function {b: Bytes} out u64 is { return b.length }

main: function is {
    s: "abc".string
    t: "de".string
    u: "fghi".string
    v: "jk".string
    xs: ListVal u8
    xs.append from: 65
    print "len=\{len p: (Path s)} eat=\{eat p: (Path t)} both=\{both a: (Path u) b: (Path v)} bytes=\{count b: (Bytes xs)}"
    print "kept=\{s} \{u} \{v} \{xs.length}"
}
