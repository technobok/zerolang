# A typedef built inline as an argument (`len p: (Path s)`) consumes its source
# into the call's temporary, which the call's end frees -- by value or by
# reference, one argument or two, into a borrowing or a taking parameter.
len: function {p: Path} out u64 is { return p.length }
eat: function {p: Path.take} out u64 is { return p.length }
both: function {a: Path b: Path} out u64 is { return a.length + b.length }
count: function {b: Bytes} out u64 is { return b.length }

main: function is {
    s: "abc".string
    t: "de".string
    u: "fghi".string
    v: "jk".string
    xs: ListVal u8
    xs.append from: 65
    print "len=\{len p: (Path s)} eat=\{eat p: (Path t)} both=\{both a: (Path u) b: (Path v)} bytes=\{count b: (Bytes xs)}"
}
