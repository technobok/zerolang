# a generic unit applied in place -- `(mathops t: i64).add a: 1 b: 2` -- is the
# instance a unit-level binding with the same arguments names: in a body, as a
# call argument, inside a generic function or another generic unit over its
# own parameter, in a signature's type, in a unit-level definition naming a
# type it declares, through a nested unit's template, and for a zero-argument
# function of a numeric unit.
mathops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
    double: function {v: t} out t is { return v + v }
}
cells: unit as {
    t: anyval.generic
    Cell: record {
        val: t
    }
    id: function {v: t} out t is {
        return v
    }
}
sized: unit as {
    n: u32.generic
    cap: function out u32 is {
        return n
    }
}
outer: unit {
    tripler: unit as {
        t: anyval.generic
        triple: function {v: t} out t is { return v + v + v }
    }
}
wrap: unit as {
    u: anyval.generic
    quad: function {v: u} out u is {
        d: (mathops t: u).double v: v
        return d + d
    }
}
ic: (cells t: i64)
wi: (wrap u: i64)
C5: (cells t: i64).Cell
show: function {c: ic.Cell} out i64 is {
    return c.val
}
sig: function {x: (cells t: i64).Cell} out i64 is {
    return x.val
}
twice: function as { t: anyval.generic } in { a: t } out t is {
    x: (cells t: t).id v: a
    return x + x
}
consume: function {v: i64} out i64 is {
    return v
}
main: function is {
    r: (mathops t: i64).add a: 1 b: 2
    s: (mathops t: i64).add a: 3 b: 4
    print "body: \{r} \{s} \{(mathops t: i64).add a: 5 b: 6} \{consume v: ((mathops t: i64).add a: 7 b: 8)}"
    c: (cells t: i64).Cell val: 9
    k: C5 val: 10
    print "types: \{show :c} \{sig x: k} \{show c: k}"
    print "generic: \{twice t: i64 a: 3} \{twice t: u8 a: 4} \{wi.quad v: 3}"
    print "nested: \{(outer.tripler t: i64).triple v: 2}"
    print "numeric: \{(sized n: 4).cap} \{(sized n: 9).cap}"
}
