# guard_else_return_narrows_after -- A single-clause `if` whose else leaves the
# function: its condition held for the code after it, so the name reads the arm's
# payload there.
f: function {o: optionval i64} out i64 is {
    if o.some then print "some" else return 0
    return o + 1
}
main: function is {
    print "\{f o: (optionval.some 4)}"
    print "\{f o: (optionval.none i64)}"
}
