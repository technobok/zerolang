# lock_dies_with_block_after_release.z -- a lock laid in a block after an outer
# holder released its own there dies with the block. `v.drop` inside the block
# releases v's locks on o; `t: o.s.stringView` then locks o for the block only,
# so after it o may be written whole.
LfOwn: class {
    s: String
}

main: function is {
    o: LfOwn s: "abc def".string
    v: o.s.stringView
    k: v.length > 0
    if k then {
        v.drop
        t: o.s.stringView
        print t
    }
    o = LfOwn s: "zzz".string
    print o.s
}
