# thread_handle_never_spawned.z -- a thread handle's type may be named by a
# program that starts no thread: a field that stays empty, an option that is
# never `some`. The handle holds the task it runs, so its instance knows the
# task's type from what `create` takes, whether or not anything calls `create`.
Worker: class {
    name: String
    handle: Option (thread.JoinHandle String)
}

main: function is {
    w: (Worker name: "idle".string handle: (Option (thread.JoinHandle String)).none)
    if w.handle.none then print "\{w.name}: no thread"
}
