# An operation on two literals is computed by the compiler, written between
# its operands or as a call, and bound, printed or left as a statement, which
# then runs nothing.
N: (6.+ rhs: 3)

main: function is {
    100 - 250
    1.5 * 2.0
    6.+ rhs: 3
    x: 6.+ rhs: 3
    k: (1.0./ rhs: 4.0)
    w: 2.u8
    z: 250.+ rhs: w
    print "\{x} \{k} \{z} \{N}"
    print "\{((18446744073709551615.+ rhs: 1) - 18446744073709551615)}"
}
