# A GENERIC TYPE'S CONCRETE MEMBERS KEEP THEIR TYPES. A field whose type does
# not mention the template's parameters -- a list, an array, a str, another
# generic's instance -- is that type in every instance, whatever the instance
# binds its parameters to. It used to take the first type argument instead
# when the field's type was an instance (`s.first` was a u8 in
# `(Stack t: u8)`), and the instance's constructor then took the wrong type.
Stack: class {
    items: (ListVal t: i64)
    top: u
} as {
    u: anyval.generic
}

peek: function {s: (Stack u: u8)} out u64 is {
    return s.items.length
}

Pair: class {
    first: (array t: i64 to: 2)
    n: t
} as {
    t: anyval.generic
}

Row: record {
    first: (array t: i64 to: 2)
} as {
    t: anyval.generic
}

show: function in { s: (Row t: u8) } out u64 is {
    return s.first.length
}

Cell: record {
    val: v
} as {
    v: anyval.generic
}

Wrap: record {
    c: (Cell v: i64)
    k: t
} as {
    t: anyval.generic
}

Named: record {
    label: (str to: 8)
    n: t
} as {
    t: anyval.generic
}

main: function is {
    s: Stack u: u8 items: (ListVal t: i64) top: 3
    s.items.append from: 4
    print "\{peek :s} \{s.top} \{s.items.get i: 0}"
    p: (Pair t: u8) first: (array t: i64 to: 2) n: 7
    p.first.set i: 1 item: 99
    print "\{p.first.length} \{p.first.get i: 1} \{p.n}"
    r: Row t: u8 first: (array t: i64 to: 2)
    q: (Row t: bool) first: (array t: i64 to: 2)
    print "\{show s: r} \{q.first.length}"
    w: (Wrap t: u8) c: (Cell v: i64 val: 40) k: 2
    print "\{w.c.val + 2} \{w.k}"
    x: (Named t: u16) label: ("hi".str to: 8) n: 3
    print "\{x.label} \{x.n}"
    l: List String
    l.append from: "a".string
    m: (ListVal i64)
    m.append from: 3
    print "\{l.length} \{m.length}"
}
