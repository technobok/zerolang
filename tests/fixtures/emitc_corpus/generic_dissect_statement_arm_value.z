# generic_dissect_statement_arm_value -- a compile-time match over a type parameter
# standing as a statement asks no value of its selected arm: an arm ending in an `if`
# whose branches yield different types is accepted, as in a run-time match.
bump: function {n: i64} out i64 is {
    print "bump \{n}"
    return n + 1
}

half: function {n: i64} out f64 is {
    print "half \{n}"
    return 0.5
}

say: function as { t: anyval.generic } in { v: t n: i64 } is {
    match (t) case i64 then {
        print "int"
        if n > 2 then (bump :n) else (half :n)
    } else {
        print "other"
        if n > 2 then (bump :n) else (half :n)
    }
}

main: function is {
    say t: i64 v: 1 n: 2
    say t: bool v: true n: 3
}
