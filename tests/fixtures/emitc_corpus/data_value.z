# data_value.z -- a data block's name is a value: `intdata t` or `floatdata t`,
# a view of the block's static array. It is bound, passed, returned, held in a
# field, read with `index` and `length`, and walked with `iterate`; binding
# copies the view, takes no lock, and leaves the block readable. A block whose
# `out` is a typedef reads its elements as that typedef.
primes: data { 2 3 5 7 11 } out u8
halves: data { 0.5 0.25 0.125 }
byteid: typedef u8
codes: data { 9 10 32 } out byteid

total: function {d: intdata u8} out u64 is {
    t: 0.u64
    for each p: d.iterate loop t = t + p.u64
    return t
}

pick: function out intdata u8 is {
    return primes
}

Table: class {
    vals: intdata u8
}

main: function is {
    print "total=\{total d: primes}"
    w: primes
    print "w0=\{w.index i: 0} wlen=\{w.length} p4=\{primes.4}"
    x: pick
    i: 3.u64
    print "x3=\{x.index :i}"
    t: Table vals: primes
    print "tlen=\{t.vals.length} t2=\{t.vals.index i: 2}"
    n: 0.u64
    for each q: t.vals.iterate loop n = n + q.u64
    print "tsum=\{n}"
    with v: primes do print "with=\{v.length}"
    for each p: primes.iterate loop print "p=\{p}"
    f: halves
    s: 0.0
    for each h: f.iterate loop s = s + h
    print "s=\{s} f1=\{f.index i: 1}"
    j: 1.u64
    c: codes.index i: j
    print "c=\{c.u8}"
}
