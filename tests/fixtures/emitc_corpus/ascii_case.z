# ascii_case.z -- `ascii.lower` and `ascii.upper` change the case of a letter
# and leave every other byte as it is: the bytes beside the letters in the
# table (`@`, `[`, `` ` ``, `{`), a digit, a byte above ASCII.
show: function {b: u8} is {
    print "\{b} lower \{ascii.lower :b} upper \{ascii.upper :b}"
}

main: function is {
    show b: 0cA
    show b: 0cZ
    show b: 0ca
    show b: 0cz
    show b: 0c@
    show b: ascii.bracketOpen
    show b: ascii.backtick
    show b: ascii.braceOpen
    show b: 0c5
    show b: 200
    buf: String
    for each c: "Hello, World 42".byteView loop buf.appendByte b: (ascii.upper b: c)
    print buf
}
