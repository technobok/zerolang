# a function value is spelled through its type's typedef wherever it is held:
# a record field, a parameter, a local, and a local inside a method body.
double: function {n: i64} out i64 is {
    return n * 2
}
apply: function {f: double.take n: i64} out i64 is {
    return (f n: n)
}
Op: record {
    run: double.take
}
Calc: class {
    base: i64
} as {
    twice: function {:this} out i64 is {
        g: double.take
        return (g n: this.base)
    }
}
main: function is {
    f: double.take
    o: Op run: double.take
    c: Calc base: 5
    print "\{apply f: f n: 3} \{o.run n: 4} \{c.twice}"
}
