# static_list_folded_only.z -- a list read only at compile time writes no C:
# its elements, its length and its labels fold, so neither the list's array
# nor its view type is emitted (static-value-guard checks the view type).
codes: list { ht: 9 lf: 10 } out staticlist u8
words: list { "alpha" "beta" }
main: function is {
    print words.0
    print "\{words.length} \{codes.lf} \{codes.slot.ht}"
}
