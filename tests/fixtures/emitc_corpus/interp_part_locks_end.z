# interp_part_locks_end.z -- an interpolation appends each part before it
# evaluates the next, so what one part keeps locked ends with that part: a
# later part may change the value an earlier one read.

main: function is {
    ps: List String
    ps.append "a".string
    print "\{(ps.get i: 0)} \{(ps.getMut i: 0)}"
}
