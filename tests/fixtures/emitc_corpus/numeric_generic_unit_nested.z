# A TYPE A GENERIC UNIT DECLARES TAKES THE UNIT INSTANCE'S NUMERIC ARGUMENTS.
# Each instance of the unit has its own instance of the type, and that instance
# holds the value of every numeric parameter of the unit, as it holds the type
# of every type parameter. A method body reads it (`n`), a field defaults to
# it (`size: n`), a marked field is of its bound (`held: n.hold`) and a method
# parameter defaults to it (`m: n`). Without the value, the body named a C
# variable that does not exist and a construction left the default out.
wrap: unit as {
    t: anyval.generic
    n: u64.generic
    bag: class {
        v: t
        size: n
        held: n.hold
    } as {
        scaled: function {b: this.view m: n} out u64 is {
            return m * 10 + b.size + n
        }
    }
    slot: record {
        y: i64
        x: n
    } as {
        width: function {s: this} out u64 is {
            return n + s.x
        }
    }
    make: function {v: t} out bag is {
        return (bag :v held: 7)
    }
    place: function {y: i64} out slot is {
        return (slot :y)
    }
}
wa: (wrap t: i64 n: 3)
wb: (wrap t: f64 n: 8)

main: function is {
    a: wa.make v: 5
    b: wb.make v: 2.5
    print "bag \{a.v} \{a.size} \{a.held} \{a.scaled} \{a.scaled m: 1}"
    print "bag \{b.v} \{b.size} \{b.held} \{b.scaled} \{b.scaled m: 1}"
    p: wa.place y: 1
    q: wb.place y: 2
    print "slot \{p.y} \{p.x} \{p.width} \{q.y} \{q.x} \{q.width}"
}
