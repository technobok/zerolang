# settle_address_arg -- an argument passed by address (a union) is built into a
# temporary before its call reads it, in the order it is written, also when a
# later operand is a control value that makes the operands before it
# statements first. f16 arithmetic calls helpers, so its operands are ordered
# parts. Before the fix the temporary was filled after the call that read it:
# `g` saw an empty union and took the wrong arm, and `mk` ran after `g`.

Un: union {
    c1: null
    c2: null
}

mk: function out Un is {
    print "mk"
    return Un.c2
}

h: function out f16 is {
    print "h"
    return 1.0.f16
}

g: function {a: Un} out f16 is {
    match a case c2 then print "g c2" else print "g c1"
    return 3.0.f16
}

main: function is {
    xs: ListVal f16
    xs.append h + ((g a: mk) % (match true case true then 2.0.f16 case false then 5.0.f16))
    xs.append (
        0.0.f16 -
        0.0.f16 +
        ((g a: Un.c2) % (match true case true then 2.0.f16 case false then 5.0.f16))
    )
    print "\{(xs.get i: 0).bits} \{(xs.get i: 1).bits}"
}
