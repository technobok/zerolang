# xunit_qualsub -- names its own subunit's type by a qualified reference in
# every declaration position: a return, a parameter, and a record field.
asReturn: function out sub.T is {
    return (sub.T n: 4)
}

asParam: function {v: sub.T} out i64 is {
    return v.n
}

Holder: record {
    f: sub.T
}

asField: function out i64 is {
    h: Holder f: (sub.T n: 9)
    return h.f.n
}
