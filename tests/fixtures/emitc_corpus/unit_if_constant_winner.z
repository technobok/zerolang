# unit_if_constant_winner.z -- a unit-level `if` constant takes the type of the
# branch that WINS, not of the first one written. Both spellings below have a
# statically false first branch holding an f64, so each constant is the else
# clause's integer, and an integer-only method applies to it: f64 declares no
# `&`. The two spellings parse to the same tree, whose value is the `if` itself.
LIMIT: 5

PAREN: (if LIMIT > 9 then { 1.5 } else { 7 })

BARE: if LIMIT > 9 then { 2.5 } else { 14 }

main: function is {
    p: PAREN & 3
    b: BARE & 6
    print "\{p} \{b}"
}
