# data_fold.z -- a field read on a data value folds to the field's value, at
# unit level and in a body, through any depth of nested values and through a
# type's `as` constant. The value itself is never emitted: each read is the
# constant it folds to -- text, a typed number, an untyped number (which keeps
# its full value until it is used), bool, an arm.
mode: variant { fast: null slow: null }

inner: data {
    v: 3.u8
} as {
    ONE: (inner v: 1)
}

row: data {
    key: "k".text
    n: 5
    big: intliteral
    live: false
    m: mode
    sub: inner
}

first: (row key: "alpha" big: 99999999999999999999999 m: mode.slow sub: (inner v: 9))
plain: inner.create
k: first.key
deep: first.sub.v
one: inner.ONE.v
scaled: first.big / 1000000000000000

main: function is {
    print first.key.stringView
    print "\{first.n} \{first.live} \{first.sub.v} \{deep} \{one} \{scaled}"
    print k.stringView
    if first.m == mode.slow then print "slow"
    print "\{inner.ONE.v} \{plain.v}"
}
