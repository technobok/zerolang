# A field an arm yields into a slot that takes it moves out of the field on that
# arm's path, as `f s: h.p` does: the field reads empty afterwards, and the rest
# of the call may not read it.
Holder: class {
    p: String
    q: String
}

keep: function {s: String.take} out u64 is {
    return s.length
}

Box2: class {
    s: String
}

main: function is {
    h: Holder p: "hp".string q: "hqq".string
    print "taken \{keep s: (if true then h.p else "made".string)} '\{h.p}' '\{h.q}'"
    g: Holder p: "gp".string q: "gqq".string
    print "other \{keep s: (if false then g.p else "made".string)} '\{g.p}'"
    k: Holder p: "kp".string q: "kq".string
    b: Box2 s: (if true then k.p else "made".string)
    print "field \{b.s} '\{k.p}'"
}
