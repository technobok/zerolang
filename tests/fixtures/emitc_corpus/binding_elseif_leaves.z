# binding_elseif_leaves.z -- a binding's value may be an `if` chain any of
# whose arms leaves, an `else if` arm included. The binding is assigned on the
# arms that yield, and the arm that leaves runs as the statement it is: a
# `break`, a `continue` or a `return`.

pick: function {z: i64} out i64 is {
    v: if z == 1 then 100 else if z == 2 then return 0 else 300
    return v + 1
}

main: function is {
    n: 0
    for n < 3 loop {
        n = n + 1
        v: if n == 1 then 100 else if n == 2 then break else 300
        print "break \{v}"
    }
    m: 0
    for m < 3 loop {
        m = m + 1
        w: if m == 1 then 10 else if m == 2 then continue else 30
        print "continue \{w}"
    }
    print "pick \{pick z: 1} \{pick z: 2} \{pick z: 3}"
}
