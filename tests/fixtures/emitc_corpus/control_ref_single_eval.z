# control_ref_single_eval.z -- a `match` (or a non-ternary `if`) that yields a
# place, read as a view: the view is built from the place's data and size, so
# the place is read twice, and a statement-expression place -- `(*({ ... }))` --
# would run its subject and arms twice. It is bound to a temp and runs once.
k: variant {one: null two: null}

tick: function {n: k} out k is {
    print "tick"
    return n
}

main: function is {
    a: "alpha".string
    b: "beta".string
    v: (match (tick n: k.one) case one then a case two then b).stringView
    print "\{v}"
    w: (if (tick n: k.two).two then { a } else { b }).stringView
    print "\{w}"
}
