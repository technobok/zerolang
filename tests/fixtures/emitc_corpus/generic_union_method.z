# generic_union_method.z -- as-block METHODS on a user UNION, generic and at two
# instantiations. emitDefMethods tested isRecordDef, isClassDef and isVariantDef
# and there was no isUnionDef anywhere in the emitter, so no user method on ANY
# union -- generic or not -- was emitted, while the call site emitted a call to
# it. attachUnionMethods separately never marked a generic union's methods, so
# its monos carried the template's function type.
Holder: union {
    some: T
    none: null
} as {
    T: AnyRef.generic
    scaled: function {h: this by: i64} out i64 is { return by * 3 }
    matches: function {h: this rhs: Holder} out bool is { return true }
}

Plain: union {
    one: String
    none: null
} as {
    twice: function {p: this n: i64} out i64 is { return n + n }
}

main: function is {
    a: Holder.some "hi".string
    b: Holder.none String
    print "String scaled \{a.scaled by: 4}"
    print "String matches \{a.matches rhs: b}"

    c: Holder.some (List String)
    print "List scaled \{c.scaled by: 5}"

    p: Plain.one "x".string
    print "plain twice \{p.twice n: 6}"
}
