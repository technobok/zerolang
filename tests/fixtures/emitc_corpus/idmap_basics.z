# IdMap / IdSet: the append-only, id-keyed containers. Covers both value
# families, an id-typedef key, growth across the small-mode boundary (no
# `indices` array below it) and the index rebuild past it, and a container
# mutated through a function parameter -- a stack struct passes by pointer.
rowid: record { val: u32.typedef }
pair: record {
    a: u64
    b: u64
}

# a class OWNING an id container: the holder must free the two arrays in
# place, where a Map field would have been a pointer it merely destroyed
Holder: class {
    byName: (IdMapV u64 value: u64)
}

fill: function {m: (IdMapV u64 value: u64) n: u64} is {
    i: u64
    for i < n loop {
        m.set key: (i * 7) value: (i + 1000)
        i = i + 1
    }
}

# `.copy` out of a BORROWED entry is an owned value. The entry is readonly --
# iterateItems takes a `.view` receiver, so the element inherits a shared pin --
# and a copy of a readonly reference is still owned, so it may be moved on.
copyOut: function {m: (IdMapR u64 value: String) dst: (ListRef String)} is {
    with cit: m.iterateItems do for ce: cit loop {
        cv: ce.value.copy
        dst.append from: cv
    }
}

# and a field-resident IdMap is readable AND iterable through a readonly holder
sumHolder: function {h: Holder.view} out u64 is {
    t: u64
    with hit: h.byName.iterateItems do for he: hit loop t = t + he.value
    return t
}

main: function is {
    m: (IdMapV u64 value: u64)
    fill :m n: 200
    ok: u64
    j: u64
    for j < 200 loop {
        g: m.get key: (j * 7)
        match (
            g
        ) case some then {
            if g == (j + 1000) then ok = ok + 1
        } case none then null
        j = j + 1
    }
    print "idmapv len=\{m.length} ok=\{ok} absent=\{m.has key: 999999}"

    # overwrite in place: the entry count does not move
    m.set key: 0 value: 5
    o0: m.get key: 0
    match (
        o0
    ) case some then {
        print "overwrite -> \{o0} len=\{m.length}"
    } case none then null

    s: (IdSet u32)
    k: u32
    for k < 100 loop {
        s.add item: (k * 3)
        k = k + 1
    }
    dup: s.add item: 3
    print "idset len=\{s.length} readd=\{dup} has33=\{s.has item: 33} has34=\{s.has item: 34}"

    # an id space is a typedef over an unsigned scalar; the bound admits it
    t: (IdMapV rowid value: u64)
    t.set key: (rowid from: 42) value: 4242
    tg: t.get key: (rowid from: 42)
    match (
        tg
    ) case some then {
        print "typedef key -> \{tg}"
    } case none then null

    # a REFERENCE value: get hands back a view into the entry storage
    r: (IdMapR u64 value: String)
    r.set key: 1 value: "one".string
    r.set key: 2 value: "two".string
    rg: r.get key: 2
    match (
        rg
    ) case some then {
        print "idmapr -> \{rg} len=\{r.length}"
    } case none then null

    # a USER type by value: the mono embeds it, so it is a late mono and must
    # be emitted after the optionval its `get` returns
    pm: (IdMapV rowid value: pair)
    pm.set key: (rowid from: 3) value: (pair a: 1 b: 2)
    pg: pm.get key: (rowid from: 3)
    match (
        pg
    ) case some then {
        print "user value \{pg.a} \{pg.b}"
    } case none then null

    # iteration is INSERTION order and needs no alive test: nothing is ever
    # removed, so the dense array IS the iteration
    order: (IdSet u32)
    order.add item: 90
    order.add item: 7
    order.add item: 41
    order.add item: 7
    seen: (ListVal u32)
    with oit: order.iterate do for ov: oit loop seen.append ov
    print "iter n=\{seen.length} first=\{seen.get i: 0} second=\{seen.get i: 1} third=\{seen.get i: 2}"

    # iterateItems yields a borrowed entry: key and value project the entry
    # struct, and the value is NOT owned by the loop -- the container frees it
    ents: (IdMapR u64 value: String)
    ents.set key: 3 value: "three".string
    ents.set key: 1 value: "one".string
    en: u64
    with eit: ents.iterateItems do for ee: eit loop {
        print "entry \{ee.key} -> \{ee.value}"
        en = en + 1
    }
    print "entries=\{en}"

    # a holder that owns one, exercised past the small-mode boundary so both
    # arrays exist to leak
    hs: (List Holder)
    hi: u64
    for hi < 3 loop {
        hd: Holder byName: (IdMapV u64 value: u64)
        hj: u64
        for hj < 40 loop {
            hd.byName.set key: (hj * 3) value: hj
            hj = hj + 1
        }
        hs.append hd
        hi = hi + 1
    }
    print "holders=\{hs.length}"

    owned: (ListRef String)
    copyOut m: ents dst: owned
    print "copied=\{owned.length} first=\{owned.get i: 0}"
    print "viewsum=\{sumHolder h: (hs.get i: 0)}"

    # getMut writes the entry IN PLACE, which the value family's copying `get`
    # cannot. Each borrow is scoped: two live views of one container conflict.
    pm2: (IdMapV u64 value: pair)
    pm2.set key: 7 value: (pair a: 1 b: 2)
    {
        mv: pm2.getMut key: 7
        match (
            mv
        ) case some then {
            mv.a = 40
        } case none then null
    }
    {
        mg: pm2.get key: 7
        match (
            mg
        ) case some then {
            print "getMut -> \{mg.a} \{mg.b}"
        } case none then null
    }
    {
        mmiss: pm2.getMut key: 999
        match (
            mmiss
        ) case some then null case none then {
            print "getMut miss is none"
        }
    }

    # empty containers allocate nothing at all
    e: (IdMapV u64 value: u64)
    e2: (IdSet u64)
    print "empty \{e.length} \{e2.length} \{e.has key: 1} \{e2.has item: 1}"
}
