# record_value_members.z -- what a record MAY hold, now that a reftype member
# is refused at the declaration: scalars, a nested record, a variant whose
# payload is a record, and a bool; the synthesised `==` compares all of it by
# value. A valtype that must live on the heap is a `Box from:` LOCAL -- Box is
# a class, so a Box field would be a reftype field, and the heap route never
# passes through the record.
pt: record { x: i64  y: i64 }
seg: record { a: pt  b: pt  open: bool }
shape: variant {
    none: null
    dot: pt
    line: seg
}

main: function is {
    p: pt x: 1 y: 2
    q: pt x: 1 y: 2
    s: seg a: p b: (pt x: 3 y: 4) open: true
    t: seg a: q b: (pt x: 3 y: 4) open: true
    print "pt eq=\{p == q} seg eq=\{s == t} seg ne=\{s != (seg a: p b: p open: false)}"
    d: shape.dot p
    l: shape.line s
    print "dot=\{d.dot} line=\{l.line} bx=\{s.b.x}"
    b: Box from: (pt x: 5 y: 6)
    b
    n: Box from: 42
    print "boxed=\{n + 1}"
}
