# generator_closed_range.z -- a CLOSED integer range whose loop body suspends.
#
# `for each i: (F.upto to: T) loop` lowers to a counted C loop carrying TWO values:
# the loop variable and the count of values after it. The resume `goto` lands
# inside the loop, past both declarations, so both are indeterminate on the next
# `.call` unless both are spilled -- where the half-open form has only the
# variable to save. Neither can be recomputed either: the ends they were taken
# from are not kept across a suspension.
#
# `Down` walks an unsigned range to zero, the shape no endpoint comparison can
# express; `Twice` proves two sibling loops draw two distinct count fields;
# `Nest` proves an inner suspending closed loop still works; `Full` walks all
# 2^64 values of u64, a count that fits only as the values after the current one.

Up: generator { n: i64 } as {
    call: function out i64 is {
        for each i: (2.upto to: this.n) loop {
            yield i
        }
    }
}

Down: generator { n: u8 } as {
    call: function out u8 is {
        for each i: (this.n.downto to: 0.u8) loop {
            yield i
        }
    }
}

Twice: generator { n: i64 } as {
    call: function out i64 is {
        for each i: (1.upto to: this.n) loop {
            yield i
        }
        for each j: (1.upto to: this.n) loop {
            yield j + 100
        }
    }
}

Nest: generator { n: i64 } as {
    call: function out i64 is {
        for each a: (1.upto to: this.n) loop {
            for each b: (1.upto to: this.n) loop {
                yield (a * 10) + b
            }
        }
    }
}

Full: generator { top: u64 } as {
    call: function out u64 is {
        for each i: (0.u64.upto to: this.top) loop {
            yield i
        }
    }
}

main: function is {
    for each u: (Up n: 5) loop print "up: \{u}"
    for each d: (Down n: 3.u8) loop print "down: \{d}"
    for each t: (Twice n: 2) loop print "t: \{t}"
    for each g: (Nest n: 2) loop print "g: \{g}"
    for each f: (Full top: 18446744073709551615.u64) loop {
        print "full: \{f}"
        if f == 2 then break
    }
    print "done"
}
