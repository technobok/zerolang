# A `hold` field is OWNED and readonly: the slot is an ordinary one -- the
# constructor takes the value, reassigning destroys the old one, and the
# destructor frees it -- while `borrow` / `view` / `lock` fields are static,
# set at construction and never again. Only the contents differ, so this is
# leak-clean and frees nothing twice.
Box: class {
    name: String.hold
    value: i64
}
main: function is {
    b: Box name: "first".string value: 1
    print "1=\{b.name} \{b.value}"
    other: "second".string
    b.name = other
    print "2=\{b.name} \{b.value}"
}
