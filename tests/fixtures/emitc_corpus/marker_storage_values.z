# The places an ownership marker does apply, and the values that take none: a
# local, a field and a function reference take markers -- a view field is taken,
# and a field that owns what it holds is borrowed, since it never moves; a
# constant, a literal and a data element are passed bare, and a typedef wrapper's
# `borrow` is a call.
LIMIT: 9
GREETING: "hello, world"
primes: data { 2 3 5 7 }

Holder: class {
    s: StringView
    o: String
}

eat: function {s: StringView.take} is {
    print "eat \{s}"
}

helper: function {n: i64} out i64 is {
    return n + 1
}

main: function is {
    v: 5
    w: v.take
    s: "abc"
    t: s.borrow
    h: Holder s: "view" o: "owned".string
    hs: h.s.take
    ho: h.o.borrow
    f: helper.take
    eat s: GREETING
    eat s: "literal"
    arr: primes.array
    print "\{w} \{t} \{hs} \{ho} \{f n: LIMIT} \{primes.0} \{primes.length} \{arr.length}"
}
