# partial_field_answers_template -- A field typed by a specialization over a parameter
# answers as its template does: an option is value data, and a bare read of it is
# returned.
Holder: class {
    o: (optionval t: elem)
    get: function {:this} out (optionval t: elem) is {
        return this.o
    }
} as { elem: anyval.generic }
main: function is {
    h: Holder o: (optionval.some 4)
    r: h.get
    print "\{r.or d: 0}"
}
