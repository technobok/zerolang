# A GENERATOR BODY'S FUNCTION-REFERENCE LOCAL LIVES IN THE INSTANCE. A local
# the body binds is kept in a field of the state class, so it survives a
# suspension. A function reference's field was declared but never flagged as a
# function-pointer field, so the state struct did not store it and the C
# compiler refused the write (`has no member named 'g_1'`).

# doubleFn -- a function reference with double's signature: the type, with no default
doubleFn: function {n: i64} out i64

double: function {n: i64} out i64 is {
    return n * 2
}

triple: function {n: i64} out i64 is {
    return n * 3
}

Steps: generator { f: doubleFn } as {
    call: function out i64 is {
        g: this.f.copy
        h: triple.copy
        yield 1
        yield (g n: 2)
        g = h.copy
        yield (g n: 2)
    }
}

main: function is {
    for each t: (Steps f: double.copy) loop print "step \{t}"
}
