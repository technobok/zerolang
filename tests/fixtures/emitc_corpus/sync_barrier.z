# sync_barrier.z -- three threads meet at a barrier twice: none passes a round
# before all three arrive, and each round has exactly one leader.

# Walker -- counts its arrivals at each round, and whether it led
# walk -- what one walker saw
walk: record {
    # the count it saw after round one
    seen: i64
    # how many rounds it led
    led: i64
}

# Walker -- crosses the barrier twice, counting arrivals between
Walker: class {
    # where the threads meet
    b: sync.Barrier
    # how many threads had finished round one when this one left it
    arrived: sync.AtomicI64
} as {
    task: (thread.TaskVal walk)
    call: function {:this} out walk is {
        led: 0.i64
        this.arrived.fetchAdd value: 1
        if this.b.wait then led = led + 1
        seen: this.arrived.load
        if this.b.wait then led = led + 1
        return (walk :seen :led)
    }
}

main: function is {
    b: sync.Barrier.create count: 3
    arrived: sync.AtomicI64.create value: 0
    {
        x: thread.spawnVal task: (Walker b: b.share arrived: arrived.share)
        y: thread.spawnVal task: (Walker b: b.share arrived: arrived.share)
        z: thread.spawnVal task: (Walker b: b.share arrived: arrived.share)
        dx: x.join
        dy: y.join
        dz: z.join
        print "each saw all three: \{(dx.seen == 3) and (dy.seen == 3) and (dz.seen == 3)}"
        print "leaders: \{(dx.led + dy.led) + dz.led}"
    }
}
