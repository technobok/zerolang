# A CONSTANT THAT READS A CONSTANT OVER A NUMERIC GENERIC PARAMETER HAS A VALUE
# IN EACH INSTANCE. `F: cap.u64` reads the parameter through a conversion, and
# `G: F + 1` reads F, so G is derived from the parameter too: each instance
# folds both, and the template has a value for neither. The template asked G
# for its own value, found none, and refused it ("'F' has no compile-time
# value") when F read the parameter through anything but an operator. A
# generic unit with no instance (`spare`) is still walked as a template, and
# a read of its constants in its function asks none of them for a value.
Box: class {
    used: u32
} as {
    cap: u32.generic
    D: cap * 1
    E: D * 2
    F: cap.u64
    G: F + 1
    info: function {:this} out String is {
        return "\{D} \{E} \{F} \{G}"
    }
}

sized: unit as {
    cap: i64.generic
    D: cap.i64
    E: D * 2
    F: E + 1
    get: function {} out i64 is {
        return D + E + F
    }
}
four: (sized cap: 4)
nine: (sized cap: 9)

spare: unit as {
    cap: i64.generic
    D: cap.i64
    E: D * 2
    get: function {} out i64 is {
        return D + E
    }
}

main: function is {
    b: (Box cap: 5) used: 1
    c: (Box cap: 7) used: 1
    print "box \{b.info} | \{c.info}"
    print "unit \{four.get} \{four.F} \{nine.get} \{nine.F}"
}
