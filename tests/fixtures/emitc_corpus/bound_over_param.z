# A `.generic` bound may name an instance over another of the template's own
# parameters, `T: (Getter v: k).generic`: once the instantiation binds k, T's
# argument must conform to that instance -- here Byte to `(Getter v: u8)` and
# Word to `(Getter v: i64)`, for a function and for a class.
Getter: protocol {
    v: anyval.generic
    get: function {t: this.view} out v
}

Byte: class { b: u8 } as {
    g: (Getter v: u8)
    get: function {t: this.view} out u8 is { return t.b }
}

Word: class { w: i64 } as {
    g: (Getter v: i64)
    get: function {t: this.view} out i64 is { return t.w }
}

read: function {t: T u: k} out k is { return t.get } as {
    k: anyval.generic
    T: (Getter v: k).generic
}

Pair: class { t: T  u: k } as {
    k: anyval.generic
    T: (Getter v: k).generic
}

main: function is {
    print "\{read t: (Byte b: 7) u: 3.u8} \{read t: (Word w: 9) u: 1}"
    p: Pair t: (Word w: 5) u: 2
    print "\{p.t.get} \{p.u}"
}
