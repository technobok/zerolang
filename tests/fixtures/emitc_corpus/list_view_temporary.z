# A LIST'S VIEW PASSED STRAIGHT FROM ONE CALL TO ANOTHER IS WRITTEN: the view a
# `listView` or a `slice` answers, handed to `extendView` with no binding of its
# own, is spelled only by those members' C, and its type was never written --
# the C named a struct that did not exist.
main: function is {
    src: ListVal u8
    src.append 7
    src.append 8
    src.append 9
    whole: ListVal u8
    whole.extendView from: src.listView
    part: ListVal u8
    part.extendView from: (src.slice from: 1 to: 3)
    print "\{whole.length} \{part.length} \{part.get i: 0}"
}
