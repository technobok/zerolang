# A unit-level constant may share its name with the data type its value
# builds: `foundation: (c.foundation n: 3)`. Read from another unit
# (`su.foundation`), the name is the constant, a value, and not the type of
# the same name, which a bare name in value position would construct.
sch: unit {
    foundation: data { n: 0 }
    Conf: record { k: 5 }
}

su: unit {
    c: sch
    foundation: (c.foundation n: 3)
    inner: function out i64 is { return foundation.n }
}

al: unit {
    s: su
    viaAlias: function out i64 is { return s.foundation.n }
}

main: function is {
    x: su.foundation
    p: sch.Conf
    print "\{x.n} \{su.inner} \{al.viaAlias} \{p.k}"
}
