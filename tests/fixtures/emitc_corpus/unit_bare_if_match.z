# unit_bare_if_match.z -- a bare `if` or `match` bound at unit level, or in a
# type's `as` block, reads as a body binding's does: an unbraced arm ends with
# its line, so the next definition is a definition, not the arm's argument.
mode: variant {fast: null slow: null}
M: mode.slow
K: if true then 1 else 2
L: if false then 10 else 20
N: match (M) case fast then 3 case slow then 4
P: if K > 1 then (5) else (6)

pt: record {s: i64} as {
    A: if true then 7 else 8
    B: 9
    C: match (M) case fast then 11 else 12
}

main: function is {
    print "\{K} \{L} \{N} \{P}"
    print "\{pt.A} \{pt.B} \{pt.C}"
    x: if true then 1 else 2
    print "\{x}"
}
