# `print` and `io.eprintln` only read their message, so they take it as a
# view: an element read through an iterator, which is readonly, prints like any
# other string. The parameter used to be a plain borrow, which asks for a
# mutable reference a readonly binding cannot lend.
mk: function out List String is {
    r: (List String)
    r.append from: "alpha".string
    r.append from: "beta".string
    return r
}

main: function is {
    l: mk
    with it: l.iterate do for e: it loop {
        print e
        io.eprintln e
    }
    with it2: (mk).iterate do for e2: it2 loop {
        print e2
    }
}
