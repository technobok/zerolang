# unit_bare_alias.z -- a bare name at unit level ALIASES the type it names,
# exactly as the dotted form (`Node: zast.Node`) does. The three targets that
# reach it differently: a type declared in this unit, a stdlib type, and a
# builtin scalar. A numeric value at unit level is still a constant.
Holder: class {
    n: i64
}

tally: u64
Same: Holder
Text: String
Sv: system.String

STEP: 2.u64

bump: function {n: tally} out tally is {
    return n + STEP
}

label: function {h: Same.view} out Text is {
    t: "n=".string
    t.append "\{h.n}"
    return t
}

main: function is {
    h: Holder n: 7
    z: tally
    d: Sv
    print "\{label h: h} bumped=\{bump n: 40} zero=\{z} dotted=\{d.length}"
}
