# const_match_unnamed_arm_takes_else -- A match on a unit constant whose arm no case
# names folds to the `else`, which is walked and runs.
shape: choice {
    circle: i64
    square: i64
    dot: null
}
SH: (shape.square 4)

main: function is {
    match SH case circle then error "SH is a square" else print "not a circle"
    n: match SH case dot then 1 else 2
    print "n \{n}"
}
