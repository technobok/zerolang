# A CONDITION OVER A NUMERIC GENERIC PARAMETER FOLDS PER INSTANTIATION, so an
# `error` it guards is eliminated where the argument passes -- bare, through
# `this`, through a value of the type, and in a generic function. The bare and
# the function forms were "Unknown reference"; the other two reached the
# emitter unhandled.
Buffer: class {
    used: u32
    check: function {:this} is {
        if cap == 0 then error "capacity must not be zero"
        if this.cap > 64 then error "capacity must not exceed 64"
    }
} as { cap: u32.generic }

scale: function as { n: i64.generic } in { v: i64 } out i64 is {
    if n < 0 then error "n must not be negative"
    return v * n
}

main: function is {
    b: (Buffer cap: 8) used: 0
    b.check
    if b.cap == 0 then error "b has no capacity"
    print "ok \{scale n: 2 v: 21}"
}
