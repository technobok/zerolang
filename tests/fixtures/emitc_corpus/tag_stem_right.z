# The other unit declaring the same sum names, for tag_stem_clash.
pal: variant { lo: null mid: null hi: null }

Foo: class { s: String }

# the arm `k` selects, by value
pick: function {k: i64} out pal is {
    if k > 6 then return pal.hi
    if k > 3 then return pal.mid
    return pal.lo
}

# an Option over this unit's own Foo
boxed: function {k: i64} out i64 is {
    if k < 1 then return -1
    o: Option.some (Foo s: "x".string)
    match (o) case some then return 7 case none then return -1
}
