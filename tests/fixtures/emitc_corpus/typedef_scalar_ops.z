# The scalar-typedef operator/position matrix: comparisons and arithmetic
# chase to the base, width conversions and interpolation work, a typedef
# keys a Map on the scalar fast path, and a shadowed == narrows equality
# to the same space while everything else stays backward compatible. A
# typedef that writes its `==` keys a Map only with a `hash` written beside
# it, which the Map then calls.
declid: typedef u64 as {
    ==: function {t: this.view rhs: declid} out bool is {
        return t.u64 == rhs.u64
    }
    hash: function {t: this.view} out u64 is {
        return t.u64
    }
}

slot: typedef u64

consume: function {x: u64} out u64 is {
    return x + 100
}

main: function is {
    a: declid.create from: 10
    b: declid.create from: 3
    c: declid.create from: 10
    if a == c then print "eq" else print "eq-BAD"
    if a != b then print "ne" else print "ne-BAD"
    if a < b then print "lt-BAD" else print "lt"
    if a >= b then print "ge" else print "ge-BAD"
    s: (a + 1) - 2
    print "arith: \{s}"
    w: (a.u32).orPanic
    print "cast: \{w}"
    print "interp: \{a}"
    z: declid
    print "zero: \{z}"
    print "compat: \{consume a}"
    xs: (ListVal declid)
    xs.append from: a
    xs.append from: b
    g: xs.get i: 1
    print "list: \{g}"
    if b.u64 == 3 then print "sentinel" else print "sentinel-BAD"
    m: (MapVR declid V: String)
    m.set key: a value: "ten".string
    ho: m.get key: c
    match (ho) case some then print "map-hit" case none then print "map-MISS"
    fast: (MapVR slot V: String)
    fast.set key: (slot.create from: 4) value: "four".string
    fo: fast.get key: (slot.create from: 4)
    match (fo) case some then print "fast-hit" case none then print "fast-MISS"
}
