# A USER TYPE IS CONSTRUCTED BY ITS `create`, synthesised or written, whichever
# way the construction is spelled. `T.create` walked a different argument list
# from the sugar: a type holding a function field demanded the field in
# `T.create` though its body is the field's default and the sugar never asked.
Dial: class {
    level: i64
    zero: function out i64 is {
        return 0
    }
}

Seeded: class { value: i64 } as {
    create: function {seed: i64} out this is {
        return (meta.create value: seed * 7)
    }
}

main: function is {
    a: Dial level: 1
    b: (Dial) level: 2
    c: (Dial level: 3)
    d: Dial.create level: 4
    e: (Dial.create level: 5)
    s: Seeded seed: 1
    t: Seeded.create seed: 2
    u: (Seeded) 3
    print "\{a.level} \{b.level} \{c.level} \{d.level} \{e.level} \{d.zero}"
    print "\{s.value} \{t.value} \{u.value}"
}
