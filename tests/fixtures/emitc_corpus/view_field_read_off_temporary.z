# A field declared `.view` holds a view of a value it does not own. Read off a
# temporary -- a construction, an `outx` call's result -- it is that view, not
# an owned value taken out of the temporary: the binding views the source,
# re-points when reassigned, and nothing is freed twice.

# W -- a class holding a view of a String
W: class {
    s: String.view
}

# wrap -- a W over `n`, which keeps `n` locked while it lives
wrap: function {n: String.view} outx W is {
    return (W s: n)
}

# read -- the view field read off a construction and off a call's result
read: function {name: String.view} is {
    a: (W s: name).s
    b: (wrap n: name).s
    print "\{a} \{b}"
}

main: function is {
    name: "abc".string
    other: "o".string
    read :name
    v: (W s: name).s
    v = (W s: other).s
    name = "xyz".string
    print "\{v} \{name}"
}
