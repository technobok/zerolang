# same_name_classes.z -- two units each declare a class `Cell`, one owning a
# String and one not, and a list holds each. The emitter re-resolved a type it
# already had by its NAME, so both lists destroyed their elements as whichever
# `Cell` the name found first, and the C compiler refused the other's destroy.
# A type with a declaration is now itself; only a shell resolves by name.
main: function is {
    a: List same_name_left.Cell
    a.append (same_name_left.mk s: "hello")
    b: List same_name_right.Cell
    b.append (same_name_right.mk n: 3)
    print "\{a.length} \{b.length} \{(a.get i: 0).s} \{(b.get i: 0).n}"
}
