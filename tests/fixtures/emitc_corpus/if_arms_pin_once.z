# An `if` value whose arms pin `o` whole (the bare local) and `o.f` (carried by
# the value `w.take` moves out) holds one lock: the exclusive pin on `o` covers
# the one on `o.f`, and keeps what it carried. Bound, passed on, or called a
# method on, the value conflicts with nothing, itself included.
Inner: class {
    n: i64
}

Outer: class {
    f: Inner
    r: Inner.borrow
} as {
    total: function {t: this.view} out i64 is {
        return t.f.n + t.r.n
    }
}

pick: function {c: bool} is {
    x: Inner n: 1
    o: Outer f: (Inner n: 3) r: x
    w: Outer f: (Inner n: 4) r: o.f
    b: if c then o else w.take
    b.f.n = b.f.n + 10
    print "\{b.f.n} \{b.r.n}"
}

both: function is {
    pick c: true
    pick c: false
}

show: function {v: Outer.view} out i64 is {
    return v.f.n
}

asArg: function {c: bool} is {
    x: Inner n: 1
    o: Outer f: (Inner n: 3) r: x
    w: Outer f: (Inner n: 4) r: o.f
    print "\{show v: (if c then o else w.take)}"
}

asReceiver: function {c: bool} is {
    x: Inner n: 1
    o: Outer f: (Inner n: 3) r: x
    w: Outer f: (Inner n: 4) r: o.f
    print "\{(if c then o else w.take).total}"
}

main: function is {
    asArg c: true
    asArg c: false
    asReceiver c: true
    asReceiver c: false
    both
}
