# folded_if_dead_clause_no_guard -- A clause after the one a constant condition selects
# is dead: its condition establishes nothing for the code after the `if`. Here the dead
# clause tests `o.none` and returns; were that read as a guard, `o` would read as its
# payload after the `if`.
U: union {
    some: String
    none: null
}

fast: true

show: function {o: U.borrow} is {
    match (
        o
    ) case some then print "some \{o}" case none then print "none"
}

f: function {o: U.take} is {
    if fast then {
        print "fast"
    } when o.none then {
        return
    }
    show :o
}

main: function is {
    f o: (U.some "abc".string)
    f o: U.none
}
