# A `match` whose subject is a CALL evaluates it once. The two-arm ordinal
# route writes `if (s) ... else if (!s)`, and a call there ran twice: its side
# effect repeated, and a `.take` argument was moved a second time.
eat: function {xs: (ListVal u32).take} out bool is {
    print "eat ran"
    return xs.length > 0
}
main: function is {
    f: (ListVal u32)
    match (eat xs: f) case true then print "t" case false then print "f"
    g: (ListVal u32)
    g.append 1
    match (eat xs: g) case true then print "gt" else print "gf"
}
