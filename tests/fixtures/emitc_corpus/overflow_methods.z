# The checked and saturating integer methods at every width, over the values
# where they differ from the wrapping operators: the ends of each type, the
# values next to them, 0, 1, -1 and a value near the square root of the range.
# The golden's values are computed outside the compiler (arbitrary precision).
# checkI8 -- every pair of i8's edge values through the six methods
checkI8: function is {
    vs: ListVal i8
    vs.append 127.i8.not
    vs.append 0.i8 - 127.i8
    vs.append 0.i8 - 1.i8
    vs.append 0.i8
    vs.append 1.i8
    vs.append 2.i8
    vs.append 16.i8
    vs.append 0.i8 - 16.i8
    vs.append 126.i8
    vs.append 127.i8
    i: u64
    for i < vs.length loop {
        a: vs.get :i
        j: u64
        for j < vs.length loop {
            b: vs.get i: j
            ca: a.addChecked rhs: b
            cs: a.subChecked rhs: b
            cm: a.mulChecked rhs: b
            if ca.some then print "i8 add \{a} \{b} = \{ca}" else print "i8 add \{a} \{b} = none"
            if cs.some then print "i8 sub \{a} \{b} = \{cs}" else print "i8 sub \{a} \{b} = none"
            if cm.some then print "i8 mul \{a} \{b} = \{cm}" else print "i8 mul \{a} \{b} = none"
            print "i8 sat \{a} \{b} = \{a.addSaturating rhs: b} \{a.subSaturating rhs: b} \{(
                a.mulSaturating
                rhs: b
            )}"
            j = j + 1
        }
        i = i + 1
    }
}

