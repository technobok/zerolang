# A BARE CALLABLE OBJECT AS A LOOP CONDITION IS CALLED. A loop condition is
# bool or a 2-arm sum; an iterator read bare is its `call`, which answers an
# option, so `for it loop` runs while the iterator has an element -- as the
# written `for it.call loop` does. (Walking with the element bound is the plain
# binding `for e: it loop`.)
Ticks: class {
    n: i64
    lim: i64
} as {
    call: function {:this} out optionval i64 is {
        if this.n >= this.lim then return (optionval.none i64)
        this.n = this.n + 1
        return (optionval.some this.n)
    }
}

main: function is {
    xs: ListVal i64
    xs.append 1
    xs.append 2
    n: 0
    with it: xs.iterate do for it loop n = n + 1
    t: Ticks n: 0 lim: 3
    for t loop n = n + 10
    with jt: xs.iterate do for e: jt loop print "bound \{e}"
    print "\{n} \{t.n}"
}
