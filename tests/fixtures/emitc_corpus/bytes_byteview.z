# `Bytes.byteView` is the buffer's readonly view: bound, passed to a ByteView
# parameter, and written to a stream. It pins the buffer shared while it lives,
# and the buffer grows again once it is gone.
len: function {v: ByteView} out u64 is { return v.length }

main: function is {
    b: Bytes
    b.append from: 104
    b.append from: 105
    b.append from: 10
    {
        bv: b.byteView
        io.stdout.write from: bv
        print "bound=\{bv.length} param=\{len v: b.byteView}"
    }
    b.append from: 33
    print "after=\{b.length}"
}
