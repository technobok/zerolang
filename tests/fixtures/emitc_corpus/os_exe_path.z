# os_exePath.z -- os.exePath returns the running executable's absolute
# path. The two differential binaries live at different paths, so assert
# only the stable shape (ok, and absolute as the system reads paths), never
# the path itself.

main: function is {
    r: os.exePath
    match (
        r
    ) case ok then {
        abs: path.isAbsolute p: r.stringView
        print "exePath ok abs=\{abs}"
    } case err then {
        print "exePath err"
    }
}
