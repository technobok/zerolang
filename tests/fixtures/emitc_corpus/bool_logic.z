# `and`, `or` and `not` are bool's logic methods. `and` / `or` are ordinary
# one-parameter methods, so they are written infix (`a or b`) or as a call
# (`a.or rhs: b`) and reach one declaration; `not` is a zero-argument method,
# because zerolang has no unary operators. BOTH OPERANDS ARE ALWAYS EVALUATED:
# an operation is a call, and a call evaluates every argument -- `say` below
# prints on the right of an `or` whose left side is already true. The
# short-circuit form is `if a when b`.
say: function {v: bool} out bool is {
    print "rhs ran"
    return v
}

isEven: function {n: i64} out bool is {
    return (n % 2) == 0
}

either: function {a: bool b: bool} out bool is {
    return a or b
}

kind: variant {
    a: i64
    b: null
}

maybe: variant {
    none: null
    some: i64
}

main: function is {
    t: true
    f: false
    # truth tables, infix
    print "and \{t and t} \{t and f} \{f and t} \{f and f}"
    print "or \{t or t} \{t or f} \{f or t} \{f or f}"
    # the call form, positional and named
    print "dotted \{t.or f} \{t.or rhs: f} \{t.and rhs: f} \{f.and t}"
    # not: on a local, a literal, a call result, and its own inverse
    print "not \{t.not} \{f.not} \{true.not} \{false.not} \{(isEven 3).not} \{t.not.not}"
    # chains fold left; parentheses group
    x: t or f or f
    print "chain \{x} \{(t or f) and f} \{t or (f and f)} \{((t or f) and t) or f}"
    # no short-circuit: the right side runs even when the left decides
    r1: true or (say false)
    print "r1 \{r1}"
    r2: false and (say true)
    print "r2 \{r2}"
    # in every condition position
    if t and f then print "wrong" else print "if and ok"
    if (t and f).not then print "if not ok"
    i: 0
    for i < 3 and t loop { i = i + 1 }
    print "loop \{i}"
    if t when (f or t) then print "when+or ok"
    print "ret \{either a: f b: t} \{either a: f b: f}"
    # `.not` on an arm predicate narrows exactly as `.false` does: the else
    # side holds the arm, so the bare name is the payload there
    k: kind.a 7
    if k.a.not then print "not a" else print "payload \{k}"
    k2: kind.b
    if k2.a.not then print "k2 not a" else print "k2 payload \{k2}"
    o: maybe.some 5
    if o.some.not then print "none" else print "some \{o}"
    o2: maybe.none
    if o2.some.not then print "o2 none" else print "o2 some \{o2}"
}
