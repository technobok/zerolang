# alias_instantiated_generic.z -- a unit-level definition whose value
# INSTANTIATES a generic template names the resulting mono: `Strs` IS
# `(List String)`, not a copy of it. The alias shares the mono's canonical id,
# so a value written the long way passes to a parameter typed with the alias
# and back again. A GENERIC template is the one callee shape that can be
# instantiated rather than constructed, which is what keeps
# `origin: Point.create x: 0` a refused construction -- see
# tests/fixtures/errors/unit_constant_construction.z.
Strs: (List String)
Pairs: (Map String value: String)

count: function {xs: Strs.view} out u64 is {
    return xs.length
}

main: function is {
    a: Strs
    a.append "x".string

    b: (List String)
    b.append "y".string
    b.append "z".string
    print "a=\{count xs: a} b=\{count xs: b}"

    m: Pairs
    m.set key: "k".string value: "v".string
    with mt: m.iterateItems do for e: mt loop print "m \{e.key}=\{e.value}"
}
