# typedef_sum_base.z -- a typedef over a union or variant is matched on its
# base's arms, as a statement or a value, through any number of typedefs; its
# arm predicates and narrowing read through to the base. The checker refused
# the match, and the emitter had no tag to switch on.
Shape: union {
    sq: Box u64
    name: String
}

ShapeAlias: typedef Shape
side: function {s: ShapeAlias} out u64 is {
    match (
        s
    ) case sq then {
        return s
    } case name then {
        return 0
    }
}

SA2: typedef ShapeAlias
dir: variant { n: null e: null far: u64 }
heading: typedef dir
color: variant { red: null green: null blue: null }
hue: typedef color
dist: function {h: heading} out u64 is {
    match (
        h
    ) case far then {
        return h
    } else {
        return 1
    }
}

main: function is {
    s: ShapeAlias (Shape.sq 4)
    print "match \{side :s}"
    print "pred \{s.sq} \{s.name}"
    if s.sq then print "narrow \{s}"
    t: SA2 (ShapeAlias (Shape.name "x".string))
    v: match (
        t
    ) case sq then 1 case name then 2
    print "value \{v} \{t.name}"
    h: heading (dir.far 9)
    print "variant \{dist :h} \{h.far} \{h.n}"
    c: hue color.green
    match (
        c
    ) case red then print "r" case green then print "g" case blue then print "b"
}
