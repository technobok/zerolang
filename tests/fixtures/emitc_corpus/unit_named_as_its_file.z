# An inline unit may share its file unit's name, and a member of it may share
# both: each name is the nearest declaration of it, read from where it is
# written. `main` names the inline unit; inside it the alias names `parts`.
parts: unit {
    part: data { n: 0 }
    four: (part n: 4)
}

unit_named_as_its_file: unit {
    unit_named_as_its_file: parts
    one: function {v: unit_named_as_its_file.part} out i64 is { return v.n }
}

main: function is {
    print "\{unit_named_as_its_file.one v: parts.four}"
}
