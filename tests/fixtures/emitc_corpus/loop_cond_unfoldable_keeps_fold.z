# loop_cond_unfoldable_keeps_fold -- a loop condition the fold cannot read (an
# interpolation builds at run time) is an ordinary run-time condition and leaves nothing
# behind: a constant `if` in the loop's body still folds, and its dead branch is not
# checked
mode: variant {
    fast: null
    slow: null
}

K: mode.slow
S: "abc"

main: function is {
    n: 0
    for "\{S}\{n}" == "abc0" loop {
        if K == mode.slow then print "slow" else print missing
        n = n + 1
    }
    print "n \{n}"
}
