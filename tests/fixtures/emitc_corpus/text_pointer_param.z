# every text member read through a `text.view` parameter, which is passed by
# pointer
G: "Hello, world"

probe: function {t: text.view} is {
    print "\{t} \{t.length} \{t.isEmpty} \{t.isAscii} \{t.count}"
    print "\{t.startsWith prefix: "He"} \{t.endsWith suffix: "ld"} \{t.contains needle: ", "}"
    print "\{(t.indexOf needle: "o").or d: 99} \{(t.lastIndexOf needle: "o").or d: 99} \{(t.byteAt i: 1).or d: 0}"
    print "\{(t.splitOnce sep: ", ").or d: 99} \{t.substring from: 7 to: 12} \{t.trim} \{t.trimStart} \{t.trimEnd}"
    print "\{t.toLowerAscii} \{t.toUpperAscii} \{t.replace needle: "o" replacement: "0"}"
    print "\{t.replaceFirst needle: "l" replacement: "L"} \{t.repeated n: 2} \{t.concat other: "!"} \{t + "?"}"
    print "\{t == G} \{t != G} \{t < G} \{t.compare rhs: G} \{t.hash == G.text.hash}"
    print "\{t.string} \{t.stringView}"
    n: u64
    for each c: t.codepoints loop {
        n = n + c.u64
    }
    print "\{n}"
}

main: function is {
    probe t: G.text
}
