# A lock-holding value appended to a container takes its locks with it: the
# container, declared AFTER the source, cannot outlive it, so the source stays
# locked while the container holds the value -- a write is refused there --
# and is writable once the container dies.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

main: function is {
    a: Src n: 1
    {
        xs: (List W)
        w: mk from: a
        xs.append w
        print "held: \{xs.length}"
    }
    a.n = 5
    print "after: \{a.n}"
}
