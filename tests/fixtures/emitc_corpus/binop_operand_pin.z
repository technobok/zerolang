# binop_operand_pin.z -- A BINOP'S RESULT ALIASES NEITHER OPERAND. A projection
# as the RIGHT operand (`b.stringView`) left its pin pending and the binding of
# the bool adopted it, so `b` read as held by `eq` and could not be appended;
# the left operand's pin was already dropped when the right was walked, which
# is why only this shape failed. Both bindings are fresh values.
main: function is {
    a: "x".string
    b: "y".string
    eq: a == b.stringView
    both: a.stringView == b.stringView
    b.append "z"
    a.append "!"
    print "\{eq} \{both} \{a} \{b}"
}
