# data_strings.z -- a data block of strings: `out StringView`, each element any
# constant that folds to a string -- a literal, `+` over unit string constants,
# another block's element. Its name is a `stringdata`, read through the block
# (a label, an ordinal, a constant `.index`) as constants and through a value at
# run time; each element is a view of static memory, so nothing is copied or
# freed until a program asks for an owned copy.
PREFIX: "z-"
verbs: data { build: "build" run: "run" emit: (PREFIX + "emit") } out StringView
names: data { "alpha" "beta" verbs.run }

total: function {d: stringdata} out u64 is {
    n: 0.u64
    for each v: d.iterate loop n = n + v.length
    return n
}

main: function is {
    print "b=\{verbs.build} e=\{verbs.emit} len=\{verbs.length} r=\{verbs.index 1}"
    print "n0=\{names.0} n2=\{names.2}"
    i: 1.u64
    w: names
    print "w1=\{w.index :i} total=\{total d: verbs}"
    for each v: names.iterate loop print "v=\{v}"
    owned: List String
    for each v: verbs.iterate loop owned.append v.string
    print "owned=\{owned.length} last=\{owned.get i: 2}"
}
