# shadow_null_positions.z -- a user `null` record in every type position. A type
# reference resolves through scope like any other name, so the nearest `null` is
# the unit's own record: a field, a parameter, a return type and a sum arm's
# payload all carry it.

null: record { x: i64 }
holder: record { n: null }

shape: variant {
    one: null
    two: i64
}

Form: union {
    one: null
    two: String
}

mk: function {v: i64} out null is {
    return (null x: v)
}

get: function {n: null} out i64 is {
    return n.x
}

main: function is {
    h: holder n: (mk v: 3)
    print "field x=\{get n: h.n}"
    s: shape.one (null x: 7)
    match (
        s
    ) case one then print "variant one x=\{s.x}" case two then print "variant two"
    u: Form.one (null x: 9)
    match (
        u
    ) case one then print "union one x=\{u.x}" case two then print "union two"
}
