# a Map or Set of CLASS keys frees them: on the container's destroy, the
# incoming key when a set or add hits an existing one, and the stored key on
# remove or delete. Only a String key was freed; any other key that owns heap
# data leaked its fields on every one of those paths.
Box: class { n: u64 s: String } as {
    hash: function {t: this.view} out u64 is { return t.n }
    ==: function {t: this.view rhs: Box} out bool is { return t.n == rhs.n }
}

main: function is {
    m: MapRV Box v: u64
    m.set key: (Box n: 1 s: "one".string) value: 1
    m.set key: (Box n: 1 s: "uno".string) value: 2
    m.set key: (Box n: 2 s: "two".string) value: 3
    k: Box n: 2 s: "probe".string
    r: m.remove key: k
    print "map \{m.length} \{r.some}"
    s: SetRef Box
    s.add item: (Box n: 5 s: "five".string)
    s.add item: (Box n: 5 s: "cinq".string)
    s.add item: (Box n: 6 s: "six".string)
    d: Box n: 6 s: "del".string
    s.delete item: d
    print "set \{s.length}"
}
