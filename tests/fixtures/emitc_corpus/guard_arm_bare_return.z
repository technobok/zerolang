# A guard arm that ends in a BARE `return` diverges like one that returns a
# value: after the match the subject is narrowed to the other arm. While
# `return` was declared generic (`as { T: Any.generic }`) the bare form did not
# narrow, and `o` below was refused as "(optionval t: i64)" -- not printable.
half: function {n: i64} out (optionval i64) is {
    if n % 2 == 0 then return (optionval.some n / 2)
    return (optionval.none i64)
}

show: function {n: i64} is {
    o: half :n
    match (
        o
    ) case none then {
        print "\{n} is odd"
        return
    } case some then null
    print "\{n} halves to \{o} and then \{o + 1}"
}

main: function is {
    show n: 8
    show n: 7
}
