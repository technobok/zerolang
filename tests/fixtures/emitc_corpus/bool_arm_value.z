# bool_arm_value.z -- an explicit arm read of a tagged type whose C form is a
# SCALAR. `bool` is `variant { false: null true: null }` with `tag: u8.tag`, so
# it lowers to C `bool` and the tag STRUCT every other arm read composes is
# invalid there: the value is the tag constant cast to that form. Covers the
# four positions that each compose it separately, plus a unit-level alias of
# one arm.
Holder: record {
    live: bool
}

want: function {b: bool} out i64 is {
    if b then return 1
    return 0
}

give: function {} out bool is {
    return bool.true
}

NO: bool.false

main: function is {
    a: bool.false
    b: want b: bool.true
    h: Holder live: bool.false
    c: give
    d: 0
    if NO then d = 1
    print "a=\{a} b=\{b} h=\{h.live} c=\{c} d=\{d}"
}
