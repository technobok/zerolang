# TWO BORROWS RE-POINTED AT CALL RESULTS IN ONE FUNCTION each keep the value in
# a companion of their own, and the readable naming scheme spelled both `_c`:
# the C defined it twice. Built under both schemes by readable-check.

# tails -- the two texts past their first byte, joined
tails: function {a: StringView b: StringView} out String is {
    x: a
    if a.length > 0 then x = a.substring from: 1 to: a.length
    y: b
    if b.length > 0 then y = b.substring from: 1 to: b.length
    r: x.string
    r.append y
    return r
}

main: function is {
    print (tails a: "xab" b: "ycd")
}
