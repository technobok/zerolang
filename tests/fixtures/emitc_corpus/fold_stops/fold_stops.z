# fold_stops.z -- where a constant condition does NOT fold, because a condition
# with a run-time value runs first. The run-time condition must run, so the
# construct stays a run-time one and the constant is tested in the C. That C
# holds a statement no path reaches, which is why this program lives below
# emitc_corpus: the deadcode-guard reads only the programs directly in it.

DEBUG: false

Count: class {
    n: i64
} as {
    tick: function {:this} out bool is {
        this.n = this.n + 1
        return true
    }
}

main: function is {
    c: Count n: 0
    # a run-time condition first: it runs, and the false after it loses
    if c.tick when DEBUG then {
        print "lost"
    } else {
        print "else after runtime, false"
    }
    print "ticks \{c.n}"
    # a clause after a run-time clause runs only after a run-time test
    k: c.n == 0
    if k then {
        print "lost"
    } else if DEBUG then {
        print "lost"
    } else {
        print "else after runtime clause"
    }
    # a binding runs first: the false arm stops the walk at its first element
    seen: 0
    for each x: 3.times while DEBUG loop {
        seen = seen + 1
        print "body \{x}"
    }
    print "seen \{seen}"
    # a run-time precondition first, then the false
    for c.tick while DEBUG loop {
        print "body"
    }
    print "ticks \{c.n}"
}
