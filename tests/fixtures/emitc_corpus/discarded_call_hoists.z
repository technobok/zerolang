# a discarded expression statement whose receiver is hoisted -- a `.copy` of
# an element reached through `getMut` -- declares the temps it reads.
main: function is {
    grid: List (List String)
    grid.append from: (List String)
    (grid.getMut i: 0).append from: "a".string
    ((grid.getMut i: 0).get i: 0).copy.length
    print "ok \{(grid.get i: 0).length}"
}
