# An `outx` result may fill a non-owned field from a PATH through a
# `.borrow`/`.view` parameter: the field then points into what the caller
# owns, and the pin on the parameter keeps it there while the result lives.
Src: class {
    n: i64
}

Holder: class {
    sub: Src
    label: String
}

W: class {
    s: Src.borrow
    tag: i64
}

mk: function {from: Holder.borrow} outx W is {
    return (W s: from.sub tag: 1)
}

main: function is {
    h: Holder sub: (Src n: 5) label: "h".string
    {
        w: mk from: h
        print "via result: \{w.tag} \{w.s.n}"
    }
    h.sub.n = 9
    print "after: \{h.sub.n} \{h.label}"
}
