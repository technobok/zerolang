# unit_path_signature.z -- a parameter, a return and a record field typed by a
# choice or a data type reached through a unit path: an alias of an inline unit,
# and the path two units deep.
runtime: unit {
    nativec: unit {
        link: data {
            library: text
            weight: 1
        }
        os: choice {
            linux: null
            windows: null
            other: link
        }
    }
}
c: runtime.nativec
lin: c.os.linux
wide: (c.link library: "z" weight: 7)
oth: (c.os.other wide)
slot: record {
    o: c.os
    far: runtime.nativec.os
}

osName: function {o: c.os} out StringView is {
    match (o) case linux then return "linux" case windows then return "windows" case other then {
        return o.library.stringView
    }
}

farName: function {o: runtime.nativec.os} out StringView is {
    if o.linux then return "far linux"
    return "far other"
}

pickOs: function {other: bool} out c.os is {
    if other then return oth
    return lin
}

weightOf: function {l: runtime.nativec.link} out i64 is {
    return l.weight
}

main: function is {
    s: slot o: (pickOs other: true) far: lin
    print "\{osName o: lin} \{osName o: s.o} \{farName o: s.far} \{farName o: oth}"
    held: s.o
    if held.other then print "\{held.weight} \{weightOf l: wide}"
}
