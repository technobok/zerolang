# `.copy` OF A FUNCTION IS ANOTHER REFERENCE TO IT. Any unbound function copies:
# a unit function, a static method and a receiver-taking method read through
# their type (the receiver is then passed as an argument), and a function
# reference held in a local, a parameter or a field. The source is a function,
# not storage, so it stays usable: a copy made on every pass of a loop reads
# the same function each time.

# sevenFn -- a function reference with seven's signature: the type, with no default
sevenFn: function out i64

seven: function out i64 is {
    return 7
}

# doubleFn -- a function reference with double's signature: the type, with no default
doubleFn: function {n: i64} out i64

double: function {n: i64} out i64 is {
    return n * 2
}

triple: function {n: i64} out i64 is {
    return n * 3
}

T: record {
    n: i64
} as {
    get: function {:this} out i64 is {
        return this.n
    }
    helper: function {n: i64} out i64 is {
        return n + 100
    }
}

Hook: class {
    op: doubleFn
}

Timer: class {
    source: sevenFn
}

apply: function {f: doubleFn n: i64} out i64 is {
    return (f n: n)
}

pick: function {f: doubleFn} out doubleFn is {
    return f.copy
}

main: function is {
    # sources: a static method and an unbound method, through their type
    b: T.helper.copy
    g: T.get.copy
    t: T n: 5
    print "\{b n: 1} \{g this: t}"
    # a unit function, a local reference, a field filled with a copy, a copy
    # of that field
    d: double.copy
    e: d.copy
    h: Hook op: double.copy
    k: h.op.copy
    # a zero-argument function held in a field is called by reading it
    tm: Timer source: seven.copy
    print "\{apply f: double.copy n: 4} \{apply f: e.copy n: 5} \{k n: 6} \{tm.source}"
    # a field write, a reassignment into an existing reference of the same
    # signature, and a parameter copied into a return
    h.op = triple.copy
    d = triple.copy
    r: pick f: d.copy
    print "\{h.op n: 2} \{d n: 2} \{r n: 3}"
    # the source stays usable: a copy on every pass
    i: 0
    for i < 3 loop {
        x: d.copy
        print "\{x n: i} \{e n: i}"
        i = i + 1
    }
}
