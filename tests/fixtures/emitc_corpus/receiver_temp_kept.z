# receiver_temp_kept.z -- a view of a string no name holds is the named hoist
# made explicit: `b: LfBox name: "abc def".string.stringView` keeps the string
# as `t: "abc def".string; b: LfBox name: t.stringView` would, to the end of
# the block, and so does an `outx` call handed a view of an interpolation. Each
# string is freed once, after the last read through its view.
LfBox: class {
    name: StringView
}

lfPass: function {v: StringView.view} outx StringView.view is {
    return v
}

main: function is {
    n: 5.i64
    b: LfBox name: "abc def".string.stringView
    v: lfPass v: "p=\{n}".stringView
    w: lfPass v: (lfPass v: "nested".string.stringView)
    print b.name
    print v
    print w
}
