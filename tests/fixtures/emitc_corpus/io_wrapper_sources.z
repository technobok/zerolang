# io_wrapper_sources.z -- the io wrappers' create takes any Writer: a value that
# already is one (`io.stdout`) passes as it stands, where the create used to look
# up a conformance label it cannot have and name `X__create`; a conformer is
# boxed as at any other slot. And a write's `from:` given a view with no address
# of its own (`outbuf.byteView`) binds it first: `&` of the call was C's error.
main: function is {
    w: io.stdout
    bw: io.BufWriter.create to: w capacity: 16.u64
    outbuf: Bytes
    outbuf.append from: 111.u8
    outbuf.append from: 107.u8
    outbuf.append from: 10.u8
    wr: bw.write from: outbuf.byteView
    match (
        wr
    ) case ok then {} case err then {}
    fr: bw.flush
    match (
        fr
    ) case ok then {} case err then {}
}
