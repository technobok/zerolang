# subunit_parent_read.z -- a hidden subunit resolves outward like any other
# unit: a bare name written inside helper walks up to its parent's definitions.
# Privacy is the other direction (subunit_private_use): nothing outside the
# parent may name helper.
compute: function out i64 is {
    r: helper.grab
    return r
}

PARENTC: 5

main: function is {
    print "\{compute}"
}
