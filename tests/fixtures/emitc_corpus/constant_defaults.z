# A DEFAULT MAY BE ANY COMPILE-TIME SCALAR, on a field and on a parameter alike:
# a named constant, an arithmetic expression, a folded `if`, or a constant of
# the type itself or of another type. A default is re-emitted at every
# construction and call, so it stays a scalar. A named constant used to make the
# member REQUIRED (`n: LIMIT` asked for `n`), an expression gave it a type named
# after its last operand (`_3`), and the type's own constant was an unknown type.
LIMIT: 9

cfg: record {
    x: i64
} as {
    K: 4
}

Rec: record {
    a: LIMIT
    b: 2 * 3
    c: CAP
    d: cfg.K
    e: cfg.K * 2
    f: if LIMIT > 5 then { 1 } else { 0 }
} as {
    CAP: 5
}

Box: class {
    a: LIMIT
    c: CAP + 1
    d: cfg.K
} as {
    CAP: 7
}

scaled: function {n: LIMIT m: 2 * 3 k: cfg.K} out i64 is {
    return (n * m) + k
}

main: function is {
    r: Rec
    print "\{r.a} \{r.b} \{r.c} \{r.d} \{r.e} \{r.f}"
    o: Rec a: 1 b: 2 c: 3 d: 4 e: 5 f: 6
    print "\{o.a} \{o.b} \{o.c} \{o.d} \{o.e} \{o.f}"
    b: Box
    print "\{b.a} \{b.c} \{b.d}"
    print "\{scaled} \{scaled n: 1} \{scaled n: 1 m: 1 k: 1}"
}
