# an argument held in an evaluation-order temp, read off a `.view` parameter,
# whose C is a pointer to const: the temp must still be assignable. MSVC keeps
# a const through a comma, where gcc, clang and tcc drop it, so the temp's type
# is the value's, unqualified.
G: "hello, world"

# tail -- the bytes of G past `p`'s length, counted
tail: function {p: String.view} out u64 is {
    t: G.text
    return (t.substring from: p.length to: t.length).length
}

# tailOf -- tail, for any StringLike
tailOf: function as { T: StringLike.generic } in {p: T.view} out u64 is {
    t: G.text
    return (t.substring from: p.length to: t.length).length
}

main: function is {
    s: "hel".string
    print "\{tail p: s} \{tailOf p: s} \{tailOf p: "h"}"
}
