# hidden_subunit.z -- a .z file in a directory named after this unit is an
# implementation subunit of it, loaded only because this unit named it. It is
# the same node as an inline unit once parsed, so it resolves and emits the
# same way.
main: function is {
    print "helper.square 7 = \{helper.square 7}"
    print "helper.SCALE = \{helper.SCALE}"
}
