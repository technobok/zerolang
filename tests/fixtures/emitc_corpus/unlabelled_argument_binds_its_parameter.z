# A call's unlabelled argument binds the parameter it names wherever the call
# is emitted: an explicit `.create` of a create whose first parameter has a
# default, and `meta.create` inside a create -- into a value field and into a
# non-owned one. Each was emitted as if the argument were not there: the
# default, a zero, a null.
P: class {
    a: i64
    b: i64
} as {
    create: function {a: 5 b: 7} out this is {
        return (meta.create :a :b)
    }
}

Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
} as {
    create: function {from: Src.borrow} outx this is {
        return (meta.create from tag: 1)
    }
}

R: record {
    a: i64
    b: i64
} as {
    create: function {x: i64} out this is {
        return (meta.create x b: 2)
    }
}

main: function is {
    p: P.create 9
    q: P.create 9 b: 1
    r: P 8
    print "\{p.a} \{p.b} \{q.a} \{q.b} \{r.a} \{r.b}"
    src: Src n: 7
    w: W.create from: src
    v: R.create x: 5
    print "\{w.s.n} \{w.tag} \{v.a} \{v.b}"
}
