# string_load_single_read.z -- a String loaded from a container, `(*get(..))`,
# and read for its data and its size -- viewed, appended, compared, parsed --
# is read once: the index is evaluated once, so a side effect in it runs once.
# A String field read off a loaded element is the same, and so is a sized str
# element, which a list hands back by value.
Ctr: class {
    n: u64
}

Item: class {
    name: String
}

bump: function {c: Ctr} out u64 is {
    c.n = c.n + 1
    return 0
}

check: function {what: StringView c: Ctr} is {
    print "\{what} \{c.n}"
    c.n = 0
}

main: function is {
    xs: List String
    xs.append from: "12"
    c: Ctr n: 0
    s: String
    s.append (xs.get i: (bump :c))
    check what: "append" :c
    s.append (xs.get i: (bump :c)).stringView
    check what: "append view" :c
    t: "\{xs.get i: (bump :c)}"
    check what: "interpolation" :c
    e: (xs.get i: (bump :c)) == "12"
    check what: "compare" :c
    p: ((xs.get i: (bump :c)).stringView.parseI64).or d: 0
    check what: "parse" :c
    b: (xs.get i: (bump :c)).stringView.startsWith "1"
    check what: "startsWith" :c
    l: (xs.get i: (bump :c)).length
    check what: "length" :c
    w: (xs.get i: (bump :c)).stringView.trim
    check what: "trim" :c
    v: (xs.get i: (bump :c)).stringView
    check what: "view" :c
    its: List Item
    its.append (Item name: "ab")
    f: (its.get i: (bump :c)).name.stringView.startsWith "a"
    check what: "field view" :c
    s.append (its.get i: (bump :c)).name
    check what: "field append" :c
    strs: ListVal (str to: 8)
    strs.append from: ("ab".str to: 8)
    q: (strs.get i: (bump :c)).stringView.length
    check what: "str view" :c
    print "\{s} \{t} \{e} \{p} \{b} \{l} \{w} \{v} \{f} \{q}"
}
