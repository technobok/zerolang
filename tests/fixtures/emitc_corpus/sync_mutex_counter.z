# sync_mutex_counter.z -- four threads append to one list a Mutex owns,
# sharing the Mutex by `.view`: each append happens under the lock, so none is
# lost. The owner reads the list back through a guard of its own after.

# Filler -- appends its numbers to the shared list
Filler: class {
    # the list, shared with every other Filler
    m: (sync.Mutex (ListVal i64)).view
    # the number it appends
    tag: i64
} as {
    task: (thread.Task null)
    call: function {:this} is {
        i: 0.i64
        for i < 500 loop {
            g: this.m.lock
            g.value.append this.tag
            i = i + 1
        }
    }
}

main: function is {
    m: (sync.Mutex (ListVal i64)).create value: (ListVal i64)
    {
        a: thread.spawn task: (Filler :m tag: 1)
        b: thread.spawn task: (Filler :m tag: 2)
        c: thread.spawn task: (Filler :m tag: 3)
        d: thread.spawn task: (Filler :m tag: 4)
    }
    g: m.lock
    total: 0.i64
    for each x: g.value loop total = total + x
    print "\{g.value.length} appended, summing to \{total}"
}
