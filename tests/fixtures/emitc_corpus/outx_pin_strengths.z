# Each input of an `outx` call is pinned at the strength the call took on it:
# a `.view` argument SHARED, so the caller keeps reading it beside the result;
# a `.borrow` argument EXCLUSIVE, so the caller reads it only through the
# result. Every pin dies with the result.
Src: class {
    n: i64
    label: String
}

W: class {
    s: Src.borrow
    v: Src.view
    label: String
}

mk: function {a: Src.view b: Src.borrow c: Src.view} outx W is {
    return (W s: b v: c label: "owned".string)
}

main: function is {
    x: Src n: 1 label: "x".string
    y: Src n: 2 label: "y".string
    z: Src n: 3 label: "z".string
    {
        w: mk a: x b: y c: z
        # the view arguments stay readable beside the result
        print "views readable: \{x.n} \{z.n}"
        # the borrow argument is read through the result
        print "borrow via result: \{w.s.n}"
        print "result owns: \{w.label}"
    }
    # every pin died with the result
    y.n = 20
    z.n = 30
    print "after: \{x.n} \{y.n} \{z.n}"
}
