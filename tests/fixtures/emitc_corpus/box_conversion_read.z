# box_conversion_read.z -- a numeric conversion read off a Box is its
# element's conversion, read through the cell: one without loss gives the
# value, and one that can lose data gives a result. The same holds through a
# local, a parameter and a class's field.
holder: class { b: (Box u8) }

widened: function {b: (Box u8)} out u64 is {
    return b.u64
}

main: function is {
    a: Box from: 200.u8
    h: holder b: (Box from: 9.u8)
    f: Box from: 300.i64
    g: f.u8.or d: 1
    print "\{a.u64} \{widened b: a} \{h.b.u64} \{g} \{f.i16.or d: 0}"
}
