# A field handed to a parameter that takes it -- written `h.p.take` or left for
# the parameter to take -- leaves its owner, which then finds the field empty
# and frees nothing twice. The move is the same in a statement, a binding, a
# return, a collection element, a constructor field and a generator, whose
# locals are fields of its state.
keep: function {s: String.take n: i64} out i64 is {
    return s.length.i64.orPanic + n
}

keepList: function {xs: (List String).take} out u64 is {
    return xs.length
}

Inner: class {
    p: String
}

Holder: class {
    p: String
    names: (List String)
    inner: Inner
} as {
    give: function {:this} out i64 is {
        return (keep s: this.p n: 1)
    }
}

Gen: generator { limit: i64 } as {
    call: function out i64 is {
        s: "gen".string
        yield (keep s: s n: 2)
        yield 0
    }
}

main: function is {
    h: Holder p: "abc".string names: (List String) inner: (Inner p: "in".string)
    h.names.append from: "n".string
    a: keep s: h.p n: 1
    print "\{a} \{h.p.length}"
    h.p = "again".string
    b: keep s: h.p.take n: 1
    print "\{b} \{h.p.length}"
    c: keepList xs: h.names
    print "\{c} \{h.names.length}"
    e: keep s: h.inner.p n: 1
    print "\{e} \{h.inner.p.length}"
    h.p = "method".string
    print "\{h.give} \{h.p.length}"
    xs: List String
    h.p = "item".string
    xs.append from: h.p
    print "\{xs.length} \{h.p.length}"
    h.p = "field".string
    k: Holder p: h.p names: (List String) inner: (Inner p: "x".string)
    print "\{k.p} \{h.p.length}"
    for v: (Gen limit: 0) loop print "gen \{v}"
}
