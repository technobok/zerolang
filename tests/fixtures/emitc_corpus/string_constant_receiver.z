# A STRING CONSTANT IS A RECEIVER LIKE ANY STRING VIEW. A method the evaluator
# knows folds to its value at the use site; any other runs on the constant's
# static view. Both used to spell the constant's NAME into the C, where no
# variable of that name exists (`GREETING.length` emitted `GREETING.size`), and
# a constant naming another constant (`SAME: GREETING`) read as a type, so its
# method calls asked for the receiver as an argument.
GREETING: "hello, world"
SHOUT: GREETING + "!"
SAME: GREETING
ALIAS: text_consts.NAME

Holder: class {
    k: u64
} as {
    total: function {t: this.view} out u64 is {
        return GREETING.length + t.k
    }
}

twice: function as { t: anyval.generic } in {x: t} out u64 is {
    return SHOUT.length * 2
}

firstWord: function out StringView is {
    return (GREETING.substring from: 0 to: 5)
}

show: function {s: StringView n: u64} is {
    print "\{s} \{n}"
}

main: function is {
    n: GREETING.length
    starts: GREETING.startsWith "hello"
    ends: (SHOUT.endsWith suffix: "!")
    has: GREETING.contains "lo, w"
    head: (GREETING.substring from: 0 to: 5)
    print "\{n} \{starts} \{ends} \{has} \{head}"
    codepoints: GREETING.count
    cmp: GREETING.compare rhs: "hello"
    trimmed: GREETING.trim.length
    upper: GREETING.toUpperAscii
    print "\{codepoints} \{cmp} \{trimmed} \{upper} \{GREETING.isEmpty}"
    first: (GREETING.byteAt i: 0)
    match (first) case some then print "first \{first}" case none then print "empty"
    at: GREETING.indexOf ","
    match (at) case some then print "comma \{at}" case none then print "no comma"
    with it: GREETING.split ", " do for part: it loop {
        print "part \{part}"
    }
    print "\{GREETING.length} \{SHOUT.count} \{GREETING.substring from: 7 to: 12}"
    show s: (GREETING.substring from: 7 to: 12) n: GREETING.length
    h: Holder k: 3
    word: firstWord
    print "\{h.total} \{twice x: 1} \{word}"
    lead: (ALIAS.substring from: 0 to: 4)
    print "\{SAME.length} \{SAME.count} \{ALIAS.length} \{lead}"
    later: "?"
    later = GREETING.substring from: 7 to: 12
    print "\{later}"
}
