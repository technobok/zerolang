# `append` answers the index of the element it added, in the list's own index
# type: a u64 for a list that names none, the id space's type for one that does.
rowid: typedef u32

main: function is {
    xs: ListVal i64
    a: xs.append from: 10
    b: xs.append from: 20
    rows: ListVal i64 i: rowid
    r0: rows.append from: 5
    r1: rows.append from: 6
    names: ListRef String i: rowid
    n0: names.append from: "x"
    print "\{a} \{b} \{r0.u32} \{r1.u32} \{rows.get i: r1} \{n0.u32} \{names.get i: n0}"
}
