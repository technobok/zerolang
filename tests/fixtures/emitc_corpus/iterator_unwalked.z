# iterator_unwalked.z -- an iterator built and read but never walked: its
# `call` has a body, which is written only where something calls it, so the
# option its signature returns is spelled nowhere and its C is not written --
# a range from `times` and a construction of one, and an iterator of the
# program's own. A walked one beside them still runs (iterator_*, ranges).

Counter: record { left: t } as {
    t: anyval.generic
    call: function {c: this} out optionval t is {
        if c.left == 0 then return (optionval.none t)
        c.left = c.left - 1
        return (optionval.some c.left)
    }
}

main: function is {
    a: 5.u8.times
    b: (intrange u16 cur: 1 left: 3 down: false)
    c: (Counter t: i32 left: 2)
    print "\{a.left} \{b.cur} \{c.left}"
    for each i: 2.u64.times loop print "walked \{i}"
}
