# The control for the pinned-move rule, and the remedy its diagnostic names.
# `.copy` gives the new owner its own buffer, so the view keeps reading the
# original -- the same program the rule refuses, made sound. Growing the copy
# reallocates only the copy; both are printed afterwards and this is
# leak-clean.
main: function is {
    s: "abcdefghij".string
    sv: s.stringview
    g: s.copy
    g.append s: "0123456789012345678901234567890123456789".string
    print "sv=\{sv}"
    print "g=\{g}"

    # A move is fine once nothing is watching: `t` is never viewed.
    t: "xyz".string
    u: t.take
    print "u=\{u}"
}
