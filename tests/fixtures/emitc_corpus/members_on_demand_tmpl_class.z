# A templated class's members are written only where written C calls them:
# this program spawns a thread and joins it, so JoinHandle's create, join and
# destroy are written and its detach, isFinished and id are not -- nor the
# thread-shim pieces only those would call (z_thread_detach).
Greeter: class {
    who: String
} as {
    task: (thread.Task String)
    call: function {:this} out String is {
        return "hello \{this.who}"
    }
}

main: function is {
    h: thread.spawn task: (Greeter who: "thread".string)
    r: h.join
    print r
}
