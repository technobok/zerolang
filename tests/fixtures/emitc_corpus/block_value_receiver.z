# A method called on a block used as a value -- `({ ... a }).size` -- runs on
# the value the block yields, as it does on an `if` or a `with` value: with no
# arguments and with some, reading the receiver and writing it.
Doc: class {
    s: String
} as {
    size: function {t: this.view} out u64 is {
        return t.s.length
    }
    sizeBy: function {t: this.view k: u64} out u64 is {
        return t.s.length * k
    }
    addFrom: function {t: this o: Doc.view} is {
        t.s.append o.s.stringView
    }
}

reads: function {a: Doc.view c: bool} is {
    n: (
        {
            if c then print "in"
            a
        }
    ).size
    j: (
        (
            {
                if c then print "again"
                a
            }
        ).sizeBy
        k: 3
    )
    print "\{n} \{j}"
}

writes: function {a: Doc.borrow c: bool} is {
    x: Doc s: "zz".string
    (
        (
            {
                if c then print "blk"
                a
            }
        ).addFrom
        o: x
    )
}

main: function is {
    a: Doc s: "abc".string
    reads :a c: true
    writes a: a.borrow c: true
    print a.s
}
