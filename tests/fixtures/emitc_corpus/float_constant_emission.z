# A FLOAT CONSTANT REACHES C AS THE VALUE ITS TYPE HOLDS NEAREST IT, rounded
# once from the exact value and spelled in hexadecimal at the type's own width.
# An untyped fold reached C as its arithmetic (`0.1 + 0.2`, 0.30000000000000004
# in a double), a literal in an f32 slot as a double literal the call then
# narrowed -- rounding twice: `1.00000005960464477539062500001` is just past
# halfway between 1 and the next f32, a double rounds it onto the halfway
# point, and the f32 it then became was 1 -- and an untyped operand of f32
# arithmetic as a double, which made the arithmetic a double's.

# bits -- an f32's bit pattern, as the argument arrived
bits: function {x: f32} out u32 is {
    return x.bits
}

main: function is {
    a: 0.1 + 0.2
    print "\{a.bits == 0.3.bits} \{a.bits}"
    print "\{bits x: 1.00000005960464477539062500001}"
    x: 16777216.f32
    y: x + 1.0
    print "\{y == 16777216.f32}"
    z: 1.0.f32 / 3
    print "\{z.bits}"
    print "\{(1e-45.f32).bits} \{(-0.0).bits}"
}
