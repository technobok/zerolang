# A LIST READ THROUGH A UNIT IS A VALUE. `w.primes` was handled by
# `.get` and `.length` alone: read as a value -- bound, passed, iterated, a
# `for each` over it -- it emitted no C at all, because only a bare block name
# reached the view of its array. A function's result of a list value type
# walked directly took the address of the call.
w: unit {
    primes: list { 2 3 5 7 }
    names: list { "a" "bc" } out staticlist StringView
    inner: unit {
        squares: list { 1 4 9 }
    }
}

total: function {xs: staticlist i64} out i64 is {
    s: 0
    for each x: xs.iterate loop s = s + x
    return s
}

odds: list { 1 3 5 }

oddsOf: function out staticlist i64 is {
    return odds
}

main: function is {
    for each p: w.primes.iterate loop print "iterate \{p}"
    for each p: w.primes loop print "each \{p}"
    x: w.primes
    print "bound \{x.length} \{x.get i: 3}"
    print "total \{total xs: w.primes}"
    for each s: w.names.iterate loop print "name \{s}"
    for each q: w.inner.squares.iterate loop print "square \{q}"
    print "squares \{w.inner.squares.length}"
    for each p: oddsOf.iterate loop print "returned \{p}"
    print "codes \{list_consts.codes.length}"
    for each c: list_consts.codes.iterate loop print "code \{c}"
}
