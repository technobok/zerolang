# A block whose value is a local of its own hands that local out: the local is
# moved where the block ends, so the block's end does not destroy what the
# value now owns. The value may be the last line itself, or an arm of an `if`
# or a `match` on that line, at any depth: the local is moved on the path that
# yields it and destroyed on a path that yields something else. A `with` used
# as a value does the same with the value it binds.
mk: function {n: u64} out String is {
    return "s\{n}"
}

Box: class {
    s: String
}

lastLine: function {c: bool} out String is {
    a: if c then {
        s: mk n: 1
        s
    } else {
        "lit".string
    }
    b: {
        t: mk n: 2
        t
    }
    o: optionval.some 3.u64
    e: match o case some then {
        w: mk n: o
        w
    } case none then {
        "none".string
    }
    return "\{a} \{b} \{e}"
}

nestedArm: function {c: bool} out String is {
    # the block's local is one arm of the `if` the block ends with
    d: {
        u: mk n: 4
        if c then u else "other".string
    }
    # each block yields its own local on one path, and an inner block yields
    # the outer block's
    g: {
        x: mk n: 5
        if c then {
            y: mk n: 6
            y
        } else {
            x
        }
    }
    # every arm yields the one local
    h: {
        z: mk n: 7
        match (c) case true then z case false then z
    }
    return "\{d} \{g} \{h}"
}

asArgument: function {c: bool} out u64 is {
    bx: Box s: ({
        k: mk n: 8
        k
    })
    xs: List String
    xs.append ({
        m: mk n: 9
        if c then m else "e".string
    })
    return bx.s.length + xs.length
}

collections: function {c: bool} out u64 is {
    l: {
        tmp: List String
        tmp.append (mk n: 10)
        tmp
    }
    b: if c then {
        made: Box s: (mk n: 11)
        made
    } else {
        Box s: "else".string
    }
    return l.length + b.s.length
}

# a `with` hands out a local of its body, or the value it binds itself
withOwn: function {c: bool} out String is {
    r: with q: (mk n: 12) do {
        z: "\{q}!"
        z
    }
    w: with q: (mk n: 13) do {
        q
    }
    v: with q: (mk n: 14) do q
    x: with q: (mk n: 15) do {
        if c then q else "kept".string
    }
    return "\{r} \{w} \{v} \{x}"
}

inLoop: function out u64 is {
    total: 0.u64
    i: 0.u64
    for i < 3 loop {
        v: {
            p: mk n: i
            if i == 1 then p else "odd".string
        }
        total = total + v.length
        i = i + 1
    }
    return total
}

main: function is {
    print "last \{lastLine c: true} | \{lastLine c: false}"
    print "nested \{nestedArm c: true} | \{nestedArm c: false}"
    print "argument \{asArgument c: true} \{asArgument c: false}"
    print "collections \{collections c: true} \{collections c: false}"
    print "with \{withOwn c: true} | \{withOwn c: false}"
    print "loop \{inLoop}"
}
