# Readonly is deep for REFTYPES only. A valtype field read is an owned mutable
# copy -- a valtype can never contain a reftype, so nothing aliasable escapes
# and the copy is free to change. Reftype reads out of the same readonly paths
# stay readable; it is only mutation through them that is refused.
Inner: class {
    n: i64
}
Outer: class {
    sub: Inner
    count: i64
}
Box: class {
    it: Inner.hold
    tag: String.hold
}
peek: function {c: Outer.view} out i64 is {
    k: c.count
    k = k + 10
    i: c.sub
    return k + i.n
}
main: function is {
    o: Outer sub: (Inner n: 5) count: 2
    print "peek=\{peek c: o}"
    b: Box it: (Inner n: 7) tag: "t".string
    print "read=\{b.it.n} \{b.tag} \{b.tag.length}"
}
