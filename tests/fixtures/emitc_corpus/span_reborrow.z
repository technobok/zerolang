# span_reborrow.z -- windows of windows: a window re-sliced, the slice re-sliced,
# each borrowing the one it was cut from, and a window lent across a call --
# returned through `outx` from a `.borrow` parameter and written by the caller.

# a window over the middle of `xs`, which it keeps lent
middle: function {xs: (ListVal u64).borrow} outx (SpanVal u64) is {
    return (xs.mutSlice from: 1 to: (xs.length - 1))
}

main: function is {
    xs: ListVal u64
    for each n: 6.u64.times loop xs.append from: n
    {
        w: xs.mutView
        s: w.slice from: 1 to: 5
        {
            t: s.slice from: 1 to: 3
            t.set i: 0 item: 20
            t.set i: 1 item: 30
            print "inner \{t.length}"
        }
        print "outer \{s.length} \{s.get i: 1} \{s.get i: 2}"
    }
    {
        m: middle :xs
        m.set i: 0 item: 11
        print "middle \{m.length} \{m.get i: 0}"
    }
    print "xs \{xs.get i: 0} \{xs.get i: 1} \{xs.get i: 2} \{xs.get i: 3} \{xs.get i: 4} \{xs.get i: 5}"
}
