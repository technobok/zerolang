# generic_self_typed_return.z -- a method whose RETURN is typed as its own
# generic template (`out Box`), at two instantiations. cloneMethodReturn already
# held the self-type substitution and never ran it: it read only the registry's
# return type, which is recorded only where a return NAMES a generic parameter.
# A return spelled as the TEMPLATE is not one, so the clone kept the template's
# return and every use of the result was typed by the unsubstituted parameter.
#
# The class family takes the same fix -- its clone's return substitutes to the
# mono too -- but cannot be shown here: a user CLASS return is emitted by value
# while the value itself is a pointer, so `out Holder` on a NON-generic class
# fails the C compiler identically. That defect is older and unrelated.
Box: record {
    val: t
} as {
    t: anyval.generic
    pick: function {b: this rhs: Box} out Box is { return rhs }
}

main: function is {
    a: Box val: 5
    b: Box val: 9
    p: a.pick rhs: b
    print "i64 pick \{p.val}"

    c: Box val: 2.i32
    d: Box val: 8.i32
    q: c.pick rhs: d
    print "i32 pick \{q.val}"

    e: Box val: 3.u8
    f: Box val: 7.u8
    r: e.pick rhs: f
    print "u8 pick \{r.val}"
}
