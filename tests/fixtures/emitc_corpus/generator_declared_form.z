# The `generator` declaration form: an `is` block of construction fields and a
# `call` whose body suspends. The class is AUTHORED -- these are its fields and
# this is its method -- so the compiler adds only what the state machine needs:
# `call`'s implicit receiver, the option wrapper around its ELEMENT type, the
# generated `create`, and the state cursor plus the promoted locals.
#
# `out U` on `call` is the ELEMENT type, not the return type. The wrapper is put
# on by the compiler and collapses to `optionval` over a valtype element and to
# `Option` over a reftype one -- so both are driven here, in one program.
#
# All three spellings of "no construction state" are legal and parse to the same
# thing: `generator { } as`, `generator as`, and `generator is {} as`. A
# generator with no fields constructs from its bare name, which is why `for s:
# Lits loop` needs no arguments.
IntRange: generator { lo: i64  hi: i64 } as {
    call: function out i64 is {
        i: this.lo
        for i < this.hi loop {
            yield i
            i = i + 1
        }
    }
}

# no is-block at all
Lits: generator as {
    call: function out String is {
        yield "alpha".string
        yield "beta".string
    }
}

# an empty one, written out
Pair: generator { } as {
    call: function out i64 is {
        yield 1
        yield 2
    }
}

# the `is` spelled explicitly
Trio: generator is {} as {
    call: function out i64 is {
        yield 7
        yield 8
        yield 9
    }
}

# an owned reftype field, read through `this`
Tags: generator { base: String } as {
    call: function out String is {
        yield "\{this.base}-1"
        yield "\{this.base}-2"
    }
}

main: function is {
    for v: (IntRange lo: 10 hi: 13) loop print "range: \{v}"
    for s: Lits loop print "lit: \{s}"
    for p: Pair loop print "pair: \{p}"
    for t: Trio loop print "trio: \{t}"
    for g: (Tags base: "tag".string) loop print "tag: \{g}"
    print "done"
}
