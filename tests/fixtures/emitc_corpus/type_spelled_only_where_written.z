# A type's C name is written only where written C spells it. A `bool` value is
# its tag constant cast to C `bool`, a `bool ==` compares the scalars, a bool
# field is the scalar, and a checked conversion's error is a tag constant: none
# of them spells the type `bool` or `converror`, so neither typedef is written
# (cdead-guard counts the one that is). Each constant spelled is still declared.
flags: record { lit: bool  count: u64 }

main: function is {
    ready: true
    f: flags lit: ready count: 2
    if (f.lit == ready) == false then print "differ" else print "same"
    n: 0 - 3
    print "\{n.u64.or d: f.count}"
}
