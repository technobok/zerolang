# A FUNCTION OF NO ARGUMENTS RETURNING A COLLECTION, BOUND BY ITS BARE NAME, IS
# THE CALL. The binding read the name as a construction of the collection it
# returns and emitted an empty create, so `a: mk` was a list of nothing, as were
# `a: (mk)`, `return mk`, and a map or a set returned the same way.
mk: function out (ListVal u64) is {
    l: ListVal u64
    l.append 3
    return l
}

mm: function out (MapVV u64 v: u64) is {
    m: MapVV u64 v: u64
    m.set key: 1 value: 2
    return m
}

ms: function out (SetVal u64) is {
    s: SetVal u64
    s.add item: 4
    return s
}

wrap: function out (ListVal u64) is {
    return mk
}

main: function is {
    a: mk
    b: (mk)
    c: wrap
    m: mm
    s: ms
    print "\{a.length} \{b.length} \{c.length} \{m.length} \{s.length}"
}
