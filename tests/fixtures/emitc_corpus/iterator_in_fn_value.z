# a function value whose type takes an iterator -- held in a class field --
# spells the cursor as the iterator's own type: a list's and a set's cursor,
# declared once, and a string's split and lines iterators, written ahead of
# the function types that name them, whether `.lines` is called from `main`
# or from a method.
ListHolder: class {
    cb: function {it: (ListIter T: String)} out u64
}
SetHolder: class {
    cb: function {it: (SetIter K: String)} out u64
}
SplitHolder: class {
    cb: function {it: Splitter} out u64
}
LinesHolder: class {
    cb: function {it: LinesIter} out u64
} as {
    run: function {:this t: StringView} out u64 is {
        return (this.cb it: t.lines)
    }
}
countList: function {it: (ListIter T: String)} out u64 is {
    n: 0.u64
    for s: it loop n = n + 1
    return n
}
countSet: function {it: (SetIter K: String)} out u64 is {
    n: 0.u64
    for s: it loop n = n + 1
    return n
}
countSplit: function {it: Splitter} out u64 is {
    n: 0.u64
    for s: it loop n = n + 1
    return n
}
countLines: function {it: LinesIter} out u64 is {
    n: 0.u64
    for s: it loop n = n + 1
    return n
}
main: function is {
    xs: List String
    xs.append from: "a".string
    xs.append from: "b".string
    ss: Set String
    ss.add item: "a".string
    lh: ListHolder cb: countList.take
    sh: SetHolder cb: countSet.take
    ph: SplitHolder cb: countSplit.take
    nh: LinesHolder cb: countLines.take
    t: "a,b,c"
    print "\{lh.cb it: xs.iterate} \{sh.cb it: ss.iterate} \{ph.cb it: (t.split sep: ",")} \{nh.run t: "a\nb"}"
}
