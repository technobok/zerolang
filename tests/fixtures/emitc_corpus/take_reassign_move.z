# A reassignment whose RHS is an explicit `.take` is a MOVE: the target frees
# the value it held, adopts the source's heap, and the source must be zeroed so
# its own scope-exit free no-ops. Without the zeroing both names free the same
# buffer -- a double free, not a leak, so it aborts rather than merely growing.
# The bare-name form (`h = y`) already moved correctly and is covered too.
Item: class {
    name: String
    value: i64
}
main: function is {
    x: "abc".string
    y: "zzzz".string
    h: x.take
    print "1=\{h} \{h.length}"
    h = y.take
    print "2=\{h} \{h.length}"

    a: Item name: "a".string value: 1
    b: Item name: "b".string value: 2
    g: a.take
    print "3=\{g.name} \{g.value}"
    g = b.take
    print "4=\{g.name} \{g.value}"

    p: "one".string
    q: "two".string
    r: p.take
    r = q
    print "5=\{r}"
}
