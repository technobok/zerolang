# sync_channel_val.z -- the value twins: a ReceiverVal and SenderVals copy each
# value in and out. A squarer thread reads numbers from one channel and writes
# their squares to another; each channel ends when its Senders do.

# Squarer -- squares each number until its inbox ends
Squarer: class {
    # where numbers come in
    inbox: sync.ReceiverVal i64
    # where squares go out
    outbox: sync.SenderVal i64
} as {
    task: thread.TaskVal i64
    call: function {:this} out i64 is {
        answered: 0.i64
        for each r: this.inbox loop {
            this.outbox.send value: r * r
            answered = answered + 1
        }
        return answered
    }
}

main: function is {
    inbox: (sync.ReceiverVal i64).create
    outbox: (sync.ReceiverVal i64).create capacity: 2
    numbers: inbox.sender
    h: thread.spawnVal task: (Squarer inbox: inbox.take outbox: outbox.sender)
    i: 1.i64
    for i <= 5 loop {
        numbers.send value: i
        i = i + 1
    }
    sync.close sender: numbers.take
    total: 0.i64
    for each sq: outbox loop total = total + sq
    print "\{h.join} squares, summing to \{total}"
    print "outbox empty: \{(outbox.tryReceive).none}"
}
