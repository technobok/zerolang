# Arguments are evaluated left to right as written (spec, Call Arguments): a
# named argument written before another runs before it, whatever the order of
# the parameters, and a call inside an argument runs where that argument is
# written. C leaves the order of a call's arguments unspecified, and gcc ran
# them right to left. Each argument is now read into an ordered temporary
# before the call; every line below prints its ticks in ascending order.
tick: function {n: i64} out i64 is {
    print "t\{n}"
    return n
}

mks: function {n: i64} out String is {
    print "s\{n}"
    return "x\{n}"
}

lenv: function {a: String.view} out i64 is {
    return (a.length.i64.or d: 0)
}

add: function {a: i64 b: i64} out i64 is {
    return (a * 10) + b
}

three: function {a: i64 b: i64 c: i64} out i64 is {
    return (a * 100) + (b * 10) + c
}

withDefault: function {a: i64 b: 5 c: i64} out i64 is {
    return a + b + c
}

sq: function {x: i64 m: i64} out i64 is {
    return x * m
}

firstOf: function as { t: anyval.generic } in {a: t b: t} out t is {
    return a
}

lt: function {a: i64 b: i64} out bool is {
    return a < b
}

viaReturn: function out i64 is {
    return (add a: (tick n: 51) b: (tick n: 52))
}

main: function is {
    print "positional"
    r1: add a: (tick n: 1) b: (tick n: 2)
    print "named out of order"
    r2: add b: (tick n: 3) a: (tick n: 4)
    r3: three c: (tick n: 5) a: (tick n: 6) b: (tick n: 7)
    print "nested"
    r4: add a: (add a: (tick n: 8) b: (tick n: 9)) b: (add b: (tick n: 10) a: (tick n: 11))
    print "unlabelled first"
    r5: sq (tick n: 12) m: (tick n: 13)
    print "default omitted"
    r6: withDefault c: (tick n: 14) a: (tick n: 15)
    print "generic"
    r7: firstOf b: (tick n: 16) a: (tick n: 17)
    print "another unit"
    r8: order_call_dep.pair b: (order_call_dep.tick n: 18) a: (tick n: 19)
    print "hoisting argument after a call"
    r9: add a: (tick n: 20) b: (lenv a: (mks n: 21))
    print "return"
    r10: viaReturn
    print "loop condition"
    i: 0
    for while (lt a: (tick n: 60 + i) b: (tick n: 62)) loop {
        i = i + 1
    }
    print "when"
    if (lt a: (tick n: 70) b: (tick n: 71)) when (lt a: (tick n: 72) b: (tick n: 73)) then print "held"
    print "arm"
    c: true
    r11: if c then (add b: (tick n: 80) a: (tick n: 81)) else 0
    print "interpolation part"
    print "\{add b: (tick n: 90) a: (tick n: 91)}"
    print "\{r1} \{r2} \{r3} \{r4} \{r5} \{r6} \{r7} \{r8} \{r9} \{r10} \{r11}"
}
