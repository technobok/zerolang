# A `hold` binding rebinds only when the marker is written again: the
# move-and-freeze has to be visible at the assignment. The rebound name is
# still frozen afterwards, and the new source has been moved away -- both are
# pinned as errors in tests/fixtures/errors. The old value is freed and the
# source zeroed, so this is leak-clean and frees nothing twice.
Item: class {
    name: String
    value: i64
}
main: function is {
    x: "abc".string
    y: "zzzz".string
    h: x.hold
    print "1=\{h} \{h.length}"
    h = y.hold
    print "2=\{h} \{h.length}"

    a: Item name: "a".string value: 1
    b: Item name: "b".string value: 2
    g: a.hold
    print "3=\{g.name} \{g.value}"
    g = b.hold
    print "4=\{g.name} \{g.value}"
}
