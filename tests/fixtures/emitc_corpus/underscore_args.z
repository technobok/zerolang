# `_` in a call argument is the type of the parameter it fills (spec:
# Underscore): `_.ARM` names an arm of it and `_.create ...` constructs one. It
# stands for the type itself, so it reaches a type another unit declares as
# readily as one of this unit's, by label or by position, in a generic call too.
mode: variant {READ: null WRITE: null}

pt: record {x: i64 y: i64}

openit: function {name: StringView m: mode} out i64 is {
    if m.READ then return 1
    return 2
}

dist: function {p: pt} out i64 is {
    return p.x + p.y
}

pick: function as { t: anyval.generic } in {a: t m: mode} out t is {
    return a
}

main: function is {
    print "\{openit name: "f" m: _.READ} \{openit name: "g" m: _.WRITE}"
    print "\{dist p: (_.create x: 3 y: 4)}"
    print "\{kinds.rank l: _.HIGH} \{kinds.rank _.LOW}"
    print "\{kinds.width s: (_.create lo: 2 hi: 9)}"
    print "\{pick a: 5 m: _.READ}"
}
