# containment_stamp_off_path -- a record whose field is a u128 is laid out
# while a template its field needs resolves on demand, and that resolution
# stamps the type-refs other definitions recorded: `outer`'s field `inner`
# among them. Those type-refs are no field of `inner`, so reaching `inner`
# through them is no containment cycle. Before the fix the program was
# refused: "containment cycle: value type 'inner' contains itself by value".

inner: record {
    q: 0.u128
}

outer: record {
    q: inner
}

makeInner: function out inner is {
    return (inner q: 340282366920938463463374607431768211455.u128)
}

makeOuter: function out outer is {
    return (outer q: (inner q: 7.u128))
}

main: function is {
    x: makeInner
    y: makeOuter
    print "\{x.q} \{y.q.q}"
}
