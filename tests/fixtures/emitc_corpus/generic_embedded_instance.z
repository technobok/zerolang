# A GENERIC TYPE MAY EMBED ANOTHER GENERIC TYPE'S INSTANCE OVER ITS OWN
# PARAMETER. A variant or union arm `(Cell t: t)` is the partial a field's
# would be (it was "type argument of generic type 'Cell' does not name a type
# here"), and each instance is written after the instances it holds by value,
# whatever order their ids came in (it was an unknown type name in the C).
Outer: record {
    mid: (Middle t: t)
} as { t: anyval.generic }

Middle: record {
    inner: (Cell t: t)
    w: i64
} as { t: anyval.generic }

Cell: record {
    val: t
} as { t: anyval.generic }

Box: record {
    inner: (Cell t: t)
} as { t: anyval.generic }

Wrap: class {
    inner: (Cell t: t)
} as { t: anyval.generic }

pick: variant {
    one: (Cell t: t)
    none: null
} as { t: anyval.generic }

Holder: record {
    s: (slot t: t)
    n: i64
} as { t: anyval.generic }

slot: variant {
    full: t
    empty: null
} as { t: anyval.generic }

Named: class {
    name: String
    v: t
} as { t: anyval.generic }

Shelf: class {
    item: (Named t: t)
} as { t: anyval.generic }

Obj: class {
    val: t
} as { t: anyval.generic }

choice: union {
    one: (Obj t: t)
    none: null
} as { t: anyval.generic }

main: function is {
    b: (Box t: i64) inner: (Cell t: i64 val: 3)
    w: (Wrap t: i64) inner: (Cell t: i64 val: 4)
    print "\{b.inner.val} \{w.inner.val}"
    p: (pick t: i64).one (Cell t: i64 val: 5)
    match (p) case one then print "\{p.val}" case none then print "none"
    h: (Holder t: i64) s: ((slot t: i64).full 4) n: 2
    match h.s case full then print "full \{h.n}" case empty then print "empty"
    o: (Outer t: u8) mid: ((Middle t: u8) inner: (Cell t: u8 val: 7) w: 9)
    print "\{o.mid.inner.val} \{o.mid.w}"
    s: (Shelf t: i64) item: ((Named t: i64) name: "n".string v: 6)
    print "\{s.item.name} \{s.item.v}"
    c: (choice t: i64).one (Obj t: i64 val: 8)
    match c case one then print "one \{c.val}" case none then print "none"
}
