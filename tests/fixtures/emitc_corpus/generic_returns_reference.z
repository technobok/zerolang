# generic_returns_reference.z -- a generic function or a generic type's method
# may return a reference into what it was given, as a plain one may: `.view`
# of a field, `outx` of a `.borrow` parameter. The body walk of an instance read
# those markers off the function it was checking, and an instance walk has no
# function of its own there -- so each return was refused as a bare field read
# or a borrowed variable returned owned. The reference locks its source for as
# long as it lives, and no longer.
Holder: class {
    name: String
    v: t
} as {
    t: anyval.generic
    label: function {h: this.view} outx String.view is {
        return h.name
    }
}

Hold: class {
    xs: ListVal i64
}

same: function as { t: anyval.generic } in { b: (ListVal t: t).borrow } outx (ListVal t: t).borrow is {
    return b
}

items: function as { t: anyval.generic } in { h: Hold.view a: t } outx (ListVal i64).view is {
    return h.xs
}

main: function is {
    h: (Holder t: i64) name: "gen".string v: 1
    print "\{h.label} \{h.label.length}"
    l: ListVal i64
    l.append from: 1
    (same t: i64 b: l).append from: 5
    {
        r: same b: l
        r.append from: 6
    }
    l.append from: 7
    print "\{l.length}"
    k: Hold xs: (ListVal i64)
    k.xs.append from: 4
    v: items t: u8 h: k a: 1
    print "\{v.length}"
}
