# A type parameter is a type in its body: `t.create` is its instance's create,
# `(t x: 4 y: 5)` constructs the instance's type, and each instance checks the
# call against its own type.

# pt -- a point with two required fields
pt: record {
    x: i64
    y: i64
}

# made -- a value of the argument's type, made through its create
made: function as {t: anyval.generic} in {a: t} out t is {
    b: t.create
    return b
}

# built -- a point-shaped value of the argument's type, constructed
built: function as {t: anyval.generic} in {a: t} out t is {
    b: (t x: 4 y: 5)
    return b
}

# fresh -- an empty value of a reference type
fresh: function as {T: AnyRef.generic} in {a: T.view} out T is {
    b: T.create
    return b
}

main: function is {
    p: built a: (pt x: 1 y: 2)
    q: made a: 2.5
    xs: fresh a: (List String)
    print "\{made a: 3} \{q} \{p.x} \{p.y} \{xs.length}"
}
