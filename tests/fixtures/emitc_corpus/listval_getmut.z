# `ListVal.getMut` -- the mutable reference into a valtype-element list.
#
# A COMPOUND valtype has children, and mutating them in place is what `getMut`
# is for, so it must hand back a REFERENCE: `get` copies out (cheap, cannot
# alias) and a write through that copy is correctly invisible to the list. The
# two accessors differ in exactly that, and a fixture that only checked getMut
# would not show it -- so both are exercised over the same element.
#
# Whole-element replacement stays `set`: a borrow never replaces its referent.
pt: record {
    x: i64
    y: i64
}

main: function is {
    ps: (ListVal pt)
    ps.append (pt x: 1 y: 2)
    ps.append (pt x: 3 y: 4)

    # a reference: the write lands in the list
    p: ps.getMut i: 0
    p.x = 41
    a: ps.get i: 0
    print "getMut wrote: x=\{a.x} y=\{a.y}"

    # a copy: the write does NOT
    c: ps.get i: 1
    c.x = 99
    b: ps.get i: 1
    print "get copied: x=\{b.x} y=\{b.y}"

    # whole-element replacement is `set`
    ps.set i: 1 val: (pt x: 7 y: 8)
    d: ps.get i: 1
    print "set replaced: x=\{d.x} y=\{d.y}"

    with it: ps.iterate do for e: it loop print "iter x=\{e.x} y=\{e.y}"
}
