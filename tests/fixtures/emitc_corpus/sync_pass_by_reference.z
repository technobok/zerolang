# sync_pass_by_reference.z -- a templated class passes as a class does, by
# reference: an atomic changed through a parameter, or through an element a
# list hands back, is the caller's atomic, not a copy of it.

# bump -- stores into the caller's atomic
bump: function {a: sync.AtomicI64} is {
    a.store value: 9
}

# add -- adds to the caller's atomic, answering what it held
add: function {a: sync.AtomicI64 n: i64} out i64 is {
    return (a.fetchAdd value: n)
}

main: function is {
    a: sync.AtomicI64.create value: 4
    bump :a
    print "param \{a.load}"
    was: add :a n: 1
    print "added to \{was}: \{a.load}"
    xs: List sync.AtomicI64
    xs.append (sync.AtomicI64.create value: 4)
    (xs.getMut i: 0).store value: 7
    print "element \{(xs.get i: 0).load}"
    bump a: (xs.getMut i: 0)
    print "element param \{(xs.get i: 0).load}"
}
