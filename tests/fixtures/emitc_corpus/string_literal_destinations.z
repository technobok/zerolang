# A string literal is the owned String it reads as where the destination is
# known to be a String (spec: String Literal Types): a String parameter of any
# marker, a String field, an `out String` return, the reassignment of a String
# place, a `List String` element. Anywhere else it stays a StringView: a plain
# binding, and a StringLike generic parameter, which takes a view as written.
Named: class { name: String }

greet: function {who: String} out u64 is {
    return who.length
}

keep: function {s: String.take} out String is {
    return s
}

label: function out String is {
    return "fixed"
}

show: function as { T: StringLike.generic } in {s: T.view} out u64 is {
    return s.length
}

main: function is {
    a: greet who: "bob"
    k: keep s: "owned"
    n: Named name: "field"
    s: "a".string
    s = "reassigned"
    n.name = "renamed"
    xs: List String
    xs.append "element"
    print "\{a} \{k} \{n.name} \{s} \{xs.get i: 0} \{label}"
    v: "view"
    print "\{v.length} \{show s: "generic"}"
}
