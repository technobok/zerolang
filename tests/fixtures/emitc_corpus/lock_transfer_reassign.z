# Reassigning a binding from a pinning call moves the pins with the new value:
# the old value's locks are released as it is destroyed, the new value's are
# installed. Reassigning from another lock-holding binding moves them too.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1 label: "owned".string)
}

main: function is {
    a: Src n: 1
    b: Src n: 2
    {
        x: mk from: a
        x = mk from: b
        # a is free again; b is locked
        a.n = 10
        print "reassigned: \{x.s.n} \{a.n}"
        y: mk from: a
        x = y
        # both pins now sit under x
        print "moved: \{x.s.n}"
    }
    a.n = 20
    b.n = 30
    print "after: \{a.n} \{b.n}"
}
