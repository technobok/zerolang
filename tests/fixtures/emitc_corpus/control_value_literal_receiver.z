# An `if` or a `match` whose arms are all literals yields the literal type, so
# that it lands where it is used, as a literal does. Read as an operator's
# receiver on a condition only run time knows, it has no compile-time value:
# with nothing else to give it a type it lands in its default, i64, as it does
# when it is bound -- and the operation runs as that type's.
#
# The operation ran as the literal type's own, which only the compiler can
# compute: the C called an undeclared `z_tN_eq`, and `+` stopped the emitter on
# E0500 "unhandled callee".
k: variant {
    a: null
    b: null
}

main: function is {
    c: true
    x: k.b
    if (match (x) case a then 1 case b then 2) == 2 then print "b"
    if (if c then 1 else 2) == 1 then print "one"
    print "\{(match (x) case a then 1 case b then 2) + 5}"
    print "\{((if c then 1 else 2) + 3) * 2}"
    w: 7.u8
    # a typed operand gives the literal its type, as before
    print "\{(if c then 1 else 2) + w}"
}
