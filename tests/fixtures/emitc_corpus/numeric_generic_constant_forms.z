# A TEMPLATE'S CONSTANT OVER ITS NUMERIC PARAMETER IS EACH INSTANCE'S, in every
# form a constant takes: the parameter itself, a conversion of it, an operator
# over that. In a class or a record the parameter itself "had no compile-time
# value", its conversion was "no member" and an operator over that "not a
# compile-time constant"; in a unit the parameter itself reached the emitter.
Box: class {
    used: u32
    sum: function {:this} out u64 is {
        return Box.SAME.u64 + Box.WIDE + Box.NEXT
    }
} as {
    cap: u32.generic
    SAME: cap
    WIDE: cap.u64
    NEXT: (cap.u64 + 1)
}

Pair: record {
    x: i64
} as {
    n: u8.generic
    SAME: n
    WIDE: n.u64
}

P9: (Pair n: 9)

sized: unit as {
    cap: u32.generic
    SAME: cap
    WIDE: cap.u64
    NEXT: (cap.u64 + 1)
}

eight: (sized cap: 8)
two: (sized cap: 2)

main: function is {
    b: (Box cap: 8) used: 0
    c: (Box cap: 3) used: 0
    print "\{b.sum} \{c.sum}"
    p: P9 x: 1
    print "\{P9.SAME} \{P9.WIDE} \{p.x}"
    print "\{eight.SAME} \{eight.WIDE} \{eight.NEXT} \{two.NEXT}"
}
