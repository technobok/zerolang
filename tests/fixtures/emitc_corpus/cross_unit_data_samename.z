# Two units each declaring `tab: data {...}`. A dependency unit's definitions are
# resolved by demand and the demand set is keyed by BARE NAME, so main's `tab`
# used to satisfy the dependency's reference: both functions read main's array
# and the dependency's table was never emitted at all (printed 1 and 1).
# Runs + prints both values: a naming-only fix compiles but still computes wrong.
tab: data { 1 2 3 4 } out u8
mine: function {i: u64} out u8 is { return (tab.index i) }
main: function is {
    a: mine i: 0.u64
    b: xunit_data_samename.lookup i: 0.u64
    print "main=\{a} dep=\{b}"
}
