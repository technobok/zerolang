# generator_alias_return.z -- a generator whose declared return head is an
# ALIAS of the Iterator protocol rather than the protocol's own name.
#
# Candidacy asks which declaration the return head reaches, never how it is
# spelled, so `Seq` reaches `Iterator` and the function lowers exactly as if
# it had named the protocol directly. While the head was compared by text,
# this program was silently NOT lowered and then rejected downstream, with an
# error naming the un-lowered protocol type rather than the real problem.

Seq: Iterator

count: function {n: i64} out (Seq Gives: i64) is {
    i: 0
    for i < n loop {
        yield i
        i = i + 1
    }
}

main: function is {
    for x: (count n: 3) loop print "x: \{x}"
    print "done"
}
