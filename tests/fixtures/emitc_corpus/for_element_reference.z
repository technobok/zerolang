# The loop element is a REFERENCE into the container, so mutating it mutates
# the container. Copying it instead would lose a valtype field's write and free
# a reftype field's buffer under the container.
#
# Also here: the index-loop form, which reads the container each iteration
# because the element reference's scope ends with the body.
Row: class {
    n: i64
    label: String
}
main: function is {
    rows: (List Row)
    rows.append from: (Row n: 1 label: "a".string)
    rows.append from: (Row n: 2 label: "b".string)

    with it: rows.iterateMut do for r: it loop {
        r.n = r.n + 10
        r.label.append s: "!".string
    }
    a: rows.get i: 0
    b: rows.get i: 1
    print "rows=\{a.n},\{a.label} \{b.n},\{b.label}"

    names: (List String)
    names.append from: "x".string
    names.append from: "y".string
    with nit: names.iterateMut do for s: nit loop {
        s.append s: "z".string
    }
    n0: names.get i: 0
    n1: names.get i: 1
    print "names=\{n0} \{n1}"

    i: 0.u64
    total: 0.i64
    for i < rows.length loop {
        e: rows.get i: i
        total = total + e.n
        i = i + 1
    }
    print "total=\{total}"
}
