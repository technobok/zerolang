# nested_template.z -- a generic template declared INSIDE a namespace unit is a
# TEMPLATE: it is marked generic, its parameters are registered against its own
# declaration, and its def node is stamped -- exactly as a top-level
# `unit as {...}` is. A unit body that declares a generic parameter parses as
# `template` whatever it is nested in, so the resolver must dispatch on that
# kind rather than treating every nested unit as a namespace.
outer: unit {
    SCALE: 3
    mathops: unit as {
        t: anyval.generic
        add: function {a: t b: t} out t is { return a + b }
        double: function {v: t} out t is { return v + v }
    }
}

# the same template at top level, which instantiates today
plainops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
}

intmath: (plainops t: i64)

main: function is {
    print "scale=\{outer.SCALE}"
    print "add=\{intmath.add a: 3 b: 5}"
}
