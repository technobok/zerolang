# A list takes an index type: u64 unless it says otherwise, and then an id
# space of its own. Every method that takes a position takes one of that
# type -- get, getMut, set, insert, slice -- and the windows a list hands out
# are indexed the same way; `length` stays a u64 count. A list that names no
# index type is indexed by u64 as before.
rowid: typedef u32

row: record { v: i64 }

Table: class {
    rows: (ListVal row i: rowid)
    names: (ListRef String i: rowid)
}

total: function {xs: (ListViewVal i64 i: rowid)} out i64 is {
    s: i64
    k: rowid from: 0.u32
    for k.u32.u64 < xs.length loop {
        s = s + (xs.get i: k)
        k = rowid from: k.u32 + 1
    }
    return s
}

main: function is {
    xs: ListVal i64 i: rowid
    xs.append from: 10
    xs.append from: 30
    xs.insert from: 20 at: (rowid from: 1.u32)
    one: rowid from: 1.u32
    print "\{xs.get i: one} \{xs.length}"
    old: xs.set i: one val: 21
    print "\{old} \{xs.get i: one}"
    print "\{total xs: xs.listView} \{total xs: (xs.slice from: one to: (rowid from: 3.u32))}"
    t: Table rows: (ListVal row i: rowid) names: (ListRef String i: rowid)
    t.rows.append from: (row v: 7)
    t.names.append from: "first"
    r: t.rows.getMut i: (rowid from: 0.u32)
    r.v = 8
    r.drop
    print "\{(t.rows.get i: (rowid from: 0.u32)).v} \{t.names.get i: (rowid from: 0.u32)}"
    # a list that names no index type is indexed by u64
    ys: ListVal i64
    ys.append from: 5
    print "\{ys.get i: 0}"
}
