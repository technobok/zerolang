# One of two units declaring the same sum names, for tag_stem_clash.
pal: variant { lo: null hi: null }

Foo: class { n: i64 }

# the arm `k` selects, by value
pick: function {k: i64} out pal is {
    if k > 3 then return pal.hi
    return pal.lo
}

# an Option over this unit's own Foo
boxed: function {k: i64} out i64 is {
    if k < 1 then return -1
    o: Option.some (Foo n: k)
    match (o) case some then return o.n case none then return -1
}
