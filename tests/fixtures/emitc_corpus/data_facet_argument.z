# A DATA VALUE PASSED AS A FACET IT IMPLEMENTS: a data value is held as a
# pointer to the static object the compiler built (a handle), so the facet's
# create is handed that pointer as it is. Taking its address again passed a
# `T**` where the create takes a `T*`, which the C compiler refused.
sizer: facet {
    size: function {t: this.view} out u64
}
box: data { n: u64 } as {
    m: sizer.implement
    size: function {t: this.view} out u64 is { return t.n + 1 }
}
five: (box n: 5)

measure: function {m: sizer} out u64 is {
    return m.size
}

main: function is {
    held: five
    print "\{measure m: five} \{measure m: held} \{measure m: five.m}"
}
