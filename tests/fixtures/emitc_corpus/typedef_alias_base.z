# a typedef takes its base's family, and a base named through an alias is its
# target's: `List` is core's alias for `collections.ListRef`, a class. The
# family lookup reused the alias's own name in the target unit, found nothing
# there and read the typedef as a record: a valtype holding a list, whose
# buffer nothing freed.
Names: typedef List String

count: function {n: Names.view} out u64 is { return n.length }

main: function is {
    n: Names
    n.append from: "a".string
    n.append from: "b".string
    print "names \{count :n}"
}
