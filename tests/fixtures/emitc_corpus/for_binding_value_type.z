# for_binding_value_type.z -- a `for` header binding takes the type of the value
# it is bound to, whatever shape that value has. `x` binds a parenthesised call
# and `y` an operation whose left operand is one; each is an f64, and each loop
# counts in halves. The binding's C temporary is typed from the value's own
# stamp, so a value shape the lookup does not recognise falls back to an
# integer and the loop truncates every step.
half: function {of: f64} out f64 is {
    return of / 2.0
}

main: function is {
    k: 0
    for x: (half of: 1.0) while x < 2.0 while k < 6 loop {
        print "x \{x}"
        x = x + 0.5
        k = k + 1
    }
    j: 0
    for y: (half of: 3.0) + 0.25 while y < 3.0 while j < 6 loop {
        print "y \{y}"
        y = y + 0.5
        j = j + 1
    }
}
