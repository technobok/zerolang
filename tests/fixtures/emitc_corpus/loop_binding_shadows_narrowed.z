# loop_binding_shadows_narrowed -- A loop's binding shadows the narrowed outer name over
# the loop's body: a write to the binding there is not a write of the outer local, so
# the outer narrowing stands after the loop.
U: union {
    some: String
    none: null
}

supplier: function {k: i64} out (optionval i64) is {
    if k < 2 then return (optionval.some k)
    return (optionval.none i64)
}

shadowed: function {o: U.take} is {
    if o.none then return
    k: 0
    for o: (supplier :k) loop {
        o = o + 10
        print "in \{o}"
        k = k + 1
    }
    n: o.length
    print "\{n}"
}

main: function is {
    shadowed o: (U.some "abc".string)
}
