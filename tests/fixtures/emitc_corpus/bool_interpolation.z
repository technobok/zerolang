# An interpolated bool prints the name of the arm it holds, `true` or `false`,
# however the value is written: a literal, a comparison, a call's result, a
# field, a typedef of bool. It printed `1` and `0`, as an integer would. The
# part is still evaluated once: the call that counts below runs once per part.
answer: bool

holder: record {
    ok: bool
}

Counter: class {
    n: i64
} as {
    bump: function {:this} out bool is {
        this.n = this.n + 1
        return this.n > 1
    }
}

isBig: function {n: i64} out bool is {
    return n > 10
}

main: function is {
    t: true
    f: false
    h: holder ok: true
    k: answer.false
    print "literals: \{t} \{f}"
    print "values: \{3 > 2} \{isBig n: 1} \{h.ok} \{k}"
    c: Counter n: 0
    print "once: \{c.bump} \{c.bump} n=\{c.n}"
    s: "\{t}/\{f}"
    print "as a string: \{s} (\{s.length} bytes)"
}
