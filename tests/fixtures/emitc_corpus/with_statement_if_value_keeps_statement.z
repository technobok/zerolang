# with_statement_if_value_keeps_statement -- a `with` standing as a statement keeps its
# body a statement even when the value it binds is an `if` with a block arm.
main: function is {
    c: true
    s: "abc".string
    with w: (if c then {
        print "picked"
        s.length
    } else 0) do s.drop
    print "done"
}
