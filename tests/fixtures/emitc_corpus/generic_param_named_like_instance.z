# A generic parameter may be named like the instance another parameter's type
# names: `pair_t` beside `(pair t)`, `pair_i64` beside a `(pair i64)` inside a
# partial. An instance is no parameter, so neither binds the parameter of that
# name; each binds from its own argument.
pair: record {
    a: t
} as {
    t: anyval.generic
}

duo: record {
    a: t
    b: u
} as {
    t: anyval.generic
    u: anyval.generic
}

holds: function as { t: anyval.generic pair_t: anyval.generic } in {
    x: pair t y: pair_t
} out pair_t is {
    return y
}

nested: function as { t: anyval.generic pair_i64: anyval.generic } in {
    x: (duo t u: pair i64)
    y: pair_i64
} out pair_i64 is {
    return y
}

main: function is {
    p: pair a: 5
    d: duo a: 1 b: p
    print "\{holds x: p y: 2.5} \{nested x: d y: 3.5}"
}
