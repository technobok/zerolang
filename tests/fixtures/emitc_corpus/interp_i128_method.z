# A 128-bit interpolation inside a TYPE METHOD. Method bodies emit after
# emitNeededNatives, so the z_fmt_128 fragment this needs is loaded at final
# assembly rather than with the other gated natives; without that, the call
# would emit and the definition would not.

Holder: record {
    v: u128
    w: i128
} as {
    show: function {t: this.view} out String is {
        return "\{t.v}/\{t.w}"
    }
}

main: function is {
    h: Holder v: 5.u128 w: (0 - 7).i128
    print h.show
}
