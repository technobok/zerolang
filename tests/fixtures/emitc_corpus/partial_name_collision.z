# partial_name_collision.z -- a partial specialisation is labelled like any
# other spec (`Cell_t`), and `isPartial` on its row is what says it is one. So a
# program may itself declare a type with exactly that name, and the two must not
# be confused.
#
# The risk is specific. A pass sweeps every GENERIC_PARAM-typed row to collect
# the names that denote type PARAMETERS; a partial wears that typetype too, so
# an unfiltered sweep would intern `Cell_t` as a parameter name and a typeref
# spelled that way would resolve as a parameter rather than as the record below.
# The filter asks the flag, not the name shape.
Cell: record {
    v: i64
} as { t: anyval.generic }

# exactly the label the partial for `(Cell :t)` carries
Cell_t: record {
    w: i64
}

Holder: class {
    n: i64
} as {
    t: anyval.generic
    sum: function {:this c: (Cell :t)} out i64 is { return this.n + c.v }
}

main: function is {
    h: (Holder t: i64 n: 10)
    c: (Cell t: i64 v: 32)
    x: (Cell_t w: 5)
    print "sum=\{h.sum c: c}"
    print "w=\{x.w}"
}
