# float_rounds_each_operation -- each float operation rounds once, so
# `a - (b * c)` rounds the product before the subtraction. A fused
# multiply-add would round once for both: with b and c just above 1, the
# product's last bit is rounded away, and `a - (b * c)` is 0 where a fused
# one is not. The values are locals, which a C compiler that fuses would fold
# as one operation.
main: function is {
    a: 1.00048828125.f32
    b: 1.000244140625.f32
    c: 1.000244140625.f32
    print "f32 \{(a - (b * c)).bits}"
    a64: 1.00000001490116119384765625.f64
    b64: 1.000000007450580596923828125.f64
    c64: 1.000000007450580596923828125.f64
    print "f64 \{(a64 - (b64 * c64)).bits}"
}
