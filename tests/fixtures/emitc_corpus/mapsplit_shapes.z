# Every spelling a split Map is constructed and passed in: the elided key
# label, the explicit `key:` label, `capacity:` inside the parens and outside
# them, a class field, and a parameter. `capacity:` is admitted by TEMPLATE
# IDENTITY -- a native create's params carry no modeled children, so the label
# is allowed by name against each container template.
#
# The class field is also what proves the auto-destructor: a split Map mono
# owns a heap table exactly as a `Map` does, and a field holding one leaks it
# otherwise.
Holder: class {
    counts: (MapRV String value: u64)
}

takes: function {m: (MapVV key: u64 value: u64).view} out u64 is {
    return m.length
}

main: function is {
    a: (MapVV u64 value: u64 capacity: 8)
    a.set key: 1 value: 10
    b: (MapVV key: u64 value: u64)
    b.set key: 2 value: 20
    c: (MapVR u64 value: String) capacity: 32.u64
    c.set key: 3 value: "three".string
    h: Holder counts: (MapRV String value: u64 capacity: 4)
    h.counts.set key: "x".string value: 4
    n: takes m: a
    print "cap=\{a.length} label=\{b.length} out=\{c.length} field=\{h.counts.length} param=\{n}"
}
