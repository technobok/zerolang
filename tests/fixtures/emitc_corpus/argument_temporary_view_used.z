# A view of an owned value lent to a call is legal while the value lives: read
# in the same statement, bound and read in the same block, or through a
# method whose other parameter it is.
mks: function {n: i64} out String is {
    return "x\{n}"
}

headOfView: function {s: String.view} outx StringView is {
    return s.stringView
}

Holder: class {
    s: String
} as {
    pick: function {t: this.view other: String.view} outx StringView is {
        return t.s.stringView
    }
}

main: function is {
    n: (headOfView s: (mks n: 1)).length
    x: 5
    m: (headOfView s: "\{x}").length
    h: headOfView s: (mks n: 22)
    b: Holder s: "bb".string
    p: b.pick other: (mks n: 3)
    print "\{n} \{m} \{h} \{p}"
}
