# const_match_dead_case_unwalked -- A match on a unit constant folds to the arm the
# constant holds. A `case` the fold rules out is not walked: what it reads need not
# type.
shape: choice {
    circle: i64
    square: i64
    dot: null
}
SH: (shape.square 4)

main: function is {
    match SH case dot then print "\{SH + 1}" case square then print "side \{SH}" case circle then print "circle"
}
