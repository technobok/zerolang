# text_default.z -- `"abc".text` declares text wherever a declaration takes a
# value: a record and a class field default, a unit constant and a type's `as`
# constant. The field is a text field, so a construction may still pass its
# own literal, and an omitted one takes the default.
greeting: "hi".text

Row: record {
    key: "none".text
    n: 5
} as {
    EMPTY: "".text
}

Tag: class {
    label: "untagged".text
}

shout: function {t: text} out String is {
    s: t.string
    s.append "!"
    return s
}

main: function is {
    r: Row
    s: Row key: "k" n: 2
    g: Tag
    h: Tag label: "lab"
    print "\{r.key} \{r.n} \{s.key} \{g.label} \{h.label}"
    print (shout t: greeting)
    print (shout t: r.key)
    print "\{Row.EMPTY.length}"
}
