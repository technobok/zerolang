# os_spawn_list_param.z -- a (List String) PARAM forwarded to os.spawn's
# by-pointer argv, the shape that made emitOsCall emit &argv (a List** where
# List* is expected). A local list needs the &; a reftype/List param already
# arrives as a pointer, so it must be passed directly. The child is this
# program run again, which ends at once with 0.

runSpawn: function {argv: List String} out i32 is {
    discard: os.nullDevice
    return (os.spawn :argv cwd: "" outPath: discard.stringView errPath: discard.stringView timeoutSecs: 0)
}

main: function is {
    args: os.args
    if args.length > 1 then os.exit code: 0
    me: os.exePath
    match (
        me
    ) case ok then {
        av: (List String)
        av.append from: me.stringView.string
        av.append from: "child".string
        code: runSpawn argv: av
        print "code=\{code}"
    } case err then print "no exePath"
}
