# A move inside a loop is fine when every path after it leaves the loop:
# `break` right after the move, or a `break` at the end of the arm that
# moves while the other iterations continue. Nothing reads the moved name
# afterwards.
eats: function {s: String.take} out bool is {
    return s.length > 0
}
main: function is {
    x: "abc".string
    n: 0
    for while n < 5 loop {
        n = n + 1
        if (eats s: x) then print "took \{n}"
        break
    }
    y: "wxyz".string
    m: 0
    for while m < 5 loop {
        m = m + 1
        if m == 3 then {
            if (eats s: y) then print "took at \{m}"
            break
        }
        print "kept \{m}"
    }
    print "done"
}
