# nested_sibling_call.z -- a function inside a nested unit calls a SIBLING by
# bare name: an inline unit's `quad` calls its `twice`, and a hidden subunit's
# does the same. The checker resolved these in the scope they were written in;
# the emitter used to look the callee up by name in the FILE unit alone and
# reported an unhandled callee. It reads the callable's stamped id now.
box: unit {
    K: 2
    kay: function out i64 is { return K }
    twice: function {v: i64} out i64 is { return v + v }
    quad: function {v: i64} out i64 is { return (twice (twice v)) }
}

main: function is {
    print "\{box.kay} \{box.quad 3} \{helper.quad 5}"
}
