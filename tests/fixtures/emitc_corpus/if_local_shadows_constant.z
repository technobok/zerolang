# if_local_shadows_constant.z -- a condition that reads a local reads that local,
# even when a unit constant has the same name. The condition folds before the
# walk reaches it, so the fold has to see the local itself.

K: false
N: 1

Box: class {
    used: u32
    show: function {:this} is {
        cap: 9
        if cap == 4 then print "read the parameter" else print "read the local"
    }
} as { cap: u32.generic }

param: function {N: i64} is {
    if N == 1 then print "read the constant" else print "read the parameter"
}

nested: function is {
    N: 2
    {
        if N == 1 then print "read the constant" else print "read the outer local"
    }
}

# a name before its local is defined is still the constant
before: function is {
    if N == 1 then print "read the constant" else print "read a later local"
    N: 2
    print "local \{N}"
}

main: function is {
    K: true
    if K then print "read the local" else print "read the constant"
    N: 2
    if N == 1 then print "read the constant" else print "read the local"
    if (N + 0) == 1 then print "read the constant" else print "read the local"
    param N: 3
    nested
    before
    b: (Box cap: 4) used: 0
    b.show
}
