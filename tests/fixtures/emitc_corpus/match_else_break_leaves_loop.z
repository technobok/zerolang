# match_else_break_leaves_loop -- A `break` in a match's `else` leaves the loop: the
# code after the loop runs.
kind: variant {
    a: null
    b: null
}

f: function {v: kind} out i64 is {
    n: 0
    for true loop {
        n = n + 1
        match v case a then print "a" else break
        if n > 2 then return n
    }
    print "after the loop"
    return 0 - n
}

main: function is {
    print "\{f v: kind.a} \{f v: kind.b}"
}
