# Every spelling a Set is constructed and passed in: the positional type
# argument, the `of:` label, `capacity:` inside the parens and outside them,
# a class field, and a parameter. `capacity:` is admitted by TEMPLATE
# IDENTITY -- a native create's params carry no modeled children, so the
# label is allowed by name against each container template, and the
# outside-the-parens form additionally needs the template excused from the
# standard constructor walk.
Holder: class {
    names: (Set String)
}

takes: function {s: (Set K: String).view} out u64 is {
    return s.length
}

main: function is {
    a: (Set String capacity: 8)
    a.add item: "a".string
    b: (Set K: String)
    b.add item: "b".string
    c: (Set K: String) capacity: 32.u64
    c.add item: "c".string
    h: Holder names: (Set String capacity: 4)
    h.names.add item: "d".string
    n: takes s: a
    print "in=\{a.length} of=\{b.length} out=\{c.length} cap=\{c.capacity} field=\{h.names.length} param=\{n}"
}
