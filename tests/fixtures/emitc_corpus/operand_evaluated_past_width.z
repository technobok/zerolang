# operand_evaluated_past_width -- every operand of an operator is evaluated,
# whatever the operator does with its value: a shift whose count is the width
# or more answers 0 (or the sign) without the left side's value, and the left
# side still runs. Each `note` call prints.

# note -- `v` after printing `what`: an operand whose evaluation shows
note: function {what: StringView v: u64} out u64 is {
    print "evaluated \{what}"
    return v
}

# note8 -- note for an i8
note8: function {what: StringView v: i8} out i8 is {
    print "evaluated \{what}"
    return v
}

main: function is {
    big: 300.u64
    print "u64 << 64: \{(note what: "u64 left" v: 5) << 64.u64}"
    print "u64 >> big: \{(note what: "u64 right-shifted" v: 5) >> big}"
    print "i8 << 8: \{(note8 what: "i8 left" v: 3.i8) << 8.i8}"
    print "u32 << 40: \{((note what: "u32 left" v: 7).u32.or d: 0) << 40.u32}"
}
