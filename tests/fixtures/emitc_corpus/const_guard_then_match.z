# A match needs only the arms its subject can still hold: a unit constant
# holds the one arm its value has, so a match on it needs that arm's case
# alone, whatever guard went before; and a match no path reaches -- after a
# guard on the constant that always returns -- needs none. A local is
# narrowed by the guard as before.
mode: variant {
    fast: null
    slow: null
    eco: null
}

K: mode.eco

taken: function out i64 is {
    if K.eco then return 0
    match K case fast then return 1 case slow then return 2
}

notTaken: function out i64 is {
    if K.fast then return 0
    match K case slow then return 1 case eco then return 2
}

local: function {m: mode} out i64 is {
    if m.eco then return 0
    match m case fast then return 1 case slow then return 2
}

main: function is {
    print "\{taken} \{notTaken} \{local m: mode.eco}"
}
