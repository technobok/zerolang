# alias_generic_out_type.z -- a generic type named through a unit-level alias
# is instantiated while declarations are indexed, before its template's method
# returns resolve. A method returning `type` must still return the INSTANCE --
# the C was written with the template's own name, which no C type carries --
# for a record over a value parameter, a record over a type parameter and a
# class alike.

# a record over a value parameter
vrec: record {
    v: u64
} as {
    n: u64.generic
    # v doubled, plus n
    twice: function {s: this.view} out type is {
        return (meta.create v: s.v * 2 + n)
    }
}

# a record over a type parameter
trec: record {
    v: u64
} as {
    t: anyval.generic
    # v plus one
    next: function {s: this.view} out type is {
        return (meta.create v: s.v + 1)
    }
}

# a class over a value parameter
vcls: class {
    v: u64
} as {
    n: u64.generic
    # a copy with v times n
    scaled: function {s: this.view} out type is {
        return (meta.create v: s.v * n)
    }
}

V2: (vrec n: 2)
TI: (trec t: i64)
C3: (vcls n: 3)

main: function is {
    a: V2 v: 7
    b: TI v: 40
    c: C3 v: 5
    print "\{a.twice.v} \{b.next.v} \{c.scaled.v}"
}
