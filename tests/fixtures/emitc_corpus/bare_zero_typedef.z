# bare_zero_typedef.z -- the bare zero-create of a TYPEDEF, in the two shapes
# the bare-atom and unit-qualified legs used to answer differently. A class
# whose typedef base is a scalar is that scalar's zero, not a call to a create
# nothing defines; a class whose typedef base is a COLLECTION constructs the
# collection, which the scalar chase cannot answer because the base names a
# template rather than a C type. Argument position is the half that reaches
# the atom leg at all -- a binding is served by its own leg -- and its hoisted
# temp is destroyed as the collection: the alias emits no destroyer of its own.
Meters: class { val: i64.typedef }
Buf: class { val: (ListVal u8).typedef }

useM: function {m: Meters} out i64 is {
    return m.i64
}

useB: function {b: Buf.view} out u64 is {
    return b.length
}

main: function is {
    m: Meters
    print "bindM=\{m.i64}"
    print "argM=\{useM m: Meters}"
    b: Buf
    print "bindB=\{b.length}"
    print "argB=\{useB b: Buf}"
}
