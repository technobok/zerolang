# A union arm too wide for the slot is written `(Box T)` and takes the plain
# value: a text, a static list, and a generic parameter's argument alike.
primes: list { 2 3 5 7 } out staticlist u8
pair: record { a: i64  b: i64 }
U: union {
    t: (Box text)
    l: (Box (staticlist u8))
    s: String
}
Tree: union { leaf: (Box t)  node: String } as { t: anyval.generic }

main: function is {
    u: U.t "hello".text
    match (u) case t then print "t" case l then print "l" case s then print u
    v: U.l primes
    match (v) case l then print "l" case t then print "t" case s then print v
    b: (Tree pair).leaf (pair a: 1 b: 2)
    if b.leaf then print "\{b.a}"
}
