# The two hashable bounds a Map key or Set element will name once the
# containers split by family.
#
# valhashable is satisfied IMPLICITLY: the compiler already synthesises a byte
# hash and a byte compare for a valtype, so a plain record needs no
# declaration. RefHashable is not: a class's contents live behind a pointer, so
# a byte hash of the handle would key on identity, and a conforming type has to
# declare both members and say which it meant. String and StringView already
# do, which is why the common reftype keys keep working untouched.
pt: record {
    x: u64
}

Good: class {
    n: u64
} as {
    hash: function {t: this.view} out u64 is {
        return t.n
    }
    ==: function {t: this.view rhs: Good} out bool is {
        return t.n == rhs.n
    }
}

keyv: function as { k: valhashable.generic } in { v: k } out u64 is {
    v
    return 1
}

keyr: function as { K: RefHashable.generic } in { v: K } out u64 is {
    v
    return 2
}

main: function is {
    a: keyv v: (pt x: 1)
    g: Good n: 1
    b: keyr v: g
    s: "hi".string
    c: keyr v: s
    sv: "there"
    d: keyr v: sv
    print "record=\{a} class=\{b} String=\{c} StringView=\{d}"
}
