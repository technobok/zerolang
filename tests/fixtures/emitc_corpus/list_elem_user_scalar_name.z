# A program's own type spelled like a scalar is the program's type, in a
# list's `out` as anywhere: `u8` below is an i64, and 300 fits it. The block's
# element kind was read off the NAME `u8`, so the element was refused as out of
# range for the system u8.
u8: typedef i64

d: list { 300  70000 } out (staticlist u8)

main: function is {
    print "\{d.get i: 0}"
    print "\{d.get i: 1}"
}
