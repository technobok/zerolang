# stringview_key.z -- text keys a Map and is a Set element (a container holds
# no view: static text is `text`). It is handed to the container's hash and
# equality functions BY VALUE, as the view it is laid out as, so both read the
# struct's own `size` and `data`: equal text from two different literals is one
# key, and text that differs only in length is two.

main: function is {
    m: MapVV text v: u8
    m.set key: "alpha" value: 1
    m.set key: "beta" value: 2
    m.set key: "alpha" value: 3
    m.set key: "alph" value: 4
    a: m.get key: "alpha"
    match (a) case some then { print "alpha=\{a}" } case none then { print "alpha=none" }
    print "has beta \{m.has key: "beta"} has gamma \{m.has key: "gamma"}"
    r: m.remove key: "beta"
    match (r) case some then { print "removed \{r}" } case none then { print "removed none" }
    print "map length \{m.length}"

    names: MapVR text V: String
    names.set key: "k" value: "first".string
    names.set key: "k" value: "second".string
    n: names.get key: "k"
    match (n) case some then { print "k=\{n}" } case none then { print "k=none" }
    print "names length \{names.length}"

    s: SetVal text
    s.add "x"
    s.add "y"
    s.add "x"
    print "set length \{s.length} has y \{s.has "y"} has z \{s.has "z"}"
    s.delete "y"
    print "set length \{s.length}"
}
