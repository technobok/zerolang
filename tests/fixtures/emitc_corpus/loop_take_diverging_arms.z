# Moves on arms that all leave the loop: `break` in one, `return` in the
# other, and a match arm that takes then breaks. Nothing reads a moved name
# afterwards.
eats: function {s: String.take} out bool is {
    return s.length > 0
}
pick: function {which: u64} out u64 is {
    x: "abc".string
    y: "de".string
    n: 0.u64
    for while n < 5 loop {
        n = n + 1
        if n == which then {
            if (eats s: x) then print "x at \{n}"
            break
        } else if n == 4 then {
            if (eats s: y) then print "y at \{n}"
            return n
        }
    }
    return n
}
main: function is {
    print "\{pick which: 2}"
    print "\{pick which: 7}"
    z: "wxyz".string
    k: 0
    for while k < 5 loop {
        k = k + 1
        third: k == 3
        match (third) case true then {
            if (eats s: z) then print "z at \{k}"
            break
        } case false then print "no \{k}"
    }
    print "done"
}
