# f128_exponents.z -- scaleB and logB at f128, the two exponent operations,
# compiled by every compiler that has the type. gcc reaches libquadmath through
# quadmath.h; clang has no such header on its path, so the runtime declares
# each libquadmath function the f128 rows call, and a function the rows reach
# with no declaration is a C error only clang reports.
main: function is {
    x: 3.0.f128
    print "scaleB \{(x.scaleB n: 4).f64.orPanic} \{(x.scaleB n: (0 - 4)).f64.orPanic}"
    print "logB \{x.logB} \{(x.scaleB n: 100).logB} \{0.5.f128.logB}"
}
