# An iterator taken and never walked -- `split`, `lines`, `codepoints`, each
# dropped -- is a value of its own type: the program compiles, and a step no
# walk calls is not written.
main: function is {
    w: "a b".split sep: " "
    l: "x\ny".lines
    c: "hé".codepoints
    w.drop
    l.drop
    c.drop
    print "taken"
}
