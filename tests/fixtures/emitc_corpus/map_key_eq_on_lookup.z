# map_key_eq_on_lookup.z -- a Map's key `==` and `hash` are written where a
# member that looks a key up is: `seen` sets and gets its record keys, so pt's
# generated `==` and `hash` are written and called; `held` is a Map whose key
# type, slot, nothing ever looks up -- the holder is built and read beside it --
# so its C carries neither.
pt: record {
    x: i64
    y: i64
}

slot: record {
    row: i64
}

holder: class {
    held: (MapVV slot v: i64)
    count: i64
}

main: function is {
    seen: (MapVV pt v: i64)
    seen.set key: (pt x: 1 y: 2) value: 3
    print "\{(seen.get key: (pt x: 1 y: 2)).or d: 0}"
    h: holder held: (MapVV slot v: i64) count: 4
    print "\{h.count}"
}
