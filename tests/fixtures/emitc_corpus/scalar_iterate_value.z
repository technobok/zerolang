# A NUMERIC RANGE IS CALLABLE AS A VALUE, not only as a for-header.
#
# `iterate` / `each` on the ten integer types are Rule 3 generator functions --
# `{:this from: type} out (optionval type)`, re-invoked once per iteration --
# and a for-header is free to lower them to a counted loop instead, which
# emitIntRangeFor does, emitting no call at all. That left the VALUE form with
# no emitter: `v: 5.iterate from: 2` type-checks, mints its optionval mono, and
# then reported `unhandled callee` for a member the compiler supplies. Each of
# these has an EMPTY row in natives.tbl precisely to say the compiler supplies
# it, so an absent leg was the compiler not keeping its own word.
#
# One step of the range: the element at `from`, or `none` once it has ended.
# The for-header keeps its counted-loop lowering, which is what the loops below
# pin -- the same receiver, driven either way.

main: function is {
    # inside the range
    a: 5.iterate from: 2
    match (a) case some then print "in    \{a}" case none then print "in    none"

    # exactly at the end: the range is over
    b: 5.iterate from: 5
    match (b) case some then print "end   \{b}" case none then print "end   none"

    # `each` is the same shape
    c: 5.each from: 0
    match (c) case some then print "each  \{c}" case none then print "each  none"

    # a non-literal receiver and a non-literal `from`
    lim: 4.i64
    st: 1.i64
    d: lim.iterate from: st
    match (d) case some then print "vars  \{d}" case none then print "vars  none"

    # the for-header is unchanged: still a counted loop, with and without `from:`
    for x: 5.iterate loop { print "loop  \{x}" }
    for y: (5.iterate from: 3) loop { print "from  \{y}" }
}
