# A valtype parameter marked `.borrow` is a REFERENCE: a write through it
# reaches the caller. Passed by value the write was silently LOST -- the
# program printed the old value and exited 0, the same shape as the container
# and borrow-return defects before it.
#
# The MARKER is what asks for a reference. An unmarked valtype parameter is
# still a copy, which is why this change moves only declarations that opt in;
# `unmarked` below is the control for that, and `peek` is the control that a
# `.view` parameter is a reference the callee may only read.
pt: record {
    x: i64
    y: i64
}

bump: function {p: pt.borrow} is {
    p.x = 99
}

peek: function {p: pt.view} out i64 is {
    return p.x + p.y
}

unmarked: function {p: pt} is {
    p.x = 7
}

main: function is {
    a: pt x: 1 y: 2
    print "before=\{a.x}"
    bump p: a
    print "after=\{a.x}"
    print "peek=\{peek p: a}"
    unmarked p: a
    print "unmarked=\{a.x}"
}
