# A match arm swaps a FIELD of the narrowed payload out and falls through to
# the post-match cleanup: the union destroy frees the value the swap left in
# the field and the rest of the payload.
Pack: class {
    label: String
    weight: u64
}

Wrap: union {
    pack: Pack
    nothing: null
}

main: function is {
    w: Wrap.pack (Pack label: "cargo".string weight: 7)
    got: "".string
    match (
        w
    ) case pack then {
        got swap w.label
    } case nothing then {}
    print "got=\{got} len=\{got.length}"
}
