# A union's destructor, and a view option's, is written only where written C
# calls it. Iterating a List String yields view options, which own nothing and
# are never destroyed: their no-op destructor is not written. A union a
# variable owns is destroyed when the variable ends, so its destructor is
# written and frees the payload; a union the program never destroys has none.
Shape: union {
    named: String
    sides: i64
}

Hint: union {
    text: String
    none: null
}

describe: function {h: Hint.view} out String is {
    match (
        h
    ) case text then {
        return "hint".string
    } else null
    return "no hint".string
}

main: function is {
    names: List String
    names.append from: "a".string
    names.append from: "b".string
    for each n: names loop {
        print n
    }
    s: Shape.named "round".string
    match (
        s
    ) case named then {
        print "named \{s.stringView}"
    } case sides then {
        print "sides"
    }
    print (describe h: Hint.none)
}
