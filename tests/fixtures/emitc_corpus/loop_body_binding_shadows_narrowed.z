# loop_body_binding_shadows_narrowed -- A body-local binding shadows the narrowed outer
# name for the lines after it: the write to the body-local is not a write of the outer
# local, so the outer narrowing stands after the loop. A second, real write of another
# narrowed name sends the loop to the exact walk.
U: union {
    some: String
    none: null
}

shadowed: function {o: U.take p: U.take} is {
    if o.none then return
    if p.none then return
    k: 0
    for k < 2 loop {
        p = U.none
        o: U.none
        o = U.some "inner".string
        k = k + 1
    }
    n: o.length
    print "\{n}"
}

main: function is {
    shadowed o: (U.some "abc".string) p: (U.some "x".string)
}
