# typedef_exact_base_ok.z -- what a typedef IS constructed from: a value of its
# base type, a literal that fits it, a narrower number once converted to it,
# and a value of the typedef itself, taken unchanged.
pid: record {
    val: u32.typedef
}

main: function is {
    n: 5.u32
    a: pid n
    b: pid 6
    small: 7.u16
    c: pid.create from: small.u32
    d: pid.create from: a
    big: 9.u64
    e: pid (big.u32.or d: 0)
    print "\{a.u32} \{b.u32} \{c.u32} \{d.u32} \{e.u32}"
}
