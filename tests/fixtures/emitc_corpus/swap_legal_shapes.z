# EVERY SHAPE A SWAP MAY TAKE, each exchanging the two slots and leaving both
# valid: two locals, two owned strings, a variable with itself, two fields, a
# field two deep against a local, two fields of `this`, a field of a borrowed
# reftype parameter against a local, two whole unions, and a typedef against its
# underlying type from either side -- both keep their own types.
pt: record {
    x: i64
    y: i64
    flip: function {:this} is {
        this.x swap this.y
    }
}

inner: record {
    p: pt
}

Box: class {
    s: String
}

U: union {
    some: String
    none: null
}

meters: record { val: i64.typedef } as {}

Name: class { base: String.typedef } as {}

rename: function {bx: Box} is {
    t: "renamed".string
    bx.s swap t
}

main: function is {
    a: 1
    b: 2
    a swap b
    print "locals: \{a} \{b}"

    s: "x".string
    r: "y".string
    s swap r
    print "strings: \{s} \{r}"

    a swap a
    print "self: \{a}"

    p: pt x: 1 y: 2
    p.x swap p.y
    print "fields: \{p.x} \{p.y}"

    q: inner p: (pt x: 3 y: 4)
    k: 9
    q.p.x swap k
    print "deep: \{q.p.x} \{k}"

    p.flip
    print "this: \{p.x} \{p.y}"

    bx: Box s: "boxed".string
    rename :bx
    print "param field: \{bx.s}"

    o: U.some "held".string
    e: U.some "spare".string
    o swap e
    match (
        o
    ) case some then print "unions: \{o}" case none then print "unions: none"

    m: meters.create from: 42
    n: 7
    m swap n
    print "typedef left: \{m.i64} \{n}"
    n swap m
    print "typedef right: \{m.i64} \{n}"

    nm: Name.create from: "name".string
    w: "word".string
    nm swap w
    print "reftype typedef: \{w}"
}
