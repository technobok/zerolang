# EVERY SHAPE A SWAP MAY TAKE, each exchanging the two slots and leaving both
# valid: two locals, two owned strings, a variable with itself, two fields, a
# field two deep against a local, two fields of `this`, a field of a borrowed
# reftype parameter against a local, two whole unions, a typedef against its
# underlying type from either side -- both keep their own types -- and a heap
# collection (a Map, a Set), which every slot holds as a pointer, against a local
# and a field.
pt: record {
    x: i64
    y: i64
    flip: function {:this} is {
        this.x swap this.y
    }
}

inner: record {
    p: pt
}

Box: class {
    s: String
}

U: union {
    some: String
    none: null
}

meters: typedef i64

Name: typedef String

Bag: class {
    m: (MapVV k: i64 v: i64)
    s: (SetVal k: i64)
}

rename: function {bx: Box} is {
    t: "renamed".string
    bx.s swap t
}

main: function is {
    a: 1
    b: 2
    a swap b
    print "locals: \{a} \{b}"

    s: "x".string
    r: "y".string
    s swap r
    print "strings: \{s} \{r}"

    a swap a
    print "self: \{a}"

    p: pt x: 1 y: 2
    p.x swap p.y
    print "fields: \{p.x} \{p.y}"

    q: inner p: (pt x: 3 y: 4)
    k: 9
    q.p.x swap k
    print "deep: \{q.p.x} \{k}"

    p.flip
    print "this: \{p.x} \{p.y}"

    bx: Box s: "boxed".string
    rename :bx
    print "param field: \{bx.s}"

    o: U.some "held".string
    e: U.some "spare".string
    o swap e
    match (
        o
    ) case some then print "unions: \{o}" case none then print "unions: none"

    m: meters.create from: 42
    n: 7
    m swap n
    print "typedef left: \{m.i64} \{n}"
    n swap m
    print "typedef right: \{m.i64} \{n}"

    nm: Name.create from: "name".string
    w: "word".string
    nm swap w
    print "reftype typedef: \{w}"

    ma: MapVV k: i64 v: i64
    ma.set key: 1 value: 10
    mb: MapVV k: i64 v: i64
    ma swap mb
    print "maps: \{ma.length} \{mb.length}"

    bag: Bag m: (MapVV k: i64 v: i64) s: (SetVal k: i64)
    bag.s.add item: 5
    bag.s.add item: 6
    sv: SetVal k: i64
    sv swap bag.s
    print "set field: \{sv.length} \{bag.s.length}"
    mb swap bag.m
    print "map field: \{mb.length} \{bag.m.length}"
}
