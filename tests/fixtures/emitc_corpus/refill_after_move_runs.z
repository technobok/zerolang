# The twins of errors/refill_after_move_keeps_locks: a refilled local holds the
# new value's locks and none of the old one's, so the OLD source is written
# freely while the local is read after.
LfBox: class {
    name: StringView
}

lfFlag: function out bool is {
    return false
}

refillConstruction: function is {
    s: "abc".string
    t: "ttt".string
    w: LfBox name: s.stringView
    w.drop
    w = LfBox name: t.stringView
    s = "zzzzzzzzzzzzzzzz".string
    print "\{w.name} \{s}"
}

refillView: function is {
    s: "abc".string
    t: "ttt".string
    w: s.stringView
    w.drop
    w = t.stringView
    s = "zzzzzzzzzzzzzzzz".string
    print "\{w} \{s}"
}

refillInEveryArm: function is {
    s: "abc".string
    t: "ttt".string
    w: LfBox name: s.stringView
    k: lfFlag
    if k then {
        w.drop
        w = LfBox name: t.stringView
    } else {
        w.drop
        w = LfBox name: t.stringView
    }
    s = "zzzzzzzzzzzzzzzz".string
    print "\{w.name} \{s}"
}

main: function is {
    refillConstruction
    refillView
    refillInEveryArm
}
