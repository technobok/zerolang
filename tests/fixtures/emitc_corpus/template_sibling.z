# template_sibling.z -- a template body resolves LEXICALLY: it sees the
# siblings of the unit it is WRITTEN in (SCALE, bump) whichever unit
# instantiates it, and a cross-unit template sees ITS unit's siblings
# (tmpl_sibling_provider.OFFSET), not the instantiating unit's.
SCALE: 3

bump: function {n: i64} out i64 is {
    return n + 1
}

scaler: unit as {
    t: anyval.generic
    apply: function {v: t} out t is { return v * SCALE }
    tag: function out i64 is { return (bump 41) }
}

isc: (scaler t: i64)
xsc: (tmpl_sibling_provider.shifter t: i64)

main: function is {
    print "apply=\{isc.apply 5} tag=\{isc.tag}"
    print "shift=\{xsc.shift 5}"
}
