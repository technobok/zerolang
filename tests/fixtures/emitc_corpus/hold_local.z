# `hold` binds the owned, readonly cell: the source moves in and the binding is
# frozen. Reads and reader methods work; the value is destroyed at scope exit,
# so this is leak-clean and the source is never freed twice.
Item: class {
    name: String
    value: i64
} as {
    label: function {t: this.view} out String is {
        return t.name.copy
    }
}
main: function is {
    x: "abcdef".string
    h: x.hold
    print "h=\{h} len=\{h.length}"

    e: Item name: "width".string value: 12
    f: e.hold
    print "f=\{f.label}=\{f.value}"
}
