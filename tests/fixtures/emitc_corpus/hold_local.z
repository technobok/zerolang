# `hold` binds the owned, readonly cell: the source moves in and the binding is
# frozen. Reads and reader methods work, for a valtype as for a reftype; the
# value is destroyed at scope exit, so this is leak-clean and the source is
# never freed twice.
Item: class {
    name: String
    value: i64
} as {
    label: function {t: this.view} out String is {
        return t.name.copy
    }
}

point: record { x: i64 y: i64 } as {
    sum: function {t: this.view} out i64 is {
        return t.x + t.y
    }
}

main: function is {
    x: "abcdef".string
    h: x.hold
    print "h=\{h} len=\{h.length}"

    e: Item name: "width".string value: 12
    f: e.hold
    print "f=\{f.label}=\{f.value}"

    p: point x: 3 y: 4
    q: p.hold
    print "q=\{q.x},\{q.y} sum=\{q.sum}"
}
