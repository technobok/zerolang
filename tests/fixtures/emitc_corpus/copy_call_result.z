# PARENTHESES FORCE THE CALL. A marker after a callable path applies to the path
# itself -- `mk.copy` is another reference to `mk` -- but a path written in
# parentheses of its own is called first, and the marker applies to what the
# call returns: `(mk).copy` is a copy of a fresh list. A method read through an
# INSTANCE has no reference form, so it is called with or without the
# parentheses: `p.name.copy` and `(p.name).copy` both copy the name.
mk: function out ListVal i64 is {
    r: ListVal i64
    r.append 1
    return r
}

seven: function out i64 is {
    return 7
}

Person: class {
    first: String
} as {
    name: function {:this} out String is {
        return this.first.copy
    }
}

main: function is {
    c: (mk).copy
    c.append 2
    fresh: mk
    d: (seven).copy
    print "\{c.length} \{fresh.length} \{d}"
    p: Person first: "Ada".string
    n1: p.name.copy
    n2: (p.name).copy
    n1.append "!"
    print "\{n1} \{n2} \{p.first}"
}
