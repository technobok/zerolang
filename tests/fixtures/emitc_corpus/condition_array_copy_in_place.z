# A condition evaluated in place -- a `when` conjunct, a loop's later `while`
# -- holds only an expression. A list copied into an array (`primes.array`) is
# one: a call of the list's copy, `_zag<row>_array()`, written beside the list,
# so it is read anew each time the condition is tested, in ISO C17.
#
# It was a declaration and a loop ahead of the read, which inside such a
# condition took a GNU statement expression: -Wpedantic refused it, and MSVC
# did not compile it.
primes: list { 2 3 5 }

second: function {a: (array i64 to: 3)} out i64 is {
    return (a.get i: 1)
}

main: function is {
    open: true
    if open when (second a: primes.array) == 3 then print "when"
    i: 0
    for while i < 4 while (second a: primes.array) == 3 loop i = i + 1
    print "\{i}"
}
