# A condition evaluated in place -- a `when` conjunct, a loop's later `while`
# -- may need a temporary no C expression can hold: a list copied into an
# array (`primes.array`) is a declaration and a loop. It runs inside a
# statement expression where the condition is tested, each time it is tested
# (the emitter's wrapInPlace).
primes: list { 2 3 5 }

second: function {a: (array i64 to: 3)} out i64 is {
    return (a.get i: 1)
}

main: function is {
    open: true
    if open when (second a: primes.array) == 3 then print "when"
    i: 0
    for while i < 4 while (second a: primes.array) == 3 loop i = i + 1
    print "\{i}"
}
