# A generic type is constructed with its type arguments inferred from values
# whose types APPLY its parameters, as a generic function's call already was:
# a written create's `v: (ListVal t: t)`, a field `(ListVal t: t)`, `(array t: t
# to: 2)`, a user generic's `(slot t: t)`, and a map field over two params. Only
# a row typed as a bare parameter inferred; each of these was "cannot infer type
# arguments", and needed its `t:` written.
Head: record {
    a: t
    n: u64
} as {
    t: anyval.generic
    create: function {v: (ListVal t: t)} out this is {
        return (meta.create a: (v.get i: 0) n: v.length)
    }
}

Bag: class {
    items: (ListVal t: t)
} as {
    t: anyval.generic
}

slot: record {
    v: t
} as {
    t: anyval.generic
}

wrap: record {
    c: (slot t: t)
} as {
    t: anyval.generic
}

pair: record {
    xs: (array t: t to: 2)
} as {
    t: anyval.generic
}

Index: class {
    m: (MapVV k: k v: v)
} as {
    k: anyval.generic
    v: anyval.generic
}

main: function is {
    l: ListVal u64
    l.append 11
    l.append 12
    h: Head v: l
    print "head \{h.a} \{h.n}"
    g: Bag items: l.take
    print "bag \{g.items.length}"
    w: wrap c: (slot v: 5.u8)
    print "wrap \{w.c.v}"
    a: array t: i32 to: 2
    p: pair xs: a
    print "array \{p.xs.length}"
    mm: MapVV k: u8 v: i32
    mm.set key: 1 value: 2
    ix: Index m: mm.take
    print "index \{ix.m.length}"
}
