# demand_public_rename.z -- reach a demand-gated unit's definition through the
# name its public interface RENAMES it to. The demand is recorded on `perimeter`;
# the definition that must resolve is `cli.perimImpl`, which nothing names.
# Before the public block's Decl edges were consulted, resolveDemandedUnitBody
# tested each member against its OWN name only, so `perimImpl` never resolved
# and the call reported an unknown member.
main: function is {
    p: cli.perimeter w: 3 h: 4
    print "perim=\{p}"
}
