# array_view_window.z -- an array's storage is inline, so reading it through a
# view -- a `this.view` receiver's field, a `.view` parameter -- holds it const
# in C. The readonly windows it lends there, `listView` and `slice`, take the
# storage without the qualifier: the C was rejected for discarding it.

# sumAll -- the words of x added up
sumAll: function {x: (ListViewVal u64).view} out u64 is {
    s: u64
    for each w: x loop s = s + w
    return s
}

# three words
v3: record {
    words: (array t: u64 to: 3)
} as {
    # every word added up, through the whole window
    total: function {s: this.view} out u64 is {
        return (sumAll x: s.words.listView)
    }
    # the first two added up, through a slice
    head: function {s: this.view} out u64 is {
        return (sumAll x: (s.words.slice from: 0 to: 2))
    }
}

# lastTwo -- the last two words of a viewed array added up
lastTwo: function {a: (array t: u64 to: 3).view} out u64 is {
    return (sumAll x: (a.slice from: 1 to: 3)) + (sumAll x: a.listView) - (sumAll x: a.listView)
}

main: function is {
    a: array t: u64 to: 3
    a.set i: 0 item: 4
    a.set i: 1 item: 5
    a.set i: 2 item: 6
    v: v3 words: a
    print "\{v.total} \{v.head} \{lastTwo :a}"
}
