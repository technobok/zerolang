# A match on a name a guard already narrowed reads the ARM's payload: after
# `if a.none then return` -- or inside `if a.some then` -- `a` is the option's
# payload, and inside `case n` it is that arm's payload in turn, not the
# option's payload read again.
shape: variant {
    n: i64
    w: u64
}

pick: function {k: i64} out optionval shape is {
    if k < 0 then return (optionval.none shape)
    if k == 0 then return (optionval.some (shape.w 7))
    return (optionval.some (shape.n k))
}

afterGuard: function {k: i64} out i64 is {
    a: pick :k
    if a.none then return 0 - 1
    match (
        a
    ) case n then {
        return a + 100
    } case w then {
        return a.i64.orPanic + 200
    }
}

insideIf: function {k: i64} out i64 is {
    a: pick :k
    r: 0 - 1
    if a.some then {
        match (
            a
        ) case n then {
            r = a + 300
        } case w then {
            r = a.i64.orPanic + 400
        }
    }
    return r
}

main: function is {
    print "\{afterGuard k: 0 - 1} \{afterGuard k: 0} \{afterGuard k: 5}"
    print "\{insideIf k: 0 - 1} \{insideIf k: 0} \{insideIf k: 5}"
}
