# typedef_sized_base.z -- a typedef over a sized native, a str or an array
# instance, shares that instance's struct and members, and a typedef over a str
# is a Text through its base's `:Text`, boxed with the str's own spelling of
# `stringView`.
# The emitter read a sized native as a scalar and panicked ("unresolvable
# typedef base str"); the inherited conformance looked only for a row on the
# instance, where str's is on its template; and the vtable slot named a C
# function the runtime does not have.
Label8: typedef (str to: 8)
Trio: typedef (array t: i64 to: 3)
show: function {s: Text} out u64 is {
    return s.stringView.length
}
main: function is {
    l: Label8
    print "label \{show s: l} \{l.size} \{l.length}"
    a: Trio
    print "trio \{a.length} \{a.get i: 0}"
}
