# A DATA ELEMENT AND A DATA BLOCK'S LENGTH ARE CONSTANTS at unit level, as they
# are in a body. The dotted definition was read as a construction ("a unit-level
# constant takes a literal value, not a construction"), an operator over an
# element had no value, and another unit's element reached the emitter.
primes: data { 2 3 5 7 }
codes: data {
    ht: 9
    lf: 10
} out u8
ONE: primes.1
HT: codes.ht
COUNT: primes.length
NEXT: primes.0 + 1
DOUBLE: (codes.ht) * 2
FIRST: if primes.0 == 2 then { 1 } else { 0 }
OTHER: data_consts.codes.space
OTHERCOUNT: data_consts.codes.length + 1

main: function is {
    print "\{ONE} \{HT} \{COUNT} \{NEXT} \{DOUBLE} \{FIRST} \{OTHER} \{OTHERCOUNT}"
    b: 9.u8
    if b == HT then print "tab" else print "other"
}
