# A GENERIC FUNCTION MAY RETURN AN INSTANCE OVER ITS OWN PARAMETERS. The
# declared `out (ListVal t: t)` is recorded as the partial it is, and each call
# takes the instance its own arguments specialise it to -- bound, passed on,
# interpolated, matched. A unit's function does the same over the unit's
# parameter. The call used to have no type at all: the binding was E0500, and
# the instance was emitted as a `void` function returning a value.
Cell: record {
    val: t
} as { t: anyval.generic }

Duo: record {
    a: x
    b: y
} as {
    x: anyval.generic
    y: anyval.generic
}

mk: function as { t: anyval.generic } in { a: t } out (ListVal t: t) is {
    l: (ListVal t: t)
    l.append from: a
    return l
}

grow: function as { t: anyval.generic } in { l: (ListVal t: t).take a: t } out (ListVal t: t) is {
    l.append from: a
    return l
}

boxed: function as { t: anyval.generic } in { a: t } out (optionval t: t) is {
    return (optionval.some a)
}

wrapped: function as { t: anyval.generic } in { a: t } out (Cell t: t) is {
    return (Cell t: t val: a)
}

duo: function as { x: anyval.generic y: anyval.generic } in { p: x q: y } out (Duo x: x y: y) is {
    return (Duo x: x y: y a: p b: q)
}

cells: function as { t: anyval.generic } in { a: t } out (ListVal t: (Cell t: t)) is {
    l: (ListVal t: (Cell t: t))
    l.append from: (Cell t: t val: a)
    return l
}

pair: function as { t: anyval.generic } in { a: t } out (array t: t to: 2) is {
    r: (array t: t to: 2)
    r.set i: 0 item: a
    r.set i: 1 item: a
    return r
}

names: function as { T: AnyRef.generic } in { a: T.take } out (List T: T) is {
    l: List T: T
    l.append from: a
    return l
}

show: function {c: (Cell t: i64)} out i64 is {
    return c.val
}

lists: unit as {
    t: anyval.generic
    one: function {a: t} out (ListVal t: t) is {
        l: (ListVal t: t)
        l.append from: a
        return l
    }
}

li: (lists t: i64)

main: function is {
    l: mk t: i64 a: 4
    m: mk a: 2.5
    print "\{l.length} \{m.get i: 0} \{(mk t: u8 a: 1).length}"
    x: (ListVal t: i64)
    g: grow t: i64 l: x a: 4
    print "\{g.length}"
    b: boxed a: 7
    if b.some then print "some \{b}" else print "none"
    c: wrapped t: i64 a: 4
    print "\{c.val} \{show c: (wrapped t: i64 a: 12)}"
    d: duo p: 3 q: true
    print "\{d.a} \{d.b}"
    cs: cells t: i64 a: 9
    print "\{cs.length} \{(cs.get i: 0).val}"
    r: pair t: i64 a: 6
    print "\{r.length} \{r.get i: 1}"
    n: names T: String a: "x".string
    o: names a: "y".string
    print "\{n.length} \{o.get i: 0}"
    u: li.one a: 5
    print "\{u.length} \{u.get i: 0}"
}
