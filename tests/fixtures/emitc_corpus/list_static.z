# A `list` is a static list: its elements are built once into static storage,
# and the list's type is `staticlist T`. Every element type a list holds walks with
# the one static iterator -- numbers and strings alike -- and a list passes to
# a parameter of its type as a value.
nid: typedef u32

codes: list { ht: 9 lf: 10 } out staticlist u8
primes: list { 2 3 5 7 }
halves: list { 0.5 0.25 }
words: list { first: "alpha" second: "beta" }
keyed: list { a: 7 b: 8 } out (staticlist u8 i: nid)
names: list { "x" "yz" } out (staticlist StringView i: nid)
none: list {} out staticlist u16
sides: list { left: 0 right: 1 } out staticlist u8
side: variant { left: null right: null } as { tag: sides.tag }

# every element of a list of bytes, summed
total: function {d: staticlist u8} out u64 is {
    r: 0.u64
    for each c: d loop r = r + c
    return r
}

# the strings of a list, joined by spaces: an untyped list of strings is a
# `staticlist text`, and text reaches a String through its view
joined: function {d: staticlist text} out String is {
    r: String
    for each s: d loop {
        if r.length > 0 then r.append " "
        r.append s.stringView
    }
    return r
}

# the element of a nid-indexed list at `k`
pick: function {d: (staticlist u8 i: nid) k: nid} out u8 is {
    return (d.get i: k)
}

main: function is {
    print "\{codes.ht} \{codes.lf} \{codes.length} \{primes.2} \{halves.1}"
    print "\{words.first} \{words.second} \{keyed.slot.b} \{none.length}"
    print "\{total d: codes} \{joined d: words} \{pick d: keyed k: keyed.slot.b}"
    for each p: primes loop print "prime \{p}"
    for each h: halves loop print "half \{h}"
    print "\{names.get i: (nid 1)}"
    i: 3
    print "\{primes.get i: i.u64.orPanic}"
    s: side.right
    if s then print "side right is truthy" else print "side right is falsy"
}
