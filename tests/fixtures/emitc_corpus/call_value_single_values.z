# The call shapes whose value was already read once: a call with arguments
# returning String, a String method, an appended String call, a bound call and
# a receiver call. Each callee announces itself once per run.
sv: function out StringView is {
    print "[sv]"
    return "x"
}

mk2: function {n: i64} out String is {
    print "[mk2 \{n}]"
    return "n".string
}

mk: function out String is {
    print "[mk]"
    return "m".string
}

Obj: class {
    tag: String
} as {
    describe: function {t: this.view} out String is {
        print "[describe]"
        return t.tag.copy
    }
}

main: function is {
    print "\{mk2 n: 1}"
    o: Obj tag: "t".string
    print "\{o.describe}"
    b: "".string
    b.append mk
    v: sv
    n: sv.count
    s: sv.startsWith "x"
    print "\{b} \{v} \{n} \{s}"
    print (mk2 n: 2)
}
