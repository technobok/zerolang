# A loop's binding shadows its name in everything the loop runs after it --
# its body, its later conditions and its postconditions -- so a write there to
# the loop's own `x` is no write to an outer `x`, whose narrowing stands.
post: function out String is {
    x: optionval.some 5
    if x.none then return "none".string
    k: 0
    for x: (optionval.some k) loop {
        k = k + 1
    } while ({
        x = x + 1
        k < 3
    })
    return "\{x + 1} \{k}"
}

cond: function out String is {
    x: optionval.some 5
    if x.none then return "none".string
    k: 0
    for x: (optionval.some k) while ({
        x = x + 1
        x < 3
    }) loop {
        k = k + 1
    }
    return "\{x + 1} \{k}"
}

main: function is {
    print post
    print cond
}
