# arm_string_payload_take.z -- `.take` of a String payload out of a matched
# union arm. The String runtime has no `_destroy`, so the moved-out local must
# ride the scope's String free list; composing a `<cname>_destroy` call emitted
# a C function that was never declared.
Err: class {
    code: u32
}

Res: union {
    ok: String
    err: Err
}

readIt: function {good: bool} out Res is {
    if good then return (Res.ok "text".string)
    e: Err code: 1
    return (Res.err e.take)
}

main: function is {
    r: readIt good: true
    match (
        r
    ) case ok then {
        s: r.take
        print "got=\{s}"
    } case err then {
        print "err"
    }
    bad: readIt good: false
    match (
        bad
    ) case ok then {
        print "unexpected"
    } case err then {
        print "code=\{bad.code}"
    }
}
