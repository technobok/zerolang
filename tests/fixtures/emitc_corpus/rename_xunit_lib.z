# rename_xunit_lib.z -- the unit rename_xunit reads its renamed members from:
# a field, a function field, methods, union arms, a generic class's field and
# method, and a unit-level function, each exposed under a public name that is
# not its own.
public: unit { :Holder  :Shape  :Bx  :make  :mkShape  :mkBox  greet: greetImpl }

Holder: class {
    nm: String
    cnt: i64
    cb: function {x: i64} out i64
} as {
    public: unit { name: nm  count: cnt  fn: cb  label: labelImpl  add: addImpl  :create }
    labelImpl: function {t: this.view} outx String.view is {
        return t.nm
    }
    addImpl: function {t: this.view delta: i64} out i64 is {
        return t.cnt + delta
    }
}

Shape: union {
    circleArm: String
    boxArm: i64
} as {
    public: unit { circle: circleArm  box: boxArm }
}

Bx: class {
    v: t
} as {
    t: anyval.generic
    public: unit { value: v  get: getImpl  :create }
    getImpl: function {t: this.view} out t is {
        return t.v
    }
}

dbl: function {x: i64} out i64 is {
    return x * 2
}

make: function out Holder is {
    return (Holder nm: "hello".string cnt: 3 cb: dbl.copy)
}

mkShape: function out Shape is {
    return (Shape.circle "round".string)
}

mkBox: function out (Bx t: i64) is {
    return ((Bx t: i64) v: 41)
}

greetImpl: function out i64 is {
    return 7
}
