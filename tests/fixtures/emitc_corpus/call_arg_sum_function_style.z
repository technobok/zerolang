# THE CALL FORM DOES NOT DEPEND ON THE RECEIVER'S FAMILY. A function-style call
# on a variant or a union reaches the same declared method a record or a class
# does, so the unlabelled argument is the receiver there too and the remaining
# labels bind by name. The two families differ in how the receiver is CARRIED --
# a variant is its own discriminator, a union is a tagged struct -- and neither
# difference reaches the call site.
colour: variant {
    red: null
    blue: null
    green: null
} as {
    pick: function {:this a: i64 b: i64} out i64 is {
        if this.red then return a
        return b
    }
}

Shape: union {
    dot: null
    len: (Box i64)
} as {
    pick: function {:this a: i64 b: i64} out i64 is {
        if this.dot then return a
        return b
    }
}

main: function is {
    r: colour.red
    g: colour.green
    v1: colour.pick r a: 10 b: 3
    v2: colour.pick r b: 3 a: 10
    v3: colour.pick g a: 10 b: 3
    print "variant \{v1} \{v2} \{v3}"

    d: Shape.dot
    u1: Shape.pick d a: 10 b: 3
    u2: Shape.pick d b: 3 a: 10
    print "union \{u1} \{u2}"
}
