# with_do_break_hidden.z -- a `break` inside a `with ... do` block leaves that
# block, even when it sits in a binding's value. It never leaves the loop
# around the block, so each loop runs to 3 and skips only the rest of the
# block at 2. (An `if` that leaves is refused in every other expression
# position, so a binding's value is the one place a break hides.)

inBinding: function is {
    n: 0
    for n < 3 loop {
        n = n + 1
        with z: n do {
            v: if z == 2 then break else z * 10
            print "binding \{v}"
        }
        print "after \{n}"
    }
}

inElseIf: function is {
    n: 0
    for n < 3 loop {
        n = n + 1
        with z: n do {
            v: if z == 1 then 100 else if z == 2 then break else 300
            print "else-if \{v}"
        }
        print "after \{n}"
    }
}

main: function is {
    inBinding
    inElseIf
}
