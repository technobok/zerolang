# os_unicode_text.z -- text beyond ASCII crosses every boundary with the system
# unchanged: printed lines, the arguments (one holding a space), and a file name
# created, listed, read and removed. On Windows each crossing converts between
# UTF-8 and UTF-16; on a console the lines go through WriteConsoleW.

main: function is {
    print "Grüße · αβγ · привет · ✓"
    args: os.args
    i: 1.u64
    for i < args.length loop {
        print "arg \{i}: \{args.get i: i}"
        i = i + 1
    }
    tmp: os.tempDir
    name: "zünï_日本_\{os.pid}.txt"
    f: path.join a: tmp.stringView b: name.stringView
    wr: io.writeText path: f.stringView content: "Grüße"
    print "write: \{wr.ok}"
    found: false
    ls: io.listDir path: tmp.stringView
    if ls.ok then {
        for each e: ls loop {
            if e.stringView == name.stringView then found = true
        }
    }
    print "listed: \{found}"
    rd: io.readText path: f.stringView
    match (
        rd
    ) case ok then {
        print "read: \{rd}"
    } case err then {
        print "read failed"
    }
    rm: io.remove path: f.stringView
    print "remove: \{rm.ok}"
}
