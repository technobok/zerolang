# A type argument names a type; it constructs nothing. Written beside a
# construction's fields -- `(pair t: row first: ..)` -- it was walked as the
# value `row`, which is the zero-argument construction of a record whose
# fields are required, and refused as one. Only a user template built with
# its fields in the same call took that walk; a built-in container and a
# parenthesised type application did not, and still do not.

row: record {
    a: i64
    b: i64
}

pair: record {
    first: t
    second: t
} as {
    t: anyval.generic
}

Box: class {
    val: t
} as {
    t: anyval.generic
}

main: function is {
    # a record template, a class template, and one nested in another
    p: pair t: row first: (row a: 1 b: 2) second: (row a: 3 b: 4)
    b: Box t: row val: (row a: 5 b: 6)
    nest: (pair
        t: (pair t: row)
        first: (pair t: row first: (row a: 7 b: 8) second: (row a: 9 b: 10))
        second: (pair t: row first: (row a: 11 b: 12) second: (row a: 13 b: 14))
    )
    print "\{p.second.b} \{b.val.a} \{nest.second.first.b}"
    # the forms that already walked it as a type
    l: ListVal row
    l.append from: (row a: 15 b: 16)
    q: (pair t: row) first: (row a: 17 b: 18) second: (row a: 19 b: 20)
    print "\{l.length} \{q.first.b}"
}
