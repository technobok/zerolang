# native_text_box.z -- the system's own Text conformers, a String and a str,
# boxed as a Text: handed to a Text parameter, projected with
# `Text.create from:`, and boxed from inside a method body as well as from a
# free function. Their helpers are written on demand, since the runtime
# supplies the structs and no unit pass visits them.

measure: function {t: Text} out u64 is { return t.stringView.length }

Counter: class { seen: u64 } as {
    add: function {:this s: String} is {
        this.seen = this.seen + (measure t: s)
    }
}

main: function is {
    s: "abc".string
    g: "hello".str to: 32
    print "\{measure t: s} \{measure t: g}"
    c: Counter seen: 0
    c.add s: "four".string
    c.add s: "fives".string
    print "\{c.seen}"
    o: Text.create from: s
    print "\{o.stringView}"
}
