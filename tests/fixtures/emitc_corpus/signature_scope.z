# signature_scope.z -- a function's parameters are in scope in its own
# signature. A parameter typed by the type it is named after is the `:nodeid`
# shorthand; a type that shares a parameter's name is reached through its unit
# (`out system.u8`); a named receiver (`t: this.view`) and the `:this` receiver
# read the type the method belongs to.
nodeid: record { v: u32 }

f: function {u8: i64} out system.u8 is { return (u8.u8.or d: 0) }

g: function {:nodeid} out u32 is { return nodeid.v }

Counter: class { n: i64 } as {
    peek: function {t: this.view} out i64 is { return t.n }
    bump: function {:this} is { this.n = this.n + 1 }
}

main: function is {
    c: Counter n: 1
    c.bump
    print "\{f u8: 7} \{g nodeid: (nodeid v: 3)} \{c.peek}"
}
