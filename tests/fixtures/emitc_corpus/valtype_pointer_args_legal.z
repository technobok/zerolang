# A valtype argument locks only where it goes by pointer. A copy (an unmarked
# parameter) never aliases, two `.view`s are both shared, and sibling fields
# are different values.
point: record { x: i64 }
pair: record { l: point r: point }

twoB: function {a: point.borrow b: point.borrow} is {
    a.x = a.x + 1
    b.x = b.x * 10
}
bc: function {a: point.borrow b: point} out i64 is {
    a.x = 100
    return b.x
}
twoPV: function {a: point.view b: point.view} out i64 is { return a.x + b.x }

main: function is {
    q: point x: 1
    # the copy is taken before the call writes through the borrow
    print "\{bc a: q b: q} \{q.x}"
    print "\{twoPV a: q b: q}"
    p: pair l: (point x: 1) r: (point x: 2)
    twoB a: p.l b: p.r
    print "\{p.l.x} \{p.r.x}"
}
