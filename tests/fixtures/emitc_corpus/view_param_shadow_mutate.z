# a block-local `s` shadowing a `.view` parameter `s` is a different binding:
# mutating the local is not a write through the readonly parameter. The lock
# rows are keyed by the binding, so the parameter's readonly self-lock never
# reaches the local that shadows it.
count: function {s: String.view} out u64 is {
    {
        s: "abc".string
        s.append "d"
        return s.length
    }
}
main: function is {
    v: "xy".string
    print "\{count s: v}"
}
