# A native `create` takes its first argument unlabelled as it takes it
# labelled. The unlabelled form used to pass the check and reach the C with
# the argument dropped: the emitter found a native create's arguments by their
# labels alone.

main: function is {
    w: io.BufWriter.create io.stdout capacity: 64
    lw: io.BufWriter.create to: io.stdout capacity: 64
    a: w.write from: "positional\n".byteView
    b: lw.write from: "labelled\n".byteView
    fa: w.flush
    fb: lw.flush
    print "done"
}
