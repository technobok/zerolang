# alias_locks_end_apart.z -- two aliases of one list lock it separately, and each
# lock ends with its own holder: dropping one leaves the list locked by the
# other, and once both are gone, dropped or out of scope, the list is its
# owner's to change again.
main: function is {
    xs: List String
    xs.append from: "a".string
    m: xs
    k: xs
    print "\{m.length} \{k.length}"
    m.drop
    k.drop
    xs.append from: "b".string
    n: xs
    {
        j: xs
        print "\{j.length} \{n.length}"
    }
    n.drop
    xs.append from: "c".string
    print "\{xs.length}"
}
