# alias_locks_end_apart.z -- an alias of a list locks it for as long as the
# alias lives, and the lock ends with its holder: once the alias is dropped or
# out of scope, the list is its owner's to change, or to alias, again. Two
# aliases at once are refused (errors/second_alias_keeps_lock).
main: function is {
    xs: List String
    xs.append from: "a".string
    m: xs
    print "\{m.length}"
    m.drop
    k: xs
    print "\{k.length}"
    k.drop
    xs.append from: "b".string
    {
        j: xs
        print "\{j.length}"
    }
    n: xs
    print "\{n.length}"
    n.drop
    xs.append from: "c".string
    print "\{xs.length}"
}
