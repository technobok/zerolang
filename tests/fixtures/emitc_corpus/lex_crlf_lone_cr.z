# A file with CRLF line ends compiles as one with LF. A newline inside a
# string literal is LF whatever the file uses -- the CRLF here once reached
# the C string raw and broke it. A CR that no LF follows is whitespace: only
# a linefeed ends a line, so the binding below is `x: 1`, one line.
main: function is {
    x:1
    s: "
        two
        lines
    "
    print "\{x}"
    print s
    print "\{s.length}"
}
