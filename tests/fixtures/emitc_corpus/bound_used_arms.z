# A sum's DEFINITION does not use every arm. Used as a generic bound, it is
# checked against the arms the instance's argument can be, and only those are
# resolved: an f64 instance of `wide` never demands f128, so the program does
# not reach quadfloat, links no libquadmath, and builds under tcc. Checking the
# bound resolved the whole sum, every arm, and tcc refused the program.
# (bound_used_arms_f128: an f128 instance reaches it; bound_runtime_all_arms:
# a run-time value of the sum uses every arm.)
wide: variant { :f64  :f128 }

twice: function as { t: wide.generic } in {x: t} out t is {
    return x + x
}

main: function is {
    print "\{twice x: 1.5}"
}
