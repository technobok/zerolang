# qualified_subunit_type.z -- `sub.T` in a DECLARATION position, where `sub` is
# a hidden subunit. A nested unit has no unit-name index entry, so the qualified
# type ref reached no resolver: it was recorded as nothing (return position) or
# peeled to the unit itself (parameter position), and the slot typed as null.
main: function is {
    r: xunit_qualsub.asReturn
    print "return=\{r.n} param=\{xunit_qualsub.asParam v: r} field=\{xunit_qualsub.asField}"
}
