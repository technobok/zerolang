# string_param_default.z -- a parameter defaulted to a string literal: the
# default is a StringView of static program memory, a compile-time constant like
# a number, so it types the parameter StringView and is re-emitted at each call
# that leaves it out as the literal's `_zcsN`.
opt: function {msg: "hi"} is {
    print msg
}

main: function is {
    opt
    opt msg: "there"
}
