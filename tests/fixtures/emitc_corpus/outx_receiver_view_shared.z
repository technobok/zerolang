# A `{t: this.view}` receiver is a `.view` input: the result pins it SHARED,
# so the caller keeps reading the receiver -- fields and view methods alike --
# beside the result. The `.view` argument the result stores is pinned SHARED
# the same way. Every pin dies with the result.
Src: class {
    n: i64
}

W: class {
    s: Src.view
    tag: i64
    label: String
}

Fac: class {
    other: i64
} as {
    mk: function {t: this.view src: Src.view} outx W is {
        return (W s: src tag: t.other label: "owned".string)
    }
    peek: function {t: this.view} out i64 is {
        return t.other
    }
}

main: function is {
    f: Fac other: 5
    x: Src n: 1
    {
        w: f.mk src: x
        print "reads: \{f.other} \{f.peek} \{x.n} \{w.s.n} \{w.tag} \{w.label}"
    }
    f.other = 7
    x.n = 9
    print "after: \{f.other} \{x.n}"
}
