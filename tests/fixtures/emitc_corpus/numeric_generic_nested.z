# A TEMPLATE INSTANTIATES OVER ITS OWN NUMERIC GENERIC PARAMETER, per instance:
# a body's `array t: i64 to: cap` (and `to: cap * 2`, `to: n + 1`, `str to:
# cap`), a field typed `(array t: i64 to: cap)`, and a parameter or return type
# over the parameter, in a class, a record, a generic function and a generic
# unit. A body construction was "'cap' has no compile-time value", a field or
# parameter type minted `array_i64_0` or "Unknown reference 'cap'", and a unit
# function's parameter type was never completed.
Buffer: class {
    used: u32
    slots: (array t: i64 to: cap)
    fill: function {:this} out i64 is {
        a: array t: i64 to: cap
        prev: a.set i: 0 item: 5
        again: a.set i: 0 item: 6
        b: array t: i64 to: cap * 2
        c: b
        return again + prev + a.1 + c.1
    }
    sizes: function {:this} out u64 is {
        a: array t: i64 to: cap
        b: array t: i64 to: cap + 1
        return a.length + b.length
    }
    count: function {:this a: (array t: i64 to: cap)} out u64 is {
        return a.length
    }
    make: function {:this} out (array t: i64 to: cap) is {
        return (array t: i64 to: cap)
    }
} as { cap: u32.generic }

Grid: record {
    rows: (array t: i64 to: cap)
    x: i64
} as { cap: u32.generic }

grow: function as { n: u64.generic } in { v: i64 } out u64 is {
    a: array t: i64 to: n + 1
    return a.length
}

sum: function as { n: u64.generic } in { a: (array t: i64 to: n) } out u64 is {
    return a.length
}

sized: unit as {
    cap: u64.generic
    width: function {} out u64 is {
        s: str to: cap
        return s.size
    }
    count: function {s: (str to: cap)} out u64 is {
        return s.size
    }
}

four: (sized cap: 4)
nine: (sized cap: 9)

main: function is {
    s4: array t: i64 to: 4
    x: (Buffer cap: 4) used: 0 slots: s4
    s2: array t: i64 to: 2
    y: (Buffer cap: 2) used: 0 slots: s2
    print "\{x.fill} \{x.sizes} \{y.sizes} \{x.slots.length} \{y.slots.length}"
    print "\{x.count a: s4} \{y.count a: s2}"
    m: x.make
    print "\{m.length}"
    r: array t: i64 to: 2
    g: (Grid cap: 2) rows: r x: 1
    print "\{g.rows.length}"
    a3: array t: i64 to: 3
    print "\{grow n: 3 v: 4} \{grow n: 5 v: 4} \{sum n: 3 a: a3}"
    t4: str to: 4
    print "\{four.width} \{nine.width} \{four.count s: t4}"
}
