# A unit is named by what the checker resolved a path's base to, never by its
# spelling. Each base below is spelled like a runtime unit and is not it: a
# nested unit `io` whose BufWriter has its own create, a nested `cli` whose
# Spec does too, a nested `os` whose `pid` is an ordinary function, and a local
# value `io` whose type has a `stdout` method. Reached by spelling, the first
# two emitted io's and cli's native creates, the third the native pid, and the
# fourth io's stdout.
ns: unit {
    io: unit {
        BufWriter: class { n: i64 } as {
            create: function {n: i64} out BufWriter is {
                return (meta.create n: n * 2)
            }
        }
    }

    cli: unit {
        Spec: class { name: String } as {
            create: function {name: String} out Spec is {
                return (meta.create name: "spec \{name}")
            }
        }
    }

    os: unit {
        pid: function out i64 is {
            return 77
        }
    }

    run: function out i64 is {
        b: io.BufWriter.create n: 5
        s: cli.Spec.create name: "x".string
        print s.name
        return b.n + os.pid
    }
}

W: class {
    n: i64
} as {
    stdout: function {t: this.view} out i64 is {
        return t.n
    }
}

main: function is {
    print "\{ns.run}"
    io: W n: 9
    print "\{io.stdout}"
}
