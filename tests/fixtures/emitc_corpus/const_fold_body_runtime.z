# A body condition the evaluator cannot fold emits an ordinary runtime branch.
# The evaluator RECORDS why it could not produce a value and the body walk
# drops the record without rendering it: a fold is an optimisation, and an
# optimisation must not turn a legal program into an error. Only a caller that
# REQUIRED a value -- a unit-level definition, a `require:` block -- renders
# one, which is what tests/fixtures/errors/const_overflow.z pins.
#
# The same expression written with bare literals has always emitted this C;
# naming the operands used to make it E0600. gcc's -Woverflow on the emitted
# line is the honest result: -fwrapv defines the wrap, and this is what a
# constant i64 overflow compiles to either way.
#
# `> n` against a local keeps both branches live, so deadcode-guard still
# speaks for the folding fixtures without this one answering for them.

BIG: 9223372036854775807

main: function is {
    n: 3
    if (BIG + BIG) > n then {
        print "sum above n"
    } else {
        print "sum below n"
    }
    if (BIG * 2) > n then {
        print "product above n"
    } else {
        print "product below n"
    }
}
