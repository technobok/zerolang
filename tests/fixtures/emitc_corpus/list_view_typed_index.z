# A LIST WITH AN INDEX TYPE OF ITS OWN TAKES A VIEW OF ITS OWN KIND: `extendView`
# declared its window as a view indexed by u64, whatever the list's index, so
# extending a `(ListVal u8 i: slot)` from another one's `listView` or `slice`
# was refused as a type mismatch.
slot: typedef u32

main: function is {
    src: (ListVal u8 i: slot)
    src.append 7
    src.append 8
    src.append 9
    whole: (ListVal u8 i: slot)
    whole.extendView from: src.listView
    part: (ListVal u8 i: slot)
    part.extendView from: (src.slice from: slot 1 to: slot 3)
    first: slot
    print "\{whole.length} \{part.length} \{part.get i: first}"
}
