# A `.take` moves a lock-holding value exactly as the bare name does, so a
# move lock_transfer_same_scope accepts is accepted written with `.take` too --
# into a container, a constructed field and a union arm, each in its source's
# own scope -- and the locks travel with the value: each source stays readable.
# The errors twins (lock_transfer_take_marker_*) are the writes and escapes
# that stay refused.
Src: class {
    n: i64
}

W: class {
    s: Src.borrow
    tag: i64
}

H: class {
    w: W
}

U: union {
    w: W
    none: null
}

mk: function {from: Src.borrow} outx W is {
    return (W s: from tag: 1)
}

main: function is {
    xs: (List W)
    a: Src n: 1
    w: mk from: a
    xs.append w.take
    b: Src n: 2
    w2: mk from: b
    h: H w: w2.take
    c: Src n: 3
    w3: mk from: c
    u: U.w w3.take
    match (
        u
    ) case w then {
        print "\{xs.length} \{(xs.get i: 0).s.n} \{h.w.s.n} \{u.s.n} \{a.n + b.n + c.n}"
    } else null
}
