# A NUMERIC GENERIC PARAMETER IS NO FIELD: a record instance stored a synthesised
# copy of its argument in every value, passed it to every construction and
# compared it in `==`, although the type already fixes it. A field the author
# wants is declared: one declared by the parameter (`stored: cap`) is a slot of
# the parameter's singleton type, which holds the instance's argument. The
# construction sets it, and takes no argument for it.
rec: record {
    stored: cap
    x: i64
} as { cap: u32.generic }

Box: class {
    stored: cap
    used: u32
} as { cap: u32.generic }

big: record {
    x: i64
} as { n: u64.generic }

main: function is {
    a: (rec cap: 7) x: 1
    b: (rec cap: 9) x: 1
    c: (Box cap: 5) used: 1
    d: (Box cap: 6) used: 2
    print "\{a.stored} \{b.stored} \{c.stored} \{d.stored} \{(rec cap: 7).cap} \{(rec cap: 9).cap} \{(Box cap: 5).cap}"
    e: (rec cap: 7) x: 1
    if a == e then print "a equals e" else print "a differs from e"
    u: (big n: 18446744073709551615) x: 2
    print "\{u.x} \{(big n: 18446744073709551615).n}"
}
