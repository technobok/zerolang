# A NUMERIC GENERIC PARAMETER IS NO FIELD: a record instance stored a synthesised
# copy of its argument in every value, passed it to every construction and
# compared it in `==`, although the type already fixes it. A field the author
# wants is declared, and one defaulted by the parameter takes each instance's
# argument (`stored: cap`), where it was a field typed `cap` that every
# construction then had to supply.
rec: record {
    stored: cap
    x: i64
} as { cap: u32.generic }

Box: class {
    stored: cap
    used: u32
} as { cap: u32.generic }

big: record {
    x: i64
} as { n: u64.generic }

main: function is {
    a: (rec cap: 7) x: 1
    b: (rec cap: 9) stored: 2 x: 1
    c: (Box cap: 5) used: 1
    d: (Box cap: 6) used: 2
    print "\{a.stored} \{b.stored} \{c.stored} \{d.stored} \{a.cap} \{b.cap} \{c.cap}"
    e: (rec cap: 7) x: 1
    if a == e then print "a equals e" else print "a differs from e"
    u: (big n: 18446744073709551615) x: 2
    print "\{u.x} \{u.n}"
}
