# os_build_stamp.z -- a program whose build stamped nothing reads an empty
# commit and date: the natives' own definitions, on every system. (zc and the
# other drivers link theirs in under ZC_BUILD_STAMP_LINKED.)
main: function is {
    c: os.buildCommit
    d: os.buildDate
    print "commit=[\{c}] date=[\{d}]"
}
