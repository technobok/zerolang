# text_literal_type.z -- a string literal and an untyped string constant wear
# textliteral until a destination pins them: a `text` place makes the value
# text, a StringView or StringLike place a StringView. `.text` and
# `.stringView` convert one outright, a literal or a constant alike, and
# `.string` copies it into a String. With no destination a binding is a
# StringView, a field or parameter declared by a string default is a
# StringView, and a data field or an untyped list's element is text.
NAME: "zero"
FULL: NAME + " lang"
T: NAME.text
holder: data {
    note: ""
    raw: textliteral
}
h: (holder raw: "raw")
words: list { "alpha" "beta" }
tagged: list { "x" "y" } out staticlist textliteral
show: function {t: text} is {
    print t.stringView
}
look: function {s: StringView} is {
    print s
}
greet: function {who: ""} is {
    print "hello \{who}"
}
named: function out text is {
    return "named"
}
main: function is {
    show t: "lit"
    show t: NAME
    show t: T
    show t: NAME.text
    show t: words.0
    show t: h.note
    show t: named
    look s: "view"
    look s: NAME
    look s: FULL
    look s: NAME.stringView
    look s: h.raw
    x: "bound"
    look s: x
    o: NAME.string
    print o.stringView
    greet
    greet who: "you"
    print "\{tagged.1} \{words.length} \{FULL.length}"
}
