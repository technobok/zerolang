# view_walk_off_call -- a view a call hands back is walked where it stands:
# `for each w: l.listView`, an explicit `.iterate` or `.iterateReverse` off it,
# and a slice of it, over an array, a ListVal and a List. The view is bound to a
# temporary whose address the walk takes; its walk was emitted as a call to a
# function no C declared.
public: unit {
    :main
}

# Box -- an array field walked from a method
Box: record {
    a: (array u64 to: 3)
} as {
    # sum -- the words added, walked through the field's view
    sum: function {t: this.view} out u64 is {
        s: u64
        for each w: t.a.listView loop s = s + w
        return s
    }
}

main: function is {
    b: Box a: (array u64 to: 3)
    b.a.set i: 1 item: 5
    b.a.set i: 2 item: 7
    print "\{b.sum}"
    l: ListVal u64
    l.append from: 1
    l.append from: 2
    l.append from: 3
    s: u64
    for each w: l.listView loop s = s + w
    print "\{s}"
    it: l.listView.iterate
    first: it.call
    match first case some then print "first \{first}" case none then print "none"
    for each w: l.listView.iterateReverse loop print "down \{w}"
    for each w: (l.listView.slice from: 1 to: 3) loop print "slice \{w}"
    names: List String
    names.append from: "ab".string
    names.append from: "cde".string
    n: u64
    for each w: names.listView loop n = n + w.length
    print "\{n}"
}
