# a type a generic unit declares, named through a unit-level instance of it
# (`ic.Cell` with `ic: (cells t: i64)`), is that instance's own copy wherever a
# type is written: a function's return and parameter, a record's field, a
# class's field and method parameter, a unit-level alias, and a numeric
# unit's type -- two instances naming two distinct types.
cells: unit as {
    t: anyval.generic
    Cell: record {
        val: t
    }
    make: function {v: t} out Cell is {
        return (Cell val: v)
    }
}
sized: unit as {
    n: u32.generic
    Slot: record {
        val: i64
    }
    cap: function out u32 is {
        return n
    }
}
ic: (cells t: i64)
uc: (cells t: u8)
s8: (sized n: 8)
ICell: ic.Cell
mk: function {v: i64} out ic.Cell is {
    return (ic.make v: v)
}
show: function {c: ic.Cell} out i64 is {
    return c.val
}
showU: function {c: uc.Cell} out u8 is {
    return c.val
}
showA: function {c: ICell} out i64 is {
    return c.val
}
slotVal: function {s: s8.Slot} out i64 is {
    return s.val
}
Holder: record {
    c: ic.Cell
}
Box: class {
    c: ic.Cell
} as {
    plus: function {:this d: ic.Cell} out i64 is {
        return this.c.val + d.val
    }
}
main: function is {
    c: mk v: 5
    h: Holder c: (ic.make v: 6)
    b: Box c: (ic.make v: 7)
    print "\{c.val} \{show c: (ic.make v: 1)} \{showU c: (uc.make v: 2)} \{showA c: c}"
    print "\{h.c.val} \{b.plus d: (ic.make v: 3)} \{slotVal s: (s8.Slot val: 4)} \{s8.cap}"
}
