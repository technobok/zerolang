# A unit-level definition is checked when something uses it (or under --eager),
# never otherwise -- including one that names itself. `idleInfix: 1 + idleInfix`
# was reported and `idleSum: idleSum + 1` was not: the pass that completes
# generic-unit instantiations resolved the ARGUMENTS of every call-shaped
# definition, instantiation or not, and the infix form is a call whose argument
# is the right operand. Only a generic unit's instantiation is its business.
bar: function {n: i64} out i64 is {
    return n
}

idleSum: idleSum + 1
idleInfix: 1 + idleInfix
idleCall: bar idleCall
IdleList: (List IdleList)

main: function is {
    print "unused definitions are not checked"
}
