# AN `as` ALIAS IS REACHED THROUGH AN INSTANCE AS THROUGH ITS TYPE: the
# template's alias, completed with the instance's arguments (`B.Elem` is i64
# for `B: (Box t: i64)`, bool for `W: (Box t: bool)`), written as a
# type application or through a name defined as one, in a parameter, a return,
# a type argument and a value alike. Each named nothing (`type '(Box t: i64)'
# has no member 'Elem'`). And a free function's parameter typed by an alias
# through a type (`v: Plain.Inner`) is that alias, where its body read the
# parameter as the type the path goes through.
Box: class {
    first: Elem
} as {
    t: anyval.generic
    Elem: t
    Elems: (ListVal Elem)
}

inner: record {
    y: 4
}

Plain: record {
    x: i64
} as {
    Inner: inner
}

B: (Box t: i64)
W: (Box t: bool)

bump: function {v: B.Elem} out B.Elem is {
    return v + 1
}

flip: function {s: W.Elem} out W.Elem is {
    return s.not
}

deeper: function {v: Plain.Inner} out i64 is {
    return v.y + 1
}

main: function is {
    l: ListVal B.Elem
    l.append (bump v: 2)
    es: (Box t: i64).Elems
    es.append 9
    z: (Box t: i64).Elem
    s: false
    print "\{l.length} \{l.get i: 0} \{es.length} \{z} \{s} \{flip :s} \{deeper v: Plain.Inner}"
}
