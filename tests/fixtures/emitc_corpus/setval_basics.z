# `SetVal` -- the valtype twin of `Set`. A valtype has no ownership to transfer
# and no interior to alias, so `add` copies rather than taking and `has` /
# `delete` take the element by value: there is no view to hand them and nothing
# for one to point at.
#
# The two families are exercised side by side because they may NOT share an
# iterator: the emitter names the iterator struct after `iterate`'s declared
# return, so one name over two containers would emit two structs under it.
pt: record {
    x: i64
    y: i64
}

main: function is {
    v: (SetVal u64)
    v.add item: 10
    v.add item: 20
    dup: v.add item: 10
    print "len=\{v.length} dup=\{dup} has20=\{v.has item: 20} has99=\{v.has item: 99}"
    gone: v.delete item: 20
    print "deleted=\{gone} len=\{v.length}"

    # a COMPOUND valtype element: hashed and compared by bytes, the same way
    # a record Map key is.
    ps: (SetVal pt)
    ps.add item: (pt x: 1 y: 2)
    ps.add item: (pt x: 3 y: 4)
    print "compound len=\{ps.length} has=\{ps.has item: (pt x: 3 y: 4)}"

    r: (Set String)
    r.add item: "a".string
    with it: r.iterate do for x: it loop print "ref \{x}"
    with jt: v.iterate do for y: jt loop print "val \{y}"
}
