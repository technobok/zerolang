# A guard that rules out the only arm of a union leaves no arm, so the code
# after it never runs. The name keeps its union type there: the arm just
# excluded is never read back as the one that remains. Each function reads
# the name as the union after such a guard -- an `if`, an else-less `match`,
# an else branch -- for a built value and for a parameter alike.
One: union {
    only: String
}

show: function {o: One} is {
    match o case only then print "only \{o}"
}

afterIf: function is {
    x: One.only "after if".string
    show o: x
    if x.only then return
    show o: x
}

afterMatch: function is {
    x: One.only "after match".string
    show o: x
    match x case only then return
    show o: x
}

inElse: function is {
    x: One.only "in else".string
    if x.only then { print "then \{x}" } else { show o: x }
}

inMatchElse: function is {
    x: One.only "in match else".string
    match x case only then print "case \{x}" else show o: x
}

afterIfParam: function {x: One} is {
    show o: x
    if x.only then return
    show o: x
}

main: function is {
    afterIf
    afterMatch
    inElse
    inMatchElse
    afterIfParam x: One.only "parameter".string
}
