# copy_through_called_base -- `.copy` reads its own base as a reference (so a
# function copies as a function), but a member that is no marker reads ITS base
# as a value: in `(mk).shown.copy` the parenthesised `(mk)` is called, as the
# parentheses say. It was read as the function itself ("type 'function out
# Holder' has no member 'shown'").
public: unit {
    :main
}

# Holder -- owns one text
Holder: class {
    s: String
} as {
    # the held text, viewed
    shown: function {h: this.view} outx String.view is {
        return h.s
    }
}

# mk -- a fresh holder
mk: function out Holder is {
    return (Holder s: "held".string)
}

# twice -- a number doubled
twice: function {n: u64} out u64 is {
    return n * 2
}

main: function is {
    u: mk.shown.copy
    u.append "!"
    print u
    print "\{mk.shown.copy}"
    f: twice.copy
    print "\{f n: 21}"
}
