# error_after_early_exit.z -- an `error` is proved only when every path reaches
# it. An early `return`, `break` or `continue` before it can skip it, so it stays
# a run-time trap, here on paths that never run.

early: function {k: bool} is {
    if k then return
    error "after early return"
}

inLoop: function {k: bool} is {
    for loop {
        if k then break
        error "after conditional break"
    }
    print "left the loop"
}

inDo: function {k: bool} is {
    with z: 1 do {
        if k then break
        error "after a break out of the do \{z}"
    }
    print "left the do"
}

skipped: function {k: bool} is {
    n: 0
    for n < 2 loop {
        n = n + 1
        if k then continue
        error "after conditional continue"
    }
    print "counted \{n}"
}

main: function is {
    k: true
    early :k
    inLoop :k
    inDo :k
    skipped :k
    print "done"
    if k then return
    error "after early return in main"
}
