# ordinal_variant_receiver.z -- a variant whose arms carry nothing is its own
# discriminator: two arms are a C bool, three or more a small integer. Its
# methods take `this` by pointer and a `.view` parameter is one too, so a
# `match` there tests the VALUE the pointer holds. It tested the pointer --
# never null -- so every value took the second arm: `Dir.up.flip` was `up`.
# And a receiver that is an arm constant or a call's result has no address,
# so it is bound to a temp first; `&` of it was C the compiler rejected.
Dir: variant {
    up: null
    down: null
} as {
    flip: function {d: this} out Dir is {
        match d case up then return Dir.down case down then return Dir.up
    }
    word: function {d: this} out String is {
        match d case up then return "up".string case down then return "down".string
    }
    isUp: function {d: this} out bool is {
        return d == Dir.up
    }
}

Tri: variant {
    a: null
    b: null
    c: null
} as {
    next: function {t: this} out Tri is {
        match t case a then return Tri.b case b then return Tri.c case c then return Tri.a
    }
}

isUpView: function {d: Dir.view} out bool is {
    match d case up then return true case down then return false
}

main: function is {
    u: Dir.up
    w: Dir.down
    print "\{u.flip.word} \{w.flip.word} \{u.flip.flip.word}"
    print "\{Dir.up.word} \{Dir.down.isUp} \{Dir.up.flip.isUp}"
    print "\{isUpView d: u} \{isUpView d: w}"
    x: Tri.a
    print "\{x.next == Tri.b} \{x.next.next == Tri.c} \{Tri.c.next == Tri.a}"
}
