# `scaleB` and `logB` -- IEEE 754's own names for the two operations that move
# a float along its exponent without touching its significand. C99 spells them
# scalbn and ilogb.
#
# scaleB is NOT a multiplication by a power of two. The exponent moves and the
# significand does not, so nothing rounds anywhere in the type's range -- which
# is the whole reason to have it rather than `x * 2.0` in a loop.
#
# They are also the first natives on a scalar type that take an ARGUMENT: every
# other bodied scalar row is a conversion, `bits` or `not`, all receiver-only.
# The row fills @V@ with the receiver and @A1@ with the argument.
main: function is {
    x: 3.0
    print "logB 3.0: \{x.logB}"
    print "scaleB up: \{x.scaleB n: 4}"
    print "scaleB down: \{x.scaleB n: (0 - 4)}"
    print "scaleB zero: \{x.scaleB n: 0}"

    # a round trip is exact: what the exponent gives up it takes back
    y: 0.1
    z: (y.scaleB n: 60).scaleB n: (0 - 60)
    if z == y then print "round trip exact" else print "round trip LOST"

    # logB is the binade, so scaling by its negation normalises to [1, 2)
    w: 1234.5
    m: w.scaleB n: (0.i32 - w.logB)
    print "normalised: \{m}"

    # a subnormal is normalised before the exponent is read
    s: 0.000000059604644775390625
    print "logB 2^-24: \{s.logB}"

    # building a power of two by scaling one, which is what the f16 binade
    # wants and what a hand-rolled halving loop was doing the long way
    print "2^-10: \{1.0.scaleB n: (0 - 10)}"
    print "2^-24: \{1.0.scaleB n: (0 - 24)}"

    # f32 carries its own row
    f: 3.0.f32
    print "f32 logB: \{f.logB}  f32 scaleB: \{f.scaleB n: 4}"
}
