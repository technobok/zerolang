# text_static.z -- `text`, static text: a pointer and a length into the program's
# own bytes, read here from a typed static list. It is a valtype -- held in a
# record and a class field, a ListVal and a MapVV, passed and returned by value
# -- with the byte orderings, a hash, `.string`, slices that are text again,
# and an interpolation. Its view pins nothing, so the binding can be reassigned
# while the view lives. A local and a field may still be NAMED text.
names: list { a: "  alpha " b: "beta" c: "gamma" d: "ab" e: "b" } out staticlist text

pair: record {
    key: text
    n: u64
}

Doc: class {
    text: String
    n: u64
}

Tag: class {
    label: text
}

pick: function {xs: staticlist text i: u64} out text is {
    return (xs.get :i)
}

shout: function {t: text} out String is {
    s: t.string
    s.append "!"
    return s
}

main: function is {
    t: names.a
    u: names.b
    print "\{t.length} \{u.length} \{t.isEmpty}"
    print t.trim.stringView
    print t.trimStart.stringView
    print (u.substring from: 1 to: 3).stringView
    print "\{t == u} \{u == u} \{t < u} \{u >= t} \{u.compare rhs: t}"
    v: t.stringView
    t = names.c
    print v
    m: MapVV text v: u64
    m.set key: names.a value: 1
    m.set key: names.b value: 2
    g: m.get key: names.b
    match g case some then print "\{g}" case none then print "none"
    xs: ListVal text
    for each e: names loop xs.append e
    xs.sort
    for each e: xs loop print e.trim.stringView
    p: pair key: names.c n: 3
    text: Doc text: "abc".string n: p.n
    tag: Tag label: p.key
    print "\{text.n} \{tag.label.length} \{text.text}"
    print "interp: \{p.key}"
    print (shout t: (pick xs: names i: 1))
    s: SetVal text
    s.add names.a
    print "\{s.has names.a} \{s.has names.b} \{(names.a.hash == names.a.hash)}"
    # equal bytes at two addresses are equal text, bare or inside a record key
    x: names.d.substring from: 1 to: 2
    y: names.e
    print "\{x == y} \{(pair key: x n: 1) == (pair key: y n: 1)}"
    pm: MapVV pair v: u64
    pm.set key: (pair key: x n: 1) value: 5
    pg: pm.get key: (pair key: y n: 1)
    match pg case some then print "\{pg}" case none then print "none"
}
