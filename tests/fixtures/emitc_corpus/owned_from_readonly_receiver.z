# owned_from_readonly_receiver.z -- what a call on a readonly receiver hands
# back is the binding's own: `c.abs.string` off a `view` parameter is a new
# String, written like any owned local. Only a binding that borrows a readonly
# place is readonly itself.

# shout -- |c| in digits, marked: the digits are an owned String, written
shout: function {c: math.BigInt.view} out String is {
    ad: c.abs.string
    ad.append "!"
    return ad
}

main: function is {
    v: math.BigInt from: -42
    print (shout c: v)
}
