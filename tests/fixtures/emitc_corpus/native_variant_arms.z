# native_variant_arms.z -- a NATIVE variant keeps its arms. The runtime owns a
# native type's layout, so the grammar gives such a type no is-block; a
# variant's is-block holds ARMS, and a payload-less arm is an ordinal rather
# than storage. `bool` is the reason: it is runtime-backed and still has to
# spell `true` and `false` for zerolang code to construct, match and narrow on.
# So the marker and the arms coexist, and everything a variant can do still
# works. A payload arm is refused -- see errors/native_variant_payload_arm.

tri: variant is native { lo: null  mid: null  hi: null }

describe: function {t: tri} out i64 is {
    match (
        t
    ) case lo then {
        return 1
    } case mid then {
        return 2
    } case hi then {
        return 3
    }
}

main: function is {
    a: tri.lo
    b: tri.mid
    c: tri.hi
    print "lo=\{describe t: a} mid=\{describe t: b} hi=\{describe t: c}"
    # `value.arm` is a predicate on a native variant like any other
    if b.mid then print "b is mid" else print "b is not mid"
    if a.hi then print "a is hi" else print "a is not hi"
}
