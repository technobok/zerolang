# `|` and `^` on the integer types, beside the `&` that has always been there.
# Bitwise operators are declared members like every other operator, so the set
# is exactly the twelve integer types -- the ten in system.z plus the two wide
# ones -- and a bare literal coerces to the operand's type at every one.
main: function is {
    a: 12.u64
    b: 10.u64
    print "u64: \{a | b} \{a ^ b} \{a & b}"
    print "u64 lit: \{a | 3} \{a ^ 3}"

    c: 12.u8
    d: 10.u8
    print "u8: \{c | d} \{c ^ d}"

    e: 12.u16
    f: 10.u16
    print "u16: \{e | f} \{e ^ f}"

    g: 12.u32
    h: 10.u32
    print "u32: \{g | h} \{g ^ h}"

    # signed: the sign bit participates like any other bit
    i: (0.i32 - 12.i32)
    j: 10.i32
    print "i32: \{i | j} \{i ^ j}"

    k: (0.i8 - 12.i8)
    l: 10.i8
    print "i8: \{k | l} \{k ^ l}"

    m: (0.i64 - 1.i64)
    n: 255.i64
    print "i64: \{m | n} \{m ^ n}"

    # xor with self is zero, or with self is identity -- the algebraic pins
    print "self: \{a ^ a} \{a | a}"

    # the character types carry the bitwise set too, because they carry `&`
    p: 12.c8
    q: 10.c8
    print "c8: \{p | q} \{p ^ q}"

    r: 12.c32
    s: 10.c32
    print "c32: \{r | s} \{r ^ s}"
}
