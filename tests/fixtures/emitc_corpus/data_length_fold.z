# `.length` on a data block is a constant of the block, not a runtime read: the
# element count is known at resolution, so it folds like a labelled element and
# never forces the static array out. An element labelled `length` claims the
# name and keeps it. Before the fold the checker left the read unstamped and the
# emitter named a `_len` symbol nothing defined.
codes: data {
    10 20 30
} out u8

primes: data { 2 3 5 7 11 }

named: data {
    length: 99
    other: 7
} out u8

main: function is {
    print "codes=\{codes.length}"
    print "named=\{named.length} other=\{named.other}"
    n: primes.length
    print "primes=\{n}"
    i: 0
    for i < primes.length loop {
        print "p\{i}=\{primes.index i}"
        i = i + 1
    }
}
