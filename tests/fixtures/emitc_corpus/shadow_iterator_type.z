# shadow_iterator_type.z -- a user record named `Iterator`, shadowing the
# stdlib protocol.
#
# `Iterator` is an ordinary shadowable name, so a function returning the USER
# type must not be taken for a generator. Candidacy compares the return head's
# RESOLVED id against the protocol's, so the shadow answers its own id and the
# function stays an ordinary factory. The twin of generator_alias_return.z:
# that one must lower without naming the protocol, this one must not lower
# while naming it.

Iterator: record {
    n: 0
}

mk: function {v: i64} out Iterator is {
    return (Iterator n: v)
}

main: function is {
    a: mk v: 7
    b: mk v: 11
    print "a: \{a.n}"
    print "b: \{b.n}"
    print "done"
}
