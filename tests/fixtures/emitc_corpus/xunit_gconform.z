# The cross-unit half of generic_conformance.z: a generic class conforming to
# a protocol, declared in a NON-MAIN unit and instantiated by the main one. The
# instance's methods are cloned from this unit's template, so its vtable
# wrapper calls them by the names this unit gives them.
Named: protocol {
    tagged: function {t: this.view} out i64
}

Crate: class {
    v: t
    k: i64
} as {
    t: anyval.generic
    :Named
    tagged: function {t: this.view} out i64 is {
        return t.k * 10
    }
}
