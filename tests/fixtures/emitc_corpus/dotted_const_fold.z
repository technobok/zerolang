# A constant read through a dotted path folds exactly as a bare one does --
# another unit's (`xunit_constflag.FLAG`) and this unit's own
# (`dotted_const_fold.LOCALOFF`), for a bool tag and for an integer.
# deadcode-guard is the gate: an unfolded condition leaves the untaken branch
# in the C, and clang reports it as unreachable.

LOCALOFF: bool.false

main: function is {
    if xunit_constflag.FLAG then {
        print "cross-unit bool NOT folded"
    } else {
        print "cross-unit bool folded"
    }
    if dotted_const_fold.LOCALOFF then {
        print "same-unit bool NOT folded"
    } else {
        print "same-unit bool folded"
    }
    if xunit_constflag.LIMIT > 5 then {
        print "cross-unit int NOT folded"
    } else {
        print "cross-unit int folded"
    }
    if LOCALOFF then {
        print "bare bool NOT folded"
    } else {
        print "bare bool folded"
    }
}
