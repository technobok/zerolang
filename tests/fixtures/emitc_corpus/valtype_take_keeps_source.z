# `.take` OF A VALUE COPIES ITS BYTES AND LEAVES THE SOURCE AS IT IS. A valtype
# -- a number, a record, a variant, a function reference -- has no owner to
# move, so taking one moves nothing: the local is still usable, a field is not
# emptied (it read as zero before), and a take on every pass of a loop is
# legal. Only a reftype is moved by `.take`, and its source is then gone
# (errors/matrix_*_refused, param_take_then_read).
pt: record {
    n: i64
}

shade: variant {
    red: null
    grey: i64
}

Holder: class {
    p: pt
}

keep: function {p: pt.take} out i64 is {
    return p.n
}

main: function is {
    a: pt n: 5
    b: a.take
    b.n = 6
    print "local \{a.n} \{b.n}"
    h: Holder p: (pt n: 7)
    c: h.p.take
    print "field \{h.p.n} \{c.n}"
    print "argument \{keep p: a.take} \{a.n}"
    i: 0
    total: 0
    for i < 3 loop {
        x: a.take
        total = total + x.n
        i = i + 1
    }
    print "loop \{total} \{a.n}"
    s: shade.grey 3
    t: s.take
    match (s) case grey then print "variant \{s}" case red then null
    match (t) case grey then print "taken \{t}" case red then null
}
