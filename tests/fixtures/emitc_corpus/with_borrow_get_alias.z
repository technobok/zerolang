# with_borrow_get_alias.z -- `with m: (xs.getMut i: 0) do ...` names the
# element the list holds, as a plain binding of the same call does: a write
# through `m` is a write to the element, never to a copy of it.

# C -- a counter
C: class { n: i64 } as {
    # count one more
    bump: function {:this} is { this.n = this.n + 1 }
}

main: function is {
    cs: List C
    cs.append (C n: 1)
    with m: (cs.getMut i: 0) do m.bump
    print "with \{(cs.get i: 0).n}"
    with v: (cs.get i: 0) do print "viewed \{v.n}"
    names: List String
    names.append "a".string
    with s: (names.getMut i: 0) do s.append "b"
    print "string \{names.get i: 0}"
}
