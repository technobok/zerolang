# A field an instance types `null` -- `v: T` with T = null -- carries nothing:
# it has no storage, takes no argument (`v: null` is accepted), and a read of
# it as a statement does nothing. It was laid out as an int64_t, required as
# an argument ("missing required argument 'v' (type: null)"), and `v: null`
# reached the C as the undeclared name `null`. Beside it, the same template
# instanced over a String and over a union bound's null arm.
Num: class { k: i64 }

Choice: union { num: Num text: String nothing: null }

Carry: class { v: T  n: u8 } as {
    T: AnyRef.generic
}

Pick: class { v: T  n: u8 } as {
    T: Choice.generic
}

main: function is {
    a: (Carry T: null) n: 2
    b: (Carry T: null) v: null n: 3
    a.v
    c: (Carry T: String) v: "s".string n: 4
    p: (Pick T: null) n: 5
    q: (Pick T: Num) v: (Num k: 6) n: 7
    print "\{a.n} \{b.n} \{c.n} \{c.v} \{p.n} \{q.v.k} \{q.n}"
}
