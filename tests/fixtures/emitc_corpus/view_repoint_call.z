# a borrowed view re-pointed at a view a call hands back -- `m = m.substring
# ...`, `v = xs.slice ...` -- keeps the value in the binding's companion: the
# value has no storage of its own, and the C took the address of the call
# (`&substring(..)`, which gcc rejects). In a loop, in a branch the binding
# outlives, and returned through an `outx`.

# trim -- s without its leading spaces
trim: function {s: StringView} outx StringView is {
    m: s
    for m.startsWith " " loop m = m.substring from: 1 to: m.length
    return m
}

# sumTail -- the sum of xs past its first element, when it has one
sumTail: function {xs: (ListVal i64).view} out i64 is {
    v: xs.listView
    if xs.length > 0 then v = xs.slice from: 1 to: xs.length
    t: 0
    for each e: v.iterate loop t = t + e
    return t
}

main: function is {
    print "[\{trim s: "   hi"}]"
    s: "-abc"
    m: s
    m = s.substring from: 1 to: s.length
    print "\{m}"
    l: ListVal i64
    l.append 4
    l.append 5
    l.append 6
    print "\{sumTail xs: l}"
}
