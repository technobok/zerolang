# A swap inside an arm whose payload is the sum itself (`more: Chain`) writes
# the whole local, as a reassignment there does: `d swap e` exchanges `d` and
# `e`, not `d`'s payload, and reads after it see the whole value.
Chain: union {
    last: i64
    more: Chain
}

show: function {c: Chain.view} out String is {
    match c case last then return "last \{c}" case more then return "more(\{show :c})"
}

main: function is {
    d: Chain.more (Chain.last 1)
    e: Chain.more (Chain.more (Chain.last 2))
    match (
        d
    ) case more then {
        d swap e
        print (show c: d)
    } case last then print "last"
    print (show c: e)
}
