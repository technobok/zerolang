# range_counter_width.z -- a counted range counts in the RECEIVER's width.
#
# The induction variable used to be `int64_t` whatever the receiver was, so a
# u64 value above i64's maximum was cast to a NEGATIVE number, the test failed
# at once and the loop ran zero times -- silently, with no diagnostic. The pair
# below straddles that edge: the range runs from i64's maximum to one past it,
# so its second value is representable only in the receiver's own width.
#
# The narrow widths are here because the counter also IS the loop name: counted
# in 64 bits, a u8 index was a wider value assigned to a u8 slot at every step.
main: function is {
    n: 9223372036854775808.u64
    f: 9223372036854775807.u64
    c: 0.u64
    for each x: (f.upto to: n) loop {
        c = c + 1
        print "wide \{x}"
    }
    print "wide count \{c}"

    for each g: 3.u8.times loop print "u8 \{g}"
    for each h: 3.u32.times loop print "u32 \{h}"
    for each s: 3.i64.times loop print "i64 \{s}"

    # the comprehension form counts through the same reader
    m: 4.u64
    sq: for each k: m.times loop k * k
    print "squares \{sq.length}"
    for each j: sq.length.times loop print "sq \{sq.get j}"
}
