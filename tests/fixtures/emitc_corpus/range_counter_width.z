# range_counter_width.z -- a counted range counts in the RECEIVER's width.
#
# The induction variable used to be `int64_t` whatever the receiver was, so a
# u64 bound above i64's maximum was cast to a NEGATIVE number, the test failed
# at once and the loop ran zero times -- silently, with no diagnostic. The pair
# below straddles that edge: `from` is i64's maximum and the bound is one past
# it, so the range holds exactly one value and only a u64 counter finds it.
#
# The narrow widths are here because the counter also IS the loop name: counted
# in 64 bits, a u8 index was a wider value assigned to a u8 slot at every step.
main: function is {
    n: 9223372036854775808.u64
    f: 9223372036854775807.u64
    c: 0.u64
    for x: (n.iterate from: f) loop {
        c = c + 1
        print "wide \{x}"
    }
    print "wide count \{c}"

    for g: 3.u8 loop print "u8 \{g}"
    for h: 3.u32 loop print "u32 \{h}"
    for s: 3.i64 loop print "i64 \{s}"

    # the comprehension form counts through the same reader
    m: 4.u64
    sq: for k: m.iterate loop k * k
    print "squares \{sq.length}"
    for j: sq.length.iterate loop print "sq \{sq.get j}"
}
