# An array holds its elements BY VALUE, so its C struct needs the element's
# complete struct first. An array over a user record is therefore emitted after
# the user structs, and a record or class holding such an array after it in
# turn. Every position is exercised: a local, a record field, a class field
# read from a method, a parameter and a return, a variant arm, an array of
# arrays, and a list of arrays -- plus a record declared after its first use.
use: function {rs: (array t: late to: 2)} out i64 is {
    r: rs.get i: 1
    return r.n
}

late: record {
    n: i64
}

row: record {
    n: i64
    tag: u8
}

holder: record {
    rows: (array t: row to: 2)
    k: i64
}

Grid: class {
    cells: (array t: row to: 3)
} as {
    total: function {:this} out i64 is {
        t: 0
        i: 0.u64
        for i < 3 loop {
            c: this.cells.get :i
            t = t + c.n
            i = i + 1
        }
        return t
    }
}

pick: variant {
    two: (array t: row to: 2)
    zero: null
}

mk: function out (array t: row to: 2) is {
    a: (array t: row to: 2)
    a.set i: 0 item: (row n: 5 tag: 1)
    return a
}

first: function {a: (array t: row to: 2)} out i64 is {
    r: a.get i: 0
    return r.n
}

main: function is {
    a: mk
    print "param/return \{first :a}"

    ls: (array t: late to: 2)
    ls.set i: 1 item: (late n: 3)
    print "declared later \{use rs: ls}"

    h: (holder rows: (array t: row to: 2) k: 4)
    h.rows.set i: 1 item: (row n: 6 tag: 2)
    hr: h.rows.get i: 1
    print "record field \{hr.n} \{h.k}"

    g: (Grid cells: (array t: row to: 3))
    g.cells.set i: 0 item: (row n: 2 tag: 0)
    g.cells.set i: 2 item: (row n: 5 tag: 0)
    print "class field \{g.total}"

    p: pick.zero
    print "variant arm \{p.zero}"

    grid: (array t: (array t: row to: 2) to: 3)
    inner: (array t: row to: 2)
    inner.set i: 1 item: (row n: 8 tag: 0)
    grid.set i: 2 item: inner
    gx: grid.get i: 2
    gy: gx.get i: 1
    print "array of arrays \{gy.n}"

    lists: ListVal (array t: row to: 2)
    lists.append from: inner
    print "list of arrays \{lists.length}"
}
