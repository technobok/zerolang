# arm_case_tags.z -- two arms of one sum whose names differ only in case are two
# arms. Their C tag enumerators were spelled from the arm names upper-cased, so
# `a` and `A` both declared `Z_K_TAG_A` and gcc refused the program; they are
# spelled from the arm's ordinal now.
k: variant {
    a: i64
    A: i64
}

K: union {
    a: i64
    A: String
}

main: function is {
    x: k.A 5
    match (x) case a then print "variant a \{x}" case A then print "variant A \{x}"
    y: K.A "up".string
    match (y) case a then print "union a \{y}" case A then print "union A \{y}"
}
