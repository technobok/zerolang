# A list whose elements are a typedef is a value like any list: bound, passed
# and walked, its view points at an array of the typedef's own C type. The
# array was emitted as int64_t while the view read uint8_t, and the C compiler
# refused the program.
byteid: typedef u8
codes: list { 9 10 32 } out staticlist byteid

# the sum of a list of byte ids
total: function {d: staticlist byteid} out u64 is {
    t: 0.u64
    for each c: d loop t = t + c.u8.u64
    return t
}

main: function is {
    w: codes
    print "\{w.length} \{(w.get i: 1).u8} \{total d: codes}"
}
