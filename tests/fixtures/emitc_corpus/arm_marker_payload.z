# An arm marker decides its payload's mutability, and nothing else changes:
# reads and `view` methods work through a `.view` arm, and an UNMARKED arm
# stays mutable -- the control that shows the rule reads the marker rather
# than freezing every payload.
Inner: class {
    n: i64
} as {
    bump: function {:this} is { this.n = this.n + 1 }
    peek: function {t: this.view} out i64 is { return t.n }
}
Frozen: union {
    some: Inner.view
    none: null
}
Plain: union {
    some: Inner
    none: null
}
main: function is {
    i: Inner n: 1
    f: Frozen.some i
    match (
        f
    ) case some then {
        print "frozen=\{f.n} peek=\{f.peek}"
    } else null

    j: Inner n: 5
    p: Plain.some j.take
    match (
        p
    ) case some then {
        p.bump
        print "plain=\{p.n}"
    } else null
}
