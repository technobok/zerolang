# A type a generic FILE unit declares is generic over the unit's parameter, as
# a type a nested `unit as { ... }` declares is: each instance has its own copy,
# and a bare name inside the unit means the instance's copy. It was an ordinary
# type over an unbound `t` ("unhandled interp part type t"), and the template's
# own functions were forward-declared over it.
ints: (gfu_cells t: i64)
fls: (gfu_cells t: f64)

main: function is {
    c: ints.mk x: 5
    print "\{c.v} \{ints.get :c}"
    s: fls.mk x: 2.5
    print "\{s.v}"
}
