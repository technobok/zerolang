# list_value_index_bounds.z -- `index` on a list VALUE checks its bounds as the
# block's own `.get` does: a read past the end panics ("zpanic: list index:
# index 4 out of bounds (length 4)" on stderr, exit 1).
primes: list { 2 3 5 7 } out staticlist u8

at: function {d: staticlist u8 i: u64} out u8 is {
    return (d.get :i)
}

main: function is {
    print "last=\{at d: primes i: 3}"
    past: at d: primes i: 4
    print "past=\{past}"
}
