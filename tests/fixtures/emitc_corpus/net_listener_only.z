# A listener alone: listen and close, with no accept and so no Conn in the
# program. Nothing of the Conn is loaded.
main: function is {
    lr: net.listen port: 49332
    match (
        lr
    ) case ok then {
        cl: lr.close
        match cl case ok then print "closed" case err then print "close failed"
    } case err then {
        print "listen failed"
    }
}
