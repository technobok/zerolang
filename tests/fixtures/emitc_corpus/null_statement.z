# null_statement.z -- the null value written as a statement does nothing, on a
# line of its own as in a clause body. The checker stamps the bare name with the
# null type; the emitter emits nothing for it, as for an empty body, rather than
# naming the type in C. A call of an out-less function wears the same stamp and
# still runs.

note: function {s: StringView} is {
    print s
}

ping: function is {
    print "ping"
}

main: function is {
    x: 1
    null
    ping
    if x == 1 then {
        null
    } else note s: "never"
    print "x=\{x}"
}
