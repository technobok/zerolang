# resultrv_basic.z -- ResultRV, the other mixed result: a reference on
# success, a value error. Its `err` is a bare value-type arm held in the
# union's own slot, so a failure that is only a reason -- a parseerror --
# allocates nothing, while the success is a cell as every reference arm is.
# Both arms are constructed, returned, matched and narrowed, the success read
# through a view and taken out, and the error's reason told apart.

Word: class { text: String }

parsed: function {n: i64} out (ResultRV Word e: parseerror) is {
    if n < 0 then return ((ResultRV Word e: parseerror).err parseerror.invalidDigit)
    if n == 0 then return ((ResultRV Word e: parseerror).err parseerror.empty)
    return ((ResultRV Word e: parseerror).ok (Word text: "word \{n}"))
}

reason: function {r: (ResultRV Word e: parseerror).view} out String is {
    match (r) case ok then {
        return r.text.copy
    } case err then {
        match (r) case empty then return "empty".string case invalidDigit then return "invalid".string case overflow then return "overflow".string
    }
}

main: function is {
    i: 0.i64 - 1
    for i < 3 loop {
        r: parsed n: i
        print "\{i}: \{reason :r}"
        i = i + 1
    }
    kept: parsed n: 7
    match (kept) case ok then {
        w: kept.take
        print "taken \{w.text}"
    } case err then print "no"
    e: parsed n: 0
    if e.err then print "err is a reason, not a cell"
}
