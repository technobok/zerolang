# typedef_generic_construct.z -- a GENERIC typedef is built from one value of
# its base: the unlabelled argument is `from:`, the type arguments are inferred
# from the value's type, and a labelled one pins them. Built from nothing it
# is its type application, the empty instance. A numeric parameter is never
# inferred and is written. The instance forwards to its base, takes its keys
# from the first declarer of `hash` and `==` through its chain, and stands in
# for a protocol its base conforms to.
# `Bag l` read `l` as the TYPE argument, and with no instance forwarding to its
# base none of these shapes had a member.
Bag: typedef (List T) as {
    T: AnyRef.generic
    first: function {this: this.view} out u64 is {
        return this.length
    }
}

Bag2: typedef (Bag T: T) as {
    T: AnyRef.generic
}

Idx: typedef (MapRV String v: v) as {
    v: anyval.generic
}

Holder: class {
    v: t
} as {
    t: anyval.generic
    get: function {this: this.view} out t is {
        return this.v
    }
}

Tag: typedef (Holder t) as {
    t: anyval.generic
}

Key: class {
    n: t
} as {
    t: anyval.generic
    hash: function {k: this.view} out u64 is {
        return 1
    }
    ==: function {k: this.view rhs: (Key t: t)} out bool is {
        return k.n == rhs.n
    }
}

KeyT: typedef (Key t) as {
    t: anyval.generic
}

Label: typedef (str to: n) as {
    n: u64.generic
}

show: function {s: Text} out u64 is {
    return s.stringView.length
}

main: function is {
    l: List String
    l.append from: "a".string
    b: Bag l
    l2: List String
    l2.append from: "b".string
    l2.append from: "c".string
    b2: Bag from: l2
    l3: List String
    c: Bag l3 T: String
    print "bags \{b.length} \{b2.first} \{c.length}"
    l4: List String
    l4.append from: "d".string
    d: (Bag T: String).create from: l4
    l5: List String
    v: Bag l5.borrow
    v.append from: "e".string
    print "create \{d.length} borrow \{v.length}"
    e: Bag T: String
    l6: List String
    l6.append from: "f".string
    ch: Bag2 (Bag l6)
    print "empty \{e.length} chain \{ch.first}"
    m: MapRV String v: i64
    m.set key: "k".string value: 1
    i: Idx m
    h: Tag (Holder v: 7)
    print "partial \{i.length} class \{h.get}"
    ks: SetRef (KeyT t: i64)
    ks.add item: (KeyT (Key n: 2))
    ks.add item: (KeyT (Key n: 2))
    ks.add item: (KeyT (Key n: 3))
    raw: str to: 8
    lb: Label raw n: 8
    le: Label n: 4
    print "keys \{ks.length} text \{show s: lb} \{lb.size} \{le.size}"
}
