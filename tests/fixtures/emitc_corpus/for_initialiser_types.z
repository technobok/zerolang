# A `for` condition that names a binding is an initialiser: declared once
# before the loop, tested every iteration. One of a type that is not a scalar
# -- a view, an owned String, a record, a list -- used to be declared `int64_t`,
# C the compiler rejected. It is declared with its own C type, and what it owns
# is released with the block around the loop, `break` or not.
pt: record { x: i64 y: i64 }

mks: function {n: i64} out String is {
    return "x\{n}"
}

main: function is {
    s: " abc ".string
    for sv: s.stringView while sv.length > 3 loop {
        sv = sv.trim
    }
    for t: "hello".string while t.length > 3 loop {
        t = "hi".string
    }
    for p: (pt x: 1 y: 2) while p.x < 3 loop {
        p = pt x: (p.x + 1) y: p.y
    }
    for l: (ListVal i64) while l.length < 2 loop {
        l.append from: 1
    }
    for u: (mks n: 42).stringView while u.length > 0 loop {
        print "view of a temporary: \{u}"
        break
    }
    for w: (mks n: 7) while w.length > 0 loop {
        print "owned: \{w}"
        break
    }
    print "done"
}
