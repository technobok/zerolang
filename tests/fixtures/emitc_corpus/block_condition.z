# A block used as a condition -- a loop's pre-condition or post-condition, or
# an `if`'s -- runs its statements where the test runs, every time it runs: the
# loop writes its test as statements and then tests the guard they leave.
main: function is {
    k: 0
    j: 0
    for loop {
        k = k + 1
    } while ({
        j = j + 2
        k < 3
    })
    print "post: \{k} \{j}"
    m: 0
    n: 0
    for while ({
        n = n + 1
        m < 4
    }) loop {
        m = m + 1
    }
    print "pre: \{m} \{n}"
    s: "abc".string
    t: 0.u64
    for while ({
        v: s.copy
        t = t + v.length
        t < 7
    }) loop null
    print "owned: \{t}"
    if ({
        w: s.copy
        w.length == 3
    }) then print "if: yes" else print "if: no"
}
