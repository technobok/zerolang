# A `.hold` parameter takes its argument as a `.take` one does -- moved in, then
# frozen -- so the callee destroys it and the caller gives it up: a local passed
# as `x.take` is zeroed after the call, and a temporary is handed over whole.
# Each pair calls a `.take` and a `.hold` parameter of the same type (String,
# class, List). The leak kind (ASan) is the judge.
Item: class {
    name: String
    value: i64
}

tS: function {s: String.take} out u64 is {
    return s.length
}

hS: function {s: String.hold} out u64 is {
    return s.length
}

tI: function {it: Item.take} out i64 is {
    return it.value
}

hI: function {it: Item.hold} out i64 is {
    return it.value
}

tL: function {xs: (List String).take} out u64 is {
    return xs.length
}

hL: function {xs: (List String).hold} out u64 is {
    return xs.length
}

main: function is {
    a: "a".string
    b: "b".string
    print "\{tS s: a.take} \{hS s: b.take}"
    print "\{tS s: "t".string} \{hS s: "h".string}"
    i1: Item name: "i1".string value: 1
    i2: Item name: "i2".string value: 2
    print "\{tI it: i1.take} \{hI it: i2.take}"
    print "\{tI it: (Item name: "t".string value: 3)} \{hI it: (Item name: "h".string value: 4)}"
    l1: List String
    l1.append "x".string
    l2: List String
    l2.append "y".string
    print "\{tL xs: l1.take} \{hL xs: l2.take}"
}
