# sync_receiver_off_call.z -- a templated class's method called on a value a
# call computes -- an element `get` hands back, a fresh `create` -- binds the
# value to a temporary for the address its method takes, read as a member or
# called with arguments.

main: function is {
    cvs: List sync.Condvar
    cvs.append sync.Condvar.create
    (cvs.get i: 0).notifyAll
    sync.Condvar.create.notifyOne
    counts: List sync.AtomicI64
    counts.append (sync.AtomicI64.create value: 4)
    print "read \{(counts.get i: 0).load}"
    print "called \{(counts.get i: 0).load order: sync.memoryorder.acquire}"
    print "fresh \{(sync.AtomicI64.create value: 5).load order: sync.memoryorder.relaxed}"
}
