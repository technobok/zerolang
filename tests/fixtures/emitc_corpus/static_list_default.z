# static_list_default.z -- a static list as a member's default: a data field (its
# element type from its elements, or named by `out`, or through an alias), a
# record field and a parameter. A construction or a call that leaves the member
# out takes the list; one that gives another static list takes that one.
texts: staticlist text
part: data {
    tags: list { "core" "base" }
    none: list {} out staticlist text
    short: list {} out texts
    nums: list { 1 2 300 }
    count: 1
}
plain: (part count: 2)
tagged: (part tags: list { "x" } nums: list { 7 })
regions: list { "eu" "us" }
settings: record {
    keys: list { "a" "b" }
    n: 1
}

countOf: function {xs: list { "a" "b" "c" }} out u64 is {
    return xs.length
}

main: function is {
    print "\{plain.tags.length} \{plain.none.length} \{plain.short.length} \{plain.nums.length}"
    print "\{(plain.tags.get i: 1).stringView} \{tagged.tags.length} \{tagged.nums.length}"
    print "\{countOf} \{countOf xs: plain.tags} \{countOf xs: regions}"
    s: settings n: 2
    print "\{s.keys.length} \{s.n}"
}
