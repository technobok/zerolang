# collection_member_of_call.z -- a no-argument member read off a stack
# collection that is a call's result: an element of a List of lists, and a
# list a function returns. The read takes the collection's address, and a
# call's result has none: `(ls.get i: 0).listView` wrote `&z_get(...)`, which
# C rejects. The base is bound to a temporary first, as a method call's
# receiver is, and a returned list the temporary owns is still freed.
mk: function out ListVal u64 is {
    r: ListVal u64
    r.append from: 4
    r.append from: 5
    return r
}

main: function is {
    ls: List (ListVal u64)
    a: ListVal u64
    a.append from: 7
    ls.append a.take
    v: (ls.get i: 0).listView
    print "\{v.length} \{v.get i: 0}"
    print "\{(mk).listView.length} \{((mk).listView.get i: 1)}"
}
