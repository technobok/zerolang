# A List, Set or Map bound from an `if`, a `match` or a do block is the value the
# arm that ran yields: a take out of a local, a construction, a
# call's result, a moved local, a block's last line, a nested `if`. The arm's
# source is left empty on that arm's path, and the binding owns what it got.
Mode: variant {
    fast: null
    slow: null
}

mk: function {n: i64} out (ListVal i64) is {
    l: ListVal i64
    l.append from: n
    l.append from: n + 1
    return l
}

listTake: function {c: bool} out u64 is {
    l: ListVal i64
    l.append 3
    r: if c then l.take else ListVal i64
    return r.length
}

listLocal: function {c: bool} out u64 is {
    l: List String
    l.append from: "a".string
    r: if c then l else (List String)
    return r.length
}

mapTake: function {c: bool} out u64 is {
    m: (Map String V: String)
    m.set key: "a".string value: "b".string
    r: if c then m.take else (Map String V: String)
    return r.length
}

setMatch: function {m: Mode} out u64 is {
    s: Set String
    s.add item: "a".string
    s.add item: "b".string
    r: match (m) case fast then s.take case slow then (Set String)
    return r.length
}

calls: function {c: bool} out u64 is {
    r: if c then (mk n: 1) else (mk n: 5)
    return r.length + (r.get i: 0).u64.orPanic
}

blocks: function {c: bool} out u64 is {
    r: if c then {
        t: ListVal i64
        t.append 1
        t.append 2
        t
    } else {
        if c.not then (mk n: 7) else ListVal i64
    }
    return r.length
}

doBlock: function {} out u64 is {
    r: {
        t: (Map String V: String)
        t.set key: "k".string value: "v".string
        t
    }
    return r.length
}

returned: function {c: bool} out (Map String V: String) is {
    m: (Map String V: String)
    m.set key: "a".string value: "b".string
    return (if c then m.take else (Map String V: String))
}

taken: function {m: (Map String V: String)} out u64 is {
    return m.length
}

inArgument: function {c: bool} out u64 is {
    m: (Map String V: String)
    m.set key: "a".string value: "b".string
    return (taken m: (match (c) case true then m.take case false then (Map String V: String)))
}

main: function is {
    print "listTake \{listTake c: true} \{listTake c: false}"
    print "listLocal \{listLocal c: true} \{listLocal c: false}"
    print "mapTake \{mapTake c: true} \{mapTake c: false}"
    print "setMatch \{setMatch m: Mode.fast} \{setMatch m: Mode.slow}"
    print "calls \{calls c: true} \{calls c: false}"
    print "blocks \{blocks c: true} \{blocks c: false}"
    print "doBlock \{doBlock}"
    print "returned \{(returned c: true).length} \{(returned c: false).length}"
    print "inArgument \{inArgument c: true} \{inArgument c: false}"
}
