# thread_panic.z -- a panic on a thread ends the whole program, with the panic's
# status, before anything after the join runs.

# Boom -- panics on its thread
Boom: class {
    # its number
    n: i64
} as {
    task: thread.Task
    call: function {:this} is {
        panic msg: "boom \{this.n}"
    }
}

main: function is {
    print "before"
    h: thread.spawn task: (Boom n: 1)
    b: h.join
    print "after \{b.n}"
}
