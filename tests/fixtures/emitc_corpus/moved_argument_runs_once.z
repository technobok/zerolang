# an argument moved out of the result of another call -- `(grid.pop).pop` handed
# to a taking parameter, a construction, `set` or `insert` -- runs that inner
# call once, and so does a `.copy` of such a value, bound or reassigned
H: class {
    name: String
}
Q: class {
    rows: List (List String)
    calls: i64
} as {
    popRow: function {this: this.borrow} out (List String) is {
        this.calls = this.calls + 1
        return this.rows.pop
    }
}
mk: function {s: String.take} out u64 is {
    return s.length
}
fill: function {grid: List (List String) count: u64} is {
    k: 0.u64
    for k < count loop {
        grid.append from: (List String)
        (grid.getMut i: grid.length - 1).append from: "x\{k}"
        k = k + 1
    }
}
main: function is {
    grid: List (List String)
    fill :grid count: 12
    v: List String
    v.append from: (grid.pop).pop
    n: mk s: (grid.pop).pop
    m: mk s: grid.pop.pop
    print "\{grid.length} \{v.length} \{n} \{m}"
    old: v.set i: 0 val: (grid.pop).pop
    v.insert from: (grid.pop).pop at: 0
    print "\{grid.length} \{old} \{v.get i: 0} \{v.get i: 1}"
    h: H name: (grid.pop).pop
    x: (grid.pop).pop.copy
    u: "z".string
    u = (grid.pop).pop.copy
    print "\{grid.length} \{h.name} \{x} \{u}"
    q: Q rows: (List (List String)) calls: 0
    fill grid: q.rows count: 2
    w: List String
    w.append from: q.popRow.pop
    w.append from: (q.popRow).pop
    print "\{q.calls} \{q.rows.length} \{w.length}"
}
