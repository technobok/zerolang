# A text constant's search methods fold to an optionval, read by `.or d:`; a
# call with a count known only at run time runs. A user variant's own `or`
# is the one that answers, never the option fold's. A constant `none` read
# through `.none` is the constant `true`: its match needs that arm alone.
I: ("a,b".indexOf needle: ",")
J: ("a,b".splitOnce sep: ",")
P: ("pre-x".stripPrefix p: "pre-")
S: ("x.z".stripSuffix s: ".z")
G: "ab#c"
MISS: G.indexOf "%"

pick: variant {
    none: null
    some: t
} as {
    t: anyval.generic
    or: function {v: this.view d: t} out t is {
        return 99
    }
}
pickI: (pick t: i64)
PN: pickI.none

show: function {k: u64} is {
    print "[\{"ab".repeated n: k}]"
}

main: function is {
    print "\{I.or d: 99} \{J.or d: 99} \{P.or d: "none"} \{S.or d: "none"}"
    show k: 3
    o: optionval.some 3
    x: PN.or d: 5
    print "\{x} \{o.or d: 0}"
    match MISS.none case true then print "none"
}
