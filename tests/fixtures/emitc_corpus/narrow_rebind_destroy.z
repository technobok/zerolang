# narrow_rebind_destroy.z -- rebinding a union local INSIDE a branch that
# narrowed it. The rebind replaces the whole variable, so it destroys the
# variable's declared type; the occurrence is stamped with the narrowed arm's
# payload type, whose destructor answers for the payload alone, and taking
# that answer leaked the arm the variable still held.
Pay: class {
    n: i64
}
Sum: union {
    one: Pay
    two: null
}
inBranch: function out bool is {
    s: Sum.one (Pay n: 3)
    if s.one then {
        s = Sum.two
    }
    return s.two
}
atStatement: function out bool is {
    s: Sum.one (Pay n: 4)
    s = Sum.two
    return s.two
}
inMatchArm: function out bool is {
    s: Sum.one (Pay n: 5)
    match (
        s
    ) case one then {
        s = Sum.two
    } else null
    return s.two
}
main: function is {
    print "\{inBranch} \{atStatement} \{inMatchArm}"
}
