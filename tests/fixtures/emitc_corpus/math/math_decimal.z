        want: "0.02"
    )
    over: (math.decimal32 precision: 9 scale: 2).parse text: "9999999.999"
    match (
        over
    ) case ok then truth :t what: "decimal32_9_2 parse overflow" ok: false case err then (truth
        :t
        what: "decimal32_9_2 parse overflow"
        ok: true
    )
    bad: (math.decimal32 precision: 9 scale: 2).parse text: "1.2x"
    match (
        bad
    ) case ok then truth :t what: "decimal32_9_2 parse bad" ok: false case err then (truth
        :t
        what: "decimal32_9_2 parse bad"
        ok: true
    )
    (same
        :t
        what: "decimal32_9_2 fromRat -7/3 toNearestEven"
        got: ((math.decimal32 precision: 9 scale: 2).fromRat
            from: (math.BigRat.fromFraction num: (math.BigInt from: -7) den: (math.BigInt from: 3))
            mode: math.roundingmode.toNearestEven
        ).string
        want: "-2.33"
    )
    (same
        :t
