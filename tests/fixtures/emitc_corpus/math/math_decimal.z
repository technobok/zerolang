# decimal32_5_0 -- (math.decimal32 precision: 5 scale: 0): 20 values
decimal32_5_0: function {t: Tally.borrow} is {
    vs: ListVal (math.decimal32 precision: 5 scale: 0)
    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "0").orPanic
    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "1").orPanic
