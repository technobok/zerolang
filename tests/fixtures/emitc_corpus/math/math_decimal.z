    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "69533").orPanic
    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "-53384").orPanic
    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "66871").orPanic
    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "-68730").orPanic
    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "230").orPanic
    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "-757").orPanic
    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "-952").orPanic
    vs.append from: ((math.decimal32 precision: 5 scale: 0).parse text: "687").orPanic
    dAdd: 14695981039346656037.u64
    dSub: dAdd
    dMul: dAdd
    dDiv: dAdd
    dCmp: dAdd
    for each a: vs loop {
        for each b: vs loop {
            {
                r: a + b
                rc: r.checked
                match (
                    rc
                ) case ok then dAdd = fold d: dAdd h: r.coef.i64.bits case err then {
                    match (
                        rc
                    ) case overflow then dAdd = (fold
                        d: dAdd
                        h: 208
                    ) case divisionByZero then dAdd = fold d: dAdd h: 209
