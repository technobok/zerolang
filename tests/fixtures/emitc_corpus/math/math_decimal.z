# math_decimal.z -- math's fixed decimals at several (precision, scale) each,
# against Python's exact integers on the coefficients: + and - exact, * and /
# rounded half-even to the scale, overflow and division by zero invalid. Each
# operator's results over every pair of a value table fold into one digest per
# instance (an invalid one its reason, a valid one its coefficient); text,
# parse, fromRat in every rounding mode, the order, the conversions and the
# sticky invalid paths are checked value by value. Generated by
# decimaltables.py.

# the failures, and the checks run
Tally: class {
    checks: u64
    bad: u64
}

# big -- a BigInt from decimal text the test spells correctly
big: function {text: StringView} out math.BigInt is {
    r: math.BigInt.parse :text base: 10
    match r case ok then return r.take case err then panic msg: "bad test text"
}

# fold -- the FNV-1a step every digest takes
fold: function {d: u64 h: u64} out u64 is {
    return ((d ^ h).mulWide rhs: 1099511628211).lo
}

# digest -- one check: a digest against the oracle's
digest: function {t: Tally.borrow what: StringView got: u64 want: u64} is {
    t.checks = t.checks + 1
    if got != want then {
        t.bad = t.bad + 1
        print "FAIL \{what}: digest \{got}, want \{want}"
    }
}

# same -- one check: the two texts agree
same: function {t: Tally.borrow what: StringView got: String.view want: StringView} is {
    t.checks = t.checks + 1
    if got != want then {
        t.bad = t.bad + 1
        print "FAIL \{what}: \{got}, want \{want}"
    }
}

# truth -- one check: the condition holds
truth: function {t: Tally.borrow what: StringView ok: bool} is {
    t.checks = t.checks + 1
    if ok.not then {
        t.bad = t.bad + 1
        print "FAIL \{what}"
    }
}


# decimal32_9_2 -- (math.decimal32 precision: 9 scale: 2): 24 values
decimal32_9_2: function {t: Tally.borrow} is {
    vs: ListVal (math.decimal32 precision: 9 scale: 2)
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "0.00").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "0.01").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "-0.01").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "9999999.99").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "-9999999.99").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "0.02").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "0.07").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "-0.13").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "1.00").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "0.50").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "-1.00").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "1.50").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "1000000.00").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "5000000.00").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "-9295380.48").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "4775923.99").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "-5576763.38").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "482521.85").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "-8803409.16").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "9309869.95").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "858.51").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "822.22").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "-271.41").orPanic
    vs.append from: ((math.decimal32 precision: 9 scale: 2).parse text: "-814.88").orPanic
    dAdd: 14695981039346656037.u64
    dSub: dAdd
    dMul: dAdd
    dDiv: dAdd
    dCmp: dAdd
    for each a: vs loop {
        for each b: vs loop {
            {
                r: a + b
                rc: r.checked
                match (
                    rc
                ) case ok then dAdd = fold d: dAdd h: r.coef.i64.bits case err then {
                    match (
                        rc
                    ) case overflow then dAdd = (fold
                        d: dAdd
                        h: 208
                    ) case divisionByZero then dAdd = fold d: dAdd h: 209
                }
            }
            {
                r: a - b
                rc: r.checked
                match (
                    rc
                ) case ok then dSub = fold d: dSub h: r.coef.i64.bits case err then {
                    match (
                        rc
                    ) case overflow then dSub = (fold
                        d: dSub
                        h: 208
                    ) case divisionByZero then dSub = fold d: dSub h: 209
                }
            }
            {
                r: a * b
                rc: r.checked
                match (
                    rc
                ) case ok then dMul = fold d: dMul h: r.coef.i64.bits case err then {
                    match (
                        rc
                    ) case overflow then dMul = (fold
                        d: dMul
                        h: 208
                    ) case divisionByZero then dMul = fold d: dMul h: 209
                }
            }
            {
                r: a / b
                rc: r.checked
                match (
                    rc
                ) case ok then dDiv = fold d: dDiv h: r.coef.i64.bits case err then {
                    match (
                        rc
                    ) case overflow then dDiv = (fold
                        d: dDiv
                        h: 208
                    ) case divisionByZero then dDiv = fold d: dDiv h: 209
                }
            }
            dCmp = fold d: dCmp h: (a.compare rhs: b).i64.bits
        }
        (truth
            :t
            what: "decimal32_9_2 text round trip"
            ok: (
                ((math.decimal32 precision: 9 scale: 2).parse text: a.string.stringView).orPanic ==
                a
            )
        )
        (truth
            :t
            what: "decimal32_9_2 rat round trip"
            ok: (
                ((math.decimal32 precision: 9 scale: 2).fromRat
                    from: a.rat
                    mode: math.roundingmode.toZero
                ) ==
                a
            )
        )
    }
    digest :t what: "decimal32_9_2 +" got: dAdd want: 1804463045579771361
    digest :t what: "decimal32_9_2 -" got: dSub want: 1239975496649991025
    digest :t what: "decimal32_9_2 *" got: dMul want: 13993870205628624678
    digest :t what: "decimal32_9_2 /" got: dDiv want: 12274014729631715381
    digest :t what: "decimal32_9_2 compare" got: dCmp want: 12811822256286347605
    (same
        :t
        what: "decimal32_9_2 max"
        got: ((math.decimal32 precision: 9 scale: 2).fromCoef from: 999999999).string
        want: "9999999.99"
    )
    (same
        :t
        what: "decimal32_9_2 -max"
        got: ((math.decimal32 precision: 9 scale: 2).fromCoef from: -999999999).string
        want: "-9999999.99"
    )
    (truth
        :t
        what: "decimal32_9_2 max+1 invalid"
        ok: (
            ((math.decimal32 precision: 9 scale: 2).fromCoef from: 999999999) +
            ((math.decimal32 precision: 9 scale: 2).fromCoef from: 1)
        ).isInvalid
    )
    (same
        :t
        what: "decimal32_9_2 invalid text"
        got: (
            ((math.decimal32 precision: 9 scale: 2).fromCoef from: 999999999) +
            ((math.decimal32 precision: 9 scale: 2).fromCoef from: 1)
        ).string
        want: "invalid"
    )
    zero: (math.decimal32 precision: 9 scale: 2) from: 0
    one: (math.decimal32 precision: 9 scale: 2).fromCoef from: 1
    div0: one / zero
    truth :t what: "decimal32_9_2 x/0 invalid" ok: div0.isInvalid
    (truth
        :t
        what: "decimal32_9_2 invalid is sticky"
        ok: (div0 + one).isInvalid and (one * div0).isInvalid and (div0 - div0).isInvalid
    )
    (truth
        :t
        what: "decimal32_9_2 invalid == invalid"
        ok: (div0 == (one / zero)) and (div0 != one) and (div0.hash == (one / zero).hash)
    )
    rc0: div0.checked
    match (
        rc0
    ) case ok then truth :t what: "decimal32_9_2 /0 reason" ok: false case err then {
        match (
            rc0
        ) case divisionByZero then (truth
            :t
            what: "decimal32_9_2 /0 reason"
            ok: true
        ) case overflow then truth :t what: "decimal32_9_2 /0 reason" ok: false
    }
    dflt: math.decimal32 precision: 9 scale: 2
    truth :t what: "decimal32_9_2 zero is default" ok: dflt == zero
    (same
        :t
        what: "decimal32_9_2 parse half to even"
        got: ((math.decimal32 precision: 9 scale: 2).parse text: "0.005").orPanic.string
        want: "0.00"
    )
    (same
