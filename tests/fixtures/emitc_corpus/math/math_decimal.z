    digest :t what: "decimal32_5_0 +" got: dAdd want: 5702897283441099661
    digest :t what: "decimal32_5_0 -" got: dSub want: 14006958856492267285
    digest :t what: "decimal32_5_0 *" got: dMul want: 11545579129698835681
