    composite :t c: "161027"
    composite :t c: "162133"
    composite :t c: "189419"
    composite :t c: "218321"
    composite :t c: "231703"
    composite :t c: "249331"
    composite :t c: "370229"
    composite :t c: "429479"
    composite :t c: "430127"
    composite :t c: "459191"
    composite :t c: "473891"
    composite :t c: "480689"
    composite :t c: "600059"
    composite :t c: "621781"
    composite :t c: "632249"
    composite :t c: "635627"
    composite :t c: "3673744903"
    composite :t c: "3281593591"
    composite :t c: "2385076987"
    composite :t c: "2738053141"
    composite :t c: "2009621503"
    composite :t c: "1502682721"
    composite :t c: "255866131"
    composite :t c: "117987841"
    composite :t c: "587861"
    composite :t c: "6368689"
    composite :t c: "8725753"
    composite :t c: "80579735209"
    composite :t c: "105919633"
    if t.bad == 0 then {
        print "ok \{t.checks} checks"
    } else {
        print "\{t.bad} of \{t.checks} checks FAILED"
    }
}
