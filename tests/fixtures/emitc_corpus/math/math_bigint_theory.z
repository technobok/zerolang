# math_bigint_theory.z -- Go's tables for BigInt's number theory, every row:
# expTests (x^y mod m; an empty m is no modulus, and the one row Go answers
# nil -- no inverse for a negative exponent -- is checked as modInverse's none),
# Issue22830, gcdTests (the gcd and both cofactors), modInverseTests (checked
# as Go checks them: g * g^-1 mod n == 1), the Jacobi cases, TestSqrt (every
# root below 10000 and the powers of ten), and prime_test's primes and
# composites at 20, 1 and 0 Miller-Rabin rounds.

# the failures, and the checks run
Tally: class {
    checks: u64
    bad: u64
}

# num -- a BigInt from text the test spells correctly, in base 0
num: function {text: StringView} out math.BigInt is {
    r: math.BigInt.parse :text base: 0
    match r case ok then return r.take case err then panic msg: "bad test text"
}

# same -- one check: the two values are equal
same: function {t: Tally.borrow what: String got: math.BigInt.view want: math.BigInt.view} is {
    t.checks = t.checks + 1
    if got != want then {
        t.bad = t.bad + 1
        print "FAIL \{what}: \{got.string}, want \{want.string}"
    }
}

# truth -- one check of a property
truth: function {t: Tally.borrow what: String ok: bool} is {
    t.checks = t.checks + 1
    if ok.not then {
        t.bad = t.bad + 1
        print "FAIL \{what}"
    }
}

# exp -- one expTests row; an empty m is no modulus
exp: function {t: Tally.borrow x: StringView y: StringView m: StringView want: StringView} is {
    mv: math.BigInt from: 0
    if m.length > 0 then mv = num text: m
    xv: num text: x
    yv: num text: y
    same :t what: "\{x}^\{y} mod \{m}" got: (xv.exp y: yv m: mv) want: (num text: want)
}

# gcd -- one gcdTests row: d = gcd(a, b) = a*x + b*y
gcd: function {
    t: Tally.borrow d: StringView x: StringView y: StringView a: StringView b: StringView
} is {
    av: num text: a
    bv: num text: b
    g: av.gcdExtended y: bv
    same :t what: "gcd(\{a}, \{b})" got: g.gcd want: (num text: d)
    same :t what: "x of gcd(\{a}, \{b})" got: g.x want: (num text: x)
    same :t what: "y of gcd(\{a}, \{b})" got: g.y want: (num text: y)
    same :t what: "gcd(\{a}, \{b}) alone" got: (av.gcd y: bv) want: (num text: d)
}

# inverse -- one modInverseTests row: g * g^-1 mod n == 1
inverse: function {t: Tally.borrow g: StringView n: StringView} is {
    gv: num text: g
    nv: num text: n
    inv: gv.modInverse n: nv
    match (
        inv
    ) case some then {
        one: (gv * inv).mod by: nv.abs
        same :t what: "\{g} * \{g}^-1 mod \{n}" got: one want: (math.BigInt from: 1)
    } case none then {
        truth :t what: "\{g} has an inverse mod \{n}" ok: false
    }
}

# jacobi -- one Jacobi case
jacobi: function {t: Tally.borrow x: i64 y: i64 want: i32} is {
    xv: math.BigInt from: x
    yv: math.BigInt from: y
    truth :t what: "jacobi(\{x}, \{y}) == \{want}" ok: (xv.jacobi y: yv) == want
}

# prime -- a prime of prime_test, at 20, 1 and 0 rounds
prime: function {t: Tally.borrow p: StringView} is {
    v: num text: p
    (truth
        :t
        what: "\{p} is prime"
        ok: (v.probablyPrime n: 20) and (v.probablyPrime n: 1) and (v.probablyPrime n: 0)
    )
}

# composite -- a composite of prime_test, at 20, 1 and 0 rounds
composite: function {t: Tally.borrow c: StringView} is {
    v: num text: c
    (truth
        :t
        what: "\{c} is composite"
        ok: (
            (v.probablyPrime n: 20).not and
            (v.probablyPrime n: 1).not and
            (v.probablyPrime n: 0).not
        )
    )
}

main: function is {
    t: Tally checks: 0 bad: 0
    exp :t x: "0" y: "0" m: "" want: "1"
    exp :t x: "1" y: "0" m: "" want: "1"
    exp :t x: "-10" y: "0" m: "" want: "1"
    exp :t x: "1234" y: "-1" m: "" want: "1"
    exp :t x: "1234" y: "-1" m: "0" want: "1"
    exp :t x: "17" y: "-100" m: "1234" want: "865"
    # no inverse for 2 mod 1234: Go answers nil
    (truth
        :t
        what: "2 has no inverse mod 1234"
        ok: ((num text: "2").modInverse n: (num text: "1234")).none
    )
    exp :t x: "0" y: "0" m: "1" want: "0"
    exp :t x: "1" y: "0" m: "1" want: "0"
    exp :t x: "-10" y: "0" m: "1" want: "0"
    exp :t x: "1234" y: "-1" m: "1" want: "0"
    exp :t x: "5" y: "1" m: "3" want: "2"
    exp :t x: "5" y: "-7" m: "" want: "1"
    exp :t x: "-5" y: "-7" m: "" want: "1"
    exp :t x: "5" y: "0" m: "" want: "1"
    exp :t x: "-5" y: "0" m: "" want: "1"
    exp :t x: "5" y: "1" m: "" want: "5"
    exp :t x: "-5" y: "1" m: "" want: "-5"
    exp :t x: "-5" y: "1" m: "7" want: "2"
    exp :t x: "-2" y: "3" m: "2" want: "0"
    exp :t x: "5" y: "2" m: "" want: "25"
    exp :t x: "1" y: "65537" m: "2" want: "1"
    exp :t x: "0x8000000000000000" y: "2" m: "" want: "0x40000000000000000000000000000000"
    exp :t x: "0x8000000000000000" y: "2" m: "6719" want: "4944"
    exp :t x: "0x8000000000000000" y: "3" m: "6719" want: "5447"
    exp :t x: "0x8000000000000000" y: "1000" m: "6719" want: "1603"
    exp :t x: "0x8000000000000000" y: "1000000" m: "6719" want: "3199"
    exp :t x: "0x8000000000000000" y: "-1000000" m: "6719" want: "3663"
    (exp
        :t
        x: "0xffffffffffffffffffffffffffffffff"
        y: "0x12345678123456781234567812345678123456789"
        m: "0x01112222333344445555666677778889"
        want: "0x36168FA1DB3AAE6C8CE647E137F97A"
    )
    (exp
        :t
        x: "2938462938472983472983659726349017249287491026512746239764525612965293865296239471239874193284792387498274256129746192347"
        y: "298472983472983471903246121093472394872319615612417471234712061"
        m: "29834729834729834729347290846729561262544958723956495615629569234729836259263598127342374289365912465901365498236492183464"
        want: "23537740700184054162508175125554701713153216681790245129157191391322321508055833908509185839069455749219131480588829346291"
    )
    (exp
        :t
        x: ""
        y: "0xB08FFB20760FFED58FADA86DFEF71AD72AA0FA763219618FE022C197E54708BB1191C66470250FCE8879487507CEE41381CA4D932F81C2B3F1AB20B539D50DCD"
        m: ""
        want: ""
    )
    (exp
        :t
        x: "-"
        y: "0xB08FFB20760FFED58FADA86DFEF71AD72AA0FA763219618FE022C197E54708BB1191C66470250FCE8879487507CEE41381CA4D932F81C2B3F1AB20B539D50DCD"
        m: ""
        want: ""
    )
    exp :t x: "0xffffffff00000001" y: "0xffffffff00000001" m: "0xffffffff00000001" want: "0"
    (exp
        :t
        x: "0xffffffffffffffff00000001"
        y: "0xffffffffffffffff00000001"
        m: "0xffffffffffffffff00000001"
        want: "0"
    )
    (exp
        :t
        x: "0xffffffffffffffffffffffff00000001"
        y: "0xffffffffffffffffffffffff00000001"
        m: "0xffffffffffffffffffffffff00000001"
        want: "0"
    )
    (exp
        :t
        x: "0xffffffffffffffffffffffffffffffff00000001"
        y: "0xffffffffffffffffffffffffffffffff00000001"
        m: "0xffffffffffffffffffffffffffffffff00000001"
        want: "0"
    )
    # Issue22830: an exponent of 1 against a modulus
    exp :t x: "84555555300000000000" y: "1" m: "66666670001111111111" want: "17888885298888888889"
    gcd :t d: "0" x: "0" y: "0" a: "0" b: "0"
    gcd :t d: "7" x: "0" y: "1" a: "0" b: "7"
    gcd :t d: "7" x: "0" y: "-1" a: "0" b: "-7"
    gcd :t d: "11" x: "1" y: "0" a: "11" b: "0"
    gcd :t d: "7" x: "-1" y: "-2" a: "-77" b: "35"
    gcd :t d: "935" x: "-3" y: "8" a: "64515" b: "24310"
    gcd :t d: "935" x: "-3" y: "-8" a: "64515" b: "-24310"
    gcd :t d: "935" x: "3" y: "-8" a: "-64515" b: "-24310"
    gcd :t d: "1" x: "-9" y: "47" a: "120" b: "23"
    gcd :t d: "7" x: "1" y: "-2" a: "77" b: "35"
    gcd :t d: "935" x: "-3" y: "8" a: "64515" b: "24310"
    (gcd
        :t
        d: "935000000000000000"
        x: "-3"
        y: "8"
        a: "64515000000000000000"
        b: "24310000000000000000"
    )
    (gcd
        :t
        d: "1"
        x: "-221"
        y: "22059940471369027483332068679400581064239780177629666810348940098015901108344"
        a: "98920366548084643601728869055592650835572950932266967461790948584315647051443"
        b: "991"
    )
    inverse :t g: "1234567" n: "458948883992"
    (inverse
        :t
        g: "239487239847"
        n: ""
    )
    inverse :t g: "-10" n: "13"
    inverse :t g: "10" n: "-13"
    inverse :t g: "-17" n: "-13"
    jacobi :t x: 0 y: 1 want: 1
    jacobi :t x: 0 y: -1 want: 1
    jacobi :t x: 1 y: 1 want: 1
    jacobi :t x: 1 y: -1 want: 1
    jacobi :t x: 0 y: 5 want: 0
    jacobi :t x: 1 y: 5 want: 1
    jacobi :t x: 2 y: 5 want: -1
    jacobi :t x: -2 y: 5 want: -1
    jacobi :t x: 2 y: -5 want: -1
    jacobi :t x: -2 y: -5 want: 1
    jacobi :t x: 3 y: 5 want: -1
    jacobi :t x: 5 y: 5 want: 0
    jacobi :t x: -5 y: 5 want: 0
    jacobi :t x: 6 y: 5 want: 1
    jacobi :t x: 6 y: -5 want: 1
    jacobi :t x: -6 y: 5 want: 1
    jacobi :t x: -6 y: -5 want: -1
    # TestSqrt: every square root below 10000, then 1e(2k)
    root: i64
    i: i64
    for i < 10000 loop {
        if (root + 1 * (root + 1)) <= i then root = root + 1
        same :t what: "sqrt \{i}" got: (math.BigInt from: i).sqrt want: (math.BigInt from: root)
        i = i + 1
    }
    k: u64
    for k < 1000 loop {
        ten: math.BigInt from: 10
        (same
            :t
            what: "sqrt 1e\{k}"
            got: (ten.exp y: (math.BigInt.fromU64 from: k) m: (math.BigInt from: 0)).sqrt
            want: (ten.exp y: (math.BigInt.fromU64 from: k / 2) m: (math.BigInt from: 0))
        )
        k = k + 10
    }
    prime :t p: "2"
    prime :t p: "3"
    prime :t p: "5"
    prime :t p: "7"
    prime :t p: "11"
    prime :t p: "13756265695458089029"
    prime :t p: "13496181268022124907"
    prime :t p: "10953742525620032441"
    prime :t p: "17908251027575790097"
    prime :t p: "18699199384836356663"
    prime :t p: "98920366548084643601728869055592650835572950932266967461790948584315647051443"
    prime :t p: "94560208308847015747498523884063394671606671904944666360068158221458669711639"
    (prime
        :t
        p: "449417999055441493994709297093108513015373787049558499205492347871729927573118262811508386655998299074566974373711472560655026288668094291699357843464363003144674940345912431129144354948751003607115263071543163"
    )
    (prime
        :t
        p: "230975859993204150666423538988557839555560243929065415434980904258310530753006723857139742334640122533598517597674807096648905501653461687601339782814316124971547968912893214002992086353183070342498989426570593"
    )
    (prime
        :t
        p: "5521712099665906221540423207019333379125265462121169655563495403888449493493629943498064604536961775110765377745550377067893607246020694972959780839151452457728855382113555867743022746090187341871655890805971735385789993"
    )
    (prime
        :t
        p: ""
    )
    prime :t p: "3618502788666131106986593281521497120414687020801267626233049500247285301239"
    prime :t p: "57896044618658097711785492504343953926634992332820282019728792003956564819949"
    (prime
        :t
        p: "9850501549098619803069760025035903451269934817616361666987073351061430442874302652853566563721228910201656997576599"
    )
    (prime
        :t
        p: "42307582002575910332922579714097346549017899709713998034217522897561970639123926132812109468141778230245837569601494931472367"
    )
    (prime
        :t
        p: "6864797660130609714981900799081393217269435300143305409394463459185543183397656052122559640661454554977296311391480858037121987999716643812574028291115057151"
    )
    composite :t c: "0"
    composite :t c: "1"
    composite :t c: "21284175091214687912771199898307297748211672914763848041968395774954376176754"
    composite :t c: "6084766654921918907427900243509372380954290099172559290432744450051395395951"
    composite :t c: "84594350493221918389213352992032324280367711247940675652888030554255915464401"
    composite :t c: "82793403787388584738507275144194252681"
    composite :t c: "1195068768795265792518361315725116351898245581"
    (composite
        :t
        c: ""
    )
    composite :t c: "989"
    composite :t c: "3239"
    composite :t c: "5777"
    composite :t c: "10877"
    composite :t c: "27971"
    composite :t c: "29681"
    composite :t c: "30739"
    composite :t c: "31631"
    composite :t c: "39059"
    composite :t c: "72389"
