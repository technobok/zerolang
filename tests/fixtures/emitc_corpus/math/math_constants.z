# math_constants.z -- math's untyped constants land, as f32 and as their f64
# default, as the value each format holds nearest the true constant: rounded
# once from the digits, against the bit patterns an exact rational oracle
# gives (work/zerolang/tools, rattables.round_bin).

# the failures, and the checks run
Tally: class {
    checks: u64
    bad: u64
}

# truth -- one check of a fact
truth: function {t: Tally.borrow what: StringView ok: bool} is {
    t.checks = t.checks + 1
    if ok.not then {
        t.bad = t.bad + 1
        print "FAIL \{what}"
    }
}

# landF32 -- an f32 as an argument lands
landF32: function {x: f32} out f32 is {
    return x
}

main: function is {
    t: Tally checks: 0 bad: 0
    truth :t what: "pi" ok: (math.pi.f32.bits == 1078530011) and (math.pi.bits == 4614256656552045848) and ((landF32 x: math.pi).bits == 1078530011)
    truth :t what: "e" ok: (math.e.f32.bits == 1076754516) and (math.e.bits == 4613303445314885481) and ((landF32 x: math.e).bits == 1076754516)
    truth :t what: "phi" ok: (math.phi.f32.bits == 1070537661) and (math.phi.bits == 4609965796441453736) and ((landF32 x: math.phi).bits == 1070537661)
    truth :t what: "sqrt2" ok: (math.sqrt2.f32.bits == 1068827891) and (math.sqrt2.bits == 4609047870845172685) and ((landF32 x: math.sqrt2).bits == 1068827891)
    truth :t what: "sqrtE" ok: (math.sqrtE.f32.bits == 1070795084) and (math.sqrtE.bits == 4610103999673009820) and ((landF32 x: math.sqrtE).bits == 1070795084)
    truth :t what: "sqrtPi" ok: (math.sqrtPi.f32.bits == 1071833029) and (math.sqrtPi.bits == 4610661241675116395) and ((landF32 x: math.sqrtPi).bits == 1071833029)
    truth :t what: "sqrtPhi" ok: (math.sqrtPhi.f32.bits == 1067635082) and (math.sqrtPhi.bits == 4608407486392206422) and ((landF32 x: math.sqrtPhi).bits == 1067635082)
    truth :t what: "ln2" ok: (math.ln2.f32.bits == 1060205080) and (math.ln2.bits == 4604418534313441775) and ((landF32 x: math.ln2).bits == 1060205080)
    truth :t what: "log2E" ok: (math.log2E.f32.bits == 1069066811) and (math.log2E.bits == 4609176140021203710) and ((landF32 x: math.log2E).bits == 1069066811)
    truth :t what: "ln10" ok: (math.ln10.f32.bits == 1075010958) and (math.ln10.bits == 4612367379483415830) and ((landF32 x: math.ln10).bits == 1075010958)
    truth :t what: "log10E" ok: (math.log10E.f32.bits == 1054759897) and (math.log10E.bits == 4601495173785380110) and ((landF32 x: math.log10E).bits == 1054759897)
    if t.bad == 0 then print "ok \{t.checks} checks" else print "\{t.bad} of \{t.checks} checks failed"
}
