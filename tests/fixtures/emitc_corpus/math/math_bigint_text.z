# math_bigint_text.z -- BigInt.text over sample bases 2 to 62: each row names
# an operand by word count, word pattern and sign, built here exactly as the
# generator built it, with the FNV-1a-64 digest of its text in the base, and
# parse reads that text back to the operand. Lengths run past the
# divide-and-conquer conversion's 8-word leaves to 100 words; the power-of-two
# bases read their digits straight off the bits. Generated by mathtables.py.

# the digests' failures, and the rows run
Tally: class {
    rows: u64
    bad: u64
}

# splitMix -- the next SplitMix64 word, advancing the state
splitMix: function {state: (ListVal u64).borrow} out u64 is {
    s: (state.get i: 0).addCarry rhs: 11400714819323198485 carry: 0
    state.set i: 0 val: s.value
    z: s.value
    z = ((z ^ (z >> 30)).mulWide rhs: 13787848793156543929).lo
    z = ((z ^ (z >> 27)).mulWide rhs: 10723151780598845931).lo
    return z ^ (z >> 31)
}

# wordOf -- the BigInt of one word
wordOf: function {w: u64} out math.BigInt is {
    hi: math.BigInt from: ((w >> 32).i64.or d: 0)
    lo: math.BigInt from: ((w & 4294967295).i64.or d: 0)
    return hi * (math.BigInt from: 4294967296) + lo
}

# operand -- the operand a row's code names: words*100 + pattern*10 + sign,
# most significant word built first
operand: function {code: u64} out math.BigInt is {
    n: code / 100
    pat: code / 10 % 10
    neg: (code % 2) == 1
    ws: ListVal u64
    state: ListVal u64
    state.append from: n
    i: u64
    for i < n loop {
        w: u64
        if pat == 0 then w = 18446744073709551615
        if pat == 1 then {
            if (i % 2) == 0 then w = 18446744073709551615
        }
        if pat == 2 then w = 9223372036854775808
        if pat == 3 then w = splitMix :state
        if pat == 4 when i == (n - 1) then w = 1
        ws.append from: w
        i = i + 1
    }
    base: (math.BigInt from: 4294967296) * (math.BigInt from: 4294967296)
    acc: math.BigInt from: 0
    j: ws.length
    for j > 0 loop {
        j = j - 1
        acc = acc * base + (wordOf w: (ws.get i: j))
    }
    if neg then acc = (math.BigInt from: 0) - acc
    return acc
}

# fnv -- FNV-1a-64 of a text
fnv: function {text: StringView} out u64 is {
    h: 14695981039346656037.u64
    i: u64
    for i < text.length loop {
        h = h ^ ((text.byteAt :i).or d: 0).u64
        h = (h.mulWide rhs: 1099511628211).lo
        i = i + 1
    }
    return h
}

# row -- one table row: the digest of a's text in the base, and the text
# parsed back in the base
row: function {t: Tally.borrow a: u64 base: u64 want: u64} is {
    x: operand code: a
    text: x.text :base
    got: fnv text: text.stringView
    t.rows = t.rows + 1
    if got != want then {
        t.bad = t.bad + 1
        print "FAIL a=\{a} base \{base}: got \{got} want \{want}"
    }
    back: math.BigInt.parse text: text.stringView :base
    match (
        back
    ) case ok then {
        if back.string != x.string then {
            t.bad = t.bad + 1
            print "FAIL a=\{a} base \{base}: parsed back as \{back.string}"
        }
    } case err then {
        t.bad = t.bad + 1
        print "FAIL a=\{a} base \{base}: its own text refused"
    }
}

