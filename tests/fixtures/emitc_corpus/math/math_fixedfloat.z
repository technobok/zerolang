# math_fixedfloat.z -- math's fixed binary floats, (float words: N), against
# Python's exact rationals rounded once to 64N mantissa bits, ties to even.
# Every operator over every pair of a value table, and each value's square root,
# fold into one digest per operator and width: the sign, the form, the exponent
# and the mantissa's words, read from the value's own fields. Generated by
# fixedfloattables.py.

# the failures, and the checks run
Tally: class {
    checks: u64
    bad: u64
}

# fold -- the FNV-1a step every digest takes
fold: function {d: u64 h: u64} out u64 is {
    return ((d ^ h).mulWide rhs: 1099511628211).lo
}

# digest -- one check: a digest against the oracle's
digest: function {t: Tally.borrow what: StringView got: u64 want: u64} is {
    t.checks = t.checks + 1
    if got != want then {
        t.bad = t.bad + 1
        print "FAIL \{what}: digest \{got}, want \{want}"
    }
}

# truth -- one check: the condition holds
truth: function {t: Tally.borrow what: StringView ok: bool} is {
    t.checks = t.checks + 1
    if ok.not then {
        t.bad = t.bad + 1
        print "FAIL \{what}"
    }
}


# fields1 -- a (math.float words: 1)'s fields folded into d
fields1: function {d: u64 x: (math.float words: 1).view} out u64 is {
    r: d
    s: u64
    if x.negative then s = 1
    f: u64
    if x.form.finite then f = 1
    if x.form.inf then f = 2
    if x.form.zero then {
        r = fold d: r h: 0
        r = fold d: r h: 0
        return (fold d: r h: 0)
    }
    r = fold d: r h: s
    r = fold d: r h: f
    r = fold d: r h: x.exp.i64.bits
    i: u64
    for i < 1 loop {
        r = fold d: r h: (x.mant.get :i)
        i = i + 1
    }
    return r
}

# float1 -- (math.float words: 1): 14 values
float1: function {t: Tally.borrow} is {
    vs: ListVal (math.float words: 1)
    vs.append from: ((math.float words: 1).parse text: "0").orPanic
    vs.append from: ((math.float words: 1).parse text: "1").orPanic
    vs.append from: ((math.float words: 1).parse text: "-1").orPanic
    vs.append from: ((math.float words: 1).parse text: "3").orPanic
    vs.append from: ((math.float words: 1).parse text: "0.1").orPanic
    vs.append from: ((math.float words: 1).parse text: "-2.5").orPanic
    vs.append from: ((math.float words: 1).parse text: "1e300").orPanic
    vs.append from: ((math.float words: 1).parse text: "-1e-300").orPanic
    vs.append from: ((math.float words: 1).parse text: "123456789012345678901234567890").orPanic
    (vs.append
        from: ((math.float words: 1).parse
            text: "0.3333333333333333333333333333333333333333333333333333333"
        ).orPanic
    )
    vs.append from: ((math.float words: 1).parse text: "18446744073709551617").orPanic
    vs.append from: ((math.float words: 1).parse text: "-7.25e-20").orPanic
    vs.append from: ((math.float words: 1).parse text: "1e-5000").orPanic
    vs.append from: ((math.float words: 1).parse text: "6.02214076e23").orPanic
    dParse: 14695981039346656037.u64
    dAdd: dParse
    dSub: dParse
    dMul: dParse
    dDiv: dParse
    dSqrt: dParse
    dCmp: dParse
    for each a: vs loop {
        dParse = fields1 d: dParse x: a
        if a.sign >= 0 then dSqrt = fields1 d: dSqrt x: a.sqrt
        for each b: vs loop {
            dAdd = fields1 d: dAdd x: a + b
            dSub = fields1 d: dSub x: a - b
            dMul = fields1 d: dMul x: a * b
            if b.sign != 0 then dDiv = fields1 d: dDiv x: a / b
            dCmp = fold d: dCmp h: (a.compare rhs: b).i64.bits
        }
        truth :t what: "float1 big round trip" ok: ((math.float words: 1).fromBig from: a.big) == a
        truth :t what: "float1 neg neg" ok: a.neg.neg == a
    }
    digest :t what: "float1 parse" got: dParse want: 2952785485374443142
    digest :t what: "float1 +" got: dAdd want: 16708912581364724739
    digest :t what: "float1 -" got: dSub want: 13396913859199550704
    digest :t what: "float1 *" got: dMul want: 14146480588210564420
    digest :t what: "float1 /" got: dDiv want: 18197580144133470471
    digest :t what: "float1 sqrt" got: dSqrt want: 15025584157938951111
    digest :t what: "float1 compare" got: dCmp want: 6202550370498635581
    inf: (math.float words: 1).inf negative: false
    one: (math.float words: 1) from: 1.0
    truth :t what: "float1 inf + 1" ok: (inf + one).isInf and ((inf + one).sign == 1)
    truth :t what: "float1 1 / inf" ok: (one / inf).sign == 0
    truth :t what: "float1 -0 == 0" ok: (one - one).neg == ((math.float words: 1) from: 0.0)
    truth :t what: "float1 f64 exact" ok: ((math.float words: 1) from: 0.1).roundF64 == 0.1
    third: math.BigRat.fromFraction num: (math.BigInt from: 1) den: (math.BigInt from: 3)
    (truth
        :t
        what: "float1 fromBig rounds a wider float"
        ok: (
            ((math.float words: 1).fromBig from: (math.BigFloat.fromRat from: third prec: 1000)) ==
            ((math.float words: 1).fromRat from: third)
        )
    )
    (truth
        :t
        what: "float1 fromBig rounds to nearest"
        ok: (
            ((math.float words: 1).fromBig from: (math.BigFloat.fromRat from: third.neg prec: 1000)
            ) ==
            ((math.float words: 1).fromRat from: third.neg)
        )
    )
    dflt: math.float words: 1
    truth :t what: "float1 zero is default" ok: dflt == ((math.float words: 1) from: 0.0)
}

# fields2 -- a (math.float words: 2)'s fields folded into d
fields2: function {d: u64 x: (math.float words: 2).view} out u64 is {
    r: d
    s: u64
    if x.negative then s = 1
    f: u64
    if x.form.finite then f = 1
    if x.form.inf then f = 2
    if x.form.zero then {
        r = fold d: r h: 0
        r = fold d: r h: 0
        return (fold d: r h: 0)
    }
    r = fold d: r h: s
    r = fold d: r h: f
    r = fold d: r h: x.exp.i64.bits
    i: u64
    for i < 2 loop {
        r = fold d: r h: (x.mant.get :i)
        i = i + 1
    }
    return r
}

# float2 -- (math.float words: 2): 14 values
float2: function {t: Tally.borrow} is {
    vs: ListVal (math.float words: 2)
    vs.append from: ((math.float words: 2).parse text: "0").orPanic
    vs.append from: ((math.float words: 2).parse text: "1").orPanic
    vs.append from: ((math.float words: 2).parse text: "-1").orPanic
    vs.append from: ((math.float words: 2).parse text: "3").orPanic
    vs.append from: ((math.float words: 2).parse text: "0.1").orPanic
    vs.append from: ((math.float words: 2).parse text: "-2.5").orPanic
    vs.append from: ((math.float words: 2).parse text: "1e300").orPanic
    vs.append from: ((math.float words: 2).parse text: "-1e-300").orPanic
    vs.append from: ((math.float words: 2).parse text: "123456789012345678901234567890").orPanic
    (vs.append
        from: ((math.float words: 2).parse
            text: "0.3333333333333333333333333333333333333333333333333333333"
        ).orPanic
    )
    vs.append from: ((math.float words: 2).parse text: "18446744073709551617").orPanic
    vs.append from: ((math.float words: 2).parse text: "-7.25e-20").orPanic
    vs.append from: ((math.float words: 2).parse text: "1e-5000").orPanic
    vs.append from: ((math.float words: 2).parse text: "6.02214076e23").orPanic
    dParse: 14695981039346656037.u64
    dAdd: dParse
    dSub: dParse
    dMul: dParse
    dDiv: dParse
    dSqrt: dParse
    dCmp: dParse
    for each a: vs loop {
        dParse = fields2 d: dParse x: a
        if a.sign >= 0 then dSqrt = fields2 d: dSqrt x: a.sqrt
        for each b: vs loop {
            dAdd = fields2 d: dAdd x: a + b
            dSub = fields2 d: dSub x: a - b
            dMul = fields2 d: dMul x: a * b
            if b.sign != 0 then dDiv = fields2 d: dDiv x: a / b
            dCmp = fold d: dCmp h: (a.compare rhs: b).i64.bits
        }
        truth :t what: "float2 big round trip" ok: ((math.float words: 2).fromBig from: a.big) == a
        truth :t what: "float2 neg neg" ok: a.neg.neg == a
    }
    digest :t what: "float2 parse" got: dParse want: 476259457760308763
    digest :t what: "float2 +" got: dAdd want: 259672074554864312
    digest :t what: "float2 -" got: dSub want: 82062503451851564
    digest :t what: "float2 *" got: dMul want: 11403496652217942679
    digest :t what: "float2 /" got: dDiv want: 5998937524174909909
    digest :t what: "float2 sqrt" got: dSqrt want: 2761282673814486016
    digest :t what: "float2 compare" got: dCmp want: 6202550370498635581
    inf: (math.float words: 2).inf negative: false
    one: (math.float words: 2) from: 1.0
    truth :t what: "float2 inf + 1" ok: (inf + one).isInf and ((inf + one).sign == 1)
    truth :t what: "float2 1 / inf" ok: (one / inf).sign == 0
    truth :t what: "float2 -0 == 0" ok: (one - one).neg == ((math.float words: 2) from: 0.0)
    truth :t what: "float2 f64 exact" ok: ((math.float words: 2) from: 0.1).roundF64 == 0.1
    third: math.BigRat.fromFraction num: (math.BigInt from: 1) den: (math.BigInt from: 3)
    (truth
        :t
        what: "float2 fromBig rounds a wider float"
        ok: (
            ((math.float words: 2).fromBig from: (math.BigFloat.fromRat from: third prec: 1000)) ==
            ((math.float words: 2).fromRat from: third)
        )
    )
    (truth
        :t
        what: "float2 fromBig rounds to nearest"
        ok: (
            ((math.float words: 2).fromBig from: (math.BigFloat.fromRat from: third.neg prec: 1000)
            ) ==
            ((math.float words: 2).fromRat from: third.neg)
        )
    )
    dflt: math.float words: 2
    truth :t what: "float2 zero is default" ok: dflt == ((math.float words: 2) from: 0.0)
}

# fields4 -- a (math.float words: 4)'s fields folded into d
fields4: function {d: u64 x: (math.float words: 4).view} out u64 is {
    r: d
    s: u64
    if x.negative then s = 1
    f: u64
    if x.form.finite then f = 1
    if x.form.inf then f = 2
    if x.form.zero then {
        r = fold d: r h: 0
        r = fold d: r h: 0
        return (fold d: r h: 0)
    }
    r = fold d: r h: s
    r = fold d: r h: f
    r = fold d: r h: x.exp.i64.bits
    i: u64
    for i < 4 loop {
        r = fold d: r h: (x.mant.get :i)
        i = i + 1
    }
    return r
}

# float4 -- (math.float words: 4): 14 values
float4: function {t: Tally.borrow} is {
    vs: ListVal (math.float words: 4)
    vs.append from: ((math.float words: 4).parse text: "0").orPanic
    vs.append from: ((math.float words: 4).parse text: "1").orPanic
    vs.append from: ((math.float words: 4).parse text: "-1").orPanic
    vs.append from: ((math.float words: 4).parse text: "3").orPanic
    vs.append from: ((math.float words: 4).parse text: "0.1").orPanic
    vs.append from: ((math.float words: 4).parse text: "-2.5").orPanic
    vs.append from: ((math.float words: 4).parse text: "1e300").orPanic
    vs.append from: ((math.float words: 4).parse text: "-1e-300").orPanic
    vs.append from: ((math.float words: 4).parse text: "123456789012345678901234567890").orPanic
    (vs.append
        from: ((math.float words: 4).parse
            text: "0.3333333333333333333333333333333333333333333333333333333"
        ).orPanic
    )
    vs.append from: ((math.float words: 4).parse text: "18446744073709551617").orPanic
    vs.append from: ((math.float words: 4).parse text: "-7.25e-20").orPanic
    vs.append from: ((math.float words: 4).parse text: "1e-5000").orPanic
    vs.append from: ((math.float words: 4).parse text: "6.02214076e23").orPanic
    dParse: 14695981039346656037.u64
    dAdd: dParse
    dSub: dParse
    dMul: dParse
    dDiv: dParse
    dSqrt: dParse
    dCmp: dParse
    for each a: vs loop {
        dParse = fields4 d: dParse x: a
        if a.sign >= 0 then dSqrt = fields4 d: dSqrt x: a.sqrt
        for each b: vs loop {
            dAdd = fields4 d: dAdd x: a + b
            dSub = fields4 d: dSub x: a - b
            dMul = fields4 d: dMul x: a * b
            if b.sign != 0 then dDiv = fields4 d: dDiv x: a / b
            dCmp = fold d: dCmp h: (a.compare rhs: b).i64.bits
        }
        truth :t what: "float4 big round trip" ok: ((math.float words: 4).fromBig from: a.big) == a
        truth :t what: "float4 neg neg" ok: a.neg.neg == a
    }
    digest :t what: "float4 parse" got: dParse want: 11547231426777732778
    digest :t what: "float4 +" got: dAdd want: 16036121550882473675
    digest :t what: "float4 -" got: dSub want: 3762850358176297616
    digest :t what: "float4 *" got: dMul want: 5545193676015740198
    digest :t what: "float4 /" got: dDiv want: 11169774117499976746
    digest :t what: "float4 sqrt" got: dSqrt want: 6861206016465717524
    digest :t what: "float4 compare" got: dCmp want: 6202550370498635581
    inf: (math.float words: 4).inf negative: false
    one: (math.float words: 4) from: 1.0
    truth :t what: "float4 inf + 1" ok: (inf + one).isInf and ((inf + one).sign == 1)
    truth :t what: "float4 1 / inf" ok: (one / inf).sign == 0
    truth :t what: "float4 -0 == 0" ok: (one - one).neg == ((math.float words: 4) from: 0.0)
    truth :t what: "float4 f64 exact" ok: ((math.float words: 4) from: 0.1).roundF64 == 0.1
    third: math.BigRat.fromFraction num: (math.BigInt from: 1) den: (math.BigInt from: 3)
    (truth
        :t
        what: "float4 fromBig rounds a wider float"
        ok: (
            ((math.float words: 4).fromBig from: (math.BigFloat.fromRat from: third prec: 1000)) ==
            ((math.float words: 4).fromRat from: third)
        )
    )
    (truth
        :t
        what: "float4 fromBig rounds to nearest"
        ok: (
            ((math.float words: 4).fromBig from: (math.BigFloat.fromRat from: third.neg prec: 1000)
            ) ==
            ((math.float words: 4).fromRat from: third.neg)
        )
    )
    dflt: math.float words: 4
    truth :t what: "float4 zero is default" ok: dflt == ((math.float words: 4) from: 0.0)
}

main: function is {
    t: Tally checks: 0 bad: 0
    float1 :t
    float2 :t
    float4 :t
    if t.bad == 0 then {
        print "ok \{t.checks} checks"
    } else {
        print "\{t.bad} of \{t.checks} checks FAILED"
    }
}
