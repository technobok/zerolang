# math_constants_wide.z -- math's untyped constants land as f128 as the value
# that format holds nearest the true constant: all 113 bits of it, rounded once
# from the digits, against the bit patterns an exact rational oracle gives.
main: function is {
    print "pi \{(math.pi.f128.bits == (0x4000921fb54442d1.u128 << 64 | 0x8469898cc51701b8.u128))}"
    print "e \{(math.e.f128.bits == (0x40005bf0a8b14576.u128 << 64 | 0x95355fb8ac404e7a.u128))}"
    print "phi \{(math.phi.f128.bits == (0x3fff9e3779b97f4a.u128 << 64 | 0x7c15f39cc0605cee.u128))}"
    print "sqrt2 \{(math.sqrt2.f128.bits == (0x3fff6a09e667f3bc.u128 << 64 | 0xc908b2fb1366ea95.u128))}"
    print "sqrtE \{(math.sqrtE.f128.bits == (0x3fffa61298e1e069.u128 << 64 | 0xbc972dfefab6df34.u128))}"
    print "sqrtPi \{(math.sqrtPi.f128.bits == (0x3fffc5bf891b4ef6.u128 << 64 | 0xaa79c3b0520d5db9.u128))}"
    print "sqrtPhi \{(math.sqrtPhi.f128.bits == (0x3fff45a3146a8845.u128 << 64 | 0x5e92554501121ec5.u128))}"
    print "ln2 \{(math.ln2.f128.bits == (0x3ffe62e42fefa39e.u128 << 64 | 0xf35793c7673007e6.u128))}"
    print "log2E \{(math.log2E.f128.bits == (0x3fff71547652b82f.u128 << 64 | 0xe1777d0ffda0d23a.u128))}"
    print "ln10 \{(math.ln10.f128.bits == (0x400026bb1bbb5551.u128 << 64 | 0x582dd4adac5705a6.u128))}"
    print "log10E \{(math.log10E.f128.bits == (0x3ffdbcb7b1526e50.u128 << 64 | 0xe32a6ab7555f5a68.u128))}"
}
