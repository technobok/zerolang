    x.add x: w
    same :t what: "16w x += w" got: x want: "1 2040 5 7ce8a95496825807347b6f3fe3f63ab8" :p
    x.quo x: d
    same :t what: "16w x /= d" got: x want: "1 1020 0 58229b0fdc5794112e57829ec1af1794" :p
    x.sub x: b
    same :t what: "16w x -= b" got: x want: "-1 1024 0 27dd64f023a86beed1a87d613e50e96b" :p
    x.rem x: e
    same :t what: "16w x %= e" got: x want: "-1 509 0 4bf891013fd06cd3a7eaf45d77652bd8" :p
    f: math.BigFloat.fromInt from: a prec: 1023
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "16w round a to 1023 bits" got: fi want: "1 1025 1024 100" :p
    } case none then {
        same :t what: "16w round a to 1023 bits" got: one want: "inf" :p
    }
}

