# words39 -- the shapes at 39 words: a all ones, b = a + 1, d and e
# pseudo-random (d odd, e half d's length with its top bit set)
words39: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: (big
        text: ""
    )
    b: one << 2496
    d: (big
        text: ""
    )
    e: (big
        text: ""
    )
    same :t what: "39w a+1" got: a + one want: "1 2497 2496 800000000000000000000" :p
    same :t what: "39w 1+a" got: one + a want: "1 2497 2496 800000000000000000000" :p
    same :t what: "39w b-1" got: b - one want: "1 2496 0 7ffffffffffffffffffff" :p
    same :t what: "39w 1-b" got: one - b want: "-1 2496 0 7ffffffffffffffffffff" :p
    same :t what: "39w a+a" got: a + a want: "1 2497 1 ffffffffffffffffffffe" :p
    same :t what: "39w a-a" got: a - a want: "0" :p
    same :t what: "39w a+d" got: a + d want: "1 2497 1 17740270fbcc1cdcf3b9dd34d32b3b5a" :p
    same :t what: "39w d-a" got: d - a want: "-1 2496 2 688bfd8f0443e3230c4622cb2cd4c4a3" :p
    same :t what: "39w d+w" got: d + w want: "1 2495 1 17740270fbc41cddf3b9dd34d32b3b5a" :p
    same :t what: "39w d-w" got: d - w want: "1 2495 2 17740270fbc41cdbf3b9dd34d32b3b5c" :p
    same :t what: "39w a*w" got: a * w want: "1 2560 0 7ffffffffff7ffff0000000000100000" :p
    same :t what: "39w d*w" got: d * w want: "1 2559 0 5c45dac3d7671e7e3b2e27ad245cfe5e" :p
    same :t what: "39w a*a" got: a * a want: "1 4992 0 7ffffffffff000000000008000000000" :p
    same :t what: "39w a*d" got: a * d want: "1 4991 0 523296e8df155a633355df0cfaa40042" :p
    same :t what: "39w d*d" got: d * d want: "1 4989 0 6261b81c82522c7e071fca70372d9ddd" :p
    same :t what: "39w d*e" got: d * e want: "1 3710 0 3c376e069315c735726100b0ff70ca15" :p
    same :t what: "39w a<<0" got: a << 0 want: "1 2496 0 7ffffffffffffffffffff" :p
