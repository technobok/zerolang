    same :t what: "7w (a*d+d/2)/d" got: a * d + (d >> 1) / d want: "1 448 0 7ffffffffffffffff" :p
    (same
        :t
        what: "7w (a*d+d/2)%d"
        got: a * d + (d >> 1) % d
        want: "1 446 0 4f7b8db7d349b56ca4aa5b8e4ffb15e9"
        :p
    )
    same :t what: "7w b/d" got: b / d want: "3" :p
    same :t what: "7w b%d" got: b % d want: "1 446 0 231aadb10c45bf7c2401daaa201d7c83" :p
    same :t what: "7w -b/d" got: b.neg / d want: "-3" :p
    same :t what: "7w d*d/e" got: d * d / e want: "1 702 0 72aa12caeeb94509dc44963d62da0e82" :p
    (same
        :t
        what: "7w d*d%e"
        got: d * d % e
        want: "54e862ea450d20cccd5227f22737295d344291916f52b606"
        :p
    )
    same :t what: "7w b/a" got: b / a want: "1" :p
    same :t what: "7w b%a" got: b % a want: "1" :p
    same :t what: "7w a*a/a" got: a * a / a want: "1 448 0 7ffffffffffffffff" :p
    x: a.copy
    x.add x: one
    same :t what: "7w x += 1" got: x want: "1 449 448 80000000000000000" :p
    x.sub x: one
    same :t what: "7w x -= 1" got: x want: "1 448 0 7ffffffffffffffff" :p
    x.add x: d
    same :t what: "7w x += d" got: x want: "1 449 1 1ef71b6fa6936ae14954b71c9ff62bd3" :p
    x.sub x: a
    same :t what: "7w x -= a" got: x want: "1 447 0 1ef71b6fa6936ad94954b71c9ff62bd4" :p
    x.mul x: d
    same :t what: "7w x *= d" got: x want: "1 893 0 67e4f0c390f4a2892a152107ff0ccb23" :p
    x.add x: w
    same :t what: "7w x += w" got: x want: "1 893 3 67e4f0c390f4a28a2a152107ff0ccb22" :p
    x.quo x: d
    same :t what: "7w x /= d" got: x want: "1 447 0 1ef71b6fa6936ad94954b71c9ff62bd4" :p
    x.sub x: b
    same :t what: "7w x -= b" got: x want: "-1 448 0 6108e490596c952eb6ab48e36009d42b" :p
    x.rem x: e
    same :t what: "7w x %= e" got: x want: "-31efb7d17987a3b0f17d964706c2ea9d386e5a914bcb53d0" :p
    f: math.BigFloat.fromInt from: a prec: 447
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "7w round a to 447 bits" got: fi want: "1 449 448 80000000000000000" :p
    } case none then {
        same :t what: "7w round a to 447 bits" got: one want: "inf" :p
    }
}

# words8 -- the shapes at 8 words: a all ones, b = a + 1, d and e
# pseudo-random (d odd, e half d's length with its top bit set)
words8: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: (big
        text: "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
    )
    b: one << 512
    d: (big
        text: "bd58b99f40104f65c2df1e32b294442ee9402b5f75ee71bb82e47ea81d31d59c96d3a65f0a1a5da10be7dc01fe50d0daed7d3a5d2697fc97ef7a8f8c23f2b569"
    )
    e: big text: "1b448d334ab6816f6ea25fe65db014a06b2ffae801c99b35cfbb7c37ed3aa13e"
