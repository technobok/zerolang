# words5 -- the shapes at 5 words: a all ones, b = a + 1, d and e
# pseudo-random (d odd, e half d's length with its top bit set)
words5: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: big text: "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
    b: one << 320
    d: big text: "469d01191a214da5a4ebf5b452c2236eeada9f9d27e155fbb45e707721e8f2dce684b3043e3237e1"
    e: big text: "32113101fd1a917ac6c59fb0077a23b7"
    same :t what: "5w a+1" got: a + one want: "1 321 320 40000000000000000" :p
    same :t what: "5w 1+a" got: one + a want: "1 321 320 40000000000000000" :p
    same :t what: "5w b-1" got: b - one want: "1 320 0 3ffffffffffffffff" :p
    same :t what: "5w 1-b" got: one - b want: "-1 320 0 3ffffffffffffffff" :p
    same :t what: "5w a+a" got: a + a want: "1 321 1 7fffffffffffffffe" :p
    same :t what: "5w a-a" got: a - a want: "0" :p
    same :t what: "5w a+d" got: a + d want: "1 321 5 7e365bdfc76d39bfd6adf6a2f67a1a6d" :p
    same :t what: "5w d-a" got: d - a want: "-1 320 1 1c9a4203892c6482952095d0985e590" :p
    same :t what: "5w d+w" got: d + w want: "1 319 5 7e365bdfc76d39bcd6adf6a2f67a1a6d" :p
    same :t what: "5w d-w" got: d - w want: "1 319 1 7e365bdfc76d39bad6adf6a2f67a1a6f" :p
    same :t what: "5w a*w" got: a * w want: "1 384 0 7ffffffffffffffb0000000000000008" :p
    same :t what: "5w d*w" got: d * w want: "1 383 0 58779ac32f0ce0b325bec11c98605908" :p
    same :t what: "5w a*a" got: a * a want: "1 640 0 7ffffffffffffff80000000000000020" :p
    same :t what: "5w a*d" got: a * d want: "1 639 0 5c817eac127b30001b04e85b44efb36f" :p
    same :t what: "5w d*d" got: d * d want: "1 637 0 525947120d277bf715d59d1168a2e2a0" :p
    same :t what: "5w d*e" got: d * e want: "1 444 0 6c014b9e054cfb74f9c41e90a4258abd" :p
    same :t what: "5w a<<0" got: a << 0 want: "1 320 0 3ffffffffffffffff" :p
    same :t what: "5w d<<0" got: d << 0 want: "1 319 0 7e365bdfc76d39bbd6adf6a2f67a1a6e" :p
    same :t what: "5w a>>0" got: a >> 0 want: "1 320 0 3ffffffffffffffff" :p
    same :t what: "5w d>>0" got: d >> 0 want: "1 319 0 7e365bdfc76d39bbd6adf6a2f67a1a6e" :p
    same :t what: "5w -d>>0" got: d.neg >> 0 want: "-1 319 0 7e365bdfc76d39bbd6adf6a2f67a1a6e" :p
    same :t what: "5w a<<1" got: a << 1 want: "1 321 1 7fffffffffffffffe" :p
    same :t what: "5w d<<1" got: d << 1 want: "1 320 1 7c6cb7bf8eda7377ad5bed45ecf434dd" :p
    same :t what: "5w a>>1" got: a >> 1 want: "1 319 0 1ffffffffffffffff" :p
    same :t what: "5w d>>1" got: d >> 1 want: "1 318 4 7f1b2defe3b69cddeb56fb517b3d0d36" :p
    same :t what: "5w -d>>1" got: d.neg >> 1 want: "-1 318 0 7f1b2defe3b69cddeb56fb517b3d0d37" :p
    same :t what: "5w a<<63" got: a << 63 want: "1 383 63 7fffffffffffffff8000000000000003" :p
    same :t what: "5w d<<63" got: d << 63 want: "1 382 63 6b56fb517b3d0d377e365bdfc76d39bb" :p
    same :t what: "5w a>>63" got: a >> 63 want: "1 257 0 7" :p
    same :t what: "5w d>>63" got: d >> 63 want: "1 256 0 7029439eb847e28dfc6cb7bf8eda7376" :p
    same :t what: "5w -d>>63" got: d.neg >> 63 want: "-1 256 1 7029439eb847e28dfc6cb7bf8eda7377" :p
    same :t what: "5w a<<64" got: a << 64 want: "1 384 64 7fffffffffffffff0000000000000007" :p
    same :t what: "5w d<<64" got: d << 64 want: "1 383 64 56adf6a2f67a1a6efc6cb7bf8eda7377" :p
    same :t what: "5w a>>64" got: a >> 64 want: "1 256 0 3" :p
    same :t what: "5w d>>64" got: d >> 64 want: "1 255 2 7814a1cf5c23f146fe365bdfc76d39ba" :p
    same :t what: "5w -d>>64" got: d.neg >> 64 want: "-1 255 0 7814a1cf5c23f146fe365bdfc76d39bb" :p
    same :t what: "5w a<<65" got: a << 65 want: "1 385 65 7ffffffffffffffe000000000000000f" :p
    same :t what: "5w d<<65" got: d << 65 want: "1 384 65 2d5bed45ecf434ddf8d96f7f1db4e6ef" :p
    same :t what: "5w a>>65" got: a >> 65 want: "1 255 0 1" :p
    same :t what: "5w d>>65" got: d >> 65 want: "1 254 1 3c0a50e7ae11f8a37f1b2defe3b69cdd" :p
    same :t what: "5w -d>>65" got: d.neg >> 65 want: "-1 254 0 3c0a50e7ae11f8a37f1b2defe3b69cde" :p
    same :t what: "5w a<<127" got: a << 127 want: "1 447 127 3ffffffffffffffff" :p
    same :t what: "5w d<<127" got: d << 127 want: "1 446 127 7e365bdfc76d39bbd6adf6a2f67a1a6e" :p
    same :t what: "5w a>>127" got: a >> 127 want: "1 193 0 3ffffffffffffffff" :p
    (same
        :t
        what: "5w d>>127"
        got: d >> 127
        want: "8d3a023234429b4b49d7eb68a58446ddd5b53f3a4fc2abf7"
        :p
    )
    (same
        :t
        what: "5w -d>>127"
        got: d.neg >> 127
        want: "-8d3a023234429b4b49d7eb68a58446ddd5b53f3a4fc2abf8"
        :p
    )
    same :t what: "5w a<<320" got: a << 320 want: "1 640 320 7ffffffffffffffc000000000000001f" :p
    same :t what: "5w d<<320" got: d << 320 want: "1 639 320 5ab7da8bd9e869bbf1b2defe3b69cdde" :p
    same :t what: "5w a>>320" got: a >> 320 want: "0" :p
    same :t what: "5w d>>320" got: d >> 320 want: "0" :p
    same :t what: "5w -d>>320" got: d.neg >> 320 want: "-1" :p
    same :t what: "5w a<<321" got: a << 321 want: "1 641 321 7ffffffffffffff8000000000000003f" :p
    same :t what: "5w d<<321" got: d << 321 want: "1 640 321 356fb517b3d0d377e365bdfc76d39bbd" :p
    same :t what: "5w a>>321" got: a >> 321 want: "0" :p
    same :t what: "5w d>>321" got: d >> 321 want: "0" :p
    same :t what: "5w -d>>321" got: d.neg >> 321 want: "-1" :p
    same :t what: "5w (a*d+d/2)/d" got: a * d + (d >> 1) / d want: "1 320 0 3ffffffffffffffff" :p
    (same
        :t
        what: "5w (a*d+d/2)%d"
        got: a * d + (d >> 1) % d
        want: "1 318 4 7f1b2defe3b69cddeb56fb517b3d0d36"
        :p
    )
    same :t what: "5w b/d" got: b / d want: "3" :p
    same :t what: "5w b%d" got: b % d want: "1 318 0 55cec60a9b852d07bf61c171c91b0b3" :p
    same :t what: "5w -b/d" got: b.neg / d want: "-3" :p
    same :t what: "5w d*d/e" got: d * d / e want: "1 511 1 5308f874216f6d742c9b160a9d212ece" :p
    same :t what: "5w d*d%e" got: d * d % e want: "1f3798e650d737f891f32fd381af3ecb" :p
    same :t what: "5w b/a" got: b / a want: "1" :p
    same :t what: "5w b%a" got: b % a want: "1" :p
    same :t what: "5w a*a/a" got: a * a / a want: "1 320 0 3ffffffffffffffff" :p
    x: a.copy
    x.add x: one
    same :t what: "5w x += 1" got: x want: "1 321 320 40000000000000000" :p
    x.sub x: one
    same :t what: "5w x -= 1" got: x want: "1 320 0 3ffffffffffffffff" :p
    x.add x: d
    same :t what: "5w x += d" got: x want: "1 321 5 7e365bdfc76d39bfd6adf6a2f67a1a6d" :p
    x.sub x: a
    same :t what: "5w x -= a" got: x want: "1 319 0 7e365bdfc76d39bbd6adf6a2f67a1a6e" :p
    x.mul x: d
    same :t what: "5w x *= d" got: x want: "1 637 0 525947120d277bf715d59d1168a2e2a0" :p
    x.add x: w
    same :t what: "5w x += w" got: x want: "1 637 6 525947120d277bf815d59d1168a2e29f" :p
    x.quo x: d
    same :t what: "5w x /= d" got: x want: "1 319 0 7e365bdfc76d39bbd6adf6a2f67a1a6e" :p
    x.sub x: b
    same :t what: "5w x -= b" got: x want: "-1 320 0 1c9a4203892c6482952095d0985e591" :p
    x.rem x: e
    same :t what: "5w x %= e" got: x want: "-1058b9ff98b9cbddc22605f79c970d1a" :p
    f: math.BigFloat.fromInt from: a prec: 319
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "5w round a to 319 bits" got: fi want: "1 321 320 40000000000000000" :p
    } case none then {
        same :t what: "5w round a to 319 bits" got: one want: "inf" :p
    }
}

# words6 -- the shapes at 6 words: a all ones, b = a + 1, d and e
# pseudo-random (d odd, e half d's length with its top bit set)
words6: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: (big
        text: "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
    )
    b: one << 384
    d: (big
        text: "82625ff532f7cc9b00a2af3707c25a2a0393097e534e17ff5df09141a067ef01cbe09192378a0c53ed6a7318ac7b70f"
    )
    e: big text: "58998cf87965c2b69a70c9a3feaa3f639f1793dd540fa2e4"
    same :t what: "6w a+1" got: a + one want: "1 385 384 8" :p
    same :t what: "6w 1+a" got: one + a want: "1 385 384 8" :p
    same :t what: "6w b-1" got: b - one want: "1 384 0 7" :p
    same :t what: "6w 1-b" got: one - b want: "-1 384 0 7" :p
    same :t what: "6w a+a" got: a + a want: "1 385 1 e" :p
    same :t what: "6w a-a" got: a - a want: "0" :p
    same :t what: "6w a+d" got: a + d want: "1 385 1 7dc902463aa056ebeabd652780c54b80" :p
    same :t what: "6w d-a" got: d - a want: "-1 384 4 236fdb9c55fa91415429ad87f3ab48d" :p
    same :t what: "6w d+w" got: d + w want: "1 380 1 7dc902463aa056eceabd652780c54b78" :p
    same :t what: "6w d-w" got: d - w want: "1 380 4 7dc902463aa056eaeabd652780c54b7a" :p
    same :t what: "6w a*w" got: a * w want: "1 448 0 6fffffffffffffff9" :p
    same :t what: "6w d*w" got: d * w want: "1 444 0 6cf462e14624f48e10d49f64f47b625d" :p
    same :t what: "6w a*a" got: a * a want: "1 768 0 31" :p
    same :t what: "6w a*d" got: a * d want: "1 764 0 707f0feb9a6260736b2dc41485651055" :p
    same :t what: "6w d*d" got: d * d want: "1 759 0 1158652d2efe80d7cf7209c515e8f4df" :p
    same :t what: "6w d*e" got: d * e want: "1 570 2 370d53b405e56aea16ee344bfe1bf9f0" :p
    same :t what: "6w a<<0" got: a << 0 want: "1 384 0 7" :p
    same :t what: "6w d<<0" got: d << 0 want: "1 380 0 7dc902463aa056ebeabd652780c54b79" :p
    same :t what: "6w a>>0" got: a >> 0 want: "1 384 0 7" :p
    same :t what: "6w d>>0" got: d >> 0 want: "1 380 0 7dc902463aa056ebeabd652780c54b79" :p
    same :t what: "6w -d>>0" got: d.neg >> 0 want: "-1 380 0 7dc902463aa056ebeabd652780c54b79" :p
    same :t what: "6w a<<1" got: a << 1 want: "1 385 1 e" :p
    same :t what: "6w d<<1" got: d << 1 want: "1 381 1 7b92048c7540add7d57aca4f018a96f3" :p
    same :t what: "6w a>>1" got: a >> 1 want: "1 383 0 3" :p
    same :t what: "6w d>>1" got: d >> 1 want: "1 379 0 3ee481231d502b75f55eb293c062a5bc" :p
    same :t what: "6w -d>>1" got: d.neg >> 1 want: "-1 379 3 3ee481231d502b75f55eb293c062a5bd" :p
    same :t what: "6w a<<63" got: a << 63 want: "1 447 63 38000000000000000" :p
    same :t what: "6w d<<63" got: d << 63 want: "1 443 63 755eb293c062a5bcfdc902463aa056eb" :p
    same :t what: "6w a>>63" got: a >> 63 want: "1 321 0 7ffffffffffffffff" :p
    same :t what: "6w d>>63" got: d >> 63 want: "1 317 1 2be6bdf5f5fd946afb92048c7540add7" :p
    same :t what: "6w -d>>63" got: d.neg >> 63 want: "-1 317 0 2be6bdf5f5fd946afb92048c7540add8" :p
    same :t what: "6w a<<64" got: a << 64 want: "1 448 64 70000000000000000" :p
    same :t what: "6w d<<64" got: d << 64 want: "1 444 64 6abd652780c54b79fb92048c7540add7" :p
    same :t what: "6w a>>64" got: a >> 64 want: "1 320 0 3ffffffffffffffff" :p
    same :t what: "6w d>>64" got: d >> 64 want: "1 316 0 55f35efafafeca357dc902463aa056eb" :p
    same :t what: "6w -d>>64" got: d.neg >> 64 want: "-1 316 1 55f35efafafeca357dc902463aa056ec" :p
    same :t what: "6w a<<65" got: a << 65 want: "1 449 65 e0000000000000000" :p
    same :t what: "6w d<<65" got: d << 65 want: "1 445 65 557aca4f018a96f3f7240918ea815baf" :p
    same :t what: "6w a>>65" got: a >> 65 want: "1 319 0 1ffffffffffffffff" :p
    same :t what: "6w d>>65" got: d >> 65 want: "1 315 1 2af9af7d7d7f651abee481231d502b75" :p
    same :t what: "6w -d>>65" got: d.neg >> 65 want: "-1 315 0 2af9af7d7d7f651abee481231d502b76" :p
    same :t what: "6w a<<127" got: a << 127 want: "1 511 127 7" :p
    same :t what: "6w d<<127" got: d << 127 want: "1 507 127 7dc902463aa056ebeabd652780c54b79" :p
    same :t what: "6w a>>127" got: a >> 127 want: "1 257 0 7" :p
    same :t what: "6w d>>127" got: d >> 127 want: "1 253 5 610af92d1727b626abe6bdf5f5fd946a" :p
    (same
        :t
        what: "6w -d>>127"
        got: d.neg >> 127
        want: "-1 253 0 610af92d1727b626abe6bdf5f5fd946b"
        :p
    )
    same :t what: "6w a<<384" got: a << 384 want: "1 768 384 38" :p
    same :t what: "6w d<<384" got: d << 384 want: "1 764 384 6e481231d502b75f55eb293c062a5bcf" :p
    same :t what: "6w a>>384" got: a >> 384 want: "0" :p
    same :t what: "6w d>>384" got: d >> 384 want: "0" :p
    same :t what: "6w -d>>384" got: d.neg >> 384 want: "-1" :p
    same :t what: "6w a<<385" got: a << 385 want: "1 769 385 70" :p
    same :t what: "6w d<<385" got: d << 385 want: "1 765 385 5c902463aa056ebeabd652780c54b79f" :p
    same :t what: "6w a>>385" got: a >> 385 want: "0" :p
    same :t what: "6w d>>385" got: d >> 385 want: "0" :p
    same :t what: "6w -d>>385" got: d.neg >> 385 want: "-1" :p
    same :t what: "6w (a*d+d/2)/d" got: a * d + (d >> 1) / d want: "1 384 0 7" :p
    (same
        :t
        what: "6w (a*d+d/2)%d"
        got: a * d + (d >> 1) % d
        want: "1 379 0 3ee481231d502b75f55eb293c062a5bc"
        :p
    )
    same :t what: "6w b/d" got: b / d want: "1f" :p
    same :t what: "6w b%d" got: b % d want: "1 378 0 44a8b97ee695796e9310c037681bdc42" :p
    same :t what: "6w -b/d" got: b.neg / d want: "-1f" :p
    same :t what: "6w d*d/e" got: d * d / e want: "1 568 0 36a81d45ec5860035864918f6256ade3" :p
    (same
        :t
        what: "6w d*d%e"
        got: d * d % e
        want: "25216f8ea05bc15a1755a64d4a2606ca8d1ac06026a928b5"
        :p
    )
    same :t what: "6w b/a" got: b / a want: "1" :p
    same :t what: "6w b%a" got: b % a want: "1" :p
    same :t what: "6w a*a/a" got: a * a / a want: "1 384 0 7" :p
    x: a.copy
    x.add x: one
    same :t what: "6w x += 1" got: x want: "1 385 384 8" :p
    x.sub x: one
    same :t what: "6w x -= 1" got: x want: "1 384 0 7" :p
    x.add x: d
    same :t what: "6w x += d" got: x want: "1 385 1 7dc902463aa056ebeabd652780c54b80" :p
    x.sub x: a
    same :t what: "6w x -= a" got: x want: "1 380 0 7dc902463aa056ebeabd652780c54b79" :p
    x.mul x: d
    same :t what: "6w x *= d" got: x want: "1 759 0 1158652d2efe80d7cf7209c515e8f4df" :p
    x.add x: w
    same :t what: "6w x += w" got: x want: "1 759 5 1158652d2efe80d8cf7209c515e8f4de" :p
    x.quo x: d
    same :t what: "6w x /= d" got: x want: "1 380 0 7dc902463aa056ebeabd652780c54b79" :p
    x.sub x: b
    same :t what: "6w x -= b" got: x want: "-1 384 0 236fdb9c55fa91415429ad87f3ab48e" :p
    x.rem x: e
    same :t what: "6w x %= e" got: x want: "-4baa379efe97e6c097ef027a50e10c4aec14772877932b69" :p
    f: math.BigFloat.fromInt from: a prec: 383
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "6w round a to 383 bits" got: fi want: "1 385 384 8" :p
    } case none then {
        same :t what: "6w round a to 383 bits" got: one want: "inf" :p
    }
}

# words7 -- the shapes at 7 words: a all ones, b = a + 1, d and e
# pseudo-random (d odd, e half d's length with its top bit set)
words7: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: (big
        text: "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
    )
    b: one << 448
    d: (big
        text: "4950fc6e129cb5e9f8b328af648ef742197754cdc6d6fd9f9b866b7b77a79f9000e3728b0c2ba7e5851da1bb25084eae97289b5ed75d363b"
    )
    e: big text: "639df66f6b8aebab02d062460039ed4cf769880aa0a52211"
    same :t what: "7w a+1" got: a + one want: "1 449 448 80000000000000000" :p
    same :t what: "7w 1+a" got: one + a want: "1 449 448 80000000000000000" :p
    same :t what: "7w b-1" got: b - one want: "1 448 0 7ffffffffffffffff" :p
    same :t what: "7w 1-b" got: one - b want: "-1 448 0 7ffffffffffffffff" :p
    same :t what: "7w a+a" got: a + a want: "1 449 1 ffffffffffffffffe" :p
    same :t what: "7w a-a" got: a - a want: "0" :p
    same :t what: "7w a+d" got: a + d want: "1 449 1 1ef71b6fa6936ae14954b71c9ff62bd3" :p
    same :t what: "7w d-a" got: d - a want: "-1 448 2 6108e490596c952eb6ab48e36009d42a" :p
    same :t what: "7w d+w" got: d + w want: "1 447 1 1ef71b6fa6936ada4954b71c9ff62bd3" :p
    same :t what: "7w d-w" got: d - w want: "1 447 2 1ef71b6fa6936ad84954b71c9ff62bd5" :p
    same :t what: "7w a*w" got: a * w want: "1 512 0 7ffffffffffffff70000000000000010" :p
    same :t what: "7w d*w" got: d * w want: "1 511 0 2a5d9bacf962c0faf4997fc2ad30a9de" :p
    same :t what: "7w a*a" got: a * a want: "1 896 0 7ffffffffffffff00000000000000080" :p
    same :t what: "7w a*d" got: a * d want: "1 895 0 2bae9d75591df3c8a61cffddc94081c0" :p
    same :t what: "7w d*d" got: d * d want: "1 893 0 67e4f0c390f4a2892a152107ff0ccb23" :p
    same :t what: "7w d*e" got: d * e want: "1 637 0 301ea472aa805e2d86d9a3916a599119" :p
    same :t what: "7w a<<0" got: a << 0 want: "1 448 0 7ffffffffffffffff" :p
    same :t what: "7w d<<0" got: d << 0 want: "1 447 0 1ef71b6fa6936ad94954b71c9ff62bd4" :p
    same :t what: "7w a>>0" got: a >> 0 want: "1 448 0 7ffffffffffffffff" :p
    same :t what: "7w d>>0" got: d >> 0 want: "1 447 0 1ef71b6fa6936ad94954b71c9ff62bd4" :p
