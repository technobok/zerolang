    x.sub x: b
    same :t what: "9w x -= b" got: x want: "-1 575 0 6f81249befa091ad123f51e04df9ff0" :p
    x.rem x: e
    same :t what: "9w x %= e" got: x want: "-1 253 0 5fcff35b91161b4d3417121ae23c2069" :p
    f: math.BigFloat.fromInt from: a prec: 575
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "9w round a to 575 bits" got: fi want: "1 577 576 100000000000000000" :p
    } case none then {
        same :t what: "9w round a to 575 bits" got: one want: "inf" :p
    }
}

