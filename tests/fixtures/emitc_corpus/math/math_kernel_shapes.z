    x.add x: d
    same :t what: "25w x += d" got: x want: "1 1601 2 68b6ac7bd5cd6e89ddcb04b9091cd7de" :p
    x.sub x: a
    same :t what: "25w x -= a" got: x want: "1 1596 0 68b6ac7bd5cd5e89ddcb04b9091cd7df" :p
