    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "13w round a to 831 bits" got: fi want: "1 833 832 400000000000000000" :p
    } case none then {
        same :t what: "13w round a to 831 bits" got: one want: "inf" :p
    }
}

