# math_kernel_shapes.z -- BigInt through its word-vector kernels at the operand
# shapes they special-case: lengths 0 and 1, a carry or a borrow through every
# word, one that dies early (the rest is copied), shifts by 0, 1, 63 and whole
# words, the in-place twins (BigInt's add, sub, mul, quo and rem accumulate),
# every length 1 to 17 -- either side of where the asm kernels take over (4, 8,
# 9) and every remainder of their 4- and 8-word unrolling -- and sizes either
# side of the karatsuba (40), divRecursive (24) and Karatsuba
# squaring (60) thresholds -- at 59, 61, 81 and 100 words divRecursive hands
# divBasic a chunk shorter than its divisor. Generated by kerneltables.py,
# Python's ints the oracle; a long result is compared by its digest.

# the failures, and the checks run
Tally: class {
    checks: u64
    bad: u64
}

# big -- a BigInt from hexadecimal text the test spells correctly
big: function {text: StringView} out math.BigInt is {
    r: math.BigInt.parse :text base: 16
    match r case ok then return r.take case err then panic msg: "bad test text"
}

# digest -- x exactly while it fits three words, else its sign, bit length,
# trailing zeros and the residue of its magnitude mod p
digest: function {x: math.BigInt.view p: math.BigInt.view} out String is {
    if x.bitLength <= 192 then return (x.text base: 16)
    return "\{x.sign} \{x.bitLength} \{x.trailingZeros} \{(x.abs % p).text base: 16}"
}

# same -- one check: the digest of got is want
same: function {
    t: Tally.borrow what: StringView got: math.BigInt.view want: StringView p: math.BigInt.view
} is {
    t.checks = t.checks + 1
    g: digest x: got :p
    if g != want then {
        t.bad = t.bad + 1
        print "FAIL \{what}: \{g}, want \{want}"
    }
}


# words0 -- the shapes at 0 words: a all ones, b = a + 1, d and e
# pseudo-random (d odd, e half d's length with its top bit set)
words0: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: big text: "0"
    b: one << 0
    d: big text: "1"
    e: big text: "8d2bdacd888ea7d6"
    same :t what: "0w a+1" got: a + one want: "1" :p
    same :t what: "0w 1+a" got: one + a want: "1" :p
    same :t what: "0w b-1" got: b - one want: "0" :p
    same :t what: "0w 1-b" got: one - b want: "0" :p
    same :t what: "0w a+a" got: a + a want: "0" :p
    same :t what: "0w a-a" got: a - a want: "0" :p
    same :t what: "0w a+d" got: a + d want: "1" :p
    same :t what: "0w d-a" got: d - a want: "1" :p
    same :t what: "0w d+w" got: d + w want: "10000000000000000" :p
    same :t what: "0w d-w" got: d - w want: "-fffffffffffffffe" :p
    same :t what: "0w a*w" got: a * w want: "0" :p
    same :t what: "0w d*w" got: d * w want: "ffffffffffffffff" :p
    same :t what: "0w a*a" got: a * a want: "0" :p
    same :t what: "0w a*d" got: a * d want: "0" :p
    same :t what: "0w d*d" got: d * d want: "1" :p
    same :t what: "0w d*e" got: d * e want: "8d2bdacd888ea7d6" :p
    same :t what: "0w a<<0" got: a << 0 want: "0" :p
    same :t what: "0w d<<0" got: d << 0 want: "1" :p
    same :t what: "0w a>>0" got: a >> 0 want: "0" :p
    same :t what: "0w d>>0" got: d >> 0 want: "1" :p
    same :t what: "0w -d>>0" got: d.neg >> 0 want: "-1" :p
    same :t what: "0w a<<1" got: a << 1 want: "0" :p
    same :t what: "0w d<<1" got: d << 1 want: "2" :p
    same :t what: "0w a>>1" got: a >> 1 want: "0" :p
    same :t what: "0w d>>1" got: d >> 1 want: "0" :p
    same :t what: "0w -d>>1" got: d.neg >> 1 want: "-1" :p
    same :t what: "0w a<<63" got: a << 63 want: "0" :p
    same :t what: "0w d<<63" got: d << 63 want: "8000000000000000" :p
    same :t what: "0w a>>63" got: a >> 63 want: "0" :p
    same :t what: "0w d>>63" got: d >> 63 want: "0" :p
    same :t what: "0w -d>>63" got: d.neg >> 63 want: "-1" :p
    same :t what: "0w a<<64" got: a << 64 want: "0" :p
    same :t what: "0w d<<64" got: d << 64 want: "10000000000000000" :p
    same :t what: "0w a>>64" got: a >> 64 want: "0" :p
    same :t what: "0w d>>64" got: d >> 64 want: "0" :p
    same :t what: "0w -d>>64" got: d.neg >> 64 want: "-1" :p
    same :t what: "0w a<<65" got: a << 65 want: "0" :p
    same :t what: "0w d<<65" got: d << 65 want: "20000000000000000" :p
    same :t what: "0w a>>65" got: a >> 65 want: "0" :p
    same :t what: "0w d>>65" got: d >> 65 want: "0" :p
    same :t what: "0w -d>>65" got: d.neg >> 65 want: "-1" :p
    same :t what: "0w a<<127" got: a << 127 want: "0" :p
    same :t what: "0w d<<127" got: d << 127 want: "80000000000000000000000000000000" :p
    same :t what: "0w a>>127" got: a >> 127 want: "0" :p
    same :t what: "0w d>>127" got: d >> 127 want: "0" :p
    same :t what: "0w -d>>127" got: d.neg >> 127 want: "-1" :p
    same :t what: "0w a<<0" got: a << 0 want: "0" :p
    same :t what: "0w d<<0" got: d << 0 want: "1" :p
    same :t what: "0w a>>0" got: a >> 0 want: "0" :p
    same :t what: "0w d>>0" got: d >> 0 want: "1" :p
    same :t what: "0w -d>>0" got: d.neg >> 0 want: "-1" :p
    same :t what: "0w a<<1" got: a << 1 want: "0" :p
    same :t what: "0w d<<1" got: d << 1 want: "2" :p
    same :t what: "0w a>>1" got: a >> 1 want: "0" :p
    same :t what: "0w d>>1" got: d >> 1 want: "0" :p
    same :t what: "0w -d>>1" got: d.neg >> 1 want: "-1" :p
    same :t what: "0w (a*d+d/2)/d" got: a * d + (d >> 1) / d want: "0" :p
    same :t what: "0w (a*d+d/2)%d" got: a * d + (d >> 1) % d want: "0" :p
    same :t what: "0w b/d" got: b / d want: "1" :p
    same :t what: "0w b%d" got: b % d want: "0" :p
    same :t what: "0w -b/d" got: b.neg / d want: "-1" :p
    same :t what: "0w d*d/e" got: d * d / e want: "0" :p
    same :t what: "0w d*d%e" got: d * d % e want: "1" :p
    x: a.copy
    x.add x: one
    same :t what: "0w x += 1" got: x want: "1" :p
    x.sub x: one
    same :t what: "0w x -= 1" got: x want: "0" :p
    x.add x: d
    same :t what: "0w x += d" got: x want: "1" :p
    x.sub x: a
    same :t what: "0w x -= a" got: x want: "1" :p
    x.mul x: d
    same :t what: "0w x *= d" got: x want: "1" :p
    x.add x: w
    same :t what: "0w x += w" got: x want: "10000000000000000" :p
    x.quo x: d
    same :t what: "0w x /= d" got: x want: "10000000000000000" :p
    x.sub x: b
    same :t what: "0w x -= b" got: x want: "ffffffffffffffff" :p
    x.rem x: e
    same :t what: "0w x %= e" got: x want: "72d4253277715829" :p
}

# words1 -- the shapes at 1 words: a all ones, b = a + 1, d and e
# pseudo-random (d odd, e half d's length with its top bit set)
words1: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: big text: "ffffffffffffffff"
    b: one << 64
    d: big text: "853ce24f0bdc3b2d"
    e: big text: "e57dcefad5242703"
    same :t what: "1w a+1" got: a + one want: "10000000000000000" :p
    same :t what: "1w 1+a" got: one + a want: "10000000000000000" :p
    same :t what: "1w b-1" got: b - one want: "ffffffffffffffff" :p
    same :t what: "1w 1-b" got: one - b want: "-ffffffffffffffff" :p
    same :t what: "1w a+a" got: a + a want: "1fffffffffffffffe" :p
    same :t what: "1w a-a" got: a - a want: "0" :p
    same :t what: "1w a+d" got: a + d want: "1853ce24f0bdc3b2c" :p
    same :t what: "1w d-a" got: d - a want: "-7ac31db0f423c4d2" :p
    same :t what: "1w d+w" got: d + w want: "1853ce24f0bdc3b2c" :p
    same :t what: "1w d-w" got: d - w want: "-7ac31db0f423c4d2" :p
    same :t what: "1w a*w" got: a * w want: "fffffffffffffffe0000000000000001" :p
    same :t what: "1w d*w" got: d * w want: "853ce24f0bdc3b2c7ac31db0f423c4d3" :p
    same :t what: "1w a*a" got: a * a want: "fffffffffffffffe0000000000000001" :p
    same :t what: "1w a*d" got: a * d want: "853ce24f0bdc3b2c7ac31db0f423c4d3" :p
    same :t what: "1w d*d" got: d * d want: "455851a0ff700e11aa0ca451a105c5e9" :p
    same :t what: "1w d*e" got: d * e want: "7770f0e4c0b3e15e60d599e273ec8c87" :p
    same :t what: "1w a<<0" got: a << 0 want: "ffffffffffffffff" :p
    same :t what: "1w d<<0" got: d << 0 want: "853ce24f0bdc3b2d" :p
    same :t what: "1w a>>0" got: a >> 0 want: "ffffffffffffffff" :p
    same :t what: "1w d>>0" got: d >> 0 want: "853ce24f0bdc3b2d" :p
    same :t what: "1w -d>>0" got: d.neg >> 0 want: "-853ce24f0bdc3b2d" :p
    same :t what: "1w a<<1" got: a << 1 want: "1fffffffffffffffe" :p
    same :t what: "1w d<<1" got: d << 1 want: "10a79c49e17b8765a" :p
    same :t what: "1w a>>1" got: a >> 1 want: "7fffffffffffffff" :p
    same :t what: "1w d>>1" got: d >> 1 want: "429e712785ee1d96" :p
    same :t what: "1w -d>>1" got: d.neg >> 1 want: "-429e712785ee1d97" :p
    same :t what: "1w a<<63" got: a << 63 want: "7fffffffffffffff8000000000000000" :p
    same :t what: "1w d<<63" got: d << 63 want: "429e712785ee1d968000000000000000" :p
    same :t what: "1w a>>63" got: a >> 63 want: "1" :p
    same :t what: "1w d>>63" got: d >> 63 want: "1" :p
    same :t what: "1w -d>>63" got: d.neg >> 63 want: "-2" :p
    same :t what: "1w a<<64" got: a << 64 want: "ffffffffffffffff0000000000000000" :p
    same :t what: "1w d<<64" got: d << 64 want: "853ce24f0bdc3b2d0000000000000000" :p
    same :t what: "1w a>>64" got: a >> 64 want: "0" :p
    same :t what: "1w d>>64" got: d >> 64 want: "0" :p
    same :t what: "1w -d>>64" got: d.neg >> 64 want: "-1" :p
    same :t what: "1w a<<65" got: a << 65 want: "1fffffffffffffffe0000000000000000" :p
    same :t what: "1w d<<65" got: d << 65 want: "10a79c49e17b8765a0000000000000000" :p
    same :t what: "1w a>>65" got: a >> 65 want: "0" :p
    same :t what: "1w d>>65" got: d >> 65 want: "0" :p
    same :t what: "1w -d>>65" got: d.neg >> 65 want: "-1" :p
    (same
        :t
        what: "1w a<<127"
        got: a << 127
        want: "7fffffffffffffff80000000000000000000000000000000"
        :p
    )
    (same
        :t
        what: "1w d<<127"
        got: d << 127
        want: "429e712785ee1d9680000000000000000000000000000000"
        :p
    )
    same :t what: "1w a>>127" got: a >> 127 want: "0" :p
    same :t what: "1w d>>127" got: d >> 127 want: "0" :p
    same :t what: "1w -d>>127" got: d.neg >> 127 want: "-1" :p
    same :t what: "1w a<<64" got: a << 64 want: "ffffffffffffffff0000000000000000" :p
    same :t what: "1w d<<64" got: d << 64 want: "853ce24f0bdc3b2d0000000000000000" :p
    same :t what: "1w a>>64" got: a >> 64 want: "0" :p
    same :t what: "1w d>>64" got: d >> 64 want: "0" :p
    same :t what: "1w -d>>64" got: d.neg >> 64 want: "-1" :p
    same :t what: "1w a<<65" got: a << 65 want: "1fffffffffffffffe0000000000000000" :p
    same :t what: "1w d<<65" got: d << 65 want: "10a79c49e17b8765a0000000000000000" :p
    same :t what: "1w a>>65" got: a >> 65 want: "0" :p
    same :t what: "1w d>>65" got: d >> 65 want: "0" :p
    same :t what: "1w -d>>65" got: d.neg >> 65 want: "-1" :p
    same :t what: "1w (a*d+d/2)/d" got: a * d + (d >> 1) / d want: "ffffffffffffffff" :p
    same :t what: "1w (a*d+d/2)%d" got: a * d + (d >> 1) % d want: "429e712785ee1d96" :p
    same :t what: "1w b/d" got: b / d want: "1" :p
    same :t what: "1w b%d" got: b % d want: "7ac31db0f423c4d3" :p
    same :t what: "1w -b/d" got: b.neg / d want: "-1" :p
    same :t what: "1w d*d/e" got: d * d / e want: "4d5ae3b96e18c2cd" :p
    same :t what: "1w d*d%e" got: d * d % e want: "aa94719d9b3a4282" :p
    same :t what: "1w b/a" got: b / a want: "1" :p
    same :t what: "1w b%a" got: b % a want: "1" :p
    same :t what: "1w a*a/a" got: a * a / a want: "ffffffffffffffff" :p
    x: a.copy
    x.add x: one
    same :t what: "1w x += 1" got: x want: "10000000000000000" :p
    x.sub x: one
    same :t what: "1w x -= 1" got: x want: "ffffffffffffffff" :p
    x.add x: d
    same :t what: "1w x += d" got: x want: "1853ce24f0bdc3b2c" :p
    x.sub x: a
    same :t what: "1w x -= a" got: x want: "853ce24f0bdc3b2d" :p
    x.mul x: d
    same :t what: "1w x *= d" got: x want: "455851a0ff700e11aa0ca451a105c5e9" :p
    x.add x: w
    same :t what: "1w x += w" got: x want: "455851a0ff700e12aa0ca451a105c5e8" :p
    x.quo x: d
    same :t what: "1w x /= d" got: x want: "853ce24f0bdc3b2e" :p
    x.sub x: b
    same :t what: "1w x -= b" got: x want: "-7ac31db0f423c4d2" :p
    x.rem x: e
    same :t what: "1w x %= e" got: x want: "-7ac31db0f423c4d2" :p
    f: math.BigFloat.fromInt from: a prec: 63
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "1w round a to 63 bits" got: fi want: "10000000000000000" :p
    } case none then {
        same :t what: "1w round a to 63 bits" got: one want: "inf" :p
    }
}

# words2 -- the shapes at 2 words: a all ones, b = a + 1, d and e
# pseudo-random (d odd, e half d's length with its top bit set)
words2: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: big text: "ffffffffffffffffffffffffffffffff"
    b: one << 128
    d: big text: "7b3fa6911d39e921dd8ed67c5871ba5b"
    e: big text: "bdcfc32821b9a630"
    same :t what: "2w a+1" got: a + one want: "100000000000000000000000000000000" :p
    same :t what: "2w 1+a" got: one + a want: "100000000000000000000000000000000" :p
    same :t what: "2w b-1" got: b - one want: "ffffffffffffffffffffffffffffffff" :p
    same :t what: "2w 1-b" got: one - b want: "-ffffffffffffffffffffffffffffffff" :p
    same :t what: "2w a+a" got: a + a want: "1fffffffffffffffffffffffffffffffe" :p
    same :t what: "2w a-a" got: a - a want: "0" :p
    same :t what: "2w a+d" got: a + d want: "17b3fa6911d39e921dd8ed67c5871ba5a" :p
    same :t what: "2w d-a" got: d - a want: "-84c0596ee2c616de22712983a78e45a4" :p
    same :t what: "2w d+w" got: d + w want: "7b3fa6911d39e922dd8ed67c5871ba5a" :p
    same :t what: "2w d-w" got: d - w want: "7b3fa6911d39e920dd8ed67c5871ba5c" :p
    same :t what: "2w a*w" got: a * w want: "fffffffffffffffeffffffffffffffff0000000000000001" :p
    same :t what: "2w d*w" got: d * w want: "7b3fa6911d39e921624f2feb3b37d13922712983a78e45a5" :p
    same :t what: "2w a*a" got: a * a want: "1 256 0 1" :p
    same :t what: "2w a*d" got: a * d want: "1 255 0 7b3fa6911d39e921dd8ed67c5871ba5b" :p
    same :t what: "2w d*d" got: d * d want: "1 254 0 60644ccc77316506d0f40ad9cf7bd58c" :p
    same :t what: "2w d*e" got: d * e want: "5b6204659ff9885ba629bdf78699e73a826cdb17baecf310" :p
    same :t what: "2w a<<0" got: a << 0 want: "ffffffffffffffffffffffffffffffff" :p
    same :t what: "2w d<<0" got: d << 0 want: "7b3fa6911d39e921dd8ed67c5871ba5b" :p
    same :t what: "2w a>>0" got: a >> 0 want: "ffffffffffffffffffffffffffffffff" :p
    same :t what: "2w d>>0" got: d >> 0 want: "7b3fa6911d39e921dd8ed67c5871ba5b" :p
    same :t what: "2w -d>>0" got: d.neg >> 0 want: "-7b3fa6911d39e921dd8ed67c5871ba5b" :p
    same :t what: "2w a<<1" got: a << 1 want: "1fffffffffffffffffffffffffffffffe" :p
    same :t what: "2w d<<1" got: d << 1 want: "f67f4d223a73d243bb1dacf8b0e374b6" :p
    same :t what: "2w a>>1" got: a >> 1 want: "7fffffffffffffffffffffffffffffff" :p
    same :t what: "2w d>>1" got: d >> 1 want: "3d9fd3488e9cf490eec76b3e2c38dd2d" :p
    same :t what: "2w -d>>1" got: d.neg >> 1 want: "-3d9fd3488e9cf490eec76b3e2c38dd2e" :p
    (same
        :t
        what: "2w a<<63"
        got: a << 63
        want: "7fffffffffffffffffffffffffffffff8000000000000000"
        :p
    )
    (same
        :t
        what: "2w d<<63"
        got: d << 63
        want: "3d9fd3488e9cf490eec76b3e2c38dd2d8000000000000000"
        :p
    )
    same :t what: "2w a>>63" got: a >> 63 want: "1ffffffffffffffff" :p
    same :t what: "2w d>>63" got: d >> 63 want: "f67f4d223a73d243" :p
    same :t what: "2w -d>>63" got: d.neg >> 63 want: "-f67f4d223a73d244" :p
    (same
        :t
        what: "2w a<<64"
        got: a << 64
        want: "ffffffffffffffffffffffffffffffff0000000000000000"
        :p
    )
    (same
        :t
        what: "2w d<<64"
        got: d << 64
        want: "7b3fa6911d39e921dd8ed67c5871ba5b0000000000000000"
        :p
    )
    same :t what: "2w a>>64" got: a >> 64 want: "ffffffffffffffff" :p
    same :t what: "2w d>>64" got: d >> 64 want: "7b3fa6911d39e921" :p
    same :t what: "2w -d>>64" got: d.neg >> 64 want: "-7b3fa6911d39e922" :p
    same :t what: "2w a<<65" got: a << 65 want: "1 193 65 20000000000000000" :p
    (same
        :t
        what: "2w d<<65"
        got: d << 65
        want: "f67f4d223a73d243bb1dacf8b0e374b60000000000000000"
        :p
    )
    same :t what: "2w a>>65" got: a >> 65 want: "7fffffffffffffff" :p
    same :t what: "2w d>>65" got: d >> 65 want: "3d9fd3488e9cf490" :p
    same :t what: "2w -d>>65" got: d.neg >> 65 want: "-3d9fd3488e9cf491" :p
    same :t what: "2w a<<127" got: a << 127 want: "1 255 127 1" :p
    same :t what: "2w d<<127" got: d << 127 want: "1 254 127 7b3fa6911d39e921dd8ed67c5871ba5b" :p
    same :t what: "2w a>>127" got: a >> 127 want: "1" :p
    same :t what: "2w d>>127" got: d >> 127 want: "0" :p
    same :t what: "2w -d>>127" got: d.neg >> 127 want: "-1" :p
    same :t what: "2w a<<128" got: a << 128 want: "1 256 128 2" :p
    same :t what: "2w d<<128" got: d << 128 want: "1 255 128 767f4d223a73d243bb1dacf8b0e374b7" :p
    same :t what: "2w a>>128" got: a >> 128 want: "0" :p
    same :t what: "2w d>>128" got: d >> 128 want: "0" :p
    same :t what: "2w -d>>128" got: d.neg >> 128 want: "-1" :p
    same :t what: "2w a<<129" got: a << 129 want: "1 257 129 4" :p
    same :t what: "2w d<<129" got: d << 129 want: "1 256 129 6cfe9a4474e7a487763b59f161c6e96f" :p
    same :t what: "2w a>>129" got: a >> 129 want: "0" :p
    same :t what: "2w d>>129" got: d >> 129 want: "0" :p
    same :t what: "2w -d>>129" got: d.neg >> 129 want: "-1" :p
    (same
        :t
        what: "2w (a*d+d/2)/d"
        got: a * d + (d >> 1) / d
        want: "ffffffffffffffffffffffffffffffff"
        :p
    )
    (same
        :t
