# pseudo-random (d odd, e half d's length with its top bit set)
words8: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: (big
        text: "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
    )
    b: one << 512
    d: (big
        text: "bd58b99f40104f65c2df1e32b294442ee9402b5f75ee71bb82e47ea81d31d59c96d3a65f0a1a5da10be7dc01fe50d0daed7d3a5d2697fc97ef7a8f8c23f2b569"
    )
    e: big text: "1b448d334ab6816f6ea25fe65db014a06b2ffae801c99b35cfbb7c37ed3aa13e"
    same :t what: "8w a+1" got: a + one want: "1 513 512 10" :p
    same :t what: "8w 1+a" got: one + a want: "1 513 512 10" :p
    same :t what: "8w b-1" got: b - one want: "1 512 0 f" :p
    same :t what: "8w 1-b" got: one - b want: "-1 512 0 f" :p
    same :t what: "8w a+a" got: a + a want: "1 513 1 1e" :p
    same :t what: "8w a-a" got: a - a want: "0" :p
    same :t what: "8w a+d" got: a + d want: "1 513 3 2aeb01931308f9f629d533c629fdcf23" :p
    same :t what: "8w d-a" got: d - a want: "-1 511 1 5514fe6cecf70609d62acc39d60230fa" :p
    same :t what: "8w d+w" got: d + w want: "1 512 3 2aeb01931308f9f729d533c629fdcf13" :p
    same :t what: "8w d-w" got: d - w want: "1 512 1 2aeb01931308f9f529d533c629fdcf15" :p
    same :t what: "8w a*w" got: a * w want: "1 576 0 efffffffffffffff1" :p
    same :t what: "8w d*w" got: d * w want: "1 576 0 7eea323316f4d51e2c00cf5ffc1424d7" :p
    same :t what: "8w a*a" got: a * a want: "1 1024 0 e1" :p
    same :t what: "8w a*d" got: a * d want: "1 1024 0 3c5179e1d86a56c737e089c75df2231" :p
    same :t what: "8w d*d" got: d * d want: "1 1024 0 542128bf52195b8859f9bca12a0e3769" :p
    same :t what: "8w d*e" got: d * e want: "1 765 1 7d0c25707b9013f7d31b0b15977b3df8" :p
    same :t what: "8w a<<0" got: a << 0 want: "1 512 0 f" :p
    same :t what: "8w d<<0" got: d << 0 want: "1 512 0 2aeb01931308f9f629d533c629fdcf14" :p
    same :t what: "8w a>>0" got: a >> 0 want: "1 512 0 f" :p
    same :t what: "8w d>>0" got: d >> 0 want: "1 512 0 2aeb01931308f9f629d533c629fdcf14" :p
    same :t what: "8w -d>>0" got: d.neg >> 0 want: "-1 512 0 2aeb01931308f9f629d533c629fdcf14" :p
    same :t what: "8w a<<1" got: a << 1 want: "1 513 1 1e" :p
    same :t what: "8w d<<1" got: d << 1 want: "1 513 1 55d603262611f3ec53aa678c53fb9e28" :p
    same :t what: "8w a>>1" got: a >> 1 want: "1 511 0 7" :p
    same :t what: "8w d>>1" got: d >> 1 want: "1 511 2 557580c989847cfb14ea99e314fee789" :p
    same :t what: "8w -d>>1" got: d.neg >> 1 want: "-1 511 0 557580c989847cfb14ea99e314fee78a" :p
    same :t what: "8w a<<63" got: a << 63 want: "1 575 63 78000000000000000" :p
    same :t what: "8w d<<63" got: d << 63 want: "1 575 63 14ea99e314fee78a2aeb01931308f9f6" :p
    same :t what: "8w a>>63" got: a >> 63 want: "1 449 0 fffffffffffffffff" :p
    same :t what: "8w d>>63" got: d >> 63 want: "1 449 0 3a5aa43a060b19ab55d603262611f3eb" :p
    same :t what: "8w -d>>63" got: d.neg >> 63 want: "-1 449 4 3a5aa43a060b19ab55d603262611f3ec" :p
    same :t what: "8w a<<64" got: a << 64 want: "1 576 64 f0000000000000000" :p
    same :t what: "8w d<<64" got: d << 64 want: "1 576 64 29d533c629fdcf1455d603262611f3ec" :p
    same :t what: "8w a>>64" got: a >> 64 want: "1 448 0 7ffffffffffffffff" :p
    same :t what: "8w d>>64" got: d >> 64 want: "1 448 0 1d2d521d03058cd5aaeb01931308f9f5" :p
    same :t what: "8w -d>>64" got: d.neg >> 64 want: "-1 448 3 1d2d521d03058cd5aaeb01931308f9f6" :p
    same :t what: "8w a<<65" got: a << 65 want: "1 577 65 1e0000000000000000" :p
    same :t what: "8w d<<65" got: d << 65 want: "1 577 65 53aa678c53fb9e28abac064c4c23e7d8" :p
    same :t what: "8w a>>65" got: a >> 65 want: "1 447 0 3ffffffffffffffff" :p
    same :t what: "8w d>>65" got: d >> 65 want: "1 447 0 e96a90e8182c66ad57580c989847cfa" :p
    same :t what: "8w -d>>65" got: d.neg >> 65 want: "-1 447 2 e96a90e8182c66ad57580c989847cfb" :p
    same :t what: "8w a<<127" got: a << 127 want: "1 639 127 f" :p
    same :t what: "8w d<<127" got: d << 127 want: "1 639 127 2aeb01931308f9f629d533c629fdcf14" :p
    same :t what: "8w a>>127" got: a >> 127 want: "1 385 0 f" :p
    same :t what: "8w d>>127" got: d >> 127 want: "1 385 0 3d6dc735ec70fd5e3a5aa43a060b19aa" :p
    (same
        :t
        what: "8w -d>>127"
        got: d.neg >> 127
        want: "-1 385 1 3d6dc735ec70fd5e3a5aa43a060b19ab"
        :p
    )
    same :t what: "8w a<<512" got: a << 512 want: "1 1024 512 f0" :p
    same :t what: "8w d<<512" got: d << 512 want: "1 1024 512 2eb01931308f9f629d533c629fdcf145" :p
    same :t what: "8w a>>512" got: a >> 512 want: "0" :p
    same :t what: "8w d>>512" got: d >> 512 want: "0" :p
    same :t what: "8w -d>>512" got: d.neg >> 512 want: "-1" :p
    same :t what: "8w a<<513" got: a << 513 want: "1 1025 513 1e0" :p
    same :t what: "8w d<<513" got: d << 513 want: "1 1025 513 5d603262611f3ec53aa678c53fb9e28a" :p
    same :t what: "8w a>>513" got: a >> 513 want: "0" :p
    same :t what: "8w d>>513" got: d >> 513 want: "0" :p
    same :t what: "8w -d>>513" got: d.neg >> 513 want: "-1" :p
    same :t what: "8w (a*d+d/2)/d" got: a * d + (d >> 1) / d want: "1 512 0 f" :p
    (same
        :t
        what: "8w (a*d+d/2)%d"
        got: a * d + (d >> 1) % d
        want: "1 511 2 557580c989847cfb14ea99e314fee789"
        :p
    )
    same :t what: "8w b/d" got: b / d want: "1" :p
    same :t what: "8w b%d" got: b % d want: "1 511 0 5514fe6cecf70609d62acc39d60230fb" :p
    same :t what: "8w -b/d" got: b.neg / d want: "-1" :p
    same :t what: "8w d*d/e" got: d * d / e want: "1 771 0 5f2ff32775f8131277351b65e3770750" :p
    same :t what: "8w d*d%e" got: d * d % e want: "1 251 0 67f11c9d69fac8cad70c331b865376ea" :p
    same :t what: "8w b/a" got: b / a want: "1" :p
    same :t what: "8w b%a" got: b % a want: "1" :p
    same :t what: "8w a*a/a" got: a * a / a want: "1 512 0 f" :p
    x: a.copy
    x.add x: one
    same :t what: "8w x += 1" got: x want: "1 513 512 10" :p
    x.sub x: one
    same :t what: "8w x -= 1" got: x want: "1 512 0 f" :p
    x.add x: d
    same :t what: "8w x += d" got: x want: "1 513 3 2aeb01931308f9f629d533c629fdcf23" :p
    x.sub x: a
    same :t what: "8w x -= a" got: x want: "1 512 0 2aeb01931308f9f629d533c629fdcf14" :p
    x.mul x: d
    same :t what: "8w x *= d" got: x want: "1 1024 0 542128bf52195b8859f9bca12a0e3769" :p
    x.add x: w
    same :t what: "8w x += w" got: x want: "1 1024 4 542128bf52195b8959f9bca12a0e3768" :p
    x.quo x: d
    same :t what: "8w x /= d" got: x want: "1 512 0 2aeb01931308f9f629d533c629fdcf14" :p
    x.sub x: b
    same :t what: "8w x -= b" got: x want: "-1 511 0 5514fe6cecf70609d62acc39d60230fb" :p
    x.rem x: e
    same :t what: "8w x %= e" got: x want: "-1 252 0 2d115b2db07f8524552f4948ccb23567" :p
    f: math.BigFloat.fromInt from: a prec: 511
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "8w round a to 511 bits" got: fi want: "1 513 512 10" :p
    } case none then {
        same :t what: "8w round a to 511 bits" got: one want: "inf" :p
    }
}

