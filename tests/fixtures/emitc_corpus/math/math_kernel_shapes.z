# words23 -- the shapes at 23 words: a all ones, b = a + 1, d and e
# pseudo-random (d odd, e half d's length with its top bit set)
words23: function {t: Tally.borrow p: math.BigInt.view} is {
    one: math.BigInt from: 1
    w: big text: "ffffffffffffffff"
    a: (big
        text: ""
    )
    b: one << 1472
    d: (big
        text: ""
    )
    e: (big
        text: "38c9a2546e1c1003580a365cf3c41a049eb379eeb940b4a9394d9edd2690290283f21b5035e20e5f2e9686409ae76b50a91e6a87fc9ffaa5d4cb0088df6fa46e13e48dde8ddd7afb88c9ec661934cbdcfc88cadf69fd14e1"
