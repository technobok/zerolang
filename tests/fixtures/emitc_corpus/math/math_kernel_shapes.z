    same :t what: "2w b%a" got: b % a want: "1" :p
    same :t what: "2w a*a/a" got: a * a / a want: "ffffffffffffffffffffffffffffffff" :p
    x: a.copy
    x.add x: one
    same :t what: "2w x += 1" got: x want: "100000000000000000000000000000000" :p
    x.sub x: one
    same :t what: "2w x -= 1" got: x want: "ffffffffffffffffffffffffffffffff" :p
    x.add x: d
    same :t what: "2w x += d" got: x want: "17b3fa6911d39e921dd8ed67c5871ba5a" :p
    x.sub x: a
    same :t what: "2w x -= a" got: x want: "7b3fa6911d39e921dd8ed67c5871ba5b" :p
    x.mul x: d
    same :t what: "2w x *= d" got: x want: "1 254 0 60644ccc77316506d0f40ad9cf7bd58c" :p
    x.add x: w
    same :t what: "2w x += w" got: x want: "1 254 3 60644ccc77316507d0f40ad9cf7bd58b" :p
    x.quo x: d
    same :t what: "2w x /= d" got: x want: "7b3fa6911d39e921dd8ed67c5871ba5b" :p
    x.sub x: b
    same :t what: "2w x -= b" got: x want: "-84c0596ee2c616de22712983a78e45a5" :p
    x.rem x: e
    same :t what: "2w x %= e" got: x want: "-584e7bf7ac806625" :p
    f: math.BigFloat.fromInt from: a prec: 127
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "2w round a to 127 bits" got: fi want: "100000000000000000000000000000000" :p
    } case none then {
        same :t what: "2w round a to 127 bits" got: one want: "inf" :p
    }
}

