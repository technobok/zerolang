    same :t what: "2w b/d" got: b / d want: "2" :p
    same :t what: "2w b%d" got: b % d want: "980b2ddc58c2dbc44e253074f1c8b4a" :p
    same :t what: "2w -b/d" got: b.neg / d want: "-2" :p
    (same
        :t
