    same :t what: "9w x += d" got: x want: "1 577 2 7907edb64105f7052edc0ae1fb20600e" :p
    x.sub x: a
    same :t what: "9w x -= a" got: x want: "1 576 0 7907edb64105f6f52edc0ae1fb20600f" :p
    x.mul x: d
    same :t what: "9w x *= d" got: x want: "1 1151 0 322c8d827a9cb1d41a75f554468f1ca0" :p
    x.add x: w
    same :t what: "9w x += w" got: x want: "1 1151 3 322c8d827a9cb1d51a75f554468f1c9f" :p
    x.quo x: d
