    words39 :t :p
    words40 :t :p
    words41 :t :p
    words59 :t :p
    words60 :t :p
    words61 :t :p
    words81 :t :p
    words100 :t :p
    if t.bad == 0 then {
        print "ok \{t.checks} checks"
    } else {
        print "\{t.bad} of \{t.checks} checks FAILED"
    }
}
