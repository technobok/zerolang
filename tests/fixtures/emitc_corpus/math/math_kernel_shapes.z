    same :t what: "100w a>>6400" got: a >> 6400 want: "0" :p
    same :t what: "100w d>>6400" got: d >> 6400 want: "0" :p
    same :t what: "100w -d>>6400" got: d.neg >> 6400 want: "-1" :p
    same :t what: "100w a<<6401" got: a << 6401 want: "1 12801 6401 1ffffffffffff8000000000000" :p
    (same
        :t
        what: "100w d<<6401"
        got: d << 6401
        want: "1 12795 6401 6b10dea08077d2a4de89f9125f1406e5"
        :p
    )
    same :t what: "100w a>>6401" got: a >> 6401 want: "0" :p
    same :t what: "100w d>>6401" got: d >> 6401 want: "0" :p
    same :t what: "100w -d>>6401" got: d.neg >> 6401 want: "-1" :p
    same :t what: "100w (a*d+d/2)/d" got: a * d + (d >> 1) / d want: "1 6400 0 3ffffffffffff" :p
    (same
        :t
        what: "100w (a*d+d/2)%d"
        got: a * d + (d >> 1) % d
        want: "1 6393 1 fc892f8a0372eb10dea08077d2a4de8"
        :p
    )
    same :t what: "100w b/d" got: b / d want: "50" :p
    same :t what: "100w b%d" got: b % d want: "1 6394 4 22a4249bdd82d1574dbefb51c58f4e9c" :p
    same :t what: "100w -b/d" got: b.neg / d want: "-50" :p
    same :t what: "100w d*d/e" got: d * d / e want: "1 9589 0 7afe0df93ec9c3ae85a8f65656807a83" :p
    same :t what: "100w d*d%e" got: d * d % e want: "1 3198 0 6aa370c0ca8d2480013b5796246a667c" :p
    same :t what: "100w b/a" got: b / a want: "1" :p
    same :t what: "100w b%a" got: b % a want: "1" :p
    same :t what: "100w a*a/a" got: a * a / a want: "1 6400 0 3ffffffffffff" :p
    x: a.copy
    x.add x: one
    same :t what: "100w x += 1" got: x want: "1 6401 6400 4000000000000" :p
    x.sub x: one
    same :t what: "100w x -= 1" got: x want: "1 6400 0 3ffffffffffff" :p
    x.add x: d
    same :t what: "100w x += d" got: x want: "1 6401 2 1f9125f1406e5d621bd8100efa549bd0" :p
    x.sub x: a
    same :t what: "100w x -= a" got: x want: "1 6394 0 1f9125f1406e5d621bd4100efa549bd1" :p
    x.mul x: d
    same :t what: "100w x *= d" got: x want: "1 12788 0 1ff9c38029422a6ab7716574bb98c518" :p
    x.add x: w
    same :t what: "100w x += w" got: x want: "1 12788 3 1ff9c38029422a6bb7716574bb98c517" :p
    x.quo x: d
    same :t what: "100w x /= d" got: x want: "1 6394 0 1f9125f1406e5d621bd4100efa549bd1" :p
    x.sub x: b
    same :t what: "100w x -= b" got: x want: "-1 6400 0 606eda0ebf91a29de42feff105ab642e" :p
    x.rem x: e
    same :t what: "100w x %= e" got: x want: "-1 3199 0 16a51ec0db6cf30d3aa327ba540bfbb2" :p
    f: math.BigFloat.fromInt from: a prec: 6399
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "100w round a to 6399 bits" got: fi want: "1 6401 6400 4000000000000" :p
    } case none then {
        same :t what: "100w round a to 6399 bits" got: one want: "inf" :p
    }
}

main: function is {
    t: Tally checks: 0 bad: 0
    p: big text: "7fffffffffffffffffffffffffffffff"
    words0 :t :p
    words1 :t :p
    words2 :t :p
    words3 :t :p
    words5 :t :p
    words8 :t :p
    words13 :t :p
    words39 :t :p
    words40 :t :p
    words41 :t :p
    words81 :t :p
    words100 :t :p
    if t.bad == 0 then {
        print "ok \{t.checks} checks"
    } else {
        print "\{t.bad} of \{t.checks} checks FAILED"
    }
}
