    x.sub x: one
    same :t what: "59w x -= 1" got: x want: "1 3776 0 1fffffffffffffffffffffff" :p
    x.add x: d
    same :t what: "59w x += d" got: x want: "1 3777 1 3058a309f133df3453f3af62ee86a047" :p
    x.sub x: a
    same :t what: "59w x -= a" got: x want: "1 3775 0 3058a309d133df3453f3af62ee86a048" :p
    x.mul x: d
    same :t what: "59w x *= d" got: x want: "1 7550 0 264e0f81cd54a56589be15a620aebfd3" :p
    x.add x: w
    same :t what: "59w x += w" got: x want: "1 7550 6 264e0f81cd54a56689be15a620aebfd2" :p
    x.quo x: d
    same :t what: "59w x /= d" got: x want: "1 3775 0 3058a309d133df3453f3af62ee86a048" :p
    x.sub x: b
    same :t what: "59w x -= b" got: x want: "-1 3776 0 4fa75cf64ecc20cbac0c509d11795fb7" :p
    x.rem x: e
    same :t what: "59w x %= e" got: x want: "-1 1854 1 5d1a60fe936942037081596ee548b442" :p
    f: math.BigFloat.fromInt from: a prec: 3775
    fi: f.truncInt
    match (
        fi
    ) case some then {
        (same
            :t
            what: "59w round a to 3775 bits"
            got: fi
            want: "1 3777 3776 200000000000000000000000"
            :p
        )
    } case none then {
        same :t what: "59w round a to 3775 bits" got: one want: "inf" :p
    }
}

