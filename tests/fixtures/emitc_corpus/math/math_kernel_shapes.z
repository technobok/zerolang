    same :t what: "25w x *= d" got: x want: "1 3192 0 2ef6a4965bd65f358ec7a0e98644a570" :p
    x.add x: w
    same :t what: "25w x += w" got: x want: "1 3192 3 2ef6a4965bd65f368ec7a0e98644a56f" :p
    x.quo x: d
    same :t what: "25w x /= d" got: x want: "1 1596 0 68b6ac7bd5cd5e89ddcb04b9091cd7df" :p
    x.sub x: b
    same :t what: "25w x -= b" got: x want: "-1 1600 0 174953842a32b1762234fb46f6e32820" :p
    x.rem x: e
    same :t what: "25w x %= e" got: x want: "-1 765 0 552279031b955c78affcc56138395cba" :p
    f: math.BigFloat.fromInt from: a prec: 1599
    fi: f.truncInt
    match (
        fi
    ) case some then {
        same :t what: "25w round a to 1599 bits" got: fi want: "1 1601 1600 10000000000000000000" :p
    } case none then {
        same :t what: "25w round a to 1599 bits" got: one want: "inf" :p
    }
}

