# math_fixedint.z -- math's fixed-width integers, (int words: N) and (uint words:
# N), against Python's ints reduced mod 2^(64N). For each width and signedness
# a table of edge and pseudo-random values is read from text; each operator's
# results over every pair (the shifts over a set of counts, the unary ones over
# every value) fold into one digest through the type's own `hash`, so a failing
# digest names its operator and width. Text, conversions and the BigInt round
# trip are checked value by value. Generated by fixedtables.py.

# the failures, and the checks run
Tally: class {
    checks: u64
    bad: u64
}

# fold -- the FNV-1a step every digest takes, over a hash
fold: function {d: u64 h: u64} out u64 is {
    return ((d ^ h).mulWide rhs: 1099511628211).lo
}

# digest -- one check: a digest against the oracle's
digest: function {t: Tally.borrow what: StringView got: u64 want: u64} is {
    t.checks = t.checks + 1
    if got != want then {
        t.bad = t.bad + 1
        print "FAIL \{what}: digest \{got}, want \{want}"
    }
}

# same -- one check: the two texts agree
same: function {t: Tally.borrow what: StringView got: String.view want: StringView} is {
    t.checks = t.checks + 1
    if got != want then {
        t.bad = t.bad + 1
        print "FAIL \{what}: \{got}, want \{want}"
    }
}

# truth -- one check: the condition holds
truth: function {t: Tally.borrow what: StringView ok: bool} is {
    t.checks = t.checks + 1
    if ok.not then {
        t.bad = t.bad + 1
        print "FAIL \{what}"
    }
}


# int1 -- (math.int words: 1): 13 values
int1: function {t: Tally.borrow} is {
    vs: ListVal (math.int words: 1)
    vs.append from: ((math.int words: 1).parse text: "0" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "1" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "2" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "3" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "-9223372036854775808" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "-1" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "-2" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "9223372036854775807" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "-6101065172474983726" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "378377139621324993" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "-2866632182979745220" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "901331494286438875" base: 10).orPanic
    vs.append from: ((math.int words: 1).parse text: "-2170159927530001970" base: 10).orPanic
    zero: (math.int words: 1) from: 0
    dAdd: 14695981039346656037.u64
    dSub: dAdd
    dMul: dAdd
    dDiv: dAdd
    dRem: dAdd
    dAnd: dAdd
    dOr: dAdd
    dXor: dAdd
    dCmp: dAdd
    for each a: vs loop {
        for each b: vs loop {
            dAdd = fold d: dAdd h: (a + b).hash
            dSub = fold d: dSub h: (a - b).hash
            dMul = fold d: dMul h: (a * b).hash
            dAnd = fold d: dAnd h: (a & b).hash
            dOr = fold d: dOr h: (a | b).hash
            dXor = fold d: dXor h: (a ^ b).hash
            dCmp = fold d: dCmp h: (a.compare rhs: b).i64.bits
            if b != zero then {
                dDiv = fold d: dDiv h: (a / b).hash
                dRem = fold d: dRem h: (a % b).hash
            }
        }
    }
    digest :t what: "int1 add" got: dAdd want: 7267885614678547518
    digest :t what: "int1 sub" got: dSub want: 3974795113732629514
    digest :t what: "int1 mul" got: dMul want: 17488802993324828118
    digest :t what: "int1 div" got: dDiv want: 3457269205808599462
    digest :t what: "int1 rem" got: dRem want: 2045956941940900499
    digest :t what: "int1 and" got: dAnd want: 8765337815116831482
    digest :t what: "int1 or" got: dOr want: 267543807004434226
    digest :t what: "int1 xor" got: dXor want: 866914388137328366
    digest :t what: "int1 compare" got: dCmp want: 610126393681716807
    dShl: 14695981039346656037.u64
    dShr: dShl
    dNot: dShl
    dNeg: dShl
    dI64: dShl
    dU64: dShl
    for each a: vs loop {
        dShl = fold d: dShl h: (a << 0).hash
        dShr = fold d: dShr h: (a >> 0).hash
        dShl = fold d: dShl h: (a << 1).hash
        dShr = fold d: dShr h: (a >> 1).hash
        dShl = fold d: dShl h: (a << 63).hash
        dShr = fold d: dShr h: (a >> 63).hash
        dShl = fold d: dShl h: (a << 64).hash
        dShr = fold d: dShr h: (a >> 64).hash
        dShl = fold d: dShl h: (a << 65).hash
        dShr = fold d: dShr h: (a >> 65).hash
        dShl = fold d: dShl h: (a << 69).hash
        dShr = fold d: dShr h: (a >> 69).hash
        dNot = fold d: dNot h: a.not.hash
        dNeg = fold d: dNeg h: (zero - a).hash
        ri: a.i64
        match (
            ri
        ) case ok then dI64 = fold d: dI64 h: ri.bits case err then dI64 = fold d: dI64 h: 23130
        ru: a.u64
        match ru case ok then dU64 = fold d: dU64 h: ru case err then dU64 = fold d: dU64 h: 23130
        (truth
            :t
            what: "int1 big round trip"
            ok: ((math.int words: 1).fromBig from: a.big).orPanic == a
        )
        (truth
            :t
            what: "int1 text round trip"
            ok: ((math.int words: 1).parse text: a.string.stringView base: 10).orPanic == a
        )
        (truth
            :t
            what: "int1 hex round trip"
            ok: ((math.int words: 1).parse text: (a.text base: 16).stringView base: 16).orPanic == a
        )
    }
    digest :t what: "int1 shl" got: dShl want: 13050768950573414247
    digest :t what: "int1 shr" got: dShr want: 14583776533806665497
    digest :t what: "int1 not" got: dNot want: 3792303457530282017
    digest :t what: "int1 neg" got: dNeg want: 9968652119170044922
    digest :t what: "int1 i64" got: dI64 want: 12434034824965223651
    digest :t what: "int1 u64" got: dU64 want: 15169968325844287054
    (same
        :t
        what: "int1 max"
        got: ((math.int words: 1).parse text: "9223372036854775807" base: 10).orPanic.string
        want: "9223372036854775807"
    )
    (same
        :t
        what: "int1 min"
        got: ((math.int words: 1).parse text: "-9223372036854775808" base: 10).orPanic.string
        want: "-9223372036854775808"
    )
    (same
        :t
        what: "int1 max+1 wraps"
        got: (
            ((math.int words: 1).parse text: "9223372036854775807" base: 10).orPanic +
            ((math.int words: 1) from: 1)
        ).string
        want: "-9223372036854775808"
    )
    (same
        :t
        what: "int1 min-1 wraps"
        got: (
            ((math.int words: 1).parse text: "-9223372036854775808" base: 10).orPanic -
            ((math.int words: 1) from: 1)
        ).string
        want: "9223372036854775807"
    )
    over: (math.int words: 1).parse text: "9223372036854775808" base: 10
    match (
        over
    ) case ok then truth :t what: "int1 max+1 refused" ok: false case err then (truth
        :t
        what: "int1 max+1 refused"
        ok: true
    )
    under: (math.int words: 1).parse text: "-9223372036854775809" base: 10
    match (
        under
    ) case ok then truth :t what: "int1 min-1 refused" ok: false case err then (truth
        :t
        what: "int1 min-1 refused"
        ok: true
    )
    dflt: math.int words: 1
    truth :t what: "int1 zero is default" ok: dflt == zero
    (same
        :t
        what: "int1 min/-1"
        got: (
            ((math.int words: 1).parse text: "-9223372036854775808" base: 10).orPanic /
            ((math.int words: 1) from: -1)
        ).string
        want: "-9223372036854775808"
    )
    (same
        :t
        what: "int1 min%-1"
        got: (
            ((math.int words: 1).parse text: "-9223372036854775808" base: 10).orPanic %
            ((math.int words: 1) from: -1)
        ).string
        want: "0"
    )
    (same
        :t
        what: "int1 -7/2"
        got: (((math.int words: 1) from: -7) / ((math.int words: 1) from: 2)).string
        want: "-3"
    )
    (same
        :t
        what: "int1 -7%2"
        got: (((math.int words: 1) from: -7) % ((math.int words: 1) from: 2)).string
        want: "-1"
    )
    same :t what: "int1 -1 hex" got: (((math.int words: 1) from: -1).text base: 16) want: "-1"
}

