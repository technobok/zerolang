        text: "13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084096"
        base: 10
    )
    match (
        over
    ) case ok then truth :t what: "uint8 max+1 refused" ok: false case err then (truth
        :t
        what: "uint8 max+1 refused"
        ok: true
    )
    under: (math.uint words: 8).parse text: "-1" base: 10
    match (
        under
    ) case ok then truth :t what: "uint8 min-1 refused" ok: false case err then (truth
        :t
        what: "uint8 min-1 refused"
        ok: true
    )
    dflt: math.uint words: 8
    truth :t what: "uint8 zero is default" ok: dflt == zero
}

main: function is {
    t: Tally checks: 0 bad: 0
    int1 :t
    uint1 :t
    int2 :t
    uint2 :t
    int3 :t
    uint3 :t
    int4 :t
    uint4 :t
    int8 :t
    uint8 :t
    if t.bad == 0 then {
        print "ok \{t.checks} checks"
    } else {
        print "\{t.bad} of \{t.checks} checks FAILED"
    }
}
