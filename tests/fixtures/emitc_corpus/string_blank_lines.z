# string_blank_lines.z -- a line of only spaces and tabs inside a multi-line
# string is an empty line, whatever its indent: shorter than the closing
# delimiter's, longer, or under a delimiter at the left edge, in a raw string
# and in an interpreted one, beside an interpolation too.
main: function is {
    raw: """
        one
    
        two
            
        three
        """
    print "[\{raw}]"
    plain: "
        one
  	
        two
        "
    print "[\{plain}]"
    left: """
  a
   
  b
"""
    print "[\{left}]"
    hole: "
        x
        n=\{raw.length}
      
        y
        "
    print "[\{hole}]"
}
