# A NUMERIC GENERIC ARGUMENT IS ANY COMPILE-TIME INTEGER, read by one reader
# on every instantiation path. A named constant or a constant expression
# resolved as a TYPE (`int64_t data[i64]`), a data block's length could not be
# inferred, a negative argument minted a different mono at every site, a unit
# instantiation took only a literal, the inference spelling dissected as 0, a
# negative dissection arm never matched, and a generic function's numeric
# parameter could not be called.
N: 4
NARROW: 4.u8
primes: data { 2 3 5 }

irec: record {
    x: i64
} as { n: i64.generic }

Buffer: class {
    used: u32
    describe: function {:this} out StringView is {
        match (
            cap
        ) case 8 then {
            return "small"
        } else {
            return "big"
        }
    }
} as { cap: u32.generic }

Signed: class {
    used: u32
    sign: function {:this} out StringView is {
        match (
            k
        ) case -5 then {
            return "minus five"
        } else {
            return "other"
        }
    }
} as { k: i64.generic }

sized: unit as {
    cap: u32.generic
    describe: function {} out StringView is {
        match (
            cap
        ) case 8 then {
            return "small"
        } else {
            return "big"
        }
    }
}

eight: (sized cap: N * 2)

rep: function as { n: i64.generic } in { v: i64 } out i64 is {
    return v * 2
}

count: function {a: (array t: i64 to: N) r: (irec n: N * 2)} out u64 is {
    return a.length
}

main: function is {
    a: array t: i64 to: N
    b: array t: i64 to: N * 2
    c: array t: i64 to: primes.length
    d: array t: i64 to: NARROW
    s: str to: N
    print "\{a.length} \{b.length} \{c.length} \{d.length} \{s.size}"
    r: (irec n: -5) x: 1
    q: (irec n: -5) x: 2
    r = q
    print "\{r.x}"
    w: (irec n: 8) x: 3
    print "\{count :a r: w}"
    buf: Buffer cap: 8 used: 0
    print "\{buf.describe} \{eight.describe}"
    neg: (Signed k: -5) used: 0
    print "\{neg.sign}"
    print "\{rep n: N * 2 v: 4} \{rep n: -3 v: 1}"
}
