# A binding of an `if` one of whose arms is read out of a readonly path is
# readonly, and reads through it are fine: the arms' places are pinned shared,
# so an arm that is a `.view` result of `o` and an arm that is a field of `o`
# do not conflict. A `with` alias of such a value reads the same way.
Inner: class {
    n: i64
    tag: String
}

Outer: class {
    a: Inner
    b: Inner
} as {
    peek: function {t: this.view} outx Inner.view is { return t.a }
}

pick: function {x: Inner.view y: Inner c: bool} out i64 is {
    d: if c then y else x
    return d.n
}

main: function is {
    o: Outer a: (Inner n: 1 tag: "a".string) b: (Inner n: 2 tag: "b".string)
    {
        d: if o.b.n > 0 then o.peek else o.b
        print "if: \{d.n} \{d.tag}"
    }
    with w: (if o.a.n > 5 then o.peek else o.b) do {
        print "with: \{w.n} \{w.tag}"
    }
    print "pick: \{pick x: o.a y: o.b c: true} \{pick x: o.a y: o.b c: false}"
    o.b.n = 7
    print "after: \{o.a.n} \{o.b.n}"
}
