# A UNIT-LEVEL `if` EVALUATES ONLY WHAT ITS FOLD REACHES. A branch whose
# condition is statically false is never evaluated, so a name nothing declares
# or a run-time call inside one is not an error; neither is a clause after the
# selected one, whose condition is never asked. Each line below compiles, and
# each constant is the value of the branch the fold selected.
LIMIT: 5

g: function {n: i64} out i64 is {
    return n
}

DEAD: if LIMIT > 9 then { GHOST } else { 3 }

DEADCALL: if LIMIT > 9 then { g n: 3 } else { 4 }

AFTER: if LIMIT > 1 then { 1 } else if PHANTOM > 2 then { 2 } else { 3 }

CHAIN: if LIMIT > 9 then { 1 } else if LIMIT > 3 then { 2 } else { 3 }

WORDS: if LIMIT > 9 then { "a" } else { "bb" }

main: function is {
    print "\{DEAD} \{DEADCALL} \{AFTER} \{CHAIN} \{WORDS}"
}
