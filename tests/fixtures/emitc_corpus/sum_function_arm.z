# sum_function_arm.z -- an arm of a variant or a union that carries a function
# is an arm, not a method, though its type is a function's: it is built through
# the type with a function of its signature, tested by its predicate, matched,
# and the narrowed name calls the function it holds. A variant of such arms
# compares by the generated `==`, the functions by identity.
binop: function {a: i64 b: i64} out i64
add: function {a: i64 b: i64} out i64 is { return a + b }
mul: function {a: i64 b: i64} out i64 is { return a * b }
step: variant {
    stop: null
    num: i64
    apply: binop
}
run: function {s: step} out i64 is {
    match (s) case apply then return (s a: 3 b: 4) case num then return s case stop then return 0
}

Job: union {
    idle: null
    task: binop
}

main: function is {
    xs: ListVal step
    xs.append (step.apply add.copy)
    xs.append (step.num 9)
    xs.append (step.apply mul.copy)
    xs.append step.stop
    for each x: xs loop print "\{run s: x} \{x.apply}"
    p: step.apply add.copy
    q: step.apply add.copy
    r: step.apply mul.copy
    print "\{p == q} \{p == r} \{p == step.stop}"
    j: Job.task mul.copy
    match (j) case task then print "\{j a: 6 b: 7}" case idle then print "idle"
}
