# generator_yields_values.z -- what a generator may yield: a view of static
# bytes, which no source owns; a value copied out of a walk of its own state;
# an owned copy of a view of it.
Names: generator { k: i64 } as {
    call: function out StringView is {
        yield "first"
        yield "second"
    }
}

Doubles: generator { ns: ListVal i64 } as {
    call: function out i64 is {
        for each x: this.ns loop yield x * 2
    }
}

Copies: generator { s: String } as {
    call: function out String is {
        yield (this.s.substring from: 0 to: 2).string
    }
}

main: function is {
    for each n: (Names k: 0) loop print n
    xs: ListVal i64
    xs.append 3
    for each d: (Doubles ns: xs.copy) loop print "\{d}"
    for each c: (Copies s: "abc".string) loop print c
}
