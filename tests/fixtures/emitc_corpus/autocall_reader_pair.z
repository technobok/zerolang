# a view lift reads its receiver and never mutates it, so several reader
# auto-calls on one receiver coexist -- in one call and alongside a live view
pair: function {a: StringView b: StringView} is {
    print "\{a} \{b}"
}
main: function is {
    s: "echo".string
    pair a: s.stringView b: s.stringView
    sv: s.stringView
    print "\{sv.length} \{s.length}"
}
