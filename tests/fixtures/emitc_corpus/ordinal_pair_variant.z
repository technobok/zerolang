# ordinal_pair_variant.z -- a USER variant with two arms and no payload is the
# same SHAPE as `bool`, and gets the same C: the value IS its discriminator, so
# it is a C `bool` rather than a struct wrapping a tag. Nothing here names
# `bool`; the emitter reads the shape the checker recorded.
#
# Everything a variant can do still works on it -- construct, match, narrow,
# `.arm` predicates, `==` -- and the FIRST arm is the false side, which is why
# `bool` writes `false` first.

switchpos: variant { closed: null  open: null }

describe: function {s: switchpos} out i64 is {
    match (
        s
    ) case closed then {
        return 0
    } case open then {
        return 1
    }
}

main: function is {
    a: switchpos.closed
    b: switchpos.open
    print "closed=\{describe s: a} open=\{describe s: b}"
    if b.open then print "b is open" else print "b is not open"
    if a.open then print "a is open" else print "a is not open"
    same: a == a
    diff: a == b
    print "same=\{same} diff=\{diff}"
}
