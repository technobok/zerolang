# A reftype field bound to a local pins only the field's own path, and only for
# the binding's scope: a sibling field stays writable, the field is writable once
# the binding's block ends, and a field read through a readonly root binds
# readonly.
Holder: class {
    p: String
    q: String
}

siblings: function {h: Holder} is {
    r: h.p
    h.q = "new q".string
    print "\{r} \{h.q}"
}

afterBlock: function {h: Holder} is {
    {
        r: h.p
        print "block \{r}"
    }
    h.p = "new p".string
    print h.p
}

readonlyRoot: function {h: Holder.view} out u64 is {
    r: h.p
    return r.length
}

main: function is {
    h: Holder p: "hp".string q: "hq".string
    siblings :h
    afterBlock :h
    print "\{readonlyRoot :h}"
}
