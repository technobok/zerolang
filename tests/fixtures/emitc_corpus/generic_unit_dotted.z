# generic_unit_dotted.z -- instantiate another unit's inline template through a
# DOTTED callable. The callable used to be read with atomName, which accepts
# only a bare atom, so a dotted one yielded "" and no instantiation request was
# built at all -- silently, not as an error. The template is resolved to an id
# through the instantiation's own scope instead.
intmath: (tmpl_provider.mathops t: i64)
i32math: (tmpl_provider.mathops t: i32)

main: function is {
    print "add=\{intmath.add a: 3 b: 5}"
    print "double=\{intmath.double 21}"
    print "i32 add=\{i32math.add a: 10 b: 20}"
}
