# `getMut` is the mutable element accessor: an exclusive receiver whose result
# may be written through. It exists so `get` can become the readonly twin and
# keep the plain name -- the same inversion as iterate/iterateMut, and for the
# same reason: measured over this compiler, reads outnumber writes ~15 to 1.
#
# Values are printed rather than merely compiled. The two entry points are the
# same C over the same storage, so a routing bug that emitted `_get` where
# `_getMut` was asked for would compile clean and still be wrong -- only the
# written-back value catches it.
Row: class {
    n: i64
    label: String
}
main: function is {
    rows: (List Row)
    rows.append from: (Row n: 1 label: "a".string)
    rows.append from: (Row n: 2 label: "b".string)

    # the mutable view holds the list EXCLUSIVELY for its whole scope -- even
    # a reader is refused beside it -- so it ends before the readers open
    {
        r: rows.getMut i: 0.u64
        r.n = r.n + 10
        r.label.append s: "!".string
    }

    a: rows.get i: 0.u64
    b: rows.get i: 1.u64
    print "rows=\{a.n},\{a.label} \{b.n},\{b.label}"

    # through a view of the same storage
    lv: rows.listView
    m: lv.getMut i: 1.u64
    m.n = m.n + 100
    c: rows.get i: 1.u64
    print "viaview=\{c.n}"
}
