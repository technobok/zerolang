# literal_default_user_scalar.z -- an untyped literal takes the SYSTEM's i64,
# u64 or f64 where nothing pins it, whatever the program declares under those
# names. Three sites looked the default up in the program's scope, so once the
# program's own `i64` record had been demanded, `x: 5` was that record.
i64: record {
    n: 0
}

u64: record {
    n: 0
}

f64: record {
    n: 0
}

K: 7

main: function is {
    r: i64 n: 3
    s: u64 n: 4
    t: f64 n: 5
    x: 5
    h: 0x10
    f: 2.5
    y: K + 1
    print "\{r.n} \{s.n} \{t.n} x=\{x} h=\{h} f=\{f} y=\{y}"
}
