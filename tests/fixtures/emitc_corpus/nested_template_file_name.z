# A generic unit nested in a namespace is the template its instance names, even
# when a file unit shares its name (ntfn_wrap). The template was looked up by
# NAME among the program root's file units first, so the instance was built
# from the file unit, never walked, and never emitted: gcc saw a call to an
# undeclared z_tN.
main: function is {
    a: ints.same v: 5
    b: ntfn_wrap.same v: 1
    print "\{a} \{b}"
}

ns: unit {
    ntfn_wrap: unit as {
        t: anyval.generic
        same: function {v: t} out t is {
            return v
        }
    }
}
ints: (ns.ntfn_wrap t: i64)
