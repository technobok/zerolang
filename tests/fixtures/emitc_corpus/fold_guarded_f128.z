# fold_guarded_f128.z -- a use of f128 behind a compile-time guard, so the
# branch that names it is DEAD for every target but the one it names.
#
# The two arms print the same text on purpose: what differs between them is
# not the program's behaviour but what it reaches. Off Windows the f128 arm is
# dead, nothing reaches quadfloat, the C names no library, and the build
# succeeds even with a C compiler that has no __float128 (tcc) -- which it did
# not before a folded branch stopped demanding the units it merely names.
main: function is {
    if z.build.os == z.build.oskind.windows then {
        w: 1.5.f128
        print "guarded \{w}"
    } else {
        print "guarded 1.5"
    }
}
