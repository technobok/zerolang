# fold_guarded_f128.z -- a use of f128 behind a compile-time guard, so the
# branch that names it is DEAD for the one toolchain that cannot build it.
#
# The two arms print the same text on purpose: what differs between them is
# not the program's behaviour but its link line. Anywhere but tcc the f128
# arm is live, quadfloat is reached, and the emitted C declares
# `zlink: quadmath`. Under tcc that arm is dead, nothing reaches quadfloat,
# the C names no library, and the build succeeds -- which it did not before
# a folded branch stopped demanding the units it merely names.
main: function is {
    if platform.cc == platform.cckind.tcc then {
        print "guarded 1.5"
    } else {
        w: 1.5.f128
        print "guarded \{w}"
    }
}
