# A data value built through a unit alias, holding a list of choice values read
# through the same alias, folds when another definition reads it. Resolving the
# alias demands the unit it is written in, and that unit's walk leaves the value
# being folded to the fold already under way.
linkSchema: unit {
    linkSet: data {
        links: list {} out staticlist link
    }
    link: data {
        library: text
        os: list {} out staticlist os
    }
    os: choice {
        linux: null
        other: null
    }
}

linker: unit {
    c: linkSchema
    linkSet: (c.linkSet links: list { (c.link library: "dl" os: list { c.os.linux c.os.other }) })
}

everyLinkSet: list { linker.linkSet } out staticlist linkSchema.linkSet

main: function is {
    for each s: everyLinkSet loop {
        for each l: s.links loop print "\{l.library} \{l.os.length}"
    }
}
