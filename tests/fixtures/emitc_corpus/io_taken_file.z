# io_taken_file.z -- a File handed out of a Result (`r.take`, answered by a
# function) leaves the Result holding nothing, so destroying the Result
# releases nothing: the standard input stays open, and a file opened next --
# which the OS gives the lowest free descriptor -- is not closed under its
# owner. Listener and Conn are held the same way.

openFor: function {path: StringView} out io.File is {
    r: io.open :path mode: io.openmode.write
    match (r) case ok then return r.take case err then panic msg: "open failed"
}

main: function is {
    first: openFor path: "z_taken_a.txt"
    into: Bytes
    rd: io.stdin.read :into max: 16
    match (rd) case ok then print "stdin still reads: \{rd} bytes" case err then print "stdin was closed"
    second: openFor path: "z_taken_b.txt"
    b: Bytes
    b.append from: 104.u8
    w: second.write from: b.byteView
    match (w) case ok then print "the second file writes: \{w} byte" case err then print "the second file was closed"
    w1: first.write from: b.byteView
    match (w1) case ok then print "the first file writes: \{w1} byte" case err then print "the first file was closed"
}
