# dep_generic.z -- a dependency unit declaring and instantiating its own generic
# unit. Every lookup an instantiation drives is relative to the unit it was
# WRITTEN in; reading them off the main unit is why this only ever worked there.
mathops: unit as {
    t: anyval.generic
    add: function {a: t b: t} out t is { return a + b }
}

intmath: (mathops t: i64)

sum: function {a: i64 b: i64} out i64 is {
    r: (intmath.add :a :b)
    return r
}
