# A view is no storage of its own: a view derived from one reads the first
# one's source. A local bound to a literal views the program's own bytes, so
# what is derived from it keeps nothing locked and may be returned through
# `out`; a view of a parameter is returned through `outx`.
lit: function out StringView is {
    a: "alpha"
    return (a.substring from: 1 to: 3)
}

litBound: function {c: bool} out StringView is {
    a: "alpha"
    b: "beta"
    v: if c then a else b
    return (v.substring from: 1 to: 3)
}

litTrim: function out StringView is {
    a: "  gamma  "
    t: a.trim
    return t
}

viaParam: function {p: String.view} outx StringView is {
    a: p.stringView
    return (a.substring from: 0 to: 1)
}

main: function is {
    p: "param".string
    print "\{lit} \{litBound c: false} \{litTrim} \{viaParam :p}"
}
