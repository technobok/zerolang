# A class holds a protocol by value, and the protocol's methods name that
# class -- one returns it, one takes it. A slot of the protocol's vtable is a
# function pointer, which needs the class declared only, so the protocol is
# written before the class that embeds it, whichever the source declares first.
Holder: class { s: Shape  tag: String }

Shape: protocol {
    area: function {t: this.view} out u64
    owner: function {t: this.view} out Holder
    fits: function {t: this.view h: Holder.view} out bool
}

Sq: class { side: u64 name: String } as {
    shape: Shape.implement
    area: function {t: this.view} out u64 is { return t.side * t.side }
    owner: function {t: this.view} out Holder is {
        return (Holder s: (Shape.create from: (Sq side: 1 name: "inner".string)) tag: "o".string)
    }
    fits: function {t: this.view h: Holder.view} out bool is { return t.side <= h.s.area }
}

Box: class { s: Shape  n: u64 }

main: function is {
    h: Holder s: (Shape.create from: (Sq side: 5 name: "held".string)) tag: "t".string
    print "area \{h.s.area} \{h.tag}"
    o: h.s.owner
    print "owner \{o.s.area} \{o.tag} fits \{h.s.fits h: o}"
    b: Box s: (Shape.create from: (Sq side: 3 name: "boxed".string)) n: 2
    print "box \{b.s.area} \{b.n}"
}
