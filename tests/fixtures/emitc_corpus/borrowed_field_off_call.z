# borrowed_field_off_call.z -- a borrowed field read off a value a call
# computes -- `(h.getW).s`, or the zero-arg auto-call `h.getW.s` -- is the place
# its pointer reaches: interpolated, bound, passed, copied, compared, called on
# and written through, as a field read off a variable is.

# W -- a borrowed string
W: class {
    s: String.borrow
}

# H -- holds a W
H: class {
    w: W
} as {
    # the W, viewed
    getW: function {t: this.view} outx W.view is {
        return t.w
    }
    # the W, borrowed
    getWMut: function {:this} outx W.borrow is {
        return this.w
    }
}

# size -- the length of s
size: function {s: String.view} out u64 is {
    return s.length
}

# owned -- the length of a string it owns
owned: function {s: String.take} out u64 is {
    return s.length
}

main: function is {
    src: "hi".string
    {
        h: H w: (W s: src)
        print "\{(h.getW).s} \{h.getW.s}"
        {
            v: (h.getW).s
            print "bound \{v}"
        }
        a: size s: (h.getW).s
        b: owned s: h.getW.s.copy
        c: (h.getW).s == "hi"
        d: h.getW.s.startsWith prefix: "h"
        e: (h.getW).s.copy
        print "\{a} \{b} \{c} \{d} \{e}"
        {
            m: (h.getWMut).s
            m.append "!"
        }
        (h.getWMut).s.append "?"
        print "\{h.w.s}"
    }
    print "\{src}"
}
