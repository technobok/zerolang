# An untyped float folds exactly -- the fraction its literals spell -- until a
# part passes 4096 bits, whatever exponent spells it; past that it is the
# nearest 512-bit float, which still keeps a tiny value positive. Only the
# final value is rounded, once, where it lands.
A: (((1e0 + 1e-200) - 1e0) == 1e-200)
B: ((1e-1001 * 1e1001) == 1.0)
C: (((1e1001 + 1.0) - 1e1001) == 1.0)
D: (((10.0 * 1e1000) + 1.0) == (1e1001 + 1.0))
E: (1e-1300 > 0.0)
T: (1.0 / 2037035976334486086268445688409378161051468393665936250636140449354381299763336706183397376.0)
X: ((1.0 + (1.0 / 9007199254740992.0)) + (T * T))

main: function is {
    y: X
    q: (2e1300 + 1e1300) / 1e1300
    print "\{A} \{B} \{C} \{D} \{E} \{y == 1.0}"
    print "\{q} \{(1e2000 + 1e2000) > 1e2000}"
}
