# unit_fn_named_member -- a unit-level function may share its name with a member
# the checker synthesizes on a type: `create`, `tag`, `hash`. The member is the
# type's own, built where the type is declared; resolving its type by name in
# the unit found the function instead, and a construction inside `create` was
# emitted as a call to `create` itself.
public: unit {
    :main
}

# Box -- a number in a class
Box: class {
    n: i64
}

# pt -- a point, hashable through its synthesized members
pt: record {
    x: i64
    y: i64
}

# dir -- a direction, its arm told apart by the synthesized tag
dir: variant { up: null down: i64 }

# create -- a Box holding n, built by the type's own construction
create: function {n: i64} out Box is {
    return (Box n: n)
}

# tag -- a label, not the variant's tag
tag: function {d: dir} out String is {
    match d case up then return "up".string case down then return "down \{d}"
}

# hash -- a sum, not the record's hash
hash: function {p: pt} out i64 is {
    return p.x + p.y
}

main: function is {
    b: create n: 4
    print "\{b.n}"
    direct: Box n: 5
    print "\{direct.n}"
    print (tag d: dir.up)
    print (tag d: (dir.down 3))
    q: pt x: 1 y: 2
    print "\{hash p: q}"
    print "\{q == (pt x: 1 y: 2)}"
    print "\{(dir.down 3) == (dir.down 3)}"
}
