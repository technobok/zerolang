# generic_instance_match_call_subject -- inside a generic function's instance, a match
# whose subject is a call is an ordinary match over the call's result, not a compile-
# time dissection.
opt: function {n: i64} out optionval i64 is {
    if n > 0 then return (optionval.some n)
    return (optionval.none i64)
}

pick: function as { t: anyval.generic } in { v: t n: i64 } out i64 is {
    match (opt :n) case some then {
        return 1
    } case none then {
        return 2
    }
}

main: function is {
    print "\{pick t: i64 v: 1 n: 2}"
    print "\{pick t: bool v: true n: 0}"
}
