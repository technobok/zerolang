# eq_on_demand.z -- a generated `==` is written only where written C calls it:
# a record compared directly, a record's fields through its own `==`, a map
# key, a list element `contains` looks for, and a fixed array compared whole,
# with its element. `quiet` is never compared, so its C carries no `_eq`.
pt: record {
    x: i64
    y: i64
}

line: record {
    a: pt
    b: pt
}

mkey: record {
    n: i64
}

slot: record {
    n: i64
}

tile: record {
    n: i64
}

quiet: record {
    n: i64
}

main: function is {
    p: pt x: 1 y: 2
    q: pt x: 1 y: 2
    if p == q then print "pt same"
    l1: line a: p b: q
    l2: line a: q b: (pt x: 3 y: 4)
    if l1 != l2 then print "line differs"
    m: (MapVV k: mkey v: i64)
    m.set key: (mkey n: 7) value: 70
    print "map \{(m.get key: (mkey n: 7)).or d: 0}"
    xs: ListVal slot
    xs.append (slot n: 5)
    if (xs.contains item: (slot n: 5)) then print "list has 5"
    a1: (array t: tile to: 2)
    a2: (array t: tile to: 2)
    if a1 == a2 then print "arrays equal"
    z: quiet n: 3
    print "quiet \{z.n}"
}
