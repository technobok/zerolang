# a text method answering an option folds on a string constant with constant
# arguments: the value keeps the option type, a known `some` or `none`, and the
# option's own readers -- `.or d:`, the arm predicates, `match`, `==` -- fold on
# it. Read at run time, it is the value itself.
G: "hello # world"
T: "key=value".text
P: G.indexOf "#"
N: G.indexOf "%"
AT: ((G.indexOf "#").or d: 99)
MISS: ((G.indexOf "%").or d: 99)
LAST: ((G.lastIndexOf "o").or d: 0)
CUT: ((G.splitOnce "#").or d: 0)
BYTE: ((G.byteAt 1).or d: 0)
PAST: ((G.byteAt 100).or d: 7)
REST: ((T.stripPrefix "key=").or d: "none".text)
NOREST: ((T.stripPrefix "x").or d: "none".text)
HEAD: ((G.stripSuffix "world").or d: "none".text)
BARE: "abc".stripPrefix "a"
FROMBARE: (BARE.or d: "x")
HAS: P.some
HASNOT: N.none
SAME: (G.indexOf "#") == (G.indexOf "#")
DIFFER: (G.indexOf "#") == (G.indexOf "%")
SIZE: match P case some then { P + 1 } else { 0 }
NSIZE: match N case some then { N } else { 42.u64 }
CHAIN: (P.or d: AT)
main: function is {
    print "\{AT} \{MISS} \{LAST} \{CUT} \{BYTE} \{PAST}"
    print "\{REST} \{NOREST} [\{HEAD}] \{FROMBARE}"
    print "\{HAS} \{HASNOT} \{SAME} \{DIFFER} \{SIZE} \{NSIZE} \{CHAIN}"
    # read at run time: the value itself
    p: P
    n: N
    print "\{p.or d: 5} \{n.or d: 5}"
    match p case some then print "p at \{p}" case none then print "p none"
    # folded in a body, on a literal receiver too
    i: (G.indexOf "w").or d: 0
    q: "hello world".stripPrefix "hello "
    print "\{i} \{q.or d: "-"}"
    if (G.indexOf "#").some then print "body some"
    if (G.stripSuffix "zzz").none then print "body none"
    # a run-time argument: the call runs
    w: "lo"
    k: G.indexOf w
    print "\{k.or d: 0}"
    # a StringView constant's piece is an Option StringView, and runs
    sv: "xyz".stringView
    t: sv.stripPrefix "x"
    match t case some then print t case none then print "-"
}
