# box_instance_construction.z -- an instance of Box is made as `Box from: v`
# is, by its one value, whichever way the instance is named: by an alias of
# it, or by its own spelling with or without the parameter's label. The value
# must be of the instance's element type. Fields read and write through the
# box.
point: record { x: i64 y: i64 }

BP: (Box point)

main: function is {
    a: BP from: (point x: 1 y: 2)
    b: (Box point) from: (point x: 3 y: 4)
    c: (Box t: point) from: (point x: 5 y: 6)
    a.x = a.x + 10
    print "\{a.x} \{a.y} \{b.x} \{b.y} \{c.x} \{c.y}"
}
