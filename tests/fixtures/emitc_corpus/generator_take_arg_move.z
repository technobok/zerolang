# generator_take_arg_move.z -- an argument MOVED into a generator must be zeroed
# in the CALLER.
#
# `for r: (G s: src) loop` with an owned String field left `src` live: the
# enclosing scope freed it and the instance's destructor freed the same pointer
# again -- `free(): double free detected in tcache 2`. The zeroing every other
# call position emits (`src = (String){0};`) was simply not emitted here,
# because the for-iterable path never ran the take-invalidation step.
#
# It is position-specific, not callee-specific: the SAME generator bound in a
# plain binding position (`it: (G s: src)`) already zeroed correctly, which is
# what made it possible to point at the position rather than the ownership.
#
# `named` is the shape that crashed. `temp` passes a temporary instead, which
# was always clean and is all `generator_local_cleanup.z` ever passes -- which
# is exactly why the corpus never caught this. The last pair drives two
# generators off two sources so a single stray zeroing cannot pass.

G: generator { s: String } as {
    call: function out u64 is {
        yield 1.u64
        yield this.s.length
    }
}

main: function is {
    src: "hello".string
    for r: (G s: src) loop print "named: \{r}"
    for t: (G s: "ab".string) loop print "temp: \{t}"
    a: "xyz".string
    b: "wxyz".string
    for p: (G s: a) loop print "p: \{p}"
    for q: (G s: b) loop print "q: \{q}"
    print "done"
}
