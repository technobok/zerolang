# data_index_bounds.z -- `.index i` checks its bounds: a read past the end
# panics through z_panic ("zpanic: data index: index 3 out of bounds (length
# 3)" on stderr, exit 1) rather than reading whatever follows the array.

codes: data { 10 20 30 } out intdata u8

main: function is {
    i: 0.u64
    for i < codes.length loop {
        print "codes \{i} = \{codes.index i}"
        i = i + 1
    }
    past: codes.index i
    print "past = \{past}"
}
