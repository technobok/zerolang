# `outx` on a result whose type declares no non-owned field is valid: the pin
# is about the result needing its inputs to stay put while it works -- an
# iterator over a native container holds no zerolang reference into it -- and
# not about the fields the type happens to declare. The source is locked
# while the result lives and writable once it dies.
Src: class {
    n: i64
}

W: class {
    tag: i64
    label: String
}

mk: function {from: Src.borrow} outx W is {
    return (W tag: from.n label: "owned".string)
}

main: function is {
    a: Src n: 1
    {
        w: mk from: a
        print "result: \{w.tag} \{w.label}"
    }
    a.n = 5
    print "after: \{a.n}"
}
