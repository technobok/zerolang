# the mirror of errors/method_body_owner_unresolved: a CORRECT method body in a
# class nothing references. Before outside-in resolution `this` typed as notype
# and this compiled to `error[E0100]: type 'notype' has no '>' method`.
Gadget: class {
    n: u64
} as {
    isPositive: function {:this} out bool is {
        return this.n > 0
    }
}

main: function is {
    print "widget"
}
