# A CONSTANT BUILT ONLY FROM BARE LITERALS IS AN UNTYPED LITERAL: it coerces by
# value at every typed position, as the literal itself does. A reassignment
# and a return refused it as an i64, where an argument and an operand took it.
N: 5
SUM: 2 + 3
Q: 7.u8

pick: function out u8 is {
    return N
}

main: function is {
    a: 1.u8
    a = N
    b: 1.u16
    b = SUM
    b = Q
    print "\{a} \{b} \{pick}"
}
