# comprehension_if_first_typed_arm -- A loop in value position whose body ends on an
# `if`: the element type is the first arm's that yields a typed value, and an untyped
# literal arm after it takes that type.
small: function {k: i64} out u8 is {
    if k > 2 then return 9
    return 3
}

main: function is {
    ys: ListVal i64
    ys.append 1
    ys.append 5
    xs: for each y: ys loop {
        if y > 2 then {
            small k: y
        } else {
            7
        }
    }
    for each x: xs loop {
        # 3 * 100 and 4 * 100 do not fit a u8: the element is a u8, the product wraps
        z: x / 2
        w: z * 100
        print "\{w}"
    }
}
