# A reference key must DECLARE `hash` and `==`, and the container then CALLS
# them. Before this, a class key emitted `z_hash_u64((uint64_t)_key)` on an
# aggregate -- C that does not compile.
#
# `has` is asked with a DIFFERENT instance holding the same value: identity
# hashing would answer 0, so a 1 is what proves the declared methods ran.
# The record and String keys are the control that the structural paths are
# untouched -- String's `hash`/`==` are natives whose C is fixed by their
# .inc, so the declared-method dispatch must not claim them.
Point: class {
    n: u64
} as {
    hash: function {t: this.view} out u64 is {
        return t.n * 2654435761
    }
    ==: function {t: this.view rhs: Point} out bool is {
        return t.n == rhs.n
    }
}

pair: record {
    a: u64
    b: u64
}

main: function is {
    m: (Map Point value: u64)
    p: Point n: 7
    m.set key: p value: 70
    q: Point n: 7
    print "class key: len=\{m.length} has-other-instance=\{m.has key: q}"

    r: (Map pair value: u64)
    r.set key: (pair a: 1 b: 2) value: 12
    print "record key: has=\{r.has key: (pair a: 1 b: 2)}"

    s: (Map String value: u64)
    k: "x".string
    s.set key: k value: 1
    print "String key: has=\{s.has key: "x".string}"

    t: (Set Point)
    u: Point n: 9
    t.add item: u
    v: Point n: 9
    print "class set: has-other-instance=\{t.has item: v}"
}
