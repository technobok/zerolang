# scalar_range_value.z -- AN INTEGER RANGE IS A VALUE, not only a for-header.
#
# `each` / `upto` / `downto` hand back an `intrange`, an ordinary iterator: a
# binding holds one and `.call` steps it, answering the next value or `none`
# once the walk is over. A for-header LOWERS a range to a counted C loop and
# constructs no object at all, so the value form below is the only place the
# object itself is driven -- the same receiver, driven either way.
#
# The cursor holds a COUNT rather than an endpoint, which is what lets a walk
# end at a type's maximum or at an unsigned zero: past either there is no value
# for a comparison to stop at.

main: function is {
    # `each` is half-open: three values, then none
    r: 3.each
    a: r.call
    match (a) case some then print "each  \{a}" case none then print "each  none"
    b: r.call
    match (b) case some then print "each  \{b}" case none then print "each  none"
    c: r.call
    match (c) case some then print "each  \{c}" case none then print "each  none"
    d: r.call
    match (d) case some then print "each  \{d}" case none then print "each  none"

    # `upto` is closed, so its first value is the receiver itself
    u: 2.upto to: 4
    e: u.call
    match (e) case some then print "upto  \{e}" case none then print "upto  none"

    # `downto` on an unsigned type walks toward a zero it still yields
    w: 1.u8.downto to: 0.u8
    f: w.call
    match (f) case some then print "down  \{f}" case none then print "down  none"
    g: w.call
    match (g) case some then print "down  \{g}" case none then print "down  none"
    h: w.call
    match (h) case some then print "down  \{h}" case none then print "down  none"

    # a non-literal receiver
    lim: 4.i64
    v: lim.each
    i: v.call
    match (i) case some then print "vars  \{i}" case none then print "vars  none"

    # an inverted closed range yields nothing at all
    z: 5.upto to: 2
    j: z.call
    match (j) case some then print "inv   \{j}" case none then print "inv   none"

    # the header is the other driver, and it builds no object
    for x: 3.each loop print "loop  \{x}"
    for y: (2.upto to: 4) loop print "up    \{y}"
}
