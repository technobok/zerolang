# A marker on a generic type's member is copied onto every instance, and the
# instance is otherwise unchanged: a `hold` field constructs, reads and is
# destroyed with its owner (leak-clean), an unmarked field of the same
# template stays mutable, and a `view` arm's payload is readable.
Held: class {
    it: t.hold
} as {
    t: AnyRef.generic
}
Free: class {
    it: t
} as {
    t: AnyRef.generic
}
Inner: class {
    n: i64
} as {
    peek: function {v: this.view} out i64 is { return v.n }
}
Peek: union {
    some: t.view
    none: null
} as {
    t: AnyRef.generic
}
main: function is {
    s: "abc".string
    h: Held it: s.take
    print "held=\{h.it} \{h.it.length}"

    f: Free it: "xy".string
    f.it.append s: "z".string
    print "free=\{f.it}"

    i: Inner n: 7
    p: (Peek.some i)
    match (
        p
    ) case some then {
        print "peek=\{p.n} \{p.peek}"
    } else null
}
