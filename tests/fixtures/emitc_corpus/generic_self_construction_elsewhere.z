# A generic class's methods other than `create` construct its own type freely
# -- through `type.create` or its bare name -- and its create builds the
# instance with `meta.create`.
Box: class {
    v: t
    n: i64
} as {
    t: anyval.generic
    create: function {v: t k: i64} out this is {
        return (meta.create :v n: k)
    }
    again: function {b: this.view} out this is {
        return (type.create v: b.v k: b.n + 1)
    }
    bare: function {b: this.view} out this is {
        return (Box v: b.v k: b.n + 2)
    }
}

main: function is {
    b: Box v: 1 k: 0
    c: b.again
    d: b.bare
    print "\{c.n} \{d.n}"
}
