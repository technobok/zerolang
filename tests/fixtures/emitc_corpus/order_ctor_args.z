# A construction's arguments are evaluated as they are written, whatever the
# order of the fields or of the create's parameters they bind: field-wise, through
# a user `create`, through `meta.create`, as a union arm's payload and across
# units. Every line prints its ticks ascending.
tick: function {n: i64} out i64 is {
    print "t\{n}"
    return n
}

pt: record { x: i64 y: i64 }

Acc: class {
    total: i64
    count: i64
}

Shape: union { rect: Box pt none: null }

pair: record { x: i64 y: i64 } as {
    create: function {a: i64 b: i64} out this is {
        return (meta.create y: (tick n: 20) x: (tick n: 21))
    }
}

Tagged: class {
    p: i64
    q: i64
} as {
    create: function {q: i64 p: i64} out this is {
        return (meta.create :p :q)
    }
}

main: function is {
    print "record"
    p: pt x: (tick n: 1) y: (tick n: 2)
    q: pt y: (tick n: 3) x: (tick n: 4)
    print "class"
    a: Acc count: (tick n: 5) total: (tick n: 6)
    print "union arm payload"
    s: Shape.rect (pt y: (tick n: 7) x: (tick n: 8))
    print "user create and meta.create"
    u: pair b: (tick n: 9) a: (tick n: 10)
    v: pair.create b: (tick n: 11) a: (tick n: 12)
    w: Tagged p: (tick n: 13) q: (tick n: 14)
    print "another unit"
    d: order_ctor_dep.point y: (tick n: 15) x: (tick n: 16)
    print "\{p.x} \{q.x} \{a.total} \{u.x} \{v.y} \{w.p} \{d.x}"
    match (
        s
    ) case rect then {
        print "rect \{s.x} \{s.y}"
    } else null
}
