# generic_unit_own_generics -- a generic unit's function with type parameters of
# its own is a template on each instance of the unit, as a generic method is on
# each instance of a type: every call through the instance mints an instance of
# it for the call's arguments, checked and emitted from its own copy of the
# body. Called from outside and from a sibling, naming the unit's parameter
# beside its own, calling another such function and itself, and reading the
# unit's constant, numeric parameter and plain sibling functions.
public: unit {
    :main
}

# wrap -- functions over the unit's `t` and over parameters of their own
wrap: unit as {
    t: anyval.generic
    n: u64.generic
    # K -- the unit's constant
    K: 40
    # keep -- the value as given
    keep: function {v: t} out t is {
        return v
    }
    # own -- any value, as given
    own: function as { u: anyval.generic } in {x: u} out u is {
        return x
    }
    # mix -- the unit's value, after reporting a value of its own type
    mix: function as { u: anyval.generic } in {x: t y: u} out t is {
        print "mix y \{y} keep \{keep v: x} K \{K} n \{n}"
        return x
    }
    # outer -- its value through `own`, an instance of a sibling template
    outer: function as { v: anyval.generic } in {y: v} out v is {
        return (own x: y)
    }
    # depth -- how many steps down to zero, carrying any value along
    depth: function as { u: anyval.generic } in {x: u k: i64} out i64 is {
        if k == 0 then return 0
        return 1 + (depth :x k: k - 1)
    }
    # use -- `own` from a plain sibling, at two types
    use: function {v: t} out t is {
        f: own x: 2.5
        print "use own \{f}"
        return (own x: v)
    }
}
wi: (wrap t: i64 n: 3)
wf: (wrap t: f64 n: 7)

main: function is {
    print "own \{wi.own x: 5} \{wi.own x: true} \{wf.own x: 1.5}"
    print "mix \{wi.mix x: 4 y: 1.5} \{wf.mix x: 2.5 y: true}"
    print "outer \{wi.outer y: 7} \{wf.outer y: false}"
    print "depth \{wi.depth x: 2.5 k: 3}"
    print "use \{wi.use v: 9}"
}
