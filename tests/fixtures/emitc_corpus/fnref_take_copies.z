# `.take` OF A VARIABLE HOLDING A FUNCTION REFERENCE COPIES IT. A function
# reference is a value, and taking a value copies its bytes -- it has no owner
# to move -- so the variable is still usable after it (valtype_take_keeps_source
# does the same for records). A function's own name is not storage, and its
# reference is `.copy` (take_function_name).

# doubleFn -- a function reference with double's signature: the type, with no default
doubleFn: function {n: i64} out i64

double: function {n: i64} out i64 is {
    return n * 2
}

Hook: class {
    op: doubleFn
}

apply: function {f: doubleFn n: i64} out i64 is {
    return (f n: n)
}

main: function is {
    f: double.copy
    h: Hook op: f.take
    g: double.copy
    r: apply f: g.take n: 5
    k: double.copy
    m: k.take
    print "\{h.op n: 2} \{r} \{m n: 4}"
    # each source is still usable
    print "\{f n: 1} \{g n: 2} \{k n: 3}"
}
