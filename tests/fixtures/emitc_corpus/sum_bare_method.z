# sum_bare_method.z -- a ZERO-ARGUMENT as-block method on a sum type, referenced
# bare so it auto-calls. The typechecker resolves it to the method and stamps its
# RETURN type; the emitter's read form never asked what the member was. It read
# the BASE's typetype and built a payload access from the member name, so a
# variant emitted `a.data.label` -- a union member no arm declares -- and a union
# emitted `a.label`. A method WITH an argument was always fine: the CALL form
# asks, the READ form did not. An arm and a method can never share a name, so
# the declaration is an unambiguous answer.
Slot: variant {
    full: i64
    empty: null
} as {
    label: function {s: this} out i64 is { return 7 }
    twice: function {s: this n: i64} out i64 is { return n + n }
}

Holder: union {
    some: String
    none: null
} as {
    mark: function {h: this} out i64 is { return 9 }
}

Crate: record {
    slot: Slot
    n: i64
}

main: function is {
    a: Slot.full 4
    print "variant bare \{a.label}"
    print "variant witharg \{a.twice n: 5}"

    b: Slot.empty
    print "variant empty bare \{b.label}"

    c: Crate slot: a n: 1
    print "variant field \{c.slot.label}"

    u: Holder.some "hi".string
    print "union bare \{u.mark}"

    v: Holder.none
    print "union none bare \{v.mark}"
}
