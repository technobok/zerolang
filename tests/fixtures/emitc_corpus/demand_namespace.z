# demand_namespace.z -- name a demand-gated unit's NAMESPACE member. Reaching
# `cli.box` at all requires the demand path to dispatch by unit kind; before
# that it reported `unit 'cli' has no member 'box'`.
main: function is {
    print "cli.box.LIMIT=\{cli.box.LIMIT}"
    print "cli.scale=\{cli.scale 21}"
}
