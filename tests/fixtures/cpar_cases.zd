# cpar_cases -- the RUN programs constparitygen writes from the table
# tests/fixtures/constparity_expect.zd, read by the runner beside
# run_cases.zd. `make regen-constparity` writes the whole file: edit the table,
# not this file.

# program -- one test program: <dir>/<name>.z from the repository root, its
# units also read from each of `roots`
program: data {
    name: text
    dir: text
    roots: list {} out staticlist text
    # it checks what only POSIX has (file descriptors, signals): on Windows it
    # is listed as (posix) and not run
    posix: false
}

programs: list {
    (program name: "cpar_intlit" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_int" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_u8" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_floatlit" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_f64" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_bool" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_strlit" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_text" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_list" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_data" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_enum" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_choice0" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_choice1" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_optsome" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_optnone" dir: "tests/fixtures/emitc_corpus")
    (program name: "cpar_fnref" dir: "tests/fixtures/emitc_corpus")
}
