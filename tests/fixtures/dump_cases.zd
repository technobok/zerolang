# dump_cases -- the DUMP kind's programs: `zc dump --canon` of each must
# equal tests/fixtures/dump_golden/<name>.canon.

# program -- one test program: <dir>/<name>.z from the repository root, its
# units also read from each of `roots`
program: data {
    name: text
    dir: text
    roots: list {} out staticlist text
    # it checks what only POSIX has (file descriptors, signals): on Windows it
    # is listed as (posix) and not run
    posix: false
}

programs: list {
    (program name: "hello" dir: "examples")
    (program name: "factorial" dir: "examples")
    (program name: "records" dir: "examples")
    (program name: "classes" dir: "examples")
    (program name: "protocols" dir: "examples")
    (program name: "facets" dir: "examples")
    (program name: "generics" dir: "examples")
    (program name: "variants" dir: "examples")
    (program name: "vector" dir: "examples")
    (program name: "linkedlist" dir: "examples")
    (program name: "str" dir: "examples")
    (program name: "strview" dir: "examples")
    (program name: "control" dir: "examples")
    (program name: "forloop" dir: "examples")
    (program name: "genericunit" dir: "examples")
    (program name: "genericpair" dir: "examples")
    (program name: "genericfunctions" dir: "examples")
    (program name: "numeric_generics" dir: "examples")
    (program name: "dump_stamps" dir: "examples")
    (program name: "ifexpr" dir: "examples")
    (program name: "tagconsts" dir: "tests/fixtures/dump_src")
    (program name: "strconsts" dir: "tests/fixtures/dump_src")
    (program name: "text_fold" dir: "tests/fixtures/dump_src")
    (program name: "text_option_fold" dir: "tests/fixtures/dump_src")
    (program name: "floatconsts" dir: "tests/fixtures/dump_src")
    (program name: "tagminimal" dir: "tests/fixtures/dump_src")
    (program name: "nested_template" dir: "tests/fixtures/emitc_corpus")
    (program name: "generic_unit_nested" dir: "tests/fixtures/emitc_corpus")
    (program name: "generic_same_spec" dir: "tests/fixtures/emitc_corpus")
    (program name: "generic_nested_spec" dir: "tests/fixtures/emitc_corpus")
    (program name: "generic_nested_signature" dir: "tests/fixtures/emitc_corpus")
    (program name: "generic_nested_construction" dir: "tests/fixtures/emitc_corpus")
    (program name: "partial_name_collision" dir: "tests/fixtures/emitc_corpus")
    (program name: "trie_node_name_collision" dir: "tests/fixtures/emitc_corpus")
    (program name: "dump_scope_rows" dir: "tests/fixtures/dump_src")
    (program name: "dump_destroy_scopes" dir: "tests/fixtures/dump_src")
    (program name: "dump_destroy_exits" dir: "tests/fixtures/dump_src")
    (program name: "dump_destroy_generic" dir: "tests/fixtures/dump_src")
    (program name: "dump_destroy_maybe" dir: "tests/fixtures/dump_src")
    (program name: "dump_generic_arg_temp" dir: "tests/fixtures/dump_src")
    (program name: "dump_lent_field_temp" dir: "tests/fixtures/dump_src")
    (program name: "dump_arm_return_temp" dir: "tests/fixtures/dump_src")
    (program name: "dump_type_application_head" dir: "tests/fixtures/dump_src")
    (program name: "dump_type_application_qualified" dir: "tests/fixtures/dump_src")
    (program name: "dump_generic_protocol_receiver" dir: "tests/fixtures/dump_src")
    (program name: "dump_generic_facet" dir: "tests/fixtures/dump_src")
