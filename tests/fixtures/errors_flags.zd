# errors_flags -- the ERROR kind's programs that take compiler flags beyond the
# kind's own, read once by the runner beside the generated cpar_flags.zd: a
# program neither file lists takes none.

# flagged -- a program that takes compiler flags: its name, and the flags it
# is compiled with after the kind's own, one argument each
flagged: data {
    name: text
    args: list {} out staticlist text
}

programs: list {
    (
        flagged
        name: "as_construction"
        args: list {
            "--eager"
