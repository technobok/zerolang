# doc_baseline.zd -- the documentation ratchet: findings of zl lint --docs-all per
# (rule, file). The ratchet is EXACT, as arch_baseline.zd's: a count above its row fails, a
# count below it fails until the row is lowered, and a row with no findings left fails until
# it is deleted. ztestrunner's doc kind enforces it, under --heavy (make ci) only -- it is a
# full-corpus lint pass, too slow for the fast gate.
#
# The codes it counts: L016 an undocumented definition, L024 a doc that only re-says the
# declaration below it, L025 a doc body repeated more than twice in one unit, its
# subunit files counted with its own and each file reporting its own copies (compared
# with the declaration's own words and every width folded out, so a body written once
# per type reads as one body). THE TARGET IS ZERO for every row: a definition always
# carries a doc, and a doc must add something the name and the type cannot -- where
# nothing can be added, the answer is to rename the thing, not to write filler.
#
# L017 (an undocumented parameter) and L018 (an undocumented member: a field, an arm, a
# generic parameter) are advisory and NOT ratcheted. A member or parameter is documented
# when its name and type do not say enough -- the units, a sentinel's meaning, who writes
# it -- and no count can judge that. `zl lint --docs-params --docs-fields` reports them
# for a reader who wants the list.

# row -- one ratchet row: the rule, the file, and the count held
row: data {
    rule: text
    file: text
    count: u64
}

# rows -- the rows, by rule then file
rows: list {
    (row rule: "L025" file: "lib/system/core.z" count: 8)
    (row rule: "L025" file: "lib/system/math/bigfloat.z" count: 6)
    (row rule: "L025" file: "lib/system/math/bigint.z" count: 11)
    (row rule: "L025" file: "lib/system/math/bigrat.z" count: 7)
    (row rule: "L025" file: "lib/system/math/dec128.z" count: 28)
    (row rule: "L025" file: "lib/system/math/dec256.z" count: 28)
    (row rule: "L025" file: "lib/system/math/dec32.z" count: 28)
    (row rule: "L025" file: "lib/system/math/dec64.z" count: 28)
    (row rule: "L025" file: "lib/system/math/fixedfloat.z" count: 5)
    (row rule: "L025" file: "lib/system/math/fixedint.z" count: 16)
    (row rule: "L025" file: "lib/system/system.z" count: 552)
    (row rule: "L025" file: "lib/system/system/halffloat.z" count: 73)
    (row rule: "L025" file: "lib/system/system/quadfloat.z" count: 73)
    (row rule: "L025" file: "lib/system/system/wideint.z" count: 73)
    (row rule: "L025" file: "src/ztypecheck/bodies.z" count: 1)
    (row rule: "L025" file: "src/ztypecheck/declare.z" count: 18)
    (row rule: "L025" file: "src/ztypecheck/statics.z" count: 1)
    (row rule: "L025" file: "src/ztypecheck/valuechecks.z" count: 4)
    (row rule: "L025" file: "src/ztypes.z" count: 21)
}
