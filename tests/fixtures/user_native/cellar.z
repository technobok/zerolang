# cellar.z -- a GENERIC native class: Cell's C comes from a template its
# `@class` row names (tmpl=), instantiated once per element type, as the
# runtime's own collections are. Two instances, over String and over a user
# class; what a Cell holds is freed by the instance's destructor.

# Jar -- a user class a Cell holds
Jar: class {
    # its contents
    label: String
}

# Cell -- a slot holding a value of its element type, or nothing
Cell: class is native as {
    # the element type
    T: AnyRef.generic
    # put a value in, destroying any it held
    put: function {:this v: T.take} is native
    # whether it holds a value
    full: function {t: this.view} out bool is native
    # how many values it holds: 0 or 1
    puts: function {t: this.view} out u64 is native
    # an empty Cell
    create: function out type is native
}

main: function is {
    s: Cell String
    print "\{s.full}"
    s.put v: "first".string
    s.put v: "second".string
    print "\{s.full} \{s.puts}"
    j: Cell Jar
    j.put v: (Jar label: "honey".string)
    print "\{j.full}"
}
