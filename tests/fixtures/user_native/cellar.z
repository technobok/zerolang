# cellar.z -- native classes written from a C template their `@class` row
# names (tmpl=). Cell is GENERIC: instantiated once per element type, as the
# runtime's own collections are -- two instances, over String and over a user
# class, and what a Cell holds is freed by the instance's destructor. Tally is
# not generic: its template is written once, and owns storage no declaration
# could lay out. `holding` is a GENERIC native free function a templated class
# implements (`via=`): its body is the template function of the Cell instance
# it answers, and the argument it leaves out is its declared default.

# Jar -- a user class a Cell holds
Jar: class {
    # its contents
    label: String
}

# Cell -- a slot holding a value of its element type, or nothing
Cell: class is native as {
    # the element type
    T: AnyRef.generic
    # put a value in, destroying any it held
    put: function {:this v: T.take} is native
    # whether it holds a value
    full: function {t: this.view} out bool is native
    # how many values it holds: 0 or 1
    puts: function {t: this.view} out u64 is native
    # an empty Cell
    create: function out type is native
}

# Tally -- a counter whose storage the template owns
Tally: class is native as {
    # add one
    bump: function {t: this.view} is native
    # the count
    count: function {t: this.view} out u64 is native
    # a counter at start
    create: function {start: u64} out type is native
}

# holding -- a Cell holding `v` when `times` is not 0; an empty one, `v`
# destroyed, when it is
holding: function {v: T.take times: 1.u64} out Cell T as {
    # the element type
    T: AnyRef.generic
} is native

main: function is {
    tl: Tally.create start: 40
    tl.bump
    tl.bump
    print "\{tl.count}"
    s: Cell String
    print "\{s.full}"
    s.put v: "first".string
    s.put v: "second".string
    print "\{s.full} \{s.puts}"
    j: Cell Jar
    j.put v: (Jar label: "honey".string)
    print "\{j.full}"
    h: holding v: (Jar label: "jam".string)
    print "\{h.full}"
}
