# nativec -- mystery's C implementation, a runtime.nativec file
c: runtime.nativec

# implementation -- the C behind mystery's native declarations. Facts:
# `brewing` holds, the program reaching spell.brew, so conjure's variant
# replaces its plain row; `vanishing` names a function nothing calls, so brew
# keeps its plain row and the variant above it is dropped. A variant stands
# above the plain row of its key.
implementation: (
    c.implementation
    rows: list {
        (
            c.row
            key: "conjure"
            fact: "brewing"
            fragments: list {
                """
                static int64_t z_mystery_conjure(int64_t n);
                static int64_t z_mystery_conjure(int64_t n) {
                    return n * 7;
                }
                """
            }
        )
        (
            c.row
            key: "conjure"
            fragments: list {
                """
                static int64_t z_mystery_conjure(int64_t n);
                static int64_t z_mystery_conjure(int64_t n) {
                    return n * 6;
                }
                """
            }
        )
        # a hidden subunit's native, keyed under its parent; its fragment steps a
        # carry through system's word primitives, which the program does not
        # otherwise demand: the host row and the piece it calls
        (
            c.row
            key: "brew"
            fact: "vanishing"
            fragments: list {
                "#error \"the vanishing fact does not hold: this variant must never be loaded\""
            }
        )
        (
            c.row
            key: "brew"
            needs: list { "system.word" "system.@word_addc" }
            fragments: list {
                """
                static int64_t z_mystery_brew(int64_t n);
                static int64_t z_mystery_brew(int64_t n) {
                    uint64_t c;
                    return (int64_t)z_word_addc((uint64_t)n, (uint64_t)n, 0, &c);
                }
                """
            }
        )
        # a receiver-only row whose member name a system type's bodyless row
        # shares (String's `length`): the name alone must not route that member
        # through it
        (c.row key: "gauge.length" body: "((uint64_t)(@V@))")
    }
    facts: list {
        (c.fact name: "brewing" reach: list { "mystery.spell.brew" })
        (c.fact name: "vanishing" reach: list { "mystery.vanish" })
    }
    # brewing asks for pthread at the link
    links: list { (c.link library: "pthread" fact: "brewing") }
)
