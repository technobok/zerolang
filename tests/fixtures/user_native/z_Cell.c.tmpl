/* Cell -- a generic native class for the user-native guard: one slot that
   holds a @@T@@ or nothing. Instantiated per mono from its class row's
   tmpl=; @@T_DESTROY@@(x) destroys a value of the element type in place. */
typedef struct z_@@NAME@@_t {
    bool full;
    @@T@@ value;
} z_@@NAME@@_t;

static z_@@NAME@@_t z_@@NAME@@_create(void) {
    z_@@NAME@@_t c;
    memset(&c, 0, sizeof c);
    return c;
}

static void z_@@NAME@@_destroy(z_@@NAME@@_t* c) {
    if (c->full) { @@T_DESTROY@@(&c->value); }
    c->full = false;
}

static void z_@@NAME@@_put(z_@@NAME@@_t* c, @@T@@ v) {
    if (c->full) { @@T_DESTROY@@(&c->value); }
    c->value = v;
    c->full = true;
}

/* cellar.holding's body (its row's via=holding) */
static z_@@NAME@@_t z_@@NAME@@_holding(@@T@@ v, uint64_t times) {
    z_@@NAME@@_t c = z_@@NAME@@_create();
    if (times == 0) { @@T_DESTROY@@(&v); return c; }
    z_@@NAME@@_put(&c, v);
    return c;
}

static bool z_@@NAME@@_full(const z_@@NAME@@_t* c) {
    return c->full;
}

static uint64_t z_@@NAME@@_puts(const z_@@NAME@@_t* c) {
    return c->full ? 1 : 0;
}
