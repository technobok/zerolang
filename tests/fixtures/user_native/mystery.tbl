
# mystery -- a unit outside src/runtime, appended to the table at test time
# facts: `brewing` holds, the program reaching spell.brew, so conjure's variant
# replaces its plain row; `vanishing` names a function nothing calls, so brew
# keeps its plain row and the variant under it is dropped. A variant stands
# above the plain row of its key.
[@fact.brewing reach=mystery.spell.brew]
[@fact.vanishing reach=mystery.vanish]
[mystery.conjure when=brewing frag=_Z_MYSTERY_CONJURE_BREWING]
[mystery.conjure frag=_Z_MYSTERY_CONJURE]
# a hidden subunit's native, keyed under its parent; its fragment steps a carry
# through system's word primitives, which the program does not otherwise demand
[mystery.brew when=vanishing frag=_Z_MYSTERY_BREW_VANISHING]
[mystery.brew needs=system.word frag=_Z_MYSTERY_BREW]
# an `@unit.` row may be a variant too: brewing asks for pthread at the link
[@unit.mystery when=brewing link=pthread]

# cellar -- a generic native class whose C is a template, one per instance
[cellar.Cell.@class tmpl=z_Cell.c.tmpl]
[cellar.Cell.put]
[cellar.Cell.full]
[cellar.Cell.puts]
[cellar.Cell.create]
