# mystery.z -- a unit outside the compiler's own runtime, shipping the row and
# the fragment for its own native. It routes, emits, LINKS and runs; before the
# runtime pass read the table, the first three worked and the link did not.
# spell.brew is a hidden subunit's native, called through the subunit's name:
# its row is keyed under mystery, and its fragment needs another unit's.
# Reaching brew makes the table's `brewing` fact hold, which swaps conjure's
# fragment for its variant (7 * 7).

conjure: function {n: i64} out i64 is native

# vanish -- nothing calls it, so the `vanishing` fact naming it never holds
vanish: function {n: i64} out i64 is {
    return n
}

main: function is {
    print "\{conjure n: 7.i64}"
    print "\{spell.brew n: 21.i64}"
    w: "abc".string
    print "\{w.length}"
}
