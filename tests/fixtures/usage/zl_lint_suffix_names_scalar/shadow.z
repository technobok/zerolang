# A unit's own type named `u8` (a typedef over the scalar) beside the scalar u8:
# `.u8` always converts to the scalar, so it is redundant only where the scalar
# is the type already -- `y = 6.u8` -- and not against a value of the unit's u8.
u8: typedef system.u8

marks: list { 5 6 } out staticlist u8

main: function is {
    for each m: marks loop {
        if m == 5.u8 then print "five"
    }
    y: system.u8
    y = 6.u8
    print "\{y.u64}"
}
