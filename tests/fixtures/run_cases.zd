# run_cases -- the RUN kind's programs: each is built and run, and its output
# must equal tests/fixtures/run_golden/<name>.out (<name>.windows.out on
# Windows, where one exists). The LONE, pedantic and emitted kinds read the same
# programs. matrix_cases.zd and cpar_cases.zd hold the RUN programs the two
# matrix generators write; this file holds the rest.

# program -- one test program: <dir>/<name>.z from the repository root, its
# units also read from each of `roots`
program: data {
    name: text
    dir: text
    roots: list {} out staticlist text
    # it checks what only POSIX has (file descriptors, signals): on Windows it
    # is listed as (posix) and not run
    posix: false
}

programs: list {
