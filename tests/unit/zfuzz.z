# zfuzz -- the token-mutation fuzzer for zc. Each case takes one program of the
# corpus, edits its tokens (delete, duplicate, swap, replace or insert tokens of
# another program), and builds the result with the compiler under test, which
# is meant to be an AddressSanitizer build. A case passes when zc builds it, or
# refuses it with a diagnostic. Anything else is a finding: a crash or a
# sanitizer report, a hang, a panic, an emitter error (the checker let through
# what the emitter cannot write), or C the C compiler refuses. A mutant is only
# ever compiled, never run.
#
# Usage: zfuzz --zc <zc> --system <dir> --corpus <dir>[,<dir>...] --work <dir>
#              [--seed N] [--count N] [--jobs N] [--timeout SECS]
#              [--known FILE] [--write-known]
#        zfuzz ... --recheck <dir>
#        zfuzz ... --reduce <file> --out <file>
#        zfuzz --generate --zc <zc> --system <dir> --work <dir>
#              [--seed N] [--count N] [--jobs N] [--timeout SECS]
#              [--configs N] [--tcc <tcc> --tcc-lib <dir>] [--zl <zl>]
# A case is decided by the seed, the NAME of the program it edits and a round
# number, and the program it takes tokens from by name too. So a run repeats
# exactly whatever the number of threads, and a program added to the corpus
# adds cases of its own and leaves nearly every other case as it was.
# Findings are kept in <work>/findings; exit status 1 when there is one.
#
# `--known FILE` names the signatures a run is known to show: a data file
# (tests/known/fuzz.zd) whose `findings` lists them. The run then fails on a
# signature the file does not list, and on a listed one it no longer shows: a
# fixed defect leaves the list in the same change. `--write-known` writes the
# file from the run instead.
#
# `--generate` takes its cases from a generator instead of the corpus
# (zfuzz/gen.z): each case is a typed program that terminates, whose output a
# model of the language predicts (zfuzz/model.z). The compiler under test
# emits the program's C once; the C is built and run under each C
# configuration of zfuzz/judge.z (`--configs N` runs the first N, 0 only
# emits), and every run must print what the model expects and exit as it
# expects. A refusal is a finding too, since every generated program is valid.
# With `--zl`, the formatter is judged on every program as well (judge.z's
# fmtJudge).
#
# `--recheck DIR` builds every saved finding, each `.z` file under DIR at any
# depth, and reports the ones that still fail, with their signatures.
# `--reduce FILE` shrinks one finding while it shows the same defect -- runs of
# lines first, then runs of tokens -- and writes what is left to `--out`. Both
# build with the corpus folders as source roots, and judge as a run does.

public: unit {
    :main
}

# slurp -- file content as an owned String, or "" when unreadable.
slurp: function {path: StringView} out String is {
    r: io.readText :path
    match (
        r
    ) case ok then {
        return r.copy
    } case err then {
        return "".string
    }
    return "".string
}

# Rng -- splitmix64: a sequence decided by its seed alone
Rng: class {
    # the state
    s: u64
} as {
    # the next 64 bits
    next: function {:this} out u64 is {
        this.s = this.s + 0x9E3779B97F4A7C15
        z: this.s
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
        z = (z ^ (z >> 27)) * 0x94D049BB133111EB
        return z ^ (z >> 31)
    }

    # a number below `n`, 0 when `n` is 0
    below: function {:this n: u64} out u64 is {
        v: this.next
        if n == 0 then return 0
        return v % n
    }
}

# nameHash -- a number decided by the bytes of `name` alone (FNV-1a)
nameHash: function {name: StringView} out u64 is {
    h: 0xCBF29CE484222325.u64
    i: u64
    for i < name.length loop {
        h = (h ^ ((name.byteAt :i).or d: 0)) * 0x100000001B3
        i = i + 1
    }
    return h
}

# nearestAbove -- the position in `hashes` of the number nearest above `v`,
# going round from the highest to the lowest. A number added to `hashes` moves
# the answer only for a `v` just below it.
nearestAbove: function {hashes: (ListVal u64).view v: u64} out u64 is {
    best: u64
    gap: 0xFFFFFFFFFFFFFFFF.u64
    i: u64
    for i < hashes.length loop {
        g: (hashes.get :i) - v
        if g <= gap then {
            gap = g
            best = i
        }
        i = i + 1
    }
    return best
}

# Tokens -- a source text cut at its token starts: piece `i` runs from
# `starts[i]` to `starts[i + 1]`, and `words` lists the pieces that are not
# white space, line ends or comments
Tokens: class {
    # the text
    src: String
    # each token's first byte, then the text's length
    starts: ListVal u64
    # the pieces a mutation picks from
    words: ListVal u64
} as {
    # cut `text` at its tokens
    create: function {text: String.take} out this is {
        starts: ListVal u64
        words: ListVal u64
        pool: zast.StringPool.create
        tok: zlexer.Tokenizer.create source: text.copy fsno: zvfs.fsno
        last: u64
        for true loop {
            t: tok.nextToken :pool
            if t.toktype == zlexer.toktype.eofTok then break
            # a token that does not advance would loop for ever on a text the
            # lexer cannot leave
            if (starts.length > 0) and (t.offset < last) then break
            if t.toktype != zlexer.toktype.bofTok then {
                trivia: (
                    (t.toktype == zlexer.toktype.wsTok) or
                    (t.toktype == zlexer.toktype.eolTok) or
                    (t.toktype == zlexer.toktype.commentTok)
                )
                if trivia.not then words.append starts.length
                starts.append t.offset
                last = t.offset
            }
        }
        starts.append text.length
        return (meta.create src: text.take :starts :words)
    }

    # how many pieces there are
    count: function {t: this.view} out u64 is {
        return t.starts.length - 1
    }

    # piece `i`
    piece: function {t: this.view i: u64} outx StringView is {
        return (t.src.substring from: (t.starts.get :i) to: (t.starts.get i: i + 1))
    }
}

# mutate -- one edit of `base`'s tokens, with `donor` to take tokens from
mutate: function {base: Tokens.view donor: Tokens.view rng: Rng} out String is {
    result: String
    n: base.count
    if (base.words.length == 0) or (donor.words.length == 0) then return base.src.copy
    at: base.words.get i: (rng.below n: base.words.length)
    other: base.words.get i: (rng.below n: base.words.length)
    from: rng.below n: donor.words.length
    run: 1 + (rng.below n: 6)
    kind: rng.below n: 7
    i: u64
    for i < n loop {
        p: base.piece :i
        if i == at then {
            if kind == 0 then {
                # delete the token
                null
            } else if kind == 1 then {
                # duplicate it
                result.append p
                result.append " "
                result.append p
            } else if kind == 2 then {
                # swap it with another
                result.append (base.piece i: other)
            } else if kind == 3 then {
                # replace it with one of the donor's
                result.append (donor.piece i: (donor.words.get i: from))
            } else if kind == 4 then {
                # insert a run of the donor's before it
                appendRun :result :donor :from :run
                result.append p
            } else if kind == 5 then {
                # delete a run: this token and the ones after it
                i = i + (run * 2 - 1)
            } else {
                # replace it with a run of the donor's
                appendRun :result :donor :from :run
            }
        } else if (i == other) and (kind == 2) then {
            result.append (base.piece i: at)
        } else {
            result.append p
        }
        i = i + 1
    }
    return result
}

# appendRun -- `run` of the donor's tokens from its word `from`, each with the
# white space after it, onto `result`
appendRun: function {result: String donor: Tokens.view from: u64 run: u64} is {
    first: donor.words.get i: from
    k: u64
    for (k < (run * 2)) and ((first + k) < donor.count) loop {
        result.append (donor.piece i: first + k)
        k = k + 1
    }
    result.append " "
}

# normalise -- `line` with every run of digits written as `N` and cut to 160
# bytes: two reports of one defect read alike whatever ids and positions they
# carry
normalise: function {line: StringView} out String is {
    r: String
    inDigits: false
    i: u64
    for (i < line.length) and (r.length < 160) loop {
        b: (line.byteAt :i).or d: ascii.space
        if (ascii.isDigit :b) then {
            if inDigits.not then r.append "N"
            inDigits = true
        } else {
            inDigits = false
            r.appendByte :b
        }
        i = i + 1
    }
    return r
}

# firstLineWith -- the first line of `text` holding `needle`, normalised; ""
# when none does
firstLineWith: function {text: StringView needle: StringView} out String is {
    for each ln: text.lines loop {
        if ln.contains needle then return (normalise line: ln)
    }
    return "".string
}

# verdict -- what a build that ended with `status` and wrote `errText` to
# stderr was: "" for a pass (built, or refused with a diagnostic), else the
# finding's kind and its signature
verdict: function {status: i32 errText: StringView} out String is {
    if status == 124 then return "hang: no answer within the time limit".string
    san: firstLineWith text: errText needle: "ERROR: AddressSanitizer"
    if san.length > 0 then return "crash: \{san}"
    leak: firstLineWith text: errText needle: "ERROR: LeakSanitizer"
    if leak.length > 0 then {
        where: firstLineWith text: errText needle: "    #1 "
        return "leak: \{where}"
    }
    ub: firstLineWith text: errText needle: "runtime error:"
    if ub.length > 0 then return "crash: \{ub}"
    pn: firstLineWith text: errText needle: "zpanic"
    if pn.length > 0 then return "panic: \{pn}"
    em: firstLineWith text: errText needle: "error[E0500]"
    if em.length > 0 then return "emitter: \{em}"
    diag: (errText.contains "error[E") or (errText.contains "error: ")
    cc: firstLineWith text: errText needle: " error: "
    if (cc.length > 0) and (errText.contains "error[E").not then return "bad C: \{cc}"
    if status == 0 then return "".string
    if (status == 1) and diag then return "".string
    if (status == 2) and diag then return "".string
    return "crash: exit status \{status} with no diagnostic"
}

# Build -- how one build of a program by zc ended
Build: class {
    status: i32
    # what zc wrote to its standard error
    err: String
}

# buildOnce -- program `text`, written as `<dir>/<name>.z`, built by `zc` with
# `dir` and then `roots` as its source roots; the files the build made are
# removed again
buildOnce: function {
    zc: StringView
    system: StringView
    roots: (List String).view
    dir: StringView
    name: StringView
    text: StringView
    timeout: i32
} out Build is {
    src: "\{dir}/\{name}.z"
    io.writeText path: src content: text
    errPath: "\{dir}/\{name}.err"
    bin: "\{dir}/\{name}.bin"
    argv: List String
    argv.append zc.string
    argv.append "build".string
    argv.append name.string
    argv.append "--src".string
    argv.append dir.string
    for each r: roots loop {
        argv.append "--src".string
        argv.append r.copy
    }
    argv.append "--system".string
    argv.append system.string
    argv.append "-o".string
    argv.append bin.copy
    argv.append "--cflags".string
    argv.append "-O0 -w".string
    status: (
        os.spawn
        :argv
        cwd: dir
        outPath: os.nullDevice.stringView
        errPath: errPath.stringView
        timeoutSecs: timeout
    )
    b: Build :status err: (slurp path: errPath.stringView)
    io.remove path: src
    io.remove path: errPath
    io.remove path: bin
    return b
}

# Report -- what one worker found
Report: class {
    # cases run
    cases: u64
    # cases zc built
    built: u64
    # each finding's kind and signature
    findings: List String
    # the case that showed each finding, and the program it was made from
    shown: List String
}

# Worker -- the task of one thread: every case whose number is `lane` modulo
# `lanes`
Worker: class {
    # the compiler under test
    zc: String
    # its --system directory
    system: String
    # the corpus directories
    dirs: List String
    # where mutants and their outputs go
    work: String
    # the run's seed
    seed: u64
    # how many cases the run has in all
    count: u64
    # this worker's lane, and how many there are
    lane: u64
    lanes: u64
    # seconds a build may take
    timeout: i32
} as {
    task: (thread.Task Report).implement

    call: function {w: this} out Report is {
        rep: Report cases: 0 built: 0 findings: List String shown: List String
        files: List String
        fdirs: List String
        hashes: ListVal u64
        for each d: w.dirs loop {
            ls: io.listDir path: d
            if ls.err then continue
            for each e: ls loop {
                if e.stringView.endsWith ".z" then {
                    files.append "\{d}/\{e}"
                    fdirs.append d.copy
                    hashes.append (nameHash name: e.stringView)
                }
            }
        }
        if files.length == 0 then return rep
        k: w.lane
        for k < w.count loop {
            w.runCase :files :fdirs :hashes :k :rep
            k = k + w.lanes
        }
        return rep
    }

    # runCase -- case `k`: mutate, build, judge, and record a finding. The
    # case edits program `k` modulo the corpus size, in round `k` divided by it;
    # `hashes` holds each program's name hash.
    runCase: function {
        w: this.view
        files: (List String).view
        fdirs: (List String).view
        hashes: (ListVal u64).view
        k: u64
        rep: Report
    } is {
        bi: k % files.length
        round: k / files.length
        rng: (
            Rng
            s: (w.seed * 0x2545F4914F6CDD1D) ^ (hashes.get i: bi) ^ (round * 0x9E3779B97F4A7C15)
        )
        di: nearestAbove :hashes v: rng.next
        text: slurp path: (files.get i: bi).stringView
        edits: 1 + (rng.below n: 3)
        donor: Tokens.create text: (slurp path: (files.get i: di).stringView)
        e: u64
        for e < edits loop {
            base: Tokens.create text: text.take
            text = mutate :base :donor :rng
            e = e + 1
        }
        name: "fz\{k}"
        roots: List String
        roots.append (fdirs.get i: bi).copy
        b: (
            buildOnce
            zc: w.zc.stringView
            system: w.system.stringView
            :roots
            dir: w.work.stringView
            name: name.stringView
            text: text.stringView
            timeout: w.timeout
        )
        rep.cases = rep.cases + 1
        if b.status == 0 then rep.built = rep.built + 1
        v: verdict status: b.status errText: b.err.stringView
        if v.length > 0 then {
            keep: "\{w.work}/findings"
            io.writeText path: "\{keep}/\{name}.z" content: text
            io.writeText path: "\{keep}/\{name}.err" content: b.err
            rep.findings.append v.take
            rep.shown.append "\{name} (from \{files.get i: bi})"
        }
    }
}

# optionOr -- the option `name` of the command line, or `d`
optionOr: function {p: cli.Parsed.view name: StringView d: StringView} out String is {
    o: p.option :name
    match (
        o
    ) case some then {
        return o.copy
    } case none then {
        return d.string
    }
    return d.string
}

main: function is {
    sp: fuzzSpec
    parsed: cli.parse spec: sp args: os.args
    match (
        parsed
    ) case ok then {
        if (parsed.option name: "--model-check").some then {
            text: slurp path: (optionOr p: parsed name: "--model-check" d: "").stringView
            if (model.checkGolden text: text.stringView) > 0 then os.exit code: 1
        } else if (parsed.hasFlag name: "--generate") then {
            generateRun p: parsed
        } else if (corpusDirs p: parsed).length == 0 then {
            io.eprintln "zfuzz: --corpus is required without --generate"
            os.exit code: 2
        } else if (parsed.option name: "--recheck").some then {
            recheck p: parsed
        } else if (parsed.option name: "--reduce").some then {
            reduce p: parsed
        } else run p: parsed
    } case err then {
        io.eprintln (cli.helpText spec: sp)
        os.exit code: 2
    }
}

# fuzzSpec -- zfuzz's command line: its options and flags
fuzzSpec: function out cli.Spec is {
    sp: (
        cli.Spec.create
        programName: "zfuzz".string
        summary: "fuzzer for zc: mutated corpus programs, or generated ones (--generate)".string
    )
    (
        cli.addOption
        spec: sp
        name: "--zc".string
        shortName: "".string
        help: "the compiler under test".string
        required: true
    )
    (
        cli.addOption
        spec: sp
        name: "--system".string
        shortName: "".string
        help: "its --system directory".string
        required: true
    )
    (
        cli.addOption
        spec: sp
        name: "--corpus".string
        shortName: "".string
        help: "corpus directories, comma separated (not with --generate)".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--work".string
        shortName: "".string
        help: "scratch directory".string
        required: true
    )
    (
        cli.addOption
        spec: sp
        name: "--seed".string
        shortName: "".string
        help: "the run's seed (1)".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--count".string
        shortName: "".string
        help: "cases to run (1000)".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--jobs".string
        shortName: "".string
        help: "threads (the cpu count)".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--timeout".string
        shortName: "".string
        help: "seconds a build may take (20)".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--known".string
        shortName: "".string
        help: "the file of signatures the run is known to show".string
        required: false
    )
    (
        cli.addFlag
        spec: sp
        name: "--write-known".string
        shortName: "".string
        help: "write the --known file from this run".string
    )
    (
        cli.addOption
        spec: sp
        name: "--recheck".string
        shortName: "".string
        help: "build every finding under this folder instead of fuzzing".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--reduce".string
        shortName: "".string
        help: "shrink this finding instead of fuzzing".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--out".string
        shortName: "".string
        help: "where --reduce writes what is left".string
        required: false
    )
    generateOptions :sp
    return sp
}

# generateOptions -- the options of `--generate` mode, added to `sp`
generateOptions: function {sp: cli.Spec} is {
    (
        cli.addFlag
        spec: sp
        name: "--generate".string
        shortName: "".string
        help: "generate typed programs and judge them against the model".string
    )
    (
        cli.addOption
        spec: sp
        name: "--tcc".string
        shortName: "".string
        help: "with --generate: the tcc of the tcc configuration".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--tcc-lib".string
        shortName: "".string
        help: "with --generate: that tcc's library folder (-B)".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--model-check".string
        shortName: "".string
        help: "check the generator's model against overflow_methods' golden output".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--zl".string
        shortName: "".string
        help: "with --generate: the formatter to judge (zl fmt, zl lint)".string
        required: false
    )
    (
        cli.addOption
        spec: sp
        name: "--configs".string
        shortName: "".string
        help: "with --generate: how many C configurations to run (5); 0 only emits".string
        required: false
    )
}

# run -- the fuzz run the command line `p` asks for
run: function {p: cli.Parsed.view} is {
    seed: numberOption :p name: "--seed" d: 1
    count: numberOption :p name: "--count" d: 1000
    jobs: jobsOf :p
    work: pathOption :p name: "--work"
    io.mkdirp path: "\{work}/findings"
    handles: List (thread.JoinHandle Report)
    lane: u64
    for lane < jobs loop {
        dirs: corpusDirs :p
        handles.append (
            thread.spawn
            task: (
                Worker
                zc: (pathOption :p name: "--zc")
                system: (pathOption :p name: "--system")
                :dirs
                work: work.copy
                :seed
                :count
                :lane
                lanes: jobs
                timeout: (timeoutOf :p)
            )
        )
        lane = lane + 1
    }
    cases: u64
    built: u64
    kinds: List String
    shown: List String
    total: u64
    for handles.length > 0 loop {
        h: handles.pop
        rep: h.join
        cases = cases + rep.cases
        built = built + rep.built
        fi: u64
        for fi < rep.findings.length loop {
            total = total + 1
            sig: rep.findings.get i: fi
            if (kinds.contains item: sig).not then {
                kinds.append sig.copy
                shown.append (rep.shown.get i: fi).copy
            }
            fi = fi + 1
        }
    }
    print "zfuzz: seed \{seed}, \{cases} cases, \{built} built, \{cases - built - total} refused, \{total} findings (\{kinds.length} distinct)"
    report :p :kinds :shown :seed :count :total header: knownHeader
}

# numberOption -- the option `name` of the command line as a number, or `d`
# when it is absent or not a number
numberOption: function {p: cli.Parsed.view name: StringView d: u64} out u64 is {
    return ((optionOr :p :name d: "").stringView.parseU64.or :d)
}

# jobsOf -- the threads the command line asks for: `--jobs`, else the cpu count
jobsOf: function {p: cli.Parsed.view} out u64 is {
    jobs: numberOption :p name: "--jobs" d: 0
    if jobs == 0 then jobs = os.cpuCount.u64.or d: 1
    return jobs
}

# timeoutOf -- the seconds a build may take: `--timeout`, else 20
timeoutOf: function {p: cli.Parsed.view} out i32 is {
    return ((numberOption :p name: "--timeout" d: 20).i32.or d: 20)
}

# corpusDirs -- the folders the command line's `--corpus` names, absolute
corpusDirs: function {p: cli.Parsed.view} out List String is {
    dirs: List String
    corpus: optionOr :p name: "--corpus" d: ""
    for each d: (corpus.stringView.split sep: ",") loop dirs.append (absolutePath p: d)
    return dirs
}

# absolutePath -- `p` from the folder zfuzz runs in, when it is relative: each
# build runs in a folder of its own, where a relative path names nothing
absolutePath: function {p: StringView} out String is {
    if (p.length == 0) or (path.isAbsolute :p) then return p.string
    here: os.cwd
    if here.err then return p.string
    return (path.join a: here.stringView b: p)
}

# pathOption -- the path option `name` of the command line, made absolute
pathOption: function {p: cli.Parsed.view name: StringView} out String is {
    v: optionOr :p :name d: ""
    return (absolutePath p: v.stringView)
}

# report -- say what the run found and end it: every finding, or, with
# `--known`, the differences from the listed ones; `--write-known` writes the
# list instead. `total` counts the findings, `kinds` the distinct ones.
report: function {
    p: cli.Parsed.view
    kinds: List String
    shown: (List String).view
    seed: u64
    count: u64
    total: u64
    # the comment heading a written --known file
    header: StringView
} is {
    knownPath: optionOr :p name: "--known" d: ""
    if knownPath.length == 0 then {
        si: u64
        for si < kinds.length loop {
            print "FINDING \{kinds.get i: si} -- \{shown.get i: si}"
            si = si + 1
        }
        if total > 0 then os.exit code: 1
        return
    }
    if (p.hasFlag name: "--write-known") then {
        writeKnown path: knownPath.stringView :kinds :seed :count :header
        print "zfuzz: wrote \{kinds.length} signatures to \{knownPath}"
        return
    }
    if (judgeAgainstKnown path: knownPath.stringView :kinds :shown).not then os.exit code: 1
}

# genKnownHeader -- knownHeader for the fixed-seed run of --generate
genKnownHeader: "# fuzzgen -- the findings the fixed-seed run of `zfuzz --generate` in `make ci`\n# is known to show, each a signature in `findings`, from the run of `seed` with\n# `cases` programs. Each is a defect not fixed yet. The run fails on a\n# signature not listed here, and on a listed one it no longer shows: fix the\n# defect and delete its line in the same change. `make fuzz-gen-known` writes\n# this file from a run."

# knownHeader -- the comment that heads the data file of known signatures
knownHeader: "# fuzz -- the findings the fixed-seed fuzz run of `make ci` is known to show,\n# each a signature in `findings`, from the run of `seed` with `cases` cases.\n# Each is a defect of zc that is not fixed yet. The run fails on a signature\n# not listed here, and on a listed one it no longer shows: fix the defect and\n# delete its line in the same change. `make fuzz-known` writes this file from\n# a run."

# writeKnown -- write the signatures `kinds` to the data file `path`, in order,
# with the run they come from
writeKnown: function {
    path: StringView kinds: List String seed: u64 count: u64 header: StringView
} is {
    kinds.sort
    items: List zd.Entry
    for each k: kinds loop items.append (
        zd.entry
        name: ""
        type: ""
        node: zd.Node.text k.stringView.trimEnd.string
    )
    defs: List zd.Entry
    defs.append (zd.entry name: "seed" type: "" node: zd.Node.integer seed.i64.orPanic)
    defs.append (zd.entry name: "cases" type: "" node: zd.Node.integer count.i64.orPanic)
    defs.append (
        zd.entry
        name: "findings"
        type: "staticlist text"
        node: zd.Node.listValue items.take
    )
    doc: zd.entry name: "fuzz" type: "" node: zd.Node.unitValue defs.take
    (zd.write :path :header schema: "" :doc).orPanic
}

# judgeAgainstKnown -- compare the signatures a run showed, `kinds`, with the
# ones `path` lists, and report each difference: a signature that is not
# listed, with the case in `shown` that showed it, and a listed one the run did
# not show. True when there is no difference.
judgeAgainstKnown: function {
    path: StringView
    kinds: (List String).view
    shown: (List String).view
} out bool is {
    known: List String
    doc: (zd.read :path).orPanic
    for each f: (doc.itemsAt path: "findings").orPanic loop known.append (f.textAt path: ""
    ).orPanic.copy
    fresh: u64
    si: u64
    for si < kinds.length loop {
        sig: (kinds.get i: si).stringView.trimEnd
        if (known.contains item: sig.string).not then {
            print "FINDING \{sig} -- \{shown.get i: si}"
            fresh = fresh + 1
        }
        si = si + 1
    }
    gone: u64
    for each k: known loop {
        seen: false
        for each s: kinds loop {
            if s.stringView.trimEnd == k then seen = true
        }
        if seen.not then {
            print "GONE \{k} -- the run no longer shows it; delete its line from \{path}"
            gone = gone + 1
        }
    }
    print "zfuzz: \{kinds.length - fresh} known, \{fresh} not listed, \{gone} listed but gone"
    return (fresh == 0) and (gone == 0)
}

# isDir -- whether `path` names a folder, following links
isDir: function {path: StringView} out bool is {
    st: io.stat :path
    if st.err then return false
    return st.kind == io.filekind.dir
}

# findingFiles -- the `.z` files under the folder `dir`, at any depth,
# appended to `into`
findingFiles: function {dir: StringView into: (List String).borrow} is {
    ls: io.listDir path: dir
    if ls.err then return
    for each e: ls loop {
        p: "\{dir}/\{e}"
        if e.stringView.endsWith ".z" then {
            into.append p.copy
        } else if (isDir path: p.stringView) then findingFiles dir: p.stringView :into
    }
}

# savedName -- the program name a saved finding is built under, whatever its
# file is called: a file name need not be a unit name
savedName: "fz"

# Rechecker -- the task of one thread of a recheck: every finding under `top`
# (findingFiles, sorted) whose position is `lane` modulo `lanes`, each built in
# the thread's own folder `dir`
Rechecker: class {
    zc: String
    system: String
    # the source roots after the finding's own folder
    roots: List String
    dir: String
    top: String
    lane: u64
    lanes: u64
    timeout: i32
} as {
    task: (thread.Task Report).implement

    call: function {w: this} out Report is {
        rep: Report cases: 0 built: 0 findings: List String shown: List String
        io.mkdirp path: w.dir
        files: List String
        findingFiles dir: w.top.stringView into: files
        files.sort
        k: w.lane
        for k < files.length loop {
            f: files.get i: k
            text: slurp path: f.stringView
            b: (
                buildOnce
                zc: w.zc.stringView
                system: w.system.stringView
                roots: w.roots
                dir: w.dir.stringView
                name: savedName
                text: text.stringView
                timeout: w.timeout
            )
            rep.cases = rep.cases + 1
            if b.status == 0 then rep.built = rep.built + 1
            v: verdict status: b.status errText: b.err.stringView
            if v.length > 0 then {
                rep.findings.append v.take
                rep.shown.append f.copy
            }
            k = k + w.lanes
        }
        return rep
    }
}

# recheck -- build every finding under the folder `--recheck` names, and
# report each that still fails with its signature, then how many show each
# signature
recheck: function {p: cli.Parsed.view} is {
    top: optionOr :p name: "--recheck" d: ""
    work: pathOption :p name: "--work"
    files: List String
    findingFiles dir: top.stringView into: files
    files.sort
    jobs: jobsOf :p
    handles: List (thread.JoinHandle Report)
    lane: u64
    for lane < jobs loop {
        handles.append (
            thread.spawn
            task: (
                Rechecker
                zc: (pathOption :p name: "--zc")
                system: (pathOption :p name: "--system")
                roots: (corpusDirs :p)
                dir: "\{work}/recheck/\{lane}"
                top: top.copy
                :lane
                lanes: jobs
                timeout: (timeoutOf :p)
            )
        )
        lane = lane + 1
    }
    left: List String
    sigs: List String
    for handles.length > 0 loop {
        h: handles.pop
        rep: h.join
        fi: u64
        for fi < rep.findings.length loop {
            f: rep.shown.get i: fi
            v: rep.findings.get i: fi
            left.append "\{f.stringView.substring from: top.length + 1 to: f.length}: \{v}"
            sigs.append v.copy
            fi = fi + 1
        }
    }
    left.sort
    for each l: left loop print "LEFT \{l}"
    sigs.sort
    si: u64
    for si < sigs.length loop {
        n: 1.u64
        for (si + n) < sigs.length loop {
            if (sigs.get i: si + n) != (sigs.get i: si) then break
            n = n + 1
        }
        print "\{n} \{sigs.get i: si}"
        si = si + n
    }
    print "zfuzz: \{left.length} of \{files.length} findings still fail"
}

# quoteMarkAt -- how many bytes the quote mark at byte `at` of `text` takes: 1
# for ' and `, 3 for the typographic ones, 0 when none starts there
quoteMarkAt: function {text: StringView at: u64} out u64 is {
    rest: text.substring from: at to: text.length
    if (rest.startsWith "'") or (rest.startsWith "`") then return 1
    if (rest.startsWith "‘") or (rest.startsWith "’") then return 3
    return 0
}

# reduceKey -- the signature `v` with every quoted name in it written `X`: a
# reduction keeps the defect, whatever names its report carries
reduceKey: function {v: StringView} out String is {
    r: String
    inQuote: false
    i: u64
    for i < v.length loop {
        mark: quoteMarkAt text: v at: i
        if mark > 0 then {
            if inQuote.not then r.append "X"
            inQuote = inQuote.not
            i = i + mark
        } else {
            if inQuote.not then r.appendByte ((v.byteAt :i).or d: ascii.space)
            i = i + 1
        }
    }
    return r
}

# Reducer -- what a reduction builds with, and the defect it keeps
Reducer: class {
    zc: String
    system: String
    # the source roots after the folder it builds in
    roots: List String
    dir: String
    # the finding's program name
    name: String
    timeout: i32
    # the reduceKey of the finding's signature
    want: String
} as {
    # keeps -- whether the program `text` still shows the finding
    keeps: function {r: this.view text: StringView} out bool is {
        if text.trim.length == 0 then return false
        b: (
            buildOnce
            zc: r.zc.stringView
            system: r.system.stringView
            roots: r.roots
            dir: r.dir.stringView
            name: r.name.stringView
            :text
            timeout: r.timeout
        )
        v: verdict status: b.status errText: b.err.stringView
        return (reduceKey v: v.stringView) == r.want
    }
}

# joinKept -- the pieces `keep` marks, joined
joinKept: function {pieces: (List String).view keep: (ListVal bool).view} out String is {
    t: String
    i: u64
    for i < pieces.length loop {
        if (keep.get :i) then t.append (pieces.get :i)
        i = i + 1
    }
    return t
}

# setRun -- `keep` set to `val` at the pieces `live` names from its position
# `from` up to `to`
setRun: function {
    keep: (ListVal bool).borrow live: (ListVal u64).view from: u64 to: u64 val: bool
} is {
    j: from
    for j < to loop {
        keep.set i: (live.get i: j) :val
        j = j + 1
    }
}

# without -- `l` without its items from position `from` up to `to`
without: function {l: (ListVal u64).view from: u64 to: u64} out ListVal u64 is {
    r: ListVal u64
    j: u64
    for j < l.length loop {
        if (j < from) or (j >= to) then r.append (l.get i: j)
        j = j + 1
    }
    return r
}

# shrink -- clear in `keep` every run of the pieces `cand` names whose removal
# keeps the finding: runs of half of them first, halved down to single pieces,
# and the pass of single pieces repeated while it removes one
shrink: function {
    r: Reducer.view
    pieces: (List String).view
    cand: (ListVal u64).view
    keep: (ListVal bool).borrow
} is {
    live: ListVal u64
    for each c: cand loop live.append c
    n: live.length / 2
    if n == 0 then n = 1
    for live.length > 0 loop {
        before: live.length
        live = shrinkPass :r :pieces :keep :live :n
        if (n == 1) and (live.length == before) then break
        if n > 1 then n = n / 2
    }
}

# shrinkPass -- one pass over the pieces `live` names, in runs of `n`: a run
# whose removal keeps the finding is cleared in `keep`; answers the pieces left
shrinkPass: function {
    r: Reducer.view
    pieces: (List String).view
    keep: (ListVal bool).borrow
    live: (ListVal u64).view
    n: u64
} out ListVal u64 is {
    left: without l: live from: 0 to: 0
    i: u64
    for i < left.length loop {
        end: i + n
        if end > left.length then end = left.length
        setRun :keep live: left from: i to: end val: false
        if (r.keeps text: (joinKept :pieces :keep).stringView) then {
            left = without l: left from: i to: end
        } else {
            setRun :keep live: left from: i to: end val: true
            i = end
        }
    }
    return left
}

# shrinkPieces -- `text` cut into `pieces`, with every run of the pieces `cand`
# names that the finding does not need removed
shrinkPieces: function {
    r: Reducer.view
    pieces: (List String).view
    cand: (ListVal u64).view
} out String is {
    keep: ListVal bool
    for keep.length < pieces.length loop keep.append true
    shrink :r :pieces :cand :keep
    return (joinKept :pieces :keep)
}

# shrinkLines -- `text` with every run of lines the finding does not need
# removed
shrinkLines: function {r: Reducer.view text: String.view} out String is {
    lines: List String
    ids: ListVal u64
    for each ln: text.stringView.lines loop {
        ids.append lines.length
        lines.append "\{ln}\n"
    }
    return (shrinkPieces :r pieces: lines cand: ids)
}

# reduce -- shrink the finding `--reduce` names while it shows the same defect
# (reduceKey): runs of its lines first, then runs of its tokens, then the lines
# again. What is left goes to `--out`.
reduce: function {p: cli.Parsed.view} is {
    file: optionOr :p name: "--reduce" d: ""
    dest: optionOr :p name: "--out" d: ""
    if dest.length == 0 then {
        io.eprintln "zfuzz: --reduce needs --out FILE"
        os.exit code: 2
    }
    work: pathOption :p name: "--work"
    dir: "\{work}/reduce"
    io.mkdirp path: dir
    r: (
        Reducer
        zc: (pathOption :p name: "--zc")
        system: (pathOption :p name: "--system")
        roots: (corpusDirs :p)
        dir: dir.copy
        name: savedName.string
        timeout: (timeoutOf :p)
        want: String
    )
    text: slurp path: file.stringView
    b: (
        buildOnce
        zc: r.zc.stringView
        system: r.system.stringView
        roots: r.roots
        dir: r.dir.stringView
        name: r.name.stringView
        text: text.stringView
        timeout: r.timeout
    )
    v: verdict status: b.status errText: b.err.stringView
    if v.length == 0 then {
        print "zfuzz: \{file} shows no finding"
        os.exit code: 1
    }
    r.want = reduceKey v: v.stringView
    text = shrinkLines :r :text
    toks: Tokens.create text: text.copy
    pieces: List String
    i: u64
    for i < toks.count loop {
        pieces.append (toks.piece :i).string
        i = i + 1
    }
    text = shrinkPieces :r :pieces cand: toks.words
    # the lines the token pass emptied
    text = shrinkLines :r :text
    io.writeText path: dest content: text
    n: u64
    for each ln: text.stringView.lines loop {
        # a line counted; its text is not needed
        ln.drop
        n = n + 1
    }
    print "zfuzz: \{v} -- \{n} lines -> \{dest}"
}

# ---------------- --generate ----------------

# GenWorker -- the task of one thread of a generate run: every case whose
# number is `lane` modulo `lanes`, each judged in the thread's own folder
GenWorker: class {
    j: judge.Judge
    # where findings and the lanes' folders go
    work: String
    seed: u64
    count: u64
    lane: u64
    lanes: u64
} as {
    task: (thread.Task Report).implement

    call: function {w: this} out Report is {
        rep: Report cases: 0 built: 0 findings: List String shown: List String
        dir: "\{w.work}/lane\{w.lane}"
        io.mkdirp path: dir
        k: w.lane
        for k < w.count loop {
            w.genCase dir: dir.stringView :k :rep
            k = k + w.lanes
        }
        return rep
    }

    # genCase -- case `k`: generate, judge, and record a finding with the program
    genCase: function {w: this.view dir: StringView k: u64 rep: Report} is {
        g: gen.generate s: (caseSeed seed: w.seed :k)
        name: "gz\{k}"
        text: printer.programText p: g.gen.p seed: w.seed index: k
        exitCode: i32
        if g.run.panicked then exitCode = 1
        want: (
            judge.Expect
            stdout: (printer.expectedOutput r: g.run)
            exit: exitCode
            err: "zpanic: \{g.run.msg}"
        )
        v: judge.pass
        if g.run.over then {
            v = judge.finding kind: "generator: step limit" config: "model" detail: ""
        } else {
            v = judge.judgeProgram j: w.j :dir name: name.stringView text: text.stringView :want
        }
        rep.cases = rep.cases + 1
        if v.kind.length == 0 then {
            rep.built = rep.built + 1
            return
        }
        sig: signatureOf :v :g
        keep: "\{w.work}/findings"
        io.writeText path: "\{keep}/\{name}.z" content: text
        report: sig.copy
        report.append "\n"
        report.append v.detail
        report.append "\n--- expected output, exit \{exitCode}\n"
        report.append want.stdout
        io.writeText path: "\{keep}/\{name}.err" content: report
        rep.findings.append sig.take
        rep.shown.append name.take
    }
}

# caseSeed -- the generator's seed for case `k` of the run seeded `seed`
caseSeed: function {seed: u64 k: u64} out u64 is {
    return (seed * 0x2545F4914F6CDD1D) ^ (k + 1 * 0x9E3779B97F4A7C15)
}

# signatureOf -- the signature of finding `v` of the generated program `g`:
# a mismatch names the print statement's form, its type and its top operator,
# so two programs that differ the same way read alike
signatureOf: function {v: judge.Verdict.view g: gen.Generated.view} out String is {
    if v.label == 0 then return "\{v.kind} \{v.config}: \{normalise line: v.detail.stringView}"
    e: g.gen.p.exprAt id: (g.gen.p.stmtAt id: v.label).e
    form: "print"
    if v.label.u64 < g.gen.formOf.length then {
        f: g.gen.formOf.get i: v.label.u64
        if f == 1 then form = "fold-unit"
        if f == 2 then form = "fold-body"
        if f == 3 then form = "fold-run"
    }
    top: "value".string
    if e.kind == prog.ek.bin then top = (prog.ops.get i: e.op.u64).text.string
    if e.kind == prog.ek.conv then top = "conversion".string
    if e.kind == prog.ek.call then top = "call".string
    return "\{v.kind} \{v.config}: \{form} \{prog.tyName t: e.ty} \{top}"
}

# generateRun -- the generate run the command line `p` asks for
generateRun: function {p: cli.Parsed.view} is {
    os.setEnv key: "DEBUGINFOD_URLS" value: ""
    seed: numberOption :p name: "--seed" d: 1
    count: numberOption :p name: "--count" d: 1000
    jobs: jobsOf :p
    work: pathOption :p name: "--work"
    io.mkdirp path: "\{work}/findings"
    handles: List (thread.JoinHandle Report)
    lane: u64
    for lane < jobs loop {
        handles.append (
            thread.spawn
            task: (
                GenWorker
                j: (judgeOf :p)
                work: work.copy
                :seed
                :count
                :lane
                lanes: jobs
            )
        )
        lane = lane + 1
    }
    cases: u64
    passed: u64
    kinds: List String
    shown: List String
    total: u64
    for handles.length > 0 loop {
        h: handles.pop
        rep: h.join
        cases = cases + rep.cases
        passed = passed + rep.built
        fi: u64
        for fi < rep.findings.length loop {
            total = total + 1
            sig: rep.findings.get i: fi
            if (kinds.contains item: sig).not then {
                kinds.append sig.copy
                shown.append (rep.shown.get i: fi).copy
            }
            fi = fi + 1
        }
    }
    print "zfuzz generate: seed \{seed}, \{cases} programs, \{passed} passed, \{total} findings (\{kinds.length} distinct)"
    report :p :kinds :shown :seed :count :total header: genKnownHeader
}

# judgeOf -- the judge the command line `p` describes
judgeOf: function {p: cli.Parsed.view} out judge.Judge is {
    return (
        judge.Judge
        zc: (pathOption :p name: "--zc")
        system: (pathOption :p name: "--system")
        tcc: (pathOption :p name: "--tcc")
        tccLib: (pathOption :p name: "--tcc-lib")
        timeout: (timeoutOf :p)
        configCount: (numberOption :p name: "--configs" d: judge.configs.length)
        zl: (pathOption :p name: "--zl")
    )
}
