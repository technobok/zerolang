    d.append "    get: function {t: this.view} out v\n"
    d.append "    getd: function {t: this.view d: v} out v\n"
    d.append "    +: function {t: this.view o: v} out v\n"
    d.append "}\n"
    d.append "GC: class { n: i64  s: String } as {\n"
    d.append "    g: (Getter v: i64)\n"
    d.append "    get: function {c: this.view} out i64 is { return c.n }\n"
    d.append "    getd: function {c: this.view d: i64} out i64 is { return c.n + d }\n"
    d.append "    +: function {c: this.view o: i64} out i64 is { return c.n + o }\n"
    d.append "}\n"
    d.append "readF: function {v: (Getter v: i64).view} out i64 is { return v.get }\n"
    return (Family
        name: "gprotocol".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "(Getter v: i64)".string
        make: "((Getter v: i64).create from: (GC n: @V s: \"q\".string))".string
        read: "(readF v: @X)".string
        meth: "@X.get".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "(Getter v: i64)".string
        arm: "".string
        tags: " ref interface generic ".string
        isRef: true
        unsignedRead: false
    )
}

