        make: "(tp (pt x: @V))".string
        read: "(readF v: @X)".string
        meth: "@X.getn".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "tp".string
        arm: "".string
        tags: " val typedef ".string
        isRef: false
