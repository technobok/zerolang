        meth: "(if @X.length == 1 then @V else 0)".string
        methArg: "(if (@X.has item: \"@S\".string) then @V else 0)".string
        op: "".string
        shown: "(SetRef K: String)".string
        arm: "".string
        tags: " ref native ".string
        isRef: true
        unsignedRead: true
    )
}

