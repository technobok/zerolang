# famTclass -- the `tclass` family: TC
famTclass: function out Family is {
    d: String
    d.append "Cell: class { n: i64  s: String } as {\n"
    d.append "    getn: function {c: this.view} out i64 is { return c.n }\n"
    d.append "    +: function {c: this.view o: i64} out i64 is { return c.n + o }\n"
    d.append "}\n"
    d.append "TC: typedef Cell\n"
    d.append "readF: function {v: TC.view} out i64 is { return v.n }\n"
    return (Family
        name: "tclass".string
        decls: d
        confType: "Cell".string
        confParam: "c".string
        confBody: "return c.n".string
        ty: "TC".string
        make: "(TC (Cell n: @V s: \"t\".string))".string
        read: "(readF v: @X)".string
        meth: "@X.getn".string
        op: "(@X + 0)".string
        shown: "TC".string
        tags: " ref typedef ".string
        isRef: true
        unsignedRead: false
    )
}

# famTrecord -- the `trecord` family: tp
famTrecord: function out Family is {
    d: String
    d.append "pt: record { x: i64 } as {\n"
    d.append "    getn: function {c: this.view} out i64 is { return c.x }\n"
    d.append "    +: function {c: this.view o: i64} out i64 is { return c.x + o }\n"
    d.append "}\n"
    d.append "tp: typedef pt\n"
    d.append "readF: function {v: tp.view} out i64 is { return v.x }\n"
    return (Family
        name: "trecord".string
        decls: d
        confType: "pt".string
        confParam: "c".string
        confBody: "return c.x".string
        ty: "tp".string
        make: "(tp (pt x: @V))".string
        read: "(readF v: @X)".string
        meth: "@X.getn".string
        op: "(@X + 0)".string
        shown: "tp".string
        tags: " val typedef ".string
        isRef: false
        unsignedRead: false
    )
}

# families -- every family the matrix crosses, in grid order
families: function out List Family is {
    fams: List Family
    fams.append famClass
    fams.append famRecord
    fams.append famUnion
    fams.append famVariant
    fams.append famGclass
    fams.append famGrecord
    fams.append famGunion
    fams.append famGvariant
    fams.append famProtocol
    fams.append famFacet
    fams.append famGprotocol
    fams.append famGfacet
    fams.append famString
    fams.append famList
    fams.append famMap
    fams.append famOption
    fams.append famResult
    fams.append famTclass
    fams.append famTrecord
    return fams
}

# positions -- every position a family's value stands in, in grid order
positions: function out List Position is {
    ps: List Position
    bindingPositions :ps
    reassignPositions :ps
    fieldPositions :ps
    parameterPositions :ps
    returnPositions :ps
    containerPositions :ps
    receiverPositions :ps
    narrowingPositions :ps
    projectionPositions :ps
    conformancePositions :ps
    return ps
}

# bindingPositions -- a value bound, moved, reassigned and borrowed in a local
bindingPositions: function {ps: List Position} is {
    (addPos
        :ps
        name: "local"
        decls: ""
        body: "x: @MK[11]\n    return @RD[x]"
        expect: 11
        needsConf: false
    )
    (addPos
        :ps
        name: "move"
        decls: ""
        body: "a: @MK[12]\n    b: a\n    return @RD[b]"
        expect: 12
        needsConf: false
    )
    (addPos
        :ps
        name: "reassign"
        decls: ""
        body: "x: @MK[1]\n    x = @MK[13]\n    return @RD[x]"
        expect: 13
        needsConf: false
    )
    (addPos
        :ps
        name: "move_then_read"
        decls: ""
        body: "a: @MK[59]\n    b: a\n    if @RD[b] == 0 then return 0\n    return @RD[a]"
        expect: 59
        needsConf: false
    )
    (addPos
        :ps
        name: "borrow_then_read"
        decls: ""
        body: "x: @MK[31]\n    b: x.borrow\n    return @RD[b]"
        expect: 31
        needsConf: false
    )
    (addPos
        :ps
        name: "borrow_then_write"
        decls: ""
        body: "x: @MK[29]\n    b: x.borrow\n    x = @MK[1]\n    return @RD[b]"
        expect: 29
        needsConf: false
    )
    (addPos
        :ps
        name: "borrow_after"
        decls: ""
        body: "x: @MK[1]\n    {\n        b: x.borrow\n        if @RD[b] == 0 then return 0\n    }\n    x = @MK[32]\n    return @RD[x]"
        expect: 32
        needsConf: false
    )
}

# reassignPositions -- a reassignment keeps the mode the name was bound with: a
# borrow re-points (at a place, releasing the old source; at an owned value,
# through its companion), an owned local takes an owned value and is refilled
# after a move, and a bare name into an owned target is a borrow it refuses
reassignPositions: function {ps: List Position} is {
    (addPos
        :ps
        name: "repoint"
        decls: ""
        body: "a: @MK[1]\n    c: @MK[74]\n    b: a\n    b = c\n    return @RD[b]"
        expect: 74
        needsConf: false
    )
    (addPos
        :ps
        name: "repoint_release"
        decls: ""
        body: "a: @MK[1]\n    c: @MK[75]\n    b: a\n    b = c\n    a = @MK[2]\n    return @RD[b]"
        expect: 75
        needsConf: false
    )
    (addPos
        :ps
        name: "repoint_owned"
        decls: ""
        body: "a: @MK[1]\n    b: a\n    b = @MK[76]\n    return @RD[b]"
        expect: 76
        needsConf: false
    )
    (addPos
        :ps
        name: "repoint_take"
        decls: ""
        body: "a: @MK[1]\n    c: @MK[77]\n    b: a\n    b = c.take\n    return @RD[b]"
        expect: 77
        needsConf: false
    )
    (addPos
        :ps
        name: "reassign_bare"
        decls: ""
        body: "x: @MK[1]\n    d: @MK[78]\n    x = d\n    return @RD[x]"
        expect: 78
        needsConf: false
    )
    (addPos
        :ps
        name: "reassign_take"
        decls: ""
        body: "x: @MK[1]\n    d: @MK[79]\n    x = d.take\n    return @RD[x]"
        expect: 79
        needsConf: false
    )
    (addPos
        :ps
        name: "refill"
        decls: ""
        body: "x: @MK[1]\n    y: x.take\n    x = @MK[80]\n    if @RD[y] == 0 then return 0\n    return @RD[x]"
        expect: 80
        needsConf: false
    )
    (addPos
        :ps
        name: "field_reassign_bare"
        decls: "HolderR: class { f: @T }\n"
        body: "h: HolderR f: @MK[1]\n    d: @MK[81]\n    h.f = d\n    return @RD[h.f]"
        expect: 81
        needsConf: false
    )
}

