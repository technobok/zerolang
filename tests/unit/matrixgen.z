# famString -- the `string` family: String
famString: function out Family is {
    d: String
    d.append "readF: function {v: String.view} out u64 is { return v.length }\n"
    return (Family
        name: "string".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "String".string
        make: "\"@S\".string".string
        read: "(readF v: @X)".string
        meth: "@X.length".string
        methArg: "(if (@X.startsWith prefix: \"s\") then @V else 0)".string
        op: "(if @X == \"@S\".string then @V else 0)".string
        shown: "String".string
        arm: "".string
        tags: " ref native ".string
        isRef: true
        unsignedRead: true
    )
}

# famList -- the `list` family: (ListVal i64)
famList: function out Family is {
    d: String
    d.append "mkL: function {n: i64} out (ListVal i64) is {\n"
    d.append "    xs: ListVal i64\n"
    d.append "    xs.append n\n"
    d.append "    return xs\n"
    d.append "}\n"
    d.append "readF: function {v: (ListVal i64).view} out i64 is {\n"
    d.append "    r: 0\n"
    d.append "    for e: v.iterate loop r = r + e\n"
    d.append "    return r\n"
    d.append "}\n"
    return (Family
        name: "list".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "(ListVal i64)".string
        make: "(mkL n: @V)".string
        read: "(readF v: @X)".string
        meth: "(@X.get i: 0)".string
        methArg: "(@X.get i: 0)".string
        op: "(if @X == (mkL n: @V) then @V else 0)".string
        shown: "(ListVal t: i64)".string
        arm: "".string
        tags: " ref native ".string
        isRef: true
        unsignedRead: false
    )
}

# famMap -- the `map` family: (Map String V: MC)
famMap: function out Family is {
    d: String
    d.append "MC: class { n: i64  s: String }\n"
    d.append "mkM: function {n: i64} out (Map String V: MC) is {\n"
    d.append "    m: Map String V: MC\n"
    d.append "    m.set key: \"k\".string value: (MC :n s: \"m\".string)\n"
    d.append "    return m\n"
    d.append "}\n"
    d.append "readF: function {v: (Map String V: MC).view} out i64 is {\n"
    d.append "    g: v.get key: \"k\".string\n"
    d.append "    match (g) case some then return g.n case none then return 0\n"
    d.append "}\n"
    return (Family
        name: "map".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "(Map String V: MC)".string
        make: "(mkM n: @V)".string
        read: "(readF v: @X)".string
        meth: "(if @X.length == 1 then @V else 0)".string
        methArg: "(if (@X.has key: \"k\".string) then @V else 0)".string
        op: "(if @X == (mkM n: @V) then @V else 0)".string
        shown: "(MapRR K: String V: MC)".string
        arm: "".string
        tags: " ref native ".string
        isRef: true
        unsignedRead: false
    )
}

# famSet -- the `set` family: (Set String)
famSet: function out Family is {
    d: String
    d.append "mkS: function {s: String.take} out (Set String) is {\n"
