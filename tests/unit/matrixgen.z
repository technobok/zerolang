# matrixgen -- the ownership matrix's generator: every type family crossed with
# every position a value of it can stand in, each crossing a CELL whose verdict
# the expectations table tests/fixtures/matrix_expect.txt states. RUN (the
# default) is a value checked by golden and leak-clean under the leak kind;
# REFUSED is the error line an errors fixture pins; NA is a cell that cannot be
# written, with the reason; ASK is a question for the user, emitted nowhere
# until it is answered; KNOWN is a cell that does not yet do what it should,
# named by its defect -- emitted nowhere in the fixtures, so they stay green,
# and written with --cells so the defect's fix can be measured.
#
# Usage: matrixgen [--root DIR] [--cells DIR]
#   --root   the repository the fixtures are written under (default `.`):
#            per family emitc_corpus/matrix_<f>.z (and matrix_<f>_conf.z for the
#            conformance cells), run_golden/matrix_<f>*.out, the matrix_ rows of
#            run_cases.txt, and errors/matrix_<f>_refused.z + .err.
#   --cells  one program per cell into DIR plus DIR/manifest.txt (name family
#            position verdict expected detail) instead, to look at a cell alone.
#
# A family is text: its declarations, and templates for making a value (`@V` the
# number, `@S` that many letters), reading one back (`@X` the value) and calling
# a method or an operator on one. A position is text too, written against the
# family through `@MK[n]` (make n), `@RD[x]` (read x), `@ME[x]` `@MA[x]` and
# `@OP[x]` (a method, a method taking an argument, or an operator on x),
# `@ARM` (the arm a make builds), `@T` (the type), `@RT` (what a read returns),
# `@Z` (its zero), `@LIST` `@MAP` `@OPT` `@RES` (the container of the type's
# ownership family), `@GB` (its generic bound) and `@GP` (a generic parameter
# named in its bound's case).

public: unit {
    :main
}

# Family -- one type family: what declares it and the templates that use it
Family: class {
    name: String
    # every declaration the cells of this family need
    decls: String
    # the declarations its unit `pr` holds, written beside each program as the
    # subunit `pr.z`; empty -- the family is declared where it is used
    unitDecls: String
    # the declared type that conforms to Rd in the conformance cells, the name of
    # its rdn receiver and rdn's body; an empty confType -- it cannot conform
    confType: String
    confParam: String
    confBody: String
    # the type as a position writes it
    ty: String
    make: String
    read: String
    meth: String
    # a method that takes an argument; empty -- the type declares none
    methArg: String
    op: String
    # the type as the compiler's messages name it: the canonical spelling,
    # which differs from `ty` where the source reaches a type through an alias
    # (`Map` for MapRR)
    shown: String
    # the arm the make template builds, which an arm predicate tests; empty --
    # not a sum type
    arm: String
    # the groups a table selector names it by, space-delimited
    tags: String
    isRef: bool
    unsignedRead: bool
}

# Position -- one place a value stands: declarations and a body, both
# templates, and the number the body returns
Position: class {
    name: String
    decls: String
    body: String
    expect: i64
    # the body projects the value onto Rd, so only a conforming family has it
    needsConf: bool
    # a refusal of the cell is raised where its declarations are, before any
    # body is checked, so an errors golden lists it first
    atDecl: bool
    # a refusal of the cell is raised once every body is checked (a stand-in
    # check), so an errors golden lists it last
    atEnd: bool
}

# Row -- one line of the expectations table, its position resolved to an index
Row: class {
    lineno: u64
    selector: String
    pos: u64
    expected: outcome
    detail: String
}

# Slot -- a cell as generated: the family and position by index, the outcome,
# and the table row that set it (-1 -- no row, the default RUN)
Slot: class {
    fam: u64
    pos: u64
    expected: outcome
    row: i64
}

# outcome -- what a cell is expected to do: run (and free all it made), be
# refused, be unwritable, wait on a question, or run once its known defect is
# fixed
outcome: variant { run: null refused: null na: null ask: null known: null }

# fail -- report a generator error and stop
fail: function as { T: StringLike.generic } in {msg: T.view} is {
    io.eprintln "matrixgen: \{msg}"
    os.exit code: 1
}

# writeFile -- write a generated file, stopping on failure
writeFile: function as { T: StringLike.generic } in {path: T.view content: StringView} is {
    w: io.writeText :path :content
    if w.err then fail msg: "cannot write \{path}"
}

# ensureDir -- make a directory and its parents, stopping on failure
ensureDir: function as { T: StringLike.generic } in {path: T.view} is {
    mk: io.mkdirp :path
    if mk.err then fail msg: "cannot create \{path}"
}

# rdDecl -- the protocol every conforming family conforms to
rdDecl: function out String is {
    return "Rd: protocol {\n    rdn: function {t: this.view} out i64\n}\n".string
}

# confDecls -- the family's declarations with `:Rd` and its rdn written into
# the conforming type's `as` block, after Rd itself; empty when it cannot conform
confDecls: function {f: Family.view} out String is {
    buf: String
    if f.confType.length == 0 then return buf
    buf.append rdDecl
    head: "\{f.confType}: "
    done: false
    decls: f.decls.stringView
    with it: decls.lines do for ln: it loop {
        buf.append ln
        buf.append "\n"
        if done.not when (ln.startsWith prefix: head) when (ln.endsWith suffix: " as {") then {
            buf.append "    :Rd\n"
            buf.append "    rdn: function {\{f.confParam}: this.view} out i64 is { \{f.confBody} }\n"
            done = true
        }
    }
    if done.not then fail msg: "family \{f.name}: no `\{f.confType}: ... as {` line to conform"
    return buf
}

# letters -- n copies of `s`, a string whose length is n
letters: function {n: i64} out String is {
    buf: String
    k: 0
    for k < n loop {
        buf.append "s"
        k = k + 1
    }
    return buf
}

# fill -- a make/method/operator template with its number put in
fill: function {tpl: StringView n: i64} out String is {
    s: letters :n
    a: tpl.replace needle: "@S" replacement: s
    return (a.stringView.replace needle: "@V" replacement: "\{n}")
}

# form -- a bracketed template form: make, read, method, method with an
# argument, operator; plain is an `@` that starts none
form: variant { plain: null make: null read: null method: null methodArg: null operator: null }

# formOf -- the form a name before `[` spells
formOf: function {name: StringView} out form is {
    if name == "MK" then return form.make
    if name == "RD" then return form.read
    if name == "ME" then return form.method
    if name == "MA" then return form.methodArg
    if name == "OP" then return form.operator
    return form.plain
}

# bracketed -- one `@NAME[arg]` form expanded for family f in a cell numbered n
bracketed: function {f: Family.view fm: form arg: StringView n: i64} out String is {
    if fm.make then {
        k: arg.parseI64
        if k.err then fail msg: "bad @MK[\{arg}]"
        return (fill tpl: f.make.stringView n: k.orPanic)
    }
    if fm.read then return (f.read.stringView.replace needle: "@X" replacement: arg)
    if fm.method then {
        m: f.meth.stringView.replace needle: "@X" replacement: arg
        return (fill tpl: m.stringView :n)
    }
    if fm.methodArg then {
        m: f.methArg.stringView.replace needle: "@X" replacement: arg
        return (fill tpl: m.stringView :n)
    }
    o: f.op.stringView.replace needle: "@M" replacement: f.make
    o2: o.stringView.replace needle: "@X" replacement: arg
    return (fill tpl: o2.stringView :n)
}

# expandBrackets -- every `@MK[..]` `@RD[..]` `@ME[..]` `@MA[..]` `@OP[..]` in text
expandBrackets: function {f: Family.view text: StringView n: i64} out String is {
    buf: String
    i: u64
    len: text.length
    for i < len loop {
        rest: text.substring from: i to: len
        at: rest.indexOf needle: "@"
        if at.none then {
            buf.append rest
            return buf
        }
        p: at
        buf.append (rest.substring from: 0 to: p)
        tail: rest.substring from: p + 1 to: rest.length
        open: tail.indexOf needle: "["
        close: tail.indexOf needle: "]"
        fm: formOf name: (tail.substring from: 0 to: (open.or d: 0))
        if open.none or close.none or fm.plain then {
            buf.append "@"
            i = i + p + 1
        } else {
            arg: tail.substring from: (open.or d: 0) + 1 to: (close.or d: 0)
            buf.append (bracketed :f :fm :arg :n)
            i = i + p + 2 + (close.or d: 0)
        }
    }
    return buf
}

# expand -- a position template written out for family f in a cell numbered n
expand: function {f: Family.view text: StringView n: i64} out String is {
    brackets: expandBrackets :f :text :n
    withArm: brackets.stringView.replace needle: "@ARM" replacement: f.arm
    ref: f.isRef
    listT: if ref then "List" else "ListVal"
    withList: withArm.stringView.replace needle: "@LIST" replacement: listT
    mapT: if ref then "Map String V: \{f.ty}" else "MapRV String v: \{f.ty}"
    withMap: withList.stringView.replace needle: "@MAP" replacement: mapT
    optT: if ref then "(Option T: \{f.ty})" else "(optionval t: \{f.ty})"
    withOpt: withMap.stringView.replace needle: "@OPT" replacement: optT
    resT: if ref then "(Result T: \{f.ty} E: String)" else "(resultval t: \{f.ty} e: i64)"
    withRes: withOpt.stringView.replace needle: "@RES" replacement: resT
    bound: if ref then "AnyRef" else "anyval"
    withBound: withRes.stringView.replace needle: "@GB" replacement: bound
    # a generic parameter's case matches its bound's (styleguide, L023)
    gparam: if ref then "U" else "u"
    withParam: withBound.stringView.replace needle: "@GP" replacement: gparam
    withRet: withParam.stringView.replace needle: "@RT" replacement: (retType :f)
    zero: if f.unsignedRead then "0.u64" else "0"
    withZero: withRet.stringView.replace needle: "@Z" replacement: zero
    return (withZero.stringView.replace needle: "@T" replacement: f.ty)
}

# retType -- what a read of the family returns
retType: function {f: Family.view} out StringView is {
    if f.unsignedRead then return "u64"
    return "i64"
}

# cellFn -- the function a cell becomes: `at` and the position in camel case
cellFn: function {pos: StringView} out String is {
    buf: "at".string
    with it: (pos.split sep: "_") do for piece: it loop {
        if piece.length > 0 then {
            buf.append (piece.substring from: 0 to: 1).toUpperAscii
            buf.append (piece.substring from: 1 to: piece.length)
        }
    }
    return buf
}

# famClass -- the `class` family: Cell
famClass: function out Family is {
    d: String
    d.append "Cell: class { n: i64  s: String } as {\n"
    d.append "    getn: function {c: this.view} out i64 is { return c.n }\n"
    d.append "    getd: function {c: this.view d: i64} out i64 is { return c.n + d }\n"
    d.append "    +: function {c: this.view o: i64} out i64 is { return c.n + o }\n"
    d.append "    -: function {c: this.view o: Cell} out i64 is { return o.getn }\n"
    d.append "    *: function {c: this.view o: Cell.view} out i64 is { return o.getn }\n"
    d.append "}\n"
    d.append "readF: function {v: Cell.view} out i64 is { return v.n }\n"
    return (Family
        name: "class".string
        decls: d
        unitDecls: "".string
        confType: "Cell".string
        confParam: "c".string
        confBody: "return c.n".string
        ty: "Cell".string
        make: "(Cell n: @V s: \"c\".string)".string
        read: "(readF v: @X)".string
        meth: "@X.getn".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "Cell".string
        arm: "".string
        tags: " ref constructible ".string
        isRef: true
        unsignedRead: false
    )
}

# famRecord -- the `record` family: pt
famRecord: function out Family is {
    d: String
    d.append "pt: record { x: i64 } as {\n"
    d.append "    getn: function {c: this.view} out i64 is { return c.x }\n"
    d.append "    getd: function {c: this.view d: i64} out i64 is { return c.x + d }\n"
    d.append "    +: function {c: this.view o: i64} out i64 is { return c.x + o }\n"
    d.append "    -: function {c: this.view o: pt} out i64 is { return o.getn }\n"
    d.append "    *: function {c: this.view o: pt.view} out i64 is { return o.getn }\n"
    d.append "}\n"
    d.append "readF: function {v: pt.view} out i64 is { return v.x }\n"
    return (Family
        name: "record".string
        decls: d
        unitDecls: "".string
        confType: "pt".string
        confParam: "c".string
        confBody: "return c.x".string
        ty: "pt".string
        make: "(pt x: @V)".string
        read: "(readF v: @X)".string
        meth: "@X.getn".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "pt".string
        arm: "".string
        tags: " val constructible ".string
        isRef: false
        unsignedRead: false
    )
}

# famUnion -- the `union` family: Sh
famUnion: function out Family is {
    d: String
    d.append "Cell: class { n: i64  s: String }\n"
    d.append "Sh: union { c: Cell  e: null } as {\n"
    d.append "    getn: function {u: this.view} out i64 is {\n"
    d.append "        match (u) case c then return u.n case e then return 0\n"
    d.append "    }\n"
    d.append "    getd: function {u: this.view d: i64} out i64 is {\n"
    d.append "        match (u) case c then return u.n + d case e then return d\n"
    d.append "    }\n"
    d.append "    +: function {u: this.view o: i64} out i64 is {\n"
    d.append "        match (u) case c then return u.n + o case e then return o\n"
    d.append "    }\n"
    d.append "    -: function {u: this.view o: Sh} out i64 is { return o.getn }\n"
    d.append "    *: function {u: this.view o: Sh.view} out i64 is { return o.getn }\n"
    d.append "}\n"
    d.append "readF: function {v: Sh.view} out i64 is {\n"
    d.append "    match (v) case c then return v.n case e then return 0\n"
    d.append "}\n"
    return (Family
        name: "union".string
        decls: d
        unitDecls: "".string
        confType: "Sh".string
        confParam: "u".string
        confBody: "match (u) case c then return u.n case e then return 0".string
        ty: "Sh".string
        make: "(Sh.c (Cell n: @V s: \"u\".string))".string
        read: "(readF v: @X)".string
        meth: "@X.getn".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "Sh".string
        arm: "c".string
        tags: " ref sum ".string
        isRef: true
        unsignedRead: false
    )
}

# famVariant -- the `variant` family: kd
famVariant: function out Family is {
    d: String
    d.append "kd: variant { k: i64  z: null } as {\n"
    d.append "    getn: function {u: this.view} out i64 is {\n"
    d.append "        match (u) case k then return u case z then return 0\n"
    d.append "    }\n"
    d.append "    getd: function {u: this.view d: i64} out i64 is {\n"
    d.append "        match (u) case k then return u + d case z then return d\n"
    d.append "    }\n"
    d.append "    +: function {u: this.view o: i64} out i64 is {\n"
    d.append "        match (u) case k then return u + o case z then return o\n"
    d.append "    }\n"
    d.append "    -: function {u: this.view o: kd} out i64 is { return o.getn }\n"
    d.append "    *: function {u: this.view o: kd.view} out i64 is { return o.getn }\n"
    d.append "}\n"
    d.append "readF: function {v: kd.view} out i64 is {\n"
    d.append "    match (v) case k then return v case z then return 0\n"
    d.append "}\n"
    return (Family
        name: "variant".string
        decls: d
        unitDecls: "".string
        confType: "kd".string
        confParam: "u".string
        confBody: "match (u) case k then return u case z then return 0".string
        ty: "kd".string
        make: "(kd.k @V)".string
        read: "(readF v: @X)".string
        meth: "@X.getn".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "kd".string
        arm: "k".string
        tags: " val sum ".string
        isRef: false
        unsignedRead: false
    )
}

# famGclass -- the `gclass` family: (GBox t: i64)
famGclass: function out Family is {
    d: String
    d.append "GBox: class { x: t  s: String } as {\n"
    d.append "    t: anyval.generic\n"
    d.append "    getn: function {c: this.view} out t is { return c.x }\n"
    d.append "    getd: function {c: this.view d: t} out t is { return c.x + d }\n"
    d.append "    +: function {c: this.view o: t} out t is { return c.x + o }\n"
    d.append "    -: function {c: this.view o: type} out t is { return o.getn }\n"
    d.append "    *: function {c: this.view o: type.view} out t is { return o.getn }\n"
    d.append "}\n"
    d.append "readF: function {v: (GBox t: i64).view} out i64 is { return v.x }\n"
    return (Family
        name: "gclass".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "(GBox t: i64)".string
        make: "((GBox t: i64) x: @V s: \"g\".string)".string
        read: "(readF v: @X)".string
        meth: "@X.getn".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "(GBox t: i64)".string
        arm: "".string
        tags: " ref constructible generic ".string
        isRef: true
        unsignedRead: false
    )
}

# famGrecord -- the `grecord` family: (gpt t: i64)
famGrecord: function out Family is {
    d: String
    d.append "gpt: record { x: t } as {\n"
    d.append "    t: anyval.generic\n"
    d.append "    getn: function {c: this.view} out t is { return c.x }\n"
    d.append "    getd: function {c: this.view d: t} out t is { return c.x + d }\n"
    d.append "    +: function {c: this.view o: t} out t is { return c.x + o }\n"
    d.append "    -: function {c: this.view o: type} out t is { return o.getn }\n"
    d.append "    *: function {c: this.view o: type.view} out t is { return o.getn }\n"
    d.append "}\n"
    d.append "readF: function {v: (gpt t: i64).view} out i64 is { return v.x }\n"
    return (Family
        name: "grecord".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "(gpt t: i64)".string
        make: "((gpt t: i64) x: @V)".string
        read: "(readF v: @X)".string
        meth: "@X.getn".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "(gpt t: i64)".string
        arm: "".string
        tags: " val constructible generic ".string
        isRef: false
        unsignedRead: false
    )
}

# famGunion -- the `gunion` family: (GT t: i64)
famGunion: function out Family is {
    d: String
    d.append "GT: union { leaf: t  node: String } as {\n"
    d.append "    t: anyval.generic\n"
    d.append "    getn: function {u: this.view d: t} out t is {\n"
    d.append "        match (u) case leaf then return u case node then return d\n"
    d.append "    }\n"
    d.append "    +: function {u: this.view o: t} out t is {\n"
    d.append "        match (u) case leaf then return u + o case node then return o\n"
    d.append "    }\n"
    d.append "    -: function {u: this.view o: type} out t is { return (o.getn d: 0) }\n"
    d.append "    *: function {u: this.view o: type.view} out t is { return (o.getn d: 0) }\n"
    d.append "}\n"
    d.append "readF: function {v: (GT t: i64).view} out i64 is {\n"
    d.append "    match (v) case leaf then return v case node then return 0\n"
    d.append "}\n"
    return (Family
        name: "gunion".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "(GT t: i64)".string
        make: "((GT t: i64).leaf @V)".string
        read: "(readF v: @X)".string
        meth: "(@X.getn d: 0)".string
        methArg: "(@X.getn d: 0)".string
        op: "(@X + 0)".string
        shown: "(GT t: i64)".string
        arm: "leaf".string
        tags: " ref sum generic ".string
        isRef: true
        unsignedRead: false
    )
}

# famGvariant -- the `gvariant` family: (gv t: i64)
famGvariant: function out Family is {
    d: String
    d.append "gv: variant { k: t  z: null } as {\n"
    d.append "    t: anyval.generic\n"
    d.append "    getn: function {u: this.view d: t} out t is {\n"
    d.append "        match (u) case k then return u case z then return d\n"
    d.append "    }\n"
    d.append "    +: function {u: this.view o: t} out t is {\n"
    d.append "        match (u) case k then return u + o case z then return o\n"
    d.append "    }\n"
    d.append "    -: function {u: this.view o: type} out t is { return (o.getn d: 0) }\n"
    d.append "    *: function {u: this.view o: type.view} out t is { return (o.getn d: 0) }\n"
    d.append "}\n"
    d.append "readF: function {v: (gv t: i64).view} out i64 is {\n"
    d.append "    match (v) case k then return v case z then return 0\n"
    d.append "}\n"
    return (Family
        name: "gvariant".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "(gv t: i64)".string
        make: "((gv t: i64).k @V)".string
        read: "(readF v: @X)".string
        meth: "(@X.getn d: 0)".string
        methArg: "(@X.getn d: 0)".string
        op: "(@X + 0)".string
        shown: "(gv t: i64)".string
        arm: "k".string
        tags: " val sum generic ".string
        isRef: false
        unsignedRead: false
    )
}

# famProtocol -- the `protocol` family: Sp
famProtocol: function out Family is {
    d: String
    d.append "Sp: protocol {\n"
    d.append "    get: function {t: this.view} out i64\n"
    d.append "    getd: function {t: this.view d: i64} out i64\n"
    d.append "    +: function {t: this.view o: i64} out i64\n"
    d.append "}\n"
    d.append "PC: class { n: i64  s: String } as {\n"
    d.append "    :Sp\n"
    d.append "    get: function {c: this.view} out i64 is { return c.n }\n"
    d.append "    getd: function {c: this.view d: i64} out i64 is { return c.n + d }\n"
    d.append "    +: function {c: this.view o: i64} out i64 is { return c.n + o }\n"
    d.append "}\n"
    d.append "readF: function {v: Sp.view} out i64 is { return v.get }\n"
    return (Family
        name: "protocol".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "Sp".string
        make: "(Sp.create from: (PC n: @V s: \"p\".string))".string
        read: "(readF v: @X)".string
        meth: "@X.get".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "Sp".string
        arm: "".string
        tags: " ref interface ".string
        isRef: true
        unsignedRead: false
    )
}

# famFacet -- the `facet` family: sz
famFacet: function out Family is {
    d: String
    d.append "sz: facet {\n"
    d.append "    size: function {t: this.view} out i64\n"
    d.append "    getd: function {t: this.view d: i64} out i64\n"
    d.append "    +: function {t: this.view o: i64} out i64\n"
    d.append "}\n"
    d.append "fp: record { x: i64 } as {\n"
    d.append "    :sz\n"
    d.append "    size: function {p: this.view} out i64 is { return p.x }\n"
    d.append "    getd: function {p: this.view d: i64} out i64 is { return p.x + d }\n"
    d.append "    +: function {p: this.view o: i64} out i64 is { return p.x + o }\n"
    d.append "}\n"
    d.append "readF: function {v: sz.view} out i64 is { return v.size }\n"
    return (Family
        name: "facet".string
        decls: d
        unitDecls: "".string
        confType: "".string
        confParam: "".string
        confBody: "".string
        ty: "sz".string
        make: "(sz.create from: (fp x: @V))".string
        read: "(readF v: @X)".string
        meth: "@X.size".string
        methArg: "(@X.getd d: 0)".string
        op: "(@X + 0)".string
        shown: "sz".string
        arm: "".string
        tags: " val interface ".string
        isRef: false
        unsignedRead: false
    )
}

# famGprotocol -- the `gprotocol` family: (Getter v: i64)
famGprotocol: function out Family is {
    d: String
    d.append "Getter: protocol {\n"
