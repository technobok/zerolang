# reassignPositions -- a reassignment keeps the mode the name was bound with: a
# borrow re-points (at a place, releasing the old source; at an owned value,
# through its companion), an owned local takes an owned value and is refilled
# after a move, and a bare name into an owned target is a borrow it refuses
reassignPositions: function {ps: List Position} is {
    (addPos
        :ps
        name: "repoint"
        decls: ""
        body: "a: @MK[1]\n    c: @MK[74]\n    b: a\n    b = c\n    return @RD[b]"
        expect: 74
        needsConf: false
    )
    (addPos
        :ps
        name: "repoint_release"
        decls: ""
        body: "a: @MK[1]\n    c: @MK[75]\n    b: a\n    b = c\n    a = @MK[2]\n    return @RD[b]"
        expect: 75
        needsConf: false
    )
    (addPos
        :ps
        name: "repoint_owned"
        decls: ""
        body: "a: @MK[1]\n    b: a\n    b = @MK[76]\n    return @RD[b]"
        expect: 76
        needsConf: false
    )
    (addPos
        :ps
        name: "repoint_take"
        decls: ""
        body: "a: @MK[1]\n    c: @MK[77]\n    b: a\n    b = c.take\n    return @RD[b]"
        expect: 77
        needsConf: false
    )
    (addPos
        :ps
        name: "reassign_bare"
        decls: ""
        body: "x: @MK[1]\n    d: @MK[78]\n    x = d\n    return @RD[x]"
        expect: 78
        needsConf: false
    )
    (addPos
        :ps
        name: "reassign_take"
        decls: ""
        body: "x: @MK[1]\n    d: @MK[79]\n    x = d.take\n    return @RD[x]"
        expect: 79
        needsConf: false
    )
    (addPos
        :ps
        name: "refill"
        decls: ""
        body: "x: @MK[1]\n    y: x.take\n    x = @MK[80]\n    if @RD[y] == 0 then return 0\n    return @RD[x]"
        expect: 80
        needsConf: false
    )
    (addPos
        :ps
        name: "field_reassign_bare"
        decls: "HolderR: class { f: @T }\n"
        body: "h: HolderR f: @MK[1]\n    d: @MK[81]\n    h.f = d\n    return @RD[h.f]"
        expect: 81
        needsConf: false
    )
}

