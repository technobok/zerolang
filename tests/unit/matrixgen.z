        :ps
        name: "conf_borrow_write"
        decls: ""
        body: "x: @MK[68]\n    p: Rd x.borrow\n    x = @MK[1]\n    return p.rdn"
        expect: 68
        needsConf: true
    )
}

# standInPositions -- a conformer written where Rd is expected with no projection
# of its own: every slot the checker lets it stand in, each boxing it as `Rd x`
# would -- borrowed where the slot borrows, owned where it owns
standInPositions: function {ps: List Position} is {
    (addPos
        :ps
        name: "conf_fn_arg"
        decls: "useConfFn: function {r: Rd} out i64 is { return r.rdn }\n"
        body: "x: @MK[120]\n    return (useConfFn r: x)"
        expect: 120
        needsConf: true
    )
    (addPos
        :ps
        name: "conf_fn_arg_inline"
        decls: "useConfFnIn: function {r: Rd} out i64 is { return r.rdn }\n"
        body: "return (useConfFnIn r: @MK[121])"
        expect: 121
        needsConf: true
    )
    (addPos
        :ps
        name: "conf_meth_arg"
        decls: "ConfMeth: class { k: i64 } as {\n    useIt: function {:this r: Rd} out i64 is { return r.rdn + this.k }\n}\n"
        body: "u: ConfMeth k: 0\n    x: @MK[122]\n    return (u.useIt r: x)"
        expect: 122
        needsConf: true
    )
    (addPos
        :ps
        name: "conf_meth_arg_qual"
        decls: "ConfMethQ: class { k: i64 } as {\n    useIt: function {u: this.view r: Rd} out i64 is { return r.rdn + u.k }\n}\n"
        body: "u: ConfMethQ k: 0\n    x: @MK[123]\n    return (ConfMethQ.useIt u: u r: x)"
        expect: 123
        needsConf: true
    )
    (addPos
        :ps
        name: "conf_dispatch_arg"
        decls: "ConfPk: protocol {\n    pick: function {t: this.view r: Rd} out i64\n}\nConfPC: class { k: i64 } as {\n    :ConfPk\n    pick: function {p: this.view r: Rd} out i64 is { return r.rdn + p.k }\n}\n"
        body: "p: ConfPk.create from: (ConfPC k: 0)\n    x: @MK[124]\n    return (p.pick r: x)"
        expect: 124
        needsConf: true
    )
    (addPos
        :ps
        name: "conf_operator"
        decls: "ConfAcc: class { k: i64 } as {\n    +: function {a: this.view r: Rd} out i64 is { return a.k + r.rdn }\n}\n"
        body: "a: ConfAcc k: 0\n    x: @MK[125]\n    return (a + x)"
        expect: 125
        needsConf: true
    )
    (addPos
        :ps
        name: "conf_field_borrow"
        decls: "ConfHB: class { r: Rd.borrow }\n"
        body: "x: @MK[126]\n    h: ConfHB r: x\n    return h.r.rdn"
        expect: 126
        needsConf: true
    )
    (addPos
        :ps
        name: "conf_field_owned"
        decls: "ConfHO: class { r: Rd }\n"
        body: "x: @MK[127]\n    h: ConfHO r: x\n    return h.r.rdn"
        expect: 127
        needsConf: true
        atEnd: true
    )
    (addPos
        :ps
        name: "conf_list"
        decls: ""
        body: "xs: List Rd\n    x: @MK[128]\n    xs.append x\n    return (xs.get i: 0).rdn"
        expect: 128
        needsConf: true
        atEnd: true
    )
    (addPos
        :ps
        name: "conf_reassign"
        decls: ""
        body: "p: Rd.create from: @MK[1]\n    x: @MK[129]\n    p = x\n    return p.rdn"
        expect: 129
        needsConf: true
    )
    (addPos
        :ps
        name: "conf_param_take"
        decls: "useConfTake: function {r: Rd.take} out i64 is { return r.rdn }\n"
        body: "x: @MK[130]\n    return (useConfTake r: x)"
        expect: 130
        needsConf: true
        atEnd: true
    )
    (addPos
        :ps
        name: "conf_return"
        decls: "mkConfRet: function out Rd is {\n    x: @MK[131]\n    return x\n}\n"
        body: "r: mkConfRet\n    return r.rdn"
        expect: 131
        needsConf: true
        atEnd: true
    )
}

# borrowedFieldPositions -- a value a class holds in a `.borrow` field: stored as
# the family is passed, read back through the holder
borrowedFieldPositions: function {ps: List Position} is {
    (addPos
        :ps
        name: "borrowed_field"
        decls: "HolderBf: class { f: @T.borrow }\n"
        body: "x: @MK[106]\n    h: HolderBf f: x\n    return @RD[h.f]"
        expect: 106
        needsConf: false
        atDecl: true
    )
    (addPos
        :ps
        name: "borrowed_field_method"
        decls: "HolderBm: class { f: @T.borrow }\n"
        body: "x: @MK[107]\n    h: HolderBm f: x\n    return @ME[h.f]"
        expect: 107
        needsConf: false
        atDecl: true
    )
}

# lentPositions -- a value with no name of its own, read where it stands: one a
# list lends (`xs.get`), whose temporary owns nothing, and a field of a call's
# result, whose temporary owns the whole result
lentPositions: function {ps: List Position} is {
    (addPos
        :ps
        name: "lent_read"
        decls: ""
        body: "xs: @LIST @T\n    xs.append @MK[90]\n    return @RD[(xs.get i: 0)]"
        expect: 90
        needsConf: false
    )
    (addPos
        :ps
        name: "lent_method"
        decls: ""
        body: "xs: @LIST @T\n    xs.append @MK[91]\n    return @ME[(xs.get i: 0)]"
        expect: 91
        needsConf: false
    )
    (addPos
        :ps
        name: "lent_method_arg"
        decls: ""
        body: "xs: @LIST @T\n    xs.append @MK[92]\n    return @MA[(xs.get i: 0)]"
        expect: 92
        needsConf: false
    )
    (addPos
        :ps
        name: "lent_operator"
        decls: ""
        body: "xs: @LIST @T\n    xs.append @MK[93]\n    return @OP[(xs.get i: 0)]"
        expect: 93
        needsConf: false
    )
    (addPos
        :ps
        name: "lent_predicate"
        decls: ""
        body: "xs: @LIST @T\n    xs.append @MK[94]\n    return (if (xs.get i: 0).@ARM then 94 else 0)"
        expect: 94
        needsConf: false
    )
    (addPos
        :ps
        name: "lent_param_borrow"
        decls: "useLentBorrow: function {p: @T.borrow} out @RT is { return @RD[p] }\n"
        body: "xs: @LIST @T\n    xs.append @MK[95]\n    return (useLentBorrow p: (xs.get i: 0))"
        expect: 95
        needsConf: false
    )
    (addPos
        :ps
        name: "lent_param_view"
        decls: "useLentView: function {p: @T.view} out @RT is { return @RD[p] }\n"
        body: "xs: @LIST @T\n    xs.append @MK[96]\n    return (useLentView p: (xs.get i: 0))"
        expect: 96
        needsConf: false
    )
    (addPos
        :ps
        name: "field_rvalue_read"
        decls: "RvHolder: class { f: @T }\nmkRvHolder: function {n: i64} out RvHolder is { return (RvHolder f: @MK[97]) }\n"
        body: "return @RD[(mkRvHolder n: 0).f]"
        expect: 97
        needsConf: false
    )
    (addPos
        :ps
        name: "field_rvalue_method"
        decls: "RvHolderM: class { f: @T }\nmkRvHolderM: function {n: i64} out RvHolderM is { return (RvHolderM f: @MK[98]) }\n"
        body: "return @ME[(mkRvHolderM n: 0).f]"
        expect: 98
        needsConf: false
    )
    (addPos
        :ps
        name: "field_rvalue_method_arg"
        decls: "RvHolderA: class { f: @T }\nmkRvHolderA: function {n: i64} out RvHolderA is { return (RvHolderA f: @MK[99]) }\n"
        body: "return @MA[(mkRvHolderA n: 0).f]"
        expect: 99
        needsConf: false
    )
}

# operandPositions -- a value as a declared operator's RIGHT operand, a parameter
# unmarked (`-`) and marked `.view` (`*`): named, a call's result, built inline
# and borrowed out of a list. Each operator answers what its operand reads.
operandPositions: function {ps: List Position} is {
    (addPos
        :ps
        name: "operand_lvalue"
        decls: ""
        body: "x: @MK[140]\n    return (@MK[1] - x)"
        expect: 140
        needsConf: false
    )
    (addPos
        :ps
        name: "operand_rvalue"
        decls: "mkOperand: function out @T is { return @MK[141] }\n"
        body: "return (@MK[1] - (mkOperand))"
        expect: 141
        needsConf: false
    )
    (addPos
        :ps
        name: "operand_inline"
        decls: ""
        body: "return (@MK[1] - @MK[142])"
        expect: 142
        needsConf: false
    )
    (addPos
        :ps
        name: "operand_lent"
        decls: ""
        body: "xs: @LIST @T\n    xs.append @MK[143]\n    return (@MK[1] - (xs.get i: 0))"
        expect: 143
        needsConf: false
    )
    (addPos
        :ps
        name: "operand_view_lvalue"
        decls: ""
        body: "x: @MK[146]\n    return (@MK[1] * x)"
        expect: 146
        needsConf: false
    )
    (addPos
        :ps
        name: "operand_view_rvalue"
        decls: "mkOperandView: function out @T is { return @MK[147] }\n"
        body: "return (@MK[1] * (mkOperandView))"
        expect: 147
        needsConf: false
    )
    (addPos
        :ps
        name: "operand_view_inline"
        decls: ""
        body: "return (@MK[1] * @MK[148])"
        expect: 148
        needsConf: false
    )
    (addPos
        :ps
        name: "operand_view_lent"
        decls: ""
        body: "xs: @LIST @T\n    xs.append @MK[149]\n    return (@MK[1] * (xs.get i: 0))"
        expect: 149
        needsConf: false
    )
}

# hoistArgPositions -- a value with no name handed to a method's parameter, and
# one a projection or a conformance takes inside an arm that returns
hoistArgPositions: function {ps: List Position} is {
    (addPos
        :ps
        name: "method_param_inline"
        decls: "MethIn: class { k: i64 } as {\n    useIt: function {:this p: @T} out @RT is { return @RD[p] }\n}\n"
        body: "u: MethIn k: 0\n    return (u.useIt p: @MK[100])"
        expect: 100
        needsConf: false
    )
    (addPos
        :ps
        name: "method_param_view_inline"
        decls: "MethView: class { k: i64 } as {\n    useIt: function {:this p: @T.view} out @RT is { return @RD[p] }\n}\n"
        body: "u: MethView k: 0\n    return (u.useIt p: @MK[101])"
        expect: 101
        needsConf: false
    )
    (addPos
        :ps
        name: "method_param_take_inline"
        decls: "MethTake: class { k: i64 } as {\n    useIt: function {:this p: @T.take} out @RT is { return @RD[p] }\n}\n"
        body: "u: MethTake k: 0\n    return (u.useIt p: @MK[102])"
        expect: 102
        needsConf: false
    )
    (addPos
        :ps
        name: "method_param_lent"
        decls: "MethLent: class { k: i64 } as {\n    useIt: function {:this p: @T} out @RT is { return @RD[p] }\n}\n"
        body: "u: MethLent k: 0\n    xs: @LIST @T\n    xs.append @MK[103]\n    return (u.useIt p: (xs.get i: 0))"
        expect: 103
        needsConf: false
    )
    (addPos
        :ps
        name: "proj_create_return_arm"
        decls: "PjArm: typedef @T\nmkPjArm: function {k: i64} out PjArm is {\n    if k > 0 then return (PjArm.create from: @MK[104])\n    return (PjArm.create from: @MK[1])\n}\n"
        body: "p: mkPjArm k: 1\n    return @RD[p]"
        expect: 104
        needsConf: false
    )
    (addPos
        :ps
        name: "conf_create_return_arm"
        decls: "mkConfArm: function {k: i64} out Rd is {\n    if k > 0 then return (Rd.create from: @MK[105])\n    return (Rd.create from: @MK[1])\n}\n"
        body: "c: mkConfArm k: 1\n    return c.rdn"
        expect: 105
        needsConf: true
    )
}

# addPos -- one position appended to the list
addPos: function {
    ps: List Position
    name: StringView
    decls: StringView
    body: StringView
    expect: i64
    needsConf: bool
    atDecl: false
    atEnd: false
} is {
    ps.append (Position
        name: name.string
        decls: decls.string
        body: body.string
        :expect
        :needsConf
        :atDecl
        :atEnd
    )
}

# words -- the first three space-separated words of a table line, then the rest
# of the line trimmed; fewer pieces when the line has fewer words
words: function {line: StringView} out List String is {
    buf: List String
    t: line.trim
    from: u64
    for buf.length < 3 loop {
        rest: (t.substring :from to: t.length).trimStart
        if rest.length == 0 then return buf
        from = t.length - rest.length
        sp: rest.indexOf needle: " "
        if sp.none then {
            buf.append rest.string
            return buf
        }
        buf.append (rest.substring from: 0 to: sp).string
        from = from + sp
    }
    last: (t.substring :from to: t.length).trim
    if last.length > 0 then buf.append last.string
    return buf
}

# slurp -- a file's text, stopping when it cannot be read
slurp: function {path: StringView} out String is {
    r: io.readText :path
    match (
        r
    ) case ok then {
        return r.copy
    } case err then {
        fail msg: "cannot read \{path}"
        return "".string
    }
}

# outcomeOf -- the outcome a verdict word names, stopping on any other word
outcomeOf: function {w: StringView where: String.view} out outcome is {
    if w == "RUN" then return outcome.run
    if w == "REFUSED" then return outcome.refused
    if w == "NA" then return outcome.na
    if w == "ASK" then return outcome.ask
    if w == "KNOWN" then return outcome.known
    fail msg: "\{where}: unknown verdict '\{w}'"
    return outcome.run
}

# outcomeWord -- the verdict word an outcome is written as
outcomeWord: function {o: outcome} out StringView is {
    match (
        o
    ) case run then return "RUN" case refused then return "REFUSED" case na then return "NA" case ask then return "ASK" case known then return "KNOWN"
}

# isCode -- an error code as a REFUSED row starts its detail: `E` and 4 digits
isCode: function {w: StringView} out bool is {
    if w.length != 5 then return false
    if (w.startsWith prefix: "E").not then return false
    tail: w.substring from: 1 to: 5
    n: tail.parseU64
    return n.ok
}

# selects -- whether a row's selector names the family: `*`, `@<tag>`, or its name
selects: function {sel: StringView f: Family.view} out bool is {
    if sel == "*" then return true
    if (sel.startsWith prefix: "@") then {
        tag: " \{sel.substring from: 1 to: sel.length} "
        return (f.tags.contains tag)
    }
    return sel == f.name
}

# knownSelector -- a selector that names at least one family
knownSelector: function {sel: StringView fams: (List Family).view} out bool is {
    for f: fams.iterate loop {
        if (selects :sel :f) then return true
    }
    return false
}

# positionIndex -- where the named position sits in poss, stopping when it is none
positionIndex: function {
    name: StringView poss: (List Position).view where: String.view
} out u64 is {
    pi: u64
    for pi < poss.length loop {
        p: poss.get i: pi
        if p.name == name then return pi
        pi = pi + 1
    }
    fail msg: "\{where}: unknown position '\{name}'"
    return 0
}

# checkDetail -- a REFUSED row's detail is a code and a message; an NA or ASK
# row's is its reason
checkDetail: function {where: String.view expected: outcome detail: StringView} is {
    if expected.refused then {
        sp: detail.indexOf needle: " "
        code: detail.substring from: 0 to: (sp.or d: detail.length)
        if sp.none or (isCode w: code).not then fail msg: "\{where}: REFUSED wants `Ennnn message`"
    }
    if expected.na or expected.ask or expected.known when detail.length == 0 then (fail
        msg: "\{where}: \{outcomeWord o: expected} needs a reason"
    )
}

# parseRow -- one table line as a row, each part checked
parseRow: function {
    line: StringView
    where: String.view
    lineno: u64
    fams: (List Family).view
    poss: (List Position).view
} out Row is {
    ws: words :line
    if ws.length < 3 then fail msg: "\{where}: want `selector position verdict [detail]`"
    sel: ws.get i: 0
    if (knownSelector sel: sel.stringView :fams).not then (fail
        msg: "\{where}: unknown selector '\{sel}'"
    )
    pos: ws.get i: 1
    pi: positionIndex name: pos.stringView :poss :where
    expected: outcomeOf w: (ws.get i: 2).stringView :where
    detail: if ws.length > 3 then (ws.get i: 3).copy else "".string
    checkDetail :where :expected detail: detail.stringView
    return (Row :lineno selector: sel.copy pos: pi :expected :detail)
}

# readTable -- the expectations table's rows
readTable: function {
    path: StringView fams: (List Family).view poss: (List Position).view
} out List Row is {
    rows: List Row
    content: slurp :path
    lineno: u64
    with it: content.stringView.lines do for ln: it loop {
        lineno = lineno + 1
        t: ln.trim
        if t.length > 0 when (t.startsWith prefix: "#").not then {
            where: "\{path}:\{lineno}"
            rows.append (parseRow line: t :where :lineno :fams :poss)
        }
    }
    return rows
}

# slotFor -- the cell of family fi at position pi: the LAST row selecting it
# wins; a position the family cannot have must be NA there
slotFor: function {
    fams: (List Family).view
    poss: (List Position).view
    rows: (List Row).view
    used: ListVal bool
    fi: u64
    pi: u64
} out Slot is {
    f: fams.get i: fi
    p: poss.get i: pi
    row: -1
    expected: outcome.run
    ri: u64
    for ri < rows.length loop {
        r: rows.get i: ri
        if r.pos == pi when (selects sel: r.selector.stringView :f) then {
            row = ri.i64.orPanic
            expected = r.expected
            used.set i: ri val: true
        }
        ri = ri + 1
    }
    if p.needsConf when f.confType.length == 0 when expected.na.not then {
        fail msg: "\{f.name}/\{p.name}: the family cannot conform to Rd; the table must say NA"
    }
    return (Slot fam: fi pos: pi :expected :row)
}

# allSlots -- every cell, families outer and positions inner; a row that selects
# no cell is an error
allSlots: function {
    fams: (List Family).view
    poss: (List Position).view
    rows: (List Row).view
    tablePath: StringView
} out List Slot is {
    used: ListVal bool
    for used.length < rows.length loop used.append false
    buf: List Slot
    fi: u64
    for fi < fams.length loop {
        pi: u64
        for pi < poss.length loop {
            buf.append (slotFor :fams :poss :rows :used :fi :pi)
            pi = pi + 1
        }
        fi = fi + 1
    }
    ri: u64
    for ri < rows.length loop {
        if (used.get i: ri).not then {
            r: rows.get i: ri
            fail msg: "\{tablePath}:\{r.lineno}: the row selects no cell"
        }
        ri = ri + 1
    }
    return buf
}

# rowDetail -- the detail of the row that set a slot, with `@N` the type as
# the compiler names it
rowDetail: function {s: Slot.view rows: (List Row).view f: Family.view} out String is {
    if s.row < 0 then return "".string
    r: rows.get i: s.row.u64.orPanic
    return (r.detail.stringView.replace needle: "@N" replacement: f.shown)
}

# errLine -- a REFUSED detail `Ennnn message` as the compiler prints it
errLine: function {detail: StringView} out String is {
    sp: (detail.indexOf needle: " ").or d: 0
    code: detail.substring from: 0 to: sp
    msg: detail.substring from: sp + 1 to: detail.length
    return "error[\{code}]: \{msg}\n"
}

# header -- the first lines of every generated program
header: function {f: Family.view what: StringView} out String is {
    buf: "# GENERATED by tests/unit/matrixgen.z from tests/fixtures/matrix_expect.txt --\n".string
    buf.append "# `make regen-matrix`; do not edit. The `\{f.name}` family (\{f.ty}) in every\n"
    buf.append "# position whose cell is \{what}: one function per cell, called from main.\n"
    return buf
}

# cellBody -- a cell as a function returning its read
cellBody: function {f: Family.view p: Position.view name: StringView} out String is {
    body: expand :f text: p.body.stringView n: p.expect
    return "\{name}: function out \{retType :f} is {\n    \{body}\n}\n"
}

# program -- a program of the given cells: declarations, one function per cell,
# and a main printing each cell's position and value
program: function {
    f: Family.view
    poss: (List Position).view
    slots: (List Slot).view
    decls: StringView
    what: StringView
} out String is {
    buf: header :f :what
    buf.append decls
    fns: String
    calls: String
    for s: slots.iterate loop {
        p: poss.get i: s.pos
        buf.append (expand :f text: p.decls.stringView n: p.expect)
        fname: cellFn pos: p.name.stringView
        fns.append (cellBody :f :p name: fname.stringView)
        calls.append "    print \"\{p.name} \\{\{fname}}\"\n"
    }
    buf.append fns
    buf.append "main: function is {\n"
    buf.append calls
    buf.append "}\n"
    return buf
}

# golden -- what a RUN program prints
golden: function {poss: (List Position).view slots: (List Slot).view} out String is {
    buf: String
    for s: slots.iterate loop {
        p: poss.get i: s.pos
        buf.append "\{p.name} \{p.expect}\n"
    }
    return buf
}

# errGolden -- the error lines a REFUSED program reports: the cells refused where
# they are declared first, then the rest, then those refused once every body is
# checked, each in cell order
errGolden: function {
    f: Family.view
    poss: (List Position).view
    rows: (List Row).view
    slots: (List Slot).view
} out String is {
    buf: String
    # a declaration's refusal is reported before any body's, a stand-in's after
    for s: slots.iterate loop {
        if (poss.get i: s.pos).atDecl then buf.append (errLine
            detail: (rowDetail :s :rows :f).stringView
        )
    }
    for s: slots.iterate loop {
        p: poss.get i: s.pos
        if p.atDecl.not when p.atEnd.not then buf.append (errLine
            detail: (rowDetail :s :rows :f).stringView
        )
    }
    for s: slots.iterate loop {
        if (poss.get i: s.pos).atEnd then buf.append (errLine
            detail: (rowDetail :s :rows :f).stringView
        )
    }
    if slots.length == 1 then {
        buf.append "1 error found\n"
    } else buf.append "\{slots.length} errors found\n"
    return buf
}

# pick -- the family's slots with the given outcome, its conformance cells or
# its others
pick: function {
    slots: (List Slot).view
    poss: (List Position).view
    fi: u64
    expected: outcome
    conf: bool
} out List Slot is {
    buf: List Slot
    for s: slots.iterate loop {
        p: poss.get i: s.pos
        if s.fam == fi when s.expected == expected when p.needsConf == conf then {
            buf.append (Slot fam: s.fam pos: s.pos expected: s.expected row: s.row)
        }
    }
    return buf
}

# writeRun -- one RUN program and its golden; its run_cases row appended to cases
writeRun: function {
    root: StringView
    f: Family.view
    poss: (List Position).view
    slots: (List Slot).view
    decls: StringView
    stem: StringView
    cases: String
} is {
    if slots.length == 0 then return
    prog: program :f :poss :slots :decls what: "RUN"
    writeFile path: "\{root}/tests/fixtures/emitc_corpus/\{stem}.z" content: prog.stringView
    writeUnit :f dir: "\{root}/tests/fixtures/emitc_corpus" :stem
    gold: golden :poss :slots
    writeFile path: "\{root}/tests/fixtures/run_golden/\{stem}.out" content: gold.stringView
    cases.append "\{stem} tests/fixtures/emitc_corpus\n"
}

# writeRefused -- the family's REFUSED program and its .err: the conformance
# declarations when the family has them, so every refused cell fits one program
writeRefused: function {
    root: StringView
    f: Family.view
    poss: (List Position).view
    rows: (List Row).view
    slots: (List Slot).view
} is {
    if slots.length == 0 then return
    cd: confDecls :f
    decls: if cd.length > 0 then cd.copy else f.decls.copy
    prog: program :f :poss :slots decls: decls.stringView what: "REFUSED"
    stem: "matrix_\{f.name}_refused"
    writeFile path: "\{root}/tests/fixtures/errors/\{stem}.z" content: prog.stringView
    writeUnit :f dir: "\{root}/tests/fixtures/errors" stem: stem.stringView
    err: errGolden :f :poss :rows :slots
    writeFile path: "\{root}/tests/fixtures/errors/\{stem}.err" content: err.stringView
}

# writeFamily -- one family's RUN programs (its conformance cells apart, so a
# conformance defect cannot hide the rest) and its REFUSED program
writeFamily: function {
    root: StringView
    fams: (List Family).view
    poss: (List Position).view
    rows: (List Row).view
    slots: (List Slot).view
    fi: u64
    cases: String
} is {
    f: fams.get i: fi
    stem: "matrix_\{f.name}"
    run: pick :slots :poss :fi expected: outcome.run conf: false
    writeRun :root :f :poss slots: run decls: f.decls.stringView stem: stem.stringView :cases
    confRun: pick :slots :poss :fi expected: outcome.run conf: true
    cd: confDecls :f
    confStem: "matrix_\{f.name}_conf"
    writeRun :root :f :poss slots: confRun decls: cd.stringView stem: confStem.stringView :cases
    refused: pick :slots :poss :fi expected: outcome.refused conf: false
    confRefused: pick :slots :poss :fi expected: outcome.refused conf: true
    for s: confRefused.iterate loop refused.append (Slot
        fam: s.fam
        pos: s.pos
        expected: s.expected
        row: s.row
    )
    writeRefused :root :f :poss :rows slots: refused
}

# writeFixtures -- every family's programs and goldens under root, and the
# matrix_ rows of run_cases.txt replaced by this run's
writeFixtures: function {
    root: StringView
    fams: (List Family).view
    poss: (List Position).view
    rows: (List Row).view
    slots: (List Slot).view
} is {
    ensureDir path: "\{root}/tests/fixtures/emitc_corpus"
    ensureDir path: "\{root}/tests/fixtures/run_golden"
    ensureDir path: "\{root}/tests/fixtures/errors"
    cases: String
    fi: u64
    for fi < fams.length loop {
        writeFamily :root :fams :poss :rows :slots :fi :cases
        fi = fi + 1
    }
    writeCases :root :cases
}

# writeCases -- run_cases.txt with its matrix_ rows replaced by cases
writeCases: function {root: StringView cases: String.view} is {
    path: "\{root}/tests/fixtures/run_cases.txt"
    buf: String
    if (io.exists :path) then {
        content: slurp path: path.stringView
        with it: content.stringView.lines do for ln: it loop {
            if ln.length > 0 when (ln.startsWith prefix: "matrix_").not then {
                buf.append ln
                buf.append "\n"
            }
        }
    }
    buf.append cases
    writeFile :path content: buf.stringView
}

# writeCells -- one program per writable cell, and the manifest
writeCells: function {
    dir: StringView
    fams: (List Family).view
    poss: (List Position).view
    rows: (List Row).view
    slots: (List Slot).view
} is {
    ensureDir path: dir
    manifest: String
    for s: slots.iterate loop {
        f: fams.get i: s.fam
        p: poss.get i: s.pos
        if p.needsConf.not or (f.confType.length > 0) then {
            cd: confDecls :f
            decls: if p.needsConf then cd.copy else f.decls.copy
            extra: expand :f text: p.decls.stringView n: p.expect
            body: expand :f text: p.body.stringView n: p.expect
            rt: retType :f
            name: "\{f.name}__\{p.name}"
            prog: "\{decls}\{extra}probe: function out \{rt} is {\n    \{body}\n}\nmain: function is {\n    print \"\\{probe}\"\n}\n"
            writeFile path: "\{dir}/\{name}.z" content: prog.stringView
            writeUnit :f :dir stem: name.stringView
            d: rowDetail :s :rows :f
            manifest.append "\{name} \{f.name} \{p.name} \{(outcomeWord
                o: s.expected
            )} \{p.expect} \{d}\n"
        }
    }
    writeFile path: "\{dir}/manifest.txt" content: manifest.stringView
}

# tally -- how many slots carry the outcome
tally: function {slots: (List Slot).view expected: outcome} out u64 is {
    n: u64
    for s: slots.iterate loop {
        if s.expected == expected then n = n + 1
    }
    return n
}

# report -- the counts, and each open question and each known defect with how
# many cells wait on it
report: function {
    fams: (List Family).view
    poss: (List Position).view
    rows: (List Row).view
    slots: (List Slot).view
} is {
    run: tally :slots expected: outcome.run
    refused: tally :slots expected: outcome.refused
    na: tally :slots expected: outcome.na
    ask: tally :slots expected: outcome.ask
    known: tally :slots expected: outcome.known
    print "matrixgen: \{fams.length} families x \{poss.length} positions: \{run} RUN, \{refused} REFUSED, \{na} NA, \{ask} ASK, \{known} KNOWN"
    questions: List String
    counts: ListVal u64
    for s: slots.iterate loop {
        if s.expected.ask or s.expected.known then {
            f: fams.get i: s.fam
            d: rowDetail :s :rows :f
            qi: u64
            for qi < questions.length while (questions.get i: qi) != d loop qi = qi + 1
            if qi == questions.length then {
                questions.append d.copy
                counts.append 0
            }
            counts.set i: qi val: (counts.get i: qi) + 1
        }
    }
    qi: u64
    for qi < questions.length loop {
        print "  x\{counts.get i: qi}: \{questions.get i: qi}"
        qi = qi + 1
    }
}

# Options -- the command line: where the fixtures go, or the cells instead
Options: class {
    root: String
    cellsDir: String
}

# parseArgs -- the command line as Options, stopping on anything else
parseArgs: function out Options is {
    argv: os.args
    opts: Options root: ".".string cellsDir: "".string
    i: 1.u64
    for i < argv.length loop {
        a: argv.get :i
        if i + 1 >= argv.length then fail msg: "usage: matrixgen [--root DIR] [--cells DIR]"
        v: argv.get i: i + 1
        if a == "--root" then {
            opts.root = v.copy
        } else if a == "--cells" then {
            opts.cellsDir = v.copy
        } else fail msg: "usage: matrixgen [--root DIR] [--cells DIR]"
        i = i + 2
    }
    return opts
}

main: function is {
    opts: parseArgs
    fams: families
    poss: positions
    tablePath: "\{opts.root}/tests/fixtures/matrix_expect.txt"
    rows: readTable path: tablePath.stringView :fams :poss
    slots: allSlots :fams :poss :rows tablePath: tablePath.stringView
    if opts.cellsDir.length > 0 then {
        writeCells dir: opts.cellsDir.stringView :fams :poss :rows :slots
    } else writeFixtures root: opts.root.stringView :fams :poss :rows :slots
    report :fams :poss :rows :slots
}
