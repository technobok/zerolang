# caselist -- the case list a fixture generator writes: matrixgen's
# tests/fixtures/matrix_cases.zd and constparitygen's cpar_cases.zd, read by
# the test runner beside the hand-written run_cases.zd. A generator writes its
# whole list on each regeneration, through the standard library's zd unit.
public: unit {
    :write
}

# rowSchema -- the row type every case list declares, with the hand-written lists'
# own words
rowSchema: "# program -- one test program: <dir>/<name>.z from the repository root, its\n# units also read from each of `roots`\nprogram: data {\n    name: text\n    dir: text\n    roots: list {} out staticlist text\n    # it checks what only POSIX has (file descriptors, signals): on Windows it\n    # is listed as (posix) and not run\n    posix: false\n}"

# write -- the case list at `path`: `header`, the row type, then a row for each
# of `names`, a program of tests/fixtures/emitc_corpus
write: function {path: StringView header: StringView names: (List String).view} is {
    items: List zd.Entry
    for each n: names loop {
        fields: List zd.Entry
        fields.append (zd.entry name: "name" type: "" node: zd.Node.text n.copy)
        fields.append (
            zd.entry
            name: "dir"
            type: ""
            node: zd.Node.text "tests/fixtures/emitc_corpus".string
        )
        items.append (zd.entry name: "" type: "program" node: zd.Node.dataValue fields.take)
    }
    defs: List zd.Entry
    defs.append (zd.entry name: "programs" type: "" node: zd.Node.listValue items.take)
    doc: zd.entry name: "" type: "" node: zd.Node.unitValue defs.take
    (zd.write :path :header schema: rowSchema :doc).orPanic
}
