# smoketext -- the rendering helpers the smoke harnesses share. A harness prints
# a deterministic dump compared against a golden, so how a value is spelled is
# part of the test's contract and belongs in one place rather than once per
# harness.

public: unit {
    :boolText
}

# a bool rendered as "true" or "false".
boolText: function {b: bool} out String is {
    match (
        b
    ) case true then {
        return "true".string
    } case false then {
        return "false".string
    }
}
