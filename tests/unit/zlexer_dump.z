# zlexer_dump -- the token dump tool: `zlexer_dump <file.z>` prints one line
# per token, `<line>:<col> <TYPE> "<escaped text>"`, for the lexer goldens.

public: unit {
    :main
}

# the printable name of a token type `t`.
ttname: function {t: zlexer.toktype} out String is {
    match (
        t
    ) case bofTok then {
        return "BOF".string
    } case eofTok then {
        return "EOF".string
    } case errTok then {
        return "ERR".string
    } case wsTok then {
        return "WS".string
    } case eolTok then {
        return "EOL".string
    } case commentTok then {
        return "COMMENT".string
    } case colonTok then {
        return "COLON".string
    } case semicolonTok then {
        return "SEMICOLON".string
    } case parenOpenTok then {
        return "PARENOPEN".string
    } case parenCloseTok then {
        return "PARENCLOSE".string
    } case braceOpenTok then {
        return "BRACEOPEN".string
    } case braceCloseTok then {
        return "BRACECLOSE".string
    } case dotTok then {
        return "DOT".string
    } case refIdTok then {
        return "REFID".string
    } case labelTok then {
        return "LABEL".string
    } case labelPreTok then {
        return "LABELPRE".string
    } case equalsTok then {
        return "EQUALS".string
    } case functionTok then {
        return "FUNCTION".string
    } case ifTok then {
        return "IF".string
    } case whenTok then {
        return "WHEN".string
    } case thenTok then {
        return "THEN".string
    } case elseTok then {
        return "ELSE".string
    } case forTok then {
        return "FOR".string
    } case loopTok then {
        return "LOOP".string
    } case whileTok then {
        return "WHILE".string
    } case doTok then {
        return "DO".string
    } case caseTok then {
        return "CASE".string
    } case matchTok then {
        return "MATCH".string
    } case onTok then {
        return "ON".string
    } case outTok then {
        return "OUT".string
    } case outxTok then {
        return "OUTX".string
    } case inTok then {
        return "IN".string
    } case swapTok then {
        return "SWAP".string
    } case unitTok then {
        return "UNIT".string
    } case recordTok then {
        return "RECORD".string
    } case classTok then {
        return "CLASS".string
    } case unionTok then {
        return "UNION".string
    } case variantTok then {
        return "VARIANT".string
    } case protocolTok then {
        return "PROTOCOL".string
    } case dataTok then {
        return "DATA".string
    } case isTok then {
        return "IS".string
    } case asTok then {
        return "AS".string
    } case withTok then {
        return "WITH".string
    } case facetTok then {
        return "FACET".string
    } case generatorTok then {
        return "GENERATOR".string
    } case nativeTok then {
        return "NATIVE".string
    } case strBegTok then {
        return "STRBEG".string
    } case strMidTok then {
        return "STRMID".string
    } case strChrTok then {
        return "STRCHR".string
    } case strEndTok then {
        return "STREND".string
    } case strExprBegTok then {
        return "STREXPRBEG".string
    }
}

# Append the canonical-escape form of byte `b` to `dst`.
hexdigit: function {b: u8} out u8 is {
    if b < 10 then return b + 48
    return b - 10 + 97
}

# append byte `b` to `dst`, rendering it as an escape when it is special.
escapeAppend: function {b: u8 dst: String} is {
    if b == zlexer.ascii.ht then {
        dst.appendByte zlexer.ascii.backslash
        dst.appendByte 116.u8  # 't'
        return
    }
    if b == zlexer.ascii.lf then {
        dst.appendByte zlexer.ascii.backslash
        dst.appendByte 110.u8  # 'n'
        return
    }
    if b == zlexer.ascii.cr then {
        dst.appendByte zlexer.ascii.backslash
        dst.appendByte 114.u8  # 'r'
        return
    }
    if b == zlexer.ascii.doubleQuote then {
        dst.appendByte zlexer.ascii.backslash
        dst.appendByte zlexer.ascii.doubleQuote
        return
    }
    if b == zlexer.ascii.backslash then {
        dst.appendByte zlexer.ascii.backslash
        dst.appendByte zlexer.ascii.backslash
        return
    }
    if b >= zlexer.ascii.space when b <= 126 then {
        dst.appendByte b
        return
    }
    h: b / 16
    # Operators are identifiers with no precedence ladder; the
    # subtraction must explicitly bracket the multiplication.
    l: b - (h * 16)
    hi: hexdigit h
    lo: hexdigit l
    dst.appendByte zlexer.ascii.backslash
    dst.appendByte zlexer.ascii.lowerX
    dst.appendByte hi
    dst.appendByte lo
}

# Try to decode a UTF-8 multi-byte sequence starting at offset `i`.
# Returns optionval.some <cp> when the bytes form a well-formed
# 2/3/4-byte sequence (lead in 0xC2..0xF7, all continuations in
# 0x80..0xBF, sequence fits within `sv`); optionval.none otherwise.
# ASCII bytes (b < 0x80) are NOT decoded here -- they fall through
# to the single-byte path in escapeStr.
utf8_decode_at: function {sv: StringView i: u64} out optionval u32 is {
    n: sv.length
    if i >= n then return (optionval.none u32)
    leadopt: sv.byteAt i
    lead: u8
    match (
        leadopt
    ) case some then {
        lead = leadopt
    } case none then {
        return (optionval.none u32)
    }

    seqlen: u8
    if lead >= 194 when lead <= 223 then seqlen = 2
    if lead >= 224 when lead <= 239 then seqlen = 3
    if lead >= 240 when lead <= 247 then seqlen = 4
    if seqlen == 0 then return (optionval.none u32)
    if (i + seqlen.u64) > n then return (optionval.none u32)

    if seqlen == 2 then {
        b1opt: sv.byteAt (i + 1)
        b1: u8
        match (
            b1opt
        ) case some then {
            b1 = b1opt
        } case none then {
            return (optionval.none u32)
        }
        if b1 < 128 then return (optionval.none u32)
        if b1 > 191 then return (optionval.none u32)
        cp: ((lead - 192).u32 * 64) + (b1 - 128).u32
        return (optionval.some cp)
    }
    if seqlen == 3 then {
        b1opt: sv.byteAt (i + 1)
        b2opt: sv.byteAt (i + 2)
        b1: u8
        b2: u8
        match (
            b1opt
        ) case some then {
            b1 = b1opt
        } case none then {
            return (optionval.none u32)
        }
        match (
            b2opt
        ) case some then {
            b2 = b2opt
        } case none then {
            return (optionval.none u32)
        }
        if b1 < 128 then return (optionval.none u32)
        if b1 > 191 then return (optionval.none u32)
        if b2 < 128 then return (optionval.none u32)
        if b2 > 191 then return (optionval.none u32)
        cp: ((lead - 224).u32 * 4096) + ((b1 - 128).u32 * 64) + (b2 - 128).u32
        return (optionval.some cp)
    }
    b1opt: sv.byteAt (i + 1)
    b2opt: sv.byteAt (i + 2)
    b3opt: sv.byteAt (i + 3)
    b1: u8
    b2: u8
    b3: u8
    match (
        b1opt
    ) case some then {
        b1 = b1opt
    } case none then {
        return (optionval.none u32)
    }
    match (
        b2opt
    ) case some then {
        b2 = b2opt
    } case none then {
        return (optionval.none u32)
    }
    match (
        b3opt
    ) case some then {
        b3 = b3opt
    } case none then {
        return (optionval.none u32)
    }
    if b1 < 128 then return (optionval.none u32)
    if b1 > 191 then return (optionval.none u32)
    if b2 < 128 then return (optionval.none u32)
    if b2 > 191 then return (optionval.none u32)
    if b3 < 128 then return (optionval.none u32)
    if b3 > 191 then return (optionval.none u32)
    cp: (
        ((lead - 240).u32 * 262144) +
        ((b1 - 128).u32 * 4096) +
        ((b2 - 128).u32 * 64) +
        (b3 - 128).u32
    )
    return (optionval.some cp)
}

# Append the codepoint as `\u{cp:x}` (lowercase, no leading zeros).
# Used when the dumper has decoded a UTF-8 sequence whose codepoint
# exceeds 0xFF.
escapeAppendCp: function {cp: u32 dst: String} is {
    dst.appendByte zlexer.ascii.backslash
    dst.appendByte zlexer.ascii.lowerU
    dst.appendByte zlexer.ascii.braceOpen

    if cp == 0 then {
        dst.appendByte zlexer.ascii.zero
        dst.appendByte zlexer.ascii.braceClose
        return
    }

    # Collect hex digits least-significant first, then emit in reverse.
    # cp fits in 21 bits (cp <= 0x10FFFF at the decoder boundary) so
    # the buffer is at most 6 bytes.
    rev: String
    v: cp
    for v > 0 loop {
        q: v / 16
        nibble: v - (q * 16)
        rev.appendByte (hexdigit nibble.u8.orPanic)
        v = q
    }
    rsv: rev.stringView
    rlen: rsv.length
    k: rlen
    for k > 0 loop {
        k = k - 1
        bopt: rsv.byteAt k
        match (
            bopt
        ) case some then {
            dst.appendByte bopt
        } case none then {
            return
        }
    }
    dst.appendByte zlexer.ascii.braceClose
}

# `sv` re-rendered with special characters shown as escapes (dump output).
escapeStr: function {sv: StringView} out String is {
    buf: String
    n: sv.length
    i: u64
    for i < n loop {
        cpopt: utf8_decode_at :sv :i
        match (
            cpopt
        ) case some then {
            if cpopt > 255 then {
                escapeAppendCp cp: cpopt dst: buf
            } else {
                escapeAppend b: cpopt.u8.orPanic dst: buf
            }
            if cpopt < 2048 then {
                i = i + 2
            } else if cpopt < 65536 then {
                i = i + 3
            } else {
                i = i + 4
            }
        } case none then {
            bopt: sv.byteAt i
            match (
                bopt
            ) case some then {
                escapeAppend b: bopt dst: buf
            } case none then {
                return buf
            }
            i = i + 1
        }
    }
    return buf
}

main: function is {
    argv: os.args
    if argv.length < 2 then {
        io.eprintln "usage: zlexer <file.z>"
        os.exit code: 2
    }
    path: argv.get i: 1
    r: io.readText :path
    match (
        r
    ) case ok then {
        tok: zlexer.Tokenizer.create source: r.take fsno: zvfs.fsno
        # the dump owns the pool the tokenizer interns into, and reads the
        # spellings back out of it
        pool: zast.StringPool.create
        dump :tok :pool
    } case err then {
        io.eprintln "zlexer: could not read source file"
        os.exit code: 1
    }
}

# print every token from `tok` (lexer golden-dump helper).
dump: function {tok: zlexer.Tokenizer pool: zast.StringPool} is {
    for true loop {
        t: tok.nextToken :pool
        txt: zast.poolTextAt :pool ref: t.text
        esc: escapeStr sv: txt.stringView
        name: ttname t: t.toktype
        print "\{t.lineno}:\{t.colno} \{name} \"\{esc}\""
        eof: false
        match (
            t.toktype
        ) case eofTok then {
            eof = true
        } else {
            eof = false
        }
        if eof then return
    }
}
