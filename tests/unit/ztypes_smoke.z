# ztypes_smoke -- the ztypes smoke harness: prints every enum arm, a
# representative of each carrier, and the numeric-literal battery. Compared
# against tests/fixtures/ztypes_smoke_z/smoke.expected.

public: unit {
    :main
}


# exercise the type registry against a golden, so a change to ZType or the
# id spaces is caught before anything downstream reads them
main: function is {
    print "=== ztypetype ==="
    print (ztypes.ztypetypeName ztypes.ztypetype.nullType)
    print (ztypes.ztypetypeName ztypes.ztypetype.genericParam)
    print (ztypes.ztypetypeName ztypes.ztypetype.unitType)
    print (ztypes.ztypetypeName ztypes.ztypetype.functionType)
    print (ztypes.ztypetypeName ztypes.ztypetype.recordType)
    print (ztypes.ztypetypeName ztypes.ztypetype.classType)
    print (ztypes.ztypetypeName ztypes.ztypetype.variantType)
    print (ztypes.ztypetypeName ztypes.ztypetype.unionType)
    print (ztypes.ztypetypeName ztypes.ztypetype.protocolType)
    print (ztypes.ztypetypeName ztypes.ztypetype.facetType)
    print (ztypes.ztypetypeName ztypes.ztypetype.dataType)
    print (ztypes.ztypetypeName ztypes.ztypetype.tagType)
    print (ztypes.ztypetypeName ztypes.ztypetype.neverType)

    print "=== zcontrolkind ==="
    print (ztypes.zcontrolkindName ztypes.zcontrolkind.none)
    print (ztypes.zcontrolkindName ztypes.zcontrolkind.returnKind)
    print (ztypes.zcontrolkindName ztypes.zcontrolkind.breakKind)
    print (ztypes.zcontrolkindName ztypes.zcontrolkind.continueKind)
    print (ztypes.zcontrolkindName ztypes.zcontrolkind.errorKind)
    print (ztypes.zcontrolkindName ztypes.zcontrolkind.panicKind)

    print "=== zownership ==="
    print (ztypes.zownershipName ztypes.zownership.owned)
    print (ztypes.zownershipName ztypes.zownership.borrowed)

    print "=== zlockstate ==="
    print (ztypes.zlockstateName ztypes.zlockstate.exclusive)
    print (ztypes.zlockstateName ztypes.zlockstate.shared)

    print "=== zparamownership ==="
    print (ztypes.zparamownershipName ztypes.zparamownership.takeMode)
    print (ztypes.zparamownershipName ztypes.zparamownership.borrowMode)
    print (ztypes.zparamownershipName ztypes.zparamownership.viewMode)

    print "=== zlockholderkind ==="
    print (ztypes.zlockholderkindName ztypes.zlockholderkind.varKind)
    print (ztypes.zlockholderkindName ztypes.zlockholderkind.callKind)
    print (ztypes.zlockholderkindName ztypes.zlockholderkind.forKind)

    print "=== zconstkind ==="
    print (ztypes.zconstkindName ztypes.zconstkind.none)
    print (ztypes.zconstkindName ztypes.zconstkind.ivalKind)
    print (ztypes.zconstkindName ztypes.zconstkind.fvalKind)
    print (ztypes.zconstkindName ztypes.zconstkind.svalKind)
    print (ztypes.zconstkindName ztypes.zconstkind.armKind)

    print "=== carriers ==="
    reg: ztypes.newRegistry
    t0: reg.newType name: "point" typetype: ztypes.ztypetype.recordType
    # the smoke asserts presence only; 1 stands in for a pool id
    reg.setNeedsDestructor typeId: t0
    tt0: reg.typetypeOf typeId: t0
    ht0: reg.hasType typeId: t0
    hd0: reg.needsDestructor typeId: t0
    print "type id=\{t0} typetype=\{ztypes.ztypetypeName tt0} hasType=\{smoketext.boolText ht0} hasDtor=\{smoketext.boolText hd0}"

    t1: reg.newType name: "List" typetype: ztypes.ztypetype.classType
    reg.setTagGenericOrigin typeId: t1
    tt1: reg.typetypeOf typeId: t1
    tg1: reg.isTagGenericOriginOf typeId: t1
    print "type id=\{t1} typetype=\{ztypes.ztypetypeName tt1} tagGenOrigin=\{smoketext.boolText tg1}"

    miss: reg.typetypeOf typeId: (ztypes.tid.create from: 99)
    print "miss typetype=\{ztypes.ztypetypeName miss} hasType=\{(smoketext.boolText
        (reg.hasType typeId: (ztypes.tid.create from: 99))
    )}"

    v0: reg.newVariable ztypeId: t0 ownership: ztypes.zownership.owned
    print "var id=\{v0} ztypeId=\{reg.variableTypeOf id: v0} ownership=\{(ztypes.zownershipName
        (reg.variableOwnershipOf id: v0)
    )}"

    e0: reg.newEntry ztypeId: t0
    print "entry id=\{e0.entryId} ztypeId=\{e0.ztypeId} taken=\{smoketext.boolText e0.isTaken}"

    cf0: (reg.newConformance
        implTypeId: t0
        specTypeId: t1
        label: "drawable"
        labelNameId: 0
        isFacet: false
    )
    print "conf id=\{cf0.conformanceId} impl=\{cf0.implTypeId} spec=\{cf0.specTypeId} label=\{cf0.label} facet=\{smoketext.boolText cf0.isFacet}"

    k0: ztypes.makeIntConst 1024.i64
    print "const kind=\{ztypes.zconstkindName k0.kind} ival=\{k0.ival}"
    k2: ztypes.makeStrConst 3.u32
    print "const kind=\{ztypes.zconstkindName k2.kind} strId=\{k2.strId}"
    k3: (ztypes.makeArmConst
        armTid: (ztypes.tid.create from: 12)
        armName: (zast.nameid.create from: 5)
    )
    print "const kind=\{ztypes.zconstkindName k3.kind} armTid=\{k3.armTid} armName=\{k3.armName}"

    lh0: ztypes.zlockholder kind: ztypes.zlockholderkind.varKind id: 5
    print "lockholder kind=\{ztypes.zlockholderkindName lh0.kind} id=\{lh0.id}"

    print "=== mangleVar ==="
    smokeMangleVar "foo"
    smokeMangleVar "int"
    smokeMangleVar "for"
    smokeMangleVar "main"
    smokeMangleVar "exit"

    print "=== intFitsFloat ==="
    smokeIntFits value: 0 k: ztypes.numkind.f32Type
    smokeIntFits value: 16777216 k: ztypes.numkind.f32Type
    smokeIntFits value: 16777217 k: ztypes.numkind.f32Type
    smokeIntFits value: 9007199254740992 k: ztypes.numkind.f64Type
    smokeIntFits value: 9007199254740993 k: ztypes.numkind.f64Type
    smokeIntFits value: 5 k: ztypes.numkind.i64Type

    print "=== floatFitsFloat ==="
    smokeFloatFits label: "0.5" value: 0.5 k: ztypes.numkind.f32Type
    smokeFloatFits label: "0.1" value: 0.1 k: ztypes.numkind.f32Type
    smokeFloatFits label: "1.0" value: 1.0 k: ztypes.numkind.f64Type
    smokeFloatFits label: "1.0" value: 1.0 k: ztypes.numkind.f128Type
    smokeFloatFits label: "2.5" value: 2.5 k: ztypes.numkind.f32Type

    # f16 -- the arm with the hand-rolled binade. Its answers are the oracle a
    # rewrite has to reproduce, so they are pinned across every boundary the
    # arm has: zero, the max finite, one past it, the smallest normal, the
    # smallest subnormal and one binade below it, and the two values either
    # side of the 10-bit mantissa.
    smokeFloatFits label: "0.0" value: 0.0 k: ztypes.numkind.f16Type
    smokeFloatFits label: "65504.0" value: 65504.0 k: ztypes.numkind.f16Type
    smokeFloatFits label: "65505.0" value: 65505.0 k: ztypes.numkind.f16Type
    smokeFloatFits label: "2^-14" value: 0.00006103515625 k: ztypes.numkind.f16Type
    smokeFloatFits label: "2^-24" value: 0.000000059604644775390625 k: ztypes.numkind.f16Type
    smokeFloatFits label: "2^-25" value: 0.0000000298023223876953125 k: ztypes.numkind.f16Type
    smokeFloatFits label: "1+2^-10" value: 1.0009765625 k: ztypes.numkind.f16Type
    smokeFloatFits label: "1+2^-11" value: 1.00048828125 k: ztypes.numkind.f16Type
    smokeFloatFits label: "1.5" value: 1.5 k: ztypes.numkind.f16Type
    smokeFloatFits label: "0.1" value: 0.1 k: ztypes.numkind.f16Type
    smokeFloatFits label: "3.0*2^-24" value: 0.000000178813934326171875 k: ztypes.numkind.f16Type

    print "=== parseNumber ==="
    smokeParse "0"
    smokeParse "42"
    smokeParse "255"
    smokeParse "256"
    smokeParse "0xff"
    smokeParse "0b1010"
    smokeParse "0o17"
    smokeParse "100u8"
    smokeParse "256u8"
    smokeParse "200i8"
    smokeParse "42i128"
    smokeParse "0cA"
    smokeParse "0cAB"
    smokeParse "0c8"
    smokeParse "0c"
    smokeParse "0x1f32"
    smokeParse "1.5"
    smokeParse "1e3"
    smokeParse "0xZZ"

    print "=== parseLiteralValue ==="
    smokeLitVal "42"
    smokeLitVal "256u8"
    smokeLitVal "1.5"
    smokeLitVal "1e3"
    smokeLitVal "0xZZ"
}

# smoke-test: print the C-mangled form of `name`.
smokeMangleVar: function {name: StringView} is {
    mangled: ztypes.mangleVarName name
    print "mangleVar \{name} -> \{mangled}"
}

# smoke-test: print whether `value` fits numeric kind `k`.
smokeIntFits: function {value: i64 k: ztypes.numkind} is {
    r: ztypes.intFitsFloat :value :k
    print "intFits \{value} \{ztypes.numkindName k} -> \{smoketext.boolText r}"
}

# smoke-test: print whether float `value` fits kind `k`.
smokeFloatFits: function {label: StringView value: f64 k: ztypes.numkind} is {
    r: ztypes.floatFitsFloat :value :k
    print "floatFits \{label} \{ztypes.numkindName k} -> \{smoketext.boolText r}"
}

# smoke-test: parse `numstr` and print the outcome.
smokeParse: function {numstr: StringView} is {
    p: ztypes.parseNumber numstr
    print "parse \{numstr} -> kind=\{ztypes.numkindName p.kind} float=\{smoketext.boolText p.isFloat} ival=\{p.ival} err=\{p.err}"
}

# smoke-test: print the parsed literal value of `numstr`.
smokeLitVal: function {numstr: StringView} is {
    v: ztypes.parseLiteralValue numstr
    print "litval \{numstr} -> ok=\{smoketext.boolText v.ok} float=\{smoketext.boolText v.isFloat} ival=\{v.ival}"
}
