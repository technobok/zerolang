# thread -- run work on its own operating-system thread.
#
# A thread runs a task: a class that conforms to `Task R` -- or `TaskVal r`, when
# its result is a value type -- and whose `call` answers the result. The task is
# MOVED to the thread when it starts, so nothing else can touch it while it
# runs; it is destroyed on that thread as soon as `call` returns, and `join`
# answers what `call` answered:
#
#     h: thread.spawnVal task: (Sum a: 1 b: 2)
#     print "\{h.join}"
#
# A task with no result is a `(Task null)`, its `call` declared with no `out`.
# A task may hold borrows (a `.borrow` or `.view` field). They stay locked for
# as long as the handle lives, so the owner of what a running task borrows can
# neither change nor drop it, and two running tasks cannot both write one
# source. Destroying a handle that was never joined joins it: a scope cannot end
# while a thread it started still uses what the scope owns. A panic on any
# thread ends the whole program.
#
# A value of a type that conforms to `ThreadBound` never reaches another thread,
# held directly or at any depth inside a task: a lock guard unlocks on the
# thread that locked. A task is the only way a value reaches another thread:
# a channel end, a Mutex handle and what they carry go over inside one.

# ThreadBound -- a marker: a value of a conforming type never leaves the thread
# that made it, by any marker, at any depth
ThreadBound: protocol {}

# Crossing -- a marker for a protocol: a value moved into a parameter typed or
# bounded by a conforming protocol is handed to another thread, and is checked
# there for what may not cross. `Task` and `TaskVal` conform, which is what
# makes `spawn`, `spawnVal` and `spawnDetached` crossings.
Crossing: protocol {}

# Unshareable -- a marker: one thread at a time may use a value of a conforming
# type. It may move to another thread, and a task may borrow it (`.borrow`
# keeps its owner off it until the join), but a view of it never crosses:
# its owner would go on using it beside the thread. Share one through a
# `sync.Mutex`. The sqlite connection types conform.
Unshareable: protocol {}

# SharedReads -- a marker: several threads read the value a conforming type
# holds at the same time (`sync.RwLock`), so it may not hold an `Unshareable`
# one where it crosses to another thread
SharedReads: protocol {}

# Task -- the work a thread does: `call` runs once, on the new thread, and
# answers the thread's result
Task: protocol {
    # the thread's body
    call: function {:this} out R
} as {
    # the result, a reference type; `null` for none
    R: AnyRef.generic
    :Crossing
}

# TaskVal -- Task for a result of a value type
TaskVal: protocol {
    # the thread's body, answering a value
    call: function {:this} out r
} as {
    r: anyval.generic
    :Crossing
}

# JoinHandle -- a thread `spawn` started. `join` waits for it and answers the
# result its task's `call` answered; destroying a handle that was not joined
# joins it first.
JoinHandle: class is native as {
    # the result
    R: AnyRef.generic
    :Drop
    public: unit {
        :Drop
        :join
        :isFinished
        :id
        :detach
    }
    # wait for the thread to finish, and answer its result
    join: function {:this} out R is native
    # whether the thread has finished its task (join will not wait)
    isFinished: function {t: this.view} out bool is native
    # the thread's id, as the operating system numbers it; 0 once joined
    id: function {t: this.view} out u64 is native
    # let the thread run on without the handle: it destroys its result when it
    # finishes, and nothing waits for it
    detach: function {:this} is native
    # start `task` on a new thread named `name` with a stack of `stackSize`
    # bytes (0: the default, 8 MiB). It is `spawn`'s C, and private: `spawn`
    # is the one way to start a thread
    create: function {task: (Task R).take name: StringView.view stackSize: u64} out type is native
}

# JoinHandleVal -- JoinHandle for a result of a value type
JoinHandleVal: class is native as {
    r: anyval.generic
    :Drop
    public: unit {
        :Drop
        :join
        :isFinished
        :id
        :detach
    }
    # wait for the thread to finish, and answer the value it computed
    join: function {:this} out r is native
    # whether join would wait no longer
    isFinished: function {t: this.view} out bool is native
    # the operating system's number for the thread; 0 once joined
    id: function {t: this.view} out u64 is native
    # let the thread run on with no handle
    detach: function {:this} is native
    # start a value task on a new thread: `spawnVal`'s C, private as
    # JoinHandle's is
    create: function {
        task: (TaskVal r).take name: StringView.view stackSize: u64
    } out type is native
}

# spawn -- start `task` on a new thread. `name` labels it for debuggers and
# `top` (15 bytes are kept); `stackSize` 0 is the default, 8 MiB. The handle
# carries the task's borrows: what it borrows stays locked until the handle
# ends.
spawn: function {
    # the work, moved to the thread
    task: T.take
    # the thread's name; empty leaves it unnamed
    name: ""
    # the thread's stack, in bytes; 0 is 8 MiB
    stackSize: 0.u64
} outx JoinHandle R as {
    # the result
    R: AnyRef.generic
    # the task's type
    T: (Task R).generic
} is native

# spawnVal -- spawn for a task whose result is a value type, its parameters as
# spawn's
spawnVal: function {
    task: T.take
    name: ""
    stackSize: 0.u64
} outx JoinHandleVal r as {
    r: anyval.generic
    T: (TaskVal r).generic
} is native

# spawnDetached -- start `task` on a new thread that nothing waits for: it runs
# to the end on its own, destroying its task and its result. It is `out`, not
# `outx`, so a task that holds borrows is refused -- nothing would keep what it
# borrows alive. The program may end while it still runs. Its parameters are as
# spawn's.
spawnDetached: function {
    task: T.take
    name: ""
    stackSize: 0.u64
} is {
    h: spawn task: task.take :name :stackSize
    h.detach
} as {
    R: AnyRef.generic
    T: (Task R).generic
}

# yieldNow -- let another thread run
yieldNow: function is native

# running -- how many threads the program started that have not finished. A
# thread leaves the count after its task is destroyed, so once it reads 0
# every detached task has run to its end and freed what it held.
running: function out i64 is native
