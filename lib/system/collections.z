# collections.z - Collection types
#
# Every container here is `<kind> is native as { ... }`: the runtime owns the
# layout, so there is no is-block to write and the `as` clause carries both the
# generic parameters and the member declarations -- parameters first, then a
# blank line, then the members. That is not a stylistic split. A definition has
# ONE is-clause, and `is native` IS it, so a body next to it is E0028; the as
# clause is where the declarations go.
#
# `is native` on a type means the runtime owns its layout. It is not a claim
# about whether the type has zerolang-visible members: these all declare theirs.

# a fixed-length inline array of `t` values, length `to`.
array: record is native as {
    # the VALUE element type of array. Lowercase says valtype, so a binding of
    # it COPIES
    t: anyval.generic
    # the element count this array was created for
    to: u64.generic

    # the element at `i`, unchecked -- the raw array is the runtime's backing
    # and does no bound test
    get: function {:this i: i64} out t is native
    # write the element at `i`, unchecked, for the same reason `get` is
    set: function {:this i: i64 item: t} out t is native
    # how many elements the raw array holds
    length: function {:this} out i64 is native
    # a raw array of `to` elements, zeroed
    create: function {} out type is native
}

# a fixed-capacity inline UTF-8 string value, capacity `to`.
str: record is native as {
    :Text
    # the byte capacity this raw str was created for
    to: u64.generic
    # the byte count the raw str currently holds
    length: function {:this} out u64 is native
    # the raw str's allocated byte capacity, which `length` may be below
    size: function {:this} out u64 is native
    # an owned String over the raw str's bytes
    string: function {:this} out String is native
    # a borrowed view over the raw str's bytes
    stringView: function {t: this.view} outx StringView is native
    # a borrowed view over the raw str's bytes in [from, to)
    substring: function {t: this.view from: u64 to: u64} outx StringView is native
    # a raw str with room for `to` bytes
    create: function out type is native
}

# a growable, heap-backed sequence of reference `T` elements. `List` in
# core is this template's alias.
ListRef: class is native as {
    # the REFERENCE element type of ListRef. Uppercase says reftype, so a
    # binding of it MOVES
    T: AnyRef.generic

    # append one element to a ListRef; it is TAKEN, so the list owns it and the
    # caller's binding is spent
    append: function {:this from: T.take} is native
    # insert one element into a ListRef at `at`, shifting the tail up; it is
    # TAKEN, so the list owns it and the caller's binding is spent
    insert: function {:this from: T.take at: u64} is native
    # append every element of another ListRef, which is taken whole rather than
    # element by element
    extend: function {:this from: type.take} is native
    # the readonly element reference: several may be live at once and none of
    # them can be written through. `getMut` is the mutable twin.
    get: function {t: this.borrow i: u64} outx T.view is native
    # the mutable element reference: writes through it reach the list, and it
    # excludes every other reference to the container. `get` is the readonly
    # twin (see iterate/iterateMut).
    getMut: function {t: this.borrow i: u64} outx T.borrow is native
    # replace element `i` of a ListRef, handing back the one displaced so its
    # ownership has somewhere to go
    set: function {:this i: u64 val: T.take} out T is native
    # remove the last element of a ListRef and hand back its ownership
    pop: function {:this} out T is native
    # a LINEAR scan of the ListRef for an equal element. A list is ordered, not
    # hashed, so this walks it -- a Set is the hashed one
    contains: function {t: this.view item: T.view} out bool is native
    # sort a ListRef in place, ascending by the element type's own ordering
    sort: function {:this} is native
    # how many elements the ListRef holds
    length: function {t: this.view} out u64 is native
    # how many elements fit before the ListRef grows again; `create` takes an
    # initial one
    capacity: function {t: this.view} out u64 is native
    # a borrowed readonly view over the whole ListRef. It pins the list, so it
    # must not outlive it
    listView: function {t: this.borrow} outx (ListView T) is native
    # the readonly walk: a SHARED receiver, so several may run at once and the
    # container stays readable throughout -- and the elements it yields are
    # readonly. `iterateMut` is the exclusive twin for writing through them.
    iterate: function {t: this.view} outx (ListIter :T) is native
    # the mutable walk: an exclusive receiver, so the elements it yields may
    # be written through. `iterate` is the readonly twin (see getMut/get).
    iterateMut: function {t: this.borrow} outx (ListIter :T) is native
    # an empty ListRef, reserving `capacity` elements up front when one is given
    create: function {capacity: 0.u64} out type is native
}

# a growable, heap-backed sequence of VALTYPE elements.
#
# The valtype twin of `List`. A valtype has no ownership to transfer and no
# interior to alias, so the signatures differ where that matters: `append`
# copies rather than taking, and `get` returns the element BY VALUE -- no
# view, so no lock on the container and no aliasing question at all. `getMut`
# is still a reference, because a COMPOUND valtype's children are mutated in
# place through it; whole-element replacement is `set`.
ListVal: class is native as {
    # the VALUE element type of ListVal. Lowercase says valtype, so a binding of
    # it COPIES
    t: anyval.generic

    # append one element to a ListVal; it is COPIED in -- a valtype has no
    # ownership to transfer
    append: function {:this from: t} is native
    # insert one element into a ListVal at `at`, shifting the tail up; it is
    # COPIED in -- a valtype has no ownership to transfer
    insert: function {:this from: t at: u64} is native
    # append every element of another ListVal, which is taken whole rather than
    # element by element
    extend: function {:this from: type.take} is native
    # a COPY of the element -- cheap, and it cannot alias. The RECEIVER still
    # says `borrow` because this shares `ListRef.get`'s emitted C, and two
    # declarations over one function cannot disagree about their receiver;
    # the difference that matters is the RETURN.
    get: function {t: this.borrow i: u64} out t is native
    # the mutable element reference: a COMPOUND valtype's children are mutated
    # in place through it. Whole-element replacement is `set`.
    getMut: function {t: this.borrow i: u64} outx t.borrow is native
    # replace element `i` of a ListVal, handing back the one displaced so its
    # ownership has somewhere to go
    set: function {:this i: u64 val: t} out t is native
    # remove the last element of a ListVal and hand back its ownership
    pop: function {:this} out t is native
    # a LINEAR scan of the ListVal for an equal element. A list is ordered, not
    # hashed, so this walks it -- a Set is the hashed one
    contains: function {t: this.view item: t} out bool is native
    # sort a ListVal in place, ascending by the element type's own ordering
    sort: function {:this} is native
    # how many elements the ListVal holds
    length: function {t: this.view} out u64 is native
    # how many elements fit before the ListVal grows again; `create` takes an
    # initial one
    capacity: function {t: this.view} out u64 is native
    # a borrowed readonly view over the whole ListVal. It pins the list, so it
    # must not outlive it
    listView: function {t: this.borrow} outx (ListViewVal t) is native
    # the readonly walk over a ListVal: a shared receiver, so several may run at
    # once and the container stays readable throughout. Elements come out BY
    # VALUE
    iterate: function {t: this.view} outx (ListIterVal :t) is native
    # the mutable walk over a ListVal: an exclusive receiver, so a COMPOUND
    # element's children may be written in place through it
    iterateMut: function {t: this.borrow} outx (ListIterVal :t) is native
    # an empty ListVal, reserving `capacity` elements up front when one is given
    create: function {capacity: 0.u64} out type is native
}

# Borrowed-view iterator over a list. listiter holds a lock on the
# source list for its lifetime; each .call yields an optionview.some
# pointing into the list's storage, or optionview.none when exhausted.
# See for-loop dispatch (rule 1) and the iterators chapter in the spec.
ListIter: class is native as {
    # the REFERENCE element type of ListIter. Uppercase says reftype, so a
    # binding of it MOVES
    T: AnyRef.generic
    # the ListIter step: the next item, or none once the walk is exhausted. A
    # `for` header drives it
    call: function {:this} outx (OptionView T) is native
}

# Borrowed-view iterator over a ListVal. The valtype twin of `ListIter`, and
# it must be its own template rather than shared: the emitter names the
# iterator struct after `iterate`'s DECLARED return and gives it a `list`
# field pointing at the container. Two containers declaring the same iterator
# type therefore emit two structs under ONE name, with different bodies --
# which typechecks and then fails at gcc with `invalid initializer`.
ListIterVal: class is native as {
    # the VALUE element type of ListIterVal. Lowercase says valtype, so a
    # binding of it COPIES
    t: anyval.generic
    # the ListIterVal step: the next item, or none once the walk is exhausted. A
    # `for` header drives it
    call: function {:this} outx (OptionView t) is native
}

# a borrowed window over a List's elements (no ownership).
ListView: class is native as {
    # the REFERENCE element type of ListView. Uppercase says reftype, so a
    # binding of it MOVES
    T: AnyRef.generic

    # the element at `i`, readonly. A ListView borrows its storage and never
    # owns it
    get: function {t: this.borrow i: u64} outx T.view is native
    # the mutable element reference, which excludes every other reference to the
    # viewed container
    getMut: function {t: this.borrow i: u64} outx T.borrow is native
    # how many elements the ListView spans
    length: function {t: this.view} out u64 is native
}

# a borrowed window over a ListVal's elements (no ownership). The valtype twin
# of `ListView`: `get` hands back a COPY of the element -- cheap, and it cannot
# alias -- while `getMut` is a reference, because a COMPOUND valtype's children
# are mutated in place through it.
ListViewVal: class is native as {
    # the VALUE element type of ListViewVal. Lowercase says valtype, so a
    # binding of it COPIES
    t: anyval.generic

    # the element at `i`, readonly. A ListViewVal borrows its storage and never
    # owns it
    get: function {t: this.borrow i: u64} out t is native
    # the mutable element reference, which excludes every other reference to the
    # viewed container
    getMut: function {t: this.borrow i: u64} outx t.borrow is native
    # how many elements the ListViewVal spans
    length: function {t: this.view} out u64 is native
}

# Bytes -- heap-mutable byte buffer. Class typedef over `list of: u8`
# so that signatures read as binary data and bytes-specific methods
# live in their own namespace. List operations flow through via the
# typedef backward-compatibility rule (list is a class).
Bytes: class { val: (ListVal u8).typedef } as {
    # Borrowed read-only view over the buffer; locks the source for
    # the lifetime of the binding (mirrors string.stringView /
    # list.listView).
    byteView: function {t: this.borrow} outx ByteView is native
}

# ByteView -- read-only borrowed view into a bytes value. Class typedef
# over `listView of: u8`. Mirrors stringView / listView lifetime rules.
ByteView: class { val: (ListViewVal u8).typedef }

# a hash map from `K` to `V`.
MapRR: class is native as {
    # the REFERENCE key type of MapRR, bounded to RefHashable: a reference key
    # must define hash and == itself, since hashing the handle would key on
    # IDENTITY
    K: RefHashable.generic
    # the REFERENCE value type of MapRR. Uppercase says reftype, so a binding of
    # it MOVES
    V: AnyRef.generic

    # the value for `key` as a borrowed OptionView into the entry, so it PINS
    # the MapRR until the view dies
    get: function {:this key: K.view} outx (OptionView V) is native
    # insert or overwrite the entry for `key` in a MapRR; the key is TAKEN
    set: function {:this key: K.take value: V.take} is native
    # whether `key` has an entry in the MapRR, without producing the value or
    # taking any lock
    has: function {t: this.view key: K.view} out bool is native
    # take the entry out of the MapRR and hand back what it held
    remove: function {:this key: K.view} out (Option V) is native
    # how many live entries the MapRR holds
    length: function {t: this.view} out u64 is native
    # how many entries fit before the MapRR grows again
    capacity: function {t: this.view} out u64 is native
    # readonly, and with no mutable twin by design: a key is hashed, so writing
    # through one in place would put the entry in the wrong bucket.
    iterate: function {t: this.view} outx (MapKeyIter :K :V) is native
    # the key-and-value walk over a MapRR, in insertion order, yielding an entry
    # with .key and .value
    iterateItems: function {t: this.borrow} outx (MapItemIter :K :V) is native
    # an empty MapRR, reserving `capacity` entries up front when one is given
    create: function {capacity: 0.u64} out type is native
}

# a hash map from a reference key to a VALUE-TYPE value.
#
# The three siblings of `Map` differ only where the family shows: a valtype key
# or value is passed BY VALUE rather than taken or viewed, and a valtype value
# comes back as an `optionval` -- a copy, so `get` takes no lock on the map at
# all, where a reference value hands back an `OptionView` into the entry
# storage and must pin it. `remove` returns an owned `Option` on the reference
# side and the same `optionval` on the value side.
MapRV: class is native as {
    # the REFERENCE key type of MapRV, bounded to RefHashable: a reference key
    # must define hash and == itself, since hashing the handle would key on
    # IDENTITY
    K: RefHashable.generic
    # the VALUE value type of MapRV. Lowercase says valtype, so a binding of it
    # COPIES
    v: anyval.generic

    # the value for `key` as an optionval -- a COPY, so it takes no lock on the
    # MapRV at all
    get: function {:this key: K.view} out (optionval v) is native
    # insert or overwrite the entry for `key` in a MapRV; the key is TAKEN
    set: function {:this key: K.take value: v} is native
    # whether `key` has an entry in the MapRV, without producing the value or
    # taking any lock
    has: function {t: this.view key: K.view} out bool is native
    # take the entry out of the MapRV and hand back what it held
    remove: function {:this key: K.view} out (optionval v) is native
    # how many live entries the MapRV holds
    length: function {t: this.view} out u64 is native
    # how many entries fit before the MapRV grows again
    capacity: function {t: this.view} out u64 is native
    # the KEY walk over a MapRV, in INSERTION order. Readonly with no mutable
    # twin by design: a key is hashed, so writing through one would strand its
    # entry in the wrong bucket
    iterate: function {t: this.view} outx (MapKeyIterRV :K :v) is native
    # the key-and-value walk over a MapRV, in insertion order, yielding an entry
    # with .key and .value
    iterateItems: function {t: this.borrow} outx (MapItemIterRV :K :v) is native
    # an empty MapRV, reserving `capacity` entries up front when one is given
    create: function {capacity: 0.u64} out type is native
}

# a hash map from a VALUE-TYPE key to a reference value. There is no `getv`:
# it exists to look a String key up by view, and a valtype key is never one.
MapVR: class is native as {
    # the VALUE key type of MapVR, bounded to valhashable: a valtype IS its
    # bytes, so the hash can be synthesised from them
    k: valhashable.generic
    # the REFERENCE value type of MapVR. Uppercase says reftype, so a binding of
    # it MOVES
    V: AnyRef.generic

    # the value for `key` as a borrowed OptionView into the entry, so it PINS
    # the MapVR until the view dies
    get: function {:this key: k} outx (OptionView V) is native
    # insert or overwrite the entry for `key` in a MapVR; the key is copied in,
    # being a valtype
    set: function {:this key: k value: V.take} is native
    # whether `key` has an entry in the MapVR, without producing the value or
    # taking any lock
    has: function {t: this.view key: k} out bool is native
    # take the entry out of the MapVR and hand back what it held
    remove: function {:this key: k} out (Option V) is native
    # how many live entries the MapVR holds
    length: function {t: this.view} out u64 is native
    # how many entries fit before the MapVR grows again
    capacity: function {t: this.view} out u64 is native
    # the KEY walk over a MapVR, in insertion order. Readonly for the reason
    # MapRV's is -- a key that changed would belong in another bucket
    iterate: function {t: this.view} outx (MapKeyIterVR :k :V) is native
    # the key-and-value walk over a MapVR, in insertion order, yielding an entry
    # with .key and .value
    iterateItems: function {t: this.borrow} outx (MapItemIterVR :k :V) is native
    # an empty MapVR, reserving `capacity` entries up front when one is given
    create: function {capacity: 0.u64} out type is native
}

# a hash map from a VALUE-TYPE key to a VALUE-TYPE value. Nothing here is
# taken, viewed or locked: both halves are copies.
MapVV: class is native as {
    # the VALUE key type of MapVV, bounded to valhashable: a valtype IS its
    # bytes, so the hash can be synthesised from them
    k: valhashable.generic
    # the VALUE value type of MapVV. Lowercase says valtype, so a binding of it
    # COPIES
    v: anyval.generic

    # the value for `key` as an optionval -- a COPY, so it takes no lock on the
    # MapVV at all
    get: function {:this key: k} out (optionval v) is native
    # insert or overwrite the entry for `key` in a MapVV; the key is copied in,
    # being a valtype
    set: function {:this key: k value: v} is native
    # whether `key` has an entry in the MapVV, without producing the value or
    # taking any lock
    has: function {t: this.view key: k} out bool is native
    # take the entry out of the MapVV and hand back what it held
    remove: function {:this key: k} out (optionval v) is native
    # how many live entries the MapVV holds
    length: function {t: this.view} out u64 is native
    # how many entries fit before the MapVV grows again
    capacity: function {t: this.view} out u64 is native
    # the KEY walk over a MapVV, in insertion order, yielding each key by value
    iterate: function {t: this.view} outx (MapKeyIterVV :k :v) is native
    # the key-and-value walk over a MapVV, in insertion order, yielding an entry
    # with .key and .value
    iterateItems: function {t: this.borrow} outx (MapItemIterVV :k :v) is native
    # an empty MapVV, reserving `capacity` entries up front when one is given
    create: function {capacity: 0.u64} out type is native
}

# Borrowed-key iterator over a map. Yields optionview.some pointing at each
# live entry''s key, optionview.none when exhausted. A Map is a compact dict --
# a dense entry array plus a separate index table -- so iteration is in
# INSERTION order: stable across runs regardless of the hash seed, and preserved
# by resize (tombstones are skipped, then reclaimed). Pair with .iterateItems
# for paired key+value views via mapentry.
MapKeyIter: class is native as {
    # the REFERENCE key type of MapKeyIter, bounded to RefHashable: a reference
    # key must define hash and == itself, since hashing the handle would key on
    # IDENTITY
    K: AnyRef.generic
    # the REFERENCE value type of MapKeyIter. Uppercase says reftype, so a
    # binding of it MOVES
    V: AnyRef.generic
    # the MapKeyIter step: the next item, or none once the walk is exhausted. A
    # `for` header drives it
    call: function {:this} outx (OptionView K) is native
}

# The family forms of the key iterator. No two Map forms can mint the same
# (key, value) mono, so these never collide in the emitted C the way the
# List/Set iterators did -- they exist because the params must name the family
# each half belongs to, and one template cannot say "either". RR keeps the
# plain name, as the `Map` alias does for `MapRR`. The value parameter never appears in a
# signature; it keeps the mono name unique per Map mono.
MapKeyIterRV: class is native as {
    # the REFERENCE key type of MapKeyIterRV, bounded to RefHashable: a
    # reference key must define hash and == itself, since hashing the handle
    # would key on IDENTITY
    K: AnyRef.generic
    # the VALUE value type of MapKeyIterRV. Lowercase says valtype, so a binding
    # of it COPIES
    v: anyval.generic
    # the MapKeyIterRV step: the next item, or none once the walk is exhausted.
    # A `for` header drives it
    call: function {:this} outx (OptionView K) is native
}

# the key iterator over a MapVR -- a value key beside a reference value. See
# MapKeyIterRV for why the family has four forms rather than one
MapKeyIterVR: class is native as {
    # the VALUE key type of MapKeyIterVR, bounded to valhashable: a valtype IS
    # its bytes, so the hash can be synthesised from them
    k: anyval.generic
    # the REFERENCE value type of MapKeyIterVR. Uppercase says reftype, so a
    # binding of it MOVES
    V: AnyRef.generic
    # the MapKeyIterVR step: the next item, or none once the walk is exhausted.
    # A `for` header drives it
    call: function {:this} outx (OptionView k) is native
}

# the key iterator over a MapVV, both halves value types. See MapKeyIterRV
# for why the family has four forms
MapKeyIterVV: class is native as {
    # the VALUE key type of MapKeyIterVV, bounded to valhashable: a valtype IS
    # its bytes, so the hash can be synthesised from them
    k: anyval.generic
    # the VALUE value type of MapKeyIterVV. Lowercase says valtype, so a binding
    # of it COPIES
    v: anyval.generic
    # the MapKeyIterVV step: the next item, or none once the walk is exhausted.
    # A `for` header drives it
    call: function {:this} outx (OptionView k) is native
}

# a hash set of unique reference `K` elements. `Set` in core is this
# template's alias.
SetRef: class is native as {
    # the REFERENCE element type of SetRef. Uppercase says reftype, so a binding
    # of it MOVES
    K: RefHashable.generic

    # add one element to a SetRef; it is TAKEN, and adding one already present
    # changes nothing
    add: function {:this item: K.take} out bool is native
    # membership in the SetRef, by hash rather than by scan
    has: function {t: this.view item: K.view} out bool is native
    # remove one element from a SetRef; removing one that is absent changes
    # nothing
    delete: function {:this item: K.view} out bool is native
    # how many elements the SetRef holds
    length: function {t: this.view} out u64 is native
    # how many elements fit before the SetRef grows again
    capacity: function {t: this.view} out u64 is native
    # readonly, and with no mutable twin: an item IS the key here (see Map).
    iterate: function {t: this.view} outx (SetIter :K) is native
    # an empty SetRef, reserving `capacity` elements up front when one is given
    create: function {capacity: 0.u64} out type is native
}

# a hash set of unique VALTYPE elements.
#
# The valtype twin of `Set`. A valtype has no ownership to transfer and no
# interior to alias, so `add` copies rather than taking and `has` / `delete`
# take the element by value: there is no view to hand them and nothing for one
# to point at. Element membership is otherwise identical -- both families hash
# the element and compare it, and both share one emitted C.
SetVal: class is native as {
    # the VALUE element type of SetVal. Lowercase says valtype, so a binding of
    # it COPIES
    k: valhashable.generic

    # add one element to a SetVal; it is copied in, being a valtype, and adding
    # one already present changes nothing
    add: function {:this item: k} out bool is native
    # membership in the SetVal, by hash rather than by scan
    has: function {t: this.view item: k} out bool is native
    # remove one element from a SetVal; removing one that is absent changes
    # nothing
    delete: function {:this item: k} out bool is native
    # how many elements the SetVal holds
    length: function {t: this.view} out u64 is native
    # how many elements fit before the SetVal grows again
    capacity: function {t: this.view} out u64 is native
    # the walk over a SetVal, in INSERTION order -- stable across runs whatever
    # the hash seed
    iterate: function {t: this.view} outx (SetIterVal :k) is native
    # an empty SetVal, reserving `capacity` elements up front when one is given
    create: function {capacity: 0.u64} out type is native
}

# Borrowed-item iterator over a set. Yields optionview.some pointing at each
# live entry''s item, optionview.none when exhausted. Same shape and the same
# INSERTION-order guarantee as MapKeyIter (a set is a map without the value
# column).
SetIter: class is native as {
    # the REFERENCE key type of SetIter, bounded to RefHashable: a reference key
    # must define hash and == itself, since hashing the handle would key on
    # IDENTITY
    K: AnyRef.generic
    # the SetIter step: the next item, or none once the walk is exhausted. A
    # `for` header drives it
    call: function {:this} outx (OptionView K) is native
}

# Borrowed-item iterator over a SetVal. The valtype twin of `SetIter`, and it
# must be its own template rather than shared: the emitter names the iterator
# struct after `iterate`'s DECLARED return and gives it a field pointing at the
# container, so two containers declaring the same iterator type emit two
# structs under ONE name with different bodies -- which typechecks and then
# fails at gcc with `invalid initializer`.
SetIterVal: class is native as {
    # the VALUE key type of SetIterVal, bounded to valhashable: a valtype IS its
    # bytes, so the hash can be synthesised from them
    k: anyval.generic
    # the SetIterVal step: the next item, or none once the walk is exhausted. A
    # `for` header drives it
    call: function {:this} outx (OptionView k) is native
}

# Borrowed-entry iterator over a map. Yields optionview.some pointing at each
# live entry, in INSERTION order (see MapKeyIter); the entry presents .key and
# .value as borrowed views via the mapentry projection.
MapItemIter: class is native as {
    # the REFERENCE key type of MapItemIter, bounded to RefHashable: a reference
    # key must define hash and == itself, since hashing the handle would key on
    # IDENTITY
    K: AnyRef.generic
    # the REFERENCE value type of MapItemIter. Uppercase says reftype, so a
    # binding of it MOVES
    V: AnyRef.generic
    # the MapItemIter step: the next item, or none once the walk is exhausted. A
    # `for` header drives it
    call: function {:this} outx (OptionView (MapEntry :K :V)) is native
}

# The family forms of the item iterator: each yields entries of its own
# MapEntry form (see MapKeyIterRV for why the forms exist at all).
MapItemIterRV: class is native as {
    # the REFERENCE key type of MapItemIterRV, bounded to RefHashable: a
    # reference key must define hash and == itself, since hashing the handle
    # would key on IDENTITY
    K: AnyRef.generic
    # the VALUE value type of MapItemIterRV. Lowercase says valtype, so a
    # binding of it COPIES
    v: anyval.generic
    # the MapItemIterRV step: the next item, or none once the walk is exhausted.
    # A `for` header drives it
    call: function {:this} outx (OptionView (MapEntryRV :K :v)) is native
}

# the item iterator over a MapVR, yielding MapEntryVR (see MapKeyIterRV for
# why the forms exist at all)
MapItemIterVR: class is native as {
    # the VALUE key type of MapItemIterVR, bounded to valhashable: a valtype IS
    # its bytes, so the hash can be synthesised from them
    k: anyval.generic
    # the REFERENCE value type of MapItemIterVR. Uppercase says reftype, so a
    # binding of it MOVES
    V: AnyRef.generic
    # the MapItemIterVR step: the next item, or none once the walk is exhausted.
    # A `for` header drives it
    call: function {:this} outx (OptionView (MapEntryVR :k :V)) is native
}

# the item iterator over a MapVV, yielding MapEntryVV
MapItemIterVV: class is native as {
    # the VALUE key type of MapItemIterVV, bounded to valhashable: a valtype IS
    # its bytes, so the hash can be synthesised from them
    k: anyval.generic
    # the VALUE value type of MapItemIterVV. Lowercase says valtype, so a
    # binding of it COPIES
    v: anyval.generic
    # the MapItemIterVV step: the next item, or none once the walk is exhausted.
    # A `for` header drives it
    call: function {:this} outx (OptionView (MapEntryVV :k :v)) is native
}

# Borrowed key+value pair from a map iteration. The C representation is a
# pointer into the source map''s entry array; .key / .value project through that
# pointer at known offsets. The entry''s liveness and hash fields are physically
# present but not addressable from zerolang.
MapEntry: class is native as {
    # the REFERENCE key type of MapEntry, bounded to RefHashable: a reference
    # key must define hash and == itself, since hashing the handle would key on
    # IDENTITY
    K: AnyRef.generic
    # the REFERENCE value type of MapEntry. Uppercase says reftype, so a binding
    # of it MOVES
    V: AnyRef.generic

    # the entry's key, as MapEntry presents it to a walk
    key: function {t: this.view} outx K.view is native
    # the entry's value, as MapEntry presents it to a walk
    value: function {t: this.view} outx V.view is native
}

# The family forms of the entry projection (see MapKeyIterRV for why).
MapEntryRV: class is native as {
    # the REFERENCE key type of MapEntryRV, bounded to RefHashable: a reference
    # key must define hash and == itself, since hashing the handle would key on
    # IDENTITY
    K: AnyRef.generic
    # the VALUE value type of MapEntryRV. Lowercase says valtype, so a binding
    # of it COPIES
    v: anyval.generic

    # the entry's key, as MapEntryRV presents it to a walk
    key: function {t: this.view} outx K.view is native
    # the entry's value, as MapEntryRV presents it to a walk
    value: function {t: this.view} out v is native
}

# the entry projection of a MapVR: a value key beside a borrowed reference
# value
MapEntryVR: class is native as {
    # the VALUE key type of MapEntryVR, bounded to valhashable: a valtype IS its
    # bytes, so the hash can be synthesised from them
    k: anyval.generic
    # the REFERENCE value type of MapEntryVR. Uppercase says reftype, so a
    # binding of it MOVES
    V: AnyRef.generic

    # the entry's key, as MapEntryVR presents it to a walk
    key: function {t: this.view} out k is native
    # the entry's value, as MapEntryVR presents it to a walk
    value: function {t: this.view} outx V.view is native
}

# the entry projection of a MapVV, where both halves are copies and neither
# pins the map
MapEntryVV: class is native as {
    # the VALUE key type of MapEntryVV, bounded to valhashable: a valtype IS its
    # bytes, so the hash can be synthesised from them
    k: anyval.generic
    # the VALUE value type of MapEntryVV. Lowercase says valtype, so a binding
    # of it COPIES
    v: anyval.generic

    # the entry's key, as MapEntryVV presents it to a walk
    key: function {t: this.view} out k is native
    # the entry's value, as MapEntryVV presents it to a walk
    value: function {t: this.view} out v is native
}

# --- id-keyed containers ---------------------------------------------------
#
# IdMap and IdSet are the APPEND-ONLY, id-keyed siblings of Map and Set. Three
# things follow from that contract and none of them is available to a Map:
#
#   * There is no `remove` and no `delete`. The whole table is freed at once,
#     so an entry never dies alone -- which means no tombstone byte and no
#     compaction pass, and `entries` is a dense insertion-ordered array with no
#     holes in it.
#   * The slot is the key's own low bits, not a hash of them, so no hash column
#     is stored and none is computed on the probe. That is what the `idkey`
#     bound is protecting: only an unsigned scalar has bits that ARE an index.
#   * The struct lives on the stack like a List, not on the heap like a Map, so
#     an empty one costs no allocation at all.
#
# Iteration and removal are what a Map has and these do not; if you need either
# one, you want a Map.

# an IdMap from an unsigned scalar id to a REFERENCE value.
IdMapR: class is native as {
    # the key type, bounded to `idkey`: an unsigned scalar, because only those
    # bits ARE an index. That bound is what IdMapR trades a hash for
    k: idkey.generic
    # the REFERENCE value type of IdMapR. Uppercase says reftype, so a binding
    # of it MOVES
    V: AnyRef.generic

    # the value for `key` as a borrowed OptionView, pinning the IdMapR
    get: function {t: this.view key: k} outx (OptionView V) is native
    # insert or overwrite the entry for the scalar `key` in an IdMapR
    set: function {:this key: k value: V.take} is native
    # the mutable twin of `get`, and the reason a Map has none: a Map's slot
    # depends on a hash OF the key, so writing through a view would strand the
    # entry in the wrong bucket. Here the slot depends on the key alone, which
    # a mutable view of the VALUE does not touch. What it buys is the value
    # family: `get` there copies out, so an update needs `set`; through this
    # the entry is written in place.
    getMut: function {t: this.borrow key: k} outx (OptionView V) is native
    # whether the scalar `key` has an entry in the IdMapR
    has: function {t: this.view key: k} out bool is native
    # positional reads over the dense, insertion-ordered entries. Position is a
    # coordinate here in a way it is not in a Map, and an ordered walk whose
    # body must reach the container's OWNER cannot hold an iterator across
    # itself. `keyAt` answers a bare id (0 past the end) because the `idkey`
    # bound makes a key a scalar; `valueAt` answers what `get` answers.
    keyAt: function {t: this.view i: u64} out k is native
    # the value at POSITION `i`, answering what `get` answers. Positional
    # because an ordered walk whose body must reach the container's owner cannot
    # hold an iterator across itself
    valueAt: function {t: this.view i: u64} outx (OptionView V) is native
    # how many live entries the IdMapR holds
    length: function {t: this.view} out u64 is native
    # how many entries fit before the IdMapR grows again
    capacity: function {t: this.view} out u64 is native
    # the entry walk over an IdMapR, in insertion order over the dense entry
    # array
    iterateItems: function {t: this.view} outx (IdMapItemIterR :k :V) is native
    # an empty IdMapR. The struct lives on the stack, so an empty one costs no
    # allocation at all
    create: function {capacity: 0.u64} out type is native
}

# an IdMap from an unsigned scalar id to a VALUE-TYPE value. Nothing here is
# taken, viewed or locked: the key is a scalar and the value is a copy.
IdMapV: class is native as {
    # the key type, bounded to `idkey`: an unsigned scalar, because only those
    # bits ARE an index. That bound is what IdMapV trades a hash for
    k: idkey.generic
    # the VALUE value type of IdMapV. Lowercase says valtype, so a binding of it
    # COPIES
    v: anyval.generic

    # the value for `key` as an optionval -- a copy, so nothing is pinned
    get: function {t: this.view key: k} out (optionval v) is native
    # insert or overwrite the entry for the scalar `key` in an IdMapV
    set: function {:this key: k value: v} is native
    # the mutable twin of `get`, and the reason a Map has none: a Map's slot
    # depends on a hash OF the key, so writing through a view would strand the
    # entry in the wrong bucket. Here the slot depends on the key alone, which
    # a mutable view of the VALUE does not touch. What it buys is the value
    # family: `get` there copies out, so an update needs `set`; through this
    # the entry is written in place.
    getMut: function {t: this.borrow key: k} outx (OptionView v) is native
    # whether the scalar `key` has an entry in the IdMapV
    has: function {t: this.view key: k} out bool is native
    # the positional pair, as IdMapR declares them; only `valueAt`'s return
    # differs, exactly as `get`'s does.
    keyAt: function {t: this.view i: u64} out k is native
    # the value at POSITION `i` as an optionval, so an IdMapV walk pins nothing
    # while its body runs
    valueAt: function {t: this.view i: u64} out (optionval v) is native
    # how many live entries the IdMapV holds
    length: function {t: this.view} out u64 is native
    # how many entries fit before the IdMapV grows again
    capacity: function {t: this.view} out u64 is native
    # the entry walk over an IdMapV, in insertion order over the dense entry
    # array
    iterateItems: function {t: this.view} outx (IdMapItemIterV :k :v) is native
    # an empty IdMapV. The struct lives on the stack, so an empty one costs no
    # allocation at all
    create: function {capacity: 0.u64} out type is native
}

# a set of unique unsigned scalar ids. One form only: an id is a valtype, so
# the reference/value split the Set family carries has nothing to divide here.
IdSet: class is native as {
    # the key type, bounded to `idkey`: an unsigned scalar, because only those
    # bits ARE an index. That bound is what IdSet trades a hash for
    k: idkey.generic

    # add one scalar id to an IdSet; adding one already present changes nothing
    add: function {:this item: k} out bool is native
    # membership in the IdSet, indexed by the id's own bits
    has: function {t: this.view item: k} out bool is native
    # how many ids the IdSet holds
    length: function {t: this.view} out u64 is native
    # how many ids fit before the IdSet grows again
    capacity: function {t: this.view} out u64 is native
    # readonly, and with no mutable twin: an item IS the key here (see Map).
    # INSERTION order, and unlike a Map's this one cannot be perforated --
    # nothing is ever removed, so the dense array IS the iteration.
    iterate: function {t: this.view} outx (IdSetIter :k) is native
    # an empty IdSet, costing no allocation until something is added
    create: function {capacity: 0.u64} out type is native
}

# Borrowed-entry iterators over an IdMap, and the entry they project. Two
# forms rather than the Map family's four: an id key is always a valtype, so
# only the VALUE side has a reference/value split to make. The key bound is
# `anyval` and not `idkey` for the reason IdSetIter's is -- the container has
# already satisfied it, and asserting it twice reports one mistake as two.
IdMapItemIterR: class is native as {
    # the key type, bounded to `idkey`: an unsigned scalar, because only those
    # bits ARE an index. That bound is what IdMapItemIterR trades a hash for
    k: anyval.generic
    # the REFERENCE value type of IdMapItemIterR. Uppercase says reftype, so a
    # binding of it MOVES
    V: AnyRef.generic
    # the IdMapItemIterR step: the next item, or none once the walk is
    # exhausted. A `for` header drives it
    call: function {:this} outx (OptionView (IdMapEntryR :k :V)) is native
}

# the item iterator over an IdMapV, yielding IdMapEntryV -- the value-side
# form of the two IdMapItemIterR describes
IdMapItemIterV: class is native as {
    # the key type, bounded to `idkey`: an unsigned scalar, because only those
    # bits ARE an index. That bound is what IdMapItemIterV trades a hash for
    k: anyval.generic
    # the VALUE value type of IdMapItemIterV. Lowercase says valtype, so a
    # binding of it COPIES
    v: anyval.generic
    # the IdMapItemIterV step: the next item, or none once the walk is
    # exhausted. A `for` header drives it
    call: function {:this} outx (OptionView (IdMapEntryV :k :v)) is native
}

# the entry an IdMapR walk projects: the scalar id beside a borrowed view of
# the value
IdMapEntryR: class is native as {
    # the key type, bounded to `idkey`: an unsigned scalar, because only those
    # bits ARE an index. That bound is what IdMapEntryR trades a hash for
    k: anyval.generic
    # the REFERENCE value type of IdMapEntryR. Uppercase says reftype, so a
    # binding of it MOVES
    V: AnyRef.generic

    # the entry's key, as IdMapEntryR presents it to a walk
    key: function {t: this.view} out k is native
    # the entry's value, as IdMapEntryR presents it to a walk
    value: function {t: this.view} outx V.view is native
}

# the entry an IdMapV walk projects: the scalar id beside a copy of the
# value, so it pins nothing
IdMapEntryV: class is native as {
    # the key type, bounded to `idkey`: an unsigned scalar, because only those
    # bits ARE an index. That bound is what IdMapEntryV trades a hash for
    k: anyval.generic
    # the VALUE value type of IdMapEntryV. Lowercase says valtype, so a binding
    # of it COPIES
    v: anyval.generic

    # the entry's key, as IdMapEntryV presents it to a walk
    key: function {t: this.view} out k is native
    # the entry's value, as IdMapEntryV presents it to a walk
    value: function {t: this.view} out v is native
}

# Borrowed-item iterator over an IdSet. Its own template rather than a shared
# one, for the reason SetIterVal spells out: the emitter names the iterator
# struct after `iterate`'s DECLARED return, so two containers declaring one
# iterator type emit two bodies under a single name.
IdSetIter: class is native as {
    # the VALUE key type of IdSetIter, bounded to valhashable: a valtype IS its
    # bytes, so the hash can be synthesised from them
    k: anyval.generic
    # the IdSetIter step: the next item, or none once the walk is exhausted. A
    # `for` header drives it
    call: function {:this} outx (OptionView k) is native
}

# stringJoin -- concatenate every string in `parts` with `sep`
# between each. Returns a fresh owned string. One allocation,
# memcpy in sequence.
#
# The `parts` list is borrowed (default convention): caller keeps
# ownership. A StringView cannot be stored in a container field (a view
# may not outlive its parent), so join takes `(List String)` rather than
# a list of views; callers that hold views must materialise owned
# strings in a list before joining.
#
# Named as a free `stringJoin` function (not `string.join` nested
# in a unit, and not a method on list) because lists are generic
# and zerolang does not yet support monomorphization-specific
# methods. Re-exported by core.z as `stringJoin`.
stringJoin: function as { T: StringLike.generic } in {
    # the strings joined, in order; an empty list gives an empty result and one
    # element gives itself
    parts: (ListRef String)
    # placed BETWEEN elements, so n of them take n-1 separators and none is
    # added at either end
    sep: T
} out String is native
