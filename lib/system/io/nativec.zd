                    if (n > 0) memcpy(buf, path.data, n);
                    buf[n] = '\0';
                #if defined(_WIN32)
                    uint64_t first = (uint64_t)z_win_root_len(buf, (size_t)n);
                    if (first == 0) first = 1;
                #else
                    uint64_t first = 1;
                #endif
                    for (uint64_t i = first; i <= n; i++) {
                #if defined(_WIN32)
                        int at_sep = i < n && (buf[i] == '/' || buf[i] == '\\');
                #else
                        int at_sep = i < n && buf[i] == '/';
                #endif
                        if (i == n || at_sep) {
                            char saved = buf[i];
                            buf[i] = '\0';
