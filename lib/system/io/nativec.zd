# nativec -- io's C implementation, a runtime.nativec file
c: runtime.nativec

# implementation -- the C behind io's native declarations
implementation: (
    c.implementation
    rows: list {
        # io -- the shared helpers first, each naming the members that pull it, then the
        # convention loads alphabetically, then File's methods in their own order and
        # the stream bundles.
        (
            c.row
            key: "@sv_to_cstr"
            demand: list { "@sv_cstr" }
            needs: list { "prelude.@xmalloc" }
            fragments: list {
                """
                static char* z_sv_to_cstr(z_@StringView@_t v) {
                    char* buf = (char*)z_xmalloc(v.size + 1);
                    if (v.size > 0) memcpy(buf, v.data, v.size);
                    buf[v.size] = '\0';
                    return buf;
                }

                """
            }
        )
        (
            c.row
            key: "@errno_map"
            demand: list { "@errno" }
            needs: list {
                "prelude.zwin32" "prelude.@String_new" "prelude.@xmalloc" "prelude.@win_error_text"
            }
            fragments: list {
                """
                /* an OS error code -> IoError: errno on POSIX, a Win32 error code (GetLastError,
                   WSAGetLastError) on Windows. A code no arm names becomes `other`, carrying
                   "<the OS's message> (os error N)" so nothing is lost in translation; so does
                   a malformed path, under `invalidpath`. POSIX's message comes from the
                   reentrant strerror_r -- the XSI form, as the prelude asks for POSIX without
                   _GNU_SOURCE -- and Windows' from FormatMessageW. */
                static z_@String@_t* z_io_os_error_text(int code) {
                    char text[640];
                #if defined(_WIN32)
                    char* msg = z_win_error_text((DWORD)code);
                    snprintf(text, sizeof text, "%s (os error %d)", msg ? msg : "unknown error", code);
                    free(msg);
                #else
                    char msg[256];
                    int failed = strerror_r(code, msg, sizeof msg);
                    snprintf(text, sizeof text, "%s (os error %d)", failed ? "unknown error" : msg, code);
                #endif
                    z_@String@_t* sp = (z_@String@_t*)z_xmalloc(sizeof(z_@String@_t));
                    *sp = z_@String@_new(text);
                    return sp;
                }

                static z_@IoError@_t z_io_os_error(int code) {
                    z_@IoError@_t r = {0};
                    r.data = NULL;
                    switch (code) {
                #if defined(_WIN32)
                        case ERROR_FILE_NOT_FOUND:
                        case ERROR_PATH_NOT_FOUND:
                        case ERROR_INVALID_DRIVE:
                        case ERROR_BAD_NETPATH:
                        case ERROR_BAD_NET_NAME:          r.tag = @ARM_IoError.notfound@; break;
                        case ERROR_ACCESS_DENIED:
                        case ERROR_SHARING_VIOLATION:
                        case ERROR_LOCK_VIOLATION:
                        case ERROR_PRIVILEGE_NOT_HELD:    r.tag = @ARM_IoError.permissiondenied@; break;
                        case WSAEINTR:                    r.tag = @ARM_IoError.interrupted@; break;
                        case ERROR_ALREADY_EXISTS:
                        case ERROR_FILE_EXISTS:           r.tag = @ARM_IoError.exists@; break;
                        case ERROR_DIRECTORY_NOT_SUPPORTED: r.tag = @ARM_IoError.isdir@; break;
                        case ERROR_DIRECTORY:             r.tag = @ARM_IoError.notdir@; break;
                        case ERROR_DISK_FULL:
                        case ERROR_HANDLE_DISK_FULL:      r.tag = @ARM_IoError.nospace@; break;
                        case ERROR_INVALID_NAME:
                        case ERROR_BAD_PATHNAME:
                        case ERROR_FILENAME_EXCED_RANGE:
                        case ERROR_NO_UNICODE_TRANSLATION:
                            r.tag = @ARM_IoError.invalidpath@;
                            r.data = z_io_os_error_text(code);
                            break;
                #else
                        case ENOENT:  r.tag = @ARM_IoError.notfound@; break;
                        case EACCES:
                        case EPERM:   r.tag = @ARM_IoError.permissiondenied@; break;
                        case EINTR:   r.tag = @ARM_IoError.interrupted@; break;
                        case EEXIST:  r.tag = @ARM_IoError.exists@; break;
                        case EISDIR:  r.tag = @ARM_IoError.isdir@; break;
                        case ENOTDIR: r.tag = @ARM_IoError.notdir@; break;
                        case ENOSPC:  r.tag = @ARM_IoError.nospace@; break;
                #endif
                        default:
                            r.tag = @ARM_IoError.other@;
                            r.data = z_io_os_error_text(code);
                            break;
                    }
                    return r;
                }
                """
            }
        )
        (
            c.row
            key: "@write_common"
            demand: list { "writeText" "appendText" }
            needs: list {
                "prelude.zwin32" "prelude.@xmalloc" "prelude.@win_open_fd" "prelude.@win_write"
                "@errno" "@sv_cstr?posix"
            }
            fragments: list {
                """
                /* shared helper: write all bytes; returns 0 ok, the OS error code on
                   failure. */
                static int z_io_write_all(int fd, const char* data, uint64_t size) {
                    uint64_t off = 0;
                    while (off < size) {
                #if defined(_WIN32)
                        int64_t n = z_win_write(fd, data + off, size - off);
                        if (n < 0) return (int)GetLastError();
                #else
                        int64_t n = write(fd, data + off, size - off);
                        if (n < 0) {
                            if (errno == EINTR) continue;
                            return errno;
                        }
                #endif
                        off += (uint64_t)n;
                    }
                    return 0;
                }

                /* shared helper: path + how it opens (1 truncates, 2 appends; the file is
                   created either way) -> write content -> close. path and content are
                   borrowed views; caller retains. */
                static z_@Result_null_IoError@_t z_io_write_common(
                    z_@StringView@_t path, z_@StringView@_t content, int how
                ) {
                    z_@Result_null_IoError@_t result = {0};
                #if defined(_WIN32)
                    int fd = z_win_open_fd(path.data, path.size, how);
                    int e = (int)GetLastError();
                #else
                    int flags = O_WRONLY | O_CREAT | (how == 2 ? O_APPEND : O_TRUNC);
                    char* path_cstr = z_sv_to_cstr(path);
                    int fd = open(path_cstr, flags | O_CLOEXEC, 0644);
                    int e = errno;
                    free(path_cstr);
                #endif
                    if (fd < 0) {
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        *boxed = z_io_os_error(e);
                        result.tag = @ARM_Result_null_IoError.err@;
                        result.data = boxed;
                        return result;
                    }
                    int werr = z_io_write_all(fd, content.data, content.size);
                #if defined(_WIN32)
                    _close(fd);
                #else
                    close(fd);
                #endif
                    if (werr != 0) {
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        *boxed = z_io_os_error(werr);
                        result.tag = @ARM_Result_null_IoError.err@;
                        result.data = boxed;
                        return result;
                    }
                    result.tag = @ARM_Result_null_IoError.ok@;
                    result.data = NULL;
                    return result;
                }
                """
            }
        )
        (
            c.row
            key: "@wrap_u64_result"
            demand: list { "file_read" "file_write" "file_seek" "@wrap_u64" }
            needs: list { "@errno" "prelude.@xmalloc" }
            fragments: list {
                """
                static z_@ResultVR_u64_IoError@_t z_io_u64_ok(uint64_t v);
                static z_@ResultVR_u64_IoError@_t z_io_u64_ok(uint64_t v) {
                    z_@ResultVR_u64_IoError@_t result = {0};
                    result.tag = @ARM_ResultVR_u64_IoError.ok@;
                    result.@MEMBER_ResultVR_u64_IoError.ok@ = v;
                    return result;
                }

                static z_@ResultVR_u64_IoError@_t z_io_u64_err(int saved_errno);
                static z_@ResultVR_u64_IoError@_t z_io_u64_err(int saved_errno) {
                    z_@ResultVR_u64_IoError@_t result = {0};
                    z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                    *boxed = z_io_os_error(saved_errno);
                    result.tag = @ARM_ResultVR_u64_IoError.err@;
                    result.data = boxed;
                    return result;
                }


                """
            }
        )
        (
            c.row
            key: "@wrap_null_result"
            demand: list { "@wrap_null" }
            needs: list { "prelude.@xmalloc" "@errno" }
            fragments: list {
                """
                static z_@Result_null_IoError@_t z_io_wrap_null_Result(int rc, int saved_errno) {
                    z_@Result_null_IoError@_t result = {0};
                    if (rc == 0) {
                        result.tag = @ARM_Result_null_IoError.ok@;
                        result.data = NULL;
                        return result;
                    }
                    z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                    *boxed = z_io_os_error(saved_errno);
                    result.tag = @ARM_Result_null_IoError.err@;
                    result.data = boxed;
                    return result;
                }


                """
            }
        )
        (
            c.row
            key: "@stat_fill"
            demand: list { "stat" "lstat" }
            needs: list { "prelude.zwin32" "prelude.@win_open" }
            fragments: list {
                """
                /* Populate fs for z_io_stat / z_io_lstat: on POSIX from a struct stat -- the
                   only behavioral split between them lives in the syscall call site (stat(2)
                   follows symlinks, lstat(2) does not) -- and on Windows from the file's handle
                   (z_io_win_stat). */
                #if defined(_WIN32)
                /* seconds since 1970 from a FILETIME's 100ns ticks since 1601 */
                static uint64_t z_io_win_unix_seconds(uint64_t ticks) {
                    const uint64_t epoch = 116444736000000000ULL;
                    return ticks > epoch ? (ticks - epoch) / 10000000ULL : 0;
                }

                static uint64_t z_io_win_ft(FILETIME ft) {
                    return ((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
                }

                /* whether the path's last component ends in an extension Windows runs */
                static int z_io_win_runnable(const char* s, size_t n) {
                    size_t i = n;
                    while (i > 0 && s[i - 1] != '/' && s[i - 1] != '\\') i--;
                    const char* dot = NULL;
                    for (size_t j = i; j < n; j++) if (s[j] == '.') dot = s + j;
                    if (dot == NULL || (size_t)(s + n - dot) != 4) return 0;
                    const char* exts[] = { ".exe", ".com", ".bat", ".cmd" };
                    for (int k = 0; k < 4; k++) {
                        int same = 1;
                        for (int c = 0; c < 4; c++) {
                            char ch = dot[c];
                            if (ch >= 'A' && ch <= 'Z') ch = (char)(ch - 'A' + 'a');
                            if (ch != exts[k][c]) same = 0;
                        }
                        if (same) return 1;
                    }
                    return 0;
                }

                /* stat (follow) or lstat (not) a path through its handle; 0, or the Win32
                   error. kind: a symbolic link or junction is `symlink` under lstat. mode is
                   synthesised as POSIX spells it: the type bits; 0444 for a read-only file,
                   else 0666; plus 0111 for a directory and for .exe, .com, .bat and .cmd.
                   device is the volume serial number, inode the file index, ctime the change
                   time. */
                static int z_io_win_stat(z_@StringView@_t path, int follow, z_@filestat@_t* fs) {
                    DWORD flags = FILE_FLAG_BACKUP_SEMANTICS | (follow ? 0 : FILE_FLAG_OPEN_REPARSE_POINT);
                    HANDLE h = z_win_open(path.data, path.size, FILE_READ_ATTRIBUTES, OPEN_EXISTING, flags);
                    if (h == INVALID_HANDLE_VALUE) return (int)GetLastError();
                    BY_HANDLE_FILE_INFORMATION bi;
                    if (!GetFileInformationByHandle(h, &bi)) {
                        int e = (int)GetLastError();
                        CloseHandle(h);
                        return e;
                    }
                    FILE_ATTRIBUTE_TAG_INFO ti;
                    memset(&ti, 0, sizeof ti);
                    if (bi.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) {
                        GetFileInformationByHandleEx(h, FileAttributeTagInfo, &ti, sizeof ti);
                    }
                    FILE_BASIC_INFO basic;
                    BOOL has_basic = GetFileInformationByHandleEx(h, FileBasicInfo, &basic, sizeof basic);
                    CloseHandle(h);
                    int is_dir = (bi.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
                    int is_link = !follow && (bi.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT)
                        && (ti.ReparseTag == IO_REPARSE_TAG_SYMLINK || ti.ReparseTag == IO_REPARSE_TAG_MOUNT_POINT);
                    uint32_t mode;
                    if (is_link) {
                        fs->@MEMBER_filestat.kind@@TAG_filekind@ = @ARM_filekind.symlink@;
                        mode = 0120000;
                    } else if (is_dir) {
                        fs->@MEMBER_filestat.kind@@TAG_filekind@ = @ARM_filekind.dir@;
                        mode = 0040000;
                    } else {
                        fs->@MEMBER_filestat.kind@@TAG_filekind@ = @ARM_filekind.file@;
                        mode = 0100000;
                    }
                    mode |= (bi.dwFileAttributes & FILE_ATTRIBUTE_READONLY) ? 0444 : 0666;
                    if (is_dir || z_io_win_runnable(path.data, path.size)) mode |= 0111;
                    fs->@MEMBER_filestat.size@ = is_dir ? 0 : (((uint64_t)bi.nFileSizeHigh << 32) | bi.nFileSizeLow);
                    fs->@MEMBER_filestat.mtimeSeconds@ = z_io_win_unix_seconds(z_io_win_ft(bi.ftLastWriteTime));
                    fs->@MEMBER_filestat.atimeSeconds@ = z_io_win_unix_seconds(z_io_win_ft(bi.ftLastAccessTime));
                    fs->@MEMBER_filestat.ctimeSeconds@ = has_basic
                        ? z_io_win_unix_seconds((uint64_t)basic.ChangeTime.QuadPart)
                        : z_io_win_unix_seconds(z_io_win_ft(bi.ftLastWriteTime));
                    fs->@MEMBER_filestat.mode@ = mode;
                    fs->@MEMBER_filestat.device@ = (uint64_t)bi.dwVolumeSerialNumber;
                    fs->@MEMBER_filestat.inode@ = ((uint64_t)bi.nFileIndexHigh << 32) | bi.nFileIndexLow;
                    fs->@MEMBER_filestat.nlink@ = (uint64_t)bi.nNumberOfLinks;
                    return 0;
                }
                #else
                static void z_io_fill_filestat(z_@filestat@_t* fs, const struct stat* sb);
                static void z_io_fill_filestat(z_@filestat@_t* fs, const struct stat* sb) {
                    if (S_ISREG(sb->st_mode))       fs->@MEMBER_filestat.kind@@TAG_filekind@ = @ARM_filekind.file@;
                    else if (S_ISDIR(sb->st_mode))  fs->@MEMBER_filestat.kind@@TAG_filekind@ = @ARM_filekind.dir@;
                    else if (S_ISLNK(sb->st_mode))  fs->@MEMBER_filestat.kind@@TAG_filekind@ = @ARM_filekind.symlink@;
                    else                            fs->@MEMBER_filestat.kind@@TAG_filekind@ = @ARM_filekind.other@;
                    fs->@MEMBER_filestat.size@ = (uint64_t)sb->st_size;
                    fs->@MEMBER_filestat.mtimeSeconds@ = (uint64_t)sb->st_mtime;
                    fs->@MEMBER_filestat.atimeSeconds@ = (uint64_t)sb->st_atime;
                    fs->@MEMBER_filestat.ctimeSeconds@ = (uint64_t)sb->st_ctime;
                    fs->@MEMBER_filestat.mode@ = (uint32_t)sb->st_mode;
                    fs->@MEMBER_filestat.device@ = (uint64_t)sb->st_dev;
                    fs->@MEMBER_filestat.inode@ = (uint64_t)sb->st_ino;
                    fs->@MEMBER_filestat.nlink@ = (uint64_t)sb->st_nlink;
                }
                #endif
                """
            }
        )
        (
            c.row
            key: "appendText"
            fragments: list {
                """
                static z_@Result_null_IoError@_t z_io_appendText(
                    z_@StringView@_t path, z_@StringView@_t content
                ) {
                    return z_io_write_common(path, content, 2);
                }


                """
            }
        )
        (
            c.row
            key: "eprintln"
            needs: list { "prelude.@write_line" }
            fragments: list {
                """
                static void z_io_eprintln(z_@StringView@_t sv) {
                    z_write_line(2, sv.data, sv.size, 1);
                }


                """
            }
        )
        (
            c.row
            key: "exists"
            needs: list { "prelude.zwin32" "prelude.@win_path" "@sv_cstr?posix" }
            fragments: list {
                """
                static bool z_io_exists(z_@StringView@_t path) {
                #if defined(_WIN32)
                    wchar_t* w = z_win_path(path.data, path.size);
                    if (w == NULL) return false;
                    DWORD a = GetFileAttributesW(w);
                    free(w);
                    return a != INVALID_FILE_ATTRIBUTES;
                #else
                    char* path_cstr = z_sv_to_cstr(path);
                    int r = access(path_cstr, F_OK);
                    free(path_cstr);
                    return r == 0;
                #endif
                }
                """
            }
        )
        (
            c.row
            key: "listDir"
            needs: list {
                "prelude.@String_new" "prelude.zwin32" "prelude.@xmalloc" "prelude.@win_path"
                "prelude.@win_utf8" "@errno" "@sv_cstr?posix"
            }
            members: list { "List_String.create" "List_String.append" }
            fragments: list {
                """
                /* Enumerate directory entries via opendir/readdir/closedir, or on
                   Windows FindFirstFileExW/FindNextFileW over `path\*`.
                   Returns bare entry names (not full paths), skipping `.` and
                   `..`, in filesystem order. The list is constructed on stack and
                   then boxed heap-side so the result union's void* data can
                   carry it; the compiler-generated result destructor calls
                   z_@List_String@_destroy on the ok payload, which in turn frees
                   each entry's z_@String@_t. */
                static z_@Result_List_String_IoError@_t z_io_listDir(z_@StringView@_t path);
                static z_@Result_List_String_IoError@_t z_io_listDir(z_@StringView@_t path) {
                    z_@Result_List_String_IoError@_t result = {0};
                #if defined(_WIN32)
                    /* path\* -- a root or a path ending in a separator takes just the * */
                    char* pat = (char*)z_xmalloc(path.size + 3);
                    if (path.size > 0) memcpy(pat, path.data, path.size);
                    size_t pn = path.size;
                    if (pn > 0 && pat[pn - 1] != '/' && pat[pn - 1] != '\\' && pat[pn - 1] != ':') pat[pn++] = '\\';
                    pat[pn++] = '*';
                    wchar_t* w = path.size > 0 ? z_win_path(pat, pn) : NULL;
                    free(pat);
                    WIN32_FIND_DATAW fd;
                    HANDLE d = INVALID_HANDLE_VALUE;
                    if (w != NULL) {
                        d = FindFirstFileExW(w, FindExInfoBasic, &fd, FindExSearchNameMatch, NULL, FIND_FIRST_EX_LARGE_FETCH);
                    } else if (path.size == 0) {
                        SetLastError(ERROR_PATH_NOT_FOUND);
                    }
                    int e = (int)GetLastError();
                    free(w);
                    int empty = 0;
                    if (d == INVALID_HANDLE_VALUE && path.size > 0) {
                        /* what the path itself is decides: a directory with nothing in it (a
                           volume's root holds no `.`), or a file, which is notdir as on POSIX */
                        wchar_t* wp = z_win_path(path.data, path.size);
                        DWORD a = wp != NULL ? GetFileAttributesW(wp) : INVALID_FILE_ATTRIBUTES;
                        free(wp);
                        if (a != INVALID_FILE_ATTRIBUTES) {
                            if (a & FILE_ATTRIBUTE_DIRECTORY) {
                                if (e == ERROR_FILE_NOT_FOUND) empty = 1;
                            } else {
                                e = ERROR_DIRECTORY;
                            }
                        }
                    }
                    if (d == INVALID_HANDLE_VALUE && !empty) {
                #else
                    char* path_cstr = z_sv_to_cstr(path);
                    DIR* d = opendir(path_cstr);
                    int e = errno;
                    free(path_cstr);
                    if (!d) {
                #endif
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        *boxed = z_io_os_error(e);
                        result.tag = @ARM_Result_List_String_IoError.err@;
                        result.data = boxed;
                        return result;
                    }
                    z_@List_String@_t list = z_@List_String@_create((uint64_t)0);
                #if defined(_WIN32)
                    if (!empty) {
                        do {
                            const wchar_t* nm = fd.cFileName;
                            if (nm[0] == L'.' && (nm[1] == 0 || (nm[1] == L'.' && nm[2] == 0))) continue;
                            char* u = z_win_utf8(nm, -1, NULL);
                            if (u == NULL) continue;
                            z_@List_String@_append(&list, z_@String@_new(u));
                            free(u);
                        } while (FindNextFileW(d, &fd));
                        FindClose(d);
                    }
                #else
                    struct dirent* entry;
                    errno = 0;
                    while ((entry = readdir(d)) != NULL) {
                        const char* name = entry->d_name;
                        if (name[0] == '.' && (name[1] == '\0' ||
                            (name[1] == '.' && name[2] == '\0'))) continue;
                        z_@List_String@_append(&list, z_@String@_new(name));
                    }
                    closedir(d);
                #endif
                    z_@List_String@_t* boxed = (z_@List_String@_t*)z_xmalloc(sizeof(z_@List_String@_t));
                    *boxed = list;
                    result.tag = @ARM_Result_List_String_IoError.ok@;
                    result.data = boxed;
                    return result;
                }


                """
            }
        )
        (
            c.row
            key: "lstat"
            needs: list { "prelude.@xmalloc" "@errno" "@sv_cstr?posix" }
            fragments: list {
                """
                /* lstat(2) — like stat but does not follow symlinks. The SYMLINK
                   arm of filekind fires here when the target path is a symlink. */
                static z_@Result_filestat_IoError@_t z_io_lstat(z_@StringView@_t path);
                static z_@Result_filestat_IoError@_t z_io_lstat(z_@StringView@_t path) {
                    z_@Result_filestat_IoError@_t result = {0};
                    z_@filestat@_t fs = {0};
                #if defined(_WIN32)
                    int e = z_io_win_stat(path, 0, &fs);
                    int rc = e == 0 ? 0 : -1;
                #else
                    char* path_cstr = z_sv_to_cstr(path);
                    struct stat sb;
                    int rc = lstat(path_cstr, &sb);
                    int e = errno;
                    free(path_cstr);
                    if (rc == 0) z_io_fill_filestat(&fs, &sb);
                #endif
                    if (rc != 0) {
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        *boxed = z_io_os_error(e);
                        result.tag = @ARM_Result_filestat_IoError.err@;
                        result.data = boxed;
                        return result;
                    }
                    z_@filestat@_t* boxed = (z_@filestat@_t*)z_xmalloc(sizeof(z_@filestat@_t));
                    *boxed = fs;
                    result.tag = @ARM_Result_filestat_IoError.ok@;
                    result.data = boxed;
                    return result;
                }


                """
            }
        )
        (
            c.row
            key: "mkdir"
            needs: list { "prelude.zwin32" "prelude.@win_path" "@sv_cstr?posix" "@wrap_null" }
            fragments: list {
                """
                /* mkdir -- one directory, mode 0755 on POSIX; Windows has no mode bits, and the
                   directory inherits its parent's access control. */
                static z_@Result_null_IoError@_t z_io_mkdir(z_@StringView@_t path) {
                #if defined(_WIN32)
                    wchar_t* w = z_win_path(path.data, path.size);
                    int rc = (w != NULL && CreateDirectoryW(w, NULL)) ? 0 : -1;
                    int e = (int)GetLastError();
                    free(w);
                #else
