                    return self;
                }


                """
            }
        )
        (
            c.row
            key: "TextReader.readLine"
            demand: list { "@tr_readLine" }
            needs: list { "system.utf8" "prelude.@xmalloc" "@utf8_validate" }
            fragments: list {
                """
                /* textreader.read_line -- scan `buf` for LF; if none present pull
                   another chunk from the underlying bufreader. On finding LF split
                   at that offset, validate the line (without its LF) as UTF-8,
                   emit `ioerror.badencoding` on failure or `result.ok(line)` on
                   success. On a zero-byte read with buf non-empty, surface the
                   unterminated tail once; with buf empty, surface `ioerror.eof`. Both
                   success paths break out with `line` set so the body ends in its
                   return -- c2mir miscompiles a struct return otherwise. */
                static z_@Result_String_IoError@_t z_@TextReader@_readLine(
                    z_@TextReader@_t* self
                );
                static z_@Result_String_IoError@_t z_@TextReader@_readLine(
                    z_@TextReader@_t* self
                ) {
                    uint64_t scan_start = 0;
                    z_@String@_t line = {0};
                    bool found = false;
                    for (;;) {
                        for (uint64_t i = scan_start; i < self->@MEMBER_TextReader.buf@.length; i++) {
                            if (self->@MEMBER_TextReader.buf@.data[i] == (uint8_t)'\n') {
                                if (!z_io_utf8_is_valid(self->@MEMBER_TextReader.buf@.data, i)) {
                                    return z_io_String_err_arm(@ARM_IoError.badencoding@);
                                }
                                line.size = i;
                                line.capacity = i + 1;
                                line.data = (char*)z_xmalloc(line.capacity + 1);
                                if (i > 0) memcpy(line.data, self->@MEMBER_TextReader.buf@.data, i);
                                line.data[i] = '\0';
                                uint64_t tail = self->@MEMBER_TextReader.buf@.length - (i + 1);
                                if (tail > 0) {
                                    memmove(self->@MEMBER_TextReader.buf@.data, self->@MEMBER_TextReader.buf@.data + i + 1, tail);
                                }
                                self->@MEMBER_TextReader.buf@.length = tail;
                                found = true;
                                break;
                            }
                        }
                        if (found) break;
                        scan_start = self->@MEMBER_TextReader.buf@.length;
                        uint64_t cap = self->@MEMBER_TextReader.source@->@MEMBER_BufReader.cap@;
                        if (cap == 0) cap = 4096;
                        z_@ResultVR_u64_IoError@_t rr = z_@BufReader@_read(
                            self->@MEMBER_TextReader.source@, &self->@MEMBER_TextReader.buf@, cap
                        );
                        if (rr.tag != @ARM_ResultVR_u64_IoError.ok@) {
                            z_@Result_String_IoError@_t result = {0};
                            result.tag = @ARM_Result_String_IoError.err@;
                            result.data = rr.data;
                            return result;
                        }
                        uint64_t n = rr.@MEMBER_ResultVR_u64_IoError.ok@;
                        if (n == 0) {
                            if (self->@MEMBER_TextReader.buf@.length == 0) {
                                return z_io_String_err_arm(@ARM_IoError.eof@);
                            }
                            uint64_t size = self->@MEMBER_TextReader.buf@.length;
                            if (!z_io_utf8_is_valid(self->@MEMBER_TextReader.buf@.data, size)) {
                                return z_io_String_err_arm(@ARM_IoError.badencoding@);
                            }
                            line.size = size;
                            line.capacity = size + 1;
                            line.data = (char*)z_xmalloc(line.capacity + 1);
                            if (size > 0) memcpy(line.data, self->@MEMBER_TextReader.buf@.data, size);
                            line.data[size] = '\0';
                            self->@MEMBER_TextReader.buf@.length = 0;
                            break;
                        }
                    }
                    return z_io_String_ok(line);
                }


                """
            }
        )
        # the statement-special: no fragment of its own, so the row states only that
        # the compiler supplies it
        (c.row key: "print")
        # the three streams: a Reader or Writer borrowed over a static File on fd 0, 1
        # or 2. The File holds nothing of its own, so nothing ever closes it
        (
            c.row
            key: "stdin"
            fragments: list {
                """
                static z_@Reader@_t z_@BOX_File.Reader@(const z_@File@_t* val);
                static z_@File@_t z_io_stdin_File = { .@MEMBER_File.fd@ = 0, .@MEMBER_File.open@ = false };
                static z_@Reader@_t z_io_stdin(void);
                static z_@Reader@_t z_io_stdin(void) {
                    return z_@BOX_File.Reader@(&z_io_stdin_File);
                }

                """
            }
        )
        (
            c.row
            key: "stdout"
            fragments: list {
                """
                static z_@Writer@_t z_@BOX_File.Writer@(const z_@File@_t* val);
                static z_@File@_t z_io_stdout_File = { .@MEMBER_File.fd@ = 1, .@MEMBER_File.open@ = false };
                static z_@Writer@_t z_io_stdout(void);
                static z_@Writer@_t z_io_stdout(void) {
                    return z_@BOX_File.Writer@(&z_io_stdout_File);
                }

                """
            }
        )
        (
            c.row
            key: "stderr"
            fragments: list {
                """
                static z_@Writer@_t z_@BOX_File.Writer@(const z_@File@_t* val);
                static z_@File@_t z_io_stderr_File = { .@MEMBER_File.fd@ = 2, .@MEMBER_File.open@ = false };
                static z_@Writer@_t z_io_stderr(void);
                static z_@Writer@_t z_io_stderr(void) {
                    return z_@BOX_File.Writer@(&z_io_stderr_File);
                }

                """
            }
        )
    }
    classes: list {
        # a File is runtime-owned: its struct is its declaration's, its destructor closes
        # the fd once, and it is live -- its Reader/Writer/Closer/Seeker natives demanded
        # -- once the byte-buffer monos its read and write take exist
        (
            c.classRow
            key: "File"
            live: list { "ListVal_u8" "ListViewVal_u8" }
            destroy: """
                static void z_@File@_destroy(z_@File@_t* p) {
                    if (!p) return;
                    if (!p->@MEMBER_File.open@) return;
                #if defined(_WIN32)
                    _close(p->@MEMBER_File.fd@);
                #else
                    close(p->@MEMBER_File.fd@);
                #endif
                    p->@MEMBER_File.open@ = false;
                }
                """
        )
    }
    canons: list {
        (c.canon stem: "Box_filestat" spec: list { "Box" "io.filestat" })
        (c.canon stem: "Result_filestat_IoError" spec: list { "Result" "@Box_filestat" "IoError" })
        (c.canon stem: "Result_String_IoError" spec: list { "Result" "String" "IoError" })
        (c.canon stem: "Result_File_IoError" spec: list { "Result" "File" "IoError" })
        (c.canon stem: "Result_null_IoError" spec: list { "Result" "null" "IoError" })
        (c.canon stem: "ResultVR_u64_IoError" spec: list { "ResultVR" "u64" "IoError" })
        (c.canon stem: "ResultVR_bool_IoError" spec: list { "ResultVR" "bool" "IoError" })
        (c.canon stem: "Result_List_String_IoError" spec: list { "Result" "@List_String" "IoError" }
        )
    }
