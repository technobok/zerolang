# sync -- share data between threads safely.
#
# A Mutex, an RwLock, a Condvar, a Barrier and the atomics are HANDLES: each
# is a pointer to one block of shared state, `x.share` makes another handle to
# the same block, and the block lives until its last handle ends. Each thread
# owns its own handle -- `c: x.share` moved into a task -- and changes the
# shared state through a borrow of it; a `.view` of a handle only reads. A
# guard keeps the handle it locked through, so a second lock through one
# handle while a guard lives is refused. A channel is two owned ends instead: a
# Receiver, and the Senders it makes, each moved to the thread that uses it.
#
# The lock guards conform to `thread.ThreadBound`: a guard unlocks on the thread
# that locked, so it never reaches another thread.

# memoryorder -- how an atomic operation orders the memory around it, as C11
# and Rust name the orderings. `seqCst` is the default and the one to reach for:
# the weaker orders are for code that has proved it needs them.
memoryorder: variant {
    # the operation alone is atomic; nothing around it is ordered
    relaxed: null
    # a load: what the thread that stored with release wrote before is seen after
    acquire: null
    # a store: what this thread wrote before is seen by an acquire load after
    release: null
    # a read-modify-write that is both acquire and release
    acqRel: null
    # acqRel, and every seqCst operation of every thread in one total order
    seqCst: null
}

# atomicint -- the integer types an Atomic holds: those every target updates
# in one instruction
atomicint: variant { :i32 :i64 :u32 :u64 }

# Atomic -- an integer every thread may read and change at once, each
# operation whole. `load` with `release` or `acqRel`, or `store` with `acquire`
# or `acqRel`, is no ordering C allows, and panics.
Atomic: class is native as {
    # the integer type
    t: atomicint.generic
    :Drop
    # an Atomic holding `value`
    create: function {value: t} out type is native
    # another handle to the same integer
    share: function {:this} out type is native
    # the value it holds
    load: function {t: this.view order: memoryorder.seqCst} out t is native
    # replace the value
    store: function {:this value: t order: memoryorder.seqCst} is native
    # replace the value, and answer the one it held (C11's exchange: `swap` is
    # zerolang's statement)
    exchange: function {:this value: t order: memoryorder.seqCst} out t is native
    # store `new` if it holds `current`; answer what it held, so it stored
    # exactly when the answer is `current`. `order` is the success ordering;
    # a failure orders as `order`'s load half
    compareExchange: function {:this current: t new: t order: memoryorder.seqCst} out t is native
    # add `value` (wrapping), and answer the value it held
    fetchAdd: function {:this value: t order: memoryorder.seqCst} out t is native
    # subtract `value` (wrapping), and answer the value it held
    fetchSub: function {:this value: t order: memoryorder.seqCst} out t is native
}

# AtomicI32 -- an i32 every thread may read and change at once
AtomicI32: Atomic i32

# AtomicI64 -- an i64 every thread may read and change at once
AtomicI64: Atomic i64

# AtomicU32 -- a u32 every thread may read and change at once
AtomicU32: Atomic u32

# AtomicU64 -- a u64 every thread may read and change at once
AtomicU64: Atomic u64

# AtomicBool -- a flag every thread may read and change at once
AtomicBool: class is native as {
    :Drop
    # an AtomicBool holding `value`
    create: function {value: bool} out type is native
    # another handle to the same flag
    share: function {:this} out type is native
    # the value it holds
    load: function {t: this.view order: memoryorder.seqCst} out bool is native
    # replace the value
    store: function {:this value: bool order: memoryorder.seqCst} is native
    # replace the value, and answer the one it held (C11's exchange: `swap` is
    # zerolang's statement)
    exchange: function {:this value: bool order: memoryorder.seqCst} out bool is native
    # store `new` if it holds `current`; answer what it held
    compareExchange: function {
        :this current: bool new: bool order: memoryorder.seqCst
    } out bool is native
}

# Mutex -- a value of T that one thread at a time reaches. `lock` waits until
# no other thread holds the lock, and answers the guard through which the value
# is read and written; the lock is released when the guard ends. The Mutex owns
# its value: it is moved in by `create`, and nothing reaches it but a guard.
Mutex: class is native as {
    T: AnyRef.generic
    :Drop
    # a Mutex owning `value`
    create: function {value: T.take} out type is native
    # another handle to the same Mutex
    share: function {:this} out type is native
    # wait for the lock, and answer the guard that holds it. The guard keeps
    # this handle, so it can neither be dropped nor lock again while the guard
    # lives
    lock: function {:this} outx MutexGuard T is native
}

# MutexGuard -- the lock on a Mutex, held: `value` reaches what the Mutex owns,
# and destroying the guard unlocks
MutexGuard: class is native as {
    T: AnyRef.generic
    :Drop
    bound: thread.ThreadBound
    # the Mutex's value, to read and write while the guard lives
    value: function {:this} outx T.borrow is native
    # unlock, wait until `cond` is notified, then lock again
    wait: function {:this cond: Condvar} is native
    # as `wait`, but for at most `ms` milliseconds; answer whether it timed out
    waitTimeout: function {:this cond: Condvar ms: u64} out bool is native
}

# RwLock -- a value of T that many threads may read at once, or one thread
# write. `read` and `write` wait as a Mutex's `lock` does, and answer the guard
# for each; a write waits for every reader to finish.
RwLock: class is native as {
    T: AnyRef.generic
    :Drop
    # an RwLock owning `value`
    create: function {value: T.take} out type is native
    # another handle to the same RwLock
    share: function {:this} out type is native
    # wait until no thread writes, and answer a guard that reads
    read: function {:this} outx ReadGuard T is native
    # wait until no thread reads or writes, and answer a guard that writes
    write: function {:this} outx WriteGuard T is native
}

# ReadGuard -- a read lock on an RwLock, held; destroying it unlocks
ReadGuard: class is native as {
    T: AnyRef.generic
    :Drop
    bound: thread.ThreadBound
    # the RwLock's value, to read while the guard lives
    value: function {t: this.view} outx T.view is native
}

# WriteGuard -- the write lock on an RwLock, held; destroying it unlocks
WriteGuard: class is native as {
    T: AnyRef.generic
    :Drop
    bound: thread.ThreadBound
    # the RwLock's value, to read and write while the guard lives
    value: function {:this} outx T.borrow is native
}

# Condvar -- where threads wait for a condition another thread makes true. A
# thread holding a Mutex's guard waits with `guard.wait cond: cv`, which unlocks
# while it waits and locks again before it returns; another thread changes the
# value under the lock and calls `notifyOne` or `notifyAll`. A wait may return
# with nothing notified, so the waiter checks its condition in a loop.
Condvar: class is native as {
    :Drop
    # a Condvar nothing waits on
    create: function out type is native
    # another handle to the same Condvar
    share: function {:this} out type is native
    # wake one waiting thread, if any waits
    notifyOne: function {:this} is native
    # wake every waiting thread
    notifyAll: function {:this} is native
}

# Barrier -- where `count` threads wait for each other: each `wait` returns
# once `count` threads have called it, and the barrier is ready for the next
# round. One of each round's threads is told it is the leader.
Barrier: class is native as {
    :Drop
    # a barrier for `count` threads
    create: function {count: u64} out type is native
    # another handle to the same barrier
    share: function {:this} out type is native
    # wait for the round's other threads; answer whether this one is the leader
    wait: function {:this} out bool is native
}

# Receiver -- the reading end of a channel, which owns the channel: threads
# send values to it through Senders it makes (`rx.sender`, then `tx.copy`),
# and it receives each value once, in the order sent. A Receiver of capacity 0
# grows as it must; one with a capacity holds at most that many, and a send
# waits for room. The channel ends when every Sender is gone: `receive` drains
# what is left, then answers none, and `for each x: rx` stops. When the
# Receiver ends first, a send answers false and the value is destroyed where
# it was sent, and what was queued is destroyed with the Receiver.
Receiver: class is native as {
    # the values' type
    T: AnyRef.generic
    :Drop
    # an empty channel holding at most `capacity` values; 0 for no limit
    create: function {capacity: 0.u64} out type is native
    # a new sending end
    sender: function {:this} out Sender T is native
    # wait for a value and take it; none once every Sender is gone and the
    # channel is empty
    receive: function {:this} out Option T is native
    # take a value if one is waiting; none when the channel is empty
    tryReceive: function {:this} out Option T is native
    # the values as they come, until every Sender is gone
    iterate: function {:this} outx ReceiverIter T is native
    # the most values it holds; 0 for no limit
    capacity: function {t: this.view} out u64 is native
}

# Sending -- a marker: a sending end of a channel, which `close` ends
Sending: protocol {}

# Sender -- a sending end of a Receiver's channel. Copying it makes another;
# the channel ends when the last one does.
Sender: class is native as {
    # the values' type
    T: AnyRef.generic
    :Drop
    :Sending
    # move `value` in, waiting while the channel is full; false, the value
    # destroyed here, once the Receiver is gone
    send: function {:this value: T.take} out bool is native
    # another sending end of the same channel
    copy: function {:this} out type is native
}

# ReceiverIter -- a Receiver walked by `for each`
ReceiverIter: class is native as {
    # the values' type
    T: AnyRef.generic
    # wait for the next value; none once every Sender is gone and the channel
    # is empty
    call: function {:this} out Option T is native
}

# ReceiverVal -- Receiver for a value type: each value is copied in and out
ReceiverVal: class is native as {
    t: anyval.generic
    :Drop
    # an empty channel of values holding at most `capacity`; 0 for no limit
    create: function {capacity: 0.u64} out type is native
    # a new sending end for values
    sender: function {:this} out SenderVal t is native
    # wait for a value; none once every SenderVal is gone and nothing is left
    receive: function {:this} out optionval t is native
    # a value if one is waiting; none when nothing is
    tryReceive: function {:this} out optionval t is native
    # the values as they come
    iterate: function {:this} outx ReceiverIterVal t is native
    # the most values it holds, 0 for none
    capacity: function {t: this.view} out u64 is native
}

# SenderVal -- Sender for a value type
SenderVal: class is native as {
    t: anyval.generic
    :Drop
    :Sending
    # copy `value` in, waiting for room; false once the ReceiverVal is gone
    send: function {:this value: t} out bool is native
    # another SenderVal of the same channel
    copy: function {:this} out type is native
}

# ReceiverIterVal -- a ReceiverVal walked by `for each`
ReceiverIterVal: class is native as {
    t: anyval.generic
    # wait for the next value, none at the end
    call: function {:this} out optionval t is native
}

# close -- end a Sender (or a SenderVal) before its scope does: the channel
# ends when the last one has, so a receiver waiting for more stops waiting
close: function {sender: S.take} is {
    sender.drop
} as {
    S: Sending.generic
}
