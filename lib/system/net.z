# net -- TCP sockets on localhost plus readiness polling: the transport
# for tool daemons (zls --listen). The v1 surface is deliberately small:
# a loopback listener, accept/connect producing bidirectional
# connections that satisfy the io Reader/Writer protocols, and readiness
# polling with a millisecond timeout (each handle's pollReadable). A
# connection or listener closes when its owner goes out of scope; `close`
# ends it early, and a second close is a safe no-op.

# Public interface -- the definitions other units may reference; all other
# top-level definitions are private to this unit.
public: unit {
    :socket
    :Listener
    :Conn
    :listen
    :connect
}

# socket -- the operating system's socket: a descriptor on POSIX, a SOCKET on
# Windows, which is a 64-bit handle. Opaque: nothing but the runtime reads it.
socket: typedef i64

# Listener -- a bound, listening TCP socket on 127.0.0.1.
Listener: class {
    # the bound, listening socket that accept takes connections from
    sock: socket
    # the port it listens on: the one asked for, or the one the system chose
    # when listen was asked for port 0
    port: u16
    # whether it holds its socket: false once close has run, and in a Listener
    # whose value moved out, which makes the destructor idempotent
    open: bool
} as {
    # block until a peer connects, answering the connection. Each call answers a
    # DIFFERENT one; the listener stays open
    accept: function {:this} out (Result Conn E: IoError) is native
    # stop listening and release the socket. Calling it twice answers ok null
    close: function {:this} out (Result null E: IoError) is native
    # whether a peer is waiting to be accepted within `timeoutMillis`; 0 asks
    # without waiting. An interrupted wait reports not-ready
    pollReadable: function {t: this.view timeoutMillis: i32} out (ResultVR bool E: IoError
    ) is native
}

# Conn -- one bidirectional TCP connection. `read` appends up to `max`
# bytes (0 read = the peer closed); `write` loops until every byte is
# out.
Conn: class {
    # the socket for this connection
    sock: socket
    # whether it holds its socket: false once close has run, and in a Conn whose
    # value moved out, which makes the destructor idempotent
    open: bool
} as {
    :Reader
    :Writer
    # read up to `max` bytes into `into`, answering how many arrived. 0 means
    # the peer closed its end, which is this stream's EOF
    read: function {:this into: Bytes max: u64} out (ResultVR u64 E: IoError) is native
    # write the view's bytes, answering how many actually went -- it may be
    # fewer, so a caller loops
    write: function {:this from: ByteView} out (ResultVR u64 E: IoError) is native
    # push anything buffered to the peer
    flush: function {:this} out (Result null E: IoError) is native
    # shut the connection and release the socket. Calling it twice answers ok
    # null
    close: function {:this} out (Result null E: IoError) is native
    # whether data (or the peer's close, to drain) is waiting within
    # `timeoutMillis`; 0 asks without waiting. An interrupted wait reports
    # not-readable
    pollReadable: function {t: this.view timeoutMillis: i32} out (ResultVR bool E: IoError
    ) is native
}

# listen -- bind + listen on 127.0.0.1:<port>, backlog 16. Port 0 asks the
# system for a free port; the Listener's `port` says which it chose. A port
# another socket holds is refused (on Windows SO_EXCLUSIVEADDRUSE says so;
# POSIX's SO_REUSEADDR only lets a port in TIME_WAIT be taken again).
listen: function {port: u16} out (Result Listener E: IoError) is native

# connect -- open a client connection to 127.0.0.1:<port>.
connect: function {port: u16} out (Result Conn E: IoError) is native
