# Virtual filesystem used by the compiler for source resolution.
# Providers (null, in-memory, real-filesystem) register with a
# ZVfs, which keeps a dentry table indexed by entry id and resolves
# walk/stat/open against the appropriate provider. The binary built
# from this file is a script-driven dispatcher: it reads a script
# file (one verb per line) and prints one line per verb to stdout,
# exercising every public verb against the goldens under
# tests/fixtures/zvfs_ops/.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :DentryTable
    :NullProvider
    :OpenResult
    :ProviderBox
    :ProviderTable
    :StringProvider
    :ZVfs
    :bindkind
    :dentry
    :dirdata
    :filedata
    :fsno
    :mountdata
    :notfounddata
}

# fsno -- a registered file's id in the vfs dentry space; 0 is "no file"
# (synthesized nodes, typecheck-minted diagnostics). A typedef so a file id
# cannot cross with the other numeric id spaces; equality is same-space
# only, and sentinel checks read the base explicitly (f.u32 == 0).
fsno: record { val: u32.typedef } as {
    # identity by index: two fsnos name the same entry when their indices match,
    # there being nothing else to an fsno
    ==: function {:this rhs: fsno} out bool is {
        return this.u32 == rhs.u32
    }
}

# the kind of a resolved VFS node: dir, file, or notfound.
nodekind: variant {
    # a directory, which a walk may descend into
    dir: null
    # a regular file, which open may read
    file: null
    # nothing there. A RESOLVED absence, cached like any other answer rather
    # than re-walked each time
    notfound: null
}

# how a mount overlays its parent: instead / before / after.
bindkind: variant {
    # the new root REPLACES the old one, and the mount carries no second arm at
    # all
    instead: null
    # the new root is searched FIRST, the old one kept as the mount's second arm
    before: null
    # the old root is searched first and the new one after it, the old kept as
    # the mount's FIRST arm
    after: null
}

# a resolved-but-absent VFS entry: parent, provider, and node ids.
notfounddata: record {
    # the directory entry this absence hangs under
    parentid: fsno
    # which registered provider owns this absence
    providerid: u32
    # the provider's OWN id for this absence, which only that provider can
    # interpret
    nodeid: u32
}

# a VFS file entry: parent, provider, and node ids.
filedata: record {
    # the directory entry this file hangs under
    parentid: fsno
    # which registered provider owns this file
    providerid: u32
    # the provider's OWN id for this file, which only that provider can
    # interpret
    nodeid: u32
}

# a VFS directory entry: parent, provider, and node ids.
dirdata: record {
    # the directory entry this directory hangs under
    parentid: fsno
    # which registered provider owns this directory
    providerid: u32
    # the provider's OWN id for this directory, which only that provider can
    # interpret
    nodeid: u32
}

# a VFS mount overlaying up to two child subtrees (`first`/`second`).
mountdata: record {
    # the entry this mount hangs under
    parentid: fsno
    # the root searched first
    first: fsno
    # the root searched after `first`; meaningful only when has_second
    second: fsno
    # whether `second` holds a root at all. An `instead` bind leaves it unset,
    # which is the whole difference between it and the other two
    has_second: bool
}

# mountinfo -- value-type carrier used by ZVfs.walk to drop the
# entrytable borrow before recursing into the mount's first/second
# arms. `is_mount` distinguishes the mount-vs-non-mount case at the
# helper boundary; the rest mirrors mountdata.
mountinfo: record {
    # whether the entry asked about is a mount. The three below mean nothing
    # when this is false
    is_mount: bool
    # the mount's first root, copied out for a caller that must not hold the
    # table
    first: fsno
    # the mount's second root, when it has one
    second: fsno
    # whether `second` is meaningful, mirroring the mountdata field it was
    # copied from
    has_second: bool
}

# a VFS directory entry -- one of root / notfound / file / directory / mount.
dentry: variant {
    # the root entry: no parent, and belonging to no provider
    root: null
    # a resolved absence -- the walk reached here and found nothing
    notfound: notfounddata
    # a file entry
    file: filedata
    # a directory entry
    directory: dirdata
    # a mount point, where one root overlays another
    mount: mountdata
}

# the id-indexed table of all VFS dentries.
DentryTable: class {
    # every entry, indexed by fsno. An fsno IS the index, which is what lets it
    # be a plain integer
    entries: ListVal dentry
} as {
    # add an entry and answer its fsno, which is simply where it landed
    append: function {:this entry: dentry.take} out fsno is {
        idx: fsno.create from: this.entries.length.u32.orPanic
        this.entries.append entry
        return idx
    }
}

# Open() result: a domain-specific non-generic union.
OpenResult: union {
    # `ok` carries the opened file's contents as String. May
    # become a TextReader once a Provider implementation needs
    # stream semantics.
    ok: String
    # why the open failed
    err: IoError
}

# ZVfsProvider -- the five-method abstract protocol every provider
# implementation satisfies. A provider owns its own id space: the `u32` these
# methods pass is the PROVIDER's node id and means nothing to any other one,
# and 0 is the conventional NOTFOUND sentinel walk answers when no walk is
# possible.
ZVfsProvider: protocol {
    # resolve one path component `name` under `parent`, answering this
    # provider's own node id, or 0 for NOTFOUND
    walk: function {:this name: StringView parent: u32} out u32
    # read the item's contents, or say why it could not be read
    open: function {t: this.view item: u32} out OpenResult
    # what the item is, without reading it
    stat: function {t: this.view item: u32} out nodekind
    # the item's path as this provider spells it, for diagnostics
    path: function {t: this.view item: u32} out String
    # add a file to this provider. Only the writable providers do anything with
    # it
    addFile: function {:this fpath: String.take content: String.take}
}

# NullProvider -- the stateless default. walk always returns
# NOTFOUND, open always errors, stat returns dir for the root
# item / notfound elsewhere, path returns the static [NULL]
# marker. `_unused: bool` is a placeholder field so the class is not
# zero-field.
NullProvider: class {
    # a placeholder so the class is not zero-field; nothing reads it
    _unused: bool
} as {
    :ZVfsProvider
    # always NOTFOUND: the null provider resolves nothing
    walk: function {:this name: StringView parent: u32} out u32 is {
        name
        parent
        return 1
    }
    # always an error: there is nothing here to read
    open: function {t: this.view item: u32} out OpenResult is {
        item
        e: IoError.other "NullProvider cannot open for read".string
        return (OpenResult.err e.take)
    }
    # dir for the root item and notfound for everything else, so a walk can
    # start and then get nowhere
    stat: function {t: this.view item: u32} out nodekind is {
        if item == 0 then return nodekind.dir
        return nodekind.notfound
    }
    # the static [NULL] marker, so a diagnostic naming it is recognisable
    path: function {t: this.view item: u32} out String is {
        item
        return "[NULL]".string
    }
    # discards it: the null provider stores nothing
    addFile: function {:this fpath: String.take content: String.take} is {
        fpath
        content
        panic "NullProvider has no file storage"
    }
}

# ProviderBox -- one-field wrapper around an owned ZVfsProvider.
# Indirection lets us store providers in a list -- (List of:
# <Protocol>) directly is untested in the tree; (List of:
# <Class>) is known-good. ~5 LOC of overhead, lossless.
ProviderBox: class {
    # the boxed provider. Boxing is what lets one list hold implementations of
    # different types behind the protocol
    p: ZVfsProvider
}

# ProviderTable -- registry of all live providers, indexed by u32.
# registerNull constructs + appends a NullProvider, returns its
# assigned id. get returns a borrow of the provider at id, scoped
# to the caller's expression.
ProviderTable: class {
    # the registered providers, indexed by the id the dentries carry
    providers: List ProviderBox
} as {
    # register a NullProvider and answer its id
    registerNull: function {:this} out u32 is {
        np: NullProvider _unused: false
        prov: ZVfsProvider.create from: np.take
        box: ProviderBox p: prov
        idx: this.providers.length.u32.orPanic
        this.providers.append box.take
        return idx
    }
    # register an in-memory StringProvider and answer its id
    registerString: function {:this} out u32 is {
        sp: StringProvider nodes: List StringNode children: (MapRV String v: u32)
        root: StringNode path: "".string kind: nodekind.dir content: "".string
        sp.nodes.append root.take
        prov: ZVfsProvider.create from: sp.take
        box: ProviderBox p: prov
        idx: this.providers.length.u32.orPanic
        this.providers.append box.take
        return idx
    }
    # registerFS -- construct an FSProvider rooted at <rootpath>/<parentpath>,
    # validating that the joined path is actually a directory. Panics if it
    # isn't. Root node 0 carries `parentpath` literally, so all walked paths
    # share that prefix.
    registerFS: function {:this rootpath: String.take parentpath: String.take} out u32 is {
        full: joinPath parent: rootpath.stringView name: parentpath.stringView
        sr: io.stat full
        match (
            sr
        ) case ok then {
            match (
                sr.kind
            ) case dir then null case file then {
                panic "FSProvider root is not a directory"
            } case symlink then {
                panic "FSProvider root is not a directory"
            } case other then {
                panic "FSProvider root is not a directory"
            }
        } case err then {
            panic "FSProvider root is not a directory (stat failed)"
        }
        fp: (FSProvider
            rootpath: rootpath.take
            pathtable: List FSNode
            pathcache: (MapRV String v: u32)
        )
        root: FSNode path: parentpath.take kind: nodekind.dir
        fp.pathtable.append root.take
        prov: ZVfsProvider.create from: fp.take
        box: ProviderBox p: prov
        idx: this.providers.length.u32.orPanic
        this.providers.append box.take
        return idx
    }
}

# StringNode -- one node in StringProvider's in-memory tree.
# `path` is the full path (e.g. "/a/b.txt"); `kind` discriminates
# file / dir / notfound; `content` is empty for dir / notfound.
#py:719.
StringNode: class {
    # the full path this node is registered under
    path: String
    # whether it is a file or a directory
    kind: nodekind
    # the file's bytes; empty for a directory
    content: String
}

# StringProvider -- in-memory file store. `nodes` is the flat node
# table (NodeID = list index); `children` maps "<parentid>:<name>"
# to the child NodeID.
StringProvider: class {
    # every registered node, indexed by this provider's own node id
    nodes: List StringNode
    # the child lookup, keyed by parent id and name joined, so a walk is one map
    # hit rather than a scan
    children: (MapRV String v: u32)
} as {
    :ZVfsProvider

    # Internal: append a node, return its assigned id.
    appendNode: function {:this fpath: String.take k: nodekind c: String.take} out u32 is {
        idx: this.nodes.length.u32.orPanic
        n: StringNode path: fpath.take kind: k content: c.take
        this.nodes.append n.take
        return idx
    }

    # Internal: record a parent->child edge in the children map.
    # Builds the composite "<parentid>:<name>" key directly.
    addChild: function {:this parentid: u32 name: StringView childid: u32.take} is {
        key: "\{parentid.u64}:\{name}"
        this.children.set key: key.take value: childid
    }

    # resolve `name` under `parent` through the children map -- no filesystem is
    # touched
    walk: function {:this name: StringView parent: u32} out u32 is {
        key: "\{parent}:\{name}"
        r: this.children.get key: key.copy
        match (
            r
        ) case some then {
            return r
        } case none then {
            # append a NOTFOUND node, record the edge, return the new id.
            childpath: "\{(this.nodes.get i: parent.u64).path}/\{name}"
            empty: String
            newid: this.appendNode fpath: childpath.take k: nodekind.notfound c: empty.take
            this.addChild parentid: parent :name childid: newid.u32
            return newid
        }
    }

    # the stored contents, which are already in memory
    open: function {t: this.view item: u32} out OpenResult is {
        n: t.nodes.get i: item.u64
        match (
            n.kind
        ) case file then {
            c: n.content.copy
            return (OpenResult.ok c.take)
        } case dir then {
            e: IoError.other "is a directory".string
            return (OpenResult.err e.take)
        } case notfound then {
            e: IoError.notfound
            return (OpenResult.err e.take)
        }
    }

    # the stored kind, with no syscall
    stat: function {t: this.view item: u32} out nodekind is {
        n: t.nodes.get i: item.u64
        return n.kind
    }

    # the path the node was registered under
    path: function {t: this.view item: u32} out String is {
        n: t.nodes.get i: item.u64
        return n.path.copy
    }

    # addFile -- walk the path components, creating intermediate
    # DIR nodes as needed, then create a FILE leaf with the
    # content.__init__ loop.
    # `fpath` shapes accepted: "/a/b.txt" splits to ["a", "b.txt"]
    # (leading "/" produces an empty leading piece, ignored). A
    # path of "/" or "" is rejected (no file to attach to).
    addFile: function {:this fpath: String.take content: String.take} is {
        sv: fpath.stringView
        currentid: u32
        # iterate by re-splitting and counting non-empty pieces
        # so we know which one is the last (file vs intermediate).
        total: u64
        with it: (sv.split sep: "/") do for piece: it loop {
            if piece.length > 0 then total = total + 1
        }
        if total == 0 then panic "addFile: empty path"
        seen: u64
        with it2: (sv.split sep: "/") do for piece: it2 loop {
            if piece.length > 0 then {
                seen = seen + 1
                key: "\{currentid}:\{piece}"
                r: this.children.get key: key.copy
                match (
                    r
                ) case some then {
                    currentid = r
                } case none then {
                    childpath: "\{(this.nodes.get i: currentid.u64).path}/\{piece}"
                    if seen == total then {
                        c: content.copy
                        newid: this.appendNode fpath: childpath.take k: nodekind.file c: c.take
                        this.addChild parentid: currentid name: piece childid: newid.u32
                        currentid = newid
                    } else {
                        empty: String
                        newid: this.appendNode fpath: childpath.take k: nodekind.dir c: empty.take
                        this.addChild parentid: currentid name: piece childid: newid.u32
                        currentid = newid
                    }
                }
            }
        }
    }
}

# FSNode -- one node in FSProvider's path table. `path` is the
# relative-to-rootpath path (with parentpath as prefix); `kind`
# discriminates file / dir / notfound.
# tuple.
FSNode: class {
    # the real path this node stands for
    path: String
    # what stat found it to be
    kind: nodekind
}

# FSProvider -- a provider that wraps a real filesystem. Walks issue
# `io.stat` on the joined rootpath/relpath; opens read the file via
# `io.readText`. `pathtable` indexes nodes by NodeID (= list index);
# `pathcache` maps the relative path back to its assigned NodeID so
# repeat walks are O(1). addFile panics: FSProvider is read-only from
# the VFS view.
FSProvider: class {
    # the real directory this provider is rooted at; every path it answers is
    # under it
    rootpath: String
    # the nodes seen so far, indexed by this provider's own node id
    pathtable: List FSNode
    # path to node id, so a path walked twice costs one syscall rather than two
    pathcache: (MapRV String v: u32)
} as {
    :ZVfsProvider

    # Internal: append a node, return its assigned id.
    appendPath: function {:this fpath: String.take k: nodekind} out u32 is {
        idx: this.pathtable.length.u32.orPanic
        n: FSNode path: fpath.take kind: k
        this.pathtable.append n.take
        return idx
    }

    # resolve `name` under `parent` against the real filesystem, caching the
    # answer so the syscall happens once
    walk: function {:this name: StringView parent: u32} out u32 is {
        rel: joinPath parent: (this.pathtable.get i: parent.u64).path.stringView :name
        # Cache lookup first; repeat walks short-circuit here.
        cached: this.pathcache.get key: rel.copy
        match (
            cached
        ) case some then {
            return cached
        } case none then {
            # Stat the full path on disk and translate filekind ->
            # nodekind. Any io.stat error collapses to NOTFOUND.
            full: joinPath parent: this.rootpath.stringView name: rel.stringView
            k: nodekind.notfound
            sr: io.stat full
            match (
                sr
            ) case ok then {
                match (
                    sr.kind
                ) case file then {
                    k = nodekind.file
                } case dir then {
                    k = nodekind.dir
                } case symlink then {
                    k = nodekind.file
                } case other then {
                    k = nodekind.notfound
                }
            } case err then null
            newid: this.appendPath fpath: rel.copy :k
            this.pathcache.set key: rel.take value: newid.u32
            return newid
        }
    }

    # read the file from disk
    open: function {t: this.view item: u32} out OpenResult is {
        n: t.pathtable.get i: item.u64
        match (
            n.kind
        ) case file then {
            full: joinPath parent: t.rootpath.stringView name: n.path.stringView
            rr: io.readText full
            match (
                rr
            ) case ok then {
                return (OpenResult.ok rr.take)
            } case err then {
                return (OpenResult.err rr.take)
            }
        } case dir then {
            e: IoError.other "is a directory".string
            return (OpenResult.err e.take)
        } case notfound then {
            e: IoError.notfound
            return (OpenResult.err e.take)
        }
    }

    # what the real filesystem says the entry is
    stat: function {t: this.view item: u32} out nodekind is {
        n: t.pathtable.get i: item.u64
        return n.kind
    }

    # the real path, which is what a diagnostic should name
    path: function {t: this.view item: u32} out String is {
        n: t.pathtable.get i: item.u64
        return n.path.copy
    }

    # write the file to disk under this provider's root
    addFile: function {:this fpath: String.take content: String.take} is {
        fpath
        content
        panic "FSProvider is read-only"
    }
}

# ZVfs -- the engine layer. Owns its own provider list (parallel to
# `ProviderTable`, which the provider-level verbs use) plus a dentry
# table, a per-id name side-table indexed by dentry id (entry ids are
# dense u32), and a walk cache keyed by "<parentid>:<name>".
ZVfs: class {
    # the registered providers, indexed by the id every dentry carries
    providers: List ProviderBox
    # each provider's root path, kept beside the provider rather than inside it
    providerRoot: (IdMapR u32 V: String)
    # the dentries, which is where resolution actually caches its answers
    entrytable: DentryTable
    # the file names seen, so a name can be reported without re-deriving it
    file_names: List String
    # resolved path to fsno. A path walked twice does not descend twice
    walk_cache: (MapRV String v: fsno)
    # the entry every absolute walk starts from
    rootid: fsno
} as {
    # registerNull -- append a NullProvider to the provider list and
    # create its root directory dentry. Returns the new dentryid.
    #py:280-300 with NullProvider as the body.
    registerNull: function {:this} out fsno is {
        np: NullProvider _unused: false
        prov: ZVfsProvider.create from: np.take
        box: ProviderBox p: prov
        pid: this.providers.length.u32.orPanic
        this.providers.append box.take
        d: dentry.directory (dirdata parentid: fsno providerid: pid nodeid: 0)
        did: this.entrytable.append entry: d
        this.file_names.append "".string
        return did
    }
    # registerString -- append a fresh StringProvider (empty) and
    # create its root directory dentry.
    # caller populates the provider's content via `addFile` against
    # the underlying provider ( The provider
    # is reachable via this.providers; the dispatcher's `addFile`
    # currently goes through ProviderTable, not ZVfs.providers.
    registerString: function {:this} out fsno is {
        sp: StringProvider nodes: List StringNode children: (MapRV String v: u32)
        root: StringNode path: "".string kind: nodekind.dir content: "".string
        sp.nodes.append root.take
        prov: ZVfsProvider.create from: sp.take
        box: ProviderBox p: prov
        pid: this.providers.length.u32.orPanic
        this.providers.append box.take
        d: dentry.directory (dirdata parentid: fsno providerid: pid nodeid: 0)
        did: this.entrytable.append entry: d
        this.file_names.append "".string
        return did
    }
    # registerFS -- append an FSProvider rooted at <rootpath>/<parentpath>,
    # validating the joined path is a directory (panics otherwise), and
    # create its root directory dentry.registerFS
    # closely; the only differences are the dentry construction at the
    # end and the use of ZVfs's own providers/entrytable/file_names.
    registerFS: function {:this rootpath: String.take parentpath: String.take} out fsno is {
        full: joinPath parent: rootpath.stringView name: parentpath.stringView
        sr: io.stat full
        match (
            sr
        ) case ok then {
            match (
                sr.kind
            ) case dir then null case file then {
                panic "ZVfs.registerFS: root is not a directory"
            } case symlink then {
                panic "ZVfs.registerFS: root is not a directory"
            } case other then {
                panic "ZVfs.registerFS: root is not a directory"
            }
        } case err then {
            panic "ZVfs.registerFS: root is not a directory (stat failed)"
        }
        rpCopy: rootpath.copy
        fp: (FSProvider
            rootpath: rootpath.take
            pathtable: List FSNode
            pathcache: (MapRV String v: u32)
        )
        root: FSNode path: parentpath.take kind: nodekind.dir
        fp.pathtable.append root.take
        prov: ZVfsProvider.create from: fp.take
        box: ProviderBox p: prov
        pid: this.providers.length.u32.orPanic
        this.providers.append box.take
        this.providerRoot.set key: pid value: rpCopy
        d: dentry.directory (dirdata parentid: fsno providerid: pid nodeid: 0)
        did: this.entrytable.append entry: d
        this.file_names.append "".string
        return did
    }
    # walk -- single-step VFS walk. Composite cache key avoids
    # re-querying the provider for the same parent/name pair.
    # Parent narrowing extracts (providerid, nodeid) -- only the
    # file / directory / notfound arms carry these. root and mount
    # arms panic. On a cache miss: ask provider.walk +
    # provider.stat, translate to a file/directory/notfound dentry,
    # append to the entry table, record the name + cache.
    walk: function {:this parent: fsno name: StringView} out fsno is {
        # cache lookup
        cachekey: "\{parent.u64}:\{name}"
        cached: this.walk_cache.get key: cachekey
        match (
            cached
        ) case some then {
            hit: cached
            return hit
        } case none then null
        # Mount-arm fast path: if parent is a UNION-mount dentry,
        # recurse into `first`, then `second` if first returned a
        # notfound dentry AND has_second is true. Extracted via
        # `_extractMount` so the entrytable borrow is released
        # before we recurse (recursive `this.walk` will WRITE to
        # entrytable on a cache miss).
        mi: this._extractMount dentryid: parent
        if mi.is_mount then {
            r1: this.walk parent: mi.first :name
            if mi.has_second then {
                r1_nf: this._dentryIsNotFound dentryid: r1
                if r1_nf then {
                    r2: this.walk parent: mi.second :name
                    this.walk_cache.set key: cachekey.take value: r2
                    return r2
                }
            }
            this.walk_cache.set key: cachekey.take value: r1
            return r1
        }
        # extract parent's provider+nodeid
        pe: this.entrytable.entries.get i: parent.u64
        ppid: u32
        pnid: u32
        match (
            pe
        ) case root then {
            panic "ZVfs.walk: parent is bare root arm (provider not registered)"
        } case file then {
            ppid = pe.providerid
            pnid = pe.nodeid
        } case directory then {
            ppid = pe.providerid
            pnid = pe.nodeid
        } case notfound then {
            ppid = pe.providerid
            pnid = pe.nodeid
        } case mount then {
            panic "ZVfs.walk: unreachable (mount handled above)"
        }
        # ask provider
        box: this.providers.getMut i: ppid.u64
        newnid: box.p.walk :name parent: pnid
        kind: box.p.stat item: newnid
        # construct new dentry
        newd: dentry.notfound (notfounddata parentid: parent providerid: ppid nodeid: newnid)
        match (
            kind
        ) case file then {
            newd = dentry.file (filedata parentid: parent providerid: ppid nodeid: newnid)
        } case dir then {
            newd = dentry.directory (dirdata parentid: parent providerid: ppid nodeid: newnid)
        } case notfound then null
        newdid: this.entrytable.append entry: newd
        this.file_names.append name.string
        this.walk_cache.set key: cachekey.take value: newdid
        return newdid
    }
    # arm -- coarse-grained "what kind of thing is this VFS entry"
    # answer for the dispatcher. mount/root collapse to dir (mount
    # is a UNION over directories; root is the unregistered sentinel
    # which we treat as a directory for printing purposes). file /
    # directory / notfound map directly. The mount case will be
    # mount arm once UNION-aware walk lands.
    arm: function {:this dentryid: u32} out nodekind is {
        e: this.entrytable.entries.get i: dentryid.u64
        match (
            e
        ) case root then {
            return nodekind.dir
        } case notfound then {
            return nodekind.notfound
        } case file then {
            return nodekind.file
        } case directory then {
            return nodekind.dir
        } case mount then {
            return nodekind.dir
        }
    }
    # fileTable -- (file-id, bare-name) for every FILE dentry, filled
    # into parallel out-lists. Only `file` arms are included so that
    # directories and not-found entries (which also carry a name in
    # file_names) are excluded.
    fileTable: function {:this outIds: ListVal fsno outPaths: List String} is {
        n: this.entrytable.entries.length
        i: u64
        for i < n loop {
            e: this.entrytable.entries.get :i
            match (
                e
            ) case file then {
                outIds.append from: (fsno.create from: i.u32.orPanic)
                nm: this.file_names.get :i
                outPaths.append nm.copy
            } case root then null case notfound then null case directory then null case mount then null
            i = i + 1
        }
    }
    # path -- reconstruct a "/"-separated path by following parentid
    # pointers back to root, gathering names from file_names. The
    # root dentry's name is empty; the dispatcher's "/" prefix comes
    # from the join itself. If the chain hits a root arm we stop;
    # anything else (notfound, file, dir, mount) keeps going. Up to
    # 1024 ancestors before we bail (defensive cap; trees in
    # practice stay shallow).
    path: function {:this dentryid: u32} out String is {
        # Collect names walking upward, then assemble in reverse.
        # Cap at 1024 ancestors (defensive; trees stay shallow).
        names: List String
        curid: dentryid
        steps: u32
        cap: 1024.u32
        active: true
        for active loop {
            e: this.entrytable.entries.get i: curid.u64
            at_root: false
            par: u32
            match (
                e
            ) case root then {
                at_root = true
            } case notfound then {
                par = e.parentid
            } case file then {
                par = e.parentid
            } case directory then {
                par = e.parentid
            } case mount then {
                par = e.parentid
            }
            # Skip name-append when we're AT the root (bare root arm
            # or self-pointing synthetic root from registerNull etc.) --
            # the root carries no name. The leading "/" comes from the
            # assembly loop below.
            if at_root then {
                active = false
            } else if curid == par then {
                active = false
            } else {
                nm: this.file_names.get i: curid.u64
                names.append nm.copy
                curid = par
                steps = steps + 1
                if steps >= cap then active = false
            }
        }
        # Assemble: reversed names joined by "/", with a leading "/"
        out_str: String
        i: names.length
        for i > 0 loop {
            i = i - 1
            nm: names.get :i
            out_str.append s: "/"
            out_str.append s: nm
        }
        if out_str.length == 0 then return "/".string
        return out_str
    }
    # pathfromprovider -- ask the dentry's provider for its native
    # path representation. For mount arms returns "[UNION]" (no
    # underlying path); for root/notfound returns "[NULL]"/
    # "[NOT FOUND]".
    pathfromprovider: function {:this dentryid: fsno} out String is {
        e: this.entrytable.entries.get i: dentryid.u64
        match (
            e
        ) case root then {
            return "[NULL]".string
        } case notfound then {
            return "[NOT FOUND]".string
        } case mount then {
            return "[UNION]".string
        } case file then {
            pid: e.providerid
            nid: e.nodeid
            box: this.providers.get i: pid.u64
            s: box.p.path item: nid
            return s
        } case directory then {
            pid: e.providerid
            nid: e.nodeid
            box: this.providers.get i: pid.u64
            s: box.p.path item: nid
            return s
        }
    }

    # pathfromproviderNative -- the dentry's absolute native path (the
    # provider's registered root joined with the provider-relative path).
    # "" when the provider has no native root (the in-memory overlay); the
    # caller resolves those against its source dir, which the overlay shadows.
    pathfromproviderNative: function {:this dentryid: u32} out String is {
        e: this.entrytable.entries.get i: dentryid.u64
        rel: String
        pid: u32
        got: false
        match (
            e
        ) case root then null case notfound then null case mount then null case file then {
            pid = e.providerid
            nid: e.nodeid
            box: this.providers.get i: pid.u64
            rel = box.p.path item: nid
            got = true
        } case directory then {
            pid = e.providerid
            nid: e.nodeid
            box: this.providers.get i: pid.u64
            rel = box.p.path item: nid
            got = true
        }
        if got == false then return "".string
        ro: this.providerRoot.get key: pid
        match (
            ro
        ) case some then {
            if ro.length == 0 then return "".string
            return (joinPath parent: ro.stringView name: rel.stringView)
        } case none then {
            return "".string
        }
    }

    # _extractMount -- read the dentry at `dentryid`, return a value-type
    # mountinfo carrier. For mount arms: is_mount=true + first/second/
    # has_second fields. For other arms: is_mount=false. Used by walk to
    # release the entrytable borrow before recursing into the mount arms.
    _extractMount: function {:this dentryid: u32} out mountinfo is {
        e: this.entrytable.entries.get i: dentryid.u64
        match (
            e
        ) case mount then {
            return (mountinfo
                is_mount: true
                first: e.first
                second: e.second
                has_second: e.has_second
            )
        } case root then null case notfound then null case file then null case directory then null
        return (mountinfo is_mount: false first: fsno second: fsno has_second: false)
    }

    # _dentryIsNotFound -- true iff the dentry at `dentryid` is the
    # notfound arm. Used by walk to decide whether to fall through from
    # the first union arm to the second on a mount.
    _dentryIsNotFound: function {:this dentryid: u32} out bool is {
        e: this.entrytable.entries.get i: dentryid.u64
        match (
            e
        ) case notfound then {
            return true
        } case root then null case file then null case directory then null case mount then null
        return false
    }

    # open -- match on the dentry arm; file delegates to the underlying
    # provider's open. Non-file arms construct the appropriate IoError
    # (directory -> isdir, notfound -> notfound, root -> "[NULL]", mount
    # -> panic untilpy:513-528
    # but returns OpenResult directly rather than wrapping in a
    # ZVfsOpenFile (the wrapper is needless in zerolang: OpenResult is
    # the value-returned result type, no with-block context manager).
    open: function {:this dentryid: u32} out OpenResult is {
        e: this.entrytable.entries.get i: dentryid.u64
        match (
            e
        ) case root then {
            ie: IoError.other "[NULL]".string
            return (OpenResult.err ie.take)
        } case notfound then {
            ie: IoError.notfound
            return (OpenResult.err ie.take)
        } case directory then {
            ie: IoError.other "is a directory".string
            return (OpenResult.err ie.take)
        } case mount then {
            panic "ZVfs.open: mount arms not yet supported"
        } case file then {
            pid: e.providerid
            nid: e.nodeid
            box: this.providers.get i: pid.u64
            return (box.p.open item: nid)
        }
    }

    # getline -- open the file, collect its lines into a List<String>,
    # return the one at `lineno` as Option.some. Out-of-range index or
    # open-failure returns Option.none. Whole-file read: VFS-mapped files
    # are small.
    getline: function {:this dentryid: u32 lineno: u64} out Option String is {
        r: this.open :dentryid
        match (
            r
        ) case ok then {
            sv: r.stringView
            all_lines: List String
            with li: sv.lines do for line: li loop all_lines.append line.string
            if lineno < all_lines.length then {
                ln: all_lines.get i: lineno
                result: ln.copy
                return (Option.some result.take)
            }
            return (Option.none String)
        } case err then {
            return (Option.none String)
        }
    }

    # bindRoot -- replace this.rootid with a fresh mount dentry over
    # the old root. INSTEAD overlays exclusively (no second arm); BEFORE
    # / AFTER preserve the old root as the union's second / first arm
    # respectively.
    bindRoot: function {:this newid: fsno kind: bindkind} out fsno is {
        old: this.rootid
        md: mountdata parentid: old first: fsno second: fsno has_second: false
        match (
            kind
        ) case instead then {
            md = mountdata parentid: old first: newid second: fsno has_second: false
        } case before then {
            md = mountdata parentid: old first: newid second: old has_second: true
        } case after then {
            md = mountdata parentid: old first: old second: newid has_second: true
        }
        new_dentry: dentry.mount md
        new_id: this.entrytable.append entry: new_dentry
        this.file_names.append "".string
        this.rootid = new_id
        return new_id
    }

    # bind -- mount `newid` at parent/name, replacing whatever was
    # walked there. INSTEAD discards the old entry; BEFORE / AFTER
    # layer the new mount as the union's first / second arm
    # respectively. The walk_cache entry for `<parentid>:<name>` is
    # overwritten so future walks route to the new mount.
    bind: function {:this parentid: fsno name: StringView newid: fsno kind: bindkind} out fsno is {
        old: this.walk parent: parentid :name
        zf: fsno
        md: mountdata :parentid first: zf second: zf has_second: false
        match (
            kind
        ) case instead then {
            md = mountdata :parentid first: newid second: zf has_second: false
        } case before then {
            md = mountdata :parentid first: newid second: old has_second: true
        } case after then {
            md = mountdata :parentid first: old second: newid has_second: true
        }
        new_dentry: dentry.mount md
        new_id: this.entrytable.append entry: new_dentry
        this.file_names.append name.string
        cachekey: "\{parentid.u64}:\{name}"
        this.walk_cache.set key: cachekey.take value: new_id
        return new_id
    }
}


# joinPath -- glue two path components with a single "/", handling
# the empty-parent case so a "" root doesn't produce a leading-slash
# child.path.join("", x) == x for the leading
# case; the trailing case is delegated to callers (we don't produce
# a trailing "/" on `parent` ourselves).
joinPath: function {parent: StringView name: StringView} out String is {
    if parent.length == 0 then return name.string
    return "\{parent}/\{name}"
}
