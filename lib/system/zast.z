# Parsed-AST surface for the zerolang compiler: the object-definition kind
# (objectkind), error codes (err), call classification (callkind), the astnode
# union of all node kinds, and the id-linked node table (Ast) the parser
# fills.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :nameid
    :Vocab
    :nodeid
    :tableReserveIn
    :markerkind
    :markerKindOf
    :markerKindOfLeaf
    :markerKindOfName
    :callsBeforeMarker
    :isGroupedPath
    :isForwardingLabel
    :isValueMarkerLeaf
    :assignmentrow
    :Ast
    :atomidrow
    :atomstringrow
    :callrow
    :caseclauserow
    :caserow
    :datablockrow
    :dorow
    :dottedpathrow
    :ErrorData
    :errorrow
    :errorDataOf
    :forrow
    :functionrow
    :ifclauserow
    :ifrow
    :labelvaluerow
    :namedoperationrow
    :astnode
    :objectdefrow
    :programrow
    :reassignmentrow
    :statementrow
    :statementlinerow
    :stringchunkrow
    :StringPool
    :swapstmtrow
    :unitrow
    :withrow
    :callkind
    :callkindname
    :err
    :errCode
    :errorLine
    :explainText
    :armName
    :objectkindname
    :errname
    :isErrorAt
    :infixparts
    :infixPartsOf
    :kidspan
    :kidsAdd
    :kidsAdd1
    :kidsAddWindow
    :kidAt
    :kidIds
    :appendSpan
    :childIds
    :childIdsInto
    :cloneTreeAt
    :childIdsAt
    :spanEndLineAt
    :stmtLineCount
    :stmtLineAt
    :ifCondAt
    :stringPartAt
    :callArgAt
    :yieldCallIdAt
    :yieldCountIn
    :yieldCountOf
    :suspendingForCountOf
    :isYieldCalleeAt
    :yieldCallOperandAt
    :fnParamAt
    :objIsItemAt
    :objItemIds
    :objAsItemAt
    :caseClauseAt
    :ifClauseAt
    :forCondAt
    :forPostAt
    :dataElemAt
    :nameTextAt
    :namedSiteAt
    :namedsite
    :nameTextCopy
    :nameTextEq
    :nodeIdOf
    :nodepos
    :objectkind
    :poolFind
    :poolSet
    :poolTextAt
    :poolTextCopy
    :poolTextEq
    :posOf
    :printNode
    :printNodeCanonical
    :printProgramCanonicalRoot
    :tableAdd
    :tableSet
    :tableReserve
    :tableTake
    :unitBodyIdsAt
    :isGenericParamOp
    :itemsHaveGenericParam
    :unitOpKindIs
    :unitOpDeclaresUnit
    :unitkind
    :wellKnown
}

# Error codes. Numeric E0xxx values are assigned by errCode, not by arm
# position, so arms may be added anywhere.

# parse/AST error variants; the diagnostics layer maps each arm to a code.
err: variant {
    # a require: names a unit with no file behind it
    fileNotFound: null
    # two definitions in one scope claim the same name
    duplicateDef: null
    # the unit's declared name does not match the file holding it
    badUnitName: null
    # the unit header itself did not parse
    badUnit: null
    # a function definition did not parse
    badFunction: null
    # the source could not be read at all
    ioError: null
    # a definition was required at this position
    expectedDef: null
    # an expression was required at this position
    expectedExp: null
    # an operator was required at this position
    expectedOp: null
    # a type definition was required at this position
    expectedTypeDef: null
    # a statement was required at this position
    expectedStatement: null
    # one argument did not parse
    badArgument: null
    # the argument list as a whole did not parse
    badArgumentBlock: null
    # an expression was begun and could not be finished
    badExpression: null
    # the thing a name was bound to did not parse
    badOperation: null
    # a string literal did not parse -- an unterminated quote, or an escape the
    # lexer does not know
    badString: null
    # a dotted path did not parse
    badPath: null
    # a reference did not parse
    badReference: null
    # a call did not parse
    badCall: null
    # one parameter did not parse
    badParameter: null
    # the parameter list as a whole did not parse
    badParameterBlock: null
    # a type body did not parse
    badObjectBlock: null
    # one member of a type body did not parse
    badItem: null
    # the `then` branch did not parse
    badThen: null
    # the `else` branch did not parse
    badElse: null
    # a match arm did not parse
    badCase: null
    # a for header did not parse
    badFor: null
    # a data block did not parse
    badData: null
    # a statement did not parse
    badStatement: null
    # the types do not agree where they must
    typeError: null
    # a name resolved to nothing in any reachable scope
    refNotFound: null
    # an ownership rule was broken -- a use after transfer, or a second take
    ownerError: null
    # the call does not match the declaration it resolved to
    callError: null
    # a generic could not be instantiated for the arguments given
    genericError: null
    # the compiler reached a state it does not handle. A BUG rather than bad
    # input, so it names itself as one
    compilerError: null
    # a word the language reserves was used as an identifier
    reservedName: null
    # a match leaves an arm the subject can still hold uncovered
    nonExhaustive: null
    # a member name the language reserves
    reservedMember: null
    # a require: block is malformed
    requireBlock: null
    # the name exists, but the unit that owns it does not export it
    notPublic: null
    # a private type surfaces in a signature other units can see
    privateEscape: null
    # a value required at compile time could not be folded to one
    constError: null
    # raised by the program itself rather than found by the compiler
    userError: null
    # there is no main to start a demand-driven walk from
    noMain: null
    # the lexer could not make a token of the bytes at all
    badToken: null
    # `main` declares a shape the entry point cannot have
    badMain: null
} as { tag: u8.tag }

# objectkind -- which of the eight object definitions an objectdef is.
objectkind: variant {
    # a protocol: a reftype interface, dispatched through a vtable
    protocolDef: null
    # a record: a valtype with named fields
    recordDef: null
    # a class: a reftype with named fields
    classDef: null
    # a union: a reftype tagged sum, so an arm may carry a reftype payload
    unionDef: null
    # a variant: a valtype tagged sum, so no arm may carry a reftype
    variantDef: null
    # a facet: a valtype interface, an existential carrying its vtable beside
    # the value
    facetDef: null
    # a generator: a reftype whose `is` fields are its construction state and
    # whose `call` member is a resumable body
    generatorDef: null
    # a typedef: a zero-overhead wrapper over its one base type, whose family
    # it takes; its single is-item is the base's type reference
    typedefDef: null
} as { tag: u8.tag }

# Classification of a Call node, set by the type checker. The
# emitter dispatches on this to choose the right call shape.
callkind: variant {
    # not yet classified; the checker stamps the real kind later
    unknown: null
    # an ordinary function or method call
    regular: null
    # `return`, which is a builtin function and not a keyword
    returnCall: null
    # `yield`, a suspension point. Like `break`/`continue` it is a compiler
    # function with no declaration: the checker defines it into a generator
    # body's scope and stamps the calls that resolve to THAT binding, so a
    # user name shadowing `yield` is an ordinary call and not a suspension
    yieldCall: null
    # constructing a record
    recordCreate: null
    # constructing a class
    classCreate: null
    # tagged-sum arm construction -- covers union AND variant parents
    unionCreate: null
    # wrapping a conforming value in a protocol, taking ownership
    protocolCreate: null
    # wrapping a conforming value in a protocol, borrowing it
    protocolBorrow: null
    # wrapping a conforming value in a facet, taking ownership
    facetCreate: null
    # wrapping a conforming value in a facet, borrowing it
    facetBorrow: null
    # constructing through a typedef, taking ownership of the base
    typedefCreate: null
    # constructing through a typedef, borrowing the base
    typedefBorrow: null
    # a reference to a function rather than a call of it -- what `.take` on a
    # member yields
    callable: null
    # boxing a valtype so a reftype slot can hold it
    boxCreate: null
    # `break`, a builtin like return
    breakCall: null
    # `continue`, a builtin like break
    continueCall: null
    # raising a user error
    errorCall: null
    # `panic`, which diverges: nothing after it is reachable
    panicCall: null
} as { tag: u8.tag }

# What a `unit` body means, set by the parser at construction. Readers
# ask the kind rather than comparing the introducing label to a name.
unitkind: variant {
    # a file unit root, or an inline `m: unit { }`: a namespace of
    # static definitions, public by default
    namespace: null
    # a hidden implementation subunit (`foo/bar.z`): private to its
    # parent -- only the parent may name it -- and, like every unit,
    # resolving outward through the parent, the file unit and core
    subunit: null
    # a generic template, `m: unit as { t: anyval.generic }`
    template: null
    # a `public:` block: the unit's or type's exported interface
    publicNs: null
    # a `require:` toolchain-requirement block
    requirement: null
} as { tag: u8.tag }

# The AST node, as a reftype tagged sum. The arm is the
# discriminant; arm-payload carrier classes (declared below)
# hold the per-arm data. No carrier holds a astnode: every child
# reference is a nodeid or a list of them, so the tree is flat
# and a row is reached only through the table.
astnode: variant {
    # a parse or check failure, kept IN the tree so a walk can carry on past it
    error: errorrow
    # a bare name
    atomid: atomidrow
    # the `:Name` shorthand, whose value is the label itself
    labelvalue: labelvaluerow
    # one piece of a string literal: literal text, or an interpolation hole
    stringchunk: stringchunkrow
    # a string literal, as its ordered chunks
    atomstring: atomstringrow
    # `a.b`, before anything decides whether it calls
    dottedpath: dottedpathrow
    # a call with its arguments, each labelled
    call: callrow
    # a name bound to something -- the node that carries a label for everything
    # that has one
    namedoperation: namedoperationrow
    # a literal sequence of elements
    datablock: datablockrow
    # a block of statements
    statement: statementrow
    # one statement: EOL is a statement boundary
    statementline: statementlinerow
    # a binding that DECLARES a name
    assignment: assignmentrow
    # a write to a name or path that already exists
    reassignment: reassignmentrow
    # an exchange of two values, neither left invalid in between
    swapstmt: swapstmtrow
    # an if with its clauses
    ifexpr: ifrow
    # one if or else-if: conditions and the body they guard
    ifclause: ifclauserow
    # a loop, in all its shapes
    forexpr: forrow
    # a block used for its value
    doexpr: dorow
    # a binding whose lock lasts exactly one block
    withexpr: withrow
    # a match over a subject
    caseexpr: caserow
    # one match arm
    caseclause: caseclauserow
    # a function or method definition
    functiondef: functionrow
    # a type definition, in any of the six kinds
    objectdef: objectdefrow
    # a unit, or one of the interface blocks inside one
    unitdef: unitrow
    # the root, owning the tree
    program: programrow
    # box-free parser placeholder: a reserved table slot carries this
    # arm (payload-less, no allocation) until intern moves the real
    # row in (see tableSet / zparser.nextId)
    placeholder: null
}


# Per-arm astnode payload carriers. Each carries a synthetic nodeid
# plus source position (line + column). The carriers are classes
# because they hold reftype fields (String, astnode, List); records
# cannot hold reftypes.
ErrorData: class {
    # this error node's own row in the node table
    nodeid: nodeid
    # the line this error node starts on
    lineno: u32
    # the column this error node starts at
    colno: u32
    # how many columns to underline beneath lineno/colno
    width: u32
    # which failure this is, so a caller can branch on the kind rather than on
    # the text
    err: err
    # the sentence shown to the reader
    msg: String
    # the file it happened in; a node's position is meaningless without one once
    # more than one file is open
    fsno: zvfs.fsno
    # an optional second line giving context; empty when there is none
    note: String
    # an optional suggested fix; empty when there is none
    hint: String
}

# errorrow -- the error ARM's payload: the same failure `ErrorData` describes,
# with its three texts as pool ids. A variant arm is a valtype and a record may
# not hold a String, so the tree's rows name their text. The checker's `errors`
# list is a DIFFERENT use of the same facts and keeps `ErrorData`: its text is
# owned, built by interpolation, and never worth interning.
errorrow: record {
    # this error node's own row in the node table
    nodeid: nodeid
    # the line this error node starts on
    lineno: u32
    # the column this error node starts at
    colno: u32
    # how many columns to underline beneath lineno/colno
    width: u32
    # which failure this is, so a caller can branch on the kind rather than on
    # the text
    err: err
    # the sentence shown to the reader, interned
    msg: nameid
    # the file it happened in
    fsno: zvfs.fsno
    # an optional second line giving context; 0 when there is none
    note: nameid
    # an optional suggested fix; 0 when there is none
    hint: nameid
}

# errorDataOf -- an error row rendered into the owned-text form every reporter
# already takes, so a tree error and a checker diagnostic print through one path.
errorDataOf: function {ast: Ast.view row: errorrow} out ErrorData is {
    return (ErrorData
        nodeid: row.nodeid
        lineno: row.lineno
        colno: row.colno
        width: row.width
        err: row.err
        msg: (poolTextCopy pool: ast.names ref: row.msg)
        fsno: row.fsno
        note: (poolTextCopy pool: ast.names ref: row.note)
        hint: (poolTextCopy pool: ast.names ref: row.hint)
    )
}

# errCode -- the numeric E-code for an err variant.
errCode: function {c: err} out u32 is {
    r: 1.u32
    match (
        c
    ) case fileNotFound then {
        r = 2
    } case duplicateDef then {
        r = 3
    } case badUnitName then {
        r = 4
    } case badUnit then {
        r = 5
    } case badFunction then {
        r = 6
    } case ioError then {
        r = 7
    } case expectedDef then {
        r = 10
    } case expectedExp then {
        r = 12
    } case expectedOp then {
        r = 13
    } case expectedTypeDef then {
        r = 14
    } case expectedStatement then {
        r = 15
    } case badArgument then {
        r = 17
    } case badArgumentBlock then {
        r = 18
    } case badExpression then {
        r = 19
    } case badOperation then {
        r = 20
    } case badString then {
        r = 21
    } case badPath then {
        r = 22
    } case badReference then {
        r = 23
    } case badCall then {
        r = 24
    } case badParameter then {
        r = 25
    } case badParameterBlock then {
        r = 26
    } case badObjectBlock then {
        r = 27
    } case badItem then {
        r = 28
    } case badThen then {
        r = 29
    } case badElse then {
        r = 30
    } case badCase then {
        r = 31
    } case badFor then {
        r = 32
    } case badData then {
        r = 34
    } case badStatement then {
        r = 35
    } case reservedName then {
        r = 33
    } case nonExhaustive then {
        r = 36
    } case reservedMember then {
        r = 37
    } case requireBlock then {
        r = 38
    } case noMain then {
        r = 39
    } case badToken then {
        r = 9
    } case badMain then {
        r = 40
    } case typeError then {
        r = 100
    } case notPublic then {
        r = 101
    } case privateEscape then {
        r = 102
    } case refNotFound then {
        r = 8
    } case ownerError then {
        r = 200
    } case callError then {
        r = 300
    } case genericError then {
        r = 400
    } case constError then {
        r = 600
    } case userError then {
        r = 601
    } case compilerError then {
        r = 1
    }
    return r
}

# errorLine -- the one-line diagnostic for an error node: error[Exxxx]: <message>.
# (Location/snippet are intentionally omitted; the negative-test goldens keep only
# the code + message line.)
errorLine: function {e: ErrorData.view} out String is {
    code: errCode c: e.err
    p: String
    if code < 10 then {
        p = "000"
    } else if code < 100 then {
        p = "00"
    } else if code < 1000 then p = "0"
    result: "error[E\{p}\{code}]: \{e.msg}"
    return result
}

# explainText -- a human-readable explanation for a numeric error code, or ""
# when the code is unknown. Keyed by the same E-codes errCode assigns, so the
# `zc explain Exxxx` command and the emitted diagnostics stay in sync.
explainText: function {code: u32} out String is {
    r: String
    if code == 1 then {
        r = "internal compiler error\n\nThe compiler hit an unexpected internal condition. This is a compiler bug, not an error in your program."
    } else if code == 2 then {
        r = "file not found\n\nThe source file for a unit (<unit>.z) could not be located under --src or the system library."
    } else if code == 3 then {
        r = "duplicate definition\n\nTwo definitions share the same name in the same scope. Rename or remove one."
    } else if code == 4 then {
        r = "bad unit name\n\nA unit name is malformed or does not match its file. Unit names are identifiers with no extension."
    } else if code == 5 then {
        r = "malformed unit\n\nThe unit could not be parsed as a sequence of top-level definitions."
    } else if code == 6 then {
        r = "malformed function\n\nA function definition is not well formed. Check the parameter block, return clause, and body."
    } else if code == 7 then {
        r = "I/O error\n\nReading or writing a file failed. Check the path and permissions."
    } else if code == 8 then {
        r = "undefined identifier\n\nA name was used that is not defined in any visible scope. Check spelling and imports."
    } else if code == 9 then {
        r = "unexpected characters\n\nThe characters form no token of the language -- a two-dot run, an unknown escape, a byte no token may contain. This is the lexer's own diagnosis, reported where the parser met the characters."
    } else if code == 10 then {
        r = "expected a definition\n\nA top-level definition (name: function / record / class / ...) was expected here."
    } else if code == 12 then {
        r = "expected an expression\n\nAn expression was expected here but something else was found."
    } else if code == 13 then {
        r = "expected an operator\n\nAn operator was expected between two operands. Operators must be surrounded by whitespace."
    } else if code == 14 then {
        r = "expected a type definition\n\nA type definition (record / variant / facet / class / union / protocol) was expected here."
    } else if code == 15 then {
        r = "expected a statement\n\nA statement was expected inside this block."
    } else if code == 17 then {
        r = "malformed argument\n\nA call argument is not well formed. Named arguments take the form name: value."
    } else if code == 18 then {
        r = "malformed argument block\n\nThe argument list of a call could not be parsed."
    } else if code == 19 then {
        r = "malformed expression\n\nThe expression could not be parsed."
    } else if code == 20 then {
        r = "malformed operation\n\nAn operator expression is not well formed."
    } else if code == 21 then {
        r = "malformed string\n\nA string literal is unterminated or contains an invalid escape or interpolation."
    } else if code == 22 then {
        r = "malformed path\n\nA dotted path (a.b.c) is not well formed."
    } else if code == 23 then {
        r = "malformed reference\n\nA reference to a name or member is not well formed."
    } else if code == 24 then {
        r = "malformed call\n\nA function or method call is not well formed."
    } else if code == 25 then {
        r = "malformed parameter\n\nA parameter declaration is not well formed. Parameters take the form name: type."
    } else if code == 26 then {
        r = "malformed parameter block\n\nThe parameter list of a function could not be parsed."
    } else if code == 27 then {
        r = "malformed object block\n\nThe body of a type definition could not be parsed."
    } else if code == 28 then {
        r = "malformed item\n\nAn item inside a block or list is not well formed."
    } else if code == 29 then {
        r = "malformed then clause\n\nAn if or for expression is missing a well-formed 'then' clause."
    } else if code == 30 then {
        r = "malformed else clause\n\nThe 'else' / 'else if' continuation is not well formed; it must follow the closing brace on the same line."
    } else if code == 31 then {
        r = "malformed case clause\n\nA match 'case' arm is not well formed; it must follow the closing brace on the same line."
    } else if code == 32 then {
        r = "malformed for header\n\nA for loop header is not well formed (for <var>: <iter> loop, or for while <cond> loop)."
    } else if code == 33 then {
        r = "reserved word used as a name\n\nA reserved keyword (unit, function, match, ...) or a future-reserved word (enum, goto, ...) cannot be used as a definition, parameter, field, binding or argument name, spelled `word:` or as the `:word` shorthand. Rename it."
    } else if code == 34 then {
        r = "malformed data block\n\nA data block is not well formed."
    } else if code == 35 then {
        r = "malformed statement\n\nThe statement could not be parsed."
    } else if code == 36 then {
        r = "non-exhaustive match\n\nA `match` over a variant or union does not cover every arm and has no `else`. Add the missing case(s), or an `else` clause."
    } else if code == 37 then {
        r = "reserved member name\n\nA type body declares a member named `public` or `tag`, or a unit declares a definition named `public`. `public` names the visibility block, so `public: unit { ... }` is the only declaration it may introduce; `tag` is the arm tag every sum type carries. Rename it."
    } else if code == 38 then {
        r = "malformed require block\n\nA unit's `require:` block declares what the unit needs from the host toolchain. It must be a unit definition, must declare at least one requirement, and every entry must be a key the compiler consumes -- today only `library:`, whose value is a compile-time string naming a link library. An unknown or misspelt key would be silently ignored, so it is rejected."
    } else if code == 39 then {
        r = "no main\n\nThe unit being compiled declares no `main: function is { ... }`, so the compiler has no entry point to start from. Compilation is demand-driven: `main` is the root, and what it reaches is what gets checked and emitted. A unit with no `main` is a library -- compile the program that opens it instead, or add a `main`. `--eager` resolves every definition rather than what a root reaches, so it does not require one."
    } else if code == 100 then {
        r = "type error\n\nA value's type does not match what is required here: a mismatch, an undefined type, or an incompatible assignment."
    } else if code == 101 then {
        r = "member not public\n\nThe member exists but is not in the type's `public:` interface. Access it from within the type's own methods (`this`), or through a `.private` friend handle the type handed out."
    } else if code == 102 then {
        r = "private escape\n\nA `.private` view may only be taken by the value's own type, or by a holder of an existing `.private` handle (a friend the type passed it to). External code holding only a public value cannot produce one."
    } else if code == 200 then {
        r = "ownership error\n\nA value's ownership was used incorrectly: used after a take/move, a borrow outliving its lock, a reftype aliased while locked, or a reassignment in another mode than the name was bound with -- an owned name takes an owned value (`x = d.take`), a borrow is re-pointed (`b = d`). See docs/ownership."
    } else if code == 300 then {
        r = "call error\n\nA call's arguments do not match the callee: wrong count, an unknown named argument, or an argument type mismatch. Also raised for a bare type name in value position that cannot construct its zero value: required fields missing, or a family with no zero-argument create (unions/variants select an arm, views bind from an owner, generic templates need type arguments)."
    } else if code == 400 then {
        r = "generic error\n\nA generic type could not be resolved: a missing type argument, failed inference, or an unsatisfied constraint."
    } else if code == 500 then {
        r = "emitter error\n\nType checking succeeded but the C emitter met a construct it cannot emit. Nothing is written; the message names the construct. This is a compiler gap, not an error in your program."
    } else if code == 601 then {
        r = "compile-time error\n\nAn `error` call the compiler proved reachable. The message is the one the program's author wrote; the compiler is reporting it, not diagnosing it."
    } else if code == 600 then {
        r = "compile-time evaluation error\n\nThe compiler was asked for a value at compile time and could not produce one: a division by a constant zero, a result outside the range the evaluator works in, a constant defined in terms of itself, or an expression it cannot evaluate: a call, an operator it does not fold, or a unit-level `if` whose condition or selected branch does not fold. Distinct from E0500, which is the emitter reporting a construct it cannot emit."
    }
    return r
}

# an atom node (a bare identifier reference): position + interned name id.
atomidrow: record {
    # this atom's own row in the node table
    nodeid: nodeid
    # the line this atom starts on
    lineno: u32
    # the column this atom starts at
    colno: u32
    # the interned name this atom spells. An id, not text: names are compared by
    # id everywhere downstream
    name: nameid
    # written inside parentheses of its own, `(mk)`. Read SEMANTICALLY, as the
    # call's `infix` is: parentheses round a callable path force its call, so a
    # marker after them applies to the result (`callsBeforeMarker`)
    grouped: false
}

# a label-value node (a `name:`-shaped operand): position + interned name id.
labelvaluerow: record {
    # this label value's own row in the node table
    nodeid: nodeid
    # the line this label value starts on
    lineno: u32
    # the column this label value starts at
    colno: u32
    # the interned label. The `:Name` shorthand parses to this, its value being
    # the label itself
    name: nameid
    # a SYNTHESIZED forward: a lowering (a generator's create) hands a parameter
    # on as it is, whatever its type -- a function reference among them, which
    # a written `:f` would call. Read semantically, as the call's `infix` is
    forwards: false
}

# Interned-name row: the single owner of one distinct identifier's text.
# atomidrow.name / labelvaluerow.name are Ast.names pool ids, so
# every occurrence of an identifier shares one String (position = first
# sight). The parser interns; synthesized atoms move into their
# reserved slots via tableAdd.
# Well-known interned names: ONE list, the spelling of each beside its label.
# Every StringPool interns them first, in this order, so an entry's SLOT is its pool
# id -- slot 0 is the pool's own sentinel row, the empty text -- and a consumer
# reads the id by label: `zast.wellKnown.slot.wkContains` is a nameid. Every
# reader asks the list, so an entry may go anywhere; moving one renumbers the
# ids after it, which a dump shows and nothing else depends on.
wellKnown: data {
    # the pool's sentinel, row 0: no name at all
    none: ""
    wkThis: "this"
    wkReturn: "return"
    wkBreak: "break"
    wkContinue: "continue"
    wkCreate: "create"
    wkBorrow: "borrow"
    wkCall: "call"
    wkGet: "get"
    wkSet: "set"
    wkGetv: "getv"
    wkRemove: "remove"
    wkAdd: "add"
    wkContains: "contains"
    wkSort: "sort"
    wkLength: "length"
    wkCapacity: "capacity"
    wkSize: "size"
    wkKey: "key"
    wkValue: "value"
    wkItem: "item"
    wkSome: "some"
    wkTag: "tag"
    wkState: "state"
    wkString: "string"
    wkStringView: "stringView"
    wkListView: "listView"
    wkIterate: "iterate"
    wkIterateItems: "iterateItems"
    wkOpEq: "=="
    wkOpNe: "!="
    wkResumeInput: "_resume_input"
    wkHash: "hash"
    wkEmpty: ""
    wkRhs: "rhs"
    wkBool: "bool"
    wkEach: "each"
    wkTake: "take"
    wkView: "view"
    wkHold: "hold"
    wkDrop: "drop"
    wkPrivate: "private"
    wkPublic: "public"
    wkYield: "yield"
    # `require`, the unit-level block label
    wkRequire: "require"
    # the collection methods the emitter writes out only when a program calls
    # them: a template method nobody uses is dead C in every program that names
    # the collection at all
    wkInsert: "insert"
    wkExtend: "extend"
    wkGetMut: "getMut"
    wkIterateMut: "iterateMut"
    # bool's logic methods, compared by id in the checker, the emitter and zl
    wkNot: "not"
    wkAnd: "and"
    wkOr: "or"
    # the sub-range window over a list, compared by id in the emitter
    wkSlice: "slice"
    # appending a ListViewVal's elements to a ListVal, compared by id in the
    # emitter
    wkExtendView: "extendView"
    # the total order `sort` asks an element for, compared by id in the checker
    wkCompare: "compare"
    # the arithmetic and bitwise operators a constant fold computes, which the
    # checker routes by id
    wkOpAdd: "+"
    wkOpSub: "-"
    wkOpMul: "*"
    wkOpDiv: "/"
    wkOpRem: "%"
    wkOpAnd: "&"
    wkOpOr: "|"
    wkOpXor: "^"
    wkOpShl: "<<"
    wkOpShr: ">>"
    wkUpto: "upto"
    wkDownto: "downto"
    wkIterateReverse: "iterateReverse"
    wkGeneric: "generic"
    wkTimes: "times"
    # `slot`, a data block's label positions
    wkSlot: "slot"
    # the lexer's keywords, which it classifies by id (zlexer.kwControlId and
    # its siblings); `each` and the seven markers are named above
    kwIf: "if"
    kwWhen: "when"
    kwThen: "then"
    kwElse: "else"
    kwFor: "for"
    kwLoop: "loop"
    kwWhile: "while"
    kwDo: "do"
    kwCase: "case"
    kwMatch: "match"
    kwOn: "on"
    kwUnit: "unit"
    kwRecord: "record"
    kwClass: "class"
    kwUnion: "union"
    kwVariant: "variant"
    kwProtocol: "protocol"
    kwData: "data"
    kwFacet: "facet"
    kwGenerator: "generator"
    kwTypedef: "typedef"
    kwNative: "native"
    kwEquals: "="
    kwFunction: "function"
    kwOut: "out"
    kwOutx: "outx"
    kwIn: "in"
    kwSwap: "swap"
    kwIs: "is"
    kwAs: "as"
    kwWith: "with"
    # the reserved words, which name nothing yet (zlexer.isReservedId)
    rsEnum: "enum"
    rsMacro: "macro"
    rsFlag: "flag"
    rsGoto: "goto"
    rsCell: "cell"
    rsUnsafe: "unsafe"
    rsRepeat: "repeat"
    rsPragma: "pragma"
    rsSwitch: "switch"
    rsUntil: "until"
    # the scalar types' names, in ztypes.numkind's order: the checker knows the
    # system's own scalar by its declaration's name id (ztypes.numkindAt)
    tyI8: "i8"
    tyI16: "i16"
    tyI32: "i32"
    tyI64: "i64"
    tyI128: "i128"
    tyU8: "u8"
    tyU16: "u16"
    tyU32: "u32"
    tyU64: "u64"
    tyU128: "u128"
    tyC8: "c8"
    tyC32: "c32"
    tyF16: "f16"
    tyF32: "f32"
    tyF64: "f64"
    tyF128: "f128"
    # the stdlib types the compiler names for itself, and the generic bounds it
    # classifies: each resolved once, from the prelude, by its id
    # (ztypecheck.stdTid), never from a program's own scope
    tyString: "String"
    tyStringView: "StringView"
    tyByteView: "ByteView"
    tyText: "Text"
    tyStr: "str"
    tyArray: "array"
    tyIntdata: "intdata"
    tyFloatdata: "floatdata"
    tyStringdata: "stringdata"
    tyOption: "Option"
    tyOptionView: "OptionView"
    tyOptionViewVal: "OptionViewVal"
    tyResult: "Result"
    tyIoError: "IoError"
    tyListRef: "ListRef"
    tyListVal: "ListVal"
    tyListView: "ListView"
    tyListViewVal: "ListViewVal"
    tyListIter: "ListIter"
    tyListIterVal: "ListIterVal"
    tySpanVal: "SpanVal"
    tySpanPair: "SpanPair"
    tySetRef: "SetRef"
    tySetVal: "SetVal"
    tySetIter: "SetIter"
    tySetIterVal: "SetIterVal"
    tyMapRR: "MapRR"
    tyMapRV: "MapRV"
    tyMapVR: "MapVR"
    tyMapVV: "MapVV"
    tyMapEntry: "MapEntry"
    tyMapEntryRV: "MapEntryRV"
    tyMapEntryVR: "MapEntryVR"
    tyMapEntryVV: "MapEntryVV"
    tyMapKeyIter: "MapKeyIter"
    tyMapKeyIterRV: "MapKeyIterRV"
    tyMapKeyIterVR: "MapKeyIterVR"
    tyMapKeyIterVV: "MapKeyIterVV"
    tyMapItemIter: "MapItemIter"
    tyMapItemIterRV: "MapItemIterRV"
    tyMapItemIterVR: "MapItemIterVR"
    tyMapItemIterVV: "MapItemIterVV"
    tyIdMapR: "IdMapR"
    tyIdMapV: "IdMapV"
    tyIdSet: "IdSet"
    tyIdSetIter: "IdSetIter"
    tyIdMapItemIterR: "IdMapItemIterR"
    tyIdMapItemIterV: "IdMapItemIterV"
    tyIdMapEntryR: "IdMapEntryR"
    tyIdMapEntryV: "IdMapEntryV"
    tyAnyval: "anyval"
    tyAnyRef: "AnyRef"
    tyValhashable: "valhashable"
    tyRefHashable: "RefHashable"
    tyIdkey: "idkey"
    tyAnyint: "anyint"
    tyAnyfloat: "anyfloat"
    tyDataindex: "dataindex"
    tyStringLike: "StringLike"
    tyBytes: "Bytes"
    tyNull: "null"
    tyNever: "never"
    tyBox: "Box"
    tyList: "List"
    tyMap: "Map"
    tySet: "Set"
    tyOptionval: "optionval"
    wkOpLt: "<"
    wkOpGt: ">"
    wkOpLe: "<="
    wkOpGe: ">="
    wkByteView: "byteView"
    wkType: "type"
    wkMain: "main"
    wkFrom: "from"
    wkTo: "to"
    wkMeta: "meta"
    wkPanic: "panic"
    wkError: "error"
    wkStartsWith: "startsWith"
    wkEndsWith: "endsWith"
    wkSubstring: "substring"
    wkPrefix: "prefix"
    wkSuffix: "suffix"
    wkNeedle: "needle"
    wkCopy: "copy"
    wkShrink: "shrink"
    wkNameTextCopy: "nameTextCopy"
    wkPoolTextCopy: "poolTextCopy"
    wkOrPanic: "orPanic"
    wkPrint: "print"
    wkAppend: "append"
    wkPush: "push"
    wkPop: "pop"
    wkHas: "has"
    wkDelete: "delete"
    wkKeyAt: "keyAt"
    wkValueAt: "valueAt"
    wkSplit: "split"
    wkFill: "fill"
    wkClear: "clear"
    wkCopyFrom: "copyFrom"
    wkMutView: "mutView"
    wkMutSlice: "mutSlice"
    wkResize: "resize"
    wkIndex: "index"
    wkAppendByte: "appendByte"
    wkReserve: "reserve"
    wkHasFlag: "hasFlag"
    wkOption: "option"
    wkPositional: "positional"
    wkClose: "close"
    wkRead: "read"
    wkWrite: "write"
    wkSeek: "seek"
    wkFlush: "flush"
    wkWriteLine: "writeLine"
    wkAccept: "accept"
    wkAsString: "asString"
    wkCount: "count"
    wkCodepoints: "codepoints"
    wkParseI64: "parseI64"
    wkParseU64: "parseU64"
    wkParseF64: "parseF64"
    wkParseF16: "parseF16"
    wkParseF128: "parseF128"
    wkLines: "lines"
    wkReadLine: "readLine"
    wkSvSimple: "simple"
    wkSvArg: "arg"
    wkSvParse: "parse"
    wkSvNoArg: "noarg"
    wkByteAt: "byteAt"
    wkDefault: "default"
    wkTrue: "true"
    wkFalse: "false"
    wkLitZero: "0"
    wkLitZeroFloat: "0.0"
    tyParsed: "Parsed"
} out (stringdata i: nameid)

# Ast -- the parse artifact carrier threaded through every reader: the
# master node table, plus (as the carrier grows) the other tree-scoped
# state produced by parsing.
Ast: class {
    # every node of every file, in one table, indexed by nodeid: a row is read
    # with a node's id and with no other number
    nodes: (ListVal astnode i: nodeid)
    # the interned name pool the whole tree shares, so two spellings of one name
    # are one id
    names: StringPool
    # the node ids of the top-level units, which is where a walk starts
    units: ListVal nodeid
    # every node's child ids, end to end. A carrier names its own children as a
    # `kidspan` window into this, so no node owns a list
    kids: ListVal nodeid
    # the file each row reports from, beside `nodes` row for row: the file a
    # parsed row was read from, the source's file for a row made from another
    # (a rewrite, an instance's copy). 0 for a row of the root parse and for one
    # made from no node
    rowFile: (ListVal zvfs.fsno i: nodeid)
    # the unit files the parse loaded, in the order it finished them
    files: ListVal zvfs.fsno
    # the program row's own id. The root is a row like any other, so a reader
    # holding the tree can reach it without being handed the node separately
    root: nodeid
    # the unit a demand-driven walk starts from. It names the tree, not one row
    # in it, which is why it sits here rather than on the program row
    mainUnitName: String
} as {
    # an empty tree: no nodes, no units, and a name pool holding only its
    # sentinel row
    create: function {} out this is {
        a: (meta.create
            nodes: (ListVal astnode i: nodeid)
            names: StringPool.create
            units: ListVal nodeid
            kids: ListVal nodeid
            rowFile: (ListVal zvfs.fsno i: nodeid)
            files: ListVal zvfs.fsno
            root: nodeid
            mainUnitName: String
        )
        # row 0 is the sentinel a node id of 0 addresses: the placeholder arm,
        # which every reader already treats as "nothing here"
        a.nodes.append from: astnode.placeholder
        a.rowFile.append from: zvfs.fsno
        # and row 0 of the child arena, so that no real span starts at 0
        a.kids.append from: nodeid
        return a
    }
    # internString -- intern a name at a MINT site (a synthesized name not
    # guaranteed to be in the pool yet: a mono mangle, an element ordinal).
    # The one sanctioned intern in an analysis stage; returns the 1-based pool
    # id. Reads use zast.poolFind (0 on miss) and never intern. Takes an
    # exclusive lock on `this` for the call, so no node view (this.nodes.get)
    # may be live at the call site -- mint sites hold none (the ordinal site
    # drops its view first).
    internString: function {:this text: StringView} out nameid is {
        return (poolSet pool: this.names :text)
    }

    # fsnoForNode -- the file the row `nodeid` reports from (rowFile).
    fsnoForNode: function {this: this.view nodeid: nodeid} out zvfs.fsno is {
        return (this.rowFile.get i: nodeid)
    }
}

# nameid -- a StringPool id: the interned identity of one identifier's text.
# 1-based, 0 is "no name". A typedef so a pool id cannot cross with the node,
# type or variable id spaces; equality is same-space only, sentinels read
# isZero.
nameid: typedef u32 as {
    # identity by interned id, which is the only sound way to compare names --
    # two spellings of one name intern to one id, and a text compare would miss
    # that
    ==: function {this: this.view rhs: nameid} out bool is {
        return this.u32 == rhs.u32
    }
    # the sentinel test, and it has TWO meanings to rule out: a nameless node
    # and an un-interned name both answer 0, so a table compare must exclude
    # zero before trusting a match
    isZero: function {this: this.view} out bool is {
        return this.u32 == 0
    }
    # the zero nameid: no name. A parameter or field that may be handed none
    # defaults to it
    zero: nameid 0
    # the name id's place in interning order, which says nothing about the texts: an id only ever
    # orders against an id of its own space, never a bare number
    compare: function {this: this.view rhs: nameid} out i32 is {
        return (this.u32.compare rhs: rhs.u32)
    }
    # this name id was numbered earlier than `rhs`
    <: function {this: this.view rhs: nameid} out bool is {
        return this.u32 < rhs.u32
    }
    # this name id was numbered no later than `rhs`
    <=: function {this: this.view rhs: nameid} out bool is {
        return this.u32 <= rhs.u32
    }
    # this name id was numbered later than `rhs`
    >: function {this: this.view rhs: nameid} out bool is {
        return this.u32 > rhs.u32
    }
    # this name id was numbered no earlier than `rhs`
    >=: function {this: this.view rhs: nameid} out bool is {
        return this.u32 >= rhs.u32
    }
    # no arithmetic and no bitwise operator: a name id names one name, and a number made from it
    # names nothing. Walking the space reads `next`, and a boundary that needs the number (a dump, a
    # table length) reads `.u32`
    +: null
    -: null
    *: null
    /: null
    %: null
    &: null
    |: null
    ^: null
    <<: null
    >>: null
    not: null
    # the id's hash, agreeing with `==`: both read the id alone, so a name id
    # keys a map or a set, alone or as part of a key record
    hash: function {this: this.view} out u64 is {
        return this.u32
    }
    # the next id in sequence, which is how a walk over every row of a
    # name-indexed table steps without a counter of its own
    next: function {this: this.view} out nameid is {
        n: this.u32 + 1
        return (nameid from: n)
    }
}

# kidspan -- a node's child ids as a window into `Ast.kids`, so a carrier
# names its children without owning a list. Row 0 of the arena is a sentinel
# no span ever addresses, which makes `first == 0` mean EMPTY and lets a
# zero-valued span be the absent case with no separate flag.
kidspan: record {
    # the arena index of the first child, 0 when there are none
    first: u32
    # how many children the span names
    count: u32
} as {
    # the empty test, spelled so a reader never compares against a literal
    isEmpty: function {this: this.view} out bool is {
        return this.count == 0
    }
}

# nodeid -- an Ast node id: the identity of one node in the single monotonic
# node space (1-based; 0 is "no node", and a synthesized node reads
# `fsnoForNode == 0`). A typedef so a node id cannot cross with the pool,
# type, variable or declaration id spaces; equality is same-space only,
# sentinels read isZero.
nodeid: typedef u32 as {
    # identity by id. Two nodes are the same node when their ids match; nothing
    # here compares contents
    ==: function {this: this.view rhs: nodeid} out bool is {
        return this.u32 == rhs.u32
    }
    # the id's hash, agreeing with `==`: both read the id alone, so a node id
    # keys a map or a set, alone or as part of a key record
    hash: function {this: this.view} out u64 is {
        return this.u32
    }
    # the next id in sequence, which is how a walk over every row of a
    # node-indexed table steps without a counter of its own
    next: function {this: this.view} out nodeid is {
        n: this.u32 + 1
        return (nodeid from: n)
    }
    # the sentinel test. Row 0 is reserved, so a zero id means ABSENT rather
    # than the first node
    isZero: function {this: this.view} out bool is {
        return this.u32 == 0
    }
    # the zero nodeid: no node, row 0 of the table being reserved. A parameter
    # or field that may be handed none defaults to it
    zero: nodeid 0
    # the node id's place in the order the parser built the nodes in: an id only ever orders against
    # an id of its own space, never a bare number
    compare: function {this: this.view rhs: nodeid} out i32 is {
        return (this.u32.compare rhs: rhs.u32)
    }
    # this node id was numbered earlier than `rhs`
    <: function {this: this.view rhs: nodeid} out bool is {
        return this.u32 < rhs.u32
    }
    # this node id was numbered no later than `rhs`
    <=: function {this: this.view rhs: nodeid} out bool is {
        return this.u32 <= rhs.u32
    }
    # this node id was numbered later than `rhs`
    >: function {this: this.view rhs: nodeid} out bool is {
        return this.u32 > rhs.u32
    }
    # this node id was numbered no earlier than `rhs`
    >=: function {this: this.view rhs: nodeid} out bool is {
        return this.u32 >= rhs.u32
    }
    # no arithmetic and no bitwise operator: a node id names one node, and a number made from it
    # names nothing. Walking the space reads `next`, and a boundary that needs the number (a dump, a
    # table length) reads `.u32`
    +: null
    -: null
    *: null
    /: null
    %: null
    &: null
    |: null
    ^: null
    <<: null
    >>: null
    not: null
}

# StringPool -- deduplicating intern table for identifier text. A pool id
# indexes its row; row 0 is a sentinel holding the empty text, which is the
# answer for an absent ref. Texts are never removed, so an id stays valid for
# the pool's lifetime. The slot index is an open-addressed, linear-probed
# power-of-two table keyed by the seeded StringView fastHash -- the keys are
# the program's own text, so it need not resist flooding: ids follow
# insertion order and are deterministic, but slot layout is process-local
# -- dump text, never hashes.
StringPool: class {
    # the interned strings, indexed by name id. Id 0 is the sentinel empty text
    texts: (List String i: nameid)
    # each text's hash, indexed by name id like `texts`: a probe compares it
    # before the bytes, and a rebuild re-slots every text without re-hashing
    hashes: (ListVal u64 i: nameid)
    # a byte per text that its first reader stores, so a classification made
    # once per distinct text -- the lexer's keyword lookup -- is not redone
    # per occurrence. 0 means not classified yet.
    wordClass: (ListVal u8 i: nameid)
    # the hash index over `texts`, which is what makes interning a lookup rather
    # than a scan
    slots: ListVal nameid
    # how many slots are occupied, so the index can be grown before it degrades
    used: u64
} as {
    # createEmpty -- a pool holding only the sentinel, so id 0 is the empty text
    # before anything has been interned: a Vocab's, which interns its own block
    # and nothing else
    createEmpty: function {} out this is {
        p: (meta.create
            texts: (List String i: nameid)
            hashes: (ListVal u64 i: nameid)
            wordClass: (ListVal u8 i: nameid)
            slots: ListVal nameid
            used: 0
        )
        # the sentinel row an absent ref reads. It is deliberately given no
        # slot, so interning "" still mints an id of its own.
        p.texts.append "".string
        p.hashes.append 0
        p.wordClass.append 0
        return p
    }

    # create -- a program's pool: the sentinel, then the well-known names
    create: function {} out this is {
        p: StringPool.createEmpty
        # the well-known names, in their block's order: each one's id is its
        # slot, in every pool. Slot 0 is the sentinel row above; `wkEmpty` is
        # an empty text of its own, which the sentinel's lack of a slot lets
        # it mint
        sentinel9: true
        for each wk9: wellKnown loop {
            if sentinel9 then {
                sentinel9 = false
            } else {
                p.set s: wk9
            }
        }
        if p.texts.length != wellKnown.length then {
            panic msg: "zast: a well-known name was interned twice, so the ids are not the slots"
        }
        return p
    }

    # reserve -- grow the slot table when empty or at 2/3 load.
    reserve: function {:this} is {
        if this.slots.length == 0 then {
            this.rebuild ncap: 16
            return
        }
        if (this.used + 1 * 3) >= (this.slots.length * 2) then {
            this.rebuild ncap: this.slots.length * 2
        }
    }

    # rebuild -- swap in a slot table of ncap (a power of two), re-probing
    # every interned text.
    rebuild: function {:this ncap: u64} is {
        ns: ListVal nameid capacity: ncap
        i: u64
        for i < ncap loop {
            ns.append nameid
            i = i + 1
        }
        mask: ncap - 1
        k: nameid
        k = k.next
        for k.u64 < this.texts.length loop {
            idx: (this.hashes.get i: k) & mask
            for (ns.get i: idx).isZero.not loop idx = (idx + 1) & mask
            ns.set i: idx val: k
            k = k.next
        }
        this.slots = ns.take
    }

    # probeSlot -- the slot index for s, whose hash is h: either holds s's id
    # or is the empty slot where s would insert. Requires a non-empty slot
    # table. Only a slot whose text hashed the same is compared byte by byte.
    probeSlot: function {t: this.view s: StringView h: u64} out u64 is {
        mask: t.slots.length - 1
        idx: h & mask
        for true loop {
            sid: t.slots.get i: idx
            if sid.isZero then return idx
            if (t.hashes.get i: sid) == h then {
                text: t.texts.get i: sid
                if text.stringView == s then return idx
            }
            idx = (idx + 1) & mask
        }
        return 0
    }

    # set -- intern s, copying the bytes only on first sight.
    set: function {:this s: StringView} out nameid is {
        this.reserve
        h: s.fastHash
        si: this.probeSlot :s :h
        sid: this.slots.get i: si
        if sid.isZero.not then return sid
        nid: this.texts.append s.string
        this.hashes.append h
        this.wordClass.append 0
        this.slots.set i: si val: nid
        this.used = this.used + 1
        return nid
    }

    # setOwned -- intern a donated owned string: moved in on first sight,
    # dropped when the text is already interned.
    setOwned: function {:this s: String.take} out nameid is {
        this.reserve
        h: s.stringView.fastHash
        si: this.probeSlot s: s.stringView :h
        sid: this.slots.get i: si
        if sid.isZero.not then return sid
        nid: this.texts.append s
        this.hashes.append h
        this.wordClass.append 0
        this.slots.set i: si val: nid
        this.used = this.used + 1
        return nid
    }

    # classOf -- the byte stored for id's text by setClass; 0 until then.
    classOf: function {t: this.view id: nameid} out u8 is {
        return (t.wordClass.get i: id)
    }

    # setClass -- store id's classification byte.
    setClass: function {:this id: nameid c: u8} is {
        this.wordClass.set i: id val: c
    }

    # find -- the id of an already-interned text (0 when absent).
    # Read-only: never interns, never grows the slot table.
    find: function {t: this.view s: StringView} out nameid is {
        if t.slots.length == 0 then return nameid
        si: t.probeSlot :s h: s.fastHash
        return (t.slots.get i: si)
    }

    # get -- an owned copy of id's text; panics on an out-of-range id.
    get: function {t: this.view id: nameid} out String is {
        text: t.texts.get i: id
        return text.copy
    }

    # eq -- does id's text equal s? Zero-allocation compare; id 0 (absent)
    # reads the sentinel, so it equals only the empty view.
    eq: function {t: this.view id: nameid s: StringView} out bool is {
        text: t.texts.get i: id
        return text.stringView == s
    }

    # length -- the row count, sentinel included: ids run 1 .. length - 1.
    length: function {t: this.view} out u64 is {
        return t.texts.length
    }
}

# one chunk of an interpolated string -- literal text or an embedded expression, tagged by `chunkKind`.
stringchunkrow: record {
    # this string chunk's own row in the node table
    nodeid: nodeid
    # the line this string chunk starts on
    lineno: u32
    # the column this string chunk starts at
    colno: u32
    # the literal bytes of this chunk, escapes already resolved, interned. The
    # lexer already put them in the pool; the row names them rather than owning
    # a second copy
    text: nameid
    # whether the chunk is literal text or an interpolation hole
    chunkKind: u8
}

# Interpolated-string-literal payload: an ordered list of astnode
# children representing the literal text chunks and embedded
# interpolation expressions.
atomstringrow: record {
    # this interpolated string's own row in the node table
    nodeid: nodeid
    # the line this interpolated string starts on
    lineno: u32
    # the column this interpolated string starts at
    colno: u32
    # the chunks in order: literal text and interpolation holes alternating
    stringparts: kidspan
}

# Dotted-path node payload: a parent path and a child selector,
# both astnode children (the child is an AtomId arm).
dottedpathrow: record {
    # this dotted path's own row in the node table
    nodeid: nodeid
    # the line this dotted path starts on
    lineno: u32
    # the column this dotted path starts at
    colno: u32
    # the left of the dot
    parent: nodeid
    # the right of the dot. The pair is a PATH and not a call: whether it calls
    # is decided later
    child: nodeid
    # the whole path was written inside parentheses of its own, `(e.key)` -- as
    # an atom's `grouped`
    grouped: false
}

# Call node payload: the callable path and an ordered list of
# argument nodes (each a NamedOperation arm once that arm lands).
callrow: record {
    # this call's own row in the node table
    nodeid: nodeid
    # the line this call starts on
    lineno: u32
    # the column this call starts at
    colno: u32
    # what is being called -- an atom, or a dotted path for a method
    callable: nodeid
    # the arguments, each a namedoperation carrying its label
    arguments: kidspan
    # written INFIX (`a op b`) rather than dotted (`a.op b`). The two spellings
    # are ONE call and compile through one path, but the flag is read
    # SEMANTICALLY, not only for layout: the checker reads it to decide whether
    # the callable's root is a path to look up, whether a literal-typed
    # operation narrows, whether a three-path operator form is a mistake, and
    # whether a constant folds as a binary operation. `infixPartsOf` is how
    # every reader of the operator shape reaches it
    infix: bool
}

# Named-operation payload: an optional argument label plus the
# operation value. Appears as a Call/Data argument; `name` is the
# label's Ast.names pool id (0 = absent / positional).
namedoperationrow: record {
    # this named operation's own row in the node table
    nodeid: nodeid
    # the line this named operation starts on
    lineno: u32
    # the column this named operation starts at
    colno: u32
    # the label, interned. This is the node that carries a name for anything
    # that has one
    name: nameid
    # what the label names: a value, a type, a definition
    operation: nodeid
}

# Data-block payload: an ordered list of NamedOperation element
# nodes and an optional `out <type-ref>` annotation that pins the
# element type for the whole block.
datablockrow: record {
    # this data block's own row in the node table
    nodeid: nodeid
    # the line this data block starts on
    lineno: u32
    # the column this data block starts at
    colno: u32
    # the elements in order
    elements: kidspan
    # the declared element type, 0 when it is left to be inferred
    outType: nodeid
}

# Statement payload: an ordered list of StatementLine nodes — the
# lines of a brace-delimited code block.
statementrow: record {
    # this statement block's own row in the node table
    nodeid: nodeid
    # the line this statement block starts on
    lineno: u32
    # the column this statement block starts at
    colno: u32
    # the statements in order. This is the block every body is made of
    statements: kidspan
}

# StatementLine payload: one line of a block, holding exactly one of an
# assignment, a reassignment, a swap, or the value the line computes.
statementlinerow: record {
    # this statement line's own row in the node table
    nodeid: nodeid
    # the line this statement line starts on
    lineno: u32
    # the column this statement line starts at
    colno: u32
    # the single statement on this line; the wrapper is what makes EOL a
    # statement boundary
    statementline: nodeid
}

# Assignment payload: bind a new local (an interned name id) to the
# value of an expression node.
assignmentrow: record {
    # this binding's own row in the node table
    nodeid: nodeid
    # the line this binding starts on
    lineno: u32
    # the column this binding starts at
    colno: u32
    # the name bound, interned
    name: nameid
    # the value bound to it. A binding declares; a reassignment is the other
    # node
    value: nodeid
}

# Reassignment payload: update the target path with the value of an
# expression node.
reassignmentrow: record {
    # this reassignment's own row in the node table
    nodeid: nodeid
    # the line this reassignment starts on
    lineno: u32
    # the column this reassignment starts at
    colno: u32
    # the path written to, which may be a dotted path and not just a name
    topath: nodeid
    # the new value. The old one is dropped where the binding owns it
    value: nodeid
}

# Swap payload: exchange the contents of two owned reference paths.
# (Arm named swapstmt because `swap` is a keyword.)
swapstmtrow: record {
    # this swap's own row in the node table
    nodeid: nodeid
    # the line this swap starts on
    lineno: u32
    # the column this swap starts at
    colno: u32
    # one side of the swap
    lhs: nodeid
    # the other. A swap moves both ways at once, so neither side is left invalid
    # in between
    rhs: nodeid
}

# If payload: ordered if/when clauses plus an optional else statement.
ifrow: record {
    # this if's own row in the node table
    nodeid: nodeid
    # the line this if starts on
    lineno: u32
    # the column this if starts at
    colno: u32
    # the if and else-if clauses in order; the first whose condition holds wins
    clauses: kidspan
    # the trailing else, 0 when there is none
    elseclause: nodeid
}

# IfClause payload: the clause conditions (each a namedoperation arm;
# unnamed = positional when-condition) and the statement to run.
ifclauserow: record {
    # this if clause's own row in the node table
    nodeid: nodeid
    # the line this if clause starts on
    lineno: u32
    # the column this if clause starts at
    colno: u32
    # the conditions, chained by `when` and short-circuiting on the first false
    conditions: kidspan
    # the body run when they all hold
    statement: nodeid
}

# For payload: loop conditions (namedoperation arms; named = binding,
# unnamed = while-condition), an optional loop body, and the bool
# postconditions re-checked each iteration.
forrow: record {
    # this for's own row in the node table
    nodeid: nodeid
    # the line this for starts on
    lineno: u32
    # the column this for starts at
    colno: u32
    # the leading conditions, chained by `while`; empty for a do-while shape
    conditions: kidspan
    # the binding was written `each`: its value is evaluated once, before the
    # loop, rather than at every iteration
    isEach: bool
    # the loop body
    body: nodeid
    # the trailing `while` conditions of a do-while shape, tested after the body
    postconditions: kidspan
}

# Do payload: a statement block evaluated as an expression.
dorow: record {
    # this do's own row in the node table
    nodeid: nodeid
    # the line this do starts on
    lineno: u32
    # the column this do starts at
    colno: u32
    # the block, whose value is the do's value
    statement: nodeid
}

# With payload: a scoped binding (an interned name id), its value, and
# the body expression evaluated under that binding.
withrow: record {
    # this with's own row in the node table
    nodeid: nodeid
    # the line this with starts on
    lineno: u32
    # the column this with starts at
    colno: u32
    # the name bound for the block's duration
    name: nameid
    # what it is bound to; its lock lasts exactly as long as the block
    value: nodeid
    # the block the binding lives for
    body: nodeid
}

# Case payload: the subject operation, the ordered match clauses, and
# an optional else statement.
caserow: record {
    # this match's own row in the node table
    nodeid: nodeid
    # the line this match starts on
    lineno: u32
    # the column this match starts at
    colno: u32
    # what is matched. Narrowing needs this to be a bare name, since an arm has
    # nothing else to narrow
    subject: nodeid
    # the arms in order
    clauses: kidspan
    # the trailing else, 0 when the arms are exhaustive
    elseclause: nodeid
}

# CaseClause payload: the binding name (an interned name id), the AtomId
# arm being matched, and the statement to run.
caseclauserow: record {
    # this match arm's own row in the node table
    nodeid: nodeid
    # the line this match arm starts on
    lineno: u32
    # the column this match arm starts at
    colno: u32
    # the arm matched, interned
    name: nameid
    # the binding the payload is narrowed into, 0 for a payload-less arm
    matcharm: nodeid
    # the body run for this arm
    statement: nodeid
}

# Function payload: optional return type, parameter list (namedoperation
# arms), an optional body statement (none for a spec), the native flag,
# and the `as`-block members (namedoperation arms). Member maps are
# ordered name+node lists, not keyed Maps.
functionrow: record {
    # this function definition's own row in the node table
    nodeid: nodeid
    # the line this function definition starts on
    lineno: u32
    # the column this function definition starts at
    colno: u32
    # the declared `out` type, 0 when the function returns nothing
    returntype: nodeid
    # the parameters in order, each a namedoperation
    parameters: kidspan
    # the body, 0 when the function is native and the runtime owns it
    body: nodeid
    # true when there is no body to emit and a natives.tbl row backs it instead
    isNative: bool
    # true when declared `outx`: the result keeps the call's borrow/view inputs
    # locked for as long as it lives
    pins: bool
    # the `as { }` members: generic parameters, and the markers a declaration
    # carries
    asItems: kidspan
}

# Unified type-definition payload. `kind` discriminates which kind of
# object this is (one of objectkind RECORD/CLASS/UNION/VARIANT/
# PROTOCOL/FACET). `isItems` are the `is`-block members and `asItems`
# the `as`-block members, each a namedoperation arm.
objectdefrow: record {
    # this type definition's own row in the node table
    nodeid: nodeid
    # the line this type definition starts on
    lineno: u32
    # the column this type definition starts at
    colno: u32
    # which of the six object definitions this is
    kind: objectkind
    # the `is`-block members: fields for a record or class, ARMS for a variant
    # or union, method declarations for a protocol or facet
    isItems: kidspan
    # the `as { }` members: generic parameters, conformances and markers
    asItems: kidspan
    # true when the runtime owns the layout, so no struct is emitted for it
    isNative: bool
}

# Unit payload: `kind` is how the unit was written and what it means;
# `body` holds its top-level definitions as namedoperation arms.
unitrow: record {
    # this unit's own row in the node table
    nodeid: nodeid
    # the line this unit starts on
    lineno: u32
    # the column this unit starts at
    colno: u32
    # which unit shape this is: a namespace, a subunit, a template, or one of
    # the interface blocks
    kind: unitkind
    # the unit's members in order
    body: kidspan
}

# Program payload (parse root): the file-level units as namedoperation
# arms keyed by unit name, plus the entry unit's name.
programrow: record {
    # this program's own row in the node table
    nodeid: nodeid
    # the line this program starts on
    lineno: u32
    # the column this program starts at
    colno: u32
}

# Arm-name dumpers: return the canonical uppercase label for an
# enum arm. Used by printNode and the smoke harness.
errname: function {e: err} out String is {
    match (
        e
    ) case fileNotFound then {
        return "FILENOTFOUND"
    } case duplicateDef then {
        return "DUPLICATEDEF"
    } case badUnitName then {
        return "BADUNITNAME"
    } case badUnit then {
        return "BADUNIT"
    } case badFunction then {
        return "BADFUNCTION"
    } case ioError then {
        return "IOERROR"
    } case expectedDef then {
        return "EXPECTEDDEF"
    } case expectedExp then {
        return "EXPECTEDEXP"
    } case expectedOp then {
        return "EXPECTEDOP"
    } case expectedTypeDef then {
        return "EXPECTEDTYPEDEF"
    } case expectedStatement then {
        return "EXPECTEDSTATEMENT"
    } case badArgument then {
        return "BADARGUMENT"
    } case badArgumentBlock then {
        return "BADARGUMENTBLOCK"
    } case badExpression then {
        return "BADEXPRESSION"
    } case badOperation then {
        return "BADOPERATION"
    } case badString then {
        return "BADSTRING"
    } case badPath then {
        return "BADPATH"
    } case badReference then {
        return "BADREFERENCE"
    } case badCall then {
        return "BADCALL"
    } case badParameter then {
        return "BADPARAMETER"
    } case badParameterBlock then {
        return "BADPARAMETERBLOCK"
    } case badObjectBlock then {
        return "BADOBJECTBLOCK"
    } case badItem then {
        return "BADITEM"
    } case badThen then {
        return "BADTHEN"
    } case badElse then {
        return "BADELSE"
    } case badCase then {
        return "BADCASE"
    } case badFor then {
        return "BADFOR"
    } case badData then {
        return "BADDATA"
    } case badStatement then {
        return "BADSTATEMENT"
    } case typeError then {
        return "TYPEERROR"
    } case refNotFound then {
        return "REFNOTFOUND"
    } case ownerError then {
        return "OWNERERROR"
    } case callError then {
        return "CALLERROR"
    } case genericError then {
        return "GENERICERROR"
    } case compilerError then {
        return "COMPILERERROR"
    } case reservedName then {
        return "RESERVEDNAME"
    } case nonExhaustive then {
        return "NONEXHAUSTIVE"
    } case reservedMember then {
        return "RESERVEDMEMBER"
    } case requireBlock then {
        return "REQUIREBLOCK"
    } case notPublic then {
        return "NOTPUBLIC"
    } case privateEscape then {
        return "PRIVATEESCAPE"
    } case constError then {
        return "CONSTERROR"
    } case userError then {
        return "USERERROR"
    } case noMain then {
        return "NOMAIN"
    } case badToken then {
        return "BADTOKEN"
    } case badMain then {
        return "BADMAIN"
    }
}

# the printable name of an `objectkind`.
objectkindname: function {k: objectkind} out String is {
    match (
        k
    ) case protocolDef then {
        return "PROTOCOL"
    } case recordDef then {
        return "RECORD"
    } case classDef then {
        return "CLASS"
    } case unionDef then {
        return "UNION"
    } case variantDef then {
        return "VARIANT"
    } case facetDef then {
        return "FACET"
    } case generatorDef then {
        return "GENERATOR"
    } case typedefDef then {
        return "TYPEDEF"
    }
}

# the printable name of a `callkind`.
callkindname: function {ck: callkind} out String is {
    match (
        ck
    ) case unknown then {
        return "UNKNOWN"
    } case regular then {
        return "REGULAR"
    } case returnCall then {
        return "RETURN"
    } case yieldCall then {
        return "YIELD"
    } case recordCreate then {
        return "RECORD_CREATE"
    } case classCreate then {
        return "CLASS_CREATE"
    } case unionCreate then {
        return "UNION_CREATE"
    } case protocolCreate then {
        return "PROTOCOL_CREATE"
    } case protocolBorrow then {
        return "PROTOCOL_BORROW"
    } case facetCreate then {
        return "FACET_CREATE"
    } case facetBorrow then {
        return "FACET_BORROW"
    } case typedefCreate then {
        return "TYPEDEF_CREATE"
    } case typedefBorrow then {
        return "TYPEDEF_BORROW"
    } case callable then {
        return "CALLABLE"
    } case boxCreate then {
        return "BOX_CREATE"
    } case breakCall then {
        return "BREAK"
    } case continueCall then {
        return "CONTINUE"
    } case errorCall then {
        return "ERROR"
    } case panicCall then {
        return "PANIC"
    }
}

# the printable name of a `unitkind`.
unitkindname: function {uk: unitkind} out String is {
    match (
        uk
    ) case namespace then {
        return "NAMESPACE"
    } case subunit then {
        return "SUBUNIT"
    } case template then {
        return "TEMPLATE"
    } case publicNs then {
        return "PUBLIC"
    } case requirement then {
        return "REQUIREMENT"
    }
}

# Print a NamedOperation's optional label. The Option is passed by
# borrow so it can be matched without moving it out of its carrier.
printPoolName: function {ast: Ast.view ref: nameid} is {
    if ref.isZero then {
        print "  name=<none>"
        return
    }
    text: nameTextCopy :ast :ref
    print "  name=\{text}"
}

# Source position (line, column) of a node. A valtype so it copies
# out freely; the parser reads it to position synthesised parent
# nodes (Call, NamedOperation) at their first child. Positions order by
# line, then column.
nodepos: record {
    # the 1-based source line
    line: u32
    # the 1-based source column
    col: u32
} as {
    # the order of two positions: by line, and by column within a line
    compare: function {this: this.view rhs: nodepos} out i32 is {
        if this.line != rhs.line then return (this.line.compare rhs: rhs.line)
        return (this.col.compare rhs: rhs.col)
    }
    # this position comes before `rhs`
    <: function {this: this.view rhs: nodepos} out bool is {
        return (this.compare :rhs) < 0
    }
    # this position comes after `rhs`
    >: function {this: this.view rhs: nodepos} out bool is {
        return (this.compare :rhs) > 0
    }
}

# Position of any node; (0, 0) for the placeholder.
posOf: function {n: astnode.view} out nodepos is {
    match (
        n
    ) case error then {
        return (nodepos line: n.lineno col: n.colno)
    } case atomid then {
        return (nodepos line: n.lineno col: n.colno)
    } case labelvalue then {
        return (nodepos line: n.lineno col: n.colno)
    } case atomstring then {
        return (nodepos line: n.lineno col: n.colno)
    } case dottedpath then {
        return (nodepos line: n.lineno col: n.colno)
    } case call then {
        return (nodepos line: n.lineno col: n.colno)
    } case namedoperation then {
        return (nodepos line: n.lineno col: n.colno)
    } case datablock then {
        return (nodepos line: n.lineno col: n.colno)
    } case stringchunk then {
        return (nodepos line: n.lineno col: n.colno)
    } case statement then {
        return (nodepos line: n.lineno col: n.colno)
    } case statementline then {
        return (nodepos line: n.lineno col: n.colno)
    } case assignment then {
        return (nodepos line: n.lineno col: n.colno)
    } case reassignment then {
        return (nodepos line: n.lineno col: n.colno)
    } case swapstmt then {
        return (nodepos line: n.lineno col: n.colno)
    } case ifexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case ifclause then {
        return (nodepos line: n.lineno col: n.colno)
    } case forexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case doexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case withexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case caseexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case caseclause then {
        return (nodepos line: n.lineno col: n.colno)
    } case functiondef then {
        return (nodepos line: n.lineno col: n.colno)
    } case objectdef then {
        return (nodepos line: n.lineno col: n.colno)
    } case unitdef then {
        return (nodepos line: n.lineno col: n.colno)
    } case program then {
        return (nodepos line: n.lineno col: n.colno)
    } case placeholder then {
        return (nodepos line: 0 col: 0)
    }
}

# Vocab -- a fixed vocabulary read off outside text (a tool's flags and verbs, a
# script's commands), interned into a pool of its own. A reader classifies a
# word by asking `slotOf` for its slot in the block, compares that with the
# block's own `.slot.label`, and never compares the bytes: the pool is where
# that happens, once per word. The pool holds the block alone, in order, so a
# word's id is its slot plus one.
Vocab: class {
    # the vocabulary's words, interned in block order after the sentinel
    pool: StringPool
    # the slot an unknown word answers: one past the block's last
    none: u64
} as {
    # create -- intern every word of `block` in order. A word given twice would
    # break id == slot + 1 for every word after it, so it is refused here.
    create: function {block: stringdata} out this is {
        v: meta.create pool: StringPool.createEmpty none: block.length
        for each w: block loop v.pool.set s: w
        if v.pool.texts.length != (block.length + 1) then {
            panic msg: "zast: a vocabulary names one word twice, so the ids are not the slots"
        }
        return v
    }

    # slotOf -- `text`'s slot in the block, `none` when it is not one of its words
    slotOf: function {this: this.view text: StringView} out u64 is {
        id: this.pool.find s: text
        if id.isZero then return this.none
        return id.u32.u64 - 1
    }
}

# poolFind -- the pool id of an already-interned name (0 when absent). Takes
# the pool as a sibling arg so a caller holding a view into another Ast field
# (the node table) does not lock the whole carrier -- read-only, never interns.
poolFind: function {pool: StringPool.view text: StringView} out nameid is {
    return (pool.find s: text)
}

# poolSet -- intern `text`, returning its 1-based pool id. Mutating
# counterpart of poolFind: takes the pool itself so a caller holding a view
# into a sibling Ast field (the node table) does not lock the whole carrier.
poolSet: function {pool: StringPool text: StringView} out nameid is {
    return (pool.set s: text)
}

# poolTextEq -- compare an interned name's text without copying. Takes the
# pool itself so a caller holding a view into a sibling Ast field (the node
# table) does not lock the whole carrier.
poolTextEq: function {pool: StringPool.view ref: nameid s: StringView} out bool is {
    return (pool.eq id: ref :s)
}

# poolTextCopy -- an owned copy of an interned name's text ("" when the ref
# is absent). Pool-taking counterpart of poolTextEq.
poolTextCopy: function {pool: StringPool.view ref: nameid} out String is {
    return (pool.get id: ref)
}

# nameTextEq -- compare an interned name's text without copying.
nameTextEq: function {ast: Ast.view ref: nameid s: StringView} out bool is {
    return (poolTextEq pool: ast.names :ref :s)
}

# nameTextCopy -- an owned copy of an interned name's text ("" when the
# ref is absent).
nameTextCopy: function {ast: Ast.view ref: nameid} out String is {
    return (poolTextCopy pool: ast.names :ref)
}

# poolTextAt -- a VIEW of an interned name's text: the binding pins its
# source shared for its scope, so every read is allocation-free, and what a
# view lends is a view. A zero ref reads the sentinel row, which holds the
# empty text.
poolTextAt: function {pool: StringPool.view ref: nameid} outx String.view is {
    return (pool.texts.get i: ref)
}

# nameTextAt -- carrier-taking counterpart of poolTextAt.
nameTextAt: function {ast: Ast.view ref: nameid} outx String.view is {
    return (ast.names.texts.get i: ref)
}

# printKidsWith -- print every child a span names, in order. An arm that
# prints a child list is one line, which is what keeps the dispatcher below
# from growing as carrier fields move into the child arena.
printKidsWith: function {ast: Ast.view span: kidspan withId: bool} is {
    ki9: u64
    for ki9 < span.count loop {
        kid: kidAt kids: ast.kids :span i: ki9
        ki9 = ki9 + 1
        printNodeWith :ast :withId n: (ast.nodes.get i: kid)
    }
}

# Print one line per astnode in the form
#   "<nodeid>: <arm> @<lineno>:<colno>"
# Recursive arms descend into their children.
# printNodeWith -- one AST node in the dump format the goldens pin. `withId`
# picks the form: the full dump prefixes every line with the node's id, and
# the canonical dump -- what the parser goldens compare -- carries no ids at
# all, so a renumbered tree still matches. The namedoperation line is the one
# arm that differs beyond the prefix: it has no position in the canonical
# form, the wrapper's position being its child's.
printNodeWith: function {ast: Ast.view n: astnode.view withId: bool} is {
    idp: String
    if withId then idp = "\{nodeIdOf :n}: "
    match (
        n
    ) case error then {
        emsg9: poolTextAt pool: ast.names ref: n.msg
        print "\{idp}error @\{n.lineno}:\{n.colno} err=\{errname n.err} msg=\{emsg9}"
    } case placeholder then {
        print "placeholder"
    } case atomid then {
        anm: nameTextCopy :ast ref: n.name
        print "\{idp}atomid @\{n.lineno}:\{n.colno} name=\{anm}"
    } case labelvalue then {
        lnm: nameTextCopy :ast ref: n.name
        print "\{idp}labelvalue @\{n.lineno}:\{n.colno} name=\{lnm}"
    } case stringchunk then {
        ctx9: poolTextAt pool: ast.names ref: n.text
        print "\{idp}stringchunk @\{n.lineno}:\{n.colno} text=\{ctx9} chunkKind=\{n.chunkKind}"
    } case atomstring then {
        print "\{idp}atomstring @\{n.lineno}:\{n.colno} parts=\{n.stringparts.count.u64}"
        printKidsWith :ast span: n.stringparts :withId
    } case dottedpath then {
        print "\{idp}dottedpath @\{n.lineno}:\{n.colno}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.parent)
        printNodeWith :ast :withId n: (ast.nodes.get i: n.child)
    } case call then {
        print "\{idp}call @\{n.lineno}:\{n.colno} args=\{n.arguments.count.u64}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.callable)
        printKidsWith :ast span: n.arguments :withId
    } case namedoperation then {
        if withId then {
            print "\{idp}namedoperation @\{n.lineno}:\{n.colno}"
        } else {
            print "namedoperation"
        }
        printPoolName :ast ref: n.name
        printNodeWith :ast :withId n: (ast.nodes.get i: n.operation)
    } case datablock then {
        print "\{idp}datablock @\{n.lineno}:\{n.colno} elements=\{n.elements.count}"
        printKidsWith :ast span: n.elements :withId
        print "  outType:"
        printOptChildWith :ast :withId id: n.outType
    } case statement then {
        print "\{idp}statement @\{n.lineno}:\{n.colno} statements=\{n.statements.count.u64}"
        printKidsWith :ast span: n.statements :withId
    } case statementline then {
        print "\{idp}statementline @\{n.lineno}:\{n.colno}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.statementline)
    } case assignment then {
        asn: nameTextCopy :ast ref: n.name
        print "\{idp}assignment @\{n.lineno}:\{n.colno} name=\{asn}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.value)
    } case reassignment then {
        print "\{idp}reassignment @\{n.lineno}:\{n.colno}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.topath)
        printNodeWith :ast :withId n: (ast.nodes.get i: n.value)
    } case swapstmt then {
        print "\{idp}swapstmt @\{n.lineno}:\{n.colno}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.lhs)
        printNodeWith :ast :withId n: (ast.nodes.get i: n.rhs)
    } case ifexpr then {
        print "\{idp}ifexpr @\{n.lineno}:\{n.colno} clauses=\{n.clauses.count.u64}"
        printKidsWith :ast span: n.clauses :withId
        print "  elseclause:"
        printOptChildWith :ast :withId id: n.elseclause
    } case ifclause then {
        print "\{idp}ifclause @\{n.lineno}:\{n.colno} conditions=\{n.conditions.count.u64}"
        printKidsWith :ast span: n.conditions :withId
        printNodeWith :ast :withId n: (ast.nodes.get i: n.statement)
    } case forexpr then {
        print "\{idp}forexpr @\{n.lineno}:\{n.colno} conditions=\{n.conditions.count.u64} isEach=\{n.isEach} postconditions=\{n.postconditions.count.u64}"
        printKidsWith :ast span: n.conditions :withId
        print "  body:"
        printOptChildWith :ast :withId id: n.body
        printKidsWith :ast span: n.postconditions :withId
    } case doexpr then {
        print "\{idp}doexpr @\{n.lineno}:\{n.colno}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.statement)
    } case withexpr then {
        wnm: nameTextCopy :ast ref: n.name
        print "\{idp}withexpr @\{n.lineno}:\{n.colno} name=\{wnm}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.value)
        printNodeWith :ast :withId n: (ast.nodes.get i: n.body)
    } case caseexpr then {
        print "\{idp}caseexpr @\{n.lineno}:\{n.colno} clauses=\{n.clauses.count.u64}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.subject)
        printKidsWith :ast span: n.clauses :withId
        print "  elseclause:"
        printOptChildWith :ast :withId id: n.elseclause
    } case caseclause then {
        ccn: nameTextCopy :ast ref: n.name
        print "\{idp}caseclause @\{n.lineno}:\{n.colno} name=\{ccn}"
        printNodeWith :ast :withId n: (ast.nodes.get i: n.matcharm)
        printNodeWith :ast :withId n: (ast.nodes.get i: n.statement)
    } case functiondef then {
        fdp: ""
        if n.pins then fdp = " pins=true"
        print "\{idp}functiondef @\{n.lineno}:\{n.colno} params=\{n.parameters.count.u64} isNative=\{n.isNative}\{fdp}"
        print "  returntype:"
        printOptChildWith :ast :withId id: n.returntype
        printKidsWith :ast span: n.parameters :withId
        print "  body:"
        printOptChildWith :ast :withId id: n.body
        printKidsWith :ast span: n.asItems :withId
    } case objectdef then {
        print "\{idp}objectdef @\{n.lineno}:\{n.colno} kind=\{objectkindname n.kind} isItems=\{n.isItems.count.u64} asItems=\{n.asItems.count.u64} isNative=\{n.isNative}"
        printKidsWith :ast span: n.isItems :withId
        printKidsWith :ast span: n.asItems :withId
    } case unitdef then {
        print "\{idp}unitdef @\{n.lineno}:\{n.colno} kind=\{unitkindname n.kind} body=\{n.body.count.u64}"
        ubi: u64
        ubn: n.body.count.u64
        for ubi < ubn loop {
            ubid: kidAt kids: ast.kids span: n.body i: ubi
            printNodeWith :ast :withId n: (ast.nodes.get i: ubid)
            ubi = ubi + 1
        }
    } case program then {
        print "\{idp}program @\{n.lineno}:\{n.colno} units=\{ast.units.length} mainUnitName=\{ast.mainUnitName}"
        pui: u64
        pun: ast.units.length
        for pui < pun loop {
            puid: ast.units.get i: pui
            printNodeWith :ast :withId n: (ast.nodes.get i: puid)
            pui = pui + 1
        }
    }
}

# printNode -- the full dump, every line carrying the node's id.
printNode: function {ast: Ast.view n: astnode.view} is {
    printNodeWith :ast :n withId: true
}

# printOptChildWith -- an optional child (0 = absent), in either form.
printOptChildWith: function {ast: Ast.view id: nodeid withId: bool} is {
    if id.isZero then {
        print "  <none>"
    } else {
        c: ast.nodes.get i: id
        printNodeWith :ast n: c :withId
    }
}

# print one AST node in the canonical dump format.
printNodeCanonical: function {ast: Ast.view n: astnode.view} is {
    printNodeWith :ast :n withId: false
}

# printNodeCanonicalAt -- print the row an id names. The row view is this
# frame's, so the table is not fetched from and lent in one call.
printNodeCanonicalAt: function {ast: Ast.view nId: nodeid} is {
    n: ast.nodes.get i: nId
    printNodeCanonical :ast :n
}

# printProgramCanonicalRoot -- canonical dump entry for a parsed tree, whose
# root row `ast.root` names.
printProgramCanonicalRoot: function {ast: Ast.view} is {
    prog: ast.nodes.get i: ast.root
    if prog.program then {
        print "program @\{prog.lineno}:\{prog.colno} units=\{ast.units.length} mainUnitName=\{ast.mainUnitName}"
        pui: u64
        pun: ast.units.length
        for pui < pun loop {
            puid: ast.units.get i: pui
            printNodeCanonicalAt :ast nId: puid
            pui = pui + 1
        }
    }
}

# ---- id-linked master node table ----
# The parser reserves one table slot per minted nodeid; a reserved slot
# holds the payload-less placeholder arm until a converted parent moves
# the real child into it. A nodeid IS its row's index; row 0 is the
# sentinel a node id of 0 addresses.

# tableReserve -- reserve a table slot for a node not yet built, made from the
# node `from`: it reports from that node's file (nodeid.zero: from none). The slot
# holds the placeholder arm until tableAdd moves the finished node in.
tableReserve: function {ast: Ast from: nodeid} out nodeid is {
    return (tableReserveIn :ast file: (ast.fsnoForNode nodeid: from))
}

# tableReserveIn -- tableReserve for a row read from `file`: the parser's form,
# which knows the file it is reading. The only place a row is added, so
# `nodes` and `rowFile` stay row for row.
tableReserveIn: function {ast: Ast file: zvfs.fsno} out nodeid is {
    ast.rowFile.append from: file
    return (ast.nodes.append from: astnode.placeholder)
}

# tableSet -- move a converted parent's child into its reserved slot
# (the displaced placeholder is destroyed here).
tableSet: function {ast: Ast id: nodeid child: astnode} is {
    ast.nodes.set i: id val: child
}

# childIds -- the child node ids of `n`, in canonical order: the order every
# walk and the dump visit them in. A walk that needs no per-arm semantics
# recurses over this list; a walk that binds names or skips a child keeps its
# own arm for that child and takes the rest from here. Absent optional
# children (an if without else, a function without a body) are omitted, and a
# program's children are the program's units.
childIds: function {ast: Ast.view n: astnode.view} out ListVal nodeid is {
    acc: ListVal nodeid
    childIdsInto :ast :n :acc
    return acc
}

# childIdsInto -- childIds appending into a caller-supplied list rather than a
# fresh one. A walk that recurses through childIds allocates a list per NODE;
# driving the same walk from one list it both reads and appends to allocates
# one per WALK. The list is not cleared, so it doubles as the walk's worklist.
childIdsInto: function {ast: Ast.view n: astnode.view acc: ListVal nodeid} is {
    match (
        n
    ) case atomstring then {
        appendSpan kids: ast.kids :acc span: n.stringparts
    } case dottedpath then {
        acc.append from: n.parent
        acc.append from: n.child
    } case call then {
        acc.append from: n.callable
        appendSpan kids: ast.kids :acc span: n.arguments
    } case namedoperation then {
        acc.append from: n.operation
    } case datablock then {
        appendSpan kids: ast.kids :acc span: n.elements
        appendOptId :acc id: n.outType
    } case statement then {
        appendSpan kids: ast.kids :acc span: n.statements
    } case statementline then {
        acc.append from: n.statementline
    } case assignment then {
        acc.append from: n.value
    } case reassignment then {
        acc.append from: n.topath
        acc.append from: n.value
    } case swapstmt then {
        acc.append from: n.lhs
        acc.append from: n.rhs
    } case ifexpr then {
        appendSpan kids: ast.kids :acc span: n.clauses
        appendOptId :acc id: n.elseclause
    } case ifclause then {
        appendSpan kids: ast.kids :acc span: n.conditions
        acc.append from: n.statement
    } case forexpr then {
        appendSpan kids: ast.kids :acc span: n.conditions
        appendOptId :acc id: n.body
        appendSpan kids: ast.kids :acc span: n.postconditions
    } case doexpr then {
        acc.append from: n.statement
    } case withexpr then {
        acc.append from: n.value
        acc.append from: n.body
    } case caseexpr then {
        acc.append from: n.subject
        appendSpan kids: ast.kids :acc span: n.clauses
        appendOptId :acc id: n.elseclause
    } case caseclause then {
        acc.append from: n.matcharm
        acc.append from: n.statement
    } case functiondef then {
        appendOptId :acc id: n.returntype
        appendSpan kids: ast.kids :acc span: n.parameters
        appendOptId :acc id: n.body
        appendSpan kids: ast.kids :acc span: n.asItems
    } case objectdef then {
        appendSpan kids: ast.kids :acc span: n.isItems
        appendSpan kids: ast.kids :acc span: n.asItems
    } case unitdef then {
        appendSpan kids: ast.kids :acc span: n.body
    } case program then {
        appendIds :acc ids: ast.units
    } else null
}

# cloneTreeAt -- a deep copy of the subtree the row `nid` names: every row a
# fresh node, every position kept. The children are copied and interned first,
# in canonical order (childIdsInto), then the copy's own slot is reserved; each
# row view is scoped to a block that lends nothing. Answers the copy, which the
# caller interns (tableAdd). A program row copies without its units.
cloneTreeAt: function {ast: Ast nid: nodeid} out astnode is {
    kids: ListVal nodeid
    {
        n: ast.nodes.get i: nid
        childIdsInto :ast :n acc: kids
    }
    cloned: ListVal nodeid
    ki: u64
    for ki < kids.length loop {
        c: cloneTreeAt :ast nid: (kids.get i: ki)
        cloned.append (tableAdd :ast n: c)
        ki = ki + 1
    }
    myId: tableReserve :ast from: nid
    built: astnode.placeholder
    {
        n: ast.nodes.get i: nid
        built = cloneArm :n :myId :cloned kids: ast.kids
    }
    return built
}

# cloneArm -- the copy of `n`'s arm under `myId`, its children the interned
# copies in `cloned` (canonical childIds order; an absent optional child is
# simply not there). Reads the view only.
cloneArm: function {
    kids: ListVal nodeid
    n: astnode.view
    myId: nodeid
    cloned: (ListVal nodeid).view
} out astnode is {
    match (
        n
    ) case atomid then {
        return (astnode.atomid (atomidrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            grouped: n.grouped
        )
        )
    } case labelvalue then {
        return (astnode.labelvalue (labelvaluerow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            forwards: n.forwards
        )
        )
    } case dottedpath then {
        return (astnode.dottedpath (dottedpathrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            parent: (cloned.get i: 0)
            child: (cloned.get i: 1)
            grouped: n.grouped
        )
        )
    } case call then {
        return (astnode.call (callrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            callable: (cloned.get i: 0)
            arguments: (kidsAddWindow :kids xs: (cloned.slice from: 1 to: cloned.length))
            infix: n.infix
        )
        )
    } case namedoperation then {
        return (astnode.namedoperation (namedoperationrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            operation: (cloned.get i: 0)
        )
        )
    } case statement then {
        return (astnode.statement (statementrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            statements: (kidsAddWindow :kids xs: (cloned.slice from: 0 to: cloned.length))
        )
        )
    } case statementline then {
        return (astnode.statementline (statementlinerow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            statementline: (cloned.get i: 0)
        )
        )
    } case assignment then {
        return (astnode.assignment (assignmentrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            value: (cloned.get i: 0)
        )
        )
    } case reassignment then {
        return (astnode.reassignment (reassignmentrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            topath: (cloned.get i: 0)
            value: (cloned.get i: 1)
        )
        )
    } case swapstmt then {
        return (astnode.swapstmt (swapstmtrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            lhs: (cloned.get i: 0)
            rhs: (cloned.get i: 1)
        )
        )
    } case ifexpr then {
        k: n.clauses.count.u64
        els: nodeid
        if n.elseclause.isZero.not then els = cloned.get i: k
        return (astnode.ifexpr (ifrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            clauses: (kidsAddWindow :kids xs: (cloned.slice from: 0 to: k))
            elseclause: els
        )
        )
    } case ifclause then {
        k: n.conditions.count.u64
        return (astnode.ifclause (ifclauserow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            conditions: (kidsAddWindow :kids xs: (cloned.slice from: 0 to: k))
            statement: (cloned.get i: k)
        )
        )
    } case forexpr then {
        k: n.conditions.count.u64
        bodyId: nodeid
        postsAt: k
        if n.body.isZero.not then {
            bodyId = cloned.get i: k
            postsAt = k + 1
        }
        return (astnode.forexpr (forrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            conditions: (kidsAddWindow :kids xs: (cloned.slice from: 0 to: k))
            isEach: n.isEach
            body: bodyId
            postconditions: (kidsAddWindow
                :kids
                xs: (cloned.slice from: postsAt to: cloned.length)
            )
        )
        )
    } case doexpr then {
        return (astnode.doexpr (dorow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            statement: (cloned.get i: 0)
        )
        )
    } case withexpr then {
        return (astnode.withexpr (withrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            value: (cloned.get i: 0)
            body: (cloned.get i: 1)
        )
        )
    } case caseexpr then {
        k: n.clauses.count.u64
        els: nodeid
        if n.elseclause.isZero.not then els = cloned.get i: k + 1
        return (astnode.caseexpr (caserow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            subject: (cloned.get i: 0)
            clauses: (kidsAddWindow :kids xs: (cloned.slice from: 1 to: k + 1))
            elseclause: els
        )
        )
    } case caseclause then {
        return (astnode.caseclause (caseclauserow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            matcharm: (cloned.get i: 0)
            statement: (cloned.get i: 1)
        )
        )
    } case atomstring then {
        return (astnode.atomstring (atomstringrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            stringparts: (kidsAddWindow :kids xs: (cloned.slice from: 0 to: cloned.length))
        )
        )
    } case stringchunk then {
        ckL: n.chunkKind
        return (astnode.stringchunk (stringchunkrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            text: n.text
            chunkKind: ckL
        )
        )
    } case error then {
        return (astnode.error (errorrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            width: n.width
            err: n.err
            msg: n.msg
            fsno: n.fsno
            note: n.note
            hint: n.hint
        )
        )
    } case datablock then {
        k: n.elements.count.u64
        ot: nodeid
        if n.outType.isZero.not then ot = cloned.get i: k
        return (astnode.datablock (datablockrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            elements: (kidsAddWindow :kids xs: (cloned.slice from: 0 to: k))
            outType: ot
        )
        )
    } case functiondef then {
        at: u64
        rt: nodeid
        if n.returntype.isZero.not then {
            rt = cloned.get i: at
            at = at + 1
        }
        pn: n.parameters.count.u64
        ps: kidsAddWindow :kids xs: (cloned.slice from: at to: at + pn)
        at = at + pn
        bd: nodeid
        if n.body.isZero.not then {
            bd = cloned.get i: at
            at = at + 1
        }
        return (astnode.functiondef (functionrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            returntype: rt
            parameters: ps
            body: bd
            isNative: n.isNative
            pins: n.pins
            asItems: (kidsAddWindow :kids xs: (cloned.slice from: at to: cloned.length))
        )
        )
    } case objectdef then {
        k: n.isItems.count.u64
        return (astnode.objectdef (objectdefrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            kind: n.kind
            isItems: (kidsAddWindow :kids xs: (cloned.slice from: 0 to: k))
            asItems: (kidsAddWindow :kids xs: (cloned.slice from: k to: cloned.length))
            isNative: n.isNative
        )
        )
    } case unitdef then {
        return (astnode.unitdef (unitrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            kind: n.kind
            body: (kidsAddWindow :kids xs: (cloned.slice from: 0 to: cloned.length))
        )
        )
    } else {
        return astnode.placeholder
    }
}


# childIdsAt -- childIds of the node with id `id`.
childIdsAt: function {ast: Ast.view id: nodeid} out ListVal nodeid is {
    return (childIds :ast n: (ast.nodes.get i: id))
}

# spanEndLineAt -- the last source line any node under `id` (itself included)
# starts on: how far down a body reaches, one line above its closing brace.
spanEndLineAt: function {ast: Ast.view id: nodeid} out u32 is {
    p: posOf n: (ast.nodes.get i: id)
    best: p.line
    kids: childIdsAt :ast :id
    for each k: kids loop {
        kl: spanEndLineAt :ast id: k
        if kl > best then best = kl
    }
    return best
}

# stmtLineCount -- the number of lines in statement block `nid` (0 for any
# other arm).
stmtLineCount: function {ast: Ast.view nid: nodeid} out u64 is {
    n: ast.nodes.get i: nid
    if n.statement then return n.statements.count
    return 0
}

# stmtLineAt -- the id of line `i` of statement block `nid` (0 for any other
# arm).
stmtLineAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.statement then return (kidAt kids: ast.kids span: n.statements :i)
    zn: nodeid
    return zn
}

# ifCondAt -- the id of condition `i` of if-clause `nid` (0 for any other arm).
ifCondAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.ifclause then return (kidAt kids: ast.kids span: n.conditions :i)
    zn: nodeid
    return zn
}

# dataElemAt -- the id of element `i` of data block `nid` (0 for any other
# arm).
dataElemAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.datablock then return (kidAt kids: ast.kids span: n.elements :i)
    zn: nodeid
    return zn
}

# caseClauseAt -- the id of clause `i` of match `nid` (0 for any other arm).
caseClauseAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.caseexpr then return (kidAt kids: ast.kids span: n.clauses :i)
    zn: nodeid
    return zn
}

# ifClauseAt -- the id of clause `i` of if `nid` (0 for any other arm).
ifClauseAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.ifexpr then return (kidAt kids: ast.kids span: n.clauses :i)
    zn: nodeid
    return zn
}

# forCondAt -- the id of condition `i` of for `nid` (0 for any other arm).
forCondAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.forexpr then return (kidAt kids: ast.kids span: n.conditions :i)
    zn: nodeid
    return zn
}

# forPostAt -- the id of postcondition `i` of for `nid` (0 for any other arm).
forPostAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.forexpr then return (kidAt kids: ast.kids span: n.postconditions :i)
    zn: nodeid
    return zn
}

# objIsItemAt -- the id of `is`-item `i` of object definition `nid` (0 for
# any other arm).
objIsItemAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.objectdef then return (kidAt kids: ast.kids span: n.isItems :i)
    zn: nodeid
    return zn
}

# objAsItemAt -- the id of `as`-item `i` of object definition `nid` (0 for
# any other arm).
objAsItemAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.objectdef then return (kidAt kids: ast.kids span: n.asItems :i)
    zn: nodeid
    return zn
}

# fnParamAt -- the id of parameter `i` of function `nid` (0 for any other
# arm).
fnParamAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.functiondef then return (kidAt kids: ast.kids span: n.parameters :i)
    zn: nodeid
    return zn
}

# isYieldCalleeAt -- the callable `callableId` is the single name `yield`.
#
# Syntactic, and deliberately so. Generator LOWERING runs before anything is
# resolved, so it cannot ask what the callee resolves to -- but it only ever
# asks INSIDE a body already established to be a generator's, which the
# declared return type decided. That is the same bargain `break` and
# `continue` strike: the SCOPE decides legality, the name id does the naming.
# Passes that run after the checker read the `yieldCall` stamp instead.
isYieldCalleeAt: function {ast: Ast.view callableId: nodeid} out bool is {
    if callableId.isZero then return false
    cal: ast.nodes.get i: callableId
    match (
        cal
    ) case atomid then {
        return cal.name == wellKnown.slot.wkYield
    } else {
        return false
    }
}

# yieldCallIdAt -- the id of the yield CALL at `nid`, peeling the statement line
# a statement position puts around it; 0 when there is no yield call there.
# Callers hold the line, not the call, so the peel belongs here rather than at
# each of them.
yieldCallIdAt: function {ast: Ast.view nid: nodeid} out nodeid is {
    if nid.isZero then return nodeid
    n: ast.nodes.get i: nid
    match (
        n
    ) case statementline then {
        return (yieldCallIdAt :ast nid: n.statementline)
    } case call then {
        if (isYieldCalleeAt :ast callableId: n.callable) then return nid
        return nodeid
    } else {
        return nodeid
    }
}

# yieldCallOperandAt -- the value a yield call yields: its one unlabelled
# argument. 0 when `nid` is not a yield call, or carries no such argument -- a
# labelled `yield x: 1` binds the label to yield itself, which the checker
# reports rather than silently reading as the yielded value.
yieldCallOperandAt: function {ast: Ast.view nid: nodeid} out nodeid is {
    cid: yieldCallIdAt :ast :nid
    if cid.isZero then return nodeid
    n: ast.nodes.get i: cid
    match (
        n
    ) case call then {
        if n.arguments.count.u64 != 1 then return nodeid
        a0: ast.nodes.get i: (kidAt kids: ast.kids span: n.arguments i: 0)
        match (
            a0
        ) case namedoperation then {
            if a0.name.isZero.not then return nodeid
            return a0.operation
        } else {
            return nodeid
        }
    } else {
        return nodeid
    }
}

# yieldCountOf / yieldCountIn -- how many suspension points a body holds.
#
# ONE definition, because two consumers have to agree exactly: generator
# LOWERING sizes the state class's resume slots by this, and the EMITTER
# numbers its resume labels by it. A body counted differently in those two
# places gives a switch arm with no slot behind it.
#
# The NODE form is the primary one. Lowering asks about a body it has just
# minted and not yet placed in the table, so an id would read the reserved
# placeholder and answer 0 -- which is exactly the silent undercount this pair
# exists to prevent. Children are in the table and are reached by id.
#
# A nested function's yields belong to that function, so the walk stops there.
# Everything else is reached through childIds, which is what lets it see a
# yield nested inside another expression.
yieldCountOf: function {ast: Ast.view n: astnode.view} out u64 is {
    if n.functiondef then return 0
    c: u64
    if n.call when (isYieldCalleeAt :ast callableId: n.callable) then c = 1
    # one worklist for the whole subtree, not a child list per node. The count
    # is a SUM, so the order the worklist drains in does not matter.
    work: ListVal nodeid
    childIdsInto :ast :n acc: work
    wi: u64
    for wi < work.length loop {
        wid: work.get i: wi
        wi = wi + 1
        if wid.isZero.not then {
            wn: ast.nodes.get i: wid
            if wn.functiondef.not then {
                if wn.call when (isYieldCalleeAt :ast callableId: wn.callable) then c = c + 1
                childIdsInto :ast n: wn acc: work
            }
        }
    }
    return c
}

# yieldCountIn -- yieldCountOf for a node already in the table.
yieldCountIn: function {ast: Ast.view nid: nodeid} out u64 is {
    if nid.isZero then return 0
    n: ast.nodes.get i: nid
    return (yieldCountOf :ast :n)
}

# suspendingForCountOf -- how many LABEL-BOUND `for` loops in a body have a
# suspension somewhere inside them.
#
# ONE definition, for the same reason `yieldCountOf` is one: generator LOWERING
# sizes the state class's loop-counter fields by this, and the EMITTER draws a
# counter from that pool for each such loop it writes. A body counted
# differently in those two places gives a header naming a field that is not
# there.
#
# Order does NOT have to agree, only the total: every counter field is an i64
# and any distinct one will do, exactly as for the resume slots. So this
# deliberately OVER-counts -- it says `for each x: E loop`, while the emitter claims
# a counter only for the ones that turn out to be an integer RANGE. Telling the
# two apart needs the checker's stamps, which this walk does not have, and a
# spare i64 field costs nothing.
#
# It takes the NODE for the same reason `yieldCountOf` does: lowering asks about
# a body it has just minted and not yet placed in the table. There is no id
# form, because the worklist below reaches the children itself.
suspendingForCountOf: function {ast: Ast.view n: astnode.view} out u64 is {
    if n.functiondef then return 0
    c: u64
    if n.forexpr when n.conditions.count.u64 == 1 when (yieldCountIn :ast nid: n.body) > 0 then {
        c0: ast.nodes.get i: (kidAt kids: ast.kids span: n.conditions i: 0)
        if c0.namedoperation when (nameTextAt :ast ref: c0.name).length > 0 then c = 1
    }
    # one worklist for the whole subtree, as in yieldCountOf, and for the same
    # reason: this is a sum, so drain order is free.
    work: ListVal nodeid
    childIdsInto :ast :n acc: work
    wi: u64
    for wi < work.length loop {
        wid: work.get i: wi
        wi = wi + 1
        if wid.isZero.not then {
            wn: ast.nodes.get i: wid
            if wn.functiondef.not then {
                if wn.forexpr when wn.conditions.count.u64 == 1 when (
                    (yieldCountIn :ast nid: wn.body) > 0
                ) then {
                    w0: ast.nodes.get i: (kidAt kids: ast.kids span: wn.conditions i: 0)
                    if w0.namedoperation when (nameTextAt :ast ref: w0.name).length > 0 then c = (
                        c + 1
                    )
                }
                childIdsInto :ast n: wn acc: work
            }
        }
    }
    return c
}

# callArgAt -- the id of argument `i` of call `nid` (0 for any other arm).
callArgAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.call then return (kidAt kids: ast.kids span: n.arguments :i)
    zn: nodeid
    return zn
}

# stringPartAt -- the id of part `i` of interpolated string `nid` (0 for any
# other arm).
stringPartAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid
    if n.atomstring then return (kidAt kids: ast.kids span: n.stringparts :i)
    zn: nodeid
    return zn
}

# appendIds -- append every id in `ids` to `acc`. A walk collects a node's
# children through one accumulator rather than a fresh list per visit, which is
# where the per-visit lists went.
# kidsAdd1 -- ONE kid, with no list to carry it. The infix fold mints a call
# per operator in the program and every one of them has exactly one argument,
# so building a one-element list just to copy it out cost a heap block for
# every operator a self-compile sees.
kidsAdd1: function {kids: ListVal nodeid x: nodeid} out kidspan is {
    f: kids.length.u32.orPanic
    kids.append from: x
    return (kidspan first: f count: 1)
}

# kidsAdd -- copy `xs` into the child arena and answer the span naming it. The
# copy is what makes a span contiguous: the parser builds a node's children
# while parsing grandchildren that are appending here too, so the window can
# only be claimed once the list is finished.
kidsAdd: function {kids: ListVal nodeid xs: (ListVal nodeid).view} out kidspan is {
    n: xs.length
    if n == 0 then return (kidspan first: 0 count: 0)
    f: kids.length.u32.orPanic
    for each x: xs loop kids.append from: x
    return (kidspan first: f count: n.u32.orPanic)
}

# kidsAddWindow -- kidsAdd over a WINDOW rather than over a list of its own.
# The rows are the same; what goes away is materialising a copy of a range
# just to read it once. The window pins its source SHARED for its lifetime,
# which is why `kids` and the window's source must be different lists -- every
# caller appends to the node's own kid table and windows a clone.
kidsAddWindow: function {kids: ListVal nodeid xs: ListViewVal nodeid} out kidspan is {
    n: xs.length
    if n == 0 then return (kidspan first: 0 count: 0)
    f: kids.length.u32.orPanic
    for each x: xs loop kids.append from: x
    return (kidspan first: f count: n.u32.orPanic)
}

# kidAt -- child `i` of `span`. Out of range is a panic, not a sentinel: a walk
# reads `span.count` first and a bad index is a bug in the walk.
kidAt: function {kids: (ListVal nodeid).view span: kidspan i: u64} out nodeid is {
    return (kids.get i: span.first.u64 + i)
}

# kidIds -- the children of `span`, in order, as a list of their own: the shape
# a walk wants when it visits them more than once or hands them on
kidIds: function {ast: Ast.view span: kidspan} out ListVal nodeid is {
    ids: ListVal nodeid
    i: u64
    for i < span.count loop {
        ids.append from: (kidAt kids: ast.kids :span :i)
        i = i + 1
    }
    return ids
}

# The three ids an `a op b` expression is made of. `found` is false for every
# other node, so one walk reads the receiver, the operator and the argument
# of an infix expression wherever it meets one.
infixparts: record {
    # true when the node IS an infix call and the three ids below are real
    found: bool
    # the receiver -- the left operand
    lhs: nodeid
    # the operator, itself a node: an operator is an identifier, not a token kind
    operator: nodeid
    # the argument -- the right operand
    rhs: nodeid
}

# infixPartsOf -- destructure an INFIX call back into receiver, operator and
# argument. `a op b` IS `a.op b`, so the receiver and the operator are the
# callable's dotted path and the right operand is the call's one unlabelled
# argument. THIS IS THE ONE PLACE THAT KNOWS THAT LAYOUT: every walk that
# reads an operator expression comes through here, so the shape is described
# once rather than re-derived per consumer.
infixPartsOf: function {ast: Ast.view n: astnode.view} out infixparts is {
    absent: infixparts found: false lhs: nodeid operator: nodeid rhs: nodeid
    match (
        n
    ) case call then {
        if n.infix.not then return absent
        if n.arguments.count.u64 != 1 then return absent
        cb: ast.nodes.get i: n.callable
        match (
            cb
        ) case dottedpath then {
            aId: kidAt kids: ast.kids span: n.arguments i: 0
            an: ast.nodes.get i: aId
            match (
                an
            ) case namedoperation then {
                return (infixparts
                    found: true
                    lhs: cb.parent
                    operator: cb.child
                    rhs: an.operation
                )
            } else {
                return absent
            }
        } else {
            return absent
        }
    } else {
        return absent
    }
}

# objItemIds -- every member node of an object definition, its `is` items then
# its `as` items; empty when `nid` is not an object definition
objItemIds: function {ast: Ast.view nid: nodeid} out ListVal nodeid is {
    ids: ListVal nodeid
    n: ast.nodes.get i: nid
    match (
        n
    ) case objectdef then {
        ids = kidIds :ast span: n.isItems
        more: kidIds :ast span: n.asItems
        for each k: more loop ids.append from: k
    } else null
    return ids
}

# namedsite -- what a named member's node says about itself: the name, the
# operation the name labels, and where it is. Every field is zero for a node
# that is not a namedoperation, so `name.isZero` is the test.
namedsite: record {
    # the member's name
    name: nameid
    # the operation the name labels
    operation: nodeid
    # the source line of the name
    line: u32
    # the source column of the name
    col: u32
}

# namedSiteAt -- the namedsite of node `nid`
namedSiteAt: function {ast: Ast.view nid: nodeid} out namedsite is {
    n: ast.nodes.get i: nid
    match (
        n
    ) case namedoperation then {
        return (namedsite name: n.name operation: n.operation line: n.lineno col: n.colno)
    } else {
        return (namedsite
            name: nameid.zero
            operation: nodeid
            line: 0
            col: 0
        )
    }
}

# appendSpan -- append every id in `span` to `acc`, the span twin of appendIds.
appendSpan: function {kids: (ListVal nodeid).view acc: ListVal nodeid span: kidspan} is {
    si: u64
    for si < span.count loop {
        acc.append from: (kidAt :kids :span i: si)
        si = si + 1
    }
}

# appendIds -- append every id in `ids` to `acc`. A walk collects a node's
# children through one accumulator rather than a fresh list per visit, which is
# where the per-visit lists went.
appendIds: function {acc: ListVal nodeid ids: (ListVal nodeid).view} is {
    for each i: ids loop acc.append from: i
}

# appendOptId -- append `id` unless it is the zero sentinel, so a caller
# collecting an OPTIONAL child needs no test of its own.
appendOptId: function {acc: ListVal nodeid id: nodeid} is {
    if id.isZero.not then acc.append from: id
}

# nodeIdOf -- a node's own id (any arm).
nodeIdOf: function {n: astnode.view} out nodeid is {
    zn: nodeid
    match (
        n
    ) case error then {
        return n.nodeid
    } case placeholder then {
        return zn
    } case atomid then {
        return n.nodeid
    } case labelvalue then {
        return n.nodeid
    } case stringchunk then {
        return n.nodeid
    } case atomstring then {
        return n.nodeid
    } case dottedpath then {
        return n.nodeid
    } case call then {
        return n.nodeid
    } case namedoperation then {
        return n.nodeid
    } case datablock then {
        return n.nodeid
    } case statement then {
        return n.nodeid
    } case statementline then {
        return n.nodeid
    } case assignment then {
        return n.nodeid
    } case reassignment then {
        return n.nodeid
    } case swapstmt then {
        return n.nodeid
    } case ifexpr then {
        return n.nodeid
    } case ifclause then {
        return n.nodeid
    } case forexpr then {
        return n.nodeid
    } case doexpr then {
        return n.nodeid
    } case withexpr then {
        return n.nodeid
    } case caseexpr then {
        return n.nodeid
    } case caseclause then {
        return n.nodeid
    } case functiondef then {
        return n.nodeid
    } case objectdef then {
        return n.nodeid
    } case unitdef then {
        return n.nodeid
    } case program then {
        return n.nodeid
    }
}

# tableAdd -- move a finished node into its reserved slot; returns its id.
tableAdd: function {ast: Ast n: astnode} out nodeid is {
    id: nodeIdOf :n
    tableSet :ast :id child: n
    return id
}

# tableTake -- swap a row out of the table (a placeholder goes back in);
# used to propagate an error node up out of a converted list.
tableTake: function {ast: Ast id: nodeid} out astnode is {
    return (ast.nodes.set i: id val: astnode.placeholder)
}

# isErrorAt -- the node with id `id` is an error arm.
isErrorAt: function {ast: Ast.view id: nodeid} out bool is {
    n: ast.nodes.get i: id
    if n.error then return true
    return false
}

# armName -- the name of `n`'s arm, as spelled in the astnode union.
armName: function {n: astnode.view} out StringView is {
    match (
        n
    ) case error then {
        return "error"
    } case placeholder then {
        return "placeholder"
    } case atomid then {
        return "atomid"
    } case labelvalue then {
        return "labelvalue"
    } case stringchunk then {
        return "stringchunk"
    } case atomstring then {
        return "atomstring"
    } case dottedpath then {
        return "dottedpath"
    } case call then {
        return "call"
    } case namedoperation then {
        return "namedoperation"
    } case datablock then {
        return "datablock"
    } case statement then {
        return "statement"
    } case statementline then {
        return "statementline"
    } case assignment then {
        return "assignment"
    } case reassignment then {
        return "reassignment"
    } case swapstmt then {
        return "swapstmt"
    } case ifexpr then {
        return "ifexpr"
    } case ifclause then {
        return "ifclause"
    } case forexpr then {
        return "forexpr"
    } case doexpr then {
        return "doexpr"
    } case withexpr then {
        return "withexpr"
    } case caseexpr then {
        return "caseexpr"
    } case caseclause then {
        return "caseclause"
    } case functiondef then {
        return "functiondef"
    } case objectdef then {
        return "objectdef"
    } case unitdef then {
        return "unitdef"
    } case program then {
        return "program"
    }
}

# markerkind -- what the last segment of a path marks. The kind is syntax --
# the lexer's marker keywords -- so it is read from the leaf's name id, and
# needs no types; what a marker DOES in a given place is the checker's.
markerkind: variant {
    # the leaf is a name, not a marker
    unmarked: null
    # `.take`: the value moves out of its path
    takeMarker: null
    # `.borrow`: a reference that may write through
    borrowMarker: null
    # `.view`: a reference that may only read
    viewMarker: null
    # `.hold`: moved in, then frozen
    holdMarker: null
    # `.drop`: the statement that ends a name early
    dropMarker: null
    # `.private`: the friend handle
    privateMarker: null
    # `.generic`: the bound of a generic parameter
    genericBound: null
} as { tag: u8.tag }

# markerKindOfName -- the marker a leaf's name id spells, `unmarked` for any
# other name.
markerKindOfName: function {id: nameid} out markerkind is {
    if id == wellKnown.slot.wkTake then return markerkind.takeMarker
    if id == wellKnown.slot.wkBorrow then return markerkind.borrowMarker
    if id == wellKnown.slot.wkView then return markerkind.viewMarker
    if id == wellKnown.slot.wkHold then return markerkind.holdMarker
    if id == wellKnown.slot.wkDrop then return markerkind.dropMarker
    if id == wellKnown.slot.wkPrivate then return markerkind.privateMarker
    if id == wellKnown.slot.wkGeneric then return markerkind.genericBound
    return markerkind.unmarked
}

# markerKindOfLeaf -- the marker a path's leaf node spells: its atom or label
# value's name.
markerKindOfLeaf: function {ast: Ast.view leaf: nodeid} out markerkind is {
    c: ast.nodes.get i: leaf
    match (
        c
    ) case atomid then {
        return (markerKindOfName id: c.name)
    } case labelvalue then {
        return (markerKindOfName id: c.name)
    } else {
        return markerkind.unmarked
    }
}

# markerKindOf -- the marker a dotted path ends in; `unmarked` for a path that
# ends in a name, and for any other node.
markerKindOf: function {ast: Ast.view n: astnode.view} out markerkind is {
    match (
        n
    ) case dottedpath then {
        return (markerKindOfLeaf :ast leaf: n.child)
    } else {
        return markerkind.unmarked
    }
}

# isGroupedPath -- `n` is a name or a dotted path written inside parentheses of
# its own.
isGroupedPath: function {n: astnode.view} out bool is {
    match (
        n
    ) case atomid then {
        return n.grouped
    } case dottedpath then {
        return n.grouped
    } else {
        return false
    }
}

# isForwardingLabel -- `n` is a synthesized `:name` that hands a parameter on as
# it is (labelvaluerow's `forwards`).
isForwardingLabel: function {n: astnode.view} out bool is {
    match (
        n
    ) case labelvalue then {
        return n.forwards
    } else {
        return false
    }
}

# isValueMarkerLeaf -- the leaf spells a marker that says what a VALUE is handed
# on as: `.copy`, `.take`, `.borrow`, `.view` or `.hold`. `.copy` is a name, not
# a keyword, so it is told by its text.
isValueMarkerLeaf: function {ast: Ast.view leaf: nodeid} out bool is {
    k: markerKindOfLeaf :ast :leaf
    if k.takeMarker or k.borrowMarker or k.viewMarker or k.holdMarker then return true
    c: ast.nodes.get i: leaf
    match (
        c
    ) case atomid then {
        return c.name == wellKnown.slot.wkCopy
    } else {
        return false
    }
}

# callsBeforeMarker -- the dotted path `parent.child` has a parent written in
# parentheses of its own and a value marker for its child: `(mk).copy`. The
# parentheses force the parent's call, and the marker applies to the result.
callsBeforeMarker: function {ast: Ast.view parent: nodeid child: nodeid} out bool is {
    if (isGroupedPath n: (ast.nodes.get i: parent)).not then return false
    return (isValueMarkerLeaf :ast leaf: child)
}

# isGenericParamOp -- true when `opId` declares a generic parameter --
# `<constraint>.generic` -- unwrapping the call the form can carry. The parser marks a unit body holding one
# as a template; the typechecker asks the same question of a type body.
isGenericParamOp: function {ast: Ast.view opId: nodeid} out bool is {
    if opId.isZero then return false
    n: ast.nodes.get i: opId
    match (
        n
    ) case call then {
        return (isGenericParamOp :ast opId: n.callable)
    } case dottedpath then {
        return (markerKindOfLeaf :ast leaf: n.child).genericBound
    } else {
        return false
    }
}

# True when any member of the definition list `items` declares a generic
# parameter, i.e. the body it came from is a template.
itemsHaveGenericParam: function {ast: Ast.view items: zast.kidspan} out bool is {
    hi: u64
    hn: items.count.u64
    for hi < hn loop {
        hid: kidAt kids: ast.kids span: items i: hi
        hm: ast.nodes.get i: hid
        if hm.namedoperation when (isGenericParamOp :ast opId: hm.operation) then return true
        hi = hi + 1
    }
    return false
}

# True when node `opId` is a unit definition of kind `k`. False when the
# node is not a unit definition at all.
unitOpKindIs: function {ast: Ast.view opId: nodeid k: unitkind} out bool is {
    if opId.isZero then return false
    n: ast.nodes.get i: opId
    match (
        n
    ) case unitdef then {
        return n.kind.tag == k.tag
    } else {
        return false
    }
}

# unitOpDeclaresUnit -- does this op declare a UNIT of static definitions: a
# file unit root, an inline `m: unit { }` (both `namespace`) or a hidden
# implementation subunit (`subunit`), or a `public:` block -- a nested unit
# named `public` whose body designates the unit's surface? False for a
# `template` and for the `private:` / `require:` block forms, which are not
# units.
#
# The two arms are NOT interchangeable and this does not merge them: a hidden
# subunit is private to its parent (only the parent may name it), while an
# inline unit is an ordinary definition, public by default; both resolve
# outward alike. A caller that cares asks `unitkind.subunit` -- what this answers is
# only "is there a unit body here", which is the question every walker that
# recurses into one was open-coding as the disjunction.
unitOpDeclaresUnit: function {ast: Ast.view opId: nodeid} out bool is {
    if (unitOpKindIs :ast :opId k: unitkind.namespace) then return true
    if (unitOpKindIs :ast :opId k: unitkind.publicNs) then return true
    return (unitOpKindIs :ast :opId k: unitkind.subunit)
}

# unitBodyIdsAt -- a unit row's member ids. The row view is scoped to this
# fetch so the caller may lend the table exclusively afterwards; the ids are
# values, so the returned list is independent of the table. An id that does
# not name a unit yields an empty list.
unitBodyIdsAt: function {ast: Ast.view unitId: nodeid} out kidspan is {
    u: ast.nodes.get i: unitId
    if u.unitdef then return u.body
    return (kidspan first: 0 count: 0)
}
