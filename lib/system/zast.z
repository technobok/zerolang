# Parsed-AST surface for the zerolang compiler: the object-definition kind
# (objectkind), error codes (err), call classification (callkind), the Node
# union of all node kinds, and the id-linked node table (Ast) the parser
# fills.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :nameid
    :nodeid
    :AssignmentData
    :Ast
    :AtomIdData
    :AtomStringData
    :BinOpData
    :CallData
    :CaseClauseData
    :CaseData
    :DataBlockData
    :DoData
    :DottedPathData
    :ErrorData
    :ExpressionData
    :FileSeg
    :ForData
    :FunctionData
    :IfClauseData
    :IfData
    :LabelValueData
    :NamedOperationData
    :Node
    :ObjectDefData
    :ProgramData
    :ReassignmentData
    :StatementData
    :StatementLineData
    :StringChunkData
    :StringPool
    :SwapStmtData
    :TypeOfExprData
    :UnitData
    :WithData
    :YieldExprData
    :callkind
    :callkindname
    :err
    :errCode
    :errorLine
    :explainText
    :armName
    :objectkindname
    :errname
    :isErrorAt
    :childIds
    :childIdsAt
    :stmtLineCount
    :stmtLineAt
    :ifCondAt
    :stringPartAt
    :callArgAt
    :fnParamAt
    :objIsItemAt
    :objAsItemAt
    :caseClauseAt
    :ifClauseAt
    :forCondAt
    :forPostAt
    :dataElemAt
    :nameTextAt
    :nameTextCopy
    :nameTextEq
    :nodeIdOf
    :nodepos
    :objectkind
    :poolFind
    :poolSet
    :poolTextAt
    :poolTextCopy
    :poolTextEq
    :posOf
    :printNode
    :printNodeCanonical
    :printProgramCanonicalRoot
    :tableAdd
    :tableReserve
    :tableTake
    :unitBodyIdsAt
    :isGenericParamOp
    :itemsHaveGenericParam
    :unitOpKindIs
    :unitOpDeclaresUnit
    :unitkind
    :unitkindname
    :names
}

# Error codes. Numeric E0xxx values are assigned by errCode, not by arm
# position, so arms may be added anywhere.

# parse/AST error variants; the diagnostics layer maps each arm to a code.
err: variant {
    fileNotFound: null
    duplicateDef: null
    badUnitName: null
    badUnit: null
    badFunction: null
    ioError: null
    expectedDef: null
    expectedExp: null
    expectedOp: null
    expectedTypeDef: null
    expectedStatement: null
    badArgument: null
    badArgumentBlock: null
    badExpression: null
    badOperation: null
    badString: null
    badPath: null
    badReference: null
    badCall: null
    badParameter: null
    badParameterBlock: null
    badObjectBlock: null
    badItem: null
    badThen: null
    badElse: null
    badCase: null
    badFor: null
    badData: null
    badStatement: null
    typeError: null
    refNotFound: null
    ownerError: null
    callError: null
    genericError: null
    compilerError: null
    reservedName: null
    nonExhaustive: null
    reservedMember: null
    requireBlock: null
    notPublic: null
    privateEscape: null
    constError: null
    userError: null
    noMain: null
    badToken: null
} as { tag: u8.tag }

# objectkind -- which of the six object definitions an objectdef is.
objectkind: variant {
    protocolDef: null
    recordDef: null
    classDef: null
    unionDef: null
    variantDef: null
    facetDef: null
} as { tag: u8.tag }

# Classification of a Call node, set by the type checker. The
# emitter dispatches on this to choose the right call shape.
callkind: variant {
    unknown: null
    regular: null
    returnCall: null
    recordCreate: null
    classCreate: null
    # tagged-sum arm construction -- covers union AND variant parents
    unionCreate: null
    protocolCreate: null
    protocolBorrow: null
    facetCreate: null
    facetBorrow: null
    typedefCreate: null
    typedefBorrow: null
    callable: null
    boxCreate: null
    breakCall: null
    continueCall: null
    errorCall: null
    panicCall: null
} as { tag: u8.tag }

# What a `unit` body means, set by the parser at construction. Readers
# ask the kind rather than comparing the introducing label to a name.
unitkind: variant {
    # a file unit root, or an inline `m: unit { }`: a namespace of
    # static definitions, public by default
    namespace: null
    # a hidden implementation subunit (`foo/bar.z`): private to its
    # parent -- only the parent may name it -- and, like every unit,
    # resolving outward through the parent, the file unit and core
    subunit: null
    # a generic template, `m: unit as { t: anyval.generic }`
    template: null
    # a `public:` block: the unit's or type's exported interface
    publicNs: null
    # a `private:` block, which is always rejected -- `private` already
    # covers every member
    privateNs: null
    # a `require:` toolchain-requirement block
    requirement: null
} as { tag: u8.tag }

# The AST node, as a reftype tagged sum. The arm is the
# discriminant; arm-payload carrier classes (declared below)
# hold the per-arm data. Node is declared before the carriers
# because carriers store Node fields by value, so the union's
# struct must be fully visible at each carrier's field site.
Node: union {
    error: ErrorData
    atomid: AtomIdData
    labelvalue: LabelValueData
    stringchunk: StringChunkData
    binop: BinOpData
    atomstring: AtomStringData
    dottedpath: DottedPathData
    call: CallData
    typeofexpr: TypeOfExprData
    namedoperation: NamedOperationData
    datablock: DataBlockData
    yieldexpr: YieldExprData
    statement: StatementData
    statementline: StatementLineData
    assignment: AssignmentData
    reassignment: ReassignmentData
    swapstmt: SwapStmtData
    expression: ExpressionData
    ifexpr: IfData
    ifclause: IfClauseData
    forexpr: ForData
    doexpr: DoData
    withexpr: WithData
    caseexpr: CaseData
    caseclause: CaseClauseData
    functiondef: FunctionData
    objectdef: ObjectDefData
    unitdef: UnitData
    program: ProgramData
    # box-free parser placeholder: a reserved table slot carries this
    # arm (payload-less, no allocation) until intern moves the real
    # row in (see tableSet / zparser.nextId)
    placeholder: null
}


# Per-arm Node payload carriers. Each carries a synthetic nodeid
# plus source position (line + column). The carriers are classes
# because they hold reftype fields (String, Node, List); records
# cannot hold reftypes.
ErrorData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    width: u32
    err: err
    msg: String
    fsno: zvfs.fsno
    note: String
    hint: String
}

# errCode -- the numeric E-code for an err variant.
errCode: function {c: err} out u32 is {
    r: 1.u32
    match (
        c
    ) case fileNotFound then {
        r = 2
    } case duplicateDef then {
        r = 3
    } case badUnitName then {
        r = 4
    } case badUnit then {
        r = 5
    } case badFunction then {
        r = 6
    } case ioError then {
        r = 7
    } case expectedDef then {
        r = 10
    } case expectedExp then {
        r = 12
    } case expectedOp then {
        r = 13
    } case expectedTypeDef then {
        r = 14
    } case expectedStatement then {
        r = 15
    } case badArgument then {
        r = 17
    } case badArgumentBlock then {
        r = 18
    } case badExpression then {
        r = 19
    } case badOperation then {
        r = 20
    } case badString then {
        r = 21
    } case badPath then {
        r = 22
    } case badReference then {
        r = 23
    } case badCall then {
        r = 24
    } case badParameter then {
        r = 25
    } case badParameterBlock then {
        r = 26
    } case badObjectBlock then {
        r = 27
    } case badItem then {
        r = 28
    } case badThen then {
        r = 29
    } case badElse then {
        r = 30
    } case badCase then {
        r = 31
    } case badFor then {
        r = 32
    } case badData then {
        r = 34
    } case badStatement then {
        r = 35
    } case reservedName then {
        r = 33
    } case nonExhaustive then {
        r = 36
    } case reservedMember then {
        r = 37
    } case requireBlock then {
        r = 38
    } case noMain then {
        r = 39
    } case badToken then {
        r = 9
    } case typeError then {
        r = 100
    } case notPublic then {
        r = 101
    } case privateEscape then {
        r = 102
    } case refNotFound then {
        r = 8
    } case ownerError then {
        r = 200
    } case callError then {
        r = 300
    } case genericError then {
        r = 400
    } case constError then {
        r = 600
    } case userError then {
        r = 601
    } case compilerError then {
        r = 1
    }
    return r
}

# errorLine -- the one-line diagnostic for an error node: error[Exxxx]: <message>.
# (Location/snippet are intentionally omitted; the negative-test goldens keep only
# the code + message line.)
errorLine: function {e: ErrorData.view} out String is {
    code: errCode c: e.err
    p: String
    if code < 10 then {
        p = "000".string
    } else if code < 100 then {
        p = "00".string
    } else if code < 1000 then p = "0".string
    result: "error[E\{p}\{code}]: \{e.msg}"
    return result
}

# explainText -- a human-readable explanation for a numeric error code, or ""
# when the code is unknown. Keyed by the same E-codes errCode assigns, so the
# `zc explain Exxxx` command and the emitted diagnostics stay in sync.
explainText: function {code: u32} out String is {
    r: String
    if code == 1 then {
        r = "internal compiler error\n\nThe compiler hit an unexpected internal condition. This is a compiler bug, not an error in your program.".string
    } else if code == 2 then {
        r = "file not found\n\nThe source file for a unit (<unit>.z) could not be located under --src or the system library.".string
    } else if code == 3 then {
        r = "duplicate definition\n\nTwo definitions share the same name in the same scope. Rename or remove one.".string
    } else if code == 4 then {
        r = "bad unit name\n\nA unit name is malformed or does not match its file. Unit names are identifiers with no extension.".string
    } else if code == 5 then {
        r = "malformed unit\n\nThe unit could not be parsed as a sequence of top-level definitions.".string
    } else if code == 6 then {
        r = "malformed function\n\nA function definition is not well formed. Check the parameter block, return clause, and body.".string
    } else if code == 7 then {
        r = "I/O error\n\nReading or writing a file failed. Check the path and permissions.".string
    } else if code == 8 then {
        r = "undefined identifier\n\nA name was used that is not defined in any visible scope. Check spelling and imports.".string
    } else if code == 9 then {
        r = "unexpected characters\n\nThe characters form no token of the language -- a two-dot run, an unknown escape, a byte no token may contain. This is the lexer's own diagnosis, reported where the parser met the characters.".string
    } else if code == 10 then {
        r = "expected a definition\n\nA top-level definition (name: function / record / class / ...) was expected here.".string
    } else if code == 12 then {
        r = "expected an expression\n\nAn expression was expected here but something else was found.".string
    } else if code == 13 then {
        r = "expected an operator\n\nAn operator was expected between two operands. Operators must be surrounded by whitespace.".string
    } else if code == 14 then {
        r = "expected a type definition\n\nA type definition (record / variant / facet / class / union / protocol) was expected here.".string
    } else if code == 15 then {
        r = "expected a statement\n\nA statement was expected inside this block.".string
    } else if code == 17 then {
        r = "malformed argument\n\nA call argument is not well formed. Named arguments take the form name: value.".string
    } else if code == 18 then {
        r = "malformed argument block\n\nThe argument list of a call could not be parsed.".string
    } else if code == 19 then {
        r = "malformed expression\n\nThe expression could not be parsed.".string
    } else if code == 20 then {
        r = "malformed operation\n\nAn operator expression is not well formed.".string
    } else if code == 21 then {
        r = "malformed string\n\nA string literal is unterminated or contains an invalid escape or interpolation.".string
    } else if code == 22 then {
        r = "malformed path\n\nA dotted path (a.b.c) is not well formed.".string
    } else if code == 23 then {
        r = "malformed reference\n\nA reference to a name or member is not well formed.".string
    } else if code == 24 then {
        r = "malformed call\n\nA function or method call is not well formed.".string
    } else if code == 25 then {
        r = "malformed parameter\n\nA parameter declaration is not well formed. Parameters take the form name: type.".string
    } else if code == 26 then {
        r = "malformed parameter block\n\nThe parameter list of a function could not be parsed.".string
    } else if code == 27 then {
        r = "malformed object block\n\nThe body of a type definition could not be parsed.".string
    } else if code == 28 then {
        r = "malformed item\n\nAn item inside a block or list is not well formed.".string
    } else if code == 29 then {
        r = "malformed then clause\n\nAn if or for expression is missing a well-formed 'then' clause.".string
    } else if code == 30 then {
        r = "malformed else clause\n\nThe 'else' / 'else if' continuation is not well formed; it must follow the closing brace on the same line.".string
    } else if code == 31 then {
        r = "malformed case clause\n\nA match 'case' arm is not well formed; it must follow the closing brace on the same line.".string
    } else if code == 32 then {
        r = "malformed for header\n\nA for loop header is not well formed (for <var>: <iter> loop, or for while <cond> loop).".string
    } else if code == 33 then {
        r = "reserved word used as a name\n\nA reserved keyword (unit, function, match, ...) or a future-reserved word (enum, goto, ...) cannot be used as a definition, parameter, field, or binding name. Rename it.".string
    } else if code == 34 then {
        r = "malformed data block\n\nA data block is not well formed.".string
    } else if code == 35 then {
        r = "malformed statement\n\nThe statement could not be parsed.".string
    } else if code == 36 then {
        r = "non-exhaustive match\n\nA `match` over a variant or union does not cover every arm and has no `else`. Add the missing case(s), or an `else` clause.".string
    } else if code == 37 then {
        r = "reserved member name\n\nA type body declares a member named `lock`, `take`, `borrow`, `drop`, `private` or `public`. These are ownership/access markers in member position and cannot be declared. Rename the member; the visibility declarations `public:`/`private:` naming a unit block remain valid.".string
    } else if code == 38 then {
        r = "malformed require block\n\nA unit's `require:` block declares what the unit needs from the host toolchain. It must be a unit definition, must declare at least one requirement, and every entry must be a key the compiler consumes -- today only `library:`, whose value is a plain string literal naming a link library. An unknown or misspelt key would be silently ignored, so it is rejected.".string
    } else if code == 39 then {
        r = "no main\n\nThe unit being compiled declares no `main: function is { ... }`, so the compiler has no entry point to start from. Compilation is demand-driven: `main` is the root, and what it reaches is what gets checked and emitted. A unit with no `main` is a library -- compile the program that opens it instead, or add a `main`. `--eager` resolves every definition rather than what a root reaches, so it does not require one.".string
    } else if code == 100 then {
        r = "type error\n\nA value's type does not match what is required here: a mismatch, an undefined type, or an incompatible assignment.".string
    } else if code == 101 then {
        r = "member not public\n\nThe member exists but is not in the type's `public:` interface. Access it from within the type's own methods (`this`), or through a `.private` friend handle the type handed out.".string
    } else if code == 102 then {
        r = "private escape\n\nA `.private` view may only be taken by the value's own type, or by a holder of an existing `.private` handle (a friend the type passed it to). External code holding only a public value cannot produce one.".string
    } else if code == 200 then {
        r = "ownership error\n\nA value's ownership was used incorrectly: used after a take/move, a borrow outliving its lock, or a reftype aliased while locked. See docs/ownership.".string
    } else if code == 300 then {
        r = "call error\n\nA call's arguments do not match the callee: wrong count, an unknown named argument, or an argument type mismatch. Also raised for a bare type name in value position that cannot construct its zero value: required fields missing, or a family with no zero-argument create (unions/variants select an arm, views bind from an owner, generic templates need type arguments).".string
    } else if code == 400 then {
        r = "generic error\n\nA generic type could not be resolved: a missing type argument, failed inference, or an unsatisfied constraint.".string
    } else if code == 500 then {
        r = "emitter error\n\nType checking succeeded but the C emitter met a construct it cannot emit. Nothing is written; the message names the construct. This is a compiler gap, not an error in your program.".string
    } else if code == 601 then {
        r = "compile-time error\n\nAn `error` call the compiler proved reachable. The message is the one the program's author wrote; the compiler is reporting it, not diagnosing it.".string
    } else if code == 600 then {
        r = "compile-time evaluation error\n\nThe compiler was asked for a value at compile time and could not produce one: a division by a constant zero, a result outside the range the evaluator works in, a constant defined in terms of itself, or an expression it cannot evaluate. Distinct from E0500, which is the emitter reporting a construct it cannot emit.".string
    }
    return r
}

# an atom node (a bare identifier reference): position + interned name id.
AtomIdData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    name: nameid
}

# a label-value node (a `name:`-shaped operand): position + interned name id.
LabelValueData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    name: nameid
}

# Interned-name row: the single owner of one distinct identifier's text.
# AtomIdData.name / LabelValueData.name are Ast.names pool ids, so
# every occurrence of an identifier shares one String (position = first
# sight). The parser interns; synthesized atoms move into their
# reserved slots via tableAdd.
# FileSeg -- one parsed file's contiguous nodeid range [startId, endId) and
# its VFS fsno. Subunit loads nest child ranges inside the parent's; the
# innermost containing range wins (fsnoForNode).
FileSeg: class {
    startId: u32
    endId: u32
    fsno: zvfs.fsno
}

# Well-known interned names: Ast.create interns these first, in this
# exact order, so their pool ids are fixed across every carrier.
# APPEND-ONLY, and never renumber: pool ids minted from this order are
# baked into every carrier and every consumer comparison, so inserting or
# reordering silently breaks them. Consumers read them cross-unit
# (`zast.names.wkContains` and friends); appending new entries is safe.
#
# One block rather than 33 constants: `out nameid` is what types the
# elements, so a read is a nameid without any literal wearing a type
# suffix, and the append-only contract has one place to live.
names: data {
    wkThis: 1
    wkReturn: 2
    wkBreak: 3
    wkContinue: 4
    wkCreate: 5
    wkBorrow: 6
    wkCall: 7
    wkGet: 8
    wkSet: 9
    wkGetv: 10
    wkRemove: 11
    wkAdd: 12
    wkContains: 13
    wkSort: 14
    wkLength: 15
    wkCapacity: 16
    wkSize: 17
    wkKey: 18
    wkValue: 19
    wkItem: 20
    wkSome: 21
    wkTag: 22
    wkState: 23
    wkString: 24
    wkStringView: 25
    wkListView: 26
    wkIterate: 27
    wkIterateItems: 28
    wkOpEq: 29
    wkOpNe: 30
    wkResumeInput: 31
    wkHash: 32
    wkEmpty: 33
    wkRhs: 34
    wkBool: 35
    wkEach: 36
} out nameid

# Ast -- the parse artifact carrier threaded through every reader: the
# master node table, plus (as the carrier grows) the other tree-scoped
# state produced by parsing.
Ast: class {
    nodes: (List Node)
    names: StringPool
    units: (ListVal u32)
    # Per-file nodeid segments: diagnostics map an erroring node back to
    # the file whose parse allocated it.
    fileSegs: (List FileSeg)
} as {
    create: function {} out this is {
        a: (meta.create
            nodes: (List Node)
            names: StringPool.create
            units: (ListVal u32)
            fileSegs: (List FileSeg)
        )
        # row 0 is the sentinel a node id of 0 addresses: the placeholder arm,
        # which every reader already treats as "nothing here"
        a.nodes.append from: Node.placeholder
        a.names.set s: "this"
        a.names.set s: "return"
        a.names.set s: "break"
        a.names.set s: "continue"
        a.names.set s: "create"
        a.names.set s: "borrow"
        a.names.set s: "call"
        a.names.set s: "get"
        a.names.set s: "set"
        a.names.set s: "getv"
        a.names.set s: "remove"
        a.names.set s: "add"
        a.names.set s: "contains"
        a.names.set s: "sort"
        a.names.set s: "length"
        a.names.set s: "capacity"
        a.names.set s: "size"
        a.names.set s: "key"
        a.names.set s: "value"
        a.names.set s: "item"
        a.names.set s: "some"
        a.names.set s: "tag"
        a.names.set s: "state"
        a.names.set s: "string"
        a.names.set s: "stringView"
        a.names.set s: "listView"
        a.names.set s: "iterate"
        a.names.set s: "iterateItems"
        a.names.set s: "=="
        a.names.set s: "!="
        a.names.set s: "_resume_input"
        a.names.set s: "hash"
        a.names.set s: ""
        a.names.set s: "rhs"
        a.names.set s: "bool"
        a.names.set s: "each"
        return a
    }
    # internString -- intern a name at a MINT site (a synthesized name not
    # guaranteed to be in the pool yet: a mono mangle, an element ordinal).
    # The one sanctioned intern in an analysis stage; returns the 1-based pool
    # id. Reads use zast.poolFind (0 on miss) and never intern. Takes an
    # exclusive lock on `this` for the call, so no node view (this.nodes.get)
    # may be live at the call site -- mint sites hold none (the ordinal site
    # drops its view first).
    internString: function {:this text: StringView} out nameid is {
        return (poolSet pool: this.names :text)
    }

    # fsnoForNode -- the fsno of the file whose parse allocated `nodeid`:
    # the innermost containing segment (subunit ranges nest inside their
    # parent's, so the largest containing startId wins). 0 when no segment
    # contains it (synthesized nodes minted after parsing).
    fsnoForNode: function {this: this.view nodeid: u32} out zvfs.fsno is {
        best: zvfs.fsno
        bestStart: u32
        n: this.fileSegs.length
        i: u64
        for i < n loop {
            sg: this.fileSegs.get :i
            i = i + 1
            if sg.startId <= nodeid when nodeid < sg.endId then {
                if best.u64 == 0 then {
                    best = sg.fsno
                    bestStart = sg.startId
                } else {
                    if sg.startId >= bestStart then {
                        best = sg.fsno
                        bestStart = sg.startId
                    }
                }
            }
        }
        return best
    }
}

# nameid -- a StringPool id: the interned identity of one identifier's text.
# 1-based, 0 is "no name". A typedef so a pool id cannot cross with the node,
# type or variable id spaces; equality is same-space only, sentinels read
# isZero.
nameid: record { val: u32.typedef } as {
    ==: function {this: this.view rhs: nameid} out bool is {
        return this.u32 == rhs.u32
    }
    isZero: function {this: this.view} out bool is {
        return this.u32 == 0
    }
}

# nodeid -- an Ast node id: the identity of one node in the single monotonic
# node space (1-based; 0 is "no node", and a synthesized node reads
# `fsnoForNode == 0`). A typedef so a node id cannot cross with the pool,
# type, variable or declaration id spaces; equality is same-space only,
# sentinels read isZero.
nodeid: record { val: u32.typedef } as {
    ==: function {this: this.view rhs: nodeid} out bool is {
        return this.u32 == rhs.u32
    }
    isZero: function {this: this.view} out bool is {
        return this.u32 == 0
    }
}

# StringPool -- deduplicating intern table for identifier text. A pool id
# indexes its row; row 0 is a sentinel holding the empty text, which is the
# answer for an absent ref. Texts are never removed, so an id stays valid for
# the pool's lifetime. The slot index is an open-addressed, linear-probed
# power-of-two table keyed by the seeded StringView hash: ids follow
# insertion order and are deterministic, but slot layout is process-local
# -- dump text, never hashes.
StringPool: class {
    texts: (List String)
    slots: (ListVal u32)
    used: u64
} as {
    create: function {} out this is {
        p: (meta.create
            texts: (List String)
            slots: (ListVal u32)
            used: 0
        )
        # the sentinel row an absent ref reads. It is deliberately given no
        # slot, so interning "" still mints an id of its own.
        p.texts.append "".string
        return p
    }

    # reserve -- grow the slot table when empty or at 2/3 load.
    reserve: function {:this} is {
        if this.slots.length == 0 then {
            this.rebuild ncap: 16
            return
        }
        if (this.used + 1) * 3 >= (this.slots.length * 2) then {
            this.rebuild ncap: this.slots.length * 2
        }
    }

    # rebuild -- swap in a slot table of ncap (a power of two), re-probing
    # every interned text.
    rebuild: function {:this ncap: u64} is {
        ns: (ListVal u32 capacity: ncap)
        i: u64
        for i < ncap loop {
            ns.append 0
            i = i + 1
        }
        mask: ncap - 1
        k: 1.u64
        for k < this.texts.length loop {
            text: this.texts.get i: k
            hv: text.stringView.hash
            idx: hv & mask
            for (ns.get i: idx) != 0 loop idx = (idx + 1) & mask
            ns.set i: idx val: k.u32.orPanic
            k = k + 1
        }
        this.slots = ns
    }

    # probeSlot -- the slot index for s: either holds s's id or is the
    # empty slot where s would insert. Requires a non-empty slot table.
    probeSlot: function {t: this.view s: StringView} out u64 is {
        mask: t.slots.length - 1
        idx: s.hash & mask
        for true loop {
            sid: t.slots.get i: idx
            if sid == 0 then return idx
            text: t.texts.get i: sid.u64
            if text.stringView == s then return idx
            idx = (idx + 1) & mask
        }
        return 0
    }

    # set -- intern s, copying the bytes only on first sight.
    set: function {:this s: StringView} out nameid is {
        this.reserve
        si: this.probeSlot :s
        sid: this.slots.get i: si
        if sid > 0 then return (nameid.create from: sid.u32)
        nid: this.texts.length.u32.orPanic
        this.texts.append s.string
        this.slots.set i: si val: nid
        this.used = this.used + 1
        return (nameid.create from: nid.u32)
    }

    # setOwned -- intern a donated owned string: moved in on first sight,
    # dropped when the text is already interned.
    setOwned: function {:this s: String.take} out nameid is {
        this.reserve
        si: this.probeSlot s: s.stringView
        sid: this.slots.get i: si
        if sid > 0 then return (nameid.create from: sid.u32)
        nid: this.texts.length.u32.orPanic
        this.texts.append s
        this.slots.set i: si val: nid
        this.used = this.used + 1
        return (nameid.create from: nid.u32)
    }

    # find -- the id of an already-interned text (0 when absent).
    # Read-only: never interns, never grows the slot table.
    find: function {t: this.view s: StringView} out nameid is {
        if t.slots.length == 0 then return (nameid.create from: 0)
        si: t.probeSlot :s
        return (nameid.create from: (t.slots.get i: si))
    }

    # get -- an owned copy of id's text; panics on an out-of-range id.
    get: function {t: this.view id: nameid} out String is {
        text: t.texts.get i: id.u64
        return text.copy
    }

    # eq -- does id's text equal s? Zero-allocation compare; id 0 (absent)
    # reads the sentinel, so it equals only the empty view.
    eq: function {t: this.view id: nameid s: StringView} out bool is {
        text: t.texts.get i: id.u64
        return text.stringView == s
    }

    # length -- the row count, sentinel included: ids run 1 .. length - 1.
    length: function {t: this.view} out u64 is {
        return t.texts.length
    }
}

# one chunk of an interpolated string -- literal text or an embedded expression, tagged by `chunkKind`.
StringChunkData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    text: String
    chunkKind: u8
}

# Binary-operation node payload: three Node children for the
# left-hand operand, operator, and right-hand operand. Arm-
# specific child-type constraints (e.g. operator must be an
# AtomId) live in the typechecker.
BinOpData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    lhs: nodeid
    operator: nodeid
    rhs: nodeid
}

# Interpolated-string-literal payload: an ordered list of Node
# children representing the literal text chunks and embedded
# interpolation expressions.
AtomStringData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    stringparts: (ListVal u32)
}

# Dotted-path node payload: a parent path and a child selector,
# both Node children (the child is an AtomId arm).
DottedPathData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    parent: nodeid
    child: nodeid
}

# Call node payload: the callable path and an ordered list of
# argument nodes (each a NamedOperation arm once that arm lands).
CallData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    callable: nodeid
    arguments: (ListVal u32)
}

# typeof-expression payload (compiler-synthesised): the operation
# whose static type is taken.
TypeOfExprData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    source: nodeid
}

# Named-operation payload: an optional argument label plus the
# operation value. Appears as a Call/Data argument; `name` is the
# label's Ast.names pool id (0 = absent / positional).
NamedOperationData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    name: nameid
    operation: nodeid
}

# Data-block payload: an ordered list of NamedOperation element
# nodes and an optional `out <type-ref>` annotation that pins the
# element type for the whole block.
DataBlockData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    elements: (ListVal u32)
    outType: nodeid
}

# Yield payload: the expression whose value is yielded out of a
# generator function at this suspension point.
YieldExprData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    expr: nodeid
}

# Statement payload: an ordered list of StatementLine nodes — the
# lines of a brace-delimited code block.
StatementData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    statements: (ListVal u32)
}

# StatementLine payload: one line of a block, wrapping exactly one of
# assignment / reassignment / swapstmt / expression.
StatementLineData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    statementline: nodeid
}

# Assignment payload: bind a new local (an interned name id) to the
# value of an expression node.
AssignmentData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    name: nameid
    value: nodeid
}

# Reassignment payload: update the target path with the value of an
# expression node.
ReassignmentData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    topath: nodeid
    value: nodeid
}

# Swap payload: exchange the contents of two owned reference paths.
# (Arm named swapstmt because `swap` is a keyword.)
SwapStmtData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    lhs: nodeid
    rhs: nodeid
}

# Expression payload: wraps the single operation/control-flow node
# that forms an expression.
ExpressionData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    expression: nodeid
}

# If payload: ordered if/when clauses plus an optional else statement.
IfData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    clauses: (ListVal u32)
    elseclause: nodeid
}

# IfClause payload: the clause conditions (each a namedoperation arm;
# unnamed = positional when-condition) and the statement to run.
IfClauseData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    conditions: (ListVal u32)
    statement: nodeid
}

# For payload: loop conditions (namedoperation arms; named = binding,
# unnamed = while-condition), an optional loop body, and the bool
# postconditions re-checked each iteration.
ForData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    conditions: (ListVal u32)
    body: nodeid
    postconditions: (ListVal u32)
}

# Do payload: a statement block evaluated as an expression.
DoData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    statement: nodeid
}

# With payload: a scoped binding (an interned name id), its value, and
# the body expression evaluated under that binding.
WithData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    name: nameid
    value: nodeid
    body: nodeid
}

# Case payload: the subject operation, the ordered match clauses, and
# an optional else statement.
CaseData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    subject: nodeid
    clauses: (ListVal u32)
    elseclause: nodeid
}

# CaseClause payload: the binding name (an interned name id), the AtomId
# arm being matched, and the statement to run.
CaseClauseData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    name: nameid
    matcharm: nodeid
    statement: nodeid
}

# Function payload: optional return type, parameter list (namedoperation
# arms), an optional body statement (none for a spec), the native flag,
# and the `as`-block members (namedoperation arms). Member maps are
# ordered name+node lists, not keyed Maps.
FunctionData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    returntype: nodeid
    parameters: (ListVal u32)
    body: nodeid
    isNative: bool
    asItems: (ListVal u32)
}

# Unified type-definition payload. `kind` discriminates which kind of
# object this is (one of objectkind RECORD/CLASS/UNION/VARIANT/
# PROTOCOL/FACET). `isItems` are the `is`-block members and `asItems`
# the `as`-block members, each a namedoperation arm.
ObjectDefData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    kind: objectkind
    isItems: (ListVal u32)
    asItems: (ListVal u32)
    isNative: bool
}

# Unit payload: `kind` is how the unit was written and what it means;
# `body` holds its top-level definitions as namedoperation arms.
UnitData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    kind: unitkind
    body: (ListVal u32)
}

# Program payload (parse root): the file-level units as namedoperation
# arms keyed by unit name, plus the entry unit's name.
ProgramData: class {
    nodeid: nodeid
    lineno: u32
    colno: u32
    mainUnitName: String
    ast: Ast
}

# Arm-name dumpers: return the canonical uppercase label for an
# enum arm. Used by printNode and the smoke harness.
errname: function {e: err} out String is {
    match (
        e
    ) case fileNotFound then {
        return "FILENOTFOUND".string
    } case duplicateDef then {
        return "DUPLICATEDEF".string
    } case badUnitName then {
        return "BADUNITNAME".string
    } case badUnit then {
        return "BADUNIT".string
    } case badFunction then {
        return "BADFUNCTION".string
    } case ioError then {
        return "IOERROR".string
    } case expectedDef then {
        return "EXPECTEDDEF".string
    } case expectedExp then {
        return "EXPECTEDEXP".string
    } case expectedOp then {
        return "EXPECTEDOP".string
    } case expectedTypeDef then {
        return "EXPECTEDTYPEDEF".string
    } case expectedStatement then {
        return "EXPECTEDSTATEMENT".string
    } case badArgument then {
        return "BADARGUMENT".string
    } case badArgumentBlock then {
        return "BADARGUMENTBLOCK".string
    } case badExpression then {
        return "BADEXPRESSION".string
    } case badOperation then {
        return "BADOPERATION".string
    } case badString then {
        return "BADSTRING".string
    } case badPath then {
        return "BADPATH".string
    } case badReference then {
        return "BADREFERENCE".string
    } case badCall then {
        return "BADCALL".string
    } case badParameter then {
        return "BADPARAMETER".string
    } case badParameterBlock then {
        return "BADPARAMETERBLOCK".string
    } case badObjectBlock then {
        return "BADOBJECTBLOCK".string
    } case badItem then {
        return "BADITEM".string
    } case badThen then {
        return "BADTHEN".string
    } case badElse then {
        return "BADELSE".string
    } case badCase then {
        return "BADCASE".string
    } case badFor then {
        return "BADFOR".string
    } case badData then {
        return "BADDATA".string
    } case badStatement then {
        return "BADSTATEMENT".string
    } case typeError then {
        return "TYPEERROR".string
    } case refNotFound then {
        return "REFNOTFOUND".string
    } case ownerError then {
        return "OWNERERROR".string
    } case callError then {
        return "CALLERROR".string
    } case genericError then {
        return "GENERICERROR".string
    } case compilerError then {
        return "COMPILERERROR".string
    } case reservedName then {
        return "RESERVEDNAME".string
    } case nonExhaustive then {
        return "NONEXHAUSTIVE".string
    } case reservedMember then {
        return "RESERVEDMEMBER".string
    } case requireBlock then {
        return "REQUIREBLOCK".string
    } case notPublic then {
        return "NOTPUBLIC".string
    } case privateEscape then {
        return "PRIVATEESCAPE".string
    } case constError then {
        return "CONSTERROR".string
    } case userError then {
        return "USERERROR".string
    } case noMain then {
        return "NOMAIN".string
    } case badToken then {
        return "BADTOKEN".string
    }
}

# the printable name of an `objectkind`.
objectkindname: function {k: objectkind} out String is {
    match (
        k
    ) case protocolDef then {
        return "PROTOCOL".string
    } case recordDef then {
        return "RECORD".string
    } case classDef then {
        return "CLASS".string
    } case unionDef then {
        return "UNION".string
    } case variantDef then {
        return "VARIANT".string
    } case facetDef then {
        return "FACET".string
    }
}

# the printable name of a `callkind`.
callkindname: function {ck: callkind} out String is {
    match (
        ck
    ) case unknown then {
        return "UNKNOWN".string
    } case regular then {
        return "REGULAR".string
    } case returnCall then {
        return "RETURN".string
    } case recordCreate then {
        return "RECORD_CREATE".string
    } case classCreate then {
        return "CLASS_CREATE".string
    } case unionCreate then {
        return "UNION_CREATE".string
    } case protocolCreate then {
        return "PROTOCOL_CREATE".string
    } case protocolBorrow then {
        return "PROTOCOL_BORROW".string
    } case facetCreate then {
        return "FACET_CREATE".string
    } case facetBorrow then {
        return "FACET_BORROW".string
    } case typedefCreate then {
        return "TYPEDEF_CREATE".string
    } case typedefBorrow then {
        return "TYPEDEF_BORROW".string
    } case callable then {
        return "CALLABLE".string
    } case boxCreate then {
        return "BOX_CREATE".string
    } case breakCall then {
        return "BREAK".string
    } case continueCall then {
        return "CONTINUE".string
    } case errorCall then {
        return "ERROR".string
    } case panicCall then {
        return "PANIC".string
    }
}

# the printable name of a `unitkind`.
unitkindname: function {uk: unitkind} out String is {
    match (
        uk
    ) case namespace then {
        return "NAMESPACE".string
    } case subunit then {
        return "SUBUNIT".string
    } case template then {
        return "TEMPLATE".string
    } case publicNs then {
        return "PUBLIC".string
    } case privateNs then {
        return "PRIVATE".string
    } case requirement then {
        return "REQUIREMENT".string
    }
}

# Print a NamedOperation's optional label. The Option is passed by
# borrow so it can be matched without moving it out of its carrier.
printPoolName: function {ast: Ast.view ref: nameid} is {
    if ref.isZero then {
        print "  name=<none>"
        return
    }
    text: nameTextCopy :ast :ref
    print "  name=\{text}"
}

# Print a Data block's optional `out` type annotation, descending
# into the type node when present.
# printOptChildAt -- the id-taking child printer (0 = absent).
printOptChildAt: function {ast: Ast.view id: u32} is {
    if id == 0 then {
        print "  <none>"
    } else {
        c: ast.nodes.get i: id.u64
        printNode :ast n: c
    }
}

# Source position (line, column) of a node. A valtype so it copies
# out freely; the parser reads it to position synthesised parent
# nodes (BinOp, Call, NamedOperation) at their first child.
nodepos: record {
    line: u32
    col: u32
}

# Position of any node; (0, 0) for the placeholder.
posOf: function {n: Node.view} out nodepos is {
    match (
        n
    ) case error then {
        return (nodepos line: n.lineno col: n.colno)
    } case atomid then {
        return (nodepos line: n.lineno col: n.colno)
    } case labelvalue then {
        return (nodepos line: n.lineno col: n.colno)
    } case binop then {
        return (nodepos line: n.lineno col: n.colno)
    } case atomstring then {
        return (nodepos line: n.lineno col: n.colno)
    } case dottedpath then {
        return (nodepos line: n.lineno col: n.colno)
    } case call then {
        return (nodepos line: n.lineno col: n.colno)
    } case namedoperation then {
        return (nodepos line: n.lineno col: n.colno)
    } case typeofexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case expression then {
        return (nodepos line: n.lineno col: n.colno)
    } case datablock then {
        return (nodepos line: n.lineno col: n.colno)
    } case yieldexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case stringchunk then {
        return (nodepos line: n.lineno col: n.colno)
    } case statement then {
        return (nodepos line: n.lineno col: n.colno)
    } case statementline then {
        return (nodepos line: n.lineno col: n.colno)
    } case assignment then {
        return (nodepos line: n.lineno col: n.colno)
    } case reassignment then {
        return (nodepos line: n.lineno col: n.colno)
    } case swapstmt then {
        return (nodepos line: n.lineno col: n.colno)
    } case ifexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case ifclause then {
        return (nodepos line: n.lineno col: n.colno)
    } case forexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case doexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case withexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case caseexpr then {
        return (nodepos line: n.lineno col: n.colno)
    } case caseclause then {
        return (nodepos line: n.lineno col: n.colno)
    } case functiondef then {
        return (nodepos line: n.lineno col: n.colno)
    } case objectdef then {
        return (nodepos line: n.lineno col: n.colno)
    } case unitdef then {
        return (nodepos line: n.lineno col: n.colno)
    } case program then {
        return (nodepos line: n.lineno col: n.colno)
    } case placeholder then {
        return (nodepos line: 0 col: 0)
    }
}

# poolFind -- the pool id of an already-interned name (0 when absent). Takes
# the pool as a sibling arg so a caller holding a view into another Ast field
# (the node table) does not lock the whole carrier -- read-only, never interns.
poolFind: function {pool: StringPool.view text: StringView} out nameid is {
    return (pool.find s: text)
}

# poolSet -- intern `text`, returning its 1-based pool id. Mutating
# counterpart of poolFind: takes the pool itself so a caller holding a view
# into a sibling Ast field (the node table) does not lock the whole carrier.
poolSet: function {pool: StringPool text: StringView} out nameid is {
    return (pool.set s: text)
}

# poolTextEq -- compare an interned name's text without copying. Takes the
# pool itself so a caller holding a view into a sibling Ast field (the node
# table) does not lock the whole carrier.
poolTextEq: function {pool: StringPool.view ref: nameid s: StringView} out bool is {
    return (pool.eq id: ref :s)
}

# poolTextCopy -- an owned copy of an interned name's text ("" when the ref
# is absent). Pool-taking counterpart of poolTextEq.
poolTextCopy: function {pool: StringPool.view ref: nameid} out String is {
    return (pool.get id: ref)
}

# nameTextEq -- compare an interned name's text without copying.
nameTextEq: function {ast: Ast.view ref: nameid s: StringView} out bool is {
    return (poolTextEq pool: ast.names :ref :s)
}

# nameTextCopy -- an owned copy of an interned name's text ("" when the
# ref is absent).
nameTextCopy: function {ast: Ast.view ref: nameid} out String is {
    return (poolTextCopy pool: ast.names :ref)
}

# poolTextAt -- a BORROWED view of an interned name's text: the binding
# pins its source shared for its scope, so every read is allocation-free.
# A zero ref reads the sentinel row, which holds the empty text.
poolTextAt: function {pool: StringPool.view ref: nameid} out String.borrow is {
    return (pool.texts.get i: ref.u64)
}

# nameTextAt -- carrier-taking counterpart of poolTextAt.
nameTextAt: function {ast: Ast.view ref: nameid} out String.borrow is {
    return (ast.names.texts.get i: ref.u64)
}

# Print one line per Node in the form
#   "<nodeid>: <arm> @<lineno>:<colno>"
# Recursive arms (binop, atomstring) descend into their children.
printNode: function {ast: Ast.view n: Node.view} is {
    match (
        n
    ) case error then {
        print "\{n.nodeid}: error @\{n.lineno}:\{n.colno} err=\{errname n.err} msg=\{n.msg}"
    } case placeholder then {
        print "placeholder"
    } case atomid then {
        anm: nameTextCopy :ast ref: n.name
        print "\{n.nodeid}: atomid @\{n.lineno}:\{n.colno} name=\{anm}"
    } case labelvalue then {
        lnm: nameTextCopy :ast ref: n.name
        print "\{n.nodeid}: labelvalue @\{n.lineno}:\{n.colno} name=\{lnm}"
    } case stringchunk then {
        print "\{n.nodeid}: stringchunk @\{n.lineno}:\{n.colno} text=\{n.text} chunkKind=\{n.chunkKind}"
    } case binop then {
        print "\{n.nodeid}: binop @\{n.lineno}:\{n.colno}"
        printNode :ast n: (ast.nodes.get i: n.lhs.u64)
        printNode :ast n: (ast.nodes.get i: n.operator.u64)
        printNode :ast n: (ast.nodes.get i: n.rhs.u64)
    } case atomstring then {
        print "\{n.nodeid}: atomstring @\{n.lineno}:\{n.colno} parts=\{n.stringparts.length}"
        iter: n.stringparts.iterate
        for partId: iter loop printNode :ast n: (ast.nodes.get i: partId.u64)
    } case dottedpath then {
        print "\{n.nodeid}: dottedpath @\{n.lineno}:\{n.colno}"
        printNode :ast n: (ast.nodes.get i: n.parent.u64)
        printNode :ast n: (ast.nodes.get i: n.child.u64)
    } case call then {
        print "\{n.nodeid}: call @\{n.lineno}:\{n.colno} args=\{n.arguments.length}"
        printNode :ast n: (ast.nodes.get i: n.callable.u64)
        argiter: n.arguments.iterate
        for argId: argiter loop printNode :ast n: (ast.nodes.get i: argId.u64)
    } case typeofexpr then {
        print "\{n.nodeid}: typeofexpr @\{n.lineno}:\{n.colno}"
        printNode :ast n: (ast.nodes.get i: n.source.u64)
    } case namedoperation then {
        print "\{n.nodeid}: namedoperation @\{n.lineno}:\{n.colno}"
        printPoolName :ast ref: n.name
        printNode :ast n: (ast.nodes.get i: n.operation.u64)
    } case datablock then {
        print "\{n.nodeid}: datablock @\{n.lineno}:\{n.colno} elements=\{n.elements.length}"
        eiter: n.elements.iterate
        for elId: eiter loop printNode :ast n: (ast.nodes.get i: elId.u64)
        print "  outType:"
        printOptChildAt :ast id: n.outType
    } case yieldexpr then {
        print "\{n.nodeid}: yieldexpr @\{n.lineno}:\{n.colno}"
        printNode :ast n: (ast.nodes.get i: n.expr.u64)
    } case statement then {
        print "\{n.nodeid}: statement @\{n.lineno}:\{n.colno} statements=\{n.statements.length}"
        siter: n.statements.iterate
        for lnId: siter loop printNode :ast n: (ast.nodes.get i: lnId.u64)
    } case statementline then {
        print "\{n.nodeid}: statementline @\{n.lineno}:\{n.colno}"
        printNode :ast n: (ast.nodes.get i: n.statementline.u64)
    } case assignment then {
        asn: nameTextCopy :ast ref: n.name
        print "\{n.nodeid}: assignment @\{n.lineno}:\{n.colno} name=\{asn}"
        printNode :ast n: (ast.nodes.get i: n.value.u64)
    } case reassignment then {
        print "\{n.nodeid}: reassignment @\{n.lineno}:\{n.colno}"
        printNode :ast n: (ast.nodes.get i: n.topath.u64)
        printNode :ast n: (ast.nodes.get i: n.value.u64)
    } case swapstmt then {
        print "\{n.nodeid}: swapstmt @\{n.lineno}:\{n.colno}"
        printNode :ast n: (ast.nodes.get i: n.lhs.u64)
        printNode :ast n: (ast.nodes.get i: n.rhs.u64)
    } case expression then {
        print "\{n.nodeid}: expression @\{n.lineno}:\{n.colno}"
        printNode :ast n: (ast.nodes.get i: n.expression.u64)
    } case ifexpr then {
        print "\{n.nodeid}: ifexpr @\{n.lineno}:\{n.colno} clauses=\{n.clauses.length}"
        clit: n.clauses.iterate
        for clId: clit loop printNode :ast n: (ast.nodes.get i: clId.u64)
        print "  elseclause:"
        printOptChildAt :ast id: n.elseclause
    } case ifclause then {
        print "\{n.nodeid}: ifclause @\{n.lineno}:\{n.colno} conditions=\{n.conditions.length}"
        coit: n.conditions.iterate
        for coId: coit loop printNode :ast n: (ast.nodes.get i: coId.u64)
        printNode :ast n: (ast.nodes.get i: n.statement.u64)
    } case forexpr then {
        print "\{n.nodeid}: forexpr @\{n.lineno}:\{n.colno} conditions=\{n.conditions.length} postconditions=\{n.postconditions.length}"
        fcit: n.conditions.iterate
        for fcId: fcit loop printNode :ast n: (ast.nodes.get i: fcId.u64)
        print "  body:"
        printOptChildAt :ast id: n.body
        fpit: n.postconditions.iterate
        for fpId: fpit loop printNode :ast n: (ast.nodes.get i: fpId.u64)
    } case doexpr then {
        print "\{n.nodeid}: doexpr @\{n.lineno}:\{n.colno}"
        printNode :ast n: (ast.nodes.get i: n.statement.u64)
    } case withexpr then {
        wnm: nameTextCopy :ast ref: n.name
        print "\{n.nodeid}: withexpr @\{n.lineno}:\{n.colno} name=\{wnm}"
        printNode :ast n: (ast.nodes.get i: n.value.u64)
        printNode :ast n: (ast.nodes.get i: n.body.u64)
    } case caseexpr then {
        print "\{n.nodeid}: caseexpr @\{n.lineno}:\{n.colno} clauses=\{n.clauses.length}"
        printNode :ast n: (ast.nodes.get i: n.subject.u64)
        ccit: n.clauses.iterate
        for ccId: ccit loop printNode :ast n: (ast.nodes.get i: ccId.u64)
        print "  elseclause:"
        printOptChildAt :ast id: n.elseclause
    } case caseclause then {
        ccn: nameTextCopy :ast ref: n.name
        print "\{n.nodeid}: caseclause @\{n.lineno}:\{n.colno} name=\{ccn}"
        printNode :ast n: (ast.nodes.get i: n.matcharm.u64)
        printNode :ast n: (ast.nodes.get i: n.statement.u64)
    } case functiondef then {
        print "\{n.nodeid}: functiondef @\{n.lineno}:\{n.colno} params=\{n.parameters.length} isNative=\{n.isNative}"
        print "  returntype:"
        printOptChildAt :ast id: n.returntype
        piter: n.parameters.iterate
        for pmId: piter loop printNode :ast n: (ast.nodes.get i: pmId.u64)
        print "  body:"
        printOptChildAt :ast id: n.body
        faiter: n.asItems.iterate
        for famId: faiter loop printNode :ast n: (ast.nodes.get i: famId.u64)
    } case objectdef then {
        print "\{n.nodeid}: objectdef @\{n.lineno}:\{n.colno} kind=\{objectkindname n.kind} isItems=\{n.isItems.length} asItems=\{n.asItems.length} isNative=\{n.isNative}"
        oiiter: n.isItems.iterate
        for oimId: oiiter loop printNode :ast n: (ast.nodes.get i: oimId.u64)
        oaiter: n.asItems.iterate
        for oamId: oaiter loop printNode :ast n: (ast.nodes.get i: oamId.u64)
    } case unitdef then {
        print "\{n.nodeid}: unitdef @\{n.lineno}:\{n.colno} kind=\{unitkindname n.kind} body=\{n.body.length}"
        ubi: u64
        ubn: n.body.length
        for ubi < ubn loop {
            ubid: n.body.get i: ubi
            printNode :ast n: (ast.nodes.get i: ubid.u64)
            ubi = ubi + 1
        }
    } case program then {
        print "\{n.nodeid}: program @\{n.lineno}:\{n.colno} units=\{ast.units.length} mainUnitName=\{n.mainUnitName}"
        pui: u64
        pun: ast.units.length
        for pui < pun loop {
            puid: (nodeid.create from: (ast.units.get i: pui))
            printNode :ast n: (ast.nodes.get i: puid.u64)
            pui = pui + 1
        }
    }
}

# Canonical (id-stripped) dump used by the parser goldens. Same as
# printNode but without the `<nodeid>: ` header prefix and without the
# namedoperation position.
# printOptChildCanonicalAt -- the id-taking canonical child printer.
printOptChildCanonicalAt: function {ast: Ast.view id: u32} is {
    if id == 0 then {
        print "  <none>"
    } else {
        c: ast.nodes.get i: id.u64
        printNodeCanonical :ast n: c
    }
}

# print one AST node in the canonical dump format.
printNodeCanonical: function {ast: Ast.view n: Node.view} is {
    match (
        n
    ) case error then {
        print "error @\{n.lineno}:\{n.colno} err=\{errname n.err} msg=\{n.msg}"
    } case placeholder then {
        print "placeholder"
    } case atomid then {
        anc: nameTextCopy :ast ref: n.name
        print "atomid @\{n.lineno}:\{n.colno} name=\{anc}"
    } case labelvalue then {
        lnc: nameTextCopy :ast ref: n.name
        print "labelvalue @\{n.lineno}:\{n.colno} name=\{lnc}"
    } case stringchunk then {
        print "stringchunk @\{n.lineno}:\{n.colno} text=\{n.text} chunkKind=\{n.chunkKind}"
    } case binop then {
        print "binop @\{n.lineno}:\{n.colno}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.lhs.u64)
        printNodeCanonical :ast n: (ast.nodes.get i: n.operator.u64)
        printNodeCanonical :ast n: (ast.nodes.get i: n.rhs.u64)
    } case atomstring then {
        print "atomstring @\{n.lineno}:\{n.colno} parts=\{n.stringparts.length}"
        iter: n.stringparts.iterate
        for partId: iter loop printNodeCanonical :ast n: (ast.nodes.get i: partId.u64)
    } case dottedpath then {
        print "dottedpath @\{n.lineno}:\{n.colno}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.parent.u64)
        printNodeCanonical :ast n: (ast.nodes.get i: n.child.u64)
    } case call then {
        print "call @\{n.lineno}:\{n.colno} args=\{n.arguments.length}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.callable.u64)
        argiter: n.arguments.iterate
        for argId: argiter loop printNodeCanonical :ast n: (ast.nodes.get i: argId.u64)
    } case typeofexpr then {
        print "typeofexpr @\{n.lineno}:\{n.colno}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.source.u64)
    } case namedoperation then {
        print "namedoperation"
        printPoolName :ast ref: n.name
        printNodeCanonical :ast n: (ast.nodes.get i: n.operation.u64)
    } case datablock then {
        print "datablock @\{n.lineno}:\{n.colno} elements=\{n.elements.length}"
        eiter: n.elements.iterate
        for elId: eiter loop printNodeCanonical :ast n: (ast.nodes.get i: elId.u64)
        print "  outType:"
        printOptChildCanonicalAt :ast id: n.outType
    } case yieldexpr then {
        print "yieldexpr @\{n.lineno}:\{n.colno}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.expr.u64)
    } case statement then {
        print "statement @\{n.lineno}:\{n.colno} statements=\{n.statements.length}"
        siter: n.statements.iterate
        for lnId: siter loop printNodeCanonical :ast n: (ast.nodes.get i: lnId.u64)
    } case statementline then {
        print "statementline @\{n.lineno}:\{n.colno}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.statementline.u64)
    } case assignment then {
        asc: nameTextCopy :ast ref: n.name
        print "assignment @\{n.lineno}:\{n.colno} name=\{asc}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.value.u64)
    } case reassignment then {
        print "reassignment @\{n.lineno}:\{n.colno}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.topath.u64)
        printNodeCanonical :ast n: (ast.nodes.get i: n.value.u64)
    } case swapstmt then {
        print "swapstmt @\{n.lineno}:\{n.colno}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.lhs.u64)
        printNodeCanonical :ast n: (ast.nodes.get i: n.rhs.u64)
    } case expression then {
        print "expression @\{n.lineno}:\{n.colno}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.expression.u64)
    } case ifexpr then {
        print "ifexpr @\{n.lineno}:\{n.colno} clauses=\{n.clauses.length}"
        clit: n.clauses.iterate
        for clId: clit loop printNodeCanonical :ast n: (ast.nodes.get i: clId.u64)
        print "  elseclause:"
        printOptChildCanonicalAt :ast id: n.elseclause
    } case ifclause then {
        print "ifclause @\{n.lineno}:\{n.colno} conditions=\{n.conditions.length}"
        coit: n.conditions.iterate
        for coId: coit loop printNodeCanonical :ast n: (ast.nodes.get i: coId.u64)
        printNodeCanonical :ast n: (ast.nodes.get i: n.statement.u64)
    } case forexpr then {
        print "forexpr @\{n.lineno}:\{n.colno} conditions=\{n.conditions.length} postconditions=\{n.postconditions.length}"
        fcit: n.conditions.iterate
        for fcId: fcit loop printNodeCanonical :ast n: (ast.nodes.get i: fcId.u64)
        print "  body:"
        printOptChildCanonicalAt :ast id: n.body
        fpit: n.postconditions.iterate
        for fpId: fpit loop printNodeCanonical :ast n: (ast.nodes.get i: fpId.u64)
    } case doexpr then {
        print "doexpr @\{n.lineno}:\{n.colno}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.statement.u64)
    } case withexpr then {
        wnc: nameTextCopy :ast ref: n.name
        print "withexpr @\{n.lineno}:\{n.colno} name=\{wnc}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.value.u64)
        printNodeCanonical :ast n: (ast.nodes.get i: n.body.u64)
    } case caseexpr then {
        print "caseexpr @\{n.lineno}:\{n.colno} clauses=\{n.clauses.length}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.subject.u64)
        ccit: n.clauses.iterate
        for ccId: ccit loop printNodeCanonical :ast n: (ast.nodes.get i: ccId.u64)
        print "  elseclause:"
        printOptChildCanonicalAt :ast id: n.elseclause
    } case caseclause then {
        ccc: nameTextCopy :ast ref: n.name
        print "caseclause @\{n.lineno}:\{n.colno} name=\{ccc}"
        printNodeCanonical :ast n: (ast.nodes.get i: n.matcharm.u64)
        printNodeCanonical :ast n: (ast.nodes.get i: n.statement.u64)
    } case functiondef then {
        print "functiondef @\{n.lineno}:\{n.colno} params=\{n.parameters.length} isNative=\{n.isNative}"
        print "  returntype:"
        printOptChildCanonicalAt :ast id: n.returntype
        piter: n.parameters.iterate
        for pmId: piter loop printNodeCanonical :ast n: (ast.nodes.get i: pmId.u64)
        print "  body:"
        printOptChildCanonicalAt :ast id: n.body
        faiter: n.asItems.iterate
        for famId: faiter loop printNodeCanonical :ast n: (ast.nodes.get i: famId.u64)
    } case objectdef then {
        print "objectdef @\{n.lineno}:\{n.colno} kind=\{objectkindname n.kind} isItems=\{n.isItems.length} asItems=\{n.asItems.length} isNative=\{n.isNative}"
        oiiter: n.isItems.iterate
        for oimId: oiiter loop printNodeCanonical :ast n: (ast.nodes.get i: oimId.u64)
        oaiter: n.asItems.iterate
        for oamId: oaiter loop printNodeCanonical :ast n: (ast.nodes.get i: oamId.u64)
    } case unitdef then {
        print "unitdef @\{n.lineno}:\{n.colno} kind=\{unitkindname n.kind} body=\{n.body.length}"
        ubi: u64
        ubn: n.body.length
        for ubi < ubn loop {
            ubid: n.body.get i: ubi
            printNodeCanonical :ast n: (ast.nodes.get i: ubid.u64)
            ubi = ubi + 1
        }
    } case program then {
        print "program @\{n.lineno}:\{n.colno} units=\{ast.units.length} mainUnitName=\{n.mainUnitName}"
        pui: u64
        pun: ast.units.length
        for pui < pun loop {
            puid: (nodeid.create from: (ast.units.get i: pui))
            printNodeCanonical :ast n: (ast.nodes.get i: puid.u64)
            pui = pui + 1
        }
    }
}

# printNodeCanonicalAt -- print the row an id names. The row view is this
# frame's, so the table is not fetched from and lent in one call.
printNodeCanonicalAt: function {ast: Ast.view nId: nodeid} is {
    n: ast.nodes.get i: nId.u64
    printNodeCanonical :ast :n
}

# printProgramCanonicalRoot -- canonical dump entry for a parsed program
# node (its master table rides inside it).
printProgramCanonicalRoot: function {prog: Node.view} is {
    match (
        prog
    ) case program then {
        print "program @\{prog.lineno}:\{prog.colno} units=\{prog.ast.units.length} mainUnitName=\{prog.mainUnitName}"
        pui: u64
        pun: prog.ast.units.length
        for pui < pun loop {
            puid: (nodeid.create from: (prog.ast.units.get i: pui))
            printNodeCanonicalAt ast: prog.ast nId: puid
            pui = pui + 1
        }
    } else null
}

# ---- id-linked master node table ----
# The parser reserves one table slot per minted nodeid; a reserved slot
# holds the payload-less placeholder arm until a converted parent moves
# the real child into it. A nodeid IS its row's index; row 0 is the
# sentinel a node id of 0 addresses.

# tableReserve -- reserve a table slot for a node not yet built; the
# slot holds the placeholder arm until tableAdd moves the finished
# node in.
tableReserve: function {ast: Ast} out nodeid is {
    id: (nodeid.create from: (ast.nodes.length).u32.orPanic)
    ast.nodes.append from: Node.placeholder
    return id
}

# tableSet -- move a converted parent's child into its reserved slot
# (the displaced placeholder is destroyed here).
tableSet: function {ast: Ast id: u32 child: Node.take} is {
    ast.nodes.set i: id.u64 val: child
}

# childIds -- the child node ids of `n`, in canonical order: the order every
# walk and the dump visit them in. A walk that needs no per-arm semantics
# recurses over this list; a walk that binds names or skips a child keeps its
# own arm for that child and takes the rest from here. Absent optional
# children (an if without else, a function without a body) are omitted, and a
# program's children are the program's units.
childIds: function {ast: Ast.view n: Node.view} out (ListVal u32) is {
    acc: (ListVal u32)
    match (
        n
    ) case binop then {
        acc.append from: n.lhs.u32
        acc.append from: n.operator.u32
        acc.append from: n.rhs.u32
    } case atomstring then {
        appendIds :acc ids: n.stringparts
    } case dottedpath then {
        acc.append from: n.parent.u32
        acc.append from: n.child.u32
    } case call then {
        acc.append from: n.callable.u32
        appendIds :acc ids: n.arguments
    } case typeofexpr then {
        acc.append from: n.source.u32
    } case namedoperation then {
        acc.append from: n.operation.u32
    } case datablock then {
        appendIds :acc ids: n.elements
        appendOptId :acc id: n.outType
    } case yieldexpr then {
        acc.append from: n.expr.u32
    } case statement then {
        appendIds :acc ids: n.statements
    } case statementline then {
        acc.append from: n.statementline.u32
    } case assignment then {
        acc.append from: n.value.u32
    } case reassignment then {
        acc.append from: n.topath.u32
        acc.append from: n.value.u32
    } case swapstmt then {
        acc.append from: n.lhs.u32
        acc.append from: n.rhs.u32
    } case expression then {
        acc.append from: n.expression.u32
    } case ifexpr then {
        appendIds :acc ids: n.clauses
        appendOptId :acc id: n.elseclause
    } case ifclause then {
        appendIds :acc ids: n.conditions
        acc.append from: n.statement.u32
    } case forexpr then {
        appendIds :acc ids: n.conditions
        appendOptId :acc id: n.body
        appendIds :acc ids: n.postconditions
    } case doexpr then {
        acc.append from: n.statement.u32
    } case withexpr then {
        acc.append from: n.value.u32
        acc.append from: n.body.u32
    } case caseexpr then {
        acc.append from: n.subject.u32
        appendIds :acc ids: n.clauses
        appendOptId :acc id: n.elseclause
    } case caseclause then {
        acc.append from: n.matcharm.u32
        acc.append from: n.statement.u32
    } case functiondef then {
        appendOptId :acc id: n.returntype
        appendIds :acc ids: n.parameters
        appendOptId :acc id: n.body
        appendIds :acc ids: n.asItems
    } case objectdef then {
        appendIds :acc ids: n.isItems
        appendIds :acc ids: n.asItems
    } case unitdef then {
        appendIds :acc ids: n.body
    } case program then {
        appendIds :acc ids: ast.units
    } else null
    return acc
}

# childIdsAt -- childIds of the node with id `id`.
childIdsAt: function {ast: Ast.view id: u32} out (ListVal u32) is {
    return (childIds :ast n: (ast.nodes.get i: id.u64))
}

# stmtLineCount -- the number of lines in statement block `nid` (0 for any
# other arm).
stmtLineCount: function {ast: Ast.view nid: nodeid} out u64 is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case statement then {
        return n.statements.length
    } else null
    return 0
}

# stmtLineAt -- the id of line `i` of statement block `nid` (0 for any other
# arm).
stmtLineAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case statement then {
        return (nodeid.create from: (n.statements.get :i))
    } else null
    zn: nodeid
    return zn
}

# ifCondAt -- the id of condition `i` of if-clause `nid` (0 for any other arm).
ifCondAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case ifclause then {
        return (nodeid.create from: (n.conditions.get :i))
    } else null
    zn: nodeid
    return zn
}

# dataElemAt -- the id of element `i` of data block `nid` (0 for any other
# arm).
dataElemAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case datablock then {
        return (nodeid.create from: (n.elements.get :i))
    } else null
    zn: nodeid
    return zn
}

# caseClauseAt -- the id of clause `i` of match `nid` (0 for any other arm).
caseClauseAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case caseexpr then {
        return (nodeid.create from: (n.clauses.get :i))
    } else null
    zn: nodeid
    return zn
}

# ifClauseAt -- the id of clause `i` of if `nid` (0 for any other arm).
ifClauseAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case ifexpr then {
        return (nodeid.create from: (n.clauses.get :i))
    } else null
    zn: nodeid
    return zn
}

# forCondAt -- the id of condition `i` of for `nid` (0 for any other arm).
forCondAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case forexpr then {
        return (nodeid.create from: (n.conditions.get :i))
    } else null
    zn: nodeid
    return zn
}

# forPostAt -- the id of postcondition `i` of for `nid` (0 for any other arm).
forPostAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case forexpr then {
        return (nodeid.create from: (n.postconditions.get :i))
    } else null
    zn: nodeid
    return zn
}

# objIsItemAt -- the id of `is`-item `i` of object definition `nid` (0 for
# any other arm).
objIsItemAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case objectdef then {
        return (nodeid.create from: (n.isItems.get :i))
    } else null
    zn: nodeid
    return zn
}

# objAsItemAt -- the id of `as`-item `i` of object definition `nid` (0 for
# any other arm).
objAsItemAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case objectdef then {
        return (nodeid.create from: (n.asItems.get :i))
    } else null
    zn: nodeid
    return zn
}

# fnParamAt -- the id of parameter `i` of function `nid` (0 for any other
# arm).
fnParamAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case functiondef then {
        return (nodeid.create from: (n.parameters.get :i))
    } else null
    zn: nodeid
    return zn
}

# callArgAt -- the id of argument `i` of call `nid` (0 for any other arm).
callArgAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case call then {
        return (nodeid.create from: (n.arguments.get :i))
    } else null
    zn: nodeid
    return zn
}

# stringPartAt -- the id of part `i` of interpolated string `nid` (0 for any
# other arm).
stringPartAt: function {ast: Ast.view nid: nodeid i: u64} out nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case atomstring then {
        return (nodeid.create from: (n.stringparts.get :i))
    } else null
    zn: nodeid
    return zn
}

appendIds: function {acc: ListVal u32 ids: (ListVal u32).view} is {
    with it: ids.iterate do for i: it loop acc.append from: i
}

appendOptId: function {acc: ListVal u32 id: nodeid} is {
    if (id.isZero) == false then acc.append from: id.u32
}

# nodeIdOf -- a node's own id (any arm).
nodeIdOf: function {n: Node.view} out nodeid is {
    zn: nodeid
    match (
        n
    ) case error then {
        return n.nodeid
    } case placeholder then {
        return zn
    } case atomid then {
        return n.nodeid
    } case labelvalue then {
        return n.nodeid
    } case stringchunk then {
        return n.nodeid
    } case binop then {
        return n.nodeid
    } case atomstring then {
        return n.nodeid
    } case dottedpath then {
        return n.nodeid
    } case call then {
        return n.nodeid
    } case typeofexpr then {
        return n.nodeid
    } case namedoperation then {
        return n.nodeid
    } case datablock then {
        return n.nodeid
    } case yieldexpr then {
        return n.nodeid
    } case statement then {
        return n.nodeid
    } case statementline then {
        return n.nodeid
    } case assignment then {
        return n.nodeid
    } case reassignment then {
        return n.nodeid
    } case swapstmt then {
        return n.nodeid
    } case expression then {
        return n.nodeid
    } case ifexpr then {
        return n.nodeid
    } case ifclause then {
        return n.nodeid
    } case forexpr then {
        return n.nodeid
    } case doexpr then {
        return n.nodeid
    } case withexpr then {
        return n.nodeid
    } case caseexpr then {
        return n.nodeid
    } case caseclause then {
        return n.nodeid
    } case functiondef then {
        return n.nodeid
    } case objectdef then {
        return n.nodeid
    } case unitdef then {
        return n.nodeid
    } case program then {
        return n.nodeid
    }
}

# tableAdd -- move a finished node into its reserved slot; returns its id.
tableAdd: function {ast: Ast n: Node.take} out nodeid is {
    id: nodeIdOf :n
    tableSet :ast :id child: n
    return id
}

# tableTake -- swap a row out of the table (a placeholder goes back in);
# used to propagate an error node up out of a converted list.
tableTake: function {ast: Ast id: u32} out Node is {
    return (ast.nodes.set i: id.u64 val: Node.placeholder)
}

# isErrorAt -- the node with id `id` is an error arm.
isErrorAt: function {ast: Ast.view id: u32} out bool is {
    n: ast.nodes.get i: id.u64
    if n.error then return true
    return false
}

# armName -- the name of `n`'s arm, as spelled in the Node union.
armName: function {n: Node.view} out StringView is {
    match (
        n
    ) case error then {
        return "error"
    } case placeholder then {
        return "placeholder"
    } case atomid then {
        return "atomid"
    } case labelvalue then {
        return "labelvalue"
    } case stringchunk then {
        return "stringchunk"
    } case binop then {
        return "binop"
    } case atomstring then {
        return "atomstring"
    } case dottedpath then {
        return "dottedpath"
    } case call then {
        return "call"
    } case typeofexpr then {
        return "typeofexpr"
    } case namedoperation then {
        return "namedoperation"
    } case datablock then {
        return "datablock"
    } case yieldexpr then {
        return "yieldexpr"
    } case statement then {
        return "statement"
    } case statementline then {
        return "statementline"
    } case assignment then {
        return "assignment"
    } case reassignment then {
        return "reassignment"
    } case swapstmt then {
        return "swapstmt"
    } case expression then {
        return "expression"
    } case ifexpr then {
        return "ifexpr"
    } case ifclause then {
        return "ifclause"
    } case forexpr then {
        return "forexpr"
    } case doexpr then {
        return "doexpr"
    } case withexpr then {
        return "withexpr"
    } case caseexpr then {
        return "caseexpr"
    } case caseclause then {
        return "caseclause"
    } case functiondef then {
        return "functiondef"
    } case objectdef then {
        return "objectdef"
    } case unitdef then {
        return "unitdef"
    } case program then {
        return "program"
    }
}

isGenericParamOp: function {ast: Ast.view opId: u32} out bool is {
    if opId == 0 then return false
    n: ast.nodes.get i: opId.u64
    match (
        n
    ) case expression then {
        return (isGenericParamOp :ast opId: n.expression)
    } case call then {
        return (isGenericParamOp :ast opId: n.callable)
    } case dottedpath then {
        c: ast.nodes.get i: n.child.u64
        match (
            c
        ) case atomid then {
            if (nameTextEq :ast ref: c.name s: "generic") then return true
            if (nameTextEq :ast ref: c.name s: "valtype") then return true
            if (nameTextEq :ast ref: c.name s: "reftype") then return true
            return false
        } case labelvalue then {
            if (nameTextEq :ast ref: c.name s: "generic") then return true
            if (nameTextEq :ast ref: c.name s: "valtype") then return true
            if (nameTextEq :ast ref: c.name s: "reftype") then return true
            return false
        } else {
            return false
        }
    } else {
        return false
    }
}

# True when any member of the definition list `items` declares a generic
# parameter, i.e. the body it came from is a template.
itemsHaveGenericParam: function {ast: Ast.view items: (ListVal u32).view} out bool is {
    hi: u64
    hn: items.length
    for hi < hn loop {
        hid: items.get i: hi
        hm: ast.nodes.get i: hid.u64
        match (
            hm
        ) case namedoperation then {
            if (isGenericParamOp :ast opId: hm.operation) then return true
        } else null
        hi = hi + 1
    }
    return false
}

# True when node `opId` is a unit definition of kind `k`, unwrapping an
# `expression` wrapper the way indexDeclDef and resolveDef do. False when the
# node is not a unit definition at all.
unitOpKindIs: function {ast: Ast.view opId: u32 k: unitkind} out bool is {
    if opId == 0 then return false
    n: ast.nodes.get i: opId.u64
    match (
        n
    ) case expression then {
        return (unitOpKindIs :ast opId: n.expression :k)
    } case unitdef then {
        return n.kind.tag == k.tag
    } else {
        return false
    }
}

# unitOpDeclaresUnit -- does this op declare a UNIT of static definitions: a
# file unit root, an inline `m: unit { }` (both `namespace`) or a hidden
# implementation subunit (`subunit`), or a `public:` block -- a nested unit
# named `public` whose body designates the unit's surface? False for a
# `template` and for the `private:` / `require:` block forms, which are not
# units.
#
# The two arms are NOT interchangeable and this does not merge them: a hidden
# subunit is private to its parent (only the parent may name it), while an
# inline unit is an ordinary definition, public by default; both resolve
# outward alike. A caller that cares asks `unitkind.subunit` -- what this answers is
# only "is there a unit body here", which is the question every walker that
# recurses into one was open-coding as the disjunction.
unitOpDeclaresUnit: function {ast: Ast.view opId: u32} out bool is {
    if (unitOpKindIs :ast :opId k: unitkind.namespace) then return true
    if (unitOpKindIs :ast :opId k: unitkind.publicNs) then return true
    return (unitOpKindIs :ast :opId k: unitkind.subunit)
}

# unitBodyIdsAt -- a unit row's member ids. The row view is scoped to this
# fetch so the caller may lend the table exclusively afterwards; the ids are
# values, so the returned list is independent of the table. An id that does
# not name a unit yields an empty list.
# True when `opId` declares a generic parameter -- `<constraint>.generic`,
# `.valtype` or `.reftype` -- unwrapping the expression and call wrappers the
# form can carry. The parser marks a unit body holding one as a template; the
# typechecker asks the same question of a type body.
unitBodyIdsAt: function {ast: Ast.view unitId: u32} out (ListVal u32) is {
    result: (ListVal u32)
    {
        u: ast.nodes.get i: unitId.u64
        if u.unitdef then {
            with bit: u.body.iterate do for b: bit loop result.append b
        }
    }
    return result
}
