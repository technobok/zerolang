    classes: list {
        # a Database is live once open could answer one. Its destructor calls SQLite,
        # whose declarations come after the struct, so it is a row of the unit's own,
        # after them, rather than the class's destroy
        (c.classRow key: "Database" live: list { "Result_Database_SqliteError" })
        # a Statement finalizes once and is live once prepare could answer one; its
        # helpers load with the type, its destructor after them as the Database's does,
        # when written C calls it
        (c.classRow key: "Statement" live: list { "Result_Statement_SqliteError" })
        # a Row reads its statement's current row and owns nothing; it is live once a
        # Step can answer one, so its struct and helpers are there before step's C
        (
            c.classRow
            key: "Row"
            live: list { "Step" }
            destroy: """
                /* a Row's destructor: a row owns nothing -- it reads its statement's current
                   row, which the statement keeps. */
                static void z_@Row@_destroy(z_@Row@_t* p) {
                    (void)p;
                }

                """
        )
        # a Transaction rolls back unless it ended; live once transaction could answer
        # one, its destructor after the unit's declarations as the Database's is
        (c.classRow key: "Transaction" live: list { "Result_Transaction_SqliteError" })
    }
