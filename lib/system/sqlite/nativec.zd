    sources: list {
        # sqlite -- SQLite 3.54.0 (vendor/sqlite), compiled ON DEMAND by the driver
        # with the compiler that links the program and linked statically; the defines
        # are vendor/sqlite/VERSION.md's, each with its reason. The fragments declare
        # the part of SQLite's interface they call (_Z_SQLITE_DECLS, checked against
        # sqlite3.h by sqlite-decls-guard), then the helpers every member shares. A
        # threaded program builds it multi-thread (THREADSAFE=2: a connection is used
        # by one thread at a time, which `thread.Unshareable` on its types enforces);
        # the two rows differ in that define and the pthread link alone.
        (
            c.source
            path: "sqlite/sqlite3.c"
            defines: list {
                "SQLITE_THREADSAFE=2" "SQLITE_OMIT_LOAD_EXTENSION" "SQLITE_DQS=0"
                "SQLITE_DEFAULT_MEMSTATUS=0" "SQLITE_DEFAULT_WAL_SYNCHRONOUS=1"
                "SQLITE_OMIT_DEPRECATED" "SQLITE_OMIT_SHARED_CACHE" "SQLITE_OMIT_PROGRESS_CALLBACK"
                "SQLITE_LIKE_DOESNT_MATCH_BLOBS" "SQLITE_MAX_EXPR_DEPTH=0" "SQLITE_STRICT_SUBTYPE=1"
                "SQLITE_ENABLE_FTS5" "SQLITE_ENABLE_RTREE" "SQLITE_ENABLE_MATH_FUNCTIONS"
                "SQLITE_ENABLE_PERCENTILE" "SQLITE_ENABLE_DBSTAT_VTAB"
                "SQLITE_ENABLE_COLUMN_METADATA" "SQLITE_ENABLE_CARRAY"
            }
            fact: "threaded"
        )
        (
            c.source
            path: "sqlite/sqlite3.c"
            defines: list {
                "SQLITE_THREADSAFE=0" "SQLITE_OMIT_LOAD_EXTENSION" "SQLITE_DQS=0"
                "SQLITE_DEFAULT_MEMSTATUS=0" "SQLITE_DEFAULT_WAL_SYNCHRONOUS=1"
                "SQLITE_OMIT_DEPRECATED" "SQLITE_OMIT_SHARED_CACHE" "SQLITE_OMIT_PROGRESS_CALLBACK"
                "SQLITE_LIKE_DOESNT_MATCH_BLOBS" "SQLITE_MAX_EXPR_DEPTH=0" "SQLITE_STRICT_SUBTYPE=1"
                "SQLITE_ENABLE_FTS5" "SQLITE_ENABLE_RTREE" "SQLITE_ENABLE_MATH_FUNCTIONS"
                "SQLITE_ENABLE_PERCENTILE" "SQLITE_ENABLE_DBSTAT_VTAB"
                "SQLITE_ENABLE_COLUMN_METADATA" "SQLITE_ENABLE_CARRAY"
            }
        )
    }
)
