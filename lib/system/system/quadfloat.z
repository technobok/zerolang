# quadfloat -- IEEE-754 quadruple precision, an implementation subunit of
# system. Its C is __float128, with libquadmath for printing, parsing and the
# maths: x86-64's, and absent from tcc. That is a fact about the C backend, so
# the C backend's table says it (natives.tbl's `@unit.system.quadfloat` row):
# a program that reaches this unit links libquadmath, and one built with a
# compiler or for a target that has no __float128 is refused by name before
# any C is compiled.

# IEEE-754 quadruple-precision (128-bit) floating point.
f128: record is native as {
    # f128 addition, rounded once to the nearest representable value
    +: function {t: this.view rhs: type} out type is native
    # f128 subtraction, rounded once; cancelling two near-equal f128 values
    # loses precision here
    -: function {t: this.view rhs: type} out type is native
    # f128 multiplication, rounded once to nearest
    *: function {t: this.view rhs: type} out type is native
    # f128 division; unlike the integer types a zero divisor gives an infinity
    # rather than trapping
    /: function {t: this.view rhs: type} out type is native
    # the f128 remainder of a truncating division, keeping the left operand's
    # sign
    %: function {t: this.view rhs: type} out type is native
    # the f128 ordering admitting equality -- still false against a NaN
    <=: function {t: this.view rhs: type} out bool is native
    # orders two f128 values; every comparison against a NaN is false, this one
    # included
    <: function {t: this.view rhs: type} out bool is native
    # the f128 ordering reversed; false against a NaN
    >: function {t: this.view rhs: type} out bool is native
    # the reversed f128 ordering admitting equality; false against a NaN
    >=: function {t: this.view rhs: type} out bool is native
    # true when both are the same f128. A NaN equals NOTHING, itself included
    ==: function {t: this.view rhs: type} out bool is native
    # true when the two f128 values differ -- and true when either is a NaN
    !=: function {t: this.view rhs: type} out bool is native
    # no hash: a NaN is unequal to itself and the two zeros are equal, so no
    # hash of an f128 agrees with its `==` -- an f128 cannot key a Map or a Set
    hash: null
    # f128 to u8: fails on a fraction, and outside what u8 can hold
    u8: function {t: this.view} out (resultval u8 e: converror) is native
    # f128 to i8: fails on a fraction, and outside what i8 can hold
    i8: function {t: this.view} out (resultval i8 e: converror) is native
    # f128 to i16: fails on a fraction, and outside what i16 can hold
    i16: function {t: this.view} out (resultval i16 e: converror) is native
    # f128 to i32: fails on a fraction, and outside what i32 can hold
    i32: function {t: this.view} out (resultval i32 e: converror) is native
    # f128 to i64: fails on a fraction, and outside what i64 can hold
    i64: function {t: this.view} out (resultval i64 e: converror) is native
    # f128 to i128: fails on a fraction, and outside what i128 can hold
    i128: function {t: this.view} out (resultval i128 e: converror) is native
    # f128 to u16: fails on a fraction, and outside what u16 can hold
    u16: function {t: this.view} out (resultval u16 e: converror) is native
    # f128 to u32: fails on a fraction, and outside what u32 can hold
    u32: function {t: this.view} out (resultval u32 e: converror) is native
    # f128 to u64: fails on a fraction, and outside what u64 can hold
    u64: function {t: this.view} out (resultval u64 e: converror) is native
    # f128 to u128: fails on a fraction, and outside what u128 can hold
    u128: function {t: this.view} out (resultval u128 e: converror) is native
    # f128 to f16: STRICT-EXACT, so it fails unless the value round-trips
    # through f16 unchanged
    f16: function {t: this.view} out (resultval f16 e: converror) is native
    # f128 to f32: STRICT-EXACT, so it fails unless the value round-trips
    # through f32 unchanged
    f32: function {t: this.view} out (resultval f32 e: converror) is native
    # f128 to f64: STRICT-EXACT, so it fails unless the value round-trips
    # through f64 unchanged
    f64: function {t: this.view} out (resultval f64 e: converror) is native
    # f128 to c8: fails on a fraction, and outside what c8 can hold
    c8: function {t: this.view} out (resultval c8 e: converror) is native
    # f128 to c32: fails on a fraction, and outside what c32 can hold
    c32: function {t: this.view} out (resultval c32 e: converror) is native
    # the f128 bit pattern as an unsigned integer of the same width, sign and
    # exponent included
    bits: function {t: this.view} out u128 is native
    # x scaled by a power of two, exactly: IEEE 754's scaleB, C99's scalbn. It
    # is not a multiplication -- the exponent moves and the significand does
    # not, so no rounding happens anywhere in the type's range.
    scaleB: function {t: this.view n: i32} out type is native
    # the UNBIASED exponent of x: IEEE 754's logB, C99's ilogb. Subnormals are
    # normalised first, so this is the binade whatever the encoding.
    logB: function {t: this.view} out i32 is native
    # the square root, correctly rounded as IEEE 754 requires: -0 for -0, and a
    # NaN below zero
    sqrt: function {t: this.view} out type is native
    # the cube root, of either sign: the cube root of -8 is -2
    cbrt: function {t: this.view} out type is native
    # the length sqrt(this^2 + y^2), without the overflow or underflow that
    # squaring the two first would cause
    hypot: function {t: this.view y: type} out type is native
    # this raised to the power y, as C's pow: anything to the power 0 is 1, a
    # NaN included, and a negative base takes only an integer power
    pow: function {t: this.view y: type} out type is native
    # e raised to this power
    exp: function {t: this.view} out type is native
    # 2 raised to this power, exact at every integer power in range
    exp2: function {t: this.view} out type is native
    # e raised to this power, minus one -- accurate near zero, where `exp`
    # would round to almost 1 and the subtraction would cancel what is left
    expm1: function {t: this.view} out type is native
    # the natural logarithm: an infinity at zero and a NaN below it
    log: function {t: this.view} out type is native
    # the base-2 logarithm, exact at every power of two
    log2: function {t: this.view} out type is native
    # the base-10 logarithm
    log10: function {t: this.view} out type is native
    # the natural logarithm of 1 + this -- accurate near zero, where the sum
    # would round away the digits that matter
    log1p: function {t: this.view} out type is native
    # the sine of an angle in radians
    sin: function {t: this.view} out type is native
    # the cosine of an angle in radians
    cos: function {t: this.view} out type is native
    # the tangent of an angle in radians
    tan: function {t: this.view} out type is native
    # the angle in radians, in [-pi/2, pi/2], whose sine this is; a NaN outside
    # [-1, 1]
    asin: function {t: this.view} out type is native
    # the angle in radians, in [0, pi], whose cosine this is; a NaN outside
    # [-1, 1]
    acos: function {t: this.view} out type is native
    # the angle in radians, in [-pi/2, pi/2], whose tangent this is
    atan: function {t: this.view} out type is native
    # the angle in radians, in [-pi, pi], of the point (x, this) -- this is
    # the y coordinate, which is why the argument is labelled x
    atan2: function {t: this.view x: type} out type is native
    # the hyperbolic sine
    sinh: function {t: this.view} out type is native
    # the hyperbolic cosine, never below 1
    cosh: function {t: this.view} out type is native
    # the hyperbolic tangent, in (-1, 1)
    tanh: function {t: this.view} out type is native
    # the value whose hyperbolic sine this is
    asinh: function {t: this.view} out type is native
    # the non-negative value whose hyperbolic cosine this is; a NaN below 1
    acosh: function {t: this.view} out type is native
    # the value whose hyperbolic tangent this is: an infinity at -1 and 1, and
    # a NaN beyond them
    atanh: function {t: this.view} out type is native
    # the error function, rising from -1 to 1 through 0
    erf: function {t: this.view} out type is native
    # 1 - erf -- accurate where erf is near 1 and the subtraction would cancel
    erfc: function {t: this.view} out type is native
    # the gamma function, (n - 1)! at a positive integer n; C's tgamma
    gamma: function {t: this.view} out type is native
    # the natural logarithm of gamma's magnitude -- C's lgamma, finite long
    # after gamma itself overflows
    logGamma: function {t: this.view} out type is native
    # the largest integer value not above this
    floor: function {t: this.view} out type is native
    # the smallest integer value not below this
    ceil: function {t: this.view} out type is native
    # this with its fraction dropped, toward zero
    trunc: function {t: this.view} out type is native
    # the nearest integer value, a halfway case away from zero: 2.5 is 3 and
    # -2.5 is -3
    round: function {t: this.view} out type is native
    # the nearest integer value, a halfway case to the even one: 2.5 is 2 and
    # 3.5 is 4 -- IEEE 754's default rounding
    roundEven: function {t: this.view} out type is native
    # the magnitude: the sign bit cleared, so -0 is 0 and a NaN stays a NaN
    abs: function {t: this.view} out type is native
    # this one's magnitude with y's sign bit -- the sign of a zero or a NaN
    # included
    copySign: function {t: this.view y: type} out type is native
    # this * y + z, rounded ONCE: the operators round the product and then
    # the sum, and the first rounding can lose everything the sum keeps
    fma: function {t: this.view y: type z: type} out type is native
    # the smaller of the two -- IEEE 754's minNum, so a NaN loses to a number
    min: function {t: this.view y: type} out type is native
    # the larger of the two -- IEEE 754's maxNum, so a NaN loses to a number
    max: function {t: this.view y: type} out type is native
    # whether this is a NaN, the one value unequal to itself
    isNaN: function {t: this.view} out bool is native
    # whether this is an infinity, of either sign
    isInf: function {t: this.view} out bool is native
    # whether this is neither an infinity nor a NaN
    isFinite: function {t: this.view} out bool is native
    # whether the sign bit is set: true for -0 and for every negative value
    signBit: function {t: this.view} out bool is native
    # the f128 identity conversion, so a width can be named uniformly even when
    # it does not change
    f128: function {t: this.view} out type is native
    # the zero f128, positive
    create: function {} out type is native
    tag: tag
}
