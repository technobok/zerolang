# wideint -- the 128-bit integers, an implementation subunit of system: they
# need something from the host toolchain that not every compiler has, and a
# unit is what a require: block attaches to.

# tcc has no __int128: it rejects the emitted C with a parse error naming a
# type the program never wrote, in a temp file that is already deleted. Saying
# so here replaces that with this unit's own message, at the point the
# toolchain is chosen rather than after the C is written.
#
# gcc and clang need no library for __int128 -- it is a compiler builtin, not
# a runtime -- so the other arm names none and this unit adds no `-l`.
require: unit {
    library: if platform.cc == platform.cckind.tcc then {
        error "tcc has no __int128; build this with gcc or clang"
    } else {
        ""
    }
}

# signed 128-bit integer. Range -2^127 to 2^127 - 1.
i128: record is native as {
    +: function {:this rhs: type} out type is native
    -: function {:this rhs: type} out type is native
    *: function {:this rhs: type} out type is native
    /: function {:this rhs: type} out type is native
    %: function {:this rhs: type} out type is native
    &: function {:this rhs: type} out type is native
    |: function {:this rhs: type} out type is native
    ^: function {:this rhs: type} out type is native
    <=: function {:this rhs: type} out bool is native
    <: function {:this rhs: type} out bool is native
    >: function {:this rhs: type} out bool is native
    >=: function {:this rhs: type} out bool is native
    ==: function {:this rhs: type} out bool is native
    !=: function {:this rhs: type} out bool is native
    u8: function {:this} out (resultval t: u8 e: converror) is native
    i8: function {:this} out (resultval t: i8 e: converror) is native
    i16: function {:this} out (resultval t: i16 e: converror) is native
    i32: function {:this} out (resultval t: i32 e: converror) is native
    i64: function {:this} out (resultval t: i64 e: converror) is native
    u16: function {:this} out (resultval t: u16 e: converror) is native
    u32: function {:this} out (resultval t: u32 e: converror) is native
    u64: function {:this} out (resultval t: u64 e: converror) is native
    u128: function {:this} out (resultval t: u128 e: converror) is native
    f32: function {:this} out (resultval t: f32 e: converror) is native
    f64: function {:this} out (resultval t: f64 e: converror) is native
    f16: function {:this} out (resultval t: f16 e: converror) is native
    f128: function {:this} out (resultval t: f128 e: converror) is native
    iterate: function {:this from: type} out (optionval type) is native
    each: function {:this from: type} out (optionval type) is native
    c8: function {:this} out (resultval t: c8 e: converror) is native
    c32: function {:this} out (resultval t: c32 e: converror) is native
    i128: function {:this} out type is native
    create: function {} out type is native
    tag: tag
}

# unsigned 128-bit integer. Range 0 to 2^128 - 1.
u128: record is native as {
    +: function {:this rhs: type} out type is native
    -: function {:this rhs: type} out type is native
    *: function {:this rhs: type} out type is native
    /: function {:this rhs: type} out type is native
    %: function {:this rhs: type} out type is native
    &: function {:this rhs: type} out type is native
    |: function {:this rhs: type} out type is native
    ^: function {:this rhs: type} out type is native
    <=: function {:this rhs: type} out bool is native
    <: function {:this rhs: type} out bool is native
    >: function {:this rhs: type} out bool is native
    >=: function {:this rhs: type} out bool is native
    ==: function {:this rhs: type} out bool is native
    !=: function {:this rhs: type} out bool is native
    u8: function {:this} out (resultval t: u8 e: converror) is native
    i8: function {:this} out (resultval t: i8 e: converror) is native
    i16: function {:this} out (resultval t: i16 e: converror) is native
    i32: function {:this} out (resultval t: i32 e: converror) is native
    i64: function {:this} out (resultval t: i64 e: converror) is native
    i128: function {:this} out (resultval t: i128 e: converror) is native
    u16: function {:this} out (resultval t: u16 e: converror) is native
    u32: function {:this} out (resultval t: u32 e: converror) is native
    u64: function {:this} out (resultval t: u64 e: converror) is native
    f32: function {:this} out (resultval t: f32 e: converror) is native
    f64: function {:this} out (resultval t: f64 e: converror) is native
    f16: function {:this} out (resultval t: f16 e: converror) is native
    f128: function {:this} out (resultval t: f128 e: converror) is native
    iterate: function {:this from: type} out (optionval type) is native
    each: function {:this from: type} out (optionval type) is native
    c8: function {:this} out (resultval t: c8 e: converror) is native
    c32: function {:this} out (resultval t: c32 e: converror) is native
    u128: function {:this} out type is native
    create: function {} out type is native
    tag: tag
}
