# wideint -- the 128-bit integers, an implementation subunit of system. They
# build with every C compiler: where it has a 128-bit integer type the runtime
# uses it, and where it has none (tcc) a value is two 64-bit words -- the
# runtime's choice, made by the C preprocessor (z_head.inc,
# natives/_Z_INT128.inc), so nothing here depends on the toolchain.

# signed 128-bit integer. Range -2^127 to 2^127 - 1.
i128: record is native as {
    # i128 addition wraps at 128 bits: 2^127 + 1 is -2^127
    +: function {t: this.view rhs: type} out type is native
    # i128 subtraction wraps at 128 bits: -2^127 - 1 is 2^127
    -: function {t: this.view rhs: type} out type is native
    # i128 multiplication wraps at 128 bits; everything above bit 127 is
    # discarded
    *: function {t: this.view rhs: type} out type is native
    # i128 truncating division. A ZERO DIVISOR IS NOT GUARDED -- it traps
    /: function {t: this.view rhs: type} out type is native
    # the i128 remainder, taking its sign from the left operand. A zero divisor
    # traps, as for /
    %: function {t: this.view rhs: type} out type is native
    # bitwise AND across i128's 128 bits
    &: function {t: this.view rhs: type} out type is native
    # bitwise OR across i128's 128 bits
    |: function {t: this.view rhs: type} out type is native
    # i128 left shift. The count is read as UNSIGNED, so 128 or more -- a
    # negative count included -- gives 0 rather than undefined behaviour
    <<: function {t: this.view rhs: type} out type is native
    # i128 ARITHMETIC right shift: the sign bit fills, so a negative value stays
    # negative. `bits` spells the logical shift. A count of 128 or more is the
    # sign fill
    >>: function {t: this.view rhs: type} out type is native
    # bitwise XOR across i128's 128 bits
    ^: function {t: this.view rhs: type} out type is native
    # bitwise complement across i128's 128 bits
    not: function {t: this.view} out type is native
    # the i128 ordering again, admitting equality
    <=: function {t: this.view rhs: type} out bool is native
    # orders two i128 values as SIGNED, so -2^127 is the smallest
    <: function {t: this.view rhs: type} out bool is native
    # the i128 ordering reversed: true when this one is the larger
    >: function {t: this.view rhs: type} out bool is native
    # the reversed i128 ordering, admitting equality
    >=: function {t: this.view rhs: type} out bool is native
    # true when the two i128 values are the same number
    ==: function {t: this.view rhs: type} out bool is native
    # true when the two i128 values differ
    !=: function {t: this.view rhs: type} out bool is native
    # the i128 total order as -1, 0 or 1: below, equal, above. What `sort`
    # orders a list of i128 by
    compare: function {t: this.view rhs: type} out system.i32 is native
    # i128 to u8: fails outside 0..255
    u8: function {t: this.view} out (resultval system.u8 e: converror) is native
    # i128 to i8: fails outside -128..127
    i8: function {t: this.view} out (resultval system.i8 e: converror) is native
    # i128 to i16: fails outside -32768..32767
    i16: function {t: this.view} out (resultval system.i16 e: converror) is native
    # i128 to i32: fails outside -2147483648..2147483647
    i32: function {t: this.view} out (resultval system.i32 e: converror) is native
    # i128 to i64: fails outside -2^63..2^63
    i64: function {t: this.view} out (resultval system.i64 e: converror) is native
    # i128 to u16: fails outside 0..65535
    u16: function {t: this.view} out (resultval system.u16 e: converror) is native
    # i128 to u32: fails outside 0..4294967295
    u32: function {t: this.view} out (resultval system.u32 e: converror) is native
    # i128 to u64: fails outside 0..2^64
    u64: function {t: this.view} out (resultval system.u64 e: converror) is native
    # i128 to u128: fails below 0
    u128: function {t: this.view} out (resultval system.u128 e: converror) is native
    # i128 to f32: fails past 2^24, where the nearest f32 stops being the value
    f32: function {t: this.view} out (resultval system.f32 e: converror) is native
    # i128 to f64: fails past 2^53, where the nearest f64 stops being the value
    f64: function {t: this.view} out (resultval system.f64 e: converror) is native
    # i128 to f16: fails past 2^11, where the nearest f16 stops being the value
    f16: function {t: this.view} out (resultval system.f16 e: converror) is native
    # i128 to f128: fails past 2^113, where the nearest f128 stops being the
    # value
    f128: function {t: this.view} out (resultval system.f128 e: converror) is native
    # i128 to c8: fails outside 0..255
    c8: function {t: this.view} out (resultval system.c8 e: converror) is native
    # i128 to c32: fails outside 0..4294967295
    c32: function {t: this.view} out (resultval system.c32 e: converror) is native
    # the same 128 bits read as u128, which is how a logical shift of a signed
    # i128 is spelled
    bits: function {t: this.view} out system.u128 is native
    # the i128 identity conversion, so a width can be named uniformly even when
    # it does not change
    i128: function {t: this.view} out type is native
    # i128 addition that answers none where the sum is outside i128
    addChecked: function {v: this.view rhs: type} out optionval type is {
        r: v + rhs
        if (v ^ r & (rhs ^ r)) < 0 then return (optionval.none type)
        return (optionval.some r)
    }
    # i128 subtraction that answers none where the difference is outside i128
    subChecked: function {v: this.view rhs: type} out optionval type is {
        r: v - rhs
        if (v ^ rhs & (v ^ r)) < 0 then return (optionval.none type)
        return (optionval.some r)
    }
    # i128 multiplication that answers none where the product is outside i128
    mulChecked: function {v: this.view rhs: type} out optionval type is {
        r: v * rhs
        if v == 0 then return (optionval.some r)
        # -1 times the lowest value wraps to the lowest value, which the
        # division below would take for the right answer
        if v == -1 then {
            if (rhs < 0) and (r < 0) then return (optionval.none type)
            return (optionval.some r)
        }
        if (r / v) != rhs then return (optionval.none type)
        return (optionval.some r)
    }
    # i128 addition that stops at the type's lowest and highest values
    addSaturating: function {v: this.view rhs: type} out type is {
        r: v + rhs
        if (v ^ r & (rhs ^ r)) >= 0 then return r
        hi: 170141183460469231731687303715884105727.i128
        if rhs < 0 then return hi.not
        return hi
    }
    # i128 subtraction that stops at the type's lowest and highest values
    subSaturating: function {v: this.view rhs: type} out type is {
        r: v - rhs
        if (v ^ rhs & (v ^ r)) >= 0 then return r
        hi: 170141183460469231731687303715884105727.i128
        if rhs < 0 then return hi
        return hi.not
    }
    # i128 multiplication that stops at the type's lowest and highest values
    mulSaturating: function {v: this.view rhs: type} out type is {
        c: v.mulChecked :rhs
        if c.some then return c
        hi: 170141183460469231731687303715884105727.i128
        if v < 0 != (rhs < 0) then return hi.not
        return hi
    }
    # the zero i128
    create: function {} out type is native
    :tag
}

# unsigned 128-bit integer. Range 0 to 2^128 - 1.
u128: record is native as {
    # u128 addition wraps at 128 bits: 2^128 + 1 is 0
    +: function {t: this.view rhs: type} out type is native
    # u128 subtraction wraps at 128 bits: 0 - 1 is 2^128
    -: function {t: this.view rhs: type} out type is native
    # u128 multiplication wraps at 128 bits; everything above bit 127 is
    # discarded
    *: function {t: this.view rhs: type} out type is native
    # u128 truncating division. A ZERO DIVISOR IS NOT GUARDED -- it traps
    /: function {t: this.view rhs: type} out type is native
    # the u128 remainder, taking its sign from the left operand. A zero divisor
    # traps, as for /
    %: function {t: this.view rhs: type} out type is native
    # bitwise AND across u128's 128 bits
    &: function {t: this.view rhs: type} out type is native
    # bitwise OR across u128's 128 bits
    |: function {t: this.view rhs: type} out type is native
    # u128 left shift. The count is read as UNSIGNED, so 128 or more -- a
    # negative count included -- gives 0 rather than undefined behaviour
    <<: function {t: this.view rhs: type} out type is native
    # u128 right shift, filling with zeros. A count of 128 or more gives 0, the
    # count being read as unsigned
    >>: function {t: this.view rhs: type} out type is native
    # bitwise XOR across u128's 128 bits
    ^: function {t: this.view rhs: type} out type is native
    # bitwise complement across u128's 128 bits
    not: function {t: this.view} out type is native
    # the u128 ordering again, admitting equality
    <=: function {t: this.view rhs: type} out bool is native
    # orders two u128 values as UNSIGNED, so 0 is the smallest
    <: function {t: this.view rhs: type} out bool is native
    # the u128 ordering reversed: true when this one is the larger
    >: function {t: this.view rhs: type} out bool is native
    # the reversed u128 ordering, admitting equality
    >=: function {t: this.view rhs: type} out bool is native
    # true when the two u128 values are the same number
    ==: function {t: this.view rhs: type} out bool is native
    # true when the two u128 values differ
    !=: function {t: this.view rhs: type} out bool is native
    # the u128 total order as -1, 0 or 1: below, equal, above. What `sort`
    # orders a list of u128 by
    compare: function {t: this.view rhs: type} out system.i32 is native
    # u128 to u8: fails above 255
    u8: function {t: this.view} out (resultval system.u8 e: converror) is native
    # u128 to i8: fails above 127
    i8: function {t: this.view} out (resultval system.i8 e: converror) is native
    # u128 to i16: fails above 32767
    i16: function {t: this.view} out (resultval system.i16 e: converror) is native
    # u128 to i32: fails above 2147483647
    i32: function {t: this.view} out (resultval system.i32 e: converror) is native
    # u128 to i64: fails above 2^63
    i64: function {t: this.view} out (resultval system.i64 e: converror) is native
    # u128 to i128: fails above 2^127
    i128: function {t: this.view} out (resultval system.i128 e: converror) is native
    # u128 to u16: fails above 65535
    u16: function {t: this.view} out (resultval system.u16 e: converror) is native
    # u128 to u32: fails above 4294967295
    u32: function {t: this.view} out (resultval system.u32 e: converror) is native
    # u128 to u64: fails above 2^64
    u64: function {t: this.view} out (resultval system.u64 e: converror) is native
    # u128 to f32: fails past 2^24, where the nearest f32 stops being the value
    f32: function {t: this.view} out (resultval system.f32 e: converror) is native
    # u128 to f64: fails past 2^53, where the nearest f64 stops being the value
    f64: function {t: this.view} out (resultval system.f64 e: converror) is native
    # u128 to f16: fails past 2^11, where the nearest f16 stops being the value
    f16: function {t: this.view} out (resultval system.f16 e: converror) is native
    # u128 to f128: fails past 2^113, where the nearest f128 stops being the
    # value
    f128: function {t: this.view} out (resultval system.f128 e: converror) is native
    # u128 to c8: fails above 255
    c8: function {t: this.view} out (resultval system.c8 e: converror) is native
    # u128 to c32: fails above 4294967295
    c32: function {t: this.view} out (resultval system.c32 e: converror) is native
    # the u128 identity conversion, so a width can be named uniformly even when
    # it does not change
    u128: function {t: this.view} out type is native
    # u128 addition that answers none where the sum is above u128's highest value
    addChecked: function {v: this.view rhs: type} out optionval type is {
        r: v + rhs
        if r < v then return (optionval.none type)
        return (optionval.some r)
    }
    # u128 subtraction that answers none where the difference is below 0
    subChecked: function {v: this.view rhs: type} out optionval type is {
        if rhs > v then return (optionval.none type)
        return (optionval.some v - rhs)
    }
    # u128 multiplication that answers none where the product is above u128's
    # highest value
    mulChecked: function {v: this.view rhs: type} out optionval type is {
        r: v * rhs
        if v == 0 then return (optionval.some r)
        if (r / v) != rhs then return (optionval.none type)
        return (optionval.some r)
    }
    # u128 addition that stops at the type's highest value
    addSaturating: function {v: this.view rhs: type} out type is {
        r: v + rhs
        if r < v then return 340282366920938463463374607431768211455.u128
        return r
    }
    # u128 subtraction that stops at 0
    subSaturating: function {v: this.view rhs: type} out type is {
        if rhs > v then return 0
        return v - rhs
    }
    # u128 multiplication that stops at the type's highest value
    mulSaturating: function {v: this.view rhs: type} out type is {
        c: v.mulChecked :rhs
        if c.some then return c
        return 340282366920938463463374607431768211455.u128
    }
    # the zero u128
    create: function {} out type is native
    :tag
}
