        (
            c.row
            key: "StringView.repeated"
            call: c.call.simple
            needs: list { "prelude.@xmalloc" }
            fragments: list {
                """
                static z_@String@_t z_@StringView@_repeated(const z_@StringView@_t* self, uint64_t n);
                static z_@String@_t z_@StringView@_repeated(const z_@StringView@_t* self, uint64_t n) {
                    z_@String@_t z = {0};
                    uint64_t total = self->size * n;
                    z.size = total;
                    z.capacity = total + 1;
