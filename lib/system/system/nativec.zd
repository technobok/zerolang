        (c.canon stem: "Map_String_String" spec: list { "MapRR" "String" "String" })
        (c.canon stem: "optionval_u64" spec: list { "optionval" "u64" })
        (c.canon stem: "optionval_u32" spec: list { "optionval" "u32" })
        (c.canon stem: "optionval_u8" spec: list { "optionval" "u8" })
        (c.canon stem: "resultval_i64_parseerror" spec: list { "resultval" "i64" "parseerror" })
        (c.canon stem: "resultval_u64_parseerror" spec: list { "resultval" "u64" "parseerror" })
        (c.canon stem: "resultval_f64_parseerror" spec: list { "resultval" "f64" "parseerror" })
        (c.canon stem: "resultval_f16_parseerror" spec: list { "resultval" "f16" "parseerror" })
        (c.canon stem: "resultval_f128_parseerror" spec: list { "resultval" "f128" "parseerror" })
        (c.canon stem: "ListVal_i64" spec: list { "ListVal" "i64" })
        (c.canon stem: "ListVal_f64" spec: list { "ListVal" "f64" })
        (c.canon stem: "List_Bytes" spec: list { "ListRef" "Bytes" })
    }
    facts: list {
        # threaded -- the program starts a thread: what is process-wide in it (a panic,
        # the environment) must hold with other threads running. Above every row that
        # varies by it.
        (
            c.fact
            name: "threaded"
            reach: list { "thread.spawn" "thread.spawnVal" "thread.spawnDetached" }
        )
    }
    links: list {
        # what a reached unit needs from the C toolchain. `@unit.<path>` names a unit:
        # when a program reaches it -- some declaration in it is demanded, and it
        # declares something native, as a user unit that only shares its name does
        # not -- `link=`
        # adds a library to the link line, `nocc=` refuses the C compiler families that
        # cannot build it (comma-separated) and `arch=` any target architecture but the one named, each
        # by name and before any C is compiled; `os=` limits the row to builds for the
        # operating systems it names (oskind arm names, comma-separated); `cfeature=` names the C feature for the
        # refusal. `csrc=` names a C source under the vendor directory that the unit's
        # runtime needs compiled and linked, and `cdefs=` the defines it is compiled
        # with, comma-separated: the emitted C records both on a `zcsrc:` header line,
        # and the driver builds the object into its cache with the compiler that links
        # (zc cobj). The facts are this backend's, so they live here rather than in the
        # unit.
        (c.link library: "quadmath" subunit: "quadfloat")
    }
    refusals: list {
        (
            c.refusal
            subunit: "quadfloat"
            feature: "__float128"
            compilers: list { c.compiler.tcc c.compiler.msvc }
            onlyArchitectures: list { c.architecture.x86_64 }
        )
    }
)

# foundation -- what every program's C is built on
foundation: (
    c.foundation
    order: list { "sviter" "collections" "system" "io" "cli" "os" "net" "tcc" "thread" "sync" }
    groups: list {
        (
            c.group
            name: "prelude"
            rows: list {
                # a runtime helper no declaration names: every i128 / u128 operation, and their
                # decimal formatter, demanded by the rows above, the conversions and any program
                # that prints or hashes one. The `@` marks it as standing outside the
                # declaration space, as the synthesised comparisons do. Its unit is `prelude`
                # because of WHERE it goes: emitC emits it into the header, ahead of the literal
                # pool, so that a need registered inside a type method is still in time.
                # z_panic, written between the prelude's head (z_head.inc) and its allocators
                # (z_alloc.inc): a threaded program's reports once and ends with _exit
                (
                    c.row
                    key: "@panic"
                    fact: "threaded"
                    pieces: list {
                        (
                            c.piece
                            text: """
                                #include <stdatomic.h>
                                #if defined(_WIN32)
                                #include <windows.h>
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "end_claim"
                            demand: list { "@end_claim" }
                            text: """
                                /* a program that runs threads ends once: the first thread to end it -- a
                                   panic, or os.exit -- flushes and leaves with _exit, so exit's handlers never
                                   run under the other threads' feet, and any thread ending it meanwhile waits
                                   here for that end */
                                static atomic_flag z_ending = ATOMIC_FLAG_INIT;
                                static void z_end_claim(void) {
                                    if (atomic_flag_test_and_set(&z_ending)) {
                                #if defined(_WIN32)
                                        for (;;) Sleep(INFINITE);
                                #else
                                        for (;;) pause();
                                #endif
                                    }
                                }
                                """
                        )
                        (
                            c.piece
                            name: "panic_fn_threaded"
                            demand: list { "@panic" }
                            needs: list { "@end_claim" "@write_line" "@noreturn" }
                            text: """
                                static Z_NORETURN void z_panic(const char* msg) {
                                    z_end_claim();
                                    z_write_line(2, "zpanic: ", 8, 0);
                                    z_write_line(2, msg, strlen(msg), 1);
                                    fflush(NULL);
                                    _exit(1);
                                }
                                """
                        )
                        (
                            c.piece
                            name: "end_threaded"
                            demand: list { "@end" }
                            needs: list { "@end_claim" }
                            text: """
                                /* the program's normal end, once main has returned: it ends the process once,
                                   as z_panic does, and flushes its output before exit runs. Exit's own flush
                                   is not enough here: a C runtime may flush only as it unloads, and a thread
                                   still finishing at that moment can cut that short (wine's does). */
                                static void z_end(void) {
                                    z_end_claim();
                                    fflush(NULL);
                                }
                                """
                        )
                    }
                )
                (
                    c.row
                    key: "@panic"
                    pieces: list {
                        (
                            c.piece
                            name: "panic_fn"
                            demand: list { "@panic" }
                            needs: list { "@write_line" "@noreturn" }
                            text: """
                                static Z_NORETURN void z_panic(const char* msg) {
                                    z_write_line(2, "zpanic: ", 8, 0);
                                    z_write_line(2, msg, strlen(msg), 1);
                                    exit(1);
                                }
                                """
                        )
                        (
                            c.piece
                            name: "end"
                            demand: list { "@end" }
                            text: """
                                /* the program's normal end, once main has returned: nothing to do with one
                                   thread, so exit flushes and leaves */
                                static void z_end(void) {}
                                """
                        )
                    }
                )
                (
                    c.row
                    key: "@int128"
                    pieces: list {
                        (
                            c.piece
                            text: """
                                /* i128 and u128: every operation the rows and the emitter need, as
                                   a function over z_i128 / z_u128 (z_head.inc). Where the C compiler has a
                                   128-bit integer type each one is the operator it names; where it has none
                                   (tcc), or under -DZ_INT128_PORTABLE, the values are two 64-bit words and each
                                   function computes on them. The emitted C is the same for every compiler: it
                                   is z_head.inc's preprocessor test that decides, not zc. Loaded only for
                                   a program that operates on either type. */
                                """
                        )
                        (
                            c.piece
                            name: "u128_lo"
                            demand: list { "@u128_lo" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline uint64_t z_u128_lo(z_u128 x) { return (uint64_t)x; }
                                #else
                                static inline uint64_t z_u128_lo(z_u128 x) { return x.lo; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_hi"
                            demand: list { "@u128_hi" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline uint64_t z_u128_hi(z_u128 x) { return (uint64_t)(x >> 64); }
                                #else
                                static inline uint64_t z_u128_hi(z_u128 x) { return x.hi; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "i128_bits"
                            demand: list { "@i128_bits" }
                            needs: list { "@int128_native" "@i128_t" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_i128_bits(z_i128 x) { return (z_u128)x; }
                                #else
                                static inline z_u128 z_i128_bits(z_i128 x) { z_u128 r = { x.lo, x.hi }; return r; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_signed"
                            demand: list { "@u128_signed" }
                            needs: list { "@int128_native" "@i128_t" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_i128 z_u128_signed(z_u128 x) { return (z_i128)x; }
                                #else
                                static inline z_i128 z_u128_signed(z_u128 x) { z_i128 r = { x.lo, x.hi }; return r; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "i128_from_i64"
                            demand: list { "@i128_from_i64" }
                            needs: list { "@int128_native" "@i128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_i128 z_i128_from_i64(int64_t v) { return (z_i128)v; }
                                #else
                                static inline z_i128 z_i128_from_i64(int64_t v) {
                                    z_i128 r = { (uint64_t)v, v < 0 ? ~(uint64_t)0 : 0 };
                                    return r;
                                }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "i128_from_u64"
                            demand: list { "@i128_from_u64" }
                            needs: list { "@int128_native" "@i128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_i128 z_i128_from_u64(uint64_t v) { return (z_i128)v; }
                                #else
                                static inline z_i128 z_i128_from_u64(uint64_t v) { z_i128 r = { v, 0 }; return r; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_from_u64"
                            demand: list { "@u128_from_u64" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_from_u64(uint64_t v) { return (z_u128)v; }
                                #else
                                static inline z_u128 z_u128_from_u64(uint64_t v) { z_u128 r = { v, 0 }; return r; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "i128_to_i64"
                            demand: list { "@i128_to_i64" }
                            needs: list { "@int128_native" "@i128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline int64_t z_i128_to_i64(z_i128 x) { return (int64_t)x; }
                                #else
                                static inline int64_t z_i128_to_i64(z_i128 x) { return (int64_t)x.lo; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_to_u64"
                            demand: list { "@u128_to_u64" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline uint64_t z_u128_to_u64(z_u128 x) { return (uint64_t)x; }
                                #else
                                static inline uint64_t z_u128_to_u64(z_u128 x) { return x.lo; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_add"
                            demand: list { "@u128_add" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_add(z_u128 a, z_u128 b) { return a + b; }
                                #else
                                static inline z_u128 z_u128_add(z_u128 a, z_u128 b) {
                                    z_u128 r;
                                    r.lo = a.lo + b.lo;
                                    r.hi = a.hi + b.hi + (r.lo < a.lo);
                                    return r;
                                }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_sub"
                            demand: list { "@u128_sub" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_sub(z_u128 a, z_u128 b) { return a - b; }
                                #else
                                static inline z_u128 z_u128_sub(z_u128 a, z_u128 b) {
                                    z_u128 r;
                                    r.lo = a.lo - b.lo;
                                    r.hi = a.hi - b.hi - (a.lo < b.lo);
                                    return r;
                                }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_mul64"
                            demand: list { "@u128_mul64" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if !defined(Z_INT128_NATIVE)
                                /* the full 128-bit product of two words, in four 32-bit partial products */
                                static inline z_u128 z_u128_mul64(uint64_t a, uint64_t b) {
                                    uint64_t al = a & 0xFFFFFFFFu, ah = a >> 32;
                                    uint64_t bl = b & 0xFFFFFFFFu, bh = b >> 32;
                                    uint64_t ll = al * bl, lh = al * bh, hl = ah * bl, hh = ah * bh;
                                    uint64_t mid = (ll >> 32) + (lh & 0xFFFFFFFFu) + (hl & 0xFFFFFFFFu);
                                    z_u128 r;
                                    r.lo = (mid << 32) | (ll & 0xFFFFFFFFu);
                                    r.hi = hh + (lh >> 32) + (hl >> 32) + (mid >> 32);
                                    return r;
                                }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_mul"
                            demand: list { "@u128_mul" }
                            needs: list { "@u128_mul64?portable128" "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_mul(z_u128 a, z_u128 b) { return a * b; }
                                #else
                                static inline z_u128 z_u128_mul(z_u128 a, z_u128 b) {
                                    z_u128 r = z_u128_mul64(a.lo, b.lo);
                                    r.hi += a.lo * b.hi + a.hi * b.lo;
                                    return r;
                                }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_and"
                            demand: list { "@u128_and" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_and(z_u128 a, z_u128 b) { return a & b; }
                                #else
                                static inline z_u128 z_u128_and(z_u128 a, z_u128 b) { z_u128 r = { a.lo & b.lo, a.hi & b.hi }; return r; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_or"
                            demand: list { "@u128_or" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_or(z_u128 a, z_u128 b) { return a | b; }
                                #else
                                static inline z_u128 z_u128_or(z_u128 a, z_u128 b) { z_u128 r = { a.lo | b.lo, a.hi | b.hi }; return r; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_xor"
                            demand: list { "@u128_xor" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_xor(z_u128 a, z_u128 b) { return a ^ b; }
                                #else
                                static inline z_u128 z_u128_xor(z_u128 a, z_u128 b) { z_u128 r = { a.lo ^ b.lo, a.hi ^ b.hi }; return r; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_not"
                            demand: list { "@u128_not" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_not(z_u128 a) { return ~a; }
                                #else
                                static inline z_u128 z_u128_not(z_u128 a) { z_u128 r = { ~a.lo, ~a.hi }; return r; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_shl"
                            demand: list { "@u128_shl" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_shl(z_u128 a, unsigned n) { return a << n; }
                                #else
                                /* n < 128, as C's shift requires of the native type */
                                static inline z_u128 z_u128_shl(z_u128 a, unsigned n) {
                                    z_u128 r;
                                    if (n == 0) return a;
                                    if (n >= 64) { r.hi = a.lo << (n - 64); r.lo = 0; return r; }
                                    r.hi = (a.hi << n) | (a.lo >> (64 - n));
                                    r.lo = a.lo << n;
                                    return r;
                                }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_shr"
                            demand: list { "@u128_shr" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_shr(z_u128 a, unsigned n) { return a >> n; }
                                #else
                                static inline z_u128 z_u128_shr(z_u128 a, unsigned n) {
                                    z_u128 r;
                                    if (n == 0) return a;
                                    if (n >= 64) { r.lo = a.hi >> (n - 64); r.hi = 0; return r; }
                                    r.lo = (a.lo >> n) | (a.hi << (64 - n));
                                    r.hi = a.hi >> n;
                                    return r;
                                }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_eq"
                            demand: list { "@u128_eq" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline bool z_u128_eq(z_u128 a, z_u128 b) { return a == b; }
                                #else
                                static inline bool z_u128_eq(z_u128 a, z_u128 b) { return a.lo == b.lo && a.hi == b.hi; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_lt"
                            demand: list { "@u128_lt" }
                            needs: list { "@int128_native" "@u128_t" }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline bool z_u128_lt(z_u128 a, z_u128 b) { return a < b; }
                                #else
                                static inline bool z_u128_lt(z_u128 a, z_u128 b) { return a.hi < b.hi || (a.hi == b.hi && a.lo < b.lo); }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_clz"
                            demand: list { "@u128_clz" }
                            needs: list { "@int128_native" "@u128_t" "@clz64?portable128" }
                            text: """
                                #if !defined(Z_INT128_NATIVE)
                                static inline int z_u128_clz(z_u128 a) {
                                    if (a.hi) return z_clz64(a.hi);
                                    if (a.lo) return 64 + z_clz64(a.lo);
                                    return 128;
                                }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_divmod"
                            demand: list { "@u128_divmod" }
                            needs: list {
                                "@u128_clz?portable128" "@u128_lt?portable128"
                                "@u128_shl?portable128" "@u128_shr?portable128"
                                "@u128_sub?portable128" "@int128_native" "@u128_t"
                                "@panic?portable128"
                            }
                            text: """
                                #if !defined(Z_INT128_NATIVE)
                                /* a / b and a % b by binary long division: b is aligned under a's top bit
                                   and subtracted back down, one quotient bit per step. A zero divisor
                                   panics, where the native type traps. */
                                static z_u128 z_u128_divmod(z_u128 a, z_u128 b, z_u128* rem) {
                                    z_u128 q = { 0, 0 };
                                    if (b.lo == 0 && b.hi == 0) z_panic("division by zero");
                                    if (z_u128_lt(a, b)) { *rem = a; return q; }
                                    int shift = z_u128_clz(b) - z_u128_clz(a);
                                    b = z_u128_shl(b, (unsigned)shift);
                                    for (int i = 0; i <= shift; i++) {
                                        q = z_u128_shl(q, 1);
                                        if (!z_u128_lt(a, b)) { a = z_u128_sub(a, b); q.lo |= 1; }
                                        b = z_u128_shr(b, 1);
                                    }
                                    *rem = a;
                                    return q;
                                }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_div"
                            demand: list { "@u128_div" }
                            needs: list {
                                "@u128_divmod?portable128" "@int128_native" "@u128_t"
                                "@panic?native128"
                            }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_div(z_u128 a, z_u128 b) {
                                    if (b == 0) z_panic("division by zero");
                                    return a / b;
                                }
                                #else
                                static inline z_u128 z_u128_div(z_u128 a, z_u128 b) { z_u128 r; return z_u128_divmod(a, b, &r); }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "u128_rem"
                            demand: list { "@u128_rem" }
                            needs: list {
                                "@u128_divmod?portable128" "@int128_native" "@u128_t"
                                "@panic?native128"
                            }
                            text: """
                                #if defined(Z_INT128_NATIVE)
                                static inline z_u128 z_u128_rem(z_u128 a, z_u128 b) {
                                    if (b == 0) z_panic("division by zero");
                                    return a % b;
                                }
                                #else
                                static inline z_u128 z_u128_rem(z_u128 a, z_u128 b) { z_u128 r; z_u128_divmod(a, b, &r); return r; }
                                #endif
                                """
                        )
                        (
                            c.piece
                            name: "i128_neg"
                            demand: list { "@i128_neg" }
                            needs: list { "@int128_native" "@i128_t" }
                            text: """
                                #if !defined(Z_INT128_NATIVE)
