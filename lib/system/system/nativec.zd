                (
                    c.piece
                    name: "StringView_eq"
                    demand: list { "@StringView_eq" }
                    needs: list { "@StringView_t" }
                    text: """
                        static bool z_@StringView@_eq(z_@StringView@_t a, z_@StringView@_t b) {
                            return a.size == b.size && memcmp(a.data, b.data, a.size) == 0;
