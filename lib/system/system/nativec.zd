    }
    structural: list {
        # -- synthesised structural equality ------------------------------------
        # A record or a variant that declares no `==` gets one, and its `!=` with it.
        # A record whose typedef chain bottoms out at a scalar compares inline instead
        # of through a helper, so it is its own shape.
        (c.row key: "record.==" callsEquals: true body: "z_@T@_eq(@L@, @R@)")
        (c.row key: "record.!=" callsEquals: true body: "!z_@T@_eq(@L@, @R@)")
        (c.row key: "variant.==" callsEquals: true body: "z_@T@_eq(@L@, @R@)")
        (c.row key: "variant.!=" callsEquals: true body: "!z_@T@_eq(@L@, @R@)")
        (c.row key: "scalar.==" form: c.form.value body: "(@L@ == @R@)")
        (c.row key: "scalar.!=" form: c.form.value body: "(@L@ != @R@)")
    }
