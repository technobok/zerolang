                                static int z_win_unsetenv(const char* k, size_t kn) {
                                    wchar_t* wk = z_win_wide(k, kn);
                                    if (wk == NULL) return -1;
                                    BOOL ok = kn > 0 && SetEnvironmentVariableW(wk, NULL);
