                )
                # a channel's block, which its typed ends share; a row naming
                # `needs=prelude.zchan` demands it, after the shim it locks with. Each of its
                # functions is a piece the template section calling it names
                (
                    c.row
                    key: "@zchan"
                    needs: list { "prelude.zthread" }
                    pieces: list {
                        (
                            c.piece
                            name: "chan"
                            demand: list { "@chan" }
                            needs: list { "@cond_t" "@mutex_t" }
                            text: """
                                /* the block a channel's two ends share (sync.z Receiver / Sender): its values,
                                   each `elemSize` bytes, in a ring under one lock, with how many Senders live
                                   and whether the Receiver does. The typed ends are thin wrappers that pass
                                   a value by address. `cap` 0 is no limit: the ring grows when full. Of the
                                   Receiver and the last Sender, whichever goes second frees the block. */
                                typedef struct z_chan {
                                    z_mutex_t m;
                                    z_cond_t notEmpty;
                                    z_cond_t notFull;
                                    unsigned char* ring;
                                    size_t elemSize;
                                    void (*destroyElem)(void*);
                                    uint64_t cap;
                                    uint64_t size;
                                    uint64_t head;
                                    uint64_t len;
                                    uint64_t senders;
                                    bool receiverAlive;
                                } z_chan;
                                """
                        )
                        (c.piece text: "")
                        (
                            c.piece
                            name: "chan_new"
                            demand: list { "@chan_new" }
                            needs: list { "@chan" "@cond_init" "@mutex_init" "@panic" "@xmalloc" }
                            text: """
                                static z_chan* z_chan_new(size_t elemSize, void (*destroyElem)(void*), uint64_t capacity) {
                                    z_chan* b = (z_chan*)z_xmalloc(sizeof(z_chan));
                                    if (z_mutex_init(&b->m) != 0 || z_cond_init(&b->notEmpty) != 0 || z_cond_init(&b->notFull) != 0) {
                                        z_panic("sync.Receiver: the operating system could not make a lock");
                                    }
                                    b->elemSize = elemSize;
                                    b->destroyElem = destroyElem;
                                    b->cap = capacity;
                                    b->size = capacity != 0 ? capacity : 16;
                                    b->ring = (unsigned char*)z_xmalloc(elemSize * b->size);
                                    b->head = 0;
                                    b->len = 0;
                                    b->senders = 0;
                                    b->receiverAlive = true;
                                    return b;
                                }
                                """
                        )
                        (c.piece text: "")
                        (
                            c.piece
                            name: "chan_free"
                            demand: list { "@chan_free" }
                            needs: list { "@chan" "@cond_destroy" "@mutex_destroy" }
                            text: """
                                /* the block, once neither end holds it; the lock is not held */
                                static void z_chan_free(z_chan* b) {
                                    free(b->ring);
                                    z_cond_destroy(&b->notFull);
                                    z_cond_destroy(&b->notEmpty);
                                    z_mutex_destroy(&b->m);
                                    free(b);
                                }
                                """
                        )
                        (c.piece text: "")
                        (
                            c.piece
                            name: "chan_grow"
                            demand: list { "@chan_grow" }
                            needs: list { "@chan" "@xmalloc" }
                            text: """
                                /* the ring, twice as large, its values in order from the start; the lock is
                                   held */
                                static void z_chan_grow(z_chan* b) {
                                    uint64_t n = b->size * 2;
                                    unsigned char* r = (unsigned char*)z_xmalloc(b->elemSize * n);
                                    for (uint64_t i = 0; i < b->len; i++) {
                                        memcpy(r + i * b->elemSize, b->ring + ((b->head + i) % b->size) * b->elemSize, b->elemSize);
                                    }
                                    free(b->ring);
                                    b->ring = r;
                                    b->size = n;
                                    b->head = 0;
                                }
                                """
                        )
                        (c.piece text: "")
                        (
                            c.piece
                            name: "chan_add_sender"
                            demand: list { "@chan_add_sender" }
                            needs: list { "@chan" "@mutex_lock" "@mutex_unlock" }
                            text: """
                                static void z_chan_add_sender(z_chan* b) {
                                    z_mutex_lock(&b->m);
                                    b->senders++;
                                    z_mutex_unlock(&b->m);
                                }
                                """
                        )
                        (c.piece text: "")
                        (
                            c.piece
                            name: "chan_drop_sender"
                            demand: list { "@chan_drop_sender" }
                            needs: list {
                                "@chan" "@chan_free" "@cond_broadcast" "@mutex_lock" "@mutex_unlock"
                            }
                            text: """
                                /* a Sender ends: the last one wakes a receiver waiting for a value that can
                                   no longer come */
                                static void z_chan_drop_sender(z_chan* b) {
                                    z_mutex_lock(&b->m);
                                    b->senders--;
                                    bool last = b->senders == 0;
                                    bool gone = last && !b->receiverAlive;
                                    if (last) z_cond_broadcast(&b->notEmpty);
                                    z_mutex_unlock(&b->m);
                                    if (gone) z_chan_free(b);
                                }
                                """
                        )
                        (c.piece text: "")
                        (
                            c.piece
                            name: "chan_drop_receiver"
                            demand: list { "@chan_drop_receiver" }
                            needs: list {
                                "@chan" "@chan_free" "@cond_broadcast" "@mutex_lock" "@mutex_unlock"
                            }
                            text: """
                                /* the Receiver ends: what it never took is destroyed, and a sender waiting for
                                   room is woken to learn nothing will read it */
                                static void z_chan_drop_receiver(z_chan* b) {
                                    z_mutex_lock(&b->m);
                                    for (uint64_t i = 0; i < b->len; i++) b->destroyElem(b->ring + ((b->head + i) % b->size) * b->elemSize);
                                    b->len = 0;
                                    b->receiverAlive = false;
                                    bool gone = b->senders == 0;
                                    z_cond_broadcast(&b->notFull);
                                    z_mutex_unlock(&b->m);
                                    if (gone) z_chan_free(b);
                                }
                                """
                        )
                        (c.piece text: "")
                        (
                            c.piece
                            name: "chan_send"
                            demand: list { "@chan_send" }
                            needs: list {
                                "@chan" "@chan_grow" "@cond_signal" "@cond_wait" "@mutex_lock"
                                "@mutex_unlock"
                            }
                            text: """
                                /* move the value at `value` in, waiting while the ring is full; false, the
                                   value destroyed here, once the Receiver is gone */
                                static bool z_chan_send(z_chan* b, void* value) {
                                    z_mutex_lock(&b->m);
                                    while (b->receiverAlive && b->cap != 0 && b->len == b->cap) z_cond_wait(&b->notFull, &b->m);
                                    if (!b->receiverAlive) {
                                        z_mutex_unlock(&b->m);
                                        b->destroyElem(value);
                                        return false;
                                    }
                                    if (b->len == b->size) z_chan_grow(b);
                                    memcpy(b->ring + ((b->head + b->len) % b->size) * b->elemSize, value, b->elemSize);
                                    b->len++;
                                    z_cond_signal(&b->notEmpty);
                                    z_mutex_unlock(&b->m);
                                    return true;
                                }
                                """
                        )
                        (c.piece text: "")
                        (
                            c.piece
                            name: "chan_receive"
                            demand: list { "@chan_receive" }
                            needs: list {
                                "@chan" "@cond_signal" "@cond_wait" "@mutex_lock" "@mutex_unlock"
                            }
                            text: """
                                /* the oldest value, moved to `out`: true when there was one. `wait` waits for
                                   one while a Sender lives; without it an empty ring answers false at once */
                                static bool z_chan_receive(z_chan* b, void* out, bool wait) {
                                    z_mutex_lock(&b->m);
                                    while (wait && b->len == 0 && b->senders > 0) z_cond_wait(&b->notEmpty, &b->m);
                                    if (b->len == 0) {
                                        z_mutex_unlock(&b->m);
                                        return false;
                                    }
                                    memcpy(out, b->ring + b->head * b->elemSize, b->elemSize);
                                    b->head = (b->head + 1) % b->size;
                                    b->len--;
                                    z_cond_signal(&b->notFull);
                                    z_mutex_unlock(&b->m);
                                    return true;
                                }
                                """
                        )
                    }
                )
            }
        )
        (
            c.group
            name: "sviter"
            rows: list {
                # @sviter -- the split / lines iterator types. They are StringView natives, but
                # they DECLARE types the collections join and the rest of system go on to spell,
                # so they load ahead of both and carry a unit of their own. Their six fragments
                # interleave: the shared state struct, then each type's typedef of it, then
                # split's pair, then lines'.
                (
                    c.row
                    key: "@splitter_struct"
                    demand: list { "sv_split" "sv_lines" }
                    fragments: list {
                        """
                        /* Splitter / linesiter state. Classes are declared `is native`
                           with no user fields; the runtime supplies the real layout,
                           stack-allocated value type (48 bytes). Both iterators share
                           the same struct — linesiter leaves sep NULL — under a name of
                           its own, so either type can be the only one a program uses. */
                        typedef struct {
                            const char* src;
                            uint64_t    src_len;
                            const char* sep;
                            uint64_t    sep_len;
                            uint64_t    cursor;
                            bool        done;
                        } z_sv_iter_t;

                        """
                    }
                )
                (
                    c.row
                    key: "@splitter"
                    demand: list { "sv_split" }
                    fragments: list {
                        """
                        typedef z_sv_iter_t z_@Splitter@_t;

                        """
                    }
                )
                (
                    c.row
                    key: "@linesiter"
                    demand: list { "sv_lines" }
                    fragments: list {
                        """
                        typedef z_sv_iter_t z_@LinesIter@_t;


                        """
                    }
                )
                (
                    c.row
                    key: "@split"
                    demand: list { "sv_split" }
                    needs: list { "prelude.@xmalloc" }
                    fragments: list {
                        """
                        static z_@Splitter@_t z_@StringView@_split(
                            const z_@StringView@_t* self, const z_@StringView@_t* sep);
                        static z_@Splitter@_t z_@StringView@_split(
                            const z_@StringView@_t* self, const z_@StringView@_t* sep) {
                            z_@Splitter@_t s;
                            s.src = self->data;
                            s.src_len = self->size;
                            s.sep = sep->data;
                            s.sep_len = sep->size;
                            s.cursor = 0;
                            s.done = (sep->size == 0);
                            return s;
                        }


                        """
                        """
                        static z_@Option_StringView@_t z_@Splitter@_call(z_@Splitter@_t* s);
                        static z_@Option_StringView@_t z_@Splitter@_call(z_@Splitter@_t* s) {
                            z_@Option_StringView@_t out = {0};
                            if (s->done) {
                                out.tag = @ARM_Option_StringView.none@;
                                return out;
                            }
                            const char* start = s->src + s->cursor;
                            uint64_t remaining = s->src_len - s->cursor;
                            if (s->sep_len > remaining) {
                                /* no more separators possible — return the tail */
                                z_@StringView@_t* boxed = (z_@StringView@_t*)z_xmalloc(sizeof(z_@StringView@_t));
                                boxed->data = start;
                                boxed->size = remaining;
                                s->cursor = s->src_len;
                                s->done = true;
                                out.tag = @ARM_Option_StringView.some@;
                                out.data = boxed;
                                return out;
                            }
                            uint64_t scan_end = remaining - s->sep_len;
                            for (uint64_t i = 0; i <= scan_end; i++) {
                                if (memcmp(start + i, s->sep, s->sep_len) == 0) {
                                    z_@StringView@_t* boxed = (z_@StringView@_t*)z_xmalloc(sizeof(z_@StringView@_t));
                                    boxed->data = start;
                                    boxed->size = i;
                                    s->cursor += i + s->sep_len;
                                    out.tag = @ARM_Option_StringView.some@;
                                    out.data = boxed;
                                    return out;
                                }
                            }
                            /* no separator in remaining — final fragment */
                            z_@StringView@_t* boxed = (z_@StringView@_t*)z_xmalloc(sizeof(z_@StringView@_t));
                            boxed->data = start;
                            boxed->size = remaining;
                            s->cursor = s->src_len;
                            s->done = true;
                            out.tag = @ARM_Option_StringView.some@;
                            out.data = boxed;
                            return out;
                        }


                        """
                    }
                )
                (
                    c.row
                    key: "@lines"
                    demand: list { "sv_lines" }
                    needs: list { "prelude.@xmalloc" }
                    fragments: list {
                        """
                        static z_@LinesIter@_t z_@StringView@_lines(const z_@StringView@_t* self);
                        static z_@LinesIter@_t z_@StringView@_lines(const z_@StringView@_t* self) {
                            z_@LinesIter@_t s;
                            s.src = self->data;
                            s.src_len = self->size;
                            s.sep = NULL;
                            s.sep_len = 0;
                            s.cursor = 0;
                            s.done = (self->size == 0);
                            return s;
                        }


                        """
                        """
                        static z_@Option_StringView@_t z_@LinesIter@_call(z_@LinesIter@_t* s);
                        static z_@Option_StringView@_t z_@LinesIter@_call(z_@LinesIter@_t* s) {
                            z_@Option_StringView@_t out = {0};
                            if (s->done) {
                                out.tag = @ARM_Option_StringView.none@;
                                return out;
                            }
                            const char* start = s->src + s->cursor;
                            uint64_t remaining = s->src_len - s->cursor;
                            uint64_t i = 0;
                            while (i < remaining && start[i] != '\n') i++;
                            uint64_t line_len = i;
                            if (line_len > 0 && start[line_len - 1] == '\r') line_len--;
                            z_@StringView@_t* boxed = (z_@StringView@_t*)z_xmalloc(sizeof(z_@StringView@_t));
                            boxed->data = start;
                            boxed->size = line_len;
                            if (i == remaining) {
                                s->cursor = s->src_len;
                                s->done = true;
                            } else {
                                s->cursor += i + 1;
                                if (s->cursor >= s->src_len) s->done = true;
                            }
                            out.tag = @ARM_Option_StringView.some@;
                            out.data = boxed;
                            return out;
                        }


                        """
                    }
                )
            }
        )
    }
    conditions: list {
