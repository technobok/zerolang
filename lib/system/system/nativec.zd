                    text: """
                        static z_@String@_t z_@String@_from_view(z_@StringView@_t sv) {
                            z_@String@_t z = {0};
                            z.size = sv.size;
                            z.capacity = sv.size;
                            /* an empty view needs no buffer: the zero struct IS an empty String -- the
