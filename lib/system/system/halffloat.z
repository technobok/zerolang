# halffloat -- IEEE-754 half precision, an implementation subunit of system.
# A type is only as portable as the compilers that can build it, and a unit
# is what a require: block attaches to.

# tcc has no _Float16. How it fails depends on the host, and one way is worse
# than the other: on Linux it rejects the emitted C outright, but its own
# headers define `_Float16` as `short unsigned int` on macOS -- "a fake type
# just for size & alignment" -- so there the program would COMPILE and quietly
# compute the wrong answers. Saying so here refuses the build in both cases,
# at the point the toolchain is chosen.
#
# gcc and clang need no library for _Float16, so the other arm names none.
require: unit {
    library: if platform.cc == platform.cckind.tcc then {
        error "tcc has no _Float16; build this with gcc or clang"
    } else {
        ""
    }
}

# IEEE-754 half-precision (16-bit) floating point.
f16: record is native as {
    # f16 addition, rounded once to the nearest representable value
    +: function {:this rhs: type} out type is native
    # f16 subtraction, rounded once; cancelling two near-equal f16 values loses
    # precision here
    -: function {:this rhs: type} out type is native
    # f16 multiplication, rounded once to nearest
    *: function {:this rhs: type} out type is native
    # f16 division; unlike the integer types a zero divisor gives an infinity
    # rather than trapping
    /: function {:this rhs: type} out type is native
    # the f16 remainder of a truncating division, keeping the left operand's
    # sign
    %: function {:this rhs: type} out type is native
    # the f16 ordering admitting equality -- still false against a NaN
    <=: function {:this rhs: type} out bool is native
    # orders two f16 values; every comparison against a NaN is false, this one
    # included
    <: function {:this rhs: type} out bool is native
    # the f16 ordering reversed; false against a NaN
    >: function {:this rhs: type} out bool is native
    # the reversed f16 ordering admitting equality; false against a NaN
    >=: function {:this rhs: type} out bool is native
    # true when both are the same f16. A NaN equals NOTHING, itself included
    ==: function {:this rhs: type} out bool is native
    # true when the two f16 values differ -- and true when either is a NaN
    !=: function {:this rhs: type} out bool is native
    # f16 to u8: fails on a fraction, and outside what u8 can hold
    u8: function {:this} out (resultval t: u8 e: converror) is native
    # f16 to i8: fails on a fraction, and outside what i8 can hold
    i8: function {:this} out (resultval t: i8 e: converror) is native
    # f16 to i16: fails on a fraction, and outside what i16 can hold
    i16: function {:this} out (resultval t: i16 e: converror) is native
    # f16 to i32: fails on a fraction, and outside what i32 can hold
    i32: function {:this} out (resultval t: i32 e: converror) is native
    # f16 to i64: fails on a fraction, and outside what i64 can hold
    i64: function {:this} out (resultval t: i64 e: converror) is native
    # f16 to i128: fails on a fraction, and outside what i128 can hold
    i128: function {:this} out (resultval t: i128 e: converror) is native
    # f16 to u16: fails on a fraction, and outside what u16 can hold
    u16: function {:this} out (resultval t: u16 e: converror) is native
    # f16 to u32: fails on a fraction, and outside what u32 can hold
    u32: function {:this} out (resultval t: u32 e: converror) is native
    # f16 to u64: fails on a fraction, and outside what u64 can hold
    u64: function {:this} out (resultval t: u64 e: converror) is native
    # f16 to u128: fails on a fraction, and outside what u128 can hold
    u128: function {:this} out (resultval t: u128 e: converror) is native
    # f16 to f32: every f16 is exactly representable in f32, so there is nothing
    # to unwrap
    f32: function {:this} out f32 is native
    # f16 to f64: every f16 is exactly representable in f64, so there is nothing
    # to unwrap
    f64: function {:this} out f64 is native
    # f16 to f128: every f16 is exactly representable in f128, so there is
    # nothing to unwrap
    f128: function {:this} out f128 is native
    # f16 to c8: fails on a fraction, and outside what c8 can hold
    c8: function {:this} out (resultval t: c8 e: converror) is native
    # f16 to c32: fails on a fraction, and outside what c32 can hold
    c32: function {:this} out (resultval t: c32 e: converror) is native
    # the f16 bit pattern as an unsigned integer of the same width, sign and
    # exponent included
    bits: function {:this} out u16 is native
    # x scaled by a power of two, exactly: IEEE 754's scaleB, C99's scalbn. It
    # is not a multiplication -- the exponent moves and the significand does
    # not, so no rounding happens anywhere in the type's range.
    scaleB: function {:this n: i32} out type is native
    # the UNBIASED exponent of x: IEEE 754's logB, C99's ilogb. Subnormals are
    # normalised first, so this is the binade whatever the encoding.
    logB: function {:this} out i32 is native
    # the f16 identity conversion, so a width can be named uniformly even when
    # it does not change
    f16: function {:this} out type is native
    # the zero f16, positive
    create: function {} out type is native
    tag: tag
}
