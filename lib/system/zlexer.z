# Lexer for the zerolang language. Splits a source file into a
# stream of tokens (toktype) consumed by the parser. The Tokenizer
# scans bytes, tracks line and column, manages a state stack for
# nested string interpolation, and emits one token per call to
# `token`. The binary built from this file is a token-dump CLI:
# given a source file it prints `<lineno>:<colno> <toktype> "<text>"`
# per token, exercised by tests/fixtures/lexer_golden/.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :ascii
    :Lexer
    :toktype
    :token
    :tokpos
    :Tokenizer
    :islookupReserved
    :kwlookup
}

# ASCII byte constants used by the scanner. Control bytes keep their
# two/three-letter mnemonics (nul/bs/ht/lf/cr/del); other names are
# full words.
ascii: data {
    nul: 0
    bs: 8
    ht: 9
    lf: 10
    cr: 13
    space: 32
    doubleQuote: 34
    hash: 35
    parenOpen: 40
    parenClose: 41
    plus: 43
    comma: 44
    minus: 45
    dot: 46
    zero: 48
    nine: 57
    colon: 58
    semicolon: 59
    upperA: 65
    upperF: 70
    bracketOpen: 91
    backslash: 92
    bracketClose: 93
    backtick: 96
    lowerA: 97
    lowerB: 98
    lowerF: 102
    lowerN: 110
    lowerR: 114
    lowerT: 116
    lowerU: 117
    lowerX: 120
    braceOpen: 123
    braceClose: 125
    del: 127
} out u8

# token type, used by Tokenizer + Lexer to classify each emitted
# token. Uppercase member names to prevent collision with the
# language keywords most arm names share.
toktype: variant {
    # beginning of file: a synthetic token, so a lookbehind always has a left
    # neighbour
    bofTok: null
    # end of file, also synthetic, so a walk terminates on a token rather than
    # on an index
    eofTok: null
    # the bytes here made no token at all; it carries what was seen so the
    # parser can report it
    errTok: null
    # a run of spaces or tabs, kept rather than dropped because the formatter
    # reads them
    wsTok: null
    # end of line, which is a STATEMENT boundary here and not mere whitespace
    eolTok: null
    # a `#` comment through to the line end, kept because the doc tooling reads
    # it
    commentTok: null
    # `:`, which binds a name to what follows it
    colonTok: null
    # `;`, which ends a statement where a newline would otherwise be needed
    semicolonTok: null
    # `(`, which overrides the EOL statement boundary
    parenOpenTok: null
    # `)`, closing the parentheses that suspended the EOL boundary
    parenCloseTok: null
    # `{`, opening a block or a parameter list
    braceOpenTok: null
    # `}`, closing a block. A continuation keyword must follow it on the SAME
    # line, which is why the lexer's EOL filtering matters here
    braceCloseTok: null
    # `.`, the path separator and the suffix marker both
    dotTok: null
    # an identifier
    refIdTok: null
    # an identifier followed by `:` -- a label, which is how every argument and
    # field is named
    labelTok: null
    # the `:name` shorthand, where the label and its value are the same word
    labelPreTok: null
    # `=`, which REASSIGNS -- a binding is spelled with `:` instead
    equalsTok: null
    # the `function` keyword
    functionTok: null
    # the `if` keyword
    ifTok: null
    # the `when` keyword
    whenTok: null
    # the `then` keyword
    thenTok: null
    # the `else` keyword
    elseTok: null
    # the `for` keyword
    forTok: null
    # the `loop` keyword
    loopTok: null
    # the `while` keyword
    whileTok: null
    # the `do` keyword
    doTok: null
    # the `case` keyword
    caseTok: null
    # the `match` keyword
    matchTok: null
    # the `on` keyword
    onTok: null
    # the `out` keyword
    outTok: null
    # the `outx` keyword
    outxTok: null
    # the `in` keyword
    inTok: null
    # the `swap` keyword
    swapTok: null
    # the `unit` keyword
    unitTok: null
    # the `record` keyword
    recordTok: null
    # the `class` keyword
    classTok: null
    # the `union` keyword
    unionTok: null
    # the `variant` keyword
    variantTok: null
    # the `protocol` keyword
    protocolTok: null
    # the `data` keyword
    dataTok: null
    # the `is` keyword
    isTok: null
    # the `as` keyword
    asTok: null
    # the `with` keyword
    withTok: null
    # the `facet` keyword
    facetTok: null
    # the `generator` keyword
    generatorTok: null
    # the `native` keyword
    nativeTok: null
    # the opening quote of a string literal
    strBegTok: null
    # literal bytes inside a string, between the quote and any interpolation
    strMidTok: null
    # one decoded character inside a string, which is how an escape arrives
    strChrTok: null
    # the closing quote of a string literal
    strEndTok: null
    # the `\{` that opens an interpolation, after which the lexer is reading
    # CODE rather than text
    strExprBegTok: null
} as { tag: u8.tag }

# Tokenizer mode stack arms.
# "Implicit FILE state when the stack is empty" -- statecurrent
# returns FILE for an empty stack so Tokenizer.create can skip an
# init push.  STRINGRAW carries the opening delim length as its u8
# payload so the inner scanner can match the closer.
tokstatetype: variant {
    # lexing ordinary source
    file: null
    # inside a string literal, reading text
    string: null
    # inside an interpolation, reading code
    stringexpr: null
    # inside a brace nested within an interpolation, so the closing one does not
    # end the interpolation early
    stringexprbrace: null
    # inside a raw string, where escapes are not decoded; the byte is the
    # delimiter being matched
    stringraw: u8
} as { tag: u8.tag }

# spanWidth -- a token's byte width from its source span. The one place the
# offset arithmetic narrows to what a diagnostic underlines, so the narrowing
# is written once rather than at every construction site.
spanWidth: function {s: u64 e: u64} out u32 is {
    return (e - s).u32.orPanic
}

# escapeErrText -- the escape as it was WRITTEN: the backslash, the specifier
# and however many digits were read. An ERR token for a bad escape carries the
# source form, not the value it failed to become.
escapeErrText: function {specifier: u8 digits: String.view} out String is {
    err: String
    err.appendByte ascii.backslash
    err.appendByte specifier
    dsv: digits.stringView
    j: u64
    dlen: dsv.length
    for j < dlen loop {
        err.appendByte ((dsv.byteAt j).or d: 0.u8)
        j = j + 1
    }
    return err
}

# textWidth -- a built token's byte width. A token whose text is accumulated
# rather than sliced out of the source still owes its callers a width.
textWidth: function {s: String} out u32 is {
    return s.length.u32.orPanic
}

# one lexer token: its kind, interned text, and file/line/column position. A
# RECORD: every field is a value now that the text is a pool id, so a token
# travels by copy and an optional one needs no box.
token: record {
    # which kind of token this is
    toktype: toktype
    # its text, interned in the name pool. An id rather than an owned copy:
    # a token's spelling is nearly always one the pool already holds, and the
    # ones that are not are the names the parser was going to intern anyway.
    # Zero reads as the pool's sentinel row, which is the empty text
    text: zast.nameid
    # the file it came from
    fsno: zvfs.fsno
    # the line it starts on
    lineno: u32
    # the column it starts at
    colno: u32
    # how many source bytes it spans. A diagnostic needs the width and nothing
    # else from the text, so it is carried rather than derived: a token whose
    # text is a constant of its type, or an id into the name pool, still owes
    # its callers a width
    width: u32
}

# Where a token is and how wide it is, without its text. A valtype, so a
# reader that needs only the span pays no allocation -- `width` is the token
# text's byte count, which is all a diagnostic needs from the text.
tokpos: record {
    # the file the span is in
    fsno: zvfs.fsno
    # the line it starts on
    lineno: u32
    # the column it starts at
    colno: u32
    # how many columns to underline, which is the token text's byte count
    width: u32
}

# kwlookup result: a token type plus a "found" flag. Returned by
# `kwlookup` instead of routing through a `toktype` sentinel arm.
kwresult: record { found: bool tt: toktype }

# Byte-class predicates used by the scanner dispatch.
isws: function {b: u8} out bool is {
    return (b == ascii.space) or (b == ascii.ht)
}

# true when byte `b` may appear in a comment body (anything but CR/LF/NUL).
iscommentbody: function {b: u8} out bool is {
    return (b != ascii.nul) and (b != ascii.lf) and (b != ascii.cr)
}

# Bitmask flags for the 128-element charflags table below. Each
# byte 0..127 maps to a u8 mask whose bits identify the character
# classes the byte belongs to. The scanner predicates lower to a
# single table lookup + mask test.
charflag: data {
    identifier: 0b0001       # identifier char (letters, digits, operators, excludes delimiters)
    digit: 0b0010            # ASCII digit 0-9
    stringBody: 0b0100       # legal in an interpreted-string body (not NUL, ", LF, CR, \\)
    rawStringBody: 0b1000    # legal in a raw-string body (not NUL, ", LF, CR)
} out u8

charflags: data {
    0b0000 0b1100 0b1100 0b1100 0b1100 0b1100 0b1100 0b1100   #   0..  7
    0b1100 0b1100 0b0000 0b1100 0b1100 0b0000 0b1100 0b1100   #   8.. 15  (lf / cr drop stringBody and rawStringBody)
    0b1100 0b1100 0b1100 0b1100 0b1100 0b1100 0b1100 0b1100   #  16.. 23
    0b1100 0b1100 0b1100 0b1100 0b1100 0b1100 0b1100 0b1100   #  24.. 31
    0b1100 0b1101 0b0000 0b1100 0b1101 0b1101 0b1101 0b1101   #  32.. 39  (space=stringBody|rawStringBody, ! identifier, " all-off, # not identifier)
    0b1100 0b1100 0b1101 0b1101 0b1100 0b1101 0b1100 0b1101   #  40.. 47  (parens/comma/dot drop identifier; * + - / keep it)
    0b1111 0b1111 0b1111 0b1111 0b1111 0b1111 0b1111 0b1111   #  48.. 55  digits: identifier | digit | stringBody | rawStringBody
    0b1111 0b1111 0b1100 0b1100 0b1101 0b1101 0b1101 0b1101   #  56.. 63  digits + ; : (drop identifier), < = > ?
    0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101   #  64.. 71  @ A..G
    0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101   #  72.. 79  H..O
    0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101   #  80.. 87  P..W
    0b1101 0b1101 0b1101 0b1100 0b1001 0b1100 0b1101 0b1101   #  88.. 95  X Y Z [ \\ ] ^ _   (\\ drops stringBody)
    0b1100 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101   #  96..103  ` a..g  (` drops identifier)
    0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101   # 104..111
    0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101 0b1101   # 112..119
    0b1101 0b1101 0b1101 0b1100 0b1101 0b1100 0b1101 0b1100   # 120..127  x y z { | } ~ del
} out u8

# true when byte `b` is legal inside an identifier.
isidchar: function {b: u8} out bool is {
    if b > 127 then return false
    idx: b.u64
    return (charflags.index idx) & charflag.identifier != 0
}

# true when byte `b` is an ASCII digit 0-9.
isdigit: function {b: u8} out bool is {
    if b > 127 then return false
    idx: b.u64
    return (charflags.index idx) & charflag.digit != 0
}

# true when byte `b` is legal in an interpreted-string body.
isstrc: function {b: u8} out bool is {
    if b > 127 then return true
    idx: b.u64
    return (charflags.index idx) & charflag.stringBody != 0
}

# true when byte `b` is legal in a raw-string body.
israwc: function {b: u8} out bool is {
    if b > 127 then return true
    idx: b.u64
    return (charflags.index idx) & charflag.rawStringBody != 0
}

# Append every byte of `delim_view` to `stringparts`. Used by the
# raw-string scanner when a short `"` run was consumed into the
# delim accumulator and must be treated as literal content.
extendraw: function {stringparts: String delim_view: StringView} is {
    j: u64
    dlen: delim_view.length
    for j < dlen loop {
        b: delim_view.byteAt j
        match (
            b
        ) case some then {
            stringparts.appendByte b
        } case none then {
            j = dlen
        }
        j = j + 1
    }
}

# true when byte `b` is a hex digit (0-9, a-f, A-F).
ishexdigit: function {b: u8} out bool is {
    return (
        ((b >= ascii.zero) and (b <= ascii.nine)) or
        ((b >= ascii.upperA) and (b <= ascii.upperF)) or
        ((b >= ascii.lowerA) and (b <= ascii.lowerF))
    )
}

# Decode a single hex digit byte into its numeric value (0-15).
# Caller must have already checked `ishexdigit`.
hexvalue: function {b: u8} out u8 is {
    if b <= ascii.nine then return b - ascii.zero
    if b <= ascii.upperF then return b - ascii.upperA + 10
    return b - ascii.lowerA + 10
}

# Encode a Unicode codepoint as 1-4 UTF-8 bytes appended to `dst`.
# Caller is responsible for ensuring cp <= 0x10FFFF -- the \uHHHHHH
# decoder rejects out-of-range values before invoking this helper.
utf8_encode_append: function {cp: u64 dst: String} is {
    if cp < 128 then {
        dst.appendByte cp.u8.orPanic
        return
    }
    if cp < 2048 then {
        # 110xxxxx 10xxxxxx  (5 + 6 payload bits)
        hi: cp >> 6
        lo: cp & 63
        dst.appendByte (hi | 192).u8.orPanic
        dst.appendByte (lo | 128).u8.orPanic
        return
    }
    if cp < 65536 then {
        # 1110xxxx 10xxxxxx 10xxxxxx  (4 + 6 + 6 payload bits)
        hi: cp >> 12
        mid: (cp >> 6) & 63
        lo: cp & 63
        dst.appendByte (hi | 224).u8.orPanic
        dst.appendByte (mid | 128).u8.orPanic
        dst.appendByte (lo | 128).u8.orPanic
        return
    }
    # 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx  (3 + 6 + 6 + 6 payload bits)
    hi: cp >> 18
    mid2: (cp >> 12) & 63
    mid1: (cp >> 6) & 63
    lo: cp & 63
    dst.appendByte (hi | 240).u8.orPanic
    dst.appendByte (mid2 | 128).u8.orPanic
    dst.appendByte (mid1 | 128).u8.orPanic
    dst.appendByte (lo | 128).u8.orPanic
}

# the raw scanner: walks a source buffer and emits Tokens, whitespace and comments retained.
Tokenizer: class {
    # the whole file, owned for the tokenizer's life
    source: String
    # the byte offset reached so far
    pos: u64
    # source index of the byte in .atchar (== source.length at EOF);
    # token spans are [tokpos-at-start, tokpos-after) slices of source
    tokpos: u64
    # the byte at `pos`, kept beside it so the hot loop does not re-index
    atchar: u8
    # the file being tokenized, stamped onto every token it makes
    fsno: zvfs.fsno
    # the line `pos` is on
    lineno: u32
    # the column `pos` is at
    colno: u32
    # Single-slot lookahead as a typed token field.
    hasnext: bool
    # the token already made but not yet handed out, which is what makes one
    # token of lookahead possible
    nexttok: token
    # Mode stack for string + interpolation contexts. Empty means the
    # implicit FILE state (see `statecurrent`).
    statestack: ListVal tokstatetype
    # Whether whitespace and comment tokens carry their source text.
    # They are the only tokens whose text no reader of THIS tokenizer
    # needs -- `scan` hands the full stream to a caller that may want it,
    # so the public default is true, and Lexer clears it because its own
    # advance drops both kinds before the parser ever sees them. An empty
    # String owns no buffer, so a token that skips its text costs nothing.
    keepTrivia: bool
} as {
    # a tokenizer over `source`, positioned before the first byte
    create: function {source: String.take fsno: zvfs.fsno} out this is {
        return (meta.create
            :source
            pos: 0
            tokpos: 0
            atchar: ascii.nul
            :fsno
            lineno: 1
            colno: 0
            hasnext: false
            nexttok: (token
                toktype: toktype.eofTok
                width: 0
                text: (zast.nameid.create from: 0)
                :fsno
                lineno: 0
                colno: 0
            )
            statestack: ListVal tokstatetype
            keepTrivia: true
        )
    }

    # State-stack helpers. Empty stack -> implicit FILE.
    #
    # except the FILE entry is implicit instead of pushed at init.
    statepush: function {:this s: tokstatetype.take} is {
        this.statestack.append s
    }

    # leave the innermost lexing state and return to the one that opened it
    statepop: function {:this} is {
        if this.statestack.length > 0 then this.statestack.pop
    }

    # the innermost lexing state, which decides how the next byte is read
    statecurrent: function {this: this.view} out tokstatetype is {
        n: this.statestack.length
        if n == 0 then return tokstatetype.file
        return (this.statestack.get i: n - 1)
    }

    # whether the next byte is read as string content, which is when an
    # end-of-line is a literal and not a separator
    inString: function {this: this.view} out bool is {
        kind: this.statecurrent
        match (
            kind
        ) case string then {
            return true
        } case stringraw then {
            return true
        } else {
            return false
        }
    }

    # Advance one byte. Returns the byte just placed in .atchar
    # (ascii.nul if past end of source).
    # which returns the byte so call sites can write `c = self._accept()`.
    accept: function {:this} out u8 is {
        this.tokpos = this.pos
        sv: this.source.stringView
        b: sv.byteAt this.pos
        match (
            b
        ) case some then {
            this.atchar = b
            this.pos = this.pos + 1
            # Bump colno once per Unicode codepoint, not once per byte:
            # UTF-8 continuation bytes (0x80..0xBF) are part of a
            # multi-byte sequence the lead byte already counted.
            #
            # filehandle.read(1) and advances per codepoint.
            if b < 128 then {
                this.colno = this.colno + 1
            } else if b >= 192 then this.colno = this.colno + 1
            return b
        } case none then {
            this.atchar = 0
            return 0
        }
    }

    # Inside a STRING state at a non-doublequote, non-EOL byte.
    #
    # acceptcharescape; otherwise gather STRC bytes into a STRMID. If
    # the very first byte is not STRC (and not backslash), emit an ERR
    # with that single byte to guarantee scanner forward progress.
    acceptstringtoken: function {:this pool: zast.StringPool} out token is {
        line: this.lineno
        col: this.colno
        c: this.atchar
        if c == ascii.backslash then return (this.acceptcharescape :pool)
        s0: this.tokpos
        for (isstrc this.atchar) loop this.accept
        if this.tokpos > s0 then {
            return (this.spanTok :pool tt: toktype.strMidTok s: s0 e: this.tokpos :line :col)
        }
        this.accept
        return (this.byteTok :pool tt: toktype.errTok s: s0 :line :col)
    }

    # Inside a STRINGRAW state.
    # rawRunStop -- the raw string's content run ended at a byte that cannot
    # continue it. Whatever was accumulated becomes a STRMID; with nothing
    # accumulated the offending byte itself is the ERR token.
    rawRunStop: function {
        :this
        pool: zast.StringPool
        stringparts: String
        line: u32
        col: u32
    } out token is {
        if stringparts.length > 0 then {
            return (this.textTok :pool tt: toktype.strMidTok s: stringparts :line :col)
        }
        err: String
        err.appendByte this.atchar
        this.accept
        return (this.textTok :pool tt: toktype.errTok s: err :line :col)
    }

    # rawRunClose -- the closing delimiter matched. The state pops here, and any
    # preceding content is emitted first with the STREND stashed behind it: one
    # call returns one token, so the close waits its turn.
    rawRunClose: function {
        :this
        pool: zast.StringPool
        stringparts: String
        delimparts: String
        line: u32
        col: u32
        dline: u32
        dcol: u32
    } out token is {
        this.statepop
        if stringparts.length > 0 then {
            this.nexttok = (this.textTok
                :pool
                tt: toktype.strEndTok
                s: delimparts
                line: dline
                col: dcol
            )
            this.hasnext = true
            return (this.textTok :pool tt: toktype.strMidTok s: stringparts :line :col)
        }
        return (this.textTok :pool tt: toktype.strEndTok s: delimparts line: dline col: dcol)
    }

    # acceptstringrawtoken. RAWC bytes accumulate into the content
    # buffer; a `"` run is matched against `delim_len` -- equal-length
    # run closes the string, shorter run is literal content. On close,
    # the STREND is stashed in `this.nexttok` (or returned directly if
    # there is no preceding content) and the STRINGRAW state is
    # popped. EOL/EOF are NOT consumed here; the outer dispatcher
    # routes them to the EOF / EOL branches in `token` on the next
    # call, which re-enters this method afterwards.
    acceptstringrawtoken: function {:this pool: zast.StringPool delim_len: u8} out token is {
        line: this.lineno
        col: this.colno
        stringparts: String
        for true loop {
            for (israwc this.atchar) loop {
                stringparts.appendByte this.atchar
                this.accept
            }
            # EOL / EOF / other non-RAWC byte: stop here and let the outer
            # dispatcher resume in the same STRINGRAW state on the next call.
            if this.atchar != ascii.doubleQuote then {
                return (this.rawRunStop :pool :stringparts :line :col)
            }
            dline: this.lineno
            dcol: this.colno
            # Fresh delimparts per outer iteration: an un-reset
            # accumulator would let a short `"` run inside the body
            # under-consume the eventual close by the leftover count.
            delimparts: String
            for this.atchar == ascii.doubleQuote while delimparts.length < delim_len.u64 loop {
                delimparts.appendByte this.atchar
                this.accept
            }
            if delimparts.length.u8.orPanic < delim_len then {
                # short run -- literal content
                extendraw :stringparts delim_view: delimparts.stringView
            } else {
                return (this.rawRunClose :pool :stringparts :delimparts :line :col :dline :dcol)
            }
        }
        # unreachable -- the for-while-true loop only exits via return
        return (token
            toktype: toktype.errTok
            width: 0
            text: (zast.nameid.create from: 0)
            fsno: this.fsno
            lineno: line
            colno: col
        )
    }

    # Consumes the leading
    # backslash, then dispatches:
    #   \n \t \b \\ \"  -> STRCHR with the interpreted byte
    #   \xHH            -> STRCHR with the decoded byte (2 hex digits)
    #   \uHHHHHH        -> STRCHR with the decoded codepoint as UTF-8
    #   \{              -> STREXPRBEG, push STRINGEXPR (the `{` itself
    #                       becomes the next token and pushes
    #                       STRINGEXPRBRACE on top)
    # Any other byte after the backslash is an ERR whose text is "\<c>".
    acceptcharescape: function {:this pool: zast.StringPool} out token is {
        line: this.lineno
        col: this.colno
        c: this.atchar
        if c != ascii.backslash then {
            err: String
            err.appendByte c
            return (this.textTok :pool tt: toktype.errTok s: err :line :col)
        }
        this.accept
        c = this.atchar

        named_byte: u8
        named_found: false
        if c == ascii.lowerN then {
            named_byte = ascii.lf
            named_found = true
        }
        if c == ascii.lowerT then {
            named_byte = ascii.ht
            named_found = true
        }
        if c == ascii.lowerB then {
            named_byte = ascii.bs
            named_found = true
        }
        if c == ascii.backslash then {
            named_byte = ascii.backslash
            named_found = true
        }
        if c == ascii.doubleQuote then {
            named_byte = ascii.doubleQuote
            named_found = true
        }
        if named_found then {
            this.accept
            sc: String
            sc.appendByte named_byte
            return (this.textTok :pool tt: toktype.strChrTok s: sc :line :col)
        }

        if c == ascii.lowerX then {
            return (this.accepthexescape :pool n: 2 specifier: ascii.lowerX :line :col)
        }
        if c == ascii.lowerU then {
            return (this.accepthexescape :pool n: 6 specifier: ascii.lowerU :line :col)
        }

        if c == ascii.braceOpen then {
            bs: String
            bs.appendByte ascii.backslash
            this.statepush s: tokstatetype.stringexpr
            return (this.textTok :pool tt: toktype.strExprBegTok s: bs :line :col)
        }

        err: String
        err.appendByte ascii.backslash
        err.appendByte c
        return (this.textTok :pool tt: toktype.errTok s: err :line :col)
    }

    # Consume `n` hex digits and produce a STRCHR with the decoded
    # value. `specifier` is the `x` or `u` that follows the backslash;
    # used to rebuild the ERR text ("\<specifier><digits-seen>") on
    # malformed input. Caller has already consumed the backslash but
    # NOT the specifier itself.
    #
    # \xHH is a raw byte escape: the text is the single byte (cp <= 0xFF).
    # \uHHHHHH is a codepoint escape: the text is the UTF-8 encoding of
    # the codepoint (1-4 bytes). Codepoints above U+10FFFF cannot be
    # represented in 1-4 byte UTF-8 and are rejected as ERR.
    accepthexescape: function {
        :this pool: zast.StringPool n: u32 specifier: u8 line: u32 col: u32
    } out token is {
        this.accept
        digits: String
        consumed: u32
        for consumed < n loop {
            c: this.atchar
            if (ishexdigit b: c) then {
                digits.appendByte c
                this.accept
                consumed = consumed + 1
            } else {
                et: escapeErrText :specifier :digits
                return (this.textTok :pool tt: toktype.errTok s: et :line :col)
            }
        }

        # Walk the collected digits for the codepoint VALUE. The source-form
        # text is built only where it is returned -- a \u escape whose value
        # exceeds U+10FFFF -- rather than on every path.
        val: u64
        dsv: digits.stringView
        j: u64
        dlen: dsv.length
        for j < dlen loop {
            db: dsv.byteAt j
            match (
                db
            ) case some then {
                hv: hexvalue b: db
                val = (val << 4) | hv.u64
            } case none then {
                j = dlen
            }
            j = j + 1
        }

        if specifier == ascii.lowerU then {
            if val > 1114111 then {
                et: escapeErrText :specifier :digits
                return (this.textTok :pool tt: toktype.errTok s: et :line :col)
            }
            sc: String
            utf8_encode_append cp: val dst: sc
            return (this.textTok :pool tt: toktype.strChrTok s: sc :line :col)
        }

        b: val.u8.orPanic
        sc: String
        sc.appendByte b
        return (this.textTok :pool tt: toktype.strChrTok s: sc :line :col)
    }

    # spanTok -- a token whose width and text both come from the source span
    # `s`..`e`. The two are written together everywhere they are written at all,
    # because a spanned token's width IS its span's.
    spanTok: function {
        this: this.view
        pool: zast.StringPool
        tt: toktype
        s: u64
        e: u64
        line: u32
        col: u32
    } out token is {
        return (token
            toktype: tt
            width: (spanWidth :s :e)
            text: (this.tokSpanId :pool :s :e)
            fsno: this.fsno
            lineno: line
            colno: col
        )
    }

    # byteTok -- a token that is exactly the one source byte at `s`.
    byteTok: function {
        this: this.view
        pool: zast.StringPool
        tt: toktype
        s: u64
        line: u32
        col: u32
    } out token is {
        return (token
            toktype: tt
            width: 1
            text: (this.tokSpanId :pool :s e: s + 1)
            fsno: this.fsno
            lineno: line
            colno: col
        )
    }

    # textTok -- a token whose spelling was BUILT rather than spanned, so its
    # width comes from the text and cannot be read off the source: an escape
    # resolves to fewer bytes than it was written in.
    textTok: function {
        this: this.view
        pool: zast.StringPool
        tt: toktype
        s: String
        line: u32
        col: u32
    } out token is {
        return (token
            toktype: tt
            width: (textWidth :s)
            text: (pool.set s: s.stringView)
            fsno: this.fsno
            lineno: line
            colno: col
        )
    }

    # tokSpanId -- the pool id for the source bytes [s, e). The pool copies
    # the bytes only on first sight, so a spelling the source has used before
    # -- which is nearly all of them -- costs nothing but the probe.
    tokSpanId: function {this: this.view pool: zast.StringPool s: u64 e: u64} out zast.nameid is {
        sv: this.source.stringView
        piece: sv.substring from: s to: e
        return (pool.set s: piece)
    }

    # stagedToken -- the token already in the lookahead slot. EOF stays staged,
    # so every later call keeps returning it; anything else clears the slot. The
    # row copies out because every field is a value now, the text included.
    stagedToken: function {:this} out token is {
        # EOF stays staged so subsequent calls keep returning it;
        # everything else gets cleared.
        is_eof: false
        match (
            this.nexttok.toktype
        ) case eofTok then {
            is_eof = true
        } else {
            is_eof = false
        }
        if is_eof then {
            # EOF's staged text is always empty
            return (token
                toktype: this.nexttok.toktype
                width: 0
                text: (zast.nameid.create from: 0)
                fsno: this.fsno
                lineno: this.nexttok.lineno
                colno: this.nexttok.colno
            )
        }
        this.hasnext = false
        return (token
            toktype: this.nexttok.toktype
            width: this.nexttok.width
            text: this.nexttok.text
            fsno: this.fsno
            lineno: this.nexttok.lineno
            colno: this.nexttok.colno
        )
    }

    # acceptStringOpen -- the `"` run that opens a string, and what its LENGTH
    # means: one pushes STRING, two is the empty string (a STRBEG with the STREND
    # stashed behind it, no push), three or more is a raw string whose delimiter
    # length goes on the state so the inner scanner can match the closer.
    acceptStringOpen: function {
        :this pool: zast.StringPool s0: u64 line: u32 col: u32
    } out token is {
        n: u64
        for this.atchar == ascii.doubleQuote loop {
            n = n + 1
            this.accept
        }
        if n == 2 then {
            # Empty string: emit STRBEG with the first quote and
            # stash a STREND with the second for the next call.
            this.nexttok = (token
                toktype: toktype.strEndTok
                width: 1
                text: (this.tokSpanId :pool s: s0 + 1 e: s0 + 2)
                fsno: this.fsno
                lineno: line
                colno: col + 1
            )
            this.hasnext = true
            return (this.byteTok :pool tt: toktype.strBegTok s: s0 :line :col)
        }
        if n == 1 then {
            this.statepush s: tokstatetype.string
            return (this.spanTok :pool tt: toktype.strBegTok s: s0 e: this.tokpos :line :col)
        }
        # n >= 3: raw string. Push STRINGRAW with the delim length
        # so acceptstringrawtoken can match a closer of the same
        # size.
        this.statepush s: tokstatetype.stringraw n.u8.orPanic
        return (this.spanTok :pool tt: toktype.strBegTok s: s0 e: this.tokpos :line :col)
    }

    # acceptDotRun -- a run of `.`. One is the path separator; any longer run is
    # not a token this language has.
    acceptDotRun: function {:this pool: zast.StringPool s0: u64 line: u32 col: u32} out token is {
        n: u64
        for this.atchar == ascii.dot loop {
            n = n + 1
            this.accept
        }
        if n == 1 then {
            return (this.spanTok :pool tt: toktype.dotTok s: s0 e: this.tokpos :line :col)
        }
        return (this.spanTok :pool tt: toktype.errTok s: s0 e: this.tokpos :line :col)
    }

    # acceptBraceOpen -- `{`. Inside an interpolation it opens a nested brace
    # scope that has to be tracked, so the matching `}` returns to STRING rather
    # than ending the interpolation.
    acceptBraceOpen: function {
        :this pool: zast.StringPool s0: u64 line: u32 col: u32
    } out token is {
        # If we are already inside an interpolation context, the `{`
        # opens a nested brace scope that must be tracked so the
        # matching `}` returns us to STRING (rather than ending the
        # interpolation).
        push_brace: false
        match (
            this.statecurrent
        ) case stringexpr then {
            push_brace = true
        } case stringexprbrace then {
            push_brace = true
        } else {
            push_brace = false
        }
        this.accept
        if push_brace then this.statepush s: tokstatetype.stringexprbrace
        return (this.byteTok :pool tt: toktype.braceOpenTok s: s0 :line :col)
    }

    # acceptBraceClose -- `}`. A brace opened inside an interpolation pops one
    # STRINGEXPRBRACE, and if that was the last one under STRINGEXPR that pops
    # too, so the next byte goes back into STRING.
    acceptBraceClose: function {
        :this pool: zast.StringPool s0: u64 line: u32 col: u32
    } out token is {
        # If the matching `{` was inside an interpolation, pop one
        # STRINGEXPRBRACE; if that was the last brace under
        # STRINGEXPR, pop STRINGEXPR too so the next byte goes back
        # into STRING.
        pop_brace: false
        match (
            this.statecurrent
        ) case stringexprbrace then {
            pop_brace = true
        } else {
            pop_brace = false
        }
        this.accept
        if pop_brace then {
            this.statepop
            pop_expr: false
            match (
                this.statecurrent
            ) case stringexpr then {
                pop_expr = true
            } else {
                pop_expr = false
            }
            if pop_expr then this.statepop
        }
        return (this.byteTok :pool tt: toktype.braceCloseTok s: s0 :line :col)
    }

    # triviaTok -- whitespace or a comment run. The span is always the width, but
    # the TEXT is interned only when trivia is being kept: a run the parser will
    # discard should not put its spelling in the pool.
    triviaTok: function {
        this: this.view
        pool: zast.StringPool
        tt: toktype
        s: u64
        line: u32
        col: u32
    } out token is {
        txt: zast.nameid
        if this.keepTrivia then txt = this.tokSpanId :pool :s e: this.tokpos
        return (token
            toktype: tt
            width: (spanWidth :s e: this.tokpos)
            text: txt
            fsno: this.fsno
            lineno: line
            colno: col
        )
    }

    # eolToken -- an end of line, either spelling. CR consumes a following LF so
    # CRLF is one token, and both advance the line counter; the token itself is
    # the same either way.
    eolToken: function {:this pool: zast.StringPool c: u8 s0: u64 line: u32 col: u32} out token is {
        this.accept
        if c == ascii.cr when this.atchar == ascii.lf then this.accept
        this.lineno = this.lineno + 1
        this.colno = 1
        return (this.spanTok :pool tt: toktype.eolTok s: s0 e: this.tokpos :line :col)
    }

    # stringStateToken -- the token the STATE STACK dictates, if it dictates one.
    # Under STRING the doublequote ends the string and everything else is string
    # content; under STRINGRAW the close-versus-content decision needs a
    # multi-byte run match and so lives in the raw scanner. None means the state
    # has nothing to say and the byte dispatches normally. EOL and EOF are
    # handled before this, so neither path has to think about them.
    stringStateToken: function {
        :this
        pool: zast.StringPool
        c: u8
        s0: u64
        line: u32
        col: u32
    } out optionval token is {
        kind: this.statecurrent
        in_string: false
        raw_delim: u8
        match (
            kind
        ) case string then {
            in_string = true
        } case stringraw then {
            # narrowed -- `kind` becomes the u8 payload value
            raw_delim = kind
        } else {
            in_string = false
        }
        if in_string then {
            if c == ascii.doubleQuote then {
                this.accept
                this.statepop
                return (optionval.some (this.byteTok :pool tt: toktype.strEndTok s: s0 :line :col))
            }
            return (optionval.some (this.acceptstringtoken :pool))
        }
        if raw_delim > 0 then {
            return (optionval.some (this.acceptstringrawtoken :pool delim_len: raw_delim))
        }
        return (optionval.none token)
    }

    # triviaToken -- a run of whitespace or a comment, whichever `c` starts.
    # None when it starts neither.
    triviaToken: function {
        :this
        pool: zast.StringPool
        c: u8
        s0: u64
        line: u32
        col: u32
    } out optionval token is {
        if (isws b: c) then {
            for (isws b: this.atchar) loop this.accept
            return (optionval.some (this.triviaTok :pool tt: toktype.wsTok s: s0 :line :col))
        }
        if c == ascii.hash then {
            for (iscommentbody b: this.atchar) loop this.accept
            return (optionval.some (this.triviaTok :pool tt: toktype.commentTok s: s0 :line :col))
        }
        return (optionval.none token)
    }

    # structuralToken -- the bytes that stand for themselves: the string opener,
    # a dot run, the brackets and the statement separator. None when `c` is none
    # of them, which leaves the word branch.
    structuralToken: function {
        :this
        pool: zast.StringPool
        c: u8
        s0: u64
        line: u32
        col: u32
    } out optionval token is {
        if c == ascii.doubleQuote then (return
            (optionval.some (this.acceptStringOpen :pool :s0 :line :col))
        )
        if c == ascii.dot then return (optionval.some (this.acceptDotRun :pool :s0 :line :col))
        if c == ascii.braceOpen then (return
            (optionval.some (this.acceptBraceOpen :pool :s0 :line :col))
        )
        if c == ascii.braceClose then (return
            (optionval.some (this.acceptBraceClose :pool :s0 :line :col))
        )
        if c == ascii.parenOpen then {
            this.accept
            return (optionval.some (this.byteTok :pool tt: toktype.parenOpenTok s: s0 :line :col))
        }
        if c == ascii.parenClose then {
            this.accept
            return (optionval.some (this.byteTok :pool tt: toktype.parenCloseTok s: s0 :line :col))
        }
        if c == ascii.semicolon then {
            this.accept
            return (optionval.some (this.byteTok :pool tt: toktype.semicolonTok s: s0 :line :col))
        }
        return (optionval.none token)
    }

    # scanWordSpan -- consume the word at the cursor and answer where it ENDS. An
    # optional sign leads it. A number-shaped word continues through a `.` when a
    # digit follows; when none does, the dot is stashed for the next call with its
    # own pre-advance position rather than joined to the word.
    scanWordSpan: function {:this pool: zast.StringPool c: u8} out u64 is {
        cw: c
        if (cw == ascii.plus) or (cw == ascii.minus) then {
            this.accept
            cw = this.atchar
        }
        # whether the first IDEN char is a digit, which is what the
        # dot-continuation rule turns on
        numbershaped: false
        if isdigit cw then numbershaped = true
        for (isidchar this.atchar) loop this.accept
        e_word: this.tokpos
        if numbershaped when this.atchar == ascii.dot then {
            dot_line: this.lineno
            dot_col: this.colno
            this.accept
            if isdigit this.atchar then {
                for (isidchar this.atchar) loop this.accept
                e_word = this.tokpos
            } else {
                this.nexttok = (token
                    toktype: toktype.dotTok
                    width: 1
                    text: (pool.set s: ".")
                    fsno: this.fsno
                    lineno: dot_line
                    colno: dot_col
                )
                this.hasnext = true
            }
        }
        return e_word
    }

    # emptyWordToken -- nothing was consumed. After a leading colon that lone
    # colon is the error; otherwise the stray byte is, and it is consumed so the
    # scan still makes progress.
    emptyWordToken: function {
        :this
        pool: zast.StringPool
        s0: u64
        s_word: u64
        has_colonpre: bool
        colonpre_line: u32
        colonpre_col: u32
        line: u32
        col: u32
    } out token is {
        if has_colonpre then {
            return (this.byteTok
                :pool
                tt: toktype.errTok
                s: s0
                line: colonpre_line
                col: colonpre_col
            )
        }
        this.accept
        return (this.byteTok :pool tt: toktype.errTok s: s_word :line :col)
    }

    # colonPreWordToken -- a word that FOLLOWED a colon. The colon is the token
    # returned and the word is stashed behind it as a LABELPRE, or as an ERR when
    # the word is a keyword or a reserved word: neither may be a label.
    colonPreWordToken: function {
        :this
        pool: zast.StringPool
        s0: u64
        s_word: u64
        e_word: u64
        kwfound: bool
        reservedfound: bool
        word_line: u32
        word_col: u32
        colonpre_line: u32
        colonpre_col: u32
    } out token is {
        stage_tt: toktype.labelPreTok
        if kwfound then stage_tt = toktype.errTok
        if reservedfound then stage_tt = toktype.errTok
        this.nexttok = (this.spanTok
            :pool
            tt: stage_tt
            s: s_word
            e: e_word
            line: word_line
            col: word_col
        )
        this.hasnext = true
        (return
            (this.byteTok :pool tt: toktype.colonTok s: s0 line: colonpre_line col: colonpre_col)
        )
    }

    # wordToken -- the word branch. A leading colon is saved separately from the
    # word's own position, because the staged LABELPRE and REFID tokens start one
    # byte after it. Three answers follow the scan: the colon with the word
    # stashed, the word with a trailing colon stashed, or the word alone as a
    # REFID, a keyword, or a reserved word read as ERR.
    wordToken: function {
        :this pool: zast.StringPool c: u8 s0: u64 line: u32 col: u32
    } out token is {
        has_colonpre: false
        colonpre_line: line
        colonpre_col: col
        cw: c
        if c == ascii.colon then {
            has_colonpre = true
            colonpre_line = this.lineno
            colonpre_col = this.colno
            this.accept
            cw = this.atchar
        }
        word_line: this.lineno
        word_col: this.colno
        s_word: this.tokpos
        e_word: this.scanWordSpan :pool c: cw
        if e_word == s_word then {
            (return
                (this.emptyWordToken
                    :pool
                    :s0
                    :s_word
                    :has_colonpre
                    :colonpre_line
                    :colonpre_col
                    :line
                    :col
                )
            )
        }
        # the word's type comes from its source span; the views stay scoped so no
        # lock outlives the lookups
        kwfound: false
        kwtt: toktype.errTok
        reservedfound: false
        {
            wsv: this.source.stringView
            wv: wsv.substring from: s_word to: e_word
            kw_res: kwlookup wv
            kwfound = kw_res.found
            kwtt = kw_res.tt
            reservedfound = islookupReserved sv: wv
        }
        if has_colonpre then {
            (return
                (this.colonPreWordToken
                    :pool
                    :s0
                    :s_word
                    :e_word
                    :kwfound
                    :reservedfound
                    :word_line
                    :word_col
                    :colonpre_line
                    :colonpre_col
                )
            )
        }
        # a trailing colon on a word that is neither a keyword nor reserved makes
        # it a LABEL, with the colon stashed. A keyword with a trailing colon
        # leaves the colon for the next call to read as a leading one.
        labelpath: false
        if this.atchar == ascii.colon when kwfound.not when reservedfound.not then labelpath = true
        if labelpath then {
            this.nexttok = (token
                toktype: toktype.colonTok
                width: 1
                text: (pool.set s: ":")
                fsno: this.fsno
                lineno: this.lineno
                colno: this.colno
            )
            this.hasnext = true
            this.accept
            (return
                (this.spanTok
                    :pool
                    tt: toktype.labelTok
                    s: s_word
                    e: e_word
                    line: word_line
                    col: word_col
                )
            )
        }
        ret_tt: toktype.refIdTok
        if kwfound then ret_tt = kwtt
        if reservedfound then ret_tt = toktype.errTok
        return (this.spanTok :pool tt: ret_tt s: s_word e: e_word line: word_line col: word_col)
    }

    # the next token, advancing past it
    nextToken: function {:this pool: zast.StringPool} out token is {
        # Drain the lookahead slot first if a token is staged. Every field
        # is a value now, the text included, so the staged row copies out.
        if this.hasnext then return this.stagedToken

        # Prime the look-ahead on the first call (pos == 0 means
        # `accept` has never run). After this, .atchar holds the next
        # byte to dispatch on (or ascii.nul if the source is empty).
        if this.pos == 0 then this.accept
        line: this.lineno
        col: this.colno
        c: this.atchar
        s0: this.tokpos

        if c == ascii.nul then {
            return (token
                toktype: toktype.eofTok
                width: 0
                text: (zast.nameid.create from: 0)
                fsno: this.fsno
                lineno: line
                colno: col
            )
        }

        if (c == ascii.lf) or (c == ascii.cr) then {
            return (this.eolToken :pool :c :s0 :line :col)
        }

        # State-aware dispatch: when the top of the state stack is
        # STRING, the doublequote ends the string (pop + STREND) and
        # everything else routes to acceptstringtoken. For STRINGRAW,
        # the close-vs-content decision lives inside
        # acceptstringrawtoken because it depends on a multi-byte run
        # match. EOL/EOF were handled above so the string-token paths
        # don't need to think about either.
        #
        stok: this.stringStateToken :pool :c :s0 :line :col
        if stok.some then return stok

        ttok: this.triviaToken :pool :c :s0 :line :col
        if ttok.some then return ttok

        # String open. Counts the consecutive `"` run. 1 -> push STRING
        # state. 2 -> empty string (STRBEG + stashed STREND, no push).
        # 3+ -> raw string: emit STRBEG with the full run and push
        # STRINGRAW carrying the run length so the inner scanner can
        # match the closer.
        xtok: this.structuralToken :pool :c :s0 :line :col
        if xtok.some then return xtok

        # the word branch, which every byte above declined
        return (this.wordToken :pool :c :s0 :line :col)
    }
}

# Parser-facing token cursor over a Tokenizer. Provides one token of
# lookahead (peek) plus filtering: WS / COMMENT / COLON are always
# skipped, EOL is skipped while filterEol is set (the parser clears it
# inside parens and toggles it around unit-body definition separators).
# The buffered token is never copied out: peekType / peekPos read it into
# scalars, peekText views it, and accept / acceptAny move its text out.
Lexer: class {
    # the tokenizer underneath; the Lexer adds lookahead and filtering to it
    lexer: Tokenizer
    # the token the Lexer is currently on
    thistoken: token
    # whether end-of-line tokens are hidden from the parser, which they are
    # wherever a construct spans lines
    filterEol: bool
} as {
    # a Lexer over `lexer`, taking it. The pool every token's text is interned
    # in travels as a PARAMETER on the methods that lex, not as a field: a
    # field would hold the pool's lock for the Lexer's whole life, and the pool
    # belongs to the parser, which must keep calling its own methods while the
    # Lexer is alive. `create` does not lex, so it does not take one -- the
    # caller primes the first token with `advance`.
    create: function {lexer: Tokenizer.take} out this is {
        # advance drops ws and comment tokens unconditionally, so their text
        # is read by nobody on this path and is the tokenizer largest
        # allocation.
        lexer.keepTrivia = false
        placeholder: (token
            toktype: toktype.bofTok
            width: 0
            text: (zast.nameid.create from: 0)
            fsno: zvfs.fsno
            lineno: 0
            colno: 0
        )
        return (meta.create :lexer thistoken: placeholder filterEol: true)
    }

    # Read the next token into thistoken, dropping filtered tokens.
    advance: function {:this pool: zast.StringPool} is {
        for true loop {
            t: this.lexer.nextToken :pool
            keep: true
            match (
                t.toktype
            ) case wsTok then {
                keep = false
            } case commentTok then {
                keep = false
            } case colonTok then {
                keep = false
            } case eolTok then {
                if this.filterEol then keep = false
                # a newline inside a string literal is its content, whatever
                # the filter says
                if this.lexer.inString then keep = true
            } else null
            if keep then {
                this.thistoken = t
                return
            }
        }
    }

    # The buffered token's type.
    peekType: function {t: this.view} out toktype is {
        return t.thistoken.toktype
    }

    # The buffered token's span.
    peekPos: function {t: this.view} out tokpos is {
        return (tokpos
            fsno: t.thistoken.fsno
            lineno: t.thistoken.lineno
            colno: t.thistoken.colno
            width: t.thistoken.width
        )
    }

    # The buffered token's text, as its pool id. An id rather than a view
    # because a view would pin the Lexer and the caller almost always wants to
    # compare or store, not to read bytes.
    peekTextId: function {t: this.view} out zast.nameid is {
        return t.thistoken.text
    }

    # Accept and advance if the buffered token matches tt; else none.
    accept: function {:this tt: toktype pool: zast.StringPool} out optionval token is {
        if this.thistoken.toktype == tt then {
            tok: this.takeCurrent
            this.advance :pool
            return (optionval.some tok)
        }
        return (optionval.none token)
    }

    # Accept and return the buffered token unconditionally, advancing.
    acceptAny: function {:this pool: zast.StringPool} out token is {
        tok: this.takeCurrent
        this.advance :pool
        return tok
    }

    # Set EOL filtering. When turning filtering back on, drop a
    # currently-buffered EOL so the next peek sees a real token.
    setFilterEol: function {:this enabled: bool pool: zast.StringPool} is {
        this.filterEol = enabled
        if enabled then {
            iseol: this.thistoken.toktype == toktype.eolTok
            if iseol then this.advance :pool
        }
    }

    # whether EOL is currently filtered, which the parser flips around the
    # constructs that may span lines
    filterEolState: function {this: this.view} out bool is {
        return this.filterEol
    }

    # Owned clone of the buffered token. Reading the receiver's own
    # field subvalues into a fresh token mirrors Tokenizer.nextToken; a
    # free helper taking a borrowed token param is rejected (the
    # projection would alias the caller's still-owned value).
    # The buffered token's fields into a fresh token; the text is an id, so
    # there is nothing to move out any more.
    takeCurrent: function {this: this.view} out token is {
        return (token
            toktype: this.thistoken.toktype
            text: this.thistoken.text
            fsno: this.thistoken.fsno
            lineno: this.thistoken.lineno
            colno: this.thistoken.colno
            width: this.thistoken.width
        )
    }
}

# kwControl -- the keywords that introduce or continue CONTROL FLOW.
kwControl: function {sv: StringView} out kwresult is {
    if sv == "if" then return (kwresult found: true tt: toktype.ifTok)
    if sv == "when" then return (kwresult found: true tt: toktype.whenTok)
    if sv == "then" then return (kwresult found: true tt: toktype.thenTok)
    if sv == "else" then return (kwresult found: true tt: toktype.elseTok)
    if sv == "for" then return (kwresult found: true tt: toktype.forTok)
    if sv == "loop" then return (kwresult found: true tt: toktype.loopTok)
    if sv == "while" then return (kwresult found: true tt: toktype.whileTok)
    if sv == "do" then return (kwresult found: true tt: toktype.doTok)
    if sv == "case" then return (kwresult found: true tt: toktype.caseTok)
    if sv == "match" then return (kwresult found: true tt: toktype.matchTok)
    if sv == "on" then return (kwresult found: true tt: toktype.onTok)
    return (kwresult found: false tt: toktype.eofTok)
}

# kwDeclarator -- the keywords that introduce a DECLARATION: the five type
# families, `data`, and the two forms that declare a body without being a type
# of their own.
kwDeclarator: function {sv: StringView} out kwresult is {
    if sv == "unit" then return (kwresult found: true tt: toktype.unitTok)
    if sv == "record" then return (kwresult found: true tt: toktype.recordTok)
    if sv == "class" then return (kwresult found: true tt: toktype.classTok)
    if sv == "union" then return (kwresult found: true tt: toktype.unionTok)
    if sv == "variant" then return (kwresult found: true tt: toktype.variantTok)
    if sv == "protocol" then return (kwresult found: true tt: toktype.protocolTok)
    if sv == "data" then return (kwresult found: true tt: toktype.dataTok)
    if sv == "facet" then return (kwresult found: true tt: toktype.facetTok)
    if sv == "generator" then return (kwresult found: true tt: toktype.generatorTok)
    if sv == "native" then return (kwresult found: true tt: toktype.nativeTok)
    return (kwresult found: false tt: toktype.eofTok)
}

# kwClause -- the keywords that join the parts of a declaration or a call: the
# binder, the result and argument directions, and the three that introduce a
# body or a conformance.
kwClause: function {sv: StringView} out kwresult is {
    if sv == "=" then return (kwresult found: true tt: toktype.equalsTok)
    if sv == "function" then return (kwresult found: true tt: toktype.functionTok)
    if sv == "out" then return (kwresult found: true tt: toktype.outTok)
    if sv == "outx" then return (kwresult found: true tt: toktype.outxTok)
    if sv == "in" then return (kwresult found: true tt: toktype.inTok)
    if sv == "swap" then return (kwresult found: true tt: toktype.swapTok)
    if sv == "is" then return (kwresult found: true tt: toktype.isTok)
    if sv == "as" then return (kwresult found: true tt: toktype.asTok)
    if sv == "with" then return (kwresult found: true tt: toktype.withTok)
    return (kwresult found: false tt: toktype.eofTok)
}

# Keyword lookup, by family. Per-call StringView equality; acceptable at this
# scale, can migrate to a Map later.
kwlookup: function {sv: StringView} out kwresult is {
    rc: kwControl :sv
    if rc.found then return rc
    rd: kwDeclarator :sv
    if rd.found then return rd
    return (kwClause :sv)
}

# true when `sv` is a reserved word that may not be used as an identifier.
islookupReserved: function {sv: StringView} out bool is {
    if sv == "enum" then return true
    if sv == "macro" then return true
    if sv == "flag" then return true
    if sv == "goto" then return true
    if sv == "cell" then return true
    if sv == "unsafe" then return true
    if sv == "repeat" then return true
    if sv == "pragma" then return true
    if sv == "switch" then return true
    if sv == "until" then return true
    return false
}
