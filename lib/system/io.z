# io

# IoError -- union covering the failure cases an I/O operation may
# return. Returned via `result.create from: T, e: IoError` from any
# fallible io function. Constructed by the compiler runtime from the
# underlying syscall errno; user code typically pattern-matches the
# specific variant it cares about and treats the rest as `other`.
#
# Defined as a union (not variant) because two arms (`invalidpath`,
# `other`) carry a `string` payload, which is a reftype and so cannot
# appear in a variant.
IoError: union {
    # the path does not exist
    notfound: null
    # the path exists but the process may not use it this way
    permissiondenied: null
    # a signal cut the call short; the operation is worth retrying, which is the
    # one arm here that usually means retry
    interrupted: null
    # the path itself is malformed -- it carries the text so the caller can say
    # which
    invalidpath: String
    # the end of the stream was reached where more was required. A short READ
    # reports 0 bytes instead; this is for the callers that cannot accept one
    eof: null
    # the bytes are not valid UTF-8, raised by the TEXT layer only -- the byte
    # layer has no opinion about encoding
    badencoding: null
    # the path is already there and the operation required that it not be
    exists: null
    # a directory was found where a file was required
    isdir: null
    # a file was found where a directory was required, or a path component is
    # not one
    notdir: null
    # the filesystem is full
    nospace: null
    # anything the arms above do not name, carrying the underlying message so
    # nothing is lost in translation
    other: String
}

# `print` is generic over `stringlike` (string | stringView). The
# typechecker monomorphizes per concrete subtype and rejects any
# argument whose type is not one of the union's members. `str` values
# must be explicitly projected: `print mystr.stringView`.
print: function as { T: StringLike.generic } in {msg: T} is native

# eprintln -- write `msg` to stderr followed by a newline. Simple
# void-return variant for diagnostic output (errors, traces).
# Intentionally never fails: if the underlying write errors, the
# message is silently dropped. Use the file / writer API for
# error-reporting writes.
eprintln: function as { T: StringLike.generic } in {msg: T} is native

# readText -- read an entire file at `path` into a heap-allocated
# UTF-8 string. Returns the content on success, or an IoError describing
# the failure (file missing, permission denied, I/O error, etc.).
#
# Content is read as bytes; no encoding validation is performed in
# this phase (badencoding is reserved for future use when a text
# reader validates UTF-8 during iteration).
readText: function as { T: StringLike.generic } in {path: T} out (Result
    String
    E: IoError
) is native

# writeText -- create (or truncate) the file at `path` and write
# `content`. Returns `ok null` on success or `err IoError` on failure
# (permission denied, out of space, etc.). Creates intermediate
# directories: NO — the parent directory must already exist.
writeText: function as { T: StringLike.generic U: StringLike.generic } in {
    # the file written, created when absent and TRUNCATED when present
    path: T
    # the text written; it replaces whatever the file held
    content: U
} out (Result null E: IoError) is native

# appendText -- open (or create) the file at `path` and append
# `content` to the end. Atomicity is not guaranteed across multiple
# processes; use OS-level locks for that.
appendText: function as { T: StringLike.generic U: StringLike.generic } in {
    # the file appended to, created when absent
    path: T
    # the text added at the end, leaving what is already there
    content: U
} out (Result null E: IoError) is native

# exists -- returns true if something exists at `path` (file, directory,
# anything the OS can `stat`). No IoError: a permission-denied on the
# parent also surfaces as false. If you need to distinguish missing
# from permission-denied, use `stat`.
exists: function as { T: StringLike.generic } in {path: T} out bool is native

# mkdir -- create a directory at `path` with default permissions (0755).
# Fails with IoError.exists if the target already exists, and with
# IoError.notfound if the parent directory is missing. To create
# intermediates (mkdir -p), use io.mkdirp below.
mkdir: function as { T: StringLike.generic } in {path: T} out (Result null E: IoError) is native

# mkdirp -- create `path` and every missing parent directory along
# the way (like `mkdir -p`). Permissions 0755 on each new directory.
# Succeeds silently if `path` already exists as a directory; fails
# with IoError.exists if it exists as a file.
mkdirp: function as { T: StringLike.generic } in {path: T} out (Result null E: IoError) is native

# remove -- delete a file or an empty directory at `path`. For
# non-empty directories this fails with IoError.other (ENOTEMPTY).
remove: function as { T: StringLike.generic } in {path: T} out (Result null E: IoError) is native

# removeTree -- best-effort recursive delete of the tree at `path`.
# Entries are lstat-ed so symlinks are removed as links, never
# followed; directories recurse and the root is removed last. Errors
# (missing path, permissions) are skipped -- a partially-deleted tree
# is possible; check `exists` afterwards when it matters.
removeTree: function {path: StringView} is {
    st: lstat :path
    match (
        st
    ) case ok then {
        if st.kind.dir then {
            ls: listDir :path
            match (
                ls
            ) case ok then {
                with it: ls.iterate do for e: it loop {
                    child: "\{path}/\{e}"
                    removeTree path: child.stringView
                }
            } case err then null
        }
    } case err then {
        return
    }
    remove :path
}

# rename -- move the entity at `from` to `to`. If `to` already exists,
# POSIX replaces it (file overwrites file, directory overwrites empty
# directory, otherwise IoError). Atomic on the same filesystem.
rename: function as { T: StringLike.generic U: StringLike.generic } in {
    # the existing path
    from: T
    # the new path. Atomic on the same filesystem, and it REPLACES an existing
    # file there rather than refusing
    to: U
} out (Result null E: IoError) is native

# filekind -- coarse classification reported by `io.stat`. Symlinks
# are distinguished only when the underlying call was `lstat`-like;
# today `stat` follows symlinks, so `symlink` is reserved for a
# future `io.lstat`.
filekind: variant {
    # a regular file
    file: null
    # a directory
    dir: null
    # a symbolic link, reported only by the call that does NOT follow links
    symlink: null
    # a socket, device, fifo or anything else the kind arms do not name
    other: null
}

# filestat -- metadata returned by `io.stat` / `io.lstat`.
# `*_seconds` fields are Unix epoch seconds; when a `time` type lands
# they will be migrated to a typed field in a follow-up. `mode` is the
# raw POSIX mode bits (file type + permission bits, as from `stat(2)`);
# callers test it with bit operations (the common permission bits are
# 0o400 / 0o200 / 0o100 for owner r/w/x, shifted for group / other).
# `device` / `inode` together uniquely identify a filesystem object;
# `nlink` is the hard-link count (directories count `.` and each
# child's `..`, so a directory with N entries typically has
# `nlink == 2 + (subdir count)`).
filestat: record {
    # what the entry is; test this before trusting size or mode to mean what you
    # expect
    kind: filekind
    # the byte length for a file. For a directory it is the filesystem's own
    # bookkeeping and not a count of anything
    size: u64
    # last MODIFICATION, in whole seconds since the Unix epoch -- the one to
    # compare when asking whether contents changed
    mtimeSeconds: u64
    # last ACCESS, in seconds since the epoch. Many filesystems are mounted so
    # this barely moves, so it is weak evidence
    atimeSeconds: u64
    # last INODE change in seconds -- metadata, not contents, so a permission
    # change moves this and not mtime
    ctimeSeconds: u64
    # the POSIX permission and type bits, raw
    mode: u32
    # the device the entry lives on; with `inode` it identifies a file uniquely,
    # which a path does not
    device: u64
    # the inode number, unique only within `device`
    inode: u64
    # how many directory entries point at this inode; above 1 means a hard link
    # exists
    nlink: u64
}

# stat -- return metadata for `path`. Follows symlinks; use
# `io.lstat` to inspect the link itself. Errors surface in the
# standard IoError shape (notfound, permissiondenied, ...).
stat: function as { T: StringLike.generic } in {path: T} out (Result
    (Box filestat)
    E: IoError
) is native

# lstat -- like `stat`, but does not follow symlinks. On a symbolic
# link, `kind` is `symlink` and `size` / `mtimeSeconds` / `mode`
# describe the link itself rather than its target.
lstat: function as { T: StringLike.generic } in {path: T} out (Result
    (Box filestat)
    E: IoError
) is native

# readlink -- return the target path a symbolic link points at.
# Does not follow the link; errors with `notfound` when `path` does
# not exist, `invalidpath` when it exists but is not a symlink, and
# the usual permission / I/O arms otherwise.
readlink: function as { T: StringLike.generic } in {path: T} out (Result
    String
    E: IoError
) is native

# symlink -- create a symbolic link at `link` whose target is
# `target`. The target is stored verbatim; it is not resolved,
# validated, or made absolute. Fails with `exists` if `link` already
# refers to anything (file, directory, or another symlink).
symlink: function as { T: StringLike.generic U: StringLike.generic } in {
    # what the link points at
    target: T
    # where the link itself is created
    link: U
} out (Result null E: IoError) is native

# listDir -- enumerate the entries of directory `path`. Returns the
# bare entry names (not full paths), excluding `.` and `..`, in the
# order `readdir(2)` produces them (filesystem order; no sort).
# Errors surface in the standard IoError shape: `notfound` when the
# path doesn't exist, `notdir` when it exists but isn't a directory,
# `permissiondenied` when the process can't read it, etc.
listDir: function as { T: StringLike.generic } in {path: T} out (Result
    (List String)
    E: IoError
) is native

# seekorigin -- where a `seek` operation interprets its offset.
# `start`: from byte 0. `current`: from current position. `end`: from
# the end (typically with a negative offset to seek backwards).
seekorigin: variant {
    # offsets count from the beginning, so the offset IS the absolute position
    start: null
    # offsets count from the head where it stands, and may be negative
    current: null
    # offsets count back from the end; 0 seeks to the end itself
    end: null
}

# Stream protocols. Operations are byte-oriented; text helpers (UTF-8
# decoding, line splitting) layer on top in later units.
#
# `reader.read into: buf max: n`
#   Reads up to `n` bytes into `buf`. Returns the number of bytes
#   actually read (0 indicates EOF) or an IoError.
Reader: protocol {
    # read up to `max` bytes into `into`, answering how many actually arrived. A
    # count of 0 is EOF rather than an error, so a caller loops until it sees
    # one
    read: function {:this into: Bytes max: u64} out (Result (Box u64) E: IoError)
}

# `writer.write from: bv`
#   Writes the byteView's bytes. Returns count actually written
#   (may be less than the input length) or an IoError.
# `writer.flush`
#   Forces buffered output to its final destination.
Writer: protocol {
    # write the view's bytes, answering how many actually went. It may be FEWER
    # than the view holds, so a caller loops rather than assuming
    write: function {:this from: ByteView} out (Result (Box u64) E: IoError)
    # force buffered output to its destination. Until this returns, a write that
    # reached a buffer has not necessarily reached the resource
    flush: function {:this} out (Result null E: IoError)
}

# `closer.close`
#   Releases the underlying resource. Errors that surface here
#   typically indicate a delayed write failure (the kernel buffered
#   data couldn't be flushed). Calling close more than once is a
#   compile-time error per the standard ownership rules.
Closer: protocol {
    # release the underlying resource. An error here is usually a DELAYED write
    # failure -- the kernel buffered data whose write fails only at close -- so
    # a caller that ignores it can lose the last of its output
    close: function {:this} out (Result null E: IoError)
}

# `seeker.seek to: offset from: origin`
#   Reposition the read/write head. Returns the new absolute position
#   from the start of the resource, or an IoError.
Seeker: protocol {
    # move the read/write head to `to`, measured from `from`, answering the new
    # absolute position counted from the start
    seek: function {:this to: i64 from: seekorigin} out (Result (Box u64) E: IoError)
}

# `file` -- an open OS file handle. Wraps a POSIX-style file
# descriptor. Single-owner; closed automatically by the destructor on
# scope exit (RAII). Use `with f: io.open(...) do { ... }` when you
# need to surface close errors explicitly; otherwise let RAII clean
# up.
#
# `closed` lets the destructor be idempotent across an explicit close
# that happens earlier in the scope.
#
# `close` releases the fd and returns a result so callers can surface
# a delayed write error (the kernel may have buffered data whose
# write fails only on close). Calling close twice is not a type
# error: the second call returns `ok null` because the destructor
# observes `closed = true` and does nothing.
File: class {
    # the POSIX file descriptor. It is the whole of the handle -- a File owns
    # exactly this
    fd: i32
    # whether close has already run. It is what makes the destructor idempotent
    # across an explicit close earlier in the scope
    closed: bool
} as {
    :Reader
    :Writer
    :Closer
    :Seeker
    # release the fd, answering a result so a delayed write error can be
    # surfaced. Calling it twice is not an error: the second answers ok null,
    # the destructor having seen `closed`
    close: function {:this} out (Result null E: IoError) is native
    # read up to `max` bytes, appending them to `buf`. Returns the
    # actual count read; 0 indicates EOF. The caller owns `buf` and
    # sees the new bytes in place on return. Signature matches the
    # `reader` protocol.
    read: function {:this into: Bytes max: u64} out (Result (Box u64) E: IoError) is native
    # write all bytes from `src` to the file. Returns the count
    # actually written (may be less than src.length on short write).
    write: function {:this from: ByteView} out (Result (Box u64) E: IoError) is native
    # flush buffered writes — a no-op on raw POSIX file descriptors
    # (each `write` syscall already goes to the kernel), kept so the
    # `writer` protocol signature is satisfied.
    flush: function {:this} out (Result null E: IoError) is native
    # reposition the read/write head. `to` is a byte offset
    # interpreted relative to `from` (start / current / end). Returns
    # the new absolute position measured from the start.
    seek: function {:this to: i64 from: seekorigin} out (Result (Box u64) E: IoError) is native
}

# openmode -- how `io.open` should acquire the underlying fd.
# `read`    -- O_RDONLY. File must exist.
# `write`   -- O_WRONLY | O_CREAT | O_TRUNC, mode 0644.
# `append`  -- O_WRONLY | O_CREAT | O_APPEND, mode 0644.
openmode: variant {
    # open for reading; the file must exist
    read: null
    # open for writing, truncating an existing file to empty
    write: null
    # open for writing at the end, keeping what is already there
    append: null
}

# open -- acquire a `file` handle at `path` in the requested `mode`.
# The returned file owns its fd: it is closed by the destructor on
# scope exit, or explicitly via `file.close` to surface a delayed
# write error.
open: function as { T: StringLike.generic } in {
    # the file to open
    path: T
    # how it is opened, which decides whether it must already exist and whether
    # its contents survive
    mode: openmode
} out (Result File E: IoError) is native

# Standard streams. Each returns a protocol handle over a static
# file pinned to the matching POSIX file descriptor (0 stdin,
# 1 stdout, 2 stderr). The returned handle is borrowed: it has no
# destroy callback, so scope exit will not close the underlying fd.
# Usage:
#   w: io.stdout
#   w.write from: bv
stdin: function out Reader is native

# the process standard-output stream (fd 1) as a borrowed Writer.
stdout: function out Writer is native

# the process standard-error stream (fd 2) as a borrowed Writer.
stderr: function out Writer is native

# `bufwriter` -- buffered adapter over any `writer`. Accumulates up
# to `cap` bytes in `buf`, flushing to the underlying sink when the
# buffer would overflow or on an explicit `flush` call. v1 does NOT
# auto-flush on scope exit: callers must invoke `flush` before the
# wrapper's scope ends, or data will be lost.
#
# Owns a borrow on `sink` via `writer.borrow`. While the bufwriter is
# alive, the original writer cannot be mutated, borrowed again, or
# locked -- path-scoped locking rejects such access at the source.
BufWriter: class {
    # the writer this buffers for. Borrowed, so the BufWriter must not outlive
    # it
    sink: Writer.borrow
    # the pending bytes, handed to the sink when they reach `cap` or a flush
    # asks
    buf: Bytes
    # the byte count that triggers a flush to the sink
    cap: u64
} as {
    :Writer
    # a BufWriter over `to`, buffering `capacity` bytes before it writes through
    create: function {to: Writer.borrow capacity: u64} outx this is native
    # buffer the view's bytes, writing through to the sink whenever the buffer
    # fills
    write: function {:this from: ByteView} out (Result (Box u64) E: IoError) is native
    # hand the buffered bytes to the sink now. A BufWriter that is dropped
    # unflushed loses them
    flush: function {:this} out (Result null E: IoError) is native
}

# `bufreader` -- buffered adapter over any `reader`. Issues exactly
# one source `read` per `capacity` bytes of data, regardless of how
# many small `read` calls the caller makes. Requests larger than
# `capacity` bypass the internal buffer and forward straight to the
# source so we never double-copy a full chunk.
#
# `buf` holds the pending bytes; `head` is the cursor into `buf` --
# bytes in `[head, buf.length)` are still to be handed out. When
# `head == buf.length` the buffer is drained and the next `read` call
# refills it from the source.
#
# Holds a borrow on `source` via `reader.borrow` so the original reader
# is locked for the wrapper's lifetime.
BufReader: class {
    # the reader this buffers from. Borrowed, so the BufReader must not outlive
    # it
    source: Reader.borrow
    # the bytes read ahead but not yet handed out
    buf: Bytes
    # how far into `buf` the caller has consumed; the unread part is what
    # remains after it
    head: u64
    # how many bytes to read ahead at a time
    cap: u64
} as {
    :Reader
    # a BufReader over `from`, reading ahead `capacity` bytes at a time
    create: function {from: Reader.borrow capacity: u64} outx this is native
    # serve up to `max` bytes from the buffer, refilling from the source when it
    # runs dry. 0 still means EOF
    read: function {:this into: Bytes max: u64} out (Result (Box u64) E: IoError) is native
}

# `textwriter` -- string-oriented adapter over a `bufwriter`. Writes
# go through the buffered sink so callers benefit from batched
# syscalls. `write` emits the stringView's bytes; `writeLine`
# appends a `\n` (LF) after the stringView. UTF-8 is the assumed
# encoding -- the wrapper does not validate on write (input
# stringviews are already known-good UTF-8 from the zerolang string
# type).
#
# Holds a borrow on `sink` via `bufwriter.borrow`, so the buffered
# wrapper cannot be flushed, mutated, or re-borrowed while the
# textwriter is alive. As with bufwriter, `flush` is NOT automatic
# on scope exit -- call it before the textwriter scope ends if you
# need a delayed-write error surfaced, or rely on the underlying
# bufwriter's own flush once the textwriter has been dropped.
TextWriter: class {
    # the BufWriter this encodes into. Borrowed, so the TextWriter must not
    # outlive it
    sink: BufWriter.borrow
} as {
    # a TextWriter over `to`; it adds UTF-8 encoding and line handling to the
    # byte layer beneath
    create: function {to: BufWriter.borrow} outx this is native
    # write a string's bytes with no terminator added
    write: function as { T: StringLike.generic } in {:this from: T} out (Result
        (Box u64)
        E: IoError
    ) is native
    # write a string's bytes followed by a newline -- the only difference from
    # `write`
    writeLine: function as { T: StringLike.generic } in {:this from: T} out (Result
        (Box u64)
        E: IoError
    ) is native
    # flush through to the underlying BufWriter, and so to its sink
    flush: function {:this} out (Result null E: IoError) is native
}

# `textreader` -- string-oriented adapter over a `bufreader`. Reads
# are pulled through the buffered source; line boundaries are tracked
# by scanning the accumulated `buf` for LF (`\n`). UTF-8 validation
# runs on each complete line before it is surfaced as a `string`;
# invalid sequences surface as `IoError.badencoding`.
#
# Holds a borrow on `source` via `bufreader.borrow`, so the buffered
# wrapper cannot be read, mutated, or re-borrowed while the
# textreader is alive.
#
# `readLine` semantics:
#
#   - ok(s)       -- one line read; the trailing LF is stripped.
#                    An empty `s` corresponds to a bare LF in the
#                    source.
#   - ok(tail)    -- end of stream reached with a trailing
#                    unterminated line; that tail is returned once.
#   - err(eof)    -- nothing left to read.
#   - err(badencoding) -- the completed line was not valid UTF-8.
#   - err(other)  -- underlying reader surfaced an I/O failure.
TextReader: class {
    # the BufReader this decodes from. Borrowed, so the TextReader must not
    # outlive it
    source: BufReader.borrow
    # the partial line carried between reads, since a line rarely ends where a
    # buffer does
    buf: Bytes
} as {
    # a TextReader over `from`, adding UTF-8 decoding and line splitting to the
    # bytes beneath
    create: function {from: BufReader.borrow} outx this is native
    # the next line WITHOUT its terminator. Invalid UTF-8 surfaces as
    # badencoding, and the end of input as eof
    readLine: function {:this} out (Result String E: IoError) is native
    # `call` makes textreader directly iterable: `for line: tr loop { ... }`
    # yields each line (LF stripped) until the stream drains. Every
    # non-ok `readLine` result -- including `badencoding` and any I/O
    # failure -- collapses to `option.none` and terminates the loop
    # silently; callers who need to distinguish the error cause must
    # call `readLine` directly rather than iterate.
    call: function {:this} out Option String is native
}
