# json -- JSON (RFC 8259) value tree, parser, and serializer.
# The tree is a reftype tagged sum (`Value`) mirroring the AST's
# union-of-carriers shape: scalars ride in the arm payload, arrays
# and objects in carrier classes. Objects remember key insertion
# order (`keys`) so serialization is deterministic; `entries` gives
# O(1) lookup. Integers and floats are separate arms so i64 values
# (protocol ids, offsets) round-trip exactly.

# Public interface -- the definitions other units may reference; all other
# top-level definitions are private to this unit.
public: unit {
    :Value
    :Arr
    :Obj
    :JsonError
    :ParseResult
    :foundkind
    :Found
    :foundMissing
    :at
    :describeValue
    :textAt
    :intAt
    :boolAt
    :hasAt
    :arrayLength
    :serialize
    :parse
}

# a JSON value: a tagged sum of null / bool / int / float / string / array / object.
Value: union {
    # JSON's null, which is a VALUE and not an absence -- `missing` is the
    # absence
    nul: null
    # true or false, boxed because a union arm holds a reftype
    boolean: Box bool
    # a number with no fraction or exponent, kept exact as i64 rather than
    # folded into a double
    intval: Box i64
    # a number that had a fraction or an exponent, so it could not stay integral
    floatval: Box f64
    # a string, already unescaped -- the escapes are resolved at parse rather
    # than on every read
    text: String
    # an ordered list of values
    array: Arr
    # a set of key/value pairs, keys kept in DOCUMENT order
    object: Obj
}

# a JSON array -- an ordered list of Values.
Arr: class {
    # the elements in document order
    items: List Value
}

# a JSON object -- string-keyed Values kept in insertion order.
Obj: class {
    # the key-to-value map, which answers lookups
    entries: (Map String V: Value)
    # the same keys in DOCUMENT order, which the map cannot give and a re-
    # serialise needs
    keys: List String
} as {
    # set -- insert or replace `key`. First insertion records the key
    # in `keys`; replacement keeps the original position.
    set: function {t: this key: String.take value: Value.take} is {
        if (t.entries.has :key).not then t.keys.append key.copy
        t.entries.set :key :value
    }

    # whether the object carries `key`, without producing its value
    has: function {t: this.view key: StringView} out bool is {
        return (t.entries.has key: key.asString)
    }
}

# Parse failure: byte offset into the input plus a message.
JsonError: class {
    # the BYTE offset the parse stopped at, not a line and column -- the caller
    # has the source and can convert
    at: u64
    # what was expected there
    msg: String
}

# the outcome of parsing JSON text: `ok` a Value, or `err` a JsonError.
ParseResult: union {
    # why the parse stopped, and where
    err: JsonError
    # the parsed document
    ok: Value
}

# ---- accessors ----------------------------------------------------
# Protocol-dispatch code addresses the tree with "/"-separated paths
# ("params/textDocument/uri"); numeric segments index arrays. The
# walk stays inside one call chain (element and member reads are
# borrows, which user code cannot return), so the terminal value is
# surfaced as scalars in `found`: the kind arm plus the matching
# payload slot. Strings are copied out; structure (array/object) is
# reported by kind and length, and is navigated in place by matching
# on the tree at the use site.

# which value kind a path lookup landed on, or `missing`.
foundkind: variant {
    # nothing at that path. Distinct from `nul`, which is a value that IS there
    missing: null
    # the path holds JSON null
    nul: null
    # the path holds true or false; read `b`
    boolean: null
    # the path holds an integral number; read `i`
    intval: null
    # the path holds a fractional number; read `f`
    floatval: null
    # the path holds a string; read `s`
    text: null
    # the path holds an array; `n` is its length
    array: null
    # the path holds an object; `n` is its entry count
    object: null
}

# a scalar path-lookup result: the `kind` plus the matching payload slot.
Found: class {
    # which of the slots below is meaningful. Read this first; the rest are zero
    # unless the kind names them
    kind: foundkind
    # the boolean, when kind is boolean
    b: bool
    # the integer, when kind is intval
    i: i64
    # the float, when kind is floatval
    f: f64
    # the string, when kind is text
    s: String
    # the element or entry count, when kind is array or object
    n: u64
}

# a Found marking "no such path" (kind = missing).
foundMissing: function out Found is {
    return (Found kind: foundkind.missing b: false i: 0 f: 0.0 s: "".string n: 0)
}

# atStep -- one INTERIOR segment of the walk: the child of `v` that `seg`
# names, walked on with whatever is left of the path. A container that has no
# such child, and a scalar that has no children at all, are both missing.
atStep: function {v: Value.view seg: String.view rest: StringView} out Found is {
    match (
        v
    ) case object then {
        child: v.entries.get key: seg
        match (
            child
        ) case some then {
            return (at v: child path: rest)
        } case none then {
            return foundMissing
        }
    } case array then {
        kv: seg.stringView
        ir: kv.parseU64
        match (
            ir
        ) case ok then {
            if ir < v.items.length then {
                el: v.items.get i: ir
                return (at v: el path: rest)
            }
            return foundMissing
        } case err then {
            return foundMissing
        }
    } else {
        return foundMissing
    }
}

# atLeaf -- the LAST segment: what the child `seg` names IS, described in place
# rather than descended into. Takes the view, because a key is only owned where
# the object leg needs one.
atLeaf: function {v: Value.view seg: StringView} out Found is {
    match (
        v
    ) case object then {
        child: v.entries.get key: seg.asString
        match (
            child
        ) case some then {
            return (describeValue v: child)
        } case none then {
            return foundMissing
        }
    } case array then {
        ir: seg.parseU64
        match (
            ir
        ) case ok then {
            if ir < v.items.length then {
                el: v.items.get i: ir
                return (describeValue v: el)
            }
            return foundMissing
        } case err then {
            return foundMissing
        }
    } else {
        return foundMissing
    }
}

# at -- walk `path` from `v`; the terminal's kind and payload.
at: function {v: Value.view path: StringView} out Found is {
    io: path.splitOnce sep: "/"
    match (
        io
    ) case some then {
        # own the head segment first: two live views of `path` would
        # conflict with substring's receiver lock
        k: String
        {
            head: path.substring from: 0 to: io
            k = head.string
        }
        rest: path.substring from: io + 1 to: path.length
        return (atStep :v seg: k :rest)
    } case none then {
        return (atLeaf :v seg: path)
    }
}

# describeValue -- one Value as a Found (no path step).
describeValue: function {v: Value.view} out Found is {
    match (
        v
    ) case nul then {
        return (Found kind: foundkind.nul b: false i: 0 f: 0.0 s: "".string n: 0)
    } case boolean then {
        return (Found kind: foundkind.boolean b: v i: 0 f: 0.0 s: "".string n: 0)
    } case intval then {
        return (Found kind: foundkind.intval b: false i: v f: 0.0 s: "".string n: 0)
    } case floatval then {
        return (Found kind: foundkind.floatval b: false i: 0 f: v s: "".string n: 0)
    } case text then {
        return (Found kind: foundkind.text b: false i: 0 f: 0.0 s: v.copy n: 0)
    } case array then {
        return (Found kind: foundkind.array b: false i: 0 f: 0.0 s: "".string n: v.items.length)
    } case object then {
        return (Found kind: foundkind.object b: false i: 0 f: 0.0 s: "".string n: v.keys.length)
    }
}

# textAt -- terminal string member as an owned copy.
textAt: function {v: Value.view path: StringView} out Option String is {
    r: at :v :path
    k: r.kind
    match (
        k
    ) case text then {
        return (Option.some r.s.copy)
    } else {
        return (Option.none String)
    }
}

# intAt -- terminal integer member.
intAt: function {v: Value.view path: StringView} out optionval i64 is {
    r: at :v :path
    k: r.kind
    match (
        k
    ) case intval then {
        return (optionval.some r.i)
    } else {
        return (optionval.none i64)
    }
}

# boolAt -- terminal boolean member.
boolAt: function {v: Value.view path: StringView} out optionval bool is {
    r: at :v :path
    k: r.kind
    match (
        k
    ) case boolean then {
        return (optionval.some r.b)
    } else {
        return (optionval.none bool)
    }
}

# hasAt -- whether the path resolves to any value.
hasAt: function {v: Value.view path: StringView} out bool is {
    r: at :v :path
    k: r.kind
    match (
        k
    ) case missing then {
        return false
    } else {
        return true
    }
}

# arrayLength -- element count, or 0 when `v` is not an array.
arrayLength: function {v: Value.view} out u64 is {
    match (
        v
    ) case array then {
        return v.items.length
    } else {
        return 0
    }
}

# ---- serializer ---------------------------------------------------

# serialize -- compact form, no whitespace; object keys in insertion
# order; strings escaped per RFC 8259 (control bytes as \u00XX,
# multi-byte UTF-8 passed through).
serialize: function {v: Value.view} out String is {
    buf: String
    writeValue :v :buf
    return buf
}

# serialize `v` as JSON text, appending to `buf`.
writeValue: function {v: Value.view buf: String} is {
    match (
        v
    ) case nul then {
        buf.append "null"
    } case boolean then {
        if v then {
            buf.append "true"
        } else {
            buf.append "false"
        }
    } case intval then {
        si: "\{v}"
        buf.append si
    } case floatval then {
        sf: "\{v}"
        buf.append sf
    } case text then {
        writeString sv: v.stringView :buf
    } case array then {
        writeArray a: v :buf
    } case object then {
        writeObject o: v :buf
    }
}

# writeArray -- `[`, the elements separated by commas, `]`. The separator goes
# BEFORE each element but the first, so an empty array writes `[]`.
writeArray: function {a: Arr.view buf: String} is {
    buf.append "["
    first: true
    for each item: a.items loop {
        if first.not then buf.append ","
        first = false
        writeValue v: item :buf
    }
    buf.append "]"
}

# writeObject -- `{`, the members in DOCUMENT order, `}`. The keys carry the
# order and the entries carry the values, so a key with no entry behind it
# writes nothing and does not consume a separator.
writeObject: function {o: Obj.view buf: String} is {
    buf.append "{"
    first: true
    for each k: o.keys loop {
        e: o.entries.get key: k
        match (
            e
        ) case some then {
            if first.not then buf.append ","
            first = false
            writeString sv: k.stringView :buf
            buf.append ":"
            writeValue v: e :buf
        } case none then null
    }
    buf.append "}"
}

# the ASCII hex digit for a nibble `n` (0..15).
hexDigit: function {n: u8} out u8 is {
    if n < 10 then return n + 0c0
    return n - 10 + 0ca
}

# append `sv` to `buf` as a quoted, escaped JSON string.
writeString: function {sv: StringView buf: String} is {
    buf.append "\""
    for each b: sv.byteView loop {
        if b == ascii.doubleQuote then {
            buf.append "\\\""
        } else if b == 0c\\ then {
            buf.append "\\\\"
        } else if b == 0c\n then {
            buf.append "\\n"
        } else if b == ascii.cr then {
            buf.append "\\r"
        } else if b == 0c\t then {
            buf.append "\\t"
        } else if b == 0c\b then {
            buf.append "\\b"
        } else if b == 0c\x0c then {
            buf.append "\\f"
        } else if b < ascii.space then {
            buf.append "\\u00"
            buf.appendByte b: (hexDigit n: b >> 4)
            buf.appendByte b: (hexDigit n: b & 15)
        } else {
            buf.appendByte :b
        }
    }
    buf.append "\""
}

# ---- parser -------------------------------------------------------

# appendCodepoint -- UTF-8 encode `cp` onto `buf`. Codepoints beyond
# U+10FFFF and unpaired surrogates are the caller's problem.
#
# UTF-8 is defined on BIT FIELDS: each continuation byte carries six bits of
# the scalar under a two-bit tag, and the lead byte carries what is left under
# a tag of its own. `cp >> 6` and `cp & 63` are that definition; divisions and
# remainders are the same thing said in a language that has no way to say it.
appendCodepoint: function {buf: String cp: u32} is {
    if cp < 128 then {
        buf.appendByte b: cp.u8.orPanic
    } else if cp < 2048 then {
        buf.appendByte b: ((cp >> 6) + 192).u8.orPanic
        buf.appendByte b: ((cp & 63) + 128).u8.orPanic
    } else if cp < 65536 then {
        buf.appendByte b: ((cp >> 12) + 224).u8.orPanic
        buf.appendByte b: (((cp >> 6) & 63) + 128).u8.orPanic
        buf.appendByte b: ((cp & 63) + 128).u8.orPanic
    } else {
        buf.appendByte b: ((cp >> 18) + 240).u8.orPanic
        buf.appendByte b: (((cp >> 12) & 63) + 128).u8.orPanic
        buf.appendByte b: (((cp >> 6) & 63) + 128).u8.orPanic
        buf.appendByte b: ((cp & 63) + 128).u8.orPanic
    }
}

# the JSON parser's scan state: input, position, nesting depth, and error info.
Cursor: class {
    # the document being parsed; the cursor borrows nothing and owns this for
    # its life
    src: String
    # the byte offset the parse has reached
    pos: u64
    # how deep the nesting is, bounded so a pathological document cannot exhaust
    # the stack
    depth: u32
    # set once, and every step after it is a no-op -- the parse unwinds by
    # CHECKING rather than by throwing
    failed: bool
    # where the first failure was, kept because `pos` keeps moving after it
    errPos: u64
    # what the first failure expected
    errMsg: String
} as {
    # record the first failure and stop. Later calls do not overwrite it, so the
    # message names the ORIGINAL problem rather than its consequences
    fail: function {t: this msg: StringView} is {
        if t.failed.not then {
            t.failed = true
            t.errPos = t.pos
            t.errMsg = msg.string
        }
    }

    # the byte at the cursor without consuming it; 0 past the end, which no
    # valid JSON byte is
    peek: function {t: this.view} out u8 is {
        sv: t.src.stringView
        b: sv.byteAt t.pos
        match (
            b
        ) case some then {
            return b
        } case none then {
            return 0
        }
    }

    # step one byte forward
    advance: function {t: this} is {
        t.pos = t.pos + 1
    }

    # step past spaces, tabs and newlines to the next meaningful byte
    skipWs: function {t: this} is {
        for (ascii.isSpace b: t.peek) loop t.advance
    }

    # one value of any kind, dispatched on the first byte
    parseValue: function {t: this} out Value is {
        t.skipWs
        if t.failed then return Value.nul
        b: t.peek
        if b == ascii.braceOpen then {
            t.depth = t.depth + 1
            if t.depth > 128 then {
                t.fail msg: "nesting too deep"
                return Value.nul
            }
            r: t.parseObject
            t.depth = t.depth - 1
            return r
        }
        if b == ascii.bracketOpen then {
            t.depth = t.depth + 1
            if t.depth > 128 then {
                t.fail msg: "nesting too deep"
                return Value.nul
            }
            r: t.parseArray
            t.depth = t.depth - 1
            return r
        }
        if b == ascii.doubleQuote then {
            s: t.parseString
            return (Value.text s)
        }
        if b == 0ct then return (t.parseWord w: "true" v: Value.boolean true)
        if b == 0cf then return (t.parseWord w: "false" v: Value.boolean false)
        if b == 0cn then return (t.parseWord w: "null" v: Value.nul)
        if b == 0c- then return t.parseNumber
        if (ascii.isDigit :b) then return t.parseNumber
        t.fail msg: "unexpected character"
        return Value.nul
    }

    # parseWord -- consume the literal `w` byte for byte; yields `v`.
    parseWord: function {t: this w: StringView v: Value.take} out Value is {
        for each wb: w.byteView loop {
            if t.peek != wb then {
                t.fail msg: "unexpected token"
                return v
            }
            t.advance
        }
        return v
    }

    # a `{...}` object, keeping the keys in document order beside the map
    parseObject: function {t: this} out Value is {
        t.advance
        o: Obj entries: (Map String V: Value) keys: List String
        t.skipWs
        if t.peek == ascii.braceClose then {
            t.advance
            return (Value.object o)
        }
        for true loop {
            t.skipWs
            if (t.peek == ascii.doubleQuote).not then {
                t.fail msg: "expected object key"
                return (Value.object o)
            }
            k: t.parseString
            if t.failed then return (Value.object o)
            t.skipWs
            if t.peek == ascii.colon then {
                t.advance
            } else {
                t.fail msg: "expected ':'"
                return (Value.object o)
            }
            v: t.parseValue
            if t.failed then return (Value.object o)
            o.set key: k value: v
            t.skipWs
            b: t.peek
            if b == ascii.comma then {
                t.advance
            } else if b == ascii.braceClose then {
                t.advance
                return (Value.object o)
            } else {
                t.fail msg: "expected ',' or '}'"
                return (Value.object o)
            }
        }
    }

    # a `[...]` array, element by element, with the nesting depth bounded
    parseArray: function {t: this} out Value is {
        t.advance
        a: Arr items: List Value
        t.skipWs
        if t.peek == ascii.bracketClose then {
            t.advance
            return (Value.array a)
        }
        for true loop {
            v: t.parseValue
            if t.failed then return (Value.array a)
            a.items.append v
            t.skipWs
            b: t.peek
            if b == ascii.comma then {
                t.advance
            } else if b == ascii.bracketClose then {
                t.advance
                return (Value.array a)
            } else {
                t.fail msg: "expected ',' or ']'"
                return (Value.array a)
            }
        }
    }

    # a quoted string with its escapes RESOLVED, so no reader has to unescape
    # later
    parseString: function {t: this} out String is {
        t.advance
        buf: String
        for true loop {
            b: t.peek
            if b == ascii.nul then {
                t.fail msg: "unterminated string"
                return buf
            }
            if b == ascii.doubleQuote then {
                t.advance
                return buf
            }
            if b == 0c\\ then {
                t.advance
                e: t.peek
                t.advance
                t.escapeBody :buf :e
                if t.failed then return buf
                continue
            }
            if b < ascii.space then {
                t.fail msg: "control character in string"
                return buf
            }
            buf.appendByte :b
            t.advance
        }
    }

    # escapeBody -- what the byte after a backslash stands for, appended to
    # `buf`. Every leg either appends or fails; the caller reads `failed`
    # rather than a result, because a failure has to stop the whole parse and
    # the flag already carries that.
    escapeBody: function {t: this buf: String e: u8} is {
        if e == ascii.doubleQuote then {
            buf.append "\""
        } else if e == 0c\\ then {
            buf.append "\\"
        } else if e == 0c/ then {
            buf.append "/"
        } else if e == 0cb then {
            buf.appendByte b: 0c\b
        } else if e == 0cf then {
            buf.appendByte b: 0c\x0c
        } else if e == 0cn then {
            buf.append "\n"
        } else if e == 0cr then {
            buf.appendByte b: ascii.cr
        } else if e == 0ct then {
            buf.append "\t"
        } else if e == 0cu then {
            t.escapeUnicode :buf
        } else {
            t.fail msg: "bad escape"
        }
    }

    # escapeUnicode -- a `\u` escape, already past the `u`. A scalar outside the
    # surrogate range encodes as itself; a HIGH surrogate needs the low half
    # that follows it, and a low surrogate arriving on its own is the error.
    escapeUnicode: function {t: this buf: String} is {
        cp: t.hex4
        if t.failed then return
        if cp >= 55296 when cp <= 56319 then {
            t.surrogateTail :buf hi: cp
            return
        }
        if cp >= 56320 when cp <= 57343 then {
            t.fail msg: "unpaired surrogate"
            return
        }
        appendCodepoint :buf :cp
    }

    # surrogateTail -- the low half of a surrogate pair, spelled as its own
    # `\u` escape, and the one codepoint the pair encodes. Anything else after
    # a high surrogate leaves the pair unpaired.
    surrogateTail: function {t: this buf: String hi: u32} is {
        if t.peek != 0c\\ then {
            t.fail msg: "unpaired surrogate"
            return
        }
        t.advance
        if t.peek != 0cu then {
            t.fail msg: "unpaired surrogate"
            return
        }
        t.advance
        lo: t.hex4
        if t.failed then return
        if lo >= 56320 when lo <= 57343 then {
            full: ((hi - 55296) << 10) + (lo - 56320) + 65536
            appendCodepoint :buf cp: full
        } else {
            t.fail msg: "unpaired surrogate"
        }
    }

    # hex4 -- four hex digits as a scalar; 0 on failure (failed set).
    hex4: function {t: this} out u32 is {
        v: u32
        i: u64
        for i < 4 loop {
            b: t.peek
            d: u32
            if (ascii.isDigit :b) then {
                d = b.u32 - 0c0
            } else if b >= 0ca when b <= 0cf then {
                d = b.u32 - 0ca + 10
            } else if b >= 0cA when b <= 0cF then {
                d = b.u32 - 0cA + 10
            } else {
                t.fail msg: "bad unicode escape"
                return 0
            }
            v = (v << 4) | d
            t.advance
            i = i + 1
        }
        return v
    }

    # a number, answering intval when it has no fraction or exponent and
    # floatval when it has
    parseNumber: function {t: this} out Value is {
        start: t.pos
        isFloat: false
        for true loop {
            b: t.peek
            if (b == 0c-) or (b == 0c+) then {
                t.advance
            } else if b == ascii.dot then {
                isFloat = true
                t.advance
            } else if b == 0ce then {
                isFloat = true
                t.advance
            } else if b == 0cE then {
                isFloat = true
                t.advance
            } else if (ascii.isDigit :b) then {
                t.advance
            } else {
                break
            }
        }
        if t.pos == start then {
            t.fail msg: "bad number"
            return Value.nul
        }
        span: (t.src.stringView.substring from: start to: t.pos).string
        if isFloat then {
            fr: span.stringView.parseF64
            match (
                fr
            ) case ok then {
                return (Value.floatval fr)
            } case err then {
                t.fail msg: "bad number"
                return Value.nul
            }
        }
        ir: span.stringView.parseI64
        match (
            ir
        ) case ok then {
            return (Value.intval ir)
        } case err then {
            t.fail msg: "bad number"
            return Value.nul
        }
    }
}

# parse -- whole-input parse; trailing non-whitespace is an error.
parse: function {source: StringView} out ParseResult is {
    c: Cursor src: source.string pos: 0 depth: 0 failed: false errPos: 0 errMsg: "".string
    v: c.parseValue
    c.skipWs
    if c.failed.not when c.pos < c.src.length then c.fail msg: "trailing data"
    if c.failed then {
        e: JsonError at: c.errPos msg: c.errMsg.copy
        return (ParseResult.err e)
    }
    return (ParseResult.ok v)
}
