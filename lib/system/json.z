# json -- JSON (RFC 8259) value tree, parser, and serializer.
# The tree is a reftype tagged sum (`Value`) mirroring the AST's
# union-of-carriers shape: scalars ride in the arm payload, arrays
# and objects in carrier classes. Objects remember key insertion
# order (`keys`) so serialization is deterministic; `entries` gives
# O(1) lookup. Integers and floats are separate arms so i64 values
# (protocol ids, offsets) round-trip exactly.

# a JSON value: a tagged sum of null / bool / int / float / string / array / object.
Value: union {
    # JSON's null, which is a VALUE and not an absence -- `missing` is the
    # absence
    nul: null
    # true or false, boxed because a union arm holds a reftype
    boolean: Box bool
    # a number with no fraction or exponent, kept exact as i64 rather than
    # folded into a double
    intval: Box i64
    # a number that had a fraction or an exponent, so it could not stay integral
    floatval: Box f64
    # a string, already unescaped -- the escapes are resolved at parse rather
    # than on every read
    text: String
    # an ordered list of values
    array: Arr
    # a set of key/value pairs, keys kept in DOCUMENT order
    object: Obj
}

# a JSON array -- an ordered list of Values.
Arr: class {
    # the elements in document order
    items: List Value
}

# a JSON object -- string-keyed Values kept in insertion order.
Obj: class {
    # the key-to-value map, which answers lookups
    entries: (Map String V: Value)
    # the same keys in DOCUMENT order, which the map cannot give and a re-
    # serialise needs
    keys: List String
} as {
    # set -- insert or replace `key`. First insertion records the key
    # in `keys`; replacement keeps the original position.
    set: function {:this key: String.take value: Value.take} is {
        if (this.entries.has :key) == false then this.keys.append key.copy
        this.entries.set :key :value
    }

    # whether the object carries `key`, without producing its value
    has: function {:this key: StringView} out bool is {
        return (this.entries.has key: key.asString)
    }
}

# Parse failure: byte offset into the input plus a message.
JsonError: class {
    # the BYTE offset the parse stopped at, not a line and column -- the caller
    # has the source and can convert
    at: u64
    # what was expected there
    msg: String
}

# the outcome of parsing JSON text: `ok` a Value, or `err` a JsonError.
ParseResult: union {
    # why the parse stopped, and where
    err: JsonError
    # the parsed document
    ok: Value
}

# ---- accessors ----------------------------------------------------
# Protocol-dispatch code addresses the tree with "/"-separated paths
# ("params/textDocument/uri"); numeric segments index arrays. The
# walk stays inside one call chain (element and member reads are
# borrows, which user code cannot return), so the terminal value is
# surfaced as scalars in `found`: the kind arm plus the matching
# payload slot. Strings are copied out; structure (array/object) is
# reported by kind and length, and is navigated in place by matching
# on the tree at the use site.

# which value kind a path lookup landed on, or `missing`.
foundkind: variant {
    # nothing at that path. Distinct from `nul`, which is a value that IS there
    missing: null
    # the path holds JSON null
    nul: null
    # the path holds true or false; read `b`
    boolean: null
    # the path holds an integral number; read `i`
    intval: null
    # the path holds a fractional number; read `f`
    floatval: null
    # the path holds a string; read `s`
    text: null
    # the path holds an array; `n` is its length
    array: null
    # the path holds an object; `n` is its entry count
    object: null
}

# a scalar path-lookup result: the `kind` plus the matching payload slot.
Found: class {
    # which of the slots below is meaningful. Read this first; the rest are zero
    # unless the kind names them
    kind: foundkind
    # the boolean, when kind is boolean
    b: bool
    # the integer, when kind is intval
    i: i64
    # the float, when kind is floatval
    f: f64
    # the string, when kind is text
    s: String
    # the element or entry count, when kind is array or object
    n: u64
}

# a Found marking "no such path" (kind = missing).
foundMissing: function out Found is {
    return (Found kind: foundkind.missing b: false i: 0 f: 0.0 s: "".string n: 0)
}

# at -- walk `path` from `v`; the terminal's kind and payload.
at: function {v: Value.view path: StringView} out Found is {
    io: path.splitOnce sep: "/"
    match (
        io
    ) case some then {
        # own the head segment first: two live views of `path` would
        # conflict with substring's receiver lock
        k: String
        {
            head: path.substring from: 0 to: io
            k = head.string
        }
        rest: path.substring from: io + 1 to: path.length
        match (
            v
        ) case object then {
            child: v.entries.get key: k
            match (
                child
            ) case some then {
                return (at v: child path: rest)
            } case none then {
                return foundMissing
            }
        } case array then {
            kv: k.stringView
            ir: kv.parseU64
            match (
                ir
            ) case ok then {
                if ir < v.items.length then {
                    el: v.items.get i: ir
                    return (at v: el path: rest)
                }
                return foundMissing
            } case err then {
                return foundMissing
            }
        } else {
            return foundMissing
        }
    } case none then {
        match (
            v
        ) case object then {
            child2: v.entries.get key: path.asString
            match (
                child2
            ) case some then {
                return (describeValue v: child2)
            } case none then {
                return foundMissing
            }
        } case array then {
            ir2: path.parseU64
            match (
                ir2
            ) case ok then {
                if ir2 < v.items.length then {
                    el2: v.items.get i: ir2
                    return (describeValue v: el2)
                }
                return foundMissing
            } case err then {
                return foundMissing
            }
        } else {
            return foundMissing
        }
    }
}

# describeValue -- one Value as a Found (no path step).
describeValue: function {v: Value.view} out Found is {
    match (
        v
    ) case nul then {
        return (Found kind: foundkind.nul b: false i: 0 f: 0.0 s: "".string n: 0)
    } case boolean then {
        return (Found kind: foundkind.boolean b: v i: 0 f: 0.0 s: "".string n: 0)
    } case intval then {
        return (Found kind: foundkind.intval b: false i: v f: 0.0 s: "".string n: 0)
    } case floatval then {
        return (Found kind: foundkind.floatval b: false i: 0 f: v s: "".string n: 0)
    } case text then {
        return (Found kind: foundkind.text b: false i: 0 f: 0.0 s: v.copy n: 0)
    } case array then {
        return (Found kind: foundkind.array b: false i: 0 f: 0.0 s: "".string n: v.items.length)
    } case object then {
        return (Found kind: foundkind.object b: false i: 0 f: 0.0 s: "".string n: v.keys.length)
    }
}

# textAt -- terminal string member as an owned copy.
textAt: function {v: Value.view path: StringView} out Option String is {
    r: (at :v :path)
    k: r.kind
    match (
        k
    ) case text then {
        return (Option.some r.s.copy)
    } else {
        return (Option.none String)
    }
}

# intAt -- terminal integer member.
intAt: function {v: Value.view path: StringView} out optionval i64 is {
    r: (at :v :path)
    k: r.kind
    match (
        k
    ) case intval then {
        return (optionval.some r.i)
    } else {
        return (optionval.none i64)
    }
}

# boolAt -- terminal boolean member.
boolAt: function {v: Value.view path: StringView} out optionval bool is {
    r: (at :v :path)
    k: r.kind
    match (
        k
    ) case boolean then {
        return (optionval.some r.b)
    } else {
        return (optionval.none bool)
    }
}

# hasAt -- whether the path resolves to any value.
hasAt: function {v: Value.view path: StringView} out bool is {
    r: (at :v :path)
    k: r.kind
    match (
        k
    ) case missing then {
        return false
    } else {
        return true
    }
}

# arrayLength -- element count, or 0 when `v` is not an array.
arrayLength: function {v: Value.view} out u64 is {
    match (
        v
    ) case array then {
        return v.items.length
    } else {
        return 0
    }
}

# ---- serializer ---------------------------------------------------

# serialize -- compact form, no whitespace; object keys in insertion
# order; strings escaped per RFC 8259 (control bytes as \u00XX,
# multi-byte UTF-8 passed through).
serialize: function {v: Value.view} out String is {
    buf: String
    writeValue :v :buf
    return buf
}

# serialize `v` as JSON text, appending to `buf`.
writeValue: function {v: Value.view buf: String} is {
    match (
        v
    ) case nul then {
        buf.append "null"
    } case boolean then {
        if v then {
            buf.append "true"
        } else {
            buf.append "false"
        }
    } case intval then {
        si: "\{v}"
        buf.append si
    } case floatval then {
        sf: "\{v}"
        buf.append sf
    } case text then {
        writeString sv: v.stringView :buf
    } case array then {
        buf.appendByte b: 91
        first: true
        with it: v.items.iterate do for item: it loop {
            if first == false then buf.appendByte b: 44
            first = false
            writeValue v: item :buf
        }
        buf.appendByte b: 93
    } case object then {
        buf.appendByte b: 123
        first: true
        with kit: v.keys.iterate do for k: kit loop {
            e: v.entries.get key: k
            match (
                e
            ) case some then {
                if first == false then buf.appendByte b: 44
                first = false
                writeString sv: k.stringView :buf
                buf.appendByte b: 58
                writeValue v: e :buf
            } case none then null
        }
        buf.appendByte b: 125
    }
}

# the ASCII hex digit for a nibble `n` (0..15).
hexDigit: function {n: u8} out u8 is {
    if n < 10 then return n + 48
    return n + 87
}

# append `sv` to `buf` as a quoted, escaped JSON string.
writeString: function {sv: StringView buf: String} is {
    buf.appendByte b: 34
    n: sv.length
    i: u64
    for i < n loop {
        b: sv.byteAt i
        match (
            b
        ) case some then {
            if b == 34 then {
                buf.appendByte b: 92
                buf.appendByte b: 34
            } else if b == 92 then {
                buf.appendByte b: 92
                buf.appendByte b: 92
            } else if b == 10 then {
                buf.appendByte b: 92
                buf.appendByte b: 0cn
            } else if b == 13 then {
                buf.appendByte b: 92
                buf.appendByte b: 0cr
            } else if b == 9 then {
                buf.appendByte b: 92
                buf.appendByte b: 0ct
            } else if b == 8 then {
                buf.appendByte b: 92
                buf.appendByte b: 0cb
            } else if b == 12 then {
                buf.appendByte b: 92
                buf.appendByte b: 0cf
            } else if b < 32 then {
                buf.append "\\u00"
                buf.appendByte b: (hexDigit n: b >> 4)
                buf.appendByte b: (hexDigit n: b & 15)
            } else {
                buf.appendByte :b
            }
        } case none then null
        i = i + 1
    }
    buf.appendByte b: 34
}

# ---- parser -------------------------------------------------------

# true when byte `b` is an ASCII digit 0-9.
isDigit: function {b: u8} out bool is {
    if b >= 48 when b <= 57 then return true
    return false
}

# true when byte `b` is JSON insignificant whitespace.
isWs: function {b: u8} out bool is {
    if b == 32 then return true
    if b == 9 then return true
    if b == 10 then return true
    if b == 13 then return true
    return false
}

# appendCodepoint -- UTF-8 encode `cp` onto `buf`. Codepoints beyond
# U+10FFFF and unpaired surrogates are the caller's problem.
#
# UTF-8 is defined on BIT FIELDS: each continuation byte carries six bits of
# the scalar under a two-bit tag, and the lead byte carries what is left under
# a tag of its own. `cp >> 6` and `cp & 63` are that definition; divisions and
# remainders are the same thing said in a language that has no way to say it.
appendCodepoint: function {buf: String cp: u32} is {
    if cp < 128 then {
        buf.appendByte b: cp.u8.orPanic
    } else if cp < 2048 then {
        buf.appendByte b: ((cp >> 6) + 192).u8.orPanic
        buf.appendByte b: ((cp & 63) + 128).u8.orPanic
    } else if cp < 65536 then {
        buf.appendByte b: ((cp >> 12) + 224).u8.orPanic
        buf.appendByte b: (((cp >> 6) & 63) + 128).u8.orPanic
        buf.appendByte b: ((cp & 63) + 128).u8.orPanic
    } else {
        buf.appendByte b: ((cp >> 18) + 240).u8.orPanic
        buf.appendByte b: (((cp >> 12) & 63) + 128).u8.orPanic
        buf.appendByte b: (((cp >> 6) & 63) + 128).u8.orPanic
        buf.appendByte b: ((cp & 63) + 128).u8.orPanic
    }
}

# the JSON parser's scan state: input, position, nesting depth, and error info.
Cursor: class {
    # the document being parsed; the cursor borrows nothing and owns this for
    # its life
    src: String
    # the byte offset the parse has reached
    pos: u64
    # how deep the nesting is, bounded so a pathological document cannot exhaust
    # the stack
    depth: u32
    # set once, and every step after it is a no-op -- the parse unwinds by
    # CHECKING rather than by throwing
    failed: bool
    # where the first failure was, kept because `pos` keeps moving after it
    errPos: u64
    # what the first failure expected
    errMsg: String
} as {
    # record the first failure and stop. Later calls do not overwrite it, so the
    # message names the ORIGINAL problem rather than its consequences
    fail: function {:this msg: StringView} is {
        if this.failed == false then {
            this.failed = true
            this.errPos = this.pos
            this.errMsg = msg.string
        }
    }

    # the byte at the cursor without consuming it; 0 past the end, which no
    # valid JSON byte is
    peek: function {:this} out u8 is {
        sv: this.src.stringView
        b: sv.byteAt this.pos
        match (
            b
        ) case some then {
            return b
        } case none then {
            return 0
        }
    }

    # step one byte forward
    advance: function {:this} is {
        this.pos = this.pos + 1
    }

    # step past spaces, tabs and newlines to the next meaningful byte
    skipWs: function {:this} is {
        for (isWs b: this.peek) loop this.advance
    }

    # one value of any kind, dispatched on the first byte
    parseValue: function {:this} out Value is {
        this.skipWs
        if this.failed then return Value.nul
        b: this.peek
        if b == 123 then {
            this.depth = this.depth + 1
            if this.depth > 128 then {
                this.fail msg: "nesting too deep"
                return Value.nul
            }
            r: this.parseObject
            this.depth = this.depth - 1
            return r
        }
        if b == 91 then {
            this.depth = this.depth + 1
            if this.depth > 128 then {
                this.fail msg: "nesting too deep"
                return Value.nul
            }
            r: this.parseArray
            this.depth = this.depth - 1
            return r
        }
        if b == 34 then {
            s: this.parseString
            return (Value.text s)
        }
        if b == 0ct then return (this.parseWord w: "true" v: (Value.boolean true))
        if b == 0cf then return (this.parseWord w: "false" v: (Value.boolean false))
        if b == 0cn then return (this.parseWord w: "null" v: Value.nul)
        if b == 45 then return this.parseNumber
        if (isDigit :b) then return this.parseNumber
        this.fail msg: "unexpected character"
        return Value.nul
    }

    # parseWord -- consume the literal `w` byte for byte; yields `v`.
    parseWord: function {:this w: StringView v: Value.take} out Value is {
        i: u64
        n: w.length
        for i < n loop {
            wb: w.byteAt i
            match (
                wb
            ) case some then {
                if this.peek == wb then {
                    this.advance
                } else {
                    this.fail msg: "unexpected token"
                    return v
                }
            } case none then null
            i = i + 1
        }
        return v
    }

    # a `{...}` object, keeping the keys in document order beside the map
    parseObject: function {:this} out Value is {
        this.advance
        o: (Obj entries: (Map String V: Value) keys: (List String))
        this.skipWs
        if this.peek == 125 then {
            this.advance
            return (Value.object o)
        }
        for true loop {
            this.skipWs
            if (this.peek == 34) == false then {
                this.fail msg: "expected object key"
                return (Value.object o)
            }
            k: this.parseString
            if this.failed then return (Value.object o)
            this.skipWs
            if this.peek == 58 then {
                this.advance
            } else {
                this.fail msg: "expected ':'"
                return (Value.object o)
            }
            v: this.parseValue
            if this.failed then return (Value.object o)
            o.set key: k value: v
            this.skipWs
            b: this.peek
            if b == 44 then {
                this.advance
            } else if b == 125 then {
                this.advance
                return (Value.object o)
            } else {
                this.fail msg: "expected ',' or '}'"
                return (Value.object o)
            }
        }
    }

    # a `[...]` array, element by element, with the nesting depth bounded
    parseArray: function {:this} out Value is {
        this.advance
        a: (Arr items: (List Value))
        this.skipWs
        if this.peek == 93 then {
            this.advance
            return (Value.array a)
        }
        for true loop {
            v: this.parseValue
            if this.failed then return (Value.array a)
            a.items.append v
            this.skipWs
            b: this.peek
            if b == 44 then {
                this.advance
            } else if b == 93 then {
                this.advance
                return (Value.array a)
            } else {
                this.fail msg: "expected ',' or ']'"
                return (Value.array a)
            }
        }
    }

    # a quoted string with its escapes RESOLVED, so no reader has to unescape
    # later
    parseString: function {:this} out String is {
        this.advance
        buf: String
        for true loop {
            b: this.peek
            if b == 0 then {
                this.fail msg: "unterminated string"
                return buf
            }
            if b == 34 then {
                this.advance
                return buf
            }
            if b == 92 then {
                this.advance
                e: this.peek
                this.advance
                if e == 34 then {
                    buf.appendByte b: 34
                } else if e == 92 then {
                    buf.appendByte b: 92
                } else if e == 47 then {
                    buf.appendByte b: 47
                } else if e == 0cb then {
                    buf.appendByte b: 8
                } else if e == 0cf then {
                    buf.appendByte b: 12
                } else if e == 0cn then {
                    buf.appendByte b: 10
                } else if e == 0cr then {
                    buf.appendByte b: 13
                } else if e == 0ct then {
                    buf.appendByte b: 9
                } else if e == 0cu then {
                    cp: this.hex4
                    if this.failed then return buf
                    if cp >= 55296 when cp <= 56319 then {
                        if this.peek == 92 then {
                            this.advance
                        } else {
                            this.fail msg: "unpaired surrogate"
                            return buf
                        }
                        if this.peek == 0cu then {
                            this.advance
                        } else {
                            this.fail msg: "unpaired surrogate"
                            return buf
                        }
                        lo: this.hex4
                        if this.failed then return buf
                        if lo >= 56320 when lo <= 57343 then {
                            full: ((cp - 55296) << 10) + (lo - 56320) + 65536
                            appendCodepoint :buf cp: full
                        } else {
                            this.fail msg: "unpaired surrogate"
                            return buf
                        }
                    } else if cp >= 56320 when cp <= 57343 then {
                        this.fail msg: "unpaired surrogate"
                        return buf
                    } else {
                        appendCodepoint :buf :cp
                    }
                } else {
                    this.fail msg: "bad escape"
                    return buf
                }
            } else {
                if b < 32 then {
                    this.fail msg: "control character in string"
                    return buf
                }
                buf.appendByte :b
                this.advance
            }
        }
    }

    # hex4 -- four hex digits as a scalar; 0 on failure (failed set).
    hex4: function {:this} out u32 is {
        v: u32
        i: u64
        for i < 4 loop {
            b: this.peek
            d: u32
            if (isDigit :b) then {
                d = b.u32 - 48
            } else if b >= 97 when b <= 102 then {
                d = b.u32 - 87
            } else if b >= 65 when b <= 70 then {
                d = b.u32 - 55
            } else {
                this.fail msg: "bad unicode escape"
                return 0
            }
            v = (v << 4) | d
            this.advance
            i = i + 1
        }
        return v
    }

    # a number, answering intval when it has no fraction or exponent and
    # floatval when it has
    parseNumber: function {:this} out Value is {
        start: this.pos
        isFloat: false
        for true loop {
            b: this.peek
            if b == 45 then {
                this.advance
            } else if b == 43 then {
                this.advance
            } else if b == 46 then {
                isFloat = true
                this.advance
            } else if b == 0ce then {
                isFloat = true
                this.advance
            } else if b == 69 then {
                isFloat = true
                this.advance
            } else if (isDigit :b) then {
                this.advance
            } else {
                break
            }
        }
        if this.pos == start then {
            this.fail msg: "bad number"
            return Value.nul
        }
        span: ((this.src.stringView).substring from: start to: this.pos).string
        if isFloat then {
            fr: span.stringView.parseF64
            match (
                fr
            ) case ok then {
                return (Value.floatval fr)
            } case err then {
                this.fail msg: "bad number"
                return Value.nul
            }
        }
        ir: span.stringView.parseI64
        match (
            ir
        ) case ok then {
            return (Value.intval ir)
        } case err then {
            this.fail msg: "bad number"
            return Value.nul
        }
    }
}

# parse -- whole-input parse; trailing non-whitespace is an error.
parse: function {source: StringView} out ParseResult is {
    c: (Cursor src: source.string pos: 0 depth: 0 failed: false errPos: 0 errMsg: "".string)
    v: c.parseValue
    c.skipWs
    if c.failed == false then {
        if c.pos < c.src.length then c.fail msg: "trailing data"
    }
    if c.failed then {
        e: (JsonError at: c.errPos msg: c.errMsg.copy)
        return (ParseResult.err e)
    }
    return (ParseResult.ok v)
}
