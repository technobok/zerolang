# toolchain -- the shapes of the data files the zerolang toolchain reads
# (docs/zdata.pdoc). A schema: its types are what a file builds its value from.

# project -- a project's settings: the value project.zd's `project` holds (docs/zc.pdoc,
# Projects). A string left "" and a switch left false take the driver's own default
project: data {
    # the source roots, relative to the project's directory, the first searched
    # first; "" is the directory itself, and an empty list is no source root
    sourceDirs: list { "" }
    # the stdlib directory
    systemDir: ""
    # the programs, each a unit declaring `main`: what a build that names no unit
    # compiles, and what the language server searches
    programs: list {} out staticlist text
    # the triple to build for
    target: ""
    # where a build writes its executable
    outputDir: ""
    # the C compiler to drive
    cCompiler: ""
    # how the C compiler runs: spawn or inproc
    cCompilerMode: ""
    # passed through to the C compile step
    cFlags: ""
    # passed through to the link step
    linkFlags: ""
    # the tcc runtime payload directory
    tccLibDir: ""
    # build with optimisation
    release: false
    # the emitter's cheaper name hash
    fastHash: false
    # emit source names rather than numbered ones
    readableNames: false
    # typecheck every definition, not only what main reaches
    eager: false
}
