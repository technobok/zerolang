# ascii -- names for the ASCII bytes a character literal cannot spell. A
# `0c` literal is one identifier token, so it writes any byte an identifier
# may hold (`0cA`, `0c/`, `0c_`) and the escapes `0c\n`, `0c\t`, `0c\b`,
# `0c\\` and `0c\xHH`. The space and the delimiters end an identifier, and
# most control bytes have no escape: those are named here. The control bytes
# keep their ASCII mnemonics; the other names are full words.

# Public interface -- the definitions other units may reference.
public: unit {
    :nul
    :bs
    :ht
    :lf
    :cr
    :del
    :space
    :doubleQuote
    :hash
    :parenOpen
    :parenClose
    :comma
    :dot
    :colon
    :semicolon
    :bracketOpen
    :bracketClose
    :backtick
    :braceOpen
    :braceClose
    :isDigit
    :isHexDigit
    :isUpper
    :isLower
    :isLetter
    :isWord
    :isSpace
    :isBlank
}

# NUL, the zero byte
nul: 0.u8

# BS, backspace; also written `0c\b`
bs: 8.u8

# HT, the horizontal tab; also written `0c\t`
ht: 9.u8

# LF, the line feed that ends a line; also written `0c\n`
lf: 10.u8

# CR, the carriage return
cr: 13.u8

# DEL, the last ASCII byte
del: 127.u8

# the space character
space: 32.u8

# `"`
doubleQuote: 34.u8

# `#`
hash: 35.u8

# `(`
parenOpen: 40.u8

# `)`
parenClose: 41.u8

# `,`
comma: 44.u8

# `.`
dot: 46.u8

# `:`
colon: 58.u8

# `;`
semicolon: 59.u8

# `[`
bracketOpen: 91.u8

# `]`
bracketClose: 93.u8

# `` ` ``
backtick: 96.u8

# `{`
braceOpen: 123.u8

# `}`
braceClose: 125.u8

# isDigit -- a decimal digit, `0` to `9`
isDigit: function {b: u8} out bool is {
    return (b >= 0c0) and (b <= 0c9)
}

# isHexDigit -- a hexadecimal digit: `0` to `9`, `a` to `f` or `A` to `F`
isHexDigit: function {b: u8} out bool is {
    return (isDigit :b) or ((b >= 0ca) and (b <= 0cf)) or ((b >= 0cA) and (b <= 0cF))
}

# isUpper -- a capital letter, `A` to `Z`
isUpper: function {b: u8} out bool is {
    return (b >= 0cA) and (b <= 0cZ)
}

# isLower -- a small letter, `a` to `z`
isLower: function {b: u8} out bool is {
    return (b >= 0ca) and (b <= 0cz)
}

# isLetter -- a letter of either case
isLetter: function {b: u8} out bool is {
    return (isUpper :b) or (isLower :b)
}

# isWord -- a byte of a name as most languages spell one: a letter, a digit
# or `_`
isWord: function {b: u8} out bool is {
    return (isLetter :b) or (isDigit :b) or (b == 0c_)
}

# isSpace -- white space: the space, the tab, the line feed or the carriage
# return
isSpace: function {b: u8} out bool is {
    return (b == space) or (b == 0c\t) or (b == 0c\n) or (b == cr)
}

# isBlank -- white space within a line: the space or the tab
isBlank: function {b: u8} out bool is {
    return (b == space) or (b == 0c\t)
}
