# ascii -- names for the ASCII bytes a character literal cannot spell. A
# `0c` literal is one identifier token, so it writes any byte an identifier
# may hold (`0cA`, `0c/`, `0c_`) and the escapes `0c\n`, `0c\t`, `0c\b`,
# `0c\\` and `0c\xHH`. The space and the delimiters end an identifier, and
# most control bytes have no escape: those are named here. The control bytes
# keep their ASCII mnemonics; the other names are full words.

# Public interface -- the definitions other units may reference.
public: unit {
    :nul
    :bs
    :ht
    :lf
    :cr
    :del
    :space
    :doubleQuote
    :hash
    :parenOpen
    :parenClose
    :comma
    :dot
    :colon
    :semicolon
    :bracketOpen
    :bracketClose
    :backtick
    :braceOpen
    :braceClose
}

# NUL, the zero byte
nul: 0.u8

# BS, backspace; also written `0c\b`
bs: 8.u8

# HT, the horizontal tab; also written `0c\t`
ht: 9.u8

# LF, the line feed that ends a line; also written `0c\n`
lf: 10.u8

# CR, the carriage return
cr: 13.u8

# DEL, the last ASCII byte
del: 127.u8

# the space character
space: 32.u8

# `"`
doubleQuote: 34.u8

# `#`
hash: 35.u8

# `(`
parenOpen: 40.u8

# `)`
parenClose: 41.u8

# `,`
comma: 44.u8

# `.`
dot: 46.u8

# `:`
colon: 58.u8

# `;`
semicolon: 59.u8

# `[`
bracketOpen: 91.u8

# `]`
bracketClose: 93.u8

# `` ` ``
backtick: 96.u8

# `{`
braceOpen: 123.u8

# `}`
braceClose: 125.u8
