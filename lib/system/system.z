    # true when the two f64 values differ -- and true when either is a NaN
    !=: function {:this rhs: type} out bool is native
    # f64 to u8: fails on a fraction, and outside what u8 can hold
    u8: function {:this} out (resultval t: u8 e: converror) is native
    # f64 to i8: fails on a fraction, and outside what i8 can hold
    i8: function {:this} out (resultval t: i8 e: converror) is native
    # f64 to i16: fails on a fraction, and outside what i16 can hold
    i16: function {:this} out (resultval t: i16 e: converror) is native
    # f64 to i32: fails on a fraction, and outside what i32 can hold
    i32: function {:this} out (resultval t: i32 e: converror) is native
    # f64 to i64: fails on a fraction, and outside what i64 can hold
    i64: function {:this} out (resultval t: i64 e: converror) is native
    # f64 to i128: fails on a fraction, and outside what i128 can hold
    i128: function {:this} out (resultval t: i128 e: converror) is native
    # f64 to u16: fails on a fraction, and outside what u16 can hold
    u16: function {:this} out (resultval t: u16 e: converror) is native
    # f64 to u32: fails on a fraction, and outside what u32 can hold
    u32: function {:this} out (resultval t: u32 e: converror) is native
    # f64 to u64: fails on a fraction, and outside what u64 can hold
    u64: function {:this} out (resultval t: u64 e: converror) is native
    # f64 to u128: fails on a fraction, and outside what u128 can hold
    u128: function {:this} out (resultval t: u128 e: converror) is native
    # f64 to f32: STRICT-EXACT, so it fails unless the value round-trips through
    # f32 unchanged
    f32: function {:this} out (resultval t: f32 e: converror) is native
    # f64 to f16: STRICT-EXACT, so it fails unless the value round-trips through
    # f16 unchanged
    f16: function {:this} out (resultval t: f16 e: converror) is native
    # f64 to f128: every f64 is exactly representable in f128, so there is
    # nothing to unwrap
    f128: function {:this} out f128 is native
    # f64 to c8: fails on a fraction, and outside what c8 can hold
    c8: function {:this} out (resultval t: c8 e: converror) is native
    # f64 to c32: fails on a fraction, and outside what c32 can hold
    c32: function {:this} out (resultval t: c32 e: converror) is native
    # the f64 bit pattern as an unsigned integer of the same width, sign and
    # exponent included
    bits: function {:this} out u64 is native
    # x scaled by a power of two, exactly: IEEE 754's scaleB, C99's scalbn. It
    # is not a multiplication -- the exponent moves and the significand does
    # not, so no rounding happens anywhere in the type's range.
    scaleB: function {:this n: i32} out type is native
    # the UNBIASED exponent of x: IEEE 754's logB, C99's ilogb. Subnormals are
    # normalised first, so this is the binade whatever the encoding.
    logB: function {:this} out i32 is native
    # the f64 identity conversion, so a width can be named uniformly even when
    # it does not change
    f64: function {:this} out type is native
    # the zero f64, positive
    create: function {} out type is native
    tag: tag
}

# boolean truth value: true or false.
bool: variant { false: null  true: null } as {
    tag: u8.tag
    # the bool ordering admitting equality
    <=: function {:this rhs: bool} out bool is native
    # orders two bools: false sorts below true
    <: function {:this rhs: bool} out bool is native
    # the bool ordering reversed: true only for true above false
    >: function {:this rhs: bool} out bool is native
    # the reversed bool ordering, admitting equality
    >=: function {:this rhs: bool} out bool is native
    # true when both bools are the same arm
    ==: function {:this rhs: bool} out bool is native
    # true when one bool is true and the other false
    !=: function {:this rhs: bool} out bool is native
}

# intliteral / floatliteral -- the type a numeric literal wears before it is
# pinned. COMPILE-TIME ONLY: neither reaches emission, because either the
# programmer converts explicitly, or the context coerces, or it falls to
# i64 / f64.
#
# The conversions return the BARE target type, never a `resultval`. On a
# scalar a lossy conversion can fail at RUN time and so must be checked; on a
# literal the value is known here, so it either fits -- and the result is
# simply that type -- or it is a compile error. `65.u8` is a u8.
#
# `create: null` because user code cannot make one: a literal type is what the
# checker gives a lexeme, not something a program constructs.
intliteral: record is native as {
    # an integer literal read as i8. CHECKED AT COMPILE TIME: a literal outside
    # -128..127 is a diagnostic naming the value and the range, never a runtime
    # failure
    i8: function {:this} out i8 is native
    # an integer literal read as i16. CHECKED AT COMPILE TIME: a literal outside
    # -32768..32767 is a diagnostic naming the value and the range, never a
    # runtime failure
    i16: function {:this} out i16 is native
    # an integer literal read as i32. CHECKED AT COMPILE TIME: a literal outside
    # -2147483648..2147483647 is a diagnostic naming the value and the range,
    # never a runtime failure
    i32: function {:this} out i32 is native
    # an integer literal read as i64. CHECKED AT COMPILE TIME: a literal outside
    # -2^63..2^63 is a diagnostic naming the value and the range, never a
    # runtime failure
    i64: function {:this} out i64 is native
    # an integer literal read as i128. CHECKED AT COMPILE TIME: a literal
    # outside -2^127..2^127 is a diagnostic naming the value and the range,
    # never a runtime failure
    i128: function {:this} out i128 is native
    # an integer literal read as u8. CHECKED AT COMPILE TIME: a literal outside
    # 0..255 is a diagnostic naming the value and the range, never a runtime
    # failure
    u8: function {:this} out u8 is native
    # an integer literal read as u16. CHECKED AT COMPILE TIME: a literal outside
    # 0..65535 is a diagnostic naming the value and the range, never a runtime
    # failure
    u16: function {:this} out u16 is native
    # an integer literal read as u32. CHECKED AT COMPILE TIME: a literal outside
    # 0..4294967295 is a diagnostic naming the value and the range, never a
    # runtime failure
    u32: function {:this} out u32 is native
    # an integer literal read as u64. CHECKED AT COMPILE TIME: a literal outside
    # 0..2^64 is a diagnostic naming the value and the range, never a runtime
    # failure
    u64: function {:this} out u64 is native
    # an integer literal read as u128. CHECKED AT COMPILE TIME: a literal
    # outside 0..2^128 is a diagnostic naming the value and the range, never a
    # runtime failure
    u128: function {:this} out u128 is native
    # an integer literal read as f16: it must be exactly representable, so a
    # value past 2^11 is refused at compile time
    f16: function {:this} out f16 is native
    # an integer literal read as f32: it must be exactly representable, so a
    # value past 2^24 is refused at compile time
    f32: function {:this} out f32 is native
    # an integer literal read as f64: it must be exactly representable, so a
    # value past 2^53 is refused at compile time
    f64: function {:this} out f64 is native
    # an integer literal read as f128: it must be exactly representable, so a
    # value past 2^113 is refused at compile time
    f128: function {:this} out f128 is native
    # an integer literal read as c8. CHECKED AT COMPILE TIME: a literal outside
    # 0..255 is a diagnostic naming the value and the range, never a runtime
    # failure
    c8: function {:this} out c8 is native
    # an integer literal read as c32. CHECKED AT COMPILE TIME: a literal outside
    # 0..4294967295 is a diagnostic naming the value and the range, never a
    # runtime failure
    c32: function {:this} out c32 is native
    create: null
}

# the float literal declares only the float targets. That is what makes
# `3.5.u8` a plain "no member" rather than a rule written by hand.
floatliteral: record is native as {
    # a float literal read as f16: it must round-trip through f16 exactly, so a
    # value like 0.1 is refused at compile time when f16 cannot hold it
    f16: function {:this} out f16 is native
    # a float literal read as f32: it must round-trip through f32 exactly, so a
    # value like 0.1 is refused at compile time when f32 cannot hold it
    f32: function {:this} out f32 is native
    # a float literal read as f64: it must round-trip through f64 exactly, so a
    # value like 0.1 is refused at compile time when f64 cannot hold it
    f64: function {:this} out f64 is native
    # a float literal read as f128: it must round-trip through f128 exactly, so
    # a value like 0.1 is refused at compile time when f128 cannot hold it
    f128: function {:this} out f128 is native
    create: null
}

# the unit type -- its one value `null` also spells an empty match/else body.
null: record is native

# an owned, growable UTF-8 text buffer.
String: class is native as {
    :Text
    # byte equality, not identity: two Strings holding the same bytes are equal
    # however each was built
    ==: function {t: this.view rhs: String} out bool is native
    # true when two Strings differ in length or in any byte
    !=: function {t: this.view rhs: String} out bool is native
    # byte-lexicographic ordering of Strings. Bytes, not codepoints and not
    # collation, so it sorts UTF-8 by encoded order
    <: function {t: this.view rhs: String} out bool is native
    # the String byte ordering, admitting equality
    <=: function {t: this.view rhs: String} out bool is native
    # the String byte ordering reversed
    >: function {t: this.view rhs: String} out bool is native
    # the reversed String byte ordering, admitting equality
    >=: function {t: this.view rhs: String} out bool is native
    # the three-way form the String orderings are built on: negative, zero or
    # positive as this sorts before, with, or after rhs. A sort wants this one,
    # not four comparisons
    compare: function {t: this.view rhs: String} out i32 is native
    # `+` BUILDS: it allocates a new owned String from this text and `rhs`,
    # leaving both operands untouched -- the same operation `StringView.concat`
    # spells as a method, and the same on a String receiver as on a view, so
    # `a + b` does not change meaning with the ownership of `a`. To accumulate
    # in place without allocating, use `append`.
    +: function as { T: StringLike.generic } in {t: this.view rhs: T} out String is native
    # a borrowed view over these bytes. It copies nothing, so it must not
    # outlive the String it came from
    stringView: function {t: this.view} outx StringView is native
    # a borrowed view over the bytes in [from, to), counted in BYTES. It does
    # not check that the ends fall on codepoint boundaries
    substring: function {t: this.view from: u64 to: u64} outx StringView is native
    # the BYTE count. `count` is the codepoint count, and the two differ for any
    # non-ASCII text
    length: function {t: this.view} out u64 is native
    # the CODEPOINT count, which walks the bytes to find it. `length` is the
    # byte count and is the cheap one
    count: function {t: this.view} out u64 is native
    # owner-only: capacity describes the allocation, not the text -- a
    # borrowed reference has no owned buffer to report on.
    capacity: function {:this} out u64 is native
    # true when the String's leading bytes are the prefix; a byte test, so it
    # never splits a codepoint in half
    startsWith: function as { T: StringLike.generic } in {t: this.view prefix: T} out bool is native
    # true when the String's trailing bytes are the suffix, compared as bytes
    endsWith: function as { T: StringLike.generic } in {t: this.view suffix: T} out bool is native
    # true when the needle's bytes appear anywhere in the String
    contains: function as { T: StringLike.generic } in {t: this.view needle: T} out bool is native
    # append any string-like value's bytes, growing the buffer as needed
    append: function as { T: StringLike.generic } in {:this s: T} is native
    # append one raw byte. It can leave the String holding incomplete UTF-8
    # until the rest of a sequence arrives, which is the point when decoding
    appendByte: function {:this b: u8} is native
    # grow the buffer to hold at least n bytes now, so a build of known size
    # does not reallocate as it goes
    reserve: function {:this n: u64} is native
    # give back the capacity the current contents do not need
    shrink: function {:this} is native
    # an owned duplicate. A bare String binding MOVES, so this is how two live
    # values are had
    copy: function {t: this.view} out String is native
    # the CONTENT hash Map and Set key on, so two Strings that compare equal
    # hash alike
    hash: function {t: this.view} out u64 is native
    # the empty String
    create: function {} out type is native
}

# a borrowed view over UTF-8 text (no ownership).
StringView: class is native as {
    # the byte count of the viewed range
    length: function {t: this.view} out u64 is native
    # an OWNED copy of the viewed bytes. The view borrows, so this is what
    # outlives the source
    string: function {t: this.view} out String is native
    # the borrowed-String projection of a view: no allocation, no copy --
    # the result aliases the view's bytes and may only be read.
    asString: function {t: this.view} outx String.view is native
    # byte equality of two views; what they are views INTO does not enter into
    # it
    ==: function {t: this.view rhs: StringView} out bool is native
    # true when two StringViews differ in length or in any byte
    !=: function {t: this.view rhs: StringView} out bool is native
    # byte-lexicographic ordering of views, matching String's so the two sort
    # together
    <: function {t: this.view rhs: StringView} out bool is native
    # the StringView byte ordering, admitting equality
    <=: function {t: this.view rhs: StringView} out bool is native
    # the StringView byte ordering reversed
    >: function {t: this.view rhs: StringView} out bool is native
    # the reversed StringView byte ordering, admitting equality
    >=: function {t: this.view rhs: StringView} out bool is native
    # the three-way form the StringView orderings are built on: negative, zero
    # or positive as this sorts before, with, or after rhs
    compare: function {t: this.view rhs: StringView} out i32 is native

    # `+` BUILDS a new owned String from this view and `rhs`; `concat` below is
    # the same operation spelled as a method. Neither operand is modified.
    +: function as { T: StringLike.generic } in {t: this.view rhs: T} out String is native

    # -- non-allocating queries --------------------------------------

    # Empty view (length == 0).
    isEmpty: function {t: this.view} out bool is native

    # Every byte is < 0x80. O(n) byte walk.
    isAscii: function {t: this.view} out bool is native

    # Does this view begin with `prefix`? Empty prefix always matches.
    startsWith: function as { T: StringLike.generic } in {t: this.view prefix: T} out bool is native

    # Does this view end with `suffix`? Empty suffix always matches.
    endsWith: function as { T: StringLike.generic } in {t: this.view suffix: T} out bool is native

    # Does this view contain `needle` as a byte substring?
    contains: function as { T: StringLike.generic } in {t: this.view needle: T} out bool is native

    # Byte index of the first occurrence of `needle`, or `none`.
    # Empty needle matches at index 0.
    indexOf: function as { T: StringLike.generic } in {
        # the view searched, left to right
        t: this.view
        # the bytes looked for; an empty needle matches at 0
        needle: T
    } out (optionval u64) is native

    # Byte index of the last occurrence of `needle`, or `none`.
    # Empty needle matches at index length.
    lastIndexOf: function as { T: StringLike.generic } in {
        # the view searched, right to left
        t: this.view
        # the bytes looked for; the LAST match wins, which is the only difference
        # from indexOf
        needle: T
    } out (optionval u64) is native

    # Byte at `i`, or `none` if out of range. Returns raw bytes,
    # NOT codepoints; use `codepoints` for decoded text.
    byteAt: function {t: this.view i: u64} out (optionval u8) is native

    # -- view-returning slicing helpers ------------------------------
    # All return a stringView borrowed from the same source as this.

    # Byte-range view over [from, to): borrowed from the same source as
    # this. Panics when from > to or to > length.
    substring: function {t: this.view from: u64 to: u64} out StringView is native

    # Strip ASCII whitespace from both ends (space, tab, CR, LF, VT, FF).
    trim: function {t: this.view} out StringView is native

    # Strip leading ASCII whitespace.
    trimStart: function {t: this.view} out StringView is native

    # Strip trailing ASCII whitespace.
    trimEnd: function {t: this.view} out StringView is native

    # Remove `p` from the start; return `some rest` on match,
    # `none` otherwise.
    stripPrefix: function as { T: StringLike.generic } in {
        # the view to strip
        t: this.view
        # the prefix to remove; the view comes back unchanged when it is not there,
        # rather than an error
        p: T
    } out (Option StringView) is native

    # Remove `s` from the end; return `some rest` on match,
    # `none` otherwise.
    stripSuffix: function as { T: StringLike.generic } in {
        # the view to strip
        t: this.view
        # the suffix to remove; absent means the view comes back unchanged
        s: T
    } out (Option StringView) is native

    # -- splitting (iterator-based) ----------------------------------
    # See `splitter`, `linesiter` below for the iterator classes.

    # Split this view at every occurrence of `sep`. Returns an
    # iterator; use with `for piece: ... loop { }`. Empty `sep`
    # yields no iterations (documented).
    split: function as { T: StringLike.generic } in {t: this.view sep: T} out Splitter is native

    # Byte index of the first `sep`, or `none`. Lets callers slice
    # the view themselves (see doc/os.pdoc splitOnce pattern).
    # Empty sep returns some(0).
    splitOnce: function as { T: StringLike.generic } in {
        # the view to cut
        t: this.view
        # the separator; the FIRST occurrence cuts, and it belongs to neither half
        sep: T
    } out (optionval u64) is native

    # Iterate lines (split on '\n', strip a paired '\r\n'). Empty
    # trailing line dropped.
    lines: function {t: this.view} out LinesIter is native

    # -- allocating transforms ---------------------------------------
    # Every method here allocates a new owned string.

    # ASCII-only lowercasing. Bytes [A-Z] are lowercased; non-ASCII
    # bytes (codepoints >= 0x80) pass through unchanged.
    toLowerAscii: function {t: this.view} out String is native

    # ASCII-only uppercasing.
    toUpperAscii: function {t: this.view} out String is native

    # Replace every occurrence of `needle` with `replacement`.
    # Empty `needle` returns a copy of this unchanged.
    replace: function as { T: StringLike.generic U: StringLike.generic } in {
        # the view to rewrite
        t: this.view
        # the bytes replaced -- EVERY occurrence, left to right
        needle: T
        # what each occurrence becomes; it may be longer or shorter than the needle,
        # and empty deletes
        replacement: U
    } out String is native

    # Replace only the first occurrence of `needle`.
    replaceFirst: function as { T: StringLike.generic U: StringLike.generic } in {
        # the view to rewrite
        t: this.view
        # the bytes replaced -- only the FIRST occurrence
        needle: T
        # what that one occurrence becomes; empty deletes it
        replacement: U
    } out String is native

    # Concatenation of this repeated `n` times. `n = 0` returns
    # the empty string. Named `repeated` because `repeat` is a
    # reserved control-flow keyword.
    repeated: function {t: this.view n: u64} out String is native

    # Concatenate this and `other` into one new owned string.
    concat: function as { T: StringLike.generic } in {t: this.view other: T} out String is native

    # -- codepoint iteration + count ---------------------------------

    # Codepoint count (O(n) UTF-8 walk). Distinct from `.length`
    # which returns byte count.
    count: function {t: this.view} out u64 is native

    # Codepoint iterator. Each `.call` yields the next decoded
    # codepoint as a u32. Ill-formed bytes are replaced with
    # U+FFFD and the iterator advances one byte.
    codepoints: function {t: this.view} out CpIter is native

    # -- numeric parsing ---------------------------------------------
    # Each parse_* consumes the whole view. Optional leading sign
    # (parseI64 / parseF64) and decimal digits; no whitespace,
    # no underscore separators, no radix prefix.

    # the WHOLE view as a signed decimal integer. A partial parse is a failure,
    # not a prefix match, so surrounding space or a trailing unit is an err
    # rather than a silent 0
    parseI64: function {t: this.view} out (resultval t: i64 e: parseerror) is native
    # the whole view as an unsigned decimal integer. A leading `-` is an err
    # here rather than a wrap, which is what makes it different from parseI64
    parseU64: function {t: this.view} out (resultval t: u64 e: parseerror) is native
    # the whole view as an f64. Nothing may follow the number, so a trailing
    # unit is an err rather than a silently truncated parse
    parseF64: function {t: this.view} out (resultval t: f64 e: parseerror) is native
    # the whole view as an f16, which holds far less than the decimal text can
    # spell -- the value is rounded to what f16 has
    parseF16: function {t: this.view} out (resultval t: f16 e: parseerror) is native
    # the whole view as an f128, the widest float parse; nothing may follow the
    # number
    parseF128: function {t: this.view} out (resultval t: f128 e: parseerror) is native

    # SipHash-1-3 of the view bytes using the per-process random
    # seed. NOT deterministic across runs.
    hash: function {t: this.view} out u64 is native
}

# Codepoint iterator. Built by `stringView.codepoints`.
CpIter: class is native as {
    # the iterator step: the next codepoint, or none once the view is exhausted
    call: function {:this} out (optionval u32) is native
}

# Splitter iterator. Built by `stringView.split`. Opaque: fields are
# managed by the runtime. The call method yields one substring view
# per iteration and returns `option.none` when exhausted.
Splitter: class is native as {
    # the iterator step: the next field, or none once the last has been yielded.
    # An empty input still yields one empty field
    call: function {:this} out (Option StringView) is native
}

# Line iterator. Built by `stringView.lines`.
LinesIter: class is native as {
    # the iterator step: the next line without its terminator, or none at the
    # end
    call: function {:this} out (Option StringView) is native
}

# Protocol: any type that can be viewed as a StringView. The returned
# view references the parent's storage; the view-lifetime rules pin the
# parent for the view's lifetime. The receiver carries no marker so both
# reftype and valtype implementors (the `String` class, the `str`
# record) can conform.
Text: protocol {
    # the bytes a conforming type exposes. Conforming to Text is how a type
    # joins StringLike and so becomes accepted wherever a string is
    stringView: function {:this} out StringView
}

# Heterogeneous union used as a generic constraint: `:StringView`
# (concrete) + `:Text` (protocol). At compile time, `T: StringLike.generic`
# accepts T if T is `StringView` or T declares `:Text` conformance.
# Matched in declaration order — first match wins. See
# docs/spec.pdoc "Heterogeneous union constraints" for the full rule
# (compile-time vs runtime semantics, declaration-order precedence).
StringLike: union { :StringView :Text }

# valhashable -- a valtype usable as a Map key or Set element. The compiler
# synthesises `hash` (a byte hash over the contents) and `==` (a byte compare)
# for every valtype that owns no heap members, so conformance is implicit and
# needs no declaration. Declaring either member overrides the default; `==:
# null` / `hash: null` strikes it off and the type stops being hashable.
#
# A heap-owning record or variant is NOT hashable: a byte range cannot cover a
# member that lives behind a pointer.
valhashable: facet {
    # the value hash a Map or Set keys on. A valtype IS a byte range, so this
    # one can be synthesised -- which is the whole reason the facet exists
    hash: function {:this} out u64
    # value equality, and it travels with hash: two values that compare equal
    # must hash alike or a Map will lose one of them
    ==: function {:this rhs: type} out bool
}

# RefHashable -- a reftype usable as a Map key or Set element. There is no
# synthesised default here: a class's or union's contents live behind a
# pointer, so a byte hash of the handle would key on IDENTITY rather than on
# value, silently and usually wrongly. A conforming type declares both members
# and says which it meant. `String` and `StringView` already do.
RefHashable: protocol {
    # the CONTENT hash, which a conforming reftype must write itself. Nothing is
    # synthesised: a byte hash of the handle would key on IDENTITY, silently and
    # usually wrongly
    hash: function {:this} out u64
    # content equality the conforming type defines, paired with hash on the same
    # terms: equal values must hash alike
    ==: function {:this rhs: type} out bool
}

# idkey -- the key of an IdMap or IdSet: an unsigned scalar id. Those
# containers index on the key's own bits instead of on a hash of them, so the
# bound says which keys may be indexed that way. Signed types are excluded --
# an id space is an unsigned count, and masking a negative number is not an
# index -- and so is every reference: a pointer's low bits are alignment
# padding, which would collapse the index. A typedef over one of these is one
# of these, which is how an id space is usually written
# (`declid: record { val: u64.typedef }`).
idkey: variant { :u8 :u16 :u32 :u64 :c8 :c32 }

# the bottom type -- a function returning `never` never returns (it errors, panics, or exits).
never: record is native

# the top type: any reftype or valtype; the generic bound that accepts
# everything. A declaration that names it is saying the family genuinely does
# not matter -- `typedef` wraps both, `Box` cells both, `Iterator` yields
# either, `return` takes anything.
Any: union is native

# the reftype bound: classes, unions, protocols, String, and the reference
# containers. Spelled `AnyRef.generic` on a generic parameter.
AnyRef: union is native

# the valtype bound: records, variants, facets, arrays and the numeric
# scalars. Spelled `anyval.generic` on a generic parameter.
anyval: variant is native

# an optional reftype value -- `some t` or `none`.
Option: union {
    # no value at all -- `o.none` is the predicate, so this arm is usually
    # tested rather than matched
    none: null
    # the value when there is one. A match arm narrows to it; returning it needs
    # .copy or .take, since the payload belongs to the subject
    some: T
} as {
    # the REFERENCE type wrapped. Option is the reftype wrapper and optionval
    # the valtype one, because the two are laid out differently
    T: AnyRef.generic
}

# an optional valtype value, stored inline -- `some t` or `none`.
optionval: variant {
    # no value; the discriminator alone says so, there being nothing to point at
    none: null
    # the value, held BY VALUE -- a valtype payload lives in the option itself
    # rather than behind a pointer
    some: t
} as {
    # the VALUE type wrapped. Option is the reftype twin of this
    t: anyval.generic
    # the payload, or `d` when none -- the whole of a match that only ever
    # wanted the value
    or: function {:this d: t} out t is native
}

# Borrowed-view optional. Used by container iterators (e.g. list,
# map) to yield non-owning views into their source. The .some arm
# is a locked reference into a parent — the optionview holds the
# borrow for its lifetime, releases on destruction. The container
# is locked for the iterator's lifetime; loop bodies see borrowed
# values that cannot be transferred (use .copy explicitly).
OptionView: union {
    # no value to view
    none: null
    # a BORROWED view of the value; it never owns, so it must not outlive what
    # it views
    some: T.borrow
} as {
    # the type viewed, reference or value alike -- a view borrows either
    T: Any.generic
}

# `iterator` -- structural marker generic protocol used as a function
# return-type shape to declare a function as iterator-yielding. Any
# class with a `.call` method returning the appropriate option-wrapper
# of `gives` (Option / optionval / OptionView per `gives`'s ownership
# form) satisfies the marker — no explicit `:Iterator` conformance is
# required. The compiler synthesises such a class for a function whose
# body contains `yield` (see docs/spec.pdoc "Generator functions");
# user code may also return iterator-conforming types built elsewhere.
#
# `gives` is the per-iteration value type (required). `takes` is the
# value type the caller sends back on each `.call` for bidirectional
# generators; it defaults to `null` (the out-only case, drivable by a
# for-loop).
Iterator: protocol {
    Gives: Any.generic
    Accepts: (Any.generic default: null)
}

# Generic two-armed result for reftype-bearing APIs. Used by I/O and
# any other API that wants explicit, pattern-matchable success/failure.
# Mirrors the option/optionval split: `Result` is the union form
# (heap-managed payload, reftype arms -- a valtype ok is spelled
# `(Box T)` and collapses onto the payload cell); `resultval` is the
# variant form (inline tagged storage, valtype arms only).
Result: union {
    # the failure payload, which carries WHICH failure rather than a bare flag
    err: E
    # the success payload
    ok: T
} as {
    # the reference type returned on success
    T: AnyRef.generic
    # the error type; making it a parameter is what lets each subsystem name its
    # own failures
    E: AnyRef.generic
}

# Inline-storage variant counterpart of `result`. Use when both arms
# are valtypes and you want stack-resident, no-allocation results
# (e.g. parseerror from numeric stringView parsers).
resultval: variant {
    # the failure payload, held by value
    err: e
    # the success payload, held by value
    ok: t
} as {
    # the VALUE type returned on success
    t: anyval.generic
    # the value error type -- converror for a conversion, parseerror for a parse
    e: anyval.generic
    # the ok payload, or a panic naming the error. For an err that means a bug
    # rather than a case worth handling
    orPanic: function {:this} out t is native
    # the ok payload, or `d` when this is an err -- the whole of a match that
    # only ever wanted the value
    or: function {:this d: t} out t is native
}

# parseerror -- error variants for stringView numeric-parse methods
# (parseI64 / parseU64 / parseF64). Valtype variant: all arms are
# `null` so the error fits inline with no heap allocation.
parseerror: variant {
    # nothing to parse: the view held no digits at all
    empty: null
    # a byte that is not a digit, which includes a trailing unit or surrounding
    # space -- the WHOLE view must parse
    invalidDigit: null
    # the digits are a number, but not one the target type can hold
    overflow: null
}

# converror -- error variants for lossy numeric conversions (valtype
# variant, all-null arms, inline). outOfRange: the value is outside the
# destination's representable range (also a NaN/Inf float->int, or a
# float->float overflow). precisionLoss: the value is in range but not
# exactly representable (a fractional float->int, an int beyond a float's
# mantissa, or an inexact f64->f32).
converror: variant {
    # the value is outside what the target type can represent
    outOfRange: null
    # the target could hold a value of that size but not THIS one exactly, which
    # is what makes the float conversions strict
    precisionLoss: null
}

# Path -- filesystem path. Class typedef over `string` so paths are
# distinct from arbitrary strings in signatures and have a place for
# path-specific operations (join / parent / basename / extension /
# normalize). String operations flow through via the typedef rule
# (string is a class).
Path: class { val: String.typedef }

# PathView -- read-only borrowed view into a path. Class typedef over
# `stringView`.
PathView: class { val: StringView.typedef }

# a heap cell holding one VALTYPE. Boxing moves a value off the stack and
# leaves an 8-byte pointer behind, which is worth doing for a large record and
# is what a union's valtype arm is spelled with (see the Box arm rule).
#
# A reftype does not need it: a class instance is already a heap pointer, so a
# box around one is a pointer to a pointer. The value-struct reftypes (String,
# List, a union's {tag, data} header) would shrink their STACK footprint, but
# that is a calling-convention question, not an ownership one, and wrapping in
# a class already answers it -- a second spelling would only re-open the
# family/convention confusion that `8b8890a` closed.
Box: class {} as { t: anyval.generic }

# raise a recoverable error carrying message `msg`; does not return.
error: function as { T: StringLike.generic } in { msg: T } out never is native

# abort the program with message `msg`; does not return.
panic: function as { T: StringLike.generic } in { msg: T } out never is native

# return `result` from the enclosing function (a builtin; can be shadowed as a name).
return: function as { T: Any.generic } in { result: T } out never is native


