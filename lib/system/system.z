# system.zero - System definitions here are provided by the compiler

# Every numeric record declares a conversion to each other numeric type
# AND to itself. The identity form (`x.u64` where x is already a u64) is
# a redundant but valid cast that yields the type unchanged; it is also
# the spelling that unwraps a scalar typedef to its base, so it must be
# a real declared member -- a member the checker only tolerated, without
# giving it a result type, could not be bound to a local at all.

# The 128-bit integers and the half/quad-precision floats are implementation
# subunits of this unit (lib/system/system/), one per host-toolchain
# requirement so each carries its own `require:` block. These four names are
# their public spellings.
i128: wideint.i128
u128: wideint.u128
f16: halffloat.f16
f128: quadfloat.f128

# tag - generic type for union/variant discriminators
# Parameterized by discriminator storage type: tag(u8), tag(u16), etc.
tag: record is native as { t: anyval.generic }

# typedef - zero-overhead wrapper type
# Parameterized by the underlying type being wrapped
typedef: record is native as { From: Any.generic }

# unsigned 8-bit integer. Range 0 to 255.
u8: record is native as {
    # u8 addition wraps at 8 bits: 255 + 1 is 0
    +: function {:this rhs: type} out type is native
    # u8 subtraction wraps at 8 bits: 0 - 1 is 255
    -: function {:this rhs: type} out type is native
    # u8 multiplication wraps at 8 bits; everything above bit 7 is discarded
    *: function {:this rhs: type} out type is native
    # u8 truncating division. A ZERO DIVISOR IS NOT GUARDED -- it traps
    /: function {:this rhs: type} out type is native
    # the u8 remainder, taking its sign from the left operand. A zero divisor
    # traps, as for /
    %: function {:this rhs: type} out type is native
    # bitwise AND across u8's 8 bits
    &: function {:this rhs: type} out type is native
    # bitwise OR across u8's 8 bits
    |: function {:this rhs: type} out type is native
    # u8 left shift. The count is read as UNSIGNED, so 8 or more -- a negative
    # count included -- gives 0 rather than undefined behaviour
    <<: function {:this rhs: type} out type is native
    # u8 right shift, filling with zeros. A count of 8 or more gives 0, the
    # count being read as unsigned
    >>: function {:this rhs: type} out type is native
    # bitwise XOR across u8's 8 bits
    ^: function {:this rhs: type} out type is native
    # bitwise complement across u8's 8 bits
    not: function {:this} out type is native
    # the u8 ordering again, admitting equality
    <=: function {:this rhs: type} out bool is native
    # orders two u8 values as UNSIGNED, so 0 is the smallest
    <: function {:this rhs: type} out bool is native
    # the u8 ordering reversed: true when this one is the larger
    >: function {:this rhs: type} out bool is native
    # the reversed u8 ordering, admitting equality
    >=: function {:this rhs: type} out bool is native
    # true when the two u8 values are the same number
    ==: function {:this rhs: type} out bool is native
    # true when the two u8 values differ
    !=: function {:this rhs: type} out bool is native
    # u8 to i8: fails above 127
    i8: function {:this} out (resultval t: i8 e: converror) is native
    # u8 to i16: every u8 fits i16, so there is nothing to unwrap
    i16: function {:this} out i16 is native
    # u8 to i32: every u8 fits i32, so there is nothing to unwrap
    i32: function {:this} out i32 is native
    # u8 to i64: every u8 fits i64, so there is nothing to unwrap
    i64: function {:this} out i64 is native
    # u8 to i128: every u8 fits i128, so there is nothing to unwrap
    i128: function {:this} out i128 is native
    # u8 to u16: every u8 fits u16, so there is nothing to unwrap
    u16: function {:this} out u16 is native
    # u8 to u32: every u8 fits u32, so there is nothing to unwrap
    u32: function {:this} out u32 is native
    # u8 to u64: every u8 fits u64, so there is nothing to unwrap
    u64: function {:this} out u64 is native
    # u8 to u128: every u8 fits u128, so there is nothing to unwrap
    u128: function {:this} out u128 is native
    # u8 to f32: every u8 is exactly representable in f32, so there is nothing
    # to unwrap
    f32: function {:this} out f32 is native
    # u8 to f64: every u8 is exactly representable in f64, so there is nothing
    # to unwrap
    f64: function {:this} out f64 is native
    # u8 to f16: every u8 is exactly representable in f16, so there is nothing
    # to unwrap
    f16: function {:this} out f16 is native
    # u8 to f128: every u8 is exactly representable in f128, so there is nothing
    # to unwrap
    f128: function {:this} out f128 is native
    # the half-open u8 range [from, this): some(from) while from is below this,
    # none at it. `for x: n loop` is sugar for this
    iterate: function {:this from: type} out (optionval type) is native
    # the same u8 range iterate gives; the two names are synonyms
    each: function {:this from: type} out (optionval type) is native
    # u8 to c8: every u8 fits c8, so there is nothing to unwrap
    c8: function {:this} out c8 is native
    # u8 to c32: every u8 fits c32, so there is nothing to unwrap
    c32: function {:this} out c32 is native
    # the u8 identity conversion, so a width can be named uniformly even when it
    # does not change
    u8: function {:this} out type is native
    # the zero u8
    create: function {} out type is native
    tag: tag
}

# an 8-bit character / byte code, backed by u8.
c8: record is native as {
    # c8 addition wraps at 8 bits: 255 + 1 is 0
    +: function {:this rhs: type} out type is native
    # c8 subtraction wraps at 8 bits: 0 - 1 is 255
    -: function {:this rhs: type} out type is native
    # c8 multiplication wraps at 8 bits; everything above bit 7 is discarded
    *: function {:this rhs: type} out type is native
    # c8 truncating division. A ZERO DIVISOR IS NOT GUARDED -- it traps
    /: function {:this rhs: type} out type is native
    # the c8 remainder, taking its sign from the left operand. A zero divisor
    # traps, as for /
    %: function {:this rhs: type} out type is native
    # bitwise AND across c8's 8 bits
    &: function {:this rhs: type} out type is native
    # bitwise OR across c8's 8 bits
    |: function {:this rhs: type} out type is native
    # c8 left shift. The count is read as UNSIGNED, so 8 or more -- a negative
    # count included -- gives 0 rather than undefined behaviour
    <<: function {:this rhs: type} out type is native
    # c8 right shift, filling with zeros. A count of 8 or more gives 0, the
    # count being read as unsigned
    >>: function {:this rhs: type} out type is native
    # bitwise XOR across c8's 8 bits
    ^: function {:this rhs: type} out type is native
    # bitwise complement across c8's 8 bits
    not: function {:this} out type is native
    # the c8 ordering again, admitting equality
    <=: function {:this rhs: type} out bool is native
    # orders two c8 values as UNSIGNED, so 0 is the smallest
    <: function {:this rhs: type} out bool is native
    # the c8 ordering reversed: true when this one is the larger
    >: function {:this rhs: type} out bool is native
    # the reversed c8 ordering, admitting equality
    >=: function {:this rhs: type} out bool is native
    # true when the two c8 values are the same number
    ==: function {:this rhs: type} out bool is native
    # true when the two c8 values differ
    !=: function {:this rhs: type} out bool is native
    # c8 to u8: every c8 fits u8, so there is nothing to unwrap
    u8: function {:this} out u8 is native
    # c8 to i8: fails above 127
    i8: function {:this} out (resultval t: i8 e: converror) is native
    # c8 to i16: every c8 fits i16, so there is nothing to unwrap
    i16: function {:this} out i16 is native
    # c8 to i32: every c8 fits i32, so there is nothing to unwrap
    i32: function {:this} out i32 is native
    # c8 to i64: every c8 fits i64, so there is nothing to unwrap
    i64: function {:this} out i64 is native
    # c8 to i128: every c8 fits i128, so there is nothing to unwrap
    i128: function {:this} out i128 is native
    # c8 to u16: every c8 fits u16, so there is nothing to unwrap
    u16: function {:this} out u16 is native
    # c8 to u32: every c8 fits u32, so there is nothing to unwrap
    u32: function {:this} out u32 is native
    # c8 to u64: every c8 fits u64, so there is nothing to unwrap
    u64: function {:this} out u64 is native
    # c8 to u128: every c8 fits u128, so there is nothing to unwrap
    u128: function {:this} out u128 is native
    # c8 to f32: every c8 is exactly representable in f32, so there is nothing
    # to unwrap
    f32: function {:this} out f32 is native
    # c8 to f64: every c8 is exactly representable in f64, so there is nothing
    # to unwrap
    f64: function {:this} out f64 is native
    # c8 to f16: every c8 is exactly representable in f16, so there is nothing
    # to unwrap
    f16: function {:this} out f16 is native
    # c8 to f128: every c8 is exactly representable in f128, so there is nothing
    # to unwrap
    f128: function {:this} out f128 is native
    # c8 to c32: every c8 fits c32, so there is nothing to unwrap
    c32: function {:this} out c32 is native
    # the c8 identity conversion, so a width can be named uniformly even when it
    # does not change
    c8: function {:this} out type is native
    # the zero c8
    create: function {} out type is native
    tag: tag
}

# a Unicode-scalar / 32-bit character code, backed by u32.
c32: record is native as {
    # c32 addition wraps at 32 bits: 4294967295 + 1 is 0
    +: function {:this rhs: type} out type is native
    # c32 subtraction wraps at 32 bits: 0 - 1 is 4294967295
    -: function {:this rhs: type} out type is native
    # c32 multiplication wraps at 32 bits; everything above bit 31 is discarded
    *: function {:this rhs: type} out type is native
    # c32 truncating division. A ZERO DIVISOR IS NOT GUARDED -- it traps
    /: function {:this rhs: type} out type is native
    # the c32 remainder, taking its sign from the left operand. A zero divisor
    # traps, as for /
    %: function {:this rhs: type} out type is native
    # bitwise AND across c32's 32 bits
    &: function {:this rhs: type} out type is native
    # bitwise OR across c32's 32 bits
    |: function {:this rhs: type} out type is native
    # c32 left shift. The count is read as UNSIGNED, so 32 or more -- a negative
    # count included -- gives 0 rather than undefined behaviour
    <<: function {:this rhs: type} out type is native
    # c32 right shift, filling with zeros. A count of 32 or more gives 0, the
    # count being read as unsigned
    >>: function {:this rhs: type} out type is native
    # bitwise XOR across c32's 32 bits
    ^: function {:this rhs: type} out type is native
    # bitwise complement across c32's 32 bits
    not: function {:this} out type is native
    # the c32 ordering again, admitting equality
    <=: function {:this rhs: type} out bool is native
    # orders two c32 values as UNSIGNED, so 0 is the smallest
    <: function {:this rhs: type} out bool is native
    # the c32 ordering reversed: true when this one is the larger
    >: function {:this rhs: type} out bool is native
    # the reversed c32 ordering, admitting equality
    >=: function {:this rhs: type} out bool is native
    # true when the two c32 values are the same number
    ==: function {:this rhs: type} out bool is native
    # true when the two c32 values differ
    !=: function {:this rhs: type} out bool is native
    # c32 to u8: fails above 255
    u8: function {:this} out (resultval t: u8 e: converror) is native
    # c32 to i8: fails above 127
    i8: function {:this} out (resultval t: i8 e: converror) is native
    # c32 to i16: fails above 32767
    i16: function {:this} out (resultval t: i16 e: converror) is native
    # c32 to i32: fails above 2147483647
    i32: function {:this} out (resultval t: i32 e: converror) is native
    # c32 to i64: every c32 fits i64, so there is nothing to unwrap
    i64: function {:this} out i64 is native
    # c32 to i128: every c32 fits i128, so there is nothing to unwrap
    i128: function {:this} out i128 is native
    # c32 to u16: fails above 65535
    u16: function {:this} out (resultval t: u16 e: converror) is native
    # c32 to u32: every c32 fits u32, so there is nothing to unwrap
    u32: function {:this} out u32 is native
    # c32 to u64: every c32 fits u64, so there is nothing to unwrap
    u64: function {:this} out u64 is native
    # c32 to u128: every c32 fits u128, so there is nothing to unwrap
    u128: function {:this} out u128 is native
    # c32 to f32: fails past 2^24, where the nearest f32 stops being the value
    f32: function {:this} out (resultval t: f32 e: converror) is native
    # c32 to f64: every c32 is exactly representable in f64, so there is nothing
    # to unwrap
    f64: function {:this} out f64 is native
    # c32 to f16: fails past 2^11, where the nearest f16 stops being the value
    f16: function {:this} out (resultval t: f16 e: converror) is native
    # c32 to f128: every c32 is exactly representable in f128, so there is
    # nothing to unwrap
    f128: function {:this} out f128 is native
    # c32 to c8: fails above 255
    c8: function {:this} out (resultval t: c8 e: converror) is native
    # the c32 identity conversion, so a width can be named uniformly even when
    # it does not change
    c32: function {:this} out type is native
    # the zero c32
    create: function {} out type is native
    tag: tag
}

# signed 8-bit integer. Range -128 to 127.
i8: record is native as {
    # i8 addition wraps at 8 bits: 127 + 1 is -128
    +: function {:this rhs: type} out type is native
    # i8 subtraction wraps at 8 bits: -128 - 1 is 127
    -: function {:this rhs: type} out type is native
    # i8 multiplication wraps at 8 bits; everything above bit 7 is discarded
    *: function {:this rhs: type} out type is native
    # i8 truncating division. A ZERO DIVISOR IS NOT GUARDED -- it traps
    /: function {:this rhs: type} out type is native
    # the i8 remainder, taking its sign from the left operand. A zero divisor
    # traps, as for /
    %: function {:this rhs: type} out type is native
    # bitwise AND across i8's 8 bits
    &: function {:this rhs: type} out type is native
    # bitwise OR across i8's 8 bits
    |: function {:this rhs: type} out type is native
    # i8 left shift. The count is read as UNSIGNED, so 8 or more -- a negative
    # count included -- gives 0 rather than undefined behaviour
    <<: function {:this rhs: type} out type is native
    # i8 ARITHMETIC right shift: the sign bit fills, so a negative value stays
    # negative. `bits` spells the logical shift. A count of 8 or more is the
    # sign fill
    >>: function {:this rhs: type} out type is native
    # bitwise XOR across i8's 8 bits
    ^: function {:this rhs: type} out type is native
    # bitwise complement across i8's 8 bits
    not: function {:this} out type is native
    # the i8 ordering again, admitting equality
    <=: function {:this rhs: type} out bool is native
    # orders two i8 values as SIGNED, so -128 is the smallest
    <: function {:this rhs: type} out bool is native
    # the i8 ordering reversed: true when this one is the larger
    >: function {:this rhs: type} out bool is native
    # the reversed i8 ordering, admitting equality
    >=: function {:this rhs: type} out bool is native
    # true when the two i8 values are the same number
    ==: function {:this rhs: type} out bool is native
    # true when the two i8 values differ
    !=: function {:this rhs: type} out bool is native
    # i8 to u8: fails below 0
    u8: function {:this} out (resultval t: u8 e: converror) is native
    # i8 to i16: every i8 fits i16, so there is nothing to unwrap
    i16: function {:this} out i16 is native
    # i8 to i32: every i8 fits i32, so there is nothing to unwrap
    i32: function {:this} out i32 is native
    # i8 to i64: every i8 fits i64, so there is nothing to unwrap
    i64: function {:this} out i64 is native
    # i8 to i128: every i8 fits i128, so there is nothing to unwrap
    i128: function {:this} out i128 is native
    # i8 to u16: fails below 0
    u16: function {:this} out (resultval t: u16 e: converror) is native
    # i8 to u32: fails below 0
    u32: function {:this} out (resultval t: u32 e: converror) is native
    # i8 to u64: fails below 0
    u64: function {:this} out (resultval t: u64 e: converror) is native
    # i8 to u128: fails below 0
    u128: function {:this} out (resultval t: u128 e: converror) is native
    # i8 to f32: every i8 is exactly representable in f32, so there is nothing
    # to unwrap
    f32: function {:this} out f32 is native
    # i8 to f64: every i8 is exactly representable in f64, so there is nothing
    # to unwrap
    f64: function {:this} out f64 is native
    # i8 to f16: every i8 is exactly representable in f16, so there is nothing
    # to unwrap
    f16: function {:this} out f16 is native
    # i8 to f128: every i8 is exactly representable in f128, so there is nothing
    # to unwrap
    f128: function {:this} out f128 is native
    # the half-open i8 range [from, this): some(from) while from is below this,
    # none at it. `for x: n loop` is sugar for this
    iterate: function {:this from: type} out (optionval type) is native
    # the same i8 range iterate gives; the two names are synonyms
    each: function {:this from: type} out (optionval type) is native
    # i8 to c8: fails below 0
    c8: function {:this} out (resultval t: c8 e: converror) is native
    # i8 to c32: fails below 0
    c32: function {:this} out (resultval t: c32 e: converror) is native
    # the same 8 bits read as u8, which is how a logical shift of a signed i8 is
    # spelled
    bits: function {:this} out u8 is native
    # the i8 identity conversion, so a width can be named uniformly even when it
    # does not change
    i8: function {:this} out type is native
    # the zero i8
    create: function {} out type is native
    tag: tag
}

# signed 16-bit integer. Range -32768 to 32767.
i16: record is native as {
    # i16 addition wraps at 16 bits: 32767 + 1 is -32768
    +: function {:this rhs: type} out type is native
    # i16 subtraction wraps at 16 bits: -32768 - 1 is 32767
    -: function {:this rhs: type} out type is native
    # i16 multiplication wraps at 16 bits; everything above bit 15 is discarded
    *: function {:this rhs: type} out type is native
    # i16 truncating division. A ZERO DIVISOR IS NOT GUARDED -- it traps
    /: function {:this rhs: type} out type is native
    # the i16 remainder, taking its sign from the left operand. A zero divisor
    # traps, as for /
    %: function {:this rhs: type} out type is native
    # bitwise AND across i16's 16 bits
    &: function {:this rhs: type} out type is native
    # bitwise OR across i16's 16 bits
    |: function {:this rhs: type} out type is native
    # i16 left shift. The count is read as UNSIGNED, so 16 or more -- a negative
    # count included -- gives 0 rather than undefined behaviour
    <<: function {:this rhs: type} out type is native
    # i16 ARITHMETIC right shift: the sign bit fills, so a negative value stays
    # negative. `bits` spells the logical shift. A count of 16 or more is the
    # sign fill
    >>: function {:this rhs: type} out type is native
    # bitwise XOR across i16's 16 bits
    ^: function {:this rhs: type} out type is native
    # bitwise complement across i16's 16 bits
    not: function {:this} out type is native
    # the i16 ordering again, admitting equality
    <=: function {:this rhs: type} out bool is native
    # orders two i16 values as SIGNED, so -32768 is the smallest
    <: function {:this rhs: type} out bool is native
    # the i16 ordering reversed: true when this one is the larger
    >: function {:this rhs: type} out bool is native
    # the reversed i16 ordering, admitting equality
    >=: function {:this rhs: type} out bool is native
    # true when the two i16 values are the same number
    ==: function {:this rhs: type} out bool is native
    # true when the two i16 values differ
    !=: function {:this rhs: type} out bool is native
    # i16 to u8: fails outside 0..255
    u8: function {:this} out (resultval t: u8 e: converror) is native
    # i16 to i8: fails outside -128..127
    i8: function {:this} out (resultval t: i8 e: converror) is native
    # i16 to i32: every i16 fits i32, so there is nothing to unwrap
    i32: function {:this} out i32 is native
    # i16 to i64: every i16 fits i64, so there is nothing to unwrap
    i64: function {:this} out i64 is native
    # i16 to i128: every i16 fits i128, so there is nothing to unwrap
    i128: function {:this} out i128 is native
    # i16 to u16: fails below 0
    u16: function {:this} out (resultval t: u16 e: converror) is native
    # i16 to u32: fails below 0
    u32: function {:this} out (resultval t: u32 e: converror) is native
    # i16 to u64: fails below 0
    u64: function {:this} out (resultval t: u64 e: converror) is native
    # i16 to u128: fails below 0
    u128: function {:this} out (resultval t: u128 e: converror) is native
    # i16 to f32: every i16 is exactly representable in f32, so there is nothing
    # to unwrap
    f32: function {:this} out f32 is native
    # i16 to f64: every i16 is exactly representable in f64, so there is nothing
    # to unwrap
    f64: function {:this} out f64 is native
    # i16 to f16: fails past 2^11, where the nearest f16 stops being the value
    f16: function {:this} out (resultval t: f16 e: converror) is native
    # i16 to f128: every i16 is exactly representable in f128, so there is
    # nothing to unwrap
    f128: function {:this} out f128 is native
    # the half-open i16 range [from, this): some(from) while from is below this,
    # none at it. `for x: n loop` is sugar for this
    iterate: function {:this from: type} out (optionval type) is native
    # the same i16 range iterate gives; the two names are synonyms
    each: function {:this from: type} out (optionval type) is native
    # i16 to c8: fails outside 0..255
    c8: function {:this} out (resultval t: c8 e: converror) is native
    # i16 to c32: fails below 0
    c32: function {:this} out (resultval t: c32 e: converror) is native
    # the same 16 bits read as u16, which is how a logical shift of a signed i16
    # is spelled
    bits: function {:this} out u16 is native
    # the i16 identity conversion, so a width can be named uniformly even when
    # it does not change
    i16: function {:this} out type is native
    # the zero i16
    create: function {} out type is native
    tag: tag
}

# signed 32-bit integer. Range -2147483648 to 2147483647.
i32: record is native as {
    # i32 addition wraps at 32 bits: 2147483647 + 1 is -2147483648
    +: function {:this rhs: type} out type is native
    # i32 subtraction wraps at 32 bits: -2147483648 - 1 is 2147483647
    -: function {:this rhs: type} out type is native
    # i32 multiplication wraps at 32 bits; everything above bit 31 is discarded
    *: function {:this rhs: type} out type is native
    # i32 truncating division. A ZERO DIVISOR IS NOT GUARDED -- it traps
    /: function {:this rhs: type} out type is native
    # the i32 remainder, taking its sign from the left operand. A zero divisor
    # traps, as for /
    %: function {:this rhs: type} out type is native
    # bitwise AND across i32's 32 bits
    &: function {:this rhs: type} out type is native
    # bitwise OR across i32's 32 bits
    |: function {:this rhs: type} out type is native
    # i32 left shift. The count is read as UNSIGNED, so 32 or more -- a negative
    # count included -- gives 0 rather than undefined behaviour
    <<: function {:this rhs: type} out type is native
    # i32 ARITHMETIC right shift: the sign bit fills, so a negative value stays
    # negative. `bits` spells the logical shift. A count of 32 or more is the
    # sign fill
    >>: function {:this rhs: type} out type is native
    # bitwise XOR across i32's 32 bits
    ^: function {:this rhs: type} out type is native
    # bitwise complement across i32's 32 bits
    not: function {:this} out type is native
    # the i32 ordering again, admitting equality
    <=: function {:this rhs: type} out bool is native
    # orders two i32 values as SIGNED, so -2147483648 is the smallest
    <: function {:this rhs: type} out bool is native
    # the i32 ordering reversed: true when this one is the larger
    >: function {:this rhs: type} out bool is native
    # the reversed i32 ordering, admitting equality
    >=: function {:this rhs: type} out bool is native
    # true when the two i32 values are the same number
    ==: function {:this rhs: type} out bool is native
    # true when the two i32 values differ
    !=: function {:this rhs: type} out bool is native
    # i32 to u8: fails outside 0..255
    u8: function {:this} out (resultval t: u8 e: converror) is native
    # i32 to i8: fails outside -128..127
    i8: function {:this} out (resultval t: i8 e: converror) is native
    # i32 to i16: fails outside -32768..32767
    i16: function {:this} out (resultval t: i16 e: converror) is native
    # i32 to i64: every i32 fits i64, so there is nothing to unwrap
    i64: function {:this} out i64 is native
    # i32 to i128: every i32 fits i128, so there is nothing to unwrap
    i128: function {:this} out i128 is native
    # i32 to u16: fails outside 0..65535
    u16: function {:this} out (resultval t: u16 e: converror) is native
    # i32 to u32: fails below 0
    u32: function {:this} out (resultval t: u32 e: converror) is native
