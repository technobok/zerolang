# IEEE-754 single-precision (32-bit) floating point.
f32: record is native as {
    # f32 addition, rounded once to the nearest representable value
    +: function {:this rhs: type} out type is native
    # f32 subtraction, rounded once; cancelling two near-equal f32 values loses
    # precision here
    -: function {:this rhs: type} out type is native
    # f32 multiplication, rounded once to nearest
    *: function {:this rhs: type} out type is native
    # f32 division; unlike the integer types a zero divisor gives an infinity
    # rather than trapping
    /: function {:this rhs: type} out type is native
    # the f32 remainder of a truncating division, keeping the left operand's
    # sign
    %: function {:this rhs: type} out type is native
    # the f32 ordering admitting equality -- still false against a NaN
    <=: function {:this rhs: type} out bool is native
    # orders two f32 values; every comparison against a NaN is false, this one
    # included
    <: function {:this rhs: type} out bool is native
    # the f32 ordering reversed; false against a NaN
    >: function {:this rhs: type} out bool is native
    # the reversed f32 ordering admitting equality; false against a NaN
    >=: function {:this rhs: type} out bool is native
    # true when both are the same f32. A NaN equals NOTHING, itself included
    ==: function {:this rhs: type} out bool is native
    # true when the two f32 values differ -- and true when either is a NaN
    !=: function {:this rhs: type} out bool is native
    # f32 to u8: fails on a fraction, and outside what u8 can hold
    u8: function {:this} out (resultval t: u8 e: converror) is native
    # f32 to i8: fails on a fraction, and outside what i8 can hold
    i8: function {:this} out (resultval t: i8 e: converror) is native
    # f32 to i16: fails on a fraction, and outside what i16 can hold
    i16: function {:this} out (resultval t: i16 e: converror) is native
    # f32 to i32: fails on a fraction, and outside what i32 can hold
    i32: function {:this} out (resultval t: i32 e: converror) is native
    # f32 to i64: fails on a fraction, and outside what i64 can hold
    i64: function {:this} out (resultval t: i64 e: converror) is native
    # f32 to i128: fails on a fraction, and outside what i128 can hold
    i128: function {:this} out (resultval t: i128 e: converror) is native
    # f32 to u16: fails on a fraction, and outside what u16 can hold
    u16: function {:this} out (resultval t: u16 e: converror) is native
    # f32 to u32: fails on a fraction, and outside what u32 can hold
    u32: function {:this} out (resultval t: u32 e: converror) is native
    # f32 to u64: fails on a fraction, and outside what u64 can hold
    u64: function {:this} out (resultval t: u64 e: converror) is native
    # f32 to u128: fails on a fraction, and outside what u128 can hold
    u128: function {:this} out (resultval t: u128 e: converror) is native
    # f32 to f64: every f32 is exactly representable in f64, so there is nothing
    # to unwrap
    f64: function {:this} out f64 is native
    # f32 to f16: STRICT-EXACT, so it fails unless the value round-trips through
    # f16 unchanged
    f16: function {:this} out (resultval t: f16 e: converror) is native
    # f32 to f128: every f32 is exactly representable in f128, so there is
    # nothing to unwrap
    f128: function {:this} out f128 is native
    # f32 to c8: fails on a fraction, and outside what c8 can hold
    c8: function {:this} out (resultval t: c8 e: converror) is native
    # f32 to c32: fails on a fraction, and outside what c32 can hold
    c32: function {:this} out (resultval t: c32 e: converror) is native
    # the f32 bit pattern as an unsigned integer of the same width, sign and
    # exponent included
    bits: function {:this} out u32 is native
    # x scaled by a power of two, exactly: IEEE 754's scaleB, C99's scalbn. It
    # is not a multiplication -- the exponent moves and the significand does
    # not, so no rounding happens anywhere in the type's range.
