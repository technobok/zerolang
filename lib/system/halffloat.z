# halffloat -- IEEE-754 half precision. Its own unit for the same reason
# quadfloat and wideint are: a type is only as portable as the compilers that
# can build it, and a unit is what a require: block attaches to.

# tcc has no _Float16. How it fails depends on the host, and one way is worse
# than the other: on Linux it rejects the emitted C outright, but its own
# headers define `_Float16` as `short unsigned int` on macOS -- "a fake type
# just for size & alignment" -- so there the program would COMPILE and quietly
# compute the wrong answers. Saying so here refuses the build in both cases,
# at the point the toolchain is chosen.
#
# gcc and clang need no library for _Float16, so the other arm names none.
require: unit {
    library: if platform.cc == platform.cckind.tcc then {
        error "tcc has no _Float16; build this with gcc or clang"
    } else {
        ""
    }
}

# IEEE-754 half-precision (16-bit) floating point.
f16: record is native as {
    +: function {:this rhs: type} out type is native
    -: function {:this rhs: type} out type is native
    *: function {:this rhs: type} out type is native
    /: function {:this rhs: type} out type is native
    %: function {:this rhs: type} out type is native
    <=: function {:this rhs: type} out bool is native
    <: function {:this rhs: type} out bool is native
    >: function {:this rhs: type} out bool is native
    >=: function {:this rhs: type} out bool is native
    ==: function {:this rhs: type} out bool is native
    !=: function {:this rhs: type} out bool is native
    u8: function {:this} out (resultval t: u8 e: converror) is native
    i8: function {:this} out (resultval t: i8 e: converror) is native
    i16: function {:this} out (resultval t: i16 e: converror) is native
    i32: function {:this} out (resultval t: i32 e: converror) is native
    i64: function {:this} out (resultval t: i64 e: converror) is native
    i128: function {:this} out (resultval t: i128 e: converror) is native
    u16: function {:this} out (resultval t: u16 e: converror) is native
    u32: function {:this} out (resultval t: u32 e: converror) is native
    u64: function {:this} out (resultval t: u64 e: converror) is native
    u128: function {:this} out (resultval t: u128 e: converror) is native
    f32: function {:this} out f32 is native
    f64: function {:this} out f64 is native
    f128: function {:this} out f128 is native
    c8: function {:this} out (resultval t: c8 e: converror) is native
    c32: function {:this} out (resultval t: c32 e: converror) is native
    f16: function {:this} out type is native
    create: function {} out type is native
    tag: tag
}
