# Ported from Go's src/math/big/nat.go at 577b91f341 (2026-09-30) on
# 2026-10-03: unsigned multi-precision integers. A natural number is a ListVal
# of words, least significant first, NORMALIZED -- no leading zero words, and 0
# the empty list. Go returns a fresh or reused `z`; here `z` is the list the
# result is written into, resized as Go's `make` would size it. Go lets `z` alias
# an operand; a list cannot be written while it is read, so a caller that wants
# `z = z op x` writes into a second list, or calls an in-place twin.

# natNorm -- z without its leading zero words
natNorm: function {z: (ListVal u64).borrow} is {
    n: z.length
    for n > 0 while (z.get i: n - 1) == 0 loop n = n - 1
    z.resize to: n
}

# natSetWord -- the one-word natural number x in z: no words at all for 0, which
# is how a normalized number holds it
natSetWord: function {z: (ListVal u64).borrow x: u64} is {
    if x == 0 then {
        z.resize to: 0
        return
    }
    z.resize to: 1
    z.set i: 0 val: x
}

# natSet -- a copy of x, z taking x's length
natSet: function {z: (ListVal u64).borrow x: ListViewVal u64} is {
    z.resize to: x.length
    w: z.mutView
    w.copyFrom from: x
}

# natAdd -- the sum in z: the shorter operand is added word for word, the carry
# then runs on through the rest of the longer, and one word more holds the last
# carry until normalizing drops it
natAdd: function {z: (ListVal u64).borrow x: ListViewVal u64 y: ListViewVal u64} is {
    m: x.length
    n: y.length
    if m < n then {
        natAdd :z x: y y: x
        return
    }
    if m == 0 then {
        z.resize to: 0
        return
    }
    if n == 0 then {
        natSet :z :x
        return
    }
    z.resize to: m + 1
    c: u64
    {
        w: z.mutSlice from: 0 to: n
        c = arith.addVV z: w x: (x.slice from: 0 to: n) y: (y.slice from: 0 to: n)
    }
    if m > n then {
        w: z.mutSlice from: n to: m
        c = arith.addVW z: w x: (x.slice from: n to: m) y: c
    }
    z.set i: m val: c
    natNorm :z
}

# natSub -- z = x - y; panics when y > x, which a natural number cannot hold
natSub: function {z: (ListVal u64).borrow x: ListViewVal u64 y: ListViewVal u64} is {
    m: x.length
    n: y.length
    if m < n then panic msg: "underflow"
    if m == 0 then {
        z.resize to: 0
        return
    }
    if n == 0 then {
        natSet :z :x
        return
    }
    z.resize to: m
    c: u64
    {
        w: z.mutSlice from: 0 to: n
        c = arith.subVV z: w x: (x.slice from: 0 to: n) y: (y.slice from: 0 to: n)
    }
    if m > n then {
        w: z.mutSlice from: n to: m
        c = arith.subVW z: w x: (x.slice from: n to: m) y: c
    }
    if c != 0 then panic msg: "underflow"
    natNorm :z
}

# natCmp -- the order of x and y as -1, 0 or 1
natCmp: function {x: ListViewVal u64 y: ListViewVal u64} out i32 is {
    m: x.length
    n: y.length
    if (m != n) or (m == 0) then {
        if m < n then return -1
        if m > n then return 1
        return 0
    }
    i: m - 1
    for i > 0 while (x.get :i) == (y.get :i) loop i = i - 1
    if (x.get :i) < (y.get :i) then return -1
    if (x.get :i) > (y.get :i) then return 1
    return 0
}

# addTo -- z += x where z is long enough; the result is not normalized, so z
# keeps its length
addTo: function {z: (SpanVal u64).borrow x: ListViewVal u64} is {
    n: x.length
    if n == 0 then return
    c: u64
    {
        lo: z.slice from: 0 to: n
        c = arith.addVVInPlace z: lo y: x
    }
    if c != 0 when n < z.length then {
        hi: z.slice from: n to: z.length
        arith.addVWInPlace z: hi y: c
    }
}

# natBitLen -- the length of x in bits; works on an x that is not normalized
natBitLen: function {x: ListViewVal u64} out u64 is {
    if x.length == 0 then return 0
    i: x.length - 1
    return i * 64 + (x.get :i).bitLength
}

# natTrailingZeroBits -- the number of consecutive zero bits at the bottom of x
natTrailingZeroBits: function {x: ListViewVal u64} out u64 is {
    if x.length == 0 then return 0
    i: u64
    for (x.get :i) == 0 loop i = i + 1
    return i * 64 + (x.get :i).trailingZeros
}

# natLsh -- x shifted up s bits into z: whole words by placement, the rest by
# lshVU, and the vacated low words cleared
natLsh: function {z: (ListVal u64).borrow x: ListViewVal u64 s: u64} is {
    m: x.length
    if m == 0 then {
        z.resize to: 0
        return
    }
    n: m + (s / 64)
    z.resize to: n + 1
    sw: s % 64
    c: u64
    {
        w: z.mutSlice from: n - m to: n
        if sw == 0 then w.copyFrom from: x else c = arith.lshVU z: w :x s: sw
    }
    z.set i: n val: c
    {
        lo: z.mutSlice from: 0 to: n - m
        lo.clear
    }
    natNorm :z
}

# natRsh -- x shifted down s bits into z: the whole words below s dropped, the
# rest by rshVU; zero once s reaches past x's top word
natRsh: function {z: (ListVal u64).borrow x: ListViewVal u64 s: u64} is {
    m: x.length
    if (s / 64) >= m then {
        z.resize to: 0
        return
    }
    n: m - (s / 64)
    z.resize to: n
    sw: s % 64
    {
        w: z.mutView
        if sw == 0 then {
            w.copyFrom from: (x.slice from: m - n to: m)
        } else {
            arith.rshVU z: w x: (x.slice from: m - n to: m) s: sw
        }
    }
    natNorm :z
}

# a bitwise operation on two words, as natBitwise applies it
bitop: variant {
    # x & y
    and: null
    # x & ^y
    andNot: null
    # x | y
    or: null
    # x ^ y
    xor: null
}

# natBitwise -- z = x op y word by word, a missing word read as 0 -- which is
# what makes Go's four loops, each with its own length rule, one loop
natBitwise: function {z: (ListVal u64).borrow x: ListViewVal u64 y: ListViewVal u64 op: bitop} is {
    n: x.length
    if y.length > n then n = y.length
    z.resize to: n
    i: u64
    for i < n loop {
        xi: u64
        yi: u64
        if i < x.length then xi = x.get :i
        if i < y.length then yi = y.get :i
        w: u64
        match (
            op
        ) case and then {
            w = xi & yi
        } case andNot then {
            w = xi & yi.not
        } case or then {
            w = xi | yi
        } case xor then {
            w = xi ^ yi
        }
        z.set :i val: w
        i = i + 1
    }
    natNorm :z
}

# natAddWord -- x plus one word: the x + 1 and x - 1 steps that let a
# two's complement operation work on magnitudes
natAddWord: function {z: (ListVal u64).borrow x: ListViewVal u64 w: u64} is {
    one: ListVal u64
    natSetWord z: one x: w
    natAdd :z :x y: one.listView
}

# natSubWord -- x minus one word, which must not exceed x
natSubWord: function {z: (ListVal u64).borrow x: ListViewVal u64 w: u64} is {
    one: ListVal u64
    natSetWord z: one x: w
    natSub :z :x y: one.listView
}

# natBit -- bit i of x, 0 or 1
natBit: function {x: ListViewVal u64 i: u64} out u64 is {
    j: i / 64
    if j >= x.length then return 0
    return ((x.get i: j) >> (i % 64)) & 1
}

# natSetBit -- z = x with bit i set to b, 0 or 1
natSetBit: function {z: (ListVal u64).borrow x: ListViewVal u64 i: u64 b: u64} is {
    j: i / 64
    m: 1.u64 << (i % 64)
    natSet :z :x
    if b == 0 then {
        if j < z.length then {
            z.set i: j val: (z.get i: j) & m.not
            natNorm :z
        }
        return
    }
    if b != 1 then panic msg: "set bit is not 0 or 1"
    for z.length <= j loop z.append from: 0
    z.set i: j val: (z.get i: j) | m
}
