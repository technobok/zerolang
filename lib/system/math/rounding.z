# Ported from Go's src/math/big/float.go at 577b91f341 (2026-09-30) on
# 2026-10-03: the rounding modes, shared by every math type that rounds, and
# the accuracy a rounded result reports.

# roundingmode -- how a result that falls between two representable values is
# chosen. An integer division (BigInt.divide) takes toZero, toNegativeInf,
# toNearestEven and toPositiveInf, as Go's Divide does
roundingmode: variant {
    # the nearer, a tie to the even one
    toNearestEven: null
    # the nearer, a tie away from zero
    toNearestAway: null
    # toward zero: truncation
    toZero: null
    # away from zero: up in magnitude whatever the sign
    awayFromZero: null
    # toward negative infinity: the floor
    toNegativeInf: null
    # toward positive infinity: the ceiling
    toPositiveInf: null
}

# accuracy -- how a rounded result compares to the exact value it stands for
accuracy: variant {
    # the result is below the exact value
    below: null
    # the result is the exact value
    exact: null
    # the result is above the exact value
    above: null
}
