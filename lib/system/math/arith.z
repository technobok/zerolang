# Ported from Go's src/math/big/arith.go at 577b91f341 (2026-09-30) on
# 2026-10-03: the elementary operations on word vectors. Go's `z == x` alias
# is spelled here as an in-place twin -- a window and a view of one list cannot
# be held at once -- and every vector is a window (written) or a view (read).

# the word size in bits
wordBits: 64

# mulAddWWW -- x*y + c as a two-word number, high word first
mulAddWWW: function {x: u64 y: u64 c: u64} out system.wide is {
    p: x.mulWide rhs: y
    s: p.lo.addCarry rhs: c carry: 0
    return (system.wide hi: p.hi + s.carry lo: s.value)
}

# nlz -- the number of leading zeros in x
nlz: function {x: u64} out u64 is {
    return x.leadingZeros
}

# addVV -- z = x + y over equal lengths, returning the final carry, 0 or 1
addVV: function {
    z: (SpanVal u64).borrow x: (ListViewVal u64).view y: (ListViewVal u64).view
} out u64 is {
    if (x.length != z.length) or (y.length != z.length) then panic msg: "addVV len"
    c: u64
    i: u64
    for i < z.length loop {
        s: (x.get :i).addCarry rhs: (y.get :i) carry: c
        z.set :i item: s.value
        c = s.carry
        i = i + 1
    }
    return c
}

# addVVInPlace -- z += y over equal lengths: addVV with z as its own x
addVVInPlace: function {z: (SpanVal u64).borrow y: (ListViewVal u64).view} out u64 is {
    if y.length != z.length then panic msg: "addVV len"
    c: u64
    i: u64
    for i < z.length loop {
        s: (z.get :i).addCarry rhs: (y.get :i) carry: c
        z.set :i item: s.value
        c = s.carry
        i = i + 1
    }
    return c
}

# subVV -- z = x - y over equal lengths, returning the final borrow, 0 or 1
subVV: function {
    z: (SpanVal u64).borrow x: (ListViewVal u64).view y: (ListViewVal u64).view
} out u64 is {
    if (x.length != z.length) or (y.length != z.length) then panic msg: "subVV len"
    c: u64
    i: u64
    for i < z.length loop {
        s: (x.get :i).subBorrow rhs: (y.get :i) carry: c
        z.set :i item: s.value
        c = s.carry
        i = i + 1
    }
    return c
}

# subVVInPlace -- z -= y over equal lengths: subVV with z as its own x
subVVInPlace: function {z: (SpanVal u64).borrow y: (ListViewVal u64).view} out u64 is {
    if y.length != z.length then panic msg: "subVV len"
    c: u64
    i: u64
    for i < z.length loop {
        s: (z.get :i).subBorrow rhs: (y.get :i) carry: c
        z.set :i item: s.value
        c = s.carry
        i = i + 1
    }
    return c
}

# addVW -- z = x + y for a word y, returning the final carry: y itself when z is
# empty, else 0 or 1
addVW: function {z: (SpanVal u64).borrow x: (ListViewVal u64).view y: u64} out u64 is {
    if x.length != z.length then panic msg: "addVW len"
    c: y
    i: u64
    for i < z.length loop {
        s: (x.get :i).addCarry rhs: c carry: 0
        z.set :i item: s.value
        c = s.carry
        i = i + 1
    }
    return c
}

# addVWInPlace -- z += y for a word y; stops as soon as the carry dies, which is
# what Go's addVW does when z and x are one vector
addVWInPlace: function {z: (SpanVal u64).borrow y: u64} out u64 is {
    c: y
    i: u64
    for i < z.length while c != 0 loop {
        s: (z.get :i).addCarry rhs: c carry: 0
        z.set :i item: s.value
        c = s.carry
        i = i + 1
    }
    return c
}

# subVW -- z = x - y for a word y, returning the final borrow: y itself when z is
# empty, else 0 or 1
subVW: function {z: (SpanVal u64).borrow x: (ListViewVal u64).view y: u64} out u64 is {
    if x.length != z.length then panic msg: "subVW len"
    c: y
    i: u64
    for i < z.length loop {
        s: (x.get :i).subBorrow rhs: c carry: 0
        z.set :i item: s.value
        c = s.carry
        i = i + 1
    }
    return c
}

# subVWInPlace -- z -= y for a word y, stopping once the borrow dies
subVWInPlace: function {z: (SpanVal u64).borrow y: u64} out u64 is {
    c: y
    i: u64
    for i < z.length while c != 0 loop {
        s: (z.get :i).subBorrow rhs: c carry: 0
        z.set :i item: s.value
        c = s.carry
        i = i + 1
    }
    return c
}

# lshVU -- z = x << s for 0 <= s < 64, returning the bits shifted out of the top
lshVU: function {z: (SpanVal u64).borrow x: (ListViewVal u64).view s: u64} out u64 is {
    if x.length != z.length then panic msg: "lshVU len"
    if s == 0 then {
        z.copyFrom from: x
        return 0
    }
    n: z.length
    if n == 0 then return 0
    sh: s & 63
    back: (64.u64 - sh) & 63
    c: (x.get i: n - 1) >> back
    i: n - 1
    for i > 0 loop {
        z.set :i item: ((x.get :i) << sh) | ((x.get i: i - 1) >> back)
        i = i - 1
    }
    z.set i: 0 item: (x.get i: 0) << sh
    return c
}

# lshVUInPlace -- z <<= s for 0 <= s < 64. The words are read from the top
# down, each before it is overwritten, so one vector serves as both
lshVUInPlace: function {z: (SpanVal u64).borrow s: u64} out u64 is {
    n: z.length
    if (s == 0) or (n == 0) then return 0
    sh: s & 63
    back: (64.u64 - sh) & 63
    c: (z.get i: n - 1) >> back
    i: n - 1
    for i > 0 loop {
        z.set :i item: ((z.get :i) << sh) | ((z.get i: i - 1) >> back)
        i = i - 1
    }
    z.set i: 0 item: (z.get i: 0) << sh
    return c
}

# rshVU -- z = x >> s for 0 <= s < 64, returning the bits shifted out of the
# bottom, left-aligned in a word
rshVU: function {z: (SpanVal u64).borrow x: (ListViewVal u64).view s: u64} out u64 is {
    if x.length != z.length then panic msg: "rshVU len"
    if s == 0 then {
        z.copyFrom from: x
        return 0
    }
    n: z.length
    if n == 0 then return 0
    sh: s & 63
    back: (64.u64 - sh) & 63
    c: (x.get i: 0) << back
    i: 1.u64
    for i < n loop {
        z.set i: i - 1 item: ((x.get i: i - 1) >> sh) | ((x.get :i) << back)
        i = i + 1
    }
    z.set i: n - 1 item: (x.get i: n - 1) >> sh
    return c
}

# rshVUInPlace -- z >>= s for 0 <= s < 64. The words are read from the bottom
# up, each before it is overwritten
rshVUInPlace: function {z: (SpanVal u64).borrow s: u64} out u64 is {
    n: z.length
    if (s == 0) or (n == 0) then return 0
    sh: s & 63
    back: (64.u64 - sh) & 63
    c: (z.get i: 0) << back
    i: 1.u64
    for i < n loop {
        z.set i: i - 1 item: ((z.get i: i - 1) >> sh) | ((z.get :i) << back)
        i = i + 1
    }
    z.set i: n - 1 item: (z.get i: n - 1) >> sh
    return c
}

# mulAddVWW -- z = x*y + r for a word y and a word r, returning the high word
# that spills past z
mulAddVWW: function {z: (SpanVal u64).borrow x: (ListViewVal u64).view y: u64 r: u64} out u64 is {
    if x.length != z.length then panic msg: "mulAddVWW len"
    c: r
    i: u64
    for i < z.length loop {
        w: mulAddWWW x: (x.get :i) :y :c
        z.set :i item: w.lo
        c = w.hi
        i = i + 1
    }
    return c
}

# mulAddVWWInPlace -- z = z*y + r for a word y and a word r
mulAddVWWInPlace: function {z: (SpanVal u64).borrow y: u64 r: u64} out u64 is {
    c: r
    i: u64
    for i < z.length loop {
        w: mulAddWWW x: (z.get :i) :y :c
        z.set :i item: w.lo
        c = w.hi
        i = i + 1
    }
    return c
}

# addMulVVWW -- z = x + y*m + a over equal lengths, for words m and a, returning
# the high word that spills past z
addMulVVWW: function {
    z: (SpanVal u64).borrow
    x: (ListViewVal u64).view
    y: (ListViewVal u64).view
    m: u64
    a: u64
} out u64 is {
    if (x.length != z.length) or (y.length != z.length) then panic msg: "addMulVVWW len"
    c: a
    i: u64
    for i < z.length loop {
        w: mulAddWWW x: (y.get :i) y: m c: (x.get :i)
        s: w.lo.addCarry rhs: c carry: 0
        z.set :i item: s.value
        c = s.carry + w.hi
        i = i + 1
    }
    return c
}

# addMulVVW -- z += x*y for a word y over equal lengths: addMulVVWW with z as its
# own x and no addend
addMulVVW: function {z: (SpanVal u64).borrow x: (ListViewVal u64).view y: u64} out u64 is {
    if x.length != z.length then panic msg: "addMulVVW len"
    c: u64
    i: u64
    for i < z.length loop {
        w: mulAddWWW x: (x.get :i) :y c: (z.get :i)
        s: w.lo.addCarry rhs: c carry: 0
        z.set :i item: s.value
        c = s.carry + w.hi
        i = i + 1
    }
    return c
}

# divWW -- (x1<<64 + x0) / y, given m = reciprocalWord y and x1 < y: the
# quotient and the remainder. Improved Division by Invariant Integers (IEEE
# Transactions on Computers, 11 Jun 2010): the estimate is low by at most 2
divWW: function {x1: u64 x0: u64 y: u64 m: u64} out system.divmod is {
    s: nlz x: y
    hi: x1
    lo: x0
    d: y
    if s != 0 then {
        hi = (x1 << s) | (x0 >> (64.u64 - s))
        lo = x0 << s
        d = y << s
    }
    t: m.mulWide rhs: hi
    c: t.lo.addCarry rhs: lo carry: 0
    q: (t.hi.addCarry rhs: hi carry: c.carry).value
    dq: d.mulWide rhs: q
    r0: lo.subBorrow rhs: dq.lo carry: 0
    r1: hi.subBorrow rhs: dq.hi carry: r0.carry
    r: r0.value
    if r1.value != 0 then {
        q = q + 1
        r = r - d
    }
    if r >= d then {
        q = q + 1
        r = r - d
    }
    return (system.divmod quo: q rem: r >> s)
}

# reciprocalWord -- the reciprocal of a divisor for divWW: (2^128 - 1) / u - 2^64,
# where u is d1 shifted until its top bit is set
reciprocalWord: function {d1: u64} out u64 is {
    u: d1 << (nlz x: d1)
    return (u.not.divWide lo: 18446744073709551615 by: u).quo
}
