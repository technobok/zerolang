# Ported from Go's src/math/big/natconv.go at 577b91f341 (2026-09-30) on
# 2026-10-03: conversion between natural numbers and text.

# mulAddInPlace -- one more chunk of digits folded in, z*y + r, z growing by a
# word when the product spills past it
mulAddInPlace: function {z: (ListVal u64).borrow y: u64 r: u64} is {
    m: z.length
    if m == 0 then {
        nat.natSetWord :z x: r
        return
    }
    c: u64
    {
        w: z.mutView
        c = arith.mulAddVWWInPlace z: w :y :r
    }
    if c != 0 then z.append from: c
}

# the digits Go's conversions spell, in value order; bases above 36 tell the
# letters' cases apart
maxBase: 62
maxBaseSmall: 36

# what natScan found wrong, if anything
scanfault: variant {
    # the digits read cleanly
    none: null
    # no digit at all: an empty text, a lone sign, a bare prefix
    noDigits: null
    # an `_` that does not separate two digits
    badSeparator: null
}

# what natScan read
scanned: record {
    # the index just past the last byte that belongs to the number
    end: u64
    # the base the digits were read in: a prefix's, for base 0
    base: u64
    # the digits read, a prefix not counted
    count: u64
    # what was wrong, if anything
    fault: scanfault
}

# natScan -- z = the unsigned number spelled in text from `from` on, for as
# long as bytes are digits of the base. Base 0 reads a prefix -- 0b, 0o, 0x,
# or a bare 0 for octal -- and is 10 without one, and only base 0 lets `_`
# separate digits. Base 2 to 62 otherwise; above 36 the upper case letters
# are digits 36 to 61. Panics on any other base, as Go does
natScan: function {z: (ListVal u64).borrow text: StringView from: u64 base: u64} out scanned is {
    if base != 0 when (base < 2) or (base > maxBase) then panic msg: "invalid number base"
    z.resize to: 0
    pos: from
    # the previous byte's kind: '_', '0' for a digit, '.' for anything else
    prev: 46.u8
    invalSep: false
    count: u64
    b: base
    prefix: u8
    if base == 0 then {
        b = 10
        if pos < text.length when (byteAt :text i: pos) == 48 then {
            prev = 48
            count = 1
            pos = pos + 1
            if pos < text.length then {
                ch: byteAt :text i: pos
                if (ch == 98) or (ch == 66) then {
                    b = 2
                    prefix = 98
                } else if (ch == 111) or (ch == 79) then {
                    b = 8
                    prefix = 111
                } else if (ch == 120) or (ch == 88) then {
                    b = 16
                    prefix = 120
                } else {
                    b = 8
                    prefix = 48
                }
                count = 0
                if prefix != 48 then pos = pos + 1
            }
        }
    }
    # digits gather n at a time in di, then join z: appended whole for the
    # bases that pack exactly into a word (bn == 0), else as z*bn + di
    n: u64
    bn: u64
    if b == 2 then {
        n = 64
    } else if b == 4 then {
        n = 32
    } else if b == 16 then {
        n = 16
    } else {
        n = maxDigits :b
        bn = pow x: b :n
    }
    di: u64
    i: u64
    for pos < text.length loop {
        ch: byteAt :text i: pos
        if (ch == 95) and (base == 0) then {
            if prev != 48 then invalSep = true
            prev = 95
        } else {
            d: digitValue :ch :b
            if d >= b then break
            prev = 48
            count = count + 1
            di = di * b + d
            i = i + 1
            if i == n then {
                if bn == 0 then z.append from: di else mulAddInPlace :z y: bn r: di
                di = 0
                i = 0
            }
        }
        pos = pos + 1
    }
    fault: scanfault.none
    if invalSep or (prev == 95) then fault = scanfault.badSeparator
    if count == 0 then {
        # only the octal prefix 0, maybe followed by digits past 7: decimal 0
        if prefix == 48 then return (scanned end: pos base: 10 count: 1 :fault)
        fault = scanfault.noDigits
    }
    if bn == 0 then {
        if i > 0 then z.append from: di * (pow x: b n: n - i)
        reverseWords :z
        nat.natNorm :z
        if i > 0 then {
            w: z.mutView
            arith.rshVUInPlace z: w s: n - i * (64.u64 / n)
        }
        nat.natNorm :z
    } else if i > 0 then {
        mulAddInPlace :z y: (pow x: b n: i) r: di
    }
    return (scanned end: pos base: b :count :fault)
}

# byteAt -- the byte at i, which the caller has checked is inside text
byteAt: function {text: StringView i: u64} out u8 is {
    return ((text.byteAt :i).or d: 0)
}

# digitValue -- a byte's value as a digit of base b, or b itself when it is
# none
digitValue: function {ch: u8 b: u64} out u64 is {
    if (ch >= 48) and (ch <= 57) then return ch - 48
    if (ch >= 97) and (ch <= 122) then return ch - 97 + 10
    if (ch >= 65) and (ch <= 90) then {
        if b <= maxBaseSmall then return ch - 65 + 10
        return ch - 65 + maxBaseSmall
    }
    return b
}

# maxDigits -- the most digits of base b one word holds: the n of the largest
# power b^n that fits
maxDigits: function {b: u64} out u64 is {
    p: b
    n: 1.u64
    limit: 18446744073709551615.u64 / b
    for p <= limit loop {
        p = p * b
        n = n + 1
    }
    return n
}

# pow -- x^n by squaring, 1 for n == 0, wrapping past a word
pow: function {x: u64 n: u64} out u64 is {
    p: 1.u64
    base: x
    e: n
    for e > 0 loop {
        if (e & 1) != 0 then p = (p.mulWide rhs: base).lo
        base = (base.mulWide rhs: base).lo
        e = e >> 1
    }
    return p
}

# reverseWords -- z's words in the opposite order
reverseWords: function {z: (ListVal u64).borrow} is {
    if z.length < 2 then return
    i: u64
    j: z.length - 1
    for i < j loop {
        t: z.get :i
        z.set :i val: (z.get i: j)
        z.set i: j val: t
        i = i + 1
        j = j - 1
    }
}

# blocks of at most this many words convert by repeated word division; longer
# ones split in two at a power of the base near their square root (Go's
# calibrated value)
leafSize: 8.u64

# a power of the base the divide-and-conquer conversion splits a number at
Divisor: class {
    # the power itself
    bbb: ListVal u64
    # its length in bits
    nbits: u64
    # its length in digits of the base, less one: the digits of a block below it
    ndigits: u64
}

# natText -- x in base 2 to 62, "0" for zero. A power-of-two base reads the
# digits straight off the bits; any other splits the number in two at a
# tabulated power of the base, recursively, and converts the halves -- which
# is what makes a long conversion subquadratic. Panics on any other base
natText: function {x: ListViewVal u64 base: u64} out String is {
    if (base < 2) or (base > maxBase) then panic msg: "invalid base"
    text: String
    if x.length == 0 then {
        text.append "0"
        return text
    }
    if (base & (base - 1)) == 0 then {
        powerOfTwoText :text :x :base
        return text
    }
    nd: maxDigits b: base
    bb: pow x: base n: nd
    table: List Divisor
    buildDivisors :table m: x.length b: base :nd :bb
    q: ListVal u64
    nat.natSet z: q :x
    convertWords :text :q width: 0 b: base :nd :bb :table limit: table.length
    return text
}

# digitChar -- the character for digit d: 0-9, then a-z, then A-Z
digitChar: function {d: u64} out u8 is {
    if d < 10 then return (d + 48).u8.orPanic
    if d < maxBaseSmall then return (d + 87).u8.orPanic
    return (d + 29).u8.orPanic
}

# powerOfTwoText -- the digits of a base 2^k, k bits at a time from the bottom
# word up, a digit that straddles two words joined across them
powerOfTwoText: function {text: String.borrow x: ListViewVal u64 base: u64} is {
    shift: base.trailingZeros
    mask: base - 1
    rev: ListVal u8
    w: x.get i: 0
    nbits: 64.u64
    k: 1.u64
    for k < x.length loop {
        for nbits >= shift loop {
            rev.append from: (digitChar d: w & mask)
            w = w >> shift
            nbits = nbits - shift
        }
        if nbits == 0 then {
            w = x.get i: k
            nbits = 64
        } else {
            w = w | ((x.get i: k) << nbits)
            rev.append from: (digitChar d: w & mask)
            w = (x.get i: k) >> (shift - nbits)
            nbits = 64.u64 - (shift - nbits)
        }
        k = k + 1
    }
    for w != 0 loop {
        rev.append from: (digitChar d: w & mask)
        w = w >> shift
    }
    appendReversed :text :rev
}

# appendReversed -- the bytes of rev, last first
appendReversed: function {text: String.borrow rev: (ListVal u8).view} is {
    i: rev.length
    for i > 0 loop {
        i = i - 1
        text.appendByte b: (rev.get :i)
    }
}

# buildDivisors -- the powers of the base an m-word number is split at: bb^8,
# then each the square of the last, until one reaches about the square root of
# the number. Each is widened while one more digit still fits its words. Go
# caches base 10's table between conversions; this builds it per conversion
buildDivisors: function {table: (List Divisor).borrow m: u64 b: u64 nd: u64 bb: u64} is {
    if m <= leafSize then return
    k: 1.u64
    words: leafSize
    for (words < (m >> 1)) and (k < 64) loop {
        words = words << 1
        k = k + 1
    }
    i: u64
    for i < k loop {
        bbb: ListVal u64
        ndigits: u64
        if i == 0 then {
            nat.natSetWord z: bbb x: 1
            j: u64
            for j < leafSize loop {
                mulAddInPlace z: bbb y: bb r: 0
                j = j + 1
            }
            ndigits = nd * leafSize
        } else {
            prev: table.get i: i - 1
            natmul.natMul z: bbb x: prev.bbb.listView y: prev.bbb.listView
            ndigits = prev.ndigits * 2
        }
        # exploit the bits the block leaves spare: one more digit while b times
        # the power still fits the same words
        larger: ListVal u64
        nat.natSet z: larger x: bbb.listView
        for (spills z: larger :b).not loop {
            nat.natSet z: bbb x: larger.listView
            ndigits = ndigits + 1
        }
        table.append (Divisor nbits: (nat.natBitLen x: bbb.listView) :ndigits bbb: bbb.take)
        i = i + 1
    }
}

# spills -- z = z*b in place, and whether the product carried past z's words
spills: function {z: (ListVal u64).borrow b: u64} out bool is {
    c: u64
    {
        w: z.mutView
        c = arith.mulAddVWWInPlace z: w y: b r: 0
    }
    return c != 0
}

# convertWords -- q's digits appended to text, exactly `width` of them with
# leading zeros when width is not 0. A q longer than a leaf splits at the
# largest tabulated power below table[limit] near its square root: the high
# part converts first, then the low part to exactly the power's digit count
convertWords: function {
    text: String.borrow
    q: (ListVal u64).borrow
    width: u64
    b: u64
    nd: u64
    bb: u64
    table: (List Divisor).view
    limit: u64
} is {
    if limit > 0 when q.length > leafSize then {
        index: limit - 1
        maxLength: nat.natBitLen x: q.listView
        minLength: maxLength >> 1
        for index > 0 while (table.get i: index - 1).nbits > minLength loop index = index - 1
        {
            d: table.get i: index
            if d.nbits >= maxLength when (nat.natCmp x: d.bbb.listView y: q.listView) >= 0 then {
                if index == 0 then panic msg: "internal inconsistency"
                index = index - 1
            }
        }
        hi: ListVal u64
        lo: ListVal u64
        dn: u64
        {
            d: table.get i: index
            natdiv.natDiv q: hi r: lo u: q.listView v: d.bbb.listView
            dn = d.ndigits
        }
        hiWidth: u64
        if width > 0 then hiWidth = width - dn
        convertWords :text q: hi width: hiWidth :b :nd :bb :table limit: index + 1
        convertWords :text q: lo width: dn :b :nd :bb :table limit: index
        return
    }
    # a leaf: nd digits per word-sized chunk, least significant first
    rev: ListVal u8
    for q.length > 0 loop {
        r: natdiv.natDivWInPlace z: q y: bb
        j: u64
        for j < nd loop {
            rev.append from: (digitChar d: r % b)
            r = r / b
            j = j + 1
        }
    }
    # no leading zeros, then exactly `width` digits when one is asked for
    for rev.length > 0 while (rev.get i: rev.length - 1) == 48 loop rev.resize to: rev.length - 1
    for rev.length < width loop rev.append from: 48
    appendReversed :text :rev
}
