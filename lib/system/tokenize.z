# tokenize -- public lexical API (preview): the raw tokenizer and its token
# types, plus `scan`, which returns the full token stream for a source string
# including whitespace, comment, and end-of-line trivia. Mirrors Python's
# `tokenize`. Stability: preview -- the surface may change.

Tokenizer: zlexer.Tokenizer
Token: zlexer.Token
toktype: zlexer.toktype
# the pool a token's text is interned in; `scan` needs one to hand it
StringPool: zast.StringPool

# scan -- tokenize `source` into its full raw token stream (whitespace,
# comments, and EOL trivia included), terminated by the EOF token. A token
# carries its text as an id into `pool`, so the pool outlives the scan and the
# caller reads a spelling back with `zast.poolTextAt`.
scan: function {source: String.take pool: zast.StringPool} out (List Token) is {
    toks: (List Token)
    tk: zlexer.Tokenizer.create :source fsno: zvfs.fsno
    for true loop {
        t: tk.token :pool
        atEof: false
        match (
            t.toktype
        ) case eofTok then {
            atEof = true
        } else null
        toks.append t
        if atEof then break
    }
    return toks
}
