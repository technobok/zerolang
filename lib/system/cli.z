# cli -- CLI argument parsing. Register flags / options /
# positionals on a `spec`, then call `parse` with argv to get a
# `parsed` result. Auto-generated help text.
#
# Grammar supported:
#   --name              long flag
#   --name value        long option (value is the next argv token)
#   --name=value        long option (embedded value)
#   -x                  short flag
#   -o value            short option
#   -xvf                bundled short flags
#   -ofile              short option with embedded value (getopt)
#   --                  end-of-options; rest go to `extras`
#   -                   positional (stdin convention)

# FlagDef -- one registered long flag (plus optional short alias).
# Class because the `string` fields are reftypes; valtypes cannot hold
# reftypes.
FlagDef: class {
    # the long name, given on the command line as --name
    name: String
    # the one-letter alias, given as -n; empty when there is none
    shortName: String
    # the one-line description usage prints beside --name
    help: String
}

# OptionDef -- one registered option (long + optional short alias).
OptionDef: class {
    # the long name, given as --name VALUE
    name: String
    # the one-letter alias; empty when there is none
    shortName: String
    # the one-line description usage prints beside --name VALUE
    help: String
    # whether omitting it is an error rather than a default
    required: bool
}

# PositionalDef -- one registered positional slot, named for lookup.
PositionalDef: class {
    # the name this slot is looked up by; it never appears on the command line
    name: String
    # the one-line description usage prints for this slot
    help: String
    # whether omitting it is an error
    required: bool
}

# CliError -- parse-time failures. Reftype arms carry a descriptive
# message so callers can compose diagnostics or print the offending
# token directly.
CliError: union {
    # a flag the spec does not declare, carrying what was given
    unknownFlag: String
    # an option given with no value after it
    missingValue: String
    # a required option or positional that never appeared
    missingRequired: String
    # a positional beyond what the spec declares
    unexpectedPositional: String
    # an argument that fits no rule at all
    unexpectedArg: String
}

# Spec -- parser registration state. Built incrementally by
# `cli.flag` / `cli.option` / `cli.positional`. All string fields
# are owned; list fields hold the registered defs in insertion
# order.
Spec: class {
    # the name usage text prints; it is not read from argv
    programName: String
    # the one-line description under the usage line
    summary: String
    # the declared flags, in the order usage prints them
    flags: (List FlagDef)
    # the declared value-taking options, in declaration order
    options: (List OptionDef)
    # the declared positional slots, IN ORDER -- position is what binds them
    positionals: (List PositionalDef)
} as {
    # an empty spec; the addFlag / addOption / addPositional calls fill it
    create: function {programName: String.take summary: String.take} out this is native
}

# Parsed -- successful parse result. Opaque; inspect via the
# accessor methods below.
Parsed: class {
    # the flags that were present. A flag is a membership question, so there is
    # no value to keep
    flagSet: (List String)
    # each option's value by long name; an absent option is simply not a key
    optionValues: (Map String V: String)
    # each positional's value by its declared name, position having been
    # resolved already
    positionalValues: (Map String V: String)
    # whatever followed the declared positionals, in order
    extraArgs: (List String)
} as {
    # Was the flag with this name present?
    hasFlag: function {t: this.view name: StringView} out bool is native

    # Value of an option, or none.
    option: function {t: this.view name: StringView} out (Option String) is native

    # Value of a positional, or none.
    positional: function {t: this.view name: StringView} out (Option String) is native
}

# Registration. Each pushes a fresh def into the spec's list.
# Named `add_*` so the verb is obvious and to sidestep the `flag`
# reserved keyword.
addFlag: function {
    # the spec extended
    spec: Spec.borrow
    # the long name, without the leading --
    name: String.take
    # the one-letter alias, without the leading -; empty for none
    shortName: String.take
    # the description the new flag carries into usage
    help: String.take
} is native
# register a value-taking option (`--name VALUE`) on `spec`.
addOption: function {
    # the spec extended
    spec: Spec.borrow
    # the long name, without the leading --
    name: String.take
    # the one-letter alias; empty for none
    shortName: String.take
    # the description the new option carries into usage
    help: String.take
    # true to make omitting it a missingRequired error
    required: bool
} is native
# register a positional argument on `spec`.
addPositional: function {
    # the spec extended
    spec: Spec.borrow
    # the name this slot is read back by
    name: String.take
    # the description the new positional carries into usage
    help: String.take
    # true to make omitting it a missingRequired error
    required: bool
} is native

# Parse argv against the registered spec. Consumes argv.
parse: function {
    # the declarations parsing is checked against
    spec: Spec.borrow
    # the arguments WITHOUT the program name, so a caller passes argv from index
    # 1
    args: (List String).take
} out (Result Parsed E: CliError) is native

# Render the usage + help block from the spec.
helpText: function {spec: Spec.borrow} out String is native
