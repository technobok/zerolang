# cli -- CLI argument parsing. Register flags / options /
# positionals on a `Spec`, then call `parse` with argv to get a
# `Parsed` result. Auto-generated help text.
#
# Grammar supported:
#   --name              long flag
#   --name value        long option (value is the next argv token)
#   --name=value        long option (embedded value)
#   -x                  short flag
#   -o value            short option
#   -xvf                bundled short flags
#   -vo value           bundle ending in a short option (value is the next token)
#   -ofile              short option with embedded value (getopt)
#   --                  end-of-options; rest go to `extraArgs`
#   -                   positional (stdin convention)

# Public interface -- the definitions other units may reference; all other
# top-level definitions are private to this unit.
public: unit {
    :FlagDef
    :OptionDef
    :PositionalDef
    :CliError
    :Spec
    :OptionValue
    :Parsed
    :addFlag
    :addOption
    :addPositional
    :parse
    :helpText
    :errorText
}

# FlagDef -- one registered long flag (plus optional short alias).
# Class because the `string` fields are reftypes; valtypes cannot hold
# reftypes.
FlagDef: class {
    # the long name with its dashes, `--name`, as given on the command line
    name: String
    # the short alias with its dash, `-n`; empty when there is none
    shortName: String
    # the one-line description usage prints beside --name
    help: String
}

# OptionDef -- one registered option (long + optional short alias).
OptionDef: class {
    # the long name with its dashes, `--name`, given before its VALUE
    name: String
    # the short alias with its dash, `-n`; empty when there is none
    shortName: String
    # the one-line description usage prints beside --name VALUE
    help: String
    # whether omitting it is an error rather than a default
    required: bool
    # whether every value written is kept, and not only the last
    # (`Parsed.optionAll`)
    repeats: bool
}

# PositionalDef -- one registered positional slot, named for lookup.
PositionalDef: class {
    # the name this slot is looked up by; it never appears on the command line
    name: String
    # the one-line description usage prints for this slot
    help: String
    # whether omitting it is an error
    required: bool
}

# CliError -- parse-time failures. Reftype arms carry a descriptive
# message so callers can compose diagnostics or print the offending
# token directly.
CliError: union {
    # a flag the spec does not declare, carrying what was given
    unknownFlag: String
    # an option given with no value after it
    missingValue: String
    # a required option or positional that never appeared
    missingRequired: String
    # an argument that fits no rule at all
    unexpectedArg: String
}

# Spec -- parser registration state. Built incrementally by
# `addFlag` / `addOption` / `addPositional`. All string fields
# are owned; list fields hold the registered defs in insertion
# order.
Spec: class {
    # the name usage text prints; it is not read from argv
    programName: String
    # the one-line description under the usage line
    summary: String
    # the declared flags, in the order usage prints them
    flags: List FlagDef
    # the declared value-taking options, in declaration order
    options: List OptionDef
    # the declared positional slots, IN ORDER -- position is what binds them
    positionals: List PositionalDef
    # true to end the reading at the first operand past the declared
    # positionals: it and every token after it go to `extraArgs` unread, as
    # the arguments of a program this one starts
    stopAtOperand: false
} as {
    # an empty spec; the addFlag / addOption / addPositional calls fill it
    create: function {programName: String.take summary: String.take} out this is {
        return (
            meta.create
            :programName
            :summary
            flags: List FlagDef
            options: List OptionDef
            positionals: List PositionalDef
        )
    }
}

# OptionValue -- one value written for an option that repeats
OptionValue: class {
    # the option's long name
    name: String
    # the value as written
    value: String
}

# Parsed -- successful parse result. Opaque; inspect via the
# accessor methods below.
Parsed: class {
    # the flags that were present. A flag is a membership question, so there is
    # no value to keep
    flagSet: List String
    # each option's value by long name; an absent option is simply not a key
    optionValues: (Map String V: String)
    # every value written for an option declared `repeats:`, in the order
    # written
    repeatValues: List OptionValue
    # each positional's value by its declared name, position having been
    # resolved already
    positionalValues: (Map String V: String)
    # whatever followed the declared positionals, in order: the operands past
    # them, then every token the reading stopped before
    extraArgs: List String
    # how many of extraArgs are operands past the declared positionals. The
    # tokens from that index on were not read: they followed `--`, or the
    # first of them ended the reading under stopAtOperand
    extraOperands: u64
} as {
    # Was the flag with this name present?
    hasFlag: function {t: this.view name: StringView} out bool is {
        return (t.flagSet.contains item: name.asString)
    }

    # Value of an option, or none.
    option: function {t: this.view name: StringView} out Option String is {
        return (valueOf m: t.optionValues :name)
    }

    # Value of a positional, or none.
    positional: function {t: this.view name: StringView} out Option String is {
        return (valueOf m: t.positionalValues :name)
    }

    # Every value kept for an option, in the order written: all of them for
    # an option declared `repeats:`, the last for any other. Empty when the
    # option was not written.
    optionAll: function {t: this.view name: StringView} out List String is {
        all: List String
        for each rv: t.repeatValues loop {
            if rv.name == name then all.append rv.value.copy
        }
        if all.length > 0 then return all
        v: t.optionValues.get key: name.asString
        match (
            v
        ) case some then {
            all.append v.copy
        } case none then null
        return all
    }

    # Was the name written: as a flag, as an option or as a positional?
    given: function {t: this.view name: StringView} out bool is {
        if (t.flagSet.contains item: name.asString) then return true
        if (t.optionValues.has key: name.asString) then return true
        return (t.positionalValues.has key: name.asString)
    }
}

# valueOf -- an owned copy of the value `m` holds under `name`, or none
valueOf: function {m: (Map String V: String).view name: StringView} out Option String is {
    v: m.get key: name.asString
    match (
        v
    ) case some then {
        return (Option.some v.copy)
    } case none then {
        return (Option.none String)
    }
}

# Registration. Each pushes a fresh def into the spec's list.
# Named `add...` so the verb is obvious and to sidestep the `flag`
# reserved keyword.
addFlag: function {
    # the spec extended
    spec: Spec.borrow
    # the long name with its dashes, `--name`
    name: String.take
    # the short alias with its dash, `-n`; empty for none
    shortName: String.take
    # the description the new flag carries into usage
    help: String.take
} is {
    spec.flags.append (FlagDef :name :shortName :help)
}

# register a value-taking option (`--name VALUE`) on `spec`.
addOption: function {
    # the spec extended
    spec: Spec.borrow
    # the long name with its dashes, `--name`
    name: String.take
    # the short alias with its dash, `-n`; empty for none
    shortName: String.take
    # the description the new option carries into usage
    help: String.take
    # true to make omitting it a missingRequired error
    required: bool
    # true to keep every value written, for `Parsed.optionAll`
    repeats: false
} is {
    spec.options.append (OptionDef :name :shortName :help :required :repeats)
}

# register a positional argument on `spec`.
addPositional: function {
    # the spec extended
    spec: Spec.borrow
    # the name this slot is read back by
    name: String.take
    # the description the new positional carries into usage
    help: String.take
    # true to make omitting it a missingRequired error
    required: bool
} is {
    spec.positionals.append (PositionalDef :name :help :required)
}

# member -- what a name on the command line is declared as. A flag is looked
# for before an option, so a name both declare is the flag's.
member: variant {
    # the flag at this index of the spec's flags
    flagAt: u64
    # the option at this index of the spec's options
    optionAt: u64
    # no flag and no option has the name
    unknown: null
}

# step -- what reading one token did
step: variant {
    # the token was read by itself
    one: null
    # the token was an option and the token after it its value
    two: null
    # the token went to a positional slot, or to the extra arguments past them
    placed: null
    # the reading ends here: the tokens left are extra arguments
    rest: null
    # no flag and no option has the token's name
    unknown: null
    # the option has no token after it to be its value
    noValue: null
    # a flag was written with a value, `--name=value`
    flagValue: null
}

# spelled -- whether a declared member answers to `name`: by its short alias
# when `short`, by its long name otherwise
spelled: function {long: String.view alias: String.view name: StringView short: bool} out bool is {
    if short then return alias == name
    return long == name
}

# declared -- the member of `spec` that `name` names
declared: function {spec: Spec.view name: StringView short: bool} out member is {
    i: u64
    for each f: spec.flags loop {
        if (spelled long: f.name alias: f.shortName :name :short) then return (member.flagAt i)
        i = i + 1
    }
    i = 0
    for each o: spec.options loop {
        if (spelled long: o.name alias: o.shortName :name :short) then return (member.optionAt i)
        i = i + 1
    }
    return member.unknown
}

# setFlag -- records that the flag at `i` was given, under its long name. A
# flag given twice is recorded twice.
setFlag: function {spec: Spec.view p: Parsed.borrow i: u64} is {
    p.flagSet.append (spec.flags.get :i).name.copy
}

# setOption -- records `value` for the option at `i`, under its long name. A
# value given earlier is replaced; an option that repeats keeps it as well.
setOption: function {spec: Spec.view p: Parsed.borrow i: u64 value: String.take} is {
    o: spec.options.get :i
    if o.repeats then p.repeatValues.append (OptionValue name: o.name.copy value: value.copy)
    p.optionValues.set key: o.name.copy :value
}

# nextValue -- gives the option at `i` the token after `at` as its value,
# whatever that token looks like
nextValue: function {
    spec: Spec.view
    args: (List String).view
    at: u64
    p: Parsed.borrow
    i: u64
} out step is {
    if (at + 1) >= args.length then return step.noValue
    setOption :spec :p :i value: (args.get i: at + 1).copy
    return step.two
}

# readLong -- the token at `at` is `--name` or `--name=value`
readLong: function {spec: Spec.view args: (List String).view at: u64 p: Parsed.borrow} out step is {
    tok: (args.get i: at).stringView
    eq: tok.indexOf needle: "="
    m: declared :spec name: (tok.substring from: 0 to: (eq.or d: tok.length)) short: false
    match (
        m
    ) case flagAt then {
        if eq.some then return step.flagValue
        setFlag :spec :p i: m
        return step.one
    } case optionAt then {
        match (
            eq
        ) case some then {
            setOption :spec :p i: m value: (tok.substring from: eq + 1 to: tok.length).string
            return step.one
        } case none then {
            return (nextValue :spec :args :at :p i: m)
        }
    } case unknown then {
        return step.unknown
    }
}

# readBundle -- the token at `at` is short names behind one dash, `-xvf`. Each
# letter must be a flag's, until an option's ends the bundle: what is left of
# the token is its value (`-ofile`), or the next token is (`-vo file`).
readBundle: function {
    spec: Spec.view args: (List String).view at: u64 p: Parsed.borrow
} out step is {
    tok: (args.get i: at).stringView
    k: 1.u64
    for k < tok.length loop {
        alias: String
        alias.append "-"
        alias.appendByte b: ((tok.byteAt i: k).or d: 0)
        m: declared :spec name: alias.stringView short: true
        match (
            m
        ) case flagAt then {
            setFlag :spec :p i: m
        } case optionAt then {
            if (k + 1) == tok.length then return (nextValue :spec :args :at :p i: m)
            setOption :spec :p i: m value: (tok.substring from: k + 1 to: tok.length).string
            return step.one
        } case unknown then {
            return step.unknown
        }
        k = k + 1
    }
    return step.one
}

# readShort -- the token at `at` starts with one dash. The whole token is tried
# as a short alias first, so an alias may be longer than one letter.
readShort: function {
    spec: Spec.view args: (List String).view at: u64 p: Parsed.borrow
} out step is {
    tok: (args.get i: at).stringView
    m: declared :spec name: tok short: true
    match (
        m
    ) case flagAt then {
        setFlag :spec :p i: m
        return step.one
    } case optionAt then {
        return (nextValue :spec :args :at :p i: m)
    } case unknown then {
        if tok.length == 2 then return step.unknown
        return (readBundle :spec :args :at :p)
    }
}

# restFrom -- the tokens of `args` from index `from` on are extra arguments,
# unread
restFrom: function {args: (List String).view p: Parsed.borrow from: u64} is {
    i: from
    for i < args.length loop {
        p.extraArgs.append (args.get :i).copy
        i = i + 1
    }
}

# readToken -- reads the token at `at` into `p`. `slot` is how many tokens were
# placed before it: the index of the positional it takes when it is one.
readToken: function {
    spec: Spec.view
    args: (List String).view
    at: u64
    p: Parsed.borrow
    slot: u64
} out step is {
    tok: (args.get i: at).stringView
    if (tok.startsWith prefix: "--") then {
        if tok.length > 2 then return (readLong :spec :args :at :p)
        restFrom :args :p from: at + 1
        return step.rest
    }
    if tok.length > 1 when (tok.startsWith prefix: "-") then return (readShort :spec :args :at :p)
    if slot < spec.positionals.length then {
        p.positionalValues.set key: (spec.positionals.get i: slot).name.copy value: tok.string
        return step.placed
    }
    if spec.stopAtOperand then {
        restFrom :args :p from: at
        return step.rest
    }
    p.extraArgs.append tok.string
    p.extraOperands = p.extraOperands + 1
    return step.placed
}

# walk -- reads every token of `args` from position `first` on into `p`.
# Answers the error of the first token it refuses, which carries that token.
walk: function {
    spec: Spec.view args: (List String).view first: u64 p: Parsed.borrow
} out Option CliError is {
    slot: u64
    i: first
    for i < args.length loop {
        s: readToken :spec :args at: i :p :slot
        match (
            s
        ) case one then {
            i = i + 1
        } case two then {
            i = i + 2
        } case placed then {
            slot = slot + 1
            i = i + 1
        } case rest then {
            break
        } case unknown then {
            return (Option.some (CliError.unknownFlag (args.get :i).copy))
        } case noValue then {
            return (Option.some (CliError.missingValue (args.get :i).copy))
        } case flagValue then {
            return (Option.some (CliError.unexpectedArg (args.get :i).copy))
        }
    }
    return (Option.none CliError)
}

# missingName -- the name of the first required member that has no value:
# the options in declaration order, then the positionals
missingName: function {spec: Spec.view p: Parsed.view} out Option String is {
    for each o: spec.options loop {
        if o.required when (p.optionValues.has key: o.name).not then return (Option.some o.name.copy
        )
    }
    for each s: spec.positionals loop {
        if s.required when (p.positionalValues.has key: s.name).not then {
            return (Option.some s.name.copy)
        }
    }
    return (Option.none String)
}

# Parse argv against the registered spec. Consumes argv.
parse: function {
    # the declarations parsing is checked against
    spec: Spec.view
    # the whole argument vector as `os.args` returns it
    args: (List String).take
    # the position reading starts at. Position 0 is the program name; a program
    # that reads its command at position 1 itself gives 2
    first: 1.u64
} out (Result Parsed E: CliError) is {
    p: (
        Parsed
        flagSet: List String
        optionValues: (Map String V: String)
        repeatValues: List OptionValue
        positionalValues: (Map String V: String)
        extraArgs: List String
        extraOperands: 0
    )
    refused: walk :spec :args :first :p
    match (
        refused
    ) case some then {
        return ((Result Parsed E: CliError).err refused.take)
    } case none then null
    missing: missingName :spec :p
    match (
        missing
    ) case some then {
        return ((Result Parsed E: CliError).err (CliError.missingRequired missing.take))
    } case none then null
    return ((Result Parsed E: CliError).ok p.take)
}

# helpLine -- one member's line of the help text: `  -n, --name    help`, the
# alias and the help left out when empty
helpLine: function {r: String.borrow alias: StringView name: StringView help: StringView} is {
    r.append "\n  "
    if alias.length > 0 then r.append "\{alias}, "
    r.append name
    if help.length > 0 then r.append "    \{help}"
}

# Render the usage + help block from the spec.
helpText: function {spec: Spec.view} out String is {
    r: "usage: \{spec.programName} [options]"
    for each s: spec.positionals loop r.append " <\{s.name}>"
    if spec.summary.length > 0 then r.append "\n\n\{spec.summary}"
    if spec.flags.length > 0 then {
        r.append "\n\nFlags:"
        for each f: spec.flags loop {
            (
                helpLine
                :r
                alias: f.shortName.stringView
                name: f.name.stringView
                help: f.help.stringView
            )
        }
    }
    if spec.options.length > 0 then {
        r.append "\n\nOptions:"
        for each o: spec.options loop {
            (
                helpLine
                :r
                alias: o.shortName.stringView
                name: o.name.stringView
                help: o.help.stringView
            )
        }
    }
    if spec.positionals.length > 0 then {
        r.append "\n\nPositionals:"
        for each s: spec.positionals loop {
            helpLine :r alias: "" name: s.name.stringView help: s.help.stringView
        }
    }
    return r
}

# slotNamed -- whether `name` is a positional of `spec`, and no option's name
slotNamed: function {spec: Spec.view name: StringView} out bool is {
    for each o: spec.options loop {
        if o.name == name then return false
    }
    for each s: spec.positionals loop {
        if s.name == name then return true
    }
    return false
}

# The sentence that says `e` to the person who wrote the command line:
# `prog: unknown option '-q'`. One line, with no newline at its end. A program
# that has a help command appends its own pointer to it.
errorText: function {
    # the spec `e` came from: it gives the program name, and says whether a
    # missing name is a positional, which is written `<name>`
    spec: Spec.view
    e: CliError.view
} out String is {
    prog: spec.programName.stringView
    match (
        e
    ) case unknownFlag then {
        return "\{prog}: unknown option '\{e}'"
    } case missingValue then {
        return "\{prog}: \{e} needs a value"
    } case missingRequired then {
        if (slotNamed :spec name: e.stringView) then return "\{prog}: missing <\{e}>"
        return "\{prog}: missing \{e}"
    } case unexpectedArg then {
        tok: e.stringView
        eq: tok.indexOf needle: "="
        name: tok.substring from: 0 to: (eq.or d: tok.length)
        return "\{prog}: \{name} takes no value"
    }
}
