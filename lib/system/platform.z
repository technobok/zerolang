# platform.z -- what the compiler knows about the build it is performing.
#
# Every definition here is a COMPILE-TIME CONSTANT, so a `require:` block or a
# unit-level `if` can guard on the toolchain:
#
#     require: unit {
#         library: if platform.cc == platform.cckind.tcc then {
#             error "this unit needs a compiler with __float128"
#         } else {
#             "quadmath"
#         }
#     }
#
# Each kind is named for its VALUES rather than for the member that reads it,
# which is what keeps `platform.platform` from ever arising: the member is
# `os`, its type is `oskind`, and an arm is `platform.oskind.linux`.

# oskind -- host operating-system family.
oskind: variant {
    # the Linux target: ELF objects and a glibc-shaped libc
    linux: null
    # macOS
    darwin: null
    # the Windows target: PE objects, and the one arm whose path separator
    # and executable suffix differ from the rest
    windows: null
    # an OS the build does not name; a require: guard should treat it as
    # unsupported rather than assume
    other: null
}

# archkind -- CPU architecture family.
archkind: variant {
    # 64-bit x86
    x86_64: null
    # 64-bit ARM
    aarch64: null
    # an architecture the build does not name
    other: null
}

# cckind -- the C compiler `zc` will hand the emitted C to, classified by the
# basename of the resolved path. By NAME alone: probing `--version` would add
# a subprocess to every compile, so a `--cc` pointing at a wrapper script
# reads as `other` and a guard keyed on one compiler will not fire for it.
cckind: variant {
    # GCC, reached by spawning it; it has no in-process mode, so ccmode.inproc
    # cannot select it
    gcc: null
    # Clang, spawned like GCC. The warn-check gate runs both because their
    # warning sets are not the same one
    clang: null
    # the vendored tcc, which compiles in-process as well as by spawn
    tcc: null
    # a C compiler the build does not name
    other: null
}

# ccmodekind -- how `zc` reaches that compiler: `spawn` runs it as a child
# process, `inproc` loads it into this one. Orthogonal to `cckind` on purpose,
# so `platform.cc == platform.cckind.tcc` keeps firing whichever way tcc is
# reached; naming the in-process path as a compiler of its own would have made
# every existing guard quietly stop applying to it.
#
# There is no `auto`: the requested mode is always the resolved one, and `zc`
# reports an error rather than falling back. That is what keeps this constant
# foldable -- an `auto` would have to probe for a loadable library, and
# `platform` is read during TYPE CHECKING, where the answer must not depend on
# a machine's shared-library layout.
ccmodekind: variant {
    # the C compiler runs as a child process
    spawn: null
    # the C compiler runs IN THIS PROCESS, which only the vendored tcc can do
    inproc: null
}

# The five below are `fold` natives: zero-argument declarations the compiler
# answers itself, while type checking, from the invocation it was given. The
# `out` type is the type; src/runtime/natives.tbl names each path, and naming
# it there IS the backing.
os: function out oskind is native
# the architecture this build targets, answered from the invocation rather than
# probed for
arch: function out archkind is native
# which C compiler the build will use, answered from the invocation
cc: function out cckind is native
# how that compiler is reached: spawned as a child, or run in this process
ccmode: function out ccmodekind is native
# the target triple as written text, for the cases the kind enums above do not
# split finely enough
target: function out StringView is native
