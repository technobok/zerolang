# platform.z -- what the compiler knows about the build it is performing.
#
# Every definition here is a COMPILE-TIME CONSTANT, so a `require:` block or a
# unit-level `if` can guard on the target:
#
#     require: unit {
#         library: if platform.os == platform.oskind.windows then {
#             "ws2_32"
#         } else {
#             ""
#         }
#     }
#
# What it describes is the TARGET -- its operating system and architecture --
# never the toolchain that builds for it: which C compiler compiles the output,
# and how, are the C backend's business, and nothing here names them.
#
# Each kind is named for its VALUES rather than for the member that reads it,
# which is what keeps `platform.platform` from ever arising: the member is
# `os`, its type is `oskind`, and an arm is `platform.oskind.linux`.

# oskind -- host operating-system family.
oskind: variant {
    # the Linux target: ELF objects and a glibc-shaped libc
    linux: null
    # macOS
    darwin: null
    # the Windows target: PE objects, and the one arm whose path separator
    # and executable suffix differ from the rest
    windows: null
    # an OS the build does not name; a require: guard should treat it as
    # unsupported rather than assume
    other: null
}

# archkind -- CPU architecture family.
archkind: variant {
    # 64-bit x86
    x86_64: null
    # 64-bit ARM
    aarch64: null
    # an architecture the build does not name
    other: null
}

# The four below are natives the type checker answers itself, from the
# invocation it was given: zero-argument declarations whose `out` type is the
# type. It lowers each to a constant of the checked program, so no backend
# implements them and the emitted C never names them.
os: function out oskind is native

# the architecture this build targets, answered from the invocation rather than
# probed for
arch: function out archkind is native

# the target triple as written text, for the cases the kind enums above do not
# split finely enough
target: function out StringView is native

# the width of a pointer on the target, in bits -- the width of a union's
# payload slot, which decides whether a bare value-type arm is held in it
ptrbits: function out u64 is native
