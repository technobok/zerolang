                        static void z_@@NAME@@_insert(z_@@NAME@@_t* _this, @@ELEM_T@@ _val, uint64_t _at);
                        static void z_@@NAME@@_insert(z_@@NAME@@_t* _this, @@ELEM_T@@ _val, uint64_t _at) {
