                (
                    c.section
                    member: "items_cap"
                    text: """
                        static uint32_t z_@@NAME@@_items_cap(uint32_t _capacity);
                        static uint32_t z_@@NAME@@_items_cap(uint32_t _capacity) {
                            return (uint32_t)((((uint64_t)_capacity) * 2u) / 3u);
                        }
                        """
                )
                (
                    c.section
                    member: "destroy"
                    text: """
                        static void z_@@NAME@@_destroy(z_@@NAME@@_t* p);
                        static void z_@@NAME@@_destroy(z_@@NAME@@_t* p) {
                            if (!p) return;
                            free(p->indices);
                            free(p->items);
                            /* NO free(p) -- the struct is on the stack */
                        }
                        """
                )
                (
                    c.section
                    member: "create"
                    needs: list { "items_cap" "prelude.@xcalloc" }
                    text: """
                        static z_@@NAME@@_t z_@@NAME@@_create(uint64_t _capacity);
                        static z_@@NAME@@_t z_@@NAME@@_create(uint64_t _capacity) {
                            z_@@NAME@@_t _this = {0};
                            if (_capacity > 0) {
                                uint32_t _p2 = 8;
                                while ((uint64_t)z_@@NAME@@_items_cap(_p2) < _capacity && _p2 < 0x40000000u) {
                                    _p2 <<= 1;
                                }
                                _this.capacity = _p2;
                                _this.items = (@@ITEM_T@@*)z_xcalloc(z_@@NAME@@_items_cap(_p2), sizeof(@@ITEM_T@@));
                                if (_p2 > Z_@@MACRO@@_SMALL_MAX) {
                                    _this.indices = (uint32_t*)z_xcalloc(_p2, sizeof(uint32_t));
                                }
                            }
                            return _this;
                        }
                        """
                )
                (
                    c.section
                    member: "grow"
                    needs: list { "items_cap" "slot" "prelude.@xcalloc" "prelude.@xrealloc" }
                    text: """
                        static void z_@@NAME@@_grow(z_@@NAME@@_t* _this);
                        static void z_@@NAME@@_grow(z_@@NAME@@_t* _this) {
                            uint32_t _new_cap = _this->capacity == 0 ? 8 : _this->capacity * 2;
                            _this->items = (@@ITEM_T@@*)z_xrealloc(_this->items,
                                (size_t)z_@@NAME@@_items_cap(_new_cap) * sizeof(@@ITEM_T@@));
                            _this->capacity = _new_cap;
                            free(_this->indices);
                            _this->indices = NULL;
                            if (_new_cap > Z_@@MACRO@@_SMALL_MAX) {
                                _this->indices = (uint32_t*)z_xcalloc(_new_cap, sizeof(uint32_t));
                                for (uint32_t i = 0; i < _this->length; i++) {
                                    uint64_t probe = z_@@NAME@@_slot(_this->items[i]) & (_new_cap - 1);
                                    while (_this->indices[probe]) probe = (probe + 1) & (_new_cap - 1);
                                    _this->indices[probe] = i + 1;
                                }
                            }
                        }
                        """
                )
                (
                    c.section
                    member: "find"
                    needs: list { "slot" }
                    text: """
                        static int64_t z_@@NAME@@_find(const z_@@NAME@@_t* _this, @@ITEM_T@@ _item, uint64_t* _slot_out);
                        static int64_t z_@@NAME@@_find(const z_@@NAME@@_t* _this, @@ITEM_T@@ _item, uint64_t* _slot_out) {
                            if (!_this->indices) {
                                for (uint32_t i = 0; i < _this->length; i++) {
                                    if (_this->items[i] == _item) return (int64_t)i;
                                }
                                return -1;
                            }
                            uint64_t _mask = _this->capacity - 1;
                            uint64_t probe = z_@@NAME@@_slot(_item) & _mask;
                            for (uint32_t i = 0; i < _this->capacity; i++) {
                                uint32_t slot = _this->indices[probe];
                                if (slot == 0) {
                                    if (_slot_out) *_slot_out = probe;
                                    return -1;
                                }
                                if (_this->items[slot - 1] == _item) {
                                    if (_slot_out) *_slot_out = probe;
                                    return (int64_t)(slot - 1);
                                }
                                probe = (probe + 1) & _mask;
                            }
                            return -1;
                        }
                        """
                )
                (
                    c.section
                    member: "add"
                    needs: list { "find" "grow" }
                    text: """
                        /* 1 when the item was newly added, 0 when it was already present */
                        static int z_@@NAME@@_add(z_@@NAME@@_t* _this, @@ITEM_T@@ _item);
                        static int z_@@NAME@@_add(z_@@NAME@@_t* _this, @@ITEM_T@@ _item) {
                            uint64_t _slot = 0;
                            if (z_@@NAME@@_find(_this, _item, &_slot) >= 0) return 0;
                            if ((uint64_t)(_this->length + 1) * 3 >= (uint64_t)_this->capacity * 2) {
                                z_@@NAME@@_grow(_this);
                                z_@@NAME@@_find(_this, _item, &_slot);
