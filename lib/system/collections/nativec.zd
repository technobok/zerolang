                (
                    c.section
                    text: """
                        /* ListVal.copy -- an owned duplicate that shares no storage with the source.
                           Emitted only for a mono whose program calls it, which is why it is its own
                           file rather than a block in z_List.c.tmpl: that file is shared with ListRef,
                           which declares no copy and must never be given one.

                           The elements are valtypes, so their BYTES are the elements and one memcpy
                           duplicates them all. An empty source needs no buffer -- the zero struct IS
                           an empty list, exactly as it is for an empty String. */
                        static z_@@NAME@@_t z_@@NAME@@_copy(const z_@@NAME@@_t* _this);
                        static z_@@NAME@@_t z_@@NAME@@_copy(const z_@@NAME@@_t* _this) {
                            z_@@NAME@@_t _out = {0};
                            if (!_this || _this->length == 0) return _out;
