                        static z_@@MAPKEYITER@@_t z_@@NAME@@_iterate(const z_@@NAME@@_t* _this);
                        static z_@@MAPKEYITER@@_t z_@@NAME@@_iterate(const z_@@NAME@@_t* _this) {
                            z_@@MAPKEYITER@@_t _it = {0};
                            /* The cursor keeps a plain T* and OptionView's payload is a single void*, shared
                           with the readers that hand out a mutable interior pointer on purpose
                           (List.get's write-back), so const cannot propagate that far without breaking
                           them. This ONE cast is where it stops. What the const receiver buys is still
                           real and is what view-guard checks: `iterate` itself provably does not write
                           through the container. That the ELEMENTS are readonly is a typecheck-level
                           guarantee -- the loop element inherits the strength of the lock its holder
                           has on the container -- not a C one. */
                            _it.m = (z_@@NAME@@_t*)_this;
                            _it.idx = 0;
                            return _it;
