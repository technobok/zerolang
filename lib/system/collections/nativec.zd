                (
                    c.section
                    member: "valueAt"
                    text: """
                        static z_@@OPTIONVAL@@_t z_@@NAME@@_valueAt(const z_@@NAME@@_t* _this, uint64_t _i);
                        static z_@@OPTIONVAL@@_t z_@@NAME@@_valueAt(const z_@@NAME@@_t* _this, uint64_t _i) {
                            int64_t idx = _i < (uint64_t)_this->length ? (int64_t)_i : -1;
                        @@GET_BODY@@
                        }
                        """
