                            return 1;
                        }
                        """
                )
                (
                    c.section
                    member: "has"
                    needs: list { "find" }
                    text: """
                        static int z_@@NAME@@_has(const z_@@NAME@@_t* _this, @@ITEM_T@@ _item);
                        static int z_@@NAME@@_has(const z_@@NAME@@_t* _this, @@ITEM_T@@ _item) {
                            return z_@@NAME@@_find(_this, _item, NULL) >= 0;
                        }
                        """
                )
                (
                    c.section
                    text: """
                        /* The cursor is a plain index test, not a scan: `items` is dense, so there is
                           no hole to skip and no `alive` byte to read. Iteration is in INSERTION order
                           for the same reason a Map's is -- the array IS the insertion order -- and
                           here nothing can ever perforate it. */
                        """
                )
                (
                    c.section
                    member: "iterate"
                    text: """
                        typedef struct {
                            z_@@NAME@@_t* s;
                            uint32_t idx;
                        } z_@@IDSETITER@@_t;

                        static z_@@OPTIONVIEW@@_t z_@@IDSETITER@@_call(z_@@IDSETITER@@_t* _it);
                        static z_@@OPTIONVIEW@@_t z_@@IDSETITER@@_call(z_@@IDSETITER@@_t* _it) {
                            z_@@OPTIONVIEW@@_t _out = {0};
                            if (_it->idx < _it->s->length) {
                                _out.tag = @@OPTIONVIEW_SOME@@;
                                _out.data = &_it->s->items[_it->idx];
                                _it->idx++;
                                return _out;
                            }
                            _out.tag = @@OPTIONVIEW_NONE@@;
                            return _out;
                        }

                        static z_@@IDSETITER@@_t z_@@NAME@@_iterate(const z_@@NAME@@_t* _this);
                        static z_@@IDSETITER@@_t z_@@NAME@@_iterate(const z_@@NAME@@_t* _this) {
                            z_@@IDSETITER@@_t _it = {0};
                            /* the one const cast, for the reason z_Set.c.tmpl's iterate spells out:
                               OptionView's payload is a bare void* shared with the readers that hand
                               out a mutable interior pointer, so const stops here. What the const
                               receiver buys -- that `iterate` provably does not write through the
                               container -- is what view-guard checks and is unaffected. */
                            _it.s = (z_@@NAME@@_t*)_this;
                            _it.idx = 0;
                            return _it;
                        }
                        """
                )
            }
        )
        (
            c.template
            name: "IdSet_copy"
            needs: list { "prelude.@xcalloc" }
            sections: list {
                (
                    c.section
                    text: """
                        /* IdSet.copy -- an owned duplicate that shares no storage with the source. An
                           id is a scalar, so the dense item array copies as bytes and the index copies
                           verbatim. z_IdMap_copy.c.tmpl without the value column: the same two size
                           rules apply, items_cap(capacity) rather than length, and a NULL index stays
                           NULL so the copy takes the same small-mode path the source does. */
                        static z_@@NAME@@_t z_@@NAME@@_copy(const z_@@NAME@@_t* _this);
                        static z_@@NAME@@_t z_@@NAME@@_copy(const z_@@NAME@@_t* _this) {
                            z_@@NAME@@_t _out = {0};
                            if (!_this || _this->capacity == 0) return _out;
                            _out.length = _this->length;
                            _out.capacity = _this->capacity;
                            uint32_t _icap = z_@@NAME@@_items_cap(_this->capacity);
                            if (_icap > 0 && _this->items) {
                                _out.items = (@@ITEM_T@@*)z_xcalloc(_icap, sizeof(@@ITEM_T@@));
                                memcpy(_out.items, _this->items, (size_t)_icap * sizeof(@@ITEM_T@@));
                            }
                            if (_this->indices) {
                                _out.indices = (uint32_t*)z_xcalloc(_this->capacity, sizeof(uint32_t));
                                memcpy(_out.indices, _this->indices, (size_t)_this->capacity * sizeof(uint32_t));
                            }
