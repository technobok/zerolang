# nativec -- collections's C implementation, a runtime.nativec file
c: runtime.nativec

# implementation -- the C behind collections's native declarations
implementation: (
    c.implementation
    rows: list {
        # the collections string join
        (
            c.row
            key: "stringJoin"
            needs: list { "prelude.@xmalloc" }
            fragments: list {
                """
                /* collections.stringJoin -- borrow `parts` (read-only) and return a new
                   owned string. `parts` arrives by pointer, as a stack reftype parameter
                   does; the caller keeps it. */
                static z_@String@_t z_collections_stringJoin(
                    z_@List_String@_t* parts, z_@StringView@_t sep);
                static z_@String@_t z_collections_stringJoin(
                    z_@List_String@_t* parts, z_@StringView@_t sep) {
                    z_@String@_t out = {0};
                    uint64_t n = parts->length;
                    if (n == 0) {
                        out.capacity = 1;
                        out.data = (char*)z_xmalloc(1);
                        out.data[0] = '\0';
                        return out;
                    }
                    uint64_t total = sep.size * (n - 1);
                    for (uint64_t i = 0; i < n; i++) {
                        total += parts->data[i].size;
                    }
                    out.size = total;
                    out.capacity = total + 1;
                    out.data = (char*)z_xmalloc(out.capacity + 1);
                    uint64_t pos = 0;
                    for (uint64_t i = 0; i < n; i++) {
                        if (i > 0 && sep.size > 0) {
                            memcpy(out.data + pos, sep.data, sep.size);
                            pos += sep.size;
                        }
                        memcpy(out.data + pos, parts->data[i].data, parts->data[i].size);
                        pos += parts->data[i].size;
                    }
                    out.data[total] = '\0';
                    return out;
                }


                """
            }
        )
        (
            c.row
            key: "@window"
            needs: list { "prelude.@panic" }
            fragments: list {
                """
                /* the bounds of a window over [from, to) of `len` elements: a list's or an
                   array's storage lent as a SpanVal or a view, or a window split in two. */
                static void z_coll_window_check(uint64_t _from, uint64_t _to, uint64_t _len, const char* _who);
                static void z_coll_window_check(uint64_t _from, uint64_t _to, uint64_t _len, const char* _who) {
                    if (_from > _to || _to > _len) {
                        char _zp_buf[160];
                        snprintf(_zp_buf, sizeof(_zp_buf), "%s: [%llu, %llu) out of bounds (length %llu)", _who, (unsigned long long)_from, (unsigned long long)_to, (unsigned long long)_len);
                        z_panic(_zp_buf);
                    }
                }
                """
            }
        )
        (
            c.row
            key: "bytesText"
            fragments: list {
                """
                /* `bytes` as a StringView over the same memory */
                static z_@StringView@_t z_collections_bytesText(z_@ListViewVal_u8@_t bytes);
                static z_@StringView@_t z_collections_bytesText(z_@ListViewVal_u8@_t bytes) {
                    z_@StringView@_t sv = { bytes.length, (const char*)bytes.data };
                    return sv;
                }
                """
            }
        )
        (
            c.row
            key: "utf8ValidUpTo"
            needs: list { "system.utf8" }
            fragments: list {
                """
                /* how many of `bytes` are valid UTF-8 before the first invalid sequence; the
                   count itself is the shared validator's (_Z_UTF8_VALID_UPTO) */
                static uint64_t z_utf8_valid_upto(const uint8_t* data, uint64_t len);
                static uint64_t z_collections_utf8ValidUpTo(z_@ListViewVal_u8@_t bytes);
                static uint64_t z_collections_utf8ValidUpTo(z_@ListViewVal_u8@_t bytes) {
                    return z_utf8_valid_upto(bytes.data, bytes.length);
                }
                """
            }
        )
