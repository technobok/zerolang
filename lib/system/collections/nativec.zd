        (
            c.template
            name: "IdMapIter"
            sections: list {
                (
                    c.section
                    text: """
                        /* The entry IS the projection: `entries` is dense, so a borrowed entry is a
                           plain `&entries[idx]` and the cursor is an index test rather than a scan for
                           the next live one. Insertion order, and nothing can perforate it. */
                        /*@@entrytype@@*/typedef z_@@NAME@@_entry_t z_@@IDMAPENTRY@@_t;

                        typedef struct {
                            z_@@NAME@@_t* m;
                            uint32_t idx;
                        } z_@@IDMAPITEMITER@@_t;

                        static z_@@OPTIONVIEW_ENTRY@@_t z_@@IDMAPITEMITER@@_call(z_@@IDMAPITEMITER@@_t* _it);
                        static z_@@OPTIONVIEW_ENTRY@@_t z_@@IDMAPITEMITER@@_call(z_@@IDMAPITEMITER@@_t* _it) {
                            z_@@OPTIONVIEW_ENTRY@@_t _out = {0};
                            if (_it->idx < _it->m->length) {
                                _out.tag = @@OPTIONVIEW_ENTRY_SOME@@;
                                _out.data = &_it->m->entries[_it->idx];
                                _it->idx++;
                                return _out;
                            }
                            _out.tag = @@OPTIONVIEW_ENTRY_NONE@@;
                            return _out;
                        }

                        static z_@@IDMAPITEMITER@@_t z_@@NAME@@_iterateItems(const z_@@NAME@@_t* _this);
                        static z_@@IDMAPITEMITER@@_t z_@@NAME@@_iterateItems(const z_@@NAME@@_t* _this) {
                            z_@@IDMAPITEMITER@@_t _it = {0};
                            /* the same const stop as `get` and z_Set's `iterate`: OptionView's payload
                               is a bare void*, so const cannot propagate into it */
                            _it.m = (z_@@NAME@@_t*)_this;
                            _it.idx = 0;
                            return _it;
                        }
                        """
                )
            }
        )
        (
            c.template
            name: "IdMapMut"
            sections: list {
                (
                    c.section
                    text: """
                        /* getMut hands back a pointer INTO the entry where the value family's `get`
                           copies out, so an update writes the entry in place instead of going through
                           `set`. One emitted function for both families: what differs is the declared
                           return, exactly as ListRef.get (a view) and ListVal.get (a copy) already
                           differ while sharing one getMut.

                           Its own file, for the reason z_IdMapIter.c.tmpl is separate: a mono whose
                           `getMut` never resolved must still emit its container, and a template read
                           by a seed that cannot fill its holes writes them into the C verbatim. */

                        static z_@@OPTIONMUT_V@@_t z_@@NAME@@_getMut(z_@@NAME@@_t* _this, @@KEY_T@@ _key);
                        static z_@@OPTIONMUT_V@@_t z_@@NAME@@_getMut(z_@@NAME@@_t* _this, @@KEY_T@@ _key) {
                            z_@@OPTIONMUT_V@@_t _r = {0};
                            int64_t idx = z_@@NAME@@_find(_this, _key, NULL);
                            if (idx >= 0) {
                                _r.tag = @@OPTIONMUT_V_SOME@@;
                                _r.data = &_this->entries[idx].value;
                            } else {
                                _r.tag = @@OPTIONMUT_V_NONE@@;
                                _r.data = NULL;
                            }
                            return _r;
                        }
                        """
                )
            }
        )
        (
            c.template
            name: "IdMap_copy"
            needs: list { "prelude.@xcalloc" }
            sections: list {
                (
                    c.section
                    text: """
                        /* IdMapV.copy -- an owned duplicate that shares no storage with the source.
                           The key is a scalar and the value a valtype, so the dense entry array copies
                           as bytes and the index copies verbatim.

                           TWO THINGS THE SIZE MUST COME FROM THE SOURCE, not from `length`. The entry
                           array is allocated at entries_cap(capacity) -- the 2/3 load factor the index
                           grows at -- so a copy sized by length would be reallocated out from under
                           the next `set`. And below SMALL_MAX there is no index at all: `indices ==
                           NULL` is the discriminator every lookup reads, so a copy that allocated one
                           would put the source and the duplicate on different code paths. */
                        static z_@@NAME@@_t z_@@NAME@@_copy(const z_@@NAME@@_t* _this);
                        static z_@@NAME@@_t z_@@NAME@@_copy(const z_@@NAME@@_t* _this) {
                            z_@@NAME@@_t _out = {0};
                            if (!_this || _this->capacity == 0) return _out;
                            _out.length = _this->length;
                            _out.capacity = _this->capacity;
                            uint32_t _ecap = z_@@NAME@@_entries_cap(_this->capacity);
                            if (_ecap > 0 && _this->entries) {
                                _out.entries = (z_@@NAME@@_entry_t*)z_xcalloc(_ecap, sizeof(z_@@NAME@@_entry_t));
                                memcpy(_out.entries, _this->entries, (size_t)_ecap * sizeof(z_@@NAME@@_entry_t));
                            }
                            if (_this->indices) {
                                _out.indices = (uint32_t*)z_xcalloc(_this->capacity, sizeof(uint32_t));
                                memcpy(_out.indices, _this->indices, (size_t)_this->capacity * sizeof(uint32_t));
                            }
                            return _out;
                        }
                        """
                )
            }
        )
        (
            c.template
            name: "IdSet"
            sections: list {
                (
                    c.section
                    text: """
                        /* IdSet -- an append-only set of unsigned scalar ids.

                           z_IdMap.c.tmpl without the value column; see that file for why there is no
                           `alive` byte, no stored hash, no DELETED sentinel and no free(p), and for
                           the reasoning behind the index function and the small mode. */

                        #define Z_@@MACRO@@_SMALL_MAX 16

                        typedef struct z_@@NAME@@_t {
                            uint32_t length;
                            uint32_t capacity;
                            uint32_t* indices;
                            @@ITEM_T@@* items;
                        } z_@@NAME@@_t;

                        """
                )
                (
                    c.section
                    member: "slot"
                    text: """
                        static uint64_t z_@@NAME@@_slot(@@ITEM_T@@ _item);
                        static uint64_t z_@@NAME@@_slot(@@ITEM_T@@ _item) {
                            return (((uint64_t)_item) * 0x9E3779B97F4A7C15ULL) >> 32;
