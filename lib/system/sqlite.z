# sqlite -- SQLite databases: open one, run SQL against it, close it. The
# library is SQLite 3.54.0 (vendor/sqlite), compiled into the program that
# reaches this unit -- zc builds it once per C compiler into its object cache
# and links it statically, so a program needs no SQLite installed.
#
# Lifetimes are the type system's, as in Rust's rusqlite: a Database is owned
# and closes when it goes out of scope (an explicit `close` reports what that
# would swallow), and what borrows from it keeps it pinned while it lives.
#
#     db: sqlite.openMemory
#     if db.err then return
#     r: db.executeBatch sql: "create table t(x); insert into t values (1)"
#     if r.err then print "failed: \{r.message}"

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :Connection
    :Database
    :Statement
    :Step
    :Row
    :Value
    :SqliteError
    :errorcode
    :columntype
    :columnerror
    :openmode
    :open
    :openMemory
    :version
}

# SqliteError -- why an SQLite call failed: the primary result code, the
# extended one SQLite reports beside it, its message and, for an SQL syntax
# error, the byte offset into the SQL where it was found
SqliteError: class {
    # what kind of failure, SQLite's primary result code
    code: errorcode
    # SQLite's extended result code, which refines `code` (SQLITE_CONSTRAINT_UNIQUE
    # within constraint, say); its documented numbers
    extendedCode: i32
    # SQLite's own description of the failure
    message: String
    # where in the SQL a syntax or name error was found, as a byte offset; none
    # when the error is not about a position
    offset: optionval u64
}

# errorcode -- SQLite's primary result codes, the kinds of failure. Each arm is
# the code of the same name in SQLite's documentation (busy is SQLITE_BUSY)
errorcode: variant {
    # a generic SQL error or missing database
    error: null
    # an internal logic error in SQLite
    internal: null
    # the access permission the operation needs is denied
    permission: null
    # a callback asked for the operation to abort
    abort: null
    # the database file is locked by another connection
    busy: null
    # a table in the database is locked by this connection
    locked: null
    # an allocation failed
    noMemory: null
    # an attempt to write a read-only database
    readOnly: null
    # the operation was interrupted
    interrupt: null
    # a disk I/O error
    ioError: null
    # the database file is malformed
    corrupt: null
    # an unknown opcode or file-control operation
    notFound: null
    # the database or disk is full
    full: null
    # the database file cannot be opened
    cannotOpen: null
    # a database lock protocol error (SQLITE_PROTOCOL; `protocol` is a
    # keyword)
    lockProtocol: null
    # the database schema changed under a statement
    schema: null
    # a string or blob exceeds the size limit
    tooBig: null
    # a constraint was violated: NOT NULL, UNIQUE, CHECK, a foreign key
    constraint: null
    # a datatype mismatch
    mismatch: null
    # the library was used incorrectly
    misuse: null
    # the host lacks large-file support
    noLargeFileSupport: null
    # an authorization callback refused
    authorization: null
    # not used by current SQLite
    format: null
    # a parameter or column index is out of range
    range: null
    # the file opened is not a database
    notADatabase: null
    # a notification from the log, not an error
    notice: null
    # a warning from the log, not an error
    warning: null
}

# openmode -- how `open` opens a database file
openmode: variant {
    # read and write, creating the file when it does not exist
    create: null
    # read and write an existing file
    readWrite: null
    # read an existing file, never writing it
    readOnly: null
}

# columntype -- what a column of a row holds: SQLite's storage classes
columntype: variant {
    # SQL NULL
    null: system.null
    # a signed 64-bit integer
    integer: system.null
    # an IEEE 64-bit float
    real: system.null
    # a string of text
    text: system.null
    # a blob of bytes, stored as given
    blob: system.null
}

# columnerror -- why a Row's typed getter could not answer: the getters are
# strict, as rusqlite's are, and convert only what cannot lose
columnerror: variant {
    # the column holds SQL NULL
    null: system.null
    # the column holds another storage class than the getter reads
    mismatch: system.null
    # the row has no such column
    range: system.null
    # the column holds TEXT that is not valid UTF-8
    encoding: system.null
}

# Value -- a column's value, owned: whatever storage class the column holds
Value: union {
    # SQL NULL
    null: system.null
    # what an INTEGER column holds: SQLite stores at most 64 bits, signed
    integer: i64
    # what a REAL column holds: SQLite stores an IEEE 754 double, nothing wider
    real: f64
    # TEXT, as UTF-8
    text: String
    # a BLOB column's bytes, copied out of the row, which the Value outlives
    blob: Bytes
}

# Connection -- what a statement runs against: a Database, and, inside a
# transaction, the Transaction pinning it
Connection: protocol {
    # run `sql`, one or more statements separated by `;`, answering whether all
    # of them succeeded. The first failure stops the rest. Any result rows are
    # discarded: this is for schema and data changes
    executeBatch: function {t: this.view sql: StringView} out (Result null E: SqliteError)
    # compile `sql`, exactly one statement, into a Statement that keeps the
    # connection pinned while it lives. SQL with a second statement after the
    # first is refused; a trailing comment is not one
    prepare: function {t: this.view sql: StringView} outx (Result Statement E: SqliteError)
}

# Step -- what stepping a statement answers: the next row, the end, or why it
# failed. A row pins its statement until the Step goes out of scope, so the
# next step waits for it
Step: union {
    # the next result row
    row: Row
    # the statement ran to completion
    done: null
    # why the step failed
    err: SqliteError
}

# Row -- one result row of a stepped statement, read by column, 0-based. Its
# getters are strict: an integer is read from INTEGER only, a real from REAL or
# INTEGER, text from TEXT and a blob from BLOB; NULL answers `null`
Row: class {
    # SQLite's statement pointer the row is read from
    handle: u64
} as {
    public: unit {
        :integer
        :real
        :text
        :blob
        :value
        :columnType
        :columnCount
        :columnName
    }
    # the INTEGER in `column`. A REAL is `mismatch`, not truncated: nothing
    # converts that could lose the value
    integer: function {t: this.view column: u64} out (resultval i64 e: columnerror) is native
    # the REAL in `column`, or its INTEGER converted
    real: function {t: this.view column: u64} out (resultval f64 e: columnerror) is native
    # the TEXT in `column`, checked to be UTF-8: a view into the row that lives
    # as long as the row does
    text: function {t: this.view column: u64} outx (ResultRV StringView e: columnerror) is native
    # the BLOB in `column`: a view into the row that lives as long as the row
    # does
    blob: function {t: this.view column: u64} outx (ResultRV ByteView e: columnerror) is native
    # whatever `column` holds, copied out
    value: function {t: this.view column: u64} out (ResultRV Value e: columnerror) is native
    # the storage class `column` holds
    columnType: function {t: this.view column: u64} out (resultval columntype e: columnerror
    ) is native
    # how many columns the row has
    columnCount: function {t: this.view} out u64 is native
    # the name of `column`: its `AS` alias, else what SQLite names it
    columnName: function {t: this.view column: u64} outx (ResultRV StringView e: columnerror
    ) is native
}

# Statement -- a compiled SQL statement, owned, pinning the connection it was
# prepared on. Parameters are bound 1-based (`?1`, or by `parameterIndex` for
# `:name`) and stay bound across executions until rebound or cleared; an
# unbound parameter is NULL. A bind on a statement that has been stepped resets
# it first. A bind that fails -- no such parameter -- is reported by the next
# `step` or `execute`, naming the parameter
Statement: class {
    # SQLite's statement pointer; 0 for SQL that holds no statement
    handle: u64
    # SQLite's connection pointer, for its errors
    db: u64
    # the first failed bind's result code since the last step, 0 when none
    bindRc: i32
    # the parameter that failed
    bindParam: u64
} as {
    public: unit {
        :bindInteger
        :bindReal
        :bindText
        :bindBlob
        :bindNull
        :bindValue
        :parameterIndex
        :parameterCount
        :columnCount
        :columnName
        :columnDeclaredType
        :columnTableName
        :columnOriginName
        :columnDatabaseName
        :step
        :execute
        :reset
        :clearBindings
        :sql
    }
    # bind `value` to the 1-based `parameter` as a 64-bit INTEGER
    bindInteger: function {:this parameter: u64 value: i64} is native
    # bind `value` to `parameter` as a REAL, which SQLite keeps a double
    bindReal: function {:this parameter: u64 value: f64} is native
    # bind TEXT to `parameter`, copied
    bindText: function {:this parameter: u64 value: StringView} is native
    # bind a BLOB to `parameter`, copied
    bindBlob: function {:this parameter: u64 value: ByteView} is native
    # set `parameter` to SQL NULL, as an unbound or cleared parameter already is
    bindNull: function {:this parameter: u64} is native
    # bind whatever `value` holds to `parameter`, copied
    bindValue: function {:this parameter: u64 value: Value.view} is native
    # the index of the parameter named `name` (`:id`, `@id`, `$id`, the prefix
    # included), none when the statement has no such parameter
    parameterIndex: function {t: this.view name: StringView} out optionval u64 is native
    # how many parameters the statement takes: its largest index
    parameterCount: function {t: this.view} out u64 is native
    # how many columns its rows have
    columnCount: function {t: this.view} out u64 is native
    # the name of `column`: its `AS` alias, else what SQLite names it
    columnName: function {t: this.view column: u64} outx (ResultRV StringView e: columnerror
    ) is native
    # the type `column` was declared with in its table; `null` for an
    # expression, which has none
    columnDeclaredType: function {t: this.view column: u64} outx (ResultRV StringView e: columnerror
    ) is native
    # the table `column` reads, `null` for an expression
    columnTableName: function {t: this.view column: u64} outx (ResultRV StringView e: columnerror
    ) is native
    # the table column `column` reads, unaliased; `null` for an expression
    columnOriginName: function {t: this.view column: u64} outx (ResultRV StringView e: columnerror
    ) is native
    # the database (`main`, `temp`, an attached name) `column` reads; `null`
    # for an expression
    columnDatabaseName: function {t: this.view column: u64} outx (ResultRV StringView e: columnerror
    ) is native
    # run the statement to its next row. The row pins the statement: the next
    # step is taken once the Step answered goes out of scope
    step: function {:this} outx Step is native
    # run the statement to completion for its effect, answering how many rows
    # it changed. A statement that yields a row is refused: step through it
    execute: function {:this} out (ResultVR u64 E: SqliteError) is native
    # rewind the statement to run again from the start, keeping its bindings
    reset: function {:this} is native
    # set every parameter back to NULL
    clearBindings: function {:this} is native
    # the SQL the statement was compiled from
    sql: function {t: this.view} outx StringView is native
}

# Database -- an open SQLite database connection. Owned: it closes when it goes
# out of scope, and an explicit `close` answers what closing reported. A
# connection has a 5 second busy timeout from `open`: a write that meets
# another connection's lock waits that long before failing with `busy`.
Database: class {
    # SQLite's connection pointer
    handle: u64
    # whether close has run, which makes the destructor and a second close
    # no-ops
    closed: bool
} as {
    public: unit {
        :Connection
        :executeBatch
        :prepare
        :close
    }
    :Connection
    # run `sql`, one or more statements separated by `;`, answering whether all
    # of them succeeded (Connection)
    executeBatch: function {t: this.view sql: StringView} out (Result null E: SqliteError) is native
    # compile `sql`, exactly one statement, into a Statement that keeps this
    # Database pinned while it lives (Connection)
    prepare: function {t: this.view sql: StringView} outx (Result Statement E: SqliteError
    ) is native
    # close the connection now, answering what closing reported. Closing an
    # already closed Database answers ok
    close: function {:this} out (Result null E: SqliteError) is native
}

# open -- open the database file at `path`, creating it when `mode` is
# `create` (the default) and it does not exist. Fails with `cannotOpen`, naming
# the file, when it cannot be opened as `mode` asks
open: function {path: StringView mode: openmode.create} out (Result Database E: SqliteError) is {
    return (openPath :path flags: (openFlags :mode))
}

# openMemory -- a new, empty database that lives in memory and is gone when it
# closes
openMemory: function out (Result Database E: SqliteError) is {
    return (openPath path: ":memory:" flags: (openFlags mode: openmode.create))
}

# openFlags -- SQLite's sqlite3_open_v2 flags for `mode`: SQLITE_OPEN_READONLY
# 1, READWRITE 2, CREATE 4
openFlags: function {mode: openmode} out i32 is {
    match (
        mode
    ) case create then {
        return 6
    } case readWrite then {
        return 2
    } case readOnly then {
        return 1
    }
}

# openPath -- open `path` with sqlite3_open_v2's `flags` and the connection's
# defaults: extended result codes, a 5 second busy timeout
openPath: function {path: StringView flags: i32} out (Result Database E: SqliteError) is native

# version -- the SQLite library's version, `3.54.0`
version: function out String is native
