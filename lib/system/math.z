# math -- numbers past the machine's own: integers, rationals and binary
# floats of any size.
#
# The arbitrary-precision core is a port of Go's math/big (BSD-3-Clause; the
# license is math/LICENSE-GO, and each ported file names its source). Its
# subunits are private: `arith` the word-vector kernels, `nat` the natural
# numbers built on them, `natmul`, `natdiv` and `natconv` their
# multiplication, division and conversion, `bigint` the signed integer and
# `bigrat` the rational and `bigfloat` the binary float this unit exposes, and
# `rounding` the modes every rounding operation takes and the accuracy it
# reports.
public: unit {
    :nat
    :natexp
    # a signed integer of any size
    BigInt: bigint.BigInt
    # a quotient and its remainder, as BigInt.divide answers them
    BigDivision: bigint.BigDivision
    # how a result between two representable values is chosen
    roundingmode: rounding.roundingmode
    # a greatest common divisor and its cofactors, as BigInt.gcdExtended
    # answers them
    BigGCD: bigint.BigGCD
    # a rational of any size, in lowest terms
    BigRat: bigrat.BigRat
    # how many digits a rational's decimal expansion has before it repeats
    decimalprec: bigrat.decimalprec
    # a binary floating-point number of any precision
    BigFloat: bigfloat.BigFloat
    # how a rounded result compares to the exact value
    accuracy: rounding.accuracy
    # how BigFloat.text spells a value
    floatformat: bigfloat.floatformat
}
