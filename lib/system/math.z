# math -- numbers past the machine's own: integers, rationals and binary
# floats of any size.
#
# The arbitrary-precision core is a port of Go's math/big (BSD-3-Clause; the
# license is math/LICENSE-GO, and each ported file names its source). Its
# subunits are private: `arith` the word-vector kernels, `nat` the natural
# numbers built on them, `natmul`, `natdiv` and `natconv` their
# multiplication, division and conversion, `bigint` the signed integer and
# `bigrat` the rational and `bigfloat` the binary float this unit exposes, and
# `rounding` the modes every rounding operation takes and the accuracy it
# reports.
#
# The mathematical constants are untyped, written to 70 digits: each lands in
# any float type as that type's value nearest it, rounded once.
public: unit {
    :nat
    :natexp
    # a signed integer of any size
    BigInt: bigint.BigInt
    # a signed integer of 64*words bits, wrapping as i64 does
    int: fixedint.int
    # an unsigned integer of 64*words bits, wrapping as u64 does
    uint: fixedint.uint
    # a signed 256-bit integer
    i256: (fixedint.int words: 4)
    # an unsigned 256-bit integer
    u256: (fixedint.uint words: 4)
    # a signed 512-bit integer
    i512: (fixedint.int words: 8)
    # an unsigned 512-bit integer
    u512: (fixedint.uint words: 8)
    # a fixed decimal of at most 9 digits, over four bytes
    decimal32: dec32.decimal32
    # a fixed decimal of at most 18 digits
    decimal64: dec64.decimal64
    # a fixed decimal of at most 38 digits
    decimal128: dec128.decimal128
    # a fixed decimal of at most 76 digits
    decimal256: dec256.decimal256
    # why a fixed decimal is invalid
    decerror: decimal.decerror
    # a binary float of 64*words mantissa bits, held inline
    float: fixedfloat.float
    # a quotient and its remainder, as BigInt.divide answers them
    BigDivision: bigint.BigDivision
    # how a result between two representable values is chosen
    roundingmode: rounding.roundingmode
    # a greatest common divisor and its cofactors, as BigInt.gcdExtended
    # answers them
    BigGCD: bigint.BigGCD
    # a rational of any size, in lowest terms
    BigRat: bigrat.BigRat
    # how many digits a rational's decimal expansion has before it repeats
    decimalprec: bigrat.decimalprec
    # a binary floating-point number of any precision
    BigFloat: bigfloat.BigFloat
    # how a rounded result compares to the exact value
    accuracy: rounding.accuracy
    # how BigFloat.text spells a value
    floatformat: bigfloat.floatformat
    # pi, the ratio of a circle's circumference to its diameter
    pi: 3.141592653589793238462643383279502884197169399375105820974944592307816
    # e, the base of the natural logarithm
    e: 2.718281828459045235360287471352662497757247093699959574966967627724077
    # phi, the golden ratio (1 + sqrt 5) / 2
    phi: 1.618033988749894848204586834365638117720309179805762862135448622705260
    # the square root of 2, the diagonal of a unit square
    sqrt2: 1.414213562373095048801688724209698078569671875376948073176679737990732
    # e to the power one half
    sqrtE: 1.648721270700128146848650787814163571653776100710148011575079311640661
    # the square root of pi, the integral of exp(-x^2) over the whole line
    sqrtPi: 1.772453850905516027298167483341145182797549456122387128213807789852911
    # phi to the power one half
    sqrtPhi: 1.272019649514068964252422461737491491715608041840096248616640382539298
    # the natural logarithm of 2
    ln2: 0.6931471805599453094172321214581765680755001343602552541206800094933936
    # the base-2 logarithm of e, 1 / ln2
    log2E: 1.442695040888963407359924681001892137426645954152985934135449406931109
    # the natural logarithm of 10
    ln10: 2.302585092994045684017991454684364207601101488628772976033327900967573
    # the base-10 logarithm of e, 1 / ln10
    log10E: 0.4342944819032518276511289189166050822943970058036665661144537831658646
}
