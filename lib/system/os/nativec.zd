            pulls: list { "io.@sv_cstr?posix" }
            fragments: list {
                """
                /* os.get_env -- look up the environment by name (Win32's on Windows,
                   where names match regardless of case). Returns
                   option.some(string) on hit (copying the value so the caller
                   owns the heap buffer and libc's environ isn't aliased); returns
                   option.none on miss. `key` is a borrowed view; caller retains. */
                static z_@Option_String@_t z_os_env(z_@StringView@_t key);
                static z_@Option_String@_t z_os_env(z_@StringView@_t key) {
                    z_@Option_String@_t out = {0};
                #if defined(_WIN32)
                    char* v = z_win_getenv(key.data, key.size);
                #else
                    char* key_cstr = z_sv_to_cstr(key);
                    const char* v = getenv(key_cstr);
                    free(key_cstr);
                #endif
                    if (v == NULL) {
                        out.tag = @ARM_Option_String.none@;
                        return out;
                    }
                    z_@String@_t* boxed = (z_@String@_t*)z_xmalloc(sizeof(z_@String@_t));
                    *boxed = z_@String@_new(v);
                #if defined(_WIN32)
                    free(v);
                #endif
                    out.tag = @ARM_Option_String.some@;
                    out.data = boxed;
                    return out;
                }


                """
            }
        )
        (
            c.row
            key: "buildCommit"
            needs: list { "prelude.@String_new" }
            fragments: list {
                """
                /* os.buildCommit -- the build stamp this binary carries, empty when the
                   build supplied none. Two routes set it: define ZC_BUILD_COMMIT for the C
                   compiler, or define ZC_BUILD_STAMP_LINKED and link an object that defines
                   z_build_commit and z_build_date. The link route costs a relink rather than
                   a recompile of this translation unit when the stamp changes, which is why
                   the Makefile uses it. There is no weak default to override: on PE/COFF
                   (mingw) a strong definition does not reliably replace a weak one, and
                   MSVC has no weak symbols at all. */
                #if defined(ZC_BUILD_STAMP_LINKED)
                extern const char z_build_commit[];
                #else
                #ifndef ZC_BUILD_COMMIT
                #define ZC_BUILD_COMMIT ""
                #endif
                const char z_build_commit[] = ZC_BUILD_COMMIT;
                #endif

                static z_@String@_t z_os_buildCommit(void);
                static z_@String@_t z_os_buildCommit(void) {
                    return z_@String@_new(z_build_commit);
                }

                """
            }
        )
        (
            c.row
            key: "buildCompiler"
            needs: list { "prelude.@String_new" }
            fragments: list {
                """
                /* os.buildCompiler -- name and version of the C compiler that compiled this
                   translation unit, read from its own predefined macros, so it needs nothing
                   from the build. clang defines __GNUC__ as well, so it is tested first. The
                   numeric macros are used rather than __VERSION__, which gcc and clang spell
                   differently ("15.2.0" vs "Ubuntu Clang 21.1.8 (6ubuntu1)"). */
                #define Z_BUILDCC_STR_(x) #x
                #define Z_BUILDCC_STR(x) Z_BUILDCC_STR_(x)

                static z_@String@_t z_os_buildCompiler(void);
                static z_@String@_t z_os_buildCompiler(void) {
                #if defined(__clang__)
                    return z_@String@_new("clang " Z_BUILDCC_STR(__clang_major__) "."
                                        Z_BUILDCC_STR(__clang_minor__) "."
                                        Z_BUILDCC_STR(__clang_patchlevel__));
                #elif defined(__GNUC__)
                    return z_@String@_new("gcc " Z_BUILDCC_STR(__GNUC__) "."
                                        Z_BUILDCC_STR(__GNUC_MINOR__) "."
                                        Z_BUILDCC_STR(__GNUC_PATCHLEVEL__));
                #elif defined(_MSC_VER)
                    /* _MSC_VER is 1951 for MSVC 19.51, and _MSC_FULL_VER adds the build */
                    char v[48];
                    snprintf(v, sizeof v, "msvc %d.%d.%d", _MSC_VER / 100, _MSC_VER % 100, _MSC_FULL_VER % 100000);
                    return z_@String@_new(v);
                #else
                    return z_@String@_new("cc");
                #endif
                }

                """
            }
        )
