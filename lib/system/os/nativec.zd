        (
            c.row
            key: "userName"
            needs: list { "prelude.@String_new" "prelude.@xmalloc" "prelude.@win_utf8" }
            pulls: list { "io.@errno" }
            fragments: list {
                """
                /* os.user_name -- resolve the effective uid via getpwuid_r.
                   Starts with a 1 KiB buffer and retries once with 16 KiB if
                   ERANGE; beyond that, surface as ioerror.other. */
                static z_@Result_String_IoError@_t z_os_userName(void);
                static z_@Result_String_IoError@_t z_os_userName(void) {
                    z_@Result_String_IoError@_t out = {0};
                #if defined(_WIN32)
                    /* the account the process runs as (GetUserNameW) */
                    wchar_t w[257];
                    DWORD wn = 257;
                    char* name = GetUserNameW(w, &wn) ? z_win_utf8(w, -1, NULL) : NULL;
                    if (name == NULL) {
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        *boxed = z_io_os_error((int)GetLastError());
                        out.tag = @ARM_Result_String_IoError.err@;
                        out.data = boxed;
                        return out;
                    }
                    z_@String@_t* sb = (z_@String@_t*)z_xmalloc(sizeof(z_@String@_t));
                    *sb = z_@String@_new(name);
                    free(name);
                    out.tag = @ARM_Result_String_IoError.ok@;
                    out.data = sb;
                    return out;
                #else
                    uid_t uid = geteuid();
                    size_t bufsize = 1024;
                    for (int attempt = 0; attempt < 2; attempt++) {
                        char* buf = (char*)z_xmalloc(bufsize);
                        struct passwd pwd;
                        struct passwd* result = NULL;
                        int rc = getpwuid_r(uid, &pwd, buf, bufsize, &result);
                        if (rc == 0 && result != NULL) {
                            z_@String@_t* boxed = (z_@String@_t*)z_xmalloc(sizeof(z_@String@_t));
                            *boxed = z_@String@_new(pwd.pw_name);
                            free(buf);
                            out.tag = @ARM_Result_String_IoError.ok@;
                            out.data = boxed;
                            return out;
                        }
                        free(buf);
                        if (rc == ERANGE && attempt == 0) {
                            bufsize = 16 * 1024;
                            continue;
                        }
                        int e = (rc == 0) ? ENOENT : rc;
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        *boxed = z_io_os_error(e);
                        out.tag = @ARM_Result_String_IoError.err@;
                        out.data = boxed;
                        return out;
                    }
                    /* unreachable */
                    out.tag = @ARM_Result_String_IoError.err@;
                    out.data = NULL;
                    return out;
                #endif
                }


                """
            }
        )
        (
            c.row
            key: "waitAny"
            needs: list { "prelude.zwin32" }
            fragments: list {
                """
                /* os.waitAny -- reap one exited child among `children` without blocking,
                   marking it reaped; pid 0 = none of them has exited. Each child is asked
                   about by its own pid (POSIX) or handle (Windows), so a child another part
                   of the program started is never reaped here, and one already reaped is
                   skipped. status decodes like os.spawn: the exit code; a signalled child
                   reports 128 + signo; one Child.kill ended reports 137 everywhere. */
                static z_@procexit@_t z_os_waitAny(z_@List_Child@_t* children);
                static z_@procexit@_t z_os_waitAny(z_@List_Child@_t* children) {
                    z_@procexit@_t r = {0};
                    for (uint64_t i = 0; i < children->length; i++) {
                        z_@Child@_t* c = &children->data[i];
                        if (c->@MEMBER_Child.reaped@ || c->@MEMBER_Child.pid@ <= 0) continue;
                #if defined(_WIN32)
                        HANDLE h = (HANDLE)(intptr_t)c->@MEMBER_Child.handle@;
                        if (WaitForSingleObject(h, 0) != WAIT_OBJECT_0) continue;
                        DWORD code = 127;
                        if (!GetExitCodeProcess(h, &code)) code = 127;
                        r.@MEMBER_procexit.status@ = (int32_t)code;
                #else
                        int wst = 0;
                        pid_t p = waitpid((pid_t)c->@MEMBER_Child.pid@, &wst, WNOHANG);
                        if (p <= 0) continue;
                        if (WIFEXITED(wst)) {
                            r.@MEMBER_procexit.status@ = (int32_t)WEXITSTATUS(wst);
                        } else if (WIFSIGNALED(wst)) {
                            r.@MEMBER_procexit.status@ = 128 + (int32_t)WTERMSIG(wst);
                        } else {
                            r.@MEMBER_procexit.status@ = 127;
                        }
                #endif
                        c->@MEMBER_Child.reaped@ = true;
                        r.@MEMBER_procexit.pid@ = c->@MEMBER_Child.pid@;
                        return r;
                    }
                    return r;
                }
                """
            }
        )
    }
    canons: list {
        (c.canon stem: "List_Child" spec: list { "ListRef" "os.Child" })
        (c.canon stem: "Result_Child_IoError" spec: list { "Result" "os.Child" "IoError" })
    }
    links: list {
        # On Windows os.userName is advapi32's (GetUserNameW) and the command line is
        # split by shell32's CommandLineToArgvW: mingw-w64 gcc links both by default,
        # tcc and cl do not
        (c.link library: "advapi32" os: list { c.os.windows })
        (c.link library: "shell32" os: list { c.os.windows })
    }
)
