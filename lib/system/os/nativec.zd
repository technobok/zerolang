                   compiler, or under ZC_BUILD_STAMP_LINKED by the linked object, as
                   os.buildCommit is. */
                #if defined(ZC_BUILD_STAMP_LINKED)
                extern const char z_build_date[];
                #else
                #ifndef ZC_BUILD_DATE
                #define ZC_BUILD_DATE ""
                #endif
                const char z_build_date[] = ZC_BUILD_DATE;
                #endif

                static z_@String@_t z_os_buildDate(void);
                static z_@String@_t z_os_buildDate(void) {
                    return z_@String@_new(z_build_date);
                }

                """
            }
        )
        (
            c.row
            key: "cwd"
            needs: list { "prelude.@String_new" "prelude.@xmalloc" "prelude.@win_utf8" }
            pulls: list { "io.@errno" }
            fragments: list {
                """
                /* os.cwd -- getcwd(NULL, 0) allocates a buffer sized to the
                   current path. We copy into a z_@String@_t and free the libc
                   buffer so ownership stays uniform. On Windows it is
                   GetCurrentDirectoryW's native path, as UTF-8. */
                static z_@Result_String_IoError@_t z_os_cwd(void);
                static z_@Result_String_IoError@_t z_os_cwd(void) {
                    z_@Result_String_IoError@_t out = {0};
                #if defined(_WIN32)
                    char* buf = NULL;
                    DWORD need = GetCurrentDirectoryW(0, NULL);
                    int e = (int)GetLastError();
                    if (need > 0) {
                        wchar_t* w = (wchar_t*)z_xmalloc((size_t)need * sizeof(wchar_t));
                        DWORD got = GetCurrentDirectoryW(need, w);
                        e = (int)GetLastError();
                        if (got > 0 && got < need) buf = z_win_utf8(w, (int)got, NULL);
                        free(w);
                    }
                #else
                    char* buf = getcwd(NULL, 0);
                    int e = errno;
                #endif
                    if (buf == NULL) {
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        *boxed = z_io_os_error(e);
                        out.tag = @ARM_Result_String_IoError.err@;
                        out.data = boxed;
                        return out;
                    }
                    z_@String@_t* boxed = (z_@String@_t*)z_xmalloc(sizeof(z_@String@_t));
                    *boxed = z_@String@_new(buf);
                    free(buf);
                    out.tag = @ARM_Result_String_IoError.ok@;
                    out.data = boxed;
                    return out;
                }


                """
            }
        )
        (
            c.row
            key: "envNames"
            needs: list {
                "prelude.zwin32" "prelude.@String_append" "prelude.@String_create"
                "prelude.@win_utf8"
            }
            members: list { "List_String.create" "List_String.append" }
            fragments: list {
                """
                /* os.env_names -- snapshot of the environment's names. Each entry is
                   `key=value`; we copy the portion before the first `=` into a
                   freshly-allocated z_@String@_t and push onto an owned list. The list's
                   destructor frees each string. Windows' block (GetEnvironmentStringsW)
                   also holds a hidden `=C:=C:\dir` entry per drive -- the shell's current
                   directories -- which names nothing a program set and is left out. */
                #if !defined(_WIN32)
                extern char** environ;
                #endif
                static z_@List_String@_t z_os_envNames(void);
                static z_@List_String@_t z_os_envNames(void) {
                    z_@List_String@_t out = z_@List_String@_create((uint64_t)0);
                #if defined(_WIN32)
                    wchar_t* block = GetEnvironmentStringsW();
                    if (block == NULL) return out;
                    for (const wchar_t* ep = block; *ep != 0; ep += wcslen(ep) + 1) {
                        if (ep[0] == L'=') continue;
                        const wchar_t* eq = wcschr(ep, L'=');
                        int n = eq != NULL ? (int)(eq - ep) : (int)wcslen(ep);
                        size_t un = 0;
                        char* u = z_win_utf8(ep, n, &un);
                        if (u == NULL) continue;
                        z_@String@_t s = z_@String@_create((uint64_t)un);
                        z_@String@_append(&s, u, (uint64_t)un);
                        free(u);
                        z_@List_String@_append(&out, s);
                    }
                    FreeEnvironmentStringsW(block);
                #else
                    if (environ == NULL) return out;
                    for (char** ep = environ; *ep != NULL; ep++) {
                        const char* entry = *ep;
                        const char* eq = strchr(entry, '=');
                        size_t n = (eq != NULL) ? (size_t)(eq - entry) : strlen(entry);
                        z_@String@_t s = z_@String@_create((uint64_t)n);
                        z_@String@_append(&s, entry, (uint64_t)n);
                        z_@List_String@_append(&out, s);
                    }
                #endif
                    return out;
                }
                """
            }
        )
        (
            c.row
            key: "exePath"
            needs: list { "prelude.@String_new" "prelude.@xmalloc" "prelude.@win_utf8" }
            pulls: list { "io.@errno" }
            fragments: list {
                """
                /* os.exePath -- absolute path of the running executable. Linux
                   reads /proc/self/exe; macOS uses _NSGetExecutablePath; Windows
                   GetModuleFileNameW, a native path. Copied
                   into a z_@String@_t so ownership stays uniform with the other os
                   string natives. */
                #if defined(__APPLE__)
                #include <mach-o/dyld.h>
                #endif
                static z_@Result_String_IoError@_t z_os_exePath(void);
                static z_@Result_String_IoError@_t z_os_exePath(void) {
                    z_@Result_String_IoError@_t out = {0};
                #if defined(_WIN32)
                    /* the buffer doubles until the name fits: a long path is not cut short */
                    DWORD cap = 512;
                    char* path = NULL;
                    for (;;) {
                        wchar_t* w = (wchar_t*)z_xmalloc((size_t)cap * sizeof(wchar_t));
                        DWORD got = GetModuleFileNameW(NULL, w, cap);
                        if (got == 0) {
                            free(w);
                            break;
                        }
                        if (got < cap) {
                            path = z_win_utf8(w, (int)got, NULL);
                            free(w);
                            break;
                        }
                        free(w);
                        cap *= 2;
                    }
                    if (path == NULL) {
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        *boxed = z_io_os_error((int)GetLastError());
                        out.tag = @ARM_Result_String_IoError.err@;
                        out.data = boxed;
                        return out;
                    }
                    z_@String@_t* sb = (z_@String@_t*)z_xmalloc(sizeof(z_@String@_t));
                    *sb = z_@String@_new(path);
                    free(path);
                    out.tag = @ARM_Result_String_IoError.ok@;
                    out.data = sb;
                    return out;
                #else
                    char buf[4096];
                #if defined(__APPLE__)
                    uint32_t bufsize = (uint32_t)sizeof(buf);
                    if (_NSGetExecutablePath(buf, &bufsize) != 0) {
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        z_@IoError@_t e = {0};
                        e.tag = @ARM_IoError.other@;
                        z_@String@_t* sp = (z_@String@_t*)z_xmalloc(sizeof(z_@String@_t));
                        *sp = z_@String@_new("the executable's path is longer than 4095 bytes");
                        e.data = sp;
                        *boxed = e;
                        out.tag = @ARM_Result_String_IoError.err@;
                        out.data = boxed;
                        return out;
                    }
                #else
                    ssize_t len = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
                    if (len < 0) {
                        int e = errno;
                        z_@IoError@_t* boxed = (z_@IoError@_t*)z_xmalloc(sizeof(z_@IoError@_t));
                        *boxed = z_io_os_error(e);
                        out.tag = @ARM_Result_String_IoError.err@;
                        out.data = boxed;
                        return out;
                    }
                    buf[len] = '\0';
                #endif
                    z_@String@_t* boxed = (z_@String@_t*)z_xmalloc(sizeof(z_@String@_t));
                    *boxed = z_@String@_new(buf);
                    out.tag = @ARM_Result_String_IoError.ok@;
                    out.data = boxed;
                    return out;
                #endif
                }


                """
            }
        )
