# Recursive-descent parser for zerolang: units and their definitions,
# statements, expressions and string literals, built into the zast node
# table. It loads the units a unit refers to (collectExterns over the parsed
# body, then the VFS) but resolves nothing -- names are the type checker's.
#
# Public productions return (Option t: astnode): none means "nothing here"
# (the caller tries another production), some carrying an `error` arm
# means "committed but malformed". Internally the parse helpers return a
# bare astnode and the leading token is checked first (atomLookahead),
# because a reftype payload cannot be moved back out of an Option to
# build a parent node -- so an owned astnode local is threaded through
# construction and wrapped in an Option only at the boundary. astnode ids
# come from the parser's sequential counter, in parse order.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :Parser
}

# Local alias for the cross-unit AST node union, for brevity at the many
# `astnode.<arm>` / `(Option t: astnode)` sites below.
astnode: zast.astnode
Ast: zast.Ast

# StringChunk.chunkKind codes (EOL=5, STRMID=21, STRCHR=22): the values the
# ast_nodes dump carries, fixed apart from the toktype variant's own tags.
chunkkind: data {
    eol: 5
    strmid: 21
    strchr: 22
} out u8

# the string-chunk kind (literal vs interpolation) for token type `tt`.
chunkKindOf: function {tt: zlexer.toktype} out u8 is {
    match tt case strMidTok then {
        return chunkkind.strmid
    } case strChrTok then {
        return chunkkind.strchr
    } case eolTok then {
        return chunkkind.eol
    } else {
        return 0
    }
}

# True for the token types that contribute literal text to a string
# (a coalesced run, an escaped char, or an embedded newline).
isStrChunkTok: function {tt: zlexer.toktype} out bool is {
    match tt case strMidTok then {
        return true
    } case strChrTok then {
        return true
    } case eolTok then {
        return true
    } else {
        return false
    }
}

# True if every byte of `sv` is a space or tab (not `trim`, which also
# strips \n \r \f \v).
isWsOnlyView: function {sv: StringView} out bool is {
    n: sv.length
    i: u64
    allWs: true
    for i < n loop {
        bOpt: sv.byteAt i
        match (
            bOpt
        ) case some then {
            isSp: bOpt == 32
            isTab: bOpt == 9
            if isSp then {
            } else if (isTab) == false then allWs = false
        } case none then null
        i = i + 1
    }
    return allWs
}

# Classify a string part for the whitespace scans:
# 0 = not a stringchunk (interpolation) ; 1 = EOL ; 2 = STRMID ws-only ;
# 3 = STRMID has non-ws ; 4 = STRCHR ; 5 = other stringchunk kind.
partClass: function {n: astnode pool: zast.StringPool.view} out i64 is {
    code: 0
    if n.stringchunk then {
        k: n.chunkKind
        if k == chunkkind.eol then {
            code = 1
        } else if k == chunkkind.strmid then {
            ws: isWsOnlyView sv: (zast.poolTextAt :pool ref: n.text).stringView
            if ws then {
                code = 2
            } else {
                code = 3
            }
        } else if k == chunkkind.strchr then {
            code = 4
        } else {
            code = 5
        }
    }
    return code
}

# True if astnode `n` is a stringchunk whose text starts with `p`.
chunkStartsWith: function {n: astnode p: StringView pool: zast.StringPool.view} out bool is {
    res: false
    if n.stringchunk then {
        res = (zast.poolTextAt :pool ref: n.text).stringView.startsWith prefix: p
    }
    return res
}

# True for the ownership/access marker names that cannot be declared as
# type-body members (the language claims them in member position); the
# visibility members `public:`/`private:` carve out the unit form.
isReservedMemberName: function {id: zast.nameid} out bool is {
    if id.isZero then return false
    if id == zast.names.wkTake then return true
    if id == zast.names.wkBorrow then return true
    if id == zast.names.wkView then return true
    if id == zast.names.wkHold then return true
    if id == zast.names.wkDrop then return true
    if id == zast.names.wkPrivate then return true
    if id == zast.names.wkPublic then return true
    return false
}

# The kind a `unit` body carries, from the label that introduces it. This is
# the one place a unit's meaning is read from a name; every later reader asks
# `zast.unitrow.kind`. `require:` is a unit-level block only, so a type-body
# member of that name is an ordinary namespace.
unitKindForLabel: function {id: zast.nameid unitBody: bool} out zast.unitkind is {
    if id == zast.names.wkPublic then return zast.unitkind.publicNs
    if id == zast.names.wkPrivate then return zast.unitkind.privateNs
    if unitBody when id == zast.names.wkRequire then return zast.unitkind.requirement
    return zast.unitkind.namespace
}

# True when the node is the bare identifier `null` (through an
# `expression` wrapper).
nodeIsBareNull: function {ast: Ast.view n: astnode} out bool is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextEq :ast ref: n.name s: "null")
    } case expression then {
        return (nodeIsBareNull :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return false
    }
}

# True when a statement line wraps the bare identifier `null`.
slIsBareNull: function {ast: Ast.view sl: astnode} out bool is {
    match (
        sl
    ) case statementline then {
        return (nodeIsBareNull :ast n: (ast.nodes.get i: sl.statementline.u64))
    } else {
        return false
    }
}

# True when a clause body is exactly the bare atom `null` (one wrapped
# expression statement): the empty-body spelling.
isBareNullBody: function {ast: Ast.view body: astnode} out bool is {
    match (
        body
    ) case statement then {
        if body.statements.count.u64 != 1 then return false
        slId: zast.kidAt kids: ast.kids span: body.statements i: 0
        return (slIsBareNull :ast sl: (ast.nodes.get i: slId.u64))
    } else {
        return false
    }
}

# True for the keyword token types that open an inline type definition
# (record / class / variant / union / protocol / facet / data). These are
# rejected inside an object body -- such a type must be defined at unit
# level and referenced by name.
isInlineTypedefTok: function {tt: zlexer.toktype} out bool is {
    match tt case recordTok then {
        return true
    } case classTok then {
        return true
    } case variantTok then {
        return true
    } case unionTok then {
        return true
    } case protocolTok then {
        return true
    } case facetTok then {
        return true
    } case generatorTok then {
        return true
    } case dataTok then {
        return true
    } else {
        return false
    }
}

# Reverse a node list into a new list. The greedy operation list is
# built in source order but consumed front-to-back; List.pop yields the
# tail, so reversing once lets each pop yield the next source element.
# The input is drained (its elements move into the result).
reverseNodes: function {src: (ListVal astnode).take} out ListVal astnode is {
    # in place: a row is 52 bytes now, so draining into a second list cost a
    # whole extra copy of every element plus the list it drained into
    n: src.length
    i: u64
    for i < (n / 2) loop {
        j: (n - 1) - i
        a: src.get :i
        b: src.get i: j
        src.set :i val: b
        src.set i: j val: a
        i = i + 1
    }
    return src
}

# True when byte `b` is NOT permitted at position `first?` of a unit name.
# Valid names start with a lowercase ascii letter, then lowercase letters,
# digits, or underscores (zlexer.isvalidunitname). Returns the negative so
# the scanner can early-return on the first bad byte.
unitNameCharBad: function {b: u8 first: bool} out bool is {
    if first then {
        if b >= 97 when b <= 122 then return false
        return true
    }
    if b >= 97 when b <= 122 then return false
    if b >= 48 when b <= 57 then return false
    if b == 95 then return false
    return true
}

# Port of zlexer.isvalidunitname: a unit (file) name is a lowercase ascii
# letter followed by lowercase letters, digits, or underscores. Used by
# parseUnitFile to reject malformed names and by collectExterns to keep
# only loadable references in the extern set.
isValidUnitName: function {name: StringView} out bool is {
    n: name.length
    if n == 0 then return false
    i: u64
    for i < n loop {
        b: name.byteAt i
        match (
            b
        ) case some then {
            isFirst: i == 0
            bad: unitNameCharBad :b first: isFirst
            if bad then return false
        } case none then {
            return false
        }
        i = i + 1
    }
    return true
}

# the recursive-descent parser: consumes a token stream and builds the AST.
Parser: class {
    # Monotonic source-node id, assigned in parse order.
    nextNodeId: u32
    # Master node table: one slot per minted id (a reserved slot holds
    # the payload-less placeholder arm until a converted parent moves
    # the real child in).
    ast: Ast
} as {
    # a parser with an empty tree: the node table holds only its sentinel row,
    # and the name pool only the empty text
    create: function {} out this is {
        return (meta.create
            nextNodeId: 1
            ast: Ast.create
        )
    }

    # Allocate the next node id and reserve its master-table slot.
    nextId: function {:this} out zast.nodeid is {
        id: this.nextNodeId
        this.nextNodeId = this.nextNodeId + 1
        this.ast.nodes.append from: zast.astnode.placeholder
        return (zast.nodeid.create from: id)
    }

    # errorTree -- hand the tree back with `e` as its root row. A failed parse
    # still delivers everything it did build, and the error travels IN the tree
    # the way every other parse error already does.
    errorTree: function {:this e: astnode} out zast.Ast is {
        eid: this.nextId
        tbl: Ast.create
        tbl swap this.ast
        tbl.root = eid
        zast.tableSet ast: tbl id: eid.u32 child: e
        return tbl
    }

    # intern -- move a finished node into its reserved master-table slot.
    intern: function {:this n: astnode} out zast.nodeid is {
        return (zast.tableAdd ast: this.ast :n)
    }

    # internName -- the pool id for an identifier's text (one
    # shared row per distinct name; minted on first sight).
    internName: function {:this name: StringView} out zast.nameid is {
        return (this.ast.names.set s: name)
    }


    # Build an error node located at `tok`.
    # peekReservedWord -- the buffered token's spelling when it is a keyword or
    # a reserved word, and "" when it is not. One place asks the pool for the
    # text and one place decides, so a caller tests a length and then has the
    # word to name in its diagnostic.
    peekReservedWord: function {:this lex: zlexer.Lexer.view} out String is {
        w: zast.poolTextCopy pool: this.ast.names ref: lex.peekTextId
        if (this.svIsReservedWord sv: w.stringView) then return w
        return "".string
    }

    # True when `sv` names a keyword or a future-reserved word (illegal
    # where a declaration name is expected -> E0033).
    svIsReservedWord: function {sv: StringView} out bool is {
        kr: zlexer.kwlookup sv
        if kr.found then return true
        return (zlexer.islookupReserved :sv)
    }

    # an error node carrying `tok`'s position, so a parse can keep going and
    # still report exactly where it broke
    mkError: function {:this tok: zlexer.token code: zast.err msg: String.take} out astnode is {
        pos: (zlexer.tokpos
            fsno: tok.fsno
            lineno: tok.lineno
            colno: tok.colno
            width: tok.width
        )
        # an ERR token is the lexer's own diagnosis -- the characters form no
        # token -- which is more precise than what the parser expected here;
        # inside a string literal the same fact is an escape the literal rejects
        if tok.toktype == zlexer.toktype.errTok then {
            # the view pins the pool, so the message is built inside the block
            # and the pin is gone before mkErrorAt takes the receiver
            em9: String
            {
                errTxt: zast.poolTextAt pool: this.ast.names ref: tok.text
                if code.badString then {
                    em9 = "unknown escape or character '\{errTxt}' in string literal"
                } else {
                    em9 = "unexpected characters '\{errTxt}'"
                }
            }
            if code.badString then return (this.mkErrorAt :pos code: zast.err.badString msg: em9)
            return (this.mkErrorAt :pos code: zast.err.badToken msg: em9)
        }
        return (this.mkErrorAt :pos :code :msg)
    }

    # Error node at a token span. The caller that only needs to report where
    # something went wrong takes lex.peekPos and never copies the token.
    mkErrorAt: function {:this pos: zlexer.tokpos code: zast.err msg: String.take} out astnode is {
        return (astnode.error (zast.errorrow
            nodeid: this.nextId
            lineno: pos.lineno
            colno: pos.colno
            width: pos.width
            err: code
            msg: (zast.poolSet pool: this.ast.names text: msg.stringView)
            fsno: pos.fsno
            note: zast.nameid
            hint: zast.nameid)
        )
    }

    # True when `node` is an `error` arm (propagate malformed sub-results).
    isError: function {node: astnode} out bool is {
        match node case error then {
            return true
        } else {
            return false
        }
    }

    # True when `node` is a `unitdef` arm (the visibility members
    # `public:` / `private:` declare one).
    isUnitDef: function {node: astnode} out bool is {
        match node case unitdef then {
            return true
        } else {
            return false
        }
    }

    # True when `node` is an `atomid` arm (a binop operator must be one).
    isAtomId: function {node: astnode} out bool is {
        match node case atomid then {
            return true
        } else {
            return false
        }
    }

    # True when `node` is an arm valid as a call's first unnamed argument.
    isOperationArm: function {node: astnode} out bool is {
        match node case binop then {
            return true
        } case dottedpath then {
            return true
        } case atomid then {
            return true
        } case atomstring then {
            return true
        } case expression then {
            return true
        } case namedoperation then {
            return true
        } case labelvalue then {
            return true
        } else {
            return false
        }
    }

    # True when `tok` is a named-argument label (LABEL) or label shorthand
    # (LABELPRE), which forces a single-path operation to parse as a call.
    ttIsLabel: function {tt: zlexer.toktype} out bool is {
        match tt case labelTok then {
            return true
        } case labelPreTok then {
            return true
        } else {
            return false
        }
    }

    # Does an atom start at the current token? (PARENOPEN | REFID | STRBEG)
    atomLookahead: function {:this lex: zlexer.Lexer.view} out bool is {
        tt: lex.peekType
        match tt case parenOpenTok then {
            return true
        } case refIdTok then {
            return true
        } case strBegTok then {
            return true
        } else {
            return false
        }
    }

    # parseAtom -> atomexpr | atomid | atomstring
    #
    # Dispatch on the leading token. Precondition: atomLookahead is true,
    # so the else arm is unreachable (guarded with an error node).
    parseAtom: function {:this lex: zlexer.Lexer} out astnode is {
        tt: lex.peekType
        match tt case parenOpenTok then {
            return (this.parseAtomExpr :lex)
        } case refIdTok then {
            return (this.parseAtomId :lex)
        } case strBegTok then {
            return (this.parseAtomString :lex)
        } else {
            badPos: lex.peekPos
            return (this.mkErrorAt
                pos: badPos
                code: zast.err.badReference
                msg: "Expected an atom".string
            )
        }
    }

    # a bare identifier as an atom. The parser's smallest leaf: everything that
    # resolves to a name starts here
    parseAtomId: function {:this lex: zlexer.Lexer} out astnode is {
        r: lex.accept tt: zlexer.toktype.refIdTok pool: this.ast.names
        match r case some then {
            return (astnode.atomid (zast.atomidrow
                nodeid: this.nextId
                lineno: r.lineno
                colno: r.colno
                name: r.text)
            )
        } case none then {
            tPos: lex.peekPos
            return (this.mkErrorAt
                pos: tPos
                code: zast.err.badReference
                msg: "Expected an identifier".string
            )
        }
    }

    # path -> atom | ( path "." atomid )
    #
    # Bare-astnode producer: an atom followed by zero or more `. id`
    # selectors, folded left into nested DottedPath ast.nodes. Used by the
    # greedy operation-path collector, which appends owned ast.nodes.
    parsePath: function {:this lex: zlexer.Lexer} out astnode is {
        startPos: lex.peekPos
        sLine: startPos.lineno
        sCol: startPos.colno
        node: this.parseAtom :lex
        nIsErr: this.isError :node
        if nIsErr then return node
        nxIsDot: lex.peekType == zlexer.toktype.dotTok
        if nxIsDot then {
            return (this.parsePathTail :lex parent: node startLine: sLine startCol: sCol)
        }
        return node
    }

    # Consume `. id` selectors, nesting each into a DottedPath whose
    # parent is the path built so far. Recursion (rather than a loop
    # reassigning an outer-scope binding) keeps each owned `parent`
    # local to its call.
    parsePathTail: function {:this lex: zlexer.Lexer parent: astnode startLine: u32 startCol: u32} out astnode is {
        dotOpt: lex.accept tt: zlexer.toktype.dotTok pool: this.ast.names
        match dotOpt case none then {
            return parent
        } case some then {
            idOpt: lex.accept tt: zlexer.toktype.refIdTok pool: this.ast.names
            match idOpt case some then {
                child: astnode.atomid (zast.atomidrow
                    nodeid: this.nextId
                    lineno: idOpt.lineno
                    colno: idOpt.colno
                    name: idOpt.text
                )
                np: astnode.dottedpath (zast.dottedpathrow
                    nodeid: this.nextId
                    lineno: startLine
                    colno: startCol
                    parent: (this.intern n: parent)
                    child: (this.intern n: child)
                )
                return (this.parsePathTail :lex parent: np :startLine :startCol)
            } case none then {
                bad: lex.acceptAny pool: this.ast.names
                err: (this.mkError
                    tok: bad
                    code: zast.err.badPath
                    msg: "Expected ID after dot".string
                )
                return err
            }
        }
    }

    # acceptPath -> Option boundary over parsePath.
    acceptPath: function {:this lex: zlexer.Lexer} out optionval astnode is {
        la: this.atomLookahead :lex
        if la then {
            return (optionval.some (this.parsePath :lex))
        } else {
            return (optionval.none astnode)
        }
    }

    # atomexpr: filled in by the next stage.
    # atomexpr -> "(" expression ")". EOLs are filtered inside the parens
    # (a parenthesised expression may span lines). Returns the inner
    # Expression node (bare), or an error.
    parseAtomExpr: function {:this lex: zlexer.Lexer} out astnode is {
        firstPos: lex.peekPos
        openOpt: lex.accept tt: zlexer.toktype.parenOpenTok pool: this.ast.names
        match openOpt case none then {
            return (this.mkErrorAt
                pos: firstPos
                code: zast.err.badExpression
                msg: "Expected open parenthesis".string
            )
        } case some then {
            prevFilter: lex.filterEolState
            lex.setFilterEol enabled: true pool: this.ast.names
            expr: this.parseExpression :lex
            isErr: this.isError node: expr
            if isErr then {
                lex.setFilterEol enabled: prevFilter pool: this.ast.names
                return expr
            }
            lex.setFilterEol enabled: prevFilter pool: this.ast.names
            closeOpt: lex.accept tt: zlexer.toktype.parenCloseTok pool: this.ast.names
            match closeOpt case some then {
                return expr
            } case none then {
                badPos: lex.peekPos
                return (this.mkErrorAt
                    pos: badPos
                    code: zast.err.badExpression
                    msg: "Expected closing parenthesis".string
                )
            }
        }
    }

    # atomstring -> "\"" { strmid | newline | strchr | strexpr } "\""
    #
    # Collect literal-text chunks; an embedded interpolation (STREXPRBEG)
    # is rejected for now because acceptExpression is stubbed. The
    # closing STREND must repeat the opening delimiter.
    parseAtomString: function {:this lex: zlexer.Lexer} out astnode is {
        firstTok: lex.acceptAny pool: this.ast.names
        fLine: firstTok.lineno
        fCol: firstTok.colno
        fDelim: firstTok.text
        parts: (ListVal u32)
        for true loop {
            tPos: lex.peekPos
            tt: lex.peekType
            if tt == zlexer.toktype.strEndTok then {
                same: lex.peekTextId == fDelim
                if same then {
                    lex.advance pool: this.ast.names
                    break
                } else {
                    return (this.mkErrorAt
                        pos: tPos
                        code: zast.err.badString
                        msg: "Unmatched string literal delimiter".string
                    )
                }
            } else if tt == zlexer.toktype.strExprBegTok then {
                lex.advance pool: this.ast.names
                btPos: lex.peekPos
                if lex.peekType != zlexer.toktype.braceOpenTok then {
                    return (this.mkErrorAt
                        pos: btPos
                        code: zast.err.badString
                        msg: "Expected open brace after backslash in string interpolation".string
                    )
                }
                lex.advance pool: this.ast.names
                eLook: this.exprLookahead :lex
                if eLook then {
                    expr: this.parseExpression :lex
                    eErr: this.isError node: expr
                    if eErr then return expr
                    parts.append (this.intern n: expr)
                    ctPos: lex.peekPos
                    if lex.peekType != zlexer.toktype.braceCloseTok then {
                        return (this.mkErrorAt
                            pos: ctPos
                            code: zast.err.badString
                            msg: "Expected close brace after interpolation expression".string
                        )
                    }
                    lex.advance pool: this.ast.names
                } else {
                    badPos: lex.peekPos
                    return (this.mkErrorAt
                        pos: badPos
                        code: zast.err.badExpression
                        msg: "Bad expression in string interpolation".string
                    )
                }
            } else if (isStrChunkTok :tt) then {
                ck: chunkKindOf :tt
                chunkTok: lex.acceptAny pool: this.ast.names
                chunk: astnode.stringchunk (zast.stringchunkrow
                    nodeid: this.nextId
                    lineno: chunkTok.lineno
                    colno: chunkTok.colno
                    text: chunkTok.text
                    chunkKind: ck
                )
                parts.append (this.intern n: chunk)
            } else {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.badString
                    msg: "Unexpected token in string literal".string
                )
            }
        }
        stripped: this.stripStringWhitespace :parts
        return (astnode.atomstring (zast.atomstringrow
            nodeid: this.nextId
            lineno: fLine
            colno: fCol
            stringparts: (zast.kidsAdd kids: this.ast.kids xs: stripped))
        )
    }

    # Apply the spec''s string newline/whitespace handling. PR-E sees
    # chunk-only inputs (interpolation is rejected above), and the
    # common case needs no rewriting, so this currently returns the
    # parts unchanged; the blank-line/common-prefix trimming lands in a
    # follow-up alongside interpolation.
    stripStringWhitespace: function {:this parts: (ListVal u32).take} out ListVal u32 is {
        origLen: parts.length
        if origLen == 0 then return parts

        # Step 1: blank first line -> startIdx (first kept index).
        startIdx: u64
        i: u64
        stop1: false
        for i < origLen loop {
            if (stop1) == false then {
                elId: parts.get :i
                c: partClass n: (this.ast.nodes.get i: elId.u64) pool: this.ast.names
                if c == 1 then {
                    startIdx = i + 1
                    stop1 = true
                } else if c != 2 then stop1 = true
            }
            i = i + 1
        }

        # Step 2: blank last line -> endIdx (exclusive) + common prefix.
        endIdx: origLen
        lastEol: false
        lastEolIdx: u64
        j: origLen
        stop2: false
        for j > startIdx loop {
            if (stop2) == false then {
                j2: j - 1
                elId: parts.get i: j2
                c: partClass n: (this.ast.nodes.get i: elId.u64) pool: this.ast.names
                if c == 1 then {
                    lastEol = true
                    lastEolIdx = j2
                    stop2 = true
                } else if c != 2 then stop2 = true
            }
            j = j - 1
        }

        prefix: String
        if lastEol then {
            m: lastEolIdx + 1
            for m < origLen loop {
                el: this.ast.nodes.get i: (parts.get i: m).u64
                if el.stringchunk then prefix.append (zast.poolTextAt
                    pool: this.ast.names
                    ref: el.text
                )
                m = m + 1
            }
            endIdx = lastEolIdx
        }

        if startIdx >= endIdx then {
            emptyParts: (ListVal u32)
            return emptyParts
        }

        prefixView: prefix.stringView
        prefixLen: prefixView.length
        needStrip: prefixLen > 0

        # Step 3 pre-check: every non-blank line-start STRMID must start
        # with the prefix, else stripping is abandoned.
        canStrip: true
        if needStrip then {
            atLineStart: true
            p: startIdx
            for p < endIdx loop {
                elId: parts.get i: p
                el: this.ast.nodes.get i: elId.u64
                c: partClass n: el pool: this.ast.names
                if c == 1 then {
                    atLineStart = true
                } else if c == 0 then {
                    atLineStart = false
                } else {
                    if atLineStart then {
                        if c == 3 then {
                            sw: chunkStartsWith n: el p: prefixView pool: this.ast.names
                            if (sw) == false then canStrip = false
                        }
                    }
                    atLineStart = false
                }
                p = p + 1
            }
        }

        doStrip: needStrip
        if (canStrip) == false then doStrip = false

        # Nothing trimmed and nothing to strip -> return unchanged.
        noTrim: startIdx == 0
        if endIdx != origLen then noTrim = false
        if noTrim then {
            if (doStrip) == false then return parts
        }

        # Rebuild: reverse-drain, then pop in original order with an index.
        rev: (ListVal u32)
        for parts.length > 0 loop rev.append parts.pop
        result: (ListVal u32)
        atLineStart2: true
        idx: u64
        pfxLen32: prefixLen.u32.orPanic
        for rev.length > 0 loop {
            elId: rev.pop
            inRange: idx >= startIdx
            if idx >= endIdx then inRange = false
            if inRange then {
                action: 0
                ncNodeId: zast.nodeid
                ncLine: u32
                ncCol: u32
                ncText: String
                {
                    el: this.ast.nodes.get i: elId.u64
                    match (
                        el
                    ) case stringchunk then {
                        kk: el.chunkKind
                        if kk == chunkkind.eol then {
                            atLineStart2 = true
                        } else if atLineStart2 then {
                            if kk == chunkkind.strmid then {
                                ws: isWsOnlyView sv: (zast.poolTextAt
                                    pool: this.ast.names
                                    ref: el.text
                                ).stringView
                                if (ws) == false then {
                                    if doStrip then {
                                        sp: (zast.poolTextAt
                                            pool: this.ast.names
                                            ref: el.text
                                        ).stringView.stripPrefix p: prefixView
                                        match (
                                            sp
                                        ) case some then {
                                            slen: sp.length
                                            if slen > 0 then {
                                                action = 2
                                                ncNodeId = el.nodeid
                                                ncLine = el.lineno
                                                ncCol = el.colno + pfxLen32
                                                ncText = sp.string
                                            } else {
                                                action = 1
                                            }
                                        } case none then null
                                    }
                                }
                            }
                            atLineStart2 = false
                        } else {
                            atLineStart2 = false
                        }
                    } else {
                        atLineStart2 = false
                    }
                }
                if action == 0 then {
                    result.append elId
                } else if action != 1 then {
                    nc: (astnode.stringchunk (zast.stringchunkrow
                        nodeid: ncNodeId
                        lineno: ncLine
                        colno: ncCol
                        text: (zast.poolSet pool: this.ast.names text: ncText.stringView)
                        chunkKind: chunkkind.strmid)
                    )
                    result.append (this.intern n: nc)
                }
            }
            idx = idx + 1
        }
        return result
    }

    # mkBinop / mkCall / mkNamedOp / mkLabelValue: id-allocating node
    # constructors for the operations layer. Children move in.
    mkBinop: function {:this lhs: astnode operator: astnode rhs: astnode line: u32 col: u32} out astnode is {
        return (astnode.binop (zast.binoprow
            nodeid: this.nextId
            lineno: line
            colno: col
            lhs: (this.intern n: lhs)
            operator: (this.intern n: operator)
            rhs: (this.intern n: rhs))
        )
    }

    # a call node over an already-built callable and argument list. The
    # arguments arrive reversed off the parse stack and are put back in order
    # here
    mkCall: function {:this callable: astnode arguments: (ListVal astnode).take line: u32 col: u32} out astnode is {
        rev: (ListVal astnode)
        for arguments.length > 0 loop rev.append arguments.pop
        argIds: (ListVal u32)
        for rev.length > 0 loop argIds.append (this.intern n: rev.pop)
        return (astnode.call (zast.callrow
            nodeid: this.nextId
            lineno: line
            colno: col
            callable: (this.intern n: callable)
            arguments: (zast.kidsAdd kids: this.ast.kids xs: argIds))
        )
    }

    # a namedoperation: the node that binds a label to whatever it names, which
    # is how every argument, field and parameter is carried
    mkNamedOp: function {:this name: u32 operation: astnode line: u32 col: u32} out astnode is {
        return (astnode.namedoperation (zast.namedoperationrow
            nodeid: this.nextId
            lineno: line
            colno: col
            name: (zast.nameid.create from: name)
            operation: (this.intern n: operation))
        )
    }

    # a labelvalue for the `:name` shorthand, where the label and the value it
    # stands for are the same word
    mkLabelValue: function {:this line: u32 col: u32 nameId: zast.nameid} out astnode is {
        return (astnode.labelvalue (zast.labelvaluerow
            nodeid: this.nextId
            lineno: line
            colno: col
            name: nameId)
        )
    }

    # Greedily collect operand/operator paths in source order. Stops at
    # the first non-atom token. A malformed path is appended as a
    # trailing error arm (callers pop and check the tail before
    # dispatching on the count).
    operationPaths: function {:this lex: zlexer.Lexer} out ListVal astnode is {
        paths: (ListVal astnode)
        for (this.atomLookahead :lex) loop {
            node: this.parsePath :lex
            errored: this.isError :node
            paths.append node
            if errored then break
        }
        return paths
    }

    # Fold a reversed operand/operator stack (pop yields source order)
    # into a left-associative, flat-precedence binop chain. The stack
    # must be non-empty. The whole chain is positioned at its first
    # operand.
    foldStack: function {:this stack: (ListVal astnode).take lex: zlexer.Lexer.view} out astnode is {
        acc: stack.pop
        sp: zast.posOf n: acc
        return (this.foldBinopTail :stack :acc line: sp.line col: sp.col :lex)
    }

    # collapse the operand/operator stack into a left-nested binop chain. Binops
    # have NO precedence here, so the fold is purely left to right and the shape
    # is exactly what was written
    foldBinopTail: function {:this stack: (ListVal astnode).take acc: astnode line: u32 col: u32 lex: zlexer.Lexer.view} out astnode is {
        if stack.length == 0 then return acc
        op: stack.pop
        opOk: this.isAtomId node: op
        if opOk then {
            if stack.length == 0 then {
                return (this.mkErrorAt
                    pos: lex.peekPos
                    code: zast.err.badExpression
                    msg: "Expected an operand for the right hand side of operation".string
                )
            }
            rhs: stack.pop
            nb: this.mkBinop lhs: acc operator: op :rhs :line :col
            return (this.foldBinopTail :stack acc: nb :line :col :lex)
        } else {
            return (this.mkErrorAt
                pos: lex.peekPos
                code: zast.err.badExpression
                msg: "Expected an operator (single identifier)".string
            )
        }
    }

    # Fold a source-order path list into a binop chain (reverse, then
    # drain). A single path returns itself.
    foldBinop: function {:this paths: (ListVal astnode).take lex: zlexer.Lexer.view} out astnode is {
        stack: this.reverseStack src: paths
        return (this.foldStack :stack :lex)
    }

    # reverseNodes wrapper as a method, for `this.`-prefixed calls.
    reverseStack: function {src: (ListVal astnode).take} out ListVal astnode is {
        return (reverseNodes :src)
    }

    # ( term binop ) form: callable + one unnamed folded argument, with
    # NO named arguments. Distinct from acceptCall (which consumes named
    # args); used for grammar operations like `abs -5`.
    acceptTermBinopCall: function {:this paths: (ListVal astnode).take lex: zlexer.Lexer.view} out astnode is {
        stack: this.reverseStack src: paths
        callable: stack.pop
        cp: zast.posOf n: callable
        args: (ListVal astnode)
        if stack.length > 0 then {
            argNode: this.foldStack :stack :lex
            argIsErr: this.isError node: argNode
            if argIsErr then return argNode
            ap: zast.posOf n: argNode
            uarg: (this.mkNamedOp
                name: 0
                operation: argNode
                line: ap.line
                col: ap.col
            )
            args.append uarg
        }
        return (this.mkCall :callable arguments: args line: cp.line col: cp.col)
    }

    # call = callable path + arguments. The first unnamed argument is the
    # remaining paths folded as a binop; then zero or more named
    # arguments (LABEL -> operation value; LABELPRE -> label shorthand).
    acceptCall: function {:this lex: zlexer.Lexer paths: (ListVal astnode).take} out astnode is {
        stack: this.reverseStack src: paths
        callable: stack.pop
        cp: zast.posOf n: callable
        args: (ListVal astnode)
        if stack.length > 0 then {
            argNode: this.foldStack :stack :lex
            argIsErr: this.isError node: argNode
            if argIsErr then return argNode
            argIsOp: this.isOperationArm node: argNode
            if argIsOp then {
                ap: zast.posOf n: argNode
                uarg: (this.mkNamedOp
                    name: 0
                    operation: argNode
                    line: ap.line
                    col: ap.col
                )
                args.append uarg
            }
        }
        argNames: (ListVal u64)
        for true loop {
            lblOpt: lex.accept tt: zlexer.toktype.labelTok pool: this.ast.names
            match lblOpt case some then {
                nm: lblOpt.text
                noName: lblOpt.text
                vLine: lblOpt.lineno
                vCol: lblOpt.colno
                dup: argNames.contains item: nm.u64
                if dup then {
                    bad: lex.acceptAny pool: this.ast.names
                    return (this.mkError
                        tok: bad
                        code: zast.err.badArgument
                        msg: "Duplicate argument name".string
                    )
                }
                vpaths: this.operationPaths :lex
                vlen: vpaths.length
                if vlen == 0 then {
                    bad: lex.acceptAny pool: this.ast.names
                    return (this.mkError
                        tok: bad
                        code: zast.err.badArgument
                        msg: "Expected an Operation after label".string
                    )
                }
                val: this.operationFromPaths paths: vpaths :lex
                vIsErr: this.isError node: val
                if vIsErr then return val
                no: (this.mkNamedOp
                    name: noName
                    operation: val
                    line: vLine
                    col: vCol
                )
                args.append no
                argNames.append from: nm.u64
            } case none then {
                lblOpt2: lex.accept tt: zlexer.toktype.labelPreTok pool: this.ast.names
                match lblOpt2 case some then {
                    nm: lblOpt2.text
                    lvName: lblOpt2.text
                    noName: lblOpt2.text
                    vLine: lblOpt2.lineno
                    vCol: lblOpt2.colno
                    dup: argNames.contains item: nm.u64
                    if dup then {
                        bad: lex.acceptAny pool: this.ast.names
                        return (this.mkError
                            tok: bad
                            code: zast.err.badArgument
                            msg: "Duplicate argument name".string
                        )
                    }
                    lv: this.mkLabelValue line: vLine col: vCol nameId: lvName
                    no: (this.mkNamedOp
                        name: noName
                        operation: lv
                        line: vLine
                        col: vCol
                    )
                    args.append no
                    argNames.append from: nm.u64
                } case none then {
                    break
                }
            }
        }
        return (this.mkCall :callable arguments: args line: cp.line col: cp.col)
    }

    # Bare operation core: dispatch a non-empty path list. Odd count ->
    # binop; even count -> ( term binop ) call. A trailing error path is
    # propagated. NO named arguments (those belong to acceptCall).
    operationFromPaths: function {:this paths: (ListVal astnode).take lex: zlexer.Lexer.view} out astnode is {
        last: paths.pop
        lerr: this.isError node: last
        if lerr then return last
        paths.append last
        n: paths.length
        even: (n & 1) == 0
        if even then return (this.acceptTermBinopCall :paths :lex)
        return (this.foldBinop :paths :lex)
    }

    # parseTyperefOperation -- a parameter / return type parsed as a grammar
    # `operation` (doc/grammar.pdoc: `in`/`out` types are operations, not bare
    # paths). The `(term binop)` unnamed-argument form (e.g. `List u8`)
    # materialises as a Call; wrap it in an Expression so it matches the
    # parenthesised `(List u8)` shape the type checker already resolves.
    # Named-argument generics (`Map u8 value: u32`) are calls, not operations,
    # so operationPaths stops at the label and they still need parentheses.
    parseTyperefOperation: function {:this lex: zlexer.Lexer} out astnode is {
        paths: this.operationPaths :lex
        n: paths.length
        if n == 0 then {
            badPos: lex.peekPos
            return (this.mkErrorAt
                pos: badPos
                code: zast.err.badArgument
                msg: "Expected type reference".string
            )
        }
        isCall: (n & 1) == 0
        node: this.operationFromPaths :paths :lex
        nerr: this.isError :node
        if nerr then return node
        if isCall then return (this.wrapExpression inner: node)
        return node
    }

    # operation-or-call: the top-level entry that also accepts named
    # arguments. Dispatch on the pre-parsed path count: (count == 1 and
    # the next token is a label) or count is even -> call; else binop.
    # Bare core of operation-or-call dispatch: a non-empty path list maps
    # to a call (named args allowed) or a binop, returning the bare astnode.
    # parseExpression needs the bare result to wrap it in an Expression
    # without moving it out of an Option.
    operationOrCallFromPaths: function {:this paths: (ListVal astnode).take lex: zlexer.Lexer} out astnode is {
        last: paths.pop
        lerr: this.isError node: last
        if lerr then return last
        paths.append last
        n: paths.length
        even: (n & 1) == 0
        if even then return (this.acceptCall :lex :paths)
        nIsOne: n == 1
        if nIsOne then {
            labelNext: this.ttIsLabel tt: lex.peekType
            if labelNext then return (this.acceptCall :lex :paths)
        }
        return (this.foldBinop :paths :lex)
    }

    # operation-or-call: top-level Option boundary over the bare core;
    # none when the pre-parsed path list is empty.
    acceptOperationOrCall: function {:this paths: (ListVal astnode).take lex: zlexer.Lexer} out optionval astnode is {
        n0: paths.length
        if n0 == 0 then return (optionval.none astnode)
        return (optionval.some (this.operationOrCallFromPaths :paths :lex))
    }

    # Does an expression start at the current token? Control-flow forms
    # begin with a keyword; everything else begins with an atom.
    exprLookahead: function {:this lex: zlexer.Lexer.view} out bool is {
        tt: lex.peekType
        match tt case ifTok then {
            return true
        } case forTok then {
            return true
        } case matchTok then {
            return true
        } case dataTok then {
            return true
        } case withTok then {
            return true
        } case braceOpenTok then {
            return true
        } else {
            return (this.atomLookahead :lex)
        }
    }

    # Wrap an operation/block node in an Expression carrier, positioned at
    # its inner node.
    wrapExpression: function {:this inner: astnode} out astnode is {
        ip: zast.posOf n: inner
        return (astnode.expression (zast.expressionrow
            nodeid: this.nextId
            lineno: ip.line
            colno: ip.col
            expression: (this.intern n: inner))
        )
    }

    # True for a block-line separator token (EOL or ';').
    atSeparator: function {:this lex: zlexer.Lexer.view} out bool is {
        tt: lex.peekType
        match tt case eolTok then {
            return true
        } case semicolonTok then {
            return true
        } else {
            return false
        }
    }

    # True when the current token is an EOL (a unit-body definition
    # separator; only observable while EOL filtering is off).
    atEol: function {:this lex: zlexer.Lexer.view} out bool is {
        return (lex.peekType == zlexer.toktype.eolTok)
    }

    # Does a block line start at the current token? (a binding label, a
    # label shorthand, or an expression)
    blocklineLookahead: function {:this lex: zlexer.Lexer.view} out bool is {
        tt: lex.peekType
        match tt case labelTok then {
            return true
        } case labelPreTok then {
            return true
        } else {
            return (this.exprLookahead :lex)
        }
    }

    # blockline -> ( label expression ) | label-value | expression.
    # Reassignment/swap (path "=" / "swap") are deferred. The caller
    # guarantees blocklineLookahead, so the bare-expression tail always
    # finds an expression. Returns a bare StatementLine node.
    parseBlockline: function {:this lex: zlexer.Lexer} out astnode is {
        startPos: lex.peekPos
        sLine: startPos.lineno
        sCol: startPos.colno
        tt: lex.peekType
        if tt == zlexer.toktype.labelPreTok then {
            lblTok: lex.acceptAny pool: this.ast.names
            lvName: lblTok.text
            asgnName: lblTok.text
            lv: this.mkLabelValue line: lblTok.lineno col: lblTok.colno nameId: lvName
            asgn: astnode.assignment (zast.assignmentrow
                nodeid: this.nextId
                lineno: sLine
                colno: sCol
                name: (zast.nameid.create from: asgnName.u32)
                value: (this.intern n: lv)
            )
            return (astnode.statementline (zast.statementlinerow
                nodeid: this.nextId
                lineno: sLine
                colno: sCol
                statementline: (this.intern n: asgn))
            )
        }
        if tt == zlexer.toktype.labelTok then {
            lblTok: lex.acceptAny pool: this.ast.names
            nm: lblTok.text
            lex.accept tt: zlexer.toktype.eolTok pool: this.ast.names
            eLook: this.exprLookahead :lex
            if eLook then {
                expr: this.parseExpression :lex
                eErr: this.isError node: expr
                if eErr then return expr
                asgn: astnode.assignment (zast.assignmentrow
                    nodeid: this.nextId
                    lineno: sLine
                    colno: sCol
                    name: (zast.nameid.create from: nm.u32)
                    value: (this.intern n: expr)
                )
                return (astnode.statementline (zast.statementlinerow
                    nodeid: this.nextId
                    lineno: sLine
                    colno: sCol
                    statementline: (this.intern n: asgn))
                )
            } else {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.badStatement
                    msg: "Expected expression for assignment statement".string
                )
            }
        }
        expr: this.parseExpression :lex
        eErr: this.isError node: expr
        if eErr then return expr
        return (astnode.statementline (zast.statementlinerow
            nodeid: this.nextId
            lineno: sLine
            colno: sCol
            statementline: (this.intern n: expr))
        )
    }

    # block -> "{" { sep } { blockline { sep } } "}" | blockline. EOL
    # filtering is disabled inside the braces so newlines separate lines.
    # Duplicate-definition detection is deferred to the typechecker.
    # Returns a bare Statement node.
    acceptBlock: function {:this lex: zlexer.Lexer} out astnode is {
        startPos: lex.peekPos
        sLine: startPos.lineno
        sCol: startPos.colno
        openOpt: lex.accept tt: zlexer.toktype.braceOpenTok pool: this.ast.names
        match openOpt case some then {
            prevFilter: lex.filterEolState
            lex.setFilterEol enabled: false pool: this.ast.names
            statements: (ListVal u32)
            for true loop {
                for (this.atSeparator :lex) loop lex.advance pool: this.ast.names
                la: this.blocklineLookahead :lex
                if la then {
                    sl: this.parseBlockline :lex
                    slErr: this.isError node: sl
                    if slErr then {
                        lex.setFilterEol enabled: prevFilter pool: this.ast.names
                        return sl
                    }
                    statements.append (this.intern n: sl)
                } else {
                    break
                }
            }
            lex.setFilterEol enabled: prevFilter pool: this.ast.names
            closeOpt: lex.accept tt: zlexer.toktype.braceCloseTok pool: this.ast.names
            match closeOpt case some then {
                return (astnode.statement (zast.statementrow
                    nodeid: this.nextId
                    lineno: sLine
                    colno: sCol
                    statements: (zast.kidsAdd kids: this.ast.kids xs: statements))
                )
            } case none then {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.badStatement
                    msg: "Expected closing brace for statement body".string
                )
            }
        } case none then {
            return (this.mkErrorAt
                pos: startPos
                code: zast.err.badStatement
                msg: "Expected opening brace for block".string
            )
        }
    }

    # bareblock -> "{ ... }" as an expression; wraps a block in a Do node.
    acceptBareblock: function {:this lex: zlexer.Lexer} out astnode is {
        startPos: lex.peekPos
        sLine: startPos.lineno
        sCol: startPos.colno
        blk: this.acceptBlock :lex
        bErr: this.isError node: blk
        if bErr then return blk
        return (astnode.doexpr (zast.dorow
            nodeid: this.nextId
            lineno: sLine
            colno: sCol
            statement: (this.intern n: blk))
        )
    }

    # a bare `null` body is an EMPTY BLOCK, not the value null: `then null` /
    # `else null` declare a body that does nothing. Shared by both clause-body
    # forms so `then` and `else` desugar identically.
    nullBodyDesugar: function {:this body: astnode line: u32 col: u32} out astnode is {
        if (isBareNullBody ast: this.ast :body) then {
            stmts: (ListVal u32)
            return (astnode.statement (zast.statementrow
                nodeid: this.nextId
                lineno: line
                colno: col
                statements: (zast.kidsAdd kids: this.ast.kids xs: stmts))
            )
        }
        return body
    }

    # clause-body -> primary-expression. The body of a `then` or a `case`,
    # where the enclosing construct is still open and a bare `if`/`match`
    # would leave a following `else` with two owners. Loop bodies do not take
    # this form; they take an expression-body.
    acceptClauseBody: function {:this lex: zlexer.Lexer} out astnode is {
        bodyPos: lex.peekPos
        body: this.acceptPrimaryExpression :lex
        bErr: this.isError node: body
        if bErr then return body
        return (this.nullBodyDesugar :body line: bodyPos.lineno col: bodyPos.colno)
    }

    # else-body -> expression. The enclosing `if` or `match` has just taken its
    # own `else` and can never take another, so every form is unambiguous here
    # -- including a bare `if`, which is what `else if` is.
    acceptElseBody: function {:this lex: zlexer.Lexer} out astnode is {
        bodyPos: lex.peekPos
        body: this.acceptExpressionBody :lex
        bErr: this.isError node: body
        if bErr then return body
        return (this.nullBodyDesugar :body line: bodyPos.lineno col: bodyPos.colno)
    }

    # primary-expression -> an expression MINUS `if` and `match`. The body of a
    # `then` or a `case`, where the enclosing construct is still OPEN.
    #
    # Those two are excluded and nothing else is, because those two are exactly
    # what can absorb an `else`: ifClausesTail and caseClausesTail are the only
    # readers of an `else` token in the parser. Written bare in a body whose own
    # construct has not closed, a following `else` has two candidate owners and
    # binds silently to the inner one. In an `else` body the enclosing `if` has
    # already taken its `else` and can never take another, so there is exactly
    # one candidate -- which is why `else if` needs no braces and is not an
    # exception but the general rule holding. `for`, `with` and `data` read no
    # `else`, so they stay legal here and need no braces.
    acceptPrimaryExpression: function {:this lex: zlexer.Lexer} out astnode is {
        tPos: lex.peekPos
        tt: lex.peekType
        if tt == zlexer.toktype.ifTok then {
            return (this.mkErrorAt
                pos: tPos
                code: zast.err.badThen
                msg: "a bare `if` here needs braces\n\nA `then` or `case` body is a primary-expression, and the two forms it excludes are exactly the two that can consume an `else`. Written bare, a following `else` would have two candidate owners -- this `if` and the enclosing one -- and would bind silently to the inner. Write `then { if ... }`. An `else` body carries no such ambiguity and takes an `if` bare, which is what `else if` is.".string
            )
        }
        if tt == zlexer.toktype.matchTok then {
            return (this.mkErrorAt
                pos: tPos
                code: zast.err.badThen
                msg: "a bare `match` here needs braces\n\nA `then` or `case` body is a primary-expression, and the two forms it excludes are exactly the two that can consume an `else`. Written bare, a following `else` would bind to this `match` rather than to the enclosing construct, silently. Write `then { match ... }`.".string
            )
        }
        return (this.acceptExpressionBody :lex)
    }

    # expression-body -> block | expression. A loop body and an `else` body:
    # both sit where no construct is left open, so the full expression grammar
    # is unambiguous there. A block parses directly to a Statement; a bare
    # expression is wrapped Statement(StatementLine(Expression)) so the body
    # field has a uniform shape either way.
    acceptExpressionBody: function {:this lex: zlexer.Lexer} out astnode is {
        tPos: lex.peekPos
        sLine: tPos.lineno
        sCol: tPos.colno
        if lex.peekType == zlexer.toktype.braceOpenTok then return (this.acceptBlock :lex)
        eLook: this.exprLookahead :lex
        if eLook then {
            expr: this.parseExpression :lex
            eErr: this.isError node: expr
            if eErr then return expr
            sl: astnode.statementline (zast.statementlinerow
                nodeid: this.nextId
                lineno: sLine
                colno: sCol
                statementline: (this.intern n: expr)
            )
            one: (ListVal u32)
            one.append (this.intern n: sl)
            return (astnode.statement (zast.statementrow
                nodeid: this.nextId
                lineno: sLine
                colno: sCol
                statements: (zast.kidsAdd kids: this.ast.kids xs: one))
            )
        } else {
            return (this.mkErrorAt
                pos: tPos
                code: zast.err.expectedStatement
                msg: "Expected an expression".string
            )
        }
    }

    # Tail of the if-clause loop. Threads the clauses list and the current
    # clause's conditions list through recursion (so the conditions list is
    # moved into the IfClause and a fresh one passed on, never reassigned).
    # `when` adds a condition; `then` closes a clause and starts a fresh one;
    # otherwise the clauses end and an optional `else` is parsed.
    ifClausesTail: function {:this lex: zlexer.Lexer clauses: (ListVal u32).take conditions: (ListVal u32).take clauseLine: u32 clauseCol: u32 ifLine: u32 ifCol: u32} out astnode is {
        tPos: lex.peekPos
        tt: lex.peekType
        if tt == zlexer.toktype.whenTok then {
            lex.advance pool: this.ast.names
            lex.accept tt: zlexer.toktype.eolTok pool: this.ast.names
            vpaths: this.operationPaths :lex
            n: vpaths.length
            if n == 0 then {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.expectedOp
                    msg: "Expected operation (condition) for 'if'".string
                )
            }
            cond: this.operationFromPaths paths: vpaths :lex
            cErr: this.isError node: cond
            if cErr then return cond
            cp: zast.posOf n: cond
            no: this.mkNamedOp name: 0 operation: cond line: cp.line col: cp.col
            conditions.append (this.intern n: no)
            return (this.ifClausesTail
                :lex
                :clauses
                :conditions
                :clauseLine
                :clauseCol
                :ifLine
                :ifCol
            )
        }
        if tt == zlexer.toktype.thenTok then {
            lex.advance pool: this.ast.names
            stmt: this.acceptClauseBody :lex
            sErr: this.isError node: stmt
            if sErr then return stmt
            clause: astnode.ifclause (zast.ifclauserow
                nodeid: this.nextId
                lineno: clauseLine
                colno: clauseCol
                conditions: (zast.kidsAdd kids: this.ast.kids xs: conditions)
                statement: (this.intern n: stmt)
            )
            clauses.append (this.intern n: clause)
            nextPos: lex.peekPos
            return (this.ifClausesTail
                :lex
                :clauses
                conditions: (ListVal u32)
                clauseLine: nextPos.lineno
                clauseCol: nextPos.colno
                :ifLine
                :ifCol
            )
        }
        cn: conditions.length
        if cn != 0 then {
            return (this.mkErrorAt
                pos: tPos
                code: zast.err.badThen
                msg: "Expected then after conditions".string
            )
        }
        if tt == zlexer.toktype.elseTok then {
            lex.advance pool: this.ast.names
            estmt: this.acceptElseBody :lex
            eErr: this.isError node: estmt
            if eErr then return estmt
            return (astnode.ifexpr (zast.ifrow
                nodeid: this.nextId
                lineno: ifLine
                colno: ifCol
                clauses: (zast.kidsAdd kids: this.ast.kids xs: clauses)
                elseclause: (this.intern n: estmt))
            )
        }
        return (astnode.ifexpr (zast.ifrow
            nodeid: this.nextId
            lineno: ifLine
            colno: ifCol
            clauses: (zast.kidsAdd kids: this.ast.kids xs: clauses)
            elseclause: (zast.nodeid.create from: 0))
        )
    }

    # if-expression -> "if" op { "when" op }* "then" primary
    #                  { "when" op }* "then" primary ... [ "else" primary ]
    acceptIfExpression: function {:this lex: zlexer.Lexer} out astnode is {
        startPos: lex.peekPos
        ifLine: startPos.lineno
        ifCol: startPos.colno
        ifOpt: lex.accept tt: zlexer.toktype.ifTok pool: this.ast.names
        match ifOpt case none then {
            return (this.mkErrorAt
                pos: startPos
                code: zast.err.badExpression
                msg: "Expected if".string
            )
        } case some then {
            clausePos: lex.peekPos
            cLine: clausePos.lineno
            cCol: clausePos.colno
            vpaths: this.operationPaths :lex
            n: vpaths.length
            if n == 0 then {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.expectedOp
                    msg: "Expected operation (condition) for 'if'".string
                )
            }
            cond: this.operationFromPaths paths: vpaths :lex
            cErr: this.isError node: cond
            if cErr then return cond
            cp: zast.posOf n: cond
            no: this.mkNamedOp name: 0 operation: cond line: cp.line col: cp.col
            conditions: (ListVal u32)
            conditions.append (this.intern n: no)
            clauses: (ListVal u32)
            return (this.ifClausesTail
                :lex
                :clauses
                :conditions
                clauseLine: cLine
                clauseCol: cCol
                :ifLine
                :ifCol
            )
        }
    }

    # Tail of the case-clause loop. Threads the subject and the clauses
    # list through recursion (each clause's owned pieces move into the
    # CaseClause, the list moves on), so neither is held across a loop
    # body -- mirrors ifClausesTail. `case` adds a clause; anything else
    # ends the clauses and parses an optional `else`.
    caseClausesTail: function {:this lex: zlexer.Lexer subjectId: u32 clauses: (ListVal u32).take mLine: u32 mCol: u32} out astnode is {
        isCase: lex.peekType == zlexer.toktype.caseTok
        if isCase then {
            clausePos: lex.peekPos
            cLine: clausePos.lineno
            cCol: clausePos.colno
            lex.advance pool: this.ast.names
            lex.accept tt: zlexer.toktype.eolTok pool: this.ast.names
            idOpt: lex.accept tt: zlexer.toktype.refIdTok pool: this.ast.names
            match idOpt case some then {
                nm: idOpt.text
                armNode: astnode.atomid (zast.atomidrow
                    nodeid: this.nextId
                    lineno: idOpt.lineno
                    colno: idOpt.colno
                    name: idOpt.text
                )
                isThen: lex.peekType == zlexer.toktype.thenTok
                if isThen then {
                    lex.advance pool: this.ast.names
                    body: this.acceptClauseBody :lex
                    bErr: this.isError node: body
                    if bErr then return body
                    clause: astnode.caseclause (zast.caseclauserow
                        nodeid: this.nextId
                        lineno: cLine
                        colno: cCol
                        name: (zast.nameid.create from: nm.u32)
                        matcharm: (this.intern n: armNode)
                        statement: (this.intern n: body)
                    )
                    clauses.append (this.intern n: clause)
                    return (this.caseClausesTail :lex :subjectId :clauses :mLine :mCol)
                } else {
                    bad: lex.acceptAny pool: this.ast.names
                    return (this.mkError
                        tok: bad
                        code: zast.err.badCase
                        msg: "Expected then keyword for case".string
                    )
                }
            } case none then {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.badReference
                    msg: "Case match expression expected (simple id)".string
                )
            }
        }
        elseOpt: lex.accept tt: zlexer.toktype.elseTok pool: this.ast.names
        match elseOpt case some then {
            estmt: this.acceptElseBody :lex
            eErr: this.isError node: estmt
            if eErr then return estmt
            return (astnode.caseexpr (zast.caserow
                nodeid: this.nextId
                lineno: mLine
                colno: mCol
                subject: (zast.nodeid.create from: subjectId)
                clauses: (zast.kidsAdd kids: this.ast.kids xs: clauses)
                elseclause: (this.intern n: estmt))
            )
        } case none then {
            return (astnode.caseexpr (zast.caserow
                nodeid: this.nextId
                lineno: mLine
                colno: mCol
                subject: (zast.nodeid.create from: subjectId)
                clauses: (zast.kidsAdd kids: this.ast.kids xs: clauses)
                elseclause: (zast.nodeid.create from: 0))
            )
        }
    }

    # match-expression -> "match" [ "on" ] op
    #                     { "case" id "then" primary }* [ "else" primary ]
    # The subject is a bare operation; each clause binds the matched id's
    # name plus the AtomId arm being matched. The clause loop is a
    # recursive tail (caseClausesTail) so the subject/clauses are never
    # held across a loop body. Narrowing the subject and rejecting `.take`
    # on it are typecheck concerns, not parse ones.
    acceptMatchExpression: function {:this lex: zlexer.Lexer} out astnode is {
        startPos: lex.peekPos
        mLine: startPos.lineno
        mCol: startPos.colno
        matchOpt: lex.accept tt: zlexer.toktype.matchTok pool: this.ast.names
        match matchOpt case none then {
            return (this.mkErrorAt
                pos: startPos
                code: zast.err.badExpression
                msg: "Expected match".string
            )
        } case some then {
            lex.accept tt: zlexer.toktype.onTok pool: this.ast.names
            spaths: this.operationPaths :lex
            sn: spaths.length
            if sn == 0 then {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.expectedOp
                    msg: "Expected operation for match (subject)".string
                )
            }
            subject: this.operationFromPaths paths: spaths :lex
            sErr: this.isError node: subject
            if sErr then return subject
            clauses: (ListVal u32)
            return (this.caseClausesTail
                :lex
                subjectId: (this.intern n: subject)
                :clauses
                :mLine
                :mCol
            )
        }
    }

    # Tail of the for-header. Threads the conditions + postconditions
    # lists and the optional body through recursion as `.take` params so
    # nothing owned is held across a loop body (E0200). `while` before the
    # body is a condition, after it a postcondition; `label op` is the
    # at-most-one binding; `loop primary` is the body. `hasBody` says
    # whether a body was seen without inspecting the owned body.
    forClausesTail: function {:this lex: zlexer.Lexer conditions: (ListVal u32).take postconditions: (ListVal u32).take bodyId: zast.nodeid hasBody: bool bound: bool forLine: u32 forCol: u32} out astnode is {
        tPos: lex.peekPos
        tt: lex.peekType
        if tt == zlexer.toktype.whileTok then {
            lex.advance pool: this.ast.names
            lex.accept tt: zlexer.toktype.eolTok pool: this.ast.names
            vpaths: this.operationPaths :lex
            n: vpaths.length
            if n == 0 then {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.expectedOp
                    msg: "Expected operation (condition) for for".string
                )
            }
            op: this.operationFromPaths paths: vpaths :lex
            oErr: this.isError node: op
            if oErr then return op
            if hasBody then {
                postconditions.append (this.intern n: op)
            } else {
                cp: zast.posOf n: op
                no: (this.mkNamedOp
                    name: 0
                    operation: op
                    line: cp.line
                    col: cp.col
                )
                conditions.append (this.intern n: no)
            }
            return (this.forClausesTail
                :lex
                :conditions
                :postconditions
                :bodyId
                :hasBody
                :bound
                :forLine
                :forCol
            )
        }
        if tt == zlexer.toktype.labelTok then {
            if hasBody then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badFor
                    msg: "Binding label not allowed after loop".string
                )
            }
            if bound then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badFor
                    msg: "for accepts at most one binding".string
                )
            }
            lblTok: lex.acceptAny pool: this.ast.names
            nm: lblTok.text
            lex.accept tt: zlexer.toktype.eolTok pool: this.ast.names
            vpaths: this.operationPaths :lex
            n: vpaths.length
            if n == 0 then {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.expectedOp
                    msg: "Expected operation for for binding label".string
                )
            }
            op: this.operationFromPaths paths: vpaths :lex
            oErr: this.isError node: op
            if oErr then return op
            no: (this.mkNamedOp
                name: nm
                operation: op
                line: lblTok.lineno
                col: lblTok.colno
            )
            conditions.append (this.intern n: no)
            return (this.forClausesTail
                :lex
                :conditions
                :postconditions
                :bodyId
                :hasBody
                bound: true
                :forLine
                :forCol
            )
        }
        if tt == zlexer.toktype.loopTok then {
            if hasBody then {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.badFor
                    msg: "Duplicate loop".string
                )
            }
            lex.advance pool: this.ast.names
            stmt: this.acceptExpressionBody :lex
            sErr: this.isError node: stmt
            if sErr then return stmt
            return (this.forClausesTail
                :lex
                :conditions
                :postconditions
                bodyId: (this.intern n: stmt)
                hasBody: true
                :bound
                :forLine
                :forCol
            )
        }
        empty: conditions.length == 0
        if empty then {
            if hasBody then {
                return (astnode.forexpr (zast.forrow
                    nodeid: this.nextId
                    lineno: forLine
                    colno: forCol
                    conditions: (zast.kidsAdd kids: this.ast.kids xs: conditions)
                    body: (zast.nodeid.create from: bodyId)
                    postconditions: (zast.kidsAdd kids: this.ast.kids xs: postconditions))
                )
            }
            bad: lex.acceptAny pool: this.ast.names
            return (this.mkError
                tok: bad
                code: zast.err.badFor
                msg: "Require at least one condition or a loop for for".string
            )
        }
        return (astnode.forexpr (zast.forrow
            nodeid: this.nextId
            lineno: forLine
            colno: forCol
            conditions: (zast.kidsAdd kids: this.ast.kids xs: conditions)
            body: (zast.nodeid.create from: bodyId)
            postconditions: (zast.kidsAdd kids: this.ast.kids xs: postconditions))
        )
    }

    # for-expression -> "for" [op] { "while" op } [ label op ] { "while" op }
    #                   [ "loop" primary ] { "while" op }
    # -> forexpr (conditions: namedoperation arms [named=binding,
    # unnamed=while/leading], body, postconditions: bare op Nodes). The
    # optional leading naked operation is an unnamed precondition; the rest
    # of the header is consumed by the recursive forClausesTail.
    acceptForExpression: function {:this lex: zlexer.Lexer} out astnode is {
        startPos: lex.peekPos
        forLine: startPos.lineno
        forCol: startPos.colno
        forOpt: lex.accept tt: zlexer.toktype.forTok pool: this.ast.names
        match forOpt case none then {
            return (this.mkErrorAt
                pos: startPos
                code: zast.err.badExpression
                msg: "Expected for".string
            )
        } case some then {
            conditions: (ListVal u32)
            postconditions: (ListVal u32)
            paths: this.operationPaths :lex
            n: paths.length
            if n == 0 then {
                return (this.forClausesTail
                    :lex
                    :conditions
                    :postconditions
                    bodyId: (zast.nodeid.create from: 0)
                    hasBody: false
                    bound: false
                    :forLine
                    :forCol
                )
            }
            op: this.operationFromPaths :paths :lex
            oErr: this.isError node: op
            if oErr then return op
            cp: zast.posOf n: op
            no: this.mkNamedOp name: 0 operation: op line: cp.line col: cp.col
            conditions.append (this.intern n: no)
            return (this.forClausesTail
                :lex
                :conditions
                :postconditions
                bodyId: (zast.nodeid.create from: 0)
                hasBody: false
                bound: false
                :forLine
                :forCol
            )
        }
    }

    # with-expression -> "with" label op "do" expression. The binding name
    # is a LABEL; the value is an operation (wrapped in an Expression, no
    # named-arg calls); the body is a full expression in the binding's scope.
    acceptWithExpression: function {:this lex: zlexer.Lexer} out astnode is {
        startPos: lex.peekPos
        wLine: startPos.lineno
        wCol: startPos.colno
        wOpt: lex.accept tt: zlexer.toktype.withTok pool: this.ast.names
        match wOpt case none then {
            return (this.mkErrorAt
                pos: startPos
                code: zast.err.badExpression
                msg: "Expected with".string
            )
        } case some then {
            isLabel: lex.peekType == zlexer.toktype.labelTok
            if isLabel then {
                lblTok: lex.acceptAny pool: this.ast.names
                nm: lblTok.text
                vpaths: this.operationPaths :lex
                n: vpaths.length
                if n == 0 then {
                    badPos: lex.peekPos
                    return (this.mkErrorAt
                        pos: badPos
                        code: zast.err.expectedExp
                        msg: "Expected operation for with value".string
                    )
                }
                op: this.operationFromPaths paths: vpaths :lex
                oErr: this.isError node: op
                if oErr then return op
                value: this.wrapExpression inner: op
                doOpt: lex.accept tt: zlexer.toktype.doTok pool: this.ast.names
                match doOpt case none then {
                    badPos: lex.peekPos
                    return (this.mkErrorAt
                        pos: badPos
                        code: zast.err.expectedExp
                        msg: "Expected do after with definition".string
                    )
                } case some then {
                    body: this.parseExpression :lex
                    bErr: this.isError node: body
                    if bErr then return body
                    return (astnode.withexpr (zast.withrow
                        nodeid: this.nextId
                        lineno: wLine
                        colno: wCol
                        name: (zast.nameid.create from: nm.u32)
                        value: (this.intern n: value)
                        body: (this.intern n: body))
                    )
                }
            }
            bad: lex.acceptAny pool: this.ast.names
            return (this.mkError
                tok: bad
                code: zast.err.expectedDef
                msg: "Expected label after with".string
            )
        }
    }

    # data-definition -> "data" ["is"] "{" { [label] term | label-value } "}"
    # ["out" type]. Elements are single terms (paths): a LABEL names the
    # element, a LABELPRE is a label-value, bare terms are positional.
    # Duplicate member names are rejected here (the typechecker does not
    # re-check). The optional "out" pins the element type.
    acceptDataDefinition: function {:this lex: zlexer.Lexer} out astnode is {
        startPos: lex.peekPos
        dLine: startPos.lineno
        dCol: startPos.colno
        dOpt: lex.accept tt: zlexer.toktype.dataTok pool: this.ast.names
        match dOpt case none then {
            return (this.mkErrorAt
                pos: startPos
                code: zast.err.badExpression
                msg: "Expected data".string
            )
        } case some then {
            lex.accept tt: zlexer.toktype.isTok pool: this.ast.names
            openOpt: lex.accept tt: zlexer.toktype.braceOpenTok pool: this.ast.names
            match openOpt case none then {
                bad: lex.acceptAny pool: this.ast.names
                return (this.mkError
                    tok: bad
                    code: zast.err.badData
                    msg: "Expected opening brace for data body".string
                )
            } case some then {
                elements: (ListVal u32)
                datanames: (ListVal u64)
                for true loop {
                    ett: lex.peekType
                    if ett == zlexer.toktype.labelPreTok then {
                        lblTok: lex.acceptAny pool: this.ast.names
                        checkName: lblTok.text
                        dup: datanames.contains item: checkName.u64
                        if dup then {
                            bad: lex.acceptAny pool: this.ast.names
                            return (this.mkError
                                tok: bad
                                code: zast.err.badArgument
                                msg: "Duplicate data member name".string
                            )
                        }
                        datanames.append from: checkName.u64
                        lvName: lblTok.text
                        opName: lblTok.text
                        lv: this.mkLabelValue line: lblTok.lineno col: lblTok.colno nameId: lvName
                        no: (this.mkNamedOp
                            name: opName
                            operation: lv
                            line: lblTok.lineno
                            col: lblTok.colno
                        )
                        elements.append (this.intern n: no)
                    } else {
                        isLbl: ett == zlexer.toktype.labelTok
                        if isLbl then {
                            lblTok: lex.acceptAny pool: this.ast.names
                            checkName: lblTok.text
                            dup: datanames.contains item: checkName.u64
                            if dup then {
                                bad: lex.acceptAny pool: this.ast.names
                                return (this.mkError
                                    tok: bad
                                    code: zast.err.badArgument
                                    msg: "Duplicate data member name".string
                                )
                            }
                            datanames.append from: checkName.u64
                            opName: lblTok.text
                            la: this.atomLookahead :lex
                            if la then {
                                pathNode: this.parsePath :lex
                                pErr: this.isError node: pathNode
                                if pErr then return pathNode
                                no: (this.mkNamedOp
                                    name: opName
                                    operation: pathNode
                                    line: lblTok.lineno
                                    col: lblTok.colno
                                )
                                elements.append (this.intern n: no)
                            } else {
                                badPos: lex.peekPos
                                return (this.mkErrorAt
                                    pos: badPos
                                    code: zast.err.badData
                                    msg: "Expected term after data label".string
                                )
                            }
                        } else {
                            la: this.atomLookahead :lex
                            if la then {
                                pathNode: this.parsePath :lex
                                pErr: this.isError node: pathNode
                                if pErr then return pathNode
                                cp: zast.posOf n: pathNode
                                no: (this.mkNamedOp
                                    name: 0
                                    operation: pathNode
                                    line: cp.line
                                    col: cp.col
                                )
                                elements.append (this.intern n: no)
                            } else {
                                break
                            }
                        }
                    }
                }
                closeOpt: lex.accept tt: zlexer.toktype.braceCloseTok pool: this.ast.names
                match closeOpt case none then {
                    bad: lex.acceptAny pool: this.ast.names
                    return (this.mkError
                        tok: bad
                        code: zast.err.badData
                        msg: "Expected closing brace for data body".string
                    )
                } case some then {
                    eLen: elements.length
                    if eLen == 0 then {
                        return (this.mkErrorAt
                            pos: startPos
                            code: zast.err.badData
                            msg: "data definition must have at least one element".string
                        )
                    }
                    outOpt: lex.accept tt: zlexer.toktype.outTok pool: this.ast.names
                    match outOpt case some then {
                        la: this.atomLookahead :lex
                        if la then {
                            typeNode: this.parsePath :lex
                            tErr: this.isError node: typeNode
                            if tErr then return typeNode
                            eSpan: zast.kidsAdd kids: this.ast.kids xs: elements
                            return (astnode.datablock (zast.datablockrow
                                nodeid: this.nextId
                                lineno: dLine
                                colno: dCol
                                elements: eSpan
                                outType: (this.intern n: typeNode))
                            )
                        } else {
                            bad: lex.acceptAny pool: this.ast.names
                            return (this.mkError
                                tok: bad
                                code: zast.err.badData
                                msg: "Expected type reference after out".string
                            )
                        }
                    } case none then {
                        eSpan: zast.kidsAdd kids: this.ast.kids xs: elements
                        return (astnode.datablock (zast.datablockrow
                            nodeid: this.nextId
                            lineno: dLine
                            colno: dCol
                            elements: eSpan
                            outType: (zast.nodeid.create from: 0))
                        )
                    }
                }
            }
        }
    }

    # Build a reassignment from an already-parsed LHS path list (the `=`
    # is consumed). The LHS must be a single path; the RHS is a full
    # expression (so `x = if c then a else b` parses).
    buildReassignment: function {:this paths: (ListVal astnode).take lex: zlexer.Lexer startLine: u32 startCol: u32} out astnode is {
        n: paths.length
        if n != 1 then {
            badPos: lex.peekPos
            return (this.mkErrorAt
                pos: badPos
                code: zast.err.badStatement
                msg: "Reassignment must be to a single path on the LHS".string
            )
        }
        lhs: paths.pop
        lhsErr: this.isError node: lhs
        if lhsErr then return lhs
        rhs: this.parseExpression :lex
        rErr: this.isError node: rhs
        if rErr then return rhs
        return (astnode.reassignment (zast.reassignmentrow
            nodeid: this.nextId
            lineno: startLine
            colno: startCol
            topath: (this.intern n: lhs)
            value: (this.intern n: rhs))
        )
    }

    # Build a swap from an already-parsed LHS path list (the `swap` is
    # consumed). Both sides are single paths.
    buildSwap: function {:this paths: (ListVal astnode).take lex: zlexer.Lexer startLine: u32 startCol: u32} out astnode is {
        n: paths.length
        if n != 1 then {
            badPos: lex.peekPos
            return (this.mkErrorAt
                pos: badPos
                code: zast.err.badStatement
                msg: "Swap must be to a single path on the LHS".string
            )
        }
        lhs: paths.pop
        lhsErr: this.isError node: lhs
        if lhsErr then return lhs
        la: this.atomLookahead :lex
        if la then {
            rhs: this.parsePath :lex
            rErr: this.isError node: rhs
            if rErr then return rhs
            return (astnode.swapstmt (zast.swapstmtrow
                nodeid: this.nextId
                lineno: startLine
                colno: startCol
                lhs: (this.intern n: lhs)
                rhs: (this.intern n: rhs))
            )
        } else {
            bad: lex.acceptAny pool: this.ast.names
            return (this.mkError
                tok: bad
                code: zast.err.badStatement
                msg: "Swap requires a right hand side".string
            )
        }
    }

    # Parse a `{ (:name | name: typeref)* }` parameter block into a
    # (List of: astnode) of namedoperation arms (name=param, operation=type
    # path or label-value). Duplicate names rejected. Errors use the
    # operationPaths trailing-sentinel: on failure an error node is the
    # last element (the caller pop-checks and propagates).
    acceptParamBlock: function {:this lex: zlexer.Lexer} out ListVal u32 is {
        params: (ListVal u32)
        names: (ListVal u64)
        openOpt: lex.accept tt: zlexer.toktype.braceOpenTok pool: this.ast.names
        match openOpt case none then {
            badPos: lex.peekPos
            params.append (this.intern n: (this.mkErrorAt
                pos: badPos
                code: zast.err.badArgument
                msg: "Expected open brace for parameter block".string
            ))
            return params
        } case some then {
            for true loop {
                lex.accept tt: zlexer.toktype.eolTok pool: this.ast.names
                pktt: lex.peekType
                if pktt == zlexer.toktype.labelPreTok then {
                    lblTok: lex.acceptAny pool: this.ast.names
                    nm: lblTok.text
                    dup: names.contains item: nm.u64
                    if dup then {
                        params.append (this.intern n: (this.mkError
                            tok: lblTok
                            code: zast.err.badParameter
                            msg: "Duplicate parameter name".string
                        ))
                        return params
                    }
                    names.append from: nm.u64
                    lvName: lblTok.text
                    opName: lblTok.text
                    lv: this.mkLabelValue line: lblTok.lineno col: lblTok.colno nameId: lvName
                    no: (this.mkNamedOp
                        name: opName
                        operation: lv
                        line: lblTok.lineno
                        col: lblTok.colno
                    )
                    params.append (this.intern n: no)
                } else {
                    isLbl: pktt == zlexer.toktype.labelTok
                    if isLbl then {
                        lblTok: lex.acceptAny pool: this.ast.names
                        nm: lblTok.text
                        dup: names.contains item: nm.u64
                        if dup then {
                            params.append (this.intern n: (this.mkError
                                tok: lblTok
                                code: zast.err.badParameter
                                msg: "Duplicate parameter name".string
                            ))
                            return params
                        }
                        names.append from: nm.u64
                        opName: lblTok.text
                        la: this.atomLookahead :lex
                        if la then {
                            pathNode: this.parseTyperefOperation :lex
                            pErr: this.isError node: pathNode
                            if pErr then {
                                params.append (this.intern n: pathNode)
                                return params
                            }
                            no: (this.mkNamedOp
                                name: opName
                                operation: pathNode
                                line: lblTok.lineno
                                col: lblTok.colno
                            )
                            params.append (this.intern n: no)
                        } else {
                            badPos: lex.peekPos
                            params.append (this.intern n: (this.mkErrorAt
                                pos: badPos
                                code: zast.err.badParameter
                                msg: "Expected type reference for parameter".string
                            ))
                            return params
                        }
                    } else {
                        break
                    }
                }
            }
            closeOpt: lex.accept tt: zlexer.toktype.braceCloseTok pool: this.ast.names
            match closeOpt case none then {
                badPos: lex.peekPos
                rwTxt: this.peekReservedWord :lex
                if rwTxt.length > 0 then {
                    params.append (this.intern n: (this.mkErrorAt
                        pos: badPos
                        code: zast.err.reservedName
                        msg: "'\{rwTxt}' is a reserved word and cannot be used as a name"
                    ))
                    return params
                }
                params.append (this.intern n: (this.mkErrorAt
                    pos: badPos
                    code: zast.err.badParameterBlock
                    msg: "Expected closing brace after parameters".string
                ))
                return params
            } case some then {
                return params
            }
        }
    }

    # Tail of the function-definition clause loop (in/out/is/as/native).
    # Threads the owned accumulators through recursion so nothing is held
    # across a loop body (E0200), as forClausesTail does.
    # Each clause rejects a duplicate; an unmatched token terminates and
    # builds the functiondef.
    functionClausesTail: function {:this lex: zlexer.Lexer parameters: (ListVal u32).take asItems: (ListVal u32).take returntypeId: zast.nodeid bodyId: zast.nodeid gotIn: bool hasOut: bool pins: bool hasIs: bool isNative: bool hasAs: bool startLine: u32 startCol: u32} out astnode is {
        tPos: lex.peekPos
        tt: lex.peekType
        # `out` and `outx` are one clause: a function declares exactly one of
        # them, and `outx` is the one whose result keeps the call's borrow/view
        # inputs locked.
        outKind: 0
        if tt == zlexer.toktype.outTok then outKind = 1
        if tt == zlexer.toktype.outxTok then outKind = 2
        if outKind > 0 then {
            if hasOut then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badArgument
                    msg: "a function declares one of `out` or `outx`".string
                )
            }
            lex.advance pool: this.ast.names
            la: this.atomLookahead :lex
            if la then {
                rt: this.parseTyperefOperation :lex
                rErr: this.isError node: rt
                if rErr then return rt
                return (this.functionClausesTail
                    :lex
                    :parameters
                    :asItems
                    returntypeId: (this.intern n: rt)
                    :bodyId
                    :gotIn
                    hasOut: true
                    pins: (outKind == 2)
                    :hasIs
                    :isNative
                    :hasAs
                    :startLine
                    :startCol
                )
            } else {
                bad: lex.acceptAny pool: this.ast.names
                outWord: "out"
                if outKind == 2 then outWord = "outx"
                return (this.mkError
                    tok: bad
                    code: zast.err.badArgument
                    msg: "Expected type reference for \{outWord}"
                )
            }
        }
        if tt == zlexer.toktype.isTok then {
            if hasIs then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badArgument
                    msg: "Duplicate is".string
                )
            }
            lex.advance pool: this.ast.names
            natOpt: lex.accept tt: zlexer.toktype.nativeTok pool: this.ast.names
            match natOpt case some then {
                return (this.functionClausesTail
                    :lex
                    :parameters
                    :asItems
                    :returntypeId
                    :bodyId
                    :gotIn
                    :hasOut
                    :pins
                    hasIs: true
                    isNative: true
                    :hasAs
                    :startLine
                    :startCol
                )
            } case none then {
                stmt: this.acceptBlock :lex
                sErr: this.isError node: stmt
                if sErr then return stmt
                return (this.functionClausesTail
                    :lex
                    :parameters
                    :asItems
                    :returntypeId
                    bodyId: (this.intern n: stmt)
                    :gotIn
                    :hasOut
                    :pins
                    hasIs: true
                    :isNative
                    :hasAs
                    :startLine
                    :startCol
                )
            }
        }
        if tt == zlexer.toktype.asTok then {
            if hasAs then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badArgument
                    msg: "Duplicate as".string
                )
            }
            lex.advance pool: this.ast.names
            ab: this.getObjectBody :lex typeBody: false
            an: ab.length
            if an > 0 then {
                lastId: ab.pop
                if (zast.isErrorAt ast: this.ast id: lastId) then {
                    return (zast.tableTake ast: this.ast id: lastId)
                }
                ab.append lastId
            }
            return (this.functionClausesTail
                :lex
                :parameters
                asItems: ab
                :returntypeId
                :bodyId
                :gotIn
                :hasOut
                :pins
                :hasIs
                :isNative
                hasAs: true
                :startLine
                :startCol
            )
        }
        if tt == zlexer.toktype.inTok then {
            if gotIn then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badArgument
                    msg: "Duplicate in".string
                )
            }
            lex.advance pool: this.ast.names
            pb: this.acceptParamBlock :lex
            pn: pb.length
            if pn > 0 then {
                lastId: pb.pop
                if (zast.isErrorAt ast: this.ast id: lastId) then {
                    return (zast.tableTake ast: this.ast id: lastId)
                }
                pb.append lastId
            }
            return (this.functionClausesTail
                :lex
                parameters: pb
                :asItems
                :returntypeId
                :bodyId
                gotIn: true
                :hasOut
                :pins
                :hasIs
                :isNative
                :hasAs
                :startLine
                :startCol
            )
        }
        return (astnode.functiondef (zast.functionrow
            nodeid: this.nextId
            lineno: startLine
            colno: startCol
            returntype: (zast.nodeid.create from: returntypeId)
            parameters: (zast.kidsAdd kids: this.ast.kids xs: parameters)
            body: (zast.nodeid.create from: bodyId)
            :isNative
            :pins
            asItems: (zast.kidsAdd kids: this.ast.kids xs: asItems))
        )
    }

    # Body of acceptFunctionDefinition after `function` is consumed. A
    # leading `{` is an implicit `in` param block; otherwise the clause
    # tail starts with empty accumulators.
    functionDefinitionInner: function {:this lex: zlexer.Lexer startLine: u32 startCol: u32} out astnode is {
        parameters: (ListVal u32)
        asItems: (ListVal u32)
        isBrace: lex.peekType == zlexer.toktype.braceOpenTok
        if isBrace then {
            pb: this.acceptParamBlock :lex
            pn: pb.length
            if pn > 0 then {
                lastId: pb.pop
                if (zast.isErrorAt ast: this.ast id: lastId) then {
                    return (zast.tableTake ast: this.ast id: lastId)
                }
                pb.append lastId
            }
            return (this.functionClausesTail
                :lex
                parameters: pb
                :asItems
                returntypeId: (zast.nodeid.create from: 0)
                bodyId: (zast.nodeid.create from: 0)
                gotIn: true
                hasOut: false
                pins: false
                hasIs: false
                isNative: false
                hasAs: false
                :startLine
                :startCol
            )
        }
        return (this.functionClausesTail
            :lex
            :parameters
            :asItems
            returntypeId: (zast.nodeid.create from: 0)
            bodyId: (zast.nodeid.create from: 0)
            gotIn: false
            hasOut: false
            pins: false
            hasIs: false
            isNative: false
            hasAs: false
            :startLine
            :startCol
        )
    }

    # Parse a function definition whose `function` keyword the caller has
    # already peeked (startPos spans it); this consumes it. Returns a bare
    # functiondef astnode. Nested function literals no longer need counting: a
    # literal pushes its own scope, and `yield` is in scope only for the body
    # generator lowering put it in, so a yield inside a literal simply does
    # not resolve.
    parseFunctionDefinition: function {:this lex: zlexer.Lexer startPos: zlexer.tokpos} out astnode is {
        lex.advance pool: this.ast.names
        return (this.functionDefinitionInner
            :lex
            startLine: startPos.lineno
            startCol: startPos.colno
        )
    }

    # function-definition -> "function" [in-block] {out|is|as|in}*. The
    # Option boundary: none when there is no `function` keyword.
    acceptFunctionDefinition: function {:this lex: zlexer.Lexer} out optionval astnode is {
        startPos: lex.peekPos
        isFunc: lex.peekType == zlexer.toktype.functionTok
        if isFunc then return (optionval.some (this.parseFunctionDefinition :lex :startPos))
        return (optionval.none astnode)
    }

    # object-body -> "{" { item } "}". Each item is `name: value` or a
    # `:name` shorthand: a method (function), an inline unit, an inline
    # field operation, or a label-value. Inline type definitions are
    # rejected. EOL filtering is on while an object body is parsed (the
    # enclosing definition value), so newlines never reach the loop in
    # practice; the EOL skip is kept for the filtering-off case. Returns
    # the items as namedoperation arms; a trailing error node flags a
    # malformed item for the caller to detect.
    getObjectBody: function {:this lex: zlexer.Lexer typeBody: bool} out ListVal u32 is {
        items: (ListVal u32)
        names: (ListVal u64)
        openOpt: lex.accept tt: zlexer.toktype.braceOpenTok pool: this.ast.names
        match openOpt case none then {
            badPos: lex.peekPos
            items.append (this.intern n: (this.mkErrorAt
                pos: badPos
                code: zast.err.badObjectBlock
                msg: "Expected open brace for object body".string
            ))
            return items
        } case some then {
            for true loop {
                for (this.atEol :lex) loop lex.advance pool: this.ast.names
                pktt: lex.peekType
                if pktt == zlexer.toktype.labelPreTok then {
                    lblTok: lex.acceptAny pool: this.ast.names
                    nm: lblTok.text
                    dup: names.contains item: nm.u64
                    if dup then {
                        items.append (this.intern n: (this.mkError
                            tok: lblTok
                            code: zast.err.badItem
                            msg: "Duplicate item name".string
                        ))
                        return items
                    }
                    names.append from: nm.u64
                    lvName: lblTok.text
                    opName: lblTok.text
                    lv: this.mkLabelValue line: lblTok.lineno col: lblTok.colno nameId: lvName
                    no: (this.mkNamedOp
                        name: opName
                        operation: lv
                        line: lblTok.lineno
                        col: lblTok.colno
                    )
                    items.append (this.intern n: no)
                } else {
                    isLbl: pktt == zlexer.toktype.labelTok
                    if isLbl then {
                        lblTok: lex.acceptAny pool: this.ast.names
                        nm: lblTok.text
                        dup: names.contains item: nm.u64
                        if dup then {
                            items.append (this.intern n: (this.mkError
                                tok: lblTok
                                code: zast.err.badItem
                                msg: "Duplicate item name".string
                            ))
                            return items
                        }
                        names.append from: nm.u64
                        opName: lblTok.text
                        mKind: unitKindForLabel id: lblTok.text unitBody: false
                        lex.accept tt: zlexer.toktype.eolTok pool: this.ast.names
                        member: this.objectBodyMember :lex unitKind: mKind
                        mErr: this.isError node: member
                        if mErr then {
                            items.append (this.intern n: member)
                            return items
                        }
                        if typeBody when (isReservedMemberName id: lblTok.text) then {
                            visUnit: false
                            if mKind.publicNs then visUnit = true
                            if mKind.privateNs then visUnit = true
                            allowed: false
                            if visUnit when (this.isUnitDef node: member) then allowed = true
                            if (allowed) == false then {
                                lblTxt: zast.poolTextCopy pool: this.ast.names ref: lblTok.text
                                em: "'\{lblTxt}' is a reserved member name"
                                if visUnit then em = "'\{lblTxt}:' must introduce a unit definition, e.g. `\{lblTxt}: unit { :field }`"
                                items.append (this.intern n: (this.mkError
                                    tok: lblTok
                                    code: zast.err.reservedMember
                                    msg: em
                                ))
                                return items
                            }
                        }
                        no: (this.mkNamedOp
                            name: opName
                            operation: member
                            line: lblTok.lineno
                            col: lblTok.colno
                        )
                        items.append (this.intern n: no)
                    } else {
                        break
                    }
                }
            }
            closeOpt: lex.accept tt: zlexer.toktype.braceCloseTok pool: this.ast.names
            match closeOpt case none then {
                badPos: lex.peekPos
                rwTxt: this.peekReservedWord :lex
                if rwTxt.length > 0 then {
                    items.append (this.intern n: (this.mkErrorAt
                        pos: badPos
                        code: zast.err.reservedName
                        msg: "'\{rwTxt}' is a reserved word and cannot be used as a name"
                    ))
                    return items
                }
                items.append (this.intern n: (this.mkErrorAt
                    pos: badPos
                    code: zast.err.badObjectBlock
                    msg: "Expected closing brace for object body".string
                ))
                return items
            } case some then {
                return items
            }
        }
    }

    # The value of a `name:` item inside an object body: a method, an
    # inline unit, or a field operation (no named arguments). Inline type
    # definitions (record / class / ...) are rejected. Returns a bare astnode.
    objectBodyMember: function {:this lex: zlexer.Lexer unitKind: zast.unitkind} out astnode is {
        startPos: lex.peekPos
        tt: lex.peekType
        if tt == zlexer.toktype.functionTok then return (this.parseFunctionDefinition
            :lex
            :startPos
        )
        if tt == zlexer.toktype.unitTok then return (this.parseUnitDefinition
            :lex
            :startPos
            kind: unitKind
        )
        inlineTypedef: isInlineTypedefTok :tt
        if inlineTypedef then {
            bad: lex.acceptAny pool: this.ast.names
            return (this.mkError
                tok: bad
                code: zast.err.badItem
                msg: "Inline type definition is not allowed here; define it at unit level and reference it by name".string
            )
        }
        paths: this.operationPaths :lex
        n: paths.length
        if n == 0 then {
            bad: lex.acceptAny pool: this.ast.names
            return (this.mkError
                tok: bad
                code: zast.err.badItem
                msg: "Expected a function or expression for item".string
            )
        }
        return (this.operationFromPaths :paths :lex)
    }

    # type-definition dispatcher: unit / function / the six item-definition
    # kinds (record/class/variant/union/protocol/facet) / the if/match/data
    # expression forms (wrapped as an Expression) / else a bare operation.
    # Returns a bare astnode; an absent definition becomes an EXPECTEDTYPEDEF
    # error node.
    acceptTypeDefinition: function {:this lex: zlexer.Lexer unitKind: zast.unitkind} out astnode is {
        startPos: lex.peekPos
        tt: lex.peekType
        match tt case unitTok then {
            return (this.parseUnitDefinition :lex :startPos kind: unitKind)
        } case functionTok then {
            return (this.parseFunctionDefinition :lex :startPos)
        } case recordTok then {
            return (this.parseItemDefinition :lex :startPos kind: zast.objectkind.recordDef)
        } case classTok then {
            return (this.parseItemDefinition :lex :startPos kind: zast.objectkind.classDef)
        } case variantTok then {
            return (this.parseItemDefinition :lex :startPos kind: zast.objectkind.variantDef)
        } case unionTok then {
            return (this.parseItemDefinition :lex :startPos kind: zast.objectkind.unionDef)
        } case protocolTok then {
            return (this.parseItemDefinition :lex :startPos kind: zast.objectkind.protocolDef)
        } case facetTok then {
            return (this.parseItemDefinition :lex :startPos kind: zast.objectkind.facetDef)
        } case generatorTok then {
            return (this.parseItemDefinition :lex :startPos kind: zast.objectkind.generatorDef)
        } case ifTok then {
            ifn: this.acceptIfExpression :lex
            iErr: this.isError node: ifn
            if iErr then return ifn
            return (this.wrapExpression inner: ifn)
        } case matchTok then {
            mexpr: this.acceptMatchExpression :lex
            mErr: this.isError node: mexpr
            if mErr then return mexpr
            return (this.wrapExpression inner: mexpr)
        } case dataTok then {
            dn: this.acceptDataDefinition :lex
            dErr: this.isError node: dn
            if dErr then return dn
            return (this.wrapExpression inner: dn)
        } else {
            paths: this.operationPaths :lex
            n: paths.length
            if n == 0 then {
                return (this.mkErrorAt
                    pos: startPos
                    code: zast.err.expectedTypeDef
                    msg: "Expected a type definition or expression".string
                )
            }
            return (this.operationFromPaths :paths :lex)
        }
    }

    # unit-body -> { newline | definition }. A definition is `name: value`
    # or `:name`; values dispatch through acceptTypeDefinition. EOL
    # filtering is off so newlines separate definitions, and re-enabled
    # while a definition value is parsed. Returns the definitions as
    # namedoperation arms; a trailing error node flags a malformed body.
    acceptUnitBody: function {:this lex: zlexer.Lexer} out ListVal u32 is {
        body: (ListVal u32)
        names: (ListVal u64)
        prevFilter: lex.filterEolState
        lex.setFilterEol enabled: false pool: this.ast.names
        for true loop {
            for (this.atEol :lex) loop lex.advance pool: this.ast.names
            pktt: lex.peekType
            if pktt == zlexer.toktype.labelPreTok then {
                lblTok: lex.acceptAny pool: this.ast.names
                nm: lblTok.text
                dup: names.contains item: nm.u64
                if dup then {
                    body.append (this.intern n: (this.mkError
                        tok: lblTok
                        code: zast.err.duplicateDef
                        msg: "Duplicate definition".string
                    ))
                    lex.setFilterEol enabled: prevFilter pool: this.ast.names
                    return body
                }
                names.append from: nm.u64
                lvName: lblTok.text
                opName: lblTok.text
                lv: this.mkLabelValue line: lblTok.lineno col: lblTok.colno nameId: lvName
                no: (this.mkNamedOp
                    name: opName
                    operation: lv
                    line: lblTok.lineno
                    col: lblTok.colno
                )
                body.append (this.intern n: no)
            } else {
                isLbl: pktt == zlexer.toktype.labelTok
                if isLbl then {
                    lblTok: lex.acceptAny pool: this.ast.names
                    nm: lblTok.text
                    dup: names.contains item: nm.u64
                    if dup then {
                        body.append (this.intern n: (this.mkError
                            tok: lblTok
                            code: zast.err.duplicateDef
                            msg: "Duplicate definition".string
                        ))
                        lex.setFilterEol enabled: prevFilter pool: this.ast.names
                        return body
                    }
                    names.append from: nm.u64
                    opName: lblTok.text
                    dKind: unitKindForLabel id: lblTok.text unitBody: true
                    lex.accept tt: zlexer.toktype.eolTok pool: this.ast.names
                    lex.setFilterEol enabled: true pool: this.ast.names
                    defNode: this.acceptTypeDefinition :lex unitKind: dKind
                    lex.setFilterEol enabled: false pool: this.ast.names
                    dErr: this.isError node: defNode
                    if dErr then {
                        body.append (this.intern n: defNode)
                        lex.setFilterEol enabled: prevFilter pool: this.ast.names
                        return body
                    }
                    isVisU: false
                    if dKind.publicNs then isVisU = true
                    if dKind.privateNs then isVisU = true
                    if isVisU when (this.isUnitDef node: defNode) == false then {
                        dTxt: zast.poolTextCopy pool: this.ast.names ref: lblTok.text
                        body.append (this.intern n: (this.mkError
                            tok: lblTok
                            code: zast.err.reservedMember
                            msg: "'\{dTxt}:' must introduce a unit definition, e.g. `\{dTxt}: unit { :field }`"
                        ))
                        lex.setFilterEol enabled: prevFilter pool: this.ast.names
                        return body
                    }
                    no: (this.mkNamedOp
                        name: opName
                        operation: defNode
                        line: lblTok.lineno
                        col: lblTok.colno
                    )
                    body.append (this.intern n: no)
                } else {
                    break
                }
            }
        }
        lex.setFilterEol enabled: prevFilter pool: this.ast.names
        return body
    }

    # subunit -> "unit" [ "as" ] "{" unit-body "}". The caller has peeked
    # the `unit` keyword (startPos); this consumes it and stamps the `kind`
    # its label implies. Returns a bare unitdef astnode positioned at the keyword.
    parseUnitDefinition: function {:this lex: zlexer.Lexer startPos: zlexer.tokpos kind: zast.unitkind} out astnode is {
        lex.advance pool: this.ast.names
        lex.accept tt: zlexer.toktype.asTok pool: this.ast.names
        openOpt: lex.accept tt: zlexer.toktype.braceOpenTok pool: this.ast.names
        match openOpt case none then {
            badPos: lex.peekPos
            return (this.mkErrorAt
                pos: badPos
                code: zast.err.badArgument
                msg: "Expected open brace for unit body".string
            )
        } case some then {
            body: this.acceptUnitBody :lex
            bn: body.length
            if bn > 0 then {
                lastId: body.pop
                if (zast.isErrorAt ast: this.ast id: lastId) then {
                    return (zast.tableTake ast: this.ast id: lastId)
                }
                body.append lastId
            }
            closeOpt: lex.accept tt: zlexer.toktype.braceCloseTok pool: this.ast.names
            match closeOpt case none then {
                badPos: lex.peekPos
                rwTxt: this.peekReservedWord :lex
                if rwTxt.length > 0 then return (this.mkErrorAt
                    pos: badPos
                    code: zast.err.reservedName
                    msg: "'\{rwTxt}' is a reserved word and cannot be used as a name"
                )
                return (this.mkErrorAt
                    pos: badPos
                    code: zast.err.badUnit
                    msg: "Expected closing brace at end of unit".string
                )
            } case some then {
                # the span is claimed once and answers both the generic probe
                # and the node's own children
                bodySpan: zast.kidsAdd kids: this.ast.kids xs: body
                uk: kind
                if kind.namespace when (zast.itemsHaveGenericParam
                    ast: this.ast
                    items: bodySpan
                ) then uk = zast.unitkind.template
                return (astnode.unitdef (zast.unitrow
                    nodeid: this.nextId
                    lineno: startPos.lineno
                    colno: startPos.colno
                    kind: uk
                    body: bodySpan)
                )
            }
        }
    }

    # item-definition entry (record/class/variant/union/protocol/facet).
    # The caller has peeked the keyword (startPos); this consumes it, seeds
    # empty is/as accumulators, and tail-calls the reorder loop. Stays a
    # thin seed so the tail is re-entrant with the keyword already consumed.
    parseItemDefinition: function {:this lex: zlexer.Lexer startPos: zlexer.tokpos kind: zast.objectkind} out astnode is {
        lex.advance pool: this.ast.names
        isItems: (ListVal u32)
        asItems: (ListVal u32)
        return (this.acceptItemBodiesTail
            :lex
            :isItems
            :asItems
            isNative: false
            hasIs: false
            hasAs: false
            :kind
            startLine: startPos.lineno
            startCol: startPos.colno
        )
    }

    # Reorderable `is { ... }` / `as { ... }` / `is native` / bare `native`
    # clause loop for an item definition. Recursive tail threading the two
    # owned member lists (like functionClausesTail) -- a leading bare `{`
    # defaults to the is-body. An item must carry an is-body or `native`;
    # otherwise the body is malformed. Builds the objectdef at the terminal.
    acceptItemBodiesTail: function {:this lex: zlexer.Lexer isItems: (ListVal u32).take asItems: (ListVal u32).take isNative: bool hasIs: bool hasAs: bool kind: zast.objectkind startLine: u32 startCol: u32} out astnode is {
        tPos: lex.peekPos
        tt: lex.peekType
        if tt == zlexer.toktype.isTok then {
            if hasIs then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badItem
                    msg: "Duplicate is clause".string
                )
            }
            if isNative then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badItem
                    msg: "Duplicate is clause".string
                )
            }
            lex.advance pool: this.ast.names
            natOpt: lex.accept tt: zlexer.toktype.nativeTok pool: this.ast.names
            match natOpt case some then {
                return (this.acceptItemBodiesTail
                    :lex
                    :isItems
                    :asItems
                    isNative: true
                    :hasIs
                    :hasAs
                    :kind
                    :startLine
                    :startCol
                )
            } case none then {
                ib: this.getObjectBody :lex typeBody: true
                ibn: ib.length
                if ibn > 0 then {
                    lastId: ib.pop
                    if (zast.isErrorAt ast: this.ast id: lastId) then {
                        return (zast.tableTake ast: this.ast id: lastId)
                    }
                    ib.append lastId
                }
                return (this.acceptItemBodiesTail
                    :lex
                    isItems: ib
                    :asItems
                    :isNative
                    hasIs: true
                    :hasAs
                    :kind
                    :startLine
                    :startCol
                )
            }
        }
        if tt == zlexer.toktype.nativeTok then {
            noBodyYet: true
            if hasIs then noBodyYet = false
            if isNative then noBodyYet = false
            if noBodyYet then {
                lex.advance pool: this.ast.names
                return (this.acceptItemBodiesTail
                    :lex
                    :isItems
                    :asItems
                    isNative: true
                    :hasIs
                    :hasAs
                    :kind
                    :startLine
                    :startCol
                )
            }
        }
        if tt == zlexer.toktype.asTok then {
            if hasAs then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badItem
                    msg: "Duplicate as clause".string
                )
            }
            lex.advance pool: this.ast.names
            ab: this.getObjectBody :lex typeBody: true
            abn: ab.length
            if abn > 0 then {
                lastId: ab.pop
                if (zast.isErrorAt ast: this.ast id: lastId) then {
                    return (zast.tableTake ast: this.ast id: lastId)
                }
                ab.append lastId
            }
            return (this.acceptItemBodiesTail
                :lex
                :isItems
                asItems: ab
                :isNative
                :hasIs
                hasAs: true
                :kind
                :startLine
                :startCol
            )
        }
        if tt == zlexer.toktype.braceOpenTok then {
            # `is native` IS the is-clause. A definition has one: either the
            # runtime supplies the body, or the body is written here -- never
            # both, and a second one is not a body the reader can act on.
            if isNative then {
                return (this.mkErrorAt
                    pos: tPos
                    code: zast.err.badItem
                    msg: "a definition has one is-clause: `is native` or an is-block, not both".string
                )
            }
            noBodyYet: true
            if hasIs then noBodyYet = false
            if noBodyYet then {
                ib: this.getObjectBody :lex typeBody: true
                ibn: ib.length
                if ibn > 0 then {
                    lastId: ib.pop
                    if (zast.isErrorAt ast: this.ast id: lastId) then {
                        return (zast.tableTake ast: this.ast id: lastId)
                    }
                    ib.append lastId
                }
                return (this.acceptItemBodiesTail
                    :lex
                    isItems: ib
                    :asItems
                    :isNative
                    hasIs: true
                    :hasAs
                    :kind
                    :startLine
                    :startCol
                )
            }
        }
        hasBody: false
        if hasIs then hasBody = true
        if isNative then hasBody = true
        # a generator's `is` block declares its construction fields, and one
        # that captures nothing has none to write. Its body is `call`, which
        # lives in `as`, so `as` alone is a complete definition -- for this kind
        # only: every other kind's members are meaningless without an is-block.
        if kind == zast.objectkind.generatorDef when hasAs then hasBody = true
        if hasBody then {
            return (astnode.objectdef (zast.objectdefrow
                nodeid: this.nextId
                lineno: startLine
                colno: startCol
                :kind
                isItems: (zast.kidsAdd kids: this.ast.kids xs: isItems)
                asItems: (zast.kidsAdd kids: this.ast.kids xs: asItems)
                :isNative)
            )
        }
        return (this.mkErrorAt
            pos: tPos
            code: zast.err.badArgument
            msg: "Expected open brace or native for item body".string
        )
    }

    # an expression, required: a failure here yields an error node rather than
    # nothing, so the caller always has a node to hang position on
    parseExpression: function {:this lex: zlexer.Lexer} out astnode is {
        match lex.peekType case ifTok then {
            ifn: this.acceptIfExpression :lex
            iErr: this.isError node: ifn
            if iErr then return ifn
            return (this.wrapExpression inner: ifn)
        } case forTok then {
            forn: this.acceptForExpression :lex
            fErr: this.isError node: forn
            if fErr then return forn
            return (this.wrapExpression inner: forn)
        } case matchTok then {
            mexpr: this.acceptMatchExpression :lex
            mErr: this.isError node: mexpr
            if mErr then return mexpr
            return (this.wrapExpression inner: mexpr)
        } case dataTok then {
            dn: this.acceptDataDefinition :lex
            dErr: this.isError node: dn
            if dErr then return dn
            return (this.wrapExpression inner: dn)
        } case withTok then {
            wn: this.acceptWithExpression :lex
            wErr: this.isError node: wn
            if wErr then return wn
            return (this.wrapExpression inner: wn)
        } case braceOpenTok then {
            blk: this.acceptBareblock :lex
            bErr: this.isError node: blk
            if bErr then return blk
            return (this.wrapExpression inner: blk)
        } else {
            op: this.parseOperation :lex
            oErr: this.isError node: op
            if oErr then return op
            return (this.wrapExpression inner: op)
        }
    }

    # operation -> binop | ( term binop ) | ( term "=" expression )
    #            | ( term "swap" term ).
    #
    # Reassignment and swap live HERE, not beside `expression`'s compound
    # forms, which is what lets a clause body be `block | operation` without
    # rejecting `then x = 1`. Nothing becomes ambiguous by the move: `=` and
    # `swap` are keyword tokens, and a binop operator must be an atomid
    # (foldBinopTail requires it), so after the first term the alternative is
    # chosen deterministically and binop greediness is untouched -- it already
    # stopped at a non-atomid.
    parseOperation: function {:this lex: zlexer.Lexer} out astnode is {
        tPos: lex.peekPos
        paths: this.operationPaths :lex
        n: paths.length
        if n == 0 then {
            return (this.mkErrorAt
                pos: tPos
                code: zast.err.badExpression
                msg: "Expected an expression".string
            )
        }
        eqOpt: lex.accept tt: zlexer.toktype.equalsTok pool: this.ast.names
        match eqOpt case some then {
            return (this.buildReassignment
                :paths
                :lex
                startLine: tPos.lineno
                startCol: tPos.colno
            )
        } case none then {
            swOpt: lex.accept tt: zlexer.toktype.swapTok pool: this.ast.names
            match swOpt case some then {
                return (this.buildSwap
                    :paths
                    :lex
                    startLine: tPos.lineno
                    startCol: tPos.colno
                )
            } case none then {
                return (this.operationOrCallFromPaths :paths :lex)
            }
        }
    }

    # an expression if one starts here, and nothing if not. The `accept` half of
    # the parser's accept/parse pair -- `parse` requires, `accept` offers
    acceptExpression: function {:this lex: zlexer.Lexer} out optionval astnode is {
        la: this.exprLookahead :lex
        if la then {
            return (optionval.some (this.parseExpression :lex))
        } else {
            return (optionval.none astnode)
        }
    }

    # True when `node` is an `error` arm carrying FILENOTFOUND. Used to
    # tell "this reference is not a subunit/unit file" (benign -- resolve
    # elsewhere) from a real parse error (propagate).
    isFileNotFound: function {node: astnode} out bool is {
        match (
            node
        ) case error then {
            match (
                node.err
            ) case fileNotFound then {
                return true
            } else {
                return false
            }
        } else {
            return false
        }
    }

    # Load and parse the unit file `<unitname>.z` under `parentid`. On
    # success appends namedoperation(name,
    # unitdef) into `outBody`, this unit's top-level def names into `outNames`,
    # and its unresolved externs into `outExterns`; recursively loads any
    # subunit found in a same-named subdirectory (attaching them into this
    # unit's body and folding their externs back into this resolve loop).
    # Returns an `error` astnode on failure (FILENOTFOUND distinguishable via
    # isFileNotFound) or a benign `atomid` "ok" sentinel on success -- so a
    # bare astnode return avoids disassembling an owned result carrier.
    loadUnit: function {:this vfs: zvfs.ZVfs parentid: zvfs.fsno unitname: String kind: zast.unitkind coreNames: (List String).view outBody: ListVal u32 outExterns: List String outNames: (ListVal u32)} out astnode is {
        valid: isValidUnitName name: unitname.stringView
        if (valid) == false then {
            return (astnode.error (zast.errorrow
                nodeid: this.nextId
                lineno: 0
                colno: 0
                width: 1
                err: zast.err.badUnitName
                msg: (zast.poolSet pool: this.ast.names text: "Invalid unit name")
                fsno: zvfs.fsno
                note: zast.nameid
                hint: zast.nameid)
            )
        }
        fn: "\{unitname.stringView}.z"
        fsid: vfs.walk parent: parentid name: fn.stringView
        fkind: vfs.arm dentryid: fsid
        isNF: false
        match (
            fkind
        ) case notfound then {
            isNF = true
        } case dir then null case file then null
        if isNF then {
            return (astnode.error (zast.errorrow
                nodeid: this.nextId
                lineno: 0
                colno: 0
                width: 1
                err: zast.err.fileNotFound
                msg: (zast.poolSet pool: this.ast.names text: "Unit file not found")
                fsno: zvfs.fsno
                note: zast.nameid
                hint: zast.nameid)
            )
        }
        r: vfs.open dentryid: fsid
        match (
            r
        ) case err then {
            return (astnode.error (zast.errorrow
                nodeid: this.nextId
                lineno: 0
                colno: 0
                width: 1
                err: zast.err.ioError
                msg: (zast.poolSet pool: this.ast.names text: "Could not open unit file")
                fsno: zvfs.fsno
                note: zast.nameid
                hint: zast.nameid)
            )
        } case ok then {
            tk: zlexer.Tokenizer.create source: r.take fsno: fsid
            lx: zlexer.Lexer.create lexer: tk
            lx.advance pool: this.ast.names
            firstPos: lx.peekPos
            segStart: this.nextNodeId
            body: this.acceptUnitBody lex: lx
            bn: body.length
            if bn > 0 then {
                lastId: body.pop
                if (zast.isErrorAt ast: this.ast id: lastId) then {
                    return (zast.tableTake ast: this.ast id: lastId)
                }
                body.append lastId
            }
            eofOpt: lx.accept tt: zlexer.toktype.eofTok pool: this.ast.names
            match (
                eofOpt
            ) case none then {
                badPos: lx.peekPos
                rwTxt: this.peekReservedWord lex: lx
                if rwTxt.length > 0 then return (this.mkErrorAt
                    pos: badPos
                    code: zast.err.reservedName
                    msg: "'\{rwTxt}' is a reserved word and cannot be used as a name"
                )
                return (this.mkErrorAt
                    pos: badPos
                    code: zast.err.badUnit
                    msg: "Expected EOF at end of unit file".string
                )
            } case some then null
            this.ast.fileSegs.append (zast.FileSeg
                startId: segStart
                endId: this.nextNodeId
                fsno: fsid
            )
            ewBindNameList ast: this.ast scope: outNames items: body
            raw: collectExterns ast: this.ast :body
            dirid: vfs.walk parent: parentid name: unitname.stringView
            dkind: vfs.arm dentryid: dirid
            hasSubdir: false
            match (
                dkind
            ) case dir then {
                hasSubdir = true
            } case file then null case notfound then null
            for raw.length > 0 loop {
                rname: raw.pop
                inCore: coreNames.contains item: rname
                if (inCore) == false then {
                    handled: false
                    if hasSubdir then {
                        subNames: (ListVal u32)
                        sub: (this.loadUnit
                            :vfs
                            parentid: dirid
                            unitname: rname
                            kind: zast.unitkind.subunit
                            :coreNames
                            outBody: body
                            outExterns: raw
                            outNames: subNames
                        )
                        subErr: this.isError node: sub
                        if subErr then {
                            nf: this.isFileNotFound node: sub
                            if (nf) == false then return sub
                        } else {
                            handled = true
                        }
                    }
                    if (handled) == false then outExterns.append rname.copy
                }
            }
            root: astnode.unitdef (zast.unitrow
                nodeid: this.nextId
                lineno: firstPos.lineno
                colno: firstPos.colno
                :kind
                body: (zast.kidsAdd kids: this.ast.kids xs: body)
            )
            outBody.append (this.intern n: (this.mkNamedOp
                name: (this.internName name: unitname.stringView)
                operation: root
                line: firstPos.lineno
                col: firstPos.colno
            ))
            return (astnode.atomid (zast.atomidrow
                nodeid: this.nextId
                lineno: 0
                colno: 0
                name: (this.internName name: "ok"))
            )
        }
    }

    # Top-level entry: load the main unit and every transitively-referenced
    # unit, returning a `program` astnode (or an `error` arm). core is loaded
    # first so its definitions suppress externs; the worklist is drained
    # LIFO via List.pop. Definitions/queue are parallel String/astnode lists
    # (no reftype-valued Map).
    parse: function {:this vfs: zvfs.ZVfs rootid: zvfs.fsno mainUnitName: String.view} out zast.Ast is {
        units: (ListVal u32)
        coreNames: (List String)
        coreNamesOut: (ListVal u32)
        coreExterns: (List String)
        coreRes: (this.loadUnit
            :vfs
            parentid: rootid
            unitname: "core".string
            kind: zast.unitkind.namespace
            :coreNames
            outBody: units
            outExterns: coreExterns
            outNames: coreNamesOut
        )
        coreErr: this.isError node: coreRes
        coreOk: false
        if coreErr then {
            coreNF: this.isFileNotFound node: coreRes
            if (coreNF) == false then return (this.errorTree e: coreRes)
        } else {
            coreOk = true
        }
        defNames: (List String)
        if coreOk then {
            defNames.append "core".string
            cnIt: coreNamesOut.iterate
            for cn: cnIt loop coreNames.append (zast.poolTextCopy
                pool: this.ast.names
                ref: (zast.nameid.create from: cn.u32)
            )
        }
        loadQueue: (List String)
        loadQueue.append mainUnitName.copy
        ceIt: coreExterns.iterate
        for ce: ceIt loop enqueueUnit queue: loadQueue :defNames name: ce.copy
        for loadQueue.length > 0 loop {
            name: loadQueue.pop
            already: defNames.contains item: name
            if (already) == false then {
                unitExterns: (List String)
                throwNames: (ListVal u32)
                res: (this.loadUnit
                    :vfs
                    parentid: rootid
                    unitname: name
                    kind: zast.unitkind.namespace
                    :coreNames
                    outBody: units
                    outExterns: unitExterns
                    outNames: throwNames
                )
                rErr: this.isError node: res
                if rErr then {
                    nf: this.isFileNotFound node: res
                    if nf then {
                        if name.stringView == mainUnitName.stringView then {
                            return (this.errorTree e: (astnode.error (zast.errorrow
                                nodeid: this.nextId
                                lineno: 0
                                colno: 0
                                width: 1
                                err: zast.err.badReference
                                msg: (zast.poolSet
                                    pool: this.ast.names
                                    text: "Unknown reference '\{name}'".stringView
                                )
                                fsno: zvfs.fsno
                                note: zast.nameid
                                hint: zast.nameid)
                            ))
                        }
                        # a free name with no unit file behind it is not a
                        # load failure: leave it unresolved -- the checker
                        # reports unknown references at their use sites (with
                        # positions) and keeps checking the rest of the unit
                        defNames.append name.copy
                    } else {
                        return (this.errorTree e: res)
                    }
                } else {
                    defNames.append name.copy
                    eIt: unitExterns.iterate
                    for e: eIt loop enqueueUnit queue: loadQueue :defNames name: e.copy
                }
            }
        }
        pid: this.nextId
        units swap this.ast.units
        tbl: Ast.create
        tbl swap this.ast
        # the root is a row like every other node: the tree is what is returned,
        # and `root` is how a reader finds the row inside it
        tbl.root = pid
        mun: mainUnitName.copy
        mun swap tbl.mainUnitName
        (zast.tableSet
            ast: tbl
            id: pid.u32
            child: (astnode.program (zast.programrow nodeid: pid lineno: 1 colno: 1))
        )
        return tbl
    }
}

# ---------------------------------------------------------------------------
# Extern (free-variable) walk.
#
# The parser does not thread externs during parsing (the AST has no extern
# field). Instead this single post-parse walk recovers the set of
# referenced names not bound within a unit. Only valid, loadable unit names are kept
# (operators, numbers, and dotted-member selectors never name a unit), so
# the set drives which sibling units and subunits parse() loads.
#
# `externs` and `scope` are threaded as borrowed list params (appending to
# a borrowed reftype mutates the caller's list -- the lib `extendraw`
# pattern), so the child loops never move an owned accumulator across an
# iteration (no E0200) and collectExterns returns a plain owned local.
# Both carry Ast.names pool ids: a scope membership test is an integer
# compare, and text is materialised only at the two edges (the unit-name
# shape test, and collectExterns' returned file names).
#
# Bias: keep a name unless it is provably bound. A spurious extern fails
# to resolve to a file and is harmless; a missed extern would drop a unit.
# ---------------------------------------------------------------------------

# Record `name` as an extern unless it is bound, not a valid unit name, or
# already recorded.
ewEmit: function {
    # the tree the name was read from
    ast: Ast.view
    # the accumulating extern list; a name already in it is not added twice
    externs: ListVal u32
    # the names bound so far. A name in scope is not an extern
    scope: (ListVal u32).view
    # the candidate. It is kept unless PROVABLY bound: a spurious extern fails
    # to resolve to a file and is harmless, while a missed one would drop a unit
    nameId: zast.nameid
} is {
    inScope: scope.contains item: nameId
    if inScope then return
    dup: externs.contains item: nameId
    if dup then return
    t: zast.nameTextAt :ast ref: nameId
    valid: isValidUnitName name: t.stringView
    if valid then externs.append nameId
}

# Push an optional bound name (a namedoperation / param / loop label).
# A ref of 0 -- a positional arm, which binds no name -- pushes nothing.
ewBindOptName: function {scope: ListVal u32 ref: zast.nameid} is {
    if ref.isZero then return
    scope.append ref
}

# Push a scope seed named by its text (`this` / `type` / `meta`). A name the
# pool never interned cannot be referenced either, so a miss binds nothing.
ewBindKnown: function {ast: Ast.view scope: ListVal u32 text: StringView} is {
    id: zast.poolFind pool: ast.names :text
    if id.isZero then return
    scope.append id
}

# Bind one namedoperation arm's name.
ewBindOneName: function {scope: (ListVal u32) item: astnode} is {
    if item.namedoperation then {
        ewBindOptName :scope ref: item.name
    }
}

# Bind the top-level names of a converted id-list (unit bodies).
ewBindNameIds: function {ast: Ast.view scope: (ListVal u32) items: zast.kidspan} is {
    ei: u64
    en: items.count.u64
    for ei < en loop {
        eid: zast.kidAt kids: ast.kids span: items i: ei
        ewBindOneName :scope item: (ast.nodes.get i: eid.u64)
        ei = ei + 1
    }
}

# ewBindNameList -- ewBindNameIds over a list the parser still holds, before
# the node that will own the span is built. Same core, different accessor.
ewBindNameList: function {ast: Ast.view scope: (ListVal u32) items: (ListVal u32).view} is {
    with it: items.iterate do for eid: it loop {
        ewBindOneName :scope item: (ast.nodes.get i: eid.u64)
    }
}

# Drop bindings introduced since depth `n` (block / scope exit).
ewTruncate: function {scope: ListVal u32 n: u64} is {
    for scope.length > n loop scope.pop
}

# Walk an optional child node if present.
# ewWalkOptAt -- the id-taking entry (0 = absent).
ewWalkOptAt: function {
    # the tree walked
    ast: Ast.view
    # the extern list this walk adds to
    externs: (ListVal u32)
    # the names bound at this point
    scope: (ListVal u32)
    # the optional child, 0 when there is none -- which is the whole reason for
    # the `At` twin
    oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    ewWalk :ast :externs :scope node: o
}

# Walk every node of an id list.
# ewWalkList -- ewWalkIds over a list the parser still holds, or over the
# canonical child list of a node with no single span. Same core.
ewWalkList: function {
    ast: Ast.view
    externs: (ListVal u32)
    scope: (ListVal u32)
    items: (ListVal u32).view
} is {
    with it: items.iterate do for wid: it loop {
        ewWalk :ast :externs :scope node: (ast.nodes.get i: wid.u64)
    }
}

# Walk every node of an id list, given as a span.
ewWalkIds: function {
    # the tree walked
    ast: Ast.view
    # the extern list the children's walks add to
    externs: (ListVal u32)
    # the names bound at this point
    scope: (ListVal u32)
    # the children walked in order
    items: zast.kidspan
} is {
    wi: u64
    wn: items.count.u64
    for wi < wn loop {
        wid: zast.kidAt kids: ast.kids span: items i: wi
        ewWalk :ast :externs :scope node: (ast.nodes.get i: wid.u64)
        wi = wi + 1
    }
}

# A for-loop condition arm: a named arm (`label op`) binds the loop
# variable for the body after its iterable is walked; an unnamed arm
# (a `while` / leading condition) is just walked.
ewWalkForCond: function {
    # the tree walked
    ast: Ast.view
    # the extern list the header's walk adds to
    externs: (ListVal u32)
    # the names bound at this point; a for header BINDS its loop name, so the
    # body sees it
    scope: (ListVal u32)
    # the for header's condition, which may introduce that binding
    cond: astnode
} is {
    match (
        cond
    ) case namedoperation then {
        ewWalk :ast :externs :scope node: (ast.nodes.get i: cond.operation.u64)
        ewBindOptName :scope ref: cond.name
    } else {
        ewWalk :ast :externs :scope node: cond
    }
}

# The core recursive walk. The arms that bind names or skip a child are
# spelled, and so are the shapes a program is mostly MADE of -- they descend
# through the node's own child fields in zast.childIds' canonical order, where
# the generic arm would build a list of those ids per node visited. Everything
# else recurses over zast.childIds. Emits atomid references; threads the bound
# scope through nested definitions and blocks.
ewWalk: function {ast: Ast.view externs: (ListVal u32) scope: ListVal u32 node: astnode} is {
    match (
        node
    ) case atomid then {
        ewEmit :ast :externs :scope nameId: node.name
    } case labelvalue then {
        # `:name` is `name: name`: a reference to `name` (a `public:` block
        # entry that lists a hidden subunit is what loads its file)
        ewEmit :ast :externs :scope nameId: node.name
    } case dottedpath then {
        # only the base can name a unit; a member selector never does
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.parent.u64)
    } case assignment then {
        # binds its name for what follows, not for its own value
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.value.u64)
        scope.append node.name
    } case statement then {
        base: scope.length
        ewWalkIds :ast :externs :scope items: node.statements
        ewTruncate :scope n: base
    } case forexpr then {
        base: scope.length
        cox1179: u64
        for cox1179 < node.conditions.count.u64 loop {
            fc: zast.kidAt kids: ast.kids span: node.conditions i: cox1179
            cox1179 = cox1179 + 1
            ewWalkForCond :ast :externs :scope cond: (ast.nodes.get i: fc.u64)
        }
        ewWalkOptAt :ast :externs :scope oId: node.body
        ewWalkIds :ast :externs :scope items: node.postconditions
        ewTruncate :scope n: base
    } case withexpr then {
        base: scope.length
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.value.u64)
        scope.append node.name
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.body.u64)
        ewTruncate :scope n: base
    } case caseclause then {
        # the arm pattern names an arm of the subject, never a unit
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.statement.u64)
    } case statementline then {
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.statementline.u64)
    } case expression then {
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.expression.u64)
    } case binop then {
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.lhs.u64)
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.operator.u64)
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.rhs.u64)
    } case call then {
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.callable.u64)
        ewWalkIds :ast :externs :scope items: node.arguments
    } case atomstring then {
        ewWalkIds :ast :externs :scope items: node.stringparts
    } case namedoperation then {
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.operation.u64)
    } case ifexpr then {
        ewWalkIds :ast :externs :scope items: node.clauses
        ewWalkOptAt :ast :externs :scope oId: node.elseclause
    } case ifclause then {
        ewWalkIds :ast :externs :scope items: node.conditions
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.statement.u64)
    } case caseexpr then {
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.subject.u64)
        ewWalkIds :ast :externs :scope items: node.clauses
        ewWalkOptAt :ast :externs :scope oId: node.elseclause
    } case reassignment then {
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.topath.u64)
        ewWalk :ast :externs :scope node: (ast.nodes.get i: node.value.u64)
    } case functiondef then {
        base: scope.length
        ewBindNameIds :ast :scope items: node.parameters
        ewBindNameIds :ast :scope items: node.asItems
        ewWalkOptAt :ast :externs :scope oId: node.returntype
        ewWalkIds :ast :externs :scope items: node.parameters
        ewWalkOptAt :ast :externs :scope oId: node.body
        ewWalkIds :ast :externs :scope items: node.asItems
        ewTruncate :scope n: base
    } case objectdef then {
        base: scope.length
        ewBindKnown :ast :scope text: "this"
        ewBindKnown :ast :scope text: "type"
        ewBindKnown :ast :scope text: "meta"
        ewBindNameIds :ast :scope items: node.isItems
        ewBindNameIds :ast :scope items: node.asItems
        ewWalkIds :ast :externs :scope items: node.isItems
        ewWalkIds :ast :externs :scope items: node.asItems
        ewTruncate :scope n: base
    } case unitdef then {
        base: scope.length
        ewBindKnown :ast :scope text: "this"
        ewBindKnown :ast :scope text: "type"
        ewBindKnown :ast :scope text: "meta"
        # a `public:` block's entries name the ENCLOSING unit's definitions
        # (`:impl`, `perimeter: perimImpl`): binding the entry names first
        # would hide the references they are, and a listed hidden subunit
        # loads on the strength of that reference alone
        if (node.kind.publicNs) == false then ewBindNameIds :ast :scope items: node.body
        ewWalkIds :ast :externs :scope items: node.body
        ewTruncate :scope n: base
    } case program then null else {
        ewWalkList :ast :externs :scope items: (zast.childIds :ast n: node)
    }
}

# Recover the extern (free-reference) set of a parsed unit body. Seeds the
# scope with {this,type,meta} and every top-level definition name (so
# forward references resolve), then walks the body. Returns the deduped
# extern names in source-reference order; parse() loads them as units.
collectExterns: function {ast: Ast.view body: (ListVal u32).view} out List String is {
    externIds: (ListVal u32)
    scope: (ListVal u32)
    ewBindKnown :ast :scope text: "this"
    ewBindKnown :ast :scope text: "type"
    ewBindKnown :ast :scope text: "meta"
    ewBindNameList :ast :scope items: body
    ewWalkList :ast externs: externIds :scope items: body
    externs: (List String capacity: externIds.length)
    with eit: externIds.iterate do for eid: eit loop {
        externs.append (zast.poolTextCopy pool: ast.names ref: (zast.nameid.create from: eid.u32))
    }
    return externs
}

# Enqueue `name` as a unit to load unless it is already loaded
# (defNames) or already queued. Consumes `name` (appends it or frees it).
enqueueUnit: function {queue: List String defNames: (List String).view name: String.take} is {
    inDef: defNames.contains item: name
    if (inDef) == false then {
        inQ: queue.contains item: name
        if (inQ) == false then queue.append name
    }
}
