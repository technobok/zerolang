                """
                /* byte-compare z_@String@_t vs C string + length */
                static bool z_cli_str_eq(const z_@String@_t* a, const char* b, uint64_t blen);
                static bool z_cli_str_eq(const z_@String@_t* a, const char* b, uint64_t blen) {
                    if (a->size != blen) return false;
                    return memcmp(a->data, b, blen) == 0;
