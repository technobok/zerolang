                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "sender"
                    needs: list { "prelude.@chan_add_sender" }
                    text: """
                        static z_@@OUT.sender@@_t z_@@NAME@@_sender(z_@@NAME@@_t* r) {
                            z_chan_add_sender(r->b);
                            z_@@OUT.sender@@_t s;
                            s.b = r->b;
