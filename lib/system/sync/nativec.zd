                    c.section
                    member: "create"
                    needs: list { "prelude.@rwlock_init" "prelude.@panic" "prelude.@xmalloc" }
                    text: """
                        static z_@@NAME@@_t z_@@NAME@@_create(@@P0@@ value) {
                            z_@@NAME@@_t rw;
                            rw.b = (z_@@NAME@@_blk*)z_xmalloc(sizeof(z_@@NAME@@_blk));
                            if (z_rwlock_init(&rw.b->l) != 0) z_panic("sync.RwLock: the operating system could not make a lock");
                            atomic_init(&rw.b->refs, 1);
                            rw.b->value = value;
                            return rw;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "share"
                    needs: list { "prelude.@atomic_add" "prelude.@relaxed" }
                    text: """
                        static z_@@NAME@@_t z_@@NAME@@_share(z_@@NAME@@_t* h) {
                            Z_ATOMIC_ADD(&h->b->refs, 1, Z_RELAXED);
                            z_@@NAME@@_t s;
                            s.b = h->b;
                            return s;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "destroy"
                    needs: list {
                        "prelude.@acqrel" "prelude.@atomic_sub" "prelude.@rwlock_destroy"
                    }
                    text: """
                        /* the last handle to end destroys what the block holds and frees it */
                        static void z_@@NAME@@_destroy(z_@@NAME@@_t* h) {
                            if (h->b == NULL) return;
                            if (Z_ATOMIC_SUB(&h->b->refs, 1, Z_ACQREL) == 1) {
                                @@P0_DESTROY@@(&h->b->value);
                                z_rwlock_destroy(&h->b->l);
                                free(h->b);
                            }
                            h->b = NULL;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "read"
                    needs: list { "prelude.@rwlock_rdlock" "prelude.@panic" }
                    text: """
                        static z_@@OUT.read@@_t z_@@NAME@@_read(z_@@NAME@@_t* rw) {
                            z_@@OUT.read@@_t g;
                            if (z_rwlock_rdlock(&rw->b->l) != 0) z_panic("sync.RwLock: read lock failed");
                            g.l = &rw->b->l;
                            g.value = &rw->b->value;
                            return g;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "write"
                    needs: list { "prelude.@rwlock_wrlock" "prelude.@panic" }
                    text: """
                        static z_@@OUT.write@@_t z_@@NAME@@_write(z_@@NAME@@_t* rw) {
                            z_@@OUT.write@@_t g;
                            if (z_rwlock_wrlock(&rw->b->l) != 0) z_panic("sync.RwLock: write lock failed");
                            g.l = &rw->b->l;
                            g.value = &rw->b->value;
                            return g;
                        }
                        """
                )
            }
