        (
            c.template
            name: "Mutex"
            needs: list { "prelude.@atomic" "prelude.@mutex_t" }
            sections: list {
                (
                    c.section
                    text: """
                        /* Mutex and MutexVal -- a value of @@P0@@ that one thread at a time reaches,
                           through the guard `lock` answers (sync.z), one copy per value type; both
                           classes are this template, @@P0@@ their one type. The lock and the
                           value live in a heap block every handle shares (`share` makes another), so
                           neither moves while a thread waits on it or holds it; the last handle to
                           end frees it. A MutexGuard is `{z_mutex_t* m; T* value}`
                           (template MutexGuard): `lock` fills one. */
                        typedef struct z_@@NAME@@_blk {
                            z_mutex_t m;
                            Z_ATOMIC(uint64_t) refs;
                            @@P0@@ value;
                        } z_@@NAME@@_blk;

                        typedef struct z_@@NAME@@_t {
                            z_@@NAME@@_blk* b;
                        } z_@@NAME@@_t;

                        """
                )
                (
                    c.section
                    member: "create"
                    needs: list { "prelude.@mutex_init" "prelude.@panic" "prelude.@xmalloc" }
                    text: """
                        static z_@@NAME@@_t z_@@NAME@@_create(@@P0@@ value) {
                            z_@@NAME@@_t mx;
                            mx.b = (z_@@NAME@@_blk*)z_xmalloc(sizeof(z_@@NAME@@_blk));
                            if (z_mutex_init(&mx.b->m) != 0) z_panic("sync.Mutex: the operating system could not make a lock");
                            atomic_init(&mx.b->refs, 1);
                            mx.b->value = value;
                            return mx;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "share"
                    needs: list { "prelude.@atomic_add" "prelude.@relaxed" }
                    text: """
                        static z_@@NAME@@_t z_@@NAME@@_share(z_@@NAME@@_t* h) {
                            Z_ATOMIC_ADD(&h->b->refs, 1, Z_RELAXED);
                            z_@@NAME@@_t s;
                            s.b = h->b;
                            return s;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "destroy"
                    needs: list { "prelude.@acqrel" "prelude.@atomic_sub" "prelude.@mutex_destroy" }
                    text: """
                        /* the last handle to end destroys what the block holds and frees it */
                        static void z_@@NAME@@_destroy(z_@@NAME@@_t* h) {
                            if (h->b == NULL) return;
                            if (Z_ATOMIC_SUB(&h->b->refs, 1, Z_ACQREL) == 1) {
                                @@P0_DESTROY@@(&h->b->value);
                                z_mutex_destroy(&h->b->m);
                                free(h->b);
                            }
                            h->b = NULL;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "lock"
                    needs: list { "prelude.@mutex_lock" "prelude.@panic" }
                    text: """
                        static z_@@OUT.lock@@_t z_@@NAME@@_lock(z_@@NAME@@_t* mx) {
                            z_@@OUT.lock@@_t g;
                            if (z_mutex_lock(&mx->b->m) != 0) z_panic("sync.Mutex: lock failed");
                            g.m = &mx->b->m;
                            g.value = &mx->b->value;
                            return g;
                        }
                        """
                )
            }
        )
        (
            c.template
            name: "MutexGuard"
            needs: list { "prelude.@mutex_t" }
            sections: list {
                (
                    c.section
                    text: """
                        /* MutexGuard and MutexGuardVal -- a Mutex's lock, held (sync.z), one copy per
                           value type; both classes are this template, @@P0@@ their one type: the
                           lock and the value it guards, both in the Mutex's block, which the guard's
                           pins keep alive. Destroying the guard unlocks; `wait` unlocks while it
                           waits on a Condvar and locks again before it returns. */
                        typedef struct z_@@NAME@@_t {
                            z_mutex_t* m;
                            @@P0@@* value;
                        } z_@@NAME@@_t;

                        """
                )
                (
                    c.section
                    member: "destroy"
                    needs: list { "prelude.@mutex_unlock" }
                    text: """
                        static void z_@@NAME@@_destroy(z_@@NAME@@_t* g) {
                            if (g->m == NULL) return;
                            z_mutex_unlock(g->m);
                            g->m = NULL;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "value"
                    text: """
                        static @@P0@@* z_@@NAME@@_value(z_@@NAME@@_t* g) {
                            return g->value;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "set"
                    text: """
                        /* the old value moves out to the caller, which owns it from here */
                        static @@P0@@ z_@@NAME@@_set(z_@@NAME@@_t* g, @@P0@@ value) {
                            @@P0@@ old = *g->value;
                            *g->value = value;
                            return old;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "wait"
                    needs: list { "prelude.@cond_wait" "prelude.@panic" }
                    text: """
                        static void z_@@NAME@@_wait(z_@@NAME@@_t* g, z_@@ARG.wait.cond@@_t cond) {
                            if (z_cond_wait(&cond.b->c, g->m) != 0) z_panic("sync.Condvar: wait failed");
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "waitTimeout"
                    needs: list { "prelude.@cond_timedwait" "prelude.@panic" }
                    text: """
                        static bool z_@@NAME@@_waitTimeout(z_@@NAME@@_t* g, z_@@ARG.waitTimeout.cond@@_t cond, uint64_t ms) {
                            int e = z_cond_timedwait(&cond.b->c, g->m, ms);
                            if (e != 0 && e != ETIMEDOUT) z_panic("sync.Condvar: wait failed");
                            return e == ETIMEDOUT;
                        }
                        """
                )
            }
        )
        (
