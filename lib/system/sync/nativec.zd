                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "receive"
                    needs: list { "prelude.@chan_receive" }
                    text: """
                        static z_@@OUT.receive@@_t z_@@NAME@@_receive(z_@@NAME@@_t* r) {
                            @@P0@@ v;
                            if (z_chan_receive(r->b, &v, true)) return @@SOME.receive@@(v);
                            return @@NONE.receive@@();
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "tryReceive"
                    needs: list { "prelude.@chan_receive" }
                    text: """
                        static z_@@OUT.tryReceive@@_t z_@@NAME@@_tryReceive(z_@@NAME@@_t* r) {
                            @@P0@@ v;
                            if (z_chan_receive(r->b, &v, false)) return @@SOME.tryReceive@@(v);
                            return @@NONE.tryReceive@@();
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "iterate"
                    text: """
                        static z_@@OUT.iterate@@_t z_@@NAME@@_iterate(z_@@NAME@@_t* r) {
                            z_@@OUT.iterate@@_t it;
