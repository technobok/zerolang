                (c.section text: "")
                (
                    c.section
                    member: "create"
                    needs: list { "destroyElem" "prelude.@chan_new" }
                    text: """
                        static z_@@NAME@@_t z_@@NAME@@_create(uint64_t capacity) {
                            z_@@NAME@@_t r;
                            r.b = z_chan_new(sizeof(@@P0@@), z_@@NAME@@_destroyElem, capacity);
                            return r;
                        }
                        """
                )
                (c.section text: "")
                (
                    c.section
                    member: "destroy"
                    needs: list { "prelude.@chan_drop_receiver" }
                    text: """
                        static void z_@@NAME@@_destroy(z_@@NAME@@_t* r) {
                            if (r->b == NULL) return;
