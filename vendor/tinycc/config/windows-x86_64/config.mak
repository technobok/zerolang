# Automatically generated by configure - do not modify
prefix=C:/Program Files/tcc
bindir=$(DESTDIR)C:/Program Files/tcc
tccdir=$(DESTDIR)C:/Program Files/tcc
libdir=$(DESTDIR)C:/Program Files/tcc/libtcc
includedir=$(DESTDIR)
mandir=$(DESTDIR)
infodir=$(DESTDIR)
docdir=$(DESTDIR)C:/Program Files/tcc/doc
CC=gcc
CC_NAME=gcc
GCC_MAJOR=16
GCC_MINOR=2
AR=ar
LIBSUF=.lib
EXESUF=.exe
DLLSUF=.dll
CFLAGS=-Wall -O2 -Wdeclaration-after-statement -Wno-unused-result
LDFLAGS=-static
ARCH=x86_64
TARGETOS=WIN32
BUILDOS=WIN32
VERSION=0.9.28rc
TOPSRC=$(TOP)
CONFIG_x86_64=yes
CONFIG_WIN32=yes
